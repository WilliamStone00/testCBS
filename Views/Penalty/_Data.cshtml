@model List<CBS.FrontDesk.Data.Entity.LoanConf.Penalty>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Flat amount</th>
            <th>Percentage</th>
            <th>Rate</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:15%">@d.penaltyName</td>
                <td style="width:10%">@d.penaltyType</td>
                <td style="width:10%">@d.flateAmount</td>
                <td style="width:10%">@d.percentage</td>
                <td style="width:10%">
                    @if (@d.isRate)
                    {
                        <label>Percentage</label>
                    }
                    else
                    {
                        <label>Flat Rate</label>
                    }
                </td>
                <td style="width:10%">
                    @if (@d.isEnabled)
                    {
                        <label>Active</label>
                    }
                    else
                    {
                        <label>Inactive</label>
                    }
                </td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','Penalty')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.penaltyName to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.penaltyName" onclick="DeleteRecordDataTable('Penalty','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

