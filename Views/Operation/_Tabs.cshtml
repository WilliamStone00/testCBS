@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
<div class="card mb-4">
    <div class="card-body d-sm-flex d-block">
        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
            <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space"onclick="GetObject('@Model.accountNumber','datalistingview','_Product','product')" data-bs-toggle="tooltip" title="Member subcribed account information">
                <span class="tf-icons mdi mdi-information mdi-18px"></span>
            </a>
            <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetObject('@Model.accountNumber','datalistingview','_AccountInfo','accountInfo')" data-bs-toggle="tooltip" title="Member account information">
                <span class="tf-icons mdi mdi-folder-information-outline mdi-18px"></span>
            </a>
            <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetObject('@Model.accountNumber','datalistingview','_Deposit','deposit')" data-bs-toggle="tooltip" title="Perform member deposit operation">
                <span class="tf-icons mdi mdi-octagram-plus mdi-18px"></span>
            </a>
            <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetObject('@Model.accountNumber','datalistingview','_Withdrawal','withdrawal')" data-bs-toggle="tooltip" title="Perform member withdrawal operation">
                <span class="tf-icons mdi mdi-outdoor-lamp mdi-18px"></span>
            </a>
            <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space"onclick="GetTransactionHistory('@Model.accountNumber','datalistingview','_TransactionHistrotriesData','histories','myDataTable','1')" data-bs-toggle="tooltip" title="Member account statements">
                <span class="tf-icons mdi mdi-format-list-bulleted mdi-18px"></span>
            </a>
        </div>
    </div>
</div>