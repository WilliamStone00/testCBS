@model List<CBS.FrontDesk.Data.Entity.LoanConf.AlertProfile>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Service</th>
            <th>Alert</th>
            <th>notification language</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:20%">@d.name</td>
                <td style="width:15%">@d.serviceId</td>
                <td style="width:35%">Sms notification: @d.sendSMS, Email notification: @d.sendEmail</td>
                <td style="width:10%">@d.language</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','AlertProfile')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('AlertProfile','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

