@model  CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<table class="table table-hover" id="myDataTable_AccountType">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
          
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.AccountTypes)
        {
            <tr>
                <td style="width:35%">@d.name</td>
                <td style="width:35%">@d.operationAccountType</td>
                <td style="width:30%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_AccountType','_CreateAccountType','update','AccountingConfiguration','accountType')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_AccountType','_AccountTypeData',0,'datalistingview_AccountType','accountType')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

