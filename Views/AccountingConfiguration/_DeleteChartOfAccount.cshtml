@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

@{
    ViewBag.Title = "ChartOfAccount";

}
<style>
    .red-text {
        color: red;
    }
</style>
<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">

        @if (Model.ChartOfAccount == null)
        {
            <div class="card col-12 alert alert-outline-danger">
                <h5> Please Reload the page an restart operation. </h5>
            </div>
           
        }
        else
        {
            <div class="card col-12 alert alert-outline-danger">
                You have requested to delete the account with the following details:
                <br>
                Number: @Model.ChartOfAccount.AccountNumber <br>
                Label: @Model.ChartOfAccount.LabelEn
                <br>
                Please confirm that you would like to permanently delete this account and its associated data.
                This action cannot be undone.
                <button onclick="DeleteData('AccountingConfiguration', @Model.ChartOfAccount.AccountNumber,'chartOfAccount')" class="btn btn-danger waves-effect waves-light mdi-bag-checked">YES</button>
            </div>
        }


    </div>
    </div>
