@model CBS.FrontDesk.Data.Entity.LoanConf.LoanPurpose
<div class="card-body">

    @using (Html.BeginForm("Update", "LoanPurpose", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.id)
        <div class="row mt-2 gy-4">
            <div class="col-md-8">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.purposeName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.purposeName, "", new { @class = "text-danger" })
                    <label>LoanPurpose type</label>
                </div>
            </div>

        </div>    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">Update</button>

    </div>
}
</div>