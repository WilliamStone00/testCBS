@model List<CBS.FrontDesk.Data.Entity.LoanConf.Fee>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Range</th>
            <th>Rate</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:30%">@d.nameOfFee</td>
                <td style="width:20%">@d.max - @d.min</td>
                <td style="width:10%">@d.rate %</td>
                <td style="width:20%">
                    @if (@d.isRate)
                    {
                        <label>Percentage</label>
                    }
                    else
                    {
                        <label>Range</label>
                    }
                </td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','Fee')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.nameOfFee to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.nameOfFee" onclick="DeleteRecordDataTable('Fee','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

