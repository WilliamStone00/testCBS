@model List<CBS.FrontDesk.Data.Entity.LoanConf.FundingLine>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Range</th>
            <th>Amount</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:30%">@d.name</td>
                <td style="width:40%">Starting from: @d.beginDate.ToString("yy-MMM-dd ddd")  to: @d.endDate.ToString("yy-MMM-dd ddd")</td>
                <td style="width:10%">@d.amount</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','FundingLine')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('FundingLine','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

