@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
<h5 class="card-header">Account Status</h5>
<div class="card-body">
    <div class="mb-3 col-12 mb-0">
        @if (Model.CustomerList.active)
        {
            <div class="alert alert-outline-success" role="alert">
                <h6 class="alert-heading mb-1">@Model.CustomerList.name account is active.</h6>
                <p class="mb-0">Un-check the box and click on de-activate button to de-activate account</p>
            </div>
        }
        else
        {<div class="alert alert-outline-danger" role="alert">
                <h6 class="alert-heading mb-1">@Model.CustomerList.name account is de-activated</h6>
                <p class="mb-0">Check the box and click on re-activate button to re-activate account</p>
            </div>
        }

    </div>
    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->

        @Html.HiddenFor(model => model.CustomerList.customerId)
        <input type="hidden" name="option" value="Status" id="option" />

        if (Model.CustomerList.active)
        {
            <div class="form-check mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.CustomerList.active, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActive">Uncheck to deactivate customer's account</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-danger deactivate-account">De-activate account</button>
            </div>

        }
        else
        {
            <div class="form-check mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.CustomerList.active, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActive">Check to re-activate customer's account</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary deactivate-account">Re-activate account</button>
            </div>

        }



    }


</div>




