@model List<CBS.FrontDesk.Data.Entity.LoanConf.Collateral>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:10%">@d.name</td>
                <td style="width:60%">@d.description</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','Collateral')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('Collateral','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

