@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<table class="table table-hover" id="myDataTable_Deposit">
    <thead class="table-light">
        <tr>
            <th>Product name</th>
            <th>Flat</th>
            <th>Rate</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.ReopenFeeParameters)
        {
            <tr>
                <td style="width:55%">@d.product.name</td>
                <td style="width:15%">@d.reopenFeeFlat</td>
                <td style="width:10%">@d.reopenFeeRate %</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview_ReopenFeeConfig','_ReopenFeeConfig','get','TransactionConfiguration','ReopenFeeParameter')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.product.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.product.name" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','myDataTable_Deposit','ReopenFeeConfigData',0,'datalistingview_ReopenFeeConfig')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

