@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<table class="table table-hover" id="myDataTable_Deposit">
    <thead class="table-light">
        <tr>
            <th>Product name</th>
            <th>Flat</th>
            <th>Rate</th>
            <th>Frequency</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.ManagementFeeParameters)
        {
            <tr>
                <td style="width:35%">@d.product.name</td>
                <td style="width:15%">@d.managementFeeFlat</td>
                <td style="width:10%">@d.managementFeeRate %</td>
                <td style="width:20%">@d.managementFeeFrequency</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview_ManagementFeeConfig','_ManagementFeeConfig','get','TransactionConfiguration','ManagementFeeParameter')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.product.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.product.name" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','myDataTable_Deposit','ManagementFeeConfigData',0,'datalistingview_ManagementFeeConfig')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

