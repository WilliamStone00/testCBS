@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
<!-- User Card -->
<div class="card mb-4 border-2 border-primary">
    <div class="card-body">
        <div class="user-avatar-section">
            <div class="d-flex align-items-center flex-column">
                <img class="img-fluid rounded mb-3 mt-4"
                     src="~/CBSTemp/ui/assets/img/avatars/10.png"
                     height="120"
                     width="120"
                     alt="User avatar" />
                <div class="user-info text-center">
                    <h4>@Model.Customer.firstName @Model.Customer.lastName </h4>
                    <span class="badge bg-label-danger rounded-pill">@Model.Customer.gender</span>
                </div>
            </div>
        </div>
       
        <h5 class="pb-3 border-bottom mb-3">Details</h5>
        <div class="info-container">
            <ul class="list-unstyled mb-4">
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">PIN:</span>
                    <span>@Model.Customer.taxIdentificationNumber</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Identity Number:</span>
                    <span>@Model.Customer.idNumber</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Email:</span>
                    <span>@Model.Customer.email</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Status:</span>
                    <span class="badge bg-label-success rounded-pill">
                        @if (@Model.Customer.active)
                        {
                            <label>Active</label>
                        }
                        else
                        {
                            <label>In-Active</label>
                        }
                    </span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Telephone:</span>
                    <span>@Model.Customer.phone</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Home phone number:</span>
                    <span>@Model.Customer.homePhone</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Address:</span>
                    <span>@Model.Customer.address</span>
                </li>
                <li class="mb-3">
                    <span class="fw-medium text-heading me-2">Online banking status</span>
                    <span class="badge bg-label-success rounded-pill">
                        @if (@Model.Customer.isUseOnlineMobileBanking)
                        {
                            <label>Activated</label>
                        }
                        else
                        {
                            <label>Not-active</label>
                        }
                    </span>
                </li>
            </ul>
            <div class="d-flex justify-content-center">
                <a href="javascript:;" class="btn btn-outline-danger suspend-user">Lock this account</a>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4 border-2 border-primary">
    <div class="card-body">
        @*<div class="d-flex justify-content-between align-items-start">
            <span class="badge bg-label-primary rounded-pill">Standard</span>
            <div class="d-flex justify-content-center">
                <sup class="h5 pricing-currency mt-3 mb-0 me-1 text-primary">Total Balance</sup>
                <h1 class="mb-1 text-primary">@Model.balance</h1>
                <sub class="h5 pricing-duration mt-auto mb-2"></sub>
            </div>
        </div>*@
        <h5 class="pb-3 border-bottom mb-3">Registration Info</h5>
        <ul class="list-unstyled g-2 my-4">
            <li class="mb-2 d-flex align-items-center">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span> Organization: @Model.Customer.organisationId</span>
            </li>
            <li class="mb-2 d-flex align-items-center">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Branch office: @Model.Customer.bankId</span>
            </li>
            <li class="mb-2 d-flex align-items-center">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Branch: @Model.Customer.branchId</span>
            </li>
            <li class="mb-2 d-flex align-items-center">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Registration date: @Model.Customer.createdDate</span>
            </li>
            <li class="mb-2 d-flex align-items-center">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Registered by: @Model.Customer.createdBy</span>
            </li>
        </ul>
    </div>
</div>

