@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@{
    ViewBag.Title = "Account Details";
}

<h5 class="py-3 mb-4"><span class="text-muted fw-light">@Model.Customer.firstName @Model.Customer.lastName /@Model.customerId</span>: Account Details</h5>
<div class="col-12">
    <div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <a href="/TransactionManagement/SavingAccounts" class="footer-link me-4">Back to list</a>
                <a href="/TransactionManagement/AccountDetails?KEY=@Model.accountNumber" class="footer-link me-4">Refresh</a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <!-- User Sidebar -->
    <div class="col-xl-4 col-lg-5 col-md-5 order-1 order-md-0">
        @Html.Partial("_CustomerCard")
    </div>
    <div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
        @Html.Partial("_Tabs")
        <div class="col-12">
            @Html.Partial("_Product")
        </div>
    </div>

</div>
@*@Html.Partial("_modal")*@

