@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
@if (Model.Loans.Count == 0)
{
    <div class="text-center my-3">
        <p>@Global_LoanData.NoLoansHaveBeenContractedBy @Model.Customer.name</p>
        <a type="button" onclick="AddORUpdateGen('@Model.Customer.CustomerId','datalistingview','_LoanApplication','loanapplication','MemberOperation',null)" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@Global_LoanData.ApplyForANewLoan">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable_customer_loan">
            <thead class="table-light">
                <tr>
                    <th style="width: 7%">@Global_LoanData.Date</th>
                    <th style="width: 8%">@Global_LoanData.MaturityDate</th>
                    <th style="width: 10%">@Global_LoanData.Principal</th>
                    <th style="width: 7%">@Global_LoanData.InterestRate</th>
                    <th style="width: 8%">@Global_LoanData.AccrualInterest</th>
                    <th style="width: 8%">@Global_LoanData.Tax</th>
                    <th style="width: 8%">@Global_LoanData.Charges</th>
                    <th style="width: 8%">@Global_LoanData.Due</th>
                    <th style="width: 8%">@Global_LoanData.Paid</th>
                    <th style="width: 8%">@Global_LoanData.Balance</th>
                    <th style="width: 8%">@Global_LoanData.LastPayment</th>
                    <th style="width: 7%">@Global_LoanData.Status</th>
                    <th style="width: 7%">@Global_LoanData.State</th>
                    <th style="width: 7%">@Global_LoanData.Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Loans.OrderBy(app => app.DisbursementDate))
                {
                    <tr>
                        <td style="width: 7%">@d.LoanDate</td>
                        <td style="width: 8%">@d.MaturityDate</td>
                        <td style="width: 10%">@d.Principal.ToString("#,0.00")</td>
                        <td style="width: 7%">@d.InterestRate %</td>
                        <td style="width: 8%">@d.AccrualInterest.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Tax.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Penalty.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.DueAmount.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Paid.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Balance.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.LastPayment.ToString("#,0.00")</td>
                        <td style="width: 7%">@d.LoanStatus</td>
                        <td style="width: 7%">
                            @if (d.IsCurrentLoan)
                            {
                                <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@Global_LoanData.Current</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@Global_LoanData.Restructured</span>
                            }
                        </td>
                        <td style="width: 7%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanDetails','loan_detail','MemberOperation','applications')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Global_LoanData.SelectForDetail">
                                @Global_LoanData.Detail
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="1"></td>
                    <td>@Global_LoanData.Principal:</td>
                    <td>@Model.Loans.Sum(x => x.Principal).ToString("#,0.00")</td>
                    <td>@Global_LoanData.Paid:</td>
                    <td>@Model.Loans.Sum(x => x.Paid).ToString("#,0.00")</td>
                    <td>@Global_LoanData.Balance:</td>
                    <td>@Model.Loans.Sum(x => x.Balance).ToString("#,0.00")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

}