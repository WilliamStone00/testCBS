@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
    @using Resources

<fieldset class="fieldset-custom">
    <div class="card mb-4">
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable_customer_loan">
                <thead class="table-light">
                    <tr>
                        <th style="width: 7%">@Global_SelectedLoanData.Select</th>
                        <th style="width: 8%">@Global_SelectedLoanData.MaturityDate</th>
                        <th style="width: 10%">@Global_SelectedLoanData.Principal</th>
                        <th style="width: 7%">@Global_SelectedLoanData.InterestPercentage</th>
                        <th style="width: 8%">@Global_SelectedLoanData.Interest</th>
                        <th style="width: 8%">@Global_SelectedLoanData.DueFee</th>
                        <th style="width: 8%">@Global_SelectedLoanData.Penalty</th>
                        <th style="width: 8%">@Global_SelectedLoanData.Due</th>
                        <th style="width: 8%">@Global_SelectedLoanData.Paid</th>
                        <th style="width: 8%">@Global_SelectedLoanData.Balance</th>
                        <th style="width: 8%">@Global_SelectedLoanData.LastPayment</th>
                        <th style="width: 7%">@Global_SelectedLoanData.Status</th>
                        <th style="width: 7%">@Global_SelectedLoanData.State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SelectLoans.OrderBy(app => app.DisbursementDate))
                    {
                        <tr>
                            <td style="width: 7%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanDetails','loan_detail','MemberOperation','applications')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Global_SelectedLoanData.SelectForDetail">
                                    @Global_SelectedLoanData.Reload
                                </a>
                            </td>
                            <td style="width: 8%">@d.MaturityDate</td>
                            <td style="width: 10%">@d.Principal.ToString("#,0.00")</td>
                            <td style="width: 7%">@d.InterestRate %</td>
                            <td style="width: 8%">@d.AccrualInterest.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.Fee.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.Penalty.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.DueAmount.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.Paid.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.Balance.ToString("#,0.00")</td>
                            <td style="width: 8%">@d.LastPayment.ToString("#,0.00")</td>
                            <td style="width: 7%">@d.LoanStatus</td>
                            <td style="width: 7%">
                                @if (d.IsCurrentLoan)
                                {
                                    <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@Global_SelectedLoanData.Current</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@Global_SelectedLoanData.Restructured</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="1"></td>
                        <td>@Global_SelectedLoanData.Due:</td>
                        <td>@Model.SelectLoans.Sum(x => x.Principal).ToString("#,0.00")</td>
                        <td>@Global_SelectedLoanData.Paid:</td>
                        <td>@Model.SelectLoans.Sum(x => x.Paid).ToString("#,0.00")</td>
                        <td>@Global_SelectedLoanData.PendingDue:</td>
                        <td>@Model.SelectLoans.Sum(x => x.Balance).ToString("#,0.00")</td>
                        <td></td> <!-- Placeholder for the last column -->
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</fieldset>