@using Resources
@{
    ViewBag.Title = @GlobalPendingDisbursment.PendingDisbursement;
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash me-2"></i> @GlobalPendingDisbursment.PendingDisbursement
                </h1>
                <p class="card-text text-muted">
                    @GlobalPendingDisbursment.PendingDisbursementDescription
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalPendingDisbursment.HelpTipsTitle
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">@GlobalPendingDisbursment.HelpTipsDescription</p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.Tip1</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.Tip2</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.Tip3</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.Tip4</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalPendingDisbursment.Tip5</li>
            </ul>
            <p class="text-muted">@GlobalPendingDisbursment.AdditionalNotes</p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalPendingDisbursment.Note1</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalPendingDisbursment.Note2</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalPendingDisbursment.Note3</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <div class="accordion-item active">
                <h2 class="accordion-header d-flex justify-content-between align-items-center text-primary" id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-view-list me-2"></i> @GlobalPendingDisbursment.PendingDisbursementsTitle @Session["BranchName"]
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <!-- Action Card -->
                                <div class="card mb-4">
                                    <div class="card-body d-flex justify-content-start align-items-center">
                                        <a href="/MemberOperation/PendingDisbursment"
                                           class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space"
                                           data-bs-toggle="tooltip"
                                           title="@GlobalPendingDisbursment.RefreshButtonTooltip">
                                            <span class="tf-icons mdi mdi-refresh mdi-18px"></span>
                                        </a>
                                        <span class="ms-3 text-muted">@GlobalPendingDisbursment.RefreshButtonDescription</span>
                                    </div>
                                </div>
                                <!-- Data Listing View -->
                                <div id="datalistingview">
                                    <!-- Data will be dynamically loaded here -->
                                    <p class="text-muted text-center">
                                        @GlobalPendingDisbursment.NoDataMessage
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/OperationPanel/Loans.js"></script>
}
