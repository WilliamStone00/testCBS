@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>@GlobalMembers.Name</th>
                <th>@GlobalMembers.Reference</th>
                <th>@GlobalMembers.ActiveStatus</th>
                <th>@GlobalMembers.Phone</th>
                <th>@GlobalMembers.Branch</th>
                <th>@GlobalMembers.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Customers)
            {
                <tr>
                    <td style="width:20%">@d.name</td>
                    <td style="width:8%">@d.CustomerId</td>
                    <td style="width:8%">
                        @if (d.ActiveStatus == "Active")
                        {
                            <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalMembers.Active</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalMembers.Blocked</span>
                        }
                    </td>
                    <td style="width:8%">@d.Phone</td>
                    <td style="width:33%">@d.branch</td>
                    <td style="width:15%">
                        <a href="/MemberOperation/OperationPanel?KEY=@d.CustomerId" target="_blank" class="mr-2" data-toggle="tooltip" data-placement="top" title="@d.name @GlobalMembers.SelectToVisitLoanPanel ">
                            <i class="mdi mdi-folder mr-1"></i>
                            @GlobalMembers.LoanPanel
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



