@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalPendingDisbursment.HelpTipsTitle</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">@GlobalPendingDisbursment.FollowTheseTipsForASmoothDisbursementProcess</p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.EnsureThatTheLoanHasBeenApprovedBeforeProceedingWithDisbursement</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.UseTheDropdownToSelectTheCorrectAccountForCreditingTheDisbursedAmount</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.CheckTheAlreadyManagedBoxIfTheMoneyHasAlreadyBeenDisbursedToPreventDoubleDisbursement</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPendingDisbursment.IncludeDetailedCommentsForBetterTrackingAndRecordKeeping</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalPendingDisbursment.VerifyAllEnteredDetailsIncludingAccountNumbersAndCustomerInformationBeforeSubmitting</li>
            </ul>
            <p class="text-muted">@GlobalPendingDisbursment.AdditionalNotes</p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalPendingDisbursment.TheSystemWillAutomaticallyUpdateTheLoanStatusOnceDisbursementIsCompleted</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalPendingDisbursment.EnsureComplianceWithTheOrganizationsLoanDisbursementPolicies</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalPendingDisbursment.ForAnyDiscrepanciesConsultTheLoanManagerImmediately</li>
            </ul>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <!-- Loan Disbursement Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingLoanDisbursement">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseLoanDisbursement"
                            aria-expanded="true"
                            aria-controls="collapseLoanDisbursement">
                        @GlobalPendingDisbursment.LoanDisbursement
                    </button>
                </h2>

                <div id="collapseLoanDisbursement"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            @Html.HiddenFor(m => m.AddLoanDisbumentCommand.LoanId)
                            @Html.HiddenFor(m => m.Loan.CustomerId)
                            @Html.HiddenFor(m => m.Loan.CustomerName)
                            @Html.HiddenFor(m => m.Loan.BranchCode)
                            <input type="hidden" name="ServiceOption" value="pending_loan_disbursement" id="ServiceOption" />

                            <fieldset class="fieldset-custom">
                                <div class="row g-4">

                                    <!-- 🗓️ Accounting Date -->
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline position-relative">
                                            @Html.TextBoxFor(
                                              m => m.AddLoanDisbumentCommand.AccountingDate,
                                              Model.AddLoanDisbumentCommand.AccountingDate == default(DateTime)
                                                ? DateTime.Today.ToString("yyyy-MM-dd")
                                                : "{0:yyyy-MM-dd}",
                                              new
                                                {
                                                @class = "form-control accounting-date",
                                                type = "date",
                                                data_date_default = "today",   // auto-fill today if empty/MinValue
                                                data_date_max = "today"        // prevent future dates (remove if not needed)
                                                // data_date_min = "today"     // uncomment to only allow today & after
                                              })
                                            @Html.ValidationMessageFor(m => m.AddLoanDisbumentCommand.AccountingDate, "", new { @class = "text-danger" })
                                            <label>@(Member_Global_LoanApplication.AccountingDate ?? "Accounting Date")</label>

                                            <span class="position-absolute top-0 end-0 translate-middle-y mt-3 me-3 badge bg-open-green px-3">
                                                <i class="mdi mdi-calendar-check-outline me-1"></i>
                                                <span id="PendingDisbAccountingDateBadge"></span>
                                            </span>
                                        </div>
                                        <small class="text-muted">
                                            This date will be used as the accounting date for this disbursement (posting & audit).
                                        </small>
                                    </div>

                                    <!-- Checkbox -->
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.AddLoanDisbumentCommand.IsAlreadyManage, new { @class = "form-check-input", id = "isAlreadyManage", @disabled = "disabled" })
                                            <label class="form-check-label" for="isAlreadyManage">
                                                @GlobalPendingDisbursment.CheckIfTheCustomerAlreadyReceivedTheMoneyThenCashWillNotBeAffected
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Status Dropdown -->
                                    <div class="col-md-12">
                                        <div class="form-floating">
                                            @Html.DropDownListFor(m => m.AddLoanDisbumentCommand.Status, new SelectList(ViewBag.DisbursmentStatuses, "Value", "Text"), "---@GlobalPendingDisbursment.Select---", new { @class = "form-control select2", @search = "true", id = "statusDropdown" })
                                            @Html.ValidationMessageFor(m => m.AddLoanDisbumentCommand.Status, "", new { @class = "text-danger" })
                                            <label for="statusDropdown">@GlobalPendingDisbursment.SelectDisbursedStatus</label>
                                        </div>
                                    </div>

                                    <!-- Account Number Dropdown -->
                                    <div class="col-md-12">
                                        <div class="form-floating">
                                            @Html.DropDownListFor(m => m.AddLoanDisbumentCommand.AccountNumber, new SelectList(ViewBag.CustomerAccounts, "Value", "Text"), "---"+@GlobalPendingDisbursment.SelectAccountToReceiveDisbursedAmount+"---", new { @class = "form-control select2", @search = "true", id = "accountDropdown", onchange = "updateComment()" })
                                            @Html.ValidationMessageFor(m => m.AddLoanDisbumentCommand.AccountNumber, "", new { @class = "text-danger" })
                                            <label for="accountDropdown">@GlobalPendingDisbursment.SelectAccountToReceiveDisbursedAmount</label>
                                        </div>
                                    </div>

                                    <!-- Comment Text Area -->
                                    <div class="col-md-12">
                                        <div class="form-floating">
                                            @Html.TextAreaFor(m => m.AddLoanDisbumentCommand.Comment, new { @class = "form-control", style = "height: 200px;", id = "commentTextArea" })
                                            @Html.ValidationMessageFor(m => m.AddLoanDisbumentCommand.Comment, "", new { @class = "text-danger" })
                                            <label for="commentTextArea">@GlobalPendingDisbursment.Comment</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        @GlobalPendingDisbursment.Disburse
                                    </button>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function updateComment() {
        const accountDropdown = document.getElementById('accountDropdown');
        const commentTextArea = document.getElementById('commentTextArea');
        const selectedOption = accountDropdown.options[accountDropdown.selectedIndex];

        // Fetch values from hidden fields
        const loanId = document.querySelector("input[name='AddLoanDisbumentCommand.LoanId']").value || "N/A";
        const customerId = document.querySelector("input[name='Loan.CustomerId']").value || "N/A";
        const customerName = document.querySelector("input[name='Loan.CustomerName']").value || "N/A";
        const branchCode = document.querySelector("input[name='Loan.BranchCode']").value || "N/A";
        const defaultAccount = "Not yet selected";

        // Construct the comment with a fallback default message
        const accountNumber = selectedOption && selectedOption.value ? selectedOption.value : defaultAccount;

        // Construct the professional comment
        commentTextArea.value = `
Loan Disbursement Details:
- Customer Name: ${customerName}
- Customer ID: ${customerId}
- Branch Code: ${branchCode}
- Loan ID: ${loanId}
- Account Number for Credit: ${accountNumber}

The loan amount has been successfully disbursed after completing all necessary validations and approval processes. Documentation has been updated accordingly.

For inquiries, please contact the Loan Manager or the Branch Admin.
        `.trim();
    }

    window.onload = function () {
        updateComment();
    };
</script>
