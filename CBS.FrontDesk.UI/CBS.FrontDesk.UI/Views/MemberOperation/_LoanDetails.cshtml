@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account me-2"></i>
                        @Global_LoanDetails.LoanDetails
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div class="card mb-4">
                                    <div class="card-body d-sm-flex d-block">
                                        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                            <a href="/MemberOperation/OperationPanel?KEY=@Model.Loan.CustomerId" data-bs-toggle="tooltip" title="@Global_LoanDetails.ViewAllLoans">
                                                <span>@Global_LoanDetails.ViewAllLoans</span>
                                            </a>
                                            <div class="ms-3">
                                                <button type="button" class="btn btn-primary" onclick="AddORUpdateGen(@Model.LoanApplication.Id,'datalistingview','_LoanCommiteeValidation','loan_commitee_validation_history','MemberOperation','applications')">@Global_LoanDetails.CommeteeValidation</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @Html.Partial("_SelectedLoanData")
                                <br />
                                <div id="datalistingview_loan_details">
                                    <div class="col">
                                        @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                                        {
                                            @Html.HiddenFor(m => m.Customer.CustomerId)

                                            <div class="row my-4">
                                                <div class="accordion" id="collapsibleSection">
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingDeliveryAddress">
                                                            <button type="button"
                                                                    class="accordion-button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseDeliveryAddress"
                                                                    aria-expanded="true"
                                                                    aria-controls="collapseDeliveryAddress">
                                                                @Global_LoanDetails.LoanTerm
                                                            </button>
                                                        </h2>
                                                        <div id="collapseDeliveryAddress"
                                                             class="accordion-collapse collapse show"
                                                             data-bs-parent="#collapsibleSection">
                                                            <div class="accordion-body">
                                                                <div class="row g-4">

                                                                    @Html.Partial("_LoanTerm")

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingPaymentMethod4">
                                                            <button type="button"
                                                                    class="accordion-button collapsed"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapsePaymentMethod4"
                                                                    aria-expanded="false"
                                                                    aria-controls="collapsePaymentMethod4">
                                                                @Global_LoanDetails.LoanSchedule
                                                            </button>
                                                        </h2>
                                                        <div id="collapsePaymentMethod4"
                                                             class="accordion-collapse collapse"
                                                             aria-labelledby="headingPaymentMethod4"
                                                             data-bs-parent="#collapsibleSection">
                                                            <div class="accordion-body">
                                                                <div class="row g-4">
                                                                    @Html.Partial("_LoanSimulationScheduleData");
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingDeliveryOptions">
                                                            <button type="button"
                                                                    class="accordion-button collapsed"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseDeliveryOptions"
                                                                    aria-expanded="false"
                                                                    aria-controls="collapseDeliveryOptions">
                                                                @Global_LoanDetails.LoanCollateral
                                                            </button>
                                                        </h2>
                                                        <div id="collapseDeliveryOptions"
                                                             class="accordion-collapse collapse"
                                                             aria-labelledby="headingDeliveryOptions"
                                                             data-bs-parent="#collapsibleSection">
                                                            <div class="accordion-body">
                                                                <div class="row g-4">
                                                                    @Global_LoanDetails.CollateralGoesHere
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingPaymentMethod">
                                                            <button type="button"
                                                                    class="accordion-button collapsed"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapsePaymentMethod"
                                                                    aria-expanded="false"
                                                                    aria-controls="collapsePaymentMethod">
                                                                @Global_LoanDetails.Expenses
                                                            </button>
                                                        </h2>
                                                        <div id="collapsePaymentMethod"
                                                             class="accordion-collapse collapse"
                                                             aria-labelledby="headingPaymentMethod"
                                                             data-bs-parent="#collapsibleSection">

                                                            <div class="accordion-body">
                                                                <div class="row g-4">
                                                                    @Global_LoanDetails.ExpensesGoHere
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingPaymentMethod7">
                                                            <button type="button"
                                                                    class="accordion-button collapsed"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapsePaymentMethod7"
                                                                    aria-expanded="false"
                                                                    aria-controls="collapsePaymentMethod7">
                                                                @Global_LoanDetails.LoanFiles
                                                            </button>
                                                        </h2>
                                                        <div id="collapsePaymentMethod7"
                                                             class="accordion-collapse collapse"
                                                             aria-labelledby="headingPaymentMethod7"
                                                             data-bs-parent="#collapsibleSection">

                                                            <div class="accordion-body">
                                                                <div class="row g-4">

                                                                    @Global_LoanDetails.LoanFilesGoHere
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="card accordion-item mb-3">
                                                        <h2 class="accordion-header" id="headingPaymentMethod8">
                                                            <button type="button"
                                                                    class="accordion-button collapsed"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapsePaymentMethod8"
                                                                    aria-expanded="false"
                                                                    aria-controls="collapsePaymentMethod8">
                                                                @Global_LoanDetails.LoanComments
                                                            </button>
                                                        </h2>
                                                        <div id="collapsePaymentMethod8"
                                                             class="accordion-collapse collapse"
                                                             aria-labelledby="headingPaymentMethod8"
                                                             data-bs-parent="#collapsibleSection">

                                                            <div class="accordion-body">
                                                                <div class="row g-4">
                                                                    @Global_LoanDetails.LoanCommentsGoHere
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>


                                                </div>

                                            </div>


                                        }
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

    </div>
</div>