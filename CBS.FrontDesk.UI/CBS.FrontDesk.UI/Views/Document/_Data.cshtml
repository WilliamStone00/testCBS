@model List<CBS.FrontDesk.Data.Entity.LoanConf.Document>
    @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalDocument.Name</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:85%">@d.Name</td>
                <td style="width:15%">
                    <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','Document')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> | 
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('Document','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

