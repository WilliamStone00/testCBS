@model CBS.FrontDesk.Data.Entity.SavingProducts.TransactionReversal
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">Data listings </legend>
    @if (Model.ReversalRequests.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalTransactionReversal.NoDataFound</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalTransactionReversal.Date</th>
                        <th>@GlobalTransactionReversal.Amount</th>
                        <th>@GlobalTransactionReversal.Incident</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalTransactionReversal.InitiatedBy</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.ReversalRequests)
                    {
                        <tr>
                            <td style="width:20%">@d.RequestDate</td>
                            <td style="width:10%">@d.Amount.ToString("#,##0.0")</td>
                            <td style="width:30%">@d.Reason</td>
                            <td style="width:10%">
                                @if (d.Status == "Approved")
                                {
                                    <span class="badge bg-info">@GlobalShared.Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@d.Status</span>
                                }
                            </td>
                            <td style="width:20%">@d.InitiatedBy</td>
                            <td style="width:20%">
                                @if (d.Status == "Approved")
                                {
                                    <a href="/TransactionReversal/RequestTreatmentForm?key=@d.Id" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalTransactionReversal.TreateRequest">@GlobalTransactionReversal.CompleteRequest</a>
                                }
                                else
                                {
                                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="">@GlobalTransactionReversal.NoAction</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>



    }


</fieldset>
