@model CBS.FrontDesk.Data.Entity.Accounting.TransactionTrackerConfiguration

@{
    ViewBag.Title = "Banking Reconciliation Interface";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@section Styles {
    <style type="text/css">
