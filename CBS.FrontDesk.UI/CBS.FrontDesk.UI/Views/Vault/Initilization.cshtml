@model CBS.FrontDesk.Data.Entity.VaultManagement.Vault
    @using Resources
@{
    ViewBag.Title = "Vault Initialization";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalVault.VaultInitialization
                </h1>
                <p class="card-text text-muted">
                    @GlobalVault.ManageTheInitializationProcessOfTheVaultEfficiently.
                </p>
                <p class="card-text text-danger fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    @GlobalVault.VaultInitializationIsAcriticalStepEspeciallyAfterSystemMigration.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalVault.HELPTIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                @GlobalVault.VaultInitializationEnsuresAccurateRecordsOfCash:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalVault.EnsureAllDenominationsAreAccuratelyEntered.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalVault.VerifyThatTotalsMatchTheExpectedAmountsInTheVault.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> @GlobalVault.IfThe <strong>@GlobalVault.InitializeVaultButtonIsGreyedOut</strong>, @GlobalVault.itIndicatesMismatchedValuesOrMissingInformation.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalVault.EnsureTheVaultBalanceReflectsThePhysicalCashAvailable.</li>
            </ul>
            <p class="text-muted">@GlobalVault.ForExample:</p>
            <ul class="list-unstyled">
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalVault.IfYouHave5NotesOfN10000Enter5UnderTheN10000Field.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalVault.TheSystemWillAutomaticallyCalculateTheTotalForAllDenominations.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            @GlobalVault.VaultInitialization
                        </button>
                    </h2>
                   
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div class="accordion-body">
                                <div id="mainviewChange">
                                    <div class="card mb-1">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" onclick="LoadDataGen('Vault','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>
                                            <a type="button" href="" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalVault.InitialiseTheVaultOfThisBranch">
                                                <i class="fas fa-cogs me-1"></i> @GlobalVault.Initialize
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_VaultInitializationForm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="vaultDetailsModal" tabindex="-1" aria-labelledby="vaultDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header p-2">
                <header class="w-100 text-center">
                    <h4 class="text-primary fw-bold mb-1">
                        <i class="mdi mdi-lock me-2"></i> @GlobalVault.VAULT_DETAILS
                    </h4>
                    <p class="text-muted mb-0">
                        @GlobalVault.ViewDetailsAndManageVaultRelatedInformationEfficiently.
                    </p>
                    <hr style="border: 1px solid rgba(128, 128, 128, 0.5);" />
                </header>
            </div>
            <div class="modal-body p-2">
                <div id="vaultDetailsContent">
                    <!-- Partial view or dynamic content will be loaded here -->
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
  
}
