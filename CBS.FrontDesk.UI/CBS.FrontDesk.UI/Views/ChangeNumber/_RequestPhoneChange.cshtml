@model CBS.FrontDesk.Data.Entity.ChangeNumber.ChangeNumberCarrier
@using Resources
<div class="row">
    <!-- Right Section: Profile & CNI Image (3 cols) -->
    <div class="col-md-3">
        <fieldset class="fieldset-custom p-3 rounded shadow-sm">
            <legend class="fw-bold text-primary">
                <i class="mdi mdi-account-box me-2"></i> @GlobalChangeNumber.MEMBERDETAILS
            </legend>
            <div class="card-body text-center">
                <!-- Profile Image -->
                <div class="mb-3">
                    <img src="@Model.Customer.photoUrl" id="profileImage" class="img-fluid rounded shadow-sm"
                         style="width: 100%; height: auto; cursor: pointer;" alt="Profile Image"
                         onclick="viewImage('@Model.Customer.photoUrl')">
                    <p class="fw-bold text-muted mt-2">@GlobalShared.ProfileImage</p>
                </div>
                <!-- CNI Image -->
                <div>
                    <img src="@Model.Customer.signatureUrl" id="cniImage" class="img-fluid rounded shadow-sm"
                         style="width: 100%; height: auto; cursor: pointer;" alt="CNI Image"
                         onclick="viewImage('@Model.Customer.signatureUrl')">
                    <p class="fw-bold text-muted mt-2">@GlobalShared.CNIImage</p>
                </div>
            </div>
        </fieldset>
    </div>

    <!-- Left Section: Form Inputs (9 cols) -->
    <div class="col-md-9">
        <fieldset class="fieldset-custom p-3 rounded shadow-sm">
            <legend class="fw-bold text-primary">
                <i class="mdi mdi-phone-edit me-2"></i> @GlobalChangeNumber.REQUESTPHONENUMBERCHANGE
            </legend>

            <div class="card-body">
                <div class="row">
                    <!-- Member ID -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline mb-3">
                            @Html.TextBoxFor(m => m.ChangePhoneNumberRequestCommand.CustomerId, new { @class = "form-control", @readonly = "readonly", @id = "CustomerId" })
                            <label for="CustomerId"><i class="mdi mdi-account me-1"></i> @GlobalChangeNumber.MemberID</label>
                        </div>
                    </div>

                    <!-- Member Name -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline mb-3">
                            @Html.TextBoxFor(m => m.Customer.name, new { @class = "form-control", @readonly = "readonly" })
                            <label for="MemberName"><i class="mdi mdi-account-circle me-1"></i> @GlobalChangeNumber.MemberName</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Branch Name -->
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline mb-3">
                            @Html.TextBoxFor(m => m.Customer.branch, new { @class = "form-control", @readonly = "readonly" })
                            <label for="Branch"><i class="mdi mdi-domain me-1"></i> @GlobalChangeNumber.BranchName</label>
                        </div>
                    </div>


                </div>

                @using (Html.BeginForm("Create", "ChangeNumber", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    @Html.HiddenFor(m => m.ChangePhoneNumberRequestCommand.CustomerId)

                    <div class="row">
                        <!-- New Phone Number -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberRequestCommand.NewPhoneNumber, new
                                    { @class = "form-control", type = "tel", id = "NewPhoneNumber", placeholder = @GlobalChangeNumber.EnterNewPhoneNumber , required = "required" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberRequestCommand.NewPhoneNumber, "", new { @class = "text-danger" })

                                <label for="NewPhoneNumber"><i class="mdi mdi-phone-incoming me-1"></i> @GlobalChangeNumber.NewPhoneNumber</label>
                                <span class="text-danger" id="newPhoneError"></span>
                            </div>
                        </div>

                        <!-- Old Phone Number -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberRequestCommand.OldPhoneNumber, new
                           { @class = "form-control", @readonly = "readonly", type = "tel", id = "OldPhoneNumber", required = "required" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberRequestCommand.OldPhoneNumber, "", new { @class = "text-danger" })

                                <label for="OldPhoneNumber"><i class="mdi mdi-phone-classic me-1"></i> @GlobalChangeNumber.OldPhoneNumber</label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- OTP Code Input -->
                        @*<div class="col-md-6">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="number" id="OtpCode" name="OtpCode" class="form-control" placeholder="Enter OTP" required>
                                <label for="OtpCode"><i class="mdi mdi-key me-1"></i> OTP Code</label>
                                <span class="text-danger" id="otpError"></span>
                            </div>
                        </div>*@
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberRequestCommand.OtpCode, new { @class = "form-control", id = "OtpCode", @placeholder = @GlobalChangeNumber.EnterOTP, required = "required" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberRequestCommand.OtpCode, "", new { @class = "text-danger" })

                                <label for="OtpCode"><i class="mdi mdi-phone-classic me-1"></i> @GlobalChangeNumber.EnterOTPCode</label>
                            </div>
                        </div>
                        <!-- Send OTP Button -->
                        <div class="col-md-6 d-flex align-items-center">
                            <button type="button" class="btn btn-warning w-100" onclick="sendOTP()">
                                <i class="mdi mdi-send"></i> @GlobalChangeNumber.SendOTP
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Request Comment -->
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.TextAreaFor(m => m.ChangePhoneNumberRequestCommand.RequestComment, new
                                    { @class = "form-control", style = "height: 120px; width: 100%; resize: none;", placeholder = @GlobalChangeNumber.EnterRequestReason, required = "required" })
                                <label for="RequestComment"><i class="mdi mdi-comment-text me-1"></i> @GlobalChangeNumber.RequestComment</label>
                                <span class="text-danger" id="commentError"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-md-12 d-flex justify-content-end">
                            <button type="reset" class="btn btn-outline-secondary me-2">
                                <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="mdi mdi-content-save"></i> @GlobalShared.SubmitRequest
                            </button>
                        </div>
                    </div>
                }
            </div>
        </fieldset>
    </div>
</div>

<!-- Modal for Image Preview -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary"><i class="mdi mdi-image me-1"></i> @GlobalShared.ViewImage</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="previewImage" src="" class="img-fluid rounded shadow-sm" alt="Preview Image">
            </div>
        </div>
    </div>
</div>

<script>
    function viewImage(imageUrl) {
        $("#previewImage").attr("src", imageUrl);
        $("#imagePreviewModal").modal("show");
    }
    function sendOTP() {
        var phoneNumber = $("#NewPhoneNumber").val();
        var customerId = $("#CustomerId").val();
        var oldPhoneNumber = $("#OldPhoneNumber").val();

        if (!phoneNumber) {
            appalert("Please enter a valid phone number and ensure the member ID is available.", 2, 1)
            return;
        }

        alertify.confirm(
            "Confirm OTP Request",
            "Are you sure you want to send an OTP and change the member's phone number from <b>" + oldPhoneNumber + "</b> to <b>" + phoneNumber + "</b>?",
            function () {
                // If user confirms, proceed with sending OTP
                $.ajax({
                    url: '/ChangeNumber/SendOTP',
                    type: 'POST',
                    data: { phoneNumber: phoneNumber, customerId: customerId },
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message, 1, 1)
                        } else {
                            appalert(response.message, 2, 1)
                        }
                    },
                    error: function () {
                        appalert("Error sending OTP. Please check your connection.", 3, 1)

                    }
                });
            },
            function () {
                appalert("OTP request was canceled.", 3, 1)
            }
        );
    }

</script>
