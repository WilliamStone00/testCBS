@model CBS.FrontDesk.Data.Entity.Accounting.AccountingRuleEntry
 @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "AccountingEntryRule", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <label for="AccountingRuleEntryName">@GlobalAccountingEntryRule.RuleEntryName</label>
                @Html.TextBoxFor(model => model.AccountingRuleEntryName, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.AccountingRuleEntryName, "", new { @class = "text-danger" })

            </div>

            <div class="col-md-6">

                <label for="OperationEventId">@GlobalAccountingEntryRule.Event</label>
                @Html.DropDownListFor(m => m.OperationEventId, new SelectList(ViewBag.OperationEvent == null ? "" : ViewBag.OperationEvent, "Id", "OperationEventName"), "---"+ @GlobalAccountingEntryRule.SelectOperationEventAttribute+"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(model => model.OperationEventId, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">

                <label for="OperationEventAttributeId">@GlobalAccountingEntryRule.OperationEventAttribute </label>
                @Html.DropDownListFor(m => m.OperationEventAttributeId, new SelectList(ViewBag.OperationEventAttributes == null ? "" : ViewBag.OperationEventAttributes, "Id", "Name"), "---"+ @GlobalAccountingEntryRule.SelectOperationEventAttribute+ "---", new { @class = "form-control select2", @search = "true" })

                @Html.ValidationMessageFor(model => model.OperationEventAttributeId, "", new { @class = "text-danger" })

            </div>

            <div class="col-md-6">
                <label for="BookingDirection">@GlobalAccountingEntryRule.BookingDirection</label>
                @Html.DropDownListFor(m => m.BookingDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---"+ @GlobalAccountingEntryRule.SelectBookingDirection+"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(model => model.BookingDirection, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">
                <label for="DebitAccountId">@GlobalAccountingEntryRule.DeterminationAccount</label>
                @Html.DropDownListFor(m => m.DeterminationAccountId, new SelectList(ViewBag.DebitAccounts == null ? "" : ViewBag.DebitAccounts, "Text", "Value"), "---"+ @GlobalAccountingEntryRule.SelectAccount +"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(model => model.DeterminationAccountId, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">

                <label for="CreditAccountId">@GlobalAccountingEntryRule.BalancingAccount</label>
                @Html.DropDownListFor(m => m.BalancingAccountId, new SelectList(ViewBag.CreditAccounts == null ? "" : ViewBag.CreditAccounts, "Text", "Value"), "---"+ @GlobalAccountingEntryRule.SelectAccount+"---", new { @class = "form-control select2", @search = "true" })

                @Html.ValidationMessageFor(model => model.BalancingAccountId, "", new { @class = "text-danger" })

            </div>



        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
        </div>
    }
</div>



