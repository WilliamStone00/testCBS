@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
    @using Resources
@{
    ViewBag.Title = "Loan Product Accounting Configurations";

}

<h2>@GlobalLoanProduct.LoanProductAccountingConfigurations</h2>
<fieldset class="fieldset-custom">


    @foreach (var tab in Model.ProductAccountingCharts)
    {
        <legend>@tab.ProductName</legend>
        <div class="table-responsive mb-3">

            <table class="table table-hover" id="myDataTable">
                <thead>
                    <tr>
                        <th>@GlobalLoanProduct.OperationEvent</th>
                        <th>@GlobalLoanProduct.AccountNumber</th>
                        <th>@GlobalLoanProduct.Description</th>
                        <th>@GlobalLoanProduct.Status</th>
                    </tr>
                </thead>

                @foreach (var d in @tab.AccountingChart)
                {

                    <tbody>

                        <tr>
                            <td style="width:25%">@d.OperationEvent</td>
                            <td style="width:20%">@d.AccountNumber</td>
                            <td style="width:30%">@d.Description</td>
                            <td style="width:25%">@d.Status</td>

                        </tr>

                    </tbody>
                }
            </table>
        </div>


    }
</fieldset>
