@model List<CBS.FrontDesk.Data.Entity.Accounting.ChartOfAccountDto>
    @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalAccountingChart_Data.AccountNumber</th>
            <th>@GlobalAccountingChart_Data.Description</th>
            <th>@GlobalAccountingChart_Data.BalanceSheetAccount</th>
            <th>@GlobalAccountingChart_Data.IsDirectAccount</th>
            <th>@GlobalAccountingChart_Data.RootAccount</th>
            <th>@GlobalAccountingChart_Data.Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                foreach (var d in Model)
                {
                    <tr>

                        <td style="width:35%">@d.AccountNumber : @d.LabelEn</td>
                        <td style="width:25%">@d.LabelEn</td>
                        <td style="width:5%">@d.IsBalanceAccount</td>
                        <td style="width:5%">@d.RootParentId</td>
                        <td style="width:20%">@d.LabelFr</td>
                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen('@d.RootParentId','datalistingview','_Update','update','AccountingChart')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(@GlobalAccountingChart_Data.SelectToEdit, d.AccountNumber)">@GlobalAccountingChart_Data.Edit</a>
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(@GlobalAccountingChart_Data.Delete, d.AccountNumber)" onclick="DeleteRecordDataTable('ChartOfAccount','@d.RootParentId','myDataTable','_Data',0,'datalistingview')">@GlobalAccountingChart_Data.Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {

            }

        }
    </tbody>
</table>