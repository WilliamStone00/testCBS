@model CBS.FrontDesk.Data.Entity.Accounting.ChartOfAccount
@using Resources
<div class="row">
    <!-- Context Menu -->
    <div class="card-body mb-auto">

        <div class="card-body">
            @if (@Model.Id == null)
            {
                <div class="misc-wrapper text-center">
                    <br /> <br />    <br /> <br />
                    <h1 class="mb-2 mx-2" style="font-size: 3rem">422</h1>
                    <h4 class="mb-2">@GlobalAccountingChart_Create.Danger</h4>
                    <p class="mb-2 mx-2">@GlobalAccountingChart_Create.SelectAccountRubrique</p>
                    <div class="d-flex justify-content-center mt-5">

                        <div>
                            <a href="/AccountingConfiguration" class="btn btn-primary text-center my-5">@GlobalAccountingChart_Create.ReloadPage</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0" style="font-size: 0.95em;">@GlobalAccountingChart_Create.AddNewAccountRubrique @Model.AccountNumber-@Model.LabelEn<br><br>@GlobalAccountingChart_Create.AccountNumberStart @Model.AccountNumber </h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "AccountingChart", FormMethod.Post, new { id = "chartOfAccountForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateChartOfAccount(this);" }))
                    {
                        @Html.HiddenFor(model => model.ParentAccountId) <!-- Hidden field for AccountNumber -->

                        <div class="form-floating form-floating-outline mb-4">
                            @Html.TextBoxFor(model => model.AccountNumber, new { @class = "form-control", placeholder = String.Format(GlobalAccountingChart_Create.AccountNumberPlaceholder) })
                            @Html.LabelFor(model => model.AccountNumber, new { @for = "accountNumber" })
                            @Html.ValidationMessageFor(model => model.AccountNumber, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-floating form-floating-outline mb-4">
                            @Html.TextBoxFor(model => model.LabelEn, new { @class = "form-control", placeholder = String.Format(GlobalAccountingChart_Create.AccountLabelPlaceholder) })
                            <label>@GlobalAccountingChart_Create.AccountLabelEnglish</label>
                            @Html.ValidationMessageFor(model => model.LabelEn, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-floating form-floating-outline mb-4">
                            @Html.TextBoxFor(model => model.LabelFr, new { @class = "form-control", placeholder =  String.Format(GlobalAccountingChart_Create.AccountLabelPlaceholder) })
                            <label>@GlobalAccountingChart_Create.AccountLabelFrench</label>
                            @Html.ValidationMessageFor(model => model.LabelFr, "", new { @class = "text-danger" })
                        </div>

                        @*<div class="form-floating form-floating-outline mb-4">
                                @Html.DropDownListFor(model => model.OperationDirection, new SelectList(ViewBag.OperationDirection == null ? "" : ViewBag.OperationDirection, "Text", "Value"), "@GlobalAccountingChart_Create.SelectBookingDirection", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(model => model.OperationDirection, "", new { @class = "text-danger" })
                                <label>@GlobalAccountingChart_Create.BookingDirection</label>
                            </div>*@

                        <div class="form-floating form-floating-outline mb-4">
                            @Html.DropDownListFor(model => model.AccountCartegoryId, new SelectList(ViewBag.AccountCartegories == null ? "" : ViewBag.AccountCartegories, "Id", "Name"), String.Format(GlobalAccountingChart_Create.SelectCategory), new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(model => model.AccountCartegoryId, "", new { @class = "text-danger" })
                            <label>@GlobalAccountingChart_Create.AccountCategory</label>
                        </div>
                        @*<div class="form-check mb-4">
                                @Html.CheckBoxFor(model => model.CanBeNegative, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.CanBeNegative, new { @class = "form-check-label" })
                            </div>
                            <div class="form-check mb-4">
                                @Html.CheckBoxFor(model => model.IsBalanceSheetAccount, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.IsBalanceSheetAccount, new { @class = "form-check-label" })
                            </div>*@
                        <button type="submit" id="Add" class="btn btn-primary waves-effect waves-light">@GlobalAccountingChart_Create.Save</button>

                    }
                </div>
            }
        </div>
    </div>
</div>