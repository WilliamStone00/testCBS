@model List<CBS.FrontDesk.Data.Entity.LoanConf.Fee>
    @using Resources
<fieldset class="fieldset-custom">
    <legend>Data</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>No loan fee type is created</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalFee.Name</th>
                        <th>@GlobalFee.Type</th>
                        <th>@GlobalFee.PaymentStatus</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:60%">@d.Name</td>
                            <td style="width:10%">@d.FeeBase</td>
                            <td style="width:15%">
                                @if (d.IsBoforeProcesing)
                                {
                                    <span class="badge bg-info">@GlobalFee.BeforeProcessing</span>
                                }
                                else
                                {
                            <span class="badge bg-warning">@GlobalFee.DuringDisburstment</span>
                                }
                            </td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','Fee')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('Fee','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
    </fieldset>


