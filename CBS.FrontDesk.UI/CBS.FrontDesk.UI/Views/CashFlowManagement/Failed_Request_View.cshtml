@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.FailedCashReplenishmentRequest;

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    <span style="color:red"> @GlobalCashFlowManagement.RequestReferenceId :  @GlobalCashFlowManagement.NotSent </span>
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@GlobalCashFlowManagement.CashReplenishmentDetails</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            <tr>
                                <td>@GlobalCashFlowManagement.DailyOperationReference </td>
                                <td>@GlobalCashFlowManagement.NotSent  </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.AmountRequested</td>
                                <td>@Model.CashReplenimentRequest.AmountRequested.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestMessage</td>
                                <td>@Model.CashReplenimentRequest.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedBy </td>
                                <td> @Model.CashReplenimentRequest.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedDate</td>
                                <td>@Model.CashReplenimentRequest.IssuedDate </td>
                            </tr>
                            <tr>
                              

                                <td> @GlobalCashFlowManagement.Status</td>
                                @if (@Model.CashReplenimentRequest.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.CashReplenimentRequest.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.CashReplenimentRequest.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequest.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequest.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-header" style="color:red">@GlobalCashFlowManagement.YourCashReplenishmentRequestFailed  </h5>
                    <br>
                    <div class="col-12 shift-right">
                        <br>
                        <button type="submit" class="btn btn-primary click-to-go-back-to-menu" onclick="refreshPageHome()">@GlobalShared.BackToHome. </button>

                    </div>
                    <br>
                </div>

            </div>
        </div>


    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/CashFlowManagement.js"></script>
}