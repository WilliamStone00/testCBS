@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.ViewCashDepositRequestDetails;

}
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{
    @Html.Partial("_GeneralErrorDiv")
}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            @*<h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId :@Model.DepositNotificationDto.BranchId Amount : FCFA  @Convert.ToDecimal(Model.DepositNotificationDto.Amount).ToString("N")
                </button>
            </h2>*@
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@GlobalCashFlowManagement.CashReplenishmentDetails</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>@GlobalCashFlowManagement.BranchOffice</td>
                                    <td>@Model.DepositNotificationDto.BranchOffice </td>
                                </tr>
                            }

                        <tr>
                            <td>@GlobalCashFlowManagement.Amount to deposit</td>
                            <td>FCFA @Convert.ToDecimal(Model.DepositNotificationDto.Amount).ToString("N")</td>
                        </tr>>
                            <tr>
                                <td> @GlobalCashFlowManagement.Message</td>
                                <td>@Model.DepositNotificationDto.Message </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.IssuedBy </td>
                                <td> @Model.DepositNotificationDto.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.IssuedDate</td>
                                <td>@Model.DepositNotificationDto.IssueDate </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.Status</td>
                                @if (@Model.DepositNotificationDto.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.DepositNotificationDto.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-title">@GlobalCashFlowManagement.BankDepositRequestStatus</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.DepositNotificationDto.IsApproved)
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">@GlobalCashFlowManagement.TheDepositCashRequestOf FCFA @{ (Convert.ToDecimal(Model.DepositNotificationDto.Amount)).ToString("N");}Issued by @Model.DepositNotificationDto.IssuedBy @GlobalCashFlowManagement.IsAlreadyApproved.</h6>

                                </div>
                            }
                            else
                            {<div class="alert alert-outline-primary" role="alert">
                                 <h6 class="alert-heading mb-1">@GlobalCashFlowManagement.ReferenceId :@Model.DepositNotificationDto.Id  with Amount XFA @{ (Convert.ToDecimal(Model.DepositNotificationDto.Amount)).ToString("N");} @GlobalCashFlowManagement.HasNotYetBeenApproved</h6>
                                    <p class="mb-0">@GlobalCashFlowManagement.SelectSourceAccountToWhichTheVaultWillBe </p>
                                </div>
                            }

                        </div>
                        @if (@Model.DepositNotificationDto.IsApproved)
                        {

                        }
                        else
                        {
                            using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                            {
                                <!-- Account Details -->

                                @Html.HiddenFor(model => model.DepositNotificationDto.Id)
                                <input type="hidden" name="option" value="Status" id="option" />
                                <input type="hidden" name="ServiceOption" value="DepositNotificationApproval" id="ServiceOption" />
                                if (Model.DepositNotificationDto.IsApproved)
                                {
                                    <div class="form-check mb-3">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.DepositNotificationDto.IsApproved, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalCashFlowManagement.TheCashReplenishmentRequestOfIssuedBy @Model.DepositNotificationDto.IssuedBy @GlobalCashFlowManagement.HasBeenApproved</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">@GlobalCashFlowManagement.AlreadyApprovedAccountReplenishment</button>
                                    </div>

                                }
                                else
                                {

                                 
                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">

                                            @Html.DropDownListFor(m => m.DepositNotificationDto.ApprovedBy, new SelectList(ViewBag.DepositDecisions == null ? "" : ViewBag.DepositDecisions, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.ApprovedBy, "", new { @class = "text-danger" })
                                            <label for="Account">@GlobalCashFlowManagement.MakeDecision</label>
                                        </div>
                                    </div>
                              
                                        <div class="form-check mb-3" id="hideBranchID">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.correpondingBranchId, new SelectList(ViewBag.ZoneBranch == null ? "" : ViewBag.ZoneBranch, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "CorrespondingBranchID" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.correpondingBranchId, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalCashFlowManagement.SelectBranch</label>
                                            </div>
                                        </div>
                                  
                                 
                           
                                        <div class="form-check mb-3" id="hideAccountId">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.Temp3, new SelectList(ViewBag.BankAccounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.Temp3, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalCashFlowManagement.SelectBankAccount</label>
                                            </div>
                                        </div>
                                   
                               

                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.DepositNotificationDto.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.ApprovedMessage, "", new { @class = "text-danger" })

                                            <label for="Description"> @GlobalCashFlowManagement.DecisionMessage</label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Validate</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />

                                    </div>

                                }



                            }

                        }


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>


