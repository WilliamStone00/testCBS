@model  CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.CashReplenishmentData;

}

<table class="table table-hover" id="ListOfCashReplenishmentData">
    @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
    {
        <thead class="table-light">
            <tr>
                <th>@GlobalCashFlowManagement.BranchOffice</th>
                <th>@GlobalCashFlowManagement.IssuedBy</th>
                <th>@GlobalCashFlowManagement.AmountRequested</th>
        
                <th>@GlobalCashFlowManagement.IssuedDate</th>
                <th>@GlobalCashFlowManagement.Action</th>
            </tr>
        </thead>

    }
    else
    {
        <thead class="table-light">
            <tr>
                <th>@GlobalCashFlowManagement.IssuedBy</th>
                <th>@GlobalCashFlowManagement.AmountRequested</th>
              
                <th>@GlobalCashFlowManagement.IssuedDate</th>
                <th>@GlobalCashFlowManagement.Action</th>
            </tr>
        </thead>
    }


    <tbody>

        @foreach (var d in Model.ListCashReplenimentRequestDto)
        {
            if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
            {
                <tr>
                    <td style="width:20%">@d.BranchOffice</td>
                    <td style="width:15%">@d.TempId1</td>
                    <td style="width:15%">@d.AmountRequested</td>
                   
                    <td style="width:15%">@d.IssuedDate</td>

                    <td style="width:25%">

                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','update','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.IssuedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalShared.Edit|</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','status','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.IssuedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.Status|</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashReplenimentRequest','approve','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalCashFlowManagement.Approve @d.IssuedBy @GlobalCashFlowManagement.CashRequest">@GlobalCashFlowManagement.Approve|</a>
                        @*<a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.AmountRequested" onclick="DeleteRecordDataTable('CashFlowManagement','@d.Id','ListOfCashReplenishmentData','_CashReplenishmentRequestData',0,'datalistingview_CashReplenimentRequest')">Delete</a>*@
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td style="width:25%">@d.TempId1</td>
                    <td style="width:15%"> @d.AmountRequested</td>
                    <td style="width:15%">@d.IssuedDate</td>

                    <td style="width:35%">

                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','update','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.IssuedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalShared.Edit|</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','status','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.IssuedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.Status|</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashReplenimentRequest','approve','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalCashFlowManagement.Approve @d.IssuedBy @GlobalCashFlowManagement.CashRequest">@GlobalCashFlowManagement.Approve|</a>
                      @*  <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.AmountRequested" onclick="DeleteRecordDataTable('CashFlowManagement','@d.Id','ListOfCashReplenishmentData','_CashReplenishmentRequestData',0,'datalistingview_CashReplenimentRequest')">Delete</a>*@
                    </td>
                </tr>
            }


        }
    </tbody>
</table>