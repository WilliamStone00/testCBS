@model CBS.FrontDesk.Data.Entity.Accounting.AccountCategory
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "AccountCategory", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>@Globals_Create.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label>@Globals_Create.Description</label>
                </div>
            </div>


        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
        </div>
    }
</div>