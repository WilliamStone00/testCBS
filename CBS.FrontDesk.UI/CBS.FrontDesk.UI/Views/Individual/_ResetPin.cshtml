@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources
<div class="card-body">


    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="ResetPin" id="option" />
        <div class="col-md-9">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Phone, new { @class = "form-control", @placeholder = @GlobalIndividual.PhoneNumber })
                @Html.ValidationMessageFor(m => m.CustomerList.Phone, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.PhoneNumber</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.CustomerPackageId, new { @class = "form-control", @placeholder = "1234",@readonly=true })
                @Html.ValidationMessageFor(m => m.CustomerList.CustomerPackageId, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.CurrentPin</label>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">@GlobalIndividual.ResetPin</button>
        </div>
    }
</div>
