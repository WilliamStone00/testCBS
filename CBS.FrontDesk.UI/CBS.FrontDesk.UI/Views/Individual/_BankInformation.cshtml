@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources
<div class="card-body">


    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="bank_info" />
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.BankId, new SelectList(ViewBag.Banks, "Id", "Name"), "---" + @GlobalIndividual.SelectBranchHeadOffice + "---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.CustomerList.BankId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalIndividual.BranchHeadOffice</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.BranchId, new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalIndividual.SelectBranchOffice+"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.CustomerList.BranchId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalIndividual.BranchOffice</label>
            </div>
        </div>

        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.MembershipApprovalStatus, new { @class = "form-control",@readonly=true })
                <label for="formValidationDob">@GlobalIndividual.MembershipStatus</label>
            </div>
        </div>


    }
</div>
