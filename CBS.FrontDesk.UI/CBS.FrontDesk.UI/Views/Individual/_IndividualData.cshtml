@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalIndividual.BRANCHMEMBERS</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalIndividual.RDate</th>
                    <th>@GlobalIndividual.Name</th>
                    <th>@GlobalIndividual.MAccNum</th>
                    <th>@GlobalIndividual.Telephone</th>
                    <th>@GlobalIndividual.MembersProfile</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>