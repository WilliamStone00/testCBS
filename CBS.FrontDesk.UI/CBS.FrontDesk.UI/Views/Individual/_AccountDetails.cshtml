@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile


<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <!-- General Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">General Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Account Number:</td>
                        <td>@Model.CustomerAccount.accountNumber</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Account Name:</td>
                        <td>@Model.CustomerAccount.accountName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Customer Name:</td>
                        <td>@Model.CustomerAccount.customerName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Member Reference:</td>
                        <td>@Model.CustomerAccount.customerId</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Branch Code:</td>
                        <td>@Model.CustomerAccount.branchCode</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Bank ID:</td>
                        <td>@Model.CustomerAccount.bankId</td>
                    </tr>

                    <!-- Balance Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Balance Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Current Balance:</td>
                        <td>@Model.CustomerAccount.balance.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Previous Balance:</td>
                        <td>@Model.CustomerAccount.previousBalance.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Blocked Amount:</td>
                        <td>@Model.CustomerAccount.blockedAmount.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Encrypted Balance:</td>
                        <td>@Model.CustomerAccount.encryptedBalance</td>
                    </tr>

                    <!-- Account Status -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Account Status</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Status:</td>
                        <td>
                            @if (Model.CustomerAccount.status == "Active")
                            {
                                <span class="badge bg-success text-white">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@Model.CustomerAccount.status</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Reason for Block:</td>
                        <td>@Model.CustomerAccount.reasonOfBlocked</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Date Blocked:</td>
                        <td>@(Model.CustomerAccount.dateBlocked == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateBlocked.ToString("dd/MM/yyyy"))</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Date Released:</td>
                        <td>@(Model.CustomerAccount.dateReleased == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateReleased.ToString("dd/MM/yyyy"))</td>
                    </tr>

                    <!-- Product Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Product Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Product Code:</td>
                        <td>@Model.CustomerAccount.product.Code</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Product Name:</td>
                        <td>@Model.CustomerAccount.product.Name</td>
                    </tr>

                    <!-- Interest Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Interest Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Interest Generated:</td>
                        <td>@Model.CustomerAccount.interestGenerated.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Last Interest Posted:</td>
                        <td>@Model.CustomerAccount.lastInterestPosted.ToString("N1") FCFA</td>
                    </tr>

                    <!-- Account Operations -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Account Operations</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Last Operation:</td>
                        <td>@Model.CustomerAccount.lastOperation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Last Operation Amount:</td>
                        <td>@Model.CustomerAccount.lastOperationAmount.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Date of Last Operation:</td>
                        <td>@(Model.CustomerAccount.dateOfLastOperation == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateOfLastOperation.ToString("dd/MM/yyyy"))</td>
                    </tr>

                    <!-- Opening Day Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">Opening Day Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Opening Day Status:</td>
                        <td>@Model.CustomerAccount.openningOfDayStatus</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Opening Day Date:</td>
                        <td>@(Model.CustomerAccount.openningOfDayDate == DateTime.MinValue ? "N/A" : Model.CustomerAccount.openningOfDayDate.ToString("dd/MM/yyyy"))</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Opening Balance:</td>
                        <td>@Model.CustomerAccount.openingBalance.ToString("N1") FCFA</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>
