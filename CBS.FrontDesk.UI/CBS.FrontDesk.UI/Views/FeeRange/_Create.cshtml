@model CBS.FrontDesk.Data.Entity.LoanConf.FeeRange
    @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalFeeRange.FeeConfiguration</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "FeeRange", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {

            @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.FeeId, new SelectList(ViewBag.Fees, "Id", "name"), "---"+ @GlobalFeeRange.SelectFee+"---", new { @class = "form-control select2", @onchange = "GetFee(this.value);", @search = "true" })
                    @Html.ValidationMessageFor(m => m.FeeId, "", new { @class = "text-danger" })
                    <label>@GlobalFeeRange.SelectFee</label>
                </div>
            </div>
            @if (ViewBag.Base == "Range")
            {
                <div id="range" style="display:block">
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountFrom, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountFrom, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.AmountFrom</label>
                            </div>
                        </div>
                        <div class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountTo, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountTo, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.AmountTo</label>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.Charge</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ViewBag.Base == "Percentage")
            {
                <div id="percentage" style="display: block">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.PercentageValue, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PercentageValue, "", new { @class = "text-danger" })
                            <label>@GlobalFeeRange.EnterValue</label>
                        </div>
                    </div>
                </div>
            }

            else
            {
                <div id="range" style="display: none">
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountFrom, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountFrom, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.AmountFrom</label>
                            </div>
                        </div>
                        <div class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountTo, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountTo, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.AmountTo</label>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                                <label>@GlobalFeeRange.Charge</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="percentage" style="display:none">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.PercentageValue, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PercentageValue, "", new { @class = "text-danger" })
                            <label>@GlobalFeeRange.EnterValue</label>
                        </div>
                    </div>
                </div>
            }


        </div>
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>

                }
            </div>

        }
    </div>
</fieldset>