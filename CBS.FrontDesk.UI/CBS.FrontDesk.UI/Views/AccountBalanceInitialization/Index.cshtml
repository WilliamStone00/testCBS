@{
    ViewBag.Title = "Ordinary Account Initialization Overview";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i>📄 Ordinary Product Account Initialization Summary</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> This interface enable back office operator to pay each daily collector.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS for daily collection payment</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>

                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>FilterByBranch:</strong>  Select branch if you are connected as head office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>Select Account:</strong>Select Account to initialise.</li>
                <li><i class="mdi mdi-cash-check me-2"></i> <strong> Member Balance:</strong>Compute Member Balance.</li>
                <li><i class="mdi mdi-cash-check me-2"></i> <strong> General Ledger Balance:</strong>Compute Trial Balance.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <!-- Action Buttons -->
    <div class="row mb-3 justify-content-end">
        <div class="demo-inline-spacing text-end">
            <a class="btn btn-icon btn-label-secondary btn-sm btn-fab demo"
               onclick="AddORUpdateGen(null,'datalistingview_AccountInitialize','_SearchOption','search','AccountBalanceInitialization','account')"
               title="Search">
                <span class="tf-icons mdi mdi-search-web mdi-18px"></span>
            </a>
            <a class="btn btn-icon btn-label-secondary btn-sm btn-fab demo"
               onclick="AddORUpdateGen(null,'datalistingview_AccountInitialize','_CreateAccountBalanceInitialization','new','AccountBalanceInitialization','account')"
               title="AddNew">
                <span class="tf-icons mdi mdi-plus mdi-18px"></span> 
            </a>

        </div>
    </div>
    <div id="datalistingview_AccountInitialize">
        @Html.Partial("_CreateAccountBalanceInitialization")

    </div>
    @*<div id="datalistingview_AccountInitializationData" class="bg-light">
        @Html.Partial("_AccountInitializationData")
    </div>*@
   
</div> <!-- .row -->

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/AccountBalanceInitialization.js"></script>

}
