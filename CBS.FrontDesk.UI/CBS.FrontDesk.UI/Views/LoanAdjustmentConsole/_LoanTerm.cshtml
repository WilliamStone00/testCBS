@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
@{
    ViewBag.Title = @GlobalLoanApplication.LoanApplicationDetails;
    var SavingCoverage = (Model.LoanApplication.SavingAccountCoverageRate / 100) * Model.RequestedAmount;
    var totalRefinancing = Model.RequestedAmount + Model.RestructuredBalance;
}

<div class="card-body">
    <table class="table table-bordered table-striped" id="myDataTable">
        <tbody>
            <!-- General Information -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.GeneralInformation</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.MembersCode:</td>
                <td>@Model.LoanApplication.CustomerId</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanApplicationCode:</td>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanApplicationType:</td>
                <td>
                    @if (@Model.LoanApplication.LoanApplicationType != "Normal")
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanApplication.LoanApplicationType</span>
                        <br /><a href="/Loan/Details?KEY=@Model.LoanId" target="_blank">@GlobalShared.Details >> @Model.LoanId</a>
                    }
                    else
                    {
                        <span class="badge bg-primary text-white">@GlobalLoanApplication.NewLoan</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanType:</td>
                <td>
                    @if (Model.LoanType=="Main_Loan")
                    {
                        <span class="badge bg-primary text-white">@Model.LoanType</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanType</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanCategory:</td>
                <td>@Model.LoanCategory</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.TargetedPopulation:</td>
                <td>@Model.LoanTarget</td>
            </tr>

            <!-- General Information -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.ProductInformation</td>
            </tr>

            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ProductCode:</td>
                <td>@Model.LoanApplication.LoanProduct.ProductCode</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ProductName:</td>
                <td>@Model.LoanApplication.LoanProduct.ProductName</td>
            </tr>
            @*<tr>
                    <td class="font-weight-bold">Product term:</td>
                    <td>@Model.LoanProduct.LoanTerm.Name</td>
                </tr>*@

            <!-- Application Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.ApplicationDetails</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ApplicationDate:</td>
                <td>@Model.LoanApplication.ApplicationDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ApprovalDate:</td>
                <td>@Model.LoanApplication.ApprovalDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.DisbursementDate:</td>
                <td>@Model.DisbursementDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ApplicationManage:</td>
                <td>@Model.LoanManager</td>
            </tr>

            <!-- Application Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.MigrationStatus</td>
            </tr>
            <tr>
                <td class="font-weight-bold">Migrated Loan:</td>
                <td>
                    @if (!Model.LoanApplication.IsUpload.Value)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoanApplication.TSCLoan</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalLoanApplication.MigratedLoan</span>
                    }
                </td>
            </tr>
            <!-- Loan Status -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.LoanStatus</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ApprovalStatus:</td>
                <td>
                    <span class="badge bg-@(Model.LoanApplication.IsApproved ? "success" : "danger")">
                        @(Model.LoanApplication.IsApproved ? "Approved" : "Pending")
                    </span>
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.DisbursementStatus:</td>
                <td>@(Model.LoanApplication.IsDisbursed ? "Yes" : "No")</td>
            </tr>
            <!-- Refinancing Details -->
            @if (Model.LoanApplication.LoanApplicationType == "Refinancing")
            {
                <tr class="table-primary">
                    <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.RefinancingDetails</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.RequestedAmount:</td>
                    <td>@Model.RequestedAmount.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.RestructuredBalance:</td>
                    <td>@Model.RestructuredBalance.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.RefinancedAmount:</td>
                    <td>@totalRefinancing.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr class="table-secondary">
                    <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.OldLoanInformation</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.OldLoanAmount:</td>
                    <td>@Model.LoanApplication.OldLoanAmount.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.OldLoanCapital:</td>
                    <td>@Model.LoanApplication.OldLoanCapital.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.OldLoanInterest:</td>
                    <td>@Model.LoanApplication.OldLoanInterest.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.OldLoanVAT:</td>
                    <td>@Model.LoanApplication.OldLoanVat.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoanApplication.OldLoanPenalty:</td>
                    <td>@Model.LoanApplication.OldLoanPenalty.ToString("#,##0.0") FCFA</td>
                </tr>
            }
            <!-- Interest Payment Details -->
            <!-- Loan Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.LoanDetails</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanProductID:</td>
                <td>@Model.LoanApplication.LoanProductId</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.TotalLoanAmount:</td>
                <td><strong>@Model.LoanApplication.Amount.ToString("#,##0.0") FCFA</strong></td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.InterestRate:</td>
                <td>@Model.InterestRate.ToString("#,##0.0")%</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.LoanManager:</td>
                <td>@Model.LoanManager</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.Fees:</td>
                <td>
                    @if (Model.LoanApplication.LoanApplicationFees.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var fee in Model.LoanApplication.LoanApplicationFees)
                            {
                                <li>
                                    @fee.FeeLable: @(fee.FeeAmount.ToString("#,##0.0") + " FCFA")
                                </li>
                            }
                        </ul>
                        <div>
                            <strong>Total Fee Amount:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.0") + " FCFA")<br />
                            <strong>Total Amount Paid:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.0") + " FCFA")
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">@GlobalLoanApplication.NoFeeAdded.</span>
                    }
                </td>
            </tr>

            <!-- Downpayments and Coverage Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.DownpaymentsAndCoverage</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.TotalDownPaymentProvided:</td>
                <td><strong>@Model.LoanApplication.DownPaymentCoverageAmountProvided.ToString("#,##0.0") FCFA</strong></td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ShareCoveredAmount:</td>
                <td>@Model.LoanApplication.ShareAccountCoverageAmount.ToString("#,##0.0") FCFA</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.SavingCoverageProvided:</td>
                <td>@Model.LoanApplication.SavingAccountCoverageRate.ToString("#,##0.0")% of @Model.RequestedAmount.ToString("#,##0"): [@SavingCoverage.ToString("#,##0")] FCFA</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.WasPreferenceShareAccountUsedAsCoverage?</td>
                <td>
                    @if (Model.LoanApplication.IsPreferenceShareAccountCoverageAmount)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoanApplication.YESCoverageAmount: @Model.LoanApplication.PreferenceShareAccountCoverageAmount.ToString("#,##0.0")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalLoanApplication.No</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.WasDepositAccountUsedAsCoverage?</td>
                <td>
                    @if (Model.LoanApplication.IsDepositAccountCoverageAmount)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoanApplication.YESCoverageAmount: @Model.LoanApplication.DepositAccountCoverageAmount.ToString("#,##0.0")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalLoanApplication.No</span>
                    }
                </td>
            </tr>



            <!-- Additional Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.AdditionalDetails</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.VATRate:</td>
                <td>@Model.VatRate.ToString("#,##0.0")%</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.GracePeriodBeforeFirstInstallment:</td>
                <td>@Model.LoanApplication.GracePeriodBeforeFirstPayment @GlobalLoanApplication.monthsBeforeFirstInstallment</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.GracePeriodAfterLoanDueDate:</td>
                <td>@Model.LoanApplication.GracePeriodAfterMaturityDate @GlobalLoanApplication.daysAfterMaturityDate</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.ApprovalStatus:</td>
                <td>
                    @if (Model.LoanApplication.IsApproved)
                    {
                        <span class="badge bg-primary text-white">@Model.LoanApplication.ApprovalStatus</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanApplication.ApprovalStatus</span>
                    }


                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoanApplication.HasTheLoanBeenApproved?</td>
                <td>
                    @if (Model.LoanApplication.IsApproved)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoanApplication.Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalLoanApplication.Pending</span>
                    }
                </td>
            </tr>
            <!-- Guarantors Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.Guarantors</td>
            </tr>
            @if (Model.LoanApplication.Guarantors?.Any() == true)
            {
                foreach (var guarantor in Model.LoanApplication.Guarantors)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.GuarantorName:</td>
                        <td>@guarantor.GuarantorName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.GuarantorRelationship:</td>
                        <td>@guarantor.Relationship</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalLoanApplication.NoGuarantorsProvided.</td>
                </tr>
            }

            <!-- Collateral Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.Collateral</td>
            </tr>
            @if (Model.LoanApplication.Collateras?.Any() == true)
            {
                foreach (var collateral in Model.LoanApplication.Collateras)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.CollateralType:</td>
                        <td>@collateral.Location</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.CollateralValue:</td>
                        <td>@collateral.Amount.ToString("#,##0.0") FCFA</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalLoanApplication.NoCollateralProvided.</td>
                </tr>
            }


            <!-- Attached Documents -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoanApplication.AttachedDocuments</td>
            </tr>
            @if (Model.LoanApplication.DocumentAttachedToLoans?.Any() == true)
            {
                foreach (var document in Model.LoanApplication.DocumentAttachedToLoans)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.DocumentName:</td>
                        <td>@document.FileName @document.FileExtension</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalLoanApplication.UploadedDate:</td>
                        <td>@document.Date.ToString("dd/MM/yyyy hh:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Open:</td>
                        <td><a href="@($"{document.FilePath}")" target="_blank" class="btn btn-sm btn-primary">@GlobalLoanApplication.ReadContent</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalLoanApplication.NoDocumentsAttached.</td>
                </tr>
            }

        </tbody>
    </table>

</div>

