@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>Accrual Interest Listing</legend>
    <hr style="border: 2px solid green;" />
    @if (Model.DailyInterestCalculations.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalLoan.NoDailyInterestCalculationsGeneratedFor @Model.IndividualCustomer.CustomerList.name</p>
        </div>
    }
    else
    {
        // Calculate totals
        decimal totalInterestCalculated = Model.DailyInterestCalculations.Sum(d => d.InterestCalculated);
        decimal totalPreviousBalance = Model.DailyInterestCalculations.Sum(d => d.PreviouseBalance);
        decimal totalvat = Model.DailyInterestCalculations.Sum(d => d.CalculatedVat);
        decimal totalNewBalance = Model.DailyInterestCalculations.Sum(d => d.NewBalance);
        decimal grandTotal = totalInterestCalculated; // Adjust as per your requirement
        int serialNumber = 1; // Initialize the serial number

        <div class="card-body d-flex justify-content-between flex-wrap gap-3">
            <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                <div class="avatar">
                    <div class="avatar-initial bg-label-primary rounded">
                        <i class="mdi mdi-currency-usd mdi-24px"></i> <!-- Icon for totalInterestCalculated -->
                    </div>
                </div>
                <div class="card-info">
                    <h4 class="mb-0">@totalInterestCalculated.ToString("#,##0.0")</h4>
                    <small>@GlobalLoan.TotalAccrualInterestCalculated</small>
                </div>
            </div>
            <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                <div class="avatar">
                    <div class="avatar-initial bg-label-primary rounded">
                        <i class="mdi mdi-currency-usd mdi-24px"></i> <!-- Icon for totalvat -->
                    </div>
                </div>
                <div class="card-info">
                    <h4 class="mb-0">@totalvat.ToString("#,##0.0")</h4>
                    <small>@GlobalLoan.TotalVATCalculated</small>
                </div>
            </div>
            <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                <div class="avatar">
                    <div class="avatar-initial bg-label-primary rounded">
                        <i class="mdi mdi-currency-usd mdi-24px"></i> <!-- Icon for Model.Balance -->
                    </div>
                </div>
                <div class="card-info">
                    <h4 class="mb-0">@Model.Balance.ToString("#,##0.0")</h4>
                    <small>@GlobalLoan.Balance</small>
                </div>
            </div>
            <!-- Add additional totals here as needed -->
        </div>
        <hr style="border: 2px solid green;" />
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTableInterest">
                <thead class="table-light">
                    <tr>
                        <th>#</th> <!-- Serial number column -->
                        <th>@GlobalLoan.Date</th>
                        <th>@GlobalLoan.Balance</th>
                        <th>@GlobalLoan.InterestCalculated</th>
                        <th>@GlobalLoan.VatCalculated</th>
                        <th>@GlobalLoan.NewBalance</th>
                        <!-- Add additional headers here -->
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DailyInterestCalculations.OrderByDescending(d => d.Date))
                    {
                        <tr>
                            <td style="width:10%">@serialNumber</td> <!-- Serial number cell -->
                            <td style="width:40%">@d.Date</td>
                            <td style="width:15%">@d.PreviouseBalance.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.InterestCalculated.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.CalculatedVat.ToString("#,##0.0")</td>
                            <td style="width:15%">@d.NewBalance.ToString("#,##0.0")</td>
                            <!-- Add additional columns here -->
                        </tr>
                        serialNumber++; // Increment the serial number for each row
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3">@GlobalLoan.TotalInterestCalculated:</td> <!-- Colspan to merge cells -->
                        <td><strong>@totalInterestCalculated.ToString("#,##0.0")</strong></td>
                        <td></td>
                        <td></td> <!-- Empty cell for alignment -->
                    </tr>
                </tfoot>

            </table>
        </div>
    }
</fieldset>
