@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
    @using Resources
@{
    ViewBag.Title = "Accounting Event -Execution";
}
<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0 w-100">@GlobalManuallyJournalEntry.ConfiguredManualJournalEntry</h4>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Left Panel: Event Metadata -->
                <div class="col-md-4">
                    <fieldset class="border p-3 rounded">
                        <legend class="w-auto text-primary">@GlobalManuallyJournalEntry.EntryMetadata</legend>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalManuallyJournalEntry.EventName</label>
                            <input type="text" class="form-control" value="@Model.AccountingEventRule.EventName" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalManuallyJournalEntry.DoubleValidationNeeded</label>
                            <input type="text" class="form-control" value="@(Model.AccountingEventRule.IsDoubleValidationNeeded ? "Double Validation is required" : "Double Validation is not required")" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalManuallyJournalEntry.LevelOfExecution</label>
                            <input type="text" class="form-control" id="LevelOfExecution" value="@Model.AccountingEventRule.LevelOfExecution" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalManuallyJournalEntry.IsChainExecution</label>
                            <input type="text" class="form-control" value="@(Model.AccountingEventRule.IsChainEntry ? "Chain execution is set" : "Chain execution is not set")" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalManuallyJournalEntry.NextAccountingEvent</label>
                            <input type="text" class="form-control" value="@(Model.AccountingEventRule.IsChainEntry ? Model.AccountingEventRule.AccountingEventRuleId : "Chain execution is not set")" readonly>
                        </div>
                    </fieldset>
                </div>

                <!-- Right Panel: Accounting Rules Table -->
                <div class="col-md-8">
                    <fieldset class="border p-3 rounded">
                        <legend class="w-auto text-primary">@GlobalManuallyJournalEntry.AccountingEntries: @Model.AccountingEventRule.EventName</legend>


                        @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "manualEntryForm" }))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@GlobalManuallyJournalEntry.TransactionReference</label>
                                <input type="text" class="form-control" id="Reference" value="" readonly>
                            </div>
                            <input type="hidden" class="form-control" id="AccountingEventId" value="@Model.AccountingEventRule.Id" readonly>
                            if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
                            {
                                @Html.Partial("_GeneralErrorDiv")
                            }

                            <table id="accountingRuleTable" class="table table-bordered">
                                <thead class="table-dark text-center">
                                    <tr>
                                        <th width="50%">@GlobalManuallyJournalEntry.AccountDescription</th>
                                        <th width="25%">@GlobalManuallyJournalEntry.Debit (XFA)</th>
                                        <th width="25%">@GlobalManuallyJournalEntry.Credit (XFA)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AccountingEventRule.AccountingRules != null && Model.AccountingEventRule.AccountingRules.Any())
                                    {
                                        foreach (var rule in Model.AccountingEventRule.AccountingRules)
                                        {
                                            <tr>
                                                <td class="accountDesc">@rule.MFI_ChartOfAccountId</td>
                                                <td>
                                                    @if (rule.BookingDirection.ToLower() == "debit")
                                                    {
                                                        <input type="number" name="AccountingRules[@rule.Id].Debit" class="form-control text-end debitInput" value="0">
                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control text-end bg-light" value="-" readonly>
                                                    }
                                                </td>
                                                <td>
                                                    @if (rule.BookingDirection.ToLower() == "credit")
                                                    {
                                                        <input type="number" name="AccountingRules[@rule.Id].Credit" class="form-control text-end creditInput" value="0">
                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control text-end bg-light" value="-" readonly>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">@GlobalManuallyJournalEntry.NoAccountingRulesAvailable.</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-secondary">
                                        <td class="fw-bold">@GlobalManuallyJournalEntry.TOTAL:</td>
                                        <td class="fw-bold text-end" id="debitTotal">0</td>
                                        <td class="fw-bold text-end" id="creditTotal">0</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-center">
                                            <span id="balanceMessage" class="text-danger fw-bold"></span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Description Input -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">@GlobalManuallyJournalEntry.Description / Purpose of Manual Entry</label>
                                <textarea class="form-control" id="descriptionField" rows="3" placeholder="@GlobalManuallyJournalEntry.EnterReasonForManualEntry..."></textarea>
                            </div>
                            <div class="mt-4 text-center">
                                <button type="submit" class="btn btn-primary px-4" id="submitButton" disabled>@GlobalManuallyJournalEntry.SubmitEntry</button>
                            </div>
                        }
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/StaticAutomatedJournalEntry.js"></script>
}
