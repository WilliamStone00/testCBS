@model List<CBS.FrontDesk.Data.Entity.Accounting.OperationEventAttributeDto>
    @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalOperationEventAttribute.Name</th>
            <th>@GlobalOperationEventAttribute.Description</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:35%">@d.Name</td>
                <td style="width:35%">@d.OperationEventName</td>
                <td style="width:25%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','OperationEventAttribute')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('OperationEventAttribute','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

