<script>
    // Function to update Amount Given and Total dynamically
    function updateGivenAndTotal() {
        const amountReceived = parseFloat(document.getElementById('AmountReceived').value) || 0;

        // Update Amount Given
        const amountGivenElement = document.getElementById('AmountGiven');
        amountGivenElement.value = amountReceived.toFixed(2);

        // Calculate total
        const formattedAmount = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'XAF' }).format(amountReceived);

        // Update total display fields
        document.getElementById('balanceBroughtForward').innerText = `Change To Be Given: ${formattedAmount}`;
        document.getElementById('lblDepositRequest_amount').innerText = `Total amount: ${formattedAmount}`;
        document.getElementById('lblBalance').innerText = `Control Balance: ${formattedAmount}`;
        document.getElementById('totalNoteAmount').value = amountReceived.toFixed(2);
        document.getElementById('totalProvision').value = amountReceived.toFixed(2);


        // Update total display fields Amount Received
        document.getElementById('balanceBroughtForward_Received').innerText = `Amount Received: ${formattedAmount}`;
        document.getElementById('lblDepositRequest_amount_Received').innerText = `Total amount: ${formattedAmount}`;
        document.getElementById('lblBalance_Received').innerText = `Control Balance: ${formattedAmount}`;
        document.getElementById('totalNoteAmount_Received').value = amountReceived.toFixed(2);
        document.getElementById('totalProvision_Received').value = amountReceived.toFixed(2);
    }

    // Validation to ensure amounts match
    function validateAmounts() {
        const amountReceived = parseFloat(document.getElementById('AmountReceived').value) || 0;
        const amountGiven = parseFloat(document.getElementById('AmountGiven').value) || 0;

        if (amountReceived !== amountGiven) {
            alert('Amount Given must match Amount Received.');
            return false;
        }
        return true;
    }
</script>






