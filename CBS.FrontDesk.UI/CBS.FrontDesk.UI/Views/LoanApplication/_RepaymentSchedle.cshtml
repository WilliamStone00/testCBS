@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>Repayment Schedule</legend>
    <hr style="border: 2px solid green;" />
    @if (Model.LoanAmortizations.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalLoanApplication.NoRepaymentScheduleGeneratedFor @Model.IndividualCustomer.CustomerList.name</p>
        </div>
    }
    else
    {

       

        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%">@GlobalLoanApplication.SN</th>
                        <th style="width: 10%">@GlobalLoanApplication.Date</th>
                        <th style="width: 15%">@GlobalLoanApplication.Description</th>
                        <th style="width: 10%">@GlobalLoanApplication.Principal</th>
                        <th style="width: 10%">@GlobalLoanApplication.Interest</th>
                        <th style="width: 10%">@GlobalLoanApplication.Vat</th>
                        <th style="width: 10%">@GlobalLoanApplication.Penalty</th>
                        <th style="width: 10%">@GlobalLoanApplication.Paid</th>
                        <th style="width: 10%">@GlobalLoanApplication.Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- First Additional Row -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">@GlobalLoanApplication.Principal:</td>
                        <td colspan="6">@Model.Principal.ToString("#,##0.0")</td>
                    </tr>
                    <!-- Second Additional Row -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">@GlobalLoanApplication.Date:</td>
                        <td colspan="6">@DateTime.Now.ToShortDateString()</td>
                    </tr>
                    @foreach (var d in Model.LoanAmortizations.OrderBy(app => app.Sno))
                    {
                        <tr>
                            <td>@d.Sno</td>
                            <td>@d.NextPaymentDate.ToShortDateString()</td>
                            <td>@d.Description</td>
                            <td>@d.Principal.ToString("#,##0.0")</td>
                            <td>@d.Interest.ToString("#,##0.0")</td>
                            <td>@d.Tax.ToString("#,##0.0")</td>
                            <td>@d.Penalty.ToString("#,##0.0")</td>
                            <td>@d.Paid.ToString("#,##0.0")</td>
                            <td>@d.Due.ToString("#,##0.0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold">@GlobalLoanApplication.Total:</td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Interest).ToString("#,##0.0")</td>
                        <td colspan="2"></td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Paid).ToString("#,##0.0")</td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Due).ToString("#,##0.0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</fieldset>
