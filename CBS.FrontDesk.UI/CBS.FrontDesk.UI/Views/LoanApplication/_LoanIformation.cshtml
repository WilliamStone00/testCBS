@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalLoanApplication.Terms</legend>
    <hr style="border: 2px solid green;" />
    <table class="table">
        <tr>
            <td><strong>@GlobalLoanApplication.LoanCode:</strong></td>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.BranchCode:</strong></td>
            <td>@Model.BranchCode</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanDate:</strong></td>
            <td>@Model.LoanDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanExpiryDate:</strong></td>
            <td>@Model.MaturityDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanType:</strong></td>
            <td>@Model.LoanType</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanAmount:</strong></td>
            <td>@Model.LoanAmount.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.InterestRate:</strong></td>
            <td>@Model.InterestRate.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.AccrualInterest:</strong></td>
            <td>@Model.AccrualInterest.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.AccrualPaid:</strong></td>
            <td>@Model.AccrualInterestPaid.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.InterestRate:</strong></td>
            <td>@Model.InterestRate.ToString("#,##0.00")%</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LastCalculatedInterestDate:</strong></td>
            <td>@Model.LastInterestCalculatedDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LastCalculatedInterest:</strong></td>
            <td>@Model.LastCalculatedInterest.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.VATRate:</strong></td>
            <td>@Model.VatRate.ToString("#,##0.00")%</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.Vat:</strong></td>
            <td>@Model.Tax.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.VatPaid:</strong></td>
            <td>@Model.TaxPaid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.Fine:</strong></td>
            <td>@Model.Penalty.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.FinePaid:</strong></td>
            <td>@Model.PenaltyPaid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.TotalPaid:</strong></td>
            <td>@Model.Paid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.Balance:</strong></td>
            <td>@Model.Balance.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LastRepaymentDate:</strong></td>
            <td>@Model.LastRefundDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LastRepayment:</strong></td>
            <td>@Model.LastPayment.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanStatus:</strong></td>
            <td>@Model.LoanStatus</td>
        </tr>

        <tr>
            <td><strong>@GlobalLoanApplication.LoanDeliquecyJourney:</strong></td>
            <td>@Model.LoanJourneyStatus</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanState</strong></td>
            <td>
                @if (@Model.IsCurrentLoan)
                {
                    <span class="badge bg-info">@GlobalLoanApplication.Current</span>
                }
                else
                {
                    <span class="badge bg-dark">@GlobalLoanApplication.NotCurrent</span>
                }
            </td>
        </tr>
        <tr>
            <td><strong>@GlobalLoanApplication.LoanManager:</strong></td>
            <td>@Model.LoanManager</td>
        </tr>
    </table>
</fieldset>
