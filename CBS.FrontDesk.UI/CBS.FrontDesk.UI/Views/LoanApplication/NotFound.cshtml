@using Resources
@{
    ViewBag.Title = @GlobalLoanApplication.LoanApplicationNotFound;
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-danger">
            <i class="mdi mdi-alert-circle-outline me-2"></i> @GlobalLoanApplication.OopsLoanApplicationNotFound
        </h1>
        <p class="lead text-muted">
            @GlobalLoanApplication.TheLoanApplicationYouAreLookingForDoesNotExist.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Search & Filters Section -->
<div class="card mb-3 shadow-sm">
    <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
        <span>
            <i class="mdi mdi-filter-outline me-2"></i> @GlobalLoanApplication.TrySearchingForAnotherLoanApplication
        </span>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Search Criteria -->
            <div class="col-md-4">
                <label for="searchCriteria" class="form-label fw-bold">Search Criteria:</label>
                <input type="text" id="searchCriteria" class="form-control shadow-sm" placeholder="@GlobalLoanApplication.EnterCustomerNameBranchOrReference..." />
            </div>

            <!-- Loan Category -->
            <div class="col-md-4">
                <label for="loanCategory" class="form-label fw-bold">@GlobalLoanApplication.LoanCategory:</label>
                <select id="loanCategory" class="form-select shadow-sm">
                    <option value="all">@GlobalLoanApplication.All</option>
                    <option value="Main_loan">@GlobalLoanApplication.MainLoans</option>
                    <option value="SSF">@GlobalLoanApplication.SpecialSavingFacilities</option>
                </select>
            </div>

            <!-- Approval Status -->
            <div class="col-md-4">
                <label for="approvalStatus" class="form-label fw-bold">@GlobalLoanApplication.ApprovalStatus:</label>
                <select id="approvalStatus" class="form-select shadow-sm">
                    <option value="all">@GlobalLoanApplication.All</option>
                    <option value="Approved">@GlobalLoanApplication.Approved</option>
                    <option value="Pending">@GlobalLoanApplication.PendingApproval</option>
                    <option value="Rejected">@GlobalLoanApplication.Rejected</option>
                </select>
            </div>
        </div>

        <!-- Search & Back Buttons -->
        <div class="row mt-3">
            <div class="col-md-12 d-flex justify-content-end">
                <button id="searchButton" class="btn btn-primary me-2">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
                </button>
                <a href="@Url.Action("Index", "LoanApplication")" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left me-1"></i> @GlobalLoanApplication.BackToLoanApplications
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
