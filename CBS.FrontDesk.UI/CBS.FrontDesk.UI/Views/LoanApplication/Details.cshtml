@model CBS.FrontDesk.Data.Entity.LoanConf.LoanApplication
    @using Resources
@{
    ViewBag.Title = @GlobalLoanApplication.LoanApplicationDetails;
    var SavingCoverage = (Model.SavingAccountCoverageRate / 100) * Model.RequestedAmount;
    var totalRefinancing = Model.RequestedAmount + Model.RestructuredBalance;
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-file-document-outline me-2"></i> @GlobalLoanApplication.LoanApplicationDetails
        </h1>
        <p class="card-text">
            @GlobalLoanApplication.ViewAndManageLoanApplicationDetails.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Loan Application Help Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoanApplication.ImportantGuidelinesForLoanApplicationModifications</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanEditTips" aria-expanded="false" aria-controls="collapseLoanEditTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanEditTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalLoanApplication.OnceAloanIsApprovedOrDisbursedItCannotBeModified.</li>

                <li>
                    <i class="mdi mdi-pencil-outline text-primary me-2"></i> @GlobalLoanApplication.ModifiableDetails
                    <ul>
                        <li>@GlobalLoanApplication.RequestedLoanAmount</li>
                        <li>@GlobalLoanApplication.InterestRateLoanDuration</li>
                        <li>@GlobalLoanApplication.RepaymentTermsGracePeriod</li>
                        <li>@GlobalLoanApplication.GuarantorCollateralInformation</li>
                        <li>@GlobalLoanApplication.CoverageDetails</li>
                        <li>@GlobalLoanApplication.ApplicableLoanFeesCharges</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalLoanApplication.NonModifiableDetails
                    <ul>
                        <li>@GlobalLoanApplication.LoanApplicationDate</li>
                        <li>@GlobalLoanApplication.LoanStatusOnceApproved</li>
                        <li>@GlobalLoanApplication.DisbursementInformation</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-bank-transfer text-success me-2"></i> @GlobalLoanApplication.LoanCoverageRequirements
                    <ul>
                        <li>@GlobalLoanApplication.EnsureThatTheTotalCoverageAmountMeetTheLoanReq.</li>
                        <li>@GlobalLoanApplication.IfADownPaymentIsRequiredMakeSureItIsCorrectlyRecorded.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLoanApplication.BeforeSubmission
                    <ul>
                        <li>@GlobalLoanApplication.ReviewAllEnteredDetailsToEnsureAccuracy.</li>
                        <li>@GlobalLoanApplication.AnyIncorrectInformationMayCauseDelaysInApproval.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-history text-info me-2"></i> @GlobalLoanApplication.TrackingLoanApplications
                    <ul>
                        <li>@GlobalLoanApplication.UseTheLoanQueryPanel.</li>
                        <li>@GlobalLoanApplication.ForAnyFurtherAssistanceReachOutToYourLoanOfficer.</li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        @if (!Model.IsApproved)
        {
            <a type="button"
               href="@Url.Action("EditLoanApplication", "LoanApplication", new { KEY = Model.Id })"
               target="_blank"
               class="btn btn-label-warning btn-sm me-2"
               data-bs-toggle="tooltip"
               title="Edit Loan Application">
                <i class="mdi mdi-pencil mdi-18px"></i> @GlobalShared.Edit
            </a>
        }

        @if (Session["IsHeadOffice"] != null && (bool)Session["IsHeadOffice"])
        {
            <a type="button" class="btn btn-label-danger btn-sm me-2"
               data-bs-toggle="tooltip" title="Delete Loan Application"
               onclick="confirmDelete('@Model.Id')">
                <i class="mdi mdi-trash-can mdi-18px"></i> @GlobalShared.Delete
            </a>
        }

    <a type="button" href="@Url.Action("Index", "LoanApplication")"
       class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="@GlobalLoanApplication.BackToLoanList">
        <i class="mdi mdi-arrow-left mdi-18px"></i> @GlobalShared.Back
    </a>
    </div>
</div>

<!-- Loan Details Section -->
@if (Model.IsApproved && Model.Loans?.Any() == true)
{
    <div class="card shadow-sm mt-4 mb-2">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="mdi mdi-bank"></i> @GlobalLoanApplication.LOAN_APPROVAL_STATUS
        </div>
        <div class="card-body">
            <!-- Loan Details Table -->
            <table class="table table-bordered table-striped" id="myDataTable">
                <thead>
                    <tr class="table-secondary">
                        <th>@GlobalLoanApplication.ID</th>
                        <th>@GlobalLoanApplication.LDate</th>
                        <th>@GlobalLoanApplication.lAmount</th>
                        <th>@GlobalLoanApplication.IRate</th>
                        <th>@GlobalLoanApplication.AInterest</th>
                        <th>@GlobalLoanApplication.TotalDue</th>
                        <th>@GlobalLoanApplication.Paid</th>
                        <th>@GlobalLoanApplication.Balance</th>
                        <th>@GlobalLoanApplication.NInstallment</th>
                        <th>@GlobalLoanApplication.Duration</th>
                        <th>@GlobalLoanApplication.MDate</th>
                        <th>@GlobalShared.Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        var totalDue = loan.Principal + loan.AccrualInterest + loan.Fee;
                        <tr>
                            <td>
                                <a href="/Loan/Details?KEY=@loan.Id" target="_blank">
                                    @loan.Id
                                </a>
                            </td>
                            <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanAmount.ToString("#,##0.0")</td>
                            <td>@loan.InterestRate %</td>
                            <td>@loan.AccrualInterest.ToString("#,##0.0")</td>
                            <td>@totalDue.ToString("#,##0.0")</td>
                            <td>@loan.Paid.ToString("#,##0.0")</td>
                            <td>@loan.Balance.ToString("#,##0.0")</td>
                            <td>@loan.NextInstallmentDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanDuration months</td>
                            <td>@loan.MaturityDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@(loan.LoanStatus == "Active" ? "primary" : (loan.LoanStatus == "Delinquent" ? "danger" : "secondary"))">
                                    @loan.LoanStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mt-2">
        <div class="card-body text-center">
            <div class="alert alert-warning">
                <h5><i class="mdi mdi-alert-circle-outline"></i> @GlobalLoanApplication.LoanNotYetApproved</h5>
                <p class="text-muted">
                    @GlobalLoanApplication.ThisLoanApplicationIsStillUnderReview.
                </p>
            </div>

            <div class="alert alert-info">
                <i class="mdi mdi-clock-outline me-2"></i>
                <strong>@GlobalLoanApplication.Tip:</strong> @GlobalLoanApplication.IfYourLoanApplicationIsTakingTooLongForApprovalContactTheLoanDep.
            </div>
        </div>
    </div>
}

<!-- Loan Terms Details -->
<div class="card shadow-sm mt-2">
    <div class="card-header bg-dark text-white fw-bold">
        <i class="mdi mdi-bank"></i> @GlobalLoanApplication.LOAN_APPLICATION_TERMS_DETAILS
    </div>
    <div class="card-body">
        <p class="text-muted">
            @GlobalLoanApplication.BelowAreTheSpecificTermsAndConditionsOfThisLoanApplication.
        </p>
        @Html.Partial("_Details")
    </div>
</div>
<!-- Scripts -->
@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
