@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.AccountToAccountTransferDto

@{
    var totalAmount = Model.TransfterRequest.Amount + Model.TransfterRequest.Charges;
    var status = Model.TransfterRequest.Status?.Trim()?.ToLowerInvariant();

    string statusBadge = "";

    if (status == "approved")
    {
        statusBadge = "<span class='badge bg-success'>Approved</span>";
    }
    else if (status == "rejected")
    {
        statusBadge = "<span class='badge bg-danger'>Rejected</span>";
    }
    else if (status == "pending" || string.IsNullOrEmpty(status))
    {
        statusBadge = "<span class='badge bg-secondary'>Pending</span>";
    }
    else
    {
        statusBadge = $"<span class='badge bg-dark'>{Model.TransfterRequest.Status}</span>";
    }
}

<div class="px-3 py-2">
    <div id="printableTransferSummary">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th colspan="2" class="fw-bold text-dark">
                        <i class="mdi mdi-information-outline text-tsc me-1"></i>
                        Transfer Summary
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="bg-light">Transaction ID</th>
                    <td>@Model.TransfterRequest.Id</td>
                </tr>
                <tr>
                    <th class="bg-light">Transaction Reference</th>
                    <td>@Model.TransfterRequest.TransactionRef</td>
                </tr>
                <tr>
                    <th class="bg-light">Status</th>
                    <td>@Html.Raw(statusBadge)</td>
                </tr>
                <tr>
                    <th class="bg-light">Inter-Branch?</th>
                    <td>
                        @if (Model.TransfterRequest.IsInterBranchOperation)
                        {
                            <span class="badge bg-warning text-dark">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-success">No</span>
                        }
                    </td>
                </tr>
            </tbody>

            <thead class="table-light">
                <tr>
                    <th colspan="2" class="fw-bold text-dark">
                        <i class="mdi mdi-account-arrow-right-outline text-success me-1"></i>
                        Sender Information
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="bg-light">Name</th>
                    <td>@Model.TransfterRequest.SenderName</td>
                </tr>
                <tr>
                    <th class="bg-light">Account</th>
                    <td>@Model.TransfterRequest.SourceAccountNumber (@Model.TransfterRequest.SourceAccountType)</td>
                </tr>
                <tr>
                    <th class="bg-light">Branch</th>
                    <td>@Model.TransfterRequest.SourceBranchName</td>
                </tr>
            </tbody>

            <thead class="table-light">
                <tr>
                    <th colspan="2" class="fw-bold text-dark">
                        <i class="mdi mdi-account-arrow-left-outline text-tsc-dark me-1"></i>
                        Receiver Information
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="bg-light">Name</th>
                    <td>@Model.TransfterRequest.RecieverName</td>
                </tr>
                <tr>
                    <th class="bg-light">Account</th>
                    <td>@Model.TransfterRequest.DestinationAccountNumber (@Model.TransfterRequest.DestinationAccountType)</td>
                </tr>
                <tr>
                    <th class="bg-light">Branch</th>
                    <td>@Model.TransfterRequest.DestinationBranchName</td>
                </tr>
            </tbody>

            <thead class="table-light">
                <tr>
                    <th colspan="2" class="fw-bold text-dark">
                        <i class="mdi mdi-cash-multiple me-1 text-warning"></i>
                        Financial Breakdown
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="bg-light">Amount</th>
                    <td>@Model.TransfterRequest.Amount.ToString("N0") FCFA</td>
                </tr>
                <tr>
                    <th class="bg-light">Fee</th>
                    <td>@Model.TransfterRequest.Charges.ToString("N0") FCFA</td>
                </tr>
                <tr>
                    <th class="bg-light">Total</th>
                    <td class="fw-bold text-primary">@totalAmount.ToString("N0") FCFA</td>
                </tr>
            </tbody>

            <thead class="table-light">
                <tr>
                    <th colspan="2" class="fw-bold text-dark">
                        <i class="mdi mdi-history text-muted me-1"></i>
                        Audit Trail
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="bg-light">Initiated</th>
                    <td>@Model.TransfterRequest.DateOfInitiation.ToString("f")</td>
                </tr>
                <tr>
                    <th class="bg-light">Initiator</th>
                    <td>@Model.TransfterRequest.InitiatedByUSerName</td>
                </tr>
                @if (status == "approved")
                {
                    <tr>
                        <th class="bg-light">Approved</th>
                        <td>@Model.TransfterRequest.DateOfApproval.ToString("f")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Approved By</th>
                        <td>@Model.TransfterRequest.ApprovedByUserName</td>
                    </tr>
                }
            </tbody>

            @if (!string.IsNullOrWhiteSpace(Model.TransfterRequest.InitiatorComment))
            {
                <thead class="table-light">
                    <tr>
                        <th colspan="2" class="fw-bold text-dark">
                            <i class="mdi mdi-text-box-outline me-1 text-secondary"></i>
                            Description
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="2">
                            <div class="border rounded p-2 bg-white text-dark">
                                @Model.TransfterRequest.InitiatorComment
                            </div>
                        </td>
                    </tr>
                </tbody>
            }
        </table>
    </div>


    <div class="text-end mt-3">
        <button class="btn btn-outline-primary" onclick="printTransferSummary()">
            <i class="mdi mdi-printer"></i> Print Summary
        </button>
    </div>
</div>

