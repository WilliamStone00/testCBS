@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel

<!-- Existing Regions Table -->
<hr />
<h6 class="text-secondary mb-3"><i class="bi bi-list-check"></i> Existing Regions</h6>

<div class="table-responsive">
    <table id="regionTable" class="table table-bordered table-striped table-hover table-sm w-100">
        <thead class="table-light">
            <tr>
                <th>Country</th>
                <th>Region Name</th>
                <th style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Regions != null && Model.Regions.Count > 0)
            {
                foreach (var region in Model.Regions)
                {
                    <tr>
                        <td>@region.CountryName</td>
                        <td>@region.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="openGlobalizationModal(
                                            '@region.Id',
                                            'globalizationModal',
                                            'globalizationFormContainer',
                                            'Globalization',
                                            'InitializeData',
                                            '_RegionForm',
                                            '',
                                            'Edit Region',
                                            'globalizationModalTitleText',
                                            'id')">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteEntity({
                                            key: '@region.Id',
                                            type: 'region',
                                            deleteUrl: '/Globalization/Delete',
                                            reloadUrl: '/Globalization/InitializeData',
                                            containerId: 'regionTableContainer',
                                            partialView: '_RegionDataTable',
                                            path: 'region',
                                            parentKey: '@region.CountryId'
                                        })">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        <i class="bi bi-info-circle me-1"></i> No regions found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
