@model CBS.FrontDesk.Data.Entity.SavingProducts.MobileMoneyCashTopup

@using Resources
@if (ViewBag.HasError)
{

    @Html.Partial("_GeneralErrorDiv")


}
else
{
    using (Html.BeginForm("Validate", "MobileMoneyCashTopup", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.ValidateMobileMoneyCashTopup.Id)
        <fieldset class="fieldset-custom">
            <legend id="select_base">@Model.OperatorType.ToUpper() @GlobalMobileMoneyCashTopup.TRANSFER_PENDING_VALIDATION: REF (@Model.RequestReference)</legend>
            <div class="row mt-2 gy-4">
                <!-- Request Approval Status (Radio Buttons) -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <label for="RequestApprovalStatus"><b>@GlobalMobileMoneyCashTopup.ApprovalStatus</b></label>
                        <br />
                        <div class="border p-3 mt-2">
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Pending", new { @class = "form-check-input", id = "statusPending" })
                                <label class="form-check-label" for="statusPending">@GlobalShared.Pending</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Approved", new { @class = "form-check-input", id = "statusApproved" })
                                <label class="form-check-label" for="statusApproved">@GlobalShared.Approved</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Rejected", new { @class = "form-check-input", id = "statusRejected" })
                                <label class="form-check-label" for="statusRejected">@GlobalShared.Rejected</label>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "", new { @class = "text-danger " })
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.SelectTheCurrentApprovalStatusForTheTransferRequest."></i>
                    </div>
                </div>

                <!-- Display Requested Amount -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box float-end">
                            @GlobalMobileMoneyCashTopup.RequestedAmount: @Model.Amount.ToString("#,##0.0")
                        </span>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ThisIsTheAmountRequestedInTheTransfer."></i>
                    </div>
                </div>

                <!-- Request Approval Note (Readonly) -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalNote, new { @class = "form-control", @style = "height: 70px;" })
                        @Html.ValidationMessageFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalNote, "", new { @class = "text-danger " })
                        <label for="formValidationApprovalNote">@GlobalMobileMoneyCashTopup.ApprovalNote</label>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.EnterAnyNotesRegardingTheApprovalStatus."></i>
                    </div>
                </div>

                <!-- Request Details Section (Modal Trigger) -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#detailsModal">@GlobalMobileMoneyCashTopup.ViewRequestDetails</button>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ClickToViewTheDetailedInformationOfTheRequest."></i>
                    </div>
                </div>

                <!-- Request Note -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.RequestNote, new { @class = "form-control", @style = "height: 70px;", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.RequestNote, "", new { @class = "text-danger " })
                        <label for="formValidationDob">@GlobalMobileMoneyCashTopup.RequestNote</label>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ThisNoteContainsAdditionalInformationAboutTheRequest."></i>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary me-2">@GlobalShared.Approve</button>
            </div>
        </fieldset>
    }

    <!-- Modal to show details of the MobileMoneyCashTopup -->
    <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailsModalLabel">@GlobalMobileMoneyCashTopup.RequestDetails</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <table class="table">
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.RequestedDateTime:</th>
                            <td>@Model.RequestDate</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.TransactionReference:</th>
                            <td>@Model.MobileMoneyTransactionId</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.RequestReference:</th>
                            <td>@Model.RequestReference</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.RequestedAmount:</th>
                            <td>@Model.Amount.ToString("#,##0.0")</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.InitiatedBy:</th>
                            <td>@Model.RequestInitiatedBy</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.OperatorType:</th>
                            <td>@Model.OperatorType</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.Source Type:</th>
                            <td>@Model.SourceType</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.Branch:</th>
                            <td>@Model.Branch.BranchCode, @Model.Branch.Name</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.RequestNote:</th>
                            <td>@Model.RequestNote</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.ApprovalStatus:</th>
                            <td>@Model.RequestApprovalStatus</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.MemberReferenceAccountNumber:</th>
                            <td>@Model.MobileMoneyMemberReference & @Model.AccountNumber</td>
                        </tr>
                        <tr>
                            <th>@GlobalMobileMoneyCashTopup.ApprovalNote:</th>
                            <td>@Model.RequestApprovalNote</td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
                </div>
            </div>
        </div>
    </div>

}
