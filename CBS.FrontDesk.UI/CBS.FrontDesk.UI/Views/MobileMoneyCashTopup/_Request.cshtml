@model CBS.FrontDesk.Data.Entity.SavingProducts.AddMobileMoneyCashTopup
@using Resources
@using (Html.BeginForm("Create", "MobileMoneyCashTopup", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <fieldset class="fieldset-custom">
        <legend id="select_base">@GlobalMobileMoneyCashTopup.TransferRequestForm</legend>
        <div class="row mt-2 gy-4">
            <div class="col-md-8">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ @GlobalMobileMoneyCashTopup.SelectBranch+"---", new { @class = "form-control select2", @id = "branchInput" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger " })
                    <label>@GlobalMobileMoneyCashTopup.Branch</label>
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.SelectTheBranchWhereTheRequestIsBeingMade."></i>
                </div>
            </div>

            <!-- Requested Amount -->
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger " })
                    <label>@GlobalMobileMoneyCashTopup.RequestedAmount</label>
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.EnterTheAmountYouWishToRequest."></i>
                </div>
            </div>

            <!-- Mobile Money Transaction ID -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.MobileMoneyTransactionId, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MobileMoneyTransactionId, "", new { @class = "text-danger " })
                    <label>@GlobalMobileMoneyCashTopup.TransactionReference</label>
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ProvideTheTransactionReferenceForTrackingPurposes."></i>
                </div>
            </div>

            <!-- Account Number -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger " })
                    <label>@GlobalMobileMoneyCashTopup.MobileMoneyMemberAccountNumber</label>
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.EnterTheMobileMoneyNoneMembersAccountNumber."></i>
                </div>
            </div>

            <!-- Operator Type (MTN or Orange) -->
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    <label><b>@GlobalMobileMoneyCashTopup.OperatorType</b></label>
                    <br />
                    <div class="border p-3 me-2">
                        <div class="form-check form-check-inline" style="margin-right: 10px;">
                            @Html.RadioButtonFor(m => m.OperatorType, "MobileMoneyMTN", new { @class = "form-check-input", @id = "mtn" })
                            <label class="form-check-label" for="mtn">MTN</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.OperatorType, "MobileMoneyORANGE", new { @class = "form-check-input", @id = "orange" })
                            <label class="form-check-label" for="orange">Orange</label>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.OperatorType, "", new { @class = "text-danger " })
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.SelectTheMobileMoneyOperatorYouAreUsing."></i>
                </div>
            </div>

            <!-- Source Type (GAV, OtherTransfer, HeadOffice, Wirering, M2Float) -->
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    <label><b>@GlobalMobileMoneyCashTopup.TransferType</b></label>
                    <br />
                    <div class="border p-3 me-2">
                        @*<div class="form-check form-check-inline" style="margin-right: 10px;">
                            @Html.RadioButtonFor(m => m.SourceType, "AuxillaryToBranch", new { @class = "form-check-input", @id = "otherTransfer" })
                            <label class="form-check-label" for="otherTransfer">Other Transfer</label>
                        </div>*@
                        <div class="form-check form-check-inline" style="margin-right: 10px;">
                            @Html.RadioButtonFor(m => m.SourceType, "HeadOfficeToBranch", new { @class = "form-check-input", @id = "headOffice" })
                            <label class="form-check-label" for="headOffice">@GlobalMobileMoneyCashTopup.HeadOfficeToBranch</label>
                        </div>
                        @*<div class="form-check form-check-inline" style="margin-right: 10px;">
                            @Html.RadioButtonFor(m => m.SourceType, "BranchToBranch", new { @class = "form-check-input", @id = "wirering", @disabled = "disabled" })
                            <label class="form-check-label" for="wirering">Branch to branch</label>
                        </div>*@
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.SourceType, "BranchToHeadOffice", new { @class = "form-check-input", @id = "m2Float" })
                            <label class="form-check-label" for="m2Float">@GlobalMobileMoneyCashTopup.BranchToHeadOffice</label>
                        </div>
                    </div>

                    @Html.ValidationMessageFor(m => m.SourceType, "", new { @class = "text-danger " })
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ChooseTheSourceTypeForThisTransaction."></i>
                </div>
            </div>

            <!-- Request Note -->
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.RequestNote, new { @class = "form-control", @style = "height: 70px;" })
                    @Html.ValidationMessageFor(m => m.RequestNote, "", new { @class = "text-danger " })
                    <label for="formValidationDob">@GlobalMobileMoneyCashTopup.RequestNote</label>
                    <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ProvideAnyAdditionalNotesOrCommentsRegardingYourRequest."></i>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" id="btnSave" class="btn btn-primary me-2">@GlobalShared.Submit</button>
        </div>
    </fieldset>
}
