@{
    ViewBag.Title = "All requests";
}
@using Resources
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>@GlobalMobileMoneyCashTopup.AllMMCOMMRequests
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body d-sm-flex d-block">
                                            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0 ms-auto">
                                                <div class="ms-3">
                                                    <a type="button" href="/MobileMoneyCashTopup/AllRequests" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalMobileMoneyCashTopup.ReloadAllRequests.">
                                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion-body">
                                        @Html.Partial("_SearchBox")
                                        <div id="datalistingview">
                                            @Html.Partial("_AllRequestData")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">@GlobalMobileMoneyCashTopup.RequestDetails</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.RequestedDateTime:</th>
                            <td id="modalRequestDate" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.TransactionReference:</th>
                            <td id="modalTransactionReference" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.RequestReference:</th>
                            <td id="modalRequestReference" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.RequestedAmount:</th>
                            <td id="modalRequestedAmount" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.InitiatedBy:</th>
                            <td id="modalInitiatedBy" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.OperatorType:</th>
                            <td id="modalOperatorType" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.SourceType:</th>
                            <td id="modalSourceType" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.Branch:</th>
                            <td id="modalBranch" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.RequestNote:</th>
                            <td id="modalRequestNote" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.ApprovalStatus:</th>
                            <td id="modalApprovalStatus" class="wrap-text">
                                <span class="badge" id="approvalStatusBadge"></span>
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.MemberReferenceAccountNumber:</th>
                            <td id="modalMemberReferenceAccountNumber" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.ApprovalNote:</th>
                            <td id="modalApprovalNote" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.ApprovalDate:</th>
                            <td id="modalApprovalDate" class="wrap-text"></td>
                        </tr>
                        <tr>
                            <th scope="row">@GlobalMobileMoneyCashTopup.ApprovedBy:</th>
                            <td id="modalApprovedBy" class="wrap-text"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>
<style>
    .table {
        width: 100%;
        margin-bottom: 1rem;
        color: #212529;
    }

        .table th {
            background-color: #f8f9fa;
            color: #495057;
            font-weight: 600;
        }

        .table td {
            vertical-align: middle;
        }

    .wrap-text {
        word-wrap: break-word;
        white-space: normal;
    }

    .modal-header {
        border-bottom: 1px solid #dee2e6;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
    }
    .badge {
        padding: 0.5em 0.75em;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }

    .badge-approved {
        background-color: #28a745; /* Green for approved */
        color: white;
    }

    .badge-pending {
        background-color: #ffc107; /* Yellow for pending */
        color: white;
    }

    .badge-rejected {
        background-color: #dc3545; /* Red for rejected */
        color: white;
    }
</style>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {
        $("#searchButton").click(function () {
            // Check if a branch is selected
            var branchId = $("#branchInput").val();
            // Check if any radio button is selected
            var statusSelected = $("input[name='status']:checked").length > 0;

            if (!branchId) {
                appalert("Please select a branch.", 3, 1);

                return; // Stop the function if no branch is selected
            }

            if (!statusSelected) {
                appalert("Please select a status.", 3, 1);
                return; // Stop the function if no radio button is selected
            }

            LoadDataTables(); // Call the function on button click
        });
    });


    var LoadDataTables = function () {
        var branchid = $("#branchInput").val(); // Update this selector to match your dropdown
        var status = $("input[name='status']:checked").val(); // Get the selected status

        $("#myDataTable").DataTable({
            "destroy": true, // Allows reinitialization of the DataTable
            "serverSide": true,
            "ajax": {
                "url": "/MobileMoneyCashTopup/AllRequests", // Ensure this URL matches your action method
                "type": "POST",
                "data": function (d) {
                    d.branchid = branchid; // Send the branch id
                    d.status = status; // Send the selected status
                }
            },
            "columns": [
                { "data": "StrRequestDate" },
                {
                    "data": "Amount",
                    "render": function (data) {
                        return parseFloat(data).toFixed(1).replace(/\d(?=(\d{3})+\.)/g, '$&,'); // Format with commas and one decimal
                    }
                },
                {
                    "data": "OperatorType",
                    "render": function (data) {
                        if (data === "MobileMoneyMTN") {
                            return '<span class="badge bg-facebook">MTN</span>';
                        } else {
                            return '<span class="badge bg-instagram">Orange</span>';
                        }
                    }
                },
                { "data": "SourceType" }, // Ensure this matches your model
                { "data": "BranchName" }, // Assuming this is how you want to display Branch
                {
                    "data": "RequestApprovalStatus",
                    "render": function (data) {
                        if (data === "Approved") {
                            return '<span class="badge bg-info">Approved</span>';
                        } else {
                            return '<span class="badge bg-danger">' + data + '</span>';
                        }
                    }
                },
                { "data": "RequestInitiatedBy" }, // Initiated by
                {
                    "data": null,
                    "render": function (data, type, row) {
                        return `
                        <a href="#" onclick="Details('${row.Id}')">Details</a> |
                        <a href="#" onclick="Delete('${row.Id}')" class="text-danger">Delete</a>`;
                    }
                }
            ],
            "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]],
            "order": [[0, "desc"]], // Default ordering
            "footerCallback": function (row, data, start, end, display) {
                // Example footer callback if needed
            }
        });
    };


    function Delete(id) {
        alertify.confirm("Delete Transfer Request",
            "Are you sure you want to delete this record? This action cannot be undone.",
            function () {
                $.ajax({
                    url: '/MobileMoneyCashTopup/Delete', // Ensure this URL matches your action method
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            appalert("The record has been successfully deleted.", 1, 1); // Success message
                            $('#myDataTable').DataTable().ajax.reload(); // Reload the DataTable
                        } else {
                            appalert("Error deleting record: " + response.message, 3, 1); // Error message
                        }
                    },
                    error: function () {
                        appalert("An error occurred while trying to delete the record. Please try again later.", 3, 1); // General error message
                    }
                });
            },
            function () {
                appalert('Transaction cancelled. The record was not deleted.', 3, 1); // Cancellation message
            }
        );
    }



