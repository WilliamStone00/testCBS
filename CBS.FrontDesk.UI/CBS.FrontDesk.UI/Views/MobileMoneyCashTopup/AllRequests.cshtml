    function Details(id) {
        $.ajax({
            url: `/MobileMoneyCashTopup/Details/${id}`,
            type: "GET",
            success: function (data) {
                if (data.success) {
                    $("#modalRequestDate").text(data.data.StrRequestDate);
                    $("#modalApprovalDate").text(data.data.StrRequestApprovalDate);
                    $("#modalApprovedBy").text(data.data.RequestApprovedBy);
                    $("#modalTransactionReference").text(data.data.MobileMoneyTransactionId);
                    $("#modalRequestReference").text(data.data.RequestReference);
                    $("#modalRequestedAmount").text(parseFloat(data.data.Amount).toFixed(1).replace(/\d(?=(\d{3})+\.)/g, '$&,'));
                    $("#modalInitiatedBy").text(data.data.RequestInitiatedBy);
                    $("#modalOperatorType").text(data.data.OperatorType);
                    $("#modalSourceType").text(data.data.SourceType);
                    $("#modalBranch").text(data.data.BranchName);
                    $("#modalRequestNote").text(data.data.RequestNote);

                    // Set the approval status and badge
                    $("#modalApprovalStatus").text(data.data.RequestApprovalStatus);
                    const approvalStatusBadge = $("#approvalStatusBadge");
                    approvalStatusBadge.text(data.data.RequestApprovalStatus); // Set the badge text
                    switch (data.data.RequestApprovalStatus) {
                        case "Approved":
                            approvalStatusBadge.addClass("badge-approved");
                            break;
                        case "Pending":
                            approvalStatusBadge.addClass("badge-pending");
                            break;
                        case "Rejected":
                            approvalStatusBadge.addClass("badge-rejected");
                            break;
                        default:
                            approvalStatusBadge.removeClass("badge-approved badge-pending badge-rejected");
                    }

                    $("#modalMemberReferenceAccountNumber").text(`${data.data.MobileMoneyMemberReference} & ${data.data.AccountNumber}`);
                    $("#modalApprovalNote").text(data.data.RequestApprovalNote);
                    $("#modalApprovalDate").text(data.data.ApprovalDate);
                    $("#modalApprovedBy").text(data.data.ApprovedBy);

                    $("#detailsModal").modal('show');
                } else {
                    alert(data.message);
                }
            },
            error: function () {
                alert('Error retrieving details.');
            }
        });
    }



</script>
