@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier
    @using Resources
@{
    ViewBag.Title = "Member's None Cash Operations";
}
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<!-- Page Header -->
<div class="row mb-0">
    <div class="col">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-wallet-outline me-2"></i></i> @GlobalMemberNoneCashOperation.ManageMembersNoneCashOperations
                </h1>
                <p class="card-text">
                    @GlobalMemberNoneCashOperation.PerformOtherNonecashTransactions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-0">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOperationTips" aria-expanded="false" aria-controls="collapseOperationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseOperationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.UseTheSearchBarToFindAMembersAccount.</li>
                <li><i class="mdi mdi-account-box-outline text-primary me-2"></i> @GlobalMemberNoneCashOperation.VerifyTheMembersNameAndAccountDetails.</li>
                <li><i class="mdi mdi-wallet-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.SelectWhetherTo <strong>@GlobalMemberNoneCashOperation.Debit</strong> @GlobalMemberNoneCashOperation.or <strong>@GlobalMemberNoneCashOperation.Credit</strong> @GlobalMemberNoneCashOperation.theMembersAccountByChoosingTheAppropriateOption.</li>
                <li><i class="mdi mdi-chart-areaspline text-primary me-2"></i> @GlobalMemberNoneCashOperation.ChooseTheCorrespondingGeneralLedger.</li>
                <li><i class="mdi mdi-note-edit-outline text-info me-2"></i> @GlobalMemberNoneCashOperation.ProvideADetailedNoteDescribingTheReasonForTheOperation.</li>
                <li><i class="mdi mdi-cash-multiple text-warning me-2"></i> @GlobalMemberNoneCashOperation.DoubleCheckAllAmountsEntered.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalMemberNoneCashOperation.OnlyOneOperationCanBeProcessedAtAtime.</li>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalMemberNoneCashOperation.EnsureTheSelectedLedgerAndMemberAccountAreCorrect.</li>
                <li><i class="mdi mdi-shield-check-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.OnceAtransactionIsSubmitted.</li>
                <li><i class="mdi mdi-clock-outline text-warning me-2"></i> @GlobalMemberNoneCashOperation.TheMembersAccountWillOnlyBeImpactedOnce.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col">
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-wallet-outline me-2"></i>
                            <span id="cashDeskOperations">@GlobalMemberNoneCashOperation.MEMBERSOTHERNONECASHOPERATION</span>
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <hr style="border: 2px solid blue;" />
                            @Html.Partial("_SearchBox")
                            <hr style="border: 2px solid blue;" />
                            <div id="datalistingview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/MemberNoneCashOperation/MembersNoneCashOperations.js"></script>
}
