
@{
    ViewBag.Title = @AccountOpeningRulePerBranch_Index.AccountOpeningRules;
}
@using Resources

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<!-- 🔖 Page Title & Intro -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-1">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-clipboard-text-outline me-2"></i>@AccountOpeningRulePerBranch_Index.AccountOpeningRuleConfiguration
                </h1>
                <p class="card-text">
                    @AccountOpeningRulePerBranch_Index.ManageBranchSpecificRules.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 🧠 Tips -->
<div class="row">
    <div class="col-12">
        <div class="accordion" id="helpTipsAccordion">
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @AccountOpeningRulePerBranch_Index.ACCOUNTOPENINGRULETIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="true">
                        <i class="mdi mdi-chevron-up"></i>
                    </button>
                </h6>
                <div id="collapseHelpTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-2">
                            <li><strong>@AccountOpeningRulePerBranch_Index.BranchSpecific:</strong> @AccountOpeningRulePerBranch_Index.SetDifferentRulesPerBranch.</li>
                            <li><strong>@AccountOpeningRulePerBranch_Index.BalanceLimits:</strong> @AccountOpeningRulePerBranch_Index.DefineMinimumAndMaximumAllowable.</li>
                            <li><strong>@AccountOpeningRulePerBranch_Index.InstallmentPermission:</strong> @AccountOpeningRulePerBranch_Index.AllowOrRestrictOpeningPayments.</li>
                            <li><strong>@AccountOpeningRulePerBranch_Index.LegalForms:</strong> @AccountOpeningRulePerBranch_Index.ChooseWhetherARuleApplies.</li>
                        </ul>
                        <p class="text-muted mb-0"><strong>@AccountOpeningRulePerBranch_Index.Note:</strong> @AccountOpeningRulePerBranch_Index.TheseRulesEnsureConsistency_.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 📋 Main Section - Rule Listing -->
<div class="row">
    <div class="col">
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="branchIdFilter" class="form-label fw-semibold">@AccountOpeningRulePerBranch_Index.FilterByBranch</label>
                <select id="branchIdFilter" class="form-select select2">
                    <option value="">-- @AccountOpeningRulePerBranch_Index.AllBranches --</option>
                    @foreach (var branch in ViewBag.Branches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="savingProductIdFilter" class="form-label fw-semibold">@AccountOpeningRulePerBranch_Index.FilterByProduct</label>
                <select id="savingProductIdFilter" class="form-select select2">
                    <option value="">-- @AccountOpeningRulePerBranch_Index.AllProducts --</option>
                    @foreach (var product in ViewBag.SavingProducts)
                    {
                        <option value="@product.Value">@product.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="filterRulesBtn" class="btn btn-primary w-100">
                    <i class="mdi mdi-filter-variant"></i> @AccountOpeningRulePerBranch_Index.Filter
                </button>
            </div>
        </div>



        <div class="row my-3">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingRules">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionRules" aria-expanded="true">
                            <i class="mdi mdi-table me-2"></i>
                            <span id="cashDeskOperations">@AccountOpeningRulePerBranch_Index.ACCOUNTOPENINGRULESTABLE</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="accordionRules" class="accordion-collapse collapse show" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="mb-3">
                                <button class="btn btn-primary" onclick="openCreateRuleModal()">
                                    <i class="mdi mdi-plus-circle-outline"></i> @AccountOpeningRulePerBranch_Index.AddNewRule
                                </button>
                            </div>
                            <div id="datalistingview">
                                <table id="myDataTable" class="table table-bordered table-hover w-100"></table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔲 Modal for Create/Edit -->
@Html.Partial("_AccountOpeningRuleModal")

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/Crud/AccountOpeningRulePerBranch/AccountOpeningRulePerBranch.js"></script>

}
