<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/AppFiles/Images/Icon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&ampdisplay=swap" rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/fonts/materialdesignicons.css" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/fonts/flag-icons.css" />

    <!-- Menu Waves -->
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/libs/node-waves/node-waves.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/css/rtl/core.css" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/css/rtl/theme-default.css" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/libs/typeahead-js/typeahead.css" />
    <link href="~/Loaders/CSSJS/Spin.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/libs/toastr/toastr.css" />
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/libs/animate-css/animate.css" />

    <!-- Page CSS -->
    <link rel="stylesheet" href="~/CBSTemp/ui/assets/vendor/css/pages/page-auth.css" />
    <style>
    html, body {
        height: 100dvh;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex: 1;
        height: 100%;
    }

    .tsc-header {
        background-color: #003865;
        color: white;
        padding: 1rem 1.5rem;
        text-align: center;
        font-weight: 600;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .tsc-header .tsc-logo {
        height: 40px;
    }

    .tsc-header .tsc-title {
        font-size: 1.2rem;
        font-weight: bold;
        color: #00c897;
        text-transform: uppercase;
    }

    .tsc-header .tsc-subtitle {
        font-size: 1rem;
        color: white;
        margin-left: 0.5rem;
        font-weight: normal;
    }

    .tsc-footer {
        background-color: #003865;
        color: #ddd;
        text-align: center;
        padding: 0.75rem;
        font-size: 0.85rem;
        border-top: 1px solid #1b3f5e;
    }

    .main-content {
        display: flex;
        flex: 1;
        overflow: hidden;
        min-height: 0;
    }

    .right-panel {
        flex: 1 1 40%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/AppFiles/Images/background-transparent.png') center center no-repeat;
        background-size: contain;
        background-color: #fff;
        padding: 1rem;
    }

    .form-box {
        width: 100%;
        max-width: 420px;
        padding: 2rem;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        background-color: rgba(255,255,255,0.95);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .logo {
        max-width: 75px;
        display: block;
        margin: 0 auto 0.75rem auto;
    }

    .left-panel {
        background-color: #e7f5ff;
        flex: 1 1 60%;
        padding: 1.25rem 1rem 1.25rem 2rem;
        font-size: 0.95rem;
        overflow-y: auto;
    }

    .left-panel h5, .left-panel h6 {
        margin-top: 1rem;
    }

    .left-panel ul, .left-panel p {
        margin-bottom: 1rem;
    }

    .left-panel ul li {
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .main-content {
            flex-direction: column;
        }

        .left-panel, .right-panel {
            flex: 1 1 100%;
            padding: 1rem;
        }

        .right-panel {
            background: none !important;
        }

        .form-box {
            max-width: 100%;
            height: auto;
            margin: 0 auto;
        }
    }
    </style>
    <!-- Helpers -->
    <script src="~/CBSTemp/ui/assets/vendor/js/helpers.js"></script>
    <script src="~/CBSTemp/ui/assets/vendor/js/template-customizer.js"></script>
    <script src="~/CBSTemp/ui/assets/js/config.js"></script>
</head>
<body>
    <div class="page-wrapper">
        <header class="tsc-header">
            @*<img src="~/AppFiles/Images/Logog2XI.png" class="tsc-logo" />*@
            <span class="tsc-title">TRUSTSOFTCREDIT</span>
            <span class="tsc-subtitle">SECURE ACCOUNT PORTAL</span>
        </header>

        @RenderBody()
        @Html.Partial("_AjaxSpinner")

        <footer class="tsc-footer">
            &copy; @DateTime.Now.Year <strong>TRUSTSOFTCREDIT</strong> — Powered by <strong>F L U X SARL Cameroon</strong>, <span>Head Office Bamenda</span>
        </footer>
    </div>


    <!-- Core + Plugin JS -->
    <script src="~/CBSTemp/ui/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>


    <script src="~/Loaders/CSSJS/Spin.js"></script>
    <script src="~/CBSTemp/ui/assets/vendor/libs/toastr/toastr.js"></script>
    <script src="~/Scripts/Js/main.js/App.js"></script>
    <script src="~/CBSTemp/ui/assets/js/main.js"></script>
    <script src="~/CBSTemp/ui/assets/js/pages-auth.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>