@{
    var menuItems = ViewBag.MenuItems as List<CBS.FrontDesk.Data.Entity.DatabaseMenus>;
}

@if (menuItems != null && menuItems.Any())
{
    <aside id="layout-menu" class="layout-menu menu-vertical menu bg-white">
        <div class="app-brand demo d-flex align-items-center">
            <a href="/" class="app-brand-link me-auto">
                <span class="app-brand-logo demo">
                    <span style="color: var(--bs-primary)">
                        <img src="~/AppFiles/Images/SideImageHeader_login.png" alt="TrustBank Logo" style="max-width: 100px; height: auto;" /> <!-- Adjust the max-width as needed -->
                    </span>
                </span>
            </a>

            <button class="layout-menu-toggle btn btn-outline-primary btn-sm">
                <i class="fas fa-bars"></i> <!-- Font Awesome icon for bars -->
            </button>
        </div>
        <hr />
        <div class="menu-inner-shadow"></div>
        <div class="d-flex align-items-center">
            <div class="user-image me-3 ml-1 d-flex align-items-center justify-content-center">
                <img src="@Session["Photo"].ToString()" alt="User Profile Image" class="img-fluid rounded-circle" style="width: 40px; height: 40px;" />
            </div>
            <div class="user-info">
                <span class="user-name">@Session["FullName"].ToString()</span>
            </div>
        </div>

        <hr />
        <ul class="menu-inner py-1">

            @foreach (var item in menuItems.Where(m => m.ParentId == 0 && m.IsVisible))
            {
                <li class="menu-item">
                    @if (menuItems.Any(m => m.ParentId == item.MenuMasterId && m.IsVisible))
                    {
                        <a href="javascript:void(0);" class="menu-link menu-toggle">
                            <i class="@item.IconClass" style="margin-right: 10px;"></i> <!-- Added margin -->
                            <div style="color: black;">@item.MenuText</div> <!-- Menu text colored black -->
                        </a>
                        <ul class="menu-sub">
                            @foreach (var subItem in menuItems.Where(m => m.ParentId == item.MenuMasterId && m.IsVisible))
                            {
                                <li class="menu-item">
                                    @if (menuItems.Any(m => m.ParentId == subItem.MenuMasterId && m.IsVisible))
                                    {
                                        <a href="javascript:void(0);" class="menu-link menu-toggle">
                                            <div style="color: black;">@subItem.MenuText</div> <!-- Menu text colored black -->
                                        </a>
                                        <ul class="menu-sub">
                                            @foreach (var subSubItem in menuItems.Where(m => m.ParentId == subItem.MenuMasterId && m.IsVisible))
                                            {
                                                <li class="menu-item">
                                                    <a href="@Url.Action(subSubItem.ActionName, subSubItem.ControllerName)" class="menu-link">
                                                        <div style="color: black;">@subSubItem.MenuText</div> <!-- Menu text colored black -->
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action(subItem.ActionName, subItem.ControllerName)" class="menu-link">
                                            <div style="color: black;">@subItem.MenuText</div> <!-- Menu text colored black -->
                                        </a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <a href="@Url.Action(item.ActionName, item.ControllerName)" class="menu-link">
                            <i class="@item.IconClass" style="margin-right: 10px;"></i> <!-- Added margin -->
                            <div style="color: black;">@item.MenuText</div> <!-- Menu text colored black -->
                        </a>
                    }
                </li>
            }
        </ul>
    </aside>
}

