@{
    ViewBag.Title = "Error Page";
    var title = ViewBag.TitleText ?? "Error";
    var message = ViewBag.Message ?? "An unexpected error has occurred.";
    var suggestion = ViewBag.Suggestion ?? "Please contact support if the issue persists.";
    var errorCode = ViewBag.StatusCode ?? 500;
    var userIp = ViewBag.UserIP ?? "Unknown IP";
    var stackTrace = ViewBag.StackTrace ?? "";
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    var showDiagnostics = HttpContext.Current.IsDebuggingEnabled;
}
@using Resources
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-start border-4 border-danger">
                <div class="card-body">

                    <!-- Error Title and Code -->
                    <h3 class="text-danger mb-3">
                        <i class="mdi mdi-alert-circle-outline me-2"></i> @title
                    </h3>

                    <p class="mb-2 fs-6">
                        <strong>Status Code:</strong>
                        <span class="badge bg-dark">@errorCode</span>
                    </p>

                    <!-- Error Message -->
                    <div class="mb-3">
                        <p class="text-muted mb-1">
                            <strong>Message:</strong> @message
                        </p>
                        <p class="text-muted mb-1">
                            <strong>Suggestion:</strong> @suggestion
                        </p>
                    </div>

                    <!-- Show IP Address for 429 (Rate Limiting) -->
                    @if (errorCode == 429)
                    {
                        <div class="alert alert-warning bg-light-subtle p-3 rounded mt-4">
                            <h6 class="text-warning fw-bold mb-2">
                                <i class="mdi mdi-alert-outline me-1"></i> @GlobalShared.RateLimitExceeded
                            </h6>
                            <p class="small text-dark mb-0">
                                @GlobalShared.YourIPAddress: <strong>@userIp</strong>
                            </p>
                            <p class="small text-dark mb-0">
                                @GlobalShared.YourIPHasBeenTemporarilyRestrictedFor30MinutesDueToExcessiveRequests.
                            </p>
                        </div>
                    }

                    <!-- Diagnostic Information (Debug Mode Only) -->
                    @if (showDiagnostics && !string.IsNullOrEmpty(stackTrace))
                    {
                        <div class="alert alert-warning bg-light-subtle p-3 rounded mt-4">
                            <h6 class="text-warning fw-bold mb-2">
                                <i class="mdi mdi-bug-outline me-1"></i> @GlobalShared.DiagnosticInformation
                            </h6>
                            <pre class="small text-dark mb-0" style="white-space: pre-wrap;">@stackTrace</pre>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <hr class="mb-4" />
                    <div class="text-center mb-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                            <i class="mdi mdi-home-outline me-1"></i> @GlobalShared.ReturnToHome
                        </a>
                    </div>

                    <p class="text-muted small mt-3 mb-0 text-center">
                        @GlobalShared.IfTheissueContinuesPleaseContactTechnicalSupport.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
