@using Resources
<div class="alert alert-outline-success alert-dismissible" role="alert" id="message_div_success" style="display:none">
    <label id="messagesuccess"></label>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="alert alert-outline-danger alert-dismissible" role="alert" id="message_div_danger" style="display:none">
    <label id="messagedanger"></label>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="alert alert-outline-warning alert-dismissible" role="alert" id="message_div_warning" style="display:none">
    <label id="messagewarning"></label>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="alert alert-outline-info alert-dismissible" role="alert" id="message_div_info" style="display:none">
    <label id="messageinfo"></label>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="alert alert-outline-dark mb-0 alert-dismissible" role="alert" style="display:none">
    @GlobalShared.ThisIsADarkOutlineAlertCheckItOut!
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>