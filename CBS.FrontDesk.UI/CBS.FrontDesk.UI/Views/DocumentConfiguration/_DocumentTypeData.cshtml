@model  CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
    @using Resources
<table class="table table-hover" id="myDataTable_DocumentType">
    <thead class="table-light">
        <tr>
            <th>@GlobalDocumentConfiguration.Document</th>
            <th>@GlobalDocumentConfiguration.Type</th>
            <th>@GlobalDocumentConfiguration.Description</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.DocumentTypeDtos)
        {

            <tr>
                <td style="width:20%">@d.documentName</td>
                <td style="width:20%">@d.name</td>
                <td style="width:40%">@d.description</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_DocumentType','_CreateDocumentType','update','DocumentConfiguration','DocumentType')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.name @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                    <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.name" onclick="DeleteDataConfiguration('DocumentConfiguration','@d.id','myDataTable_DocumentType','_DocumentTypeData',0,'datalistingview_DocumentType','DocumentType')">@GlobalShared.Delete</a>

                </td>


            </tr>


        }
    </tbody>
</table>
