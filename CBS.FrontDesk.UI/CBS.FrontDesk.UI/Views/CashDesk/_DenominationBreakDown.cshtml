@using Resources
<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend style="color: blue">@CashDesk_DenominationBreakDown.Denomination</legend>
        <table class="table table-striped table-hover" id="myDataTable" style="border-collapse: collapse; width: 100%;">
            <thead>
                <tr>
                    <th colspan="2" class="separation-text"><h6 class="card-title">@CashDesk_DenominationBreakDown.Notes</h6></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>10,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note10000" oninput="calculateBalance()" value="0" min="0" step="1" data-denomination="10000"></td>
                </tr>
                <tr>
                    <td><strong>5,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note5000" oninput="calculateBalance()" value="0" min="0" step="1" data-denomination="5000"></td>
