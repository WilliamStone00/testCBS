@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources

@{
    // Safe fallbacks – adjust to your actual property names if different
    var memberName = Model?.Customer.name ?? "—";
    var branchName = Model?.Branch.Name ?? "—";
    var branchCode = Model?.Branch.BranchCode ?? "—";
    string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";

        var parts = name.Trim()
                        .Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return (parts[0][0].ToString() + parts.Last()[0]).ToUpper();
    }

}
<style>
    /* ========== Member Info ========== */
    .member-info .avatar-initials {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        background: #e9f4ff;
        color: #0d6efd;
        box-shadow: inset 0 0 0 1px rgba(13,110,253,.15);
    }

    .member-info.compact .card-body {
        padding: .75rem 1rem;
    }

    .member-info.compact .avatar-initials {
        width: 40px;
        height: 40px;
        font-size: .9rem;
    }

    .member-info .fw-bold {
        color: var(--bs-emphasis-color);
        font-weight: 600;
    }

    /* ========== Stat Tiles ========== */
    .stat-tile {
        border: 1px solid var(--bs-border-color);
        border-radius: 1rem;
        padding: 1rem;
        background: #fff;
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.04);
    }

    .stat-icon {
        width: 36px;
        height: 36px;
        border-radius: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-bottom: .5rem;
    }

    .stat-label {
        font-size: .85rem;
        color: var(--bs-secondary-color);
    }

    .stat-value {
        font-size: 1.125rem;
        font-weight: 800;
    }

    .compact .stat-tile {
        padding: .75rem .85rem;
        border-radius: .75rem;
        box-shadow: 0 .075rem .15rem rgba(0,0,0,.03);
    }

    .compact .stat-icon {
        width: 28px;
        height: 28px;
        border-radius: .5rem;
        font-size: .8rem;
        margin-bottom: .4rem;
    }

    .compact .stat-label {
        font-size: .78rem;
        opacity: .8;
    }

    .compact .stat-value {
        font-size: 1rem;
        font-weight: 700;
    }

    /* ========== Total Panel ========== */
    .total-panel {
        border: 1px dashed var(--bs-border-color);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(180deg,#f8fbff,#ffffff);
    }

    .compact .total-panel {
        padding: .75rem .9rem;
        border-radius: .75rem;
        background: linear-gradient(180deg,#fcfdff,#ffffff);
    }

    .compact #summaryTotal {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--bs-emphasis-color);
    }

    .compact .small, .compact .text-secondary {
        opacity: .9;
    }

    /* ========== Legend ========== */
    .legend-chip {
        display: inline-block;
        padding: .35rem .75rem;
        border-radius: 999px;
        background: #eef6ff;
        color: #0d6efd;
        font-weight: 700;
        letter-spacing: .2px;
        border: 1px solid rgba(13,110,253,.15);
    }
    /* Softer, smaller legends */
    fieldset legend {
        font-size: 0.85rem; /* reduce size */
        font-weight: 600; /* less bold */
        color: var(--bs-secondary-color); /* softer grey-blue instead of strong black */
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: .5rem;
    }
    /* Smaller, softer legends for repayment/summary sections only */
    .fieldset-custom legend {
        font-size: 0.85rem; /* reduce size */
        font-weight: 600; /* lighter bold */
        color: var(--bs-secondary-color); /* softer gray-blue */
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: .5rem;
    }

    .compact legend {
        font-size: .95rem;
        font-weight: 700;
    }

    /* ========== Buttons ========== */
    .compact .btn {
        padding: .35rem .6rem;
        font-size: .8rem;
    }

    /* ========== Simulation Card + Table ========== */
    .sim-card {
        border-radius: 1rem;
        background: linear-gradient(180deg,#ffffff,#fbfbfe);
    }

    .sim-table thead th {
        border-bottom: 1px solid var(--bs-border-color);
        color: var(--bs-secondary-color);
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        background: #f7f9fc;
    }

    .sim-table td, .sim-table th {
        vertical-align: middle;
    }

    .sim-table tbody tr:hover {
        background: #f8fbff;
    }

    .sim-table input.form-control-sm {
        border-radius: .6rem;
    }

    /* ========== Compact Global Adjustments ========== */
    .compact,
    .compact .card,
    .compact .stat-tile,
    .compact .total-panel {
        color: var(--bs-body-color);
    }

        .compact .text-dark-emphasis,
        .compact .stat-label,
        .compact .fw-bold,
        .compact .fw-bolder {
            color: var(--bs-secondary-color) !important;
            font-weight: 600;
        }

        .compact .row.g-3 {
            --bs-gutter-x: .75rem;
            --bs-gutter-y: .75rem;
        }
</style>

<style>
    /* Hide print area on screen */
    .print-sim {
        display: none;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printSim, #printSim * {
            visibility: visible !important;
        }



        @@page {
            size: A4;
            margin: 12mm;
        }

        .simdoc {
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial;
            color: #222;
            font-size: 12px;
        }

        .simdoc-header {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            border-bottom: 1px solid #e3e7ef;
            padding-bottom: 8px;
        }

            .simdoc-header .left {
                display: flex;
                gap: 12px;
                align-items: center;
            }

        .brand-mark {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #e9f4ff;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .brand-name {
            font-weight: 700;
            font-size: 14px;
        }

        .doc-title {
            font-weight: 700;
            font-size: 13px;
            color: #333;
        }

        .doc-sub {
            font-size: 11px;
            color: #777;
        }

        .simdoc-header .right {
            font-size: 12px;
        }

            .simdoc-header .right .lbl {
                color: #666;
            }

        .infobar {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin: 10px 0 6px;
            background: #f8fafc;
            border: 1px solid #edf1f7;
            padding: 8px 10px;
            border-radius: 6px;
        }

            .infobar .lbl {
                color: #666;
            }

        .section {
            margin-top: 10px;
        }

        .section-title {
            font-weight: 700;
            font-size: 12px;
            color: #333;
            margin: 6px 0;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 8px;
        }

        .kpi {
            border: 1px solid #e8ebf0;
            border-radius: 8px;
            padding: 8px;
        }

        .kpi-label {
            font-size: 11px;
            color: #666;
        }

        .kpi-val {
            font-size: 12px;
            font-weight: 700;
            color: #1d1d1d;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px dashed #dfe3ea;
            border-radius: 8px;
            padding: 10px 12px;
            margin-top: 8px;
        }

            .total-line .lbl {
                color: #666;
            }

            .total-line .val {
                font-size: 16px;
                font-weight: 800;
                color: #111;
            }

        .simtbl {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

            .simtbl th, .simtbl td {
                border: 1px solid #e6e9f0;
                padding: 6px;
            }

            .simtbl thead th {
                background: #f5f7fb;
                color: #555;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .03em;
            }

        .text-end {
            text-align: right;
        }

        .note ul {
            margin: 6px 0 0 16px;
        }
        /* Screen only: hide print simulation area */
        #printSim {
            position: absolute;
            left: -9999px; /* push off-screen */
            top: -9999px;
        }

        @@media print {
            body * {
                visibility: hidden !important;
            }

            #printSim, #printSim * {
                visibility: visible !important;
            }

            #printSim {
                position: absolute;
                inset: 0; /* stretch to page */
                left: 0 !important;
                top: 0 !important;
                padding: 14mm;
                background: #fff; /* ensure white background */
            }
        }
    }
</style>

<!-- ===== Member Information (new) ===== -->
<div class="card shadow-sm mb-2 border-0 member-info compact">
    <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <div class="avatar-initials">@GetInitials(memberName)</div>

        <div class="flex-grow-1">
            <div class="fw-semibold text-dark-emphasis small mb-1">@GlobalLoanRepaymentBackOffice.MembersName</div>
            <div class="fs-5 fw-bold">@memberName</div>
        </div>

        <div class="vr d-none d-md-block"></div>

        <div class="flex-grow-1">
            <div class="fw-semibold text-dark-emphasis small mb-1">@GlobalLoanRepaymentBackOffice.BranchName</div>
            <div class="fw-medium">@branchName</div>
        </div>

        <div class="vr d-none d-md-block"></div>

        <div>
            <div class="fw-semibold text-dark-emphasis small mb-1">@GlobalLoanRepaymentBackOffice.BranchCode</div>
            <span class="badge rounded-pill text-bg-secondary px-3 py-2">@branchCode</span>
        </div>
    </div>
</div>


<fieldset class="fieldset-custom mt-1">
    <legend class="legend-chip">@CashDesk_LoanRepaymentSimulationForm.ComputedDetails</legend>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#computedDetailsSection"
                aria-expanded="true"
                aria-controls="computedDetailsSection">
            @CashDesk_LoanRepaymentSimulationForm.ToggleSummary
        </button>
    </div>

    <div class="collapse show compact" id="computedDetailsSection">
        <div class="row g-3 align-items-stretch">
            <!-- Capital -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="stat-tile h-100">
                    <div class="stat-icon bg-success-subtle text-success">₵</div>
                    <div class="stat-label">@CashDesk_LoanRepaymentSimulationForm.RefundAmount</div>
                    <div class="stat-value" id="summaryCapital">0.0 @CashDesk_LoanRepaymentSimulationForm.XAF</div>
                </div>
            </div>

            <!-- Interest -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="stat-tile h-100">
                    <div class="stat-icon bg-info-subtle text-info">%</div>
                    <div class="stat-label">@CashDesk_LoanRepaymentSimulationForm.InterestAmount</div>
                    <div class="stat-value" id="summaryInterest">0.0 @CashDesk_LoanRepaymentSimulationForm.XAF</div>
                </div>
            </div>

            <!-- VAT -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="stat-tile h-100">
                    <div class="stat-icon bg-warning-subtle text-warning">VAT</div>
                    <div class="stat-label">
                        @* Use text literal to avoid resource-key spacing issue *@
                        <text>VAT Amount (on Interest)</text>
                    </div>
                    <div class="stat-value" id="summaryVat">0.0 @CashDesk_LoanRepaymentSimulationForm.XAF</div>
                </div>
            </div>

            <!-- Penalty -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="stat-tile h-100">
                    <div class="stat-icon bg-secondary-subtle text-secondary">!</div>
                    <div class="stat-label">@CashDesk_LoanRepaymentSimulationForm.PenaltyAmount</div>
                    <div class="stat-value" id="summaryPenalty">0.0 @CashDesk_LoanRepaymentSimulationForm.XAF</div>
                </div>
            </div>

            <!-- Total -->
            <div class="col-12">
                <div class="total-panel">
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                        <div class="text-dark-emphasis small fw-semibold">@CashDesk_LoanRepaymentSimulationForm.TotalRepaymentAmount</div>
                        <div class="display-6 fw-bolder mb-0" id="summaryTotal">0.0 @CashDesk_LoanRepaymentSimulationForm.XAF</div>
                    </div>
                    <div class="mt-1 small text-secondary">
                        <text>@CashDesk_LoanRepaymentSimulationForm.Interest</text>
                    </div>
                </div>
            </div>
        </div>
    </div>


</fieldset>

<!-- ===== Existing Simulator / VAT mode controls (kept) ===== -->
<fieldset class="fieldset-custom">
    <!-- Your existing table block is unchanged -->
    @* (Keep your current table markup exactly as you posted) *@

    <legend class="legend-chip">@CashDesk_LoanRepaymentSimulationForm.LoanRepaymentFrom</legend>

    <div class="card shadow-sm border-0 sim-card">
        <div class="card-body pb-2">

            <!-- Top row: date + VAT mode -->
            <div class="row g-3 align-items-center justify-content-between">

                <div class="col-12 col-lg-auto text-lg-end">
                    <div class="btn-group btn-group-sm" role="group" aria-label="VAT Mode">
                        <input class="btn-check" type="radio" name="vatMode" id="vatModeExclusive"
                               value="exclusive" onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                        <label class="btn btn-outline-primary rounded-pill" for="vatModeExclusive">
                            VAT Exclusive
                        </label>

                        <input class="btn-check" type="radio" name="vatMode" id="vatModeInclusive"
                               value="inclusive" checked onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                        <label class="btn btn-outline-primary rounded-pill" for="vatModeInclusive">
                            VAT Inclusive
                        </label>
                    </div>
                </div>
            </div>
            <div class="mt-1 small">
                <span id="vatExclusiveHint" class="text-muted d-none">
                    Enter net interest; VAT is added on top (19.25%).
                </span>
                <span id="vatInclusiveHint" class="text-muted">
                    Enter gross interest; VAT is extracted (16.1425%) and the field shows net.
                </span>
            </div>

            <!-- Table -->
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle table-hover sim-table">
                    <thead>
                        <tr>
                            <th style="display:none;">@CashDesk_LoanRepaymentSimulationForm.LoanId</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.Date</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.LoanAmount</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.Balance</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.Interest</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.VAT</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.Penalty</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.EnterCapital</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.EnterInterest</th>
                            <th>@CashDesk_LoanRepaymentSimulationForm.EnterPenalty</th>
                            <th class="text-end">@CashDesk_LoanRepaymentSimulationForm.Total</th>
                        </tr>
                    </thead>
                    <tbody id="loanRepaymentTable">
                        @foreach (var d in Model.Loans)
                        {
                            <tr id="row-@d.Id">
                                <td style="display:none;">@d.Id</td>
                                <td>@d.LoanDate.ToString("dd/MM/yy")</td>
                                <td>@d.LoanAmount.ToString("N1")</td>
                                <td>@d.Balance.ToString("N1")</td>
                                <td>@d.AccrualInterest.ToString("N1")</td>
                                <td><span id="vat-@d.Id">0</span></td>
                                <td>@d.Penalty.ToString("N1")</td>
                                <td style="min-width:150px;">
                                    <input type="number" class="form-control form-control-sm"
                                           id="capital-@d.Id" value="0"
                                           oninput="onCapitalPenaltyChanged('@d.Id')" />
                                </td>
                                <td style="min-width:150px;">
                                    <input type="number" class="form-control form-control-sm interest-input"
                                           id="interest-@d.Id" value="0"
                                           data-loanamount="@d.LoanAmount.ToString("N")" />
                                </td>
                                <td style="min-width:150px;">
                                    <input type="number" class="form-control form-control-sm"
                                           id="penalty-@d.Id" value="0"
                                           oninput="onCapitalPenaltyChanged('@d.Id')" />
                                </td>
                                <td class="text-end fw-semibold">
                                    <span class="total-span" id="total-@d.Id">0</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer: only print -->
            @*<div class="d-flex justify-content-end pt-2">
                    <button type="button"
                            class="btn btn-success btn-sm d-flex align-items-center gap-2"
                            onclick="buildSimulationPrint()">
                        <i class="bi bi-printer"></i>
                        Print Simulation
                    </button>
                </div>*@

        </div>
    </div>



</fieldset>

<!-- ===== Printable Simulation Summary (hidden on screen) ===== -->
<div id="printSim" class="print-sim" aria-hidden="true">
    <div class="simdoc">
        <!-- Header -->
        <div class="simdoc-header">
            <div class="left">
                <div class="brand-mark">TSC</div>
                <div class="brand-info">
                    <div class="brand-name">Trust Soft Credit</div>
                    <div class="doc-title">Loan Repayment Simulation — Summary</div>
                    <div class="doc-sub">Generated: <span data-bind="generatedAt"></span></div>
                </div>
            </div>
            <div class="right">
                <div><span class="lbl">Accounting Date:</span> <span data-bind="accountingDate"></span></div>
                <div><span class="lbl">VAT Mode:</span> <span data-bind="vatMode"></span></div>
                <div><span class="lbl">File/Ref:</span> <span data-bind="refNo">—</span></div>
            </div>
        </div>

        <!-- Member & Branch -->
        <div class="infobar">
            <div><span class="lbl">Member:</span> <span data-bind="memberName"></span></div>
            <div><span class="lbl">Branch:</span> <span data-bind="branchName"></span></div>
            <div><span class="lbl">Branch Code:</span> <span data-bind="branchCode"></span></div>
        </div>

        <!-- Computed Details -->
        <div class="section">
            <div class="section-title">Computed Details</div>
            <div class="kpi-grid">
                <div class="kpi"><div class="kpi-label">Refund Amount (Capital)</div><div class="kpi-val" data-bind="capital">0 XAF</div></div>
                <div class="kpi"><div class="kpi-label">Interest Amount</div><div class="kpi-val" data-bind="interest">0 XAF</div></div>
                <div class="kpi"><div class="kpi-label">VAT Amount (on Interest)</div><div class="kpi-val" data-bind="vat">0 XAF</div></div>
                <div class="kpi"><div class="kpi-label">Penalty Amount</div><div class="kpi-val" data-bind="penalty">0 XAF</div></div>
            </div>
            <div class="total-line">
                <div class="lbl">Total Repayment Amount</div>
                <div class="val" data-bind="total">0 XAF</div>
            </div>
        </div>

        <!-- Breakdown Table -->
        <div class="section">
            <div class="section-title">Breakdown</div>
            <table class="simtbl" id="printSimTbl">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Loan Amount</th>
                        <th>Balance</th>
                        <th>Interest</th>
                        <th>VAT</th>
                        <th>Penalty</th>
                        <th>Capital (Entered)</th>
                        <th>Interest (Entered)</th>
                        <th>Penalty (Entered)</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody><!-- rows injected --></tbody>
            </table>
        </div>

        <!-- Notes / Disclaimer -->
        <div class="section note">
            <div class="section-title">Notes</div>
            <ul>
                <li>This document is a <strong>simulation summary</strong> for advisory purposes only; it is not a receipt.</li>
                <li>Values depend on VAT mode and current inputs provided at simulation time.</li>
            </ul>
        </div>
    </div>
</div>

<script>
    // If you ever swap the Bootstrap toggle button, this keeps working
    document.querySelectorAll('[data-bs-target="#computedDetailsSection"]')
        .forEach(btn => btn.addEventListener('click', () => { })); // no-op, Bootstrap handles it
</script>
<script>
  function getText(sel, def="") {
    const el = document.querySelector(sel);
    if (!el) return def;
    if (el.tagName === "INPUT" || el.tagName === "SELECT" || el.tagName === "TEXTAREA") return (el.value || def).trim();
    return (el.textContent || def).trim();
  }

  function getVatModeText() {
    const ex = document.getElementById("vatModeExclusive");
    const inc = document.getElementById("vatModeInclusive");
    if (ex && ex.checked) return "VAT Exclusive (19.25%)";
    if (inc && inc.checked) return "VAT Inclusive (16.1425%)";
    return "—";
  }

  function fmtXaf(v) {
    const s = ("" + (v ?? "")).replace(/[^\d.-]/g,"");
    if (!s || isNaN(+s)) return (v || "0") + " XAF";
    return Number(s).toLocaleString(undefined, {maximumFractionDigits: 0}) + " XAF";
  }

  function buildSimulationPrint() {
    const root = document.getElementById("printSim");
    if (!root) return;

    // Header bindings
    root.querySelector('[data-bind="generatedAt"]').textContent =
      new Date().toLocaleString();
    root.querySelector('[data-bind="accountingDate"]').textContent =
      getText('input[name="BulkDeposit.AccountingDate"]') || getText('input[type="date"]');
    root.querySelector('[data-bind="vatMode"]').textContent = getVatModeText();

    // Member + Branch (server values written at render time)
    root.querySelector('[data-bind="memberName"]').textContent = "@memberName";
    root.querySelector('[data-bind="branchName"]').textContent = "@branchName";
    root.querySelector('[data-bind="branchCode"]').textContent = "@branchCode";

    // KPIs
    root.querySelector('[data-bind="capital"]').textContent = fmtXaf(getText('#summaryCapital'));
    root.querySelector('[data-bind="interest"]').textContent = fmtXaf(getText('#summaryInterest'));
    root.querySelector('[data-bind="vat"]').textContent      = fmtXaf(getText('#summaryVat'));
    root.querySelector('[data-bind="penalty"]').textContent  = fmtXaf(getText('#summaryPenalty'));
    root.querySelector('[data-bind="total"]').textContent    = fmtXaf(getText('#summaryTotal'));

    // Breakdown rows
    const srcRows = document.querySelectorAll('#myDataTableT tbody tr');
    const tgtBody = root.querySelector('#printSimTbl tbody');
    tgtBody.innerHTML = "";

    srcRows.forEach(tr => {
      const id = tr.id?.replace('row-','') ?? "";
      const cells = [
        tr.children[1]?.textContent,                         // Date
        tr.children[2]?.textContent,                         // Loan Amount
        tr.children[3]?.textContent,                         // Balance
        tr.children[4]?.textContent,                         // Interest
        document.getElementById('vat-' + id)?.textContent,   // VAT
        tr.children[6]?.textContent,                         // Penalty
        document.getElementById('capital-' + id)?.value,     // Enter Capital
        document.getElementById('interest-' + id)?.value,    // Enter Interest
        document.getElementById('penalty-' + id)?.value,     // Enter Penalty
        document.getElementById('total-' + id)?.textContent  // Total
      ];

      const trOut = document.createElement('tr');
      cells.forEach((val, i) => {
        const td = document.createElement('td');
        td.textContent = (val ?? "").toString().trim();
        if (i === 9) td.className = "text-end";
        trOut.appendChild(td);
      });
      tgtBody.appendChild(trOut);
    });

    // Print
    window.print();
  }
</script>
<script>
    function updateVatHints() {
        const mode = document.querySelector('input[name="vatMode"]:checked')?.value;
        const ex = document.getElementById('vatExclusiveHint');
        const inc = document.getElementById('vatInclusiveHint');
        if (!ex || !inc) return;
        if (mode === 'exclusive') { ex.classList.remove('d-none'); inc.classList.add('d-none'); }
        else { inc.classList.remove('d-none'); ex.classList.add('d-none'); }
    }

    // Example: call this at the end of applyVatModeToAllRows()
    // window.applyVatModeToAllRows = () => { ...existing VAT logic...; updateVatHints(); };

    // Also run once on load so the default (Inclusive) shows the right hint
    document.addEventListener('DOMContentLoaded', updateVatHints);
</script>
