@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
@if (Model.SavingProducts.Count == 0)
{
    <div class="text-center my-3">
        <p>@Globals_OrdinaryProductAccount.NoOrdinaryProductCreated</p>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_ProductConfig','new','TransactionConfiguration','savingproduct')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@Globals_OrdinaryProductAccount.AddNew">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
}
else
{
    <fieldset class="fieldset-custom">
        <legend>@Globals_OrdinaryProductAccount.OrdinaryAccountListings</legend>
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@Globals_OrdinaryProductAccount.Code</th>
                        <th>@Globals_OrdinaryProductAccount.Name</th>
                        <th>@Globals_OrdinaryProductAccount.Type</th>
                        <th>@Globals_OrdinaryProductAccount.Range</th>
                        <th>@Globals_OrdinaryProductAccount.Status</th>
                        <th>@Globals_OrdinaryProductAccount.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SavingProducts)
                    {
                        <tr>
                            <td style="width:10%">@d.Code</td>
                            <td style="width:30%">@d.Name</td>
                            <td style="width:13%">@d.AccountType</td>
                            <td style="width:20%">@d.MinAmount.ToString("#,##0.0")-@d.MaxAmount.ToString("#,##0.0")</td>
                            <td style="width:7%">
                                @if (d.ActiveStatus)
                                {
                                    <span class="badge bg-info">@Globals_OrdinaryProductAccount.Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Globals_OrdinaryProductAccount.Inactive</span>
                                }
                            </td>
                            <td style="width:20%">
                                @if (!d.IsUsedForTellerProvisioning)
                                {
                                    <a href="/TransactionConfiguration/PolicyandSharing?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_OrdinaryProductAccount.ConfigureOperationPolicies, @d.Name)">@Globals_OrdinaryProductAccount.Policies</a> |
                                    <a href="/TransactionConfiguration/AccountMapping?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_OrdinaryProductAccount.ConfigureAccountMapping, @d.Name)">@Globals_OrdinaryProductAccount.Mappings</a> |
                                    <a href="/TransactionConfiguration/AccountMappingInfo?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_OrdinaryProductAccount.ConfigureAccountMapping, @d.Name)">@Globals_OrdinaryProductAccount.Simulation</a>

}
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </fieldset>
}