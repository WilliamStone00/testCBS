                                                        var PayCashCollectionEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "MOMO_CASHCOLLECTION_PAYEMENT");
                                                        var sumDebitCOMP = PayCashCollectionEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                        var sumCreditCOMP = PayCashCollectionEntri.Where(x => x.BookingDirection == "CREDIT").Sum(x => Convert.ToDouble(x.Amount));

