@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
@{
    ViewBag.Title = GlobalsAccountMappingInfo.AccouningEntryBooking;

}
<div class="container bg-icon-right">
    <h6 class="text-center fw-semibold d-flex justify-content-center align-items-center mb-4">
        <img src="~/AppFiles/Images/Icon.ico" alt="section title icon" class="me-2">

        <span class="text-uppercase"></span>
    </h6>
    <h3 class="text-center mb-2">@GlobalsAccountMappingInfo.AccountingEntriesFor <span class="fw-bold"> @ViewBag.Name</span> service. </h3>
    <div class="row gy-5">
        <div class="col-lg-5">
            <div class="text-center">

                <img src="~/AppFiles/Images/BG2.png" class="faq-image" />
            </div>
        </div>
        @if (ViewBag.ProductType == "Saving_Product")
        {

            if (ViewBag.ProductName == "Daily Savings")
            {
                <div class="col-lg-7">
                    <div class="accordion" id="accordionFront">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="head-One">
                                <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="false" aria-controls="accordionOne">
                                    @GlobalsAccountMappingInfo.CollOfSubsMemberDailySaving
                                </button>
                            </h2>

                            <div id="accordionOne" class="accordion-collapse collapse" data-bs-parent="#accordionFront" aria-labelledby="accordionOne" style="">
                                <div class="accordion-body">
                                    <p>
                                        @GlobalsAccountMappingInfo.TableAccountingEntriesDescription <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold">@GlobalsAccountMappingInfo.ForInstance</span>
                                    </p>

                                    <p>
                                        @GlobalsAccountMappingInfo.AMemberWantToDeposit
                                        A member wants to deposit 10000Frs in his daily savings account.
                                    </p>

                                    <div class="table-responsive mb-3">
                                        <table class="table table-hover" id="myDataTable_AccountData">
                                            <thead class="table-light">
                                                <tr>
                                                    <th> @GlobalsAccountMappingInfo.AccountNumber</th>
                                                    <th> @GlobalsAccountMappingInfo.AccountLabel</th>
                                                    <th>@GlobalsAccountMappingInfo.Debit</th>
                                                    <th>@GlobalsAccountMappingInfo.Credit</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{

                                                    var MomoCollectionEntries = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "MOMOCASH_COLLECTION");

                                                    foreach (var item in MomoCollectionEntries)
                                                    {
                                                        <tr>
                                                            <td style="width:30%">@item.AccountNumber</td>
                                                            <td style="width:30%">@item.AccountName</td>
                                                            @if (item.BookingDirection == "DEBIT")
                                                            {
                                                                <td style="width:20%">@item.Amount</td>
                                                                <td style="width:20%">0</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="width:20%">0</td>
                                                                <td style="width:20%">@item.Amount </td>

                                                            }

                                                        </tr>
                                                    }

                                                }
                                            </tbody>
                                            <thead class="table-light">
                                                <tr>

                                                    <th colspan="2">@GlobalsAccountMappingInfo.TotalDebit</th>
                                                    @{

                                                        var MomoCollectionEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "MOMOCASH_COLLECTION");
                                                        var sumDebitMC = MomoCollectionEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                        var sumCreditMC = MomoCollectionEntri.Where(x => x.BookingDirection != "DEBIT").Sum(x => Convert.ToDouble(x.Amount));

                                                        <th>@sumDebitMC</th>
                                                        <th>@sumCreditMC</th>
                                                    }
                                                </tr>
                                            </thead>

                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="head-Two">
                                <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionTwo" aria-expanded="false" aria-controls="accordionTwo">
                                    @GlobalsAccountMappingInfo.DepositOfDailyCollFieldOp
                                </button>
                            </h2>
                            <div id="accordionTwo" class="accordion-collapse collapse" aria-labelledby="accordionTwo" data-bs-parent="#accordionFront" style="">
                                <div class="accordion-body">
                                    <p>
                                        @GlobalsAccountMappingInfo.TableDepositOfDailyCollectorDesc
                                    </p>
                                    <p>
                                        <span class="fw-bold">@GlobalsAccountMappingInfo.ForInstance :</span>
                                    </p>

                                    <p>
                                        @GlobalsAccountMappingInfo.ADailyCollectorWantToPerformDeposit
                                        A daily collector wants to perform deposit the  1,000,000Frs collected from the daily savings members.
                                    </p>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-hover" id="myDataTable_AccountData">
                                            <thead class="table-light">
                                                <tr>
                                                    <th> @GlobalsAccountMappingInfo.AccountNumber</th>
                                                    <th> @GlobalsAccountMappingInfo.AccountLabel</th>
                                                    <th>@GlobalsAccountMappingInfo.Debit</th>
                                                    <th>@GlobalsAccountMappingInfo.Credit</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{

                                                    var CashCollectionEntries = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "MOMO_CASHCOLLECTION_DEPOSIT");

                                                    foreach (var item in CashCollectionEntries)
                                                    {
                                                        <tr>
                                                            <td style="width:30%">@item.AccountNumber</td>
                                                            <td style="width:30%">@item.AccountName</td>
                                                            @if (item.BookingDirection == "DEBIT")
                                                            {
                                                                <td style="width:20%">@item.Amount</td>
                                                                <td style="width:20%">0</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="width:20%">0</td>
                                                                <td style="width:20%">@item.Amount </td>

                                                            }

                                                        </tr>
                                                    }

                                                }
                                            </tbody>
                                            <thead class="table-light">
                                                <tr>

                                                    <th colspan="2">@GlobalsAccountMappingInfo.Total  :</th>
                                                    @{

                                                        var CashCollectionEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "MOMO_CASHCOLLECTION_DEPOSIT");
                                                        var sumDebitCOMD = CashCollectionEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                        var sumCreditCOMD = CashCollectionEntri.Where(x => x.BookingDirection == "CREDIT").Sum(x => Convert.ToDouble(x.Amount));

                                                        <th>@sumDebitCOMD</th>
                                                        <th>@sumCreditCOMD</th>
                                                    }
                                                </tr>
                                            </thead>

                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="head-Three">
                                <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionThree" aria-expanded="false" aria-controls="accordionTwo">
                                    @GlobalsAccountMappingInfo.PaymentOfCommissionByMember
