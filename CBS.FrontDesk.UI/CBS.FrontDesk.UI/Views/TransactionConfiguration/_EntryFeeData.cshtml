@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@Globals_EntryFeeData.ProductName</th>
            <th>@Globals_EntryFeeData.Flat</th>
            <th>@Globals_EntryFeeData.Rate</th>
            <th>@Globals_EntryFeeData.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.EntryFeeParameters)
        {
            <tr>
                <td style="width:55%">@d.product.name</td>
                <td style="width:15%">@d.entryFeeFlat</td>
                <td style="width:10%">@d.entryFeeRate %</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview_EntryFeeConfig','_EntryFeeConfig','get','TransactionConfiguration','EntryFeeParameter')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_EntryFeeData.EditProductTooltip, @d.product.name)">@Globals_EntryFeeData.Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_EntryFeeData.Delete, @d.product.name)" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','myDataTable','EntryFeeConfigData',0,'datalistingview_EntryFeeConfig')">@Globals_EntryFeeData.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>