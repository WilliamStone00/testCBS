@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
@if (Model.SavingProducts.Count == 0)
{
    <div class="text-center my-3">
        <p>@Globals_ProductData.NoOrdinaryProductCreated</p>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_ProductConfig','new','TransactionConfiguration','savingproduct')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@Globals_ProductData.AddNew">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
}
else
{
    <fieldset class="fieldset-custom">
        <legend>@Globals_ProductData.OrdinaryAccountListings</legend>
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@Globals_ProductData.Code</th>
                        <th>@Globals_ProductData.Name</th>
                        <th>@Globals_ProductData.Type</th>
                        <th>@Globals_ProductData.Range</th>
                        <th>@Globals_ProductData.Status</th>
                        <th>@Globals_ProductData.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SavingProducts)
                    {
                        <tr>
                            <td style="width:10%">@d.Code</td>
                            <td style="width:35%">@d.Name</td>
                            <td style="width:13%">@d.AccountType</td>
                            <td style="width:20%">@d.MinAmount.ToString("#,##0.0")-@d.MaxAmount.ToString("#,##0.0")</td>
                            <td style="width:7%">
                                @if (d.ActiveStatus)
                                {
                                    <span class="badge bg-info">@Globals_ProductData.Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Globals_ProductData.Inactive</span>
                                }
                            </td>
                            <td style="width:15%">
                                @if (!d.IsUsedForTellerProvisioning)
                                {
                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_ProductConfig','get','TransactionConfiguration','savingproduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Globals_ProductData.SelectToEdit @d.Name">@Globals_ProductData.Edit |</a>
                                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Globals_ProductData.Delete @d.Name " onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','myDataTable_product','_ProductData',0,'myDataTable')">@Globals_ProductData.Delete</a>
                                }
                                else
                                {
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_ProductConfig','get','TransactionConfiguration','savingproduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Globals_ProductData.SelectToEdit @d.Name">@Globals_ProductData.Edit</a>

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </fieldset>
}