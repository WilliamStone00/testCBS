@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
 @using Resources
@using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <input type="hidden" name="ServiceOption" value="CloseFeeParameter" id="ServiceOption" />
    <div class="row mt-2 gy-4">
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CloseFeeParameter.productId, new SelectList(ViewBag.Products, "Id", "name"), @Globals_ClossingFeeConfig.SelectProduct, new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.productId, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.SelectProductLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.closeFeeFlat, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.closeFeeFlat, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.FlatFeeLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.closeFeeRate, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.closeFeeRate, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.FeeRateLabel</label>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.SourceBrachOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.SourceBrachOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.SourceBranchShareLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.DestinationBranchOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.DestinationBranchOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.DestinationBranchShareLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.HeadOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.HeadOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.HeadOfficeShareLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.PartnerShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.PartnerShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.PartnerBranchShareLabel</label>
            </div>
        </div>
        <h3>@Globals_ClossingFeeConfig.SharingLabel</h3>
        <br />
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.SourceBrachOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.SourceBrachOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.SourceBranchShareLabel</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.DestinationBranchOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.DestinationBranchOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.DestinationBranchShareLabel</label>
            </div>S
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CloseFeeParameter.HeadOfficeShare, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CloseFeeParameter.HeadOfficeShare, "", new { @class = "text-danger" })
                <label>@Globals_ClossingFeeConfig.HeadOfficeShareLabel</label>
            </div>
        </div>
        @*<div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseFeeParameter.PartnerShare, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CloseFeeParameter.PartnerShare, "", new { @class = "text-danger" })
                    <label>@Globals_ClossingFeeConfig.PartnerBranchShareLabel</label>
                </div>
            </div>*@
    </div>

    <div class="mt-4">
        @if (Model.CloseFeeParameter.id == null)
        {
            <button type="submit" class="btn btn-primary me-2">@Globals_ClossingFeeConfig.SaveButton</button>
            <input type="hidden" name="Action" value="insert" id="Action" />
        }
        else
        {
            <button type="submit" class="btn btn-primary me-2">@Globals_ClossingFeeConfig.UpdateButton</button>
            @Html.HiddenFor(m => m.CloseFeeParameter.id)
            <input type="hidden" name="Action" value="update" id="Action" />
        }
    </div>
}