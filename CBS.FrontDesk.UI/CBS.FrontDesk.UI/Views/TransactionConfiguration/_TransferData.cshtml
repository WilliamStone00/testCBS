@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
<fieldset class="fieldset-custom">
    <legend>@Globals_TransferData.TRUSTCONFIGANDSHARING</legend>
    @if (Model.TransferLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>@Globals_TransferData.NoTransferPolicyIsConfigured</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover" id="xmyDataTable">
                <thead>
                    <tr>
                        <th>@Globals_TransferData.Type</th>
                        <th>@Globals_TransferData.MaxAmount</th>
                        <th>@Globals_TransferData.Source</th>
                        <th>@Globals_TransferData.Destin</th>
                        <th>@Globals_TransferData.CamCCUL</th>
                        <th>@Globals_TransferData.HeadOffice</th>
                        <th>@Globals_TransferData.FluxPTM</th>
                        <th>@Globals_TransferData.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.TransferLimits)
                    {
                        <tr>
                            <td>@d.transferType</td>
                            <td>@d.maxAmount.ToString("#,##0.0")</td>
                            <td>@d.SourceBrachOfficeShare.ToString("#,##0") %</td>
                            <td>@d.DestinationBranchOfficeShare.ToString("#,##0") %</td>
                            <td>@d.CamCCULShare.ToString("#,##0") %</td>
                            <td>@d.HeadOfficeShare.ToString("#,##0") %</td>
                            <td>@d.FluxAndPTMShare.ToString("#,##0") %</td>
                            <td>
                                <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_Transfer','_TransferConfig','get','TransactionConfiguration','transferlimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Globals_TransferData.SelectToEdit @d.transferType">@Globals_TransferData.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@Globals_TransferData.Delete" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','xmyDataTable','_TransferData',0,'datalistingview_Transfer',null,'cash_transfer_parameter')">@Globals_TransferData.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>

<fieldset class="fieldset-custom">
    <legend>@Globals_TransferData.CMONEYSHARING</legend>
    @if (Model.TransferLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>@Globals_TransferData.NoTransferPolicyIsConfigured</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover" id="xxmyDataTable">
                <thead>
                    <tr>
                        <th>@Globals_TransferData.Type</th>
                        <th>@Globals_TransferData.Source</th>
                        <th>@Globals_TransferData.Destin</th>
                        <th>@Globals_TransferData.CamCCUL</th>
                        <th>@Globals_TransferData.HeadOffice</th>
                        <th>@Globals_TransferData.FluxPTM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.TransferLimits)
                    {
                        <tr>
                            <td>@d.transferType</td>
                            <td>@d.SourceBrachOfficeShareCMoney.ToString("#,##0") %</td>
                            <td>@d.DestinationBranchOfficeShareCMoney.ToString("#,##0") %</td>
                            <td>@d.CamCCULShareCMoney.ToString("#,##0") %</td>
                            <td>@d.HeadOfficeShareCMoney.ToString("#,##0") %</td>
                            <td>@d.FluxAndPTMShareCMoney.ToString("#,##0") %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>