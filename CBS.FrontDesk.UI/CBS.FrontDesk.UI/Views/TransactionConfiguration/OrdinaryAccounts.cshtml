@using Resources
@{
    ViewBag.Title = GlobalOrdinaryAccounts.OrdinaryAccounts;
}
<style>
    .fieldset-legend {
        font-weight: normal;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: bold;
    }

    .card-text {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title text-primary">@GlobalOrdinaryAccounts.OrdinaryAccountPolicySetup</h4>
                <p class="card-text">
                    @GlobalOrdinaryAccounts.OrdinaryAccountPolicySetupDescription
                </p>
            </div>
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cog me-2"></i>
                            @GlobalOrdinaryAccounts.OrdinaryAccountPolicySetup
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <h5 class="text-success">
                                                @GlobalOrdinaryAccounts.ManageOrdinaryPolicies
                                            </h5>
                                            <p class="text-muted">
                                                @GlobalOrdinaryAccounts.ManageOrdinaryPoliciesDescriptionText
                                            </p>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_OrdinaryAccountData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/DropDownLoader.js"></script>
}
