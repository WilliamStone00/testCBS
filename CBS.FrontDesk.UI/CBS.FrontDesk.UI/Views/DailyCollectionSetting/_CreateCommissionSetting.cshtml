

@model CBS.FrontDesk.Data.Entity.DailyCollectorManagement.DailyCollectionConfiguration
@{
    ViewBag.Title = "Index";
}

 

<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Header Section -->
            <div class="card-header text-white">
                <h4 class="mb-0">
                    <i class="mdi mdi-percent me-2"></i>Commission Configuration
                </h4>
                <small>Configure commission settings for different operation types and stakeholders</small>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "DailyCollectionSetting", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);", id = "commissionForm" }))
                {
                    <input type="hidden" name="ServiceOption" value="commissionSetting" id="ServiceOption" />
                    @Html.HiddenFor(m => m.CommissionSetting.Id)

                    <!-- Operation Type Selection -->
            <div class="form-section">
                <h6 class="text-primary mb-3">
                    <i class="mdi mdi-cog me-2"></i>Operation Configuration
                </h6>
           
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            @Html.DropDownListFor(m => m.CommissionSetting.OperationType,
                                (IEnumerable<SelectListItem>)ViewBag.OperationTypes,
                                new
                                     {
                                    @class = "form-control select2",
                                    data_search = "true",
                                    required = "required",
                                    onchange = "updateOperationDisplay()"
                                })
                            @Html.ValidationMessageFor(m => m.CommissionSetting.OperationType, "", new { @class = "text-danger" })
                            <label>Operation Type *</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            @Html.DropDownListFor(m => m.CommissionSetting.ProviderType,
                                (IEnumerable<SelectListItem>)ViewBag.ProviderTypes,
                                new
                                     {
                                    @class = "form-control select2",
                                    data_search = "true",
                                    required = "required"
                                })
                            @Html.ValidationMessageFor(m => m.CommissionSetting.ProviderType, "", new { @class = "text-danger" })
                            <label>Provider Type *</label>
                        </div>
                    </div>
                </div>
                <!-- Commission Type Selection -->
                <div class="row">
                    <div class="col-md-8">
                        <h6 class="text-secondary mb-3">Commission Type</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="commission-type-card" onclick="selectCommissionType(true)">
                                    <i class="mdi mdi-percent text-success" style="font-size: 2rem;"></i>
                                    <h6 class="mt-2">Proportional</h6>
                                    <small class="text-muted">Percentage-based commission</small>
                                    @Html.RadioButtonFor(m => m.CommissionSetting.IsProportional, true,
                                        new { id = "proportionalTrue", onchange = "toggleCommissionType(true)" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="commission-type-card" onclick="selectCommissionType(false)">
                                    <i class="mdi mdi-cash text-warning" style="font-size: 2rem;"></i>
                                    <h6 class="mt-2">Fixed Amount</h6>
                                    <small class="text-muted">Fixed amount per transaction</small>
                                    @Html.RadioButtonFor(m => m.CommissionSetting.IsProportional, false,
                                        new { id = "proportionalFalse", onchange = "toggleCommissionType(false)" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            @Html.CheckBoxFor(m => m.CommissionSetting.IsInterbranch, new { @class = "form-check-input", id = "interbranchChk" })
                            <label class="form-check-label" for="interbranchChk">
                                <strong>Inter-branch Transaction</strong>
                                <small class="d-block text-muted">Check if this applies to inter-branch operations</small>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

                    <!-- Fixed Amount Section -->
                    <div id="fixedAmountSection" class="form-section hidden-section">
                        <h6 class="text-primary mb-3">
                            <i class="mdi mdi-cash me-2"></i>Fixed Amount Configuration
                        </h6>
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.CommissionSetting.AmountPerTransaction,
                                    new { @class = "form-control", @type = "number", step = "0.01", min = "0", placeholder = "Amount Per Transaction" })
                                @Html.ValidationMessageFor(m => m.CommissionSetting.AmountPerTransaction, "", new { @class = "text-danger" })
                                <label>Amount Per Transaction</label>
                            </div>
                        </div>
                    </div>

                    <!-- Proportional Commission Section -->
                    <div id="proportionalSection" class="form-section">
                        <h6 class="text-primary mb-3">
                            <i class="mdi mdi-percent me-2"></i>Commission Distribution
                        </h6>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            @Html.TextBoxFor(m => m.CommissionSetting.CommissionProviderShare,
                                                new { @class = "form-control commission-input", @type = "number", step = "0.01", min = "0", max = "100", placeholder = "Commission Provider", oninput = "updateCommissionTotal()" })
                                            @Html.ValidationMessageFor(m => m.CommissionSetting.CommissionProviderShare, "", new { @class = "text-danger" })
                                            <label>Commission Provider (%)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            @Html.TextBoxFor(m => m.CommissionSetting.AgentShare,
                                                new { @class = "form-control commission-input", @type = "number", step = "0.01", min = "0", max = "100", placeholder = "Agent Share", oninput = "updateCommissionTotal()" })
                                            @Html.ValidationMessageFor(m => m.CommissionSetting.AgentShare, "", new { @class = "text-danger" })
                                            <label>Agent Share (%)</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="commission-preview">
                                    <h6><i class="mdi mdi-calculator me-2"></i>Commission Summary</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Provider:</span>
                                        <span id="providerDisplay" class="percentage-display">0%</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Agent:</span>
                                        <span id="agentDisplay" class="percentage-display">0%</span>
                                    </div>
                                    <hr style="border-color: rgba(255,255,255,0.3);">
                                    <div class="d-flex justify-content-between">
                                        <strong>Total:</strong>
                                        <strong id="totalDisplay" class="percentage-display">0%</strong>
                                    </div>
                                    <div id="totalWarning" class="validation-warning" style="display: none;">
                                        <i class="mdi mdi-alert me-1"></i><span id="warningText"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scope Configuration -->
                    <div class="form-section">
                        <h6 class="text-primary mb-3">
                            <i class="mdi mdi-target me-2"></i>Configuration Scope
                        </h6>
                        <p class="text-muted mb-3">Select the scope for this commission configuration (select only one):</p>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="scope-selector" onclick="selectScope('global')">
                                    <div class="text-center">
                                        <i class="mdi mdi-earth text-success" style="font-size: 2rem;"></i>
                                        <h6 class="mt-2">Global Configuration</h6>
                                        <small class="text-muted">Applies to entire organization</small>
                                        @Html.CheckBoxFor(m => m.CommissionSetting.IsGlobal, new { @class = "form-check-input d-none", id = "isGlobalChk" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="scope-selector" onclick="selectScope('branch')">
                                    <div class="text-center">
                                        <i class="mdi mdi-office-building text-warning" style="font-size: 2rem;"></i>
                                        <h6 class="mt-2">Branch Configuration</h6>
                                        <small class="text-muted">Applies to specific branch</small>
                                        @Html.CheckBoxFor(m => m.CommissionSetting.IsBranch, new { @class = "form-check-input d-none", id = "isBranchChk" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="scope-selector" onclick="selectScope('agent')">
                                    <div class="text-center">
                                        <i class="mdi mdi-account-group text-info" style="font-size: 2rem;"></i>
                                        <h6 class="mt-2">Agent Configuration</h6>
                                        <small class="text-muted">Applies to specific agent</small>
                                        @Html.CheckBoxFor(m => m.CommissionSetting.IsAgent, new { @class = "form-check-input d-none", id = "isAgentChk" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Branch Selection -->
                        <div id="branchSelection" class="hidden-section mt-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.CommissionSetting.BranchId,
                                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Text", "Value"),
                                        "---Select Branch---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.CommissionSetting.BranchId, "", new { @class = "text-danger" })
                                    <label>Branch *</label>
                                </div>
                            </div>
                        </div>

                        <!-- Agent Selection -->
                        <div id="agentSelection" class="hidden-section mt-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.CommissionSetting.AgentId,
                                        new SelectList(ViewBag.Agents ?? new List<SelectListItem>(), "Text", "Value"),
                                        "---Select Agent---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.CommissionSetting.AgentId, "", new { @class = "text-danger" })
                                    <label>Agent *</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <div>
            <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                <i class="mdi mdi-refresh me-2"></i>Reset Form
            </button>
            <button type="button" class="btn btn-outline-info" onclick="previewConfiguration()">
                <i class="mdi mdi-eye me-2"></i>Preview
            </button>
        </div>
                <!-- Commission Preview Modal -->
                <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-light">
                                <h5 class="modal-title">Confirm Configuration</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" id="previewContent">
                                <!-- Preview content will be inserted here -->
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    @if (Model?.CommissionSetting?.Id == null)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-content-save me-2"></i>Save Configuration
                        </button>
                        <input type="hidden" name="Action" value="insert" id="Action" />
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success">
                            <i class="mdi mdi-update me-2"></i>Update Configuration
                        </button>
                        <input type="hidden" name="Action" value="update" id="Action" />
                    }
                </div>
            </div>
                }
            </div>
        </div>
    </div>
</div>