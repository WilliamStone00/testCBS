
@{
    ViewBag.Title = "DailyCollectionSettings";

}


<div class="row">
    <div class="col-12">
        <!-- Commission Configuration Guide (Collapsible) -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center text-primary bg-light">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i>
                    COMMISSION CONFIGURATION GUIDE
                </span>
                <button class="btn btn-outline-primary btn-sm"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseGuide"
                        aria-expanded="true"
                        aria-controls="collapseGuide">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>
            <div id="collapseGuide" class="collapse">
                <div class="card-body">
                    <!-- Quick Start Tip -->
                    <div class="alert alert-info mb-4">
                        <strong><i class="mdi mdi-lightbulb-on-outline me-2"></i>Quick Start:</strong>
                        Select Transction operation type → Choose commission provider → Configure commission structure → Set scope
                    </div>

                    <!-- Configuration Types Section -->
                    <h5 class="text-primary mb-3 border-bottom pb-2">
                        <i class="mdi mdi-cog-outline me-2"></i>
                        COMMISSION TYPES
                    </h5>

                    <div class="row g-3 mb-4">
                        <!-- Proportional Commission -->
                        <div class="col-md-4">
                            <div class="card border-success h-100">
                                <div class="card-header bg-light-success text-success d-flex align-items-center">
                                    <i class="mdi mdi-percent me-2"></i>
                                    <strong>Proportional</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Percentage-based commissions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>For revenue sharing models</li>
                                        <li>When transaction amounts vary</li>
                                        <li>For stakeholder profit distribution</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-success">
                                        <strong>How to configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-success">Proportional</span></li>
                                            <li>Set provider share (e.g., 70%)</li>
                                            <li>Set agent share (e.g., 30%)</li>
                                            <li class="text-danger">Total must equal 100%</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: ₦1000 transaction → Provider:₦700, Agent:₦300
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fixed Amount -->
                        <div class="col-md-4">
                            <div class="card border-warning h-100">
                                <div class="card-header bg-light-warning text-warning d-flex align-items-center">
                                    <i class="mdi mdi-cash me-2"></i>
                                    <strong>Fixed Amount</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Flat-rate commissions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>For standardized fees</li>
                                        <li>When transaction amount doesn't matter</li>
                                        <li>For simple commission structures</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-warning">
                                        <strong>How to configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-warning text-dark">Fixed</span></li>
                                            <li>Enter fixed amount (e.g., ₦50)</li>
                                            <li>Same amount applies per transaction</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: ₦50 fee per transaction
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Interbranch -->
                        <div class="col-md-4">
                            <div class="card border-info h-100">
                                <div class="card-header bg-light-info text-info d-flex align-items-center">
                                    <i class="mdi mdi-bank-transfer me-2"></i>
                                    <strong>Interbranch</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Cross-branch transactions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>For branch-to-branch transfers</li>
                                        <li>When revenue sharing between branches</li>
                                        <li>Special commission arrangements</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-info">
                                        <strong>How to configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Enable <span class="badge bg-info">Interbranch</span></li>
                                            <li>Set source/destination rules</li>
                                            <li>Configure special rates if needed</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: 1% fee on interbranch transfers
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scope Configuration Section -->
                    <h5 class="text-primary mb-3 border-bottom pb-2">
                        <i class="mdi mdi-target me-2"></i>
                        SCOPE CONFIGURATION
                    </h5>

                    <div class="row g-3 mb-4">
                        <!-- Global -->
                        <div class="col-md-4">
                            <div class="card border-primary h-100">
                                <div class="card-header bg-light-primary text-primary d-flex align-items-center">
                                    <i class="mdi mdi-earth me-2"></i>
                                    <strong>Global</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Organization-wide defaults</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>Base configuration for all</li>
                                        <li>Fallback for specific cases</li>
                                        <li>Standard commission rules</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-primary">
                                        <strong>How to set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-primary">Global</span></li>
                                            <li>Applies to all branches/agents</li>
                                            <li>Overridden by specific settings</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Branch -->
                        <div class="col-md-4">
                            <div class="card border-warning h-100">
                                <div class="card-header bg-light-warning text-warning d-flex align-items-center">
                                    <i class="mdi mdi-bank-circle-outline me-2"></i>
                                    <strong>Branch</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Branch-specific rules</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>Regional variations</li>
                                        <li>Special branch arrangements</li>
                                        <li>Override global settings</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-warning">
                                        <strong>How to set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-warning text-dark">Branch</span></li>
                                            <li>Choose branch from dropdown</li>
                                            <li>Applies to all agents in branch</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Agent -->
                        <div class="col-md-4">
                            <div class="card border-info h-100">
                                <div class="card-header bg-light-info text-info d-flex align-items-center">
                                    <i class="mdi mdi-account-circle me-2"></i>
                                    <strong>Agent</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>When to use:</strong> Individual exceptions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>Special agent agreements</li>
                                        <li>Performance-based commissions</li>
                                        <li>Override all other settings</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-info">
                                        <strong>How to set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-info">Agent</span></li>
                                            <li>Choose agent from dropdown</li>
                                            <li>Applies only to this agent</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Best Practices -->
                    <div class="alert alert-light mt-3">
                        <h6 class="alert-heading text-primary">
                            <i class="mdi mdi-lightbulb-on-outline me-2"></i> Best Practices
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li><strong>Test first:</strong> Use Preview before saving</li>
                            <li><strong>Hierarchy:</strong> Global → Branch → Agent</li>
                            <li><strong>Document:</strong> Note special arrangements</li>
                            <li><strong>Review:</strong> Audit quarterly for updates</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Commission Management Accordion -->
        <div class="accordion mb-4" id="commissionAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommission" aria-expanded="true" aria-controls="collapseCommission">
                        <i class="mdi mdi-book-account-outline me-2"></i>
                        COMMISSION MANAGEMENT
                    </button>
                </h2>
                <div id="collapseCommission" class="accordion-collapse collapse show" data-bs-parent="#commissionAccordion">
                    <div class="accordion-body">
                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end mb-3">
                            <div class="btn-group">
                                <button class="btn btn-outline-primary btn-sm"
                                        onclick="LoadDataGeneration('DailyCollectionSetting','myDataTable','_CommissionSettingData','datalistingview_CommissionSetting',0,'commissionSetting','list')">
                                    <i class="mdi mdi-view-list me-1"></i> View List
                                </button>
                                <button class="btn btn-outline-success btn-sm"
                                        onclick="AddORUpdateGen(null,'datalistingview_CommissionSetting','_CreateCommissionSetting','new','DailyCollectionSetting','commissionSetting')">
                                    <i class="mdi mdi-plus me-1"></i> Add New
                                </button>
                            </div>
                        </div>

                        <!-- Content -->
                        <div id="datalistingview_CommissionSetting">
                            @Html.Partial("_CreateCommissionSetting")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link href="~/CBSTemp/ui/assets/css/Commission.css" rel="stylesheet" />
}


@section Scripts {@Scripts.Render("~/bundles/jqueryval")


<script src="~/Scripts/Js/CommissionManagement/CommissionManagement.js"></script>
<script src="~/Scripts/Js/AccountEventConfigurtion/MFIChartOfAccount.js"></script>
<script src="~/Scripts/Js/main.js/Account.js"></script>
}
