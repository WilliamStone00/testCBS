@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanDeliquencyConfiguration>
    @using Resources
<fieldset class="fieldset-custom">
    <legend>Data</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalLoanDeliquencyConfiguration.NoLoanLoanDeliquencyConfigurationTypeIsCreated</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalLoanDeliquencyConfiguration.Name</th>
                        <th>@GlobalLoanDeliquencyConfiguration.From</th>
                        <th>@GlobalLoanDeliquencyConfiguration.To</th>
                        <th>@GlobalLoanDeliquencyConfiguration.Status</th>
                        <th>@GlobalLoanDeliquencyConfiguration.SMSMembers</th>
                        <th>@GlobalLoanDeliquencyConfiguration.AM_Score</th>
                        <th>@GlobalLoanDeliquencyConfiguration.Fine</th>
                        <th>@GlobalLoanDeliquencyConfiguration.SMSTeam</th>
                        <th>@GlobalLoanDeliquencyConfiguration.EmailTeam</th>
                        <th>@GlobalLoanDeliquencyConfiguration.CreditO</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:14%">@d.Name</td>
                            <td style="width:8%">@d.DaysFrom Ds</td>
                            <td style="width:8%">@d.DaysTo Ds</td>
                            <td style="width:15%">@d.Status</td>
                            <td style="width:8%">
                                @if (d.SendSMStoClient)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                            <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.AffectScoring)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.ApplyFine)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.SendSMS)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.SendMail)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.ReportToCreditOffice)
                                {
                                    <span class="badge bg-info">@GlobalLoanDeliquencyConfiguration.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanDeliquencyConfiguration.No</span>
                                }
                            </td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','LoanDeliquencyConfiguration')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('LoanDeliquencyConfiguration','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
    </fieldset>


