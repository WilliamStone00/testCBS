@model CBS.FrontDesk.Data.Entity.SalaryManagement.StandingOrderCarrier
    @using Resources
@{
    ViewBag.Title = "Standing Order Management";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
<div class="row mb-1">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-cash-outline me-2"></i>@GlobalStandingOrder.STANDING_ORDER_MANAGEMENT
                </h1>
                <p class="card-text text-muted">
                    @GlobalStandingOrder.EasilyCeateViewAndManageStandingOrdersForMembers.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<!-- Tips Section -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalStandingOrder.TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStandingOrderTips" aria-expanded="false" aria-controls="collapseStandingOrderTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseStandingOrderTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-magnify text-primary me-2"></i> @GlobalStandingOrder.SearchMembersEfficientlyUseTheSearchBoxToFindAMember.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalStandingOrder.CreateNewOrdersClickOnTheAddNewRequest.</li>
                <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalStandingOrder.EditExistingOrdersLocateTheStandingOrder.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalStandingOrder.ReviewBeforeDeletingEnsureYouVerifyTheMembersDetails.</li>
                <li><i class="mdi mdi-calendar-search text-primary me-2"></i> @GlobalStandingOrder.TrackStartAndEndDatesRegularlyCheckTheStartAndEndDates.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalStandingOrder.SystemNotificationsUseTheNotifications.</li>
                <li><i class="mdi mdi-account-cash-outline text-success me-2"></i> @GlobalStandingOrder.MemberCommunicationInformMembers.</li>
                <li><i class="mdi mdi-database-search text-primary me-2"></i> @GlobalStandingOrder.NoRecordsFoundIfNoRecordsAreDisplayed.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col">
        <div class="accordion" id="standingOrderAccordion">
            <!-- Standing Order Section -->
            <div class="accordion-item mb-3 shadow">
                <h2 class="accordion-header" id="headingStandingOrder">
                    <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseStandingOrder" aria-expanded="true" aria-controls="collapseStandingOrder">
                        <i class="mdi mdi-account-cash-outline me-2"></i>
                        @GlobalStandingOrder.STANDING_ORDER_MANAGEMENT
                    </button>
                </h2>
                <div id="collapseStandingOrder" class="accordion-collapse collapse show" data-bs-parent="#standingOrderAccordion">
                    <div class="accordion-body">
                        <!-- Search Box -->
                        @Html.Partial("_SearchBox")
                        <!-- Data Listing View -->
                        <div id="datalistingview">
                            <p class="text-muted">@GlobalStandingOrder.NoStandingOrdersFoundUseTheSearchBox.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Other Sections Can Be Added Below -->
        </div>
    </div>
</div>


<div class="modal fade" id="standingOrderDetailsModal" tabindex="-1" aria-labelledby="standingOrderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header p-2">
                <header class="w-100 text-center">
                    <h4 class="text-primary fw-bold mb-1">
                        <i class="mdi mdi-receipt me-2"></i> @GlobalStandingOrder.STANDING_ORDER_DETAILS
                    </h4>
                    <p class="text-muted mb-0">
                        @GlobalStandingOrder.ViewAndManageDetailsOfTheStandingOrder.
                    </p>
                    <hr style="border: 1px solid rgba(128, 128, 128, 0.5);" />
                </header>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-2">
                <div id="standingOrderDetailsContent">
                    <!-- Dynamic content or partial view will be loaded here -->
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>


