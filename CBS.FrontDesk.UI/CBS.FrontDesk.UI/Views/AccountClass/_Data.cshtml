@model List<CBS.FrontDesk.Data.Entity.Accounting.AccountClass>
    @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalAccountClass_Data.Name</th>
            <th>@GlobalAccountClass_Data.Description</th>
            <th>@GlobalAccountClass_Data.Categories</th>
            <th>@GlobalAccountClass_Data.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:20%">@d.Name</td>
                <td style="width:15%">@d.Description</td>
                <td style="width:10%">@d.AccountCategoryId</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','AccountClass')" class="mr-2" data-toggle="tooltip" data-placement="top" title= "@string.Format(GlobalAccountClass_Data.SelectToEdit, d.Name)" >@GlobalAccountClass_Data.Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(GlobalAccountClass_Data.Delete, d.Name)" onclick="DeleteRecordDataTable('AccountClass','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalAccountClass_Data.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

