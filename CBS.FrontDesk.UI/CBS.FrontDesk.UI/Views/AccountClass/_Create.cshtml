@model CBS.FrontDesk.Data.Entity.Accounting.AccountClass
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "AccountClass", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>@GlobalAccountClass_Create.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label>@GlobalAccountClass_Create.Description</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.AccountCategoryId, new SelectList(ViewBag.AccountCartegories == null ? "" : ViewBag.AccountCartegories, "id", "Name"), GlobalAccountClass_Create.SelectAcccountCategory, new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.AccountCategoryId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountClass_Create.AccountCategory</label>
                </div>
            </div>
         
            
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalAccountClass_Create.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalAccountClass_Create.Reset</button>
        </div>
    }
</div>