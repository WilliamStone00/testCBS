@model CBS.FrontDesk.Data.Entity.Accounting.AccountClass
    @using Resources
<div class="card-body">

    @using (Html.BeginForm("Update", "AccountClass", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>@GlobalAccountClass_Update.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label>@GlobalAccountClass_Update.Description</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.AccountCategoryId, new SelectList(ViewBag.AccountCategories == null ? "" : ViewBag.OperationEvents, "id", "Name"), GlobalAccountClass_Update.SelectAccountCategory, new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.AccountCategoryId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountClass_Update.AccountCategory</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalAccountClass_Update.Update</button>
        </div>
    }
</div>