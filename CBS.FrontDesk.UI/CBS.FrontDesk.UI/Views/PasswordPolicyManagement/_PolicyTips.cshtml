<!-- Tips Section -->
@using Resources
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalPasswordPolicyManagement.PasswordPolicyIdleTimeoutGuidelines</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="true" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-account-clock-outline text-info me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.IdleDuration</strong>: @GlobalPasswordPolicyManagement.TimeAUserSessionCanRemainInactiveBeforeAutomaticLogout.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Recommended: <code>15</code> minutes</span>
                </li>

                <li>
                    <i class="mdi mdi-login-variant text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.NumberOfLoginAttempts</strong>: @GlobalPasswordPolicyManagement.MaximumFailedLoginAttemptsBeforeAccountLockoutIsTriggered.
                <span class="text-muted">@GlobalPasswordPolicyManagement.Recommended: <code>5</code> @GlobalPasswordPolicyManagement.attempts</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-reset text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.NumberOfDaysRequiredToResetPassword</strong>: @GlobalPasswordPolicyManagement.MinimumNumberOfDaysRequiredBeforeAUserCanResetTheirPasswordAgain.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Recommended: <code>1</code> @GlobalPasswordPolicyManagement.day</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-remove text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.NumberOfDaysToBlockUserIfInactive</strong>: @GlobalPasswordPolicyManagement.NumberOfDaysOfInactivityAfterWhichAUserAccountWillBeAutomaticallyDisabled.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Recommended: <code>90</code> @GlobalPasswordPolicyManagement.days</span>
                </li>

                <li>
                    <i class="mdi mdi-shield-key-outline text-success me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.PasswordPolicies</strong>: @GlobalPasswordPolicyManagement.JSONFormattedSetOfRulesGoverningPasswordStructure.
                    <span class="text-muted">Examples: <code>@GlobalPasswordPolicyManagement.MinLength</code>, <code>@GlobalPasswordPolicyManagement.RequireDigit</code>, <code>@GlobalPasswordPolicyManagement.EnableMFA</code></span>
                </li>

                <li>
                    <i class="mdi mdi-numeric text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.MinLengthMaxLength</strong>: @GlobalPasswordPolicyManagement.EnforcesMinimumAndMaximumNumberOfCharactersInPasswords.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Typically: <code>8–128</code></span>
                </li>

                <li>
                    <i class="mdi mdi-alphabet-aurebesh text-info me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.RequireUppercaseLowercaseDigitSpecialChar</strong>: @GlobalPasswordPolicyManagement.DefinesCharacterCompositionRequirementsToIncreasePasswordComplexity.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.EnablesProtectionAgainstBruteForceAttacks.</span>
                </li>

                <li>
                    <i class="mdi mdi-text-box-check-outline text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.DisallowUsernameInPassword</strong>: @GlobalPasswordPolicyManagement.PreventsUseOfUsernameAsPartOfThePasswordForAddedSecurity.
                </li>

                <li>
                    <i class="mdi mdi-history text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.PasswordHistoryCount</strong>: @GlobalPasswordPolicyManagement.NumberOfPreviousPasswordsRetainedToAvoidReuse.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.HelpsPreventCyclingThroughWeakPasswords.</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-clock text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.MaxPasswordAgeDaysMinPasswordAgeDays</strong>: @GlobalPasswordPolicyManagement.ControlsPasswordExpirationAndMinimumHoldDuration.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.PromotesTimelyRotationAndAvoidsAbuseOfFrequentResets.</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-alert-outline text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.LockoutThresholdDurationResetnterval</strong>: @GlobalPasswordPolicyManagement.DefinesRulesForAccountLockoutHandlingBonRepeatedLoginFailures.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.ExampleLockFor15MinutesAfter5FailedAttempts.</span>
                </li>

                <li>
                    <i class="mdi mdi-security text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.EnableMFA</strong>: @GlobalPasswordPolicyManagement.ActivatesAdditionalAuthenticationBeyondPassword.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.GreatlReducesRisksFromCredentialTheft.</span>
                </li>

                <li>
                    <i class="mdi mdi-clock-fast text-info me-2"></i>
                    <strong>MFAEnforcementGraceDays</strong>: @GlobalPasswordPolicyManagement.DelayPeriodBeforeMFABecomesMandatoryForNewUsers.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Recommended: <code>3</code> @GlobalPasswordPolicyManagement.days</span>
                </li>

                <li>
                    <i class="mdi mdi-filter-outline text-info me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.DisallowedSubstrings</strong>: @GlobalPasswordPolicyManagement.PatternsOrKeywordsThatMustNotAppearInPasswords.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Example: <code>@GlobalPasswordPolicyManagement.password, admin, 1234</code></span>
                </li>

                <li>
                    <i class="mdi mdi-code-tags-check text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.RegexPatternValidation</strong>: @GlobalPasswordPolicyManagement.OptionalRegularExpressionToEnforceAdditionalFormattingLogic.
                </li>

                <li>
                    <i class="mdi mdi-shield-account text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.AllowAdminReset</strong>: @GlobalPasswordPolicyManagement.AllowsAdminAccountsToResetPasswordsOnBehalfOfUsers.
                </li>

                <li>
                    <i class="mdi mdi-history-off text-muted me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.AdminResetBypassHistory</strong>: @GlobalPasswordPolicyManagement.DeterminesWhetherAdminInitiatedResetsBypassPasswordReuseChecks.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.Default: <code>@GlobalPasswordPolicyManagement.False</code></span>
                </li>

                <li>
                    <i class="mdi mdi-office-building-outline text-secondary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.ScopeCentralOrBranchLevel</strong>:
                    @GlobalPasswordPolicyManagement.Set <code>IsCentral = true</code> @GlobalPasswordPolicyManagement.toApplyThePolicyGloballyAcrossTheSystem.
                    @GlobalPasswordPolicyManagement.If <code>IsCentral = false</code>, @GlobalPasswordPolicyManagement.youMustSelectASpecificBranchFromTheDropdownListUsing
                    <code>@GlobalPasswordPolicyManagement.BranchCode</code> @GlobalPasswordPolicyManagement.and <code>@GlobalPasswordPolicyManagement.BranchName</code>.
                    <br />
                    <span class="text-muted">@GlobalPasswordPolicyManagement.OnlyOnePolicyCanExistPerScopeCentralOrPerBranch.</span>
                </li>

                <li class="mt-3">
                    <i class="mdi mdi-check-bold text-primary me-2"></i>
                    <strong>✅ @GlobalPasswordPolicyManagement.GoodPasswordExample:</strong><br />
                    <code class="text-primary"><strong>N3xt!Gen_S3cur3#</strong></code><br />
                    <small class="text-muted">@GlobalPasswordPolicyManagement.MeetsAllPolicyRulesLengthDigitsUppercaseLowercase.</small>
                </li>
                <li class="mt-2">
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                    <strong>❌ @GlobalPasswordPolicyManagement.BadPasswordExample:</strong><br />
                    <code class="text-danger"><string>password123</string></code><br />
                    <small class="text-muted">@GlobalPasswordPolicyManagement.FailsComplexityRulesUsesDisallowedKeywords.</small>
                </li>
            </ul>
        </div>

        <!-- Default Configuration Display -->
        <div class="alert alert-secondary mt-3">
            <strong class="mb-2 d-block">🔐 @GlobalPasswordPolicyManagement.DefaultPasswordPolicyConfiguration:</strong>

            <div class="table-responsive">
                <table class="table table-bordered table-sm table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>@GlobalPasswordPolicyManagement.PolicyKey</th>
                            <th>@GlobalPasswordPolicyManagement.DefaultValue</th>
                            <th>@GlobalPasswordPolicyManagement.Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>1</td><td>@GlobalPasswordPolicyManagement.MinLength</td><td>8</td><td>@GlobalPasswordPolicyManagement.MinimumNumberOfCharactersRequiredInAPassword.</td></tr>
                        <tr><td>2</td><td>@GlobalPasswordPolicyManagement.MaxLength</td><td>128</td><td>@GlobalPasswordPolicyManagement.MaximumNumberOfCharactersAllowedInAPassword.</td></tr>
                        <tr><td>3</td><td>@GlobalPasswordPolicyManagement.RequireUppercase</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.AtLeastOneUppercaseLetterMustBePresentInThePassword.</td></tr>
                        <tr><td>4</td><td>@GlobalPasswordPolicyManagement.RequireLowercase</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.AtLeastOneLowercaseLetterMustBePresentInThePassword.</td></tr>
                        <tr><td>5</td><td>@GlobalPasswordPolicyManagement.RequireDigit</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.AtLeastOneNumericDigitMustBePresentInThePassword.</td></tr>
                        <tr><td>6</td><td>@GlobalPasswordPolicyManagement.RequireSpecialChar</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.AtLeastOneSpecialCharacterFromTheAllowedListMustBePresent.</td></tr>
                        <tr><td>7</td><td>@GlobalPasswordPolicyManagement.AllowedSpecialChars</td><td>!@@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?</td><td>@GlobalPasswordPolicyManagement.SetOfPermittedSpecialCharacters.</td></tr>
                        <tr><td>8</td><td>@GlobalPasswordPolicyManagement.DisallowUsernameInPassword</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.RestrictsPasswordsFromContainingTheUsername.</td></tr>
                        <tr><td>9</td><td>@GlobalPasswordPolicyManagement.PasswordHistoryCount</td><td>5</td><td>@GlobalPasswordPolicyManagement.HowManyPreviousPasswordsAreRememberedToAvoidReuse.</td></tr>
                        <tr><td>10</td><td>@GlobalPasswordPolicyManagement.DisallowPreviousPasswords</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.PreventsTheReuseOfPastPasswordsWithinTheHistoryCount.</td></tr>
                        <tr><td>11</td><td>@GlobalPasswordPolicyManagement.EnableMFA</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.EnablesMultiFactorAuthenticationForAdditionalLoginSecurity.</td></tr>
                        <tr><td>12</td><td>@GlobalPasswordPolicyManagement.MFATypesAllowed</td><td>SMS, EMAIL, TOTP</td><td>@GlobalPasswordPolicyManagement.AcceptedMFATypesSMS.</td></tr>
                        <tr><td>13</td><td>@GlobalPasswordPolicyManagement.MFAEnforcementGraceDays</td><td>3</td><td>@GlobalPasswordPolicyManagement.GracePeriodBeforeMFABecomesMandatoryForUsersAfterAccountCreation.</td></tr>
                        <tr>
                            <td>14</td>
                            <td>@GlobalPasswordPolicyManagement.DisallowedSubstrings</td>
                            <td>@GlobalPasswordPolicyManagement.password, admin, login, 1234, qwerty, abcd, root, test, guest, access, letmein, welcome, secret, iloveyou, trustno1, dragon, 2020, 2021, 0000</td>
                            <td>@GlobalPasswordPolicyManagement.RejectsCommonWeakKeywordsAndPhrasesOftenExploitedInBruteForce.</td>
                        </tr>
                        <tr>
                            <td>15</td>
                            <td>RegexPatternValidation</td>
                            <td>^(?!.*(.)\1{2,})(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@#$%^&+=!?]).{12,128}$</td>
                            <td>
                                @GlobalPasswordPolicyManagement.EnforcesStrongPasswords:
                                <ul class="mb-0 ps-3">
                                    <li>@GlobalPasswordPolicyManagement._12_128CharactersLong</li>
                                    <li>@GlobalPasswordPolicyManagement.AtLeast1Uppercase1Lowercase1DigitAnd1SpecialCharacter</li>
                                    <li>@GlobalPasswordPolicyManagement.RejectsPasswordsWith3OrMoreConsecutiveRepeatedCharacters</li>
                                </ul>
                            </td>
                        </tr>
                        <tr><td>16</td><td>@GlobalPasswordPolicyManagement.RejectSerialPatterns</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.BlocksPasswordsThatContainSimpleNumericSequencesLike <code>123456</code>, <code>0000</code>, <code>987654</code>, @GlobalPasswordPolicyManagement.orSimilarSerialLikeStructures.</td></tr>
                        <tr><td>17</td><td>@GlobalPasswordPolicyManagement.AllowAdminReset</td><td>@GlobalPasswordPolicyManagement.True</td><td>@GlobalPasswordPolicyManagement.PermitsAdministratorsToResetUserPasswordsIfNeeded.</td></tr>
                        <tr><td>18</td><td>@GlobalPasswordPolicyManagement.AdminResetBypassHistory</td><td>@GlobalPasswordPolicyManagement.False</td><td>@GlobalPasswordPolicyManagement.DeterminesWhetherAdminResetsBypassPasswordReuseHistoryChecks.</td></tr>
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>




<!-- Configuration Notice -->
<div class="alert alert-info mt-3 mb-2">
    <strong>@GlobalPasswordPolicyManagement.Notice:</strong> @GlobalPasswordPolicyManagement.Only <u>@GlobalPasswordPolicyManagement.oneConfigurationPerBranch</u> @GlobalPasswordPolicyManagement.isAllowedForCentralizedControlEnableThe <code>@GlobalPasswordPolicyManagement.IsCentral</code> @GlobalPasswordPolicyManagement.flag.<br />
    @GlobalPasswordPolicyManagement.NewConfigurationEntriesWillBeRejectedIfOneAlreadyExistsForTheSameScope.
</div>
