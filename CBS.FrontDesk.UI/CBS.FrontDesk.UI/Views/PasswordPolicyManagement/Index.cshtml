@{
    ViewBag.Title = "Idle Timeout & Password Policy Configuration";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-timer-sand-empty me-2"></i> @GlobalPasswordPolicyManagement.IdleTimeoutPasswordPolicyConfiguration
                </h1>
                <p class="card-text">
                    @GlobalPasswordPolicyManagement.UseThisInterfaceToDefineRulesForUserInactivity.
                    @GlobalPasswordPolicyManagement.AdministratorsCanConfigureCentralized.
                    <br />
                    @GlobalPasswordPolicyManagement.SettingsIncludeLockoutThresholds.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<!-- Create Button Outside Header -->
<div class="d-flex justify-content-end mb-2">
    <a href="/PasswordPolicyManagement" class="btn btn-sm btn-outline-primary me-2">
        <i class="mdi mdi-plus"></i> @GlobalPasswordPolicyManagement.CreateNewPolicy
    </a>
    <a type="button" onclick="LoadDataGen('PasswordPolicyManagement','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="@GlobalPasswordPolicyManagement.ViewExistingConfigs">
        <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
    </a>
</div>

<!-- Tips Section -->
@Html.Partial("_PolicyTips")

<!-- Main Configuration Form -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div class="card-body" id="datalistingview">
                @Html.Partial("_Create")
            </div>
        </div>
    </div>
</div>



