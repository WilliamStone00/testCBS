@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.14/ace.js" crossorigin="anonymous"></script>

    <script>
        let editor; // ACE Editor instance

        function initializeJsonEditor() {
            const editorContainer = document.getElementById("jsonEditor");
            const hiddenInput = document.getElementById("PasswordPoliciesJson");
            const errorBox = document.getElementById("jsonError");

            if (!editorContainer || !hiddenInput) {
                console.warn("⚠️ JSON Editor or hidden input not found in DOM.");
                return;
            }

            editor = ace.edit(editorContainer);
            editor.setTheme("ace/theme/github");
            editor.session.setMode("ace/mode/json");
            editor.setOptions({
                maxLines: Infinity,
                minLines: 20,
                fontSize: "13px",
                wrap: true,
                autoScrollEditorIntoView: true,
                readOnly: false
            });

            try {
                const parsed = JSON.parse(hiddenInput.value || "{}");
                editor.setValue(JSON.stringify(parsed, null, 4), -1);
            } catch {
                editor.setValue("{}", -1);
            }

            editor.session.on("change", () => {
                hiddenInput.value = editor.getValue();
                if (errorBox) errorBox.classList.add("d-none");
            });

            document.querySelector("form")?.addEventListener("submit", function (e) {
                try {
                    JSON.parse(editor.getValue());
                    hiddenInput.value = editor.getValue();
                } catch (err) {
                    e.preventDefault();
                    if (errorBox) {
                        errorBox.textContent = `❌ Invalid JSON: ${err.message}`;
                        errorBox.classList.remove("d-none");
                    }
                }
            });
        }

        function toggleBranchSection(isCentral) {
            const branchSection = document.getElementById("branchSection");

            if (branchSection) {
                if (isCentral) {
                    branchSection.style.display = "none";
                    $("#BranchId").val(null).trigger('change');
                } else {
                    branchSection.style.display = "flex";
                }
            }
        }

        // ✅ Initialize things on full page load (normal request)
        $(document).ready(() => {
            toggleBranchSection($('#IsCentralCheckbox').is(':checked'));

            if (document.getElementById("jsonEditor")) {
                initializeJsonEditor(); // Editor exists => initialize directly
            }
        });

        // 🔁 Retry-based initializer (for partial view / modal load)
        function waitForEditorThenInitEditor(retries = 10, interval = 200) {
            const attempt = () => {
                const editorDiv = document.getElementById("jsonEditor");
                if (editorDiv) {
                    initializeJsonEditor();
                    toggleBranchSection($('#IsCentralCheckbox').is(':checked'));
                } else if (retries > 0) {
                    setTimeout(() => attempt(--retries, interval), interval);
                } else {
                    console.warn("❌ jsonEditor still not found after multiple attempts.");
                }
            };
            attempt();
        }

        // ⚙️ Called from _Data table actions
        function AddORUpdateGenPasswordPolicy(KEY, divToLoadData, partialView, path, controller, serviceOption, dateFrom, dateTo) {
            EditResetMain(KEY, partialView, divToLoadData, controller, "InitializeData", null, path, null, serviceOption, dateFrom, dateTo);

            setTimeout(() => {
                $('.select2').select2();
                initializeDatePickers();
                waitForEditorThenInitEditor();
            }, 100);
        }
    </script>
}



