


@{
    ViewBag.Title = "Product Configuration";
}

@using CBS.FrontDesk.UI.Helper


@model CBS.FrontDesk.Data.Entity.Accounting.ProductConfigurationViewModel



@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .account-row:hover {
            background-color: #f8f9fa !important;
            transform: scale(1.001);
            transition: all 0.2s ease-in-out;
        }

        .config-status {
            animation: pulse 2s infinite;
        }
        /**/
    </style>
}

<div class="container-fluid">
    @Html.ProductConfigurationTable(Model)
</div>
 
@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any additional JavaScript functionality here
            $('.config-status').addClass('config-status');
        });
    </script>
}