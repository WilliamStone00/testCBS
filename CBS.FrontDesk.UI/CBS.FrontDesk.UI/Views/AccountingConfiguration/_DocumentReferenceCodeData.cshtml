@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
<table class="table table-hover" id="DataTable_DocumentReference">
    <thead class="table-light">
        <tr>
            <th>@AccountingConfig_DocumentReferenceCodeData.Reference</th>
            <th>@AccountingConfig_DocumentReferenceCodeData.Heading</th>
            <th>@AccountingConfig_DocumentReferenceCodeData.Document</th>
            <th>@AccountingConfig_DocumentReferenceCodeData.Cartegory </th>
            <th>@AccountingConfig_DocumentReferenceCodeData.Action</th>
        </tr>
      
    </thead>
    <tbody>
        @foreach (var d in Model.DocumentReferenceCodeDataDtos)
        {
            <tr>
                <td style="width:10%">@d.ReferenceCode</td>
                <td style="width:30%">@d.Description</td>
                <td style="width:20%">@d.Document</td>
                <td style="width:20%">@d.DocumentType</td>
                <td style="width:20%">
                    <a href="#" onclick="GetData('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_CreateDocumentReferenceCode','desc','update','datalistingview_DocumentReferenceCode','documentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ReferenceCode @GlobalShared.ToEdit">@GlobalShared.Edit</a>|
                    <a href="#" onclick="GetData('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_DocumentReferenceCodeDetails','desc','details','datalistingview_DocumentReferenceCode','documentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ReferenceCode @GlobalShared.ToEdit">@GlobalShared.Details</a>|
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.ReferenceCode" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_DocumentReferenceCodeData',0,'datalistingview_DocumentReferenceCode','documentReferenceCode')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>