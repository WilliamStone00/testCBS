@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources
<div class="table-responsive mb-3">
 
        <table class="table table-hover" id="myDataTable_AccountingEntryRule">
            <thead class="table-light">
                <tr>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.EntryRule</th>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.Derterminant</th>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.DerterminantAccountNumber</th>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.BalancingAccount</th>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.BalancingAccountNumber</th>
                    <th>@AccountingConfig_DownloadAccountingEntryRule.Booking</th>

                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var d in Model.AccountingRuleEntryDataDTOS)
                    {
                        <tr>
                            <td style="width:15%">@d.AccountingRuleEntryName</td>
                            <td style="width:20%">@d.Determinant</td>
                            <td style="width:20%">@d.DeterminantAccountNumber</td>
                            <td style="width:20%">@d.CounterPart</td>
                            <td style="width:20%">@d.CounterPartAccountNumber</td>
                            <td style="width:5%">@d.BookingDirection</td>

                        </tr>
                    }

                }
            </tbody>
        </table>
 

        <button type="button" onclick="DownloadAccountingEntryRule()" class="btn btn-primary me-2 mdi-download-circle-outline">@AccountingConfig_DownloadAccountingEntryRule.DownloadAccountingEvent</button>


</div>

