@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
@if (true)
{
    <table class="table table-hover" id="myDataTable_AccountingRuleData">
        <thead class="table-light">
            <tr>
                <th>@AccountingConfig_EntryRuleData.RuleName</th>
                <th>@AccountingConfig_EntryRuleData.ChartOfAccount</th>
                <th>@AccountingConfig_EntryRuleData.BookingDirection</th>
                <th>@AccountingConfig_EntryRuleData.Description</th>
                <th>@AccountingConfig_EntryRuleData.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.AccountingRules)
            {
                <tr>
 

                    <td style="width:35%" id="DeterminantAccount-@d.Id">@d.MFI_ChartOfAccountId</td>
                    <td style="width:10%" id="BookingDirection-@d.Id">@d.BookingDirection</td>
                    <td style="width:50%" id="Description-@d.Id">@d.Description</td>
                    <td style="width:5%">

                        <a href="#" onclick="DeleteAccountingRole('@d.Id','AccountingConfiguration','DeleteAccountingRole')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.SelectToEdit @d.RuleName">@GlobalShared.Delete</a>

                    </td>
                </tr>

            }

        </tbody>
    </table>
    <table class="table table-hover" id="myDataTable_XXX">
        <thead class="table-light">
            <tr>
                <th colspan="5" class="shift-right"> <a href="#" onclick="RegisterEntryRule()" class="btn btn-primary">@AccountingConfig_EntryRuleData.RegisterRule</a></th>
                
            </tr>
        </thead>
        <tbody>
          
        </tbody>
    </table>
}
else
{
    <tr>
       

    </tr>
    <table class="table table-hover" id="myDataTable_AccountingRuleData">
        <thead class="table-light">
            <tr>
                <th>@AccountingConfig_EntryRuleData.RuleName</th>
                <th>@AccountingConfig_EntryRuleData.DeterminantAccount</th>
                <th>@AccountingConfig_EntryRuleData.BookingDirection</th>
                <th>@AccountingConfig_EntryRuleData.BalancingAccount</th>
                <th>@AccountingConfig_EntryRuleData.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.AccountingRules)
            {
                <tr>
                    <td style="width:35%" id="DeterminantAccount-@d.Id">@d.MFI_ChartOfAccountId</td>
                    <td style="width:10%" id="BookingDirection-@d.Id">@d.BookingDirection</td>
                    <td style="width:50%" id="Description-@d.Id">@d.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

