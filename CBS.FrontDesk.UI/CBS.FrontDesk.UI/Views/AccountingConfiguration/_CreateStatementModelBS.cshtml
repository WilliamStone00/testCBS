
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources

<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="ServiceOption" value="statementModel" id="ServiceOption" />
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(model => model.IncomeStatement.Reference, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.IncomeStatement.Reference, "", new { @class = "text-danger" })
                    <label for="Reference">@AccountingConfig_CreateStatementModelBS.Reference</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.IncomeStatement.Document_type, new SelectList(ViewBag.Document_typeBS == null ? "" : ViewBag.Document_typeBS, "Text", "Value"), "---"+ @AccountingConfig_CreateStatementModelBS.SelectDocumentType+"---", new { @class = "form-control select2", @search = "true", id = "Document_type" })
                    @Html.ValidationMessageFor(model => model.IncomeStatement.Document_type, "", new { @class = "text-danger" })
                    <label for="Document_type">@AccountingConfig_CreateStatementModelBS.DocumentType</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.IncomeStatement.GrossChartOfAccountId, new SelectList(ViewBag.ChartOfAccounts == null ? new List<SelectListItem>() : ViewBag.ChartOfAccounts, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple" })
                    @Html.ValidationMessageFor(model => model.IncomeStatement.GrossChartOfAccountId, "", new { @class = "text-danger" })
                    <label for="AccountIds">@AccountingConfig_CreateStatementModelBS.SelectAccountNumbers </label>
                </div>
                <div class="col-md-6 ">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.IncomeStatement.OperationSideGross, new SelectList(ViewBag.OperationSide == null ? "" : ViewBag.OperationSide, "Text", "Value"), "---"+ @AccountingConfig_CreateStatementModelBS.SelectBookingDirection+"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(model => model.IncomeStatement.OperationSideGross, "", new { @class = "text-danger" })
                        <label for="Document">@AccountingConfig_CreateStatementModelBS.SelectGrossAccountBookingDirection</label>
                    </div>
                </div>
                <div class="col-md-6 ">
                    <div class="form-floating form-floating-outline">
                        @Html.ListBoxFor(m => m.IncomeStatement.AmortizationChartOfAccountId, new SelectList(ViewBag.ChartOfAccounts == null ? new List<SelectListItem>() : ViewBag.ChartOfAccounts, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple" })
                        @Html.ValidationMessageFor(model => model.IncomeStatement.AmortizationChartOfAccountId, "", new { @class = "text-danger" })
                        <label for="AccountIds">@AccountingConfig_CreateStatementModelBS.SelectAccountNumbersFromChart</label>
                    </div>
                </div>
                <div class="col-md-6 ">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.IncomeStatement.OperationSideAmortization, new SelectList(ViewBag.OperationSide == null ? "" : ViewBag.OperationSide, "Text", "Value"), "---"+@AccountingConfig_CreateStatementModelBS.SelectBookingDirection+"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(model => model.IncomeStatement.OperationSideAmortization, "", new { @class = "text-danger" })
                        <label for="Document">@AccountingConfig_CreateStatementModelBS.SelectAmortizationsBookingDirection</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.IncomeStatement.Heading, new { @class = "form-control", @style = "height: 150px;" })
                        @Html.ValidationMessageFor(m => m.IncomeStatement.Heading, "", new { @class = "text-danger" })
                        <label for="Documentxxx">@AccountingConfig_CreateStatementModelBS.Heading</label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                @if (Model.IncomeStatement.Id == null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <input type="hidden" name="Action" value="insert" id="Action" />
                }
                else
                { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                    @Html.HiddenFor(m => m.IncomeStatement.Id)
                    <input type="hidden" name="Action" value="update" id="Action" />
                }
            </div>




        </div>
    }
</div>