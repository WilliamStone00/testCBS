@model List<CBS.FrontDesk.Data.Entity.Config.System.SysConfiguration>
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalSysConfiguration.OperationYearLising.</legend>

    @if (Model.Any())
    {<div class="table-responsive">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalSysConfiguration.Name</th>
                        <th>@GlobalSysConfiguration.CurrentYear</th>
                        <th>@GlobalSysConfiguration.YearStatus</th>
                        <th>@GlobalSysConfiguration.DayStatus</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:60%">@d.Name</td>
                            <td style="width:10%">@d.Value</td>
                            <td style="width:10%">
                                @if (d.IsYearOpen)
                                {
                                    <span class="badge bg-info">@GlobalSysConfiguration.Opened</span>
                                }
                                else
                                {
                            <span class="badge bg-danger">@GlobalSysConfiguration.Closed</span>
                                }
                            </td>
                            <td style="width:10%">
                                @if (d.IsDayOpen)
                                {
                                    <span class="badge bg-info">@GlobalSysConfiguration.Opened</span>
                                }
                                else
                                {
                            <span class="badge bg-danger">@GlobalSysConfiguration.Closed</span>
                                }
                            </td>
                            <td style="width:10%">
                                
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_SysConfiguration','get','SysConfiguration','SysConfiguration')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalSysConfiguration.Configure</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>


    }
    else
    {
<div class="text-center my-3">
    @GlobalSysConfiguration.ThereIsNoRunningYearConfigured.
    <br />
    <br />
    <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','SysConfiguration','SysConfiguration')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
    </a>
</div>
    }



</fieldset>