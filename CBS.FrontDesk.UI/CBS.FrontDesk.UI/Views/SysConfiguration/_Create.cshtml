@model CBS.FrontDesk.Data.Entity.Config.System.SysConfiguration
@using Resources





<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalSysConfiguration.NEW_CONFIGURATION_YEAR
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>@GlobalSysConfiguration.SET_UP_NEW_RUNNING_YEAR</legend>
                                <div class="row g-4">
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.NameRunningYear</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Value, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.Year (e.g 2025)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 75px;"})
                                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.Description</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Add</button>
                                    @Html.HiddenFor(m => m.Id)
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
