@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-redo-alt me-2"></i> @GlobalUserManagement.ResetPassword
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "ResetPassword")
        @Html.HiddenFor(m => m.id)

        <div class="mb-3">
            <label class="form-label fw-bold text-secondary">@GlobalUserManagement.Username</label>
            @Html.TextBox("ResetPassword.userName", Model.ResetPassword.userName, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-secondary">@GlobalUserManagement.NewDefaultPassword</label>
            @Html.TextBox("ResetPassword.password", Model.ResetPassword.password, new { @class = "form-control bg-light text-danger fw-bold", @readonly = "readonly" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-secondary">@GlobalUserManagement.ReasonForPasswordReset</label>
            @Html.TextAreaFor(m => m.ResetPassword.ResetPasswordReason, new { @class = "form-control", rows = "3", placeholder = @GlobalUserManagement.ProvideReasonForPasswordReset })
            @Html.ValidationMessageFor(m => m.ResetPassword.ResetPasswordReason, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-secondary">@GlobalUserManagement.RequirePasswordChangeOnNextLogin</label>
            <div>
                @if (Model.ChangePasswordOnFirstLogin)
                {
                    <span class="badge bg-danger px-3 py-2 fs-6 shadow-sm">
                        <i class="fas fa-key me-1"></i> @GlobalUserManagement.PendingChangeOfPasswordFrom @Model.name
                    </span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> @GlobalUserManagement.NotRequired
                    </span>
                }
            </div>
        </div>

        <hr />

        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.LastLogin</label>
                <div class="text-dark">@Model.LastLoginDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.LastPasswordChange</label>
                <div class="text-dark">@Model.LastDateOfPasswordChange.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.FailedLoginAttempts</label>
                <span class="badge bg-warning text-dark">@Model.LoginAttempts</span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.VerificationStatus</label>
                @if (Model.IsVerified)
                {
                    <span class="badge bg-success">@GlobalUserManagement.Verified</span>
                }
                else
                {
                    <span class="badge bg-secondary">@GlobalUserManagement.NotVerified</span>
                }
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.AccountBlocked</label>
                @if (Model.IsBlocked)
                {
                    <span class="badge bg-danger">@GlobalShared.Blocked</span>
                }
                else
                {
            <span class="badge bg-success">@GlobalShared.Active</span>
                }
            </div>
            @if (Model.IsBlocked && !string.IsNullOrWhiteSpace(Model.ReasonForBlockingAccount))
            {
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary">@GlobalUserManagement.ReasonForBlocking</label>
                    <div class="text-danger fw-bold">@Model.ReasonForBlockingAccount</div>
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-secondary"> @GlobalUserManagement.Account</label>
            @if (Model.IsRoot)
            {
                <span class="badge bg-primary"><i class="fas fa-shield-alt me-1"></i> @GlobalUserManagement.RootUser</span>
            }
            else
            {
                <span class="badge bg-secondary">@GlobalUserManagement.User</span>
            }
        </div>

        <div class="alert alert-warning shadow-sm mb-3">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @GlobalUserManagement.AreYouSureYouWantToResetTheUsersPasswordTo <strong>000000 @GlobalUserManagement.asDefaultPassword</strong>?
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-danger shadow-sm">
                <i class="fas fa-sync-alt me-1"></i> @GlobalUserManagement.YesResetPassword
            </button>
        </div>
    }
</div>
