@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-user-shield me-2"></i> @GlobalUserManagement.AccountOverridePolicy
    </h5>
</div>

<div class="modal-body bg-light">

    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.id)
        @Html.Hidden("Option", "OverridePolicy")

        @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

        <div class="row gy-3">

            <!-- 🔐 Override Policy Section -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pb-1">
                    <i class="mdi mdi-shield-account-outline me-1"></i> @GlobalUserManagement.OverrideSecurityRules
                </h6>
            </div>

            <div class="col-md-6">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.PolicyOverride.PasswordNeverExpires, new { @class = "form-check-input", id = "PasswordNeverExpires" })
                    <label class="form-check-label" for="PasswordNeverExpires" data-bs-toggle="tooltip" title="@GlobalUserManagement.DisablesPasswordExpiryForThisAccount.">@GlobalUserManagement.PasswordNeverExpires</label>
                </div>

                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.PolicyOverride.IgnoreMFARequirement, new { @class = "form-check-input", id = "IgnoreMFARequirement" })
                    <label class="form-check-label" for="IgnoreMFARequirement" data-bs-toggle="tooltip" title="@GlobalUserManagement.SkipsMFAForLoginNotRecommendedForNormalUsers.">@GlobalUserManagement.IgnoreMFARequirement</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.PolicyOverride.AllowWeakPassword, new { @class = "form-check-input", id = "AllowWeakPassword" })
                    <label class="form-check-label" for="AllowWeakPassword" data-bs-toggle="tooltip" title="@GlobalUserManagement.AllowsPasswordsThatDontMeetPolicyStrengthRequirements.">@GlobalUserManagement.AllowWeakPassword</label>
                </div>

                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.PolicyOverride.BypassLockoutPolicy, new { @class = "form-check-input", id = "BypassLockoutPolicy" })
                    <label class="form-check-label" for="BypassLockoutPolicy" data-bs-toggle="tooltip" title="@GlobalUserManagement.PreventsTheAccountFromBeingLockedDueToMultipleFailedLoginAttempts.">@GlobalUserManagement.BypassLockoutPolicy</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.PolicyOverride.CustomExpiryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", placeholder = @GlobalUserManagement.CustomExpiryDate })
                    @Html.ValidationMessageFor(m => m.PolicyOverride.CustomExpiryDate, "", new { @class = "text-danger" })
                    <label>@GlobalUserManagement.CustomExpiryDate</label>
                </div>
            </div>

            <!-- ✅ Submit -->
            <div class="col-12 text-end mt-4">
                <button type="submit" class="btn btn-primary shadow-sm px-4">
                    <i class="fas fa-save me-1"></i> @GlobalUserManagement.SavePolicy
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Enable Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>
}
