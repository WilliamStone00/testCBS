@model CBS.FrontDesk.Data.UserManagement.User
    @using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-key me-2"></i> @GlobalUserManagement.ChangePassword
    </h5>
</div>

<div class="modal-body bg-light mb-2">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "ChangePassword")
        @Html.HiddenFor(m => m.id)
        @Html.HiddenFor(m => m.userName)
        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.oldPassword, new { @class = "form-control", placeholder = @GlobalUserManagement.OldPassword })
                    <label>@GlobalUserManagement.OldPassword</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.oldPassword, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.password, new { @class = "form-control", placeholder = @GlobalUserManagement.NewPassword })
                    <label>@GlobalUserManagement.NewPassword</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.password, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.confirmPassword, new { @class = "form-control", placeholder = @GlobalUserManagement.ConfirmPassword })
                    <label>@GlobalUserManagement.ConfirmPassword</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.confirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary shadow-sm">
                <i class="fas fa-save me-1"></i> @GlobalUserManagement.Change
            </button>
        </div>
    }



</div>
<div class="modal-body bg-light">
    <div class="alert alert-info shadow-sm mb-4">
        @Html.Partial("_PasswordPolicyPanel")
    </div>
</div>
