@model CBS.FrontDesk.Data.UserManagement.User
@using Resources

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

    <div class="row gy-3">
        <!-- Profile & Address Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-account-outline me-1"></i> @GlobalUserManagement.ProfileAddress</h6>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.firstName, new { @class = "form-control", placeholder = @GlobalUserManagement.FirstName })
                @Html.ValidationMessageFor(m => m.firstName, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.FirstName</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.lastName, new { @class = "form-control", placeholder = @GlobalUserManagement.LastName })
                @Html.ValidationMessageFor(m => m.lastName, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.LastName</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.email, new { @class = "form-control", placeholder = "Email" })
                @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.Email</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.phoneNumber, new { @class = "form-control", placeholder = @GlobalUserManagement.PhoneNumber })
                @Html.ValidationMessageFor(m => m.phoneNumber, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.PhoneNumber</label>
            </div>
        </div>
        <div class="col-12">
            <div class="form-floating shadow-sm">
                @Html.TextAreaFor(m => m.address, new { @class = "form-control", placeholder = "Address", style = "height: 100px;" })
                @Html.ValidationMessageFor(m => m.address, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.Address</label>
            </div>
        </div>
        <!-- Profile Selection Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-shield-account-outline me-1"></i> @GlobalUserManagement.AccountProfile</h6>
        </div>
        <div class="col-md-12">
            <div class="form-group ps-2">
                @foreach (SelectListItem profile in ViewBag.AccountPolicyProfiles)
                {
                    <div class="form-check form-check-inline me-4">
                        @Html.RadioButtonFor(m => m.AccountTypePolicyProfile, profile.Value, new { @class = "form-check-input", id = profile.Value })
                        <label class="form-check-label" for="@profile.Value">@profile.Text</label>
                    </div>
                }
                @Html.ValidationMessageFor(m => m.AccountTypePolicyProfile, "", new { @class = "text-danger" })
            </div>
        </div>
        <!-- ID Card Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-card-account-details-outline me-1"></i> @GlobalUserManagement.IDCardDetails</h6>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.NationalIdentityCardNumber, new { @class = "form-control", placeholder = "ID Card Number" })
                @Html.ValidationMessageFor(m => m.NationalIdentityCardNumber, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.NationalIDCardNumber</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.IssueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.IssueDate, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.IssueDate</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.ExpiryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.ExpiryDate, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.ExpiryDate</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.PlaceOfIssue, new { @class = "form-control", placeholder = @GlobalUserManagement.PlaceOfIssue })
                @Html.ValidationMessageFor(m => m.PlaceOfIssue, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.PlaceOfIssue</label>
            </div>
        </div>

        <!-- Role and Branch Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-office-building-marker-outline me-1"></i> @GlobalUserManagement.RoleBranch</h6>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.DropDownListFor(m => m.roleID, new SelectList(ViewBag.Roles, "Id", "Name"), "---"+ @GlobalUserManagement.SelectRole+"---", new { @class = "form-control select2" })
                @Html.ValidationMessageFor(m => m.roleID, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.Role</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.DropDownListFor(m => m.BranchID, new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalUserManagement.SelectBranch+"---", new { @class = "form-control select2" })
                @Html.ValidationMessageFor(m => m.BranchID, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.Branch</label>
            </div>
        </div>

        <!-- Security Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-security me-1"></i> @GlobalUserManagement.Security</h6>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.userName, new { @class = "form-control", placeholder = @GlobalUserManagement.Username })
                @Html.ValidationMessageFor(m => m.userName, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.Username</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.allowedIP, new { @class = "form-control", placeholder = @GlobalUserManagement.WhitelistIP })
                @Html.ValidationMessageFor(m => m.allowedIP, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.AllowedIP (Example: 192.168.11.1)</label>
            </div>
        </div>


        <!-- Language Preference Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-translate me-1"></i> @GlobalUserManagement.LanguagePreference</h6>
        </div>
        <div class="col-md-12">
            <div class="form-floating shadow-sm">
                @Html.DropDownListFor(m => m.UserPreferedLanguage, new SelectList(ViewBag.Languages, "Key", "Value"), "---"+ @GlobalUserManagement.SelectLanguage+"---", new { @class = "form-control select2" })
                @Html.ValidationMessageFor(m => m.UserPreferedLanguage, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.PreferredLanguage</label>
            </div>
        </div>
        <!-- Account Policy Override Section -->
        <div class="col-12">
            <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-lock-alert-outline me-1"></i> @GlobalUserManagement.OverrideSecurityPolicy</h6>
        </div>

        <div class="col-md-6">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.PolicyOverride.PasswordNeverExpires, new { @class = "form-check-input", id = "PasswordNeverExpires" })
                <label class="form-check-label" for="PasswordNeverExpires">@GlobalUserManagement.PasswordNeverExpires</label>
            </div>
            <div class="form-check">
                @Html.CheckBoxFor(m => m.PolicyOverride.IgnoreMFARequirement, new { @class = "form-check-input", id = "IgnoreMFARequirement" })
                <label class="form-check-label" for="IgnoreMFARequirement">@GlobalUserManagement.IgnoreMFARequirement</label>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.PolicyOverride.AllowWeakPassword, new { @class = "form-check-input", id = "AllowWeakPassword" })
                <label class="form-check-label" for="AllowWeakPassword">@GlobalUserManagement.AllowWeakPassword</label>
            </div>
            <div class="form-check">
                @Html.CheckBoxFor(m => m.PolicyOverride.BypassLockoutPolicy, new { @class = "form-check-input", id = "BypassLockoutPolicy" })
                <label class="form-check-label" for="BypassLockoutPolicy">@GlobalUserManagement.BypassLockoutPolicy</label>
            </div>
        </div>

        <div class="col-md-12 mt-2">
            <div class="form-floating shadow-sm">
                @Html.TextBoxFor(m => m.PolicyOverride.CustomExpiryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.PolicyOverride.CustomExpiryDate, "", new { @class = "text-danger" })
                <label>@GlobalUserManagement.CustomExpiryDate</label>
            </div>
        </div>

        <div class="col-12 text-end mt-3">
            <button type="submit" class="btn btn-primary shadow-sm px-4">
                <i class="fas fa-save me-1"></i> @GlobalUserManagement.CreateAccount
            </button>
            <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                @GlobalShared.Reset
            </button>
        </div>
    </div>
    }
</div>