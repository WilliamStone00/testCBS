@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header mb-3">
    <h5 class="modal-title">
        <i class="fas fa-shield-alt me-2"></i> @GlobalUserManagement.MFAStatusRecovery <small class="text-light">(@GlobalUserManagement.AdminView)</small>
    </h5>
</div>

<div class="modal-body bg-light">
    <div class="mb-3">
        <strong class="text-secondary">@GlobalUserManagement.Username:</strong>
        <span class="fw-bold text-dark">@Model.userName</span>
    </div>

    @if (Model.IsGoogleAuthenticatorEnabled)
    {
        <div class="alert alert-success shadow-sm mb-3">
            <i class="fas fa-check-circle me-2"></i>
            @GlobalUserManagement.MFAIs <strong>@GlobalUserManagement.enabled</strong> @GlobalUserManagement.forThisUser.
        </div>

        <div class="alert alert-info mb-3">
            <strong>@GlobalUserManagement.NoteToAdministrator:</strong><br />
            @GlobalUserManagement.ThisUserHasActivatedMFAUsingTheGoogleAuthenticatorApp.
            @GlobalUserManagement.You <strong>@GlobalUserManagement.cannotDisableOrModify</strong> @GlobalUserManagement.MFAForThemHoweverYouCanAssistWithRecoveryIfTheyveLostAccess.
        </div>

        <div class="alert alert-secondary mb-3">
            <strong>@GlobalUserManagement.StandardLoginProcess:</strong>
            <ol class="mt-2 mb-0">
                <li>@GlobalUserManagement.EnterUsernameAndPassword.</li>
                <li>@GlobalUserManagement.OpenGoogleAuthenticatorAppOnTheirPhone.</li>
                <li>@GlobalUserManagement.EnterThe6DigitTimeBasedVerificationCode.</li>
                <li>@GlobalUserManagement.LoginIsCompletedUponValidCodeVerification.</li>
            </ol>
        </div>

        <hr class="my-4" />

        <div class="alert alert-warning shadow-sm">
            <i class="fas fa-key me-2"></i>
            <strong>@GlobalUserManagement.RecoveryOptions:</strong><br />
            @GlobalUserManagement.IfTheUserHasLostAccessToTheirAuthenticatorApp.
        </div>

        <div class="row gy-3">
            <div class="col-md-6 text-center">
                <img src="@Model.BarcodeImageUrl" alt="QR Code for MFA" class="img-thumbnail border shadow-sm" style="width: 180px; height: 180px;" />
                <div class="small text-muted mt-2">QR Code (Google Authenticator)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalUserManagement.MFASetupKey:</label>
                <div class="bg-light border p-2 rounded text-danger fw-bold">@Model.GoogleAuthenticatorSecretKey</div>
                <div class="form-text text-muted mt-1">
                    @GlobalUserManagement.AskTheUserToOpenTheirGoogleAuthenticator.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm mb-3">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @GlobalUserManagement.MFAIs <strong>@GlobalUserManagement.currentlyDisabled</strong> @GlobalUserManagement.forThisUser.
        </div>

        <div class="alert alert-info">
            <strong>@GlobalUserManagement.Important:</strong> @GlobalUserManagement.AdministratorsCannotEnableMFAOnBehalfOfUsers.<br /><br />
            <strong>@GlobalUserManagement.EncourageUsers</strong> @GlobalUserManagement.toActivateMFAToImproveTheirAccountSecurity.
        </div>
    }
</div>
