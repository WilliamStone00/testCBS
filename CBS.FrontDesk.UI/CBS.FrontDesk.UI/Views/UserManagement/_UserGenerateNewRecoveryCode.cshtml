@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-shield-alt me-2"></i> @GlobalUserManagement.GenerateNewSessionRecoveryCode
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "GenerateNewRecoveryCode")
        @Html.HiddenFor(m => m.id)

        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    <input type="text" class="form-control" id="oldCode" value="@Model.SessionRecoveryCode" readonly />
                    <label>@GlobalUserManagement.CurrentRecoveryCode</label>
                </div>
                <small class="text">@GlobalUserManagement.ThisIsTheCurrentlyAssignedSessionRecoveryCode.</small>
            </div>
        </div>

        <div class="alert alert-info mt-4">
            <h6><i class="fas fa-info-circle me-1"></i> @GlobalUserManagement.WhyRegenerateARecoveryCode?</h6>
            <ul class="mb-0 ps-3">
                <li>@GlobalUserManagement.ToRevokeAnExistingCodeThatMayHaveBeenExposed.</li>
                <li>@GlobalUserManagement.WhenUsersSuspectUnauthorizedAccessToTheirAccount.</li>
                <li>@GlobalUserManagement.aRegularSecurityHygieneBestPractice.</li>
                <li>@GlobalUserManagement.codesAreUsedToInvalidateAllOpenSessions.</li>
            </ul>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary shadow-sm">
                <i class="fas fa-sync-alt me-1"></i> @GlobalUserManagement.GenerateNewCode
            </button>
        </div>
    }
</div>
