@using Resources
@{
    ViewBag.Title = @GlobalError.Unauthorized;
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
}


<h2 class="mb-4">@GlobalError.UnauthorizedAccess</h2>
<p class="lead mb-4">@GlobalError.OopsItSeemsYouDontHavePermission.</p>
<p>@GlobalError.PleaseContactTheAdministratorForAssistance.</p>

<p>@GlobalError.ERROR:<br />@ViewBag.ErrorMessage</p>
<a href="/" class="btn">@GlobalShared.GoBackToHome</a>