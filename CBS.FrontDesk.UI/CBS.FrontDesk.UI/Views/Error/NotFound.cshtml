@using Resources
@{
    ViewBag.Title = @GlobalError.ResourceNotFound;
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
}

<h2 class="mb-4">@GlobalError.ResourceNotFound</h2>
<p class="lead mb-4">@GlobalError.OopsWeCouldntFindTheRequestedResource.</p>
<p>@GlobalError.PleaseCheckTheURLOrContactTheAdministratorForAssistance.</p>
<p>@GlobalError.ERROR:<br />@ViewBag.ErrorMessage</p>
<a href="/" class="btn">@GlobalShared.GoBackToHome</a>