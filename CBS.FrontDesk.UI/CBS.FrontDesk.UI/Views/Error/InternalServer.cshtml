@using Resources
@{
    ViewBag.Title = "500-Internal Server Error";
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
}

<h2 class="mb-4">500 - Internal Server Error</h2>
<p class="lead mb-4">@GlobalError.OopsSomethingWentWrong.</p>
<p>@GlobalError.PleaseTryAgainLater.</p>
<p>@GlobalError.ERROR:<br />@ViewBag.ErrorMessage</p>
<a href="/" class="btn">@GlobalShared.GoBackToHome</a>