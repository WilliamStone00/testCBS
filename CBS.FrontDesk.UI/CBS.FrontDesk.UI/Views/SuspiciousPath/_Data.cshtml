@model List<CBS.FrontDesk.Data.Entity.RequestManagement.SuspiciousPath>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalSuspiciousPath.SUSPICIOUS_PATHS</legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>@GlobalSuspiciousPath.NoSuspiciousPathsHaveBeenRegisteredYet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered align-middle" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60%;">@GlobalSuspiciousPath.Pattern</th>
                        <th style="width: 10%;">@GlobalSuspiciousPath.Regex?</th>
                        <th style="width: 20%;">@GlobalSuspiciousPath.CreatedOn</th>
                        <th style="width: 10%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.Timestamp))
                    {
                        <tr>
                            <td>@item.Pattern</td>
                            <td>
                                @if (item.IsRegex)
                                {
                                    <span class="badge bg-info">@GlobalSuspiciousPath.Yes</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary">@GlobalSuspiciousPath.No</span>
                                }
                            </td>
                            <td>@item.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">

                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="AddORUpdateGen('@item.Id', 'datalistingview', '_Create', 'update', 'SuspiciousPath')"
                                            data-bs-toggle="tooltip"
                                            title="Edit Pattern">
                                        <i class="fas fa-edit me-1"></i> @GlobalShared.Edit
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="DeleteDynamic('SuspiciousPath','Delete','@item.Id','myDataTable','_Data', 2,'datalistingview')"
                                            data-bs-toggle="tooltip"
                                            title="Delete Pattern">
                                        <i class="fas fa-trash-alt me-1"></i> @GlobalShared.Delete
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
