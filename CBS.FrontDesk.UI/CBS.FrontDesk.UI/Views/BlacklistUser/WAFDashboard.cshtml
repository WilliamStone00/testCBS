@model CBS.FrontDesk.Data.Entity.RequestManagement.WafDashboardData
@using Newtonsoft.Json
@{
    ViewBag.Title = "WAF Dashboard";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .chart-fixed {
        height: 300px !important;
        max-height: 300px !important;
    }

    canvas.chart-fixed {
        width: 100% !important;
        height: 300px !important;
        max-height: 300px;
        display: block !important;
    }

    #blockedUserMap {
        height: 400px;
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        z-index: 0;
        position: relative;
        background: #f3f3f3;
    }

    .leaflet-container {
        height: 100% !important;
        width: 100% !important;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="bi bi-shield-lock-fill me-2"></i> WAF Dashboard
                </h1>
                <p class="card-text">Monitor and analyze access control enforced by the WAF. Apply filters below to view metrics within the selected date range.</p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Filter Form -->
<form id="filterForm" method="post" asp-action="GetWafDashBoardForBlockedUsers" class="card bg-light p-3 mb-3">
    <h5 class="text-primary mb-3"><i class="bi bi-filter me-1"></i> Filters</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label fw-bold">From Date</label>
            <input type="date" name="FromDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">To Date</label>
            <input type="date" name="ToDate" class="form-control" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button id="applyFilterBtn" type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Apply Filter
            </button>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button id="exportExcelBtn" type="button" class="btn btn-success w-100">
                <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </button>
        </div>
    </div>
</form>
<div id="dashboardWrapper">
    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center p-3 h-100 d-flex flex-column justify-content-center">
                <h6 class="text-warning">Active Blocks</h6>
                <h3>@Model.Summary.ActiveBlocks</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 h-100 d-flex flex-column justify-content-center">
                <h6 class="text-info">Top Country</h6>
                <h3>@Model.Summary.TopCountry</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 h-100 d-flex flex-column justify-content-center">
                <h6 class="text-danger">Blocked IPs</h6>
                <h3>@Model.Summary.BlockedIps</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 h-100 d-flex flex-column justify-content-center">
                <h6 class="text-warning">Top Reason</h6>
                <p class="mb-0">@Model.Summary.TopReason</p>
            </div>
        </div>
    </div>

</div>

<div class="card mt-2">
    <h5 class="section-title mb-2">Blocked User Locations</h5>
    <div id="blockedUserMap" style="height: 400px; width: 100%; border-radius: 12px;"></div>
</div>


<!-- Charts -->
