@model List<CBS.FrontDesk.Data.Entity.SavingProducts.MemberRegistrationFeePolicy>
    @using Resources
@if (Model != null)
{<div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalMemberAccountActivationPolicy.Policy</th>
                    <th>@GlobalMemberAccountActivationPolicy.EntranceFee</th>
                    <th>@GlobalMemberAccountActivationPolicy.ByeLawsFee</th>
                    <th>@GlobalMemberAccountActivationPolicy.LoanPFee</th>
                    <th>@GlobalMemberAccountActivationPolicy.BuildinCFee</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="width:18%">@d.PolicyName</td>
                        <td style="width:15%">@d.MinimumEntranceFee.ToString("#,##0.0") - @d.MaximumEntrancenFee.ToString("#,##0.0")</td>
                        <td style="width:15%">@d.MinimumByeLawsFee.ToString("#,##0.0") - @d.MinimumByeLawsFee.ToString("#,##0.0")</td>
                        <td style="width:15%">@d.MinimumLoanPolicyFee.ToString("#,##0.0") - @d.MaximumLoanPolicyFee.ToString("#,##0.0")</td>
                        <td style="width:15%">@d.MinimumBuildingContributionFee.ToString("#,##0.0") - @d.MaximumBuildingContribution.ToString("#,##0.0")</td>
                        <td style="width:10%">

                            @if (d.IsActive)
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalShared.Active</span></label>
                            }
                            else
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalShared.Blocked</span></label>
                            }
                        </td>
                        <td style="width:12%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','MemberAccountActivationPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.PolicyName @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.PolicyName" onclick="DeleteRecordDataTable('MemberAccountActivationPolicy','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
<div class="alert alert-info" role="alert">
    @GlobalMemberAccountActivationPolicy.NoMemberFeePolicyWasFoundAtTheMoment.
</div>
}
