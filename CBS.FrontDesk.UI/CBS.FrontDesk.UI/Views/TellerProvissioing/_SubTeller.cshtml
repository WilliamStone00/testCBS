@model CBS.FrontDesk.Data.Entity.SavingProducts.OpeningOfTheDay
@using Resources
@using (Html.BeginForm("SubTeller", "TellerProvissioing", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <div class="row mt-2 gy-4">

        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@GlobalTellerProvissioing.TotalAmount: 0.0</span>
            </div>
        </div>


        <div class="col-md-2">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.SubTellerProvissioning.currencyNotes.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateBalance()" })
                @Html.ValidationMessageFor(m => m.SubTellerProvissioning.currencyNotes.note10000, "", new { @class = "text-danger " })
                <label>N10,000</label>
            </div>
        </div>
        <div class="col-md-2">
