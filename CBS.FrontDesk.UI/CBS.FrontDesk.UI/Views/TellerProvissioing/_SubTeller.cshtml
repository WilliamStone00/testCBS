        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.SubTellerProvissioning.primaryTellerId, new SelectList(ViewBag.PrimaryTeller, "id", "name"), "---"+ @GlobalTellerProvissioing.SelectPrimaryTeller + "---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.SubTellerProvissioning.primaryTellerId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalTellerProvissioing.SelectPrimaryCaisse</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.SubTellerProvissioning.subTellerId, new SelectList(ViewBag.SubTellers, "id", "name"), "---"+ @GlobalTellerProvissioing.SelectTellerBox + "---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.SubTellerProvissioning.subTellerId, "", new { @class = "text-danger " })
