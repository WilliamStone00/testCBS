                                            <div class="col-md-2">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.currencyNotes.coin5, new { @class = "form-control", @id = "Notes_coin5", @oninput = "calculateBalance()" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.currencyNotes.coin5, "", new { @class = "text-danger " })
                                                    <label>C5</label>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.currencyNotes.coin1, new { @class = "form-control", @id = "Notes_coin1", @oninput = "calculateBalance()" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.currencyNotes.coin1, "", new { @class = "text-danger " })
                                                    <label>C1</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.Principal, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.Principal, "", new { @class = "text-danger " })
                                                    <label>@GlobalOperation.Principal</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.Interest, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.Interest, "", new { @class = "text-danger " })
                                                    <label>@GlobalOperation.Interest</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.Tax, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.Tax, "", new { @class = "text-danger " })
                                                    <label>@GlobalOperation.Vat</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.DepositRequest.Penalty, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.Penalty, "", new { @class = "text-danger " })
                                                    <label>@GlobalOperation.Penalty</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextAreaFor(m => m.DepositRequest.note, new { @class = "form-control", @style = "height: 75px;" })
                                                    @Html.ValidationMessageFor(m => m.DepositRequest.note, "", new { @class = "text-danger " })
                                                    <label for="formValidationDob">@GlobalOperation.TellerNote</label>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center my-3">
                                            <p>@GlobalOperation.DepositPolicyIsNotConfigureForProduct @Model.Product.name</p>
                                        </div>
                                    }
                                </div>

                            </fieldset>
                        </div>
                    </div>
                </div>
                <div class="my-4"></div>
                <div class="accordion-item">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOneT">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-T"
                                aria-controls="accordionPopoutIcon-T">
                            <i class="mdi mdi-transfer me-2"></i>
                            @GlobalOperation.Loans
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-T"
                         class="accordion-collapse collapse"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="transferSeting">
                                <div class="accordion-body">
                                    <div id="mainviewChange">
                                        <fieldset class="fieldset-custom">
                                            <div class="change-group">
                                                <div class="row mt-2 gy-4">
                                                    @Html.Partial("_LoanData")
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            }

        </div>
        <div class="accordion-body">
            <div class="row g-4">
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                </div>
            </div>
        </div>



    }

</div>

