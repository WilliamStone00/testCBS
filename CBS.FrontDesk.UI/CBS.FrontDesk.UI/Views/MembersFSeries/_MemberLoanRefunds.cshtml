@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk

@if (Model == null || !Model.Refunds.Any())
{
    <div class="alert alert-info text-center">No refunds found for the selected period.</div>
}
else
{
    var totalPaid = Model.Refunds.Sum(x => x.Amount); // ✅ Amount column now represents Paid
    var totalPrincipal = Model.Refunds.Sum(x => x.Principal);
    var totalInterest = Model.Refunds.Sum(x => x.Interest);
    var totalTax = Model.Refunds.Sum(x => x.Tax);
    var totalPenalty = Model.Refunds.Sum(x => x.Penalty);
    var totalBalance = Model.Refunds.Sum(x => x.Balance);

    <div class="table-responsive">
        <table class="table table-striped table-hover" id="myDataTableT2">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Loan #</th>
                    <th class="text-end">Paid</th> <!-- Renamed -->
                    <th class="text-end">Principal</th>
                    <th class="text-end">Interest</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Penalty</th>
                    <th class="text-end">Balance</th>
                    <th>Method</th>
                    <th>Channel</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Refunds.OrderByDescending(x => x.DateOfPayment))
                {
                    <tr>
                        <td>@r.DateOfPayment.ToString("dd/MM/yyyy")</td>
                        <td>@r.LoanId</td>
                        <td class="text-end text-primary">@r.Amount.ToString("N0")</td> <!-- Paid -->
                        <td class="text-end">@r.Principal.ToString("N0")</td>
                        <td class="text-end">@r.Interest.ToString("N0")</td>
                        <td class="text-end">@r.Tax.ToString("N0")</td>
                        <td class="text-end">@r.Penalty.ToString("N0")</td>
                        <td class="text-end text-danger">@r.Balance.ToString("N0")</td>
                        <td>@(string.IsNullOrWhiteSpace(r.PaymentMethod) ? "N/A" : r.PaymentMethod)</td>
                        <td>@(string.IsNullOrWhiteSpace(r.PaymentChannel) ? "N/A" : r.PaymentChannel)</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="loadRefundDetails('@r.Id')">
                                <i class="mdi mdi-eye-outline me-1"></i> Details
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="2" class="text-end">Totals:</td>
                    <td class="text-end text-primary">@totalPaid.ToString("N0")</td> <!-- Paid -->
                    <td class="text-end">@totalPrincipal.ToString("N0")</td>
                    <td class="text-end">@totalInterest.ToString("N0")</td>
                    <td class="text-end">@totalTax.ToString("N0")</td>
                    <td class="text-end">@totalPenalty.ToString("N0")</td>
                    <td class="text-end text-danger">@totalBalance.ToString("N0")</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="mt-3 p-3 border rounded bg-light">
        <h6 class="fw-bold text-primary mb-2">
            <i class="mdi mdi-information-outline me-1"></i> Column Definitions
        </h6>
        <ul class="small mb-0">
            <li><strong>Date</strong>: Refund/repayment posting date.</li>
            <li><strong>Paid</strong>: Total refund amount paid in the transaction.</li>
            <li><strong>Principal / Interest / Tax / Penalty</strong>: Breakdown of the payment.</li>
            <li><strong>Balance</strong>: Remaining loan balance after this refund.</li>
            <li><strong>Method / Channel</strong>: Payment method and collection channel.</li>
        </ul>
    </div>
}
