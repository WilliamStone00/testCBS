@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
<div class="card-body d-sm-flex d-block flex-wrap">
    <!-- 🔎 Accounts Overview -->
    <a href="#"
       onclick="GetMembersAccounts('@Model.CustomerId','_MembersAccount','datalistingview','members_account')"
       class="btn btn-outline-primary d-flex align-items-center me-2 mb-2"
       data-bs-toggle="tooltip" title="Members account status">
        <i class="fas fa-money-check me-2"></i>
        <span>Accounts</span>
    </a>

    <!-- 💳 Transactions -->
    <a href="#"
       onclick="GetTransactionMembersTransactions('@Model.CustomerId','datalistingview','_Transactions','transactions','myDataTable',0)"
       class="btn btn-outline-success d-flex align-items-center me-2 mb-2"
       data-bs-toggle="tooltip" title="View all member transactions">
        <i class="fas fa-exchange-alt me-2"></i>
        <span>Transactions</span>
    </a>

    <!-- 👤 Profile Information -->
    <a href="#"
       onclick="GetMembersData('@Model.CustomerId','_MembersProfile','datalistingview','members_profile')"
       class="btn btn-outline-secondary d-flex align-items-center me-2 mb-2"
       data-bs-toggle="tooltip" title="View member profile details">
        <i class="fas fa-user me-2"></i>
        <span>Profile</span>
    </a>
</div>
