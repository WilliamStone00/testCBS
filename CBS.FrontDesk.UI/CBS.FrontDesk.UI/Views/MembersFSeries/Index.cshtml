@{
    ViewBag.Title = "Member Overall branches";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group-outline me-2"></i> @GlobalMembersFSeries.MEMBERS_OVERVIEW_FROM_OVER_ALL_BRANCHES
                </h1>
                <p class="card-text">
                    @GlobalMembersFSeries.TheF2F5SeriesProvidesUsersWithDetailedInsights.
                    @GlobalMembersFSeries.ThisReportOffersNetworkWideAccessSpecificallyLimitedToThe <strong>@Session["BankName"]</strong>, @GlobalMembersFSeries.andIsStrictlyReadOnly.
                    @GlobalMembersFSeries.AListOfMembersIsFirstDisplayed.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalMembersFSeries.LeverageTheFiltersBelowToNarrowResultsByGender.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalMembersFSeries.TIPS_FOR_FILTERING_MEMBERS_EFFECTIVELY</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalMembersFSeries.FilterByBranch:</strong> @GlobalMembersFSeries.EasilySegmentMembersByOperationalBranch.</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i> <strong>@GlobalMembersFSeries.RegistrationDates:</strong> @GlobalMembersFSeries.FilterByCreationDateOrBirthDateToTargetSpecificDemographics.</li>
                <li><i class="mdi mdi-gender-male-female text-secondary me-2"></i> <strong>@GlobalMembersFSeries.GenderMaritalStatus:</strong> @GlobalMembersFSeries.AnalyzeMemberBreakdownAcrossKeyAttributes.</li>
                <li><i class="mdi mdi-account-check-outline text-info me-2"></i> <strong>@GlobalMembersFSeries.ApprovalLegalStatus:</strong> @GlobalMembersFSeries.FilterApprovedMembersByLegalFormOrType.</li>
                <li><i class="mdi mdi-file-export-outline text-success me-2"></i> <strong>@GlobalMembersFSeries.Export:</strong> @GlobalMembersFSeries.ExportSearchResultsToExcelForReportingOrRecordkeeping.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Advanced Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalMembersFSeries.MemberFilters</h5>
    <form id="memberFilterForm">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle switches for additional filters -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDemographics" onclick="document.getElementById('demographicFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleDemographics">@GlobalMembersFSeries.ShowDemographicFilters</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleApproval" onclick="document.getElementById('approvalFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleApproval">@GlobalMembersFSeries.ShowApprovalLegalFilters</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDates" onclick="document.getElementById('dateFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleDates">@GlobalMembersFSeries.ShowDateFilters</label>
                    </div>
                </div>
            </div>

            <!-- Default Filters -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalMembersFSeries.MemberAccountNumber</label>
                    <input type="text" id="customerId" name="CustomerId" class="form-control" placeholder="@GlobalMembersFSeries.MemberAccountTemporalNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalMembersFSeries.FirstName</label>
                    <input type="text" id="firstName" name="FirstName" class="form-control" placeholder="@GlobalMembersFSeries.FirstName" />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold">@GlobalMembersFSeries.LastName</label>
                    <input type="text" id="lastName" name="LastName" class="form-control" placeholder="@GlobalMembersFSeries.LastName" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <label class="form-label fw-bold">@GlobalMembersFSeries.Branch</label>
                    @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalMembersFSeries.SelectBranch +"---", new { @class = "form-control select2", @id = "branchId", @name = "BranchId" })
                </div>
            </div>

            <!-- Demographic Filters -->
            <div id="demographicFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.GenderOrGroups</label>
                        <select id="gender" name="Gender" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Female">@GlobalMembersFSeries.Female</option>
                            <option value="Male">@GlobalMembersFSeries.Male</option>
                            <option value="Male">@GlobalMembersFSeries.Groups</option>
                        </select>

                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.MaritalStatus</label>
                        <select id="maritalStatus" name="MaritalStatus" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Divorced">@GlobalMembersFSeries.Divorced</option>
                            <option value="Married">@GlobalMembersFSeries.Married</option>
                            <option value="Single">@GlobalMembersFSeries.Single</option>
                            <option value="Widowed">@GlobalMembersFSeries.Widowed</option>
                        </select>

                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.WorkingStatus</label>
                        <select id="workingStatus" name="WorkingStatus" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Unemployed">@GlobalMembersFSeries.Unemployed</option>
                            <option value="Working">@GlobalMembersFSeries.Working</option>
                        </select>

                    </div>
                </div>
            </div>

            <!-- Approval & Legal Filters -->
            <div id="approvalFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.MembershipApproval</label>
                        <select id="membershipApprovalStatus" name="MembershipApprovalStatus" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Approved">@GlobalShared.Approved</option>
                            <option value="Pending">@GlobalMembersFSeries.AwaitsValidation</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.LegalForm</label>
                        <select id="legalForm" name="LegalForm" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Moral_Person">@GlobalMembersFSeries.MoralPerson</option>
                            <option value="Physical_Person">@GlobalMembersFSeries.PhysicalPerson</option>
                        </select>

                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.MembersProfile</label>
                        <select id="customerType" name="CustomerType" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="AffiliateMemberSalaryAccount">@GlobalMembersFSeries.AffiliateMemberSalary</option>
                            <option value="CivilServantsSalaryCollection">@GlobalMembersFSeries.CivilServantsSalary</option>
                            <option value="DailyCollection">@GlobalMembersFSeries.DailyCollection</option>
                            <option value="DailySaver">@GlobalMembersFSeries.DailySaver</option>
                            <option value="MemberAccount">@GlobalMembersFSeries.MembersAccountSerialNumber</option>
                            <option value="MobileMoneyMTN">@GlobalMembersFSeries.MobileMoneyMTN</option>
                            <option value="MobileMoneyOrange">@GlobalMembersFSeries.MobileMoneyOrange</option>
                            <option value="PreRegisteredMember">@GlobalMembersFSeries.PreRegisteredMembers</option>
                            <option value="PrivateInstitutionSalaryCollection">@GlobalMembersFSeries.PrivateInstitutionSalary</option>
                            <option value="Remittance">@GlobalMembersFSeries.Remittance </option>
                            <option value="TemporalAccount">@GlobalMembersFSeries.TemporalAccount</option>
                            <option value="UnknownSalaryMemberAccount">@GlobalMembersFSeries.TemporalSalaryForMember</option>
                        </select>


                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.AgeCategory</label>
                        <select id="ageCategoryStatus" name="AgeCategoryStatus" class="form-select">
                            <option value="">@GlobalMembersFSeries.All</option>
                            <option value="Major">@GlobalMembersFSeries.Major</option>
                            <option value="Minor">@GlobalMembersFSeries.Minor</option>
                        </select>
                    </div>

                </div>
            </div>

            <!-- Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.DateOfBirthFrom</label>
                        <input type="date" id="dobFrom" name="DateOfBirthFrom" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.DateofBirthTo</label>
                        <input type="date" id="dobTo" name="DateOfBirthTo" class="form-control" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.CreatedFrom</label>
                        <input type="date" id="createdFrom" name="CreatedFrom" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalMembersFSeries.CreatedTo</label>
                        <input type="date" id="createdTo" name="CreatedTo" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> @GlobalMembersFSeries.ApplyFilter</button>
                <button id="resetFilterBtn" type="reset" class="btn btn-secondary me-2 w-100"><i class="mdi mdi-refresh"></i> @GlobalShared.Reset</button>
                @*<button id="exportBtn" class="btn btn-success w-100"><i class="mdi mdi-file-excel"></i> Export</button>*@
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_MembersData")
</div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/MembersFSeries/Members.js"></script>
}
