@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<div class="row g-4">
    <div class="col-md-3">
        <div class="card mt-3">
            <div class="card-body px-3 py-2">
                <div class="image-upload-container">
                    <!-- Image for picture -->
                    @if (Model.Customer.photoUrl != null)
                    {
                        <!-- Clickable photo for preview -->
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                            <img src="@Model.Customer.photoUrl" class="img-fluid preview-image" alt="@GlobalShared.UploadedImage">
                        </a>
                        <!-- Modal for photo preview -->
                        <div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-body">
                                        <img src="@Model.Customer.photoUrl" class="img-fluid" alt="@GlobalShared.UploadedImage">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <img src="@Url.Content(Model.Customer.ImageNoVirtualPath)" class="img-fluid preview-image" alt="@GlobalShared.NoSignatureFound" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                    }
                    <!-- ... Other content ... -->
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-body px-3 py-2">
                <div class="image-upload-container">
                    <!-- Image for signature -->
                    @if (Model.Customer.signatureUrl != null)
                    {
                        <!-- Clickable signature for preview -->
                        <a href="#" data-bs-toggle="modal" data-bs-target="#signaturePreviewModal">
                            <img src="@Model.Customer.signatureUrl" class="img-fluid preview-image" alt="@GlobalShared.UploadedSignature">
                        </a>
                        <!-- Modal for signature preview -->
                        <div class="modal fade" id="signaturePreviewModal" tabindex="-1" aria-labelledby="signaturePreviewModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-body">
                                        <img src="@Model.Customer.signatureUrl" class="img-fluid" alt="@GlobalShared.UploadedSignature">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <img src="@Url.Content(Model.Customer.ImageVirtualNoSignaturePath)" class="img-fluid preview-image" alt="@GlobalShared.NoSignatureFound" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                    }
                    <!-- ... Other content ... -->
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="mb-3 border-2">
            <div id="datalistingview_inner">
                <div class="card mb-4 border-2">
                    <div class="card-header">
                        <h5 class="card-title">@GlobalMembersFSeries.MembersProfile</h5>
                    </div>
                    <div class="mt-3">

                        <table class="table" id="myDataTable">
                            <tr>
                                <td><strong>@GlobalMembersFSeries.CustomerNumber:</strong></td>
                                <td>@Model.Customer.CustomerId</td>
                            </tr>
                            <tr>
                                <td><strong>@GlobalMembersFSeries.CustomerCode:</strong></td>
                                <td>@Model.Customer.CustomerCode</td>
                            </tr>
                            <tr>
                                <td><strong>@GlobalMembersFSeries.Name</strong></td>
                                <td>@Model.Customer.name</td>
                            </tr>
                            <tr>
                                <td><strong>@GlobalMembersFSeries.Telephone</strong></td>
                                <td>@Model.Customer.Phone</td>
                            </tr>
                            <tr>
                                <td><strong>@GlobalMembersFSeries.Branch:</strong></td>
                                <td>@Model.Customer.BankName</td>
                            </tr>
                            <tr>
                                <td><strong>@GlobalMembersFSeries.ApprovalStatus</strong></td>
                                <td>
                                    @if (Model.Customer.MembershipApprovalStatus == "Approved")
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle-fill"></i>@Model.Customer.MembershipApprovalStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            <i class="bi bi-x-circle-fill"></i>@Model.Customer.MembershipApprovalStatus
                                        </span>
                                    }
                                </td>
                            </tr>


                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



