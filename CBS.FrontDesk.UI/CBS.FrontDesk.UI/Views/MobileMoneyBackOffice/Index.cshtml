@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier
@{
    ViewBag.Title = "Back Office - None Cash Mobile Money Cash-In";
}
@using Resources
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<!-- Page Header -->
<div class="row mb-0">
    <div class="col">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cellphone-transfer me-2"></i> @GlobalMobileMoneyBackOffice.BackOfficeNoneCashMobileMoneyCashIn
                </h1>
                <p class="card-text">
                    @GlobalMobileMoneyBackOffice.ThisInterfaceIsExclusivelyForBackOffice.
                    @GlobalMobileMoneyBackOffice.ItAllowsStaffToProcessMemberDeposits
                    @GlobalMobileMoneyBackOffice.AndCreditThoseFundsToTheRespectiveMembersAccount.
                    <strong>@GlobalMobileMoneyBackOffice.NoWithdrawalsCanBeProcessedFromThisInterface.</strong>
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-0">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalMobileMoneyBackOffice.MobileMoneyCashInGuidelines</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOperationTips" aria-expanded="false" aria-controls="collapseOperationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseOperationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-magnify text-success me-2"></i> @GlobalMobileMoneyBackOffice.SearchForTheMembersAccount.</li>
                <li><i class="mdi mdi-account-box-outline text-primary me-2"></i> @GlobalMobileMoneyBackOffice.VerifyTheMembersDetails.</li>
                <li><i class="mdi mdi-cellphone text-success me-2"></i> @GlobalMobileMoneyBackOffice.SelectTheCorrectMobileMoneyOperator.</li>
                <li><i class="mdi mdi-bank text-primary me-2"></i> @GlobalMobileMoneyBackOffice.EnsureTheDepositWasMadeIntoTheBranchsMobileMoneyFloatAccount.</li>
                <li><i class="mdi mdi-cash-register text-primary me-2"></i> @GlobalMobileMoneyBackOffice.EnterTheCorrectTellerCodeToProcess.</li>
                <li><i class="mdi mdi-note-edit-outline text-info me-2"></i> @GlobalMobileMoneyBackOffice.EnterAClearTransactionNote.</li>
                <li><i class="mdi mdi-cash-multiple text-warning me-2"></i> @GlobalMobileMoneyBackOffice.VerifyTheAmountEnteredIncludingAnyApplicableFeesBeforeConfirming</li>
                <li><i class="mdi mdi-swap-horizontal text-success me-2"></i> @GlobalMobileMoneyBackOffice.TheAccountantMustImmediatelyProcessTheTransaction</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalMobileMoneyBackOffice.OnlyDepositsAreAllowed</li>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalMobileMoneyBackOffice.OnceSubmittedTransactionsCannotBeReversed.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalMobileMoneyBackOffice.NoAdditionalApprovalIsRequired.</li>
            </ul>
        </div>
    </div>
</div>



<!-- Main Content -->
<div class="row">
    <div class="col">
        <div class="row my-2">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-1">
                    <h2 class="accordion-header" id="headingMobileMoney">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cellphone-transfer me-2"></i>
                            <span id="NoneCashMobileMoney">@GlobalMobileMoneyBackOffice.BACK_OFFICE_NONE_CASH_MOBILE_MONEY_CASH_IN</span>
                        </button>
                    </h2>
                    <div id="collapseMobileMoneyOperations" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <hr style="border: 2px solid blue;" />
                            @Html.Partial("_SearchBox")
                            <hr style="border: 2px solid blue;" />
                            <div id="datalistingview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/NoneCashMobileMoney/NoneCashMobileMoneyOperations.js"></script>
}
