@model CBS.FrontDesk.Data.Entity.LoanConf.Penalty

@using (Html.BeginForm("AddOrEdit", "Penalty", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))

{
    @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

<div class="row gy-3">
    @Html.HiddenFor(model => model.Id)

    <!-- 📌 Basic Info -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-file-document-outline me-1"></i> Penalty Details
        </h6>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyName, new { @class = "form-control", required = "required" })
            <label>Penalty Name</label>
            <small class="text-muted d-block">💡 Example: “Late Fee – Personal Loans”. Must be unique.</small>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.PenaltyType, new SelectList(ViewBag.PenaltyTypes, "Value", "Text"), "--- Select Penalty Type ---", new { @class = "form-control select2", required = "required" })
            <label>Penalty Type</label>
            <small class="text-muted d-block">💡 Determines when to trigger penalty (e.g., after due date or on maturity).</small>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-floating shadow-sm">
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", style = "height: 150px;" })
            <label>Description (optional)</label>
            <small class="text-muted d-block">💡 Internal notes or detailed explanation for admins.</small>
        </div>
    </div>



    <!-- 💵 Value & Rate -->
    <!-- 💵 Value & Application Mode -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-currency-usd me-1"></i> Value & Application Mode
        </h6>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyValue, new
            {
                @class = "form-control",
                type = "number",
                id = "PenaltyValue",
                step = "0.01",
                min = "0",
                required = "required"
            })
            <label>Penalty Value</label>
            <small class="text-muted d-block">💡 Enter either a fixed amount (e.g., 2000 FCFA) or a % rate.</small>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsRate, new { @class = "form-check-input", id = "IsRate" })
            <label class="form-check-label" for="IsRate">Value is a Rate (%)</label>
            <small class="text-muted d-block">💡 When checked, the system treats PenaltyValue as a percentage (e.g., 2%). Recommended max: 10%.</small>
        </div>
    </div>




    <!-- ⚙️ Calculation Logic -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-calculator-variant me-1"></i> Calculation Logic
        </h6>
    </div>

    <!-- Base Amount Selection -->
    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.CalculatePenaltyOn,
                new List<SelectListItem>
                {
                    new SelectListItem { Text = "Overdue Principal Amount", Value = "Overdue_Principal_Amount" },
                    new SelectListItem { Text = "Overdue Interest Amount", Value = "Overdue_Interest_Amount" },
                    new SelectListItem { Text = "Overdue Daily Interest Amount", Value = "Overdue_Daily_Interest_Amount" },
                    new SelectListItem { Text = "Apply Fixed Penalty Amount", Value = "Apply_Fixed_Penalty_Amount" },
                    new SelectListItem { Text = "Overdue Principal + Interest", Value = "Overdue_Principal_Plus_Interest" }
                },
                "--- Select Base ---",
                new { @class = "form-control select2" })
            <label>Apply On</label>
            <small class="text-muted d-block">
                💡 Defines the part of the loan used as the penalty base. For fixed fees, choose "Apply Fixed Penalty Amount".
            </small>
        </div>
    </div>

    <!-- Max Cap -->
    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyMaxCapAmount, new { @class = "form-control", type = "number", min = "0" })
            <label>Penalty Cap (optional)</label>
            <small class="text-muted d-block">💡 Maximum amount this penalty can reach (e.g., 50,000 FCFA).</small>
        </div>
    </div>

    <!-- Cumulative -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsCumulative, new { @class = "form-check-input", id = "IsCumulative" })
            <label class="form-check-label fw-bold" for="IsCumulative">Cumulative</label>
            <small class="text-muted d-block">💡 Apply the penalty at each eligible recurrence interval. Recommended for daily/weekly logic.</small>
        </div>
    </div>

    <!-- One-Time -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsOneTimeOnly, new { @class = "form-check-input", id = "IsOneTimeOnly" })
            <label class="form-check-label fw-bold" for="IsOneTimeOnly">Apply Once</label>
            <small class="text-muted d-block">💡 Use for special one-time charges like late start fees.</small>
        </div>
    </div>


    <!-- 📅 Timing & Recurrence -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-clock-outline me-1"></i> Timing & Recurrence
        </h6>
    </div>

    <!-- Grace Period -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.GracePeriodInDaysBeforeApplyingPenalty, new { @class = "form-control", type = "number", min = "0" })
            <label>Grace Period (Days)</label>
            <small class="text-muted d-block">💡 Days after due date before penalty eligibility begins.</small>
        </div>
    </div>

    <!-- Apply After Days -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.DaysToApplyPenalty, new { @class = "form-control", type = "number", min = "0" })
            <label>Apply After (Days)</label>
            <small class="text-muted d-block">💡 Minimum number of days overdue before enforcing penalty.</small>
        </div>
    </div>

    <!-- Apply on Weekends -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.ApplyOnWeekends, new { @class = "form-check-input", id = "ApplyOnWeekends" })
            <label class="form-check-label fw-bold" for="ApplyOnWeekends">Apply on Weekends</label>
            <small class="text-muted d-block">💡 Check to allow penalties even on weekends.</small>
        </div>
    </div>

    <!-- Recurrence Frequency -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.RecurringPeriod,
                new List<SelectListItem> {
                    new SelectListItem { Text = "Days", Value = "Days" },
                    new SelectListItem { Text = "Weeks", Value = "Weeks" },
                    new SelectListItem { Text = "Months", Value = "Months" },
                    new SelectListItem { Text = "Years", Value = "Years" }
                },
                "--- Select Period ---",
                new { @class = "form-control select2" })
            <label>Recurring Period</label>
            <small class="text-muted d-block">💡 How often to apply: daily, weekly, monthly, etc.</small>
        </div>
    </div>

    <!-- Recurrence Interval -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.RecuringInterval, new { @class = "form-control", type = "number", min = "1" })
            <label>Interval</label>
            <small class="text-muted d-block">💡 Multiplier of the period (e.g., every 2 weeks = 2).</small>
        </div>
    </div>

    <!-- Expiry Toggle -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBox("HasExpiryAfterDays", false, new { @class = "form-check-input", id = "HasExpiryAfterDays" })
            <label class="form-check-label fw-bold" for="HasExpiryAfterDays">Enable Expiry by Days</label>
            <small class="text-muted d-block">💡 Ends penalty enforcement after a specific number of days.</small>
        </div>
    </div>

    <!-- Expiry Days -->
    <div class="col-md-4" id="expiryDaysContainer" style="display:none;">
        <div class="form-floating shadow-sm">
            @Html.TextBox("ExpireAfterDays", null, new { @class = "form-control", type = "number", min = "1" })
            <label>Expire After (Days)</label>
            <small class="text-muted d-block">💡 Time in days from activation until penalty stops applying.</small>
        </div>
    </div>




    <!-- 🧾 Accounting -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-bank-transfer me-1"></i> Accounting Posting
        </h6>
    </div>

    <!-- Fee Posting Account -->
    <div class="col-md-12">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.FeePostingAccountId, new { @class = "form-control" })
            <label>Fee Posting Account ID</label>
            <small class="text-muted d-block">💡 Used for tracking penalty revenue in the General Ledger (GL).</small>
        </div>
    </div>

    <!-- Enable/Disable Rule -->
    <div class="col-md-12">
        <div class="form-check mt-3">
            @Html.CheckBoxFor(m => m.IsEnabled, new { @class = "form-check-input", id = "IsEnabled" })
            <label class="form-check-label fw-bold" for="IsEnabled">Enable Penalty</label>
            <small class="text-muted d-block">💡 Toggle to activate or deactivate this penalty rule.</small>
        </div>
    </div>

    <!-- 🔘 Actions -->
    <div class="col-12 text-end mt-3">
        <button type="submit" class="btn btn-danger shadow-sm px-4">
            <i class="mdi mdi-content-save-outline me-1"></i>
            @(Model.Id == null ? "Save Configuration" : "Update Configuration")
        </button>
        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">Reset</button>
    </div>


</div>
}



<script>
    $(function () {
        function validatePenaltyValue() {
            const isRate = $('#IsRate').is(':checked');
            const value = parseFloat($('#PenaltyValue').val());

            if (isRate && value > 100) {
                alert('❌ Penalty Value cannot exceed 100% when it is a rate.');
                $('#PenaltyValue').val(100);
            }
        }

        // Attach on change
        $('#PenaltyValue').on('input', validatePenaltyValue);
        $('#IsRate').on('change', validatePenaltyValue);
    });
</script>


<script>
    $(function () {
        function toggleValidityMode() {
            const byDays = $('#HasExpiryAfterDays').is(':checked');
            $('#expiryDaysContainer').toggle(byDays);
            //$('#validityDateContainer, #validityDateContainer2').toggle(!byDays);
        }
        toggleValidityMode();
        $('#HasExpiryAfterDays').on('change', toggleValidityMode);
    });
</script>
