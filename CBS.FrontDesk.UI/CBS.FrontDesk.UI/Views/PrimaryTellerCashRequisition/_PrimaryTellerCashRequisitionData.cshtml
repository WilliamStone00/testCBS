@model List<CBS.FrontDesk.Data.Entity.SavingProducts.CashReplenishmentPrimaryTeller>
    @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">Data listings </legend>
    @if (Model.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalPrimaryTellerCashRequisition.NoDataFound</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalPrimaryTellerCashRequisition.Date</th>
                        <th>@GlobalPrimaryTellerCashRequisition.Amount</th>
                        <th>@GlobalPrimaryTellerCashRequisition.Branch</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalPrimaryTellerCashRequisition.InitiatedBy</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:20%">@d.InitializeDate</td>
                            <td style="width:10%">@d.RequestedAmount.ToString("#,##0.0")</td>
                            <td style="width:30%">@d.Branch.Name</td>
                            <td style="width:10%">
                                @if (d.ApprovedStatus=="Approved")
                                {
                                    <span class="badge bg-info">@GlobalShared.Approved</span>
                                }
                                else
                                {
                            <span class="badge bg-danger">@d.ApprovedStatus</span>
                                }
                            </td>
                            <td style="width:20%">@d.RequesterName</td>
                            <td style="width:10%">
                                <a href="/PrimaryTellerCashRequisition/Details?ProvisionKey=@d.Id" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Validate @d.RequestedAmount @GlobalPrimaryTellerCashRequisition.intoOperation.">@GlobalShared.Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
