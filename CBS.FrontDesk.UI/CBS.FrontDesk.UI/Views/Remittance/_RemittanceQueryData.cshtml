
@using Resources

<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" id="remittanceDataTable">
        <thead>
            <tr>
                <th>@GlobalRemittance.Date</th>
                <th>@GlobalRemittance.SenderName</th>
                <th>@GlobalRemittance.ReceiverName</th>
                <th>@GlobalRemittance.TransactionReference</th>
                <th>@GlobalRemittance.InitiatingBranch</th>
                <th>@GlobalRemittance.ReceivingBranch</th>
                <th>@GlobalRemittance.Amount</th>
                <th>@GlobalShared.Status</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
    </table>
</div>
