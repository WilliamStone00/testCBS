@model CBS.FrontDesk.Data.Entity.SavingProducts.AddRemittanceCommand
@using Resources




@using (Html.BeginForm("Create", "Remittance", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <div class="accordion" id="remittanceAccordion">
        <!-- Request Properties Section -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="requestPropertiesHeader">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#requestProperties" aria-expanded="true" aria-controls="requestProperties">
                    @GlobalRemittance.RequestProperties
                </button>
            </h2>
            <div id="requestProperties" class="accordion-collapse collapse show" aria-labelledby="requestPropertiesHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <!-- Help Note -->
                    <div class="mb-3">
                        <p class="text-muted">
                            @GlobalRemittance.ThisSectionAllowsYouToConfigureTheEssentialDetails.
                            @GlobalRemittance.EnsureThatAllInputsAlignWithTheRemittancesRequirements
                            @GlobalRemittance.determinesTheProcessingFlowAndEnsuresProperIdentification.
                        </p>
                    </div>
                    <fieldset class="fieldset-custom mb-4">
                        <legend class="text-black">@GlobalRemittance.RequestProperties</legend>
                        <div class="row mt-2 gy-4">


                            <!-- Transfer Source -->
                            <div class="col-md-12 mt-3">
                                <label class="form-label">@GlobalRemittance.TransferSource</label>
                                <div class="d-flex align-items-center">
                                    <!-- Local Remittance -->
                                    <div class="form-check me-3">
                                        @Html.RadioButtonFor(m => m.TransferSource, "Local_Remittance", new
                                   {
                                       @id = "transferSourceLocal",
                                       @class = "form-check-input",
                                       @checked = (Model.TransferSource == "Local_Remittance" || Model.TransferSource == null) ? "checked" : null,
                                       @onchange = "HandleTransferSourceChange()"
                                   })
                                        <label class="form-check-label" for="transferSourceLocal">@GlobalRemittance.LocalRemittance</label>
                                    </div>

                                    <!-- International Remittance -->
                                    <div class="form-check">
                                        @Html.RadioButtonFor(m => m.TransferSource, "International_Remittance", new
                                   {
                                       @id = "transferSourceInternational",
                                       @class = "form-check-input",
                                       @onchange = "HandleTransferSourceChange()"
                                   })
                                        <label class="form-check-label" for="transferSourceInternational">@GlobalRemittance.InternationalRemittance</label>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.TransferSource, "", new { @class = "text-danger" })
                            </div>
                            <!-- Source Branch -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.SourceBranchId, new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalRemittance.SelectBranch+"---", new { @class = "form-control select2", @search = "true", @onchange = "GetBranchRemittanceAccounts(this.value)", @id = "BranchId" })
                                    @Html.ValidationMessageFor(m => m.SourceBranchId, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SourceBranch</label>
                                </div>
                            </div>
                            <!-- Transfer Type (Hidden by default) -->
                            <div id="transferTypeSection" class="col-md-12 mt-2" style="display: none;">
                                <label class="form-label">@GlobalRemittance.TransferType</label>
                                <div class="d-flex align-items-center">
                                    <!-- Local Transfer -->
                                    <div class="form-check me-3 transfer-type local">
                                        @Html.RadioButtonFor(m => m.TransferType, "Local", new
                                   {
                                       @id = "transferTypeLocal",
                                       @class = "form-check-input",
                                   })
                                        <label class="form-check-label" for="transferTypeLocal">@GlobalRemittance.LocalTransfer</label>
                                    </div>

                                    <!-- Incoming International Transfer -->
                                    <div class="form-check me-3 transfer-type international">
                                        @Html.RadioButtonFor(m => m.TransferType, "Incoming_International", new
                                   {
                                       @id = "transferTypeIncoming",
                                       @class = "form-check-input",
                                   })
                                        <label class="form-check-label" for="transferTypeIncoming">@GlobalRemittance.IncomingInternationalTransfer</label>
                                    </div>

                                    <!-- Outgoing International Transfer -->
                                    <div class="form-check transfer-type international">
                                        @Html.RadioButtonFor(m => m.TransferType, "Outgoing_International", new
                                   {
                                       @id = "transferTypeOutgoing",
                                       @class = "form-check-input",
                                   })
                                        <label class="form-check-label" for="transferTypeOutgoing">@GlobalRemittance.OutgoingInternationalTransfer</label>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.TransferType, "", new { @class = "text-danger" })
                            </div>

                            <!-- Remittance Type -->
                            <div class="col-md-9 mt-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.RemittanceType, new SelectList(ViewBag.RemittanceTypes, "AccountType", "AccountType"), "---"+ @GlobalRemittance.SelectRemittanceType + "---", new { @class = "form-control select2", @search = "true", @id = "RemittanceTypeId", @onchange = "GetAccountNumber(this.value)" })
                                    @Html.ValidationMessageFor(m => m.RemittanceType, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.RemittanceType</label>
                                </div>
                            </div>

                            <!-- Account Number -->
                            <div class="col-md-3 mt-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control", placeholder = "Account Number", @id = "AccountNumberId", @readonly = true })
                                    @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger" })
                                    <label id="AccountName">@GlobalRemittance.AccountNumber</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <!-- Sender Information Section -->
        <div class="accordion-item  mt-2">
            <h2 class="accordion-header" id="senderInfoHeader">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#senderInfo" aria-expanded="false" aria-controls="senderInfo">
                    @GlobalRemittance.SenderInformation
                </button>
            </h2>
            <div id="senderInfo" class="accordion-collapse collapse" aria-labelledby="senderInfoHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <!-- Help Note -->
                    <div class="mb-3">
                        <p class="text-muted">
                            @GlobalRemittance.ThisSectionCapturesDetailsAboutTheSenderOfTheRemittance
                            @GlobalRemittance.TheTransactionIsSecurelyProcessedAndCompliesWithNecessaryIdentificationRequirements.
                        </p>
                    </div>
                    <fieldset class="fieldset-custom mb-4">
                        <legend class="text-black">@GlobalRemittance.SenderInformation</legend>
                        <div class="row mt-2 gy-4">
                            <!-- Sender Name -->
                            <div class="col-md-5">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderName, new { @class = "form-control", placeholder = @GlobalRemittance.SenderName })
                                    @Html.ValidationMessageFor(m => m.SenderName, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderName</label>
                                </div>
                            </div>

                            <!-- Sender Phone Number -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderPhoneNumber, new { @class = "form-control", placeholder = @GlobalRemittance.SenderPhoneNumber })
                                    @Html.ValidationMessageFor(m => m.SenderPhoneNumber, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderPhoneNumber</label>
                                </div>
                            </div>

                            <!-- Sender CNI -->
                            <div class="col-md-4">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderCNI, new { @class = "form-control", placeholder = @GlobalRemittance.SenderNationalIdentityCardInformation })
                                    @Html.ValidationMessageFor(m => m.SenderCNI, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderCNI</label>
                                </div>
                            </div>

                            <!-- Date of Issue -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.DateOfIssue, new { @class = "form-control", @type = "date", placeholder = @GlobalRemittance.DateOfIssue })
                                    @Html.ValidationMessageFor(m => m.DateOfIssue, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.DateOfIssue</label>
                                </div>
                            </div>

                            <!-- Expiry Date -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.ExpirationDate, new { @class = "form-control", @type = "date", placeholder = @GlobalRemittance.ExpiryDate })
                                    @Html.ValidationMessageFor(m => m.ExpirationDate, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.ExpiryDate</label>
                                </div>
                            </div>

                            <!-- Place of Issue -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.PlaceOfIssue, new { @class = "form-control", placeholder = @GlobalRemittance.PlaceOfIssue })
                                    @Html.ValidationMessageFor(m => m.PlaceOfIssue, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.PlaceOfIssue</label>
                                </div>
                            </div>

                            <!-- Sender Secret Code -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderSecreteCode, new { @class = "form-control", placeholder = @GlobalRemittance.WithdrawalSecretCode })
                                    @Html.ValidationMessageFor(m => m.SenderSecreteCode, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SecretCode</label>
                                </div>
                            </div>

                            <!-- Sender Address -->
                            <div class="col-md-9">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderAddress, new { @class = "form-control", placeholder = @GlobalRemittance.SenderAddress })
                                    @Html.ValidationMessageFor(m => m.SenderAddress, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderAddress</label>
                                </div>
                            </div>

                            <!-- Sender Country -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.SenderCountry, new { @class = "form-control", placeholder = @GlobalRemittance.SenderCountry })
                                    @Html.ValidationMessageFor(m => m.SenderCountry, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderCountry</label>
                                </div>
                            </div>

                            <!-- Sender Note -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextAreaFor(m => m.SenderNote, new { @class = "form-control", @style = "height: 150px;" })
                                    @Html.ValidationMessageFor(m => m.SenderNote, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SenderNoteIoTheReceiver</label>
                                </div>
                            </div>

                            <!-- Receiver SMS Checkbox -->
                            <div class="col-md-12 mt-3">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.SendSMSTotReceiver, new { @class = "form-check-input", @id = "sendSmsToReceiver" })
                                    <label class="form-check-label" for="sendSmsToReceiver">
                                        @GlobalRemittance.SendSMSNotificationToReceiver
                                    </label>
                                </div>
                                @Html.ValidationMessageFor(m => m.SendSMSTotReceiver, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </fieldset>


                </div>
            </div>
        </div>

        <!-- Receiver Information Section -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="receiverInfoHeader">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#receiverInfo" aria-expanded="true" aria-controls="receiverInfo">
                    @GlobalRemittance.ReceiverInformation
                </button>
            </h2>
            <div id="receiverInfo" class="accordion-collapse collapse" aria-labelledby="receiverInfoHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <!-- Help Note -->
                    <div class="mb-3">
                        <p class="text-muted">
                            @GlobalRemittance.ThisSectionCapturesEssentialDetails
                            @GlobalRemittance.canSecurelyCollectTheFunds.
                        </p>
                    </div>
                    <fieldset class="fieldset-custom mb-4">
                        <legend class="text-black">@GlobalRemittance.ReceiverInformation</legend>
                        <div class="row mt-2 gy-4">
                            <!-- Receiver Name -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.ReceiverName, new { @class = "form-control", placeholder = @GlobalRemittance.ReceiverName })
                                    @Html.ValidationMessageFor(m => m.ReceiverName, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.ReceiverName</label>
                                </div>
                            </div>
                            <!-- Receiver Phone Number -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.ReceiverPhoneNumber, new { @class = "form-control", placeholder = @GlobalRemittance.ReceiverPhoneNumber })
                                    @Html.ValidationMessageFor(m => m.ReceiverPhoneNumber, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.ReceiverPhoneNumber</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.ReceiverLanguage, new SelectList(ViewBag.Languages, "Value", "Text"), "---"+ @GlobalRemittance.SelectLanguage+"---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.ReceiverLanguage, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.SelectReceiverPreferredLanguageForSMS</label>
                                </div>
                            </div>
                            <!-- Sender Country -->
                            <div class="col-md-5">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.ReceiverCountry, new { @class = "form-control", placeholder = @GlobalRemittance.ReceiverCountry })
                                    @Html.ValidationMessageFor(m => m.ReceiverCountry, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.ReceiverCountry</label>
                                </div>
                            </div>
                            <!-- Receiver Address -->
                            <div class="col-md-7">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.ReceiverAddress, new { @class = "form-control", placeholder = @GlobalRemittance.ReceiverAddress })
                                    @Html.ValidationMessageFor(m => m.ReceiverAddress, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.ReceiverAddress</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <!-- Charges Section -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="chargesSectionHeader">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#chargesSection" aria-expanded="false" aria-controls="chargesSection">
                    @GlobalRemittance.ChargesSection
                </button>
            </h2>
            <div id="chargesSection" class="accordion-collapse collapse" aria-labelledby="chargesSectionHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <!-- Help Note -->
                    <div class="mb-3">
                        <p class="text-muted">
                            @GlobalRemittance.ThisSectionOutlinesTheChargesAssociatedWithTheRemittanceTransaction,
                            @GlobalRemittance.andReviewTheCalculatedFinalAmounts.
                        </p>
                        <p class="text-muted">
                            <strong>@GlobalRemittance.InclusiveCharges:</strong> @GlobalRemittance.TheChargesAreIncludedInTheSpecifiedAmount,
                            @GlobalRemittance.andTheReceiversAmountIsReducedByTheApplicableCharges.
                        </p>
                        <p class="text-muted">
                            <strong>@GlobalRemittance.ExclusiveCharges:</strong> @GlobalRemittance.TheChargesAreAddedOnTopOfTheSpecifiedAmount
                            @GlobalRemittance.plusTheChargesWhileTheReceiversAmountRemains.
                        </p>
                    </div>
                    <fieldset class="fieldset-custom mb-4">
                        <legend class="text-black">@GlobalRemittance.ChargesSection</legend>
                        <div class="row gy-4">
                            <!-- Initial Amount -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.InitailAmount, new { @class = "form-control", @id = "initialAmount", type = "number", step = "0.01", placeholder = @GlobalRemittance.Amount })
                                    @Html.ValidationMessageFor(m => m.InitailAmount, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.EnterAmountToTransfer</label>
                                </div>
                            </div>

                            <!-- Final Amount -->
                            <div class="col-md-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", @id = "AmountId", type = "number", step = "0.01", placeholder = @GlobalRemittance.Amount, ReadOnly = true })
                                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.FinalAmountToTransfer</label>
                                </div>
                            </div>

                            <!-- Charges -->
                            <div class="col-md-2">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.Fee, new { @class = "form-control", @id = "FeeId", placeholder = @GlobalRemittance.RemittanceCharge, ReadOnly = true })
                                    @Html.ValidationMessageFor(m => m.Fee, "", new { @class = "text-danger" })
                                    <label>@GlobalRemittance.Charges</label>
                                </div>
                            </div>

                            <!-- Charge Type Radio Buttons -->
                            <div class="col-md-4">
                                <label class="form-label">@GlobalRemittance.ChargeType</label>
                                <div class="d-flex align-items-center">
                                    <div class="form-check me-3">
                                        @Html.RadioButtonFor(m => m.ChargeType, "Inclussive", new
                                   {
                                       @id = "chargeTypeInclusive",
                                       @class = "form-check-input",
                                       @onchange = "GetRemittanceCharge()"
                                   })
                                        <label class="form-check-label" for="chargeTypeInclusive"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="@GlobalRemittance.InclusiveChargesAreIncludedInTheFinalAmount.">
                                            @GlobalRemittance.Inclusive
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        @Html.RadioButtonFor(m => m.ChargeType, "Exclussive", new
                                   {
                                       @id = "chargeTypeExclusive",
                                       @class = "form-check-input",
                                       @onchange = "GetRemittanceCharge()"
                                   })
                                        <label class="form-check-label" for="chargeTypeExclusive"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="@GlobalRemittance.ExclusiveChargesAreAddedOnTopOfTheSpecifiedAmount.">
                                            @GlobalRemittance.Exclusive
                                        </label>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.ChargeType, "", new { @class = "text-danger" })
                            </div>

                            <!-- Button to Get Charges -->
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" id="getChargesBtn" class="btn btn-primary" onclick="GetRemittanceCharge()">@GlobalRemittance.ComputeCharges</button>
                            </div>
                        </div>

                        <!-- Charges Display Section -->
                        <div class="mt-4">
                            <div class="table-responsive mb-3" style="display: none;" id="chargesdiv">
                                <table class="table table-hover table-bordered table-sm" id="myDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalRemittance.RemittanceType</th>
                                            <th>@GlobalRemittance.INITAmount</th>
                                            <th>@GlobalRemittance.ReceiverAmount</th>
                                            <th>@GlobalRemittance.ServiceCharge</th>
                                            <th>@GlobalRemittance.Value</th>
                                            <th>@GlobalRemittance.FeeType</th>
                                            <th>@GlobalRemittance.Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td id="remittanceType"></td>
                                            <td id="initalAmountvalue"></td>
                                            <td id="amountValue"></td>
                                            <td id="serviceCharge"></td>
                                            <td id="percentageValue"></td>
                                            <td id="feeType"></td>
                                            <td id="totalCharges"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Transaction Summary -->
                            <div id="transactionSummary"></div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="accordion-item  mt-2">
            <h2 class="accordion-header" id="submitButtonHeader">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#submitButton" aria-expanded="false" aria-controls="submitButton">
                    @GlobalShared.Submit
                </button>
            </h2>
            <div id="submitButton" class="accordion-collapse collapse" aria-labelledby="submitButtonHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <div class="mt-4 text-center">
                        <button type="submit" id="btnSave" class="btn btn-primary px-5">@GlobalShared.Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


