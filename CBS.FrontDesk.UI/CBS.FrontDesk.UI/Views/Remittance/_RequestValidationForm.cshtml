@model CBS.FrontDesk.Data.Entity.SavingProducts.ValidationOfRemittanceCommand
@using Resources
@{
    var totalAmountPayable = Model.Remittance.Amount + Model.Remittance.Fee;
    var totalAmountRecevable = Model.Remittance.Amount;
}

@using (Html.BeginForm("Validate", "Remittance", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.HiddenFor(model => model.Id)

    <div class="accordion" id="remittanceAccordion">
        <!-- Remittance Details Section -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="remittanceDetailsHeader">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#remittanceDetails" aria-expanded="true" aria-controls="remittanceDetails">
                    @GlobalRemittance.RemittanceDetails
                </button>
            </h2>
            <div id="remittanceDetails" class="accordion-collapse collapse show" aria-labelledby="remittanceDetailsHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <fieldset class="fieldset-custom">
                        <legend id="select_base">@GlobalRemittance.RemittanceDetails</legend>
                        <div class="mb-4">
                            <hr>
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>@GlobalRemittance.Date:</strong> @Model.Remittance.InitiationDate</p>
                                    <p><strong>@GlobalRemittance.Sender:</strong> @Model.Remittance.SenderName, [Tel: @Model.Remittance.SenderPhoneNumber]</p>
                                    <p><strong>@GlobalRemittance.Receiver:</strong> @Model.Remittance.ReceiverName, [Tel: @Model.Remittance.ReceiverPhoneNumber]</p>
                                    <p><strong>@GlobalRemittance.InitialAmount:</strong> @Model.Remittance.InitailAmount.ToString("#,##0.0")</p>
                                    <p><strong>@GlobalRemittance.Reference:</strong> @Model.Remittance.TransactionReference</p>
                                    <p>
                                        <strong>@GlobalRemittance.ChargeStatus:</strong>
                                        @if (Model.Remittance.ChargeType == "Inclussive")
                                        {
                                            <span class="badge bg-dark text-white">@GlobalRemittance.ChargeIncludedInAmount</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark text-white">@GlobalRemittance.ChargeExcludedFromAmount</span>
                                        }
                                    </p>
                                    <p><strong>@GlobalRemittance.TransferSource:</strong> @Model.Remittance.TransfterSource</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>@GlobalRemittance.RequestedAmount:</strong> @Model.Remittance.InitailAmount.ToString("#,##0.0")</p>
                                    <p><strong>@GlobalRemittance.InitiatingBranch:</strong> @Model.Remittance.SourceBranchName</p>
                                    <p><strong>@GlobalRemittance.Charges:</strong> @Model.Remittance.Fee.ToString("#,##0.0")</p>
                                    <p>
                                        <strong>@GlobalRemittance.TotalAmountToBePaidBySender:</strong>
                                        <span class="text-success">@totalAmountPayable.ToString("#,##0.0")</span>
                                    </p>
                                    <p>
                                        <strong>@GlobalRemittance.AmountToBeReceivedByReceiver:</strong>
                                        <span class="text-info">@totalAmountRecevable.ToString("#,##0.0")</span>
                                    </p>
                                    <p><strong>@GlobalRemittance.TransferType:</strong> @Model.Remittance.TransferType</p>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <!-- Review and Approve Form Section -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="reviewApproveFormHeader">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reviewApproveForm" aria-expanded="false" aria-controls="reviewApproveForm">
                    @GlobalRemittance.ReviewAndApproveForm
                </button>
            </h2>
            <div id="reviewApproveForm" class="accordion-collapse collapse" aria-labelledby="reviewApproveFormHeader" data-bs-parent="#remittanceAccordion">
                <div class="accordion-body">
                    <fieldset class="fieldset-custom mt-4">
                        <legend id="select_base">@GlobalRemittance.ReviewAndApproveForm</legend>
                        <hr>
                        <div class="row mt-2 gy-4">
                            <!-- Status Radio Buttons -->
                            <div class="col-md-12">
                                <div class="d-flex align-items-center">
                                    <div class="form-check me-3">
                                        @Html.RadioButtonFor(m => m.Status, "Approved", new { @id = "statusApproved", @class = "form-check-input", @checked = "checked" })
                                        <label class="form-check-label" for="statusApproved">@GlobalShared.Approved</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.RadioButtonFor(m => m.Status, "Rejected", new { @id = "statusRejected", @class = "form-check-input" })
                                        <label class="form-check-label" for="statusRejected">@GlobalShared.Rejected</label>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                            </div>

                            <!-- Approval Comment -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextAreaFor(m => m.ApprovalComment, new { @class = "form-control", @style = "height: 70px;" })
                                    @Html.ValidationMessageFor(m => m.ApprovalComment, "", new { @class = "text-danger" })
                                    <label for="formValidationDob">@GlobalRemittance.ApprovalNote</label>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="mt-4 text-center">
                            <button type="submit" id="btnSave" class="btn btn-primary px-5">@GlobalShared.Submit</button>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
}
