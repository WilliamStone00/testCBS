<!-- ✅ FINAL CLEAN VERSION -->
@using Resources
<div id="translationTableContainer" class="card p-3 shadow mb-4">
    <div class="table-responsive mb-4">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>@GlobalMenuTranslation.Menu</th>
                    <th>@GlobalMenuTranslation.OriginalDescription</th>
                    <th>@GlobalMenuTranslation.TranslatedText</th>
                    <th>@GlobalMenuTranslation.TranslatedDescription</th>
                </tr>
            </thead>
            <tbody id="translationTableBody">
                <!-- Populated by renderTranslationTable() -->
            </tbody>
        </table>
    </div>
    <button class="btn btn-primary mt-3" onclick="submitMenuTranslations()">
        <i class="mdi mdi-content-save me-1"></i> @GlobalMenuTranslation.SubmitTranslations
    </button>
</div>
