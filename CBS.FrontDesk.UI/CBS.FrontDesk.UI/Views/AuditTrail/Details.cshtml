@model CBS.FrontDesk.Data.Entity.AuditTralP.AuditTrailDto
@using Resources
@{
    ViewBag.Title = @GlobalAuditTrail.AuditTrailDetails;
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-history me-2"></i> @GlobalAuditTrail.AuditTrailDetails
                </h1>
                <p class="card-text">
                    @GlobalAuditTrail.ReviewTheDetailsOfTheSelectedAuditLog.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalAuditTrail.IMPORTANTTIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalAuditTrail.ReviewKeyDetailsIncludingUserActions.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalAuditTrail.UseThe <strong>@GlobalAuditTrail.Copy</strong> @GlobalAuditTrail.ButtonToCopyLogInformation.</li>
                <li><i class="mdi mdi-account-outline text-primary me-2"></i> @GlobalAuditTrail.ConfirmTheUserWhoPerformedTheAction.</li>
                <li><i class="mdi mdi-security-network text-danger me-2"></i> @GlobalAuditTrail.HandleSensitiveDataWithCaution.</li>
                <li><i class="mdi mdi-shield-check-outline text-warning me-2"></i> @GlobalAuditTrail.AuditEntriesInvolvingCriticalOperations.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalAuditTrail.TheCorrelationIDCanBeUseful.</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="text-primary">@GlobalAuditTrail.AuditInformation</h5>
        <div class="table-responsive mb-3">
            <table class="table table-bordered table-striped">
                <tbody>
                    <!-- General Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">@GlobalAuditTrail.GeneralInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.ID:</td>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.Action:</td>
                        <td>@Model.Action</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.Timestamp:</td>
                        <td>@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.UserName:</td>
                        <td>@Model.UserName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.FullName:</td>
                        <td>@Model.FullName</td>
                    </tr>

                    <!-- Network Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">@GlobalAuditTrail.NetworkInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.IPAddress:</td>
                        <td>@Model.IPAddress</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.StatusCode:</td>
                        <td>@Model.StatusCode</td>
                    </tr>

                    <!-- Microservice Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">Microservice Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.MicroserviceName:</td>
                        <td>@Model.MicroServiceName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.Level:</td>
                        <td>
                            @if (Model.Level == "Information")
                            {
                                <span class="badge bg-info text-dark">
                                    <i class="mdi mdi-information-outline me-1"></i> @GlobalAuditTrail.Information
                                </span>
                            }
                            else if (Model.Level == "Warning")
                            {
                        <span class="badge bg-warning text-dark">
                            <i class="mdi mdi-alert-outline me-1"></i> @GlobalAuditTrail.Warning
                        </span>
                            }
                            else if (Model.Level == "Error")
                            {
                        <span class="badge bg-danger text-white">
                            <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalAuditTrail.Error
                        </span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">
                            <i class="mdi mdi-help-circle-outline me-1"></i> @GlobalAuditTrail.Unknown
                        </span>
                            }
                        </td>
                    </tr>


                    <!-- Branch Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">@GlobalAuditTrail.BranchInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.BranchID:</td>
                        <td>@Model.BranchID</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.BranchName:</td>
                        <td>@Model.BranchName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.BranchCode:</td>
                        <td>@Model.BranchCode</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.BankID:</td>
                        <td>@Model.BankID</td>
                    </tr>

                    <!-- Correlation Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">@GlobalAuditTrail.CorrelationInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.CorrelationID:</td>
                        <td>@Model.CorrolationId</td>
                    </tr>

                    <!-- Entity Affected -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-uppercase text-start">@GlobalAuditTrail.EntityAffected</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.StringifiedObject:</td>
                        <td>
                            <div class="d-flex align-items-start">
                                <button class="btn btn-sm btn-secondary me-2" onclick="copyToClipboard('stringifiedObject')">
                                    <i class="mdi mdi-content-copy"></i> @GlobalAuditTrail.Copy
                                </button>
                                <pre id="stringifiedObject" class="bg-light p-2 rounded w-100" style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word;">@Model.StringifyObject</pre>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalAuditTrail.DetailMessage:</td>
                        <td>
                            <div class="d-flex align-items-start">
                                <button class="btn btn-sm btn-secondary me-2" onclick="copyToClipboard('detailMessage')">
                                    <i class="mdi mdi-content-copy"></i> Copy
                                </button>
                                <pre id="detailMessage" class="bg-light p-2 rounded w-100" style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word;">@Model.DetailMessage</pre>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="text-center mt-4">
                <a class="btn btn-primary" href="/AuditTrail">
                    <i class="mdi mdi-arrow-left"></i> @GlobalAuditTrail.Back
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(elementId) {
        const content = document.getElementById(elementId).innerText;
        navigator.clipboard.writeText(content).then(() => {
            alert("Copied to clipboard!");
        }).catch(err => {
            console.error('Error copying text: ', err);
        });
    }
</script>
