@model CBS.FrontDesk.Data.Entity.VaultManagement.Vault
@{
    ViewBag.Title = "Vault Initialization";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> Vault Initialization
                </h1>
                <p class="card-text text-muted">
                    Manage the initialization process of the vault efficiently. Ensure all details are accurate for proper setup.
                </p>
                <p class="card-text text-danger fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    Vault initialization is a critical step, especially after system migration, to align the trial balance and reconcile the cash in hand before operations can begin. Double-check all input values for accuracy.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                Vault initialization ensures accurate records of cash and denominations at the start of operations, aligning with the trial balance post-migration. Follow these tips:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure all denominations are accurately entered.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Verify that totals match the expected amounts in the vault.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> If the <strong>Initialize Vault button is greyed out</strong>, it indicates mismatched values or missing information.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Ensure the vault balance reflects the physical cash available and aligns with the trial balance.</li>
            </ul>
            <p class="text-muted">For example:</p>
            <ul class="list-unstyled">
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> If you have 5 notes of N10,000, enter "5" under the N10,000 field.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> The system will automatically calculate the total for all denominations.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            Vault Initialization
                        </button>
                    </h2>
                   
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div class="accordion-body">
                                <div id="mainviewChange">
                                    <div class="card mb-1">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" onclick="LoadDataGen('Vault','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                                <i class="mdi mdi-view-list mdi-18px"></i> View List
                                            </a>
                                            <a type="button" href="" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Initialise the vault of this branch">
                                                <i class="fas fa-cogs me-1"></i> Initialize
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_VaultInitializationForm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("VaultInitialization", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
