<script>
    // Function to calculate the total amount and update the relevant fields
    function calculateTotalAmount() {
        // Example: Get cash-in-vault and cash-in-hand values (replace with your actual inputs)
        const cashInVault = parseFloat(document.getElementById('AmountInVault').value) || 0;
        const cashInHand = parseFloat(document.getElementById('AmountInHand').value) || 0;

        // Calculate total amount
        const totalAmount = cashInVault + cashInHand;

        // Format total amount to currency XAF
        const formattedAmount = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'XAF' }).format(totalAmount);

        // Update the spans and hidden input fields
        document.getElementById('balanceBroughtForward').innerText = `Balance Brought Forward: ${formattedAmount}`;
        document.getElementById('lblDepositRequest_amount').innerText = `Total amount: ${formattedAmount}`;
        document.getElementById('lblBalance').innerText = `Balance: ${formattedAmount}`;
        document.getElementById('totalNoteAmount').value = totalAmount.toFixed(2);
        document.getElementById('totalProvision').value = totalAmount.toFixed(2);

        // Update the Total Amount field
        document.getElementById('TotalAmount').value = totalAmount.toFixed(2);
    }
</script>
<script type="text/javascript">
    function formatXaf(amount) {
        if (amount == null || isNaN(amount)) return "0";
        return Number(amount).toLocaleString("en-US", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        });
    }
    // ✅ Define this so calls to resetVaultFields() work
    function resetVaultFields() {
        $('#AmountInHand').val(0);
        $('#AmountInVault').val(0);
        $('#TotalAmount').val(0);

        $('#balanceBroughtForward').text('@GlobalVault.BalanceBroughtForward: 0 XAF');
        $('#lblBalance').text('@GlobalVault.Balance: 0 XAF');

        $('#canProceedCheckbox')
            .prop('checked', false)
            .prop('disabled', true); // keep greyed out
    }
    function fetchVaultBalances(branchId) {
        if (!branchId) {
            resetVaultFields();
            return;
        }

        $.ajax({
            url: '@Url.Action("GetVaultBalances", "Vault")',
            type: 'GET',
            data: { branchId: branchId },
            success: function (res) {
                console.log("Vault balances response:", res); // 👈 helps debug

                if (!res || !res.success) {
                    resetVaultFields();
                    var msg = (res && res.message) ? res.message : "Unable to load vault balances.";
                    if (typeof appalert === "function") {
                        appalert(msg, 3, 1);
                    } else {
                        alert(msg);
                    }
                    return;
                }

                // ⚠️ Make sure these match your JSON exactly:
                // e.g. if API returns AmountInHand, use res.amountInHand instead.
                var cashInHand = Number(res.cashInHandBalance  || 0);
                var cashInVault = Number(res.cashInVaultBalance || 0);

                var total = cashInHand + cashInVault;

                // --- 3) Red boxes ---
                $('#AmountInHand').val(cashInHand);
                $('#AmountInVault').val(cashInVault);
                $('#TotalAmount').val(total); // raw number for posting

                // --- 4) Circled labels ---
                $('#balanceBroughtForward').text(
                    '@GlobalVault.BalanceBroughtForward: ' + formatXaf(total) + ' XAF'
                );

                $('#lblBalance').text(
                    '@GlobalVault.Balance: ' + formatXaf(total) + ' XAF'
                );

                // --- 5) Hidden block updates ---
                $('#lblDepositRequest_amount').text(
                    '@GlobalVault.TotalAmount: ' + formatXaf(total)
                );

                $('#totalNoteAmount').val(total);   // raw number
                $('#totalProvision').val(total);    // raw number

                $('#canProceedCheckbox')
                    .prop('checked', false)
                    .prop('disabled', true);
            },
            error: function () {
                resetVaultFields();
                if (typeof appalert === "function") {
                    appalert("Technical error while loading vault balances.", 3, 1);
                } else {
                    alert("Technical error while loading vault balances.");
                }
            }
        });
    }

    // Optional: auto-load on page load
    $(function () {
        var initialBranchId = $('#BranchId').val();
        if (initialBranchId) {
            fetchVaultBalances(initialBranchId);
        } else {
            resetVaultFields();
        }
    });
</script>
