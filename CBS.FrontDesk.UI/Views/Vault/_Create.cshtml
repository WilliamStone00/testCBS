@model CBS.FrontDesk.Data.Entity.VaultManagement.Vault
@using Resources


<fieldset class="fieldset-custom">
    <legend id="select_base">VAULT</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Vault", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(model => model.AddVaultCommand.Id)

            <div class="row mt-3 gy-3">

                <!-- Branch Selection -->
                <div class="col-md-10">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.AddVaultCommand.BranchId,
                            new SelectList(ViewBag.Branches, "Id", "Name"),
                            "---"+ @GlobalVault.SelectBranch+ "---",
                            new { @class = "form-control select2", id = "BranchId", @search = "true", onchange = "fetchBranchDetails(this.value)" }
                        )
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label for="BranchId">@GlobalVault.SelectBranch</label>
                    </div>
                </div>


                <!-- Branch Code -->
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.BranchCode, new { @class = "form-control", @readonly = "readonly", id = "BranchCode" })
                        <label for="BranchCode">@GlobalVault.BranchCode</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.Name, new { @class = "form-control", id = "VaultName", @readonly = "readonly" })
                        <label for="VaultName">@GlobalVault.VaultName</label>
                    </div>
                </div>

                <!-- Maximum Capacity -->
                <div class="col-md-5">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.MaximumCapacity, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddVaultCommand.MaximumCapacity, "", new { @class = "text-danger" })
                        <label for="MaximumCapacity">@GlobalVault.MaximumCapacity</label>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.Diamention, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddVaultCommand.Diamention, "", new { @class = "text-danger", @placeholder = "3x3 Tall" })
                        <label for="MaximumCapacity">@GlobalVault.Diamention (Example: 3x3 meter tall)</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddVaultCommand.Location, "", new { @class = "text-danger" })
                        <label for="Location">@GlobalVault.LocationCouldJustBeThelocationWhereTheVaultInLocatedInYourOffice</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddVaultCommand.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        <label for="Address">@GlobalVault.Address</label>
                    </div>
                </div>
                <!-- Description -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.AddVaultCommand.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label for="Description">@GlobalVault.Description</label>
                    </div>
                </div>

                <!-- Active Status -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AddVaultCommand.IsActive, new { @class = "form-check-input", id = "isActive" })
                        <label class="form-check-label" for="isActive">@GlobalVault.ActiveStatus</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
            </div>
           
        }
    </div>
</fieldset>

<script>
    // Define a reusable function to fetch branch details
    function fetchBranchDetails(branchId) {
        var branchCodeInput = $('#BranchCode'); // Branch Code field
        var vaultNameInput = $('#VaultName'); // Vault Name field

        if (branchId) {
            // Perform AJAX request to fetch branch details
            $.ajax({
                url: '/Vault/GetBranch', // Controller action to fetch branch details
                type: 'GET',
                data: { Key: branchId }, // Pass the selected Branch ID
                success: function (branch) {
                    if (branch) {
                        // Populate Branch Code and Vault Name
                        branchCodeInput.val(branch.BranchCode);
                        vaultNameInput.val(`${branch.BranchCode}-Vault-${branch.Name}`);
                    } else {
                        // Clear fields if no branch is found
                        branchCodeInput.val('');
                        vaultNameInput.val('');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching branch details:', error);
                    // Clear fields in case of error
                    branchCodeInput.val('');
                    vaultNameInput.val('');
                }
            });
        } else {
            // Clear fields if no branch is selected
            branchCodeInput.val('');
            vaultNameInput.val('');
        }
    }
    function showVaultDetails(vaultId) {
        // Clear the modal content
        $('#vaultDetailsContent').html('<p>Loading...</p>');

        // Load the partial view into the modal
        $.ajax({
            url: '/Vault/GetVaultPartialView',
            type: 'GET',
            data: { Key: vaultId },
            success: function (html) {
                // Load the partial view HTML into the modal content
                $('#vaultDetailsContent').html(html);

                // Show the modal
                $('#vaultDetailsModal').modal('show');
            },
            error: function () {
                $('#vaultDetailsContent').html('<p>Error loading vault details.</p>');
                $('#vaultDetailsModal').modal('show');
            }
        });
    }

</script>


