@using Resources
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateCashOutOrCashInBulkOperation
@{
    ViewBag.Title = @GlobalBulkOperation.SimulateBulkOperation;
}

<div class="accordion mb-4" id="operationParamsAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOperationParams">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOperationParams" aria-expanded="true" aria-controls="collapseOperationParams">
                <i class="mdi mdi-cog-outline me-2"></i> @GlobalBulkOperation.BulkCashOperationParameters
            </button>
        </h2>
        <div id="collapseOperationParams" class="accordion-collapse collapse show" aria-labelledby="headingOperationParams">
            <div class="accordion-body">
                <div class="row g-3">
                    <!-- Branch Dropdown -->
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.BranchId, @GlobalBulkOperation.SelectBranch, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.branches, "Id", "Name"),
                            @GlobalBulkOperation.Branch,
                            new { @class = "form-select select2", required = "required" })
                        <div class="invalid-feedback">Please select a branch</div>
                    </div>
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.AccountCartId, @GlobalBulkOperation.BulkOperationCashOutOrCashInAccount, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.AccountCartId,
                            new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                            @GlobalBulkOperation.SelectAccount,
                            new { @class = "form-select select2", required = "required" })
                        <div class="invalid-feedback">Please select a destination account</div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.TransferType, @GlobalBulkOperation.SelectOperationType, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TransferType,
                            new SelectList(ViewBag.transferType, "Text", "Value"),
                            @GlobalBulkOperation.SelectOperationType,
                            new { @class = "form-select select2", required = "required" })
                        <div class="invalid-feedback">Please select an operation type</div>
                    </div>

                    <div class="col-md-6">
                        @*  <div class="form-floating form-floating-outline position-relative">*@
                        @Html.LabelFor(m => m.AccountDate, @GlobalBulkOperation.SelectAccountingDate, new { @class = "form-label" })
                        @Html.TextBoxFor(
                          m => m.AccountDate,
                          Model.AccountDate == default(DateTime)
                            ? DateTime.Today.ToString("yyyy-MM-dd")
                            : "{0:yyyy-MM-dd}",
                          new
                              {
                            @class = "form-control accounting-date",
                            type = "date",
                            data_date_default = "today",   // auto-fill today if empty/MinValue
                            data_date_max = "today"        // prevent future dates (remove if not needed)
                            // data_date_min = "today"     // uncomment to only allow today & after
                          })
                        <div class="invalid-feedback">Please select a valid accounting date</div>
                        @*   @Html.ValidationMessageFor(m => m.AccountDate, "", new { @class = "text-danger" })*@
                        @*   <label>@(Member_Global_LoanApplication.AccountingDate ?? "Accounting Date")</label>*@
                        @* </div>*@
                        @* <small class="text-muted">
            This date will be used as the accounting date for posting and audit.
            Choose a past date to backdate (if permitted).
        </small>*@
                    </div>

                    <!-- Title Field -->
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.OperationTitle, "Operation Title", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.OperationTitle,
                            new
                                 {
                                     @class = "form-control",
                                  required = "required",
                                  placeholder = "Enter operation title"
                                 })
                        <div class="invalid-feedback">Please enter a title for the operation</div>
                    </div>

                    <!-- Simulation Description -->
                    <div class="col-6">
                        @Html.LabelFor(m => m.SimulationDescription, "Simulation Description", new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.SimulationDescription,
                            new
                                 {
                                     @class = "form-control",
                                  rows = "3",
                                  placeholder = "Enter simulation details or notes"
                                 })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
