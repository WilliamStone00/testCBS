@model CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationDataDetails
@using Resources

<style>
    .transfer-details-container {
        font-size: 0.95rem;
    }

    .card-header {
        padding: 0.75rem 1.25rem;
    }

    .detail-item {
        margin-bottom: 0.8rem;
    }

    .detail-label {
        display: block;
        color: #6c757d;
        font-size: 0.85rem;
    }

    .detail-value {
        display: block;
        color: #212529;
        font-size: 1rem;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.35rem 0.5rem;
    }
</style>




<div class="transfer-details-container">
    <!-- Member Information Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-account-circle-outline me-2"></i>@GlobalBulkOperation.MemberInformation
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.MemberName:</span>
                        <span class="detail-value fw-semibold">@(Model.MemberName ?? "N/A")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.MemberReference:</span>
                        <span class="detail-value">@(Model.MemberReference ?? "N/A")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.Branch:</span>
                        <span class="detail-value">@(Model.BranchName ?? "N/A") <small>(@(Model.BranchCode ?? "N/A"))</small></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accounts Section -->
    <div class="row mb-4">
        <!-- Source Account -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="mdi mdi-bank-remove me-2 text-danger"></i>@GlobalBulkOperation.SourceAccount
                    </h5>
                </div>
                <div class="card-body">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.AccountNumber:</span>
                        <span class="detail-value">@(Model.SourceAccountNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.AccountType:</span>
                        <span class="detail-value">@(Model.SourceAccountType ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.CurrentBalance:</span>
                        <span class="detail-value fw-bold">@Model.SourceAccountBalance</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Destination Account -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="mdi mdi-bank-plus me-2 text-success"></i>@GlobalBulkOperation.DestinationAccount
                    </h5>
                </div>
                <div class="card-body">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.AccountNumber:</span>
                        <span class="detail-value">@(Model.DestinationAccountNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.AccountType:</span>
                        <span class="detail-value">@(Model.DestinationAccountType ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.CurrentBalance:</span>
                        <span class="detail-value fw-bold">@Model.DestinationBalance</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transfer Details Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-swap-horizontal me-2 text-primary"></i>@GlobalBulkOperation.TransferDetails
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.Amount:</span>
                        <span class="detail-value fw-bold text-primary">@Model.AmountToDebit</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.Status:</span>
                        <span class="detail-value badge bg-@(Model.TransferStatus == "Completed" ? "success" : "warning")">
                            @(Model.TransferStatus ?? "Not Started")
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.TransferDate:</span>
                        <span class="detail-value">@Model.TransferDate.ToLocalTime().ToString("g")</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.ApprovalStatus:</span>
                        <span class="detail-value badge bg-@(Model.ApprovalStatus == "Approved" ? "success" : "warning")">
                            @(Model.ApprovalStatus ?? "N/A")
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">Approval Date:</span>
                        <span class="detail-value">@Model.ApprovalDate.ToLocalTime().ToString("g")</span>
                    </div>
                </div>

            </div>
            @if (string.IsNullOrWhiteSpace(Model.TransferMessage) || !Model.TransferMessage.ToLower().Contains("success"))
            {
                <div class="alert alert-danger mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>@GlobalBulkOperation.Error:</strong> @Model.TransferMessage
                </div>
            }
            else
            {
                <div class="alert alert-primary mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>@GlobalBulkOperation.Success:</strong> @Model.TransferMessage
                </div>
            }
        </div>
    </div>

    <!-- Balance Information Card -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-scale-balance me-2 text-info"></i>@GlobalBulkOperation.BalanceInformation
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.TotalBalance:</span>
                        <span class="detail-value fw-bold">@Model.TotalBalance</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">@GlobalBulkOperation.NetBalance:</span>
                        <span class="detail-value fw-bold">@Model.NetBalance</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

