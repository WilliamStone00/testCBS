@model CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationDataDetails

<div class="transfer-details-container">
    <!-- Member Information Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-account-circle-outline me-2"></i>Member Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">Member Name:</span>
                        <span class="detail-value fw-semibold">@(Model.MemberName ?? "N/A")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">Member Reference:</span>
                        <span class="detail-value">@(Model.MemberReference ?? "N/A")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <span class="detail-label">Branch:</span>
                        <span class="detail-value">@(Model.BranchName ?? "N/A") <small>(@(Model.BranchCode ?? "N/A"))</small></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accounts Section -->
    <div class="row mb-4">
        <!-- Source Account -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="mdi mdi-bank-remove me-2 text-danger"></i>Source Account
                    </h5>
                </div>
                <div class="card-body">
                    <div class="detail-item">
                        <span class="detail-label">Account Number:</span>
                        <span class="detail-value">@(Model.SourceAccountNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Account Type:</span>
                        <span class="detail-value">@(Model.SourceAccountType ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Current Balance:</span>
                        <span class="detail-value fw-bold">@Model.SourceAccountBalance</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Destination Account -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="mdi mdi-bank-plus me-2 text-success"></i>Destination Account
                    </h5>
                </div>
                <div class="card-body">
                    <div class="detail-item">
                        <span class="detail-label">Account Number:</span>
                        <span class="detail-value">@(Model.DestinationAccountNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Account Type:</span>
                        <span class="detail-value">@(Model.DestinationAccountType ?? "N/A")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Current Balance:</span>
                        <span class="detail-value fw-bold">@Model.DestinationBalance</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transfer Details Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-swap-horizontal me-2 text-primary"></i>Transfer Details
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="detail-item">
                        <span class="detail-label">Amount:</span>
                        <span class="detail-value fw-bold text-primary">@Model.AmountToDebit</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="detail-item">
                        <span class="detail-label">Status:</span>
                        <span class="detail-value badge bg-@(Model.TransferStatus == "Completed" ? "success" : "warning")">
                            @(Model.TransferStatus ?? "N/A")
                        </span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="detail-item">
                        <span class="detail-label">Transfer Date:</span>
                        <span class="detail-value">@Model.TransferDate.ToLocalTime().ToString("g")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="detail-item">
                        <span class="detail-label">Approval Status:</span>
                        <span class="detail-value badge bg-@(Model.ApprovalStatus == "Approved" ? "success" : "warning")">
                            @(Model.ApprovalStatus ?? "N/A")
                        </span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.TransferErrorMessage))
            {
                <div class="alert alert-danger mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>Error:</strong> @Model.TransferErrorMessage
                </div>
            }
        </div>
    </div>

    <!-- Balance Information Card -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-scale-balance me-2 text-info"></i>Balance Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">Total Balance:</span>
                        <span class="detail-value fw-bold">@Model.TotalBalance</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">Net Balance:</span>
                        <span class="detail-value fw-bold">@Model.NetBalance</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transfer-details-container {
        font-size: 0.95rem;
    }

    .card-header {
        padding: 0.75rem 1.25rem;
    }

    .detail-item {
        margin-bottom: 0.8rem;
    }

    .detail-label {
        display: block;
        color: #6c757d;
        font-size: 0.85rem;
    }

    .detail-value {
        display: block;
        color: #212529;
        font-size: 1rem;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.35rem 0.5rem;
    }
</style>
