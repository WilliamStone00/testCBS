
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateBulkOperation

<div class="card-body">
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                @Html.LabelFor(m => m.SourceAccountType, "Destination Account Type", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.SourceAccountType,
                    new SelectList(Model.SavingProducts, "Id", "Name"),
                    "Select Account Type",
                    new { @class = "form-select" })
            </div>
            <div class="col-md-12">
                <div class="mb-3">
                    @Html.LabelFor(m => m.TargetAmount, "Target Account Balance", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TargetAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
        </div>

    </div>
    
</div>
