@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateBulkOperation
    @using Resources

    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountType,Model.BulkOperationSelectionModel.SelectedOperationType=="unique" ? @GlobalBulkOperation.SimulationContributionSourceAccountType : @GlobalBulkOperation.SimulationTopupSourceAccountType, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.SourceAccountType,
                        new SelectList(Model.SavingProducts, "Name", "Name"),
                        Model.BulkOperationSelectionModel.SelectedOperationType == "unique" ? @GlobalBulkOperation.SimulationContributionSourceAccountType : @GlobalBulkOperation.SimulationTopupSourceAccountType,
                        new { @class = "form-select" })
                </div>
            </div>
            
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.StartAccount, Model.BulkOperationSelectionModel.SelectedOperationType == "unique" ? @GlobalBulkOperation.SimulationContributionStartMemberAccount : @GlobalBulkOperation.SimulationTopupStartMemberAccount, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.StartAccount, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.EndAccount, Model.BulkOperationSelectionModel.SelectedOperationType == "unique" ? @GlobalBulkOperation.SimulationContributionEndMemberAccount : @GlobalBulkOperation.SimulationTopupEndMemberAccount, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EndAccount, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountMinAmount, Model.BulkOperationSelectionModel.SelectedOperationType == "unique" ? @GlobalBulkOperation.SimulationContributionMinimumAccountBalance : @GlobalBulkOperation.SimulationTopupMinimumAccountBalance, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SourceAccountMinAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountMaxAmount, Model.BulkOperationSelectionModel.SelectedOperationType == "unique" ? @GlobalBulkOperation.SimulationContributionMaximumAccountBalance : @GlobalBulkOperation.SimulationTopupMaximumAccountBalance, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SourceAccountMaxAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
        </div>
    </div>
