@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateBulkOperation

    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountType, "Source Account Type", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.SourceAccountType,
                        new SelectList(Model.SavingProducts, "Id", "Name"),
                        "Select Account Type",
                        new { @class = "form-select" })
                </div>
            </div>
            
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.StartAccount, "Start Account Range", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.StartAccount, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.EndAccount, "End Account Range", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EndAccount, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountMinAmount, "Minimum Account Balance", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SourceAccountMinAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(m => m.SourceAccountMaxAmount, "Maximum Account Balance", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SourceAccountMaxAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
        </div>
    </div>
