<!-- Operation Parameters Section -->


    <div class="accordion mb-4" id="fileUploadAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingFileUpload">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFileUpload" aria-expanded="true" aria-controls="collapseFileUpload">
                    <i class="mdi mdi-cloud-upload-outline me-2"></i> Bulk Operation File Upload
                    <span class="badge bg-primary ms-2">Required</span>
                </button>
            </h2>
            <div id="collapseFileUpload" class="accordion-collapse collapse show" aria-labelledby="headingFileUpload">
                <div class="accordion-body">
                    <div class="alert alert-info mb-4">
                        <i class="mdi mdi-information-outline me-2"></i>
                        Upload a properly formatted CSV or Excel file containing the bulk operation details. Maximum file size: 10MB.
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-lg-8">
                            <div class="file-upload-wrapper">
                                <label for="bulkOperationFile" class="form-label">Select operation file</label>
                                <div class="input-group has-validation">
                                    <input type="file"
                                           name="file"
                                           class="form-control"
                                           id="bulkOperationFile"
                                           accept=".csv,.xlsx,.xls"
                                           required
                                           data-max-size="10485760">
                                    <button class="btn btn-primary px-4" type="submit" id="uploadButton">
                                        <span class="upload-text">Upload File</span>
                                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        <i class="mdi mdi-cloud-upload-outline ms-1"></i>
                                    </button>
                                    <div class="invalid-feedback">
                                        Please select a valid Excel file (max 10MB).
                                    </div>
                                </div>
                                <div class="form-text">Supported formats: .csv, .xlsx, .xls (Template available below)</div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/BulkOperation/DownloadBulkOperationFileTemplate" class="btn btn-outline-primary d-inline-flex align-items-center">
                                <i class="mdi mdi-file-download-outline me-2"></i>
                                <span>Download Template</span>
                            </a>
                        </div>
                    </div>

                    <!-- Upload Progress -->
                    <div class="upload-feedback mt-4">
                        <div class="progress mb-2" style="height: 8px; display: none;" id="uploadProgress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                 role="progressbar"
                                 style="width: 0%"
                                 aria-valuenow="0"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>

                        <div id="uploadStatus" class="alert d-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <style>
        .file-upload-wrapper {
            position: relative;
        }

        .upload-feedback {
            transition: all 0.3s ease;
        }

        #uploadStatus {
            transition: opacity 0.3s ease;
        }

        .progress-bar {
            transition: width 0.3s ease;
        }

        .accordion-button .badge {
            position: relative;
            top: -1px;
        }
    </style>
