
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateBulkOperation

<div class="card-body">
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                @Html.LabelFor(m => m.SourceAccountType, "Destination Account", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.SourceAccountType,
                    new SelectList(ViewBag.chartOfAccounts, "Text", "Text"),
                    "Select Account",
                    new { @class = "form-select select2" })
            </div>
            <div class="col-md-12">
                <div class="mb-3">
                    @Html.LabelFor(m => m.TargetAmount, "Amount", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TargetAmount, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
        </div>

    </div>

</div>
