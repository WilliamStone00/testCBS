@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateBulkOperation
@using Resources

@{
    ViewBag.Title = @GlobalBulkOperation.SimulateBulkOperation;

}


<style>
    .hint {
        font-size: .85rem;
        color: #6c757d;
    }

    .field-note {
        margin-top: .25rem;
    }

    .req-star {
        color: #dc3545;
        font-weight: 700;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

        <!-- Header Section -->
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group-outline me-2"></i> @GlobalBulkOperation.BULKRANGEDOPERATIONS
                </h1>
                <p class="card-text">
                    <strong>Bulk Account Management System</strong> — Perform mass operations across multiple accounts simultaneously.
                    Save time by processing hundreds of accounts in a single operation while maintaining complete audit trails and operational control.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

                <div class="alert alert-info mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>Important:</strong> All bulk operations are executed in simulation mode first to allow full review and validation before actual execution.
                </div>
            </div>
        </div>

        <!-- Tips Section -->
        <div class="card shadow-sm mb-4">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.TIPS</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUserTips"
                        aria-expanded="false" aria-controls="collapseUserTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>

            <div id="collapseUserTips" class="collapse">
                <div class="card-body">
                    <div class="row gy-3">

                        <div class="col-md-12">
                            <h5 class="text-primary mb-2">
                                <i class="mdi mdi-playlist-check me-2"></i> Quick Guide
                            </h5>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 border rounded">
                                        <div class="fw-bold text-dark mb-1">
                                            <i class="mdi mdi-cog-outline me-1"></i> Simulation Details
                                        </div>
                                        <div class="hint">
                                            Choose a simulation type and write a clear description.
                                            This is what auditors and reports will use to identify the run.
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border rounded">
                                        <div class="fw-bold text-dark mb-1">
                                            <i class="mdi mdi-database-outline me-1"></i> Source Accounts
                                        </div>
                                        <div class="hint">
                                            Define which accounts are impacted (type, range, min/max balance).
                                            Keep ranges tight to avoid unintended selections.
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border rounded">
                                        <div class="fw-bold text-dark mb-1">
                                            <i class="mdi mdi-target-account me-1"></i> Destination
                                        </div>
                                        <div class="hint">
                                            For Top-Up: choose destination account type + target amount.
                                            For Contribution: choose a single destination GL + contribution amount.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-3 mb-0 d-flex align-items-center" role="alert">
                                <i class="mdi mdi-alert-outline me-2"></i>
                                Always run simulation and verify the impacted accounts list before execution.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="alert alert-primary d-flex align-items-center" role="alert">
                                <i class="mdi mdi-account-edit-outline me-2"></i>
                                @GlobalBulkOperation.FillAllRequiredFieldsAccurately.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                <i class="mdi mdi-close-circle-outline me-2"></i>
                                Avoid wide ranges (Start/End). Bulk runs are hard to reverse and may require manual correction.
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="row mb-2">
            <div class="col-md-6 text-md-end mb-1 mb-md-0">
                <a href="/BulkOperation/BulkCashOperation" class="btn btn-primary btn-sm shadow-sm px-3 w-100 w-md-auto">
                    <i class="mdi mdi-account-plus-outline me-1"></i> @GlobalBulkOperation.SimulateBulkCashOperation
                </a>
            </div>
            <div class="col-md-6 text-md-start">
                <a href="/BulkOperation/Listing" class="btn btn-outline-secondary btn-sm shadow-sm px-3 w-100 w-md-auto" data-bs-toggle="tooltip" title="@GlobalBulkOperation.GoToExecutedBulkOperationList">
                    <i class="mdi mdi-cash me-1"></i> @GlobalBulkOperation.ViewBulkOperations
                </a>
            </div>
        </div>


        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <div class="accordion-item active">
                <div class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconBulk">
                    <button type="button" class="accordion-button" data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-bulk" aria-expanded="true" aria-controls="accordionPopoutIcon-bulk">
                        <i class="fas fa-user-plus me-2"></i> @GlobalBulkOperation.BulkOperationSimulation
                    </button>

                    @*  <div class="d-flex align-items-center">
                            <a href="/BulkOperation/Listing" class="btn btn-sm btn-outline-secondary align-self-center me-3"
                               data-bs-toggle="tooltip" title="@GlobalBulkOperation.GoToExecutedBulkOperationList">
                                <i class="mdi mdi-view-list me-1"></i> @GlobalBulkOperation.ViewBulkOperations
                            </a>
                        </div>*@
                </div>

                <div id="accordionPopoutIcon-bulk" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">

                        @using (Html.BeginForm("Simulate", "BulkOperation", FormMethod.Post,
                            new { enctype = "multipart/form-data", id = "bulkOperationForm", onsubmit = "return AjaxPostAndUpdateBulkOperation(this);" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.IsContribution, new { id = "isContribution" })

                            <!-- ============================= -->
                            <!-- Simulation Details -->
                            <!-- ============================= -->
                            <div class="accordion mb-4" id="simulationTypeAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingSimulationType">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapseSimulationType" aria-expanded="true" aria-controls="collapseSimulationType">
                                            <i class="mdi mdi-cog-outline me-2"></i> @GlobalBulkOperation.SimulationDetails
                                        </button>
                                    </h2>

                                    <div id="collapseSimulationType" class="accordion-collapse collapse show" aria-labelledby="headingSimulationType">
                                        <div class="accordion-body">
                                            <div class="row g-3">

                                                <!-- Simulation Type -->
                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.SimulationType, @GlobalBulkOperation.SimulationType, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.DropDownListFor(
                                                        m => m.SimulationType,
                                                        new SelectList(ViewBag.SimulationTypes, "Value", "Text"),
                                                        "--- Select Simulation Type ---",
                                                        new { @class = "form-select select2", required = "required", id = "SimulationType" }
                                                    )
                                                    <div class="hint field-note">
                                                        Pick a type that matches the business reason. Use <b>Other</b> only when none fits.
                                                    </div>
                                                </div>

                                                <!-- Branch -->
                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.BranchId, @GlobalBulkOperation.SelectBranch, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.DropDownListFor(m => m.BranchId,
                                                        new SelectList(Model.Branches, "Id", "Name"),
                                                        "--- " + GlobalBulkOperation.SelectBranch + " ---",
                                                        new { @class = "form-select select2", id = "BranchId", onchange = "loadBranchAccounts(this.value, 1)" })
                                                    <div class="hint field-note">
                                                        The branch defines the accounting scope and the available branch Chart of Accounts.
                                                    </div>
                                                </div>

                                                <!-- Description -->
                                                <div class="col-md-12">
                                                    @Html.LabelFor(m => m.Description, @GlobalBulkOperation.Description, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.TextAreaFor(m => m.Description,
                                                        new
                                                             {
                                                                 @class = "form-control",
                                                                 rows = "3",
                                                            placeholder = @GlobalBulkOperation.EnterADescriptionForThisBulkOperation,
                                                            id = "Description"
                                                             })
                                                    <div class="hint field-note">
                                                        Recommended format: <b>Reason + period + operator</b>. Example:
                                                        “Share top-up for Dec 2025 – initiated by Teller A”.
                                                        Required if Simulation Type is <b>Other</b>.
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ============================= -->
                            <!-- Operation Type -->
                            <!-- ============================= -->
                            <div class="accordion mb-4" id="operationTypeAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOperationType">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapseOperationType" aria-expanded="true" aria-controls="collapseOperationType">
                                            <i class="mdi mdi-format-list-bulleted-type me-2"></i> Operation Mode
                                        </button>
                                    </h2>

                                    <div id="collapseOperationType" class="accordion-collapse collapse show" aria-labelledby="headingOperationType">
                                        <div class="accordion-body">
                                            <div class="card-body">

                                                <div class="alert alert-light border mb-3">
                                                    <i class="mdi mdi-information-outline me-2"></i>
                                                    <b>Top-Up</b> credits multiple accounts to a target amount.
                                                    <b>Contribution</b> collects from many accounts into a single destination account (GL).
                                                </div>

                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="operationType" id="specificAccountType"
                                                           value="specific" checked="@(Model.BulkOperationSelectionModel.SelectedOperationType == "specific")">
                                                    <label class="form-check-label" for="specificAccountType">
                                                        @GlobalBulkOperation.SimulateShareTopUp
                                                    </label>
                                                </div>

                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="operationType" id="uniqueAccount"
                                                           value="unique" checked="@(Model.BulkOperationSelectionModel.SelectedOperationType == "unique")">
                                                    <label class="form-check-label" for="uniqueAccount">
                                                        @GlobalBulkOperation.SimulateContribution
                                                    </label>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ============================= -->
                            <!-- Source Accounts -->
                            <!-- ============================= -->
                            <div class="accordion mb-4" id="sourceAccountsAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingSourceAccounts">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapseSourceAccounts" aria-expanded="true" aria-controls="collapseSourceAccounts">
                                            <i class="mdi mdi-database-outline me-2"></i> @GlobalBulkOperation.SourceAccountsConfiguration
                                        </button>
                                    </h2>

                                    <div id="collapseSourceAccounts" class="accordion-collapse collapse show" aria-labelledby="headingSourceAccounts">
                                        <div class="accordion-body">

                                            <div class="row g-3">

                                                <div class="col-md-12">
                                                    @Html.LabelFor(m => m.SourceAccountType, @GlobalBulkOperation.SimulationTopupSourceAccountType, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.DropDownListFor(m => m.SourceAccountType,
                                                        new SelectList(Model.SavingProducts, "Name", "Name"),
                                                        "--- Select Account Type ---",
                                                        new { @class = "form-select select2", id = "SourceAccountType" })
                                                    <div class="hint field-note">
                                                        This is the member account type that will be filtered and impacted by the bulk run.
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.StartAccount, @GlobalBulkOperation.SimulationTopupStartMemberAccount, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.TextBoxFor(m => m.StartAccount, new { @class = "form-control", id = "StartAccount", placeholder = "e.g. 0000100" })
                                                    <div class="hint field-note">
                                                        Limits selection to accounts starting from this member/account reference.
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.EndAccount, @GlobalBulkOperation.SimulationTopupEndMemberAccount, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.TextBoxFor(m => m.EndAccount, new { @class = "form-control", id = "EndAccount", placeholder = "e.g. 0000999" })
                                                    <div class="hint field-note">
                                                        Limits selection to accounts ending at this member/account reference.
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.SourceAccountMinAmount, @GlobalBulkOperation.SimulationTopupMinimumAccountBalance, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.TextBoxFor(m => m.SourceAccountMinAmount, new { @class = "form-control", id = "SourceAccountMinAmount", type = "number", step = "0.01", min = "0", placeholder = "0" })
                                                    <div class="hint field-note">
                                                        Only accounts with balance >= this amount are included.
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    @Html.LabelFor(m => m.SourceAccountMaxAmount, @GlobalBulkOperation.SimulationTopupMaximumAccountBalance, new { @class = "form-label" })
                                                    <span class="req-star">*</span>
                                                    @Html.TextBoxFor(m => m.SourceAccountMaxAmount, new { @class = "form-control", id = "SourceAccountMaxAmount", type = "number", step = "0.01", min = "0", placeholder = "0 (no limit)" })
                                                    <div class="hint field-note">
                                                        Only accounts with balance <= this amount are included.
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ============================= -->
                            <!-- Destination -->
                            <!-- ============================= -->
                            <div class="accordion mb-4" id="dynamicViewsAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingDynamicViews">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapseDynamicViews" aria-expanded="true" aria-controls="collapseDynamicViews">
                                            <i class="mdi mdi-page-layout-body me-2"></i> @GlobalBulkOperation.DestinationConfiguration
                                        </button>
                                    </h2>

                                    <div id="collapseDynamicViews" class="accordion-collapse collapse show" aria-labelledby="headingDynamicViews">
                                        <div class="accordion-body">

                                            <div id="mainviewChange">
                                                <div class="change-group">

                                                    <!-- TOP-UP -->
                                                    <div id="mainview1">
                                                        <div class="row g-3">
                                                            <div class="col-md-12">
                                                                @Html.LabelFor(m => m.DestinationAccountType, @GlobalBulkOperation.SimulationTopupDestinationAccountType, new { @class = "form-label" })
                                                                <span class="req-star">*</span>
                                                                @Html.DropDownListFor(m => m.DestinationAccountType,
                                                                    new SelectList(Model.SavingProducts, "Name", "Name"),
                                                                    "--- Select Destination Account Type ---",
                                                                    new { @class = "form-select select2", id = "DestinationAccountType" })
                                                                <div class="hint field-note">
                                                                    Target account type to be credited during top-up.
                                                                </div>
                                                            </div>

                                                            <div class="col-md-12">
                                                                @Html.LabelFor(m => m.TargetAmount, @GlobalBulkOperation.SimulationTopupAmount, new { @class = "form-label" })
                                                                <span class="req-star">*</span>
                                                                @Html.TextBoxFor(m => m.TargetAmount,
                                                                    new { @class = "form-control", id = "TargetAmount", type = "number", step = "0.01", min = "0", placeholder = "e.g. 5000" })
                                                                <div class="hint field-note">
                                                                    The system will credit each eligible account up to this target amount.
                                                                    Must be greater than 0.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- CONTRIBUTION -->
                                                    <div id="mainview2">
                                                        <div class="row g-3">
                                                            <div class="col-md-12">
                                                                @Html.LabelFor(m => m.DestinationAccountId, @GlobalBulkOperation.SimulationContributionDestinationAccountType, new { @class = "form-label" })
                                                                <span class="req-star">*</span>
                                                                @Html.DropDownListFor(m => m.DestinationAccountId,
                                                                    new List<SelectListItem> { new SelectListItem { Text = "--- Select Chart Of Account ---", Value = "" } },
                                                                    new { @class = "form-select select2", id = "DestinationAccountId" })
                                                                <div class="hint field-note">
                                                                    This is the single destination GL that receives the collected contribution amount.
                                                                    Loaded based on the selected branch.
                                                                </div>
                                                            </div>

                                                            <div class="col-md-12">
                                                                @Html.LabelFor(m => m.ContributionAmount, @GlobalBulkOperation.SimulationContributionAmount, new { @class = "form-label" })
                                                                <span class="req-star">*</span>
                                                                @Html.TextBoxFor(m => m.ContributionAmount,
                                                                    new { @class = "form-control", id = "ContributionAmount", type = "number", step = "0.01", min = "0", placeholder = "e.g. 1000" })
                                                                <div class="hint field-note">
                                                                    Amount to collect from each eligible account (or per rule, depending on your backend logic).
                                                                    Must be greater than 0.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="mt-4 d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="mdi mdi-play me-1"></i> @GlobalBulkOperation.SimulateBulkOperation
                                </button>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    // ✅ FIXED: proper signature loadBranchAccounts(branchId, targetIndex)
    async function loadBranchAccounts(branchId, targetIndex) {
        // only one dropdown in this view (DestinationAccountId)
        const $targetDropdown = $('#DestinationAccountId');
        if (!$targetDropdown.length) return;

        const textLoading = 'Loading Chart Of Accounts...';
        const textEmpty = '--- Select Branch Account reference ---';
        const textNone = 'No branch accounts available';
        const textError = 'Error loading branch accounts';

        $targetDropdown.prop('disabled', true).empty().append($('<option>').val('').text(textLoading));

        if (!branchId) {
            $targetDropdown.prop('disabled', false).empty().append($('<option>').val('').text(textEmpty));
            if ($.fn.select2) $targetDropdown.trigger('change.select2');
            return;
        }

        const url = '@Url.Action("GetBranchAccountsByBranch", "BranchAccount")';

        try {
            const resp = await fetch(url + '?branchId=' + encodeURIComponent(branchId), {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-cache',
                headers: { 'Accept': 'application/json' }
            });

            if (!resp.ok) {
                const body = await resp.text().catch(() => '');
                console.error('Fetch failed', resp.status, resp.statusText, body);
                $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text(textError));
                if ($.fn.select2) $targetDropdown.trigger('change.select2');
                return;
            }

            const payload = await resp.json().catch(() => null);
            let items = [];
            if (Array.isArray(payload)) items = payload;
            else if (payload && Array.isArray(payload.items)) items = payload.items;
            else if (payload && Array.isArray(payload.data)) items = payload.data;

            $targetDropdown.empty().prop('disabled', false);

            if (items && items.length) {
                $targetDropdown.append($('<option>').val('').text(textEmpty));
                items.forEach(acc => {
                    const id = acc.id ?? acc.Id ?? acc.Value ?? acc.value ?? '';
                    const name = acc.text ?? acc.Text ?? acc.Name ?? acc.name ?? acc.Description ?? id;
                    $targetDropdown.append($('<option>').val(id).text(name));
                });
            } else {
                $targetDropdown.append($('<option>').val('').text(textNone));
            }

            if ($.fn.select2) $targetDropdown.trigger('change.select2');
        } catch (e) {
            console.error('Error loading branch accounts:', e);
            $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text(textError));
            if ($.fn.select2) $targetDropdown.trigger('change.select2');
        }
    }
    </script>

    <script>
        $(document).ready(function () {

            // Tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Select2
            if ($.fn.select2) {
                try { $('.select2').select2({ width: '100%' }); } catch (e) { console.warn('select2 failed', e); }
            }

            // Initial state
            updateOperationViews();

            // Listen for changes
            $('input[name="operationType"]').change(function () {
                updateOperationViews();
            });

            function updateOperationViews() {
                const isContribution = $('input[name="operationType"]:checked').val() === "unique";

                // ✅ keep hidden in sync for server if needed
                $("#isContribution").val(isContribution.toString());

                if (isContribution) {
                    $('label[for="SourceAccountType"]').text('@GlobalBulkOperation.SimulationContributionSourceAccountType');
                   $('label[for="StartAccount"]').text('@GlobalBulkOperation.SimulationContributionStartMemberAccount');
                    $('label[for="EndAccount"]').text('@GlobalBulkOperation.SimulationContributionEndMemberAccount');
                    $('label[for="SourceAccountMinAmount"]').text('@GlobalBulkOperation.SimulationContributionMinimumAccountBalance');
                    $('label[for="SourceAccountMaxAmount"]').text('@GlobalBulkOperation.SimulationContributionMaximumAccountBalance');

                    $("#mainview1").hide();
                    $("#mainview2").show();
                } else {
                    $('label[for="SourceAccountType"]').text('@GlobalBulkOperation.SimulationTopupSourceAccountType');
                    $('label[for="StartAccount"]').text('@GlobalBulkOperation.SimulationTopupStartMemberAccount');
                    $('label[for="EndAccount"]').text('@GlobalBulkOperation.SimulationTopupEndMemberAccount');
                    $('label[for="SourceAccountMinAmount"]').text('@GlobalBulkOperation.SimulationTopupMinimumAccountBalance');
                    $('label[for="SourceAccountMaxAmount"]').text('@GlobalBulkOperation.SimulationTopupMaximumAccountBalance');

                    $("#mainview1").show();
                    $("#mainview2").hide();
                }
            }
        });

    function AjaxPostAndUpdateBulkOperation(form) {

        let isValid = true;
        let firstInvalid = null;

        function markInvalid(field, message) {
            field.addClass('is-invalid');
            if (!firstInvalid) firstInvalid = field;
            isValid = false;
            if (message) appalert(message, 2, 1);
        }

        function clearValidation(formElement) {
            $(formElement).find('.is-invalid').removeClass('is-invalid');
        }

        clearValidation(form);

        // ===============================
        // Simulation Details Validation
        // ===============================
        const simulationType = $(form).find('[name="SimulationType"]');
        const description = $(form).find('[name="Description"]');
        const branchId = $(form).find('[name="BranchId"]');

        if (!simulationType.val()) markInvalid(simulationType, "❌ Please select a simulation type.");
        if (!branchId.val()) markInvalid(branchId, "❌ Please select a branch.");

        const descTrim = $.trim(description.val() || "");
        if (!descTrim) markInvalid(description, "❌ Description is required.");
        if (simulationType.val() === "Other" && descTrim.length < 5) {
            markInvalid(description, "❌ Please provide a detailed description when Simulation Type is Other.");
        }

        // ===============================
        // Source Accounts Validation
        // ===============================
        const sourceType = $(form).find('[name="SourceAccountType"]');
        if (!$.trim(sourceType.val() || "")) markInvalid(sourceType, "❌ Please select a source account type.");

        const minAmount = parseFloat($(form).find('[name="SourceAccountMinAmount"]').val()) || 0;
        const maxAmount = parseFloat($(form).find('[name="SourceAccountMaxAmount"]').val()) || 0;

        if (minAmount < 0) markInvalid($(form).find('[name="SourceAccountMinAmount"]'), "❌ Minimum amount must be 0 or greater.");
        if (maxAmount < 0) markInvalid($(form).find('[name="SourceAccountMaxAmount"]'), "❌ Maximum amount must be 0 or greater.");
        if (maxAmount > 0 && minAmount > maxAmount) {
            markInvalid($(form).find('[name="SourceAccountMinAmount"]'), "❌ Minimum amount cannot be greater than maximum amount.");
        }

        // ===============================
        // Destination Validation
        // ===============================
        const isContribution = $(form).find('input[name="operationType"]:checked').val() === 'unique';

        if (isContribution) {
            const destAccountId = $(form).find('[name="DestinationAccountId"]');
            const amount = parseFloat($(form).find('[name="ContributionAmount"]').val()) || 0;

            if (!$.trim(destAccountId.val() || "")) markInvalid(destAccountId, "❌ Destination GL is required for Contribution.");
            if (amount <= 0) markInvalid($(form).find('[name="ContributionAmount"]'), "❌ Contribution amount must be greater than 0.");
        } else {
            const destType = $(form).find('[name="DestinationAccountType"]');
            const amount = parseFloat($(form).find('[name="TargetAmount"]').val()) || 0;

            if (!$.trim(destType.val() || "")) markInvalid(destType, "❌ Destination account type is required for Top-Up.");
            if (amount <= 0) markInvalid($(form).find('[name="TargetAmount"]'), "❌ Target amount must be greater than 0.");
        }

        if (!isValid) {
            if (firstInvalid) firstInvalid.focus();
            if (!$(".appalert:visible").length) {
                appalert("❌ Please correct the highlighted fields before submitting.", 2, 1);
            }
            return false;
        }

        // Confirm + submit
        alertify.confirm("Confirmation", "Are you sure you want to simulate this bulk operation?",
            function () {

                const ajaxConfig = {
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message || "✅ Simulation completed.", 1, 1);
                            setTimeout(() => {
                                if (response.redirectUrl) window.location.href = response.redirectUrl;
                                else location.reload();
                            }, 1200);
                        } else {
                            appalert(response.message || "❌ Simulation failed.", 2, 1);
                        }
                    },
                    error: function (err) {
                        if (err.status === 401) window.location.href = '/Authentication/Login';
                        else appalert(err.statusText || "❌ An error occurred during simulation.", 0, 1);
                    }
                };

                ajaxConfig.contentType = false;
                ajaxConfig.processData = false;

                $.ajax(ajaxConfig);
            },
            function () {
                appalert('Simulation cancelled.', 3, 1);
            }
        );

        return false;
    }
    </script>

}

