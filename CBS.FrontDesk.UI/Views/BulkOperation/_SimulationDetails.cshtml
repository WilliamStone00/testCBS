@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData

<style>
    .is-invalid {
        border-color: red !important;
        background-color: #fff0f0;
    }
</style>
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="card-body">
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">Operation Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Simulation Type</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.SimulationType</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Branch</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.BranchName (@Model.BranchCode)</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Bank</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.BankName (@Model.BankCode)</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Total Volume</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.TotalVolume</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Total Members</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.TotalMembers</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">Approval Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Status</label>
                        <div class="col-sm-8">
                            <span class="badge @Model.ApprovalStatusBadge">@Model.ApprovalStatus</span>
                        </div>
                    </div>


                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Created By</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.CreatedBy) ? "N/A" : Model.CreatedBy)</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Approved By</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.ApprovalBy) ? "N/A" : Model.ApprovalBy)</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Approval Date</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(Model.ApprovalValidationDate == default(DateTime) ? "N/A" : Model.ApprovalValidationDate.ToString("dd/MM/yyyy HH:mm:ss"))</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Description</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.ApprovalValidationDescription) ? "N/A" : Model.ApprovalValidationDescription)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="accordion" id="collapsibleSection">
        <div class="card accordion-item mb-3">
            <h2 class="accordion-header" id="headingMembers">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseMembers"
                        aria-expanded="false"
                        aria-controls="collapseMembers">
                    <i class="fas fa-users me-2"></i>Operation Members (@Model.TotalMembers)
                </button>
            </h2>
            <div id="collapseMembers" class="accordion-collapse collapse" aria-labelledby="headingMembers">
                <div class="accordion-body">
                    @Html.Partial("_SimulationDetailsDataTable", Model)
                </div>
            </div>
        </div>

        <div class="card accordion-item mb-3">
            <h2 class="accordion-header" id="headingActions">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseActions"
                        aria-expanded="false"
                        aria-controls="collapseActions">
                    <i class="fas fa-tasks me-2"></i>Available Actions
                </button>
            </h2>
            <div id="collapseActions"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingActions"
                 data-bs-parent="#collapsibleSection">
                <div class="accordion-body">
                    <div class="d-flex gap-2">
                        @if (@Model.ApprovalStatus != "Approved")
                        {
                            <button type="button" class="btn btn-primary" id="approveBulkOperation" data-simulation-id="@Model.Id">
                                <i class="fas fa-check me-1"></i> Approve
                            </button>
                            <button type="button" class="btn btn-warning" id="reviewBulkOperation" data-simulation-id="@Model.Id">
                                <i class="fas fa-search me-1"></i> Send for Review
                            </button>
                        }
                        <button type="button" class="btn btn-info">
                            <i class="fas fa-download me-1"></i> Export Data
                        </button>
                        <button type="button" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Modal -->
<!-- Transfer Details Modal -->
<div class="modal fade" id="transferDetailsModal" tabindex="-1" aria-labelledby="transferDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="transferDetailsLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">Loading transfer details...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-bank-transfer me-2"></i> Transfer Details
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section (optional) -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> About This Transfer</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTransferTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseTransferTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-clock-outline text-primary me-2"></i><strong>Real-time:</strong> Shows the most current transfer status.</li>
                            <li><i class="mdi mdi-shield-check-outline text-success me-2"></i><strong>Secure:</strong> All information is encrypted.</li>
                            <li><i class="mdi mdi-history text-warning me-2"></i><strong>Complete History:</strong> Shows full transaction details.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="modal-body p-4">
                <div id="transferDetailsContent" class="details-grid">
                    <!-- Content will be loaded dynamically -->
                    <div class="loading-container text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading transfer details...</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        Transaction ID: <span class="text-dark" id="transferTransactionId">@Model.Id</span>
                    </span>
                </div>
                <div class="text-center w-100">
                    <small class="text-muted">Powered by FLX-CBS</small>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Bulk Operation Modal -->
<div class="modal fade" id="confirmBulkOperationModal" tabindex="-1" aria-labelledby="confirmBulkOperationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="confirmBulkOperationLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">Processing bulk operation...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-checkbox-marked-circle-outline me-2"></i> Confirm Bulk Operation
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> About This Operation</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBulkOperationTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseBulkOperationTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>Important:</strong> This action will affect multiple records.</li>
                            <li><i class="mdi mdi-shield-check-outline text-success me-2"></i><strong>Secure:</strong> All changes are logged for audit purposes.</li>
                            <li><i class="mdi mdi-undo text-danger me-2"></i><strong>Irreversible:</strong> This operation cannot be undone.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="modal-body p-4">
                <form id="confirmBulkOperationForm">
                    <input type="hidden" id="bulkOperationSimulationId" name="BulkOperationSimulationId"  />

                    <div class="mb-3">
                        <label for="approvalStatus" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-check-decagram me-2"></i>Approval Status
                        </label>
                        <select class="form-select" id="approvalStatus" name="ApprovalStatus" required>
                            <option value="">Select status...</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Reviewed</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="approvalStatusDescription" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-text-box-outline me-2"></i>Description
                        </label>
                        <textarea class="form-control" id="approvalStatusDescription" name="ApprovalStatusDescription" rows="3" placeholder="Enter description or comments..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="approvalBy" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-account-check-outline me-2"></i>Approved By
                        </label>
                        <input type="text" class="form-control" id="approvalBy" name="ApprovalBy" placeholder="Enter approver name" required>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        <strong>Warning:</strong> Please review all details carefully before confirming this bulk operation.
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        Simulation ID: <span class="text-dark" id="bulkOperationSimulationIdDisplay">Not provided</span>
                    </span>
                </div>
                <div class="text-center w-100">
                    <small class="text-muted">Powered by FLX-CBS</small>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmBulkOperationBtn">
                        <i class="mdi mdi-check-circle-outline"></i> Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
