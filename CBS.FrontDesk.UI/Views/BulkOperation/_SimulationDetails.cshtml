@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources
@{ 
    var firstMember = Model?.BulkOperationSimulationDetails?.FirstOrDefault();
    var sourceAccountype = string.IsNullOrWhiteSpace(firstMember?.SourceAccountType) ? "N/A" : firstMember.SourceAccountType  ;
    var destinationAccountype = string.IsNullOrWhiteSpace(firstMember?.DestinationAccountNumber) ? "N/A" : firstMember.DestinationAccountNumber;
}

<style>
    .is-invalid {
        border-color: red !important;
        background-color: #fff0f0;
    }
</style>
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="card-body">
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">@GlobalShared.Operation_information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Simulation_type</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(Model.SimulationType?.ToUpper())</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Branch</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(Model.InitiatorBranchName?.ToUpper()) (@Model.InitiatorBranchCode)</div>
                        </div>
                    </div>
                    @* <div class="row mb-3">
                            <label class="col-sm-4 col-form-label">@GlobalBulkOperation.Bank</label>
                            <div class="col-sm-8">
                                <div class="form-control">@(Model.BankName?.ToUpper()) (@Model.BankCode)</div>
                            </div>
                        </div>*@
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Total_volume</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.TotalVolume</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.TotalMembers</label>
                        <div class="col-sm-8">
                            <div class="form-control">@Model.TotalMembers</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Description</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(Model?.Description)</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalBulkOperation.Accounting_Impact</label>
                        <div class="col-sm-8">
                            <div class="form-control">

                                @if (Model?.ShouldImpactAccounting == false)
                                {
                                    <span class="text-warning fw-semibold">
                                        <i class="mdi mdi-alert-outline me-1"></i>
                                        @GlobalBulkOperation.Accounting_impact_is <b>@GlobalShared.DISABLED</b>.
                                    </span>
                                    <div class="small text-muted mt-1">
                                        @Html.Raw(@GlobalBulkOperation.This_simulation_was_explicitly_configured_not_to_generate_accounting_entries_even_if_approved)
                                    </div>
                                }
                                else if (!string.Equals(Model?.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="text-info fw-semibold">
                                        <i class="mdi mdi-timer-sand me-1"></i>
                                        @GlobalBulkOperation.Accounting_impact_is <b>@GlobalShared.PENDING_UC</b>.
                                    </span>
                                    <div class="small text-muted mt-1">
                                        @GlobalBulkOperation.This_simulation_is_eligible_to_impact_accounting_but_no_entries_were_generated_because_the_operation_is_not_yet_approved
                                    </div>
                                }
                                else
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="mdi mdi-check-circle-outline me-1"></i>
                                        @GlobalBulkOperation.Accounting_impact_is <b>@GlobalShared.ENABLED</b>.
                                    </span>
                                    <div class="small text-muted mt-1">
                                        @GlobalBulkOperation.This_simulation_is_approved_and_will_generate_accounting_entries_upon_execution
                                    </div>
                                }

                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">@GlobalShared.Approval_information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Status</label>
                        <div class="col-sm-8">
                            <span class="badge @Model.ApprovalStatusBadge">@(Model.ApprovalStatus?.ToUpper())</span>
                        </div>
                    </div>


                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Created_by</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.CreatedBy) ? "N/A" : Model.CreatedBy.ToUpper())</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Approved_by</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.ApprovalBy) ? "N/A" : Model.ApprovalBy.ToUpper())</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Approval_date</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(Model.ApprovalValidationDate == default(DateTime) ? "N/A" : Model.ApprovalValidationDate.ToString("dd/MM/yyyy HH:mm:ss"))</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">@GlobalShared.Description</label>
                        <div class="col-sm-8">
                            <div class="form-control">@(string.IsNullOrEmpty(Model.ApprovalValidationDescription) ? "N/A" : Model.ApprovalValidationDescription)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Simulation Details Filter Panel -->
    <div class="accordion" id="collapsibleSection">
        <!-- Simulation Details Filter Panel as Accordion Item -->
        <div class="card accordion-item mb-3">
            <h2 class="accordion-header" id="headingSimulationDetailsFilters">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseSimulationDetailsFilters"
                        aria-expanded="false"
                        aria-controls="collapseSimulationDetailsFilters">
                    <i class="mdi mdi-filter-outline text-primary me-2"></i>
                    @GlobalBulkOperation.Simulation_Details_Filters
                    <span class="badge badge-soft small ms-2" id="activeDetailsFiltersBadge" style="display:none;">
                        <i class="mdi mdi-filter-variant me-1"></i> @GlobalShared.Active_filters_applied
                    </span>
                </button>
            </h2>

            <div id="collapseSimulationDetailsFilters" class="accordion-collapse collapse" aria-labelledby="headingSimulationDetailsFilters">
                <div class="accordion-body">
                    <!-- Filter Toggle Checkboxes -->
                    <div class="d-flex flex-wrap gap-3 align-items-center mb-3 pb-2 border-bottom">
                        <span class="small fw-bold text-muted"><i class="mdi mdi-eye-settings me-1"></i>@GlobalShared.Show_Filters:</span>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByMember" checked />
                            <label class="form-check-label small" for="filterByMember">
                                <i class="mdi mdi-account-circle text-primary me-1"></i>@GlobalShared.Member
                            </label>
                        </div>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByAccount" checked />
                            <label class="form-check-label small" for="filterByAccount">
                                <i class="mdi mdi-bank text-primary me-1"></i>@GlobalShared.Account
                            </label>
                        </div>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByBranch" checked />
                            <label class="form-check-label small" for="filterByBranch">
                                <i class="mdi mdi-office-building text-primary me-1"></i>@GlobalShared.Branch
                            </label>
                        </div>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByStatus" />
                            <label class="form-check-label small" for="filterByStatus">
                                <i class="mdi mdi-toggle-switch text-warning me-1"></i>@GlobalShared.Status
                            </label>
                        </div>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByDate" />
                            <label class="form-check-label small" for="filterByDate">
                                <i class="mdi mdi-calendar-range text-info me-1"></i>@GlobalShared.Date_Range
                            </label>
                        </div>

                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="filterByMessage" />
                            <label class="form-check-label small" for="filterByMessage">
                                <i class="mdi mdi-message-text text-success me-1"></i>@GlobalShared.Message
                            </label>
                        </div>
                    </div>

                    @using (Html.BeginForm(null, null, FormMethod.Get, new { id = "detailsFilterForm", autocomplete = "off" }))
                    {
                        <!-- Member Filters Section -->
                        <div id="memberFiltersSection" class="filter-section mb-3">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-account-circle me-1"></i>@GlobalShared.Member_Information
                                    </h6>
                                </div>
                                <div class="col-md-4">
                                    @Html.Label("FilterMemberReference", GlobalShared.Enter_member_reference, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterMemberReference", null, new { @class = "form-control form-control-sm", placeholder = "Search by member ref..." })
                                </div>
                                <div class="col-md-4">
                                    @Html.Label("FilterMemberName", GlobalShared.Members_name, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterMemberName", null, new { @class = "form-control form-control-sm", placeholder = "Search by member name..." })
                                </div>
                            </div>
                        </div>

                        <!-- Account Filters Section -->
                        <div id="accountFiltersSection" class="filter-section mb-3">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-bank me-1"></i>@GlobalShared.Account_Information
                                    </h6>
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterSourceAccountNumber", GlobalShared.Source_account, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterSourceAccountNumber", null, new { @class = "form-control form-control-sm", placeholder = "Account number..." })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterSourceAccountType", GlobalShared.Source_account_type, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownList("FilterSourceAccountType",
                                        new SelectList(ViewBag.AccountTypes ?? new List<SelectListItem>(), "Value", "Text"),
                                        "--- All Types ---",
                                        new { @class = "form-select form-select-sm" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterDestinationAccountNumber", GlobalShared.Destination_account, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterDestinationAccountNumber", null, new { @class = "form-control form-control-sm", placeholder = "Account number..." })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterDestinationAccountType", GlobalShared.Destination_type, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownList("FilterDestinationAccountType",
                                        new SelectList(ViewBag.AccountTypes ?? new List<SelectListItem>(), "Value", "Text"),
                                        "--- All Types ---",
                                        new { @class = "form-select form-select-sm" })
                                </div>
                            </div>
                        </div>

                        <!-- Branch Filters Section -->
                        <div id="branchFiltersSection" class="filter-section mb-3">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-office-building me-1"></i>@GlobalShared.Branch_Information
                                    </h6>
                                </div>
                                <div class="col-md-6">
                                    @Html.Label("FilterBranchId", GlobalShared.Branch, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownList("FilterBranchId",
                                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                                        "--- All Branches ---",
                                        new { @class = "form-select form-select-sm" })
                                </div>
                                <div class="col-md-6">
                                    @Html.Label("FilterBranchCode", GlobalShared.Branch_Code, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterBranchCode", null, new { @class = "form-control form-control-sm", placeholder = "Branch code..." })
                                </div>
                            </div>
                        </div>

                        <!-- Status Filters Section -->
                        <div id="statusFiltersSection" class="filter-section mb-3 d-none">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-toggle-switch me-1"></i>@GlobalShared.Status_Information
                                    </h6>
                                </div>
                                <div class="col-md-6">
                                    @Html.Label("FilterTransferStatus", GlobalShared.Transfer_Status, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownList("FilterTransferStatus",
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Value = "", Text = "--- All Statuses ---" },
                                            new SelectListItem { Value = "Pending", Text = GlobalShared.Pending },
                                            new SelectListItem { Value = "InProgress", Text = GlobalShared.In_Progress },
                                            new SelectListItem { Value = "Send", Text = GlobalShared.Send },
                                            new SelectListItem { Value = "Sent", Text = GlobalShared.Sent },
                                            new SelectListItem { Value = "Successful", Text = GlobalShared.Successful },
                                            new SelectListItem { Value = "Completed", Text = GlobalShared.Completed },
                                            new SelectListItem { Value = "Paid", Text = GlobalShared.Paid },
                                            new SelectListItem { Value = "Failed", Text = GlobalShared.Failed },
                                            new SelectListItem { Value = "Exception", Text = GlobalShared.Exception },
                                            new SelectListItem { Value = "Closed", Text = GlobalShared.Closed }
                                        },
                                        new { @class = "form-select form-select-sm" })
                                </div>
                                <div class="col-md-6">
                                    @Html.Label("FilterApprovalStatus", GlobalShared.Approval_status, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownList("FilterApprovalStatus",
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Value = "", Text = "--- All Statuses ---" },
                                            new SelectListItem { Value = "Pending", Text = GlobalShared.Pending },
                                            new SelectListItem { Value = "Approved", Text = GlobalShared.Approved },
                                            new SelectListItem { Value = "Rejected", Text = GlobalShared.Rejected },
                                            new SelectListItem { Value = "Reviewed", Text = GlobalShared.Reviewed },
                                            new SelectListItem { Value = "InProgress", Text = GlobalShared.In_Progress },
                                            new SelectListItem { Value = "Completed", Text = GlobalShared.Completed },
                                            new SelectListItem { Value = "Failed", Text = GlobalShared.Failed }
                                        },
                                        new { @class = "form-select form-select-sm" })
                                </div>
                            </div>
                        </div>

                        <!-- Date Range Filters Section -->
                        <div id="dateFiltersSection" class="filter-section mb-3 d-none">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-calendar-range me-1"></i>@GlobalShared.Date_Range_Information
                                    </h6>
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterTransferDateFrom", GlobalShared.Transfer_Date_From, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterTransferDateFrom", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterTransferDateTo", GlobalShared.Transfer_Date_To, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterTransferDateTo", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterApprovalDateFrom", GlobalShared.Approval_Date_From, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterApprovalDateFrom", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterApprovalDateTo", GlobalShared.Approval_Date_To, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterApprovalDateTo", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterCreatedDateFrom", GlobalShared.Created_Date_From, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterCreatedDateFrom", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Label("FilterCreatedDateTo", GlobalShared.Created_Date_To, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterCreatedDateTo", null, new { @class = "form-control form-control-sm", type = "date" })
                                </div>
                            </div>
                        </div>

                        <!-- Message Filters Section -->
                        <div id="messageFiltersSection" class="filter-section mb-3 d-none">
                            <div class="row g-2">
                                <div class="col-12">
                                    <h6 class="text-primary small fw-bold mb-2 border-bottom pb-1">
                                        <i class="mdi mdi-message-text me-1"></i>@GlobalShared.Message_Information
                                    </h6>
                                </div>
                                <div class="col-md-12">
                                    @Html.Label("FilterTransferMessage", GlobalShared.Transfer_Message, new { @class = "form-label small fw-bold" })
                                    @Html.TextBox("FilterTransferMessage", null, new { @class = "form-control form-control-sm", placeholder = "Search by transfer message..." })
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-2">
                            <div class="col-md-12 d-flex gap-2">
                                <button id="applyDetailsFilterBtn" type="button" class="btn btn-primary btn-sm flex-fill">
                                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Apply_Filter
                                </button>
                                <button id="resetDetailsFilterBtn" type="button" class="btn btn-secondary btn-sm flex-fill">
                                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="accordion" id="collapsibleSection">
        <div class="card accordion-item mb-3">
            <h2 class="accordion-header" id="headingMembers">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseMembers"
                        aria-expanded="false"
                        aria-controls="collapseMembers">
                    <i class="fas fa-users me-2"></i>@GlobalShared.Operation_members (@Model.TotalMembers)
                </button>
            </h2>



            <div id="collapseMembers" class="accordion-collapse collapse" aria-labelledby="headingMembers">
                <div class="accordion-body">
                    @Html.Partial("_SimulationDetailsDataTable", Model)
                </div>
            </div>
        </div>
    </div>

    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="headingActions">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseActions"
                    aria-expanded="false"
                    aria-controls="collapseActions">
                <i class="fas fa-tasks me-2"></i>@GlobalShared.Available_actions
            </button>
        </h2>
        <div id="collapseActions"
             class="accordion-collapse collapse"
             aria-labelledby="headingActions"
             data-bs-parent="#collapsibleSection">
            <div class="accordion-body">
                <div class="d-flex gap-2">
                    @if (@Model.ApprovalStatus == "Pending" || @Model.ApprovalStatus == "Failed" || @Model.ApprovalStatus == "Reviewed")
                    {
                        <button type="button" class="btn btn-primary" id="approveBulkOperation" data-simulation-id="@Model.Id">
                            <i class="fas fa-check me-1"></i> @GlobalShared.Perform_actions
                        </button>
                        @* <button type="button" class="btn btn-warning" id="reviewBulkOperation" data-simulation-id="@Model.Id">
                                <i class="fas fa-search me-1"></i> Send for Review
                            </button>*@
                    }
                    <button type="button" class="btn btn-info" data-bs-toggle="tooltip" title="@GlobalShared.Export bulk operation Analysis to Excel" onclick="exportBulkOperation('@Model.Id')">
                        <i class="fas fa-download me-1"></i> @GlobalShared.Export Bulk Operation to Excel
                    </button>
                    @*  <button type="button" class="btn btn-danger"  data-bs-toggle="tooltip" title="Delete bulk operation Analysis to Excel" onclick="deleteBulkOperation('@Model.Id','@Model.SimulationType')">
                            <i class="fas fa-trash me-1"></i> Delete Simulation
                        </button>*@
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Main Modal -->
<!-- Transfer Details Modal -->
<div class="modal fade" id="transferDetailsModal" tabindex="-1" aria-labelledby="transferDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="transferDetailsLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@GlobalBulkOperation.LoadingTransferDetails...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-bank-transfer me-2"></i>@GlobalShared.Transfer_details
                            </h1>
                            <p class="card-text lead">
                               @(string.IsNullOrWhiteSpace(Model.SimulationType)? "N/A" : Model.SimulationType?.ToUpper())
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section (optional) -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.AboutThisTransfer</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTransferTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseTransferTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-clock-outline text-primary me-2"></i><strong>@GlobalShared.Real_time:</strong> @GlobalBulkOperation.ShowsTheMostCurrentTransferStatus.</li>
                            <li><i class="mdi mdi-shield-check-outline text-success me-2"></i><strong>@GlobalShared.Secure:</strong> @GlobalBulkOperation.AllInformationIsEncrypted.</li>
                            <li><i class="mdi mdi-history text-warning me-2"></i><strong>@GlobalShared.Complete_history:</strong> @GlobalBulkOperation.ShowsFullTransactionDetails.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="modal-body p-4">
                <div id="transferDetailsContent" class="details-grid">
                    <!-- Content will be loaded dynamically -->
                    <div class="loading-container text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@GlobalShared.Loading...</span>
                        </div>
                        <p class="mt-2">@GlobalBulkOperation.LoadingTransferDetails...</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        @GlobalShared.Transaction_id: <span class="text-dark" id="transferTransactionId">@Model.Id</span>
                    </span>
                </div>
                <div class="text-center w-100">
                    <small class="text-muted">@GlobalShared.Powered_by FLX-CBS</small>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> @GlobalShared.Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>



