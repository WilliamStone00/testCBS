@model CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationSelectionModel


<div class="card-body">
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="operationType" id="specificAccountType"
               value="specific" checked="@(Model.SelectedOperationType == "specific")">
        <label class="form-check-label" for="specificAccountType">
            Simulate Share Top Up
        </label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="operationType" id="uniqueAccount"
               value="unique" checked="@(Model.SelectedOperationType == "unique")">
        <label class="form-check-label" for="uniqueAccount">
            Simulate Contribution
        </label>
    </div>

</div>
