@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" data-simulation-id="@Model.Id" id="myDataTable">
        <thead>
            <tr>
                <th style="width : 12%"> @GlobalShared.Date</th>
                <th style="width : 18%"> @GlobalShared.Member_name</th>
                <th style="width : 12%"> @GlobalShared.Branch_Name</th>
                <th style="width : 14%"> @GlobalShared.Source_account</th>
                <th style="width : 14%"> @GlobalShared.Destination_account</th>
                <th style="width : 8%"> @GlobalShared.Source_balance</th>
                <th style="width : 8%"> @GlobalShared.Amount_to_debit</th>
                <th style="width : 8%"> @GlobalShared.Actual_balance</th>
                <th style="width : 8%"> @GlobalShared.Approval_status</th>
                <th style="width : 10%">@GlobalShared.Transfer_Status</th>
                <th style="width : 6%"> @GlobalShared.Action</th>
            </tr>
        </thead>
    </table>
</div>




