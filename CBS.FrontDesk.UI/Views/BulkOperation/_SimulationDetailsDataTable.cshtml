@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" data-simulation-id="@Model.Id" id="myDataTable">
        <thead>
            <tr>
                <th> @GlobalBulkOperation.MemberName</th>
                <th> @GlobalBulkOperation.SourceAccount</th>
                <th> @GlobalBulkOperation.SourceBalance</th>
                <th> @GlobalBulkOperation.DestinationAccount</th>
                <th> @GlobalBulkOperation.AmountToDebit</th>
                <th> @GlobalBulkOperation.Status</th>
                <th>Transfer Status</th>
                <th> @GlobalBulkOperation.Action</th>
            </tr>
        </thead>
    </table>
</div>




