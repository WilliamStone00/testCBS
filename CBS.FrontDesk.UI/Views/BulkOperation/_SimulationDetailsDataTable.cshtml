@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" data-simulation-id="@Model.Id" id="myDataTable">
        <thead>
            <tr>
                <th style="width : 19%"> @GlobalBulkOperation.MemberName</th>
                <th style="width : 13%"> @GlobalBulkOperation.SourceAccount</th>
                <th style="width : 15%"> @GlobalBulkOperation.DestinationAccount</th>
                <th style="width : 10%"> @GlobalBulkOperation.SourceBalance</th>
                <th style="width : 10%"> @GlobalBulkOperation.AmountToDebit</th>
                <th style="width : 10%"> Actual Balance</th>
                <th style="width : 8%"> @GlobalBulkOperation.Status</th>
                <th style="width : 10%">Transfer Status</th>
                <th style="width : 5%"> @GlobalBulkOperation.Action</th>
            </tr>
        </thead>
    </table>
</div>




