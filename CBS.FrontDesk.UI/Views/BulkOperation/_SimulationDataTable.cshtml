@using Resources

<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle w-100" id="myDataTable">

        <!-- ✅ Column sizing -->
        <colgroup>
            <col style="width: 14%;" />  @* Date *@
            <col style="width: 12%;" />  @* Branch *@
            <col style="width: 20%;" />  @* SimulationType *@
            <col style="width: 12%;" />  @* BulkType *@
            <col style="width: 10%;" />  @* TotalAccounts *@
            <col style="width: 12%;" />  @* Volume *@
            <col style="width: 12%;" />  @* ApprovalStatus *@
            <col style="width: 8%;" />  @* Action *@
        </colgroup>

        <thead>
            <tr>
                <th>@GlobalBulkOperation.Date</th>
                <th>@GlobalBulkOperation.BranchName</th>
                @*<th>@GlobalBulkOperation.TransactionReference</th>*@
                <th>@GlobalBulkOperation.SimulationType</th>
                <th>@GlobalBulkOperation.BulkType</th>
                <th>@GlobalBulkOperation.TotalAccounts</th>
                <th>@GlobalBulkOperation.SimulationVolume</th>
                <th>@GlobalBulkOperation.ApprovalStatus</th>
                @* <th>@GlobalBulkOperation.ApprovalBy</th>
                    <th>@GlobalBulkOperation.ApprovalDate</th> *@
                <th>@GlobalBulkOperation.Action</th>
            </tr>
        </thead>

    </table>
</div>
