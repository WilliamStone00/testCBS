@model CBS.FrontDesk.Data.Entity.BulkOperation.GetBulkOperationDataTableQuery
@using Resources
@using Newtonsoft.Json

@{
    ViewBag.Title = GlobalBulkOperation.BulkOperationQueryOverview;
}

<style>
    /* Compact spacing */
    .compact .card {
        margin-bottom: .5rem !important;
    }

    .compact .card-body {
        padding: .75rem !important;
    }

    .compact .card-header {
        padding: .5rem .75rem !important;
    }

    .compact .form-label {
        margin-bottom: .2rem !important;
        font-size: 0.75rem;
    }

    .compact .form-check {
        margin-bottom: 0 !important;
    }

    .compact .row.g-1 > [class^="col-"] {
        margin-bottom: .5rem;
    }

    /* Badge styles */
    .badge-soft {
        background: rgba(13, 110, 253, .08);
        border: 1px solid rgba(13, 110, 253, .2);
        color: #0d6efd;
        font-weight: normal;
        padding: 0.35rem 0.65rem;
    }

    .badge-soft-warning {
        background: rgba(255, 193, 7, .08);
        border: 1px solid rgba(255, 193, 7, .2);
        color: #856404;
    }

    .badge-soft-success {
        background: rgba(40, 167, 69, .08);
        border: 1px solid rgba(40, 167, 69, .2);
        color: #1e7e34;
    }

    /* Accordion customization */
    .accordion-item {
        border: 1px solid rgba(0, 0, 0, .125);
        border-radius: 0.25rem;
        margin-bottom: 0.5rem;
    }

    .accordion-button {
        padding: 0.5rem 0.75rem;
        background-color: #f8f9fa;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0d6efd;
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(13, 110, 253, .25);
    }

    .accordion-body {
        padding: 1rem;
        background-color: white;
    }

    /* Filter section headers */
    .filter-section-header {
        background-color: #f8f9fc;
        padding: 0.5rem 0.75rem;
        border-radius: 0.25rem;
        margin-bottom: 0.75rem;
        border-left: 3px solid #0d6efd;
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Button consistency */
    .btn-sm i {
        font-size: 0.875rem;
    }

    .action-buttons-container {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    /* Workflow stepper */
    .workflow-step {
        position: relative;
    }

    .workflow-step:not(:last-child):after {
        content: "→";
        position: absolute;
        right: -10px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-weight: bold;
    }

    @*@media (max-width: 768px) {
        .workflow-step:not(:last-child):after {
            content: "↓";
            right: 50%;
            top: auto;
            bottom: -15px;
            transform: translateX(50%);
        }
    }

    /* Responsive improvements */
    @media (max-width: 576px) {
        .compact .card-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 0.5rem;
        }

        .compact .card-header div {
            width: 100%;
        }

        .btn-group-responsive {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
    }*@
</style>

<div class="compact">

    <!-- ========== HEADER SECTION ========== -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-gradient-light border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        @*<div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                                <i class="mdi mdi-database-export text-primary" style="font-size: 1.5rem;"></i>
                            </div>
                        </div>*@
                        <div class="flex-grow-1">
                            <h5 class="card-title text-primary mb-1">
                                @GlobalBulkOperation.BulkOperationManagement
                            </h5>
                            <p class="card-text text-muted small mb-0">
                                @GlobalBulkOperation.Run_bulk_simulations_and_approvals_safely_filter_preview_then_execute.
                            </p>
                        </div>
                    </div>
                    <div class="alert alert-info border-0 bg-info bg-opacity-10 mt-2 mb-0 small py-2">
                        <i class="mdi mdi-shield-check-outline text-info me-2"></i>
                        <strong class="text-dark">@GlobalShared.Pro_Tip:</strong>
                        <span class="text-secondary">@GlobalBulkOperation.Use_Branch_Status_Date_Range_together_to_narrow_results_before_opening_details_or_approvals</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== WORKFLOW ACCORDION ========== -->
    <div class="accordion mb-2" id="workflowAccordion">
        <div class="accordion-item border-0 shadow-sm">
            <h2 class="accordion-header" id="headingWorkflow">
                <button class="accordion-button bg-light" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseWorkflow"
                        aria-expanded="true"
                        aria-controls="collapseWorkflow">
                    <i class="mdi mdi-road-variant text-primary me-2"></i>
                    @GlobalBulkOperation.Bulk_Operation_Workflow
                </button>
            </h2>
            <div id="collapseWorkflow" class="accordion-collapse collapse show"
                 aria-labelledby="headingWorkflow"
                 data-bs-parent="#workflowAccordion">
                <div class="accordion-body">
                    <div class="row text-center g-2">
                        <div class="col-6 col-md-3 workflow-step">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2" style="width: 40px; height: 40px; line-height: 40px;">
                                <span class="fw-bold text-primary">1</span>
                            </div>
                            <h6 class="mb-0 small fw-bold">@GlobalBulkOperation.Simulate</h6>
                            <small class="text-muted d-block">@GlobalBulkOperation.Create_a_simulation_batch</small>
                        </div>
                        <div class="col-6 col-md-3 workflow-step">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2" style="width: 40px; height: 40px; line-height: 40px;">
                                <span class="fw-bold text-primary">2</span>
                            </div>
                            <h6 class="mb-0 small fw-bold">@GlobalShared.Filter</h6>
                            <small class="text-muted d-block">@GlobalShared.Apply_Branch / @GlobalShared.Status / @GlobalShared.Date</small>
                        </div>
                        <div class="col-6 col-md-3 workflow-step">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2" style="width: 40px; height: 40px; line-height: 40px;">
                                <span class="fw-bold text-primary">3</span>
                            </div>
                            <h6 class="mb-0 small fw-bold">@GlobalBulkOperation.Review</h6>
                            <small class="text-muted d-block">@GlobalBulkOperation.Open_details_and_verify_totals</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2" style="width: 40px; height: 40px; line-height: 40px;">
                                <span class="fw-bold text-primary">4</span>
                            </div>
                            <h6 class="mb-0 small fw-bold">@GlobalShared.Approve / @GlobalShared.Execute</h6>
                            <small class="text-muted d-block">@GlobalBulkOperation.Finalize_the_bulk_action</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== TIPS ACCORDION ========== -->
    <div class="accordion mb-2" id="tipsAccordion">
        <div class="accordion-item border-0 shadow-sm">
            <h2 class="accordion-header" id="headingTips">
                <button class="accordion-button bg-light" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseTips"
                        aria-expanded="true"
                        aria-controls="collapseTips">
                    <i class="mdi mdi-information-outline text-primary me-2"></i>
                    @GlobalBulkOperation.TIPSFORBulkOPERATIONSFILTERING
                </button>
            </h2>
            <div id="collapseTips" class="accordion-collapse collapse show"
                 aria-labelledby="headingTips"
                 data-bs-parent="#tipsAccordion">
                <div class="accordion-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-2 rounded bg-light bg-opacity-50">
                                <i class="mdi mdi-office-building text-primary me-2 mt-1"></i>
                                <div>
                                    <strong class="small d-block">@GlobalShared.Branch:</strong>
                                    <span class="small text-muted">@GlobalBulkOperation.Filter_operations_initiated_from_a_specific_branch.</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-2 rounded bg-light bg-opacity-50">
                                <i class="mdi mdi-toggle-switch text-warning me-2 mt-1"></i>
                                <div>
                                    <strong class="small d-block">@GlobalShared.Status:</strong>
                                    <span class="small text-muted">@GlobalBulkOperation.Use_status_to_quickly_identify_what_needs_action</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-2 rounded bg-light bg-opacity-50">
                                <i class="mdi mdi-calendar-range text-info me-2 mt-1"></i>
                                <div>
                                    <strong class="small d-block">@GlobalShared.Date_Range:</strong>
                                    <span class="small text-muted">@GlobalBulkOperation.Narrow_by_creation_date_to_isolate_todays_last_weeks_simulations_and_reduce_noise</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-2 rounded bg-light bg-opacity-50">
                                <i class="mdi mdi-filter-plus text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="small d-block">@GlobalShared.Best_Practice:</strong>
                                    <span class="small text-muted">@GlobalBulkOperation.Combine_filters_then_sort_by_Date_descending_to_see_most_recent_work_first</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 small mt-2 mb-0 py-2">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        @Html.Raw(@GlobalBulkOperation.Always_open_Details_before_approval_to_confirm_totals_member_count_and_simulation_type)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== ACTION BUTTONS ========== -->
    <div class="row mb-2 g-2">
        <div class="col-12 col-md-6">
            <a href="/BulkOperation" class="btn btn-primary w-100 btn-sm shadow-sm">
                <i class="mdi mdi-account-plus-outline me-1"></i>
                @GlobalBulkOperation.SimulateARangeBulkOperation
            </a>
        </div>
        <div class="col-12 col-md-6">
            <a href="/BulkOperation/BulkCashOperation" class="btn btn-outline-primary w-100 btn-sm shadow-sm">
                <i class="mdi mdi-cash me-1"></i>
                @GlobalBulkOperation.SimulateBulkCashOperation
            </a>
        </div>
    </div>

    <!-- ========== FILTER PANEL ACCORDION ========== -->
    <div class="accordion mb-2" id="filterAccordion">
        <div class="accordion-item border-0 shadow-sm">
            <h2 class="accordion-header" id="headingFilters">
                <button class="accordion-button bg-light" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseFilters"
                        aria-expanded="true"
                        aria-controls="collapseFilters">
                    <i class="mdi mdi-filter-outline text-primary me-2"></i>
                    @GlobalBulkOperation.AdvancedUserFilters
                    <span class="badge badge-soft ms-2" id="activeFiltersBadge" style="display:none;">
                        <i class="mdi mdi-filter-variant me-1"></i> @GlobalShared.Active_filters_applied
                    </span>
                </button>
            </h2>
            <div id="collapseFilters" class="accordion-collapse collapse show"
                 aria-labelledby="headingFilters"
                 data-bs-parent="#filterAccordion">
                <div class="accordion-body">

                    <!-- Filter Toggles -->
                    <div class="d-flex flex-wrap gap-3 align-items-center mb-3 pb-2 border-bottom">
                        <span class="small fw-bold text-muted">
                            <i class="mdi mdi-eye-settings me-1"></i>@GlobalShared.Show_Filters:
                        </span>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="byBranch" checked />
                            <label class="form-check-label small" for="byBranch">
                                <i class="mdi mdi-office-building text-primary me-1"></i>@GlobalShared.Branch
                            </label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="byStatus" />
                            <label class="form-check-label small" for="byStatus">
                                <i class="mdi mdi-toggle-switch text-warning me-1"></i>@GlobalShared.Status
                            </label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="checkbox" id="byDate" />
                            <label class="form-check-label small" for="byDate">
                                <i class="mdi mdi-calendar-range text-info me-1"></i>@GlobalShared.Date_Range
                            </label>
                        </div>
                    </div>

                    @using (Html.BeginForm(null, null, FormMethod.Get, new { id = "bulkFilterForm", autocomplete = "off" }))
                    {
                        <!-- Branch Filter -->
                        <div id="branchFilterSection" class="mb-3">
                            <div class="filter-section-header">
                                <i class="mdi mdi-office-building me-1"></i> @GlobalShared.Branch_Information
                            </div>
                            <div class="row g-2">
                                <div class="col-md-12">
                                    @Html.LabelFor(m => m.BranchId, GlobalShared.SelectBranch, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownListFor(
                                        m => m.BranchId,
                                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name", Model?.BranchId),
                                        "--- " + GlobalShared.SelectBranch + " ---",
                                        new { @class = "form-select form-select-sm select2", id = "BranchId" })
                                </div>
                            </div>
                        </div>

                        <!-- Status Filter (Hidden by default) -->
                        <div id="statusFilterSection" class="mb-3 d-none">
                            <div class="filter-section-header">
                                <i class="mdi mdi-toggle-switch me-1"></i> @GlobalShared.Status_Information
                            </div>
                            <div class="row g-2">
                                <div class="col-md-12">
                                    @Html.LabelFor(m => m.Status, GlobalShared.Select_status, new { @class = "form-label small fw-bold" })
                                    @Html.DropDownListFor(
                                        m => m.Status,
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Value = "", Text = "--- " + GlobalShared.All_Statuses + " ---" },
                                            new SelectListItem { Value = "Pending", Text = GlobalShared.Pending },
                                            new SelectListItem { Value = "Accepted", Text = GlobalShared.Accepted },
                                            new SelectListItem { Value = "Rejected", Text = GlobalShared.Rejected },
                                            new SelectListItem { Value = "NoValidAccounts", Text = GlobalShared.No_Valid_Accounts },
                                            new SelectListItem { Value = "BulkProcessInitiated", Text = GlobalBulkOperation.BulkProcessInitiated },
                                            new SelectListItem { Value = "Executed", Text = GlobalShared.Executed },
                                            new SelectListItem { Value = "Failed", Text = GlobalShared.Failed },
                                            new SelectListItem { Value = "ProcessingApproval", Text = GlobalShared.Processing_approval },
                                            new SelectListItem { Value = "Approved", Text = GlobalShared.Approved }
                                        },
                                        new { @class = "form-select form-select-sm select2", id = "Status" })
                                </div>
                            </div>
                        </div>

                        <!-- Date Range Filter (Hidden by default) -->
                        <div id="dateRangeSection" class="mb-3 d-none">
                            <div class="filter-section-header">
                                <i class="mdi mdi-calendar-range me-1"></i> @GlobalShared.Date_Range_Information
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.StartDate, GlobalShared.From_Date, new { @class = "form-label small fw-bold" })
                                    @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control form-control-sm", type = "date", id = "StartDate" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.EndDate, GlobalShared.To_Date, new { @class = "form-label small fw-bold" })
                                    @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control form-control-sm", type = "date", id = "EndDate" })
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-2">
                            <div class="col-md-12 d-flex gap-2">
                                <button id="applyFilterBtn" type="button" class="btn btn-primary btn-sm flex-fill">
                                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Apply_Filter
                                </button>
                                <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm flex-fill">
                                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ========== RESULTS TABLE ACCORDION ========== -->
    <div class="accordion" id="resultsAccordion">
        <div class="accordion-item border-0 shadow-sm">
            <h2 class="accordion-header" id="headingResults">
                <button class="accordion-button bg-light" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseResults"
                        aria-expanded="true"
                        aria-controls="collapseResults">
                    <i class="mdi mdi-table text-primary me-2"></i>
                    @GlobalBulkOperation.FilteredResults
                    <span class="badge bg-primary bg-opacity-10 text-primary ms-2" id="resultsCountBadge">0</span>
                </button>
            </h2>
            <div id="collapseResults" class="accordion-collapse collapse show"
                 aria-labelledby="headingResults"
                 data-bs-parent="#resultsAccordion">
                <div class="accordion-body p-0">
                    <div class="table-responsive">
                        @Html.Partial("_model")
                        <div id="userTableView">
                            @Html.Partial("_SimulationDataTable")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function ($) {
            'use strict';

            let table = null;

            function setActiveFiltersBadge() {
                const byBranch = $('#byBranch').is(':checked') && ($('#BranchId').val() || '').length > 0;
                const byStatus = $('#byStatus').is(':checked') && ($('#Status').val() || '').length > 0;
                const byDate = $('#byDate').is(':checked') && (($('#StartDate').val() || '').length > 0 || ($('#EndDate').val() || '').length > 0);

                const any = byBranch || byStatus || byDate;
                $('#activeFiltersBadge').toggle(any);
            }

            function resetFilterForm() {
                // values
                $('#StartDate, #EndDate').val('');
                $('#BranchId').val('').trigger('change');
                $('#Status').val('').trigger('change');

                // toggles default state
                $('#byBranch').prop('checked', true);
                $('#byStatus').prop('checked', false);
                $('#byDate').prop('checked', false);

                // sections visibility
                $('#branchFilterSection').removeClass('d-none');
                $('#statusFilterSection').addClass('d-none');
                $('#dateRangeSection').addClass('d-none');

                setActiveFiltersBadge();
            }

            function initFilterToggles() {
                $('#byBranch').on('change', function () {
                    const isChecked = $(this).is(':checked');
                    $('#branchFilterSection').toggleClass('d-none', !isChecked);
                    if (!isChecked) $('#BranchId').val('').trigger('change');
                    setActiveFiltersBadge();
                });

                $('#byStatus').on('change', function () {
                    const isChecked = $(this).is(':checked');
                    $('#statusFilterSection').toggleClass('d-none', !isChecked);
                    if (!isChecked) $('#Status').val('').trigger('change');
                    setActiveFiltersBadge();
                });

                $('#byDate').on('change', function () {
                    const isChecked = $(this).is(':checked');
                    $('#dateRangeSection').toggleClass('d-none', !isChecked);
                    if (!isChecked) $('#StartDate, #EndDate').val('');
                    setActiveFiltersBadge();
                });

                // also update badge when filters change
                $('#BranchId, #Status, #StartDate, #EndDate').on('change', setActiveFiltersBadge);
            }

            function collectBulkFilters(d) {
                const byBranch = $('#byBranch').is(':checked');
                const byStatus = $('#byStatus').is(':checked');
                const byDate = $('#byDate').is(':checked');

                const branchId = byBranch ? ($('#BranchId').val() || null) : null;
                const status = byStatus ? ($('#Status').val() || null) : null;
                const startDate = byDate ? ($('#StartDate').val() || null) : null;
                const endDate = byDate ? ($('#EndDate').val() || null) : null;

                let sortColumnName = '';
                let sortColumnDirection = '';

                if (d && d.order && d.order.length > 0) {
                    const order = d.order[0];
                    const colIdx = order.column;
                    sortColumnDirection = order.dir;

                    if (d.columns && d.columns[colIdx]) {
                        sortColumnName = d.columns[colIdx].data || '';
                    }
                }

                return {
                    branchId: branchId,
                    status: status,
                    startDate: startDate,
                    endDate: endDate,
                    options: {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        skip: d.start,
                        pageSize: d.length,
                        searchValue: d.search ? (d.search.value || '') : '',
                        sortColumnName: sortColumnName,
                        sortColumnDirection: sortColumnDirection
                    }
                };
            }

            function initOrReloadTable() {

                // If already created, just reload with current filters
                if (table && $.fn.DataTable.isDataTable('#myDataTable')) {
                    table.ajax.reload(null, true);
                    return;
                }

                table = $('#myDataTable').DataTable({
                    processing: false,
                    serverSide: true,
                    responsive: true,
                    ajax: {
                        url: '/BulkOperation/LoadBulkOperationData',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: function (d) {
                            const payload = collectBulkFilters(d);
                            return JSON.stringify(payload);
                        },
                        dataSrc: function (json) {
                            return json && json.data ? json.data : [];
                        }
                    },
                    columns: [
                        {
                            data: 'CreatedDate',
                            title: '@GlobalShared.Date',
                            render: function (data) {
                                if (!data) return 'N/A';
                                return window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data;
                            }
                        },
                        {
                            data: 'InitiatorBranchName',
                            name: 'InitiatorBranchName',
                            title: '@GlobalShared.Branch_Name',
                            render: function (data) { return data || 'N/A'; }
                        },
                  @*      {
                            data: 'TransactionReference',
                            name: 'TransactionReference',
                            title: '@GlobalBulkOperation.TransactionReference',
                            render: function (data) { return data || 'N/A'; }
                        },*@
                        {
                            data: 'SimulationType',
                            name: 'SimulationType',
                            title: '@GlobalShared.Simulation_type',
                            render: function (data) { return data || 'N/A'; }
                        },
                        {
                            data: 'BulkType',
                            name: 'BulkType',
                            title: '@GlobalBulkOperation.BulkType',
                            render: function (data) { return data || 'N/A'; }
                        },
                        {
                            data: 'TotalMembers',
                            name: 'TotalMembers',
                            title: '@GlobalShared.Total_accounts',
                            render: function (data) { return data ?? 0; }
                        },
                        {
                            data: 'TotalVolume',
                            name: 'TotalVolume',
                            title: '@GlobalShared.Simulation_volume',
                            render: function (data) {
                                if (data == null) return '0.0';
                                return new Intl.NumberFormat('en-NG', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(data);
                            }
                        },
                        {
                            data: 'ApprovalStatus',
                            name: 'ApprovalStatus',
                            title: '@GlobalShared.Approval_status',
                            render: function (data) {
                                if (!data) return '';

                                const map = {
                                    Pending: { class: 'bg-warning text-dark', label: 'Pending' },
                                    Accepted: { class: 'bg-primary text-white', label: 'Accepted' },
                                    Rejected: { class: 'bg-danger text-white', label: 'Rejected' },
                                    NoValidAccounts: { class: 'bg-dark text-white', label: 'No valid accounts' },
                                    BulkProcessInitiated: { class: 'bg-info text-white', label: 'Bulk process initiated' },
                                    Executed: { class: 'bg-success text-white', label: 'Executed' },
                                    Failed: { class: 'bg-danger text-white', label: 'Failed' },
                                    ProcessingApproval: { class: 'bg-secondary text-white', label: 'Processing approval' },
                                    Approved: { class: 'bg-success text-white', label: 'Approved' }
                                };

                                const item = map[data] || { class: 'bg-secondary text-white', label: data.replace(/([a-z])([A-Z])/g, '$1 $2') };
                                return `<span class="badge ${item.class}">${item.label}</span>`;
                            }
                        },
                       @* {
                            data: 'ApprovalBy',
                            name: 'ApprovalBy',
                            title: '@GlobalBulkOperation.ApprovalBy',
                            render: function (data) { return data || 'N/A'; }
                        },
                        {
                            data: 'ApprovalValidationDate',
                            name: 'ApprovalValidationDate',
                            title: '@GlobalBulkOperation.ApprovalDate',
                            render: function (data) {
                                if (!data) return 'N/A';
                                const d = new Date(data);
                                if (isNaN(d.getTime())) return 'N/A';
                                const minDate = new Date('0001-01-01T00:00:00');
                                if (d.getTime() <= minDate.getTime()) return 'N/A';
                                return window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data;
                            }
                        },*@
                        {
                            data: 'Id',
                            orderable: false,
                            searchable: false,
                            title: '@GlobalShared.Action',
                            render: function (id) {
                                if (!id) return '';
                                return `
                                    <div class="text-center">
                                        <a href="/BulkOperation/Details?KEY=${id}" target="_Blank"
                                           class="btn btn-sm btn-outline-primary"
                                           title="@GlobalShared.ViewDetails">
                                            <i class="mdi mdi-eye me-1"></i> @GlobalShared.View
                                        </a>
                                    </div>`;
                            }
                        }
                    ],
                    order: [[0, 'desc']],
                    lengthMenu: [10, 25, 50, 100],
                    pageLength: 10,
                    language: {
                        emptyTable: 'No Bulk Operations available for the selected criteria.',
                        search: 'Search:'
                    }
                });
            }

            function bindFilterActions() {
                $('#applyFilterBtn').on('click', function (e) {
                    e.preventDefault();
                    setActiveFiltersBadge();
                    initOrReloadTable();
                });

                $('#resetFilterBtn').on('click', function (e) {
                    e.preventDefault();
                    resetFilterForm();
                    initOrReloadTable();
                });

                $('#bulkFilterForm').on('keypress', 'input,select', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        setActiveFiltersBadge();
                        initOrReloadTable();
                    }
                });
            }

            $(function () {
                if ($.fn.select2) {
                    try {
                        $('#BranchId').select2({ width: '100%', placeholder: '@GlobalShared.SelectBranch' });
                        $('#Status').select2({ width: '100%', placeholder: '@GlobalShared.Select_status' });
                    } catch (e) {
                        console.warn('select2 init failed', e);
                    }
                }

                initFilterToggles();
                bindFilterActions();
                setActiveFiltersBadge();

                // ✅ Load table on page load (recommended)
                //initOrReloadTable();
            });

        })(jQuery);
    </script>
}
