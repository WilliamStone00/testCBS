<!-- Workflow Guidance Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-road-variant text-primary me-1"></i>  Bulk Operation Workflow</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="collapseTips" class="collapse show">
        <div class="card-body">
            <div class="steps">
                <div class="step">
                    <div class="step-number bg-light text-primary">1</div>
                    <div class="step-content">
                        <h6>Simulate</h6>
                        <p class="small text-muted">Simulate an operation </p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number bg-light text-primary">2</div>
                    <div class="step-content">
                        <h6>Filter & Select</h6>
                        <p class="small text-muted">Use the filters below to target specific records</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number bg-light text-primary">3</div>
                    <div class="step-content">
                        <h6>Preview</h6>
                        <p class="small text-muted">Review selected records in the data table</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number bg-light text-primary">4</div>
                    <div class="step-content">
                        <h6>Execute</h6>
                        <p class="small text-muted">Complete the bulk operation</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Filtering Tips Section -->
<div class="card  mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-filter-outline text-primary me-1"></i> @GlobalBulkOperation.TIPSFORBulkOPERATIONSFILTERING</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="collapseTips" class="collapse show">
        <div class="card-body">
            <div class="row">
