@using Resources
@{
    ViewBag.Title = @GlobalBulkOperation.BulkOperationQueryOverview;
}
@using Newtonsoft.Json;

<style>
    .steps {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

    .steps:before {
        content: "";
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: #e9ecef;
        z-index: 1;
    }

    .step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
    }

    .step-number {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        font-weight: bold;
        border: 3px solid white;
    }

    .step-content {
        padding: 0 10px;
    }

    .filter-section {
        transition: all 0.3s ease;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 5px;
    }
</style>

<div class="row">
    <div class="col-12">
        <!-- Enhanced Header Section -->
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-database-export me-2"></i> @GlobalBulkOperation.BulkOperationManagement
                </h1>
                <p class="card-text lead">
                    Execute batch actions across multiple users accounts with precision and control.
                </p>
                <div class="alert alert-light border-primary mb-0 mt-3">
                    <i class="mdi mdi-alert-circle-outline text-primary me-2"></i>
                    <strong>Pro Tip:</strong> @GlobalBulkOperation.UseFiltersToRefineSelectionsBeforeApplyingBulkChanges.
                </div>
                <hr class="my-3" style="border: 2px solid rgba(128, 128, 128, 0.3);" />
            </div>
        </div>
    </div>
</div>

