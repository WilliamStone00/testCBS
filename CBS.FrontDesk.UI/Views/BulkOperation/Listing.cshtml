    <!-- Filter Panel -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-filter-outline text-primary me-1"></i> @GlobalBulkOperation.AdvancedUserFilters</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="collapseTips" class="collapse show">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="filter-toggle-group mb-3">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="byBranch" checked>
                            <label class="form-check-label" for="byBranch">@GlobalBulkOperation.Branch</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="byStatus">
                            <label class="form-check-label" for="byStatus">@GlobalBulkOperation.Status</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="byDate">
                            <label class="form-check-label" for="byDate">@GlobalBulkOperation.FilterByBetweenDates</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Filter Sections -->
            <div id="branchFilterSection" class="filter-section mb-3">
                <label class="form-label fw-bold">@GlobalBulkOperation.SelectBranch</label>
                @Html.DropDownList("branchInput", new SelectList(ViewBag.Branches, "Id", "Name"),
                    "---" + @GlobalBulkOperation.SelectBranch + "---",
                    new { @class = "form-select select2", id = "branchInput" })
            </div>

            <div id="statusFilterSection" class="filter-section mb-3" style="display:none;">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalBulkOperation.SelectStatus</label>
                        <select class="form-select select2" id="statusInput">
                            <option value="">--- @GlobalBulkOperation.AllStatuses ---</option>
                            <option value="Approved">@GlobalBulkOperation.Approved</option>
                            <option value="Pending">@GlobalBulkOperation.Pending</option>
                            <option value="Reviewed">@GlobalBulkOperation.Reviewed</option>
                            <option value="Rejected">@GlobalBulkOperation.Rejected</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="dateRangeSection" class="filter-section mb-3" style="display:none;">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalBulkOperation.FromDate</label>
                        <input type="date" id="createdFrom" class="form-control" placeholder="@GlobalBulkOperation.CreatedFrom" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalBulkOperation.ToDate</label>
                        <input type="date" id="createdTo" class="form-control" placeholder="@GlobalBulkOperation.CreatedTo" />
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="row mt-4">
                <div class="col-md-12 d-flex gap-2">
                    <button id="applyFilterBtn" class="btn btn-primary flex-grow-1">
                        <i class="mdi mdi-magnify me-1"></i> Apply Filters
                    </button>
                    <button id="resetFilterBtn" class="btn btn-outline-secondary flex-grow-1">
                        <i class="mdi mdi-refresh me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
    
 </div>


