@using Resources
@{
    ViewBag.Title = @GlobalBulkOperation.BulkOperationQueryOverview;
}
@using Newtonsoft.Json;

<div class="row">
    <div class="col-12">
        <!-- Enhanced Header Section -->
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-database-export me-2"></i> @GlobalBulkOperation.BulkOperationManagement
                </h1>
                <p class="card-text lead">
                    Execute batch actions across multiple users accounts with precision and control.
                </p>
                <div class="alert alert-light border-primary mb-0 mt-3">
                    <i class="mdi mdi-alert-circle-outline text-primary me-2"></i>
                    <strong>Pro Tip:</strong> @GlobalBulkOperation.UseFiltersToRefineSelectionsBeforeApplyingBulkChanges
                </div>
                <hr class="my-3" />
            </div>
        </div>
    </div>
</div>

<!-- Workflow Guidance Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-road-variant text-primary me-1"></i> Bulk Operation Workflow</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#workflowSteps" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="workflowSteps" class="collapse show">
        <div class="card-body">
            <div class="row text-center">
                <div class="col">
                    <div class="fw-bold text-primary">1</div>
                    <h6>Simulate</h6>
                    <small class="text-muted">Simulate an operation</small>
                </div>
                <div class="col">
                    <div class="fw-bold text-primary">2</div>
                    <h6>Filter & Select</h6>
                    <small class="text-muted">Use filters below</small>
                </div>
                <div class="col">
                    <div class="fw-bold text-primary">3</div>
                    <h6>Preview</h6>
                    <small class="text-muted">Review selected records</small>
                </div>
                <div class="col">
                    <div class="fw-bold text-primary">4</div>
                    <h6>Execute</h6>
                    <small class="text-muted">Complete bulk operation</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtering Tips Section -->
<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-filter-outline text-primary me-1"></i> @GlobalBulkOperation.TIPSFORBulkOPERATIONSFILTERING</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="filterTips" class="collapse show">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="alert alert-light border">
                        <i class="mdi mdi-office-building text-primary me-2"></i>
                        <strong>@GlobalBulkOperation.Branch:</strong>
                        <span class="small">@GlobalBulkOperation.FilterUsersByOrganizationalBranchOrLocation</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-light border">
                        <i class="mdi mdi-toggle-switch text-warning me-2"></i>
                        <strong>@GlobalBulkOperation.Status:</strong>
                        <span class="small">@GlobalBulkOperation.FilterByActiveInactiveCompletedOrSuspendedAccounts</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-light border">
                        <i class="mdi mdi-calendar-range text-info me-2"></i>
                        <strong>Date Range:</strong>
                        <span class="small">@GlobalBulkOperation.SetTheStartDateRangeForUserRegistrationActivity</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-light border">
                        <i class="mdi mdi-filter-plus text-success me-2"></i>
                        <strong>Combined Filters:</strong>
                        <span class="small">@GlobalBulkOperation.CombineFilters</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="row mb-3">
    <div class="col-md-6 text-end">
        <a href="/BulkOperation" class="btn btn-primary shadow-sm px-4">
            <i class="mdi mdi-account-plus-outline me-1"></i> @GlobalBulkOperation.SimulateARangeBulkOperation
        </a>
    </div>
    <div class="col-md-6 text-start">
        <a href="/BulkOperation/BulkCashOperation" class="btn btn-primary shadow-sm px-4">
            <i class="mdi mdi-cash me-1"></i> @GlobalBulkOperation.SimulateBulkCashOperation
        </a>
    </div>
</div>

<!-- Filter Panel -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-filter-outline text-primary me-1"></i> @GlobalBulkOperation.AdvancedUserFilters</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="advancedFilters" class="collapse show">
        <div class="card-body">

            <!-- Toggle Checkboxes -->
            <div class="mb-3">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="byBranch" checked>
                    <label class="form-check-label" for="byBranch">@GlobalBulkOperation.Branch</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="byStatus">
                    <label class="form-check-label" for="byStatus">@GlobalBulkOperation.Status</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="byDate">
                    <label class="form-check-label" for="byDate">@GlobalBulkOperation.FilterByBetweenDates</label>
                </div>
            </div>

            <!-- Branch Filter -->
            <div id="branchFilterSection" class="mb-3">
                <label class="form-label fw-bold">@GlobalBulkOperation.SelectBranch</label>
                @if (ViewBag.Branches != null && ((IEnumerable<dynamic>)ViewBag.Branches).Any())
                {
                    var firstBranch = ((IEnumerable<dynamic>)ViewBag.Branches).First();
                    @Html.DropDownList("branchInput", new SelectList(ViewBag.Branches, "Id", "Name", firstBranch.Id),
                        "---" + @GlobalBulkOperation.SelectBranch + "---",
                        new { @class = "form-select select2", id = "branchInput" })
                }
                else
                {
                    @Html.DropDownList("branchInput", new SelectList(ViewBag.Branches, "Id", "Name"),
                        "---" + @GlobalBulkOperation.SelectBranch + "---",
                        new { @class = "form-select select2", id = "branchInput" })
                }
            </div>

            <!-- Status Filter -->
            <div id="statusFilterSection" class="mb-3 d-none">
                <label class="form-label fw-bold">@GlobalBulkOperation.SelectStatus</label>
                <select class="form-select select2" id="statusInput">
                    <option value="">--- @GlobalBulkOperation.AllStatuses ---</option>
                    <option value="Approved">@GlobalBulkOperation.ApprovedFilter</option>
                    <option value="Pending">@GlobalBulkOperation.PendingFilter</option>
                    <option value="Reviewed">@GlobalBulkOperation.ReviewedFilter</option>
                    <option value="Failed">@GlobalBulkOperation.FailedFilter</option>
                    <option value="Rejected">@GlobalBulkOperation.RejectedFilter</option>
                    <option value="Completed">@GlobalBulkOperation.CompletedFilter</option>
                    <option value="ProcessingApproval">@GlobalBulkOperation.ProcessingApprovalFilter</option>
                </select>
            </div>

            <!-- Date Range Filter -->
            <div id="dateRangeSection" class="mb-3 d-none">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalBulkOperation.FromDate</label>
                        <input type="date" id="createdFrom" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalBulkOperation.ToDate</label>
                        <input type="date" id="createdTo" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 mt-3">
                <button id="applyFilterBtn" class="btn btn-primary flex-grow-1">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
                <button id="resetFilterBtn" class="btn btn-outline-secondary flex-grow-1">
                    <i class="mdi mdi-refresh me-1"></i> Reset
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Data Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-table text-primary me-1"></i> Filtered Results</h6>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#resultsTable" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="resultsTable" class="collapse show">
        <div class="card-body">
            @Html.Partial("_model")
            <div id="userTableView">
                @Html.Partial("_SimulationDataTable")
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>

        $(document).ready(function () {
            initFilterToggles();
            //loadBulkOperationDataTable();
            bindFilterActions();
        });

        function resetFilterForm() {
            $(' #createdFrom, #createdTo').val('');
            $('#isActive, #isBlocked, #isVerified').val('');
            $('#branchInput').val('').trigger('change');
            $('#byBranch, #byUser, #byDate').prop('checked', false);
            $('#branchFilterSection, #statusFilterSection, #dateRangeSection').hide();
        }

        // ✅ Filter toggle control
        function initFilterToggles() {
            $('#byBranch').change(function () {
                $('#branchFilterSection').toggleClass('d-none', !this.checked);
                if (!this.checked) $('#branchInput').val('').trigger('change');
            });

            $('#byStatus').change(function () {
                $('#statusFilterSection').toggleClass('d-none', !this.checked);
                if (!this.checked) $('#statusInput').val('').trigger('change');
            });

            $('#byDate').change(function () {
                $('#dateRangeSection').toggleClass('d-none', !this.checked);
                if (!this.checked) $('#createdFrom, #createdTo').val('');
            });
        }


        // 🎯 Bind button actions
        function bindFilterActions() {
            const table = $('#myDataTable').DataTable();

            $('#applyFilterBtn').click(() => {
                //if (!isDateRangeValid()) return;
                initFilterToggles();
                loadBulkOperationDataTable();
            });

            $('#resetFilterBtn').click(() => {
                resetFilterForm();
                //table.ajax.reload();
            });

            $('#exportBtn').click(() => {
                if (!isDateRangeValid()) return;
                const query = $.param(collectFilterData());
                window.location.href = `/UserManagement/DownloadUsers?${query}`;
            });
        }

        function getSearchParameters(d) {
            d.searchCriteria = $('#searchCriteria').val();
            d.dateFrom = $('#dateFrom').val();
            d.dateTo = $('#dateTo').val();
            d.status = $('#status').val();
            d.branchid = $('#branchInput').val();
        }

        function loadBulkOperationDataTable() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                searching: true,
                order: [[0, 'desc']], // Requested At
                ajax: {
                    url: '/BulkOperation/LoadBulkOperationData',
                    type: 'POST',
                    data: getSearchParameters,
                    dataSrc: function (json) {
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        title: 'Date',
                        render: (data) => moment(data).format('DD/MM/YYYY HH:mm:ss')
                    },
                    {
                        data: 'BranchName',
                        title: 'Branch Name',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'SimulationType',
                        title: 'Simulation Type',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'TotalMembers',
                        title: 'Total Accounts',
                        render: (data) => data
                    },
                    {
                        data: 'TotalVolume',
                        title: 'Total Volume',
                        render: (data) => formatCurrency(data)
                    },
                    {
                        data: 'CreatedBy',
                        title: 'Created By',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'ApprovalStatus',
                        title: 'Approval Status',
                        render: (data) => {
                            let badgeClass = '';
                            switch (data) {
                                case 'Pending':
                                    badgeClass = 'bg-warning text-dark';
                                    break;
                                case 'Reviewed':
                                    badgeClass = 'bg-info text-white';
                                    break;
                                case 'Approved':
                                    badgeClass = 'bg-success text-white';
                                    break;
                                default:
                                    badgeClass = 'bg-secondary text-white';
                            }
                            return `<span class="badge ${badgeClass}">${data}</span>`;
                        }
                    },
                    {
                        data: 'ApprovalBy',
                        title: 'Approval By',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'ApprovalValidationDate',
                        title: 'Approval Date',
                        render: (data) => {
                            const csharpMinDate = new Date('0001-01-01T00:00:00');
                            if (!data || new Date(data).getTime() <= csharpMinDate.getTime()) {
                                return 'N/A';
                            }
                            return moment(data).format('DD/MM/YYYY HH:mm:ss');
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (id) {
                            return `
                                            <div class="text-center">
                                                <a href="/BulkOperation/Details?KEY=${id}" class="btn btn-sm btn-outline-primary" title="Detail Simulation">
                                                <i class="fas fa-user-cog me-1"></i> View </a>
                                            </div>`;
                        }
                    }
                ],
                language: {
                    emptyTable: "No Bulk Oprations available for the selected criteria.",
                    //"processing": "Processing...",  Add processing text
                    "search": "Search :" // Customize search label
                }
            });
        }


        // Function to format currency in NGN
        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-NG', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
            }).format(amount);
        }
    </script>
    @*<script src="~/Scripts/Js/Crud/BulkOperation/BulkSimulationQuery.js"></script>*@
}




