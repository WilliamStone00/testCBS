@using Resources
@using Newtonsoft.Json
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateCashOutOrCashInBulkOperation

@{
    ViewBag.Title = @GlobalBulkOperation.SimulateBulkOperation;
}

    <style>
        .file-upload-wrapper {
            position: relative;
        }

        .upload-feedback {
            transition: all 0.3s ease;
        }

        #uploadStatus {
            transition: opacity 0.3s ease;
        }

        .progress-bar {
            transition: width 0.3s ease;
        }

        .accordion-button .badge {
            position: relative;
            top: -1px;
        }
    </style>

    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

            <!-- Header Section -->
            <div class="card bg-light mb-4 shadow-sm">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-cash-multiple me-2"></i> @GlobalBulkOperation.BULKOPERATIONS
                    </h1>
                    <p class="card-text">
                        <strong>Bulk Cash Management System</strong> - Perform mass cash in/out operations on multiple accounts simultaneously.
                        Efficiently process cash movements while maintaining complete audit trails.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

                    <div class="alert alert-info mt-3">
                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                        <strong>Important:</strong> All bulk cash operations run in <b>simulation mode</b> first, before execution.
                    </div>
                </div>
            </div>

            <!-- Listing button -->
            <div class="mb-3 text-end">
                <a href="/BulkOperation/Listing"
                   class="btn btn-sm btn-outline-secondary align-self-center me-3"
                   data-bs-toggle="tooltip"
                   title="@GlobalBulkOperation.GoToExecutedBulkOperationList">
                    <i class="mdi mdi-view-list me-1"></i> @GlobalBulkOperation.ViewBulkOperations
                </a>
            </div>

            <!-- Main Accordion -->
            <div class="accordion mb-2" id="bulkOperationAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingMethodSelection">
                        <button class="accordion-button" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseMethodSelection"
                                aria-expanded="true" aria-controls="collapseMethodSelection">
                            <i class="mdi mdi-format-list-bulleted-type me-2"></i> @GlobalBulkOperation.BulkCashSimulationMethod
                        </button>
                    </h2>

                    <div id="collapseMethodSelection" class="accordion-collapse collapse show" aria-labelledby="headingMethodSelection">
                        <div class="accordion-body">

                            <!-- Input mode -->
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                                            <label class="btn btn-outline-primary active">
                                                @Html.RadioButtonFor(m => m.InputMethod, "manual", new { @checked = "checked", id = "manualInput" })
                                                <i class="mdi mdi-keyboard-outline me-2"></i> Manual Entry
                                            </label>
                                            <label class="btn btn-outline-primary">
                                                @Html.RadioButtonFor(m => m.InputMethod, "file", new { id = "fileInput" })
                                                <i class="mdi mdi-file-import-outline me-2"></i> File Upload
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- =============================== -->
                            <!-- Manual Input Section -->
                            <!-- =============================== -->
                            <div id="manualInputSection" class="mt-3">

                                @using (Html.BeginForm("SimulateCashOutOrCashInBulkOperation", "BulkOperation", FormMethod.Post,
                                    new { id = "manualForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateManualEntryingBulkCashOperation(this);" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <!-- Tips -->
                                    <div class="card shadow-sm mb-1">
                                        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                            <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.TIPS</span>
                                            <button class="btn btn-light btn-sm" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseUserTipsManual"
                                                    aria-expanded="false"
                                                    aria-controls="collapseUserTipsManual">
                                                <i class="mdi mdi-chevron-down"></i>
                                            </button>
                                        </h6>

                                        <div id="collapseUserTipsManual" class="collapse">
                                            <div class="card-body">
                                                <div class="row gy-2">
                                                    <div class="col-md-12">
                                                        <h5 class="text-primary mb-3">
                                                            <i class="mdi mdi-playlist-check me-2"></i> How to Execute a Bulk Cash Operation:
                                                        </h5>
                                                        <ol class="list-group list-group-numbered">
                                                            <li class="list-group-item">
                                                                <div class="fw-bold">Define Operation Type</div>
                                                                Select whether this is Cash-In (deposit) or Cash-Out (withdrawal).
                                                            </li>
                                                            <li class="list-group-item">
                                                                <div class="fw-bold">Select Simulation Type</div>
                                                                Choose the reason/type for audit and reporting (e.g. Fees, Salary, Correction).
                                                            </li>
                                                            <li class="list-group-item">
                                                                <div class="fw-bold">Add Member Accounts</div>
                                                                Add all member accounts and amounts.
                                                            </li>
                                                            <li class="list-group-item">
                                                                <div class="fw-bold">Run Simulation</div>
                                                                Verify totals before execution.
                                                            </li>
                                                        </ol>
                                                    </div>

                                                    <div class="col-md-6 mt-3">
                                                        <div class="alert alert-primary d-flex align-items-center" role="alert">
                                                            <i class="mdi mdi-cash-check me-2"></i>
                                                            Ensure all account references and amounts are correct.
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 mt-3">
                                                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                                                            <i class="mdi mdi-alert-outline me-2"></i>
                                                            Cash operations are immediate and may require special reversals.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Operation Scope -->
                                    <div class="card mb-3">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    @Html.LabelFor(m => m.OperationScope, @GlobalBulkOperation.SelectOperationType, new { @class = "form-label" })
                                                    @Html.DropDownListFor(m => m.OperationScope,
                                                        new SelectList(ViewBag.operationScope, "Value", "Text"),
                                                        @GlobalBulkOperation.SelectOperationType,
                                                        new { @class = "form-select select2", required = "required", id = "OperationScope" })
                                                    <div class="invalid-feedback">Please select an operation scope</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Branch -->
                                    <div class="col-md-12 mb-2">
                                        @Html.LabelFor(m => m.BranchId, @GlobalBulkOperation.SelectBranch, new { @class = "form-label" })
                                        @Html.DropDownListFor(m => m.BranchId,
                                            new SelectList(ViewBag.branches, "Id", "Name"),
                                            @GlobalBulkOperation.Branch,
                                            new { @class = "form-select select2", required = "required", onchange = "loadBranchAccounts(this.value, 1)" })
                                        <div class="invalid-feedback">Please select a branch</div>
                                    </div>

                                    <!-- Account List -->
                                    <div class="accordion mb-2" id="accountListAccordion">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingAccountList">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                        data-bs-target="#collapseAccountList" aria-expanded="true" aria-controls="collapseAccountList">
                                                    <i class="mdi mdi-account-details me-2"></i> @GlobalBulkOperation.BulkCashAccountList
                                                </button>
                                            </h2>
                                            <div id="collapseAccountList" class="accordion-collapse collapse show" aria-labelledby="headingAccountList">
                                                <div class="accordion-body">

                                                    <div class="table-responsive">
                                                        <table class="table table-hover mb-0" id="myDataTable">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Branch</th>
                                                                    <th>Member Reference</th>
                                                                    <th>Account Type</th>
                                                                    <th>Amount</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr class="empty-row">
                                                                    <td colspan="5" class="text-center text-muted py-4">
                                                                        <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                                                                        No accounts added yet. Click "Add Account" to begin.
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                                                        <button type="button" class="btn btn-sm btn-outline-danger" id="resetAccountsBtn">
                                                            <i class="mdi mdi-delete-sweep-outline me-1"></i> Clear All
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-primary" id="addAccountBtn">
                                                            <i class="mdi mdi-plus-circle-outline me-1"></i> Add Account
                                                        </button>
                                                    </div>

                                                    <div class="mt-2">
                                                        <small class="text-muted">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            You can add multiple accounts to process in this batch.
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Operation Parameters -->
                                    <div class="accordion mb-4" id="operationParamsAccordionManual">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingOperationParamsManual">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                        data-bs-target="#collapseOperationParamsManual" aria-expanded="true" aria-controls="collapseOperationParamsManual">
                                                    <i class="mdi mdi-cog-outline me-2"></i> @GlobalBulkOperation.BulkCashOperationParameters
                                                </button>
                                            </h2>
                                            <div id="collapseOperationParamsManual" class="accordion-collapse collapse show" aria-labelledby="headingOperationParamsManual">
                                                <div class="accordion-body">
                                                    <div class="row g-3">

                                                        <!-- Transfer Type -->
                                                        <div class="col-md-6">
                                                            @Html.LabelFor(m => m.TransferType, @GlobalBulkOperation.SelectOperationType, new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.TransferType,
                                                                new SelectList(ViewBag.transferType, "Value", "Text"),
                                                                @GlobalBulkOperation.SelectOperationType,
                                                                new { @class = "form-select select2", required = "required", id = "TransferType" })
                                                            <div class="invalid-feedback">Please select an operation type</div>
                                                        </div>

                                                        <!-- Accounting Date -->
                                                        <div class="col-md-6">
                                                            @Html.LabelFor(m => m.AccountDate, @GlobalBulkOperation.SelectAccountingDate, new { @class = "form-label" })
                                                            @Html.TextBoxFor(
                                                                m => m.AccountDate,
                                                                Model.AccountDate == default(DateTime) ? DateTime.Today.ToString("yyyy-MM-dd") : "{0:yyyy-MM-dd}",
                                                                new
                                                                {
                                                                    @class = "form-control accounting-date",
                                                                    type = "date",
                                                                    data_date_default = "today",
                                                                    data_date_max = "today",
                                                                    id = "AccountDate"
                                                                })
                                                            <div class="invalid-feedback">Please select a valid accounting date</div>
                                                        </div>

                                                        <!-- ✅ Simulation Type (Dropdown) -->
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(m => m.SimulationType, "Simulation Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(
                                                                m => m.SimulationType,
                                                                new SelectList(ViewBag.SimulationTypes, "Value", "Text"),
                                                                "--- Select Simulation Type ---",
                                                                new { @class = "form-select select2", required = "required", id = "SimulationType" }
                                                            )
                                                            <div class="invalid-feedback">Please select a simulation type</div>
                                                            <small class="text-muted d-block mt-1">
                                                                <i class="mdi mdi-information-outline me-1"></i>
                                                                Select the reason/type for audit and reporting.
                                                            </small>
                                                        </div>

                                                        <!-- Simulation Description -->
                                                        <div class="col-12">
                                                            @Html.LabelFor(m => m.SimulationDescription, "Simulation Description", new { @class = "form-label" })
                                                            @Html.TextAreaFor(m => m.SimulationDescription,
                                                                new { @class = "form-control", rows = "3", placeholder = "Enter details or justification (required if type is Other)", id = "SimulationDescription" })
                                                        </div>

                                                        <!-- Destination Account -->
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(m => m.AccountCartId,
                                                                @GlobalBulkOperation.BulkOperationCashOutOrCashInAccount +
                                                                $" ({(Model.TransferType == "CashIn" ?  @GlobalBulkOperation.BulkOperationCashOutOrCashInAccountTransferCashOut : @GlobalBulkOperation.BulkOperationCashOutOrCashInAccountTransferCashIn)})",
                                                                new { @class = "form-label", id = "AccountCartLabel" })

                                                            @Html.DropDownListFor(m => m.AccountCartId,
                                                                new List<SelectListItem> { new SelectListItem { Text = "--- Select Chart Of Account ---", Value = "" } },
                                                                new { @class = "form-select select2", required = "required", id = "AccountCartId" })

                                                            <div class="invalid-feedback">Please select a destination account</div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-12 text-end">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="mdi mdi-play-circle-outline me-2"></i> Run Simulation
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- =============================== -->
                            <!-- File Input Section -->
                            <!-- =============================== -->
                            <div id="fileInputSection" class="mt-3" style="display:none;">

                                @using (Html.BeginForm("UploadBulkCashOperationFile", "BulkOperation", FormMethod.Post,
                                    new { id = "fileForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostBulkCashFileUploadOperation(this);" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <!-- Tips (unique collapse id) -->
                                    <div class="card shadow-sm mb-4">
                                        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                            <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.TIPS</span>
                                            <button class="btn btn-light btn-sm" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseUserTipsFile"
                                                    aria-expanded="false"
                                                    aria-controls="collapseUserTipsFile">
                                                <i class="mdi mdi-chevron-down"></i>
                                            </button>
                                        </h6>
                                        <div id="collapseUserTipsFile" class="collapse">
                                            <div class="card-body">
                                                <div class="alert alert-warning small mb-0">
                                                    <i class="mdi mdi-alert-outline me-2"></i>
                                                    Upload the template, verify preview, then run simulation. If Simulation Type is <b>Other</b>, add details in Description.
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- File Upload Accordion -->
                                    <div class="accordion mb-4" id="fileUploadAccordion">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingFileUpload">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                        data-bs-target="#collapseFileUpload" aria-expanded="true" aria-controls="collapseFileUpload">
                                                    <i class="mdi mdi-cloud-upload-outline me-2"></i> Bulk Operation File Upload
                                                    <span class="badge bg-primary ms-2">Required</span>
                                                </button>
                                            </h2>
                                            <div id="collapseFileUpload" class="accordion-collapse collapse show" aria-labelledby="headingFileUpload">
                                                <div class="accordion-body">
                                                    <div class="alert alert-info mb-4">
                                                        <i class="mdi mdi-information-outline me-2"></i>
                                                        Upload a CSV/Excel containing bulk accounts & amounts. Max size: 10MB.
                                                    </div>

                                                    <div class="row g-3 align-items-end">
                                                        <div class="col-lg-8">
                                                            <div class="file-upload-wrapper">
                                                                <label for="bulkOperationFile" class="form-label">Select operation file</label>
                                                                <div class="input-group has-validation">
                                                                    <input type="file" name="file" class="form-control"
                                                                           id="bulkOperationFile" accept=".csv,.xlsx,.xls"
                                                                           required data-max-size="10485760">
                                                                    <button class="btn btn-primary px-4" type="submit" id="uploadButton">
                                                                        <span class="upload-text">Upload File</span>
                                                                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                                                        <i class="mdi mdi-cloud-upload-outline ms-1"></i>
                                                                    </button>
                                                                    <div class="invalid-feedback">
                                                                        Please select a valid file (max 10MB).
                                                                    </div>
                                                                </div>
                                                                <div class="form-text">Supported: .csv, .xlsx, .xls (Template below)</div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-4 text-lg-end">
                                                            <a href="/BulkOperation/DownloadBulkOperationFileTemplate" class="btn btn-outline-primary d-inline-flex align-items-center">
                                                                <i class="mdi mdi-file-download-outline me-2"></i>
                                                                <span>Download Template</span>
                                                            </a>
                                                        </div>
                                                    </div>

                                                    <!-- Upload Progress -->
                                                    <div class="upload-feedback mt-4">
                                                        <div class="progress mb-2" style="height: 8px; display: none;" id="uploadProgress">
                                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                                                 role="progressbar"
                                                                 style="width: 0%"
                                                                 aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                        <div id="uploadStatus" class="alert d-none"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- File Content Preview -->
                                    <div class="accordion mb-4" id="fileContentAccordion">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingFileContent">
                                                <button class="accordion-button collapsed" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#collapseFileContent"
                                                        aria-expanded="false" aria-controls="collapseFileContent">
                                                    <i class="mdi mdi-file-document-outline me-2"></i> File Content Preview
                                                </button>
                                            </h2>
                                            <div id="collapseFileContent" class="accordion-collapse collapse" aria-labelledby="headingFileContent">
                                                <div class="accordion-body">
                                                    <div class="table-responsive mb-3">
                                                        <table class="table table-hover table-bordered align-middle" id="myDataTable2">
                                                            <thead>
                                                                <tr>
                                                                    <th>Branch Code</th>
                                                                    <th>Member Reference</th>
                                                                    <th>Account Type</th>
                                                                    <th>Member Name</th>
                                                                    <th>Amount</th>
                                                                </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Posting Form (File Simulation) -->
                                @using (Html.BeginForm("SimulateCashOutOrCashInBulkFileOperation", "BulkOperation", FormMethod.Post,
                                    new { id = "filePosting", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateBulkCashOperation(this);" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="accordion mb-4" id="operationParamsAccordionFile">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingOperationParamsFile">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                        data-bs-target="#collapseOperationParamsFile" aria-expanded="true" aria-controls="collapseOperationParamsFile">
                                                    <i class="mdi mdi-cog-outline me-2"></i> @GlobalBulkOperation.BulkCashOperationParameters
                                                </button>
                                            </h2>
                                            <div id="collapseOperationParamsFile" class="accordion-collapse collapse show" aria-labelledby="headingOperationParamsFile">
                                                <div class="accordion-body">
                                                    <div class="row g-3">

                                                        <!-- Branch -->
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(m => m.BranchId2, @GlobalBulkOperation.SelectBranch, new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.BranchId2,
                                                                new SelectList(ViewBag.branches, "Id", "Name"),
                                                                @GlobalBulkOperation.Branch,
                                                                new { @class = "form-select select2", required = "required", onchange = "loadBranchAccounts(this.value, 2)" })
                                                            <div class="invalid-feedback">Please select a branch</div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            @Html.LabelFor(m => m.TransferType2, @GlobalBulkOperation.SelectOperationType, new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.TransferType2,
                                                                new SelectList(ViewBag.transferType, "Text", "Value"),
                                                                @GlobalBulkOperation.SelectOperationType,
                                                                new { @class = "form-select select2", required = "required", id = "TransferType2" })
                                                            <div class="invalid-feedback">Please select an operation type</div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            @Html.LabelFor(m => m.AccountDate2, @GlobalBulkOperation.SelectAccountingDate, new { @class = "form-label" })
                                                            @Html.TextBoxFor(
                                                                m => m.AccountDate2,
                                                                Model.AccountDate2 == default(DateTime) ? DateTime.Today.ToString("yyyy-MM-dd") : "{0:yyyy-MM-dd}",
                                                                new
                                                                {
                                                                    @class = "form-control accounting-date",
                                                                    type = "date",
                                                                    data_date_default = "today",
                                                                    data_date_max = "today",
                                                                    id = "AccountDate2"
                                                                })
                                                            <div class="invalid-feedback">Please select a valid accounting date</div>
                                                        </div>

                                                        <!-- ✅ Simulation Type (Dropdown) -->
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(m => m.SimulationType2, "Simulation Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(
                                                                m => m.SimulationType2,
                                                                new SelectList(ViewBag.SimulationTypes, "Value", "Text"),
                                                                "--- Select Simulation Type ---",
                                                                new { @class = "form-select select2", required = "required", id = "SimulationType2" }
                                                            )
                                                            <div class="invalid-feedback">Please select a simulation type</div>
                                                        </div>

                                                        <!-- Simulation Description -->
                                                        <div class="col-12">
                                                            @Html.LabelFor(m => m.SimulationDescription2, "Simulation Description", new { @class = "form-label" })
                                                            @Html.TextAreaFor(m => m.SimulationDescription2,
                                                                new { @class = "form-control", rows = "3", placeholder = "Enter details or justification (required if type is Other)", id = "SimulationDescription2" })
                                                        </div>

                                                        <!-- Destination COA -->
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(m => m.AccountCartId2,
                                                                @GlobalBulkOperation.BulkOperationCashOutOrCashInAccount +
                                                                $" ({(Model.TransferType2 == "CashIn" ? @GlobalBulkOperation.BulkOperationCashOutOrCashInAccountTransferCashOut : @GlobalBulkOperation.BulkOperationCashOutOrCashInAccountTransferCashIn )})",
                                                                new { @class = "form-label", id = "AccountCartLabel2" })

                                                            @Html.DropDownListFor(m => m.AccountCartId2,
                                                                new List<SelectListItem> { new SelectListItem { Text = "--- Select Chart Of Account ---", Value = "" } },
                                                                new { @class = "form-select select2", required = "required", id = "AccountCartId2" })

                                                            <div class="invalid-feedback">Please select a destination account</div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-12 text-end">
