        const $bulkUploadForm = $('#bulkUploadForm');
        const $fileInput = $('#bulkOperationFile');
        const $uploadButton = $('#uploadButton');
        const $uploadStatus = $('#uploadStatus');
        const $progressBar = $('.progress-bar');
        const maxFileSize = parseInt($fileInput.data('max-size')) || 10 * 1024 * 1024; // Default 10MB

        // Display file content in DataTable
        function displayFileContent(data) {

            if ($.fn.DataTable.isDataTable('#fileContentTable')) {
                $('#fileContentTable').DataTable().destroy();
            }

            $('#fileContentCard').show();
            const $table = $('#fileContentTable');
            console.log('Table : ' + $table)

            $table.DataTable({
                data: data || [],
                columns: [
                    {
                        data: "BranchCode",
                        title: "Branch Code",
                        render: $.fn.dataTable.render.text() // Sanitize output
                    },
                    {
                        data: "MemberReference",
                        title: "Member Reference",
                        render: $.fn.dataTable.render.text() // Sanitize output
                    },
                    {
                        data: "AccountType",
                        title: "Account Type",
                        render: $.fn.dataTable.render.text()
                    },
                    {
                        data: "MemberName",
                        title: "Member Name",
                        render: $.fn.dataTable.render.text()
                    },
                    {
                        data: "Amount",
                        title: "Amount",
                        className: "text-end",
                        render: function (data) {
                            return data ? formatCurrency(data) : '0';
                        }
                    }
                ],
                language: {
                    emptyTable: "No data available in table",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of 0 entries",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    lengthMenu: "Show _MENU_ entries",
                    search: "Search:",
                    zeroRecords: "No matching records found"
                },
                responsive: true,
                lengthMenu: [[5, 10, 25, 50, 100, 500, 1000], [5, 10, 25, 50, 100, 500, 1000]],
                pageLength: 5,
                order: [[0, 'desc']], // Disable initial sorting
                /* dom: '<"top"f>rt<"bottom"lip><"clear">',*/
                initComplete: function () {
                    $table.removeClass('d-none');
                }
            });
        }


