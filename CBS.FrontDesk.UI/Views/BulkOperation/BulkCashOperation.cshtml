    <script>

        $(document).ready(function () {
            let accountCounter = 0;

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Add Account button click handler
            $('#addAccountBtn').on('click', function () {
                addAccountRow();
            });


            // Function to add a new account row
          function addAccountRow() {
                accountCounter++;

                // Remove empty row if it exists
                $('.empty-row').remove();

                // Get the current branch ID (in case it changed)
              const currentBranchId = $('#BranchId').val();
              const operationScope = $('#OperationScope').val();
              console.log('operationScope :', operationScope);
             /* var operationScope = currentOperationScope==null ? "Internal" :currentOperationScope;
              console.log('operationScope :', operationScope);*/
              const isInterbranch = operationScope === "Internal";

                // Create branch options HTML
                let branchOptions = '';
                if (isInterbranch) {
                    // For interbranch, use only the selected branch
                    const branchId = $('#BranchId').val();
                    const branchName = $('#BranchId option:selected').text();
                    branchOptions = `<option value="${branchId}">${branchName}</option>`;
                } else {
                    // For non-interbranch, show all branches
                    @foreach (var item in Model.Branches) {
                        @:branchOptions += `<option value="@item.Id">@item.Name</option>`;
                    }
                }

                // Create saving product options HTML
                let savingProductOptions = '';
                @foreach (var item in ViewBag.SavingProducts) {
                    @:savingProductOptions += `<option value="@item.Id">@item.Name</option>`;
                }

                // Create new row
                const newRow = $(`
                    <tr data-account-id="${accountCounter}">
                        <td>
                            <select class="form-control form-control-sm form-select select3 branch-name"
                                    name="Accounts[${accountCounter}].BranchName" required>
                                ${branchOptions}
                            </select>
                            <div class="invalid-feedback">Branch Name required</div>
                        </td>

                        <td>
                            <input type="text" class="form-control form-control-sm member-reference"
                                    name="Accounts[${accountCounter}].MemberReference"
                                    placeholder="e.g. 5467" required>
                            <div class="invalid-feedback">Member reference required</div>
                        </td>

                        <td>
                            <select class="form-control form-control-sm form-select select2 account-type"
                                    name="Accounts[${accountCounter}].AccountType" required>
                                ${savingProductOptions}
                            </select>
                            <div class="invalid-feedback">Account Type required</div>
                        </td>

                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control amount"
                                        name="Accounts[${accountCounter}].Amount"
                                        placeholder="0" step="0.01" min="0" required>
                                <div class="invalid-feedback">Valid amount required</div>
                            </div>
                        </td>

                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-account">
                                <i class="mdi mdi-delete-outline"></i>
                            </button>
                        </td>
                    </tr>
                `);

                // Add row to table
                $('#myDataTable tbody').append(newRow);

                // Initialize select2 if needed
                if ($.fn.select2) {
                    newRow.find('.select2').select2({
                        width: '100%',
                        dropdownParent: newRow
                    });

                    newRow.find('.select3').select2({
                        width: '100%',
                        dropdownParent: newRow
                    });
                }

                // Enable submit button if we have at least one account
                $('#submitBtn').prop('disabled', false);

                // Focus on the first input of the new row
                newRow.find('.member-reference').focus();

                // Add click handler for remove button
                newRow.find('.remove-account').click(function () {
                    $(this).closest('tr').remove();
                    // Disable submit button if no accounts left
                    if ($('#myDataTable tbody tr').not('.empty-row').length === 0) {
                        $('#submitBtn').prop('disabled', true);
                        // Add empty row back if needed
                        $('#myDataTable tbody').append('<tr class="empty-row"><td colspan="5" class="text-center text-muted py-3">No accounts added yet</td></tr>');
                    }
                });
            }

            // Remove account row (moved outside the function)
            $(document).on('click', '.remove-account', function () {
                $(this).closest('tr').remove();

                // Show empty message if no accounts left
                if ($('#myDataTable tbody tr').length === 0) {
                    $('#myDataTable tbody').append(`
                    <tr class="empty-row">
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                            No accounts added yet. Click "Add Account" to begin.
                        </td>
                    </tr>
                    `);
                    $('#submitBtn').prop('disabled', true);
                }
            });

            // Reset form (moved outside the function)
            $('#resetAccountsBtn').on('click', function () {
                //$('#myDataTable')[0].reset();
                //$('#myDataTable').removeClass('was-validated');
                $('#myDataTable tbody').empty().append(`
                    <tr class="empty-row">
                        <td colspan="5" class="text-center text-muted py-4">
