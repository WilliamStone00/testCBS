@using Resources
@using Newtonsoft;
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateCashOutOrCashInBulkOperation
@{
    ViewBag.Title = @GlobalBulkOperation.SimulateBulkOperation;
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <!-- Header Section -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalBulkOperation.BULKOPERATIONS
                </h1>
                <p class="card-text">
                    <strong>Bulk Cash Management System</strong> - Perform mass cash in/out operations on multiple accounts simultaneously.
                    Efficiently process cash movements while maintaining complete audit trails.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

                <div class="alert alert-info mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>Important:</strong> All bulk cash operations will first run in simulation mode to preview results before actual execution.
                </div>
            </div>
        </div>

        <!-- Added button as requested -->
        <div class="mb-3 text-end">
            <a href="/BulkOperation/Listing" class="btn btn-sm btn-outline-secondary align-self-center me-3" data-bs-toggle="tooltip" title="@GlobalBulkOperation.GoToExecutedBulkOperationList">
                <i class="mdi mdi-view-list me-1"></i> @GlobalBulkOperation.ViewBulkOperations
            </a>
        </div>

        <!-- Main Accordion Container -->
        <div class="accordion mb-2" id="bulkOperationAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingMethodSelection">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMethodSelection" aria-expanded="true" aria-controls="collapseMethodSelection">
                        <i class="mdi mdi-format-list-bulleted-type me-2"></i> @GlobalBulkOperation.BulkCashSimulationMethod
                    </button>
                </h2>
                <div id="collapseMethodSelection" class="accordion-collapse collapse show" aria-labelledby="headingMethodSelection">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                                        <label class="btn btn-outline-primary active">
                                            @Html.RadioButtonFor(m => m.InputMethod, "manual", new { @checked = "checked", id = "manualInput" })
                                            <i class="mdi mdi-keyboard-outline me-2"></i> Manual Entry
                                        </label>
                                        <label class="btn btn-outline-primary">
                                            @Html.RadioButtonFor(m => m.InputMethod, "file", new { id = "fileInput" })
                                            <i class="mdi mdi-file-import-outline me-2"></i> File Upload
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>



                        <!-- Manual Input Section -->
                        <div id="manualInputSection" class="mt-3">
                            @using (Html.BeginForm("SimulateCashOutOrCashInBulkOperation", "BulkOperation", FormMethod.Post, new { id = "manualForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateManualEntryingBulkCashOperation(this);" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Partial("_ManualBulkOperationConfigurationPartial", Model)

                                <div class="row mt-3">
                                    <div class="col-md-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-play-circle-outline me-2"></i> Run Simulation
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>


                        <!-- File Input Section -->
                        <div id="fileInputSection" class="mt-3" style="display: none;">
                            @using (Html.BeginForm("UploadBulkCashOperationFile", "BulkOperation", FormMethod.Post, new { id = "fileForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostBulkCashFileUploadOperation(this);" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Partial("_FileBulkOperationConfigurationPartial")
                            }
                            @using (Html.BeginForm("SimulateCashOutOrCashInBulkFileOperation", "BulkOperation", FormMethod.Post, new { id = "filePosting", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateBulkCashOperation(this);" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Partial("_BulkOperationParameters2", Model)
                                <div class="row mt-2">
                                    <div class="col-md-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-play-circle-outline me-2"></i> Run Simulation
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Toggle between manual and file input
            $('input[name="InputMethod"]').change(function () {
                if ($(this).val() === 'manual') {
                    $('#manualInputSection').show();
                    $('#fileInputSection').hide();
                } else {
                    $('#manualInputSection').hide();
                    $('#fileInputSection').show();
                }
            });

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            /*  if (!Modernizr.inputtypes.date) {
                  $('.datepicker').datepicker({
                      dateFormat: 'yy-mm-dd',
                      minDate: 0,
                      maxDate: 30
                  });
              }*/

        });
    </script>
    @*Manual Bulk Batch Operation*@
<script>

        $(document).ready(function () {
            let accountCounter = 0;

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Add Account button click handler
            $('#addAccountBtn').on('click', function () {
                addAccountRow();
            });


            // Function to add a new account row
          function addAccountRow() {
                accountCounter++;

                // Remove empty row if it exists
                $('.empty-row').remove();

                // Get the current branch ID (in case it changed)
              const currentBranchId = $('#BranchId').val();
              const operationScope = $('#OperationScope').val();
              console.log('operationScope :', operationScope);
             /* var operationScope = currentOperationScope==null ? "Internal" :currentOperationScope;
              console.log('operationScope :', operationScope);*/
              const isInterbranch = operationScope === "Internal";

                // Create branch options HTML
                let branchOptions = '';
                if (isInterbranch) {
                    // For interbranch, use only the selected branch
                    const branchId = $('#BranchId').val();
                    const branchName = $('#BranchId option:selected').text();
                    branchOptions = `<option value="${branchId}">${branchName}</option>`;
                } else {
                    // For non-interbranch, show all branches
                    @foreach (var item in Model.Branches) {
                        @:branchOptions += `<option value="@item.Id">@item.Name</option>`;
                    }
                }

                // Create saving product options HTML
                let savingProductOptions = '';
                @foreach (var item in ViewBag.SavingProducts) {
                    @:savingProductOptions += `<option value="@item.Id">@item.Name</option>`;
                }

                // Create new row
                const newRow = $(`
                    <tr data-account-id="${accountCounter}">
                        <td>
                            <select class="form-control form-control-sm form-select select3 branch-name"
                                    name="Accounts[${accountCounter}].BranchName" required>
                                ${branchOptions}
                            </select>
                            <div class="invalid-feedback">Branch Name required</div>
                        </td>

                        <td>
                            <input type="text" class="form-control form-control-sm member-reference"
                                    name="Accounts[${accountCounter}].MemberReference"
                                    placeholder="e.g. 5467" required>
                            <div class="invalid-feedback">Member reference required</div>
                        </td>

                        <td>
                            <select class="form-control form-control-sm form-select select2 account-type"
                                    name="Accounts[${accountCounter}].AccountType" required>
                                ${savingProductOptions}
                            </select>
                            <div class="invalid-feedback">Account Type required</div>
                        </td>

                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control amount"
                                        name="Accounts[${accountCounter}].Amount"
                                        placeholder="0" step="0.01" min="0" required>
                                <div class="invalid-feedback">Valid amount required</div>
                            </div>
                        </td>

                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-account">
                                <i class="mdi mdi-delete-outline"></i>
                            </button>
                        </td>
                    </tr>
                `);

                // Add row to table
                $('#accountsTable tbody').append(newRow);

                // Initialize select2 if needed
                if ($.fn.select2) {
                    newRow.find('.select2').select2({
                        width: '100%',
                        dropdownParent: newRow
                    });

                    newRow.find('.select3').select2({
                        width: '100%',
                        dropdownParent: newRow
                    });
                }

                // Enable submit button if we have at least one account
                $('#submitBtn').prop('disabled', false);

                // Focus on the first input of the new row
                newRow.find('.member-reference').focus();

                // Add click handler for remove button
                newRow.find('.remove-account').click(function () {
                    $(this).closest('tr').remove();
                    // Disable submit button if no accounts left
                    if ($('#accountsTable tbody tr').not('.empty-row').length === 0) {
                        $('#submitBtn').prop('disabled', true);
                        // Add empty row back if needed
                        $('#accountsTable tbody').append('<tr class="empty-row"><td colspan="5" class="text-center text-muted py-3">No accounts added yet</td></tr>');
                    }
                });
            }

            // Remove account row (moved outside the function)
            $(document).on('click', '.remove-account', function () {
                $(this).closest('tr').remove();

                // Show empty message if no accounts left
                if ($('#accountsTable tbody tr').length === 0) {
                    $('#accountsTable tbody').append(`
                    <tr class="empty-row">
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                            No accounts added yet. Click "Add Account" to begin.
                        </td>
                    </tr>
                    `);
                    $('#submitBtn').prop('disabled', true);
                }
            });

            // Reset form (moved outside the function)
            $('#resetAccountsBtn').on('click', function () {
                //$('#accountsTable')[0].reset();
                //$('#accountsTable').removeClass('was-validated');
                $('#accountsTable tbody').empty().append(`
                    <tr class="empty-row">
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                            No accounts added yet. Click "Add Account" to begin.
                        </td>
                    </tr>
                `);
                $('#submitBtn').prop('disabled', true);
                accountCounter = 0;
                $('.alert').alert('close');
            });

            // Preview button click handler (moved outside the function)
            $('#previewBtn').on('click', function () {
                $('#bulkCashOperationForm').trigger('submit');
            });
        });


        function AjaxPostAndUpdateManualEntryingBulkCashOperation(form) {
            $.validator.unobtrusive.parse(form);
            if ($(form).valid()) {
                alertify.confirm("Confirmation", "Are you sure you want to perform this action?",
                    function () {
                        // Collect all account data
                        const accounts = [];
                        $('#accountsTable tbody tr').not('.empty-row').each(function () {
                            const row = $(this);
                            accounts.push({
                                BranchName: row.find('.branch-name').val(),
                                MemberReference: row.find('.member-reference').val(),
                                AccountType: row.find('.account-type').val(),
                                Amount: parseFloat(row.find('.amount').val()) || 0
                            });
                        });

                        // Get Branches data from hidden field
                       // const branches = JSON.parse($('#branchObject').val() || '[]');

                        // Get SavingProducts data (assuming they're in a similar hidden field)
                       // const savingProducts = JSON.parse($('#savingProductsObject').val() || '[]');

                        // Prepare complete request data
                        const requestData = {
                            // Form fields
                            BranchId: $('#BranchId').val(),
                            TransferType: $('#TransferType').val(),
                            AccountCartId: $('#AccountCartId').val(),
                            AccountDate: $('#AccountDate').val(),
                            OperationTitle: $('#OperationTitle').val(),
                            SimulationDescription: $('#SimulationDescription').val(),
                            TargetAmount: parseFloat($('#TargetAmount').val()) || 0,
                            BulkCashStrategy:'ManualEntrying',
                            // Collections
                            //Branches: branches,
                            //SavingProducts: savingProducts,
                            Accounts: accounts
                        };

                        console.log("Submitting data:", requestData);

                        $.ajax({
                            type: 'POST',
                            url: form.action,
                            data: JSON.stringify(requestData),
                            contentType: 'application/json',
                            success: function (response) {
                                if (response.success) {
                                    alertify.success(response.message || 'Operation completed successfully');
                                } else {
                                    alertify.error(response.message || 'Error during operation');
                                }
                            },
                            error: function (err) {
                                console.error("Error:", err);
                                if (err.status === 401) {
                                    window.location.href = '/Authentication/Login';
                                } else {
                                    alertify.error(err.responseJSON?.message || err.statusText || 'An error occurred');
                                }
                            }
                        });
                    },
                    function () {
                        alertify.message('Operation cancelled');
                    }
                );
            }
            return false;
        }
</script>

