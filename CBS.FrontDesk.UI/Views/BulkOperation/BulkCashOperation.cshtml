                ],
                language: {
                    emptyTable: "No data available in table",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of 0 entries",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    lengthMenu: "Show _MENU_ entries",
                    search: "Search:",
                    zeroRecords: "No matching records found"
                },
                responsive: true,
                lengthMenu: [[5, 10, 25, 50, 100, -1], [5, 10, 25, 50, 100, "All"]],
                pageLength: 10,
                order: [[0, 'asc']],
                dom: '<"top"lf>rt<"bottom"ip><"clear">',
                initComplete: function () {
                    $table.removeClass('d-none');
                }
            });

            // Add export buttons if needed
            new $.fn.dataTable.Buttons(dataTable, {
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });
            dataTable.buttons().container().appendTo($('#exportButtons'));
        }

        // Display simulation results (similar to previous example)
        function displaySimulationResult2(data) {
            const modal = $('#simulationResultsModal');
            const modalBody = modal.find('.modal-body');

            modalBody.empty();

            if (data && data.length > 0) {
                const table = $('<table class="table table-striped"></table>');
                const thead = $('<thead><tr><th>Account</th><th>Current Balance</th><th>New Balance</th><th>Status</th></tr></thead>');
                const tbody = $('<tbody></tbody>');

                data.forEach(item => {
                    const row = $('<tr></tr>');
                    row.append($('<td></td>').text(item.accountNumber));
                    row.append($('<td class="text-end"></td>').text(formatCurrency(item.currentBalance)));
                    row.append($('<td class="text-end"></td>').text(formatCurrency(item.newBalance)));

                    const statusCell = $('<td></td>');
                    const statusClass = item.status === 'Success' ? 'badge bg-success' : 'badge bg-danger';
                    statusCell.append($(`<span class="${statusClass}">${item.status}</span>`));
                    row.append(statusCell);

                    tbody.append(row);
                });

                table.append(thead).append(tbody);
                modalBody.append(table);
            } else {
                modalBody.append('<p>No simulation results available.</p>');
            }

            modal.modal('show');
        }

        // Helper function to show status messages
        function showUploadStatus(message, type) {
            const $uploadStatus = $('#uploadStatus');
            $uploadStatus.removeClass('d-none alert-danger alert-success alert-info')
                .addClass(`alert-${type}`)
                .html(`<i class="mdi mdi-${type === 'success' ? 'check' : 'alert'}-circle-outline me-2"></i>${message}`);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-NG', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
            }).format(amount);
        }

        function formatBytes(bytes, decimals = 2) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm) + ' ' + sizes[i]);
        }

        function setUploadState(isUploading) {
            $uploadButton.prop('disabled', isUploading);
            $uploadButton.find('.upload-text').text(isUploading ? 'Uploading...' : 'Upload File');
            $uploadButton.find('.spinner-border').toggleClass('d-none', !isUploading);
            $('#uploadProgress').toggle(isUploading);
        }

        function updateProgressBar(loaded, total) {
            const percent = Math.round((loaded / total) * 100);
            $progressBar.css('width', percent + '%')
                .attr('aria-valuenow', percent)
                .text(percent + '%');
        }

        function resetProgressBar() {
            $progressBar.css('width', '0%')
                .attr('aria-valuenow', 0)
                .text('0%')
                .removeClass('bg-success bg-danger')
                .addClass('bg-primary progress-bar-animated');
        }

        function resetUploadUI() {
            $uploadStatus.addClass('d-none');
            $bulkUploadForm.removeClass('was-validated');
            resetProgressBar();
        }

    </script>
}




