@using Resources
@using Newtonsoft.Json
@model CBS.FrontDesk.Data.Entity.BulkOperation.SimulateCashOutOrCashInBulkOperation

@{
    ViewBag.Title = GlobalBulkOperation.SimulateBulkOperation;
}

<style>
    .file-upload-wrapper {
        position: relative;
    }

    .upload-feedback {
        transition: all 0.3s ease;
    }

    #uploadStatus {
        transition: opacity 0.3s ease;
    }

    .progress-bar {
        transition: width 0.3s ease;
    }

    .accordion-button .badge {
        position: relative;
        top: -1px;
    }

    .help-hint {
        font-size: .85rem;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

        <!-- ====================== -->
        <!-- HEADER -->
        <!-- ====================== -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-success fw-bold mb-2">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalBulkOperation.BULKCASHOPERATIONS
                </h1>

                <p class="card-text text-muted mb-2">
                    <strong>@GlobalBulkOperation.Bulk_Cash_Management_Console</strong> — @GlobalBulkOperation.Simulate_and_validate_Cash_In_Cash_Out_batches_before_execution
                    <br />
                    @GlobalBulkOperation.Process_multiple_account_cash_movements_in_one_operation_while_maintaining_complete_audit_trails_and_operational_control
                </p>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.35);" />

                <div class="alert alert-info mt-3 d-flex align-items-center justify-content-center">
                    <i class="mdi mdi-information-outline me-2"></i>
                    <strong>@GlobalShared.Important:</strong>&nbsp;@Html.Raw(@GlobalBulkOperation.All_bulk_cash_operations_run_in_SIMULATION_mode_first_for_review_and_validation_before_execution)
                </div>
            </div>
        </div>

        <!-- ====================== -->
        <!-- QUICK ACTIONS -->
        <!-- ====================== -->
        <div class="row mb-2">
            <div class="col-md-6 text-md-end mb-1 mb-md-0">
                <a href="/BulkOperation" class="btn btn-primary btn-sm shadow-sm px-3 w-100 w-md-auto">
                    <i class="mdi mdi-account-plus-outline me-1"></i> @GlobalBulkOperation.SimulateARangeBulkOperation
                </a>
            </div>
            <div class="col-md-6 text-md-start">
                <a href="/BulkOperation/Listing" class="btn btn-outline-secondary btn-sm shadow-sm px-3 w-100 w-md-auto"
                   data-bs-toggle="tooltip" title="@GlobalBulkOperation.GoToExecutedBulkOperationList">
                    <i class="mdi mdi-view-list me-1"></i> @GlobalBulkOperation.View_Bulk_Operations
                </a>
            </div>
        </div>

        <!-- ====================== -->
        <!-- MAIN ACCORDION -->
        <!-- ====================== -->
        <div class="accordion mb-2" id="bulkOperationAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingMethodSelection">
                    <button class="accordion-button" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseMethodSelection"
                            aria-expanded="true" aria-controls="collapseMethodSelection">
                        <i class="mdi mdi-format-list-bulleted-type me-2"></i>
                        @GlobalBulkOperation.BulkCashSimulationMethod
                        <span class="badge bg-success ms-2">@GlobalShared.Simulation</span>
                    </button>
                </h2>

                <div id="collapseMethodSelection" class="accordion-collapse collapse show" aria-labelledby="headingMethodSelection">
                    <div class="accordion-body">

                        <!-- =============================== -->
                        <!-- INPUT METHOD -->
                        <!-- =============================== -->
                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">
                                        @GlobalShared.Input_Method
                                        <i class="mdi mdi-help-circle-outline text-muted"
                                           data-bs-toggle="tooltip"
                                           title="@GlobalBulkOperation.Choose_how_you_will_provide_account_data_manual_entry_or_file_upload"></i>
                                    </label>

                                    <div class="btn-group w-100" role="group" aria-label="Input method">
                                        <input type="radio" class="btn-check" name="InputMethod" id="manualInput" value="manual" checked />
                                        <label class="btn btn-outline-primary" for="manualInput">
                                            <i class="mdi mdi-keyboard-outline me-2"></i> @GlobalShared.Manual_Entry
                                        </label>

                                        <input type="radio" class="btn-check" name="InputMethod" id="fileInput" value="file" />
                                        <label class="btn btn-outline-primary" for="fileInput">
                                            <i class="mdi mdi-file-import-outline me-2"></i> @GlobalShared.File_Upload
                                        </label>
                                    </div>

                                    <small class="text-muted d-block help-hint mt-1">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        @GlobalBulkOperation.Manual_mode_is_best_for_small_batches_File_mode_is_recommended_for_large_batches.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- =============================== -->
                        <!-- MANUAL INPUT SECTION -->
                        <!-- =============================== -->
                        <div id="manualInputSection" class="mt-3">

                            @using (Html.BeginForm("SimulateCashOutOrCashInBulkOperation", "BulkOperation", FormMethod.Post,
                                new { id = "manualForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateManualEntryingBulkCashOperation(this);" }))
                            {
                                @Html.AntiForgeryToken()

                                <!-- TIPS -->
                                <div class="card shadow-sm mb-2">
                                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips & @GlobalShared.Rules (@GlobalShared.Manual_Entry)</span>
                                        <button class="btn btn-light btn-sm" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapseUserTipsManual"
                                                aria-expanded="false"
                                                aria-controls="collapseUserTipsManual">
                                            <i class="mdi mdi-chevron-down"></i>
                                        </button>
                                    </h6>

                                    <div id="collapseUserTipsManual" class="collapse">
                                        <div class="card-body">
                                            <ol class="list-group list-group-numbered">
                                                <li class="list-group-item">
                                                    <div class="fw-bold">@GlobalBulkOperation.Choose_Operation_Scope</div>
                                                    @GlobalBulkOperation.Internal_usually_means_same_branch_processing_External_Inter_Branch_allows_per_row_branch_selection
                                                </li>
                                                <li class="list-group-item">
                                                    <div class="fw-bold">@GlobalBulkOperation.Select_Cash_Direction</div>
                                                    @GlobalBulkOperation.Choose_Cash_In_deposit_or_Cash_Out_withdrawal_for_correct_accounting_routing.
                                                </li>
                                                <li class="list-group-item">
                                                    <div class="fw-bold">@GlobalBulkOperation.Use_Simulation_Type</div>
                                                    @GlobalBulkOperation.Simulation_Type_is_mandatory_for_audit_classification_If_type_is_Other_provide_a_clear_description.
                                                </li>
                                                <li class="list-group-item">
                                                    <div class="fw-bold">@GlobalBulkOperation.Validate_Accounts_and_Amounts</div>
                                                    @GlobalBulkOperation.Amount_must_be_greater_than_0_Verify_references_carefully_cash_operations_may_require_formal_reversals.
                                                </li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>

                                <!-- ====================== -->
                                <!-- OPERATION SCOPE -->
                                <!-- ====================== -->
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row g-2">

                                            <div class="col-md-12">
                                                @Html.LabelFor(m => m.OperationScope, GlobalShared.Select_operation_type, new { @class = "form-label fw-semibold" })
                                                @Html.DropDownListFor(m => m.OperationScope,
                                                    new SelectList(ViewBag.operationScope, "Value", "Text"),
                                                    "--- Select Operation Scope ---",
                                                    new { @class = "form-select select2", required = "required", id = "OperationScope" })

                                                <small class="text-muted d-block help-hint mt-1">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    @GlobalBulkOperation.Defines_whether_accounts_are_processed_within_a_single_branch_or_across_multiple_branches.
                                                </small>

                                                <div class="invalid-feedback">@GlobalBulkOperation.Please_select_an_operation_scope.</div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <!-- ====================== -->
                                <!-- BRANCH -->
                                <!-- ====================== -->
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.BranchId, GlobalShared.SelectBranch, new { @class = "form-label fw-semibold" })
                                    @Html.DropDownListFor(m => m.BranchId,
                                        new SelectList(ViewBag.branches, "Id", "Name"),
                                        "--- Select Branch ---",
                                        new { @class = "form-select select2", required = "required", id = "BranchId", onchange = "loadBranchAccounts(this.value, 1)" })

                                    <small class="text-muted d-block help-hint mt-1">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        @GlobalBulkOperation.Used_to_load_branch_Chart_of_Accounts_for_cash_source_destination_routing
                                    </small>
                                    <div class="invalid-feedback">@GlobalShared.Please_select_a_branch</div>
                                </div>

                                <!-- ====================== -->
                                <!-- ACCOUNT LIST -->
                                <!-- ====================== -->
                                <div class="accordion mb-2" id="accountListAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingAccountList">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#collapseAccountList" aria-expanded="true" aria-controls="collapseAccountList">
                                                <i class="mdi mdi-account-details me-2"></i> @GlobalBulkOperation.BulkCashAccountList
                                                <span class="badge bg-primary ms-2">@GlobalShared.Required</span>
                                            </button>
                                        </h2>
                                        <div id="collapseAccountList" class="accordion-collapse collapse show" aria-labelledby="headingAccountList">
                                            <div class="accordion-body">

                                                <div class="table-responsive">
                                                    <table class="table table-hover mb-0" id="myDataTable">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>@GlobalShared.Branch</th>
                                                                <th>@GlobalShared.Member_reference</th>
                                                                <th>@GlobalShared.Account_type</th>
                                                                <th class="text-end">Amount</th>
                                                                <th class="text-end">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr class="empty-row">
                                                                <td colspan="5" class="text-center text-muted py-4">
                                                                    <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                                                                    @Html.Raw(@GlobalBulkOperation.No_accounts_added_yet_Click_Add_Account_to_begin)
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger" id="resetAccountsBtn">
                                                        <i class="mdi mdi-delete-sweep-outline me-1"></i> Clear All
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary" id="addAccountBtn">
                                                        <i class="mdi mdi-plus-circle-outline me-1"></i> @GlobalShared.Add_Account
                                                    </button>
                                                </div>

                                                <small class="text-muted">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    @GlobalBulkOperation.Each_row_represents_one_member_account_entry_in_the_batch
                                                </small>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ====================== -->
                                <!-- OPERATION PARAMETERS -->
                                <!-- ====================== -->
                                <div class="accordion mb-4" id="operationParamsAccordionManual">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingOperationParamsManual">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#collapseOperationParamsManual" aria-expanded="true" aria-controls="collapseOperationParamsManual">
                                                <i class="mdi mdi-cog-outline me-2"></i>
                                                @GlobalShared.Operation_Parameters
                                                <span class="badge bg-secondary ms-2">@GlobalShared.Audit + @GlobalShared.Accounting</span>
                                            </button>
                                        </h2>
                                        <div id="collapseOperationParamsManual" class="accordion-collapse collapse show" aria-labelledby="headingOperationParamsManual">
                                            <div class="accordion-body">
                                                <div class="row g-3">

                                                    <!-- Transfer Type -->
                                                    <div class="col-md-6">
                                                        @Html.LabelFor(m => m.TransferType, "Cash Direction", new { @class = "form-label fw-semibold" })
                                                        @Html.DropDownListFor(m => m.TransferType,
                                                            new SelectList(ViewBag.transferType, "Value", "Text"),
                                                            "--- Select Cash Direction ---",
                                                            new { @class = "form-select select2", required = "required", id = "TransferType" })

                                                        <small class="text-muted d-block help-hint mt-1">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            @GlobalBulkOperation.Cash_In_deposit_to_member_accounts_Cash_Out_withdrawal_from_member_accounts.
                                                        </small>
                                                        <div class="invalid-feedback">@GlobalBulkOperation.Please_select_a_cash_direction</div>
                                                    </div>

                                                    <!-- Accounting Date -->
                                                    <div class="col-md-6">
                                                        @Html.LabelFor(m => m.AccountDate, "Accounting Date", new { @class = "form-label fw-semibold" })
                                                        @Html.TextBoxFor(m => m.AccountDate,
                                                            Model.AccountDate == default(DateTime) ? DateTime.Today.ToString("yyyy-MM-dd") : "{0:yyyy-MM-dd}",
                                                            new { @class = "form-control accounting-date", type = "date", id = "AccountDate" })

                                                        <small class="text-muted d-block help-hint mt-1">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            @GlobalBulkOperation.Must_match_an_open_accounting_day_for_the_selected_branch.
                                                        </small>
                                                        <div class="invalid-feedback">@GlobalBulkOperation.Please_select_a_valid_accounting_date.</div>
                                                    </div>

                                                    <!-- Simulation Type -->
                                                    <div class="col-md-12">
                                                        @Html.LabelFor(m => m.SimulationType, "Simulation Type", new { @class = "form-label fw-semibold" })
                                                        @Html.DropDownListFor(m => m.SimulationType,
                                                            new SelectList(ViewBag.SimulationTypes, "Value", "Text"),
                                                            "--- Select Simulation Type ---",
                                                            new { @class = "form-select select2", required = "required", id = "SimulationType" })

                                                        <small class="text-muted d-block help-hint mt-1">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            @GlobalBulkOperation.Categorizes_the_batch_for_audit_and_reporting.
                                                        </small>
                                                        <div class="invalid-feedback">@GlobalBulkOperation.Please_select_a_simulation_type.</div>
                                                    </div>

                                                    <!-- Simulation Description -->
                                                    <div class="col-12">
                                                        @Html.LabelFor(m => m.SimulationDescription, "Simulation Description", new { @class = "form-label fw-semibold" })
                                                        @Html.TextAreaFor(m => m.SimulationDescription,
                                                            new
                                                            {
                                                                @class = "form-control",
                                                                rows = "3",
                                                                placeholder = "Provide justification / context (required if Simulation Type is Other).",
                                                                id = "SimulationDescription"
                                                            })
                                                        <small class="text-muted d-block help-hint mt-1">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            @GlobalBulkOperation.Recommended_include_ticket_number_approval_reference_or_business_reason.
                                                        </small>
                                                    </div>

                                                    <!-- Impact Accounting -->
                                                    <div class="col-md-12">
                                                        <div class="form-check form-switch">
                                                            @Html.CheckBoxFor(
                                                                m => m.ShouldImpactAccounting,
                                                                new
                                                                {
                                                                    @class = "form-check-input",
                                                                    role = "switch",
                                                                    id = "ShouldImpactAccounting"
                                                                })

                                                            <label class="form-check-label fw-semibold" for="ShouldImpactAccounting">
                                                                Impact Accounting
                                                            </label>
                                                        </div>

                                                        <small class="text-muted d-block help-hint mt-1">
                                                            <i class="mdi mdi-information-outline me-1"></i>
                                                            When enabled, this simulation will generate accounting entries upon execution.
                                                        </small>
                                                    </div>


                                                    <!-- Destination COA -->
                                                    <div class="col-md-12">
                                                        <label class="form-label fw-semibold" id="AccountCartLabel">
                                                            @GlobalBulkOperation.Cash_Source_Destination_Account_COA
                                                        </label>

                                                        @Html.DropDownListFor(m => m.AccountCartId,
                                                            new List<SelectListItem> { new SelectListItem { Text = "--- Select Chart Of Account ---", Value = "" } },
                                                            new { @class = "form-select select2", required = "required", id = "AccountCartId" })

                                                    <small class="text-muted d-block help-hint mt-1">
                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                        @GlobalBulkOperation.Select_the_branch_GL_account_used_to_route_this_cash_batch.
                                                    </small>
                                                    <div class="invalid-feedback">@GlobalBulkOperation.Please_select_a_chart_of_account.</div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SUBMIT -->
                                <div class="row mt-3">
                                    <div class="col-md-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-play-circle-outline me-2"></i> @GlobalShared.Run_Simulation
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- =============================== -->
                        <!-- FILE INPUT SECTION -->
                        <!-- =============================== -->
                        <div id="fileInputSection" class="mt-3" style="display:none;">

                            @using (Html.BeginForm("UploadBulkCashOperationFile", "BulkOperation", FormMethod.Post,
                                new { id = "fileForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostBulkCashFileUploadOperation(this);" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="card shadow-sm mb-3">
                                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips & @GlobalShared.Rules (@GlobalShared.File_Upload)</span>
                                        <button class="btn btn-light btn-sm" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapseUserTipsFile"
                                                aria-expanded="false"
                                                aria-controls="collapseUserTipsFile">
                                            <i class="mdi mdi-chevron-down"></i>
                                        </button>
                                    </h6>
                                    <div id="collapseUserTipsFile" class="collapse">
                                        <div class="card-body">
                                            <div class="alert alert-warning small mb-0">
                                                <i class="mdi mdi-alert-outline me-2"></i>
                                                @GlobalBulkOperation.Use_the_template_Upload_preview_confirm_parameters_run_simulation.
                                                @Html.Raw(@GlobalBulkOperation.If_Simulation_Type_is_Other_description_is_required).
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion mb-4" id="fileUploadAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingFileUpload">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#collapseFileUpload" aria-expanded="true" aria-controls="collapseFileUpload">
                                                <i class="mdi mdi-cloud-upload-outline me-2"></i> @GlobalBulkOperation.Bulk_Operation_File_Upload
                                                <span class="badge bg-primary ms-2"> @GlobalShared.Required</span>
                                            </button>
                                        </h2>
                                        <div id="collapseFileUpload" class="accordion-collapse collapse show" aria-labelledby="headingFileUpload">
                                            <div class="accordion-body">

                                                <div class="alert alert-info mb-3">
                                                    <i class="mdi mdi-information-outline me-2"></i>
                                                    @GlobalShared.Upload_a_CSV_Excel_containing_accounts_and_amounts_Max_size: 10MB.
                                                </div>

                                                <div class="row g-3 align-items-end">
                                                    <div class="col-lg-8">
                                                        <div class="file-upload-wrapper">
                                                            <label for="bulkOperationFile" class="form-label fw-semibold">
                                                                @GlobalShared.Select_Operation_File
                                                            </label>

                                                            <div class="input-group has-validation">
                                                                <input type="file" name="file" class="form-control"
                                                                       id="bulkOperationFile" accept=".csv,.xlsx,.xls"
                                                                       required data-max-size="10485760" />

                                                                <button class="btn btn-primary px-4" type="submit" id="uploadButton">
                                                                    <span class="upload-text">Upload</span>
                                                                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                                                    <i class="mdi mdi-cloud-upload-outline ms-1"></i>
                                                                </button>

                                                                <div class="invalid-feedback">@GlobalShared.Please_select_a_valid_file (max 10MB).</div>
                                                            </div>

                                                            <div class="form-text">
                                                                Supported: .csv, .xlsx, .xls
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4 text-lg-end">
                                                        <a href="/BulkOperation/DownloadBulkOperationFileTemplate"
                                                           class="btn btn-outline-primary d-inline-flex align-items-center">
                                                            <i class="mdi mdi-file-download-outline me-2"></i>
                                                            <span>@GlobalShared.Download_Template</span>
                                                        </a>
                                                    </div>
                                                </div>

                                                <div class="upload-feedback mt-3">
                                                    <div class="progress mb-2" style="height: 8px; display: none;" id="uploadProgress">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                                             role="progressbar" style="width: 0%"
                                                             aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <div id="uploadStatus" class="alert d-none"></div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion mb-4" id="fileContentAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingFileContent">
                                            <button class="accordion-button collapsed" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#collapseFileContent"
                                                    aria-expanded="false" aria-controls="collapseFileContent">
                                                <i class="mdi mdi-file-document-outline me-2"></i> @GlobalShared.File_Content_Preview
                                            </button>
                                        </h2>
                                        <div id="collapseFileContent" class="accordion-collapse collapse" aria-labelledby="headingFileContent">
                                            <div class="accordion-body">
                                                <div class="table-responsive mb-3">
                                                    <table class="table table-hover table-bordered align-middle" id="myDataTable2">
                                                        <thead>
                                                            <tr>
                                                                <th>@GlobalShared.Branch_Code</th>
                                                                <th>@GlobalShared.Member_reference</th>
                                                                <th>@GlobalShared.Account_type</th>
                                                                <th>@GlobalShared.Member_name</th>
                                                                <th class="text-end">@GlobalShared.Amount</th>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                    <small class="text-muted">
                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                        @GlobalBulkOperation.Validate_the_preview_before_running_simulation.
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                              

                            }

                            <!-- FILE POSTING -->
                            @using (Html.BeginForm("SimulateCashOutOrCashInBulkFileOperation", "BulkOperation", FormMethod.Post,
                                new { id = "filePosting", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateBulkCashOperation(this);" }))
                            {
