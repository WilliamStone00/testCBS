@model CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources

@{
    ViewBag.Title = "Bulk Operation Details";
    var status = string.IsNullOrEmpty(Model.ApprovalStatus) ? "Pending" : Model.ApprovalStatus;
}

<!-- Hidden simulation id for JS -->
<input type="hidden" id="BulkOperationSimulationId" value="@Model.Id" />

<div class="row">
    <div class="col-12">
        <!-- Enhanced Header Section -->
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-database-export me-2"></i> @GlobalBulkOperation.BulkOperationDetails - @Model.SimulationType
                </h1>
                <p class="card-text lead">
                    @GlobalBulkOperation.Bulk_Operation_Details_Verification_and_Approvals...
                </p>
                <hr class="my-3" style="border: 2px solid rgba(128, 128, 128, 0.3);" />
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="fas fa-cogs me-2"></i>
                            @GlobalBulkOperation.BulkOperationDetails - @Model.SimulationType
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div id="datalistingview">
                                        @Html.Partial("_SimulationDetails", @Model)
                                    </div>
                                </div>
                                <!-- DETAILS TABLE PARTIAL -->
                                @*  <div class="mt-3">
                                        @Html.Partial("_SimulationDetailsDataTable")
                                    </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Bulk Operation Modal (unchanged except where necessary) -->
<div class="modal fade" id="confirmBulkOperationModal" tabindex="-1" aria-labelledby="confirmBulkOperationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="confirmBulkOperationLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@GlobalShared.Processing_bulk_operation...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-checkbox-marked-circle-outline me-2"></i> @GlobalBulkOperation.ConfirmBulkOperation
                            </h1>
                            <p>@(Model.SimulationType?.ToUpper())</p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.AboutThisOperation</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBulkOperationTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseBulkOperationTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>@GlobalShared.Important:</strong> @GlobalBulkOperation.ThisActionWillAffectMultipleRecords.</li>
                            <li><i class="mdi mdi-shield-check-outline text-success me-2"></i><strong>@GlobalShared.Secure:</strong> @GlobalBulkOperation.AllChangesAreLoggedForAuditPurposes.</li>
                            <li><i class="mdi mdi-undo text-danger me-2"></i><strong>@GlobalShared.Irreversible:</strong> @GlobalBulkOperation.ThisOperationCannotBeUndone.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="modal-body p-4">
                <form id="confirmBulkOperationForm">
                    <input type="hidden" id="bulkOperationSimulationId" name="BulkOperationSimulationId" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="approvalStatus" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-check-decagram me-2"></i>@GlobalShared.Approval_status
                        </label>
                        <select class="form-select" id="approvalStatus" name="ApprovalStatus" required>
                            <option value="Pending" @(status == "Pending" ? "selected" : "")>@GlobalShared.Pending</option>
                            <option value="Approved" @(status == "Approved" ? "selected" : "")>@GlobalShared.Approved</option>
                            <option value="Reviewed" @(status == "Reviewed" ? "selected" : "")>@GlobalShared.Reviewed</option>
                            <option value="Rejected" @(status == "Rejected" ? "selected" : "")>@GlobalShared.Rejected</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="approvalStatusDescription" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-text-box-outline me-2"></i>@GlobalShared.Description
                        </label>
                        <textarea class="form-control" id="approvalStatusDescription" name="ApprovalStatusDescription" rows="3" placeholder="@GlobalBulkOperation.EnterDescriptionOrComments..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="approvalBy" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-account-check-outline me-2"></i>@GlobalShared.Approved_by
                        </label>
                        <input type="text" class="form-control" id="approvalBy" name="ApprovalBy" value="@ViewBag.FullName" readonly />
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        <strong>@GlobalShared.Warning:</strong> @GlobalBulkOperation.PleaseReviewAllDetailsCarefullyBeforeConfirmingThisBulkOperation.
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        Simulation ID: <span class="text-dark" id="bulkOperationSimulationIdDisplay">@Model.Id</span>
                    </span>
                </div>
                <div class="text-center w-100">
                    <small class="text-muted">@GlobalShared.Powered_by FLX-CBS</small>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> @GlobalShared.Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmBulkOperationBtn">
                        <i class="mdi mdi-check-circle-outline"></i> @GlobalShared.Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    // ---------- Helpers for badges (unchanged) ----------

    function renderApprovalStatusBadge(status) {
        if (!status) return '<span class="badge bg-secondary text-white">N/A</span>';

        const map = {
            Pending: { class: 'bg-warning text-dark', label: 'Pending' },
            Approved: { class: 'bg-success text-white', label: 'Approved' },
            Rejected: { class: 'bg-danger text-white', label: 'Rejected' },
            Reviewed: { class: 'bg-info text-white', label: 'Reviewed' },
            InProgress: { class: 'bg-primary text-white', label: 'In Progress' },
            Completed: { class: 'bg-success text-white', label: 'Completed' },
            ProcessingApproval: { class: 'bg-secondary text-white', label: 'Processing approval' },
            Failed: { class: 'bg-danger text-white', label: 'Failed' },
            Exception: { class: 'bg-danger text-white', label: 'Exception' },
            Closed: { class: 'bg-dark text-white', label: 'Closed' }
        };

        const item = map[status] || {
            class: 'bg-secondary text-white',
            label: status.replace(/([a-z])([A-Z])/g, '$1 $2')
        };

        return `<span class="badge ${item.class}">${item.label}</span>`;
    }

    function renderTransferStatusBadge(status) {
        if (!status) return '<span class="badge bg-secondary text-white">NOT STARTED</span>';

        const map = {
            Pending: { class: 'bg-warning text-dark', label: 'Pending' },
            InProgress: { class: 'bg-info text-white', label: 'In progress' },
            Send: { class: 'bg-info text-white', label: 'Sending' },
            Sent: { class: 'bg-info text-white', label: 'Sent' },
            Successful: { class: 'bg-success text-white', label: 'Successful' },
            Completed: { class: 'bg-success text-white', label: 'Completed' },
            Paid: { class: 'bg-success text-white', label: 'Paid' },
            Failed: { class: 'bg-danger text-white', label: 'Failed' },
            Exception: { class: 'bg-danger text-white', label: 'Exception' },
            Closed: { class: 'bg-dark text-white', label: 'Closed' }
        };

        const item = map[status] || {
            class: 'bg-secondary text-white',
            label: status.replace(/([a-z])([A-Z])/g, '$1 $2')
        };

        return `<span class="badge ${item.class}">${item.label}</span>`;
    }

    function formatCurrency(amount) {
        if (amount == null) return '0.0';
        return new Intl.NumberFormat('en-NG', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
        }).format(amount);
    }

    function showLoading(modal, contentDiv, message) {
        // Simple: just show modal for now
        modal.show();
    }

    // ---------- Filter UI Helpers ----------

    function setActiveDetailsFiltersBadge() {
        const hasFilters =
            ($('#FilterMemberReference').val() || '').length > 0 ||
            ($('#FilterSourceAccountNumber').val() || '').length > 0 ||
            ($('#FilterSourceAccountType').val() || '').length > 0 ||
            ($('#FilterDestinationAccountNumber').val() || '').length > 0 ||
            ($('#FilterDestinationAccountType').val() || '').length > 0 ||
            ($('#FilterBranchId').val() || '').length > 0 ||
            ($('#FilterTransferStatus').val() || '').length > 0 ||
            ($('#FilterTransferMessage').val() || '').length > 0 ||
            ($('#FilterApprovalStatus').val() || '').length > 0 ||
            ($('#FilterTransferDateFrom').val() || '').length > 0 ||
            ($('#FilterTransferDateTo').val() || '').length > 0 ||
            ($('#FilterApprovalDateFrom').val() || '').length > 0 ||
            ($('#FilterApprovalDateTo').val() || '').length > 0;

        $('#activeDetailsFiltersBadge').toggle(hasFilters);
    }

        function resetDetailsFilterForm() {
        // Clear all filter inputs
        $('#FilterMemberReference, #FilterSourceAccountNumber, #FilterDestinationAccountNumber, #FilterTransferMessage').val('');
            $('#FilterSourceAccountType, #FilterDestinationAccountType, #FilterBranchId, #FilterTransferStatus, #FilterApprovalStatus').val('').trigger('change');
            $('#FilterTransferDateFrom, #FilterTransferDateTo, #FilterApprovalDateFrom, #FilterApprovalDateTo').val('');

            setActiveDetailsFiltersBadge();
        }


        function initFilterToggles() {
            // Member filters toggle
            $('#filterByMember').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#memberFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterMemberReference, #FilterMemberName').val('');
                }
                setActiveDetailsFiltersBadge();
            });

            // Account filters toggle
            $('#filterByAccount').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#accountFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterSourceAccountNumber, FilterSourceAccountType, FilterDestinationAccountNumber, FilterDestinationAccountType').val('').trigger('change');
                }
                setActiveDetailsFiltersBadge();
            });

            // Branch filters toggle
            $('#filterByBranch').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#branchFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterBranchId, #FilterBranchCode').val('').trigger('change');
                }
                setActiveDetailsFiltersBadge();
            });

            // Status filters toggle
            $('#filterByStatus').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#statusFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterTransferStatus, #FilterApprovalStatus').val('').trigger('change');
                }
                setActiveDetailsFiltersBadge();
            });

            // Date filters toggle
            $('#filterByDate').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#dateFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterTransferDateFrom, FilterTransferDateTo, FilterApprovalDateFrom, FilterApprovalDateTo, FilterCreatedDateFrom, FilterCreatedDateTo').val('');
                }
                setActiveDetailsFiltersBadge();
            });

            // Message filters toggle
            $('#filterByMessage').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('#messageFiltersSection').toggleClass('d-none', !isChecked);
                if (!isChecked) {
                    $('#FilterTransferMessage').val('');
                }
                setActiveDetailsFiltersBadge();
            });
        }

        function setActiveDetailsFiltersBadge() {
            let hasFilters = false;

            // Only check filters from visible sections
            if (!$('#memberFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterMemberReference').val() || '').length > 0 ||
                    ($('#FilterMemberName').val() || '').length > 0;
            }

            if (!$('#accountFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterSourceAccountNumber').val() || '').length > 0 ||
                    ($('#FilterSourceAccountType').val() || '').length > 0 ||
                    ($('#FilterDestinationAccountNumber').val() || '').length > 0 ||
                    ($('#FilterDestinationAccountType').val() || '').length > 0;
            }

            if (!$('#branchFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterBranchId').val() || '').length > 0 ||
                    ($('#FilterBranchCode').val() || '').length > 0;
            }

            if (!$('#statusFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterTransferStatus').val() || '').length > 0 ||
                    ($('#FilterApprovalStatus').val() || '').length > 0;
            }

            if (!$('#dateFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterTransferDateFrom').val() || '').length > 0 ||
                    ($('#FilterTransferDateTo').val() || '').length > 0 ||
                    ($('#FilterApprovalDateFrom').val() || '').length > 0 ||
                    ($('#FilterApprovalDateTo').val() || '').length > 0 ||
                    ($('#FilterCreatedDateFrom').val() || '').length > 0 ||
                    ($('#FilterCreatedDateTo').val() || '').length > 0;
            }

            if (!$('#messageFiltersSection').hasClass('d-none')) {
                hasFilters = hasFilters ||
                    ($('#FilterTransferMessage').val() || '').length > 0;
            }

            $('#activeDetailsFiltersBadge').toggle(hasFilters);
        }

        function resetDetailsFilterForm() {
            // Clear all filter inputs
            $('#FilterMemberReference, #FilterMemberName').val('');
            $('#FilterSourceAccountNumber, FilterDestinationAccountNumber, FilterTransferMessage, FilterBranchCode').val('');
            $('#FilterSourceAccountType, FilterDestinationAccountType, FilterBranchId, FilterTransferStatus, FilterApprovalStatus').val('').trigger('change');
            $('#FilterTransferDateFrom, FilterTransferDateTo, FilterApprovalDateFrom, FilterApprovalDateTo, FilterCreatedDateFrom, FilterCreatedDateTo').val('');

            setActiveDetailsFiltersBadge();
        }

    // ---------- DataTable helpers ----------

    let bulkDetailsTable = null;

        // ---------- Updated collectFilters to include new fields ----------

    function collectFilters(d, simulationId) {
        let sortColumnName = '';
        let sortColumnDirection = '';

        if (d && d.order && d.order.length > 0) {
            const order = d.order[0];
            const colIdx = order.column;
            sortColumnDirection = order.dir;
            if (d.columns && d.columns[colIdx]) {
                sortColumnName = d.columns[colIdx].data || '';
            }
        }

        // Build filter object - only include values from visible sections
        const filters = {
            simulationId: simulationId || $('#BulkOperationSimulationId').val() || '',
            options: {
                draw: d.draw,
                start: d.start,
                length: d.length,
                skip: d.start,
                pageSize: d.length,
                searchValue: d.search ? (d.search.value || '') : '',
                sortColumnName: sortColumnName,
                sortColumnDirection: sortColumnDirection
            }
        };

        console.log($('#FilterMemberReference').val() || null);
        // Add member filters if section is visible
        if (!$('#memberFiltersSection').hasClass('d-none')) {
            filters.memberReference = $('#FilterMemberReference').val() || null;
            filters.memberName = $('#FilterMemberName').val() || null;
        }

        // Add account filters if section is visible
        if (!$('#accountFiltersSection').hasClass('d-none')) {
            filters.sourceAccountNumber = $('#FilterSourceAccountNumber').val() || null;
            filters.sourceAccountType = $('#FilterSourceAccountType').val() || null;
            filters.destinationAccountNumber = $('#FilterDestinationAccountNumber').val() || null;
            filters.destinationAccountType = $('#FilterDestinationAccountType').val() || null;
        }

        // Add branch filters if section is visible
        if (!$('#branchFiltersSection').hasClass('d-none')) {
            filters.branchId = $('#FilterBranchId').val() || null;
            filters.branchCode = $('#FilterBranchCode').val() || null;
        }

        // Add status filters if section is visible
        if (!$('#statusFiltersSection').hasClass('d-none')) {
            filters.transferStatus = $('#FilterTransferStatus').val() || null;
            filters.approvalStatus = $('#FilterApprovalStatus').val() || null;
        }

        // Add date filters if section is visible
        if (!$('#dateFiltersSection').hasClass('d-none')) {
            filters.transferDateFrom = $('#FilterTransferDateFrom').val() || null;
            filters.transferDateTo = $('#FilterTransferDateTo').val() || null;
            filters.approvalDateFrom = $('#FilterApprovalDateFrom').val() || null;
            filters.approvalDateTo = $('#FilterApprovalDateTo').val() || null;
            filters.createdDateFrom = $('#FilterCreatedDateFrom').val() || null;
            filters.createdDateTo = $('#FilterCreatedDateTo').val() || null;
        }

        // Add message filters if section is visible
        if (!$('#messageFiltersSection').hasClass('d-none')) {
            filters.transferMessage = $('#FilterTransferMessage').val() || null;
        }

        return filters;
    }

    function loadBulkOperationDetailsDataTable(simulationId) {
        const $tbl = $('#myDataTable');
        if (!$tbl.length) {
            console.warn('#myDataTable not found – cannot init details DataTable.');
            return;
        }

        // Destroy existing table instance if it exists
        if (bulkDetailsTable && $.fn.DataTable.isDataTable($tbl)) {
            bulkDetailsTable.destroy();
            // IMPORTANT: do NOT .empty() the table; keep THEAD/TH
            // $tbl.find('tbody').empty(); // optional if you want to clear rows
        }

        bulkDetailsTable = $tbl.DataTable({
            serverSide: true,
            destroy: true,
            /*searching: true,*/
            order: [[0, 'desc']], // 0 = Date
            ajax: {
                url: '/BulkOperation/LoadBulkOperationDetailsData',
                type: 'POST',
                contentType: 'application/json; charset=utf-8', // ✅ needed for MVC JSON binding
                data: function (d) {
                    const payload = collectFilters(d, simulationId);
                    console.log('Bulk details payload:', payload);
                    return JSON.stringify(payload);
                },
                dataSrc: function (json) {
                    return json && json.data ? json.data : [];
                }
            },
            columns: [
                {
                    data: 'CreatedDate',
                    title: '@GlobalShared.Date',
                    width: '12%',
                    render: function (data) {
                        if (!data) return 'N/A';
                        return window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data;
                    }
                },
                {
                    data: 'MemberName',
                    title: '@GlobalShared.Member_name',
                    width: '18%',
                    render: function (data, type, row) {
                        const ref = row.MemberReference ? ` <small class="text-muted">(${row.MemberReference})</small>` : '';
                        return (data || 'N/A') + ref;
                    }
                },
                {
                    data: 'BranchName',
                    title: '@GlobalShared.Branch_Name',
                    width: '12%',
                    render: function (data, type, row) {
                        const code = row.BranchCode ? ` <small class="text-muted">(${row.BranchCode})</small>` : '';
                        return (data || 'N/A') + code;
                    }
                },
                {
                    data: 'SourceAccountNumber',
                    title: '@GlobalShared.Source_account',
                    width: '14%',
                    render: function (data, type, row) {
                        const typeText = row.SourceAccountType ? ` <small class="text-muted">[${row.SourceAccountType}]</small>` : '';
                        return (data || 'N/A') + typeText;
                    }
                },
                {
                    data: 'DestinationAccountNumber',
                    title: '@GlobalShared.Destination_account',
                    width: '14%',
                    render: function (data, type, row) {
                        const typeText = row.DestinationAccountType ? ` <small class="text-muted">[${row.DestinationAccountType}]</small>` : '';
                        return (data || 'N/A') + typeText;
                    }
                },
                {
                    data: 'SourceAccountBalance',
                    title: '@GlobalShared.Source_balance',
                    width: '8%',
                    className: 'text-end',
                    render: function (data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'AmountToDebit',
                    title: '@GlobalShared.Amount_to_debit',
                    width: '8%',
                    className: 'text-end',
                    render: function (data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'NetBalance',
                    title: '@GlobalShared.Actual_balance',
                    width: '8%',
                    className: 'text-end',
                    render: function (data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'ApprovalStatus',
                    title: '@GlobalShared.Approval_status',
                    width: '8%',
                    render: function (data) {
                        return renderApprovalStatusBadge(data || 'Pending');
                    }
                },
                {
                    data: 'TransferStatus',
                    title: '@GlobalShared.Transfer_Status',
                    width: '10%',
                    render: function (data) {
                        return renderTransferStatusBadge(data);
                    }
                },
                {
                    data: 'Id',
                    width: '6%',
                    orderable: false,
                    searchable: false,
                    title: 'Action',
                    render: function (id) {
                        if (!id) return '';
                        return `
                            <div class="text-center">
                                <a href="#"
                                   class="btn btn-sm btn-outline-primary details-btn"
                                   title="@GlobalShared.ViewDetails"
                                   data-id="${id}">
                                    <i class="fas fa-user-cog me-1"></i>@GlobalShared.View
                                </a>
                            </div>`;
                    }
                }
            ],
            language: {
                emptyTable: "No Bulk Operations details available for this simulation.",
                search: "Search :"
            },
            initComplete: function () {
                $('#myDataTable').on('click', '.details-btn', function (e) {
                    e.preventDefault();
                    const KEY = $(this).data('id');
                    const modalEl = document.getElementById('transferDetailsModal');
                    const modal = new bootstrap.Modal(modalEl);
                    const contentDiv = document.getElementById('transferDetailsContent');

                    showLoading(modal, contentDiv, `GetBulkOperationDetails : ${KEY}`);

                    $.ajax({
                        url: '/BulkOperation/GetBulkOperationDetails',
                        type: 'GET',
                        data: { KEY: KEY },
                        success: function (data) {
                            contentDiv.innerHTML = data;
                        },
                        error: function () {
                            contentDiv.innerHTML = `
                                <div class="alert alert-danger">
                                    Failed to load transfer details. Please try again.
                                </div>`;
                        }
                    });
                });
            }
        });
    }

    function bindDetailsFilterActions(simulationId) {
        // Apply filters button
        $('#applyDetailsFilterBtn').on('click', function (e) {
            e.preventDefault();
            setActiveDetailsFiltersBadge();
            if (bulkDetailsTable) {
                bulkDetailsTable.ajax.reload(null, true);
            }
        });

        // Reset filters button
        $('#resetDetailsFilterBtn').on('click', function (e) {
            e.preventDefault();
            resetDetailsFilterForm();
            if (bulkDetailsTable) {
                bulkDetailsTable.ajax.reload(null, true);
            }
        });

        // Enter key in filter inputs
        $('#detailsFilterForm input, #detailsFilterForm select').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                setActiveDetailsFiltersBadge();
                if (bulkDetailsTable) {
                    bulkDetailsTable.ajax.reload(null, true);
                }
            }
        });

        // Update badge when any filter changes
        $('#detailsFilterForm input, #detailsFilterForm select').on('change', setActiveDetailsFiltersBadge);
    }

