@model  CBS.FrontDesk.Data.Entity.BulkOperation.BulkOperationData
@using Resources
@{
    ViewBag.Title = "Bulk Operation Details";

    var status = string.IsNullOrEmpty(Model.ApprovalStatus) ? "Pending" : Model.ApprovalStatus;
}


<div class="row">
    <div class="col-12">
        <!-- Enhanced Header Section -->
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-database-export me-2"></i>  @GlobalBulkOperation.BulkOperationDetails - @Model.SimulationType
                </h1>
                <p class="card-text lead">
                    Bulk Operation Details , Verification and Approvals...
                </p>
              @*  <div class="alert alert-light border-primary mb-0 mt-3">
                    <i class="mdi mdi-alert-circle-outline text-primary me-2"></i>
                    <strong>Pro Tip:</strong> @GlobalBulkOperation.UseFiltersToRefineSelectionsBeforeApplyingBulkChanges.
                </div>*@
                <hr class="my-3" style="border: 2px solid rgba(128, 128, 128, 0.3);" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="fas fa-cogs me-2"></i>
                            @GlobalBulkOperation.BulkOperationDetails - @Model.SimulationType
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div id="datalistingview">
                                        @Html.Partial("_SimulationDetails", @Model)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Bulk Operation Modal -->
<div class="modal fade" id="confirmBulkOperationModal" tabindex="-1" aria-labelledby="confirmBulkOperationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="confirmBulkOperationLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@GlobalBulkOperation.ProcessingBulkOperation...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-checkbox-marked-circle-outline me-2"></i> @GlobalBulkOperation.ConfirmBulkOperation
                            </h1>
                            <p>@(Model.SimulationType?.ToUpper())</p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalBulkOperation.AboutThisOperation</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBulkOperationTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseBulkOperationTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>@GlobalBulkOperation.Important:</strong> @GlobalBulkOperation.ThisActionWillAffectMultipleRecords.</li>
                            <li><i class="mdi mdi-shield-check-outline text-success me-2"></i><strong>@GlobalBulkOperation.Secure:</strong> @GlobalBulkOperation.AllChangesAreLoggedForAuditPurposes.</li>
                            <li><i class="mdi mdi-undo text-danger me-2"></i><strong>@GlobalBulkOperation.Irreversible:</strong> @GlobalBulkOperation.ThisOperationCannotBeUndone.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="modal-body p-4">
                <form id="confirmBulkOperationForm">
                    <input type="hidden" id="bulkOperationSimulationId" name="BulkOperationSimulationId" />

                    <div class="mb-3">
                        <label for="approvalStatus" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-check-decagram me-2"></i>@GlobalBulkOperation.ApprovalStatus
                        </label>
                        <select class="form-select" id="approvalStatus" name="ApprovalStatus" required>
                            <option value="Pending" @(status == "Pending" ? "selected" : "")>Pending</option>
                            <option value="Approved" @(status == "Approved" ? "selected" : "")>Approved</option>
                            <option value="Reviewed" @(status == "Reviewed" ? "selected" : "")>Reviewed</option>
                            <option value="Rejected" @(status == "Rejected" ? "selected" : "")>Rejected</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="approvalStatusDescription" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-text-box-outline me-2"></i>@GlobalBulkOperation.Description
                        </label>
                        <textarea class="form-control" id="approvalStatusDescription" name="ApprovalStatusDescription" rows="3" placeholder="@GlobalBulkOperation.EnterDescriptionOrComments..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="approvalBy" class="form-label text-primary fw-semibold">
                            <i class="mdi mdi-account-check-outline me-2"></i>@GlobalBulkOperation.ApprovedBy
                        </label>
                        <input type="text" class="form-control" id="approvalBy" name="ApprovalBy" value="@ViewBag.FullName" readonly>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        <strong>@GlobalBulkOperation.Warning:</strong> @GlobalBulkOperation.PleaseReviewAllDetailsCarefullyBeforeConfirmingThisBulkOperation.
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        Simulation ID: <span class="text-dark" id="bulkOperationSimulationIdDisplay">@GlobalBulkOperation.NotProvided</span>
                    </span>
                </div>
                <div class="text-center w-100">
                    <small class="text-muted">@GlobalBulkOperation.PoweredBy FLX-CBS</small>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> @GlobalBulkOperation.Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmBulkOperationBtn">
                        <i class="mdi mdi-check-circle-outline"></i> @GlobalBulkOperation.Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
   @* <script src="~/Scripts/Js/Crud/BulkOperation/BulkSimulationDetailsQuery.js"></script>*@
    <script>
        $(document).ready(function () {
            var simulationId = $('#myDataTable').data('simulation-id') || '';
            console.log("SimulationId", simulationId);

            // Add loading indicator
            /* $('#myDataTable').wrap('<div class="position-relative"></div>')
    .parent().append('<div class="datatable-loader"><div class="spinner-border"></div></div>');
    */
            loadBulkOperationDetailsDataTable(simulationId);
        });

        function loadBulkOperationDetailsDataTable(simulationId) {
            $('#myDataTable').DataTable({
                "destroy": true,
                "serverSide": true,
                "processing": true, // Add processing indicator
                "info": true,
                "stateSave": true,
                "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]],
                "searching": true,
                "paging": true, // Ensure pagination is enabled
                ajax: {
                    url: '/BulkOperation/LoadBulkOperationDetailsData',
                    type: 'POST',
                    data: function (d) {
                        d.simulationId = simulationId;

                        return d;
                    },
                    dataSrc: function (json) {
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'MemberName',
                        title: 'Member Name',
                        width: '19%',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'SourceAccountNumber',
                        title: 'Source Account',
                        width: '13%',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'DestinationAccountNumber',
                        title: 'Destination Account',
                        width: '15%',
                        render: (data) => data || 'N/A'
                    },
                    {
                        data: 'SourceAccountBalance',
                        title: 'Source Balance',
                        width: '10%',
                        className: 'text-end',
                        render: (data) => formatCurrency(data)
                    },
                    {
                        data: 'AmountToDebit',
                        title: 'Amount To Debit',
                        width: '10%',
                        className: 'text-end',
                        render: (data) => formatCurrency(data)
                    },
                    {
                        data: 'NetBalance',
                        title: 'Actual Balance',
                        width: '10%',
                        className: 'text-end',
                        render: (data) => formatCurrency(data)
                    },
                    {
                        data: 'ApprovalStatus',
                        title: 'Status',
                        width: '8%',
                        render: function (data, type, row) {
                            let badgeClass = '';
                            switch (data) {
                                case 'Pending':
                                    badgeClass = 'bg-warning text-dark';
                                    break;
                                case 'Review':
                                    badgeClass = 'bg-info text-white';
                                    break;
                                case 'Approved':
                                    badgeClass = 'bg-success text-white';
                                    break;
                                default:
                                    badgeClass = 'bg-secondary text-white';
                            }
                            return `<span class="badge ${badgeClass}">${data || 'N/A'}</span>`;
                        }
                    },
                    {
                        data: 'TransferStatus',
                        title: 'Transfer Status',
                        width: '10%',
                        render: function (data, type, row) {
                            let badgeClass = '';
                            switch (data) {
                                case 'Failed':
                                    badgeClass = 'bg-warning text-dark';
                                    break;
                                case 'Completed':
                                    badgeClass = 'bg-success text-white';
                                    break;
                                default:
                                    badgeClass = 'bg-secondary text-white';
                            }
                            return `<span class="badge ${badgeClass}">${data || 'N/A'}</span>`;
                        }
                    },
                    {
                        data: 'Id',
                        width: '5%',
                        orderable: false,
                        searchable: false,
                        render: function (id) {
                            return `
                                    <div class="text-center">
                                        <a href="#" 
                                           class="btn btn-sm btn-outline-primary details-btn" 
                                           title="Transfer Details"
                                           data-id="${id}">
                                            <i class="fas fa-user-cog me-1"></i>View
                                        </a>
                                    </div>`;
                        }
                    }
                ],
                "order": [[0, "desc"]],
                language: {
                    emptyTable: "No Bulk Oprations available for the selected criteria.",
                    "processing": "Processing...", // Add processing text
                    "search": "Search all columns:" // Customize search label
                },
                initComplete: function () {
                    // Add click event handler for details buttons
                    $('#myDataTable').on('click', '.details-btn', function (e) {
                        e.preventDefault();
                        var KEY = $(this).data('id');
                        console.log(KEY);
                        var modal = new bootstrap.Modal(document.getElementById('transferDetailsModal'));
                        var contentDiv = document.getElementById('transferDetailsContent');
                        // Show loading indicator
                        showLoading(modal, contentDiv, `GetBulkOperationDetails : ${KEY}`);

                        // Fetch detailed data
                        $.ajax({
                            url: '/BulkOperation/GetBulkOperationDetails',
                            type: 'GET',
                            data: { KEY: KEY },
                            success: function (data) {
                                contentDiv.innerHTML = data;
                            },
                            error: function () {
                                contentDiv.innerHTML = `
                    <div class="alert alert-danger">
                        Failed to load transfer details. Please try again.
                    </div>`;
                            }
                        });
                    });
                }
            });
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-NG', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
            }).format(amount);
        }

        function showLoading(modal, contentDiv, message) {
            // Show loading state
            modal.show();
        }
    </script>
    <script src="~/Scripts/Js/Crud/BulkOperation/BulkOperationValidation.js"></script>
    <script>
        function exportBulkOperation(simulationId) {
            const url = `@Url.Action("DownloadBulkOperationExcel", "BulkOperation")?simulationId=${simulationId}`;
            window.location.href = url;
        }

        async function deleteBulkOperation(simulationId, simulationType) {
            // Confirm before deleting
            if (!confirm('Are you sure you want to delete this operation? This action cannot be undone.')) {
                return;
            }

            try {
                // Using fetch API for proper HTTP DELETE
                const response = await fetch(`/BulkOperation/DeleteBulkOperation`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        // 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        simulationId: simulationId,
                        simulationType: simulationType
                    })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                // Show success message and optionally reload the page
                alert(result.message || 'Operation deleted successfully');
                window.location.reload(); // Or update UI as needed

            } catch (error) {
                console.error('Error deleting operation:', error);
                alert('Failed to delete operation. Please try again.');
            }
        }
    </script>
    
}


