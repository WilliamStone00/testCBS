@model CBS.BusinessService.ThirdPartyBankAccount.ThirdPartyBranch
<div class="card-body">

    @using (Html.BeginForm("Update", "ThirdPartyInstitution", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.ThirdPartyInstitutionId)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.RegionId, new SelectList(ViewBag.Region == null ? "" : ViewBag.Region, "Text", "Value"), "---Select Region---", new { @class = "form-control select2", @search = "true", id = "Region" })
                    @Html.ValidationMessageFor(model => model.RegionId, "", new { @class = "text-danger" })
                    <label for="RegionId">Region</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.DivisionId, new SelectList(ViewBag.Division == null ? "" : ViewBag.Division, "Text", "Value"), "---Select Division---", new { @class = "form-control select2", @search = "true", id = "Division" })

                    @Html.ValidationMessageFor(m => m.DivisionId, "", new { @class = "text-danger" })
                    <label>Division</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.SubdivisionId, new SelectList(ViewBag.Subdivision == null ? "" : ViewBag.Subdivision, "Text", "Value"), "---Select Subdivision---", new { @class = "form-control select2", @search = "true", id = "Subdivision" })

                    @Html.ValidationMessageFor(m => m.SubdivisionId, "", new { @class = "text-danger" })
                    <label>Sub division</label>
                </div>
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.TownId, new SelectList(ViewBag.Town == null ? "" : ViewBag.Town, "Text", "Value"), "---Select Town---", new { @class = "form-control select2", @search = "true", id = "Town" })
                    @Html.ValidationMessageFor(m => m.TownId, "", new { @class = "text-danger" })
                    <label>Town</label>
                </div>

            </div>
        </div>

        <div class="mt-4">

            <button type="submit" class="btn btn-primary me-2">Update</button>

        </div>
    }
</div>