                    <td class="text-end">@Money(Model.Loan2_Exceptional_Loan_Interest)</td>
                    <td class="text-end">@Money(Model.Loan2_Exceptional_Loan_VAT)</td>
                    <td class="text-end fw-bold">@Money(Model.Loan2_Exceptional_Loan_TotalRepayment)</td>
                </tr>
            </tbody>
        </table>
    }

    @* Loan 3 *@
    @if ((!string.IsNullOrWhiteSpace(Model.Loan3_Elected_Staff_Id)) ||
         (Model.Loan3_Elected_Staff_Capital + Model.Loan3_Elected_Staff_Interest + Model.Loan3_Elected_Staff_VAT + Model.Loan3_Elected_Staff_TotalRepayment) > 0)
    {
        <h6 class="section-title"><i class="mdi mdi-file-document-edit-outline"></i> @GlobalSalaryProcessed.loan_3_elected_staff</h6>
        <table class="table table-sm table-bordered kv mb-2">
            <tbody>
                <tr><th>@GlobalShared.Used?</th><td>@Html.Raw(YesNo(Model.Loan3_Elected_Staff_Id_Used))</td></tr>
                <tr><th>@GlobalShared.Loan_ID</th><td class="mono">@Model.Loan3_Elected_Staff_Id</td></tr>
                <tr><th>@GlobalShared.Type</th><td>@Model.Loan3_Elected_Staff_Type</td></tr>
                <tr><th>@GlobalShared.Product</th><td>@Model.Loan3_Elected_Staff_ProductName <span class="text-muted">(@Model.Loan3_Elected_Staff_ProductId)</span></td></tr>
            </tbody>
        </table>
        <table class="table table-sm table-bordered mb-3">
            <thead class="table-light">
                <tr><th class="text-end">@GlobalShared.Capital</th><th class="text-end">@GlobalShared.Interest</th><th class="text-end">@GlobalShared.VAT</th><th class="text-end">@GlobalShared.Total</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-end">@Money(Model.Loan3_Elected_Staff_Capital)</td>
                    <td class="text-end">@Money(Model.Loan3_Elected_Staff_Interest)</td>
                    <td class="text-end">@Money(Model.Loan3_Elected_Staff_VAT)</td>
                    <td class="text-end fw-bold">@Money(Model.Loan3_Elected_Staff_TotalRepayment)</td>
                </tr>
            </tbody>
        </table>
    }

    @* Loan 4 *@
    @if ((!string.IsNullOrWhiteSpace(Model.Loan4_Special_Loan_With_Overdraft_Id)) ||
         (Model.Loan4_Special_Loan_With_Overdraft_Capital + Model.Loan4_Special_Loan_With_Overdraft_Interest + Model.Loan4_Special_Loan_With_Overdraft_VAT + Model.Loan4_Special_Loan_With_Overdraft_TotalRepayment) > 0)
    {
        <h6 class="section-title"><i class="mdi mdi-file-document-edit-outline"></i> @GlobalSalaryProcessed.loan_4_special_overdraft</h6>
        <table class="table table-sm table-bordered kv mb-2">
            <tbody>
                <tr><th>@GlobalShared.Used?</th><td>@Html.Raw(YesNo(Model.Loan4_Special_Loan_With_Overdraft_Id_Used))</td></tr>
                <tr><th>@GlobalShared.Loan_ID</th><td class="mono">@Model.Loan4_Special_Loan_With_Overdraft_Id</td></tr>
                <tr><th>@GlobalShared.Type</th><td>@Model.Loan4_Special_Loan_With_Overdraft_Type</td></tr>
                <tr><th>@GlobalShared.Product</th><td>@Model.Loan4_Special_Loan_With_Overdraft_ProductName <span class="text-muted">(@Model.Loan4_Special_Loan_With_Overdraft_ProductId)</span></td></tr>
