    <!-- Operators / Status -->
<h6 class="section-title"><i class="mdi mdi-account-badge-outline"></i> @GlobalShared.operators / @GlobalShared.Status</h6>
    <table class="table table-sm table-bordered kv mb-3">
        <tbody>
            <tr><th>@GlobalShared.Uploaded_By</th><td>@Model.UploadedBy</td></tr>
            <tr><th>@GlobalShared.executed_by</th><td>@Model.ExecutedBy</td></tr>
            <tr><th>@GlobalSalaryProcessed.payment_comment</th><td>@Model.PaymentComment</td></tr>
            <tr><th>@GlobalSalaryProcessed.is_paid (@GlobalShared.execution)</th><td>@Html.Raw(Paid(Model.Status))</td></tr>
            <tr><th>@GlobalSalaryProcessed.is_paid (@GlobalShared.flag)</th><td>@Html.Raw(YesNo(Model.Ispaid))</td></tr>
        </tbody>
    </table>

    <!-- Dates -->
    <h6 class="section-title"><i class="mdi mdi-calendar-multiselect"></i> @GlobalShared.Dates</h6>
    <table class="table table-sm table-bordered kv mb-1">
        <tbody>
            <tr><th>@GlobalShared.extraction_date</th><td>@Model.ExtrationDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
            <tr><th>@GlobalShared.execution_date</th><td>@Model.ExecutionDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
            <tr><th>@GlobalShared.Accounting_Date</th><td>@Model.AccountingDate.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>@GlobalShared.Created_Date</th><td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
        </tbody>
    </table>
</div>
