@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryExtract
@using Resources
@functions {
    public string Money(decimal v) =>
        v.ToString("N0");

    public string YesNo(bool v) =>
        v ? "<span class=\"badge bg-success\">Yes</span>"
          : "<span class=\"badge bg-secondary\">No</span>";

    public string Paid(bool v) =>
        v ? "<span class=\"badge bg-success\">Paid</span>"
          : "<span class=\"badge bg-warning text-dark\">Pending</span>";

    // Non-member = null/empty OR length 10 with first 3 digits + "0000000"
    public bool IsNonMemberRef(string mr)
    {
        if (string.IsNullOrEmpty(mr)) return true;
        if (mr.Length != 10) return false;
        if (!char.IsDigit(mr[0]) || !char.IsDigit(mr[1]) || !char.IsDigit(mr[2])) return false;
        return string.Equals(mr.Substring(3), "0000000", StringComparison.Ordinal);
    }
}

@{
    var memberRef = Model.MemberReference ?? string.Empty;
    var isNonMember = IsNonMemberRef(memberRef);
    var canActivate = isNonMember && !Model.Status; // only when Pending
}

<style>
    .section-title {
        font-weight: 700;
        color: #0d6efd;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: .35rem;
        margin-top: 1rem;
        margin-bottom: .75rem;
        display: flex;
        align-items: center;
        gap: .5rem
    }

    .kv th {
        width: 260px;
        background: #f7f7f7;
        text-transform: uppercase;
        font-weight: 600
    }

    .table-sm td, .table-sm th {
        vertical-align: middle
    }

    .mono {
        font-family: ui-monospace,SFMono-Regular,Menlo,monospace
    }

    .nowrap {
        white-space: nowrap
    }
</style>

<div class="px-3 py-2">
    <!-- Header + conditional Activate -->
    <div class="d-flex justify-content-between align-items-start">
        <h5 class="fw-bold text-uppercase text-primary border-bottom mb-3">
            <i class="mdi mdi-file-document-outline me-1"></i> @GlobalSalaryProcessed.processed_salary_details
        </h5>

        @if (canActivate)
        {
            <div class="text-end ms-3">
                <button type="button"
                        class="btn btn-sm btn-success"
                        title="Activate / Register non-member"
                        onclick="openRegisterNonMember('@Model.Id', {
                        name: '@(Model.MemberName ?? "—")',
                        ref: '@(Model.MemberReference ?? Model.NonMemberReference ?? "—")',
                        branchText: '@(Model.BranchName ?? "—")',
                        branchId: '@(Model.BranchId ?? "")',
                        branchCode: '@(Model.BranchCode ?? "")'
                })">
                    <i class="mdi mdi-account-plus-outline me-1"></i>
                    @GlobalShared.Activate / @GlobalShared.register
                </button>
                <div class="small text-muted mt-1">
                    @GlobalSalaryProcessed.non_member_reference_detected (@(string.IsNullOrEmpty(Model.MemberReference) ? "—" : Model.MemberReference)).
                </div>
            </div>
        }

    </div>

    <!-- Member summary -->
    <div class="row g-3">
        <div class="col-md-7">
            <h6 class="section-title"><i class="mdi mdi-account-circle-outline"></i> @GlobalShared.Member</h6>
            <table class="table table-sm table-bordered kv mb-3">
                <tbody>
                    <tr><th>@GlobalShared.Name</th><td>@Model.MemberName</td></tr>
                    <tr><th>@GlobalShared.Member_reference</th><td class="mono">@Model.MemberReference</td></tr>
                    <tr><th>@GlobalShared.matricule</th><td class="mono">@Model.Matricule</td></tr>
                    <tr><th>@GlobalSalaryProcessed.non_member_reference</th><td class="mono">@Model.NonMemberReference</td></tr>
                    <tr><th>@GlobalShared.Branch</th><td>@Model.BranchName <span class="text-muted">(@Model.BranchCode)</span></td></tr>
                    <tr><th>@GlobalShared.paid_status</th><td>@Html.Raw(Paid(Model.Status))</td></tr>
                    <tr><th>@GlobalSalaryProcessed.is_old_loan?</th><td>@Html.Raw(YesNo(Model.IsOnldLoan)) <span class="ms-2 text-muted">@Model.LoanType</span></td></tr>
                </tbody>
            </table>
        </div>

        <div class="col-md-5">
            <h6 class="section-title"><i class="mdi mdi-clipboard-text-outline"></i> @GlobalShared.File / @GlobalShared.batch</h6>
            <table class="table table-sm table-bordered kv mb-3">
                <tbody>
                    <tr><th>@GlobalSalaryProcessed.file_upload_id</th><td class="mono">@Model.FileUploadId</td></tr>
                    <tr><th>@GlobalSalaryProcessed.file_ref_id</th><td class="mono">@Model.FileUploadIdReferenceId</td></tr>
                    <tr><th>@GlobalSalaryProcessed.salary_analysis_result_id</th><td class="mono">@Model.SalaryAnalysisResultId</td></tr>
                    <tr><th>@GlobalSalaryProcessed.temp_pay_code</th><td class="mono">@Model.LastTempPayCodeId</td></tr>
                    <tr><th>@GlobalSalaryProcessed.temp_code_status</th><td>@Model.LastTempPayCodeStatus</td></tr>
                    <tr>
                        <th>@GlobalSalaryProcessed.temp_code_expires</th>
                        <td class="nowrap">
                            @(Model.LastTempPayCodeExpiresAt == DateTime.MinValue ? "—" : Model.LastTempPayCodeExpiresAt.ToString("dd/MM/yyyy HH:mm"))
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Amounts -->
    <h6 class="section-title"><i class="mdi mdi-cash-multiple"></i> @GlobalShared.amounts</h6>
    <table class="table table-sm table-bordered mb-3">
        <thead class="table-light">
            <tr>
                <th class="text-end">@GlobalSalaryProcessed.gross_salary</th>
                <th class="text-end">@GlobalShared.Saving</th>
                <th class="text-end">@GlobalShared.Deposit</th>
                <th class="text-end">@GlobalShared.Shares</th>
                <th class="text-end">@GlobalSalaryProcessed.preference_shares</th>
                <th class="text-end">@GlobalShared.Charges</th>
                <th class="text-end">@GlobalSalaryProcessed.standing_order</th>
                <th class="text-end">@GlobalShared.Remaining</th>
                <th class="text-end">@GlobalShared.net_salary</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-end">@Money(Model.Salary)</td>
                <td class="text-end">@Money(Model.Saving)</td>
                <td class="text-end">@Money(Model.Deposit)</td>
                <td class="text-end">@Money(Model.Shares)</td>
                <td class="text-end">@Money(Model.PreferenceShares)</td>
                <td class="text-end">@Money(Model.Charges)</td>
                <td class="text-end">
                    @Money(Model.StandingOrderAmount)
                    @if (!string.IsNullOrWhiteSpace(Model.StandingOrderStatement))
                    {<span class="text-muted ms-1">(@Model.StandingOrderStatement)</span>}
                </td>
                <td class="text-end">@Money(Model.RemainingSalary)</td>
                <td class="text-end fw-bold">@Money(Model.NetSalary)</td>
            </tr>
        </tbody>
    </table>

    <!-- Savings (Special) -->
    <h6 class="section-title"><i class="mdi mdi-safe-square-outline"></i> @GlobalShared.Savings (@GlobalShared.special)</h6>
    <table class="table table-sm table-bordered kv mb-3">
        <tbody>
            <tr><th>@GlobalShared.Used?</th><td>@Html.Raw(YesNo(Model.SpSavingId_Used))</td></tr>
            <tr><th>@GlobalShared.Type</th><td>@Model.SpSavingType</td></tr>
            <tr><th>@GlobalShared.Product</th><td>@Model.SpSavingProductName <span class="text-muted">(@Model.SpSavingProductId)</span></td></tr>
            <tr><th>@GlobalSalaryProcessed.saving_id</th><td class="mono">@Model.SpSavingId</td></tr>
        </tbody>
    </table>
    <table class="table table-sm table-bordered mb-3">
        <thead class="table-light">
            <tr>
                <th class="text-end">@GlobalShared.Capital</th>
                <th class="text-end">@GlobalShared.Interest</th>
                <th class="text-end">@GlobalShared.VAT</th>
                <th class="text-end">@GlobalShared.total_repayment</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-end">@Money(Model.SpSavingCapital)</td>
                <td class="text-end">@Money(Model.SpSavingInterest)</td>
                <td class="text-end">@Money(Model.SpSavingVAT)</td>
                <td class="text-end fw-bold">@Money(Model.SpSavingTotalRepayment)</td>
            </tr>
        </tbody>
    </table>

    <!-- Loans (only when present) -->
    @* Loan 1 *@
    @if ((!string.IsNullOrWhiteSpace(Model.Loan1_Main_Loan_Id)) ||
         (Model.Loan1_Main_Loan_Capital + Model.Loan1_Main_Loan_Interest + Model.Loan1_Main_Loan_VAT + Model.Loan1_Main_Loan_TotalRepayment) > 0)
    {
        <h6 class="section-title"><i class="mdi mdi-file-document-edit-outline"></i> Loan 1 – Main</h6>
        <table class="table table-sm table-bordered kv mb-2">
            <tbody>
                <tr><th>@GlobalShared.Used?</th><td>@Html.Raw(YesNo(Model.Loan1_Main_Loan_Id_Used))</td></tr>
                <tr><th>@GlobalShared.Loan_ID</th><td class="mono">@Model.Loan1_Main_Loan_Id</td></tr>
                <tr><th>@GlobalShared.Type</th><td>@Model.Loan1_Main_Loan_Type</td></tr>
                <tr><th>@GlobalShared.Product</th><td>@Model.Loan1_Main_Loan_ProductName <span class="text-muted">(@Model.Loan1_Main_Loan_ProductId)</span></td></tr>
            </tbody>
        </table>
        <table class="table table-sm table-bordered mb-3">
            <thead class="table-light">
                <tr><th class="text-end">@GlobalShared.Capital</th><th class="text-end">@GlobalShared.Interest</th><th class="text-end">@GlobalShared.VAT</th><th class="text-end">@GlobalShared.Total</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-end">@Money(Model.Loan1_Main_Loan_Capital)</td>
                    <td class="text-end">@Money(Model.Loan1_Main_Loan_Interest)</td>
                    <td class="text-end">@Money(Model.Loan1_Main_Loan_VAT)</td>
                    <td class="text-end fw-bold">@Money(Model.Loan1_Main_Loan_TotalRepayment)</td>
                </tr>
            </tbody>
        </table>
    }

    @* Loan 2 *@
    @if ((!string.IsNullOrWhiteSpace(Model.Loan2_Exceptional_Loan_Id)) ||
         (Model.Loan2_Exceptional_Loan_Capital + Model.Loan2_Exceptional_Loan_Interest + Model.Loan2_Exceptional_Loan_VAT + Model.Loan2_Exceptional_Loan_TotalRepayment) > 0)
