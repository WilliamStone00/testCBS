<!-- ======================= MODAL: Processed Salary – Details / Register ======================= -->
@using Resources
<div class="modal fade" id="salaryDetailModal" tabindex="-1" aria-labelledby="salaryDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content position-relative" id="salaryDetailModalContent" data-mode="detail">
            <!-- Header (Receipt-like card) -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-tsc m-0" id="salaryDetailModalLabel">
                                <i class="mdi mdi-file-document-outline me-2"></i>
                                <span id="salaryDetailTitleText">@GlobalSalaryProcessed.processed_salary_detail</span>
                                <span id="salaryDetailStatus" class="badge align-middle ms-2"></span>
                            </h1>

                            <!-- compact sub-line -->
                            <p class="card-text mb-0 mt-2">
                                <span class="me-3"><i class="mdi mdi-account"></i> <strong id="salaryDetailName">—</strong></span>
                                <span class="me-3"><i class="mdi mdi-card-account-details-outline"></i> Ref: <strong id="salaryDetailRef">—</strong></span>
                                <span class="me-3"><i class="mdi mdi-bank-outline"></i> <span id="salaryDetailBranch">—</span></span>
                            </p>

                            <hr style="border: 2px solid rgba(128,128,128,.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Helpful tips (collapsible) -->
            <div class="card mx-3 mt-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-tsc">
                    <span id="salaryTipsTitle">
                        <i class="mdi mdi-information-outline me-2"></i>
                        <span id="salaryTipsTitleText">@GlobalSalaryProcessed.salary_detail_tips</span>
                    </span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryTips" class="collapse">
                    <div class="card-body" id="salaryTipsBody">
                        <!-- default (detail-mode) tips -->
                        <ul class="mb-0" style="list-style:none; padding-left:0;">
                            <li class="mb-2">
                                <i class="mdi mdi-cash-multiple text-success me-2"></i>
                                <strong>@GlobalSalaryProcessed.gsalary_vs_nsalary:</strong> @GlobalSalaryProcessed.nsalary_is_after_savings_shares_charges_and_standing_order.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-percent-outline text-tsc-dark me-2"></i>
                                <strong>@GlobalShared.Remaining:</strong> @GlobalSalaryProcessed.whats_left_after_all_deductions.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-file-document-edit-outline text-tsc me-2"></i>
                                <strong>@GlobalShared.loans:</strong> @GlobalSalaryProcessed.main_exceptional_elected_special_micro_sections_render_only_when_values_exist.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-key-variant text-muted me-2"></i>
                                <strong>@GlobalSalaryProcessed.temppaycode:</strong> @GlobalSalaryProcessed.for_nonmember_payout_activation_shows_last_code_expiry.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Body (PV injected here) -->
            <div id="salaryDetailBody" class="px-3 pb-2 overflow-auto position-relative" style="max-height:65vh;">
                <!-- Loader overlay (relative to this container) -->
                <div id="salaryDetailLoader"
                     class="d-none position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex align-items-center justify-content-center"
                     style="z-index:2;">
                    <div class="text-center">
                        <div class="spinner-border mb-2" role="status" aria-hidden="true"></div>
                        <div class="small text-muted">@GlobalShared.Loading…</div>
                    </div>
                </div>
            </div>

            <!-- Footer (Close + Print with spinner) -->
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> @GlobalShared.Close
                </button>
                <button type="button" id="salaryDetailPrintBtn" class="btn btn-primary">
                    <span class="btn-text"><i class="mdi mdi-printer"></i> @GlobalShared.Print</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- ======================= /MODAL ======================= -->
