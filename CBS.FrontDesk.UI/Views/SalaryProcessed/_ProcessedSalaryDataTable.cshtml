<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="text-primary fw-bold"><i class="mdi mdi-table me-2"></i>Processed Salary Results</span>
        <small class="text-muted">Paid vs Pending with quick actions</small>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover w-100 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Names</th>                       @* MemberName *@
                        <th>M.Reference</th>                 @* MemberReference *@
                        <th class="text-end">G.Salary</th>   @* Salary *@
                        <th class="text-end">Saving</th>     @* Saving *@
                        <th class="text-end">Deposit</th>    @* Deposit *@
                        <th class="text-end">Shares</th>     @* Shares *@
                        <th class="text-end">Charges</th>    @* Charges *@
                        <th class="text-end">N.Salary</th>   @* NetSalary (moved here after Charges) *@
                        <th>Executed On</th>                 @* ExecutionDate *@
                        <th class="text-center">Status</th>  @* Paid/Pending badge *@
                        <th class="text-center">Action</th>  @* Detail / Activate buttons *@
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
