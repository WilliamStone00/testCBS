@{
    ViewBag.Title = "Processed Salary Overview";
}
@using Resources
<style>
    /* Force status column to shrink (used by DataTables render) */
    table.dataTable td.status-col {
        white-space: nowrap;
        width: 1%;
    }
    /* compact status chip in modal */
    #salaryDetailStatus.badge {
        white-space: nowrap;
        font-weight: 600;
    }
    /* comfortable PV area + safe height */
    #salaryDetailBody {
        padding-top: .25rem;
        min-height: 120px;
    }
    /* make modal header remain visible on scroll */
    .modal .sticky-top {
        z-index: 1031;
    }
</style>

<!-- ========= your hero + tips + filters remain exactly as you posted above ========= -->
<!-- Developer error area (shown only when PV load fails; modal will not open) -->
<div id="salaryDetailErrorArea" class="d-none"></div>

<!-- Results table (unchanged) -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="text-primary fw-bold"><i class="mdi mdi-table me-2"></i>@GlobalSalaryProcessed.processed_salary_results</span>
        <small class="text-muted">Paid vs Pending with quick actions</small>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover w-100 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Names</th>
                        <th>M.Reference</th>
                        <th class="text-end">@GlobalSalaryProcessed.g_salary</th>
                        <th class="text-end">@GlobalShared.Saving</th>
                        <th class="text-end">@GlobalShared.Deposit</th>
                        <th class="text-end">@GlobalShared.Shares</th>
                        <th class="text-end">@GlobalShared.Charges</th>
                        <th class="text-end">@GlobalSalaryProcessed.n_salary</th>   @* Net salary now before date *@
                        <th>Date</th>
                        <th class="text-center">@GlobalShared.Status</th>
                        <th class="text-center">@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

