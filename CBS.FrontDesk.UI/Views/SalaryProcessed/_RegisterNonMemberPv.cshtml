@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryExtract
@using CBS.FrontDesk.Data.Entity.SalaryManagement
@{
    // helpers/locals
    var nowUtc = DateTime.UtcNow;

    bool hasActiveTemp =
        !string.IsNullOrWhiteSpace(Model?.LastTempPayCodeId) &&
        Model.LastTempPayCodeExpiresAt > nowUtc &&
        (string.Equals(Model.LastTempPayCodeStatus, "active", StringComparison.OrdinalIgnoreCase)
         || string.Equals(Model.LastTempPayCodeStatus, "issued", StringComparison.OrdinalIgnoreCase));

    var kyc = Model?.RegisterNonMemberAndGenerateTempCode?.Kyc
              ?? new NoneMemberProfileCreateionRequest { BranchId = Model?.BranchId, BranchCode = Model?.BranchCode };

    var expiryToUse = Model?.RegisterNonMemberAndGenerateTempCode?.ExpiresAt ?? DateTime.UtcNow.AddHours(48);
    Func<DateTime?, string> DtLocal = dt => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    string Money(decimal v) => v.ToString("N0");
}

<style>
    .nm-hint {
        font-size: .875rem;
        color: #6c757d;
    }

    .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .kv th {
        width: 220px;
        background: #f7f7f7;
        text-transform: uppercase;
        font-weight: 600;
    }
</style>

<div class="px-3 pb-2">

    <h5 class="fw-bold text-primary mb-2">
        <i class="mdi mdi-account-plus-outline me-1"></i>
        @(hasActiveTemp ? "Non-Member Already Activated" : "Register / Activate Non-Member & Generate TempPayCode")
    </h5>

    <div id="nmAlert" class="d-none"></div>

    @if (!hasActiveTemp)
    {
        <!-- ================= Register / Activate ================= -->
        <div class="alert alert-info py-2">
            <div>
                <i class="mdi mdi-information-outline me-1"></i>
                Fill KYC and submit. A temporary payment code will be generated for this non-member.
            </div>
            <div class="nm-hint mt-1">Expiry defaults to <strong>now + 48h (UTC)</strong>. Adjust if needed.</div>
        </div>

        using (Html.BeginForm("RegisterNonMemberAndGenerateTempCode", "SalaryProcessed", FormMethod.Post, new { id = "nmForm", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()

            @* --- Hidden context (unchanged) --- *@
            <input type="hidden" name="SalaryExtractId" id="nmSalaryExtractId" value="@(Model?.Id ?? "")" />
            <input type="hidden" name="Kyc.BranchId" id="nmBranchId" value="@(kyc?.BranchId ?? Model?.BranchId ?? "")" />
            <input type="hidden" name="Kyc.BranchCode" id="nmBranchCode" value="@(kyc?.BranchCode ?? Model?.BranchCode ?? "")" />
            <br />
            <div class="row g-3">

                @* ================= Identity ================= *@
                <div class="col-12 mt-1">
                    <h6 class="fw-bold text-tsc border-bottom pb-1">
                        <i class="mdi mdi-account-badge-outline me-1"></i> Identity
                    </h6>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">First Name</label>
                    <input class="form-control" name="Kyc.FirstName" value="@(kyc?.FirstName ?? "")" required />
                    @Html.ValidationMessage("Kyc.FirstName", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Last Name</label>
                    <input class="form-control" name="Kyc.LastName" value="@(kyc?.LastName ?? "")" required />
                    @Html.ValidationMessage("Kyc.LastName", null, new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">CNI / ID No.</label>
                    <input class="form-control mono" name="Kyc.CNI" value="@(kyc?.CNI ?? "")" />
                    @Html.ValidationMessage("Kyc.CNI", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Issued Date</label>
                    <input class="form-control" type="date" name="Kyc.IssuedDate" value="@(kyc?.IssuedDate ?? "")" />
                    @Html.ValidationMessage("Kyc.IssuedDate", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Expiry Date</label>
                    <input class="form-control" type="date" name="Kyc.ExpiryDate" value="@(kyc?.ExpiryDate ?? "")" />
                    @Html.ValidationMessage("Kyc.ExpiryDate", null, new { @class = "text-danger small" })
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold">Place of Issue</label>
                    <input class="form-control" name="Kyc.PlaceOfIssued" value="@(kyc?.PlaceOfIssued ?? "")" />
                    @Html.ValidationMessage("Kyc.PlaceOfIssued", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold">Place of Birth</label>
                    <input class="form-control" name="Kyc.PlaceOfBirth" value="@(kyc?.PlaceOfBirth ?? "")" />
                    @Html.ValidationMessage("Kyc.PlaceOfBirth", null, new { @class = "text-danger small" })
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Date of Birth</label>
                    <input class="form-control" type="date" name="Kyc.DOB" value="@(kyc?.DOB?.ToString("yyyy-MM-dd") ?? "")" />
                    @Html.ValidationMessage("Kyc.DOB", null, new { @class = "text-danger small" })
                </div>

                @* ================= Contact & Address ================= *@
                <div class="col-12 mt-2">
                    <h6 class="fw-bold text-tsc border-bottom pb-1">
                        <i class="mdi mdi-home-city-outline me-1"></i> Contact & Address
                    </h6>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Phone</label>
                        <input class="form-control" name="Kyc.Phone" value="@(kyc?.Phone ?? "")" />
                        <div class="nm-hint">Include country code if international.</div>
                        @Html.ValidationMessage("Kyc.Phone", null, new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-9">
                        <label class="form-label fw-bold">Address</label>
                        <input class="form-control" name="Kyc.Address" value="@(kyc?.Address ?? "")" />
                        @Html.ValidationMessage("Kyc.Address", null, new { @class = "text-danger small" })
                    </div>
                </div>


                @* ================= Location ================= *@
                <div class="col-12 mt-2">
                    <h6 class="fw-bold text-tsc border-bottom pb-1">
                        <i class="mdi mdi-map-marker-outline me-1"></i> Location
                    </h6>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Country</label>
                    @if (ViewBag.Countries != null)
                    {
                        @Html.DropDownList("Kyc.CountryId",
                       new SelectList(ViewBag.Countries, "Id", "Name"),
                            "--- Select Country ---", new { @class = "form-select select2", id = "nmCountry", data_placeholder = "--- Select ---" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.CountryId" id="nmCountry" value="@(kyc?.CountryId ?? "")" placeholder="Country Id" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Region</label>
                    @if (ViewBag.Regions != null)
                    {
                        @Html.DropDownList("Kyc.RegionId",
                       new SelectList(ViewBag.Regions, "Id", "Name"),
                            "--- Select Region ---", new { @class = "form-select select2", id = "nmRegion", data_placeholder = "--- Select ---" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.RegionId" id="nmRegion" value="@(kyc?.RegionId ?? "")" placeholder="Region Id" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Division</label>
                    @if (ViewBag.Divisions != null)
                    {
                        @Html.DropDownList("Kyc.DivisionId",
                       new SelectList(ViewBag.Divisions, "Id", "Name"),
                            "--- Select Division ---", new { @class = "form-select select2", id = "nmDivision", data_placeholder = "--- Select ---" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.DivisionId" id="nmDivision" value="@(kyc?.DivisionId ?? "")" placeholder="Division Id" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Sub-Division</label>
                    @if (ViewBag.SubDivisions != null)
                    {
                        @Html.DropDownList("Kyc.SubDivisionId",
                       new SelectList(ViewBag.SubDivisions, "Id", "Name"),
                            "--- Select Sub-Division ---", new { @class = "form-select select2", id = "nmSubDivision", data_placeholder = "--- Select ---" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.SubDivisionId" id="nmSubDivision" value="@(kyc?.SubDivisionId ?? "")" placeholder="Sub-Division Id" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Town</label>
                    @if (ViewBag.Towns != null)
                    {
                        @Html.DropDownList("Kyc.TownId",
                       new SelectList(ViewBag.Towns, "Id", "Name"),
                            "--- Select Town ---", new { @class = "form-select select2", id = "nmTown", data_placeholder = "--- Select ---" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.TownId" id="nmTown" value="@(kyc?.TownId ?? "")" placeholder="Town Id" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Language</label>
                    @if (ViewBag.Languages != null)
                    {
                        @Html.DropDownList("Kyc.Language",
                       new SelectList(ViewBag.Languages, "Text", "Value"),
                            "--- Select Language ---", new { @class = "form-select select2", id = "nmLanguage" })
                    }
                    else
                    {
                        <input class="form-control" name="Kyc.Language" id="nmLanguage" value="@(kyc?.Language ?? "")" placeholder="Language" />
                    }
                </div>

                @* ================= Execution Context ================= *@
                <div class="col-12 mt-2">
                    <h6 class="fw-bold text-tsc border-bottom pb-1">
                        <i class="mdi mdi-key-variant me-1"></i> TempPayCode
                    </h6>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">TempPayCode Expiry (UTC)</label>
                    <input class="form-control" type="datetime-local" name="ExpiresAt" value="@DtLocal(expiryToUse)" />
                    <div class="nm-hint">If empty, server defaults to now + 48h (UTC).</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Branch</label>
                    <input class="form-control" value="@($"{Model?.BranchCode ?? ""} / {Model?.BranchId ?? ""}")" disabled />
                    <div class="nm-hint">Provided by salary extract.</div>
                </div>
            </div>

            <div class="d-flex mt-3">
                <button type="submit" id="nmSubmit" class="btn btn-success">
                    <span class="btn-text"><i class="mdi mdi-content-save-outline"></i> Register & Generate Code</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Cancel
                </button>
            </div>
        }

        <div id="nmResult" class="d-none mt-3"></div>
    }
    else
    {
        <!-- ================= Existing TempPayCode / Revoke ================= -->
        <div class="alert alert-warning py-2">
            <i class="mdi mdi-alert-decagram-outline me-1"></i>
            This entry already has an active TempPayCode. You may revoke it below.
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <table class="table table-sm table-bordered kv mb-0">
                    <tbody>
                        <tr><th>TempPayCode Id</th><td class="mono">@Model.LastTempPayCodeId</td></tr>
                        <tr><th>Status</th><td>@(Model.LastTempPayCodeStatus ?? "—")</td></tr>
                        <tr><th>Expires At</th><td>@(Model.LastTempPayCodeExpiresAt.ToString("dd/MM/yyyy HH:mm"))</td></tr>
                        <tr><th>Non-Member Ref</th><td class="mono">@Model.NonMemberReference</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-sm table-bordered kv mb-0">
                    <tbody>
                        <tr><th>Beneficiary</th><td>@Model.MemberName</td></tr>
                        <tr><th>Amount</th><td>@Money(Model.NetSalary) FCFA</td></tr>
                        <tr><th>Branch</th><td>@Model.BranchName <span class="text-muted">(@Model.BranchCode)</span></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        using (Html.BeginForm("RevokeTempPayCodes", "SalaryProcessed", FormMethod.Post, new { id = "revokeForm", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="BranchId" value="@(Model?.BranchId ?? "")" />
            <input type="hidden" name="TempPayCodeIds[0]" value="@(Model?.LastTempPayCodeId ?? "")" />

            <div class="mt-3">
                <label class="form-label fw-bold">Reason (for audit)</label>
                <textarea class="form-control" name="Reason" rows="3" placeholder="Why are you revoking this code?"></textarea>
            </div>

            <div class="d-flex mt-3">
                <button type="submit" id="revokeBtn" class="btn btn-danger">
                    <span class="btn-text"><i class="mdi mdi-block-helper"></i> Revoke TempPayCode</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Close
                </button>
            </div>
        }
    }
</div>


