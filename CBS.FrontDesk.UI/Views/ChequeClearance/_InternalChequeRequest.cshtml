
@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@{
    ViewBag.Title = "Internal Cheque Clearance Request";
}
<div class="card mb-4">
    <div class="modal-body">

        @using (Html.BeginForm())
        {
            <div class="row gy-3">

                <!-- ================= HEADER ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-money-check-alt me-1"></i>
                        Cheque Clearance Request
                    </h6>
                    <p class="text-muted small mb-0">
                        Capture internal cheque clearance details for approval.
                    </p>
                </div>

                <!-- ================= BASIC DETAILS ================= -->
                @*<div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.EnumDropDownListFor(m => m.ChequeType,
                                "Select Cheque Type",
                                new { @class = "form-control" })
                            <label>Cheque Type</label>
                        </div>
                    </div>*@

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CustomerId,
                            new { @class = "form-control", placeholder = "Member Reference" })
                        <label>Member Reference</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.BranchId,
                            new { @class = "form-control", placeholder = "Branch ID" })
                        <label>Branch</label>
                    </div>
                </div>

                <!-- ================= ACCOUNT DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-university me-1"></i>
                        Account Information
                    </h6>
                </div>

                @*<div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.AccountNumber,
                            new { @class = "form-control", placeholder = "From Account" })
                        <label>From Account Number</label>
                    </div>
                </div>*@

                @*<div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ToAccountNumber,
                            new { @class = "form-control", placeholder = "To Account" })
                        <label>To Account Number</label>
                    </div>
                </div>*@

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Amount,
                            new { @class = "form-control", type = "number", step = "0.01", placeholder = "Amount" })
                        <label>Amount</label>
                    </div>
                </div>

                <!-- ================= CHEQUE BOOK DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-book-open me-1"></i>
                        Cheque Book Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookId,
                            new { @class = "form-control", placeholder = "Cheque Book ID",@readonly  = "readonly"})
                        <label>Cheque Book ID</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookPageNumber,
                            new { @class = "form-control", type = "number", placeholder = "Page Number" ,@readonly = "readonly"})
                        <label>Cheque Book Page Number</label>
                    </div>
                </div>

                <!-- ================= OPTIONS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-cogs me-1"></i>
                        Clearing Options
                    </h6>
                </div>

                @*<div class="col-12">
                    <div class="form-check ps-2">
                        @Html.CheckBoxFor(m => m.UseOverdraft,
                            new { @class = "form-check-input", id = "UseOverdraft" })
                        <label class="form-check-label" for="UseOverdraft">
                            Use Overdraft
                        </label>
                    </div>
                </div>*@

                <!-- ================= NOTES ================= -->
                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.RequestNote, 3, 100,
                            new { @class = "form-control", placeholder = "Request Note", style = "height:100px" })
                        <label>Request Note</label>
                    </div>
                </div>

                <!-- ================= ACTION BUTTONS ================= -->
                <div class="col-12 text-end mt-3">
                    <button type="button" class="btn btn-outline-secondary shadow-sm px-4">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-success shadow-sm px-4">
                        <i class="fas fa-paper-plane me-1"></i>
                        Submit Request
                    </button>
                </div>

            </div>
        }

    </div>
</div>
