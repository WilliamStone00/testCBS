            }

            // Signature Section
            previewHTML += `
                <div style="margin-top: 40px; padding-top: 20px; border-top: 2px solid #333;">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h3 style="border-bottom: 1px solid #ccc; padding-bottom: 10px; font-size: 14px; color: #2c3e50;">AUTHORIZATION SIGNATURES</h3>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-top: 30px;">
                        <div style="flex: 1; text-align: center; margin: 0 10px; min-height: 150px;">
                            <div style="height: 70px; border-bottom: 1px solid #000; margin-bottom: 10px;"></div>
                            <p style="margin: 5px 0;"><strong>Prepared By</strong></p>
                            <p style="font-size: 11px; margin: 3px 0;">Name: _________________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Signature: ___________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Date: ________________________</p>
                        </div>
                        <div style="flex: 1; text-align: center; margin: 0 10px; min-height: 150px;">
                            <div style="height: 70px; border-bottom: 1px solid #000; margin-bottom: 10px;"></div>
                            <p style="margin: 5px 0;"><strong>Reviewed By</strong></p>
                            <p style="font-size: 11px; margin: 3px 0;">Name: _________________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Signature: ___________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Date: ________________________</p>
                        </div>
                        <div style="flex: 1; text-align: center; margin: 0 10px; min-height: 150px;">
                            <div style="height: 70px; border-bottom: 1px solid #000; margin-bottom: 10px;"></div>
                            <p style="margin: 5px 0;"><strong>Approved By</strong></p>
                            <p style="font-size: 11px; margin: 3px 0;">Name: _________________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Signature: ___________________</p>
                            <p style="font-size: 11px; margin: 3px 0;">Date: ________________________</p>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 30px; padding-top: 10px; border-top: 1px solid #333; text-align: center; font-size: 10px; color: #7f8c8d;">
                    <p>${document.getElementById('printFooter').value || 'Confidential - Internal Use Only'}</p>
                    ${document.getElementById('printTimestamp').checked ? '<p>Printed on: ' + new Date().toLocaleString() + '</p>' : ''}
                </div>
            </div>
        `;

            previewDiv.innerHTML = previewHTML;
        }

        // Generate and print final document
        function generatePrint() {
            var printWindow = window.open('', '_blank');
            var orientation = document.getElementById('printOrientation').value;

            var previewContent = document.getElementById('printPreview').innerHTML;

            var printDoc = `
<!DOCTYPE html>
<html>
<head>
    <title>Cheque Details - @Model.Id</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12pt;
