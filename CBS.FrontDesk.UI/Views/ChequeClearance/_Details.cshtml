            // Status Timeline
            if (document.getElementById('printTimeline').checked) {
                previewHTML += `
                    <div style="margin-bottom: 20px;">
                        <h3 style="color: #3498db; border-bottom: 1px solid #eee; padding-bottom: 5px; font-size: 14px;">Status Timeline</h3>
                        <div style="padding-left: 10px; margin-top: 10px;">
