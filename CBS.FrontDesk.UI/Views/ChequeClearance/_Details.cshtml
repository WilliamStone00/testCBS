@functions {
    public string GetStatusBadgeClass(string status)
    {
        switch (status?.ToUpper())
        {
            case "UNDER_OVERDRAFT":
                return "bg-warning";
            case "APPROVED":
                return "bg-success";
            case "REJECTED":
                return "bg-danger";
            case "PROCESSED":
                return "bg-primary";
            default:
                return "bg-secondary";
        }
    }

    public string GetPaymentStatusBadgeClass(string paymentStatus)
    {
        switch (paymentStatus?.ToUpper())
        {
            case "PENDING":
                return "bg-warning";
            case "PAID":
                return "bg-success";
            case "FAILED":
                return "bg-danger";
            default:
                return "bg-secondary";
        }
    }
}
