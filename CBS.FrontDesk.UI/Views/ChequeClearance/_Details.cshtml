                            <tr><td style="padding: 6px; border: 1px solid #ddd;"><strong>Net Amount:</strong></td><td style="padding: 6px; border: 1px solid #ddd;">@((Model.Amount - Model.DeduceAmount).ToString("N0")) XAF</td></tr>
                            <tr><td style="padding: 6px; border: 1px solid #ddd;"><strong>Charges:</strong></td><td style="padding: 6px; border: 1px solid #ddd;">@Model.Charges.ToString("N0") XAF</td></tr>
