
@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@{
    ViewBag.Title = "Internal Cheque Clearance Request";
}


<div class="card mb-4 shadow-sm">
    <div class="modal-body">

        @using (Html.BeginForm(
            "CreateOrUpdate",
            "ChequeClearance",
            FormMethod.Post,
            new { id = "ClearanceForm", enctype = "multipart/form-data", onsubmit = "return ClearanceSubmitAjax(this);" }))
        {
            @Html.AntiForgeryToken()

            <div class="row gy-4">

                <!-- ================= HEADER ================= -->
                <div class="col-12">
                    <h5 class="text-success border-bottom pb-2">
                        <i class="fas fa-money-check-alt me-1"></i>
                        Cheque Clearance Request
                    </h5>
                    <p class="text-muted small mb-0">
                        Capture internal cheque clearance details for approval.
                    </p>
                </div>

                <!-- ================= MEMBER & BRANCH ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pb-1">
                        <i class="fas fa-user me-1"></i>
                        Member & Branch Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CustomerId,
                            new { @class = "form-control", placeholder = "Member Reference" })
                        <label>Member Reference</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Branch</label>
                    @Html.DropDownList("BranchId",
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2", id = "BranchId", required = "required" })
                </div>

                <!-- ================= ACCOUNT DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pb-1">
                        <i class="fas fa-university me-1"></i>
                        Account Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Amount,
                            new { @class = "form-control", type = "number", step = "0.01", placeholder = "Amount" })
                        <label>Cheque Amount</label>
                    </div>
                </div>

                <!-- ================= CHEQUE BOOK DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pb-1">
                        <i class="fas fa-book-open me-1"></i>
                        Cheque Book Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookId,
                            new { @class = "form-control", placeholder = "Cheque Book ID", @readonly = "readonly" })
                        <label>Cheque Book ID</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookPageNumber,
                            new { @class = "form-control", type = "number", placeholder = "Page Number", @readonly = "readonly" })
                        <label>Cheque Book Page Number</label>
                    </div>
                </div>

                <!-- ================= CLEARING OPTIONS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pb-1">
                        <i class="fas fa-cogs me-1"></i>
                        Clearing Options
                    </h6>
                </div>

                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.RequestNote, 3, 100,
                            new { @class = "form-control", placeholder = "Request Note", style = "height:100px" })
                        <label>Request Note</label>
                    </div>
                </div>

                <!-- ================= ACTION BUTTONS ================= -->
                <div class="col-12 text-end pt-3 border-top mt-2">
                    <button type="button" class="btn btn-outline-secondary px-4 me-2">
                        Cancel
                    </button>

                    <button type="submit" id="btnSubmitClearance" class="btn btn-success px-4">
                        <i class="fas fa-paper-plane me-1"></i>
                        Submit Request
                    </button>
                </div>

            </div>
        }

    </div>
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")


<script>




        window.ClearanceSubmitAjax = function (form) {

    const $form = $(form);
    if (!$form.valid()) return false;

    alertify.confirm(
        "Confirmation",
        "Are you sure you want to Submit the request?",

        // ✅ OK
        function () {

            const $btn = $('#btnSubmitClearance'); // change to your actual button id
            const $icon = $btn.find('i');
            const $text = $btn.find('.btn-text');

            // Button loading state
            $btn.prop('disabled', true);
            $icon.removeClass().addClass('mdi mdi-loading mdi-spin');
            $text.text('Processing...');

            $.ajax({
                type: 'POST',
                url: $form.attr('action'),
                data: new FormData($form[0]),
                processData: false,
                contentType: false,

              success: function (res) {

                    if (res?.success) {

                        appalert("✅ Clearance submitted successfully.", 1, 1);

                        setTimeout(function () {

                            alertify.confirm(
                                "Next Step",
                                "Clearance ID: <b>" + res.clearanceId + "</b><br/><br/>Do you want to upload an image or go to the list?",

                                // Upload Image
                                function () {
                                    window.location.href =
                                        '@Url.Action("ImageUpload","ChequeClearance")?clearanceId=' + res.clearanceId;
                                },

                                // Go to List
                                function () {
                                    window.location.href =
                                        '@Url.Action("Index","ChequeClearance")';
                                }

                            ).set({
                                labels: {
                                    ok: "Upload Image",
                                    cancel: "Go to List"
                                }
                            });

                        }, 800);

                    } else {
                        appalert(res?.message || "❌ Failed to submit clearance request.", 2, 1);
                    }
                },

                error: function (xhr) {
                    if (xhr.status === 401)
                        window.location.href = '/Authentication/Login';

                    let errorMessage =
                        xhr.responseJSON?.message ||
                        "An error occurred during submission.";

                    appalert(errorMessage, 0, 1);
                },

                complete: function () {

                    // Reset button state
                    $btn.prop('disabled', false);
                    $icon.removeClass().addClass('mdi mdi-check');
                    $text.text('Submit');
                }
            });
        },

        // ❌ Cancel
        function () {
            appalert("🚫 Clearance submission cancelled.", 2, 1);
        }
    ).set({
        labels: { ok: 'Yes, Continue', cancel: 'Cancel' }
    });

    return false;
};

</script>

}