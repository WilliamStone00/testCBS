@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@using Resources

@* ----------------- Clearance Form ----------------- *@
@using (Html.BeginForm("CreateOrUpdate", "ChequeClearance", FormMethod.Post,
    new { enctype = "multipart/form-data", onsubmit = "return clearanceSubmitAjax(this);" }))
{
    @Html.AntiForgeryToken()


    <div id="clearanceDetailsForm" class="card shadow p-3 mb-4 mt-3">
        <h5 class="text-success mb-3">
            <i class="mdi mdi-file-document-edit me-1"></i> Cheque Clearance
        </h5>

        <div class="text-end mb-2">
            <button type="button" class="btn btn-primary btn-sm px-3"
                    data-bs-toggle="modal" data-bs-target="#discountModal">
                <i class="mdi mdi-tag"></i> Discount
            </button>
        </div>



        <div class="row">
            @if (!Model.External)
            {
                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.SameDayProcessing, new { @class = "form-check-input", id = "SameDayProcessing" })
                        <label class="form-check-label" for="SameDayProcessing">Process Same Day (otherwise 3 days)</label>
                    </div>
                </div>
            }

            <div class="col-md-6 mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.DepositToAccount, new { @class = "form-check-input", id = "DepositToAccount" })
                    <label class="form-check-label" for="DepositToAccount">Deposit into Account</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control", id = "AccountNumber" })
                    @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger" })
                    <label for="AccountNumber">Account Number</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.MemberReference, new { @class = "form-control", id = "MemberReference" })
                    @Html.ValidationMessageFor(m => m.MemberReference, "", new { @class = "text-danger" })
                    <label for="MemberReference">Member Reference</label>
                </div>
            </div>

            <!-- Other inputs like ChequeBranchId, ReceivingBranchId, Amount, Dates, etc. -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeBranchId, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ChequeBranchId, "", new { @class = "text-danger" })
                    <label>Cheque Branch Id (Created)</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ReceivingBranchId, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ReceivingBranchId, "", new { @class = "text-danger" })
                    <label>Branch Id (Receiving)</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeAmount, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.ChequeAmount, "", new { @class = "text-danger" })
                    <label>Cheque Amount</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeCreationDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.ChequeCreationDate, "", new { @class = "text-danger" })
                    <label>Cheque Creation Date</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeExpirationDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.ChequeExpirationDate, "", new { @class = "text-danger" })
                    <label>Cheque Expiration Date</label>
                </div>
            </div>

            <!-- National ID -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.NationalIdNumber, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.NationalIdNumber, "", new { @class = "text-danger" })
                    <label>National ID Number</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.NationalIdCreationDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.NationalIdCreationDate, "", new { @class = "text-danger" })
                    <label>National ID Creation Date</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.NationalIdExpirationDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.NationalIdExpirationDate, "", new { @class = "text-danger" })
                    <label>National ID Expiration Date</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- Cheque Image -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Cheque Proof Image</h5>
                <div class="image-upload-container">
                    @if (Model.ChequeImagePath != null)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                            <img src="@Model.ChequeImagePath" class="img-fluid preview-image" alt="@GlobalShared.UploadedImage">
                        </a>
                    }
                    else
                    {
                        <img src="@Url.Content(Model.ChequeImagePath)" class="img-fluid preview-image" alt="@GlobalShared.NoPhotoFound">
                    }
                </div>
            </div>
        </div>

        <!-- Save & Reset -->
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success shadow-sm px-4 me-2">
                <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Save
            </button>
            <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                @GlobalShared.Reset
            </button>
        </div>
    </div>
}






<!-- Photo Modal -->
<div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoPreviewModalLabel">@GlobalShared.PhotoPreview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                @if (Model.ChequeImagePath != null)
                {
                    <img src="@Model.ChequeImagePath" class="img-fluid" alt="@GlobalShared.PreviewImage">
                }
                else
                {
                    <img src="@Url.Content(Model.ChequeImagePath)" class="img-fluid" alt="@GlobalShared.NoImageFound">
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    
    <script>
$(function () {
    // hide SameDay if External
    if ('@(Model.External)' === 'True') {
        $('#SameDayProcessing').closest('.col-md-6').hide();
    }

    // toggle account number
    $(document).on('change', '#DepositToAccount', function () {
        if ($(this).is(':checked')) {
            $('#AccountNumberWrapper').removeClass('d-none');
        } else {
            $('#AccountNumberWrapper').addClass('d-none');
            $('#AccountNumber').val('');
        }
    });

    // reset form
    $(document).on('click', '#resetFormBtn', function () {
        $('#clearanceForm')[0].reset();
        $('#AccountNumberWrapper').addClass('d-none');
    });


});




    </script>
}
