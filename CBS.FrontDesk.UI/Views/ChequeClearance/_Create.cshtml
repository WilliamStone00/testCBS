@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@using Resources



<div class="card mb-4">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "ChequeClearance", FormMethod.Post,
                 new { id = "ClearanceForm", enctype = "multipart/form-data", onsubmit = "return ClearanceSubmitAjax(this);" }))
        {
            @Html.AntiForgeryToken()

            <div class="row gy-3">

                <!-- ================= HEADER ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-money-check-alt me-1"></i>
                        External Cheque Clearance Request
                    </h6>
                    <p class="text-muted small mb-0">
                        Capture cheque details for approval and processing
                    </p>
                </div>

                <!-- ================= BRANCH ================= -->
                <div class="col-md-12">
                    @Html.Label("BranchId", "Branch", new { @class = "form-label fw-bold" })
                    @Html.DropDownList(
                        "BranchId",
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2", required = "required" }
                    )
                </div>

                <!-- ================= BASIC CHEQUE INFO ================= -->
                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Amount,
                             new { @class = "form-control", type = "number", step = "0.01", placeholder = "Amount" })
                        <label>Cheque Amount</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalChequeNumber,
                             new { @class = "form-control", placeholder = "Cheque Number" })
                        <label>External Cheque Number</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.IsExternalCheck,
                             new { @class = "form-check-input", id = "IsExternalCheck" })
                        <label class="form-check-label" for="IsExternalCheck">
                            Is External Cheque
                        </label>
                    </div>
                </div>

                <!-- ================= EXTERNAL CHEQUE DETAILS ================= -->
                <div class="col-12 mt-3">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        External Cheque Details
                    </h6>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalCheckLeaf,
                             new { @class = "form-control", type="number", placeholder="Cheque Leaf Number" })
                        <label>Cheque Leaf Number</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalDateIssue,
                             new { @class = "form-control", type="date" })
                        <label>Date of Issue</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExpirationDate,
                             new { @class = "form-control", type="date" })
                        <label>Expiration Date</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalPlaceIssue,
                             new { @class = "form-control", placeholder="Place of Issue" })
                        <label>Place of Issue</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalLocation,
                             new { @class = "form-control", placeholder="Cheque Location" })
                        <label>Cheque Location</label>
                    </div>
                </div>

                <!-- ================= ISSUER INFO ================= -->
                <div class="col-12 mt-3">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        Issuer Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalAccountName,
                             new { @class = "form-control", placeholder="Account Holder Name" })
                        <label>Account Holder Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalAccountNumber,
                             new { @class = "form-control", placeholder="Account Number" })
                        <label>External Account Number</label>
                    </div>
                </div>

                <!-- ================= EXTERNAL BANK ================= -->
                <div class="col-12 mt-3">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        External Bank Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBankName,
                             new { @class = "form-control", placeholder="Bank Name" })
                        <label>External Bank Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBankCode,
                             new { @class = "form-control", placeholder="Bank Code" })
                        <label>Bank Code (SWIFT/BIC)</label>
                    </div>
                </div>

                

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBranchName,
                             new { @class = "form-control", placeholder="Branch Name" })
                        <label>Branch Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBranchCode,
                             new { @class = "form-control", placeholder="Branch Code" })
                        <label>Branch Code</label>
                    </div>
                </div>

                <!-- ================= BENEFICIARY ================= -->
                <div class="col-12 mt-3">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        Beneficiary
                    </h6>
                </div>

                <div class="col-md-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CustomerId,
                             new { @class = "form-control", placeholder="Member Reference" })
                        <label>Member Reference</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.RequestNote, 3, 100,
                             new { @class = "form-control", style="height:100px", placeholder="Note" })
                        <label>Request Note</label>
                    </div>
                </div>

                <!-- ================= CLEARING OPTIONS ================= -->
                <div class="col-12 mt-3">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        Clearing Options
                    </h6>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.UseOverdraft,
                             new { @class = "form-check-input" })
                        <label class="form-check-label">
                            Use Overdraft
                        </label>
                    </div>
                </div>

               <!-- ================= OVERDRAFT SECTION ================= -->
                <div id="overdraftSection">

                    <div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.TextBoxFor(m => m.CurrentClearanceAmount,
                                 new { @class = "form-control", type="number", step="0.01" })
                            <label>Amount to Clear Now</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.TextBoxFor(m => m.RemainingAmount,
                                 new { @class = "form-control", type="number", step="0.01" })
                            <label>Remaining Amount</label>
                        </div>
                    </div>

                    <!-- ================= FINANCIAL BREAKDOWN ================= -->
                    <div class="col-12 mt-3">
                        <h6 class="text-primary border-bottom pt-2 pb-1">
                            Financial Breakdown
                        </h6>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating shadow-sm">
                            @Html.TextBoxFor(m => m.DeduceAmount,
                                 new { @class = "form-control", type="number", step="0.01" })
                            <label>Deducted Amount</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating shadow-sm">
                            @Html.TextBoxFor(m => m.Charges,
                                 new { @class = "form-control", type="number", step="0.01" })
                            <label>Charges</label>
                        </div>
                    </div>   

                    <div class="col-md-4">
                        <div class="form-floating shadow-sm">
                            @Html.TextBoxFor(m => m.ReceiveAmount,
                                 new { @class = "form-control", type="number", step="0.01" })
                            <label>Amount to Receive</label>
                        </div>
                    </div>

                </div>

                <!-- ================= ACTION BUTTONS ================= -->
                <div class="col-12 text-end mt-4">
                    <button type="button"  id="btnSubmitClearance" class="btn btn-outline-secondary px-4">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-paper-plane me-1"></i>
                        Submit Request
                    </button>
                </div>

            </div>
        }
    </div>
</div>