@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest





<div class="card mb-4">
    <div class="modal-body">

        @using (Html.BeginForm())
        {

            <div class="row gy-3">

                <!-- ================= HEADER ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-money-check-alt me-1"></i>
                        External Cheque Clearance Request
                    </h6>
                    <p class="text-muted small mb-0">
                        Capture cheque details for approval and processing.
                    </p>
                </div>

                <!-- ================= CHEQUE DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-file-invoice-dollar me-1"></i>
                        Cheque Details
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownList("ChequeType",
                     new SelectList(ViewBag.ChequeType, "Value", "Text"),
                     "Select Cheque Type",
                     new { @class = "form-control select2", id = "chequeType" })
                        <label>Cheque Type</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Amount,
                     new { @class = "form-control", type = "number", step = "0.01", placeholder = "Amount" })
                        <label>Amount</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalChequeNumber,
                     new { @class = "form-control", placeholder = "Cheque Number" })
                        <label>External Cheque Number</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookPageNumber,
                     new { @class = "form-control", type = "number", placeholder = "Page Number" })
                        <label>Check Book Page Number</label>
                    </div>
                </div>

                <!-- ================= EXTERNAL BANK ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-university me-1"></i>
                        External Bank Details
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBankName,
                     new { @class = "form-control", placeholder = "Bank Name" })
                        <label>External Bank Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBankCode,
                     new { @class = "form-control", placeholder = "Bank Code" })
                        <label>External Bank Code</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBranchCode,
                     new { @class = "form-control", placeholder = "Branch Code" })
                        <label>External Branch Code</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalBranchName,
                     new { @class = "form-control", placeholder = "Branch Name" })
                        <label>External Branch Name</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ExternalAccountNumber,
                     new { @class = "form-control", placeholder = "Account Number" })
                        <label>External Account Number</label>
                    </div>
                </div>

                <!-- ================= BENEFICIARY ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-user-check me-1"></i>
                        Beneficiary & Notes
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.ToAccountNumber,
                     new { @class = "form-control", placeholder = "Account Number" })
                        <label>To Account Number</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CustomerId,
                     new { @class = "form-control", placeholder = "Member Reference" })
                        <label>Member Reference</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.RequestNote, 3, 100,
                     new { @class = "form-control", placeholder = "Note", style = "height:100px" })
                        <label>Note</label>
                    </div>
                </div>

                <!-- ================= CLEARING OPTIONS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-cogs me-1"></i>
                        Clearing Options
                    </h6>
                </div>

                <div class="col-12">
                    <div class="form-check ps-2">
                        @Html.CheckBoxFor(m => m.UseOverdraft,
                     new { @class = "form-check-input", id = "UseOverdraft" })
                        <label class="form-check-label" for="UseOverdraft">
                            Use Overdraft
                        </label>
                    </div>
                </div>


                <!-- ================= CHEQUE IMAGE UPLOAD ================= -->
                <div class="section mt-4">

                    <div class="section-title text-success mb-3">
                        <i class="fas fa-file-image me-2"></i>
                        Cheque Image Upload
                    </div>

                    <div class="image-upload-container row">

                        <!-- ================= UPLOAD AREA ================= -->
                        <div class="col-md-6">

                            <div class="upload-area border rounded p-4 text-center
                                       d-flex flex-column justify-content-center align-items-center"
                                 id="uploadArea"
                                 style="cursor:pointer; background:#f8f9fa; min-height: 320px;">

                                <div class="upload-icon mb-3 text-success">
                                    <i class="fas fa-cloud-upload-alt fa-3x"></i>
                                </div>

                                <h5 class="mb-2">Upload Cheque Image</h5>

                                <p class="text-muted mb-1">
                                    Drag & drop your cheque image here
                                </p>

                                <p class="small text-muted mb-3">
                                    JPG, PNG, PDF (Max 5MB)
                                </p>

                                <button type="button"
                                        class="btn btn-success"
                                        id="browseBtn">
                                    <i class="fas fa-folder-open me-1"></i>
                                    Browse Files
                                </button>

                                @Html.TextBoxFor(m => m.ChequeImage,
                     new
                     {
                         type = "file",
                         @class = "d-none",
                         id = "chequeImage",
                         accept = ".jpg,.jpeg,.png,.pdf"
                     })
                            </div>

                        </div>


                        <!-- ================= PREVIEW AREA ================= -->
                        <div class="col-md-6">

                            <div class="border rounded p-3 bg-white shadow-sm">

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-semibold text-success">
                                        <i class="fas fa-eye me-1"></i>
                                        Cheque Preview
                                    </span>
                                    <span id="fileName" class="small text-muted">
                                        No file selected
                                    </span>
                                </div>

                                <div id="previewContent"
                                     class="text-center p-3"
                                     style="min-height:200px;">

                                    <div id="noImage">
                                        <i class="fas fa-file-invoice fa-3x text-muted mb-2"></i>
                                        <p class="text-muted small">
                                            Uploaded cheque will appear here
                                        </p>
                                    </div>

                                    <img id="imagePreview"
                                         class="img-fluid rounded shadow-sm"
                                         style="display:none; max-height:250px;" />

                                    <div id="pdfPreview"
                                         style="display:none;"
                                         class="text-center">

                                        <i class="fas fa-file-pdf fa-4x text-danger mb-2"></i>
                                        <p class="small">PDF Document Uploaded</p>
                                    </div>
                                </div>

                                <!-- ================= ACTION BUTTONS ================= -->
                                <div class="col-12 text-end mt-3">
                                    <button type="button" class="btn btn-outline-secondary shadow-sm px-4">
                                        Cancel
                                    </button>

                                    <button type="submit" class="btn btn-success shadow-sm px-4">
                                        <i class="fas fa-paper-plane me-1"></i>
                                        Submit Request
                                    </button>
                                </div>

                            </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        }
</div>

    <script>
        const checkbox = document.getElementById("useOverdraft");
        const overdraftSection = document.getElementById("overdraftSection");

        checkbox.addEventListener("change", function () {
            overdraftSection.classList.toggle("d-none", !this.checked);
        });
    </script>




