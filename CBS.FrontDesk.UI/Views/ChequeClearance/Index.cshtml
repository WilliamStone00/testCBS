@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@using Resources
@{
    ViewBag.Title = "Cheque Clearance Request";
}
@Html.AntiForgeryToken()

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-currency-usd-circle-outline me-2"></i> @ChequeClearanceResource.Clearance_Request_Data_Table
        </h1>


    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @ChequeClearanceResource.TIPS_FOR_CHEQUE_CLEARANCE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClearanceTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseClearanceTips" class="collapse ">
        <div class="card-body">
            <ul>
                <li><strong>@ChequeClearanceResource.Verify_Cheque_Details:</strong> @ChequeClearanceResource.Ensure_the_cheque_number_amount_and_account_match_the_customer_s_information_before_processing</li>
                <li><strong>@ChequeClearanceResource.Check_Account_Balance:</strong> @ChequeClearanceResource.Confirm_that_the_issuing_account_has_sufficient_funds_to_avoid_rejection</li>
                <li><strong>@GlobalShared.Endorsements:</strong> @ChequeClearanceResource.Verify_that_the_cheque_is_properly_signed_and_endorsed_according_to_Microfinance_policy</li>
                <li><strong>@ChequeClearanceResource.External_vs_Internal:</strong> @Html.Raw(@ChequeClearanceResource.Use_External_if_the_cheque_originates_from_another_Microfinance_select_Internal_if_it_s_from_the_same_branch_system)</li>
                <li><strong>@GlobalShared.Load_Configuration:</strong> @Html.Raw(@ChequeClearanceResource.Use_the_Load_button_to_fetch_and_validate_existing_cheque_details_before_clearance)</li>
                <li><strong>@GlobalShared.Hold_Period:</strong> @ChequeClearanceResource.Be_aware_of_clearance_hold_periods_for_external_cheques_before_confirming_availability_of_funds</li>
                <li><strong>@GlobalShared.Final_Approval:</strong> @ChequeClearanceResource.Some_clearances_may_require_supervisor_authorization_check_workflow_rules_before_confirming</li>
            </ul>
        </div>
    </div>
</div>



<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">

        <a type="button" onclick=" LoadDataGen('ChequeClearance', 'myDataTable', '_ChequeClearanceDataTable', 0, 'datalistingview', null, 'list')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>


        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_MainForm','new','ChequeClearance')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalVault.AddNewVault">
            <i class="mdi mdi-plus mdi-18px"></i> @ChequeManagements.addbutton
        </a>

    </div>
</div>




<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> CLEARANCE FILTERS
    </h5>

    <form id="clearanceFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />


        <div class="card p-3 mb-3 bg-light">

            <!-- ================= TOGGLES ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- ================= BRANCH FILTER ================= -->
            <div id="branchFilter" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- ================= DATE FILTERS ================= -->
            <div id="dateFilters" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="StartDate" name="StartDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="EndDate" name="EndDate" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- ================= CORE FILTERS ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Member Reference</label>
                    <input type="text" id="CustomerId" name="CustomerId"
                           class="form-control"
                           placeholder="Enter Customer Id" />
                </div>

            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Check Book Id</label>
                    <input type="text" id="CheckBookId" name="CheckBookId"
                           class="form-control"
                           placeholder="Enter Check Book Id" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Status</label>
                    @Html.DropDownList("Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2", id = "Status" })
                </div>
            </div>
        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <button id="applyFilterBtn" type="submit"
                        class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-6">
                <button id="resetFilterBtn" type="button"
                        class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>
        </div>

    </form>
</div>


<div id="datalistingview">
    @Html.Partial("_DataTable")
</div>

@*<div id="createViewContainer"></div>*@

@*@Html.Partial("_DiscountModal", Model.Discount)*@

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
<script>

    $(document).ready(function () {



        




        function initializeClearanceTable() {
            clearanceTable = $('#myDataTable').DataTable({
                serverSide: true,
                processing: true,
                order: [[0, 'asc']],
                ajax: {
                    url: '@Url.Action("LoadClearanceData", "ChequeClearance")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {

                        const filters = collectClearanceFilter();

                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    }
                },
                columns: [
                    { data: 'CreatedDate' },
                    { data: 'BranchName' },
                    { data: 'AccountNumber' },
                    { data: 'CustomerId' },
                    { data: 'Amount' },
                    { data: 'Status' },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle text-white"
                                        style="background-color:#0dcaf0;"
                                        data-bs-toggle="dropdown">
                                    <i class="mdi mdi-cog-outline me-1"></i> Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item"
                                            onclick="ViewClearanceDetails('${row.Id}')">
                                            <i class="mdi mdi-file-document-outline me-1 text-primary"></i> Details
                                        </button>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <button class="dropdown-item"
                                            onclick="ReviewClearance('${row.Id}')">
                                            <i class="mdi mdi-eye me-1 text-info"></i> Review
                                        </button>
                                    </li>

                                    <li>
                                        <button class="dropdown-item"
                                            onclick="ApproveClearance('${row.Id}')">
                                            <i class="mdi mdi-check-circle-outline me-1 text-success"></i> Approve
                                        </button>
                                    </li>

                                    <li>
                                        <button class="dropdown-item text-danger"
                                            onclick="RejectClearance('${row.Id}')">
                                            <i class="mdi mdi-close-circle-outline me-1 text-danger"></i> Reject
                                        </button>
                                    </li>
                                </ul>
                            </div>`;
                        }
                    }
                ],
                language: {
                    emptyTable: "No clearance records found",
                    zeroRecords: "No matching records"
                }
            });
        }

              function collectClearanceFilter() {
                  return {
                      BranchId: $('#branchId').val(),
                      StartDate: $('#StartDate').val(),
                      EndDate: $('#EndDate').val(),
                      CustomerId: $('#CustomerId').val(),
                      CheckBookId: $('#CheckBookId').val(),
                      Status: $('#Status').val(),
                      Options: {} // matches C# ClearanceQuery.Options
                  };
              }


              function resetclearanceFilters() {
                  $('#clearanceFilterForm').trigger('reset');
                  $('.select2').val('').trigger('change');
                  appalert('🧹 Filters reset.', 1, 1);
              }



            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();

                initializeClearanceTable();
            });

           

        $('#resetFilterBtn').on('click', function (e) {
            e.preventDefault();
            resetclearanceFilters();
           // initializeClearanceTable();
        });

    });

</script>
}
