<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> CLEARANCE FILTERS
    </h5>

    <form id="clearanceFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />


        <div class="card p-3 mb-3 bg-light">

            <!-- ================= TOGGLES ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- ================= BRANCH FILTER ================= -->
            <div id="branchFilter" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- ================= DATE FILTERS ================= -->
            <div id="dateFilters" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="StartDate" name="StartDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="EndDate" name="EndDate" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- ================= CORE FILTERS ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Member Reference</label>
                    <input type="text" id="CustomerId" name="CustomerId"
                           class="form-control"
                           placeholder="Enter Customer Id" />
                </div>

            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Check Book Id</label>
                    <input type="text" id="CheckBookId" name="CheckBookId"
                           class="form-control"
                           placeholder="Enter Check Book Id" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Status</label>
                    @Html.DropDownList("Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2", id = "Status" })
                </div>
            </div>
        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <button id="applyFilterBtn" type="submit"
                        class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-6">
                <button id="resetFilterBtn" type="button"
                        class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>
        </div>

    </form>
</div>


<div id="datalistingview">
    @Html.Partial("_DataTable")
</div>

@*<div id="createViewContainer"></div>*@

@*@Html.Partial("_DiscountModal", Model.Discount)*@


<div class="modal fade" id="clearanceDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                <div id="clearanceDetailsContent">
                    @Html.Partial("_Details")
                    <!-- Content will load here -->
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
    <script>

    // =====================================================
    // GLOBAL VARIABLES
    // =====================================================
    let clearanceTableLoaded = false;

    // =====================================================
    // FILTER HELPERS
    // =====================================================
    function collectClearanceFilter() {
        return {
            BranchId: $('#branchId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            CustomerId: $('#CustomerId').val(),
            CheckBookId: $('#CheckBookId').val(),
            Status: $('#Status').val(),
            Options: {}
        };
    }

    function resetClearanceFilters() {
        $('#clearanceFilterForm').trigger('reset');
        $('.select2').val('').trigger('change');
        appalert('🧹 Filters reset.', 1, 1);
    }

    // =====================================================
    // LOAD DATATABLE
    // =====================================================
    function loadClearanceData() {

        $('#myDataTable').DataTable({
            serverSide: true,
            processing: false,
            destroy: true,                // ✅ allows multiple filter apply
            responsive: true,
            searching: false,
            order: [[0, 'asc']],

            ajax: {
                url: '@Url.Action("LoadClearanceData", "ChequeClearance")',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {

                    const filters = collectClearanceFilter();

                    filters.Options = {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        skip: d.start,
                        pageSize: d.length,
                        searchValue: d.search?.value || '',
                        sortColumnName: d.columns[d.order[0].column].data,
                        sortColumnDirection: d.order[0].dir
                    };

                    return JSON.stringify(filters);
                },
                error: function (xhr, status, err) {
                    console.error('❌ Load clearance failed:', status, err);
                    appalert('❌ Failed to load clearance data. Status: ' + xhr.status, 4, 1);
                }
            },

            columns: [
                {
                    data: 'CreatedDate',
                    render: data => data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : ''
                },
                { data: 'BranchName' },
                { data: 'AccountNumber' },
                { data: 'CustomerId' },
                {
                    data: 'Amount',
                    render: data => data ? parseFloat(data).toLocaleString() : '0'
                },
                {
                    data: 'Status',
                    render: function (data) {
                        if (data === 'Approved')
                            return `<span class="badge bg-success">${data}</span>`;
                        if (data === 'Rejected')
                            return `<span class="badge bg-danger">${data}</span>`;
                        if (data === 'Pending')
                            return `<span class="badge bg-warning">${data}</span>`;
                        return `<span class="badge bg-secondary">${data}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (_, __, row) {
                        return `
                        <div class="dropdown text-center">
                            <button class="btn btn-sm dropdown-toggle text-white"
                                    style="background-color:#0dcaf0;"
                                    data-bs-toggle="dropdown">
                                <i class="mdi mdi-cog-outline me-1"></i> Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <button class="dropdown-item"
                                        onclick="ViewClearanceDetails('${row.Id}')">
                                        <i class="mdi mdi-file-document-outline me-1 text-primary"></i> Details
                                    </button>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <button class="dropdown-item"
                                        onclick="ReviewClearance('${row.Id}')">
                                        <i class="mdi mdi-eye me-1 text-info"></i> Review
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item"
                                        onclick="ApproveClearance('${row.Id}')">
                                        <i class="mdi mdi-check-circle-outline me-1 text-success"></i> Approve
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item text-danger"
                                        onclick="RejectClearance('${row.Id}')">
                                        <i class="mdi mdi-close-circle-outline me-1 text-danger"></i> Reject
                                    </button>
                                </li>
                            </ul>
                        </div>`;
                    }
                }
            ],

            initComplete: function () {
                clearanceTableLoaded = true;
                appalert('✅ Clearance table loaded successfully!', 1, 1);
            },

            drawCallback: function () {
                if (!this.api().rows({ page: 'current' }).data().length) {
                    appalert('⚠️ No clearance records found.', 2, 1);
                }
            }
        });
    }

    // =====================================================
    // DOCUMENT READY
    // =====================================================
    $(document).ready(function () {

        // Apply Filter
        $('#applyFilterBtn').on('click', function (e) {
            e.preventDefault();
            clearanceTableLoaded = false;
            loadClearanceData();
        });

        // Reset Filter
        $('#resetFilterBtn').on('click', function (e) {
            e.preventDefault();
            resetClearanceFilters();
        });


        function ViewClearanceDetails(id) {

            if (!id) {
                appalert("❌ Invalid clearance ID", 2, 1);
                return;
            }

            // Optional: load details from server
            $.get('/ChequeClearance/GetClearanceDetails', { id: id }, function (response) {

                // Put response inside modal body
                $('#clearanceDetailsContent').html(response);

                // Show modal
                var modal = new bootstrap.Modal(document.getElementById('clearanceDetailsModal'));
                modal.show();
            })
                .fail(function () {
                    appalert("❌ Failed to load clearance details", 2, 1);
                });
        }

    });

    </script>

    }

