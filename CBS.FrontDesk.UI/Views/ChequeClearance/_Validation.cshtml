<!-- 🔷 Header Section -->
<div class="card-body text-center">
    <h1 class="card-title text-primary">
        <i class="mdi mdi-cash-check me-2"></i> Cheque Clearance Request
    </h1>

    <div class="alert alert-info mt-3 py-2">
        <i class="mdi mdi-information-outline me-1"></i>
        Review cheque details below and take appropriate action.
    </div>
</div>


<!-- 🔷 Cheque Details Section -->
<div class="card-body">
    <table class="table table-bordered table-striped">
        <tbody>

            <tr>
                <td class="fw-bold">Cheque ID</td>
                <td>@Model.Id</td>
            </tr>

            <tr>
                <td class="fw-bold">Customer ID</td>
                <td>@Model.CustomerId</td>
            </tr>

            <tr>
                <td class="fw-bold">Branch</td>
                <td>@Model.BranchName (@Model.BranchCode)</td>
            </tr>

            <tr>
                <td class="fw-bold">Amount</td>
                <td class="fw-bold text-primary">
                    @Model.Amount.ToString("N2")
                </td>
            </tr>

            <tr>
                <td class="fw-bold">Cheque Type</td>
                <td>
                    @(Model.IsExternalCheck ? "External Cheque" : "Internal Cheque")
                </td>
            </tr>

            @* External Cheque Fields *@
            @if (Model.IsExternalCheck)
            {
                <tr>
                    <td class="fw-bold">External Bank</td>
                    <td>@Model.ExternalBankName</td>
                </tr>

                <tr>
                    <td class="fw-bold">Cheque Number</td>
                    <td>@Model.ExternalChequeNumber</td>
                </tr>
            }

            @* Internal Cheque Field *@
            @if (!Model.IsExternalCheck)
            {
                <tr>
                    <td class="fw-bold">CheckBook Page</td>
                    <td>@Model.CheckBookPageNumber</td>
                </tr>
            }

            <!-- 🔹 Status -->
            <tr>
                <td class="fw-bold">Status</td>
                <td>
                    <span class="badge bg-@(
                        Model.Status == "APPROVED" ? "success" :
                        Model.Status == "REJECTED" ? "danger" :
                        Model.Status == "REVIEW" ? "info" :
                        "warning")">
                        @Model.Status
                    </span>
                </td>
            </tr>

        </tbody>
    </table>


    <!-- 🔘 Action Buttons -->
    <div class="mt-3 text-end">

        @* If Status = PENDING → Show Review *@
        @if (Model.Status == "PENDING")
        {
            <button class="btn btn-primary"
                    onclick="reviewCheque('@Model.Id')">
                <i class="mdi mdi-eye"></i> Review
            </button>
        }

        @* If Status = REVIEW → Show Approve & Reject *@
        @if (Model.Status == "REVIEW")
        {
            <button class="btn btn-success"
                    onclick="approveCheque('@Model.Id')">
                <i class="mdi mdi-check-circle"></i> Approve
            </button>

            <button class="btn btn-danger"
                    onclick="rejectCheque('@Model.Id')">
                <i class="mdi mdi-close-circle"></i> Reject
            </button>
        }

    </div>
</div>
