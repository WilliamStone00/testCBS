@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@using Resources
@{
    ViewBag.Title = "Cheque Clearance Request";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-bank-outline"></i></i> @GlobalShared.Clearance_Request
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @ChequeClearanceResource.Always_choose_either_Cheque_is_Internal_or_External
        </div>
    </div>
</div>


<div class="card shadow p-4 mt-4 text-center">
    @*<h4 class="text-primary mb-4">
            <i class="mdi mdi-bank-outline"></i> Cheque Clearance
        </h4>*@

    <div class="row justify-content-center">
        <div class="col-md-6 mb-3">
            <button id="externalBtn" class="btn btn-outline-primary w-100 py-3">
                <i class="mdi mdi-earth me-1"></i>
                @GlobalShared.External_Cheque
            </button>
        </div>

        <div class="col-md-6 mb-3">
            <a href="@Url.Action("List", "ChequeClearance")"
               class="btn btn-outline-success w-100 py-3">
                <i class="mdi mdi-bank me-1"></i>
                @GlobalShared.Internal_Cheque
            </a>
        </div>
    </div>
</div>

<div id="internalContainer">

    <fieldset class="fieldset-custom">
        <div class="row g-3">
            <!-- CUSTOMER SEARCH -->
            <h6 class="text-primary">
                <i class="mdi mdi-account-search-outline me-2"></i> @GlobalShared.Member_Search
            </h6>

            <div class="col-md-12">
                <label class="form-label fw-bold">@GlobalShared.Member_reference</label>
                <div class="input-group">
                    <input type="text" name="CustomerId" id="customerIdInput"
                           class="form-control" placeholder="Enter Member Reference">
                    <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Search
                    </button>
                </div>
            </div>

            <!-- DETAILS BLOCK -->
            <div id="chequebookContainer" class="mt-3"></div>

        </div>
    </fieldset>

</div>
<div id="externalContainer" class="d-none"></div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

<script>
        (function () {

            // Prevent multiple initializations (important for partial loads)
            if (window.chequeUploadInit) return;
            window.chequeUploadInit = true;

            let rotation = 0;

            // ================= SAFE FILE PICKER =================
            function openFilePicker() {
                const input = document.getElementById("chequeImage");
                if (!input) return;

                input.value = "";          // 🔥 reset so change always fires
                input.click();             // use native click (safer than trigger)
            }

            // ================= LOAD EXTERNAL PARTIAL =================
            $(document)
                .off('click', '#externalBtn')
                .on('click', '#externalBtn', function (e) {
                    e.preventDefault();

                    $('#internalContainer').addClass('d-none');
                    $('#externalContainer').removeClass('d-none');

                    $('#externalContainer').load(
                        '@Url.Action("LoadExternal", "ChequeClearance")'
                    );
                });

            // ================= BROWSE BUTTON =================
            $(document)
                .off('click', '#browseBtn')
                .on('click', '#browseBtn', function () {
                    openFilePicker();
                });

            // ================= UPLOAD AREA =================
            $(document)
                .off('click', '#uploadArea')
                .on('click', '#uploadArea', function () {
                    openFilePicker();
                });

            // ================= FILE CHANGE =================
            $(document)
                .off('change', '#chequeImage')
                .on('change', '#chequeImage', function () {

                    const file = this.files && this.files[0];
                    if (!file) return;

                    $("#fileName").text(file.name);
                    $("#noImage").hide();

                    rotation = 0; // reset rotation each time

                    if (file.type.startsWith("image/")) {

                        $("#pdfPreview").hide();
                        $("#imagePreview").show();

                        const reader = new FileReader();

                        reader.onload = function (e) {
                            $("#imagePreview")
                                .attr("src", e.target.result)
                                .css("transform", "rotate(0deg)");
                        };

                        reader.readAsDataURL(file);

                    } else if (file.type === "application/pdf") {

                        $("#imagePreview").hide();
                        $("#pdfPreview").show();
                    }
                });

            // ================= REMOVE IMAGE =================
            $(document)
                .off('click', '#removeImage')
                .on('click', '#removeImage', function () {

                    const input = document.getElementById("chequeImage");
                    if (input) input.value = "";

                    $("#imagePreview").hide().attr("src", "");
                    $("#pdfPreview").hide();
                    $("#noImage").show();
                    $("#fileName").text("No file selected");

                    rotation = 0;
                });

            // ================= ROTATION =================
            $(document)
                .off('click', '#rotateLeft')
                .on('click', '#rotateLeft', function () {
                    rotation -= 90;
                    $("#imagePreview").css("transform", "rotate(" + rotation + "deg)");
                });

            $(document)
                .off('click', '#rotateRight')
                .on('click', '#rotateRight', function () {
                    rotation += 90;
                    $("#imagePreview").css("transform", "rotate(" + rotation + "deg)");
                });

        })();



            $(document).on("click", "#searchCustomerBtn", function () {

                const customerId = $("#customerIdInput").val().trim();

                if (!customerId) {
                    appalert("Please enter Member Reference", 0, 1);
                    return;
                }

                // Optional loading state
                $("#chequebookContainer").html(`
            <div class="text-center p-3">
                <i class="mdi mdi-loading mdi-spin"></i> Loading cheque books...
            </div>`);

                $.ajax({
                    url: '/ChequeClearance/Search',   // ✅ YOUR CONTROLLER
                    type: 'GET',
                    data: { customerId: customerId },

                    success: function (partialView) {
                        $("#chequebookContainer").html(partialView);
                    },

                    error: function (err) {

                        let errorMsg = "Error loading cheque books: ";

                        if (err.status === 404) {
                            errorMsg += "Customer not found";
                        } else if (err.status === 400) {
                            errorMsg += "Invalid customer reference";
                        } else if (err.status === 500) {
                            errorMsg += "Server error occurred";
                        } else if (err.status === 401) {
                            window.location.href = '/Authentication/Login';
                            return;
                        } else {
                            errorMsg += "Unexpected error";
                        }

                        $("#chequebookContainer").html("");
                        appalert(errorMsg, 3, 1);
                    }
                });

            });

        $('#UseOverdraft').change(function () {
            if ($(this).is(':checked')) {
                // show clearance fields
            } else {
                // hide clearance fields
            }
        });









window.ClearanceSubmitAjax = function(form) {
    const $form = $(form);
    if (!$form.valid()) return false;

    function getSelectText(selector) {
        const $el = $form.find(selector);
        if (!$el.length) return "---";
        if ($el.is('select')) return $el.find('option:selected').text() || "---";
        return $el.val() || "---";
    }

    const fields = {
       
        "Amount": $form.find('#Amount').val() || "---",
        "External Cheque Number": $form.find('#ExternalChequeNumber').val() || "---",
        "Page Number": $form.find('#CheckBookPageNumber').val() || "---",
        "Bank Name": $form.find('#ExternalBankName').val() || "---",
        "Bank Code": $form.find('#ExternalBankCode').val() || "---",
        "Branch Code": $form.find('#ExternalBranchCode').val() || "---",
        "Branch Name": $form.find('#ExternalBranchName').val() || "---",
        "External Account": $form.find('#ExternalAccountNumber').val() || "---",
        "To Account": $form.find('#ToAccountNumber').val() || "---",
        "Member Reference": $form.find('#CustomerId').val() || "---",
        "Use Overdraft": $form.find('#UseOverdraft').is(':checked') ? "Yes" : "No",
        "Clear Now": $form.find('#CurrentClearanceAmount').val() || "---",
        "Remaining": $form.find('#RemainingAmount').val() || "---"
    };

    let tableRows = '';
    for (const key in fields) {
        tableRows += `<tr><th>${key}</th><td>${fields[key]}</td></tr>`;
    }

    const title = "Submit Clearance Request";
    const message = `
        <p>Please review the clearance details before submitting:</p>
        <table class="table table-sm table-bordered"><tbody>${tableRows}</tbody></table>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
            <label class="form-check-label" for="alertifyConfirmCheckbox">I confirm that the above details are correct.</label>
        </div>
    `;

    alertify.confirm(title, message,
        function() {
            $.ajax({
                type: 'POST',
                url: $form.attr('action'),
                data: new FormData($form[0]),
                processData: false,
                contentType: false,
                beforeSend: function() {
                    $('.alertify .ajs-ok').prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                },
                success: function(res) {
                    alertify.dismissAll();

                    if (res?.success) {
                        const successHtml = `
                            <div class="text-center">
                                <div class="mb-3">
                                    <i class="mdi mdi-check-circle-outline text-success" style="font-size: 4rem;"></i>
                                </div>
                                <h4 class="text-success mb-3">Clearance Submitted Successfully!</h4>
                                <p class="mb-2">Reference ID: <strong>${res.clearanceId || 'N/A'}</strong></p>
                                <p class="text-muted">Would you like to upload cheque image now?</p>
                            </div>
                        `;

                        alertify.confirm('Success', successHtml,
                            function() { window.location.href = res.uploadUrl || '@Url.Action("ImageUpload","ChequeClearance")'; },
                            function() { window.location.href = res.listingUrl || '@Url.Action("Index","ChequeClearance")'; }
                        ).set({ labels: { ok: 'Upload Image', cancel: 'Go to Listing' }, defaultFocus: 'none' });

                    } else {
                        appalert(res?.message || "❌ Failed to submit clearance request.", 2, 1);
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 401) window.location.href = '/Authentication/Login';
                    let errorMessage = xhr.responseJSON?.message || "An error occurred during submission.";
                    appalert(errorMessage, 0, 1);
                },
                complete: function() { $('.alertify .ajs-ok').prop('disabled', false).html('Yes, Continue'); }
            });
        },
        function() { appalert("🚫 Clearance submission cancelled.", 2, 1); }
    ).set({
        labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
        onshow: function() {
            const okBtn = $('.alertify .ajs-ok');
            okBtn.prop('disabled', true);
            $('#alertifyConfirmCheckbox').off('change').on('change', function() {
                okBtn.prop('disabled', !this.checked);
            });
        }
    });

    return false;
};



</script>




}
