@using Resources
<div class="card p-3 shadow mb-4">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.CreatedDate</th>
                    <th>@GlobalShared.Approved_by</th>
                    <th>@GlobalShared.IsPrinted</th>
                    <th>@GlobalShared.Category</th>
                    <th>@GlobalShared.NumOfLeaves</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
