@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest
@using Resources
<style>
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #4CAF50;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #2e7d32;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }
</style>

<!-- ✅ Header Viewer -->
<div class="header-viewer">
    <h6>
        <i class="mdi mdi-file-eye-outline me-1"></i> @ChequeClearanceResource.CHEQUE_CLEARANCE_VIEWER
    </h6>
    <p class="mb-0">
        @ChequeClearanceResource.You_are_viewing_a_detailed_summary_of_the_selected_cheque_clearance_request
        @ChequeClearanceResource.Use_this_information_to_validate_or_review_the_clearance
    </p>
</div>

<!-- ✅ Modal Body -->
<div class="modal-body">

    <!-- Branch Info -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-office-building me-1"></i> @GlobalShared.Branch_Information
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.Receiving_Branch</th><td>@Model.ReceivingBranchId</td></tr>
            <tr><th class="bg-label">@GlobalShared.Cheque_Branch</th><td>@Model.ChequeBranchId</td></tr>
        </tbody>
    </table>

    <!-- CheckBook Details -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-book-open-variant me-1"></i> @GlobalShared.CheckBook_Details
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.CheckBook_Number</th><td>@Model.CheckBookNumber</td></tr>
            <tr><th class="bg-label">@GlobalShared.Page_Number</th><td>@Model.CheckBookPageNumber</td></tr>
        </tbody>
    </table>

    <!-- Member Info -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-account-card-details me-1"></i> @GlobalShared.Member
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.Member_reference</th><td>@Model.MemberReference</td></tr>
            <tr>
                <th class="bg-label">@GlobalShared.Operation_type</th>
                <td>
                    <span class="badge @(Model.External ? "bg-success" : "bg-secondary")">
                        @(Model.External ? "External" : "Internal")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Cheque Details -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-cash me-1"></i> @GlobalShared.Cheque
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.Amount</th><td>@Model.ChequeAmount.ToString("N0") FCFA</td></tr>
            <tr><th class="bg-label">@GlobalShared.Created</th><td>@(Model.ChequeCreationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            <tr><th class="bg-label">@GlobalShared.Expires</th><td>@(Model.ChequeExpirationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
        </tbody>
    </table>

    <!-- Identification -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-card-account-details me-1"></i> @GlobalShared.Identification
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.National_ID</th><td>@Model.NationalIdNumber</td></tr>
            <tr><th class="bg-label">@GlobalShared.ID_Created</th><td>@(Model.NationalIdCreationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            <tr><th class="bg-label">@GlobalShared.ID_Expires</th><td>@(Model.NationalIdExpirationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
        </tbody>
    </table>

    <!-- Processing -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-settings me-1"></i> @GlobalShared.Processing
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr>
                <th class="bg-label">@GlobalShared.Deposit_to_Account</th>
                <td>
                    @if (Model.DepositToAccount)
                    {
                        <span class="badge bg-success">@GlobalShared.Yes (@Model.AccountNumber)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@GlobalShared.No</span>
                    }
                </td>
            </tr>
            <tr><th class="bg-label">@GlobalShared.Same_Day_Processing</th><td>@(Model.SameDayProcessing ? "Yes" : "No")</td></tr>
        </tbody>
    </table>

    <!-- Status -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-information-outline me-1"></i> @GlobalShared.Status
    </h6>
    <table class="table table-sm table-bordered">
        <tbody>
            <tr><th class="bg-label">@GlobalShared.Request_Status</th><td>@Model.Status</td></tr>
        </tbody>
    </table>

</div>

<!-- ✅ Modal Footer -->
<div class="modal-footer justify-content-start">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
</div>










<script>
    $(document).ready(function () {
        $('#clearanceDetailsModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var url = button.data('url'); // Extract info from data-url attribute
            var modal = $(this);

            // Load the content from the controller
            modal.find('.modal-content').load(url);
        });
    });
</script>
