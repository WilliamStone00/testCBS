@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest

<style>
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #4CAF50;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #2e7d32;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }
</style>

<!-- ✅ Header Viewer -->
<div class="header-viewer">
    <h6>
        <i class="mdi mdi-file-eye-outline me-1"></i> CHEQUE CLEARANCE VIEWER
    </h6>
    <p class="mb-0">
        You are viewing a detailed summary of the selected cheque clearance request.
        Use this information to validate or review the clearance.
    </p>
</div>

<!-- ✅ Modal Body -->
<div class="modal-body">

    <!-- Branch Info -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-office-building me-1"></i> Branch Information
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">Receiving Branch</th><td>@Model.ReceivingBranchId</td></tr>
            <tr><th class="bg-label">Cheque Branch</th><td>@Model.ChequeBranchId</td></tr>
        </tbody>
    </table>

    <!-- CheckBook Details -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-book-open-variant me-1"></i> CheckBook Details
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">CheckBook Number</th><td>@Model.CheckBookNumber</td></tr>
            <tr><th class="bg-label">Page Number</th><td>@Model.CheckBookPageNumber</td></tr>
        </tbody>
    </table>

    <!-- Member Info -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-account-card-details me-1"></i> Member
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">Member Reference</th><td>@Model.MemberReference</td></tr>
            <tr>
                <th class="bg-label">Operation Type</th>
                <td>
                    <span class="badge @(Model.External ? "bg-success" : "bg-secondary")">
                        @(Model.External ? "External" : "Internal")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Cheque Details -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-cash me-1"></i> Cheque
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">Amount</th><td>@Model.ChequeAmount.ToString("N0") FCFA</td></tr>
            <tr><th class="bg-label">Created</th><td>@(Model.ChequeCreationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            <tr><th class="bg-label">Expires</th><td>@(Model.ChequeExpirationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
        </tbody>
    </table>

    <!-- Identification -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-card-account-details me-1"></i> Identification
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">National ID</th><td>@Model.NationalIdNumber</td></tr>
            <tr><th class="bg-label">ID Created</th><td>@(Model.NationalIdCreationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            <tr><th class="bg-label">ID Expires</th><td>@(Model.NationalIdExpirationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
        </tbody>
    </table>

    <!-- Processing -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-settings me-1"></i> Processing
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr>
                <th class="bg-label">Deposit to Account</th>
                <td>
                    @if (Model.DepositToAccount)
                    {
                        <span class="badge bg-success">Yes (@Model.AccountNumber)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
            </tr>
            <tr><th class="bg-label">Same Day Processing</th><td>@(Model.SameDayProcessing ? "Yes" : "No")</td></tr>
        </tbody>
    </table>

    <!-- Status -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-information-outline me-1"></i> Status
    </h6>
    <table class="table table-sm table-bordered">
        <tbody>
            <tr><th class="bg-label">Request Status</th><td>@Model.Status</td></tr>
        </tbody>
    </table>

</div>

<!-- ✅ Modal Footer -->
<div class="modal-footer justify-content-start">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>










<script>
    $(document).ready(function () {
        $('#clearanceDetailsModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var url = button.data('url'); // Extract info from data-url attribute
            var modal = $(this);

            // Load the content from the controller
            modal.find('.modal-content').load(url);
        });
    });
</script>
