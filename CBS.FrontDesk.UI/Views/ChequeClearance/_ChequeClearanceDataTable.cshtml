<script>
    $(document).ready(function () {
        $('#clearanceDetailsModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var url = button.data('url'); // Extract info from data-url attribute
            var modal = $(this);

            // Load the content from the controller
            modal.find('.modal-content').load(url);
        });
    });



(function ($) {
    var getActionFormUrl = '@Url.Action("GetActionForm", "ChequeClearance")';

    function appalert(msg) {
        if (window.appalert) return window.appalert(msg, 4, 3);
        console.log('ALERT:', msg);
    }

    function ensureModal() {
        var $modal = $('#actionModal');
        if ($modal.length === 0) {
            var m = `
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">


      </div>
      <div class="modal-body" id="actionModalBody"></div>
    </div>
  </div>
</div>`;
            $('body').append(m);
            $modal = $('#actionModal');
        }
        return $modal;
    }

    function openClearanceAction(chequeClearanceId, mode) {
        if (!chequeClearanceId) { appalert('Missing clearance id'); return; }
        mode = (mode || 'review').toLowerCase();

        var $modal = ensureModal();
        var $body = $modal.find('#actionModalBody');
        $('#actionModalLabel').text((mode.charAt(0).toUpperCase() + mode.slice(1)) + ' Clearance');


        $modal.modal('show');

        $.ajax({
            url: getActionFormUrl,
            type: 'GET',
            data: { fileUploadId: chequeClearanceId, mode: mode },
            dataType: 'html',
            timeout: 20000
        })
        .done(function (response) {
            var trimmed = (response || '').trim();
            if (!trimmed) {
                $body.html('<div class="alert alert-warning">Empty response received.</div>');
                return;
            }
            if (trimmed.indexOf('<form') !== -1) {
                $body.html(response);
                $body.find('[name="ChequeClearanceId"]').val(chequeClearanceId);
                $body.find('[name="Mode"]').val(mode);
                $body.find('script').each(function () {
                    try { $.globalEval(this.innerHTML || this.text || ''); } catch (e) {}
                });
            } else {
                $body.html('<div class="alert alert-info">Unexpected HTML received:</div><div class="border p-2 small">' +
                           $('<div>').text(response).html() + '</div>');
            }
        })
        .fail(function (xhr, status, err) {
            $('#actionModalBody').html('<div class="alert alert-danger">Could not load form. ' + (err || status) + '</div>');
        });
    }

    // expose actions globally
    window.ReviewClearance = function (id) { openClearanceAction(id, 'review'); };
    window.ApproveClearance = function (id) { openClearanceAction(id, 'approve'); };
    window.RejectClearance = function (id) { openClearanceAction(id, 'reject'); };
    window.DisburseClearance = function (id) { openClearanceAction(id, 'disburse'); };

})(jQuery);

function loadClearanceData() {
    $('#myDataTable').DataTable({
        serverSide: true,
        destroy: true,
        order: [[0, 'asc']],
        ajax: {
            url: '@Url.Action("LoadClearanceData", "ChequeClearance")',
            type: 'POST',
            contentType: 'application/json',
            data: function (d) {
                const filters = collectClearanceFilterParams();
                filters.Options = {   // must match C# property name in ClearanceQuery
                    draw: d.draw,
                    start: d.start,
                    length: d.length,
                    skip: d.start,
                    pageSize: d.length,
                    sortColumnName: d.columns[d.order[0].column].data,
                    sortColumnDirection: d.order[0].dir
                };
                return JSON.stringify(filters);
            }
        },
        columns: [
            { data: 'ChequeCreationDate', name: 'ChequeCreationDate' },
            { data: 'MemberReference', name: 'MemberReference' },
            { data: 'OperationType', name: 'OperationType' },
            { data: 'ChequeAmount', name: 'ChequeAmount' },
            { data: 'ChequeExpirationDate', name: 'ChequeExpirationDate' },
            { data: 'Branch', name: 'Branch' },
            { data: 'Status', name: 'Status' },
            {
                data: null,
                orderable: false,
                render: function (data, type, row) {
                    return `
                        <div class="dropdown">
                            <button class="btn btn-sm dropdown-toggle text-white"
                                    style="background-color:#0dcaf0;"
                                    data-bs-toggle="dropdown">
                                <i class="mdi mdi-cog-outline me-1"></i> Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <button class="dropdown-item" onclick="ReviewClearance('${row.ChequeClearanceId}')">
                                        <i class="mdi mdi-eye me-1 text-info"></i> Review
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" onclick="ApproveClearance('${row.ChequeClearanceId}')">
                                        <i class="mdi mdi-check-circle-outline me-1 text-success"></i> Approve
                                    </button>
                                </li>
                            </ul>
                        </div>`;
                }
            }
        ],
        language: {
            emptyTable: "No clearance records found",
            zeroRecords: "No matching records"
        }
    });
}

function collectClearanceFilterParams() {
    return {
        BranchId: $('#branchFilter').val(),
        StartDate: $('#startDateFilter').val(),
        EndDate: $('#endDateFilter').val(),
        OperationType: $('#operationFilter').val(),
        Status: $('#statusFilter').val(),
        Options: {}   // matches C# ClearanceQuery.Options
    };
}

// Button events
$('#applyFilterBtn').on('click', function (e) {
    e.preventDefault();
    if ($.fn.DataTable.isDataTable('#myDataTable')) {
        $('#myDataTable').DataTable().destroy();
    }
    loadClearanceData();
});

$('#resetFilterBtn').on('click', function (e) {
    e.preventDefault();
    $('#branchFilter, #operationFilter, #statusFilter, #startDateFilter, #endDateFilter').val('');
    if ($.fn.DataTable.isDataTable('#myDataTable')) {
        $('#myDataTable').DataTable().destroy();
    }
});
</script>
