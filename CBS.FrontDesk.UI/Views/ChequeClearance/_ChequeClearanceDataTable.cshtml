@model IEnumerable<CBS.FrontDesk.Data.Entity.CheckManagementSystem.Clearance.ClearanceRequest.OptionRequest>
@using Resources;
@functions {
    // Accepts either DateTime or DateTime? or string; returns "-" for default/empty
    private string FmtDate(object o)
    {
        if (o == null) return "-";
        DateTime dt;
        if (DateTime.TryParse(o.ToString(), out dt))
        {
            return dt == default(DateTime) ? "-" : dt.ToString("MM/dd/yyyy HH:mm"); // includes hour and minute
        }
        return "-";
    }

    // Accepts decimal or decimal? or string; returns "-" for null/0
    private string FmtDecimalObj(object o)
    {
        if (o == null) return "-";
        decimal d;
        if (decimal.TryParse(o.ToString(), out d))
        {
            // treat 0 as empty (change if 0 is valid in your domain)
            return d == 0 ? "-" : d.ToString();
        }
        return "-";
    }

    private string FmtString(string s) => string.IsNullOrWhiteSpace(s) ? "-" : s;
    private string FmtBool(bool? b) => b.HasValue ? (b.Value ? "External" : "Internal") : "-";

}

<div class="card shadow p-3 mb-4 ">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-2"></i> Filter & Sort Clearance Requests</h5>
    <div class="bg-light">
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList(
                    "BranchId",
                    new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "name"),
                    "--- All Branches ---",
                    new { @class = "form-control select2", id = "branchFilter" }
                )
            </div>


            <!-- Start Date -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Start Date</label>
                <input type="date" id="startDateFilter" class="form-control" />
            </div>

            <!-- End Date -->
            <div class="col-md-3">
                <label class="form-label fw-bold">End Date</label>
                <input type="date" id="endDateFilter" class="form-control" />
            </div>
        </div>
        <div class="row mb-3">
            <!-- Operation Type -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Operation Type</label>
                <select id="operationFilter" class="form-control">
                    <option value="">All Types</option>
                    <option value="External">External</option>
                    <option value="Internal">Internal</option>
                </select>
            </div>



            <!-- Status -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select id="statusFilter" class="form-control">
                    <option value="">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Reviewed">Reviewed</option>
                    <option value="Approved">Approved</option>
                    <option value="Disbursed">Disbursed</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
        </div>

        <div class="col-md-9 d-flex align-items-end">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> Apply Filters
            </button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100">
                <i class="mdi mdi-refresh"></i> Reset
            </button>
        </div>

    </div>

</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-hover table-bordered" style="width:100%">

                <!-- Column widths -->
                <colgroup>
                    <col style="width: 13%;"> <!-- Cheque Creation Date -->
                    <col style="width: 13%;"> <!-- Member Reference -->
                    <col style="width: 13%;"> <!-- Operation Type -->
                    <col style="width: 13%;"> <!-- Cheque Amount -->
                    <col style="width: 13%;"> <!-- Cheque Expiration Date -->
                    <col style="width: 13%;"> <!-- Branch -->
                    <col style="width: 16%;"> <!-- Status -->
                    <col style="width: 19%;"> <!-- Actions -->
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th>Cheque Creation Date</th>
                        <th>Member Reference</th>
                        <th>Operation Type</th>
                        <th>Cheque Amount</th>
                        <th>Cheque Expiration Date</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>@FmtDate(c.ChequeCreationDate)</td>
                                <td>@FmtString(c.MemberReference)</td>
                                <td>@FmtBool(c.External)</td>
                                <td>@FmtDecimalObj(c.ChequeAmount)</td>
                                <td>@FmtDate(c.ChequeExpirationDate)</td>
                                <td>@FmtString(c.BranchId)</td>

                                <td>
                                    @switch (c.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                        case "Reviewed":
                                            <span class="badge bg-primary">Reviewed</span>
                                            break;
                                        case "Approved":
                                            <span class="badge bg-success">Approved</span>
                                            break;
                                        case "Disbursed":
                                            <span class="badge bg-info text-dark">Disbursed</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">-</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <!-- Dropdown toggle -->
                                        <button class="btn btn-sm dropdown-toggle text-white"
                                                type="button"
                                                id="actionDropdown_@idx"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                style="background-color:#0dcaf0; border:none;">
                                            <i class="mdi mdi-cog-outline me-1"></i> Actions
                                        </button>

                                        <!-- Dropdown menu -->
                                        <ul class="dropdown-menu p-2 bg-white" aria-labelledby="actionDropdown_@idx" style="min-width: 180px;">

                                            @* Pending *@
                                            @if (c.Status == "Pending")
                                            {
                                                <li>
                                                    <button class="btn w-100 mb-1 bg-transparent text-dark"
                                                            onclick="AddORUpdateGen('@c.ChequeClearanceId','datalistingview','_Edit',null,'ChequeClearance')">
                                                        <i class="mdi mdi-pencil me-1 text-primary"></i> Edit
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="btn w-100 mb-1 bg-transparent text-dark"
                                                            onclick="ReviewClearance('@c.ChequeClearanceId')">
                                                        <i class="mdi mdi-eye-check-outline me-1 text-warning"></i> Review
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="btn w-100 mb-1 bg-transparent text-dark"
                                                            onclick="RejectClearance('@c.ChequeClearanceId')">
                                                        <i class="mdi mdi-close-circle-outline me-1 text-danger"></i> Reject
                                                    </button>
                                                </li>
                                            }

                                            @* Reviewed *@
                                            else if (c.Status == "Reviewed")
                                            {
                                                <li>
                                                    <button class="btn w-100 mb-1 bg-transparent text-dark"
                                                            onclick="ApproveClearance('@c.ChequeClearanceId')">
                                                        <i class="mdi mdi-check-circle-outline me-1 text-success"></i> Approve
                                                    </button>
                                                </li>
                                            }

                                            @* Approved *@
                                            else if (c.Status == "Approved")
                                            {
                                                <li>
                                                    <button class="btn w-100 mb-1 bg-transparent text-dark"
                                                            onclick="DisburseClearance('@c.ChequeClearanceId')">
                                                        <i class="mdi mdi-cash-multiple me-1 text-warning"></i> Disburse
                                                    </button>
                                                </li>
                                            }

                                            @* Default action: Details always available *@
                                            <li>
                                                @*<button class="btn w-100 bg-transparent text-dark"
                                                            onclick="viewClearanceDetails('@c.ChequeClearanceId')">
                                                        <i class="mdi mdi-file-document-outline me-1 text-info"></i> Details
                                                    </button>*@

                                                <button class="btn w-100 bg-transparent text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#clearanceDetailsModal"
                                                        data-url="@Url.Action("Details", "ChequeClearance", new { id = c.ChequeClearanceId })">
                                                    <i class="mdi mdi-file-document-outline me-1 text-info"></i> Details
                                                </button>

                                            </li>



                                        </ul>
                                    </div>
                                </td>

                            </tr>
                            idx++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="mdi mdi-information-outline me-1"></i> No clearance records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



<div class="modal fade" id="clearanceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content"></div>
    </div>
</div>








