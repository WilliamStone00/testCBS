@model List<CBS.FrontDesk.Data.Entity.Accounting.AccountingRuleDto>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Rule Name</th>
            <th>Operation Name</th> 
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:20%">@d.RuleName</td>
                <td style="width:20%">@d.OperationName</td>
                <td style="width:50%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','AccountingRule')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.RuleName to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.OperationName" onclick="DeleteRecordDataTable('OperationEvent','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

