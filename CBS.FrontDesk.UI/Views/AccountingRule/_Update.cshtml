@model CBS.FrontDesk.Data.Entity.Accounting.AccountingRule
<div class="card-body">

    @using (Html.BeginForm("Update", "AccountingRule", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.RuleName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.RuleName, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
      
        </div>
    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">Update</button>

    </div>
}
</div>