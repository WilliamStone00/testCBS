@model CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitedUser
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@BlacklistUserRessource.BLACKLIST_USER_IP</legend>
    <div class="card-body">
        @using (Html.BeginForm("AddOrUpdate", "BlacklistUser", FormMethod.Post, new
        {
            enctype = "multipart/form-data",
            onsubmit = "return AjaxPostAndUpdate(this);"
        }))
        {
            <div class="row mt-3 gy-3">
                <!-- User ID -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.BlockRequest.UserId,
                            new SelectList(ViewBag.Users, "Value", "Text"),
                            "--- Select User ---",
                            new { @class = "form-control select2", id = "UserId", @search = "true" }
                        )
                        @Html.ValidationMessageFor(m => m.BlockRequest.UserId, "", new { @class = "text-danger" })
                        <label for="UserId">@GlobalShared.userAccount</label>
                    </div>
                </div>

                <!-- User IP -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BlockRequest.UserIP, new { @class = "form-control", id = "BlockRequest_UserIP", placeholder = "192.168.1.1 or IPv6" })
                        @Html.ValidationMessageFor(m => m.BlockRequest.UserIP, "", new { @class = "text-danger" })
                        <label for="BlockRequest_UserIP">@BlacklistUserRessource.Blocked_IPs</label>
                        <span id="ipError" class="text-danger small d-block mt-1" style="display: none;"></span>
                    </div>
                </div>

                <!-- Block Duration -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BlockRequest.NumberOfDays, new { @class = "form-control", type = "number", min = 1, max = 365 })
                        @Html.ValidationMessageFor(m => m.BlockRequest.NumberOfDays, "", new { @class = "text-danger" })
                        <label for="NumberOfDays">@BlacklistUserRessource.Set_a_reasonable_block_duration_long_enough_to_deter_abuse</label>
                    </div>
                </div>

                <!-- Reason -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.BlockRequest.Reason, new { @class = "form-control", style = "height: 150px;", placeholder = "Reason for blocking the user or IP." })
                        @Html.ValidationMessageFor(m => m.BlockRequest.Reason, "", new { @class = "text-danger" })
                        <label for="Reason">@BlacklistUserRessource.Reason_for_Blocking</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            </div>
        }
    </div>
</fieldset>


