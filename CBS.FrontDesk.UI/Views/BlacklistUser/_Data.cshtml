@model List<CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitedUser>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@BlacklistUserRessource.BLACKLISTED_USERS</legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>@BlacklistUserRessource.No_users_or_IPs_are_currently_blacklisted.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered align-middle" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 10%;">IP</th>
                        <th style="width: 15%;">@GlobalShared.userAccount</th>
                        <th style="width: 15%;">@BlacklistUserRessource.Blocked_On</th>
                        <th style="width: 10%;">@BlacklistUserRessource.Type</th>
                        <th style="width: 18%;">@BlacklistUserRessource.Location</th>
                        <th style="width: 19%;">@BlacklistUserRessource.Reason</th>
                        <th style="width: 13%;">@BlacklistUserRessource.Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.BlockedAt))
                    {
                        <tr>
                            <td>@item.IpAddress</td>
                            <td>@(item.UserName ?? "N/A")</td>
                            <td>@item.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    string blockTypeClass;

                                    if (item.BlockType == "IP-Based")
                                    {
                                        blockTypeClass = "bg-danger";
                                    }
                                    else if (item.BlockType == "User-Based")
                                    {
                                        blockTypeClass = "bg-warning text-dark";
                                    }
                                    else if (item.BlockType == "Suspicious-Attack")
                                    {
                                        blockTypeClass = "bg-danger";
                                    }
                                    else if (item.BlockType == "Manual")
                                    {
                                        blockTypeClass = "bg-dark";
                                    }
                                    else
                                    {
                                        blockTypeClass = "bg-secondary";
                                    }
                                }

                                <span class="badge @blockTypeClass">@item.BlockType</span>
                            </td>



                            <td>@(item.Location ?? "—")</td>
                            <td>@(item.Reason ?? "—")</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Detail Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info"
                                            onclick="showBlacklistDetails('@item.Id')"
                                            data-bs-toggle="tooltip"
                                            title="View Block Details">
                                        <i class="fas fa-eye me-1"></i> @GlobalShared.Details
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="DeleteDynamic('BlacklistUser','Delete','@item.Id','myDataTable','_Data', 0,'datalistingview')"
                                            data-bs-toggle="tooltip"
                                            title="Remove from Blacklist">
                                        <i class="fas fa-trash-alt me-1"></i> @GlobalShared.Delete
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
