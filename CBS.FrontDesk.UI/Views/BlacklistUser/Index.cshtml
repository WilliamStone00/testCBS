@{
    ViewBag.Title = "Blacklist Management";
}
@using Resources
<style>
    table#Detail td {
        word-wrap: break-word;
        white-space: pre-wrap;
        max-width: 500px;
        vertical-align: top;
        text-align: left; /* ✅ this fixes the alignment issue */
    }
</style>


<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-danger">
                    <i class="mdi mdi-account-cancel-outline me-2"></i> @BlacklistUserRessource.Blacklisted_Users_LC
                </h1>
                <p class="card-text">
                    @BlacklistUserRessource.Manage_users_and_IPs_that_have_been_blocked_due_to_suspicious_or_abusive_behavior.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @BlacklistUserRessource.Ensure_IP_or_User_ID_is_accurate_before_applying_a_block.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @BlacklistUserRessource.Set_a_reasonable_block_duration_long_enough_to_deter_abuse.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @BlacklistUserRessource.Monitor_location_branch_and_timestamp_info_for_investigation.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main View -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-lock-alert me-2"></i> @BlacklistUserRessource.Blacklist_Configuration
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-4">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button" onclick="LoadDataGen('BlacklistUser','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                        </a>
                                        <a href="/BlacklistUser" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Block">
                                            <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add
                                        </a>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_Create")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="blacklistDetailModal" tabindex="-1" aria-labelledby="blacklistDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="blacklistDetailModalLabel">
                    <i class="mdi mdi-eye-outline text-primary me-1"></i> @BlacklistUserRessource.Blacklisted_User_Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="blacklistDetailContent">
                <!-- AJAX-loaded partial view (_Details.cshtml) will appear here -->
                <div class="text-center text-muted">
                    <i class="fas fa-spinner fa-spin"></i> @GlobalShared.Loading...
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function showBlacklistDetails(id) {
            $('#blacklistDetailModal').modal('show');
            $('#blacklistDetailContent').html('<div class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Loading details...</div>');

            $.get('/BlacklistUser/Details', { id: id })
                .done(function (html) {
                    $('#blacklistDetailContent').html(html);
                })
                .fail(function () {
                    $('#blacklistDetailContent').html('<div class="text-danger">Failed to load details.</div>');
                });
        }

        function isIntegerOnly(input) {
            return /^[0-9]+$/.test(input);
        }

        function isValidIpFormat(ip) {
            const ipv4Format = /^(([0-9]{1,3}\.){3}[0-9]{1,3})$/;
            const ipv6Format = /^([a-fA-F0-9:]+)$/;
            return ipv4Format.test(ip) || ipv6Format.test(ip);
        }

        function isPrivateIp(ip) {
            // Only check private IPv4 ranges (most common case)
            const privateIPv4 = /^(10\.|127\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)/;
            const loopbackIPv6 = /^::1$/;
            const linkLocalIPv6 = /^fe80:/i;

            return privateIPv4.test(ip) || loopbackIPv6.test(ip) || linkLocalIPv6.test(ip);
        }

        $(document).ready(function () {
            const $ipInput = $('#BlockRequest_UserIP');
            const $error = $('#ipError');

            if ($ipInput.length) {
                $ipInput.on('blur', function () {
                    const ip = $ipInput.val().trim();
                    $error.hide();

                    if (!ip) {
                        $error.text("IP address is required.").show();
                        return;
                    }

                    if (isIntegerOnly(ip)) {
                        $error.text("IP address cannot be a pure number.").show();
                        return;
                    }

                    if (!isValidIpFormat(ip)) {
                        $error.text("Invalid IP address format. Please enter a valid IPv4 or IPv6 address.").show();
                        return;
                    }

                    if (isPrivateIp(ip)) {
                        $error.text("The IP address is private or reserved. Only public IP addresses are allowed.").show();
                        return;
                    }
                });
            }
        });
    </script>


}
