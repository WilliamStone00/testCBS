@model CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitedUser
@using Resources
<div class="card-body">
    <table class="table table-bordered table-striped table-sm" id="Detail">
        <tbody>
            <!-- General Information -->
            <tr class="table-primary text-center fw-bold">
                <td colspan="2">General Information</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Full_Name:</td>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Username:</td>
                <td>@Model.UserName</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Phone_Number:</td>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>
                <td class="fw-semibold">@BlacklistUserRessource.Blocked_By:</td>
                <td>@Model.BlockedBy</td>
            </tr>

            <!-- Blocking Details -->
            <tr class="table-primary text-center fw-bold">
                <td colspan="2">@BlacklistUserRessource.Blocking_Details</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.IP_Address:</td>
                <td>@Model.IpAddress</td>
            </tr>
            <tr>
                <td class="fw-semibold">CIDR:</td>
                <td>@Model.Cidr</td>
            </tr>
            <tr>
                <td class="fw-semibold">@BlacklistUserRessource.Block_Type:</td>
                <td class="text-start">
                    <span class="badge bg-@(Model.BlockType == "IP-Based" ? "danger" : "warning text-dark")">
                        @Model.BlockType
                    </span>
                </td>
            </tr>

            <tr>
                <td class="fw-semibold">@GlobalShared.Reason:</td>
                <td class="text-wrap text-break" style="max-width: 500px;">@Model.Reason</td>
            </tr>

            <tr>
                <td class="fw-semibold">@BlacklistUserRessource.Blocked_On:</td>
                <td>@Model.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
            </tr>
            <tr>
                <td class="fw-semibold">@BlacklistUserRessource.Block_Ends:</td>
                <td>@Model.BlockEndTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Active?</td>
                <td>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">@GlobalShared.Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@GlobalShared.Expired</span>
                    }
                </td>
            </tr>

            <!-- Branch & Location -->
            <tr class="table-primary text-center fw-bold">
                <td colspan="2">@GlobalShared.Branch & @GlobalShared.Location</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Branch_ID:</td>
                <td>@Model.BranchId</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Branch_Code:</td>
                <td>@Model.BranchCode</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Branch_Name:</td>
                <td>@Model.BranchName</td>
            </tr>

            <!-- Geo Information -->
            <tr class="table-primary text-center fw-bold">
                <td colspan="2">@BlacklistUserRessource.Geolocation_Details</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Country:</td>
                <td>@Model.Country</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Region:</td>
                <td>@Model.Region</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.City:</td>
                <td>@Model.City</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Location:</td>
                <td>@Model.Location</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Latitude:</td>
                <td>@Model.Latitude</td>
            </tr>
            <tr>
                <td class="fw-semibold">@GlobalShared.Longitude:</td>
                <td>@Model.Longitude</td>
            </tr>
        </tbody>
    </table>

    <div class="text-center mt-4">
        <button class="btn btn-outline-primary px-4" onclick="DeleteDynamic('BlacklistUser','Delete','@Model.Id','myDataTable','_Data', 0,'datalistingview')">
            <i class="fas fa-unlock me-1"></i> @BlacklistUserRessource.Unblock_Delete_User_or_IP
        </button>
    </div>
</div>
