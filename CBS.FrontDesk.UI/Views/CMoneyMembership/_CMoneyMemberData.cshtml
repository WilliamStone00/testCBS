
@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> C-Money Member Activations Listing</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Name</th>
                    <th>@GlobalCMoneyMembership.MReference</th>
                    <th>@GlobalShared.Phone</th>
                    <th>@GlobalShared.Activated_by</th>
                    <th>BCD</th>
                    <th>@GlobalCMoneyMembership.ADate</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Login</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


