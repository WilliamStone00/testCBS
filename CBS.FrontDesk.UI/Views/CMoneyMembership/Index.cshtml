@{
    ViewBag.Title = "C-Money Member Activations Overview";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-check me-2"></i> C-MONEY MEMBER ACTIVATIONS
                </h1>
                <p class="card-text">
                    Track, search, and analyze member activations across branches. Use filters to view activations by user, branch, activation date, subscription status, and more.
                </p>
                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Use advanced search, date ranges, and status filters to pinpoint key activation records. Export the data for reporting and audit compliance.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR USING C-MONEY ACTIVATION FILTERS EFFECTIVELY</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Filter by Branch:</strong> Use branch code or name to narrow activations.</li>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>Date Range:</strong> Filter by activation and last payment date ranges.</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>Activated By:</strong> Filter by activation user.</li>
                <li><i class="mdi mdi-star-circle-outline text-primary me-2"></i> <strong>Subscription & PIN Status:</strong> Filter by subscription or PIN change state.</li>
                <li><i class="mdi mdi-file-export-outline text-success me-2"></i> <strong>Export:</strong> Export filtered activations to Excel.</li>
                <li><i class="mdi mdi-reload text-info me-2"></i> <strong>Refresh Often:</strong> To keep data up to date.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Advanced Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Advanced Filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" />
                <label class="form-check-label fw-bold" for="byBranch">Filter By Branch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byUser" />
                <label class="form-check-label fw-bold" for="byUser">Filter By User</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" />
                <label class="form-check-label fw-bold" for="byDate">Filter By Date Range</label>
            </div>
        </div>

        <div id="branchFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="branchInput" class="form-label fw-bold">Select Branch</label>
                @Html.DropDownList(
                    "branchInput",
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "--- Select Branch ---",
                    new { @class = "form-control shadow-sm select2", @id = "branchInput" }
                )
            </div>
        </div>
 
        <div id="userFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label class="form-label fw-bold">Search By User</label>
                <input type="text" id="activatedBy" class="form-control" placeholder="Activated By (User)" />
            </div>
        </div>

        <div id="dateRangeSection" class="row mb-3" style="display:none;">
            <div class="col-md-6">
                <input type="date" id="activationDateFrom" class="form-control" placeholder="Activation Date From (dd/mm/yyyy)" />
            </div>
            <div class="col-md-6">
                <input type="date" id="activationDateTo" class="form-control" placeholder="Activation Date To (dd/mm/yyyy)" />
            </div>

        </div>


        <div class="row">
            <div class="col-md-3 mb-2"><input type="text" id="customerId" class="form-control" placeholder="Customer ID" /></div>
            <div class="col-md-3 mb-2"><input type="text" id="loginId" class="form-control" placeholder="Login ID" /></div>
            <div class="col-md-3 mb-2"><input type="text" id="phoneNumber" class="form-control" placeholder="Phone Number" /></div>
            <div class="col-md-3 mb-2"><input type="text" id="name" class="form-control" placeholder="Customer Name" /></div>
        </div>
        <div class="row">
            <div class="col-md-3 mb-2">
                <select id="activationStatus" class="form-select">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Deactivated</option>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <select id="hasChangedDefaultPin" class="form-select">
                    <option value="">Changed Default PIN?</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <select id="isSubscribed" class="form-select">
                    <option value="">Subscription Status</option>
                    <option value="true">Subscribed</option>
                    <option value="false">Not Subscribed</option>
                </select>
            </div>
            <div class="col-md-3 mb-2 d-flex">
                <input type="number" id="failedAttemptsMin" class="form-control me-1" placeholder="Min Attempts" />
                <input type="number" id="failedAttemptsMax" class="form-control" placeholder="Max Attempts" />
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> Apply Filter</button>
            <button id="resetFilterBtn" class="btn btn-secondary me-2 w-100"><i class="mdi mdi-refresh"></i> Reset</button>
            <button id="exportBtn" class="btn btn-success w-100"><i class="mdi mdi-file-excel"></i> Export</button>
        </div>
    </div>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_CMoneyMemberData")
</div>

@section Scripts {

    <script src="~/Scripts/Js/CMoney/cmMembers.js"></script>
}
