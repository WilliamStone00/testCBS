<fieldset class="fieldset-custom p-4 border border-secondary rounded shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-7 mx-auto">
            <input type="hidden" class="form-control shadow-sm" value="activation" id="currentselectedOperation" />
            <div class="input-group">
                <input type="text" id="manualSearchInput" class="form-control shadow-sm"
                       placeholder="Enter Member Reference Number: 0120050001001"
                       aria-label="Search Member Reference"
                       aria-describedby="searchButton">
                <button class="btn btn-primary shadow-sm" id="searchButton" onclick="GetMember()">
                    <i class="mdi mdi-account-check"></i> Search
                </button>
            </div>
        </div>
    </div>
</fieldset>
