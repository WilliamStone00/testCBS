@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    ViewBag.Title = @GlobalCMoneyMembership.MobileAccountActivation;
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="container mt-4">
    <header class="text-center mb-4">
        <h1 class="text-primary fw-bold">@GlobalCMoneyMembership.CMONEYACCOUNTACTIVATION</h1>
        <p class="text-muted">@GlobalCMoneyMembership.EasilyManageAndActivateAccountsWithOurSimpleInterface.</p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </header>

    <div class="row">
        <div class="col">
            <div class="accordion" id="activationAccordio">
                <!-- Activation Section -->
                <div class="accordion-item mb-3 shadow">
                    <h2 class="accordion-header" id="headingActivation">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseActivation" aria-expanded="true" aria-controls="collapseActivation">
                            <i class="mdi mdi-account-key-outline me-2"></i>
                            @GlobalCMoneyMembership.CMONEYACCOUNTACTIVATION
                        </button>
                    </h2>
                    <div id="collapseActivation" class="accordion-collapse collapse show" data-bs-parent="#activationAccordio">
                        <div class="accordion-body">
                            <!-- Search Box -->
                            @Html.Partial("_SearchBox")
                            <!-- Data Listing View -->
                            <div id="datalistingview">
                                <p class="text-muted">@GlobalCMoneyMembership.NoSearchResultWasFound.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Other Sections Can Be Added Below -->
            </div>
        </div>
    </div>
</div>

