<style>
    /* Custom Styles */
    .accordion-button {
        font-weight: bold;
        color: #0056b3;
        background-color: #f8f9fa;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    .badge {
        display: inline-flex;
        align-items: center;
        font-size: 1rem;
    }
    .upload-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        border: 2px dashed #ccc;
        padding: 20px;
        border-radius: 8px;
    }

        .upload-container .image-preview img {
            max-width: 150px;
            max-height: 150px;
            border-radius: 50%;
            object-fit: cover;
        }

    .custom-file-upload {
        cursor: pointer;
    }

    /*.btn-primary {
        margin-top: 10px;
    }*/

        .badge i {
            font-size: 1.2rem;
        }

        .accordion-button:hover {
            background-color: #e9ecef;
            color: #00376d;
        }

        .accordion-button i {
            font-size: 1.2rem;
        }

    .accordion-body {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.125);
        border-top: none;
        padding: 1.5rem;
    }

    hr {
        border: 1px solid rgba(128, 128, 128, 0.5);
        margin: 1rem 0;
    }

    header h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    header p {
        font-size: 1rem;
    }
</style>
