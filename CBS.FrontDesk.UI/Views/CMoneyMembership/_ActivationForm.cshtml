@model CBS.FrontDesk.Data.Entity.CMoney.CMoneyMembersActivationAccount

<header class="text-center my-4">
    <p class="text-muted">Activate a member's account by verifying their phone number and completing the required details.</p>
    <hr style="border: 3px solid rgba(128, 128, 128, 0.7);" />
</header>

<div class="text-center mb-4">
    <div class="status-indicator">
        @if (Model.Customer.IsUseOnLineMobileBanking)
        {
            <span class="badge bg-success py-2 px-4">
                <i class="mdi mdi-check-circle-outline me-2"></i> Member is <strong>Activated</strong>
            </span>
        }
        else
        {
            <span class="badge bg-danger py-2 px-4">
                <i class="mdi mdi-alert-circle-outline me-2"></i> Member is <strong>Not Activated</strong>
            </span>
        }
    </div>
</div>

@if (!Model.Customer.IsUseOnLineMobileBanking)
{
    <div class="accordion" id="activationAccordion">
        <!-- Procedure Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="procedureHeading">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#procedureCollapse" aria-expanded="true" aria-controls="procedureCollapse">
                    ACTIVATION PROCEDURE
                </button>
            </h2>
            <div id="procedureCollapse" class="accordion-collapse collapse show" aria-labelledby="procedureHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Follow these steps to activate a member for C-MONEY Mobile Application usage:</p>
                    <ol class="text-muted">
                        <li>Member should provide a valid phone number.</li>
                        <li>Send an OTP code to the member's default phone number for verification.</li>
                        <li>Enter the OTP code received by the member to validate the phone number.</li>
                        <li>After the member confirms the OTP with their phone number, any other instances of the same phone number used by another member in the system will be overwritten.</li>
                        <li>Login ID will be automatically generated by the system, combining the BranchCode and the last 4 digits of the Member Reference. If duplicates exist, it may extend to 5 digits for uniqueness.</li>
                        <li>Upload the member's photo to complete their profile. Ensure the photo is clear and adheres to the format requirements.</li>
                        <li>Advise the member to set their security question and answer. This will be used if the member forgets their PIN code.</li>
                        <li>Submit the form to finalize the activation process.</li>
                        <li>Advise the member to change the default PIN. Members will not have access until the PIN is changed.</li>
                        <li>The Member Service will assist members through the login process.</li>
                        <li>Note that for every activation, the member receives login credentials via SMS. Advise members to keep credentials confidential.</li>
                    </ol>

                    <p class="text-muted">Once activated, the member will have access to C-MONEY Mobile Application features, enabling seamless financial transactions.</p>
                </div>
            </div>
        </div>

        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="imageUploadHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#imageUploadCollapse" aria-expanded="false" aria-controls="imageUploadCollapse">
                    UPLOAD MEMBER PHOTO
                </button>
            </h2>
            <div id="imageUploadCollapse" class="accordion-collapse collapse" aria-labelledby="imageUploadHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <div class="card-body text-center">
                        @using (Html.BeginForm("UploadImage", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                        {
                            @Html.HiddenFor(model => model.CustomerDocumentRequest.CustomerID)
                            <input type="hidden" name="option" value="upload" />
                            <input type="hidden" name="CustomerDocumentRequest.DocumentType" value="CustomerPhoto" />

                            <!-- Upload Container -->
                            <div class="upload-container d-flex flex-column align-items-center justify-content-center">
                                <!-- Image Preview -->
                                <div class="image-preview mb-3">
                                    <img src="@Url.Content(Model.Customer.ImageVirtualPath)" alt="No Image Found" id="previewimage" class="img-fluid rounded shadow" style="max-width: 200px; max-height: 200px;" />
                                </div>

                                <!-- Choose Photo Button -->
                                <label for="imageuploadSignature" class="custom-file-upload btn btn-outline-primary mb-3">
                                    <i class="fas fa-cloud-upload-alt"></i> Choose Photo
                                </label>
                                <input type="file" name="CustomerDocumentRequest.AttachedFiles" accept="image/jpeg,image/png,image/JPG" id="imageuploadSignature" onchange="ShowImagePreview(this, document.getElementById('previewimage'))" style="display: none;" />

                                <!-- Submit Button -->

                            </div>

                            <div class="form-group mt-3">
                                <button type="button" class="btn btn-outline-primary" id="cameraButton" onclick="OpenCamera()">
                                    <i class="fas fa-camera"></i> Use Camera
                                </button>
                            </div>
                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary">Upload Photo</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>



        <!-- OTP Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="otpHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#otpCollapse" aria-expanded="false" aria-controls="otpCollapse">
                    SEND OTP CODE
                </button>
            </h2>
            <div id="otpCollapse" class="accordion-collapse collapse" aria-labelledby="otpHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted text-center">Verify the member's phone number [@Model.Customer.Phone] by sending a one-time password (OTP).</p>
                    @using (Html.BeginForm("GenerateOTP", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateActivateCMoneyMembersOTP(this);" }))
                    {
                        @Html.HiddenFor(m => m.GenerateMemberActivationOTPCommand.CustomerId)
                        <div class="mb-3">
                            <label for="PhoneNumber" class="form-label">Phone Number</label>
                            @Html.TextBoxFor(m => m.GenerateMemberActivationOTPCommand.PhoneNumber, new { @class = "form-control shadow-input-boxes", @id = "otpphonNumber" })
                            @Html.ValidationMessageFor(m => m.GenerateMemberActivationOTPCommand.PhoneNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="text-center mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-2"></i> Send OTP to @Model.Customer.name
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Activation Form Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="activationFormHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#activationFormCollapse" aria-expanded="false" aria-controls="activationFormCollapse">
                    ACTIVATION FORM
                </button>
            </h2>
            <div id="activationFormCollapse" class="accordion-collapse collapse" aria-labelledby="activationFormHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    @using (Html.BeginForm("Create", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateActivateCMoneyMembers(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="change-group">
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-8">
                                        <div class="form-floating form-floating-outline">
                                            <span class="formatted-amount shadow-box float-start">Member's Name: <strong>@Model.Customer.name</strong></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Subscription Fee: <strong>0.0</strong></span>
                                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="memberName" value="@Model.Customer.name" />
                                <hr style="border: 3px solid rgba(128, 128, 128, 0.7);" />

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.AddCMoneyMemberActivationCommand.PhoneNumber, new { @class = "form-control shadow-input-boxes", @id = "phoneNumberId" })
                                            @Html.ValidationMessageFor(m => m.AddCMoneyMemberActivationCommand.PhoneNumber, "", new { @class = "text-danger" })
                                            <label>DEFAULT PHONE NUMBER</label>
                                            <p class="text-muted small mt-1">Please enter the member's default phone number for receiving OTPs and communication.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.AddCMoneyMemberActivationCommand.LoginId, new { @class = "form-control shadow-input-boxes", @readonly = "readonly", @id = "loginId" })
                                            @Html.ValidationMessageFor(m => m.AddCMoneyMemberActivationCommand.LoginId, "", new { @class = "text-danger" })
                                            <label>LOGIN ID</label>
                                            <p class="text-muted small mt-1">Login ID is automatically generated by the system and communicated to the member.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.AddCMoneyMemberActivationCommand.OTP, new { @class = "form-control shadow-input-boxes", @id = "otpid" })
                                            @Html.ValidationMessageFor(m => m.AddCMoneyMemberActivationCommand.OTP, "", new { @class = "text-danger" })
                                            <label>OTP CODE</label>
                                            <p class="text-muted small mt-1">Enter the OTP sent to the member's phone for verification.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.AddCMoneyMemberActivationCommand.Language, new SelectList(ViewBag.Languages, "Value", "Text"), "---Select language---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.AddCMoneyMemberActivationCommand.Language, "", new { @class = "text-danger" })
                                            <label>Select member preferred language for SMS</label>
                                        </div>
                                    </div>
                                </div>

                                <hr style="border: 3px solid rgba(128, 128, 128, 0.7);" />

                                <div class="header-buttons mt-4 text-center">
                                    @Html.HiddenFor(m => m.AddCMoneyMemberActivationCommand.CustomerId)
                                    @Html.HiddenFor(m => m.AddCMoneyMemberActivationCommand.BranchId)
                                    @Html.HiddenFor(m => m.AddCMoneyMemberActivationCommand.BranchCode)
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success py-2 px-4">Member is <strong>Activated</strong></span>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">
                                            <i class="fas fa-save me-2"></i> SAVE
                                        </button>
                                        <input type="hidden" name="Option" value="create" id="Option" />
                                    }

                                </div>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>
    </div>

}

<script>
    // Function to show image preview
    function ShowImagePreview(input, imgElement) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                imgElement.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function OpenCamera() {
        const modalHtml = `
        <div class="modal fade" id="cameraModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Capture Photo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <video id="videoElement" autoplay style="width: 100%; height: auto;"></video>
                        <canvas id="canvasElement" style="display:none;"></canvas>
                    </div>
                    <div class="modal-footer">
                        <button id="captureButton" class="btn btn-primary">Capture</button>
                    </div>
                </div>
            </div>
        </div>
    `;

        document.body.insertAdjacentHTML('beforeend', modalHtml);
        const cameraModal = new bootstrap.Modal(document.getElementById('cameraModal'), {});
        cameraModal.show();

        const video = document.getElementById('videoElement');
        const canvas = document.getElementById('canvasElement');
        const capture = document.getElementById('captureButton');

        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
                video.srcObject = stream;
                capture.onclick = () => {
                    const context = canvas.getContext('2d');
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);
                    const dataURL = canvas.toDataURL('image/png');
                    document.getElementById('previewimage').src = dataURL;
                    video.srcObject.getTracks().forEach(track => track.stop());
                    cameraModal.hide();
                    document.getElementById('cameraModal').remove(); // Clean up modal after use
                };
            })
            .catch(err => {
                console.error("Camera error:", err);
                alert(`Unable to access the camera. Please check your device permissions. Error: ${err.message}`);
                cameraModal.hide();
                document.getElementById('cameraModal').remove(); // Clean up modal if camera access fails
            });
    }

    // Bind function to the global scope
    window.OpenCamera = OpenCamera;
</script>
