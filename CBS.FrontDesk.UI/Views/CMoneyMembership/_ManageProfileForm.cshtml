@model CBS.FrontDesk.Data.Entity.CMoney.CMoneyMembersActivationAccount

<div class="container mt-4">
    <header class="text-center mb-4">
        <p class="text-muted">Easily manage profiles, including activation, PIN resets, deactivation, reactivation, Set Security Questions & Answer, Change Members Number, Generate OTP and Update Subcription Status</p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);">
    </header>

    <div class="accordion" id="activationAccordion">
        <!-- Reset PIN Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="resetPinHeading">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#resetPinCollapse" aria-expanded="true" aria-controls="resetPinCollapse">
                    RESET PIN
                </button>
            </h2>
            <div id="resetPinCollapse" class="accordion-collapse collapse show" aria-labelledby="resetPinHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Resetting the PIN will set it back to the default value. Inform the member to change it immediately upon login.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="row mt-2 gy-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control shadow-input-boxes", @readonly = true })
                                        <label>DEFAULT PHONE NUMBER</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control shadow-input-boxes", @readonly = "readonly" })
                                        <label>LOGIN ID</label>
                                    </div>
                                </div>
                            </div>

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">

                            <div class="header-buttons mt-4 text-center">
                                @Html.HiddenFor(m => m.ResetCMoneyMemberPinCommand.CustomerId)
                                <input type="hidden" name="Option" value="reset_pin" id="Option" />
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas mdi-face-recognition me-2"></i> RESET PIN
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

        <!-- Reset PIN with Security Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="resetPinWithSecurityHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#resetPinWithSecurityCollapse" aria-expanded="false" aria-controls="resetPinWithSecurityCollapse">
                    RESET PIN WITH SECURITY QUESTIONS
                </button>
            </h2>
            <div id="resetPinWithSecurityCollapse" class="accordion-collapse collapse" aria-labelledby="resetPinWithSecurityHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Use security questions and answers to reset the PIN securely.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ResetPinWithSecurityCommand.LoginId, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ResetPinWithSecurityCommand.LoginId, "", new { @class = "text-danger" })
                                <label>LOGIN ID</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ResetPinWithSecurityCommand.SecretQuestion, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ResetPinWithSecurityCommand.SecretQuestion, "", new { @class = "text-danger" })
                                <label>SECRET QUESTION</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ResetPinWithSecurityCommand.SecretAnswer, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ResetPinWithSecurityCommand.SecretAnswer, "", new { @class = "text-danger" })
                                <label>SECRET ANSWER</label>
                            </div>

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            <input type="hidden" name="Option" value="reset_pin_with_secret" id="Option" />

                            <div class="header-buttons mt-4 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas mdi-security me-2"></i> RESET PIN
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>
        <!-- Set Security Questions Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="securityQuestionHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#securityQuestionCollapse" aria-expanded="false" aria-controls="securityQuestionCollapse">
                    SET SECURITY QUESTION & ANSWER
                </button>
            </h2>
            <div id="securityQuestionCollapse" class="accordion-collapse collapse" aria-labelledby="securityQuestionHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Setting a security question and answer helps enhance account security and allows for PIN resets using this information.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ManageSecretQuestionCommand.LoginId, new { @class = "form-control shadow-input-boxes", @readonly = true })
                                @Html.ValidationMessageFor(m => m.ManageSecretQuestionCommand.LoginId, "", new { @class = "text-danger" })
                                <label>LOGIN ID</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ManageSecretQuestionCommand.SecretQuestion, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ManageSecretQuestionCommand.SecretQuestion, "", new { @class = "text-danger" })
                                <label>SECRET QUESTION</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ManageSecretQuestionCommand.SecretAnswer, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ManageSecretQuestionCommand.SecretAnswer, "", new { @class = "text-danger" })
                                <label>SECRET ANSWER</label>
                            </div>
                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            <input type="hidden" name="Option" value="set_security_questions" id="Option" />
                            <div class="header-buttons mt-4 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas mdi-security me-2"></i> SAVE SECURITY QUESTION
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>
        <!-- Deactivate Account Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="deactivateAccountHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#deactivateAccountCollapse" aria-expanded="false" aria-controls="deactivateAccountCollapse">
                    DEACTIVATE ACCOUNT
                </button>
            </h2>
            <div id="deactivateAccountCollapse" class="accordion-collapse collapse" aria-labelledby="deactivateAccountHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Deactivating an account will restrict the member's access to C-Money services.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.DeactivateCMoneyMemberCommand.Reason, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.DeactivateCMoneyMemberCommand.Reason, "", new { @class = "text-danger" })
                                <label>Reason for deactivating account</label>
                            </div>

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            <input type="hidden" name="Option" value="deactivate_account" id="Option" />

                            <div class="header-buttons mt-4 text-center">
                                @Html.HiddenFor(m => m.DeactivateCMoneyMemberCommand.CustomerId)
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i> DEACTIVATE ACCOUNT
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

        <!-- Reactivate Account Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="reactivateAccountHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reactivateAccountCollapse" aria-expanded="false" aria-controls="reactivateAccountCollapse">
                    REACTIVATE ACCOUNT
                </button>
            </h2>
            <div id="reactivateAccountCollapse" class="accordion-collapse collapse" aria-labelledby="reactivateAccountHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Reactivating an account will restore the member's access to C-Money services.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            <input type="hidden" name="Option" value="reactivate_account" id="Option" />

                            <div class="header-buttons mt-4 text-center">
                                @Html.HiddenFor(m => m.ReactivateCMoneyMemberCommand.CustomerId)
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i> REACTIVATE ACCOUNT
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

        <!-- Update Subscription Status Section -->
        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="updateSubscriptionHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#updateSubscriptionCollapse" aria-expanded="false" aria-controls="updateSubscriptionCollapse">
                    UPDATE SUBSCRIPTION STATUS
                </button>
            </h2>
            <div id="updateSubscriptionCollapse" class="accordion-collapse collapse" aria-labelledby="updateSubscriptionHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Note: Update the subscription status for the member's account.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.UpdateCMoneyMemberActivationCommand.PhoneNumber, new { @class = "form-control shadow-input-boxes", @readonly = true })
                                @Html.ValidationMessageFor(m => m.UpdateCMoneyMemberActivationCommand.PhoneNumber, "", new { @class = "text-danger" })
                                <label>PHONE NUMBER</label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                @Html.CheckBoxFor(m => m.UpdateCMoneyMemberActivationCommand.IsSubcribed, new { @class = "form-check-input", @role = "switch" })
                                <label class="form-check-label">SUBSCRIBED</label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                @Html.CheckBoxFor(m => m.UpdateCMoneyMemberActivationCommand.IsActive, new { @class = "form-check-input", @role = "switch" })
                                <label class="form-check-label">ACTIVE</label>
                            </div>
                            <input type="hidden" name="Option" value="update_activation_profile" id="Option" />

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            @Html.HiddenFor(m => m.UpdateCMoneyMemberActivationCommand.Id)
                            <div class="header-buttons mt-4 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i> UPDATE SUBSCRIPTION
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="generateOtpHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#generateOtpCollapse" aria-expanded="false" aria-controls="generateOtpCollapse">
                    GENERATE OTP
                </button>
            </h2>
            <div id="generateOtpCollapse" class="accordion-collapse collapse" aria-labelledby="generateOtpHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Generate a one-time password (OTP) to change member's phone number [@Model.PhoneNumber].</p>
                    @using (Html.BeginForm("GenerateOTP", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.GenerateMemberActivationOTPCommand.CustomerId, new { @class = "form-control shadow-input-boxes", @readonly = true })
                                @Html.ValidationMessageFor(m => m.GenerateMemberActivationOTPCommand.CustomerId, "", new { @class = "text-danger" })
                                <label>CUSTOMER ID</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.GenerateMemberActivationOTPCommand.PhoneNumber, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.GenerateMemberActivationOTPCommand.PhoneNumber, "", new { @class = "text-danger" })
                                <label>PHONE NUMBER</label>
                            </div>

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">

                            <div class="header-buttons mt-4 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-2"></i> SEND OTP
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

        <div class="accordion-item mb-3">
            <h2 class="accordion-header" id="changePhoneNumberHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#changePhoneNumberCollapse" aria-expanded="false" aria-controls="changePhoneNumberCollapse">
                    CHANGE PHONE NUMBER
                </button>
            </h2>
            <div id="changePhoneNumberCollapse" class="accordion-collapse collapse" aria-labelledby="changePhoneNumberHeading" data-bs-parent="#activationAccordion">
                <div class="accordion-body">
                    <p class="text-muted">Update the member's phone number. Ensure the new number is verified via OTP received.</p>
                    @using (Html.BeginForm("Update", "CMoneyMembership", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                    {
                        <fieldset class="fieldset-custom">
                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberCommand.CustomerId, new { @class = "form-control shadow-input-boxes", @readonly = true })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberCommand.CustomerId, "", new { @class = "text-danger" })
                                <label>CUSTOMER ID</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberCommand.OldPhoneNumber, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberCommand.OldPhoneNumber, "", new { @class = "text-danger" })
                                <label>OLD PHONE NUMBER</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberCommand.NewPhoneNumber, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberCommand.NewPhoneNumber, "", new { @class = "text-danger" })
                                <label>NEW PHONE NUMBER</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberCommand.OTP, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberCommand.OTP, "", new { @class = "text-danger" })
                                <label>OTP CODE</label>
                            </div>

                            <div class="form-floating mb-3">
                                @Html.TextBoxFor(m => m.ChangePhoneNumberCommand.Reason, new { @class = "form-control shadow-input-boxes" })
                                @Html.ValidationMessageFor(m => m.ChangePhoneNumberCommand.Reason, "", new { @class = "text-danger" })
                                <label>REASON FOR CHANGE</label>
                            </div>
                            @Html.HiddenFor(m => m.ChangePhoneNumberCommand.Language)

                            <hr style="border: 3px solid rgba(128, 128, 128, 0.7);">
                            <input type="hidden" name="Option" value="change_phone_number" id="Option" />
                            <div class="header-buttons mt-4 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-phone me-2"></i> UPDATE PHONE NUMBER
                                </button>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
