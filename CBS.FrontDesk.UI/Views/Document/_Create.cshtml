@model CBS.FrontDesk.Data.Entity.LoanConf.Document

<div class="change-group">
    <div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <div class="ms-3">
                    <a type="button" onclick="LoadDataGen('Document','myDataTable','_Data',0,'datalistingview')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                    </a>
                </div>
                <div class="ms-3">
                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_data','_Create','new','Document')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col">
    @using (Html.BeginForm("Create", "Document", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="ServiceOption" value="loan_schedule" id="ServiceOption" />
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryAddress"
                                aria-expanded="true"
                                aria-controls="collapseDeliveryAddress">
                            Document
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @Html.HiddenFor(m => m.Id)
                            <div class="row mt-2 gy-4">
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                        <label>Name</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DocumentType, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DocumentType, "", new { @class = "text-danger" })
                                        <label>Document type</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                                        <label>Description</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.LinkDoc, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.LinkDoc, "", new { @class = "text-danger" })
                                        <label>Document link</label>
                                    </div>
                                </div>

                            </div>
                            <div class="mt-4">
                                @if (ViewBag.Key == null)
                                {
                                    <button type="submit" class="btn btn-primary me-2">Save</button>
                                    <button type="reset" class="btn btn-outline-secondary">Reset</button>

                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary me-2">Update</button>

                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>


    }
</div>


