@model List<CBS.FrontDesk.Data.Entity.LoanConf.Document>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Description</th>
            <th>Link</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:20%">@d.Name</td>
                <td style="width:10%">@d.DocumentType</td>
                <td style="width:50%">@d.Description</td>
                <td style="width:50%">@d.LinkDoc</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Update','update','Document')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('Document','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

