@using Resources
<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-primary" id="confirmModalLabel">
        <i class="mdi mdi-book-check-outline me-2"></i> @GlobalManualJournalEntry.confirm_journal_posting
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="border rounded p-3 mb-3 bg-light small">
        <div class="row mb-2">
            <div class="col-md-6">
                <strong>@GlobalShared.Accounting_Date:</strong> <span id="confirmAccountingDate"></span>
            </div>
            <div class="col-md-6" id="confirmCounterpartyDiv" style="display:none;">
                <strong>@GlobalShared.Counterparty_Branch:</strong> <span id="confirmCounterpartyBranch"></span>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center" id="confirmTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Account</th>
                    <th>@GlobalShared.Debit</th>
                    <th>@GlobalShared.Credit</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot class="fw-bold text-end">
                <tr>
                    <td class="text-end">@GlobalShared.Total_Debit:</td>
                    <td id="confirmTotalDebit" class="text-end text-success">0.00</td>
                    <td id="confirmTotalCredit" class="text-end text-success">0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="alert alert-info mt-3 text-center mb-0">
        <i class="mdi mdi-alert-circle-outline me-1"></i>
        @GlobalManualJournalEntry.are_you_sure_you_want_to_post_the_above_entries?
    </div>
</div>

<div class="modal-footer justify-content-center">
    <button type="button" class="btn btn-success px-4" id="confirmPostBtn">
        <i class="mdi mdi-check-circle-outline me-1"></i> @GlobalShared.OK
    </button>
    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
        <i class="mdi mdi-cancel me-1"></i> @GlobalShared.Cancel
    </button>
</div>


