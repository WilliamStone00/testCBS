
@model CBS.FrontDesk.Data.Entity.AccountongV2.JournalEntry

@{
    ViewBag.Title = "Manual Journal Entry";
}
@using Resources

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-book-open-variant me-2"></i>@ManualEntry.ManualJournalEntry
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @ManualEntry.HeaderNote
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @ManualEntry.TIPSFORMANUALJOURNALENTRY  ENTRY</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseJournalTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseJournalTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><strong>@ManualEntry.ValidateAccounts:</strong> @ManualEntry.chartofaccounts . </li>
                <li><strong>@ManualEntry.DebitandCreditBalance:</strong>@ManualEntry.DebitEqualCredit.</li>
                <li><strong>@ManualEntry.Narration:</strong> @ManualEntry.Description</li>
                <li><strong>@ManualEntry.PostingDate:</strong> @ManualEntry.ConfirmationofDate</li>
                <li><strong>@ManualEntry.ApprovalWorkflow:</strong> @ManualEntry.ApprovalVerification</li>
                <li><strong>@ManualEntry.ManualEntryChecks:</strong>Use the <em>Validate</em> button to confirm account codes and balances before submission.</li>
                <li><strong>@ManualEntry.Attachments:</strong> @ManualEntry.Upload </li>
            </ul>
        </div>
    </div>
</div>


<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">

        <a type="button" onclick=" LoadDataGen('ManualJournalEntry', 'myDataTable', '_JournalHeadFilters', 0, 'datalistingview', null, 'list')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @ManualEntry.ViewList
        </a>


        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Posting','new','ManualJournalEntry')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="AddNewVault">
            <i class="mdi mdi-plus mdi-18px"></i> @ManualEntry.addbutton
        </a>

    </div>
</div>


<div class="card">
    <div class="card-body">
        <div id="datalistingview">
            @Html.Partial("_Posting")
        </div>
    </div>
</div>
@section Scripts {@Scripts.Render("~/bundles/jqueryval")


<script>
    $(function () {
        const tableBody = $('#myDataTable tbody');
        let accounts = [];

        function initSelect2() {
            $('.account-select, #CounterpartyBranchId, #OperationCode').select2({
                width: '100%',
                placeholder: 'Select option',
                allowClear: true
            });
        }

        // 🗓️ Restrict Accounting Date
        const today = new Date();
        const maxDate = today.toISOString().split('T')[0];
        const minDate = new Date(today.setDate(today.getDate() - 30)).toISOString().split('T')[0];
        $('#AccountingDate').attr('max', maxDate).attr('min', minDate);

        function addRow() {
            const index = tableBody.children('tr').length;
            const row = `
                <tr>
                    <td>
                        <select name="Lines[${index}].AccountId" class="form-select account-select" required>
                            <option value="">Select Account</option>
                            ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                        </select>
                    </td>
                    <td><input type="text" class="form-control narration-input" name="Lines[${index}].Narration" placeholder="Enter narration" required /></td>
                    <td><input type="number" step="0.01" class="form-control debit-input" name="Lines[${index}].Debit" placeholder="0.00" min="0" /></td>
                    <td><input type="number" step="0.01" class="form-control credit-input" name="Lines[${index}].Credit" placeholder="0.00" min="0" /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger deleteRow"><i class="mdi mdi-delete"></i></button>
                    </td>
                </tr>`;
            tableBody.append(row);
            initSelect2();
        }

        // Load accounts
        function loadAccounts() {
            $.ajax({
                url: '/ManualJournalEntry/GetAccounts',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (!response.success || !response.data) {
                        appalert(response.message || '⚠️ No accounts found.', 2, 1);
                        return;
                    }

                    accounts = response.data.map(a => ({
                        Value: a.Id,
                        Text: `${a.Code} - ${a.Name}`
                    }));

                    const options = accounts
                        .map(a => `<option value="${a.Value}">${a.Text}</option>`)
                        .join('');

                    tableBody.find('.account-select').html('<option value="">Select Account</option>' + options);
                    initSelect2();
                    appalert(' Accounts loaded successfully.', 1, 1);
                },
                error: function (err) {
                    if (err.status === 401) {
                        window.location.href = '/Authentication/Login';
                    } else {
                        appalert(" Error loading content: " + err.statusText, 0, 1);
                    }
                }
            });
        }

        loadAccounts();
        addRow();
        initSelect2();

        // ➕ Add new row validation
        $('#addRowBtn').click(() => {
            let canAdd = true;
            tableBody.find('tr:last').find('input:enabled, select:enabled').each(function () {
                if (!$(this).val()) {
                    canAdd = false;
                    $(this).addClass('is-invalid').css('border-color', 'red');
                } else {
                    $(this).removeClass('is-invalid').css('border-color', '');
                }
            });
            if (!canAdd) {
                appalert(' Please fill all fields before adding a new row.', 2, 1);
                return;
            }
            addRow();
            appalert(' Row added successfully.', 1, 1);
        });

        // 🗑️ Delete row
        tableBody.on('click', '.deleteRow', function () {
            $(this).closest('tr').remove();
            updateTotals();
            appalert(' Row deleted successfully.', 1, 1);
        });

        // 🔄 Clear all
        $('#clearRowsBtn').click(() => {
            tableBody.empty();
            addRow();
            updateTotals();
            appalert('All rows cleared.', 3, 1);
        });

        // 💰 Update totals
        function updateTotals() {
            let debitTotal = 0, creditTotal = 0;
            tableBody.find('.debit-input').each(function () {
                debitTotal += parseFloat($(this).val()) || 0;
            });
            tableBody.find('.credit-input').each(function () {
                creditTotal += parseFloat($(this).val()) || 0;
            });
            const diff = debitTotal - creditTotal;
            $('#totalDebit').text(`XAF ${debitTotal.toLocaleString()}`);
            $('#totalCredit').text(`XAF ${creditTotal.toLocaleString()}`);
            $('#difference')
                .text(`Diff: XAF ${diff.toLocaleString()}`)
                .toggleClass('text-danger', diff !== 0)
                .toggleClass('text-success', diff === 0);
            $('#postEntriesBtn').prop('disabled', diff !== 0);
        }

        tableBody.on('input', '.debit-input, .credit-input', function () {
            const row = $(this).closest('tr');
            const debit = row.find('.debit-input');
            const credit = row.find('.credit-input');

            if ($(this).hasClass('debit-input') && $(this).val()) {
                credit.val('').prop('disabled', true);
            } else if ($(this).hasClass('credit-input') && $(this).val()) {
                debit.val('').prop('disabled', true);
            } else {
                debit.prop('disabled', false);
                credit.prop('disabled', false);
            }
            updateTotals();
        });

        // 🔹 Interbranch toggle
        $('#enableInterbranch').change(function () {
            if ($(this).is(':checked')) {
                $('#counterpartyBranchDiv').slideDown();
                $('#CounterpartyBranchId').prop('required', true);
                appalert(' Interbranch enabled.', 3, 1);
            } else {
                $('#counterpartyBranchDiv').slideUp();
                $('#CounterpartyBranchId').prop('required', false).val('').trigger('change');
                appalert(' Interbranch disabled.', 3, 1);
            }
        });

        // ✅ Inline Validation + Ajax
        $(document).on('submit', '#journalForm', function (e) {
            e.preventDefault();

            let isValid = true;
            const $form = $(this);

            // remove previous validation messages
            $form.find('.validation-message').remove();

            // check all required fields including textarea
            $form.find('input[required], select[required], textarea[required]').each(function () {
                const value = $(this).val()?.trim();
                const $field = $(this);

                if (!value) {
                    isValid = false;
                    $field.addClass('is-invalid').css('border-color', 'red');
                    if ($field.next('.validation-message').length === 0) {
                        $field.after('<small class="validation-message text-danger">Please fill all required fields before posting.</small>');
                    }
                } else {
                    $field.removeClass('is-invalid').css('border-color', '');
                    $field.next('.validation-message').remove();
                }
            });

            // stop posting if any invalid field exists
            if (!isValid) return false;

            // all good → submit via ajax
            return window.journalEntrySubmitAjax(this);
        });
    });


    // ✅ AJAX Submission Logic
    window.journalEntrySubmitAjax = function (form) {
        var $form = $(form);
        var token = getAntiForgeryToken();
        var $submit = $form.find('[type="submit"]').first();
        var origHtml = $submit.data('orig-html') || $submit.html();
        $submit.data('orig-html', origHtml);
        $submit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');

        var ajaxOptions = {
            url: $form.attr('action'),
            type: ($form.attr('method') || 'POST').toUpperCase(),
            dataType: 'json',
            data: new FormData(form),
            processData: false,
            contentType: false,
            headers: { 'RequestVerificationToken': token },
            success: function (res) {
                if (res && res.success) {
                    showMsg(res.message || 'Journal entry posted successfully', 1);
                    $form[0].reset();
                    $('#postEntriesBtn').prop('disabled', true);
                    $('#myDataTable tbody').empty();
                    $form.find('.validation-message').remove();
                } else {
                    showMsg(res.message || 'Failed to post journal entry', 2);
                }
            },
            error: function (xhr) {
                console.error('journalEntrySubmitAjax error', xhr.status, xhr.responseText);
                showMsg('Network error or server unavailable', 4);
            },
            complete: function () {
                $submit.prop('disabled', false).html(origHtml);
            }
        };

        // confirmation before posting
        if (window.alertify && typeof alertify.confirm === 'function') {
            alertify.confirm("Confirmation", "Are you sure you want to post this journal entry?",
                function () { $.ajax(ajaxOptions); },
                function () { showMsg('Transaction cancelled', 3); })
                .set('labels', { ok: 'Yes', cancel: 'No' });
        } else {
            if (confirm('Are you sure you want to post this journal entry?'))
                $.ajax(ajaxOptions);
            else
                showMsg('Transaction cancelled', 3);
        }

        return false;
    };
</script>
}