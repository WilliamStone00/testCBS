@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            const tableBody = $('#myDataTable tbody');
            let accounts = [];

            // ==================== Initialize Select2 ====================
            function initSelect2() {
                $('.account-select, #CounterpartyBranchId, #OperationCode, #BranchId').select2({
                    width: '100%',
                    placeholder: 'Select option',
                    allowClear: true
                });
            }

            // ==================== Add Row ====================
            function addRow() {
                const index = tableBody.children('tr').length;
                const row = `
                        <tr>
                            <td>
                                <select name="Lines[${index}].AccountId" class="form-select account-select" required>
                                    <option value="">Select Account</option>
                                    ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                                </select>
                            </td>
                            <td>
                                <textarea class="form-control narration-input"
                                          name="Lines[${index}].Narration"
                                          placeholder="Enter narration"
                                          rows="1"
                                          oninput="autoGrow(this)"
                                          required></textarea>
                            </td>
                            <td><input type="number" step="0.01" class="form-control debit-input" name="Lines[${index}].Debit" placeholder="0.00" min="0" /></td>
                            <td><input type="number" step="0.01" class="form-control credit-input" name="Lines[${index}].Credit" placeholder="0.00" min="0" /></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger deleteRow"><i class="mdi mdi-delete"></i></button>
                            </td>
                        </tr>`;
                tableBody.append(row);
                initSelect2();
            }

            // ==================== Load Accounts by Branch ====================
            function loadAccounts(branchId) {
                if (!branchId) {
                    appalert("⚠️ Please select a branch first.", 2, 1);
                    return;
                }

                $.ajax({
                    url: '/ManualJournalEntry/GetAccounts',
                    type: 'GET',
                    data: { branchId: branchId },
                    dataType: 'json',
                    success: function (response) {
                        if (!response.success || !response.data) {
                            appalert(response.message || '⚠️ No accounts found for this branch.', 2, 1);
                            accounts = [];
                            return;
                        }

                        accounts = response.data.map(a => ({
                            Value: a.Value,
                            Text: `${a.Text}`
                        }));

                        const options = accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('');
                        $('#myDataTable .account-select').each(function () {
                            $(this).html('<option value="">Select Account</option>' + options);
                        });

                        appalert('✅ Accounts loaded successfully for selected branch.', 1, 1);
                        $('#addRowBtn, #postEntriesBtn').prop('disabled', false);
                        initSelect2();
                    },
                    error: function (err) {
                        appalert("Error loading accounts: " + err.statusText, 0, 1);
                    }
                });
            }

            // ==================== Branch Selection Event ====================
            $("#BranchId").on("change", function () { // ✅ Matches Razor ID
                const branchId = $(this).val();
                if (branchId) {
                    loadAccounts(branchId);
                } else {
                    $('#myDataTable .account-select').html('<option value="">Select Account</option>');
                    $('#addRowBtn, #postEntriesBtn').prop('disabled', true);
                    accounts = [];
                }
            });

            // ==================== Add Row Validation ====================
            $('#addRowBtn').click(() => {
                let canAdd = true;
                tableBody.find('tr:last').find('input:enabled, select:enabled').each(function () {
                    if (!$(this).val()) {
                        canAdd = false;
                        $(this).addClass('is-invalid').css('border-color', 'red');
                    } else {
                        $(this).removeClass('is-invalid').css('border-color', '');
                    }
                });
                if (!canAdd) {
                    appalert('Please fill all fields before adding a new row.', 2, 1);
                    return;
                }
                addRow();
            });

            // ==================== Delete Row ====================
            tableBody.on('click', '.deleteRow', function () {
                $(this).closest('tr').remove();
                updateTotals();
            });

            // ==================== Clear All Rows ====================
            $('#clearRowsBtn').click(() => {
                tableBody.empty();
                addRow();
                updateTotals();
            });

            // ==================== Auto Grow Textarea ====================
            window.autoGrow = function (element) {
                element.style.height = "auto";
                element.style.height = (element.scrollHeight) + "px";
            }

            // ==================== Update Totals ====================
            function updateTotals() {
                let debitTotal = 0, creditTotal = 0;
                tableBody.find('.debit-input').each(function () {
                    debitTotal += parseFloat($(this).val()) || 0;
                });
                tableBody.find('.credit-input').each(function () {
                    creditTotal += parseFloat($(this).val()) || 0;
                });
                const diff = debitTotal - creditTotal;
                $('#totalDebit').text(`XAF ${debitTotal.toLocaleString()}`);
                $('#totalCredit').text(`XAF ${creditTotal.toLocaleString()}`);
                $('#difference')
                    .text(`Diff: XAF ${diff.toLocaleString()}`)
                    .toggleClass('text-danger', diff !== 0)
                    .toggleClass('text-success', diff === 0);
                $('#postEntriesBtn').prop('disabled', diff !== 0 || accounts.length === 0);
            }

            // ==================== Input Totals Auto Update ====================
            tableBody.on('input', '.debit-input, .credit-input', function () {
                const row = $(this).closest('tr');
                const debit = row.find('.debit-input');
                const credit = row.find('.credit-input');

                if ($(this).hasClass('debit-input') && $(this).val()) {
                    credit.val('').prop('disabled', true);
                } else if ($(this).hasClass('credit-input') && $(this).val()) {
                    debit.val('').prop('disabled', true);
                } else {
                    debit.prop('disabled', false);
                    credit.prop('disabled', false);
                }
                updateTotals();
            });

            // ==================== Interbranch Toggle ====================
            $('#enableInterbranch').change(function () {
                if ($(this).is(':checked')) {
                    $('#counterpartyBranchDiv').slideDown();
                    $('#CounterpartyBranchId').prop('required', true);
                } else {
                    $('#counterpartyBranchDiv').slideUp();
                    $('#CounterpartyBranchId').prop('required', false).val('').trigger('change');
                }
            });

            // ==================== Confirmation Modal Logic ====================
            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));

            $('#postEntriesBtn').on('click', function (e) {
                e.preventDefault();

                const rows = $('#myDataTable tbody tr');
                const tbody = $('#confirmTable tbody');
                tbody.empty();

                let totalDebit = 0, totalCredit = 0;

                rows.each(function () {
                    const account = $(this).find('.account-select option:selected').text().trim();
                    const debit = parseFloat($(this).find('.debit-input').val()) || 0;
                    const credit = parseFloat($(this).find('.credit-input').val()) || 0;

                    if (account && (debit > 0 || credit > 0)) {
                        tbody.append(`
                                <tr>
                                    <td>${account}</td>
                                    <td class="text-end">${debit.toFixed(2)}</td>
                                    <td class="text-end">${credit.toFixed(2)}</td>
                                </tr>
                            `);
                        totalDebit += debit;
                        totalCredit += credit;
                    }
                });

                $('#confirmTotalDebit').text(totalDebit.toFixed(2));
                $('#confirmTotalCredit').text(totalCredit.toFixed(2));

                if (rows.length === 0 || (totalDebit === 0 && totalCredit === 0)) {
                    appalert("Please add at least one valid entry before posting.", 2, 1);
                    return;
                }

                if ($('#enableInterbranch').is(':checked')) {
                    $('#confirmCounterpartyBranch').text($('#CounterpartyBranchId option:selected').text());
                    $('#confirmCounterpartyDiv').show();
                } else {
                    $('#confirmCounterpartyDiv').hide();
                }

                $('#confirmAccountingDate').text($('#AccountingDate').val());
                modal.show();
            });

            // ==================== Confirm Post ====================
            $('#confirmPostBtn').on('click', function () {
                modal.hide();
                $('#postEntriesBtn').prop('disabled', true);
                const form = document.getElementById('journalForm');
                journalEntrySubmitAjax(form);
            });

            // ==================== Prevent Default Form Submit ====================
            $('#journalForm').submit(function (e) {
                e.preventDefault();
            });

            // ==================== Initialize Page ====================
            initSelect2();
            addRow();
            $('#addRowBtn, #postEntriesBtn').prop('disabled', true);
        });

        // ==================== AJAX Submit ====================
        window.journalEntrySubmitAjax = function (form) {
            const entries = [];
            $("#myDataTable tbody tr").each(function () {
                const $row = $(this);
                const accountId = $row.find(".account-select").val();
                const narration = $row.find(".narration-input").val();
                const debit = parseFloat($row.find(".debit-input").val()) || 0;
                const credit = parseFloat($row.find(".credit-input").val()) || 0;

                if (accountId && (debit > 0 || credit > 0)) {
                    entries.push({
                        AffiliateAccountId: accountId,
                        Naration: narration,
                        Dr: debit > 0,
                        Cr: credit > 0,
                        Amount: debit > 0 ? debit : credit
                    });
                }
            });

            const payload = {
                BranchId: $("#BranchId").val() || null,
                CounterpartyBranchId: $("#CounterpartyBranchId").val() || null,
                AccountingDate: $("#AccountingDate").val(),
                PostMode: "MANUAL",
                Payload: {
                    Memo: $("#Payload_Memo").val(),
                    Entries: entries
                }
            };

            $.ajax({
                url: '/ManualJournalEntry/PostJournalEntry',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                beforeSend: function () {
                    $('#postEntriesBtn').prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Posting...');
                },
                success: function (res) {
                    if (res.success) {
                        appalert(res.message || 'Journal entry posted successfully', 1, 1);
                        $('#journalForm')[0].reset();
                        $('#myDataTable tbody').empty();
                        $('#addRowBtn, #postEntriesBtn').prop('disabled', true);
                    } else {
                        appalert(res.message || 'Failed to post journal entry', 2, 1);
                    }
                },
                error: function (xhr) {
                    appalert("Error posting journal entry: " + xhr.statusText, 0, 1);
                },
                complete: function () {
                    $('#postEntriesBtn').prop('disabled', false)
                        .html('<i class="mdi mdi-check-circle-outline me-1"></i> Post Entries');
                }
            });
        };
    </script>
}
