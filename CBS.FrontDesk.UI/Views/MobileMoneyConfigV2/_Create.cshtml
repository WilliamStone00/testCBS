@model CBS.FrontDesk.Data.Entity.AccountingV2.MobileMoneyV2.MobileMoney
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalMobileMoneyConfigV2.mobile_money_configuration</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "MobileMoneyConfigV2", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(model => model.Id)

            <!-- ========================= -->
            <!-- 🔹 HOLDER INFORMATION -->
            <!-- ========================= -->
            <fieldset class="border rounded p-3 mb-4">
                <legend class="float-none w-auto px-2 text-primary fw-bold">@GlobalShared.holder_information</legend>

                <div class="row gy-3">
                    <!-- Holder Name -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Holder Name" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                            <label for="Name">@GlobalShared.holder_name</label>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Address" })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                            <label for="Address">@GlobalShared.Address</label>
                        </div>
                    </div>
                </div>
            </fieldset>


            <!-- ========================= -->
            <!-- 🔹 MOBILE MONEY INFO -->
            <!-- ========================= -->
            <fieldset class="border rounded p-3 mb-4">
                <legend class="float-none w-auto px-2 text-primary fw-bold">@GlobalMobileMoneyConfigV2.mobile_money_info</legend>

                <div class="row gy-3">
                    <!-- Operator Type -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                m => m.OperatorType,
                                new SelectList(new List<string> { "MTN", "Orange", "Camtel" }),
                                $"--- {@GlobalShared.Select_Operator} ---",
                                new { @class = "form-control select2", id = "OperatorType", @search = "true" }
                            )
                            @Html.ValidationMessageFor(m => m.OperatorType, "", new { @class = "text-danger" })
                            <label for="OperatorType">@GlobalShared.operator_type</label>
                        </div>
                    </div>

                    <!-- Merchant Number -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.TelNumber, new { @class = "form-control", placeholder = "Merchant/MoMo Number" })
                            @Html.ValidationMessageFor(m => m.TelNumber, "", new { @class = "text-danger" })
                            <label for="TelNumber">@GlobalMobileMoneyConfigV2.merchantmomoorange_number</label>
                        </div>
                    </div>
                </div>
            </fieldset>


            <!-- ========================= -->
            <!-- 🔹 ACCOUNTS GL INFO -->
            <!-- ========================= -->
            <fieldset class="border rounded p-3 mb-4">
                <legend class="float-none w-auto px-2 text-primary fw-bold">@GlobalMobileMoneyConfigV2.accounts_gl_info</legend>

                <div class="row gy-3">
                    <!-- Branch -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                m => m.BranchId,
                                new SelectList(ViewBag.Branches, "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-control select2", id = "BranchId", @search = "true", @onchange = "LoadBranchAccounts(this.value)" }
                            )
                            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                            <label for="BranchId">@GlobalShared.Select_Branch</label>
                        </div>
                    </div>

                    <!-- Branch Account -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                m => m.BranchAccountId,
                                new SelectList(ViewBag.Accounts, "Value", "Text"),
                                $"--- {@GlobalShared.select_branch_account} ---",
                                new { @class = "form-control select2", @id = "BranchAccountId", @search = "true" }
                            )
                            @Html.ValidationMessageFor(m => m.BranchAccountId, "", new { @class = "text-danger" })
                            <label for="BranchAccountId">@GlobalMobileMoneyConfigV2.branch_account_gl</label>
                        </div>
                    </div>
                </div>
            </fieldset>


            <!-- ========================= -->
            <!-- 🔹 SETTINGS -->
            <!-- ========================= -->
            <fieldset class="border rounded p-3 mb-4">
                <legend class="float-none w-auto px-2 text-primary fw-bold">@GlobalShared.settings</legend>
                <div class="form-check ms-2 mt-1">
                    @Html.CheckBoxFor(m => m.ActiveStatus, new { @class = "form-check-input", id = "ActiveStatus" })
                    <label class="form-check-label ms-1" for="ActiveStatus">@GlobalShared.Active_Status</label>
                </div>
            </fieldset>


            <!-- ========================= -->
            <!-- 🔹 ACTION BUTTONS -->
            <!-- ========================= -->
            <div class="mt-4 d-flex justify-content-end gap-2">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary">@GlobalShared.Update</button>
                }
                else
                {
            <button type="submit" class="btn btn-primary">@GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
            </div>
        }
    </div>
</fieldset>


