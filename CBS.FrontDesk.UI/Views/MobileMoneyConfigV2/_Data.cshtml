@model List<CBS.FrontDesk.Data.Entity.AccountingV2.MobileMoneyV2.MobileMoney>

<fieldset class="fieldset-custom">
    <legend id="select_base">Mobile Money Configurations</legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>No Mobile Money configurations have been set up yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered align-middle" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Account Name</th>
                        <th style="width: 15%;">Phone Number</th>
                        <th style="width: 10%;">Branch Code</th>
                        <th style="width: 20%;">Branch Name</th>
                        <th style="width: 10%;" class="text-center">Status</th>
                        <th style="width: 20%;" class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mobileMoney in Model)
                    {
                        <tr>
                            <td>@mobileMoney.Name</td>
                            <td>@mobileMoney.TelNumber</td>
                            <td>@mobileMoney.BranchCode</td>
                            <td>@mobileMoney.BranchName</td>
                            <td class="text-center">
                                @if (mobileMoney.ActiveStatus)
                                {
                                    <span class="badge rounded-pill bg-success fs-6">
                                        <i class="fas fa-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger fs-6">
                                        <i class="fas fa-times-circle"></i> Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Edit -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                            onclick="AddORUpdateGen('@mobileMoney.Id', 'datalistingview', '_Create', 'update', 'MobileMoneyConfigV2', null, null)"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Edit @mobileMoney.Name">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </button>

                                    <!-- Details -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info d-flex align-items-center"
                                            onclick="showMobileMoneyDetails('@mobileMoney.Id')"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="View Details">
                                        <i class="fas fa-info-circle me-1"></i> Details
                                    </button>

                                   
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>

<script>
    function showMobileMoneyDetails(id) {
        $('#mobileMoneyDetailsContent').html('<p>Loading...</p>');

        $.ajax({
            url: '/MobileMoney/GetDetailsPartial',
            type: 'GET',
            data: { Key: id },
            success: function (html) {
                $('#mobileMoneyDetailsContent').html(html);
                $('#mobileMoneyDetailsModal').modal('show');
            },
            error: function () {
                $('#mobileMoneyDetailsContent').html('<p>Error loading details.</p>');
                $('#mobileMoneyDetailsModal').modal('show');
            }
        });
    }
</script>
