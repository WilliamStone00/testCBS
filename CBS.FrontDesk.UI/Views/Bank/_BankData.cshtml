@model CBS.FrontDesk.Data.Entity.Config.BankConfig
@using Resources

<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalBankData.Name</th>
            <th>@GlobalBankData.Code</th>
            <th>@GlobalBankData.Tel</th>
            <th>@GlobalBankData.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Banks)
        {
            <tr>
                <td style="width:60%">@d.Name</td>
                <td style="width:10%">@d.BankCode</td>
                <td style="width:10%">@d.Telephone</td>
                <td style="width:20%">
                    <a href="#"
                       onclick="AddORUpdateGen(@d.Id,'datalistingview','_Bank','get','Bank','bank')"
                       class="mr-2"
                       data-toggle="tooltip" data-placement="top"
                       title="Select @d.Name to edit">
                        @GlobalBankData.Edit
                    </a> |

                    <a href="#"
                       class="mr-2"
                       data-toggle="tooltip" data-placement="top"
                       title="Update @d.Name logo"
                       onclick="AddORUpdateGen(@d.Id,'datalistingview','_ImageUploader','get','Bank','bank')">
                        Logo
                    </a> |

                    <a href="#"
                       class="mr-2"
                       data-toggle="tooltip" data-placement="top"
                       title="Update @d.Name watermark"
                       onclick="AddORUpdateGen(@d.Id,'datalistingview','_WatermarkUploader','get','Bank','bank')">
                        W-Mark
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

