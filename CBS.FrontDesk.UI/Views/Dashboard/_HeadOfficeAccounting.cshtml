@using Resources
<div class="section-header">@GlobalDashboard.TRIALBALANCE</div>
<div class="row">
    <!-- MTN Mobile Money Balance -->

    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-warning h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-cash mdi-16px"></i> <!-- Cash icon for Orange Money -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="xmTNMobileMoneyBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.MTNMobileMoneyBalance</p>
            </div>
        </div>
    </div>
    <!-- Orange Money Balance -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-warning h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-cash mdi-16px"></i> <!-- Cash icon for Orange Money -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="orangeMoneyBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.OrangeMoneyBalance</p>
            </div>
        </div>
    </div>

    <!-- Total Expense Balance -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-danger h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-lock mdi-16px"></i> <!-- Lock icon for Total Expense Balance -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="totalExpenseBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.TotalExpenseBalance</p>
            </div>
        </div>
    </div>

    <!-- Total Income Balance -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-info h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="mdi mdi-bank mdi-16px"></i> <!-- Bank icon for Total Income Balance -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="totalIncomeBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.TotalIncomeBalance</p>
            </div>
        </div>
    </div>
</div>



<div class="row">
    <!-- Cash in Hand -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-primary h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-bank mdi-16px"></i> <!-- Bank icon for Cash in Hand -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="cashInHandBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.CashInHand</p>
            </div>
        </div>
    </div>

    <!-- Cash in Bank -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-warning h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-cash-multiple mdi-16px"></i> <!-- Cash multiple icon for Cash in Bank -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="cashInBankBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.CashInBank</p>
            </div>
        </div>
    </div>

    <!-- Total Shares Balance -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-danger h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-secondary">
                            <i class="mdi mdi-chart-pie mdi-16px"></i> <!-- Pie chart icon for Total Shares Balance -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="totalSharesBalance"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.TotalSharesBalance</p>
            </div>
        </div>
    </div>

    <!-- Total Liquidity -->
    <div class="col-sm-6 col-lg-3 mb-3">
        <div class="card card-border-shadow-info h-100" style="padding: 0.5rem;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center mb-1 pb-1">
                    <div class="avatar me-1">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="mdi mdi-chart-line mdi-16px"></i> <!-- Line chart icon for Total Liquidity -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="totalLiquidity"></span></h5>
                </div>
                <p class="mb-0 text-heading" style="font-size: 0.85rem;">@GlobalDashboard.TotalLiquidity</p>
            </div>
        </div>
    </div>
</div>


