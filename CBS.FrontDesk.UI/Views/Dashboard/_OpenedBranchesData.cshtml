@model IEnumerable<CBS.FrontDesk.Data.Entity.GeneralDailyDashboardDto>
@using Resources
   @*@{
        // Calculate totals for the footer
        var totalBalance = Model.Sum(d => d.SubTillBalance);
        var totalBranches = Model.Count();
    }*@


@{
    var totalBalance = Model?.Sum(d => d.SubTillBalance) ?? 0;
    var totalBranches = Model?.Count() ?? 0;
}

<div class="table-responsive">
    <table class="table table-hover table-bordered text-center align-middle" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th style="width: 34%;">Branch Name</th>
                <th style="width: 7%;">Branch Code</th>
                <th style="width: 7%;">@GlobalDashboard.TCIN</th>
                <th style="width: 7%;">@GlobalDashboard.TCOUT</th>
                <th style="width: 20%;">Date</th>
                <th style="width: 15%;">@GlobalDashboard.Sub_Till_Balance</th>
                <th style="width: 10%;">@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.BranchName</td>
                    <td>@d.BranchCode</td>
                    <td>@d.NumberOfCashIn</td>
                    <td>@d.NumberOfCashOut</td>
                    <td>@d.Date.ToString("dd MMM yyyy, hh:mm:ss")</td>
                    <td>@d.SubTillBalance.ToString("#,##0.0")</td>
                    <td>
                        <a href="/Dashboard/BranchOffice?branchid=@d.BranchId"
                           class="btn btn-primary btn-sm"
                           data-toggle="tooltip"
                           data-placement="top"
                           title="View Dashboard for @d.BranchName">
                            View Dashboard
                        </a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="5" class="text-end">Total</th>
                <th>@totalBalance.ToString("#,##0.0")</th>
                <th>Total Branches: @totalBranches</th>
            </tr>
        </tfoot>
    </table>
</div>
