                            <i class="mdi mdi-account-group mdi-20px"></i> <!-- Reduced icon size -->
                        </span>
                    </div>
                    <h5 class="ms-1 mb-0" style="font-size: 1.2rem;"><span id="mtotalMembers"></span></h5> <!-- Reduced font size -->
