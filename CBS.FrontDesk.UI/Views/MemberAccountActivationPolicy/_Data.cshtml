@model List<CBS.FrontDesk.Data.Entity.SavingProducts.MemberAccountActivationPolicy>
@if (Model != null)
{<div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Policy</th>
                    <th>Reg</th>
                    <th>Clossing fee</th>
                    <th>Reopening Fee</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        
                        <td style="width:20%">@d.PolicyName</td>
                        <td style="width:20%">@d.MinimumRegistrationFee.ToString("0.0") - @d.MaximumRegistrationFee.ToString("0.0")</td>
                        <td style="width:20%">@d.MinimumAccountClossingFee.ToString("0.0") - @d.MaximumAccountClossingFee.ToString("0.0")</td>
                        <td style="width:20%">@d.MinimumReopeningFee.ToString("0.0") - @d.MaximumReopeningFee.ToString("0.0")</td>
                        <td style="width:10%">

                            @if (d.IsActive)
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">Active</span></label>
                            }
                            else
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">Blocked</span></label>
                            }
                        </td>
                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','MemberAccountActivationPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.PolicyName to edit">Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.PolicyName" onclick="DeleteRecordDataTable('MemberAccountActivationPolicy','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No member fee policy was found at the moment.
    </div>
}
