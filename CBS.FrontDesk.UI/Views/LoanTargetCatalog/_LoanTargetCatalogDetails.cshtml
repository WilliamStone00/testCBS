@model CBS.FrontDesk.Data.Entity.LoanConf.LoanTargetCatalog
@using Resources

<fieldset class="fieldset-custom">
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

    @GlobalShared.header_card
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-target-account me-2"></i> @GlobalLoanTargetCatalog.loan_target_details
            </h1>
            <p class="card-text text-muted mb-1">
                @GlobalLoanTargetCatalog.detailed_view_of_loan_target_catalog_entry
            </p>
        </div>
    </div>

    @if (Model.Id == null)
    {

    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">

                <div class="col-md-6">
                    <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Basic_Information</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr><td class="fw-bold">ID</td><td>@Model.Id</td></tr>
                        <tr><td class="fw-bold">@GlobalShared.Name (@GlobalShared.English)</td><td>@Model.NameEn</td></tr>
                        <tr><td class="fw-bold">@GlobalShared.Name (@GlobalShared.French)</td><td>@Model.NameFr</td></tr>
                        <tr><td class="fw-bold">@GlobalShared.pcmf_population</td><td>@Model.PcmfPopulation.ToString("N0")</td></tr>
                        <tr>
                            <td class="fw-bold">Status</td>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">@GlobalShared.Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@GlobalShared.InActive</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                @*System Information
                    <div class="col-md-6">
                        <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> System Information</h6>
                        <table class="table table-sm table-bordered mb-0">
                            <tr>
                                <td class="fw-bold">Created Date</td>
                                <td>@Model.CreatedDate.ToString()</td>
                            </tr>
                            <tr><td class="fw-bold">Created By</td><td>@(Model.CreatedBy ?? "-")</td></tr>
                            <tr>
                                <td class="fw-bold">Modified Date</td>
                                <td>
                                    @if (Model.ModifiedDate.HasValue)
                                    {
                                        @Model.ModifiedDate.Value.ToString()
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                            </tr>
                            <tr><td class="fw-bold">Modified By</td><td>@(Model.ModifiedBy ?? "-")</td></tr>
                        </table>
                    </div>*@
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">
            <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
        </button>
        <button type="button" class="btn btn-primary"
                onclick="ShowModal('@Model.Id', '_CreateEditLoanTargetCatalog', 'LoanTargetCatalog', 'edit')">
            <i class="mdi mdi-pencil me-1"></i> @GlobalShared.Edit
        </button>
    </div>

</fieldset>
