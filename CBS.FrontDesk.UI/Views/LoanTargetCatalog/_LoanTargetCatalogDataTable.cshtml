@*_LoanTargetCatalogDataTable.cshtml*@
@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> Loan Target Catalog</h5>
    <div class="table-responsive">
        <table id="loanTargetDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>@GlobalShared.Name (@GlobalShared.English)</th>
                    <th>@GlobalShared.Name (@GlobalShared.French)</th>
                    <th>@GlobalShared.pcmf_population</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded via AJAX -->
            </tbody>
        </table>
    </div>
</div>