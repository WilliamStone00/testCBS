<!-- Alternative: Index_Ajax.cshtml -->
<div id="datalistingview">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2 shadow-sm">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary fw-bold">
                        <i class="mdi mdi-target-account me-2"></i> Loan Target Catalog
                    </h1>
                    <p class="card-text">
                        Manage loan target categories for PCMF population classification
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <button type="button"
                    onclick="showCreateModal()"
                    class="btn btn-label-primary btn-sm me-2">
                <i class="mdi mdi-plus mdi-18px"></i> Add New
            </button>
            <button type="button"
                    onclick="refreshTable()"
                    class="btn btn-label-secondary btn-sm">
                <i class="mdi mdi-refresh mdi-18px"></i> Refresh
            </button>
        </div>
    </div>

    <!-- DataTable -->
    <div class="card p-3 shadow mb-4">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-table"></i> Loan Target Catalog
            <small class="text-muted ms-2">
                <span id="recordCount" class="badge bg-info">Loading...</span>
            </small>
        </h5>
        <div class="table-responsive">
            <table id="loanTargetDataTable" class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Name (English)</th>
                        <th>Name (French)</th>
                        <th>PCMF Population</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                    <tr id="loadingRow">
                        <td colspan="6" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Loading loan target data...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div class="modal fade" id="genericModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"></div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        var dataTable = null;

        function showCreateModal() {
            ShowModal(null, '_CreateEditLoanTargetCatalog', 'LoanTargetCatalog', 'create');
        }

        function ShowModal(key, partialView, controller, path) {
            var url = '/' + controller + '/InitializeData?KEY=' + encodeURIComponent(key || '') +
                '&partialView=' + encodeURIComponent(partialView) +
                '&path=' + encodeURIComponent(path);

            $.get(url).done(function (html) {
                $('#genericModal .modal-content').html(html);
                var modal = new bootstrap.Modal(document.getElementById('genericModal'));
                modal.show();
            }).fail(function () {
                appalert('Failed to load content', 0, 1);
            });
        }

        function loadData() {
            $.ajax({
                url: '/LoanTargetCatalog/GetAllForTable',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.success && response.data) {
                        renderTable(response.data);
                    } else {
                        $('#loanTargetDataTable tbody').html(`
                                <tr>
                                    <td colspan="6" class="text-center text-danger py-4">
                                        <i class="mdi mdi-alert-circle me-1"></i>
                                        Failed to load data
                                    </td>
                                </tr>
                            `);
                    }
                },
                error: function () {
                    $('#loanTargetDataTable tbody').html(`
                            <tr>
                                <td colspan="6" class="text-center text-danger py-4">
                                    <i class="mdi mdi-alert-circle me-1"></i>
                                    Error loading data. Please try again.
                                </td>
                            </tr>
                        `);
                }
            });
        }

        function renderTable(data) {
            var tbody = $('#loanTargetDataTable tbody');
            tbody.empty();

            if (data.length === 0) {
                tbody.html(`
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="mdi mdi-information-outline me-1"></i>
                                No loan target records found
                            </td>
                        </tr>
                    `);
                $('#recordCount').text('0 records');
                return;
            }

            $('#recordCount').text(data.length + ' records');

            data.forEach(function (item) {
                var row = `
                        <tr>
                            <td class="fw-semibold">${escapeHtml(item.NameEn)}</td>
                            <td>${escapeHtml(item.NameFr)}</td>
                            <td>${item.PcmfPopulation ? parseInt(item.PcmfPopulation).toLocaleString() : '0'}</td>
                            <td>
                                ${item.IsActive ?
                        '<span class="badge bg-success">Active</span>' :
                        '<span class="badge bg-secondary">Inactive</span>'}
                            </td>
                            <td>${formatDate(item.CreatedDate)}</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                            type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i> Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button class="dropdown-item btn-details" data-id="${item.Id}">
                                                <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item btn-edit" data-id="${item.Id}">
                                                <i class="mdi mdi-pencil me-1 text-warning"></i> Edit
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item btn-delete text-danger" data-id="${item.Id}">
                                                <i class="mdi mdi-delete me-1"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    `;
                tbody.append(row);
            });

            // Reinitialize DataTable if needed
            if ($.fn.DataTable && !dataTable) {
                dataTable = $('#loanTargetDataTable').DataTable({
                    searching: true,
                    responsive: true,
                    order: [[0, 'asc']],
                    language: {
                        emptyTable: 'No records found',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        infoEmpty: 'Showing 0 to 0 of 0 entries',
                        lengthMenu: 'Show _MENU_ entries',
                        search: 'Search:',
                        zeroRecords: 'No matching records found'
                    },
                    lengthMenu: [10, 25, 50, 100],
                    pageLength: 10,
                    columnDefs: [
                        { orderable: false, targets: 5 } // Actions column
                    ]
                });
            } else if (dataTable) {
                dataTable.destroy();
                dataTable = $('#loanTargetDataTable').DataTable({
                    searching: true,
                    responsive: true,
                    order: [[0, 'asc']],
                    language: {
                        emptyTable: 'No records found',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        infoEmpty: 'Showing 0 to 0 of 0 entries',
                        lengthMenu: 'Show _MENU_ entries',
                        search: 'Search:',
                        zeroRecords: 'No matching records found'
                    },
                    lengthMenu: [10, 25, 50, 100],
                    pageLength: 10,
                    columnDefs: [
                        { orderable: false, targets: 5 }
                    ]
                });
            }
        }

        function refreshTable() {
            loadData();
            appalert('Data refreshed', 3, 1);
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            var date = new Date(dateString);
            return date.toLocaleDateString('en-GB'); // DD/MM/YYYY format
        }

        function escapeHtml(text) {
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text ? text.toString().replace(/[&<>"']/g, function (m) { return map[m]; }) : '';
        }

        $(document).ready(function () {
            // Load data on page load
            loadData();

            // Action handlers (using event delegation for dynamic content)
            $(document).on('click', '.btn-details', function () {
                var id = $(this).data('id');
                ShowModal(id, '_LoanTargetCatalogDetails', 'LoanTargetCatalog', 'details');
            });

            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                ShowModal(id, '_CreateEditLoanTargetCatalog', 'LoanTargetCatalog', 'edit');
            });

            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');
                ShowModal(id, '_DeleteLoanTargetCatalog', 'LoanTargetCatalog', 'delete');
            });

            // Handle modal close to refresh data
            $('#genericModal').on('hidden.bs.modal', function () {
                loadData(); // Refresh table after modal close
            });
        });
    </script>
}