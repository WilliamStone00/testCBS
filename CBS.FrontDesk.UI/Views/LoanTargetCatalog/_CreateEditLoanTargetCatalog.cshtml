@model CBS.FrontDesk.Data.Entity.LoanConf.UpdateLoanTargetCatalogRequest
@using Resources

<div class="modal-body">
    @using (Html.BeginForm("CreateOrUpdate","LoanTargetCatalog",FormMethod.Post, new { id = "loanTargetForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

    <div class="mt-2">
        <div class="row">
            <div class="col-12">
                <div class="card bg-light mb-2">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-target-account me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model?.Id)
                                         ? "Institutional Loan Targeted Population"
                                         : "Update Institutional Loan Targeted Population")
                        </h1>

                        @*<p class="card-text">
                            Configure and manage Insurance Premium System settings for different years and branches.
                        </p>
                        <div class="alert alert-info mt-3 py-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            Set coverage limits, premium rates, and eligibility criteria for loan and savings insurance products.
                        </div>*@

                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">

                <!-- Card Body -->
                <div class="card-body">
                    <div class="row g-3">

                        <!-- Name EN -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.NameEn, new
                                {
                                    @class = "form-control",
                                    placeholder = "Name (English)",
                                    maxlength = "200"
                                })
                                <label>@GlobalShared.Name (@GlobalShared.English)</label>
                                @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- Name FR -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.NameFr, new
                                {
                                    @class = "form-control",
                                    placeholder = "Name (French)",
                                    maxlength = "200"
                                })
                                <label>@GlobalShared.Name (@GlobalShared.French)</label>
                                @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- PCMF Population -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.DropDownListFor(
                                    m => m.PcmfPopulation,
                                    (IEnumerable<SelectListItem>)ViewBag.population,
                                    "Select PCMF Population",
                                    new { @class = "form-control select2" }
                                )
                                <label>@GlobalShared.pcmf_population</label>
                                @Html.ValidationMessageFor(m => m.PcmfPopulation, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- Active Status -->
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check mt-2">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActive" })
                                <label class="form-check-label fw-bold ms-2" for="isActive">
                                    @GlobalShared.Active_Status
                                </label>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="text-end">
                        @if (string.IsNullOrWhiteSpace(Model?.Id))
                        {
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Save
                            </button>
                            <button type="reset" class="btn btn-outline-secondary">
                                @GlobalShared.Reset
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Update
                            </button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                Close
                            </button>
                        }
                    </div>
                </div>

            </div>
        </div>



    
    </div>
        }
    </div>
