<!-- Main Content Area -->
<div class="card shadow p-3 mb-4">
    <!-- Search Section (Initially Visible) -->
    <div id="searchSection">
        @Html.Partial("_CustomerSearch")
    </div>

    <!-- Request Form Section (Initially Hidden) -->
    <div id="requestFormSection" style="display: none;">
        <!-- Form will be loaded here dynamically -->
    </div>

    <!-- DataTable Section (Initially Hidden) -->
    <div id="dataTableSection" style="display: none;">
        <!-- DataTable will be loaded here dynamically -->
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Take Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="actionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="actionType" name="action">
                    <input type="hidden" id="actionRequestId" name="requestId">

                    <div class="mb-3">
                        <label for="actionNote" class="form-label">Statement / Reason</label>
                        <textarea id="actionNote" name="note" class="form-control" rows="4" required
                                  placeholder="Please provide a statement or reason for this action..."></textarea>
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Action</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- Details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Corrected Script Paths -->
    <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/search-manager.js"></script>
    <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/form-manager.js"></script>
    <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/datatable-manager.js"></script>

    <script>
        // Global section management functions
        function showSearchSection() {
            $('#dataTableSection').hide();
            $('#requestFormSection').hide();
            $('#searchSection').show();

            // Reset search form
            if (window.searchManager) {
                window.searchManager.resetSearch();
            }
        }

        function showDataTableSection() {
            $('#searchSection').hide();
            $('#requestFormSection').hide();
            $('#dataTableSection').show();

            // Load data table content if not already loaded
            if (!$('#dataTableSection').html().trim()) {
                loadDataTableContent();
            }

            // Refresh data table if already initialized
            if (window.dataTableManager && window.dataTableManager.dataTable) {
                window.dataTableManager.refresh();
            }
        }

        function showRequestFormSection() {
            $('#searchSection').hide();
            $('#dataTableSection').hide();
            $('#requestFormSection').show();
        }

        function loadDataTableContent() {
            $.get('@Url.Action("InitializeData", "ChequeRequest")', {
                partialView: '_RequestDataTable',
                path: 'list'
            }, function(html) {
                $('#dataTableSection').html(html);

                // Re-initialize DataTable after content is loaded
                if (window.dataTableManager) {
                    window.dataTableManager.initializeDataTable();
                }
            });
        }

        function loadRequestForm() {
            $.get('@Url.Action("InitializeData", "ChequeRequest")', {
                partialView: '_ChequeRequestForm',
                path: 'new'
            }, function(html) {
                $('#requestFormSection').html(html);

                // Re-initialize form manager after content is loaded
                if (window.formManager) {
                    window.formManager.init();
                }
            });
        }

             function loadDataTable() {
            // Hide other sections
            $('#searchSection').hide();
            $('#emptyState').hide();

            // Show and load data table section
            $('#dataTableSection').show();

            // Load the DataTable partial view
            $.get('/ChequeRequest/InitializeData', {
                partialView: '_RequestDataTable',
                path: 'list'
            }, function(html) {
                $('#dataTableSection').html(html);

                // Initialize DataTable after content is loaded
                initializeDataTable();
            });
        }

        function loadSearchForm() {
            // Hide other sections
            $('#dataTableSection').hide();
            $('#emptyState').hide();

            // Show search section
            $('#searchSection').show();

            // Reset search form
            if (window.searchManager) {
                window.searchManager.resetSearch();
            }
        }

                function initializeDataTable() {
                    // Wait a brief moment for the table to be rendered
                    setTimeout(function() {
                        if ($.fn.DataTable && $('#myDataTable').length) {
                            // Destroy existing DataTable if it exists
                            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                                $('#myDataTable').DataTable().destroy();
                            }

                            // Initialize new DataTable
                            $('#myDataTable').DataTable({
                                processing: true,
                                serverSide: true,
                                ajax: {
                                    url: '/ChequeRequest/LoadRequestsForDataTable',
                                    type: 'POST',
                                    data: function(d) {
                                        return {
                                            query: {
                                                Options: {
                                                    draw: d.draw,
                                                    start: d.start,
                                                    pageSize: d.length,
                                                    sortColumnName: d.columns[d.order[0]?.column]?.data,
                                                    sortDirection: d.order[0]?.dir || 'asc'
                                                },
                                                CustomerFilter: $('#customerFilter')?.val() || '',
                                                CategoryFilter: $('#categoryFilter')?.val() || '',
                                                StatusFilter: $('#statusFilter')?.val() || ''
                                            }
                                        };
                                    }
                                },
                                columns: [
                                    { data: 'customerName', name: 'customerName' },
                                    { data: 'categoryName', name: 'categoryName' },
                                    {
                                        data: 'requestDate',
                                        name: 'requestDate',
                                        render: function(data) {
                                            return data ? new Date(data).toLocaleDateString() : 'N/A';
                                        }
                                    },
                                    {
                                        data: 'status',
                                        name: 'status',
                                        render: function(data) {
                                            // Your status badge rendering logic
                                            return data;
                                        }
                                    },
                                    {
                                        data: null,
                                        orderable: false,
                                        className: 'text-center',
                                        render: function(data, type, row) {
                                            // Your action buttons rendering logic
                                            return '<div class="dropdown">...</div>';
                                        }
                                    }
                                ]
                            });
                        }
                    }, 100);
        }

        // Function to initialize and load the cheque requests DataTable
        function loadChequeRequests() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                processing: true,
                searching: false,
                ordering: true,
                order: [[2, 'desc']], // Default sort by Request Date (column index 2) descending
                ajax: {
                    url: '/ChequeRequest/LoadDatatable', // Update with your actual endpoint
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectChequeRequestFilterParams();
                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir,
                            sortDirection: d.order[0].dir,
                            searchValue: d.search.value,
                            search: d.search.value
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (xhr, error, thrown) {
                        console.error('Error loading cheque requests:', error);
                        // You can show a user-friendly error message here
                    }
                },
                columns: [
                    {
                        data: 'customerName',
                        title: 'Customer Name',
                        orderable: true
                    },
                    {
                        data: 'categoryName',
                        title: 'Category',
                        orderable: true
                    },
                    {
                        data: 'requestDate',
                        title: 'Request Date',
                        orderable: true,
                        render: function (data) {
                            if (!data) return 'Invalid Date';
                            try {
                                return moment(data).format('DD/MM/YYYY HH:mm');
                            } catch (e) {
                                return 'Invalid Date';
                            }
                        }
                    },
                    {
                        data: 'status',
                        title: 'Status',
                        orderable: true,
                        render: function (data) {
                            const statusClass = {
                                'Pending': 'badge bg-warning',
                                'Approved': 'badge bg-success',
                                'Rejected': 'badge bg-danger',
                                'Delivered': 'badge bg-info',
                                'Reviewed': 'badge bg-primary'
                            }[data] || 'badge bg-secondary';

                            return `<span class="${statusClass}">${data || 'Unknown'}</span>`;
                        }
                    },
                    {
                        data: 'id',
                        title: 'Actions',
                        orderable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            let actions = `
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" onclick="viewRequest('${data}')" title="View Details">
                                <i class="mdi mdi-eye"></i>
                            </button>
                    `;

                            // Add status-specific actions
                            if (row.status === 'Pending') {
                                actions += `
                            <button class="btn btn-outline-success" onclick="approveRequest('${data}')" title="Approve">
                                <i class="mdi mdi-check"></i>
                            </button>
                            <button class="btn btn-outline-danger" onclick="rejectRequest('${data}')" title="Reject">
                                <i class="mdi mdi-close"></i>
                            </button>
                            <button class="btn btn-outline-info" onclick="reviewRequest('${data}')" title="Review">
                                <i class="mdi mdi-clipboard-check"></i>
                            </button>
                        `;
                            } else if (row.status === 'Approved') {
                                actions += `
                            <button class="btn btn-outline-info" onclick="markAsDelivered('${data}')" title="Mark as Delivered">
                                <i class="mdi mdi-truck-check"></i>
                            </button>
                        `;
                            }

                            actions += `</div>`;
                            return actions;
                        }
                    }
                ],
                language: {
                    processing: '<div class="spinner-border text-primary" role="status"></div> Processing...',
                    zeroRecords: 'No cheque requests found',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    }
                },
                initComplete: function () {
                    console.log('Cheque requests DataTable initialized');
                },
                drawCallback: function () {
                    // Any additional actions after table draw
                    console.log('Table redrawn');
                }
            });
        }

        // Function to collect filter parameters from the UI
        function collectChequeRequestFilterParams() {
            return {
                customerName: $('#customerNameFilter').val() || '',
                categoryName: $('#categoryFilter').val() || '',
                status: $('#statusFilter').val() || '',
                branchId: $('#branchFilter').val() || '',
                bankId: $('#bankFilter').val() || '',
                startDate: $('#startDateFilter').val() ? new Date($('#startDateFilter').val()).toISOString() : null,
                endDate: $('#endDateFilter').val() ? new Date($('#endDateFilter').val()).toISOString() : null,
                notifyOnRejection: $('#notifyRejectionFilter').is(':checked') || null,
                notifyOnAnyTransaction: $('#notifyAnyTransactionFilter').is(':checked') || null,
                notifyOnClearance: $('#notifyClearanceFilter').is(':checked') || null,
                automaticRenewal: $('#autoRenewalFilter').is(':checked') || null
            };
        }

        // Function to apply filters and reload the DataTable
        function applyFilters() {
            const table = $('#myDataTable').DataTable();
            table.ajax.reload();
        }

        // Function to clear all filters
        function clearFilters() {
            // Clear input fields
            $('.filter-input').val('');

            // Clear select fields
            $('.filter-select').val('');

            // Uncheck checkboxes
            $('.filter-checkbox').prop('checked', false);

            // Reload table without filters
            applyFilters();
        }

        // Action functions for the buttons
        function viewRequest(requestId) {
            console.log('View request:', requestId);
            // Implement view functionality
            // Example: window.location.href = `/ChequeRequest/Details/${requestId}`;
        }

        function approveRequest(requestId) {
            if (confirm('Are you sure you want to approve this cheque request?')) {
                console.log('Approve request:', requestId);
                // Implement approve functionality
                // Example: call API to approve request, then reload table
            }
        }

        function rejectRequest(requestId) {
            if (confirm('Are you sure you want to reject this cheque request?')) {
                console.log('Reject request:', requestId);
                // Implement reject functionality
            }
        }

        function reviewRequest(requestId) {
            console.log('Review request:', requestId);
            // Implement review functionality
        }

        function markAsDelivered(requestId) {
            if (confirm('Mark this cheque book as delivered?')) {
                console.log('Mark as delivered:', requestId);
                // Implement mark as delivered functionality
            }
        }

        // Initialize when document is ready
        $(document).ready(function () {
            loadChequeRequests();

            // Add event listeners for filter changes if you want auto-filtering
            $('.filter-input, .filter-select').on('change', function () {
                // Optional: Auto-apply filters on change
                // applyFilters();
            });
        });

        // Initialize on page load
        $(document).ready(function () {
            loadChequeRequests();
        });

