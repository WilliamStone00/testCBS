<!-- Main Content Area -->
<div class="card shadow p-3 mb-4">
    <!-- Search Section (Initially Visible) -->
    <div id="searchSection">
        @Html.Partial("_CustomerSearch")
    </div>

    <!-- Request Form Section (Initially Hidden) -->
    <div id="requestFormSection" style="display: none;">
        <!-- Form will be loaded here dynamically -->
    </div>

    <!-- DataTable Section (Initially Hidden) -->
    <div id="requestFormSection" style="display: none;">
        <!-- DataTable will be loaded here dynamically -->
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Take Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="actionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="actionType" name="action">
                    <input type="hidden" id="actionRequestId" name="requestId">

                    <div class="mb-3">
                        <label for="actionNote" class="form-label">Statement / Reason</label>
                        <textarea id="actionNote" name="note" class="form-control" rows="4" required
                                  placeholder="Please provide a statement or reason for this action..."></textarea>
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Action</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- Details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Corrected Script Paths -->
    <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/search-manager.js"></script>
    <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/form-manager.js"></script>
 @* <script src="~/Scripts/Js/Crud/ChequeManagement/ChequeRequest/datatable-manager.js"></script>*@

    <script>
        // Global section management functions
        function showSearchSection() {
            $('#requestFormSection').hide();
            $('#requestFormSection').hide();
            $('#searchSection').show();

            // Reset search form
            if (window.searchManager) {
                window.searchManager.resetSearch();
            }
        }

        function showrequestFormSection() {
            $('#searchSection').hide();
            $('#requestFormSection').hide();
            $('#dataTablrequestFormSectioneSection').show();

            // Load data table content if not already loaded
            if (!$('#requestFormSection').html().trim()) {
                loadDataTableContent();
            }

            // Refresh data table if already initialized
            if (window.dataTableManager && window.dataTableManager.dataTable) {
                window.dataTableManager.refresh();
            }
        }

        function showRequestFormSection() {
            $('#searchSection').hide();
            $('#requestFormSection').hide();
            $('#requestFormSection').show();
        }

        function loadDataTableContent() {
            $.get('@Url.Action("InitializeData", "ChequeRequest")', {
                partialView: '_RequestDataTable',
                path: 'list'
            }, function(html) {
                $('#requestFormSection').html(html);

                // Re-initialize DataTable after content is loaded
                if (window.dataTableManager) {
                    window.dataTableManager.initializeDataTable();
                }
            });
        }

        function loadRequestForm() {
            $.get('@Url.Action("InitializeData", "ChequeRequest")', {
                partialView: '_ChequeRequestForm',
                path: 'new'
            }, function(html) {
                $('#requestFormSection').html(html);

                // Re-initialize form manager after content is loaded
                if (window.formManager) {
                    window.formManager.init();
                }
            });
        }

             function loadDataTable() {
            // Hide other sections
            $('#searchSection').hide();
            $('#emptyState').hide();

            // Show and load data table section
            $('#requestFormSection').show();

            // Load the DataTable partial view
            $.get('/ChequeRequest/InitializeData', {
                partialView: '_RequestDataTable',
                path: 'list'
            }, function(html) {
                $('#requestFormSection').html(html);

                // Initialize DataTable after content is loaded
                initializeDataTable();
            });
        }

        function loadSearchForm() {
            // Hide other sections
            $('#requestFormSection').hide();
            $('#emptyState').hide();

            // Show search section
            $('#searchSection').show();

            // Reset search form
            if (window.searchManager) {
                window.searchManager.resetSearch();
            }
        }

                function initializeDataTable() {
                    // Wait a brief moment for the table to be rendered
                    setTimeout(function() {
                        if ($.fn.DataTable && $('#myDataTable').length) {
                            // Destroy existing DataTable if it exists
                            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                                $('#myDataTable').DataTable().destroy();
                            }

                            // Initialize new DataTable
                            $('#myDataTable').DataTable({
                                processing: false,
                                serverSide: true,
                                ajax: {
                                    url: '/ChequeRequest/LoadRequestsForDataTable',
                                    type: 'POST',
                                    data: function(d) {
                                        return {
                                            query: {
                                                Options: {
                                                    draw: d.draw,
                                                    start: d.start,
                                                    pageSize: d.length,
                                                    sortColumnName: d.columns[d.order[0]?.column]?.data,
                                                    sortDirection: d.order[0]?.dir || 'asc'
                                                },
                                                CustomerFilter: $('#customerFilter')?.val() || '',
                                                CategoryFilter: $('#categoryFilter')?.val() || '',
                                                StatusFilter: $('#statusFilter')?.val() || ''
                                            }
                                        };
                                    }
                                },
                                columns: [
                                    { data: 'customerName', name: 'customerName' },
                                    { data: 'categoryName', name: 'categoryName' },
                                    {
                                        data: 'requestDate',
                                        name: 'requestDate',
                                        render: function(data) {
                                            return data ? new Date(data).toLocaleDateString() : 'N/A';
                                        }
                                    },
                                    {
                                        data: 'status',
                                        name: 'status',
                                        render: function(data) {
                                            // Your status badge rendering logic
                                            return data;
                                        }
                                    },
                                    {
                                        data: null,
                                        orderable: false,
                                        className: 'text-center',
                                        render: function(data, type, row) {
                                            // Your action buttons rendering logic
                                            return '<div class="dropdown">...</div>';
                                        }
                                    }
                                ]
                            });
                        }
                    }, 100);
                      }

             



            function submitChequeRequestForm(form) {
                // Validate form first
                if (!$(form).valid()) {
                    return false;
                }

                const submitBtn = $(form).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Submitting...');

                // Build FormData manually
                const formData = new FormData();

                // Add non-checkbox fields
                $(form).serializeArray().forEach(function (field) {
                    if (!field.name.endsWith("_false")) {
                        formData.append(field.name, field.value);
                    }
                });

                // Add checkboxes explicitly
                $(form).find('input[type="checkbox"]').each(function () {
                    const checkbox = $(this);
                    const isChecked = checkbox.is(':checked');
                    const fieldName = checkbox.attr('name');
                    formData.delete(fieldName);
                    formData.append(fieldName, isChecked.toString());
                });

                // Build confirmation message
                const idValue = formData.get('Id') || formData.get('id');
                const customerName = formData.get('customerName') || 'Not specified';
                const customerId = formData.get('customerId') || 'Not specified';
                const operation = idValue ? 'Update' : 'Create';

                const summaryParts = [];
                summaryParts.push(`Action: ${operation}`);
                if (idValue) summaryParts.push(`ID: ${idValue}`);
                summaryParts.push(`Customer: ${customerName} (${customerId})`);

                const summary = summaryParts.join('\n');
                const confirmTitle = (operation === 'Update') ? 'Confirm Update' : 'Confirm Cheque Book Request';
                const confirmMessage = `Please confirm the following:\n\n${summary}\n\nProceed?`;

                // Show confirmation using alertify
                alertify.confirm(confirmTitle, confirmMessage,
                    function () { // OK callback -> perform AJAX
                        const ajaxConfig = {
                            type: 'POST',
                            url: form.action,
                            data: formData,
                            contentType: false,  // CRITICAL: Add this
                            processData: false,  // CRITICAL: Add this
                            success: function (response) {
                                console.log("Response:", response);

                                if (response && response.success) {
                                    // Use the actual properties your controller returns
                                    const messageType = response.status === "Exist" ? 3 : 
                                                      response.status === "Failed" ? 2 : 1;
                        
                                    appalert(response.message, messageType, 1);

                                    // Simple success handling
                                    $('#chequeRequestModal').modal('hide');
                        
                                    if (window.dataTableManager) {
                                        window.dataTableManager.refresh();
                                    }
                        
                                    form.reset();
                        
                                } else {
                                    // Handle failure
                                    const msg = response && response.message ? response.message : 'Operation failed';
                                    const msgType = response && response.status === "Exist" ? 3 : 2;
                                    appalert(msg, msgType, 1);
                                }
                            },
                            error: function (err) {
                                console.error('AJAX Error:', err);
                                if (err && err.status === 401) {
                                    window.location.href = '/Authentication/Login';
                                } else {
                                    const errorMsg = err.responseJSON && err.responseJSON.message ? 
                                                   err.responseJSON.message : 
                                                   (err.statusText || 'An error occurred');
                                    appalert(errorMsg, 4, 1);
                                }
                            },
                            complete: function () {
                                submitBtn.prop('disabled', false).html(originalText);
                            }
                        };

                        console.log('AJAX Config:', ajaxConfig);
                        $.ajax(ajaxConfig);
                    },
                    function () { // Cancel callback
                        submitBtn.prop('disabled', false).html(originalText);
                        appalert('Transaction cancelled', 3, 1);
                    }
                ).set('labels', { ok: 'Yes', cancel: 'No' });

                return false;
            }

        $(document).ready(function() {
            // Initialize managers
            window.searchManager = new SearchManager();
            window.formManager = new FormManager();
            window.dataTableManager = new DataTableManager();
            loadChequeRequests();
            // Show search section by default
            showSearchSection();
        });
    </script>
}