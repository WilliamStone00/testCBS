@* This simple partial is just a form for the modal *@
<form id="chequeActionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="requestId" name="requestId" />
    <input type="hidden" id="action" name="action" />
    <div class="mb-3">
        <label for="note" class="form-label">Note / Reason</label>
        <textarea id="note" name="note" class="form-control" rows="4" required></textarea>
    </div>
    <div class="text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit Action</button>
    </div>
</form>
