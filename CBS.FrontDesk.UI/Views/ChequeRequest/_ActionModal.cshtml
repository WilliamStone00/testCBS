<!-- Page Header -->
<fieldset class="fieldset-custom">
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-book-open-page-variant-outline me-2"></i> Cheque Book Request Actions
            </h1>
            <p class="card-text text-muted mb-1">
                Validate,Reject or Deliver a customers cheque request and manage the lifecycle of a request using this page.
            </p>
            <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
        </div>
    </div>

   
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="actionModalTitle">
                        <i class="mdi mdi-cog-outline me-2"></i>
                        <span id="actionTypeText">Process Request</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Request Information Header -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Customer Name</label>
                                    <p class="fw-bold text-dark mb-0" id="actionCustomerName">-</p>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Customer ID</label>
                                    <p class="fw-bold text-dark mb-0" id="actionCustomerId">-</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Request ID</label>
                                    <p class="fw-bold text-dark mb-0" id="actionRequestIdDisplay">-</p>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Current Status</label>
                                    <p class="fw-bold mb-0">
                                        <span id="actionCurrentStatus" class="badge bg-warning">-</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Form (only field user fills is "approvalNote") -->
                    <form id="actionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="actionType" name="actionType" value=""> <!-- e.g. "approve" or "reject" -->
                        <input type="hidden" id="hiddenRequestId" name="requestId" value="">

                        <div class="mb-3">
                            <label for="actionNote" class="form-label fw-bold text-dark">
                                <i class="mdi mdi-text-box-edit-outline me-1"></i>
                                Action Statement / Reason
                                <span class="text-danger">*</span>
                            </label>
                            <textarea id="actionNote" name="note" class="form-control" rows="5"
                                      placeholder="Please provide a detailed statement or reason for this action. This information will be recorded in the request history and may be visible to the customer..."
                                      required minlength="10"></textarea>
                            <div class="form-text text-muted">
                                <small>
                                    <i class="mdi mdi-information-outline me-1"></i>
                                    Required field. Minimum 10 characters.
                                </small>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close-circle-outline me-1"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="actionSubmitBtn">
                        <i class="mdi mdi-check-circle-outline me-1"></i>
                        <span id="submitButtonText">Submit Action</span>
                    </button>
                </div>
            </div>
    

    </fieldset>
    <script>
/*
  showActionModal(action, requestId, customerName, customerId, currentStatus)
  - action (string): e.g. "approve" | "reject" | "review" — we derive isApprove from it
  - requestId (string)
  - customerName, customerId, currentStatus are optional for display
*/
function showActionModal(action, requestId, customerName, customerId, currentStatus) {
    // normalize action text for display
    var displayAction = (action || 'Process').toString().replace(/^\w/, function (c) { return c.toUpperCase(); });

    // set visible fields
    $('#actionTypeText').text(displayAction +'For'+ customerName);
    $('#actionCustomerName').text(customerName || '-');
    $('#actionCustomerId').text(customerId || '-');
    $('#actionRequestIdDisplay').text(requestId || '-');
    $('#actionCurrentStatus').text(currentStatus || '-');

    // set hidden form values
    $('#actionType').val((action || '').toString().toLowerCase());
    $('#hiddenRequestId').val(requestId || '');

    // update summary text to reflect the chosen action
    $('#summaryAction').text(displayAction + ' Summary');
    $('#summaryDescription').text('You are about to ' + displayAction.toLowerCase() + ' this request. Please provide a short statement and confirm.');

    // reset comment field
    $('#actionNote').val('').removeClass('is-invalid');

    // set submit button text
    $('#submitButtonText').text(displayAction + ' Request');

    // show modal
    var modalEl = document.getElementById('actionModal');
    var modal = new bootstrap.Modal(modalEl);
    modal.show();
}

// Submit handler: builds the required JSON object and POSTs as application/json
$(document).on('click', '#actionSubmitBtn', function (e) {
    e.preventDefault();

    // basic validation
    var note = $('#actionNote').val() ? $('#actionNote').val().trim() : '';
    if (!note || note.length < 10) {
        $('#actionNote').addClass('is-invalid');
        // scroll into view so user sees validation (helpful on small screens)
        $('#actionNote').get(0).scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
    }

    var requestId = $('#hiddenRequestId').val();
    if (!requestId) {
        alert('Missing request identifier. Cannot proceed.');
        return;
    }

    // Decide isApprove: only 'approve' is true; everything else false
    var actionType = ($('#actionType').val() || '').toLowerCase();
    var isApprove = (actionType === 'approve');

    // Build payload matching specified schema
    var payload = {
        id: requestId,
        isApprove: isApprove,
        approvalNote: note,
        approvalDate: new Date().toISOString()
    };

    // anti-forgery token
    var token = $('#actionForm input[name="__RequestVerificationToken"]').val();

    // POST JSON to server - adjust URL if your controller expects a different route
    $.ajax({
        url: '@Url.Action("TakeAction", "ChequeRequest")', // adjust if needed
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        headers: token ? { 'RequestVerificationToken': token } : {},
        success: function (res) {
            // hide modal and refresh table if present
            var modalEl = document.getElementById('actionModal');
            bootstrap.Modal.getInstance(modalEl)?.hide();

            // reload datatable if present
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                $('#myDataTable').DataTable().ajax.reload(null, false);
            }

            // success feedback (you can change to your appalert)
            if (res && res.message) {
                alert(res.message);
            } else {
                alert('Action processed successfully.');
            }
        },
        error: function (xhr) {
            console.error('Action submission failed', xhr);
            var msg = 'Error performing action.';
            if (xhr && xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
            alert(msg);
        }
    });
});
    </script>
