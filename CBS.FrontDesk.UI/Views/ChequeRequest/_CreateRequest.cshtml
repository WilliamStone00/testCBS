@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeRequest.ChequeBookRequest
@using Resources

<div class="modal-body">
    @using (Html.BeginForm("CreateOrUpdate", "ChequeRequest", FormMethod.Post, new { enctype = "multipart/form-data", id = "chequeRequestForm" }))
    {
        @Html.AntiForgeryToken()

        <fieldset class="fieldset-custom">
            <div class="row g-3">

                <h5 class="legend-custom text-primary">
                    <i class="mdi mdi-plus-circle-outline me-2"></i>
                    Create New Cheque Book Request
                </h5>

                <!-- ======================= SECTION 1: Customer & Account Information ======================= -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pb-1 mb-3"><i class="mdi mdi-account-details me-1"></i> Customer & Account Details</h6>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalUserManagement.Branch</label>
                    @Html.DropDownListFor(m => m.branchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(m => m.branchId, "", new { @class = "text-danger" })
                </div>

                <!-- CHANGED: Customer ID Input with Search Button -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Customer ID</label>
                    <div class="input-group">
                        @Html.TextBox("customerIdInput", "", new
                        {
                            @class = "form-control",
                            placeholder = "Enter Customer ID",
                            id = "customerIdInput"
                        })
                        <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                            <i class="mdi mdi-magnify"></i>
                        </button>
                    </div>
                    <!-- Hidden field to store the actual customer ID -->
                    @Html.HiddenFor(m => m.customerId, new { id = "customerId" })
                    @Html.ValidationMessageFor(m => m.customerId, "", new { @class = "text-danger" })
                </div>

                <!-- Customer Name Display (will be populated after search) -->
                <div class="col-md-6">
                    <label class="form-label">Customer Name</label>
                    @Html.TextBoxFor(m => m.customerName, new
                    {
                        @class = "form-control",
                        placeholder = "Customer name will appear here",
                        id = "customerName",
                        @readonly = "readonly"
                    })
                    @Html.ValidationMessageFor(m => m.customerName, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Cheque Book Category</label>
                    @Html.DropDownListFor(m => m.categoryId, new SelectList(ViewBag.Categories, "Id", "name"), "--- Select Category ---", new { @class = "form-control select2", required = "required" })
                    @Html.ValidationMessageFor(m => m.categoryId, "", new { @class = "text-danger" })
                </div>

                <!-- Account Selection Dropdowns (will be populated after search) -->
                <div class="col-md-6">
                    <label class="form-label">Account for Cheque Book</label>
                    @Html.DropDownListFor(m => m.checkBookAccount, new SelectList(Enumerable.Empty<SelectListItem>()), "--- Select Account ---", new
                    {
                        @class = "form-control",
                        id = "checkBookAccountDropdown"
                    })
                    @Html.ValidationMessageFor(m => m.checkBookAccount, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Account for Fees (Debit)</label>
                    @Html.DropDownListFor(m => m.subscriptionPaymentAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "--- Select Account ---", new
                    {
                        @class = "form-control",
                        id = "subscriptionPaymentAccountDropdown"
                    })
                    @Html.ValidationMessageFor(m => m.subscriptionPaymentAccountId, "", new { @class = "text-danger" })
                </div>

                <!-- Rest of your form remains the same -->
                <div class="col-12">
                    <label class="form-label">Request Note (Optional)</label>
                    @Html.TextAreaFor(m => m.requestNote, new { @class = "form-control", placeholder = "Enter any specific notes for this request...", rows = "3" })
                </div>

                <!-- ======================= SECTION 2: Notification Preferences ======================= -->
                <div class="col-12 mt-4">
                    <h6 class="text-primary border-bottom pb-1 mb-3"><i class="mdi mdi-bell-ring-outline me-1"></i> Notification Options</h6>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mb-2">
                        @Html.CheckBoxFor(m => m.notifyOnApproval, new { @class = "form-check-input" })
                        <label class="form-check-label" for="NotifyOnApproval">Notify customer on Approval</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        @Html.CheckBoxFor(m => m.notifyOnRejection, new { @class = "form-check-input" })
                        <label class="form-check-label" for="NotifyOnRejection">Notify customer on Rejection</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        @Html.CheckBoxFor(m => m.notifyOnClearance, new { @class = "form-check-input" })
                        <label class="form-check-label" for="NotifyOnClearance">Notify customer on Cheque Clearance</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        @Html.CheckBoxFor(m => m.notifyOnPayment, new { @class = "form-check-input" })
                        <label class="form-check-label" for="NotifyOnPayment">Notify customer on Fee Payment</label>
                    </div>
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.notifyOnAnyTransaction, new { @class = "form-check-input" })
                        <label class="form-check-label" for="NotifyOnAnyTransaction">Notify customer on any transaction</label>
                    </div>
                </div>

                <!-- ======================= SECTION 3: Action Buttons ======================= -->
                <div class="col-12 text-end mt-3">
                    @if (Model.Id == null)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-send-check-outline me-1"></i> Submit Request
                        </button>
                        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4" id="resetFormBtn">
                            @GlobalShared.Reset
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">@GlobalBank.Update</button>
                    }
                </div>
            </div>
        </fieldset>
    }
</div>

<!-- Customer Details Modal -->
<div class="modal fade" id="customerDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Customer Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="customerDetailsContent">
                <!-- Customer details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="useCustomerBtn">Use This Customer</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Customer lookup functionality with debug logging
    $(document).ready(function () {
        let currentCustomerData = null;

        // Search customer button click - with better error handling
        $('#searchCustomerBtn').on('click', function () {
            console.log('Search button clicked'); // Debug log

            const customerId = $('#customerIdInput').val().trim();
            console.log('Customer ID entered:', customerId); // Debug log

            if (!customerId) {
                appalert('Please enter a Customer ID', 2, 1);
                return;
            }

            // Show loading state
            $('#customerDetailsContent').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Searching for customer...</div>
                </div>
            `);
            $('#customerDetailsModal').modal('show');

            // Build the URL with parameters
            const url = '@Url.Action("GetCustomerDetails", "ChequeRequest")' + '?customerId=' + encodeURIComponent(customerId);
            console.log('Making request to:', url); // Debug log

            // Make AJAX call to get customer details
            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    console.log('Response received:', response); // Debug log

                    if (response.success) {
                        currentCustomerData = response.data;
                        displayCustomerDetails(response.data);
                    } else {
                        $('#customerDetailsContent').html(`
                            <div class="alert alert-danger">
                                <i class="mdi mdi-alert-circle-outline me-2"></i>
                                ${response.message || 'Unknown error occurred'}
                            </div>
                        `);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', xhr, status, error); // Debug log

                    let errorMessage = 'Error searching for customer: ';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage += xhr.responseJSON.message;
                    } else {
                        errorMessage += error;
                    }

                    $('#customerDetailsContent').html(`
                        <div class="alert alert-danger">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            ${errorMessage}
                        </div>
                    `);
                }
            });
        });

        // Display customer details in modal
        function displayCustomerDetails(customerData) {
            console.log('Displaying customer data:', customerData); // Debug log

            if (!customerData) {
                $('#customerDetailsContent').html(`
                    <div class="alert alert-warning">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        No customer data received
                    </div>
                `);
                return;
            }

            const customer = customerData.customerDto;
            const accounts = customerData.accountDtos;

            if (!customer) {
                $('#customerDetailsContent').html(`
                    <div class="alert alert-warning">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        Customer information not found in response
                    </div>
                `);
                return;
            }

            let html = `
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-primary"><i class="mdi mdi-account-outline me-2"></i>Customer Information</h6>
                        <table class="table table-sm table-bordered">
                            <tr><td class="fw-bold">Customer ID:</td><td>${customer.customerId || 'N/A'}</td></tr>
                            <tr><td class="fw-bold">Name:</td><td>${(customer.firstName || '')} ${(customer.lastName || '')}</td></tr>
                            <tr><td class="fw-bold">Phone:</td><td>${customer.phone || 'N/A'}</td></tr>
                            <tr><td class="fw-bold">Email:</td><td>${customer.email || 'N/A'}</td></tr>
                            <tr><td class="fw-bold">Status:</td><td>${customer.active ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>'}</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary"><i class="mdi mdi-bank-outline me-2"></i>Account Summary</h6>
                        <table class="table table-sm table-bordered">
            `;

            // Safely handle accounts array
            if (accounts && Array.isArray(accounts)) {
                const activeAccounts = accounts.filter(a => a.status === 'Active');
                html += `
                    <tr><td class="fw-bold">Total Accounts:</td><td>${accounts.length}</td></tr>
                    <tr><td class="fw-bold">Active Accounts:</td><td>${activeAccounts.length}</td></tr>
                `;
            } else {
                html += `
                    <tr><td class="fw-bold">Total Accounts:</td><td>0</td></tr>
                    <tr><td class="fw-bold">Active Accounts:</td><td>0</td></tr>
                `;
            }

            html += `</table></div></div>`;

            // Add accounts table if accounts exist
            if (accounts && Array.isArray(accounts) && accounts.length > 0) {
                html += `
                    <div class="row mt-3">
                        <div class="col-12">
                            <h6 class="text-primary"><i class="mdi mdi-credit-card-outline me-2"></i>Customer Accounts</h6>
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-sm table-striped table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Account Number</th>
                                            <th>Account Name</th>
                                            <th>Type</th>
                                            <th>Balance</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                `;

                accounts.forEach(account => {
                    html += `
                        <tr>
                            <td>${account.accountNumber || 'N/A'}</td>
                            <td>${account.accountName || 'N/A'}</td>
                            <td>${account.accountType || 'N/A'}</td>
                            <td>${account.balance ? account.balance.toLocaleString() : '0.00'}</td>
                            <td>${account.status === 'Active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>'}</td>
                        </tr>
                    `;
                });

                html += `
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                `;
            }

            $('#customerDetailsContent').html(html);
        }

        // Use customer button click
        $('#useCustomerBtn').on('click', function () {
            if (!currentCustomerData) {
                appalert('No customer data available', 2, 1);
                return;
            }

            const customer = currentCustomerData.customerDto;
            const accounts = currentCustomerData.accountDtos;

            // Populate customer information
            $('#customerId').val(customer.customerId || '');
            $('#customerName').val(`${customer.firstName || ''} ${customer.lastName || ''}`.trim());

            // Populate account dropdowns
            populateAccountDropdowns(accounts);

            // Close modal
            $('#customerDetailsModal').modal('hide');

            appalert('Customer information loaded successfully!', 1, 1);
        });

        // Populate account dropdowns with customer accounts
        function populateAccountDropdowns(accounts) {
            // Clear existing options
            $('#checkBookAccountDropdown, #subscriptionPaymentAccountDropdown').empty();

            // Add default option
            $('#checkBookAccountDropdown').append(new Option('--- Select Account ---', ''));
            $('#subscriptionPaymentAccountDropdown').append(new Option('--- Select Account ---', ''));

            // Check if accounts exist and are array
            if (accounts && Array.isArray(accounts)) {
                const activeAccounts = accounts.filter(acc => acc.status === 'Active');

                // Add account options
                activeAccounts.forEach(account => {
                    const optionText = `${account.accountNumber || 'N/A'} - ${account.accountName || 'N/A'} (${account.accountType || 'N/A'}) - ${account.balance ? account.balance.toLocaleString() : '0.00'}`;
                    const optionValue = account.accountNumber || '';

                    if (optionValue) {
                        $('#checkBookAccountDropdown').append(new Option(optionText, optionValue));
                        $('#subscriptionPaymentAccountDropdown').append(new Option(optionText, optionValue));
                    }
                });

                // Set the first account as default for both dropdowns if available
                if (activeAccounts.length > 0 && activeAccounts[0].accountNumber) {
                    $('#checkBookAccountDropdown').val(activeAccounts[0].accountNumber);
                    $('#subscriptionPaymentAccountDropdown').val(activeAccounts[0].accountNumber);
                }
            }
        }

        // Reset form button
        $('#resetFormBtn').on('click', function () {
            // Clear customer-specific fields
            $('#customerIdInput').val('');
            $('#customerId').val('');
            $('#customerName').val('');
            $('#checkBookAccountDropdown, #subscriptionPaymentAccountDropdown').empty();
            currentCustomerData = null;
        });

        // Initialize Select2 for dropdowns
        if ($.fn.select2) {
            $('.select2').select2({ width: '100%' });
        }

        // Allow Enter key to trigger search
        $('#customerIdInput').on('keypress', function (e) {
            if (e.which === 13) { // Enter key
                $('#searchCustomerBtn').click();
                e.preventDefault();
            }
        });

        // Debug: Check if elements exist
        console.log('Search button element:', $('#searchCustomerBtn').length);
        console.log('Customer input element:', $('#customerIdInput').length);
    });
</script>