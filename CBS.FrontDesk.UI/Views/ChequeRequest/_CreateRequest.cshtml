@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeRequest.ChequeBookRequest
@using Resources

@using (Html.BeginForm("Create", "ChequeRequest", FormMethod.Post, new { onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

    <fieldset class="fieldset-custom">
        <div class="row g-3">

            <h5 class="legend-custom text-primary">
                <i class="mdi mdi-plus-circle-outline me-2"></i>
                Create New Cheque Book Request
            </h5>

            <!-- ======================= SECTION 1: Customer & Account Information ======================= -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pb-1 mb-3"><i class="mdi mdi-account-details me-1"></i> Customer & Account Details</h6>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalUserManagement.Branch</label>
                @Html.DropDownListFor(m => m.branchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                @Html.ValidationMessageFor(m => m.branchId, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Customer</label>
                @* This assumes ViewBag.Customers is a List<SelectListItem> prepared by your controller's Loader() *@
                @Html.DropDownListFor(m => m.customerId, new SelectList(ViewBag.Customers, "Value", "Text"), "--- Select Customer ---", new { @class = "form-control select2", required = "required" })
                @Html.ValidationMessageFor(m => m.customerId, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Cheque Book Category</label>
                @* This assumes ViewBag.Categories is a list prepared by your controller's Loader() *@
                @Html.DropDownListFor(m => m.categoryId, new SelectList(ViewBag.Categories, "Id", "name"), "--- Select Category ---", new { @class = "form-control select2", required = "required" })
                @Html.ValidationMessageFor(m => m.categoryId, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label">Account for Cheque Book (Debit)</label>
                @Html.TextBoxFor(m => m.checkBookAccount, new { @class = "form-control", placeholder = "Enter account number to be debited" })
                @Html.ValidationMessageFor(m => m.checkBookAccount, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label">Account for Fees (Payment)</label>
                @Html.TextBoxFor(m => m.subscriptionPaymentAccountId, new { @class = "form-control", placeholder = "Enter account for fee payment" })
                @Html.ValidationMessageFor(m => m.subscriptionPaymentAccountId, "", new { @class = "text-danger" })
            </div>

            <div class="col-12">
                <label class="form-label">Request Note (Optional)</label>
                @Html.TextAreaFor(m => m.requestNote, new { @class = "form-control", placeholder = "Enter any specific notes for this request...", rows = "3" })
            </div>

            <!-- ======================= SECTION 2: Notification Preferences ======================= -->
            <div class="col-12 mt-4">
                <h6 class="text-primary border-bottom pb-1 mb-3"><i class="mdi mdi-bell-ring-outline me-1"></i> Notification Options</h6>
            </div>

            <div class="col-12">
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.notifyOnApproval, new { @class = "form-check-input" })
                    <label class="form-check-label" for="NotifyOnApproval">Notify customer on Approval</label>
                </div>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.notifyOnRejection, new { @class = "form-check-input" })
                    <label class="form-check-label" for="NotifyOnRejection">Notify customer on Rejection</label>
                </div>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.notifyOnClearance, new { @class = "form-check-input" })
                    <label class="form-check-label" for="NotifyOnClearance">Notify customer on Cheque Clearance</label>
                </div>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.notifyOnPayment, new { @class = "form-check-input" })
                    <label class="form-check-label" for="NotifyOnPayment">Notify customer on Fee Payment</label>
                </div>
                <div class="form-check form-switch">
                    @Html.CheckBoxFor(m => m.notifyOnAnyTransaction, new { @class = "form-check-input" })
                    <label class="form-check-label" for="NotifyOnAnyTransaction">Notify customer on any transaction</label>
                </div>
            </div>

            <!-- ======================= SECTION 3: Action Buttons ======================= -->
            <div class="col-12 text-end mt-4">
                <button type="reset" class="btn btn-outline-secondary me-2">
                    <i class="mdi mdi-refresh me-1"></i> Reset Form
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="mdi mdi-send-check-outline me-1"></i> Submit Request
                </button>
            </div>

        </div>
    </fieldset>
}

<script>
    // Initialize select2 plugins as soon as this partial view is loaded
    $(document).ready(function () {
        if ($.fn.select2) {
            $('#CustomerId').select2({ placeholder: "--- Select Customer ---", width: '100%' });
            $('#CategoryId').select2({ placeholder: "--- Select Category ---", width: '100%' });
        }
    });
</script>