@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeRequest.ChequeBookRequest

<fieldset class="fieldset-custom">

    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-book-open-page-variant-outline me-2"></i> Cheque Book Request Details
            </h1>
            <p class="card-text text-muted mb-1">
               Here we have the details of a cheque request with all the informations required 
            </p>
                   <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
        </div>
    </div>

    @*<legend class="legend-custom d-flex justify-content-between align-items-center">
        <span>
            <i class="mdi mdi-information-outline me-2"></i>Cheque Request Details
        </span>
        <small class="text-muted">Request ID: @Model.Id</small>
    </legend>*@

    <div class="row">
        <h5 class="text-muted">Request ID: @Model.Id</h5>
        <!-- Left Column: Key Details -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Request Information</h5>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Customer Name</dt>
                        <dd class="col-sm-8">@Model.customerName (@Model.customerId)</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.categoryName</dd>

                        <dt class="col-sm-4">Cheque Book Account</dt>
                        <dd class="col-sm-8"><code>@Model.checkBookAccount</code></dd>

                        <dt class="col-sm-4">Fee Payment Account</dt>
                        <dd class="col-sm-8"><code>@Model.subscriptionPaymentAccount</code></dd>

                        <dt class="col-sm-4">Request Note</dt>
                        <dd class="col-sm-8">@Model.requestNote</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Right Column: Status & Timeline -->
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Status & Timeline</h5>
                    <hr />
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Current Status:</span>
                            <span class="badge bg-info">@Model.status</span>
                        </li>

                        @if (Model.approvalDate.HasValue)
                        {
                            <li class="list-group-item"><strong>Approval/Rejection Date:</strong> @Model.approvalDate?.ToString("f")</li>
                        }
                        <li class="list-group-item"><strong>Approval/Rejection Note:</strong> @Model.approvalNote</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Preferences -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title text-primary">Notification Preferences</h5>
                    <hr />
                    <div class="d-flex flex-wrap gap-3">
                        <div class="form-check"><input type="checkbox" disabled @(Model.notifyOnApproval ? "checked" : "") /> <label>On Approval</label></div>
                        <div class="form-check"><input type="checkbox" disabled @(Model.notifyOnRejection ? "checked" : "") /> <label>On Rejection</label></div>
                        <div class="form-check"><input type="checkbox" disabled @(Model.notifyOnClearance ? "checked" : "") /> <label>On Clearance</label></div>
                        <div class="form-check"><input type="checkbox" disabled @(Model.notifyOnPayment ? "checked" : "") /> <label>On Payment</label></div>
                        <div class="form-check"><input type="checkbox" disabled @(Model.notifyOnAnyTransaction ? "checked" : "") /> <label>On Any Transaction</label></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</fieldset>
