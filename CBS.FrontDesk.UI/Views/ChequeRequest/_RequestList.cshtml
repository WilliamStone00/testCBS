@using Resources

<fieldset class="fieldset-custom">
    <legend class="text-primary">
        <i class="mdi mdi-clipboard-list-outline me-2"></i>
        Existing Cheque Book Requests
    </legend>

    <!-- =================================================
         FILTERING SECTION
    ================================================== -->
    <div class="card p-3 mb-3 bg-light border">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Customer Name/ID</label>
                <input type="text" id="customerFilter" class="form-control" placeholder="Search customer...">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Category</label>
                @* Assumes ViewBag.Categories is loaded by the controller's InitializeData(path="list") *@
                @Html.DropDownList("categoryFilter", new SelectList(ViewBag.Categories, "Value", "Text"), "--- All Categories ---", new { @class = "form-control select2" })
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select id="statusFilter" class="form-control select2">
                    <option value="">--- All Statuses ---</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Delivered">Delivered</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button id="applyListFilterBtn" class="btn btn-primary w-100"><i class="mdi mdi-magnify me-1"></i>Filter</button>
            </div>
        </div>
    </div>


    <!-- =================================================
         DATATABLE
    ================================================== -->
    <div class="table-responsive">
        <table id="requestsDataTable" class="table table-hover" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>Customer Name</th>
                    <th>Category</th>
                    <th>Request Date</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded by server-side AJAX -->
            </tbody>
        </table>
    </div>
</fieldset>

<script>
    // Self-contained script for this partial view
    $(document).ready(function() {

        // --- Initialize Plugins ---
        $('#categoryFilter, #statusFilter').select2({ width: '100%' });

        // --- Helper Functions ---
        function getStatusBadge(status) {
            if (!status) return "";
            let badgeClass = "bg-secondary";
            switch (status.toLowerCase()) {
                case "pending": badgeClass = "bg-warning text-dark"; break;
                case "approved": badgeClass = "bg-success"; break;
                case "rejected": badgeClass = "bg-danger"; break;
                case "delivered": badgeClass = "bg-info"; break;
            }
            return `<span class='badge ${badgeClass}'>${status}</span>`;
        }

        function generateActionButtons(row) {
            let detailsBtn = `<a href="#" class="btn btn-sm btn-outline-secondary" onclick="AddORUpdateGen('${row.Id}', 'datalistingview', '_RequestDetails', 'get', 'ChequeRequest')">Details</a>`;
            let approveBtn = '', rejectBtn = '', deliverBtn = '';

            if ((row.Status || '').toLowerCase() === 'pending') {
                approveBtn = `<a href="#" class="btn btn-sm btn-outline-success" onclick="showActionModal('Approve', '${row.Id}', '${row.CustomerName}')">Approve</a>`;
                rejectBtn = `<a href="#" class="btn btn-sm btn-outline-danger" onclick="showActionModal('Reject', '${row.Id}', '${row.CustomerName}')">Reject</a>`;
            }
            if ((row.Status || '').toLowerCase() === 'approved') {
                deliverBtn = `<a href="#" class="btn btn-sm btn-outline-info" onclick="showActionModal('Delivered', '${row.Id}', '${row.CustomerName}')">Deliver</a>`;
            }

            return `<div class="btn-group btn-group-sm">${detailsBtn}${approveBtn}${rejectBtn}${deliverBtn}</div>`;
        }

        // --- DataTable Initialization ---
        const requestsDataTable = $('#requestsDataTable').DataTable({
            "processing": true,
            "serverSide": true,
            "searching": false, // We use our own custom filters
            "ajax": {
                // IMPORTANT: You will need to create this controller action
                "url": "@Url.Action("LoadRequestsForDataTable", "ChequeRequest")",
                "type": "POST",
                "data": function (d) {
                    const order = d.order[0] || {};
                    const query = {
                        Options: { // Assumes a similar DataTableOptions DTO
                            draw: d.draw,
                            start: d.start,
                            pageSize: d.length,
                            sortColumnName: d.columns[order.column]?.name,
                            sortDirection: order.dir
                        },
                        // Pass our filter values to the controller
                        CustomerFilter: $('#customerFilter').val(),
                        CategoryFilter: $('#categoryFilter').val(),
                        StatusFilter: $('#statusFilter').val()
                    };
                    return { query: query };
                }
            },
            "columns": [
                // 'name' must match a property on your request DTO for sorting
                { "data": "CustomerName", "name": "CustomerName" },
                { "data": "CategoryName", "name": "CategoryName" },
                {
                    "data": "RequestDate",
                    "name": "RequestDate",
                    "render": function(data) { return data ? new Date(data).toLocaleDateString() : ''; }
                },
                {
                    "data": "Status",
                    "name": "Status",
                    "orderable": false,
                    "render": getStatusBadge
                },
                {
                    "data": null, // 'data' is null because we build actions from the full row object
                    "orderable": false,
                    "className": "text-center",
                    "render": function (data, type, row) {
                        return generateActionButtons(row);
                         // 'row' is the full object for the current row: { Id: "...", CustomerName: "...", ... }
                    }
                }
            ]
        });

        // --- Event Handlers ---
        $('#applyListFilterBtn').on('click', function() {
            requestsDataTable.ajax.reload();
        });
    });
</script>