@using Resources
@{
    ViewBag.Title = "Cheque Requests";
}
<fieldset class="fieldset-custom">
    <div class="card shadow p-3 mb-4">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-filter-outline me-1"></i> Advanced Request Filters
        </h5>

        <div class="card p-3 mb-3 bg-light">
            <form id="chequeRequestFilterForm" autocomplete="off" method="post" action="@Url.Action("Filter", "ChequeRequests")">
                <div class="row g-3 mb-2">
                    <!-- Customer -->
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byCustomerToggle" />
                            <label class="form-check-label" for="byCustomerToggle">Filter by Customer</label>
                        </div>

                        <div id="customerFilterSection" class="mt-2" style="display:none;">
                            <!-- maps to ChequeRequestQuery.CustomerId -->
                            <input type="text" id="CustomerId" name="CustomerId" class="form-control" placeholder="Customer name or ID..." />
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byCategoryToggle" />
                            <label class="form-check-label" for="byCategoryToggle">Filter by Category</label>
                        </div>

                        <div id="categoryFilterSection" class="mt-2" style="display:none;">
                            @Html.DropDownList(
                                "CategoryId",                                              // maps to ChequeRequestQuery.CategoryId
                                new SelectList(ViewBag.Categories ?? new List<object>(), "Id", "name"),
                                "All Categories",
                                new { @class = "form-select", id = "CategoryId" })
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="col-md-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byStatusToggle" />
                            <label class="form-check-label" for="byStatusToggle">Filter by Status</label>
                        </div>

                        <div id="statusFilterSection" class="mt-2" style="display:none;">
                            <!-- maps to ChequeRequestQuery.Status -->
                            <select id="Status" name="Status" class="form-select">
                                <option value="">All Statuses</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Rejected">Rejected</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Reviewed">Reviewed</option>
                            </select>
                        </div>
                    </div>

                    <!-- Branch -->
                    <div class="col-md-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byBranchToggle" />
                            <label class="form-check-label" for="byBranchToggle">Filter by Branch</label>
                        </div>

                        <div id="branchFilterSection" class="mt-2" style="display:none;">
                            @Html.DropDownList(
                                "BranchId",                                              // maps to ChequeRequestQuery.BranchId
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "name"),
                                "All Branches",
                                new { @class = "form-select", id = "BranchId" })
                        </div>
                    </div>

                    <!-- Bank -->
                    <div class="col-md-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byBankToggle" />
                            <label class="form-check-label" for="byBankToggle">Filter by Bank</label>
                        </div>

                        <div id="bankFilterSection" class="mt-2" style="display:none;">
                            @Html.DropDownList(
                                "BankId",                                                // maps to ChequeRequestQuery.BankId
                                new SelectList(ViewBag.Banks ?? new List<object>(), "Id", "name"),
                                "All Banks",
                                new { @class = "form-select", id = "BankId" })
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-2">
                    <!-- Approval Date (single) -->
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byApprovalDateToggle" />
                            <label class="form-check-label" for="byApprovalDateToggle">Filter by Approval Date</label>
                        </div>

                        <div id="approvalDateFilterSection" class="mt-2" style="display:none;">
                            <!-- maps to ChequeRequestQuery.ApprovalDate -->
                            <input type="date" id="ApprovalDate" name="ApprovalDate" class="form-control" />
                        </div>
                    </div>

                    <!-- Notification options -->
                    <div class="col-md-5">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byNotifyToggle" />
                            <label class="form-check-label" for="byNotifyToggle">Notification Options</label>
                        </div>

                        <div id="notifyFilterSection" class="mt-2" style="display:none;">
                            <div class="row">
                                <div class="col-6 col-sm-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NotifyOnApproval" name="NotifyOnApproval" />
                                        <label class="form-check-label small" for="NotifyOnApproval">Notify on Approval</label>
                                    </div>
                                </div>

                                <div class="col-6 col-sm-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NotifyOnClearance" name="NotifyOnClearance" />
                                        <label class="form-check-label small" for="NotifyOnClearance">Notify on Clearance</label>
                                    </div>
                                </div>

                                <div class="col-6 col-sm-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NotifyOnRejection" name="NotifyOnRejection" />
                                        <label class="form-check-label small" for="NotifyOnRejection">Notify on Rejection</label>
                                    </div>
                                </div>

                                <div class="col-6 col-sm-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NotifyOnPayment" name="NotifyOnPayment" />
                                        <label class="form-check-label small" for="NotifyOnPayment">Notify on Payment</label>
                                    </div>
                                </div>

                                <div class="col-6 col-sm-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="NotifyOnAnyTransaction" name="NotifyOnAnyTransaction" />
                                        <label class="form-check-label small" for="NotifyOnAnyTransaction">Notify on Any Transaction</label>
                                    </div>
                                </div>

                                <div class="col-6 col-sm-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="AutomaticRenewal" name="AutomaticRenewal" />
                                        <label class="form-check-label small" for="AutomaticRenewal">Automatic Renewal</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Validity Date range -->
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="byDateToggle" />
                            <label class="form-check-label" for="byDateToggle">Filter by Date Range</label>
                        </div>

                        <div id="dateFilterSection" class="mt-2" style="display:none;">
                            <div class="row g-2">
                                <!-- StartDate & EndDate map to ChequeRequestQuery.StartDate / EndDate -->
                                <div class="col-6">
                                    <input type="date" id="StartDate" name="StartDate" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <input type="date" id="EndDate" name="EndDate" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-12 d-flex">
                        <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                            <i class="mdi mdi-magnify"></i> Apply Filter
                        </button>

                        <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                            <i class="mdi mdi-refresh"></i> Reset
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <hr />

    <table id="requestsDataTable" class="table table-bordered table-striped" width="100%">
        <thead class="table-light">
            <tr>
                <th>Customer Name</th>
                <th>Category</th>
                <th>Request Date</th>
                <th class="text-center">Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</fieldset>

<!-- DETAILS MODAL -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-white">
                <h5 class="modal-title"><i class="mdi mdi-eye-outline me-1"></i> Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="detailsModalBody" class="modal-body p-3">Loading…</div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ACTION MODAL -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Take Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="actionModalBody" class="modal-body">
                <div class="text-center text-muted py-4">Loading form…</div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        console.log('ChequeRequests view script loaded');

        // ensure DOM ready
        $(function () {
            try {
                // Initialize DataTable
                var table = $('#requestsDataTable').DataTable({
                    processing: false,
                    serverSide: true,
                    searching: false,
                    order: [[2, 'desc']],
                    // send JSON body (like your manual entry system)
                    ajax: {
                        url: '@Url.Action("LoadChequeBooksData", "ChequeRequest")',
                        type: 'POST',
                        contentType: "application/json",
                        data: function (d) {
                            // if toggles are off, still pass values (server can ignore nulls)
                            return JSON.stringify({
                                Options: d,
                                CustomerFilter: $('#customerFilter').val() || null,
                                CategoryFilter: $('#categoryFilter').val() || null,
                                StatusFilter: $('#statusFilter').val() || null,
                                CustomerName: $('#customerNameFilter').val() || null,
                                BranchId: $('#branchFilter').val() || null,
                                BankId: $('#bankFilter').val() || null,
                                NotifyOnRejection: $('#notifyRejectionFilter').is(':checked') || false,
                                AutomaticRenewal: $('#automaticRenewalFilter').is(':checked') || false,
                                NotifyOnAnyTransaction: $('#notifyAnyTransactionFilter').is(':checked') || false,
                                NotifyOnClearance: $('#notifyClearanceFilter').is(':checked') || false,
                                StartDate: $('#startDateFilter').val() || null,
                                EndDate: $('#endDateFilter').val() || null
                            });
                        }
                    },
                    columns: [
                        { data: "customerName", name: "CustomerName", className: "ps-4" },
                        { data: "categoryName", name: "CategoryName" },
                        {
                            data: "requestDate",
                            name: "RequestDate",
                            render: function (data) { return data ? new Date(data).toLocaleString() : ''; }
                        },
                        {
                            data: "status",
                            name: "Status",
                            className: "text-center",
                            orderable: false,
                            render: function (data) { return getStatusBadge(data); }
                        },
                        {
                            data: null,
                            className: "text-center pe-4",
                            orderable: false,
                            render: function (data, type, row) { return renderActionButtons(row); }
                        }
                    ],
                    drawCallback: function () {
                        updateTableInfo();
                    }
                });

                // Toggle handlers
                $('#byCustomerToggle').change(function () { $('#customerFilterSection').toggle(this.checked); });
                $('#byCategoryToggle').change(function () { $('#categoryFilterSection').toggle(this.checked); });
                $('#byStatusToggle').change(function () { $('#statusFilterSection').toggle(this.checked); });
                $('#byDateToggle').change(function () { $('#dateFilterSection').toggle(this.checked); });
                $('#byBranchToggle').change(function () { $('#branchFilterSection').toggle(this.checked); });
                $('#byBankToggle').change(function () { $('#bankFilterSection').toggle(this.checked); });
                $('#byCustomerNameToggle').change(function () { $('#customerNameFilterSection').toggle(this.checked); });
                $('#byNotifyToggle').change(function () { $('#notifyFilterSection').toggle(this.checked); });

                // Buttons
                $('#applyFilterBtn').on('click', function () {
                    console.debug('Apply filters clicked');
                    table.ajax.reload();
                });

                $('#resetFilterBtn').on('click', function () {
                    resetFilters();
                    table.ajax.reload();
                });

                $('#printBtn').on('click', function () {
                    alert('TODO: Implement PDF export for filtered results.');
                });

                // Global functions used by action buttons in rows
                window.viewDetails = function (id) {
                    if (!id) return;
                    $.get('@Url.Action("InitializeData", "ChequeRequest")', { KEY: id, partialView: '_RequestDetails', path: 'get' })
                        .done(function (html) {
                            $('#detailsModalBody').html(html);
                            var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                            modal.show();
                        })
                        .fail(function () {
                            alert('Unable to load details.');
                        });
                };

                window.showActionModal = function (action, requestId, customerName) {
                    if (!requestId) return;
                    $.get('@Url.Action("InitializeData", "ChequeRequest")', { KEY: requestId, partialView: '_ActionModal', path: 'get' })
                        .done(function (html) {
                            $('#actionModalBody').html(html);
                            $('#actionModalLabel').text(action + ' Request - ' + customerName);
                            $('#actionModalBody').find('#actionType').val(action.toLowerCase());
                            $('#actionModalBody').find('#actionRequestId').val(requestId);
                            $('#actionModalBody').find('#actionSubmitBtn').off('click').on('click', function () {
                                submitAction($('#actionModalBody').find('form').get(0), table);
                            });
                            var modal = new bootstrap.Modal(document.getElementById('actionModal'));
                            modal.show();
                        })
                        .fail(function () {
                            var fallback = '<form id="actionForm">' +
                                '<input type="hidden" id="actionType" name="action" value="' + action.toLowerCase() + '" />' +
                                '<input type="hidden" id="actionRequestId" name="requestId" value="' + requestId + '" />' +
                                '<div class="mb-3"><label for="actionNote" class="form-label">Statement / Reason</label>' +
                                '<textarea id="actionNote" name="note" class="form-control" rows="4" required></textarea></div>' +
                                '<div class="text-end"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>' +
                                '<button type="button" class="btn btn-primary" id="actionSubmitBtn">Submit Action</button></div></form>';

                            $('#actionModalBody').html(fallback);
                            $('#actionSubmitBtn').off('click').on('click', function () {
                                submitAction($('#actionModalBody').find('#actionForm').get(0), table);
                            });
                            var modal = new bootstrap.Modal(document.getElementById('actionModal'));
                            modal.show();
                        });
                };

                // Helpers
                function getStatusBadge(status) {
                    var statusMap = {
                        'pending': 'bg-warning text-dark',
                        'approved': 'bg-success',
                        'rejected': 'bg-danger',
                        'delivered': 'bg-info',
                        'reviewed': 'bg-primary'
                    };
                    var cls = statusMap[(status || '').toLowerCase()] || 'bg-secondary';
                    return '<span class="badge ' + cls + '">' + (status || '—') + '</span>';
                }

                function renderActionButtons(row) {
                    var status = (row.status || '').toLowerCase();
                    var id = row.Id || row.id || '';
                    var name = (row.customerName || '').replace(/'/g, "\\'");
                    var detailsBtn = '<a href="#" class="btn btn-sm btn-outline-info me-1" onclick="viewDetails(\'' + id + '\')" title="View Details"><i class="mdi mdi-eye-outline"></i></a>';
                    var dropdownItems = '';
                    if (status === 'pending') dropdownItems += '<li><a class="dropdown-item" href="#" onclick="showActionModal(\'Review\', \'' + id + '\', \'' + name + '\')">Review</a></li>';
                    if (status === 'reviewed') { dropdownItems += '<li><a class="dropdown-item" href="#" onclick="showActionModal(\'Approve\', \'' + id + '\', \'' + name + '\')">Approve</a></li>'; dropdownItems += '<li><a class="dropdown-item" href="#" onclick="showActionModal(\'Reject\', \'' + id + '\', \'' + name + '\')">Reject</a></li>'; }
                    if (status === 'approved') dropdownItems += '<li><a class="dropdown-item" href="#" onclick="showActionModal(\'Delivered\', \'' + id + '\', \'' + name + '\')">Mark as Delivered</a></li>';

                    if (dropdownItems) {
                        return '<div class="btn-group">' + detailsBtn +
                            '<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>' +
                            '<ul class="dropdown-menu">' + dropdownItems + '</ul></div>';
                    }
                    return detailsBtn;
                }

                function submitAction(form, tableInstance) {
                    if (!form) return false;
                    var $f = $(form);
                    var token = $f.find('input[name="__RequestVerificationToken"]').val();
                    var requestId = $f.find('input[name="requestId"]').val() || $f.find('#actionRequestId').val();
                    var action = $f.find('input[name="action"]').val() || $f.find('#actionType').val();
                    var note = $f.find('textarea[name="note"]').val() || $f.find('#actionNote').val();

                    if (!requestId || !action) {
                        alert('Missing request id or action');
                        return false;
                    }

                    var payload = { requestId: requestId, action: action, note: note };

                    $.ajax({
                        url: '@Url.Action("TakeAction", "ChequeRequest")',
                        type: 'POST',
                        data: payload,
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        success: function (res) {
                            var modalEl = document.getElementById('actionModal');
                            bootstrap.Modal.getInstance(modalEl)?.hide();
                            tableInstance.ajax.reload();
                            alert((res && res.message) ? res.message : 'Action processed.');
                        },
                        error: function (xhr) {
                            alert('Error performing action.');
                        }
                    });

                    return false;
                }

                function updateTableInfo() {
                    if (table) {
                        var info = table.page.info();
                        // optionally update a small info element
                        if ($('#tableInfo').length) {
                            $('#tableInfo').text('Showing ' + (info.start + 1) + ' to ' + info.end + ' of ' + info.recordsTotal + ' entries');
                        }
                    }
                }

                function resetFilters() {
                    $('#customerFilter').val('');
                    $('#categoryFilter').val('');
                    $('#statusFilter').val('');
                    $('#customerNameFilter').val('');
                    $('#branchFilter').val('');
                    $('#bankFilter').val('');
                    $('#startDateFilter').val('');
                    $('#endDateFilter').val('');
                    $('#notifyRejectionFilter').prop('checked', false);
                    $('#notifyAnyTransactionFilter').prop('checked', false);
                    $('#notifyClearanceFilter').prop('checked', false);
                    $('#automaticRenewalFilter').prop('checked', false);

                    $('input.form-check-input[type=checkbox]').prop('checked', false);
                    $('#customerFilterSection, #categoryFilterSection, #statusFilterSection, #dateFilterSection, #customerNameFilterSection, #branchFilterSection, #bankFilterSection, #notifyFilterSection').hide();
                }

            } catch (err) {
                console.error('ChequeRequests script failed:', err);
            }
        });
    })();
</script>
