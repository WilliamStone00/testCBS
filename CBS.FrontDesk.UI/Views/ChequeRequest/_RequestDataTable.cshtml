@using Resources
@{
    ViewBag.Title = "Cheque Requests";
}
<fieldset class="fieldset-custom">

    <h5 class="text-primary mb-3">
        <i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.Advanced_Request_Filters
    </h5>

    <div class="card p-3 mb-3 bg-light">
        <form id="chequeRequestFilterForm" autocomplete="off">
            <div class="row g-3 mb-2">
                <!-- Customer -->
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byCustomerToggle" />
                        <label class="form-check-label" for="byCustomerToggle">@GlobalShared.Filter_by_Customer</label>
                    </div>

                    <div id="customerFilterSection" class="mt-2" style="display:none;">
                        <input type="text" id="CustomerId" name="CustomerId" class="form-control" placeholder="@ChequeRequestResource.Customer_name_or_ID..." />
                    </div>
                </div>

                <!-- Category -->
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byCategoryToggle" />
                        <label class="form-check-label" for="byCategoryToggle">@GlobalShared.Filter_by_Category</label>
                    </div>

                    <div id="categoryFilterSection" class="mt-2" style="display:none;">
                        @Html.DropDownList(
                            "CategoryId",
                            new SelectList(ViewBag.Categories ?? new List<object>(), "Id", "name"),
                            "All Categories",
                            new { @class = "form-select", id = "CategoryId" })
                    </div>
                </div>

                <!-- Status -->
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byStatusToggle" />
                        <label class="form-check-label" for="byStatusToggle">@GlobalShared.Filter_by_status</label>
                    </div>

                    <div id="statusFilterSection" class="mt-2" style="display:none;">
                        <select id="Status" name="Status" class="form-select">
                            <option value="">@GlobalShared.All_Statuses</option>
                            <option value="pending">@GlobalShared.Pending</option>
                            <option value="approved">@GlobalShared.Approved</option>
                            <option value="rejected">@GlobalShared.Rejected</option>
                            <option value="delivered">@GlobalShared.Delivered</option>
                            <option value="reviewed">@GlobalShared.Reviewed</option>
                        </select>
                    </div>
                </div>

                <!-- Branch -->
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byBranchToggle" />
                        <label class="form-check-label" for="byBranchToggle">@GlobalShared.FilterByBranch</label>
                    </div>

                    <div id="branchFilterSection" class="mt-2" style="display:none;">
                        @Html.DropDownList(
                            "BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "name"),
                            "All Branches",
                            new { @class = "form-select", id = "BranchId" })
                    </div>
                </div>

            </div>

            <div class="row g-3 mb-2">
                <!-- Approval Date (single) -->
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byApprovalDateToggle" />
                        <label class="form-check-label" for="byApprovalDateToggle">@GlobalShared.Filter_by_Approval_Date</label>
                    </div>

                    <div id="approvalDateFilterSection" class="mt-2" style="display:none;">
                        <input type="date" id="ApprovalDate" name="ApprovalDate" class="form-control" />
                    </div>
                </div>

                <!-- Notification options -->
                <div class="col-md-5">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byNotifyToggle" />
                        <label class="form-check-label" for="byNotifyToggle">@GlobalShared.Notification_Options</label>
                    </div>

                    <div id="notifyFilterSection" class="mt-2" style="display:none;">
                        <div class="row">
                            <div class="col-6 col-sm-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="NotifyOnApproval" name="NotifyOnApproval" />
                                    <label class="form-check-label small" for="NotifyOnApproval">@GlobalShared.Notify_on_Approval</label>
                                </div>
                            </div>

                            <div class="col-6 col-sm-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="NotifyOnClearance" name="NotifyOnClearance" />
                                    <label class="form-check-label small" for="NotifyOnClearance">@GlobalShared.Notify_on_Clearance</label>
                                </div>
                            </div>

                            <div class="col-6 col-sm-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="NotifyOnRejection" name="NotifyOnRejection" />
                                    <label class="form-check-label small" for="NotifyOnRejection">@GlobalShared.Notify_on_Rejection</label>
                                </div>
                            </div>

                            <div class="col-6 col-sm-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="NotifyOnPayment" name="NotifyOnPayment" />
                                    <label class="form-check-label small" for="NotifyOnPayment">@GlobalShared.Notify_on_Payment</label>
                                </div>
                            </div>

                            <div class="col-6 col-sm-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="NotifyOnAnyTransaction" name="NotifyOnAnyTransaction" />
                                    <label class="form-check-label small" for="NotifyOnAnyTransaction">@GlobalShared.Notify_on_Any_Transaction</label>
                                </div>
                            </div>

                            <div class="col-6 col-sm-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="AutomaticRenewal" name="AutomaticRenewal" />
                                    <label class="form-check-label small" for="AutomaticRenewal">@GlobalShared.Automatic_Renewal</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Validity Date range -->
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="byDateToggle" />
                        <label class="form-check-label" for="byDateToggle">@GlobalShared.Filter_by_Date_Range</label>
                    </div>

                    <div id="dateFilterSection" class="mt-2" style="display:none;">
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="date" id="StartDate" name="StartDate" class="form-control" />
                            </div>
                            <div class="col-6">
                                <input type="date" id="EndDate" name="EndDate" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-12 d-flex">
                    <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                    </button>

                    <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                        <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                    </button>
                </div>
            </div>
        </form>
    </div>

    <hr />

    <table id="myDataTable" class="table table-bordered table-striped" width="100%">
        <colgroup>
            <col style="width:30%;">
            <col style="width:20%;">
            <col style="width:20%;">
            <col style="width:15%;">
            <col style="width:15%;">
        </colgroup>

        <thead class="table-light">
            <tr>
                <th>@GlobalShared.Customer_Name</th>
                <th>@GlobalShared.Category</th>
                <th>@GlobalShared.Branch_Name</th>
                <th class="text-center">@GlobalShared.Status</th>
                <th class="text-center">@GlobalShared.Actions</th>
            </tr>
        </thead>
    </table>

</fieldset>

<!-- DETAILS MODAL -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div id="detailsModalBody" class="modal-body p-3">

            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ACTION MODAL -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4">
                <!-- Request Information Header -->
                <div class="card bg-light mb-4 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="modal-title">
                            <i class="mdi mdi-cog-outline me-2"></i>
                            <span id="actionModalTitle">@GlobalShared.Process_Request</span>
                        </h5>
                        <div class="alert alert-info mt-3 py-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            @ChequeRequestResource.Validate_Reject_or_Deliver_a_customers_cheque_request_and_manage_the_lifecycle_of_a_request_using_this_page
                        </div>
                        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
                    </div>
                </div>

                <div class="card mb-4 border-0 bg-light">
                    <div class="card-body py-3">
                        <div class="row">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">@GlobalShared.Customer_Name</label>
                                <p class="fw-bold text-dark mb-0" id="actionCustomerName">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">@GlobalShared.Customer_ID</label>
                                <p class="fw-bold text-dark mb-0" id="actionCustomerId">-</p>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">@GlobalShared.Request_ID</label>
                                <p class="fw-bold text-dark mb-0" id="actionRequestIdDisplay">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">@GlobalShared.Current_Status</label>
                                <p class="fw-bold mb-0">
                                    <span id="actionCurrentStatus" class="badge bg-warning">-</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Form -->
                <form id="actionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="actionType" name="actionType" value="">
                    <input type="hidden" id="hiddenRequestId" name="requestId" value="">

                    <div class="mb-3">
                        <label for="actionNote" class="form-label fw-bold text-dark">
                            <i class="mdi mdi-text-box-edit-outline me-1"></i>
                            @GlobalShared.Action_Statement / @GlobalShared.Reason
                            <span class="text-danger">*</span>
                        </label>
                        <textarea id="actionNote" name="note" class="form-control" rows="5"
                                  placeholder="@ChequeRequestResource.Please_provide_a_detailed_statement_or_reason_for_this_action_This_information_will_be_recorded_in_the_request_history_and_may_be_visible_to_the_customer"
                                  required minlength="10"></textarea>
                        <div class="form-text text-muted">
                            <small>
                                <i class="mdi mdi-information-outline me-1"></i>
                                @GlobalShared.Required_field_Minimum_10_characters
                            </small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> @GlobalShared.Cancel
                </button>
                <button type="button" class="btn btn-primary" id="actionSubmitBtn">
                    <i class="mdi mdi-check-circle-outline me-1"></i>
                    <span id="submitButtonText">@GlobalShared.Submit_Action</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Cheque Requests - DataTable + Actions
(function () {
    'use strict';

    // Store last action type in case DOM issues
    window._lastActionType = '';

    // Collect filters to send to server
    function collectChequeFilters() {
        return {
            CustomerId: $('#CustomerId').val() || '',
            CategoryId: $('#CategoryId').val() || '',
            Status: $('#Status').val() || '',
            BranchId: $('#BranchId').val() || '',
            BankId: $('#BankId').val() || '',
            ApprovalDate: $('#ApprovalDate').val() || '',
            StartDate: $('#StartDate').val() || '',
            EndDate: $('#EndDate').val() || '',
            NotifyOnApproval: $('#NotifyOnApproval').is(':checked') || false,
            NotifyOnClearance: $('#NotifyOnClearance').is(':checked') || false,
            NotifyOnRejection: $('#NotifyOnRejection').is(':checked') || false,
            NotifyOnPayment: $('#NotifyOnPayment').is(':checked') || false,
            NotifyOnAnyTransaction: $('#NotifyOnAnyTransaction').is(':checked') || false,
            AutomaticRenewal: $('#AutomaticRenewal').is(':checked') || false,
            ShowAll: false,
            options: {}
        };
    }

    // Initialize / load cheques into DataTable
    function loadChequeData() {
        // destroy if exists so filters/sorting reapply cleanly
        if ($.fn.DataTable.isDataTable('#myDataTable')) {
            $('#myDataTable').DataTable().destroy();
            $('#myDataTable').find('tbody').empty();
        }

        $('#myDataTable').DataTable({
            serverSide: false,
            destroy: true,
            searching: true,
            order: [[0, 'desc']],
            columnDefs: [
                { targets: 0, width: '30%' },
                { targets: 1, width: '20%' },
                { targets: 2, width: '20%' },
                { targets: 3, width: '15%', className: 'text-center' },
                { targets: 4, width: '15%', className: 'text-center' }
            ],
            ajax: {
                url: '@Url.Action("LoadChequeBooksData", "ChequeRequest")',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    var filters = collectChequeFilters();
                    filters.options = {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        skip: d.start,
                        pageSize: d.length,
                        searchValue: (d.search && d.search.value) ? d.search.value : '',
                        sortColumnName: (d.order && d.order.length) ? (d.columns[d.order[0].column].data) : '',
                        sortColumnDirection: (d.order && d.order.length) ? d.order[0].dir : 'desc'
                    };
                    return JSON.stringify(filters);
                }
            },
            columns: [
                { data: 'CustomerName', name: 'customerName' },
                { data: 'CheckBookCategoryName', name: 'categoryName' },
                {
                    data: 'BranchName',
                    name: 'branchName',
                    render: function (data) { return data ? data : '—'; }
                },
                {
                    data: 'Status',
                    name: 'status',
                    className: 'text-center',
                    orderable: false,
                    render: function (data) { return getStatusBadge(data); }
                },
                {
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    render: function (_, __, row) {
                        var id = row.Id || row.id || '';
                        var customerId = row.CustomerId || '';
                        var name = (row.CustomerName || '').replace(/'/g, "\\'");
                        var status = (row.Status || '').toLowerCase();

                        var items = '';
                        if (status === 'pending') {
                            items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('review', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-magnify me-2 text-primary"></i> Review</button></li>`;
                            items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('approve', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-check me-2 text-success"></i> Approve</button></li>`;
                            items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('reject', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-close me-2 text-danger"></i> Reject</button></li>`;
                        }
                        if (status === 'review') {
                            items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('approve', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-check me-2 text-success"></i> Approve</button></li>`;
                            items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('reject', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-close me-2 text-danger"></i> Reject</button></li>`;
                        }
                        //if (status === 'approved') {
                        //    items += `<li><button class="dropdown-item text-dark" onclick="showActionModal('delivered', '${id}', '${name}', '${customerId}', '${status}')"><i class="mdi mdi-truck-delivery me-2 text-info"></i> Mark as Delivered</button></li>`;
                        //}

                        var detailsBtn = `<li><button class="dropdown-item text-dark" onclick="viewDetails('${id}')"><i class="mdi mdi-eye-outline me-2 text-primary"></i> Details</button></li>`;

                        var menu = `
                            <div class="text-center dropdown">
                                <button class="btn btn-sm btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="mdi mdi-cog"></i> Actions
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    ${detailsBtn}
                                    ${items}
                                </ul>
                            </div>`;
                        return menu;
                    }
                }
            ],
            drawCallback: function () { updateTableInfo(); }
        });
    }

    // Simple status badge helper
    function getStatusBadge(status) {
        var statusMap = {
            'pending': 'bg-warning text-dark',
            'approved': 'bg-success',
            'rejected': 'bg-danger',
            'delivered': 'bg-info',
            'reviewed': 'bg-primary'
        };
        var cls = statusMap[(status || '').toLowerCase()] || 'bg-secondary';
        return '<span class="badge ' + cls + '">' + (status || '—') + '</span>';
    }

    // Debug function for modal state
    window.debugModalState = function() {
        console.log('=== Modal State Debug ===');
        console.log('1. Submit button data-action:', $('#actionSubmitBtn').data('action'));
        console.log('2. Hidden input value (global):', $('#actionType').val());
        console.log('3. Modal-scoped input value:', $('#actionModal').find('#actionType').val());
        console.log('4. Elements with id="actionType":', document.querySelectorAll('#actionType').length);
        console.log('5. Request ID value:', $('#hiddenRequestId').val());
        console.log('6. Window._lastActionType:', window._lastActionType);
        console.log('========================');
    }

    // viewDetails: improved and robust for empty / redirect responses
    window.viewDetails = function (id) {
        if (!id) {
            appalert('Missing request identifier. Cannot load details.', 0, 1);
            return;
        }
        var url = '@Url.Action("InitializeData", "ChequeRequest")';

        // show loading inside modal body and show modal early (gives immediate feedback)
        $('#detailsModalBody').html('<div class="text-center text-muted py-4"><i class="mdi mdi-loading mdi-spin"></i> Loading…</div>');
        var modalEl = document.getElementById('detailsModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();

        // Request partial (server expects KEY, partialView, path)
        $.get(url, { KEY: id, partialView: '_RequestDetails', path: 'get' })
            .done(function (html) {
                if (!html || (typeof html === 'string' && html.trim().length === 0)) {
                    console.error('viewDetails: empty response for id', id);
                    $('#detailsModalBody').html('<div class="text-center text-danger py-3">No details were returned for this request.</div>');
                    appalert('No details were returned for this request.', 2, 1);
                    return;
                }
                // If server returned a full HTML page (e.g., login redirect), detect and show helpful msg
                var lowered = (html + '').toLowerCase();
                if (lowered.indexOf('<!doctype html') !== -1 || lowered.indexOf('<html') !== -1) {
                    console.error('viewDetails: server returned full page (possible redirect to login):', html);
                    $('#detailsModalBody').html('<div class="text-center text-danger py-3">Unable to load details. You may have been redirected to the login page or an error occurred. See console for details.</div>');
                    appalert('Unable to load details. You may have been redirected to the login page.', 0, 1);
                    return;
                }

                // Success: inject partial html
                $('#detailsModalBody').html(html);
            })
            .fail(function (jqXHR, textStatus, errorThrown) {
                console.error('viewDetails failed:', jqXHR.status, textStatus, errorThrown, jqXHR.responseText);
                var msg = 'Unable to load details.';
                if (jqXHR && jqXHR.responseJSON && xhr.responseJSON.message) {
                    msg = jqXHR.responseJSON.message;
                } else if (jqXHR.status === 500) {
                    msg = 'Internal server error occurred. Please try again.';
                } else if (jqXHR.status === 401) {
                    msg = 'Session expired. Please refresh the page and try again.';
                }
                $('#detailsModalBody').html('<div class="text-center text-danger py-3">' + msg + '</div>');
                appalert(msg, 0, 1);
            });
    };

    // Show Action Modal - Fixed version with multiple data storage
    window.showActionModal = function (action, requestId, customerName, customerId, currentStatus) {
        // Normalize action
        var normalizedAction = (action || 'Process').toString().toLowerCase();
        var displayAction = normalizedAction.charAt(0).toUpperCase() + normalizedAction.slice(1);

        // Set visible fields
        $('#actionModalTitle').text(displayAction + ' Request');
        $('#actionCustomerName').text(customerName || '-');
        $('#actionCustomerId').text(customerId || '-');
        $('#actionRequestIdDisplay').text(requestId || '-');
        $('#actionCurrentStatus').text(currentStatus || '-');

        // Update status badge
        var statusBadge = $('#actionCurrentStatus');
        statusBadge.removeClass('bg-warning bg-success bg-danger bg-info bg-primary');
        switch((currentStatus || '').toLowerCase()) {
            case 'pending': statusBadge.addClass('bg-warning text-dark'); break;
            case 'approved': statusBadge.addClass('bg-success'); break;
            case 'rejected': statusBadge.addClass('bg-danger'); break;
            case 'delivered': statusBadge.addClass('bg-info'); break;
            case 'reviewed': statusBadge.addClass('bg-primary'); break;
            default: statusBadge.addClass('bg-secondary'); break;
        }

        // MULTI-LAYERED DATA STORAGE (Fix for null actionType issue)

        // 1. Store in window variable (global fallback)
        window._lastActionType = normalizedAction;

        // 2. Store as data attribute on submit button (survives DOM manipulations)
        $('#actionSubmitBtn').data('action', normalizedAction);

        // 3. Set hidden form input value
        $('#actionModal').find('#actionType').val(normalizedAction);
        $('#actionType').val(normalizedAction); // Global selector as backup

        // 4. Set hidden request ID
        $('#hiddenRequestId').val(requestId || '');

        // 5. Set submit button text
        $('#submitButtonText').text(displayAction + ' Request');

        // Reset comment field
        $('#actionNote').val('').removeClass('is-invalid');

        // Debug logging (optional - remove in production)
        console.log('showActionModal called:', {
            action: action,
            normalized: normalizedAction,
            requestId: requestId,
            storedInButton: $('#actionSubmitBtn').data('action'),
            storedInWindow: window._lastActionType,
            storedInInput: $('#actionModal').find('#actionType').val()
        });

        // Show modal
        var modalEl = document.getElementById('actionModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    };

    // Submit Action Handler with Alertify Confirmation
    function submitAction() {
        var note = $('#actionNote').val() ? $('#actionNote').val().trim() : '';
        if (!note || note.length < 10) {
            $('#actionNote').addClass('is-invalid');
            $('#actionNote').get(0).scrollIntoView({ behavior: 'smooth', block: 'center' });
            appalert('Please provide a detailed note with at least 10 characters.', 3, 1);
            return;
        }

        // MULTI-LAYERED ACTION TYPE RETRIEVAL (Fix for null actionType issue)
        var actionType =
            $('#actionSubmitBtn').data('action') ||                          // Primary: data attribute (survives DOM moves)
            $('#actionModal').find('#actionType').val() ||                   // Secondary: modal-scoped selector
            $('#actionType').val() ||                                        // Tertiary: global selector
            window._lastActionType;                                          // Fallback: window variable

        var requestId = $('#hiddenRequestId').val();
        var customerName = $('#actionCustomerName').text();
        var currentStatus = $('#actionCurrentStatus').text();

        // Debug validation
        console.log('submitAction - actionType sources:', {
            buttonData: $('#actionSubmitBtn').data('action'),
            modalScoped: $('#actionModal').find('#actionType').val(),
            global: $('#actionType').val(),
            windowVar: window._lastActionType,
            final: actionType
        });

        if (!actionType) {
            console.error('submitAction: No action type found! DOM state:', {
                button: $('#actionSubmitBtn').length,
                modalInput: $('#actionModal').find('#actionType').length,
                globalInput: $('#actionType').length
            });
            appalert('Internal error: Action type not found. Please refresh and try again.', 0, 1);
            return;
        }

        if (!requestId) {
            appalert('Missing request identifier. Cannot proceed.', 0, 1);
            return;
        }

        // Build confirmation message
        var actionDisplay = actionType.charAt(0).toUpperCase() + actionType.slice(1);
        var confirmationMessage = `
            <div class="alert alert-warning mb-3">
                <strong>Please confirm this action:</strong>
            </div>
            <div class="mb-2"><strong>Action:</strong> ${actionDisplay}</div>
            <div class="mb-2"><strong>Request ID:</strong> ${requestId}</div>
            <div class="mb-2"><strong>Customer:</strong> ${customerName}</div>
            <div class="mb-2"><strong>Current Status:</strong> ${currentStatus}</div>
            <div class="mb-2"><strong>Note:</strong> ${note}</div>
            <div class="alert alert-info mt-3">
                <small><i class="mdi mdi-information-outline me-1"></i> This action cannot be undone.</small>
            </div>
        `;

        // Show alertify confirmation
        alertify.confirm(
            'Confirm Action',
            confirmationMessage,
            function () {
                // OK callback - proceed with AJAX submission
                performActionSubmission(requestId, note, actionType);
            },
            function () {
                // Cancel callback
                appalert('Action cancelled.', 2, 1);
            }
        ).set('labels', { ok: 'Yes, Proceed', cancel: 'No, Cancel' });
    }

    // Perform the actual AJAX submission
    function performActionSubmission(requestId, note, actionType) {

        // Show loading state on the submit button
        var submitBtn = $('#actionSubmitBtn');
        var originalHtml = submitBtn.html();
        submitBtn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Processing...');

        // Build payload matching your Approval model
        var payload = {
            id: requestId,
            approvalNote: note,
            action: actionType
        };

        var token = $('#actionForm input[name="__RequestVerificationToken"]').val();

        // IMPORTANT: Pass the action type as a query parameter
        var url = '@Url.Action("TakeAction", "ChequeRequest")?action=' + encodeURIComponent(actionType);

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            headers: token ? { 'RequestVerificationToken': token } : {},
            success: function (res) {
                // Re-enable button
                submitBtn.prop('disabled', false).html(originalHtml);

                // Hide modal
                var modalEl = document.getElementById('actionModal');
                var modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                }

                // Reload datatable
                if ($.fn.DataTable.isDataTable('#myDataTable')) {
                    $('#myDataTable').DataTable().ajax.reload(null, false);
                }

                // Show success message
                if (res && res.success) {
                    appalert(res.message || 'Action completed successfully!', 1, 1);
                } else {
                    appalert(res.message || 'Action completed with warnings.', 2, 1);
                }
            },
            error: function (xhr) {
                // Re-enable button
                submitBtn.prop('disabled', false).html(originalHtml);

                console.error('Action submission failed', xhr);
                var msg = 'Error performing action.';
                if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                    msg = xhr.responseJSON.message;
                } else if (xhr.status === 500) {
                    msg = 'Internal server error occurred. Please try again.';
                } else if (xhr.status === 401) {
                    msg = 'Session expired. Please refresh the page and try again.';
                }
                appalert(msg, 4, 1);
            },
            complete: function () {
                // Ensure button is re-enabled in case of any issues
                submitBtn.prop('disabled', false).html(originalHtml);
            }
        });
    }

    // Setup action submit handler
    function setupActionSubmitHandler() {
        $('#actionSubmitBtn').off('click').on('click', function (e) {
            e.preventDefault();
            submitAction();
        });
    }

    function updateTableInfo() {
        if ($.fn.DataTable.isDataTable('#myDataTable')) {
            var table = $('#myDataTable').DataTable();
            var info = table.page.info();
            if ($('#tableInfo').length) {
                $('#tableInfo').text('Showing ' + (info.start + 1) + ' to ' + info.end + ' of ' + info.recordsTotal + ' entries');
            }
        }
    }

    function resetFilters() {
        $('#CustomerId').val('');
        $('#CategoryId').val('');
        $('#Status').val('');
        $('#BranchId').val('');
        $('#BankId').val('');
        $('#ApprovalDate').val('');
        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#NotifyOnApproval').prop('checked', false);
        $('#NotifyOnClearance').prop('checked', false);
        $('#NotifyOnRejection').prop('checked', false);
        $('#NotifyOnPayment').prop('checked', false);
        $('#NotifyOnAnyTransaction').prop('checked', false);
        $('#AutomaticRenewal').prop('checked', false);

        $('input.form-check-input[type=checkbox]').prop('checked', false);
        $('#customerFilterSection, #categoryFilterSection, #statusFilterSection, #dateFilterSection, #approvalDateFilterSection, #branchFilterSection, #bankFilterSection, #notifyFilterSection').hide();
    }

    // Toggle filter sections
    function toggleFilterSection(checkboxId, sectionId) {
        const checkbox = document.getElementById(checkboxId);
        const section = document.getElementById(sectionId);

        if (checkbox && section) {
            // Set initial state
            section.style.display = checkbox.checked ? 'block' : 'none';

            // Add change event listener
            checkbox.addEventListener('change', function () {
                section.style.display = this.checked ? 'block' : 'none';
            });
        }
    }

    // Initialize everything
    function initializeDataTable() {
        // Initialize filter toggles
        toggleFilterSection('byCustomerToggle', 'customerFilterSection');
        toggleFilterSection('byCategoryToggle', 'categoryFilterSection');
        toggleFilterSection('byStatusToggle', 'statusFilterSection');
        toggleFilterSection('byBranchToggle', 'branchFilterSection');
        toggleFilterSection('byApprovalDateToggle', 'approvalDateFilterSection');
        toggleFilterSection('byNotifyToggle', 'notifyFilterSection');
        toggleFilterSection('byDateToggle', 'dateFilterSection');

        // Setup event handlers
        $('#applyFilterBtn').on('click', function (e) {
            e.preventDefault();
            loadChequeData();
        });

        $('#resetFilterBtn').on('click', function (e) {
            e.preventDefault();
            resetFilters();
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                $('#myDataTable').DataTable().clear().draw();
            }
        });

        // Setup modal event listeners
        $('#actionModal').on('hidden.bs.modal', function () {
            // Clear data on modal close
            $('#actionSubmitBtn').removeData('action');
            window._lastActionType = '';
            $('#actionNote').val('').removeClass('is-invalid');
        });

        $('#actionModal').on('show.bs.modal', function () {
            // Ensure clean state when modal opens
            $('#actionNote').removeClass('is-invalid');
        });

        // Setup action submit handler
        setupActionSubmitHandler();

        // Load initial data
       // loadChequeData();
    }

    // Initialize when document is ready
    $(document).ready(function () {
        try {
            initializeDataTable();
        } catch (error) {
            console.error('Error initializing DataTable:', error);
            appalert('Error loading data table: ' + error.message, 0, 1);
        }
    });

})();
</script>