<!-- Partial Views/_ChequeRequestForm.cshtml -->
@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeRequest.ChequeBookRequest
@using Resources 
<div class="card shadow p-3 mb-4">
    @using (Html.BeginForm("CreateOrUpdate", "ChequeRequest", FormMethod.Post, new
    {
        id = "chequeRequestForm",
        onsubmit = "return AjaxPostAndUpdate(this);"
    }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.customerId, new { id = "formCustomerId" })
        @Html.HiddenFor(m => m.customerName, new { id = "formCustomerName" })

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-primary mb-0">
                <i class="mdi mdi-plus-circle-outline me-2"></i>
                <span id="formTitle">Create Cheque Book Request</span>
            </h5>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="backToSearchBtn">
                <i class="mdi mdi-arrow-left me-1"></i> Back to Search
            </button>
        </div>

        <div class="col-12">
            <h6 class="text-primary border-bottom pb-1 mb-3">
                <i class="mdi mdi-credit-card-outline me-1"></i> Branch Info
            </h6>
        </div>

        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.branchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
            @Html.ValidationMessageFor(m => m.branchId, "", new { @class = "text-danger" })

            <label>@GlobalUserManagement.Branch</label>
        </div>

        <div class="col-12">
            <h6 class="text-primary border-bottom pb-1 mb-3">
                <i class="mdi mdi-credit-card-outline me-1"></i> Customer Name and reference
            </h6>
        </div>

        <!-- Customer Summary -->
        <div class="alert alert-info py-2 mb-4">
            <i class="mdi mdi-account-outline me-2"></i>
            <strong id="formCustomerSummary">Customer will appear here</strong>
        </div>

        <div class="row g-3">
            <!-- Cheque Book Details -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="mdi mdi-credit-card-outline me-1"></i> Cheque Book Details
                </h6>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Cheque Book Category</label>
                @Html.DropDownListFor(m => m.categoryId, new SelectList(ViewBag.Categories, "Id", "name"),
                    "Select Category", new { @class = "form-control select2", required = "required" })
                @Html.ValidationMessageFor(m => m.categoryId)
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Account for Cheque Book(To be linked with check leave)</label>
                @Html.DropDownListFor(m => m.checkBookAccount, new SelectList(Enumerable.Empty<SelectListItem>()),
                    "Select Account", new { @class = "form-control", id = "checkBookAccountDropdown", required = "required" })
                @Html.ValidationMessageFor(m => m.checkBookAccount)
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Account for Fees(To pay for fees)</label>
                @Html.DropDownListFor(m => m.subscriptionPaymentAccountId, new SelectList(Enumerable.Empty<SelectListItem>()),
                    "Select Account", new { @class = "form-control", id = "subscriptionPaymentAccountDropdown", required = "required" })
                @Html.ValidationMessageFor(m => m.subscriptionPaymentAccountId)
            </div>

            <div class="col-12">
                <label class="form-label">Request Note</label>
                @Html.TextAreaFor(m => m.requestNote, new { @class = "form-control", rows = "3", placeholder = "Optional notes..." })
            </div>

            <!-- Notification Options - Side by Side Layout -->
            <div class="col-12 mt-4">
                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="mdi mdi-bell-ring-outline me-1"></i> Notification Options
                </h6>

                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.notifyOnApproval, new { @class = "form-check-input", id = "NotifyOnApproval" })
                            <label class="form-check-label fw-medium" for="NotifyOnApproval">
                                <i class="mdi mdi-check-circle-outline me-1 text-success"></i>Notify on Approval
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.notifyOnRejection, new { @class = "form-check-input", id = "NotifyOnRejection" })
                            <label class="form-check-label fw-medium" for="NotifyOnRejection">
                                <i class="mdi mdi-close-circle-outline me-1 text-danger"></i>Notify on Rejection
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.notifyOnClearance, new { @class = "form-check-input", id = "NotifyOnClearance" })
                            <label class="form-check-label fw-medium" for="NotifyOnClearance">
                                <i class="mdi mdi-shield-check-outline me-1 text-info"></i>Notify on Cheque Clearance
                            </label>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.notifyOnPayment, new { @class = "form-check-input", id = "NotifyOnPayment" })
                            <label class="form-check-label fw-medium" for="NotifyOnPayment">
                                <i class="mdi mdi-cash-check me-1 text-warning"></i>Notify on Fee Payment
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.notifyOnAnyTransaction, new { @class = "form-check-input", id = "NotifyOnAnyTransaction" })
                            <label class="form-check-label fw-medium" for="NotifyOnAnyTransaction">
                                <i class="mdi mdi-alert-circle-outline me-1 text-primary"></i>Notify on Any Transaction
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.automticRenewal, new { @class = "form-check-input", id = "AutomticRenewal" })
                            <label class="form-check-label fw-medium" for="AutomticRenewal">
                                <i class="mdi mdi-autorenew me-1 text-success"></i>Automatic Renewal
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Help Text -->
                <div class="alert alert-light mt-3">
                    <small class="text-muted">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Notification preferences will be applied to both the customer and relevant staff members.
                        Automatic renewal will process cheque book requests automatically upon expiration.
                    </small>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="col-12 text-end mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="mdi mdi-send-check-outline me-1"></i>
                    <span id="submitButtonText">Submit Request</span>
                </button>
                <button type="button" class="btn btn-outline-secondary px-4" onclick="window.formManager.resetForm()">
                    <i class="mdi mdi-close me-1"></i>Cancel
                </button>
            </div>
        </div>
    }
</div>