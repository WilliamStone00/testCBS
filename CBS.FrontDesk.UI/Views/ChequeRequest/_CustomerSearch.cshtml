<!-- Views/ChequeRequest/_CustomerSearch.cshtml -->
<div class="fieldset-custom">
    <div class="row g-3">
        <h6 class="text-primary">
            <i class="mdi mdi-account-search-outline me-2"></i> Customer Search
        </h6>

        <div class="col-md-12">
            <label class="form-label fw-bold">Member Reference</label>
            <div class="input-group">
                <input type="text" id="customerIdInput" class="form-control" placeholder="Enter Member Reference">
                <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                    <i class="mdi mdi-magnify"></i> Search
                </button>
            </div>
            <small class="text-muted">Enter Member Reference and press Search. The request form will appear automatically below.</small>
        </div>
    </div>

    <!-- Request Form will be loaded here automatically after successful search -->
    <div id="requestFormSection" class="mt-4" style="display: none;">
        <!-- Form loads here automatically -->
    </div>
</div>