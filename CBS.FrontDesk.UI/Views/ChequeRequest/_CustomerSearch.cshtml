<!-- Partial Views/_CustomerSearch.cshtml -->
<div class="fieldset-custom">
    <legend class="text-primary">
        <i class="mdi mdi-account-search-outline me-2"></i> Customer Search
    </legend>

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-bold">Branch</label>
            @Html.DropDownList("searchBranchId", new SelectList(ViewBag.Branches, "Id", "name"),
                "Select Branch", new { @class = "form-control select2", id = "searchBranchId" })
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Customer ID</label>
            <div class="input-group">
                <input type="text" id="customerIdInput" class="form-control" placeholder="Enter Customer ID" value="003DCT0001">
                <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                    <i class="mdi mdi-magnify"></i> Search
                </button>
            </div>
        </div>
    </div>

    <!-- Customer Details Display (Initially Hidden) -->
    <div id="customerDetailsCard" class="mt-3" style="display: none;">
        <div class="card bg-light">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 id="customerSummary" class="mb-0"></h6>
                        <small id="accountSummary" class="text-muted"></small>
                    </div>
                    <button type="button" class="btn btn-success btn-sm" id="proceedToRequestBtn">
                        <i class="mdi mdi-arrow-right"></i> Proceed to Request
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>