@model CBS.FrontDesk.Data.Entity.SavingProducts.OpeningOfTheDay
    @using Resources
@{
    ViewBag.Title = "OPEN OF DAY P.T.";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalOpenningOfDay.OpeningOfMainTill
                </h1>
                <p class="card-text text-muted">
                    @GlobalOpenningOfDay.ManageTheOpeningProcessOfTheMainTillEfficiently.
                </p>
                <p class="card-text text-danger fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    @GlobalOpenningOfDay.PleaseNoteTheMainTillMustBeOpenedBeforeAnySubTillsCanBeOpened.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalOpenningOfDay.HELP_TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                @GlobalOpenningOfDay.TheMainTillServesAsTheMainControlTillForSubTillsFollowTheseTips:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalOpenningOfDay.EnsureAllDenominationsAreAccuratelyEntered.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalOpenningOfDay.VerifyThatTotalsMatchTheExpectedAmountsForSubTillOperations.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> @GlobalOpenningOfDay.IfThe <strong>@GlobalOpenningOfDay.OpenOfDayButtonIsGreyedOut</strong>, @GlobalOpenningOfDay.itIndicatesMismatchedValuesOrMissingInformation.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalOpenningOfDay.TheMainTillDoesNotDirectlyInteract.</li>
            </ul>
            <p class="text-muted">@GlobalOpenningOfDay.ForExample:</p>
            <ul class="list-unstyled">
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalOpenningOfDay.IfYouHave3NotesOfN10000Enter3.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalOpenningOfDay.TheSystemWillAutomaticallyCalculateTheTotal.</li>
            </ul>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            @GlobalOpenningOfDay.PrimaryTillOpening
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_OpenOfDayForm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("OpenningOfDay", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
