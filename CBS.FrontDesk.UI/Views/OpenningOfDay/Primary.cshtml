@model CBS.FrontDesk.Data.Entity.SavingProducts.OpeningOfTheDay
@{
    ViewBag.Title = "OPEN OF DAY P.T.";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> Opening of Primary Till
                </h1>
                <p class="card-text text-muted">
                    Manage the opening process of the primary till efficiently. Ensure all details are accurate for a smooth operation.
                </p>
                <p class="card-text text-danger fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    Please note: The primary till must be opened before any sub-tills can be opened. The primary till does not perform cash operations with members.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                The primary till serves as the main control till for sub-tills. Follow these tips:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure all denominations are accurately entered.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Verify that totals match the expected amounts for sub-till operations.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> If the <strong>Open of Day button is greyed out</strong>, it indicates mismatched values or missing information.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> The primary till does not directly interact with members for cash operations.</li>
            </ul>
            <p class="text-muted">For example:</p>
            <ul class="list-unstyled">
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> If you have 3 notes of N10,000, enter "3" under the N10,000 field.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> The system will automatically calculate the total for all denominations.</li>
            </ul>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            Primary Till Opening
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_OpenOfDayForm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("OpenningOfDay", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
