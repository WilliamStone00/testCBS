@model CBS.FrontDesk.Data.Entity.RequestManagement.IdleTime
@using Resources
@{
    ViewBag.Title = "Update Idle Timeout & Password Policy";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-key-outline me-2"></i> @GlobalPasswordPolicyManagement.update_idle_timeout_password_policy
                </h1>
                <p class="card-text">
                    @GlobalPasswordPolicyManagement.you_are_updating_the_configuration_for_either.
                    <br />
                    @GlobalPasswordPolicyManagement.use_this_interface_to_define_rules_for_user_inactivity.
                    <br />
                    @GlobalPasswordPolicyManagement.settings_include_lockout_thresholds.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>


<!-- Tips Section -->
@Html.Partial("_PolicyTips")

<!-- Create Button Outside Header -->
<div class="d-flex justify-content-end mb-2">
    <a href="/PasswordPolicyManagement" class="btn btn-sm btn-outline-primary me-2">
        <i class="mdi mdi-plus"></i> @GlobalShared.create_new_policy
    </a>
    <a type="button" onclick="LoadDataGen('PasswordPolicyManagement','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="@GlobalShared.view_existing_configs">
        <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
    </a>
</div>

<!-- Main Configuration Form -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div class="card-body" id="datalistingview">
                @Html.Partial("_Create", Model)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.14/ace.js" crossorigin="anonymous"></script>

    <script>
        let editor; // ACE Editor instance

        function initializeJsonEditor() {
            const editorContainer = document.getElementById("jsonEditor");
            const hiddenInput = document.getElementById("PasswordPoliciesJson");
            const errorBox = document.getElementById("jsonError");

            if (!editorContainer || !hiddenInput) {
                console.warn("⚠️ JSON Editor or hidden input not found in DOM.");
                return;
            }

            editor = ace.edit(editorContainer);
            editor.setTheme("ace/theme/github");
            editor.session.setMode("ace/mode/json");
            editor.setOptions({
                maxLines: Infinity,
                minLines: 20,
                fontSize: "13px",
                wrap: true,
                autoScrollEditorIntoView: true,
                readOnly: false
            });

            try {
                const parsed = JSON.parse(hiddenInput.value || "{}");
                editor.setValue(JSON.stringify(parsed, null, 4), -1);
            } catch {
                editor.setValue("{}", -1);
            }

            editor.session.on("change", () => {
                hiddenInput.value = editor.getValue();
                if (errorBox) errorBox.classList.add("d-none");
            });

            document.querySelector("form")?.addEventListener("submit", function (e) {
                try {
                    JSON.parse(editor.getValue());
                    hiddenInput.value = editor.getValue();
                } catch (err) {
                    e.preventDefault();
                    if (errorBox) {
                        errorBox.textContent = `❌ Invalid JSON: ${err.message}`;
                        errorBox.classList.remove("d-none");
                    }
                }
            });
        }

        function toggleBranchSection(isCentral) {
            const branchSection = document.getElementById("branchSection");

            if (branchSection) {
                if (isCentral) {
                    branchSection.style.display = "none";
                    $("#BranchId").val(null).trigger('change');
                } else {
                    branchSection.style.display = "flex";
                }
            }
        }

        $(document).ready(() => {
            toggleBranchSection($('#IsCentralCheckbox').is(':checked'));

            if (document.getElementById("jsonEditor")) {
                initializeJsonEditor();
            }
        });
    </script>
}
