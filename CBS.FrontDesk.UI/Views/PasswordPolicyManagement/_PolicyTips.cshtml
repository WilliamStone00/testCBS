<!-- Tips Section -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Password Policy & Idle Timeout Guidelines</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="true" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-account-clock-outline text-info me-2"></i>
                    <strong>IdleDuration</strong>: Time (in minutes) a user session can remain inactive before automatic logout.
                    <span class="text-muted">Recommended: <code>15</code> minutes</span>
                </li>

                <li>
                    <i class="mdi mdi-login-variant text-danger me-2"></i>
                    <strong>NumberOfLoginAttempts</strong>: Maximum failed login attempts before account lockout is triggered.
                    <span class="text-muted">Recommended: <code>5</code> attempts</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-reset text-warning me-2"></i>
                    <strong>NumberOfDaysRequiredToResetPassword</strong>: Minimum number of days required before a user can reset their password again.
                    <span class="text-muted">Recommended: <code>1</code> day</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-remove text-warning me-2"></i>
                    <strong>NumberOfDaysToBlockUserIfInactive</strong>: Number of days of inactivity after which a user account will be automatically disabled.
                    <span class="text-muted">Recommended: <code>90</code> days</span>
                </li>

                <li>
                    <i class="mdi mdi-shield-key-outline text-success me-2"></i>
                    <strong>PasswordPolicies</strong>: JSON-formatted set of rules governing password structure, rotation, reuse, and security.
                    <span class="text-muted">Examples: <code>MinLength</code>, <code>RequireDigit</code>, <code>EnableMFA</code></span>
                </li>

                <li>
                    <i class="mdi mdi-numeric text-primary me-2"></i>
                    <strong>MinLength & MaxLength</strong>: Enforces minimum and maximum number of characters in passwords.
                    <span class="text-muted">Typically: <code>8–128</code></span>
                </li>

                <li>
                    <i class="mdi mdi-alphabet-aurebesh text-info me-2"></i>
                    <strong>RequireUppercase, Lowercase, Digit, SpecialChar</strong>: Defines character composition requirements to increase password complexity.
                    <span class="text-muted">Enables protection against brute-force attacks.</span>
                </li>

                <li>
                    <i class="mdi mdi-text-box-check-outline text-danger me-2"></i>
                    <strong>DisallowUsernameInPassword</strong>: Prevents use of username as part of the password for added security.
                </li>

                <li>
                    <i class="mdi mdi-history text-warning me-2"></i>
                    <strong>PasswordHistoryCount</strong>: Number of previous passwords retained to avoid reuse.
                    <span class="text-muted">Helps prevent cycling through weak passwords.</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-clock text-primary me-2"></i>
                    <strong>MaxPasswordAgeDays / MinPasswordAgeDays</strong>: Controls password expiration and minimum hold duration.
                    <span class="text-muted">Promotes timely rotation and avoids abuse of frequent resets.</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-alert-outline text-danger me-2"></i>
                    <strong>LockoutThreshold, Duration, ResetInterval</strong>: Defines rules for account lockout handling based on repeated login failures.
                    <span class="text-muted">Example: Lock for 15 minutes after 5 failed attempts.</span>
                </li>

                <li>
                    <i class="mdi mdi-security text-primary me-2"></i>
                    <strong>EnableMFA (Multi-Factor Authentication)</strong>: Activates additional authentication beyond password (e.g. Email, SMS, TOTP).
                    <span class="text-muted">Greatly reduces risks from credential theft.</span>
                </li>

                <li>
                    <i class="mdi mdi-clock-fast text-info me-2"></i>
                    <strong>MFAEnforcementGraceDays</strong>: Delay period before MFA becomes mandatory for new users.
                    <span class="text-muted">Recommended: <code>3</code> days</span>
                </li>

                <li>
                    <i class="mdi mdi-filter-outline text-info me-2"></i>
                    <strong>DisallowedSubstrings</strong>: Patterns or keywords that must not appear in passwords.
                    <span class="text-muted">Example: <code>password, admin, 1234</code></span>
                </li>

                <li>
                    <i class="mdi mdi-code-tags-check text-warning me-2"></i>
                    <strong>RegexPatternValidation</strong>: Optional regular expression to enforce additional formatting logic.
                </li>

                <li>
                    <i class="mdi mdi-shield-account text-primary me-2"></i>
                    <strong>AllowAdminReset</strong>: Allows admin accounts to reset passwords on behalf of users.
                </li>

                <li>
                    <i class="mdi mdi-history-off text-muted me-2"></i>
                    <strong>AdminResetBypassHistory</strong>: Determines whether admin-initiated resets bypass password reuse checks.
                    <span class="text-muted">Default: <code>false</code></span>
                </li>

                <li>
                    <i class="mdi mdi-office-building-outline text-secondary me-2"></i>
                    <strong>Scope: Central or Branch-Level</strong>:
                    Set <code>IsCentral = true</code> to apply the policy globally across the system.
                    If <code>IsCentral = false</code>, you must select a specific branch from the dropdown list using
                    <code>BranchCode</code> and <code>BranchName</code>.
                    <br />
                    <span class="text-muted">Only one policy can exist per scope (central or per branch).</span>
                </li>

                <li class="mt-3">
                    <i class="mdi mdi-check-bold text-primary me-2"></i>
                    <strong>✅ Good Password Example:</strong><br />
                    <code class="text-primary"><strong>N3xt!Gen_S3cur3#</strong></code><br />
                    <small class="text-muted">Meets all policy rules: length, digits, uppercase/lowercase, special characters, no username or weak patterns.</small>
                </li>
                <li class="mt-2">
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                    <strong>❌ Bad Password Example:</strong><br />
                    <code class="text-danger"><string>password123</string></code><br />
                    <small class="text-muted">Fails complexity rules: uses disallowed keywords, lacks uppercase and special characters, predictable structure.</small>
                </li>
            </ul>
        </div>

        <!-- Default Configuration Display -->
        <div class="alert alert-secondary mt-3">
            <strong class="mb-2 d-block">🔐 Default Password Policy Configuration (Excludes Form-Controlled Fields):</strong>

            <div class="table-responsive">
                <table class="table table-bordered table-sm table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Policy Key</th>
                            <th>Default Value</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>1</td><td>MinLength</td><td>8</td><td>Minimum number of characters required in a password.</td></tr>
                        <tr><td>2</td><td>MaxLength</td><td>128</td><td>Maximum number of characters allowed in a password.</td></tr>
                        <tr><td>3</td><td>RequireUppercase</td><td>true</td><td>At least one uppercase letter (A–Z) must be present in the password.</td></tr>
                        <tr><td>4</td><td>RequireLowercase</td><td>true</td><td>At least one lowercase letter (a–z) must be present in the password.</td></tr>
                        <tr><td>5</td><td>RequireDigit</td><td>true</td><td>At least one numeric digit (0–9) must be present in the password.</td></tr>
                        <tr><td>6</td><td>RequireSpecialChar</td><td>true</td><td>At least one special character from the allowed list must be present.</td></tr>
                        <tr><td>7</td><td>AllowedSpecialChars</td><td>!@@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?</td><td>Set of permitted special characters.</td></tr>
                        <tr><td>8</td><td>DisallowUsernameInPassword</td><td>true</td><td>Restricts passwords from containing the username (case-insensitive match).</td></tr>
                        <tr><td>9</td><td>PasswordHistoryCount</td><td>5</td><td>How many previous passwords are remembered to avoid reuse.</td></tr>
                        <tr><td>10</td><td>DisallowPreviousPasswords</td><td>true</td><td>Prevents the reuse of past passwords within the history count.</td></tr>
                        <tr><td>11</td><td>EnableMFA</td><td>true</td><td>Enables Multi-Factor Authentication for additional login security.</td></tr>
                        <tr><td>12</td><td>MFATypesAllowed</td><td>SMS, EMAIL, TOTP</td><td>Accepted MFA types: SMS (Short Message Service), Email, and Time-based One-Time Password.</td></tr>
                        <tr><td>13</td><td>MFAEnforcementGraceDays</td><td>3</td><td>Grace period before MFA becomes mandatory for users after account creation.</td></tr>
                        <tr>
                            <td>14</td>
                            <td>DisallowedSubstrings</td>
                            <td>password, admin, login, 1234, qwerty, abcd, root, test, guest, access, letmein, welcome, secret, iloveyou, trustno1, dragon, 2020, 2021, 0000</td>
                            <td>Rejects common weak keywords and phrases often exploited in brute-force and dictionary attacks.</td>
                        </tr>
                        <tr>
                            <td>15</td>
                            <td>RegexPatternValidation</td>
                            <td>^(?!.*(.)\1{2,})(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@#$%^&+=!?]).{12,128}$</td>
                            <td>
                                Enforces strong passwords:
                                <ul class="mb-0 ps-3">
                                    <li>12–128 characters long</li>
                                    <li>At least 1 uppercase, 1 lowercase, 1 digit, and 1 special character</li>
                                    <li>Rejects passwords with 3 or more consecutive repeated characters (e.g., aaa, 111)</li>
                                </ul>
                            </td>
                        </tr>
                        <tr><td>16</td><td>RejectSerialPatterns</td><td>true</td><td>Blocks passwords that contain simple numeric sequences like <code>123456</code>, <code>0000</code>, <code>987654</code>, or similar serial-like structures.</td></tr>
                        <tr><td>17</td><td>AllowAdminReset</td><td>true</td><td>Permits administrators to reset user passwords if needed.</td></tr>
                        <tr><td>18</td><td>AdminResetBypassHistory</td><td>false</td><td>Determines whether admin resets bypass password reuse history checks. If false, admins must follow reuse restrictions.</td></tr>
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>




<!-- Configuration Notice -->
<div class="alert alert-info mt-3 mb-2">
    <strong>Notice:</strong> Only <u>one configuration per branch</u> is allowed. For centralized control, enable the <code>IsCentral</code> flag.<br />
    New configuration entries will be rejected if one already exists for the same scope.
</div>
