<!-- Tips Section -->
@using Resources
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalPasswordPolicyManagement.password_policy_idle_timeout_guidelines</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="true" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-account-clock-outline text-info me-2"></i>
                    <strong>@GlobalShared.idle_duration</strong>: @GlobalPasswordPolicyManagement.time_auser_session_can_remain_inactive_before_automatic_logout.
                    <span class="text-muted">@GlobalShared.Recommended: <code>15</code> minutes</span>
                </li>

                <li>
                    <i class="mdi mdi-login-variant text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.number_of_login_attempts</strong>: @GlobalPasswordPolicyManagement.maximum_failed_login_attempts_before_account_lockout_is_triggered.
                <span class="text-muted">@GlobalShared.Recommended: <code>5</code> @GlobalShared.Attempts</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-reset text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.number_of_days_required_to_reset_password</strong>: @GlobalPasswordPolicyManagement.minimum_number_of_days_required_before_auser_can_reset_their_password_again.
                    <span class="text-muted">@GlobalShared.Recommended: <code>1</code> @GlobalShared.Day</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-remove text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.number_of_days_to_block_user_if_inactive</strong>: @GlobalPasswordPolicyManagement.number_of_days_of_inactivity_after_which_auser_account_will_be_automatically_disabled.
                    <span class="text-muted">@GlobalShared.Recommended: <code>90</code> @GlobalShared.Days</span>
                </li>

                <li>
                    <i class="mdi mdi-shield-key-outline text-success me-2"></i>
                    <strong>@GlobalShared.password_policies</strong>: @GlobalPasswordPolicyManagement.jsonformatted_set_of_rules_governing_password_structure.
                    <span class="text-muted">Examples: <code>@GlobalShared.min_length</code>, <code>@GlobalShared.require_digit</code>, <code>@GlobalPasswordPolicyManagement.enable_mfa</code></span>
                </li>

                <li>
                    <i class="mdi mdi-numeric text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.min_length_max_length</strong>: @GlobalPasswordPolicyManagement.enforces_minimum_and_maximum_number_of_characters_in_passwords.
                    <span class="text-muted">@GlobalShared.typically: <code>8–128</code></span>
                </li>

                <li>
                    <i class="mdi mdi-alphabet-aurebesh text-info me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.require_uppercase_lowercase_digit_special_char</strong>: @GlobalPasswordPolicyManagement.defines_character_composition_requirements_to_increase_password_complexity.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.enables_protection_against_brute_force_attacks.</span>
                </li>

                <li>
                    <i class="mdi mdi-text-box-check-outline text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.disallow_username_in_password</strong>: @GlobalPasswordPolicyManagement.prevents_use_of_username_as_part_of_the_password_for_added_security.
                </li>

                <li>
                    <i class="mdi mdi-history text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.password_history_count</strong>: @GlobalPasswordPolicyManagement.number_of_previous_passwords_retained_to_avoid_reuse.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.helps_prevent_cycling_through_weak_passwords.</span>
                </li>

                <li>
                    <i class="mdi mdi-calendar-clock text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.max_password_age_days_min_password_age_days</strong>: @GlobalPasswordPolicyManagement.controls_password_expiration_and_minimum_hold_duration.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.promotes_timely_rotation_and_avoids_abuse_of_frequent_resets.</span>
                </li>

                <li>
                    <i class="mdi mdi-lock-alert-outline text-danger me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.lockout_threshold_duration_resetnterval</strong>: @GlobalPasswordPolicyManagement.defines_rules_for_account_lockout_handling_bon_repeated_login_failures.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.example_lock_for15_minutes_after5_failed_attempts.</span>
                </li>

                <li>
                    <i class="mdi mdi-security text-primary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.enable_mfa</strong>: @GlobalPasswordPolicyManagement.activates_additional_authentication_beyond_password.
                    <span class="text-muted">@GlobalPasswordPolicyManagement.greatl_reduces_risks_from_credential_theft.</span>
                </li>

                <li>
                    <i class="mdi mdi-clock-fast text-info me-2"></i>
                    <strong>MFAEnforcementGraceDays</strong>: @GlobalPasswordPolicyManagement.delay_period_before_mfabecomes_mandatory_for_new_users.
                    <span class="text-muted">@GlobalShared.Recommended: <code>3</code> @GlobalShared.Days</span>
                </li>

                <li>
                    <i class="mdi mdi-filter-outline text-info me-2"></i>
                    <strong>@GlobalShared.disallowed_substrings</strong>: @GlobalPasswordPolicyManagement.patterns_or_keywords_that_must_not_appear_in_passwords.
                    <span class="text-muted">@GlobalShared.Example: <code>@GlobalShared.Password, admin, 1234</code></span>
                </li>

                <li>
                    <i class="mdi mdi-code-tags-check text-warning me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.regex_pattern_validation</strong>: @GlobalPasswordPolicyManagement.optional_regular_expression_to_enforce_additional_formatting_logic.
                </li>

                <li>
                    <i class="mdi mdi-shield-account text-primary me-2"></i>
                    <strong>@GlobalShared.allow_admin_reset</strong>: @GlobalPasswordPolicyManagement.allows_admin_accounts_to_reset_passwords_on_behalf_of_users.
                </li>

                <li>
                    <i class="mdi mdi-history-off text-muted me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.admin_reset_bypass_history</strong>: @GlobalPasswordPolicyManagement.determines_whether_admin_initiated_resets_bypass_password_reuse_checks.
                    <span class="text-muted">@GlobalShared.Default: <code>@GlobalShared._false</code></span>
                </li>

                <li>
                    <i class="mdi mdi-office-building-outline text-secondary me-2"></i>
                    <strong>@GlobalPasswordPolicyManagement.scope_central_or_branch_level</strong>:
                    @GlobalShared.set <code>IsCentral = true</code> @GlobalPasswordPolicyManagement.to_apply_the_policy_globally_across_the_system.
                    @GlobalPasswordPolicyManagement._if <code>IsCentral = false</code>, @GlobalPasswordPolicyManagement.you_must_select_aspecific_branch_from_the_dropdown_list_using
                    <code>@GlobalShared.Branch_Code</code> @GlobalShared.and <code>@GlobalShared.Branch_Name</code>.
                    <br />
                    <span class="text-muted">@GlobalPasswordPolicyManagement.only_one_policy_can_exist_per_scope_central_or_per_branch.</span>
                </li>

                <li class="mt-3">
                    <i class="mdi mdi-check-bold text-primary me-2"></i>
                    <strong>✅ @GlobalPasswordPolicyManagement.good_password_example:</strong><br />
                    <code class="text-primary"><strong>N3xt!Gen_S3cur3#</strong></code><br />
                    <small class="text-muted">@GlobalPasswordPolicyManagement.meets_all_policy_rules_length_digits_uppercase_lowercase.</small>
                </li>
                <li class="mt-2">
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                    <strong>❌ @GlobalPasswordPolicyManagement.bad_password_example:</strong><br />
                    <code class="text-danger"><string>password123</string></code><br />
                    <small class="text-muted">@GlobalPasswordPolicyManagement.fails_complexity_rules_uses_disallowed_keywords.</small>
                </li>
            </ul>
        </div>

        <!-- Default Configuration Display -->
        <div class="alert alert-secondary mt-3">
            <strong class="mb-2 d-block">🔐 @GlobalPasswordPolicyManagement.default_password_policy_configuration:</strong>

            <div class="table-responsive">
                <table class="table table-bordered table-sm table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>@GlobalShared.policy_key</th>
                            <th>@GlobalShared.default_value</th>
                            <th>@GlobalShared.Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>1</td><td>@GlobalShared.min_length</td><td>8</td><td>@GlobalPasswordPolicyManagement.minimum_number_of_characters_required_in_apassword.</td></tr>
                        <tr><td>2</td><td>@GlobalShared.max_length</td><td>128</td><td>@GlobalPasswordPolicyManagement.maximum_number_of_characters_allowed_in_apassword.</td></tr>
                        <tr><td>3</td><td>@GlobalShared.require_uppercase</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.at_least_one_uppercase_letter_must_be_present_in_the_password.</td></tr>
                        <tr><td>4</td><td>@GlobalShared.require_lowercase</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.at_least_one_lowercase_letter_must_be_present_in_the_password.</td></tr>
                        <tr><td>5</td><td>@GlobalShared.require_digit</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.at_least_one_numeric_digit_must_be_present_in_the_password.</td></tr>
                        <tr><td>6</td><td>@GlobalShared.require_special_char</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.at_least_one_special_character_from_the_allowed_list_must_be_present.</td></tr>
                        <tr><td>7</td><td>@GlobalShared.allowed_special_chars</td><td>!@@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?</td><td>@GlobalPasswordPolicyManagement.set_of_permitted_special_characters.</td></tr>
                        <tr><td>8</td><td>@GlobalPasswordPolicyManagement.disallow_username_in_password</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.restricts_passwords_from_containing_the_username.</td></tr>
                        <tr><td>9</td><td>@GlobalPasswordPolicyManagement.password_history_count</td><td>5</td><td>@GlobalPasswordPolicyManagement.how_many_previous_passwords_are_remembered_to_avoid_reuse.</td></tr>
                        <tr><td>10</td><td>@GlobalPasswordPolicyManagement.disallow_previous_passwords</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.prevents_the_reuse_of_past_passwords_within_the_history_count.</td></tr>
                        <tr><td>11</td><td>@GlobalPasswordPolicyManagement.enable_mfa</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.enables_multi_factor_authentication_for_additional_login_security.</td></tr>
                        <tr><td>12</td><td>@GlobalPasswordPolicyManagement.mfa_types_allowed</td><td>SMS, EMAIL, TOTP</td><td>@GlobalPasswordPolicyManagement.accepted_mfa_types_sms.</td></tr>
                        <tr><td>13</td><td>@GlobalPasswordPolicyManagement.mfa_enforcement_grace_days</td><td>3</td><td>@GlobalPasswordPolicyManagement.grace_period_before_mfabecomes_mandatory_for_users_after_account_creation.</td></tr>
                        <tr>
                            <td>14</td>
                            <td>@GlobalShared.disallowed_substrings</td>
                            <td>@GlobalShared.Password, admin, login, 1234, qwerty, abcd, root, test, guest, access, letmein, welcome, secret, iloveyou, trustno1, dragon, 2020, 2021, 0000</td>
                            <td>@GlobalPasswordPolicyManagement.rejects_common_weak_keywords_and_phrases_often_exploited_in_brute_force.</td>
                        </tr>
                        <tr>
                            <td>15</td>
                            <td>RegexPatternValidation</td>
                            <td>^(?!.*(.)\1{2,})(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@#$%^&+=!?]).{12,128}$</td>
                            <td>
                                @GlobalPasswordPolicyManagement.enforces_strong_passwords:
                                <ul class="mb-0 ps-3">
                                    <li>@GlobalPasswordPolicyManagement._12_128_characters_long</li>
                                    <li>@GlobalPasswordPolicyManagement.at_least1_uppercase1_lowercase1_digit_and1_special_character</li>
                                    <li>@GlobalPasswordPolicyManagement.rejects_passwords_with3_or_more_consecutive_repeated_characters</li>
                                </ul>
                            </td>
                        </tr>
                        <tr><td>16</td><td>@GlobalPasswordPolicyManagement.reject_serial_patterns</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.blocks_passwords_that_contain_simple_numeric_sequences_like <code>123456</code>, <code>0000</code>, <code>987654</code>, @GlobalPasswordPolicyManagement.or_similar_serial_like_structures.</td></tr>
                        <tr><td>17</td><td>@GlobalShared.allow_admin_reset</td><td>@GlobalShared._true</td><td>@GlobalPasswordPolicyManagement.permits_administrators_to_reset_user_passwords_if_needed.</td></tr>
                        <tr><td>18</td><td>@GlobalPasswordPolicyManagement.admin_reset_bypass_history</td><td>@GlobalShared._false</td><td>@GlobalPasswordPolicyManagement.determines_whether_admin_resets_bypass_password_reuse_history_checks.</td></tr>
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>




<!-- Configuration Notice -->
<div class="alert alert-info mt-3 mb-2">
    <strong>@GlobalShared.Notice:</strong> @GlobalShared.only <u>@GlobalPasswordPolicyManagement.one_configuration_per_branch</u> @GlobalPasswordPolicyManagement.is_allowed_for_centralized_control_enable_the <code>@GlobalShared.is_central</code> @GlobalShared.flag.<br />
    @GlobalPasswordPolicyManagement.new_configuration_entries_will_be_rejected_if_one_already_exists_for_the_same_scope.
</div>
