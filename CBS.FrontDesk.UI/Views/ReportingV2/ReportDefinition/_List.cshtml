@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportDefinition.ReportDefinition>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Definitions</h5>
    <a href="#" class="btn btn-sm btn-primary" @*onclick="loadPartialView('@Url.Action("Initilization","ReportDefinition")', '#definitionContainer', { path: 'new' })*@">
        <i class="mdi mdi-plus"></i> New
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Currency</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.ReportType</td>
                <td>@item.Currency</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <a href="#" class="btn btn-sm btn-info" @*onclick="loadPartialView('@Url.Action("Initilization","ReportDefinition")', '#definitionContainer', { path: 'edit', KEY: '@item.Id' })"*@>
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
