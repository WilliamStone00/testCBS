
@model CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportDefinition.ReportDefinition

<form id="reportDefinitionForm">
    @Html.HiddenFor(m => m.Id)

    <div class="row g-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Code, "Report Code", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "BALANCE_SHEET_V1" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.Name, "Report Name", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Balance Sheet" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.ReportType, "Report Type", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.ReportType,
                new SelectList(new[] { "BalanceSheet", "IncomeExpenditure" }),
                "--- Select Type ---",
                new { @class = "form-select" })
        </div>

        <div class="col-md-3">
            @Html.LabelFor(m => m.Currency, "Currency", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Currency, new { @class = "form-control", placeholder = "XAF" })
        </div>

        <div class="col-md-2 d-flex align-items-center">
            <div class="form-check mt-3">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                <label class="form-check-label fw-bold">Active</label>
            </div>
        </div>
    </div>

    <div class="text-end mt-4">
        <button type="submit" class="btn btn-success px-4">
            <i class="mdi mdi-content-save"></i> Save
        </button>
        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">
            <i class="mdi mdi-close"></i> Cancel
        </button>
    </div>
</form>

<script>
    // ✅ Soumission AJAX
    $("#reportDefinitionForm").submit(function (e) {
        e.preventDefault();

        const formData = $(this).serialize();

        $.post("/ReportDefinition/Create", formData, function (res) {
            if (res.success) {
                Swal.fire("Saved!", res.message, "success");
                bootstrap.Modal.getInstance(document.getElementById("definitionModal")).hide();
                reloadDefinitionList();
            } else {
                Swal.fire("Error", res.message || "Something went wrong", "error");
            }
        }).fail(function (xhr) {
            Swal.fire("Error", "Request failed: " + xhr.status, "error");
        });
    });
</script>
