@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportLineMapping.ReportLineMapping>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Line Mappings</h5>
    <a href="#" class="btn btn-sm btn-primary" onclick="loadPartialView('@Url.Action("Initilization","ReportLineMapping")', '#mappingContainer', { path: 'new' })">
        <i class="mdi mdi-plus"></i> New
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Line Id</th>
            <th>Match Type</th>
            <th>From Value</th>
            <th>To Value</th>
            <th>Side</th>
            <th>Sign</th>
            <th>Include Liaison</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LineId</td>
                <td>@item.MatchType</td>
                <td>@item.FromValue</td>
                <td>@item.ToValue</td>
                <td>@item.Side</td>
                <td>@item.Sign</td>
                <td>@(item.IncludeLiaison ? "Yes" : "No")</td>
                <td>
                    <a href="#" class="btn btn-sm btn-info" onclick="loadPartialView('@Url.Action("Initilization","ReportLineMapping")', '#mappingContainer', { path: 'edit', KEY: '@item.Id' })">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
