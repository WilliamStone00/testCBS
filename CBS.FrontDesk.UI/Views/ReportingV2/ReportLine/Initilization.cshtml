@model CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportLine.ReportLine

<div class="card border-light shadow-sm">
    <div class="card-header bg-light fw-bold text-success">
        <i class="mdi mdi-format-line-weight me-1"></i> Report Line Management
    </div>
    <div class="card-body">
        <form id="reportLineForm">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Report Definition</label>
                    <select name="ReportId" id="ReportId" class="form-select">
                        <option value="">-- Select Report --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Section</label>
                    <select name="SectionId" id="SectionId" class="form-select">
                        <option value="">-- Select Section --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ref Code</label>
                    <input type="text" name="RefCode" class="form-control" placeholder="AS01" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Caption</label>
                    <input type="text" name="Caption" class="form-control" placeholder="Cash and Bank" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Calc Mode</label>
                    <select name="CalcMode" class="form-select">
                        <option value="SUM">SUM</option>
                        <option value="SUBTOTAL">SUBTOTAL</option>
                        <option value="DIFF">DIFF</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sort Order</label>
                    <input type="number" name="SortOrder" class="form-control" placeholder="1" />
                </div>
                <div class="col-md-1 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="ShowInOutput" checked />
                        <label class="form-check-label">Show</label>
                    </div>
                </div>
            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success px-4">
                    <i class="mdi mdi-content-save"></i> Save Line
                </button>
            </div>
        </form>

        <hr />

        <table class="table table-sm table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>REF CODE</th>
                    <th>CAPTION</th>
                    <th>CALC MODE</th>
                    <th>SORT ORDER</th>
                    <th>SECTION</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody id="lineList">
                <!-- Dynamic Data -->
            </tbody>
        </table>
    </div>
</div>
