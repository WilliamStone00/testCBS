@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportSection.ReportSection>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Sections</h5>
    <a href="#" class="btn btn-sm btn-primary" onclick="loadPartialView('@Url.Action("Initilization","ReportSection")', '#sectionContainer', { path: 'new' })">
        <i class="mdi mdi-plus"></i> New
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Sort Order</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.SortOrder</td>
                <td>
                    <a href="#" class="btn btn-sm btn-info" onclick="loadPartialView('@Url.Action("Initilization","ReportSection")', '#sectionContainer', { path: 'edit', KEY: '@item.Id' })">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
