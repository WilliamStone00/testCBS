@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonAccountConfiguration.LiaisonAccountConfigurationDto

@using Resources

<div class="card-body">
    @using (Html.BeginForm("Create", "LiaisonAccountConfiguration", FormMethod.Post, new { onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <legend class="text-primary">Liaison Account Configuration</legend>
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.BranchId)

            <div class="row gy-3">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Source Branch ---", new { @class = "form-control select2", id = "BranchId", onchange = "LoadAccounts(this.value,'LiaisonAccountId')" })
                        <label>Source Branch</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.HeadOfficeLiaisonAccountId, new SelectList(ViewBag.Liasons, "Value", "Text"), "--- Select Option ---", new { @class = "form-control select2", id = "LiaisonAccountId" })
                        <label>Liaison Account</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-check">
                        <label class="form-check-label">
                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-check-input" }) Active
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <button type="reset" class="btn btn-outline-secondary">Reset</button>
            </div>
        </fieldset>
    }
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function LoadAccounts(branchId, affectedID) {
            if (branchId) {
                $.get('/LiaisonAccountConfiguration/GetAccountsByBranch', { branchId: branchId }, function (data) {
                    const ddl = $('#' + affectedID);
                    ddl.empty().append('<option value="">--- Select Liaison Account ---</option>');
                    $.each(data, function (i, account) {
                        ddl.append($('<option></option>').val(account.id).text(account.text));
                    });
                });
            }
        }

        $(document).ready(function () {
            $('#BranchId').change(function () {
                const branchId = $(this).val();
                LoadAccounts(branchId, 'LiaisonAccountId');
            });
        });
    </script>
}