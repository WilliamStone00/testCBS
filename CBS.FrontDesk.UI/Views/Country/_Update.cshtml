@model CBS.FrontDesk.Data.Entity.Config.Country
    @using Resources
<div class="card-body pt-2 mt-1">
    @using (Html.BeginForm("Update", "Country", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.Id)
    <div class="row mt-4 gy-12">
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.Code, new { @class = "form-control", @placeholder = @GlobalCountry.CountryCode })
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                <label>@GlobalCountry.CountryCode</label>
            </div>
        </div>
        <div class="col-md-8">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = GlobalShared.Name })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                <label>@GlobalCountry.CountryName</label>
            </div>
        </div>

    </div>
    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>

    </div>
}
</div>