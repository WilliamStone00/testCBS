@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@{
    ViewBag.Title = "Saving accounts";
}

<h5 class="py-3 mb-4"><span class="text-muted fw-light">Transactions/</span>: Accounts</h5>
<div class="col-12">
    <div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <a href="/TransactionManagement/SavingAccounts" class="footer-link me-4">Refresh</a>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-datatable table-responsive">
        <div id="datalistingview">
            @Html.Partial("_SavingAccountData")
        </div>
    </div>
</div>
<!-- Offcanvas to add new user -->
@*</div>*@

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/TransactionManagement/Savings.js"></script>
}

