

@using Resources
<div class="card p-3 shadow mb-2">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Open_Date</th>
                    <th>@GlobalShared.Closed_Date</th>
                    <th>@GlobalShared.Reference </th>
                    <th>@GlobalShared.Initiated_By</th>
                    <th>@GlobalShared.State</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>



