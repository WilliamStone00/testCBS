@model CBS.FrontDesk.Data.Entity.AccountingV2.JournalHead
@using Resources
@{
    ViewBag.Title = "Journal Head Listing";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> JOURNAL HEAD
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Use the filters below to search and review journal entries efficiently.
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> FILTER USAGE GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Branch Filter:</strong> Check the box to enable branch selection. You can show or hide it as needed.</li>
                <li><strong>Operation Type:</strong> Choose whether to view <em>Cash In</em> or <em>Cash Out</em> operations.</li>
                <li><strong>Reconciliation Status:</strong> Filter between <em>Temporary</em> or <em>Reconciled</em> journal entries.</li>
                <li><strong>Reference:</strong> Enter a reference number or keyword to search for specific transactions.</li>
                <li><strong>Date Filters:</strong> Use the toggle to show or hide accounting and creation date filters. You can filter by range for better results.</li>
                <li><strong>Apply Filters:</strong> Click <em>Search</em> to load matching results in the table below.</li>
                <li><strong>Reset Filters:</strong> Use the reset button to clear all filters and start a new search.</li>
                <li><strong>Tip:</strong> Combine filters (e.g., Branch + Date) for more precise results.</li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-2 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('AccoutingdateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Accounting Date
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Entry Date Filters
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-1 d-flex align-items-center mt-4">
                    <div class="form-check">
                        @Html.CheckBox("IsInterbranch", false, new { @class = "form-check-input", id = "IsInterbranch" })
                        <label class="form-check-label fw-bold" for="IsInterbranch">Is Interbranch</label>
                    </div>
                </div>


            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>



            @*<hr class="my-3" />*@

            <!-- 🔹 Reference, Operation Type & Work Ticket (always visible) -->
            <!-- 🔹 Mode, Daily Operation & Is Interbranch -->
            <div class="row mb-1">


                <div class="col-md-6 mb-1">

                    <label class="form-label fw-bold">Journal Status</label>
                    @Html.DropDownList("JournalStatus",
                        new SelectList(ViewBag.JournalStatus, "Value", "Text"),
                        "Select Journal Status",
                        new { @class = "form-control select2 mb-1", @id = "JournalStatus" })
                </div>

                @*<div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Daily Operator</label>
                        @Html.DropDownList("DailyOperator",
                            new List<SelectListItem>(), // backend will populate
                            "--- Select Operator ---",
                            new { @class = "form-control select2 mb-1", id = "DailyOperator" })
                    </div>*@
                <div class="col-md-6 mb-1">
                    <label class="form-label fw-bold">Daily Operator</label>
                    @Html.DropDownList(
                        "DailyOperator",
                        ViewBag.DailyOperators as List<SelectListItem>,
                        "--- Select Operator ---",
                        new { @class = "form-control select2 mb-1", id = "DailyOperator" }
                    )
                </div>



            </div>




            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Reference</label>
                    <input type="text" id="reference" name="Reference" class="form-control mb-1" placeholder="Enter Reference" />
                </div>

                @*<div class="col-md-4 mb-1">
                        <label class="form-label fw-bold">Operation Type</label>
                        @Html.DropDownList("OperationType",
                            new SelectList(ViewBag.OperationTypes, "Value", "Text"),
                            "Select Operation Type",
                            new { @class = "form-control select2 mb-1", @id = "OperationType" })
                    </div>*@

                <div class="col-md-4 mb-1">

                    <label class="form-label fw-bold">Data Source</label>
                    @Html.DropDownList("Source",
                        new SelectList(ViewBag.Source, "Value", "Text"),
                        "Select Source ",
                        new { @class = "form-control select2 mb-1", @id = "Source" })
                </div>


                @*<div class="col-md-4 mb-1">
                        <label class="form-label fw-bold">Operation Code</label>
                        @Html.DropDownList("OperationCode",
                            new List<SelectListItem>(), // backend will populate
                            "--- Select Operation Code ---",
                            new { @class = "form-control select2 mb-1", id = "OperationCode" })
                    </div>*@

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Operation Code</label>
                    @Html.DropDownList(
                        "OperationCode",
                        ViewBag.OperationCodes as List<SelectListItem>,
                        "--- Select Operation Code ---",
                        new { @class = "form-control select2 mb-1", id = "OperationCode" }
                    )
                </div>

            </div>





            <div id="AccoutingdateFilters" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Start Accounting Date</label>
                        <input type="date" id="startaccountingDate" name="StartAccountingDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">End Accounting Date</label>
                        <input type="date" id="endaccountingDate" name="EndAccountingDate" class="form-control mb-1" />
                    </div>


                </div>
            </div>

            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold" for="startDate">Start Entry Date</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold" for="endDate">End Entry Date</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>


                </div>
            </div>


        </div>





        <div class="row g-2 mt-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100"
                        onclick="document.getElementById('journalHeaderFilterForm').reset();">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btnExport" class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> Export
                </button>
            </div>
        </div>




    </form>
</div>


<hr />



<div id="datalistingview">
    @Html.Partial("_JournalHeadDataTable")
</div>


@*Modal container (no body content yet)*@
<div class="modal fade" id="journalDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="journalDetailsModalContent" class="p-3">
                @* Content will be loaded here *@
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="journalExportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_ExportJournalHeadDataTable")

        </div>
    </div>
</div>



@section Scripts {


    @Scripts.Render("~/bundles/jqueryval")


    <script>
$(document).ready(function () {

    // ==============================
    // 🔹 Flags
    // ==============================
    let filtersApplied = false;
    let isResetting = false;

    // ==============================
    // 🔹 Initialize Select2 (ONCE)
    // ==============================
    $("#OperationCode").select2();
    $("#DailyOperator").select2();

    // ==============================
    // 🔹 Load Journal Header Data
    // ==============================
    function loadJournalHeaderData() {
        $('#myDataTable').DataTable({
            serverSide: true,
            destroy: true,
            responsive: true,
            searching: false,
            order: [[0, 'desc']],
            ajax: {
                url: '/JournalHead/LoadJournalHeaderData',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    const filters = collectJournalHeaderFilters();
                    filters.Options = {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        skip: d.start,
                        pageSize: d.length,
                        searchValue: d.search?.value || '',
                        sortColumnName: d.columns[d.order[0].column].data,
                        sortColumnDirection: d.order[0].dir
                    };
                    return JSON.stringify(filters);
                },
                error: function (xhr, status, err) {
                    console.error('❌ Error loading journal headers:', status, err);
                    appalert('❌ Failed to load journal headers. Status: ' + xhr.status, 4, 1);
                }
            },
            columns: [
                {
                    data: null,
                    name: 'Dates',
                    render: function (_, __, row) {
                        const today = moment();

                        const createdAt = row.CreatedAt
                            ? moment(row.CreatedAt).format('DD/MM/YYYY HH:mm:ss')
                            : '-';

                        const accountingMoment = row.AccountingDate
                            ? moment(row.AccountingDate)
                            : null;

                        const accountingDate = accountingMoment
                            ? accountingMoment.format('DD/MM/YYYY')
                            : '-';

                        // ✅ Accounting DATE is green when CreatedAt date == AccountingDate date
                        const accountingClass =
                            accountingMoment &&
                                row.CreatedAt &&
                                accountingMoment.isSame(moment(row.CreatedAt), 'day')
                                ? 'text-success'
                                : 'text-danger';

                        return `
            <div>
                <div>
                    <small class="text-muted fw-bold">Entry:</small>
                    <span class="text-info fw-semibold">${createdAt}</span>
                </div>
                <div>
                    <small class="text-muted fw-bold">Accounting:</small>
                    <span class="${accountingClass}">
                        ${accountingDate}
                    </span>
                </div>
            </div>
        `;
                    }
                },

                { data: 'Memo', name: 'Memo' },
                { data: 'InitiatedByTrim', name: 'InitiatedByTrim' },
                { data: 'ApprovedByTrim', name: 'ApprovedByTrim' },
                { data: 'OperationCodeTrim', name: 'OperationCodeTrim' },
                {
                    data: null,
                    orderable: false,
                    render: function (_, __, row) {
                        return `
                            <div class="text-center">
                                <button class="btn btn-sm btn-info view-details" data-id="${row.Id}">
                                    <i class="mdi mdi-eye-outline me-1"></i> Details
                                </button>
                            </div>`;
                    }
                }
            ],
            initComplete: function () {
                appalert('✅ Journal headers table loaded successfully!', 1, 1);
            },
            drawCallback: function () {
                const api = this.api();
                if (api.rows({ page: 'current' }).data().length === 0) {
                    appalert('⚠️ No journal headers found on this page.', 2, 1);
                }
            }
        });
    }

    // ==============================
    // 🔹 Collect Filter Values
    // ==============================
    function collectJournalHeaderFilters() {
        return {
            BranchId: $('#branchId').val(),
            OperationType: $('#OperationType').val(),
            OperationCode: $('#OperationCode').val(),
            Reference: $('#reference').val(),
            StartDate: $('#startDate').val(),
            EndDate: $('#endDate').val(),
            StartAccountingDate: $('#startaccountingDate').val(),
            EndAccountingDate: $('#endaccountingDate').val(),
            JournalStatus: $('#JournalStatus').val(),
            DailyOperator: $('#DailyOperator').val(),
            IsInterbranch: $('#IsInterbranch').prop('checked'),
            Source: $('#Source').val(),
            Options: {}
        };
    }

    // ==============================
    // 🔹 Reset Filters
    // ==============================
    function resetJournalHeaderFilters() {
        isResetting = true;
        $('#journalHeaderFilterForm').trigger('reset');
        $('.select2').val('').trigger('change'); // triggers change, but blocked by isResetting
        $('#branchFilter, #dateFilters').addClass('d-none');
        appalert('🧹 Filters reset successful', 1, 1);
        isResetting = false;
    }

    // ==============================
    // 🔹 Load Filter Dependencies
    // ==============================
    function loadDependencies(request) {
        $.ajax({
            url: '/JournalHead/LoadFilterDependencies',
            type: 'POST',
            data: request,
            success: function (res) {

                if (!res || !res.success) {
                    appalert("Failed to load data. Please try again.", 2, 1);
                    return;
                }

                // Update Operation Codes
                const opDropdown = $("#OperationCode");
                opDropdown.empty().append('<option value="">--- Select Operation Code ---</option>');
                $.each(res.operationCodes || [], function (_, code) {
                    opDropdown.append(new Option(code, code));
                });

                // Update Daily Operators
                const operatorDropdown = $("#DailyOperator");
                operatorDropdown.empty().append('<option value="">--- Select Operator ---</option>');
                $.each(res.initiatedBy || [], function (_, name) {
                    operatorDropdown.append(new Option(name, name));
                });

                // Refresh Select2 without reinitializing
                opDropdown.trigger('change.select2');
                operatorDropdown.trigger('change.select2');
            },
            error: function () {
                appalert("Unable to connect to server. Please check your network.", 3, 3);
            }
        });
    }

    // ==============================
    // 🔹 Build Filter Request
    // ==============================
    function buildFilterRequest() {
        return {
            BranchId: $("#branchId").val() || " ",
            JournalStatus: $("#JournalStatus").val() || null,
            Source: $("#Source").val() || null
        };
    }

    // ==============================
    // 🔹 Filter Change Handling
    // ==============================
    $("#branchId, #JournalStatus, #Source").on("change", function () {
        if (isResetting) return;
        const request = buildFilterRequest();
        loadDependencies(request);
    });

    // ==============================
    // 🔹 Reset Button
    // ==============================
    $('#resetFilterBtn').on('click', function(e) {
        e.preventDefault();
        resetJournalHeaderFilters();
    });

    // ==============================
    // 🔹 Apply Filters
    // ==============================
    $('#applyFilterBtn').on('click', function(e) {
        e.preventDefault();
        loadJournalHeaderData();
        filtersApplied = true;
    });

    // ==============================
    // 🔹 View Details Modal
    // ==============================
    $(document).on("click", ".view-details", function () {
        const journalId = $(this).data("id");
        if (!journalId) return;

        $.ajax({
            url: `/JournalHead/GetDetails?id=${encodeURIComponent(journalId)}`,
            type: "GET",
            dataType: "html",
            success: function (html) {
                $("#journalDetailsModal .modal-content").html(html);
                const modalEl = document.getElementById('journalDetailsModal');
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            },
            error: function (xhr) {
                $("#journalDetailsModal .modal-content").html(`
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            Failed to load journal details. Status: ${xhr.status}
                        </div>
                    </div>
                `);
                const modalEl = document.getElementById('journalDetailsModal');
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            }
        });
    });

    // ==============================
    // 🔹 Export Journal Header
    // ==============================
    $('#btnExport').on('click', function () {
        if (!filtersApplied) {
            appalert("⚠️ Please apply filters before exporting.", 2, 1);
            return;
        }
        const modalEl = document.getElementById('journalExportModal');
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
    });

    $('#btnConfirmJournalExport').on('click', function () {
        let filters = collectJournalHeaderFilters();
        let exportOptions = {
            FileName: $("#jhFileName").val(),
            Format: $("#jhExportFormat").val(),
            ReportType: $("#jhReportType").val(),
            StartDate: $("#jhStartDate").val(),
            EndDate: $("#jhEndDate").val()
        };

        let request = { Filters: filters, ExportOptions: exportOptions };

        $("#btnConfirmJournalExport").prop("disabled", true).html(`<span class="spinner-border spinner-border-sm"></span> Exporting...`);

        $.ajax({
            url: '@Url.Action("ExportJournalData", "JournalHead")',
            type: "POST",
            data: JSON.stringify(request),
            contentType: "application/json",
            xhrFields: { responseType: 'blob' },
            success: function (data, status, xhr) {
                let disposition = xhr.getResponseHeader("Content-Disposition");
                let filename = "JournalHeader.xlsx";
                if (disposition && disposition.indexOf("filename=") !== -1) {
                    filename = disposition.split("filename=")[1].trim();
                }
                let blob = new Blob([data]);
                let link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = filename;
                link.click();
                $("#journalExportModal").modal("hide");
                toastr.success("Export completed.");
            },
            error: function () {
                toastr.error("Export failed.");
            },
            complete: function () {
                $("#btnConfirmJournalExport").prop("disabled", false).html(`<i class="mdi mdi-export"></i> Export`);
            }
        });
    });

});
    </script>

}
