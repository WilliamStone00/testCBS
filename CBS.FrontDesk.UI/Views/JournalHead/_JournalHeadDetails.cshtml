
@model CBS.FrontDesk.Data.Entity.AccountongV2.JournalEntry

<style>
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    /* Table and layout adjustments */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
    }

    .card-body-tight {
        padding: 0; /* Make table touch borders */
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }

    th {
        width: 20%;
        color: #333;
    }

    td {
        color: #555;
    }
</style>

<div class="container mt-2">

    <!-- Journal Header Info -->
    <div class="header-viewer">
        <h6>
            <i class="mdi mdi-file-eye-outline me-1"></i> MANUAL JOURNAL ENTRY VIEWER
        </h6>
        <p class="mb-0">
            You are viewing a detailed summary of the selected Manual journal entry.
            Use this information to validate or review the entry.
        </p>
    </div>

    <div class="card rounded-0 shadow-sm mb-4">
        <div class="card-body card-body-tight">
            <table class="table table-sm table-borderless mb-0">
                <tbody>
                    <tr>
                        <th>Reference</th>
                        <td>@(Model?.Reference ?? "")</td>
                        <th>Operation Code</th>
                        <td>@(Model?.OperationCode ?? "")</td>
                    </tr>
                    <tr>
                        <th>Branch</th>
                        <td>@(Model?.BranchId ?? "")</td>
                        <th>Counterparty Branch</th>
                        <td>@(Model?.CounterpartyBranchId ?? "")</td>
                    </tr>
                    <tr>
                        <th>Accounting Date</th>
                        <td>@(Model?.AccountingDate.ToString("yyyy-MM-dd") ?? "")</td>
                        <th>Post Mode</th>
                        <td>@(Model?.PostMode ?? "")</td>
                    </tr>
                    <tr>
                        <th>Correlation ID</th>
                        <td>@(Model?.CorrelationId ?? "")</td>
                        <th>External App</th>
                        <td>@(Model?.ExternalApplicationName ?? "")</td>
                    </tr>
                    <tr>
                        <th>Narration</th>
                        <td colspan="3">@Html.Raw(Model?.Narration ?? "")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Journal Line Entries -->
    <div class="header-viewer">
        <h6>
            <i class="mdi mdi-table me-1"></i> JOURNAL LINE ENTRIES
        </h6>
        <p class="mb-0">All journal line entries under this transaction are listed below for your review.</p>
    </div>

    <div class="card rounded-0 shadow-sm">
        <div class="card-body card-body-tight">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Affiliate Account</th>
                        <th>Narration</th>
                        <th>Debit (XAF)</th>
                        <th>Credit (XAF)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Payload?.Entries != null && Model.Payload.Entries.Any())
                    {
                        foreach (var line in Model.Payload.Entries)
                        {
                            var dr = line.Dr;
                            var cr = line.Cr;
                            var amountText = line.Amount.ToString("N0");
                            <tr>
                                <td>@(line.AffiliateAccountId ?? "")</td>
                                <td>@(line.Naration ?? "")</td>
                                <td>@(dr ? amountText : "")</td>
                                <td>@(cr ? amountText : "")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center">No entries found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal-footer d-flex justify-content-between">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="mdi mdi-close"></i> Close
        </button>
        <button type="button" id="printJournalBtn" class="btn btn-primary">
            <i class="mdi mdi-printer"></i> Print
        </button>
    </div>
</div>
