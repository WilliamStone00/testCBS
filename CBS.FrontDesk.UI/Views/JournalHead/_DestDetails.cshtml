@model CBS.FrontDesk.Data.Entity.AccountingV2.WorkflowTicket
@using Resources;

<style>
    /* ===================== HEADER VIEWER ===================== */
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        Journal entry data could not be loaded.
    </div>
    return;
}



@*===================== MAIN HEADER =====================*@
<div class="header-viewer">
    <h6><i class="mdi mdi-file-document-outline me-1"></i> Work ticket  & DETAILS</h6>
    <p class="mb-0">Detailed information for the selected journal entry.</p>
</div>

@*===================== MODAL BODY =====================*@
<div class="modal-body">

    JOURNAL HEADER INFO
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2"><i class="mdi mdi-file-document me-1"></i> Journal Header</h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">Reference</th><td>@(Model?.Reference ?? "")</td></tr>
            <tr><th class="bg-label">State</th><td>@(Model?.State ?? "")</td></tr>
            <tr><th class="bg-label">Operation Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
            <tr><th class="bg-label">Branch</th><td>@(Model?.BranchId ?? "")</td></tr>
            <tr>
                <th class="bg-label">Accounting Date</th>
                <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
            </tr>
            <tr>
                <th class="bg-label">Remarks</th>
                <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
            </tr>

        </tbody>
    </table>

    @*================= TABLE =================*@
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width:30%">@ManualEntry.Account</th>
                    <th style="width:30%">@ManualEntry.Narration</th>
                    <th style="width:15%">@ManualEntry.Debit</th>
                    <th style="width:15%">@ManualEntry.Credit</th>
                    <th style="width:10%">@ManualEntry.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="2" class="text-end">@ManualEntry.Totals:</td>
                    <td id="totalDebit" class="text-end">0.00</td>
                    <td id="totalCredit" class="text-end">0.00</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-end mt-2">
        <span id="difference" class="fw-bold text-danger">@ManualEntry.Diff: 0.00</span>
    </div>

    @*================= ACTION BUTTONS =================*@
    <div class="mt-3 d-flex justify-content-between">
        <div>
            <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                <i class="mdi mdi-plus"></i> @ManualEntry.AddRow
            </button>
            <button type="button" class="btn btn-outline-danger" id="clearRowsBtn">
                <i class="mdi mdi-trash-can-outline"></i> @ManualEntry.ClearAllRows
            </button>
        </div>
    </div>

    @*================= MEMO =================*@
    @*<div class="mt-4">
            <label class="form-label fw-bold" for="Payload_Memo">@ManualEntry.Remark</label>
            @Html.TextAreaFor(m => m.Payload.Memo, new { @class = "form-control shadow-sm", rows = "3", placeholder = @ManualEntry.Enter, required = "required", id = "Payload_Memo" })
        </div>*@

</div>

@*===================== MODAL FOOTER =====================*@
<div class="modal-footer d-flex justify-content-between">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close"></i> Close
    </button>
    <div>
        <button type="button" id="btnReject" class="btn btn-danger me-2">
            <i class="mdi mdi-close-circle-outline"></i> Reject
        </button>
        <button type="button" id="btnApprove" class="btn btn-success">
            <i class="mdi mdi-check-circle-outline"></i> Approve
        </button>
    </div>
</div>



<script>
    $(document).ready(function () {
        let accounts = [];
        const tableBody = $('#myDataTable tbody');

        // ==================== Add Row ====================
        function addRow() {
            const index = tableBody.children('tr').length;
            const row = `
                <tr>
                    <td>
                        <select name="Lines[${index}].AccountId" class="form-select account-select" required>
                            <option value="">Select Account</option>
                            ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                        </select>
                    </td>
                    <td>
                        <textarea class="form-control narration-input"
                                  name="Lines[${index}].Narration"
                                  placeholder="Enter narration"
                                  rows="1"
                                  oninput="autoGrow(this)"
                                  required></textarea>
                    </td>
                    <td><input type="number" step="0.01" class="form-control debit-input" name="Lines[${index}].Debit" placeholder="0.00" min="0" /></td>
                    <td><input type="number" step="0.01" class="form-control credit-input" name="Lines[${index}].Credit" placeholder="0.00" min="0" /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger deleteRow">
                            <i class="mdi mdi-delete"></i>
                        </button>
                    </td>
                </tr>`;
            tableBody.append(row);

            // ✅ Initialize select2 *only for this new row* and attach it to the modal
            $('.account-select').last().select2({
                width: '100%',
                placeholder: 'Select Account',
                allowClear: true,
                dropdownParent: $('.modal.show') // ensures dropdown appears on top of modal
            });
        }

        // ==================== Load Accounts ====================
        function loadAccounts() {
            $.ajax({
                url: '/ManualJournalEntry/GetAccounts',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (!response.success || !response.data) {
                        appalert(response.message || '⚠️ No accounts found.', 2, 1);
                        return;
                    }

                    // ✅ Store accounts globally
                    accounts = response.data.map(a => ({
                        Value: a.Id,
                        Text: `${a.Code} - ${a.Name}`
                    }));

                    // ✅ Refresh existing dropdowns if rows already exist
                    tableBody.find('.account-select').each(function () {
                        $(this).html('<option value="">Select Account</option>' +
                            accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join(''));
                    });
                },
                error: function (err) {
                    appalert("Error loading accounts: " + err.statusText, 0, 1);
                }
            });
        }

        // ==================== Initial Load ====================
        loadAccounts();
        addRow();

        // ==================== Add Row Validation ====================
        $('#addRowBtn').click(() => {
            let canAdd = true;
            tableBody.find('tr:last').find('input:enabled, select:enabled').each(function () {
                if (!$(this).val()) {
                    canAdd = false;
                    $(this).addClass('is-invalid').css('border-color', 'red');
                } else {
                    $(this).removeClass('is-invalid').css('border-color', '');
                }
            });
            if (!canAdd) {
                appalert('Please fill all fields before adding a new row.', 2, 1);
                return;
            }
            addRow();
        });

        // ==================== Delete Row ====================
        tableBody.on('click', '.deleteRow', function () {
            $(this).closest('tr').remove();
            updateTotals();
        });

        // ==================== Clear All Rows ====================
        $('#clearRowsBtn').click(() => {
            tableBody.empty();
            addRow();
            updateTotals();
        });

        // ==================== Auto Grow Textarea ====================
        window.autoGrow = function (element) {
            element.style.height = "auto";
            element.style.height = (element.scrollHeight) + "px";
        }

        // ==================== Update Totals ====================
        function updateTotals() {
            let debitTotal = 0, creditTotal = 0;
            tableBody.find('.debit-input').each(function () { debitTotal += parseFloat($(this).val()) || 0; });
            tableBody.find('.credit-input').each(function () { creditTotal += parseFloat($(this).val()) || 0; });

            const diff = debitTotal - creditTotal;
            $('#totalDebit').text(`XAF ${debitTotal.toLocaleString()}`);
            $('#totalCredit').text(`XAF ${creditTotal.toLocaleString()}`);
            $('#difference')
                .text(`Diff: XAF ${diff.toLocaleString()}`)
                .toggleClass('text-danger', diff !== 0)
                .toggleClass('text-success', diff === 0);
        }

        // ==================== Handle Debit/Credit Exclusivity ====================
        tableBody.on('input', '.debit-input, .credit-input', function () {
            const row = $(this).closest('tr');
            const debit = row.find('.debit-input');
            const credit = row.find('.credit-input');

            if ($(this).hasClass('debit-input') && $(this).val()) {
                credit.val('').prop('disabled', true);
            } else if ($(this).hasClass('credit-input') && $(this).val()) {
                debit.val('').prop('disabled', true);
            } else {
                debit.prop('disabled', false);
                credit.prop('disabled', false);
            }

            updateTotals();
        });

        window.updateTotals = updateTotals;
    });
</script>

