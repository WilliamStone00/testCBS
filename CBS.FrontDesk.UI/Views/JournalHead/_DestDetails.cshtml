

@model CBS.FrontDesk.Data.Entity.AccountongV2.JournalEntry

<style>
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0; /* Table touches edges */
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>


<!-- ===================== DESTINATION DETAILS MODAL ===================== -->
<div class="modal fade" id="destinationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">

            <!-- Modal Body -->
            <div class="modal-body">

                <!-- Destination Header -->
                <div class="header-viewer mb-3">
                    <h6>
                        <i class="mdi mdi-file-document-outline me-1"></i> DESTINATION INFORMATION
                    </h6>
                    <p class="mb-0">
                        You are viewing details for the selected destination entry.
                        You can <strong>modify</strong> the journal lines before posting.
                    </p>
                </div>

                <!-- Destination Info Table -->
                <div class="card border-0 mb-3">
                    <div class="card-body card-body-tight">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <th>Destination Reference</th>
                                    <td>@(Model?.Reference ?? "")</td>
                                </tr>
                                <tr>
                                    <th>Created By</th>
                                    <td>@(Model?.CreatedBy ?? "")</td>
                                    <th>Created Date</th>
                                    <td>@(Model?.CreatedDate.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>@(Model?.Status ?? "")</td>
                                    <th>Branch</th>
                                    <td>@(Model?.BranchId ?? "")</td>
                                </tr>
                                <tr>
                                    <th>Narration</th>
                                    <td colspan="3">@Html.Raw(Model?.Narration ?? "")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ====================== JOURNAL ENTRY SECTION ====================== -->
                <!-- Totals (above table) -->
                <div class="d-flex justify-content-end mb-2">
                    <div class="me-4 fw-bold text-primary">Total Debit: <span id="totalDebitTop">0.00</span></div>
                    <div class="fw-bold text-danger">Total Credit: <span id="totalCreditTop">0.00</span></div>
                </div>

                <!-- Journal Table -->
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center" id="destinationTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:30%">Account</th>
                                <th style="width:30%">Narration</th>
                                <th style="width:15%">Debit</th>
                                <th style="width:15%">Credit</th>
                                <th style="width:10%">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <!-- Buttons -->
                <div class="mt-3 d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn btn-outline-primary" id="addRowBtnDest">
                            <i class="mdi mdi-plus"></i> Add Row
                        </button>
                        <button type="button" class="btn btn-outline-danger" id="clearRowsBtnDest">
                            <i class="mdi mdi-trash-can-outline"></i> Clear All Rows
                        </button>
                    </div>
                </div>

                <!-- Remark -->
                <div class="mt-4">
                    <label class="form-label fw-bold">Remark</label>
                    <textarea name="Remark" class="form-control shadow-sm" rows="3" placeholder="Enter remark..."></textarea>
                </div>

                <!-- Post -->
                <div class="mt-4 text-end">
                    <button type="submit" id="postEntriesBtnDest" class="btn btn-primary px-4" disabled>
                        <i class="mdi mdi-check-circle-outline me-1"></i> save
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        const tableBody = $("#destinationTable tbody");
        const totalDebitEl = $("#totalDebitTop");
        const totalCreditEl = $("#totalCreditTop");
        const postBtn = $("#postEntriesBtnDest");

        function updateTotals() {
            let totalDebit = 0, totalCredit = 0;

            tableBody.find('tr').each(function () {
                const debit = parseFloat($(this).find('.debit-input').val()) || 0;
                const credit = parseFloat($(this).find('.credit-input').val()) || 0;
                totalDebit += debit;
                totalCredit += credit;
            });

            totalDebitEl.text(totalDebit.toFixed(2));
            totalCreditEl.text(totalCredit.toFixed(2));

            // Enable post button only when totals match and not zero
            if (totalDebit > 0 && totalDebit === totalCredit)
                postBtn.prop("disabled", false);
            else
                postBtn.prop("disabled", true);
        }

        function addRow() {
            const index = tableBody.children('tr').length;
            const row = `
                <tr>
                    <td>
                        <select name="Lines[${index}].AccountId" class="form-select account-select" required>
                            <option value="">Select Account</option>
                            ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control narration-input" name="Lines[${index}].Narration" placeholder="Enter narration" required />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control debit-input" name="Lines[${index}].Debit" placeholder="0.00" min="0" />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control credit-input" name="Lines[${index}].Credit" placeholder="0.00" min="0" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger deleteRow"><i class="mdi mdi-delete"></i></button>
                    </td>
                </tr>`;
            tableBody.append(row);
            initSelect2();
        }

        // ➕ Add Row
        $("#addRowBtnDest").click(() => {
            let canAdd = true;
            tableBody.find('tr:last').find('input:enabled, select:enabled').each(function () {
                if (!$(this).val()) {
                    canAdd = false;
                    $(this).addClass('is-invalid').css('border-color', 'red');
                } else {
                    $(this).removeClass('is-invalid').css('border-color', '');
                }
            });
            if (!canAdd) {
                appalert('Please fill all fields before adding a new row.', 2, 1);
                return;
            }
            addRow();
            appalert('Row added successfully.', 1, 1);
        });

        // 🗑️ Delete Row
        tableBody.on('click', '.deleteRow', function () {
            $(this).closest('tr').remove();
            updateTotals();
            appalert('Row deleted successfully.', 1, 1);
        });

        // 💰 Handle debit/credit mutual exclusion + total updates
        tableBody.on('input', '.debit-input', function () {
            const debit = parseFloat($(this).val()) || 0;
            if (debit > 0) {
                $(this).closest('tr').find('.credit-input').val('').prop('disabled', true);
            } else {
                $(this).closest('tr').find('.credit-input').prop('disabled', false);
            }
            updateTotals();
        });

        tableBody.on('input', '.credit-input', function () {
            const credit = parseFloat($(this).val()) || 0;
            if (credit > 0) {
                $(this).closest('tr').find('.debit-input').val('').prop('disabled', true);
            } else {
                $(this).closest('tr').find('.debit-input').prop('disabled', false);
            }
            updateTotals();
        });

        // 🧹 Clear all rows
        $("#clearRowsBtnDest").click(() => {
            tableBody.empty();
            updateTotals();
            postBtn.prop("disabled", true);
            appalert('All rows cleared.', 1, 1);
        });

        // Initialize with one row
        addRow();
    });
</script>
