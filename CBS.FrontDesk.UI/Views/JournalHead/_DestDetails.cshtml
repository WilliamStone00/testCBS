            });

            // Delete Row
            tableBody.off('click', '.deleteRow').on('click', '.deleteRow', function () {
                $(this).closest('tr').remove();
                updateTotals(modal);
            });

            // ✅ Debit/Credit logic: one disables the other
            tableBody.on('input', '.debit-input', function () {
                const $row = $(this).closest('tr');
                const debitVal = parseFloat($(this).val()) || 0;
                const $credit = $row.find('.credit-input');

                if (debitVal > 0) {
                    $credit.val('').prop('disabled', true);
                } else {
                    $credit.prop('disabled', false);
                }
                updateTotals(modal);
            });

            tableBody.on('input', '.credit-input', function () {
                const $row = $(this).closest('tr');
                const creditVal = parseFloat($(this).val()) || 0;
                const $debit = $row.find('.debit-input');

                if (creditVal > 0) {
                    $debit.val('').prop('disabled', true);
                } else {
                    $debit.prop('disabled', false);
                }
                updateTotals(modal);
            });
        });
    });
</script>





