                    </td>
                </tr>
            `);
            tableBody.append(row);
            initSelect2(row.find('.account-select'));
        }

        // ✅ Update debit/credit totals inside modal
        function updateTotals(modal) {
            const tableBody = modal.find('#myDataTable tbody');
