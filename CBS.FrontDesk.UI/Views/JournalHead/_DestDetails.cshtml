                .toggleClass('text-success', diff === 0);
        }

        // ✅ When modal opens — initialize table setup
        $('#SourceDetailsModal').on('shown.bs.modal', function () {
            const modal = $(this);
            const tableBody = modal.find('#myDataTable tbody');

            // Clear previous rows to avoid duplicates
