


@model CBS.FrontDesk.Data.Entity.AccountingV2.WorkflowTicket
@using Resources;

<style>
    /* ===================== HEADER VIEWER ===================== */
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        @GlobalJournalHead.Journal_entry_data_could_not_be_loaded
    </div>
    return;
}



@if (Model.TicketType == "SOURCE")
{
    @Html.Partial("_SourceDetails")
}
else if (Model.TicketType == "SOURCE_EOY")
{
    @Html.Partial("_SourceDetails")
}

else if (Model.TicketType == "SOURCE_MEMBERS_BALANCE_RECONCILIATION")
{
    @Html.Partial("_MemberReconciliationDetails")
}
else if (Model.TicketType == "SOURCE_CASH_GLS_RECONCILATION")
{
    @Html.Partial("_CashReconciliationDetails")
}
else
{


    if (Model.State == "INITIATED")
    {


        @*===================== MAIN HEADER =====================*@
        <div class="header-viewer">
            <h6><i class="mdi mdi-file-document-outline me-1"></i> @GlobalJournalHead.JOURNAL_REQUEST_DETAILS</h6>
            <p class="mb-0">@GlobalJournalHead.Detailed_information_for_the_selected_journal_entry</p>
        </div>
        <input type="hidden" id="sourceBranchId" value="@Model.BranchId" />
        <input type="hidden" id="ExcelId" value="@Model.Id" />

        @*===================== MODAL BODY =====================*@
        <div class="modal-body">





            @*JOURNAL HEADER INFO*@
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2"><i class="mdi mdi-file-document me-1"></i> @GlobalJournalHead.Journal_Header</h6>
            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="bg-label">@GlobalShared.Reference</th><td>@(Model?.Reference ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.State</th>
                        <td>
                            <span class="badge
  @(Model?.State == "APPROVED" ? "bg-success" :
    Model?.State == "REJECTED" ? "bg-danger" :
    "bg-secondary")">
                                @(Model?.State ?? "")
                            </span>
                        </td>
                    </tr>
                    <tr><th class="bg-label">@GlobalShared.Operation_Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Branch</th><td>@(Model?.BranchName ?? "")</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Ticket_Type</th><td>@(Model?.TicketType ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.IsInterBranch</th>
                        <td>@(Model?.IsInterBranch.ToString() ?? "")</td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Accounting_Date</th>
                        <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.Remarks</th>
                        <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.Initiated_By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.InitiatedBy)
? "-"
: Model.TempJournalHeader.InitiatedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Initiated_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.InitiationDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Approved_by</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.ApprovedBy)
? "-"
: Model.TempJournalHeader.ApprovedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Approved_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.ApprovalDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Rejected_By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.RejectedBy)
? "-"
: Model.TempJournalHeader.RejectedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Rejected_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.RejectedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr><th class="bg-label">@GlobalShared.Initiated_Amount</th><td>@Math.Abs(Model.InitiatedAmount).ToString("N0")</td></tr>
                </tbody>
            </table>




            @if (!string.Equals(Model?.State, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                <div class="row mb-2 align-items-end">
                    <div class="col-md-12 mb-2">
                        @Html.Label("BranchId", "Destination Branch", new { @class = "form-label fw-bold", @for = "BranchId" })
                        @Html.DropDownList(
                         "BranchId",
                         new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                         "---"+ GlobalShared.Select_Branch +"---",
                         new { @class = "form-control select2 mb-2", id = "BranchId", disabled = "disabled" }
                     )
                    </div>
                </div>

            }



            @*================= TABLE =================*@
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:30%">@GlobalShared.Account</th>
                            <th style="width:30%">@GlobalShared.Memo</th>
                            <th style="width:15%">@GlobalShared.Debit</th>
                            <th style="width:15%">@GlobalShared.Credit</th>
                            <th style="width:10%">@GlobalShared.Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">@GlobalShared.Totals:</td>
                            <td id="totalDebit" class="text-end">0.00</td>
                            <td id="totalCredit" class="text-end">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-2">
                <span id="difference" class="fw-bold text-danger">Diff: 0.00</span>
            </div>

            @*================= ACTION BUTTONS =================*@
            <div class="mt-3 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                        <i class="mdi mdi-plus"></i> @GlobalShared.Add_Row
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="clearRowsBtn">
                        <i class="mdi mdi-trash-can-outline"></i> @GlobalShared.ClearAllRows
                    </button>
                </div>
            </div>


        </div>

        @*===================== MODAL FOOTER =====================*@
        <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close"></i> @GlobalShared.Close
            </button>
            <div>



                

                    <button type="button" id="btnExportExcel" class="btn btn-outline-primary me-2">
                        <i class="mdi mdi-file-excel-outline"></i> @GlobalShared.Export_Excel
                    </button>

                    <button type="button" id="btnApproveDestination" class="btn btn-success">
                        <i class="mdi mdi-check-circle-outline"></i>
                        <span class="btn-text">@GlobalShared.Approve</span>
                    </button>


                    <button type="button" id="btnReject" class="btn btn-danger me-2">
                        <i class="mdi mdi-check-circle-outline"></i>
                        <span class="btn-text">@GlobalShared.Reject</span>
                    </button>


                

            </div>
        </div>




        <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered custom-width">
                <div class="modal-content">

                    <div class="card bg-light mb-3">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-file-document-outline me-2"></i>@GlobalJournalHead.Reject_Journal_REQUEST
                            </h1>
                            <p class="card-text">
                                @GlobalJournalHead.Use_this_page_to_Reject_your_journal_request
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>

                    <div class="modal-body">

                        <input type="hidden" id="RejectId" value="@Model.Reference" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">@GlobalShared.Reason</label>
                            <textarea id="RejectReason" class="form-control" rows="3"
                                      placeholder="Enter rejection reason"></textarea>

                        </div>

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
                        <button id="btnSubmitReject" class="btn btn-danger">@GlobalShared.Submit_Rejection</button>
                    </div>

                </div>
            </div>
        </div>




    }
    else
    {




        <!-- ===================== MAIN HEADER ===================== -->
        <div class="header-viewer">
            <h6>
                <i class="mdi mdi-file-document-outline me-1"></i> @GlobalJournalHead.JOURNAL_REQUEST_DETAILS
            </h6>
            <p class="mb-0">
                @GlobalJournalHead.Detailed_information_for_the_selected_journal_entry
            </p>
        </div>

        <!-- ===================== MODAL BODY ===================== -->
        <div class="modal-body">
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                <i class="mdi mdi-file-document me-1"></i> @GlobalJournalHead.Journal_Header
            </h6>
            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="bg-label">@GlobalShared.Reference</th><td>@(Model?.Reference ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.State</th>
                        <td>
                            <span class="badge
            @(Model?.State == "APPROVED" ? "bg-success" :
              Model?.State == "REJECTED" ? "bg-danger" :
              "bg-secondary")">
                                @(Model?.State ?? "")
                            </span>
                        </td>
                    </tr>

                    <tr><th class="bg-label">@GlobalShared.Operation_Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Branch</th><td>@(Model?.BranchName ?? "")</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Type</th><td>@(Model?.TicketType ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.IsInterBranch</th>
                        <td>@(Model?.IsInterBranch.ToString() ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.Accounting_Date</th>
                        <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.Remarks</th>
                        <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">@GlobalShared.Initiated_By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.InitiatedBy)
? "-"
: Model.TempJournalHeader.InitiatedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Initiated_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.InitiationDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Approved_by</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.ApprovedBy)
? "-"
: Model.TempJournalHeader.ApprovedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Approved_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.ApprovalDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Rejected_By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.RejectedBy)
? "-"
: Model.TempJournalHeader.RejectedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">@GlobalShared.Rejected_Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.RejectedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>
                    <tr><th class="bg-label">@GlobalShared.Initiated_Amount</th><td>@Math.Abs(Model.InitiatedAmount).ToString("N0")</td></tr>
                </tbody>
            </table>

            <!-- ===================== MAIN JOURNAL LINES ===================== -->
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                <i class="mdi mdi-table me-1"></i> @GlobalJournalHead.Journal_Line_Entries
            </h6>
            <div class="card border-0 mb-3">
                <div class="card-body card-body-tight">
                    @{
                        decimal totalDebit = 0;
                        decimal totalCredit = 0;
                    }
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@GlobalShared.Account_Number</th>
                                <th>@GlobalShared.Account_Name</th>
                                <th>@GlobalShared.Description</th>
                                <th>@GlobalShared.Debit (FCFA)</th>
                                <th>@GlobalShared.Credit (FCFA)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.JournalLines != null && Model.JournalLines.Any())
                            {
                                foreach (var line in Model.JournalLines)
                                {
                                    var debit = line.DrCr?.ToLower() == "debit" ? Math.Abs(line.Amount) : 0;
                                    var credit = line.DrCr?.ToLower() == "credit" ? Math.Abs(line.Amount) : 0;
                                    totalDebit += debit;
                                    totalCredit += credit;

                                    <tr>
                                        <td>@line.AccountNumber</td>
                                        <td>@line.AccountName</td>
                                        <td>@line.Description</td>
                                        <td>@debit.ToString("N0")</td>
                                        <td>@credit.ToString("N0")</td>
                                    </tr>
                                }

                                <tr class="fw-bold bg-light">
                                    <td colspan="3" class="text-end">@GlobalShared.Totals</td>
                                    <td>@totalDebit.ToString("N0")</td>
                                    <td>@totalCredit.ToString("N0")</td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center text-muted">@GlobalJournalHead.No_journal_line_entries_found</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


        </div>



        <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close"></i> @GlobalShared.Close
            </button>
            <div>


                <button type="button" id="btnExportExcel" class="btn btn-outline-primary me-2">
                    <i class="mdi mdi-file-excel-outline"></i> @GlobalShared.Export_Excel
                </button>


                <button type="button" id="btnApprove" class="btn btn-success" disabled>
                    <i class="mdi mdi-check-circle-outline"></i>
                    <span class="btn-text">@GlobalShared.Approve</span>
                </button>

                <button type="button" id="btnReject" class="btn btn-danger">
                    <i class="mdi mdi-check-circle-outline"></i>
                    <span class="btn-text">@GlobalShared.Reject</span>
                </button>

            </div>
        </div>





    }
}


















