


@model CBS.FrontDesk.Data.Entity.AccountingV2.WorkflowTicket
@using Resources;

<style>
    /* ===================== HEADER VIEWER ===================== */
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        Journal entry data could not be loaded.
    </div>
    return;
}

@if (Model.TicketType == "SOURCE")
{
    @Html.Partial("_SourceDetails")
}
else if (Model.TicketType == "SOURCE_EOY")
{
    @Html.Partial("_SourceDetails")
}

else if (Model.TicketType == "SOURCE_MEMBERS_BALANCE_RECONCILIATION")
{
    @Html.Partial("_MemberReconciliationDetails")
}
else if (Model.TicketType == "SOURCE_CASH_GLS_RECONCILATION")
{
    @Html.Partial("_CashReconciliationDetails")
}
else
{


    if (Model.State == "INITIATED")
    {


        @*===================== MAIN HEADER =====================*@
        <div class="header-viewer">
            <h6><i class="mdi mdi-file-document-outline me-1"></i> JOURNAL REQUEST  & DETAILS</h6>
            <p class="mb-0">Detailed information for the selected journal entry.</p>
        </div>

        @*===================== MODAL BODY =====================*@
        <div class="modal-body">





            @*JOURNAL HEADER INFO*@
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2"><i class="mdi mdi-file-document me-1"></i> Journal Header</h6>
            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="bg-label">Reference</th><td>@(Model?.Reference ?? "")</td></tr>
                    <tr><th class="bg-label">State</th><td>@(Model?.State ?? "")</td></tr>
                    <tr><th class="bg-label">Operation Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
                    <tr><th class="bg-label">Branch</th><td>@(Model?.BranchName ?? "")</td></tr>
                    <tr><th class="bg-label">Ticket Type</th><td>@(Model?.TicketType ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">IsInterBranch</th>
                        <td>@(Model?.IsInterBranch.ToString() ?? "")</td>
                    </tr>

                    <tr>
                        <th class="bg-label">Accounting Date</th>
                        <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">Remarks</th>
                        <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">Initiated By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.InitiatedBy)
? "-"
: Model.TempJournalHeader.InitiatedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Initiated Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.InitiationDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Approved By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.ApprovedBy)
? "-"
: Model.TempJournalHeader.ApprovedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Approved Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.ApprovalDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Rejected By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.RejectedBy)
? "-"
: Model.TempJournalHeader.RejectedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Rejected Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.RejectedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr><th class="bg-label">Initiated Amount</th><td>@Math.Abs(Model.InitiatedAmount).ToString("N0")</td></tr>
                </tbody>
            </table>




            @if (!string.Equals(Model?.State, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                <div class="row mb-2 align-items-end">
                    <div class="col-md-12 mb-2">
                        @Html.Label("BranchId", "Destination Branch", new { @class = "form-label fw-bold", @for = "BranchId" })
                        @Html.DropDownList(
                         "BranchId",
                         new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                         "--- Select Branch ---",
                         new { @class = "form-control select2 mb-2", id = "BranchId", disabled = "disabled" }
                     )
                    </div>
                </div>

            }



            @*================= TABLE =================*@
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:30%">@ManualEntry.Account</th>
                            <th style="width:30%">Memo</th>
                            <th style="width:15%">@ManualEntry.Debit</th>
                            <th style="width:15%">@ManualEntry.Credit</th>
                            <th style="width:10%">@ManualEntry.Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">@ManualEntry.Totals:</td>
                            <td id="totalDebit" class="text-end">0.00</td>
                            <td id="totalCredit" class="text-end">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-2">
                <span id="difference" class="fw-bold text-danger">@ManualEntry.Diff: 0.00</span>
            </div>

            @*================= ACTION BUTTONS =================*@
            <div class="mt-3 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-primary" id="addRowBtn">
                        <i class="mdi mdi-plus"></i> @ManualEntry.AddRow
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="clearRowsBtn">
                        <i class="mdi mdi-trash-can-outline"></i> @ManualEntry.ClearAllRows
                    </button>
                </div>
            </div>


        </div>

        @*===================== MODAL FOOTER =====================*@
        <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close"></i> Close
            </button>
            <div>



                <div class="mt-3 d-flex justify-content-end">


                    <button type="button" id="btnReject" class="btn btn-danger me-2">
                        <i class="mdi mdi-check-circle-outline"></i>
                        <span class="btn-text">Reject</span>
                    </button>

                    <button type="button" id="btnApproveDestination" class="btn btn-success">
                        <i class="mdi mdi-check-circle-outline"></i>
                        <span class="btn-text">Approve</span>
                    </button>
                </div>

            </div>
        </div>








        <script>
    $(document).ready(function () {
        let accounts = [];

        // ==========================
        // Utility functions
        // ==========================

        function initSelect2(element) {
            element.select2({
                width: '100%',
                placeholder: 'Select Account',
                allowClear: true,
                dropdownParent: $('#SourceDetailsModal')
            });
        }

        window.autoGrow = function (element) {
            element.style.height = 'auto';
            element.style.height = (element.scrollHeight) + 'px';
        }

        function loadAccounts(branchId, callback) {
            if (!branchId) {
                appalert("⚠️ Please select a branch first.", 2, 1);
                return;
            }

            if (loadAccounts.request) loadAccounts.request.abort();

            loadAccounts.request = $.ajax({
                url: '/ManualJournalEntry/GetAccounts',
                type: 'GET',
                data: { branchId: branchId },
                dataType: 'json',
                success: function (response) {
                    if (!response.success || !response.data) {
                        appalert(response.message || '⚠️ No accounts found for this branch.', 2, 1);
                        accounts = [];
                        return;
                    }

                    accounts = response.data.map(a => ({
                        Value: a.Value,
                        Text: `${a.Text}`
                    }));

                    appalert('✅ Accounts loaded successfully for selected branch.', 1, 1);

                    if (callback) callback();
                },
                error: function (err) {
                    if (err.statusText !== 'abort')
                        appalert("Error loading accounts: " + err.statusText, 0, 1);
                }
            });
        }

        function addRow(tableBody) {
            const index = tableBody.children('tr').length;
            const row = $(`
                <tr>
                    <td style="width: 35%;">
                        <select name="Lines[${index}].AffiliateAccountId" class="form-select account-select account-id" required>
                            <option value="">Select Account</option>
                            ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                        </select>
                    </td>
                    <td style="width: 25%;">
                        <textarea class="form-control memo"
                                  name="Lines[${index}].Narration"
                                  placeholder="Enter memo"
                                  rows="1"
                                  oninput="autoGrow(this)"
                                  required></textarea>
                    </td>
                    <td style="width: 15%;">
                        <input type="number" step="0.01" class="form-control debit-input amount"
                               name="Lines[${index}].Debit" placeholder="0.00" min="0" />
                    </td>
                    <td style="width: 15%;">
                        <input type="number" step="0.01" class="form-control credit-input amount"
                               name="Lines[${index}].Credit" placeholder="0.00" min="0" />
                    </td>
                    <td class="text-center" style="width: 10%;">
                        <button type="button" class="btn btn-sm btn-outline-danger deleteRow">
                            <i class="mdi mdi-delete"></i>
                        </button>
                    </td>
                </tr>
            `);

            tableBody.append(row);
            initSelect2(row.find('.account-select'));
        }

        function updateTotals(modal) {
            const tableBody = modal.find('#myDataTable tbody');
            let debitTotal = 0, creditTotal = 0;

            tableBody.find('.debit-input').each(function () {
                debitTotal += parseFloat($(this).val()) || 0;
            });

            tableBody.find('.credit-input').each(function () {
                creditTotal += parseFloat($(this).val()) || 0;
            });

            const diff = debitTotal - creditTotal;
            const initiatedAmount = Math.abs(parseFloat('@Model.InitiatedAmount')) || 0;

            // Update totals in UI
            modal.find('#totalDebit').text(`XAF ${debitTotal.toLocaleString()}`);
            modal.find('#totalCredit').text(`XAF ${creditTotal.toLocaleString()}`);
            modal.find('#difference')
                .text(`Diff: XAF ${diff.toLocaleString()}`)
                .toggleClass('text-danger', diff !== 0)
                .toggleClass('text-success', diff === 0);

            const approveBtn = $('#btnApproveDestination');

            // ✅ Enable Approve button only when:
            // 1. Debits = Credits
            // 2. Debits > 0
            // 3. Debits (or Credits) == InitiatedAmount
            const canApprove =
                diff === 0 &&
                debitTotal > 0 &&
                debitTotal.toFixed(2) === initiatedAmount.toFixed(2);

            if (canApprove) {
                approveBtn.prop('disabled', false)
                    .removeClass('btn-secondary')
                    .addClass('btn-success');
            } else {
                approveBtn.prop('disabled', true)
                    .removeClass('btn-success')
                    .addClass('btn-secondary');
            }
        }

        // ==========================
        // Modal events
        // ==========================

        $('#SourceDetailsModal').off('shown.bs.modal').on('shown.bs.modal', function () {
            const modal = $(this);
            const tableBody = modal.find('#myDataTable tbody');
            tableBody.empty();

            const branchId = $('#BranchId').val();
            if (!branchId) {
                appalert("⚠️ Please select a branch before adding journal entries.", 2, 1);
                return;
            }

            loadAccounts(branchId, () => addRow(tableBody));

            modal.find('#addRowBtn').off('click').on('click', function () {
                if (accounts.length === 0) {
                    appalert("⚠️ Please select a branch first to load accounts.", 2, 1);
                    return;
                }
                addRow(tableBody);
            });

            tableBody.off('click', '.deleteRow').on('click', '.deleteRow', function () {
                $(this).closest('tr').remove();
                updateTotals(modal);
            });

            tableBody.off('input', '.debit-input').on('input', '.debit-input', function () {
                const $row = $(this).closest('tr');
                const debitVal = parseFloat($(this).val()) || 0;
                const $credit = $row.find('.credit-input');
                $credit.prop('disabled', debitVal > 0).val(debitVal > 0 ? '' : $credit.val());
                updateTotals(modal);
            });

            tableBody.off('input', '.credit-input').on('input', '.credit-input', function () {
                const $row = $(this).closest('tr');
                const creditVal = parseFloat($(this).val()) || 0;
                const $debit = $row.find('.debit-input');
                $debit.prop('disabled', creditVal > 0).val(creditVal > 0 ? '' : $debit.val());
                updateTotals(modal);
            });
        });

        // ==========================
        // Branch change
        // ==========================

        $('#BranchId').off('change').on('change', function () {
            const branchId = $(this).val();
            accounts = [];
            if (branchId) loadAccounts(branchId);
        });

        // ==========================
        // Approve Destination
        // ==========================

                @*const destState = '@(Model?.State ?? "")';
                if (destState.toUpperCase() === 'APPROVED') {
                    $('#btnApproveDestination')
                        .prop('disabled', true)
                        .addClass('btn-secondary')
                        .removeClass('btn-success');
                }*@



        const destState = '@(Model?.State ?? "")'.toUpperCase();

            if (['APPROVED', 'REJECTED', 'RECONCILED'].includes(destState)) {
                $('#btnApproveDestination')
                    .prop('disabled', true)
                    .addClass('btn-secondary')
                    .removeClass('btn-success')
                    .attr('aria-disabled', 'true');
            }

        $('#btnApproveDestination').on('click', function (e) {
            e.preventDefault();

            alertify.confirm(
                "Confirmation",
                "Are you sure you want to approve this journal entry?",
                function () {

                    var $btn = $('#btnApproveDestination');
                    var $icon = $btn.find('i');
                    var $text = $btn.find('.btn-text');

                    $btn.prop('disabled', true);
                    $icon.removeClass('mdi-check-circle-outline')
                         .addClass('mdi-loading mdi-spin');
                    $text.text('Approving...');

                    var payload = {
                        Reference: '@Model.Reference',
                        BranchId: $('#BranchId').val() || '@Model.BranchId',
                        Approver: '@User.Identity.Name',
                        TicketType: '@Model.TicketType',
                        Lines: []
                    };

                    $('#myDataTable tbody tr').each(function () {
                        var $row = $(this);
                        var affiliateAccountId = $row.find('.account-id').val();
                        var debitVal = parseFloat($row.find('.debit-input').val()) || 0;
                        var creditVal = parseFloat($row.find('.credit-input').val()) || 0;

                        if (affiliateAccountId && (debitVal > 0 || creditVal > 0)) {
                            payload.Lines.push({
                                AffiliateAccountId: affiliateAccountId,
                                DrCr: debitVal > 0 ? 'DR' : 'CR',
                                Amount: debitVal > 0 ? debitVal : creditVal,
                                Memo: $row.find('.memo').val()
                            });
                        }
                    });

                    $.ajax({
                        url: '@Url.Action("Approve", "JournalHead")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function (response) {
                            if (response && response.success) {
                                appalert(response.message || "✅ Approved successfully.", 1, 1);

                                $btn.prop('disabled', true);
                                $icon.removeClass('mdi-loading mdi-spin')
                                     .addClass('mdi-check-circle');
                                $text.text('Approved');
                            } else {
                                appalert((response && response.message) || "❌ Approval failed.", 2, 1);

                                $btn.prop('disabled', false);
                                $icon.removeClass('mdi-loading mdi-spin')
                                     .addClass('mdi-check-circle-outline');
                                $text.text('Approve');
                            }
                        },
                        error: function (xhr) {
                            appalert("❌ An error occurred while approving.", 0, 1);

                            $btn.prop('disabled', false);
                            $icon.removeClass('mdi-loading mdi-spin')
                                 .addClass('mdi-check-circle-outline');
                            $text.text('Approve');
                        }
                    });
                },
                function () {
                    appalert("🚫 Approval cancelled.", 2, 1);
                }
            );
        });
    });


        </script>
    }
    else
    {




        <!-- ===================== MAIN HEADER ===================== -->
        <div class="header-viewer">
            <h6>
                <i class="mdi mdi-file-document-outline me-1"></i> JOURNAL REQUEST & DETAILS
            </h6>
            <p class="mb-0">
                Detailed information for the selected journal entry.
            </p>
        </div>

        <!-- ===================== MODAL BODY ===================== -->
        <div class="modal-body">
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                <i class="mdi mdi-file-document me-1"></i> Journal Header
            </h6>
            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="bg-label">Reference</th><td>@(Model?.Reference ?? "")</td></tr>
                    <tr><th class="bg-label">State</th><td>@(Model?.State ?? "")</td></tr>
                    <tr><th class="bg-label">Operation Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
                    <tr><th class="bg-label">Branch</th><td>@(Model?.BranchName ?? "")</td></tr>
                    <tr><th class="bg-label">Ticket Type</th><td>@(Model?.TicketType ?? "")</td></tr>
                    <tr>
                        <th class="bg-label">IsInterBranch</th>
                        <td>@(Model?.IsInterBranch.ToString() ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">Accounting Date</th>
                        <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">Remarks</th>
                        <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
                    </tr>
                    <tr>
                        <th class="bg-label">Initiated By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.InitiatedBy)
? "-"
: Model.TempJournalHeader.InitiatedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Initiated Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.InitiationDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Approved By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.ApprovedBy)
? "-"
: Model.TempJournalHeader.ApprovedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Approved Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.ApprovalDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Rejected By</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model?.TempJournalHeader?.RejectedBy)
? "-"
: Model.TempJournalHeader.RejectedBy)
                        </td>
                    </tr>

                    <tr>
                        <th class="bg-label">Rejected Date</th>
                        <td>
                            @(Model?.TempJournalHeader?.RejectedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>
                    <tr><th class="bg-label">Initiated Amount</th><td>@Math.Abs(Model.InitiatedAmount).ToString("N0")</td></tr>
                </tbody>
            </table>

            <!-- ===================== MAIN JOURNAL LINES ===================== -->
            <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                <i class="mdi mdi-table me-1"></i> Journal Line Entries
            </h6>
            <div class="card border-0 mb-3">
                <div class="card-body card-body-tight">
                    @{
                        decimal totalDebit = 0;
                        decimal totalCredit = 0;
                    }
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Account Number</th>
                                <th>Account Name</th>
                                <th>Description</th>
                                <th>Debit (FCFA)</th>
                                <th>Credit (FCFA)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.JournalLines != null && Model.JournalLines.Any())
                            {
                                foreach (var line in Model.JournalLines)
                                {
                                    var debit = line.DrCr?.ToLower() == "debit" ? Math.Abs(line.Amount) : 0;
                                    var credit = line.DrCr?.ToLower() == "credit" ? Math.Abs(line.Amount) : 0;
                                    totalDebit += debit;
                                    totalCredit += credit;

                                    <tr>
                                        <td>@line.AccountNumber</td>
                                        <td>@line.AccountName</td>
                                        <td>@line.Description</td>
                                        <td>@debit.ToString("N0")</td>
                                        <td>@credit.ToString("N0")</td>
                                    </tr>
                                }

                                <tr class="fw-bold bg-light">
                                    <td colspan="3" class="text-end">Totals</td>
                                    <td>@totalDebit.ToString("N0")</td>
                                    <td>@totalCredit.ToString("N0")</td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center text-muted">No journal line entries found</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


        </div>



        <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close"></i> Close
            </button>
            <div>


                <button type="button" id="btnExportExcel" class="btn btn-outline-primary me-2">
                    <i class="mdi mdi-file-excel-outline"></i> Export Excel
                </button>


                <button type="button" id="btnApprove" class="btn btn-success" disabled>
                    <i class="mdi mdi-check-circle-outline"></i>
                    <span class="btn-text">Approve</span>
                </button>

                <button type="button" id="btnReject" class="btn btn-danger">
                    <i class="mdi mdi-check-circle-outline"></i>
                    <span class="btn-text">Reject</span>
                </button>

            </div>
        </div>





        <script>
            $(document).ready(function () {

                 $('#btnExportExcel').click(function () {
                     const id = '@Model.Id';
                     if (!id) {
                         alert("Invalid journal ID!");
                         return;
                     }

                     window.location.href = '@Url.Action("DownloadJournalHeadExcel", "JournalHead")' + '?id=' + id;
                 });
            });
        </script>
    }
}


















