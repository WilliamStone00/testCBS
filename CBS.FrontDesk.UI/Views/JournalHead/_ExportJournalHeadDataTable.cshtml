
@model CBS.FrontDesk.Data.Entity.AccountingV2.JournalHead
@using Resources
<div class="modal-body">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-export me-2"></i>@GlobalJournalHead.Export_Journal_Header
                    </h1>
                    <p class="card-text"></p>

                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        @GlobalJournalHead.Export_Journal_Header_entries_with_optional_date_filtering_and_export_format_selection
                    </div>

                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Export_Format</label>
            <select class="form-select" id="jhExportFormat">
                <option value="excel">Excel (.xlsx)</option>
                @*<option value="csv">CSV (.csv)</option>*@
                <option value="pdf">PDF (.pdf)</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Report_Type</label>
            <select class="form-select" id="jhReportType">
                <option value="full">@GlobalShared.Full_Report</option>
                <option value="dateRange">@GlobalShared.Date_Range_Only</option>
                <option value="branch">@GlobalShared.By_Branch</option>
            </select>
        </div>
    </div>

    <!-- Date Range -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Date_Range (@GlobalShared.Optional)</label>
            <div class="input-group">
                <input type="date" class="form-control" id="jhStartDate">
                <span class="input-group-text">To</span>
                <input type="date" class="form-control" id="jhEndDate">
            </div>
            <small class="text-muted">@GlobalJournalHead.Leave_empty_to_include_all_dates</small>
        </div>

        <!-- File Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.File_Name</label>
            <input type="text" class="form-control" id="jhFileName"
                   value="Journal_Header_Report"
                   placeholder="@GlobalShared.Enter_file_name">
        </div>
    </div>




</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close me-1"></i>@GlobalShared.Cancel
    </button>

    <button type="button" class="btn btn-success" id="btnConfirmJournalExport">
        <i class="mdi mdi-export me-1"></i>@GlobalShared.Export
    </button>
</div>



    





