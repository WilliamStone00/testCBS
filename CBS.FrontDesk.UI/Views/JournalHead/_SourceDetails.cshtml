@model CBS.FrontDesk.Data.Entity.AccountingV2.WorkflowTicket

<style>
    /* ===================== HEADER VIEWER ===================== */
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        Journal entry data could not be loaded.
    </div>
    return;
}

<!-- ===================== MAIN HEADER ===================== -->
<div class="header-viewer">
    <h6>
        <i class="mdi mdi-file-document-outline me-1"></i> JOURNAL HEADER & DETAILS
    </h6>
    <p class="mb-0">
        Detailed information for the selected journal entry.
    </p>
</div>

<!-- ===================== MODAL BODY ===================== -->
<div class="modal-body">
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-file-document me-1"></i> Journal Header
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr><th class="bg-label">Reference</th><td>@(Model?.Reference ?? "")</td></tr>
            <tr><th class="bg-label">State</th><td>@(Model?.State ?? "")</td></tr>
            <tr><th class="bg-label">Operation Code</th><td>@(Model?.OperationCode ?? "")</td></tr>
            <tr><th class="bg-label">Branch</th><td>@(Model?.BranchId ?? "")</td></tr>
            <tr>
                <th class="bg-label">Accounting Date</th>
                <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
            </tr>
            <tr>
                <th class="bg-label">Remarks</th>
                <td colspan="3">@Html.Raw(Model?.Remarks ?? "")</td>
            </tr>
            <tr>
                <th class="bg-label">Approved By</th>
                <td>@(string.IsNullOrWhiteSpace(Model?.Approveby) ? "-" : Model.Approveby)</td>
            </tr>
            <tr>
                <th class="bg-label">Approved Date</th>
                <td>@(Model?.ApproveDate != DateTime.MinValue ? Model.ApproveDate.ToString("dd/MM/yyyy HH:mm") : "-")</td>
            </tr>
            <tr>
                <th class="bg-label">Rejected By</th>
                <td>@(string.IsNullOrWhiteSpace(Model?.Rejectedby) ? "-" : Model.Rejectedby)</td>
            </tr>
            <tr>
                <th class="bg-label">Rejected Date</th>
                <td>@(Model?.RejectedDate != DateTime.MinValue ? Model.RejectedDate.ToString("dd/MM/yyyy HH:mm") : "-")</td>
            </tr>
        </tbody>
    </table>

    <!-- ===================== MAIN JOURNAL LINES ===================== -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-table me-1"></i> Journal Line Entries
    </h6>
    <div class="card border-0 mb-3">
        <div class="card-body card-body-tight">
            @{
                decimal totalDebit = 0;
                decimal totalCredit = 0;
            }
            <table class="table table-hover table-striped mb-0">
                <thead>
                    <tr>
                        <th>Account Number</th>
                        <th>Account Name</th>
                        <th>Description</th>
                        <th>Debit (FCFA)</th>
                        <th>Credit (FCFA)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.JournalLines != null && Model.JournalLines.Any())
                    {
                        foreach (var line in Model.JournalLines)
                        {
                            var debit = line.DrCr?.ToLower() == "debit" ? Math.Abs(line.Amount) : 0;
                            var credit = line.DrCr?.ToLower() == "credit" ? Math.Abs(line.Amount) : 0;
                            totalDebit += debit;
                            totalCredit += credit;

                            <tr>
                                <td>@line.AccountNumber</td>
                                <td>@line.AccountName</td>
                                <td>@line.Description</td>
                                <td>@debit.ToString("N0")</td>
                                <td>@credit.ToString("N0")</td>
                            </tr>
                        }

                        <tr class="fw-bold bg-light">
                            <td colspan="3" class="text-end">Totals</td>
                            <td>@totalDebit.ToString("N0")</td>
                            <td>@totalCredit.ToString("N0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted">No journal line entries found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================== TEMP JOURNAL LINES ===================== -->
    @if (Model.TempJournalHeader != null && Model.TempJournalHeader.Lines != null && Model.TempJournalHeader.Lines.Any())
    {
        <h6 class="fw-bold text-success border-bottom pb-1 mb-2">
            <i class="mdi mdi-table me-1"></i> Temp Journal Lines (Pending / Destination)
        </h6>
        <div class="card border-0 mb-3">
            <div class="card-body card-body-tight">
                @{
                    decimal tempDebit = 0;
                    decimal tempCredit = 0;
                }
                <table class="table table-hover table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Account Number</th>
                            <th>Account Name</th>
                            <th>Description</th>
                            <th>Debit (FCFA)</th>
                            <th>Credit (FCFA)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.TempJournalHeader.Lines)
                        {
                            var debit = line.DrCr?.ToLower() == "debit" ? Math.Abs(line.Amount) : 0;
                            var credit = line.DrCr?.ToLower() == "credit" ? Math.Abs(line.Amount) : 0;
                            tempDebit += debit;
                            tempCredit += credit;

                            <tr>
                                <td>@line.AccountNumber</td>
                                <td>@line.AccountName</td>
                                <td>@line.Description</td>
                                <td>@debit.ToString("N0")</td>
                                <td>@credit.ToString("N0")</td>
                            </tr>
                        }

                        <tr class="fw-bold bg-light">
                            <td colspan="3" class="text-end">Totals</td>
                            <td>@tempDebit.ToString("N0")</td>
                            <td>@tempCredit.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


@*===================== MODAL FOOTER =====================*@
<div class="modal-footer d-flex justify-content-between">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close"></i> Close
    </button>
    <div>
       
        <button type="button" id="btnApprove" class="btn btn-success">
            <i class="mdi mdi-check-circle-outline"></i> Approve
        </button>
    </div>
</div>



<!-- ===================== Optional Script ===================== -->
<script>
    $(document).ready(function () {

        $('#btnApprove').click(function (e) {
            e.preventDefault();

            // Prepare payload
            const payload = {
                Reference: '@Model.Reference',   // your journal reference from Razor model
                BranchId: '@Model.BranchId',     // branch id
                Approver: '@User.Identity.Name'  // current user
            };

            $.ajax({
                url: '@Url.Action("Approve", "JournalHead")', // controller action
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message); // success notification
                        // Optional: disable button after approval
                        $('#btnApprove').prop('disabled', true);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("An error occurred: " + error);
                }
            });
        });

    });
</script>


