@model CBS.FrontDesk.Data.Entity.AccountingV2.JournalHead

<style>
    /* ===================== HEADER VIEWER ===================== */
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .card-body-tight {
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 0;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding-top: 1rem;
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        Journal entry data could not be loaded.
    </div>
    return;
}

<div class="modal fade" id="SourceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">

            <!-- ===================== MAIN HEADER ===================== -->
            <div class="header-viewer">
                <h6>
                    <i class="mdi mdi-file-document-outline me-1"></i> JOURNAL HEADER & DETAILS
                </h6>
                <p class="mb-0">
                    Detailed information for the selected journal entry.
                </p>
            </div>

            <!-- ===================== MODAL BODY ===================== -->
            <div class="modal-body">

                <!-- JOURNAL HEADER INFO -->
                <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                    <i class="mdi mdi-file-document me-1"></i> Journal Header
                </h6>
                <table class="table table-sm table-bordered mb-3">
                    <tbody>
                        <tr><th class="bg-label">Reference</th><td>@(Model?.Reference ?? "")</td></tr>
                        <tr><th class="bg-label">Stage</th><td>@(Model?.Stage ?? "")</td></tr>
                        <tr><th class="bg-label">Status</th><td>@(Model?.Status ?? "")</td></tr>
                        <tr><th class="bg-label">Branch</th><td>@(Model?.BranchId ?? "")</td></tr>
                        <tr>
                            <th class="bg-label">Accounting Date</th>
                            <td>@(Model != null ? Model.AccountingDate.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        </tr>
                        <tr>
                            <th class="bg-label">Narration</th>
                            <td colspan="3">@Html.Raw(Model?.Narrative ?? "")</td>
                        </tr>
                        <tr>
                            <th class="bg-label">Total Debit</th>
                            <td>@(Model != null ? Model.TotalDebit.ToString("N0") : "0")</td>
                            <th class="bg-label">Total Credit</th>
                            <td>@(Model != null ? Model.TotalCredit.ToString("N0") : "0")</td>
                        </tr>
                    </tbody>
                </table>

                <!-- JOURNAL LINES -->
                <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
                    <i class="mdi mdi-table me-1"></i> Journal Line Entries
                </h6>
                <div class="card border-0 mb-3">
                    <div class="card-body card-body-tight">
                        <table class="table table-hover table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Account Number</th>
                                    <th>Account Name</th>
                                    <th>Description</th>
                                    <th>Debit (FCFA)</th>
                                    <th>Credit (FCFA)</th>
                                    <th>Created By</th>
                                    <th>Created On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.Lines != null && Model.Lines.Any())
                                {
                                    foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>@(line?.AccountNumber ?? "")</td>
                                            <td>@(line?.AccountName ?? "")</td>
                                            <td>@(line?.Description ?? "")</td>
                                            <td>@((line != null && line.DrCr == "Debit") ? line.Amount.ToString("N0") : "")</td>
                                            <td>@((line != null && line.DrCr == "Credit") ? line.Amount.ToString("N0") : "")</td>
                                            <td>@(line?.CreatedBy ?? "")</td>
                                            <td>@(line != null ? line.CreatedOn.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">No line entries found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ===================== MODAL FOOTER ===================== -->
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Close
                </button>
                <div>
                    <button type="button" id="btnReject" class="btn btn-danger me-2">
                        <i class="mdi mdi-close-circle-outline"></i> Reject
                    </button>
                    <button type="button" id="btnApprove" class="btn btn-success">
                        <i class="mdi mdi-check-circle-outline"></i> Approve
                    </button>
                </div>
            </div>



<!-- ===================== Optional Script ===================== -->
<script>
    $(document).ready(function () {
        // Approve button click
        $('#btnApproveSource').on('click', function () {
            let id = '@Model?.Id';
            $.ajax({
                url: '/JournalHead/Approve',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        toastr.success('Source approved successfully!');
                        $('#sourceDetailsModal').modal('hide');
                        // Refresh table or page if needed
                    } else {
                        toastr.error(res.message || 'Approval failed.');
                    }
                }
            });
        });

        // Reject button click
        $('#btnRejectSource').on('click', function () {
            let id = '@Model?.Id';
            $.ajax({
                url: '/JournalHead/Reject',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        toastr.warning('Source rejected.');
                        $('#sourceDetailsModal').modal('hide');
                    } else {
                        toastr.error(res.message || 'Rejection failed.');
                    }
                }
            });
        });
    });
</script>

