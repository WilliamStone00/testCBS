@model CBS.FrontDesk.Data.Entity.AccountingV2.JournalHead
@using Resources

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Work Ticket
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Use the filters below to search and review journal entries efficiently.
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> FILTER USAGE GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Branch Filter:</strong> Check the box to enable branch selection. You can show or hide it as needed.</li>
                <li><strong>Operation Type:</strong> Choose whether to view <em>Cash In</em> or <em>Cash Out</em> operations.</li>
                <li><strong>Reconciliation Status:</strong> Filter between <em>Temporary</em> or <em>Reconciled</em> journal entries.</li>
                <li><strong>Reference:</strong> Enter a reference number or keyword to search for specific transactions.</li>
                <li><strong>Date Filters:</strong> Use the toggle to show or hide accounting and creation date filters. You can filter by range for better results.</li>
                <li><strong>Apply Filters:</strong> Click <em>Search</em> to load matching results in the table below.</li>
                <li><strong>Reset Filters:</strong> Use the reset button to clear all filters and start a new search.</li>
                <li><strong>Tip:</strong> Combine filters (e.g., Branch + Date) for more precise results.</li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-3 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Accounting / Created Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Start Accounting Date</label>
                        <input type="date" id="startaccountingDate" name="StartAccountingDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">End Accounting Date</label>
                        <input type="date" id="endaccountingDate" name="EndAccountingDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>
                </div>
            </div>

            @*<hr class="my-3" />*@

            <!-- 🔹 Reference, Operation Type & Work Ticket (always visible) -->
            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Reference</label>
                    <input type="text" id="reference" name="Reference" class="form-control mb-1" placeholder="Enter Reference" />
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Operation Type</label>
                    @Html.DropDownList("OperationType",
                        new SelectList(ViewBag.OperationTypes, "Value", "Text"),
                        "Select Operation Type",
                        new { @class = "form-control select2 mb-1", @id = "OperationType" })
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Reconciliation Status</label>
                    @Html.DropDownList("WorkTicket",
                        new SelectList(ViewBag.WorkTickets, "Value", "Text"),
                        "Select Work Ticket",
                        new { @class = "form-control select2 mb-1", @id = "WorkTicket" })
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filters
                </button>
                <button id="resetFilterBtn" type="button" class="btn btn-secondary w-100"
                        onclick="document.getElementById('journalHeaderFilterForm').reset();">
                    <i class="mdi mdi-refresh"></i> Reset Filters
                </button>
            </div>
        </div>
    </form>
</div>

<div id="datalistingview">
    @Html.Partial("_SourceDataTable")
</div>

<div class="modal fade" id="SourceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            @Html.Partial("_SourceDetails")
        </div>
    </div>
</div>


