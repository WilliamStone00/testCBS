    <script>
        // ==============================
        // Load Journal Entries into DataTable
        // ==============================
        function loadJournalData() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/JournalHead/LoadJournalSourceData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectJournalFilters();

                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        name: 'Created Date',
                        render: function (data) {
                            return data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : '';
                        }
                    },
                    { data: 'Reference', name: 'Reference' },
                    { data: 'BranchName', name: 'BranchName' },
                    {
                        data: 'AccountingDate',
                        name: 'Accounting Date',
                        render: function (data) {
                            return data ? moment(data).format('DD/MM/YYYY') : '';
                        }
                    },
                    { data: 'PostMode', name: 'PostMode' },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
<div class="text-center">
        <button class="btn btn-sm btn-info view-details" data-id="${row.Id}">
            <i class="mdi mdi-eye-outline me-1"></i> Details
        </button>
</div>`;
                        }
                    }
                ]
            });
        }

        // ==============================
        // Collect Filter Values
        // ==============================
        function collectJournalFilters() {
            return {
                BranchId: $('#branchId').val(),
                Reference: $('#reference').val(),
                OperationType: $('#OperationType').val(),
                WorkTicket: $('#WorkTicket').val(),
                StartAccountingDate: $('#startaccountingDate').val(),
                EndAccountingDate: $('#endaccountingDate').val(),
                StartDate: $('#startDate').val(),
                EndDate: $('#endDate').val(),
                Options: {}
            };
        }

        // ==============================
        // Reset Filters
        // ==============================
        function resetJournalFilters() {
            $('#journalHeaderFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');
            $('#branchFilter, #dateFilters').addClass('d-none');
            loadJournalData();
        }

        // ==============================
        // Init
        // ==============================
        $(document).ready(function () {
            // Uncomment below to auto-load
            // loadJournalData();

            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                loadJournalData();
            });

            $('#resetFilterBtn').on('click', function (e) {
                e.preventDefault();
                resetJournalFilters();
            });
        });

        // ==============================
        // Optional Edit Function
        // ==============================
        // ==============================
        // Handle Details Button Click
        // ==============================
        $(document).on('click', '.view-details', function () {
            const journalId = $(this).data('id');

            if (!journalId) return;

            $.ajax({
                url: `/JournalHead/Details?id=${journalId}`,
                type: 'GET',
                success: function (partialViewHtml) {
                    // Inject the partial view into the modal container
                    $('#SourceDetailsModal .modal-content').html(partialViewHtml);

                    // Show the modal
                    const modal = new bootstrap.Modal(document.getElementById('SourceDetailsModal'));
                    modal.show();
                },
                error: function (xhr) {
                    let message = xhr.responseText || 'An error occurred while fetching details.';
                    alert(message);
                }
            });
        });

    </script>

}

