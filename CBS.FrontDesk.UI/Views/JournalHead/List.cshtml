@model CBS.FrontDesk.Data.Entity.AccountingV2.JournalHead
@using Resources
@{
    ViewBag.Title = "Work ticket Listing";
}
<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> @GlobalShared.Journal_Request
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @GlobalJournalHead.Use_the_filters_below_to_search_and_review_journal_entries_efficiently
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.FILTER_USAGE_GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>@GlobalShared.Branch_Filter:</strong> @GlobalJournalHead.Check_the_box_to_enable_branch_selection_You_can_show_or_hide_it_as_needed</li>
                <li><strong>@GlobalShared.Operation_type:</strong> @Html.Raw(@GlobalJournalHead.Choose_whether_to_view_Cash_In_or_Cash_Out_operations)</li>
                <li><strong>@GlobalShared.Reconciliation_Status:</strong> @Html.Raw(@GlobalJournalHead.Filter_between_Temporary_or_econciled_ournal_ntries)</li>
                <li><strong>@GlobalShared.Reference:</strong> @GlobalJournalHead.Enter_a_reference_number_or_keyword_to_search_for_specific_transactions</li>
                <li><strong>@GlobalShared.Date_Filters:</strong> @GlobalJournalHead.Use_the_toggle_to_show_or_hide_accounting_and_creation_date_filters_You_can_filter_by_range_for_better_results</li>
                <li><strong>@GlobalShared.Apply_filters:</strong> @Html.Raw(@GlobalJournalHead.Click_Search_to_load_matching_results_in_the_table_below)</li>
                <li><strong>@GlobalShared.Reset_Filters:</strong> @GlobalJournalHead.Use_the_reset_button_to_clear_all_filters_and_start_a_new_search</li>
                <li><strong>@GlobalShared.Tip:</strong> @GlobalJournalHead.Combine_filters_e_g_Branch_Date_for_more_precise_results</li>
            </ul>
        </div>
    </div>
</div>


@*<input type="hidden" id="JournalReference" value="@(Model?.Reference ?? "")" />
    <input type="hidden" id="JournalBranch" value="@(Model?.BranchId ?? "")" />
    <input type="hidden" id="JournalTicketType" value="@(Model?.TicketType ?? "")" />
    <input type="hidden" id="JournalState" value="@(Model?.State ?? "")" />*@



<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.ADVANCE_FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-2 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            @GlobalShared.Show_Branch_Filter
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            @GlobalShared.Show_Accounting / @GlobalShared.Created_Date_Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">@GlobalShared.Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "---"+ GlobalShared.Select_Branch +"---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Start_Accounting_Date</label>
                        <input type="date" id="startaccountingDate" name="StartAccountingDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.End_Accounting_Date</label>
                        <input type="date" id="endaccountingDate" name="EndAccountingDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Start_Date</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.End_Date</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>
                </div>
            </div>

            @*<hr class="my-3" />*@

            <!-- 🔹 Reference, Operation Type & Work Ticket (always visible) -->
        <div class="row mb-1">
            <div class="col-md-4 mb-1">
                <label class="form-label fw-bold">@GlobalShared.Reference</label>
                <input type="text" id="reference" name="Reference" class="form-control mb-1" placeholder="@GlobalShared.Enter_Reference" />
            </div>

            <div class="col-md-4 mb-1">
                <label class="form-label fw-bold">@GlobalShared.Ticket_Source</label>
                @Html.DropDownList("TicketSource",
                    new SelectList(ViewBag.TicketSource, "Value", "Text"),
                    ""+ GlobalShared.Select_Ticket_Source+"",
                    new { @class = "form-control select2 mb-1", @id = "TicketSource" })
            </div>

            <div class="col-md-4 mb-1">
                <label class="form-label fw-bold">@GlobalShared.Ticket_Source</label>
                @Html.DropDownList("Status",
                    new SelectList(ViewBag.Status, "Value", "Text"),
                    ""+ GlobalShared.Select_status+"",
                    new { @class = "form-control select2 mb-1", @id = "status" })
            </div>
        </div>
            @*<div class="row mb-1">
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Reconciliation Status</label>
                        @Html.DropDownList("OperationCode",
                            new SelectList(ViewBag.OperationCode, "Value", "Text"),
                            "Select Operation Code",
                            new { @class = "form-control select2 mb-1", @id = "OperationCode" })
                    </div>

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Ticket Source</label>
                        @Html.DropDownList("TicketSource",
                            new SelectList(ViewBag.TicketSource, "Value", "Text"),
                            "Select Ticket Source",
                            new { @class = "form-control select2 mb-1", @id = "TicketSource" })
                    </div>

                </div>*@

        </div>     <!-- Action Buttons -->





        <div class="row g-2 mt-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Apply_filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100"
                        onclick="document.getElementById('journalHeaderFilterForm').reset();">
                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset_Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btntExport" class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> @GlobalShared.Export
                </button>
            </div>
        </div>
    </form>
</div>

<div id="datalistingview">
    @Html.Partial("_SourceDataTable")
</div>

<div class="modal fade" id="SourceDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            @Html.Partial("_DestDetails")
        </div>
    </div>
</div>



<div class="modal fade" id="WorkflowExportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_ExportJournalHeadDataTable")

        </div>
    </div>
</div>






@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

<script>

        // =====================================
        // Track if filters were applied
        // =====================================
        let filtersApplied = false;

        // ==============================
        // Load Journal Entries into DataTable
        // ==============================
        function loadJournalData() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: false,
                order: [[0, 'desc']],
                ajax: {
                    url: '/JournalHead/LoadJournalSourceData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectJournalFilters();

                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    }
                },
                columns: [
                    {
                        data: 'OpenedAtUtc',
                        name: 'OpenedAtUtc',
                        render: function (data) {
                            return data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : '-';
                        }
                    },
                    {
                        data: 'ClosedAtUtc',
                        name: 'ClosedAtUtc',
                        render: function (data) {
                            return data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : '-';
                        }
                    },
                    { data: 'Reference', name: 'Reference' },
                    { data: 'CreatedBy', name: 'CreatedBy' },
                    {
                                        data: 'State',
                                        name: 'State',
                                        render: function (data) {

                                            if (!data) return '-';

                                            const state = data.toUpperCase();
                                            let badgeClass = 'bg-secondary'; // default (ash)

                                            switch (state) {
                                                case 'APPROVED':
                                                    badgeClass = 'bg-success';
                                                    break;

                                                case 'REJECTED':
                                                    badgeClass = 'bg-danger';
                                                    break;

                                                case 'INITIATED':
                                                    badgeClass = 'bg-secondary'; // ash
                                                    break;
                                            }

                                            return `
                            <span class="badge ${badgeClass}">
                                ${state}
                            </span>
                        `;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                         return `
                            <div class="text-center">
                                <button class="btn btn-sm btn-info view-details"
                                        data-id="${row.Id}"
                                        data-reference="${row.Reference}"
                                        data-branch="${row.BranchId}"
                                        data-ticket="${row.TicketType}"
                                        data-state="${row.State}"
                                        data-amount="${row.InitiatedAmount}">
                                    <i class="mdi mdi-eye-outline me-1"></i> Details
                                </button>
                            </div>`;
                        }
                    }

                ]
            });
        }

        // ==============================
        // Collect Filter Values
        // ==============================
        function collectJournalFilters() {
            return {
                BranchId: $('#branchId').val(),
                Reference: $('#reference').val(),
                OperationType: $('#OperationType').val(),
                OperationCode: $('#OperationCode').val(),
                StartAccountingDate: $('#startaccountingDate').val(),
                EndAccountingDate: $('#endaccountingDate').val(),
                TicketSource: $('#TicketSource').val(),
                StartDate: $('#startDate').val(),
                EndDate: $('#endDate').val(),
                Status: $('#status').val(),
                Options: {}
            };
        }

        // ==============================
        // Reset Filters
        // ==============================
        function resetJournalFilters() {
            $('#journalHeaderFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');
            $('#branchFilter, #dateFilters').addClass('d-none');
            //loadJournalData();
            filtersApplied = false;
        }

        // ==============================
        // INIT – Apply & Reset Filters
        // ==============================
        $(document).ready(function () {

            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                loadJournalData();
                filtersApplied = true;   // <-- IMPORTANT
            });

            $('#resetFilterBtn').on('click', function (e) {
                e.preventDefault();
                resetJournalFilters();
            });

        });
        // ============================================
        // OPEN DETAILS MODAL (AJAX LOAD)
    // ============================================


            $(document).on('click', '.view-details', function () {

            const $btn = $(this);

            const journalId = $btn.data('id');
            if (!journalId) return;

            const modal = $('#SourceDetailsModal');

            // ✅ Read directly from button (SOURCE OF TRUTH)
            const state = ($btn.data('state') || '').toUpperCase();

            modal
                .data('reference', $btn.data('reference'))
                .data('branch', $btn.data('branch'))
                .data('ticket', $btn.data('ticket'))
                .data('state', state)
                .data('user', '@User.Identity.Name');

            $.ajax({
                url: `/JournalHead/Details?id=${journalId}`,
                type: 'GET',
                success: function (html) {

                    modal.find('.modal-content').html(html);

                    bootstrap.Modal
                        .getOrCreateInstance(modal[0])
                        .show();

                    // 🔥 Apply button logic AFTER modal renders
                    applyWorkflowButtonState(state);
                },
                error: function () {
                    appalert("Failed to load journal details.", 2, 1);
                }
            });
        });


        function applyWorkflowButtonState(state) {

            if (["APPROVED", "REJECTED", "RECONCILED"].includes(state)) {

                $('#btnApprove')
                    .prop('disabled', true)
                    .removeClass('btn-success')
                    .addClass('btn-secondary');

                $('#btnReject')
                    .prop('disabled', true)
                    .removeClass('btn-danger')
                    .addClass('btn-secondary');
            }
        }







    // ============================================
    // APPROVE
    // ============================================
        $(document).on('click', '#btnApprove', function (e) {
            e.preventDefault();

            if ($(this).is(':disabled')) return;

            alertify
                .confirm(
                    "Confirmation",
                    "Are you sure you want to approve this journal entry?",

                    // ✅ OK
                    function () {

                        const $btn = $('#btnApprove');
                        const $icon = $btn.find('i');
                        const $text = $btn.find('.btn-text');

                        $btn.prop('disabled', true);
                        $icon.removeClass().addClass('mdi mdi-loading mdi-spin');
                        $text.text('Approving...');

                        const modal = $('#SourceDetailsModal');

                        const payload = {
                            Reference: modal.data('reference'),
                            BranchId: $("#sourceBranchId").val(),
                            Approver: modal.data('user'),
                            Approve: true,
                            TicketType: modal.data('ticket')
                        };

                        $.ajax({
                            url: '/JournalHead/Approve',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: function (res) {
                                if (res?.success) {
                                    appalert(res.message || "Approved successfully.", 1, 1);
                                    $('#btnApprove, #btnReject').prop('disabled', true);
                                    $icon.removeClass().addClass('mdi mdi-check-circle');
                                    $text.text('Approved');
                                } else {
                                    resetApprove();
                                    appalert(res?.message || "Approval failed.", 2, 1);
                                }
                            },
                            error: function () {
                                resetApprove();
                                appalert("Error during approval.", 2, 1);
                            }
                        });
                    },

                    // ❌ CANCEL
                    function () {
                        resetApprove();
                        appalert("🚫 Approval cancelled.", 2, 1);
                    }
                )
                .set({
                    labels: { ok: 'Yes', cancel: 'No' }
                });
        });

    function resetApprove() {
        const $btn = $('#btnApprove');
        if (!$btn.length) return;

        $btn.prop('disabled', false);
        $btn.find('i').removeClass().addClass('mdi mdi-check-circle-outline');
        $btn.find('.btn-text').text('Approve');
    }


    // ============================================
    // OPEN REJECT MODAL
    // ============================================
    $(document).on('click', '#btnReject', function () {
        if ($(this).prop('disabled')) return;
        $('#rejectModal').modal('show');
    });


    // ============================================
    // SUBMIT REJECT
    // ============================================
        // ============================================
        // SUBMIT REJECT (WITH CONFIRMATION)
        // ============================================
        $(document).on('click', '#btnSubmitReject', function () {

            const reason = $('#RejectReason').val().trim();
            if (!reason) {
                appalert("Please enter a rejection reason.", 3, 1);
                return;
            }

            alertify
                .confirm(
                    "Confirm Rejection",
                    "Are you sure you want to reject this journal entry?",

                    // ✅ YES
                    function () {

                        const modal = $('#SourceDetailsModal');

                        const payload = {
                            Reference: modal.data('reference'),
                            Approver: modal.data('user'),
                            Reason: reason,
                            BranchId: $("#sourceBranchId").val(),
                            Approver: modal.data('user'),
                            Approve: false,
                        };

                        const $btn = $('#btnSubmitReject');
                        $btn.prop('disabled', true).text('Rejecting...');

                        $.ajax({
                            url: '/JournalHead/Reject',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: function (res) {
                                if (res?.success) {
                                    appalert("Journal rejected successfully.", 1, 1);
                                    $('#rejectModal').modal('hide');
                                    $('#btnApprove, #btnReject').prop('disabled', true);
                                } else {
                                    appalert(res?.message || "Rejection failed.", 2, 1);
                                }
                            },
                            error: function () {
                                appalert("Error during rejection.", 2, 1);
                            },
                            complete: function () {
                                $btn.prop('disabled', false).text('Submit Rejection');
                            }
                        });
                    },

                    // ❌ NO
                    function () {
                        appalert("🚫 Rejection cancelled.", 2, 1);
                    }
                )
                .set({
                    labels: { ok: 'Yes', cancel: 'No' }
                });
        });



        // =====================================================
        // 🔹 EXPORT BUTTON CLICK (Open Export Modal)
        // =====================================================
        $(document).on("click", "#btntExport", function () {

            if (!filtersApplied) {
                appalert("⚠️ Please apply filters before exporting.", 2, 1);
                return;
            }

            // Open Export Modal
            const modalEl = document.getElementById('WorkflowExportModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        });


        // =====================================================
        // 🔹 CONFIRM EXPORT REQUEST
        // =====================================================
        $(document).on("click", "#btnConfirmJournalExport", function () {

            // Filters
            let filters = collectJournalFilters();

            // Export Params
            let exportOptions = {
                FileName: $("#jhFileName").val(),
                Format: $("#jhExportFormat").val(),
                ReportType: $("#jhReportType").val(),
                StartDate: $("#jhStartDate").val(),
                EndDate: $("#jhEndDate").val()
            };

            let request = {
                Filters: filters,
                ExportOptions: exportOptions
            };

            // Button loading state
            $("#btnConfirmJournalExport")
                .prop("disabled", true)
                .html(`<span class="spinner-border spinner-border-sm"></span> Exporting...`);

            $.ajax({
                url: '/JournalHead/ExportWorkflowData',
                type: "POST",
                data: JSON.stringify(request),
                contentType: "application/json",
                xhrFields: { responseType: 'blob' },
                success: function (data, status, xhr) {

                    let disposition = xhr.getResponseHeader("Content-Disposition");
                    let filename = "JournalHeader.xlsx";

                    if (disposition && disposition.indexOf("filename=") !== -1) {
                        filename = disposition.split("filename=")[1].trim();
                    }

                    let blob = new Blob([data]);
                    let link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = filename;
                    link.click();

                    // Close modal
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById("WorkflowExportModal")
                    ).hide();

                    toastr.success("Export completed.");
                },
                error: function () {
                    toastr.error("Export failed.");
                },
                complete: function () {
                    $("#btnConfirmJournalExport")
                        .prop("disabled", false)
                        .html(`<i class="mdi mdi-export"></i> Export`);
                }
            });




        });


   

        $(document).on('click', '#btnExportExcel', function () {

            const id = $('#ExcelId').val(); // ✅ from hidden input

            console.log('📤 Export Excel ID:', id);

            if (!id) {
                appalert("❌ Invalid journal ID!", 2, 1);
                return;
            }

            window.location.href =
                '/JournalHead/DownloadJournalHeadExcel?id=' + id;
        });

    



</script>

    
   




    <script>
        $(document).ready(function () {

            // =====================================================
            // GLOBALS
            // =====================================================
            let accounts = [];

            function getModal() {
                return $('#SourceDetailsModal');
            }

            function getInitiatedAmount() {
                return Math.abs(parseFloat(getModal().data('amount'))) || 0;
            }

            function getDestState() {
                return (getModal().data('state') || '').toUpperCase();
            }

            // =====================================================
            // UTILITIES
            // =====================================================
            function initSelect2(element) {
                element.select2({
                    width: '100%',
                    placeholder: 'Select Account',
                    allowClear: true,
                    dropdownParent: getModal()
                });
            }

            window.autoGrow = function (el) {
                el.style.height = 'auto';
                el.style.height = el.scrollHeight + 'px';
            };

            // =====================================================
            // LOAD ACCOUNTS
            // =====================================================
            function loadAccounts(branchId, callback) {

                if (!branchId) {
                    appalert("⚠️ Please select a branch first.", 2, 1);
                    return;
                }

                if (loadAccounts.request) loadAccounts.request.abort();

                loadAccounts.request = $.ajax({
                    url: '/ManualJournalEntry/GetAccounts',
                    type: 'GET',
                    data: { branchId },
                    success: function (res) {

                        if (!res?.success || !res.data) {
                            appalert(res?.message || '⚠️ No accounts found.', 2, 1);
                            accounts = [];
                            return;
                        }

                        accounts = res.data.map(a => ({
                            Value: a.Value,
                            Text: a.Text
                        }));

                        appalert('✅ Accounts loaded.', 1, 1);
                        callback && callback();
                    },
                    error: function (err) {
                        if (err.statusText !== 'abort')
                            appalert("❌ Error loading accounts.", 0, 1);
                    }
                });
            }

            // =====================================================
            // ADD ROW
            // =====================================================
            function addRow(tableBody) {

                const row = $(`
                                <tr>
                                    <td style="width:35%">
                                        <select class="form-select account-select account-id" required>
                                            <option value="">Select Account</option>
                                            ${accounts.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                                        </select>
                                    </td>
                                    <td style="width:25%">
                                        <textarea class="form-control memo" rows="1"
                                            placeholder="Enter memo"
                                            oninput="autoGrow(this)" required></textarea>
                                    </td>
                                    <td style="width:15%">
                                        <input type="number" step="0.01" class="form-control debit-input" min="0">
                                    </td>
                                    <td style="width:15%">
                                        <input type="number" step="0.01" class="form-control credit-input" min="0">
                                    </td>
                                    <td class="text-center" style="width:10%">
                                        <button type="button" class="btn btn-sm btn-outline-danger deleteRow">
                                            <i class="mdi mdi-delete"></i>
                                        </button>
                                    </td>
                                </tr>
                            `);

                tableBody.append(row);
                initSelect2(row.find('.account-select'));
            }

            // =====================================================
            // TOTALS & APPROVE LOGIC
            // =====================================================
            function updateTotals() {
                const modal = getModal();
                let debitTotal = 0, creditTotal = 0;

                // Sum only rows with account and amount
                modal.find('#myDataTable tbody tr').each(function () {
                    const dr = parseFloat($(this).find('.debit-input').val()) || 0;
                    const cr = parseFloat($(this).find('.credit-input').val()) || 0;
                    const acc = $(this).find('.account-id').val();

                    if (acc && (dr || cr)) {
                        debitTotal += dr;
                        creditTotal += cr;
                    }
                });

                const diff = debitTotal - creditTotal;

                modal.find('#totalDebit').text(`XAF ${debitTotal.toLocaleString()}`);
                modal.find('#totalCredit').text(`XAF ${creditTotal.toLocaleString()}`);
                modal.find('#difference')
                    .text(`Diff: XAF ${diff.toLocaleString()}`)
                    .toggleClass('text-danger', diff !== 0)
                    .toggleClass('text-success', diff === 0);

                // Enable approve only if totals match and at least 1 filled row
                const hasFilledRow = debitTotal > 0 || creditTotal > 0;
                const canApprove = hasFilledRow && diff === 0;

                const btn = $('#btnApproveDestination');
                btn.prop('disabled', !canApprove)
                    .removeClass('btn-secondary')
                    .toggleClass('btn-success', canApprove);
            }

            // =====================================================
            // MODAL INIT
            // =====================================================
            $('#SourceDetailsModal').on('shown.bs.modal', function () {

                const modal = getModal();
                const tableBody = modal.find('#myDataTable tbody').empty();
                const branchId = modal.data('branch');

                if (!branchId) {
                    appalert("⚠️ Branch not found.", 2, 1);
                    return;
                }

                loadAccounts(branchId, () => addRow(tableBody));
            });

            // =====================================================
            // TABLE EVENTS
            // =====================================================
            $(document)
                .on('click', '#addRowBtn', function () {
                    if (!accounts.length) {
                        appalert("⚠️ Load accounts first.", 2, 1);
                        return;
                    }
                    addRow($('#myDataTable tbody'));
                })
                .on('click', '.deleteRow', function () {
                    $(this).closest('tr').remove();
                    updateTotals();
                })
                .on('input', '.debit-input', function () {
                    const row = $(this).closest('tr');
                    row.find('.credit-input').prop('disabled', this.value > 0).val('');
                    updateTotals();
                })
                .on('input', '.credit-input', function () {
                    const row = $(this).closest('tr');
                    row.find('.debit-input').prop('disabled', this.value > 0).val('');
                    updateTotals();
                });

            // =====================================================
            // DESTINATION APPROVE
            // =====================================================
            $(document).off('click', '#btnApproveDestination').on('click', '#btnApproveDestination', function (e) {
                e.preventDefault();

                const modal = getModal();

                alertify.confirm(
                    "Confirmation",
                    "Approve this journal entry?",
                    function () {

                        const btn = $('#btnApproveDestination').prop('disabled', true);
                        btn.find('i').removeClass().addClass('mdi mdi-loading mdi-spin');

                        const payload = {
                            Reference: modal.data('reference'),
                            BranchId: $('#sourceBranchId').val(),
                            Approver: modal.data('user'),
                            Approver: true,
                            TicketType: modal.data('ticket'),
                            Lines: []
                        };

                        $('#myDataTable tbody tr').each(function () {
                            const dr = parseFloat($(this).find('.debit-input').val()) || 0;
                            const cr = parseFloat($(this).find('.credit-input').val()) || 0;
                            const acc = $(this).find('.account-id').val();

                            if (acc && (dr || cr)) {
                                payload.Lines.push({
                                    AffiliateAccountId: acc,
                                    DrCr: dr > 0 ? 'DR' : 'CR',
                                    Amount: dr || cr,
                                    Memo: $(this).find('.memo').val()
                                });
                            }
                        });

                        $.ajax({
                            url: '/JournalHead/Approve',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: function (r) {
                                appalert(r?.message || "✅ Approved.", 1, 1);
                                btn.find('i').removeClass().addClass('mdi mdi-check-circle');
                            },
                            error: function () {
                                appalert("❌ Approval failed.", 0, 1);
                                btn.prop('disabled', false);
                                btn.find('i').removeClass().addClass('mdi mdi-check-circle-outline');
                            }
                        });
                    },
                    function () {
                        appalert("🚫 Approval cancelled.", 2, 1);
                    }
                );
            });


