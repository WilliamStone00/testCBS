@model CBS.FrontDesk.Data.Entity.DailyCollectorManagement.DailyCollectionConfiguration
@using Resources



<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "DailyCollectionSetting", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    <input type="hidden" name="ServiceOption" value="zone" id="ServiceOption" />
                    <div class="row mt-2 gy-4">
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Zone.Name, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Zone.Name, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Zone</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.Zone.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "---Select Branch---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.Zone.BranchId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Select_Branch</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                             
                                @Html.TextAreaFor(m => m.Zone.Description, new { @class = "form-control", @style = "height: 200px;" })
                                @Html.ValidationMessageFor(m => m.Zone.Description, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Zone_Description</label>
                            </div>
                        </div>
                     
                    </div>
                    <div class="mt-4">
                        @if (Model.Zone.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2"> @GlobalShared.Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2"> @GlobalShared.Update</button>
                        @Html.HiddenFor(m => m.Zone.Id)
                        <input type="hidden" name="Action" value="update" id="Action" />
                    }
                    </div>
                }

            </div>
        </div>
    </div>
</div>
