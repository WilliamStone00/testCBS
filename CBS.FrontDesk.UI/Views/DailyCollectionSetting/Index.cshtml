
@{
    ViewBag.Title = "DailyCollectionSettings";

}
@using Resources

<div class="row">
    <div class="col-12">
        <!-- Commission Configuration Guide (Collapsible) -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center text-primary bg-light">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i>
                    @DailyCollectionSettingRessource.COMMISSION_CONFIGURATION_GUIDE
                </span>
                <button class="btn btn-outline-primary btn-sm"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseGuide"
                        aria-expanded="true"
                        aria-controls="collapseGuide">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>
            <div id="collapseGuide" class="collapse">
                <div class="card-body">
                    <!-- Quick Start Tip -->
                    <div class="alert alert-info mb-4">
                        <strong><i class="mdi mdi-lightbulb-on-outline me-2"></i>@GlobalShared.Quick_Start:</strong>
                        @DailyCollectionSettingRessource.Select_Transction_operation_type_Choose_commission_provider_Configure_commission_structure_Set_scope
                    </div>

                    <!-- Configuration Types Section -->
                    <h5 class="text-primary mb-3 border-bottom pb-2">
                        <i class="mdi mdi-cog-outline me-2"></i>
                        @DailyCollectionSettingRessource.COMMISSION_TYPES
                    </h5>

                    <div class="row g-3 mb-4">
                        <!-- Proportional Commission -->
                        <div class="col-md-4">
                            <div class="card border-success h-100">
                                <div class="card-header bg-light-success text-success d-flex align-items-center">
                                    <i class="mdi mdi-percent me-2"></i>
                                    <strong>@DailyCollectionSettingRessource.Proportional</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Percentage_based_commissions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.For_revenue_sharing_models</li>
                                        <li>@DailyCollectionSettingRessource.When_transaction_amounts_vary</li>
                                        <li>@DailyCollectionSettingRessource.For_stakeholder_profit_distribution</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-success">
                                        <strong>@DailyCollectionSettingRessource.How_to_configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>Select <span class="badge bg-success">@DailyCollectionSettingRessource.Proportional</span></li>
                                            <li>Set provider share (e.g., 70%)</li>
                                            <li>Set agent share (e.g., 30%)</li>
                                            <li class="text-danger">@DailyCollectionSettingRessource.Total_must_equal_100 %</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: ₦1000 transaction → Provider:₦700, Agent:₦300
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fixed Amount -->
                        <div class="col-md-4">
                            <div class="card border-warning h-100">
                                <div class="card-header bg-light-warning text-warning d-flex align-items-center">
                                    <i class="mdi mdi-cash me-2"></i>
                                    <strong>@GlobalShared.Fixed_Amount</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Flat_rate_commissions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.For_standardized_fees</li>
                                        <li>@DailyCollectionSettingRessource.When_transaction_amount_doesnt_matter</li>
                                        <li>@DailyCollectionSettingRessource.For_simple_commission_structures</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-warning">
                                        <strong>@DailyCollectionSettingRessource.How_to_configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>@GlobalShared.Select <span class="badge bg-warning text-dark">@GlobalShared.Fixed</span></li>
                                            <li>@DailyCollectionSettingRessource.Enter_fixed_amount (e.g., ₦50)</li>
                                            <li>@DailyCollectionSettingRessource.Same_amount_applies_per_transaction</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: ₦50 fee per transaction
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Interbranch -->
                        <div class="col-md-4">
                            <div class="card border-info h-100">
                                <div class="card-header bg-light-info text-info d-flex align-items-center">
                                    <i class="mdi mdi-bank-transfer me-2"></i>
                                    <strong>@DailyCollectionSettingRessource.Interbranch</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Cross_branch_transactions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.For_branch_to_branch_transfers</li>
                                        <li>@DailyCollectionSettingRessource.When_revenue_sharing_between_branches</li>
                                        <li>@DailyCollectionSettingRessource.Special_commission_arrangements</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-info">
                                        <strong>@DailyCollectionSettingRessource.How_to_configure:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>@GlobalShared.Enable <span class="badge bg-info">@DailyCollectionSettingRessource.Interbranch</span></li>
                                            <li>@DailyCollectionSettingRessource.Set_source_destination_rules</li>
                                            <li>@DailyCollectionSettingRessource.Configure_special_rates_if_needed</li>
                                        </ol>
                                    </div>
                                    <div class="alert alert-sm alert-warning mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i> Example: 1% fee on interbranch transfers
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scope Configuration Section -->
                    <h5 class="text-primary mb-3 border-bottom pb-2">
                        <i class="mdi mdi-target me-2"></i>
                        @DailyCollectionSettingRessource.SCOPE_CONFIGURATION
                    </h5>

                    <div class="row g-3 mb-4">
                        <!-- Global -->
                        <div class="col-md-4">
                            <div class="card border-primary h-100">
                                <div class="card-header bg-light-primary text-primary d-flex align-items-center">
                                    <i class="mdi mdi-earth me-2"></i>
                                    <strong>@GlobalShared.Global</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Organization_wide_defaults</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.Base_configuration_for_all</li>
                                        <li>@DailyCollectionSettingRessource.Fallback_for_specific_cases</li>
                                        <li>@DailyCollectionSettingRessource.Standard_commission_rules</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-primary">
                                        <strong>@DailyCollectionSettingRessource.How_to_set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>@GlobalShared.Select <span class="badge bg-primary">@GlobalShared.Global</span></li>
                                            <li>@DailyCollectionSettingRessource.Applies_to_all_branches_agents</li>
                                            <li>@DailyCollectionSettingRessource.Overridden_by_specific_settings</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Branch -->
                        <div class="col-md-4">
                            <div class="card border-warning h-100">
                                <div class="card-header bg-light-warning text-warning d-flex align-items-center">
                                    <i class="mdi mdi-bank-circle-outline me-2"></i>
                                    <strong>@GlobalShared.Branch</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Branch_specific_rules</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.Regional_variations</li>
                                        <li>@DailyCollectionSettingRessource.Special_branch_arrangements</li>
                                        <li>@DailyCollectionSettingRessource.Override_global_settings</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-warning">
                                        <strong>@DailyCollectionSettingRessource.How_to_set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>@GlobalShared.Select <span class="badge bg-warning text-dark">@GlobalShared.Branch</span></li>
                                            <li>@DailyCollectionSettingRessource.Choose_branch_from_dropdown</li>
                                            <li>@DailyCollectionSettingRessource.Applies_to_all_agents_in_branch</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Agent -->
                        <div class="col-md-4">
                            <div class="card border-info h-100">
                                <div class="card-header bg-light-info text-info d-flex align-items-center">
                                    <i class="mdi mdi-account-circle me-2"></i>
                                    <strong>@GlobalShared.Agent</strong>
                                </div>
                                <div class="card-body">
                                    <p class="small mb-2"><strong>@DailyCollectionSettingRessource.When_to_use:</strong> @DailyCollectionSettingRessource.Individual_exceptions</p>
                                    <ul class="small ps-3 mb-3">
                                        <li>@DailyCollectionSettingRessource.Special_agent_agreements</li>
                                        <li>@DailyCollectionSettingRessource.Performance_based_commissions</li>
                                        <li>@DailyCollectionSettingRessource.Override_all_other_settings</li>
                                    </ul>
                                    <div class="alert alert-sm alert-light-info">
                                        <strong>@DailyCollectionSettingRessource.How_to_set:</strong>
                                        <ol class="mb-0 ps-3">
                                            <li>@GlobalShared.Select <span class="badge bg-info">@GlobalShared.Agent</span></li>
                                            <li>@DailyCollectionSettingRessource.Choose_agent_from_dropdown</li>
                                            <li>@DailyCollectionSettingRessource.Applies_only_to_this_agent</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Best Practices -->
                    <div class="alert alert-light mt-3">
                        <h6 class="alert-heading text-primary">
                            <i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalShared.Best_Practices
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li><strong>@GlobalShared.Test first:</strong> @DailyCollectionSettingRessource.Use_Preview_before_saving</li>
                            <li><strong>@GlobalShared.Hierarchy:</strong> @GlobalShared.Global → @GlobalShared.Branch → @GlobalShared.Agent</li>
                            <li><strong>@GlobalShared.Document:</strong> @DailyCollectionSettingRessource.Note_special_arrangements</li>
                            <li><strong>@GlobalShared.Review:</strong> @DailyCollectionSettingRessource.Audit_quarterly_for_updates</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Commission Management Accordion -->
        <div class="accordion mb-4" id="commissionAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommission" aria-expanded="true" aria-controls="collapseCommission">
                        <i class="mdi mdi-book-account-outline me-2"></i>
                        @DailyCollectionSettingRessource.COMMISSION_MANAGEMENT
                    </button>
                </h2>
                <div id="collapseCommission" class="accordion-collapse collapse show" data-bs-parent="#commissionAccordion">
                    <div class="accordion-body">
                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end mb-3">
                            <div class="btn-group">
                                <button class="btn btn-outline-primary btn-sm"
                                        onclick="LoadDataGeneration('DailyCollectionSetting','myDataTable','_CommissionSettingData','datalistingview_CommissionSetting',0,'commissionSetting','list')">
                                    <i class="mdi mdi-view-list me-1"></i> @GlobalShared.View_List
                                </button>
                                <button class="btn btn-outline-success btn-sm"
                                        onclick="AddORUpdateGen(null,'datalistingview_CommissionSetting','_CreateCommissionSetting','new','DailyCollectionSetting','commissionSetting')">
                                    <i class="mdi mdi-plus me-1"></i> @GlobalShared.Add_New_LC
                                </button>
                            </div>
                        </div>

                        <!-- Content -->
                        <div id="datalistingview_CommissionSetting">
                            @Html.Partial("_CreateCommissionSetting")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link href="~/CBSTemp/ui/assets/css/Commission.css" rel="stylesheet" />
}


@section Scripts {@Scripts.Render("~/bundles/jqueryval")


<script src="~/Scripts/Js/CommissionManagement/CommissionManagement.js"></script>
<script src="~/Scripts/Js/AccountEventConfigurtion/MFIChartOfAccount.js"></script>
<script src="~/Scripts/Js/main.js/Account.js"></script>
}
