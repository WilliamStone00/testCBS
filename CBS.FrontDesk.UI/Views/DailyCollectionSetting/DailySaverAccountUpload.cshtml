
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

 
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-check me-2"></i> DAILYSAVER MIGRATION
                </h1>
                <p class="card-text">
                    This interface gives the possibility to migrate data dailyasvers  into the TRUSTSOFTCREDIT by the daily collector.
                </p>
                <p class="card-text text-warning fw-bold"> 
                    <i class="mdi mdi-alert-circle-outline me-1"></i> In case of any difficulty kindly contact system administrator.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR MIGRATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Scenario:</strong> I want use and account that is not currently created in the system.</li>
                <li><i class="mdi mdi-check-circle-outline  text-primary me-2"></i> <strong>Action:  </strong>Go on account management and fill the form acccordingly.</li>


            </ul>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card mb-4">
        <h5 class="card-title"></h5>
        <div class="card-body">
            <div class="card-body">
                <div class="upload-container">
                    <div class="upload-header">
                        <h1>📊 Excel File Upload</h1>
                        <p>Upload your Excel files to process data</p>
                    </div>

                    <div class="file-constraints">
                        <h3>File Requirements:</h3>
                        <ul>
                            <li>Accepted formats: .xlsx, .xls</li>
                            <li>Maximum file size: 3.0 MB</li>
                            <li>Single file upload</li>
                        </ul>
                    </div>

                    <form class="upload-form" id="uploadForm" enctype="multipart/form-data">
                        <div class="file-input-container" id="fileInputContainer">
                            <input type="file" class="file-input" id="fileInput" name="excelFile" accept=".xlsx,.xls" required>
                            <div class="file-input-content">
                                <span class="upload-icon">📁</span>
                                <div class="file-input-text">Choose Excel File or Drag & Drop</div>
                                <div class="file-input-subtext">Support for .xlsx and .xls files up to 3MB</div>
                            </div>
                        </div>

                        <div class="file-info" id="fileInfo">
                            <div class="file-details">
                                <span class="file-name" id="fileName"></span>
                                <span class="file-size" id="fileSize"></span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" id="progressFill"></div>
                            </div>
                        </div>

                        <button type="submit" class="upload-button" id="uploadButton">
                            <span class="loading-spinner" id="loadingSpinner"></span>
                            <span id="buttonText">Upload File</span>
                        </button>
                    </form>

                    <div class="message" id="message"></div>
                </div>

          
               

            </div>
        </div>
    </div>
</div>
