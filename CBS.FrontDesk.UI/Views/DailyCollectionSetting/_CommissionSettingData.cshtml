@model CBS.FrontDesk.Data.Entity.DailyCollDailyCollectorManagement.DailyCollectionConfiguration
@using Resources

@{
    ViewBag.Title = "CommissionSettings List";
}




<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th> @GlobalShared.Operation_type</th>
            <th> @GlobalShared.Type</th>
            <th> @GlobalShared.Provider</th>
            <th> @GlobalShared.Scope</th>
            <th> @GlobalShared.InterBranch</th>
            <th> @GlobalShared.AgentShare</th>
            <th> @GlobalShared.ProviderShare</th>
            <th> @DailyCollectionSettingRessource.AmountPerTransaction</th>
            <th> @GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var d in Model.CommissionSettings)
        {
            <tr>
                <td>@d.OperationType</td>
                <td>@(d.IsProportional ? "Proportional" : "Fixed")</td>
                <td>@d.ProviderType</td>
                <td>
                    @(
              d.IsGlobal ? "Global" :
              d.IsBranch ? "Branch" :
              d.IsAgent ? "Agent" : "-"
          )
                </td>
                <td>@(d.IsInterbranch ?  "YES" :  "NO")</td>
                <td>@(d.AgentShare)%</td>
                <td>@(d.CommissionProviderShare)%</td>
                <td>@d.AgentShare</td>
                <td>
                    <a href="#" class="btn btn-dark" onclick="AddORUpdateGen('@d.Id','datalistingview_CommissionSetting','_CreateCommissionSetting','update','DailyCollectionSetting','commissionSetting')" class="Modelr-2" data-toggle="tooltip" title="Edit">
                        @GlobalShared.Edit
                    </a> |
                    <a href="#" class="btn btn-danger" onclick="DeleteData('DailyCollectionSetting','@d.Id','myDataTable','_CommissionSettingData',0,'datalistingview_CommissionSetting','commissionSetting')" class="text-danger" data-toggle="tooltip" title="Delete">
                        @GlobalShared.Delete
                    </a>
                </td>
            </tr>
        }



    </tbody>
</table>
