@model CBS.FrontDesk.Data.Entity.DailyCollectorManagement.DailyCollectionConfiguration



<div class="row">
    <div class="col-12 card-body">
        <div class="card mb-12">
            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "DailyCollectionSetting", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    <input type="hidden" name="ServiceOption" value="agentDailyCashLimit" id="ServiceOption" />
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.AgentDailyCashLimit.cashIn, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Daily Cash-In Limit" })
                                @Html.ValidationMessageFor(m => m.AgentDailyCashLimit.cashIn, "", new { @class = "text-danger" })
                                <label>Daily Cash-In Limit</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.AgentDailyCashLimit.cashOut, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Daily Cash-Out Limit" })
                                @Html.ValidationMessageFor(m => m.AgentDailyCashLimit.cashOut, "", new { @class = "text-danger" })
                                <label>Daily Cash-Out Limit</label>
                            </div>
                        </div>


                        <div class="col-md-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AgentDailyCashLimit.Isglobal, new { @class = "form-check-input", id = "isGlobalChk" })
                                <label class="form-check-label" for="isGlobalChk">Global Setting</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AgentDailyCashLimit.IsBranch, new { @class = "form-check-input", id = "isBranchChk" })
                                <label class="form-check-label" for="isBranchChk">Branch Level</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AgentDailyCashLimit.IsAgent, new { @class = "form-check-input", id = "isAgentChk" })
                                <label class="form-check-label" for="isAgentChk">Agent Level</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.DropDownListFor(m => m.AgentDailyCashLimit.branchId, new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Value", "Text"), "---Select Branch---", new { @class = "form-control select2" })
                                @Html.ValidationMessageFor(m => m.AgentDailyCashLimit.branchId, "", new { @class = "text-danger" })
                                <label>Select Branch</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.DropDownListFor(m => m.AgentDailyCashLimit.agentId, new SelectList(ViewBag.Agents ?? new List<SelectListItem>(), "Value", "Text"), "---Select Agent---", new { @class = "form-control select2" })
                                @Html.ValidationMessageFor(m => m.AgentDailyCashLimit.agentId, "", new { @class = "text-danger" })
                                <label>Select Agent</label>
                            </div>
                        </div>

                        <div class="mt-4">
                            @if (Model.AgentDailyCashLimit.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2"> Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                            }
                            else
                            { <button type="submit" class="btn btn-primary me-2"> Update</button>
                                @Html.HiddenFor(m => m.AgentDailyCashLimit.Id)
                                <input type="hidden" name="Action" value="update" id="Action" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
