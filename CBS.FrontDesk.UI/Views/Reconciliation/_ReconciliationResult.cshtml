@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.TrialBalanceReconciliationData

<div class="modal fade" id="reconciliationResultModal" tabindex="-1" aria-hidden="true"
     data-branchid="@Model.BranchId" data-branchaccountid="@Model.BranchAccountId">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-scale-balance me-2"></i> Trial Balance Reconciliation Result
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                @* Anti-forgery token for fetch POST *@
                @Html.AntiForgeryToken()

                <!-- Tips Section -->
                <div class="card mb-4">
                    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
                        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips</span>
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseReconGuidance" aria-expanded="false"
                                aria-controls="collapseReconGuidance">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseReconGuidance" class="collapse">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-primary">Understanding the Difference</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-check-circle text-success me-2"></i><strong>Surplus:</strong> Member balance is greater than trial balance</li>
                                        <li><i class="mdi mdi-alert-circle text-warning me-2"></i><strong>Deficit:</strong> Trial balance is greater than member balance</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-primary">Next Steps</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Select the appropriate GL account</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Choose surplus or deficit</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Review and confirm reconciliation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reconciliation Results -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-calculator me-2"></i>Balance Comparison</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-warning">@Model.AccountType</h5>
                                            <small class="text-muted">Account Type Selected</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-primary">@Model.MemberBalance.ToString("N2")</h5>
                                            <small class="text-muted">Member Balance</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div>
                                            <h5 class="text-info">@Model.TrialBalanceBalance.ToString("N2")</h5>
                                            <small class="text-muted">Trial Balance</small>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="text-center">
                                    <h4 class="@(Model.IsMemberBalanceGreater ? "text-success" : "text-danger")">
                                        Difference: @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                    </h4>
                                    <p class="mb-0">
                                        <i class="mdi @(Model.IsMemberBalanceGreater ? "mdi-arrow-up-bold text-success" : "mdi-arrow-down-bold text-warning") me-1"></i>
                                        @Model.Statement
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-information-outline me-2"></i>Reconciliation Details</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Branch Code:</strong></td>
                                        <td>@Model.BRANCHName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Source GL:</strong></td>
                                        <td>@Model.BranchAccountName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Trial Side:</strong></td>
                                        <td><span class="badge bg-secondary">@Model.TrialSide</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <span class="badge @(Model.MemberBalance == Model.TrialBalanceBalance ? "bg-success" : "bg-warning")">
                                                @(Model.MemberBalance == Model.TrialBalanceBalance ? "Balanced" : "Needs Adjustment")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Memo & Accounting Date aligned perfectly -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <!-- Memo Field -->
                            <div class="col-12 col-md-8 d-flex flex-column">
                                @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                                @Html.TextBoxFor(m => m.Memo, new { @class = "form-control", placeholder = "Memo", maxlength = "80" })
                                @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger" })
                            </div>

                            <!-- Accounting Date Field -->
                            <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                                <label for="AccountingDay" class="form-label mb-1">
                                    📅 Accounting Date
                                </label>
                                @Html.TextBoxFor(
                                    m => m.AccountingDate,
                                    new
                                    {
                                        @class = "form-control accounting-date",
                                        type = "date",
                                        id = "AccountingDay",
                                        required = "required",
                                        value = DateTime.Today.ToString("yyyy-MM-dd"),
                                        max = DateTime.Today.ToString("yyyy-MM-dd")
                                    })
                                @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Adjustment Section — only rendered when there is a difference (your original logic) -->
                @if (Model.MemberBalance != Model.TrialBalanceBalance)
                {
                    <div class="card" id="adjustmentCard">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="mdi mdi-adjust me-2"></i>Reconciliation Adjustment</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="DiffBranchAccountId" class="form-label fw-semibold">Select GL Account for Adjustment</label>
                                        @Html.DropDownListFor(m => m.DiffBranchAccountId,
                                            new SelectList(ViewBag.DiifBrachAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                                            "--- Select Branch Account ---",
                                            new { @class = "form-control select2", id = "DiffBranchAccountId" })
                                        @Html.ValidationMessageFor(m => m.DiffBranchAccountId, "", new { @class = "text-danger" })
                                        <div class="form-text">Choose the GL account to apply the adjustment</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Adjustment Type</label>
                                        <div class="mt-2">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="surplus" value="surplus"
                                                       @(Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-success" for="surplus">
                                                    <i class="mdi mdi-plus-circle-outline me-1"></i>Surplus
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="deficit" value="deficit"
                                                       @(!Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-warning" for="deficit">
                                                    <i class="mdi mdi-minus-circle-outline me-1"></i>Deficit
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-text">
                                            @if (Model.IsMemberBalanceGreater)
                                            {
                                                <span class="text-success">Member balance is greater - typically use Surplus</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Trial balance is greater - typically use Deficit</span>
                                            }
                                        </div>
                                        <hr />
                                        <div>
                                            <strong>Difference Amount:</strong>
                                            <span class="fs-5 ms-2 @(Model.IsMemberBalanceGreater ? "text-success" : "text-warning")">
                                                @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Reconcile button aligned to the right *@
                            <div class="d-flex justify-content-end mt-4">
                                <button type="button" id="btnFinalReconcile" class="btn btn-primary">
                                    <i class="mdi mdi-check-all me-1"></i>Reconcile
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center">
                        <i class="mdi mdi-check-circle-outline me-2 fs-4"></i>
                        <strong>Balances are already reconciled!</strong> No adjustment needed.
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    // Store server-side values in data attributes to avoid JavaScript injection issues
    $('#reconciliationResultModal').data('memberbalance', @Model.MemberBalance)
                                   .data('trialbalancebalance', @Model.TrialBalanceBalance)
                                   .data('accounttype', '@Html.Raw(Model.AccountType)')
                                   .data('branchaccountname', '@Html.Raw(Model.BranchAccountName)')
                                   .data('mode', '@Model.Mode')
                                   .data('trialbalancestagingid', '@(Model.TrialBalanceStagingId ?? "")');

    $(function () {
        console.log('Reconciliation modal script loaded');

        // Grab modal and its data attributes
        const $modal = $('#reconciliationResultModal');
        const branchId = $modal.data('branchid');
        const sourceBranchAccountId = $modal.data('branchaccountid');

        console.log('Modal data - BranchId:', branchId, 'BranchAccountId:', sourceBranchAccountId);

        // Bind finalize button (only exists when there is a difference)
        $('#btnFinalReconcile').on('click', function () {
            finalizeReconciliation();
        });
    });

    function finalizeReconciliation() {
        const selectedAccount = $('#DiffBranchAccountId').val();
        const selectedAccountText = $('#DiffBranchAccountId option:selected').text();
        const memo = $('#Memo').val();
        const accountingDay = $('#AccountingDay').val();
        const adjustmentType = $('input[name="adjustmentType"]:checked').val();
        const modal = $('#reconciliationResultModal');
        const branchId = modal.data('branchid');
        const sourceBranchAccountId = modal.data('branchaccountid');

        console.log('Branch Account:', branchId, 'selectedAccount:', selectedAccount);

        // Validation
        if (!selectedAccount) {
            console.log('checkfinal:', selectedAccount);
            if (typeof appalert === 'function') {
                appalert('Please select a GL account for adjustment.', 3, 1);
            } else {
                alert('Please select a GL account for adjustment.');
            }
            return;
        }

        if (!accountingDay) {
            console.log('checkfinal:', accountingDay);
            if (typeof appalert === 'function') {
                appalert('Please select Accounting day.', 3, 1);
            } else {
                alert('Please select accounting day.');
            }
            return;
        }
        if (!memo) {
            console.log('checkfinal:', memo);
            if (typeof appalert === 'function') {
                appalert('Please Enter Memo.', 3, 1);
            } else {
                alert('Please Enter Memo.');
            }
            return;
        }

        if (!adjustmentType) {
            if (typeof appalert === 'function') {
                appalert('Please select adjustment type (Surplus or Deficit).', 3, 1);
            } else {
                alert('Please select adjustment type (Surplus or Deficit).');
            }
            return;
        }

        // Get server-side values from data attributes (safe approach)
        const memberBalance = parseFloat(modal.data('memberbalance'));
        const trialBalanceBalance = parseFloat(modal.data('trialbalancebalance'));
        const difference = Math.abs(memberBalance - trialBalanceBalance);

        // Get string values from data attributes
        const accountType = modal.data('accounttype');
        const sourceBranchAccountName = modal.data('branchaccountname');
        const mode = modal.data('mode'); // This is a string like "member" or "loan"
        const trialBalanceStagingId = modal.data('trialbalancestagingid');

        const requestData = {
            BranchId: branchId,
            TrialBalanceBranchAccountId: sourceBranchAccountId,
            DiffBranchAccountId: selectedAccount,
            SurplusDeficit: adjustmentType,
            MemberBalance: memberBalance,
            TrialBalanceBalance: trialBalanceBalance,
            Difference: difference,
            TrialBalanceStagingId: trialBalanceStagingId,
            Memo: memo,
            AccountingDate: accountingDay,
            AccountType: accountType,
            Mode: mode,
            SourceBranchAccountName: sourceBranchAccountName
        };

        console.log('Request data:', requestData);

        const status = adjustmentType === 'surplus' ? 'Surplus' : 'Deficit';

        const message = `
        <div style="max-height: 600px; overflow-y: auto; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
            <!-- Header -->
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px 8px 0 0; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="background: rgba(255,255,255,0.2); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="mdi mdi-shield-check" style="font-size: 20px;"></i>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-weight: 600; font-size: 1.4rem;">Confirm Reconciliation</h3>
                        <p style="margin: 4px 0 0 0; opacity: 0.9; font-size: 0.9rem;">Review all details before proceeding</p>
                    </div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                <!-- Configuration Card -->
                <div style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <i class="mdi mdi-cog-outline" style="color: #667eea; font-size: 18px;"></i>
                        <h4 style="margin: 0; color: #495057; font-size: 1rem; font-weight: 600;">Configuration</h4>
                    </div>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #6c757d; font-weight: 500; width: 40%;">Mode:</td>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6;">
                                <span style="background: #667eea; color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500;">${mode.toUpperCase()}</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #6c757d; font-weight: 500;">Account Type:</td>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #495057; font-weight: 500;">${accountType}</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 8px; color: #6c757d; font-weight: 500;">Adjustment:</td>
                            <td style="padding: 10px 8px;">
                                <span style="background: ${status === 'Surplus' ? '#28a745' : '#ffc107'}; color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500;">
                                    ${status.toUpperCase()}
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Amounts Card -->
                <div style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <i class="mdi mdi-calculator" style="color: #667eea; font-size: 18px;"></i>
                        <h4 style="margin: 0; color: #495057; font-size: 1rem; font-weight: 600;">Amounts</h4>
                    </div>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #6c757d; font-weight: 500; width: 40%;">Member Balance:</td>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #495057; font-weight: 600; text-align: right;">${memberBalance.toLocaleString()}</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #6c757d; font-weight: 500;">Trial Balance:</td>
                            <td style="padding: 10px 8px; border-bottom: 1px solid #dee2e6; color: #495057; font-weight: 600; text-align: right;">${trialBalanceBalance.toLocaleString()}</td>
                        </tr>
                        <tr style="background: #f8f9fa;">
                            <td style="padding: 12px 8px; color: #495057; font-weight: 600; border-top: 2px solid #dee2e6;">Difference:</td>
                            <td style="padding: 12px 8px; color: ${difference > 0 ? '#dc3545' : '#28a745'}; font-weight: 700; font-size: 1.1rem; text-align: right; border-top: 2px solid #dee2e6;">
                                ${difference.toLocaleString()}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Account Details Card -->
            <div style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <i class="mdi mdi-account-switch" style="color: #667eea; font-size: 18px;"></i>
                    <h4 style="margin: 0; color: #495057; font-size: 1rem; font-weight: 600;">Account Details</h4>
                </div>
        
                <!-- GL Accounts Table -->
                <div style="margin-bottom: 16px;">
                    <h5 style="color: #6c757d; font-size: 0.9rem; font-weight: 600; margin-bottom: 12px; padding-left: 8px;">GL Accounts</h5>
                    <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 6px; overflow: hidden;">
                        <thead>
                            <tr style="background: #e9ecef;">
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600; font-size: 0.85rem; width: 50%;">Account</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600; font-size: 0.85rem; width: 50%;">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">
                                    <div style="font-weight: 600; color: #495057; margin-bottom: 4px;">Source GL</div>
                                    <div style="font-size: 0.85rem; color: #6c757d;">ID: ${sourceBranchAccountId}</div>
                                </td>
                                <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">
                                    <div style="color: #495057; font-weight: 500;">${sourceBranchAccountName || 'N/A'}</div>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 12px;">
                                    <div style="font-weight: 600; color: #495057; margin-bottom: 4px;">Adjustment GL</div>
                                    <div style="font-size: 0.85rem; color: #6c757d;">ID: ${selectedAccount}</div>
                                </td>
                                <td style="padding: 12px;">
                                    <div style="color: #495057; font-weight: 500;">${selectedAccountText}</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Transaction Details Table -->
                <div>
                    <h5 style="color: #6c757d; font-size: 0.9rem; font-weight: 600; margin-bottom: 12px; padding-left: 8px;">Transaction Details</h5>
                    <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 6px; overflow: hidden;">
                        <thead>
                            <tr style="background: #e9ecef;">
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600; font-size: 0.85rem; width: 50%;">Field</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600; font-size: 0.85rem; width: 50%;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 12px; border-bottom: 1px solid #dee2e6; color: #6c757d; font-weight: 500;">Memo</td>
                                <td style="padding: 12px; border-bottom: 1px solid #dee2e6; color: #495057; font-weight: 500;">${memo}</td>
                            </tr>
                            <tr>
                                <td style="padding: 12px; color: #6c757d; font-weight: 500;">Accounting Date</td>
                                <td style="padding: 12px; color: #495057; font-weight: 500;">${accountingDay}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Confirmation Section -->
            <div style="background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%); border: 1px solid #ffd43b; border-radius: 8px; padding: 20px; margin-bottom: 16px;">
                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <div style="flex-shrink: 0;">
                        <input type="checkbox" id="confirmReconciliation" style="transform: scale(1.3); margin-top: 2px; accent-color: #28a745;">
                    </div>
                    <div style="flex-grow: 1;">
                        <label for="confirmReconciliation" style="font-weight: 600; color: #856404; margin: 0; cursor: pointer; line-height: 1.4;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <i class="mdi mdi-shield-check-outline" style="font-size: 18px;"></i>
                                Confirmation Required
                            </div>
                            <div style="color: #856404; font-weight: normal; font-size: 0.95rem;">
                                I confirm that I have reviewed all the reconciliation details above and want to proceed with balancing the accounts. This action will create adjustment journal entries.
                            </div>
                        </label>
                    </div>
                </div>
                <div id="confirmationError" style="color: #dc3545; font-size: 0.9rem; margin-top: 8px; display: none;">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>Please check the confirmation box to proceed.
                </div>
            </div>

            <!-- Warning Footer -->
            <div style="background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; padding: 16px;">
                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <i class="mdi mdi-alert-circle-outline" style="color: #dc3545; font-size: 20px; flex-shrink: 0;"></i>
                    <div>
                        <strong style="color: #721c24; display: block; margin-bottom: 4px;">Important Notice</strong>
                        <p style="color: #721c24; margin: 0; font-size: 0.9rem; line-height: 1.4;">
                            This action will create permanent adjustment entries in the general ledger. Please ensure all details are correct before proceeding as this operation cannot be undone.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        `;

                // Add CSS for better checkbox styling and larger dialog size
                const style = document.createElement('style');
                style.textContent = `
            .alertify .ajs-dialog {
                max-width: 900px !important;
                width: 90% !important;
            }
            .alertify .ajs-content {
