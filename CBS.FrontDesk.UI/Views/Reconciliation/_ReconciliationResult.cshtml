@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.TrialBalanceReconciliationData

<div class="modal fade" id="reconciliationResultModal" tabindex="-1" aria-hidden="true"
     data-branchid="@Model.BranchId" data-branchaccountid="@Model.BranchAccountId">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-scale-balance me-2"></i> Trial Balance Reconciliation Result
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                @* Anti-forgery token for fetch POST *@
                @Html.AntiForgeryToken()

                <!-- Tips Section -->
                <div class="card mb-2">
                    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
                        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips</span>
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseReconGuidance" aria-expanded="false"
                                aria-controls="collapseReconGuidance">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseReconGuidance" class="collapse">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-primary">Understanding the Difference</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-check-circle text-success me-2"></i><strong>Surplus:</strong> Member balance is greater than trial balance</li>
                                        <li><i class="mdi mdi-alert-circle text-warning me-2"></i><strong>Deficit:</strong> Trial balance is greater than member balance</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-primary">Next Steps</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Select the appropriate GL account</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Choose surplus or deficit</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Review and confirm reconciliation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reconciliation Results -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-calculator me-2"></i>Balance Comparison</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-warning">@Model.AccountType</h5>
                                            <small class="text-muted">Account Type Selected</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-primary">@Model.MemberBalance.ToString("N2")</h5>
                                            <small class="text-muted">Member Balance</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div>
                                            <h5 class="text-info">@Model.TrialBalanceBalance.ToString("N2")</h5>
                                            <small class="text-muted">Trial Balance</small>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="text-center">
                                    <h4 class="@(Model.IsMemberBalanceGreater ? "text-success" : "text-danger")">
                                        Difference: @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                    </h4>
                                    <p class="mb-0">
                                        <i class="mdi @(Model.IsMemberBalanceGreater ? "mdi-arrow-up-bold text-success" : "mdi-arrow-down-bold text-warning") me-1"></i>
                                        @Model.Statement
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-information-outline me-2"></i>Reconciliation Details</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Branch Reference:</strong></td>
                                        <td>@Model.BRANCHName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Branch Account Ref.:</strong></td>
                                        <td>@Model.BranchAccountName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Trial Side:</strong></td>
                                        <td><span class="badge bg-secondary">@Model.TrialSide</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <span class="badge @(Model.MemberBalance == Model.TrialBalanceBalance ? "bg-success" : "bg-warning")">
                                                @(Model.MemberBalance == Model.TrialBalanceBalance ? "Balanced" : "Needs Adjustment")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Memo & Accounting Date aligned perfectly -->
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <!-- Memo Field -->
                            <div class="col-12 col-md-8 d-flex flex-column">
                                @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                                @Html.TextBoxFor(m => m.Memo, new
                                {
                                    @class = "form-control",
                                    placeholder = "Memo",
                                    maxlength = "80",
                                    data_val = "true",
                                    data_val_required = "Memo is required"
                                })
                                @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger" })
                            </div>

                            <!-- Accounting Date Field -->
                            <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                                <label for="AccountingDay" class="form-label mb-1">
                                    📅 Accounting Date
                                </label>
                                @Html.TextBoxFor(
                                    m => m.AccountingDate,
                                    new
                                    {
                                        @class = "form-control accounting-date",
                                        type = "date",
                                        id = "AccountingDay",
                                        required = "required",
                                        data_val = "true",
                                        data_val_required = "Accounting date is required",
                                        value = DateTime.Today.ToString("yyyy-MM-dd"),
                                        max = DateTime.Today.ToString("yyyy-MM-dd")
                                    })
                                @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Adjustment Section -->
                @if (Model.MemberBalance != Model.TrialBalanceBalance)
                {
                    <div class="card" id="adjustmentCard">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="mdi mdi-adjust me-2"></i>Reconciliation Adjustmen</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="DiffBranchAccountId" class="form-label fw-semibold">Select GL Account for Adjustment</label>
                                        @Html.DropDownListFor(m => m.DiffBranchAccountId,
                                            new SelectList(ViewBag.DiifBrachAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                                            "--- Select Branch Account ---",
                                            new
                                                 {
                                                @class = "form-control select2",
                                                id = "DiffBranchAccountId",
                                                data_val = "true",
                                                data_val_required = "GL Account is required"
                                            })
                                        @Html.ValidationMessageFor(m => m.DiffBranchAccountId, "", new { @class = "text-danger" })
                                        <div class="form-text">Choose the GL account to apply the adjustment</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Adjustment Type</label>
                                        <div class="mt-2">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="surplus" value="surplus"
                                                       data-val="true"
                                                       data-val-required="Adjustment type is required"
                                                       @(Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-success" for="surplus">
                                                    <i class="mdi mdi-plus-circle-outline me-1"></i>Surplus
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="deficit" value="deficit"
                                                       data-val="true"
                                                       data-val-required="Adjustment type is required"
                                                       @(!Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-warning" for="deficit">
                                                    <i class="mdi mdi-minus-circle-outline me-1"></i>Deficit
                                                </label>
                                            </div>
                                        </div>
                                        <span class="field-validation-valid text-danger" data-valmsg-for="adjustmentType" data-valmsg-replace="true"></span>
                                        <div class="form-text">
                                            @if (Model.IsMemberBalanceGreater)
                                            {
                                                <span class="text-success">Member balance is greater - typically use Surplus</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Trial balance is greater - typically use Deficit</span>
                                            }
                                        </div>
                                        <hr />
                                        <div>
                                            <strong>Difference Amount:</strong>
                                            <span class="fs-5 ms-2 @(Model.IsMemberBalanceGreater ? "text-success" : "text-warning")">
                                                @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Reconcile button aligned to the right *@
                            <div class="d-flex justify-content-end mt-4">
                                <button type="button" id="btnFinalReconcile" class="btn btn-primary">
                                    <i class="mdi mdi-check-all me-1"></i>Reconcile
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center">
                        <i class="mdi mdi-check-circle-outline me-2 fs-4"></i>
                        <strong>Balances are already reconciled!</strong> No adjustment needed.
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    // Store server-side values in data attributes to avoid JavaScript injection issues
    $('#reconciliationResultModal').data('memberbalance', @Model.MemberBalance)
                                   .data('trialbalancebalance', @Model.TrialBalanceBalance)
                                   .data('accounttype', '@Html.Raw(Model.AccountType)')
                                   .data('branchaccountname', '@Html.Raw(Model.BranchAccountName)')
                                   .data('mode', '@Model.Mode')
                                   .data('trialbalancestagingid', '@(Model.TrialBalanceStagingId ?? "")');

    $(function () {
        console.log('Reconciliation modal script loaded');

        // Initialize validation
        initializeValidation();

        // Grab modal and its data attributes
        const $modal = $('#reconciliationResultModal');
        const branchId = $modal.data('branchid');
        const sourceBranchAccountId = $modal.data('branchaccountid');

        console.log('Modal data - BranchId:', branchId, 'BranchAccountId:', sourceBranchAccountId);

        // Bind finalize button (only exists when there is a difference)
        $('#btnFinalReconcile').on('click', function () {
            finalizeReconciliation();
        });
    });

    function initializeValidation() {
        // Check if jQuery Validation is available
        if (typeof $.fn.validate !== 'function') {
            console.warn('jQuery Validation plugin not loaded');
            return;
        }

        // Create a form wrapper for validation if it doesn't exist
        if ($('#reconciliationForm').length === 0) {
            $('.modal-body').wrapInner('<form id="reconciliationForm" novalidate="novalidate"></form>');
        }

        // Custom validator for radio buttons
        $.validator.addMethod("requiredRadio", function(value, element) {
            return $('input[name="' + element.name + '"]:checked').length > 0;
        }, "Please select an option");

        // Setup validation for the form
        $('#reconciliationForm').validate({
            rules: {
                DiffBranchAccountId: {
                    required: true
                },
                Memo: {
                    required: true,
                    maxlength: 80
                },
                AccountingDate: {
                    required: true,
                    date: true
                },
                adjustmentType: {
                    requiredRadio: true
                }
            },
            messages: {
                DiffBranchAccountId: {
                    required: "Please select a GL account for adjustment"
                },
                Memo: {
                    required: "Please enter a memo",
                    maxlength: "Memo cannot exceed 80 characters"
                },
                AccountingDate: {
                    required: "Please select accounting date",
                    date: "Please enter a valid date"
                },
                adjustmentType: {
                    requiredRadio: "Please select adjustment type"
                }
            },
            errorPlacement: function(error, element) {
                if (element.attr("name") === "adjustmentType") {
                    error.insertAfter(element.closest('.mb-3'));
                } else {
                    error.insertAfter(element);
                }
            },
            highlight: function(element) {
                $(element).addClass('is-invalid').removeClass('is-valid');
            },
            unhighlight: function(element) {
                $(element).addClass('is-valid').removeClass('is-invalid');
            },
            submitHandler: function(form) {
                // This will be called when form is valid
                return false; // Prevent actual form submission
            }
        });
    }

    function validateForm() {
        // Check if jQuery Validation is available
        if (typeof $.fn.validate !== 'function') {
            console.warn('jQuery Validation not available, using manual validation');
            return manualValidateForm();
        }

        const $form = $('#reconciliationForm');

        if (!$form.valid()) {
            // Show first error field
            const firstError = $form.find('.error:first, .text-danger:visible:first');
            if (firstError.length) {
                const errorElement = firstError.prev('input, select, textarea') || firstError.closest('.d-flex').find('input, select, textarea');
                if (errorElement.length) {
                    $('html, body').animate({
                        scrollTop: errorElement.offset().top - 100
                    }, 500);
                    errorElement.focus();
                }
            }

            if (typeof appalert === 'function') {
                appalert('Please fix the validation errors before proceeding.', 3, 1);
            }
            return false;
        }
        return true;
    }

    function manualValidateForm() {
        let isValid = true;
        const errors = [];

        // Clear previous validation styles
        $('.is-invalid').removeClass('is-invalid');
        $('.manual-validation-error').remove();

        // Validate GL Account
        const glAccount = $('#DiffBranchAccountId').val();
        if (!glAccount) {
            $('#DiffBranchAccountId').addClass('is-invalid');
            $('#DiffBranchAccountId').after('<div class="manual-validation-error text-danger">Please select a GL account for adjustment</div>');
            isValid = false;
            errors.push('GL Account');
        }

        // Validate Memo
        const memo = $('#Memo').val();
        if (!memo || memo.trim() === '') {
            $('#Memo').addClass('is-invalid');
            $('#Memo').after('<div class="manual-validation-error text-danger">Please enter a memo</div>');
            isValid = false;
            errors.push('Memo');
        } else if (memo.length > 80) {
            $('#Memo').addClass('is-invalid');
            $('#Memo').after('<div class="manual-validation-error text-danger">Memo cannot exceed 80 characters</div>');
            isValid = false;
            errors.push('Memo length');
        }

        // Validate Accounting Date
        const accountingDate = $('#AccountingDay').val();
        if (!accountingDate) {
            $('#AccountingDay').addClass('is-invalid');
            $('#AccountingDay').after('<div class="manual-validation-error text-danger">Please select accounting date</div>');
            isValid = false;
            errors.push('Accounting Date');
        }

        // Validate Adjustment Type
        const adjustmentType = $('input[name="adjustmentType"]:checked').val();
        if (!adjustmentType) {
            $('input[name="adjustmentType"]').closest('.mb-3').addClass('is-invalid');
            $('input[name="adjustmentType"]').closest('.mb-3').append('<div class="manual-validation-error text-danger">Please select adjustment type</div>');
            isValid = false;
            errors.push('Adjustment Type');
        }

        if (!isValid) {
            // Scroll to first error
            const firstError = $('.is-invalid:first');
            if (firstError.length) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 500);
                firstError.focus();
            }

            if (typeof appalert === 'function') {
                appalert('Please fix the following errors: ' + errors.join(', '), 3, 1);
            }
        }

        return isValid;
    }

    function finalizeReconciliation() {
        // Validate form before proceeding
        if (!validateForm()) {
            return;
        }

        const selectedAccount = $('#DiffBranchAccountId').val();
        const selectedAccountText = $('#DiffBranchAccountId option:selected').text();
        const memo = $('#Memo').val();
        const accountingDay = $('#AccountingDay').val();
        const adjustmentType = $('input[name="adjustmentType"]:checked').val();
        const modal = $('#reconciliationResultModal');
        const branchId = modal.data('branchid');
        const sourceBranchAccountId = modal.data('branchaccountid');

        console.log('Branch Account:', branchId, 'selectedAccount:', selectedAccount);

        // Get server-side values from data attributes (safe approach)
        const memberBalance = parseFloat(modal.data('memberbalance'));
        const trialBalanceBalance = parseFloat(modal.data('trialbalancebalance'));
        const difference = Math.abs(memberBalance - trialBalanceBalance);

        // Get string values from data attributes
        const accountType = modal.data('accounttype');
        const sourceBranchAccountName = modal.data('branchaccountname');
        const mode = modal.data('mode');
        const trialBalanceStagingId = modal.data('trialbalancestagingid');

        const requestData = {
            BranchId: branchId,
            TrialBalanceBranchAccountId: sourceBranchAccountId,
            DiffBranchAccountId: selectedAccount,
            SurplusDeficit: adjustmentType,
            MemberBalance: memberBalance,
            TrialBalanceBalance: trialBalanceBalance,
            Difference: difference,
            TrialBalanceStagingId: trialBalanceStagingId,
            Memo: memo,
            AccountingDate: accountingDay,
            AccountType: accountType,
            Mode: mode,
            SourceBranchAccountName: sourceBranchAccountName
        };

        console.log('Request data:', requestData);

        showBootstrapConfirmation(requestData, selectedAccountText);
    }

    // Generate the HTML for the confirmation modal (Bootstrap)
    function generateConfirmationHtml(requestData, selectedAccountText, sourceBranchAccountId) {
        const status = requestData.SurplusDeficit === 'surplus' ? 'Surplus' : 'Deficit';
        // Use bootstrap table alignment: labels left, values right
        return `
<div class="container-fluid p-0">
    <div class="py-2 mb-3">
        <div class="d-flex align-items-center">
            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:46px; height:46px;">
                <i class="mdi mdi-shield-check fs-5 text-secondary"></i>
            </div>
            <div>
                <h5 class="mb-0 text-primary fw-bold">Confirm Reconciliation</h5>
                <small class="text-muted">Review and confirm before proceeding</small>
            </div>
        </div>
    </div>

              <div class="row g-3 mb-3">
              <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body p-3">
                    <h6 class="mb-2">Configuration</h6>

                    <table class="table table-borderless mb-0">
                      <tr class="align-middle">
                        <td class="ps-3 text-start" style="width:45%;">Mode:</td>
                        <td class="pe-3 text-end">
                          <span class="badge bg-light text-dark border">${(requestData.Mode || '').toUpperCase()}</span>
                        </td>
                      </tr>

                      <tr class="align-middle">
                        <td class="ps-3 text-start">Account Type:</td>
                        <td class="pe-3 text-end">${requestData.AccountType || ''}</td>
                      </tr>

                      <tr class="align-middle">
                        <td class="ps-3 text-start">Adjustment:</td>
                        <td class="pe-3 text-end">
                          <span class="${status === 'Surplus' ? 'text-success' : 'text-warning'} fw-medium">${status}</span>
                        </td>
                      </tr>
                    </table>

                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body p-3">
                    <h6 class="mb-2">Amounts</h6>

                    <table class="table table-borderless mb-0">
                      <tr class="align-middle">
                        <td class="ps-3 text-start" style="width:50%;">Member Balance:</td>
                        <td class="pe-3 text-end fw-bold">${(requestData.MemberBalance || 0).toLocaleString()}</td>
                      </tr>

                      <tr class="align-middle">
                        <td class="ps-3 text-start">Trial Balance:</td>
                        <td class="pe-3 text-end fw-bold">${(requestData.TrialBalanceBalance || 0).toLocaleString()}</td>
                      </tr>

                      <tr class="align-middle bg-light">
                        <td class="ps-3 text-start border-top">Difference:</td>
                        <td class="pe-3 text-end fw-bold border-top ${requestData.Difference > 0 ? 'text-warning' : 'text-success'}">
                          ${(requestData.Difference || 0).toLocaleString()}
                        </td>
                      </tr>
                    </table>

                  </div>
                </div>
              </div>
            </div>


    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <h6 class="mb-2">Account Details</h6>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <td class="text-start" style="width:50%;">
                                <div class="fw-bold mb-1">Branch Account Reference</div>
                                <div class="text-muted small">ID: ${sourceBranchAccountId}</div>
                            </td>
                            <td class="text-start">
                                <div class="fw-medium">${requestData.SourceBranchAccountName || 'N/A'}</div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-start">
                                <div class="fw-bold mb-1">Adjustment Branch Account Ref.</div>
                                <div class="text-muted small">ID: ${requestData.DiffBranchAccountId}</div>
                            </td>
                            <td class="text-start">
                                <div class="fw-medium">${selectedAccountText}</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr class="my-3" />

            <h6 class="mb-2">Transaction Details</h6>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <td class="text-start">Memo</td>
                            <td class="text-start">${requestData.Memo}</td>
                        </tr>
                        <tr>
                            <td class="text-start">Accounting Date</td>
                            <td class="text-start">${requestData.AccountingDate}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-warning bg-warning bg-opacity-10 mb-3">
        <div class="card-body p-3">
            <div class="d-flex align-items-start">
                <div class="flex-shrink-0 mt-1">
                    <input type="checkbox" id="confirmReconciliationModal" class="form-check-input" style="transform: scale(1.18);">
                </div>
                <div class="flex-grow-1 ms-3">
                    <label for="confirmReconciliationModal" class="form-check-label cursor-pointer">
                        <div class="d-flex align-items-center mb-2">
                            <i class="mdi mdi-shield-check-outline text-warning fs-5 me-2"></i>
                            <span class="fw-bold text-dark">Confirmation Required</span>
                        </div>
                        <p class="text-muted mb-0 small">
                            I confirm that I have reviewed all the reconciliation details above and want to proceed with balancing the accounts. This action will create adjustment journal entries.
                        </p>
                    </label>
                </div>
            </div>
            <div id="confirmationErrorModal" class="text-danger small mt-2 d-none">
                <i class="mdi mdi-alert-circle-outline me-1"></i>Please check the confirmation box to proceed.
            </div>
        </div>
    </div>

    <div class="card border-secondary bg-light">
        <div class="card-body p-3">
            <div class="d-flex align-items-start">
                <i class="mdi mdi-information-outline text-muted fs-5 me-3 mt-1"></i>
                <div>
                    <strong class="text-dark d-block mb-2">Important Notice</strong>
                    <p class="text-muted mb-0 small">
                        This action will create permanent adjustment entries in the general ledger. Please ensure all details are correct before proceeding as this operation cannot be undone.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>`;
    }

    // Show a Bootstrap modal for confirmation (keeps it open until checkbox checked)
    function showBootstrapConfirmation(requestData, selectedAccountText) {
        const sourceBranchAccountId = $('#reconciliationResultModal').data('branchaccountid');
        const uniq = 'reconConfirm' + Date.now();
        const modalHtml = `
<div id="${uniq}" class="modal fade" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document" style="max-width: 940px;">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title text-primary fw-bold">Confirm Reconciliation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3">
        ${generateConfirmationHtml(requestData, selectedAccountText, sourceBranchAccountId)}
      </div>
      <div class="modal-footer">
        <div class="me-auto text-muted small">Please confirm to create adjustment journal entries</div>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button id="${uniq}ConfirmBtn" type="button" class="btn btn-primary">Proceed</button>
      </div>
    </div>
  </div>
</div>`;

        // append and show
        $('body').append(modalHtml);
        const $modal = $('#' + uniq);
        // apply safety CSS to avoid overlap
        const styleId = 'recon-modal-style';
        if (!document.getElementById(styleId)) {
            const style = document.createElement('style');
            style.id = styleId;
            style.textContent = `
                /* Ensure modal body scrolls and footer always visible */
                #${uniq} .modal-body { max-height: calc(75vh); overflow-y: auto; }
                #${uniq} .modal-footer { z-index: 3; }
                #${uniq} .modal-dialog { margin: 1.75rem auto; }
                #${uniq} table.table { margin-bottom: 0; }
                #${uniq} .table td, #${uniq} .table th { vertical-align: middle; }
            `;
            document.head.appendChild(style);
        }

        const bsModal = new bootstrap.Modal($modal[0], {
            backdrop: 'static',
            keyboard: false,
            focus: true
        });

        bsModal.show();

        // handlers
        const confirmBtn = document.getElementById(uniq + 'ConfirmBtn');
        const cancelBtn = $modal.find('[data-bs-dismiss="modal"]');

        function showCheckboxError(show) {
            const err = $modal.find('#confirmationErrorModal');
            if (err.length) {
                if (show) err.removeClass('d-none');
                else err.addClass('d-none');
            }
        }

        confirmBtn.addEventListener('click', function () {
            const checkbox = $modal.find('#confirmReconciliationModal');
            if (checkbox.length && !checkbox.prop('checked')) {
                // show error but keep modal open (do not close)
                showCheckboxError(true);
                // scroll to error for visibility
                const errEl = document.getElementById('confirmationErrorModal');
                if (errEl) {
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                if (typeof appalert === 'function') {
                    appalert('Please check the confirmation box to proceed.', 3, 1);
                }
                return;
            }

            // Hide any previous error
            showCheckboxError(false);

            // Disable button while processing
            confirmBtn.disabled = true;
            const originalHtml = confirmBtn.innerHTML;
            confirmBtn.innerHTML = '<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...';

            // Call server
            performFinalReconciliation(requestData).then(success => {
                if (success) {
                    bsModal.hide();
                    // remove the modal from DOM after hide
                    $modal.on('hidden.bs.modal', function () {
                        $modal.remove();
                    });
                } else {
                    // remain open and re-enable button
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = originalHtml;
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                }
            }).catch(err => {
                console.error(err);
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = originalHtml;
                if (typeof appalert === 'function') {
                    appalert('Error during reconciliation. See console for details.', 2, 1);
                }
            });
        });

        // Remove modal from DOM when closed via cancel or close button
        $modal.on('hidden.bs.modal', function () {
            $modal.remove();
        });
    }

    async function performFinalReconciliation(requestData) {
        try {
            $('#btnFinalReconcile').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...');

            const token = $('input[name="__RequestVerificationToken"]').val();

            const response = await fetch('@Url.Action("FinalizeReconciliation", "Reconciliation")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();
            console.log('Final reconciliation response:', result);

            if (result.success) {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation completed successfully!', 1, 1);
                }

                // Close the original reconciliation modal if open
                $('#reconciliationResultModal').modal('hide');

                // refresh or update UI
                setTimeout(() => location.reload(), 1200);
                return true;
            } else {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation failed!', 2, 1);
                }
                return false;
            }
        } catch (error) {
            console.error('Final reconciliation error:', error);
            if (typeof appalert === 'function') {
                appalert('Error during final reconciliation: ' + (error.message || error), 2, 1);
            }
            return false;
        } finally {
            $('#btnFinalReconcile').prop('disabled', false).html('<i class="mdi mdi-check-all me-1"></i>Reconcile');
        }
    }
</script>
