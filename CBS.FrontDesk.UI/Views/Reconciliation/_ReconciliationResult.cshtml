@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.TrialBalanceReconciliationData

<div class="modal fade" id="reconciliationResultModal" tabindex="-1" aria-hidden="true"
     data-branchid="@Model.BranchId" data-branchaccountid="@Model.BranchAccountId">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-scale-balance me-2"></i> Trial Balance Reconciliation Result
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                @* Anti-forgery token for fetch POST *@
                @Html.AntiForgeryToken()

                <!-- Tips Section -->
                <div class="card mb-2">
                    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
                        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips</span>
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseReconGuidance" aria-expanded="false"
                                aria-controls="collapseReconGuidance">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseReconGuidance" class="collapse">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-primary">Understanding the Difference</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-check-circle text-success me-2"></i><strong>Surplus:</strong> Member balance is greater than trial balance</li>
                                        <li><i class="mdi mdi-alert-circle text-warning me-2"></i><strong>Deficit:</strong> Trial balance is greater than member balance</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-primary">Next Steps</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Select the appropriate GL account</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Choose surplus or deficit</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Review and confirm reconciliation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reconciliation Results -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-calculator me-2"></i>Balance Comparison</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-warning">@Model.AccountType</h5>
                                            <small class="text-muted">Account Type Selected</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-primary">@Model.MemberBalance.ToString("N2")</h5>
                                            <small class="text-muted">Member Balance</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div>
                                            <h5 class="text-info">@Model.TrialBalanceBalance.ToString("N2")</h5>
                                            <small class="text-muted">Trial Balance</small>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="text-center">
                                    <h4 class="@(Model.IsMemberBalanceGreater ? "text-success" : "text-danger")">
                                        Difference: @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                    </h4>
                                    <p class="mb-0">
                                        <i class="mdi @(Model.IsMemberBalanceGreater ? "mdi-arrow-up-bold text-success" : "mdi-arrow-down-bold text-warning") me-1"></i>
                                        @Model.Statement
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-information-outline me-2"></i>Reconciliation Details</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Branch Reference:</strong></td>
                                        <td>@Model.BRANCHName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Branch Account Ref.:</strong></td>
                                        <td>@Model.BranchAccountName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Trial Side:</strong></td>
                                        <td><span class="badge bg-secondary">@Model.TrialSide</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <span class="badge @(Model.MemberBalance == Model.TrialBalanceBalance ? "bg-success" : "bg-warning")">
                                                @(Model.MemberBalance == Model.TrialBalanceBalance ? "Balanced" : "Needs Adjustment")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Memo & Accounting Date aligned perfectly -->
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <!-- Memo Field -->
                            <div class="col-12 col-md-8 d-flex flex-column">
                                @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                                @Html.TextBoxFor(m => m.Memo, new { @class = "form-control", placeholder = "Memo", maxlength = "80" })
                                @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger" })
                            </div>

                            <!-- Accounting Date Field -->
                            <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                                <label for="AccountingDay" class="form-label mb-1">
                                    📅 Accounting Date
                                </label>
                                @Html.TextBoxFor(
                                    m => m.AccountingDate,
                                    new
                                    {
                                        @class = "form-control accounting-date",
                                        type = "date",
                                        id = "AccountingDay",
                                        required = "required",
                                        value = DateTime.Today.ToString("yyyy-MM-dd"),
                                        max = DateTime.Today.ToString("yyyy-MM-dd")
                                    })
                                @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Adjustment Section — only rendered when there is a difference (your original logic) -->
                @if (Model.MemberBalance != Model.TrialBalanceBalance)
                {
                    <div class="card" id="adjustmentCard">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="mdi mdi-adjust me-2"></i>Reconciliation Adjustment</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="DiffBranchAccountId" class="form-label fw-semibold">Select GL Account for Adjustment</label>
                                        @Html.DropDownListFor(m => m.DiffBranchAccountId,
                                            new SelectList(ViewBag.DiifBrachAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                                            "--- Select Branch Account ---",
                                            new { @class = "form-control select2", id = "DiffBranchAccountId" })
                                        @Html.ValidationMessageFor(m => m.DiffBranchAccountId, "", new { @class = "text-danger" })
                                        <div class="form-text">Choose the GL account to apply the adjustment</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Adjustment Type</label>
                                        <div class="mt-2">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="surplus" value="surplus"
                                                       @(Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-success" for="surplus">
                                                    <i class="mdi mdi-plus-circle-outline me-1"></i>Surplus
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="deficit" value="deficit"
                                                       @(!Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-warning" for="deficit">
                                                    <i class="mdi mdi-minus-circle-outline me-1"></i>Deficit
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-text">
                                            @if (Model.IsMemberBalanceGreater)
                                            {
                                                <span class="text-success">Member balance is greater - typically use Surplus</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Trial balance is greater - typically use Deficit</span>
                                            }
                                        </div>
                                        <hr />
                                        <div>
                                            <strong>Difference Amount:</strong>
                                            <span class="fs-5 ms-2 @(Model.IsMemberBalanceGreater ? "text-success" : "text-warning")">
                                                @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("N2")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Reconcile button aligned to the right *@
                            <div class="d-flex justify-content-end mt-4">
                                <button type="button" id="btnFinalReconcile" class="btn btn-primary">
                                    <i class="mdi mdi-check-all me-1"></i>Reconcile
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center">
                        <i class="mdi mdi-check-circle-outline me-2 fs-4"></i>
                        <strong>Balances are already reconciled!</strong> No adjustment needed.
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    // Store server-side values in data attributes to avoid JavaScript injection issues
    $('#reconciliationResultModal').data('memberbalance', @Model.MemberBalance)
                                   .data('trialbalancebalance', @Model.TrialBalanceBalance)
                                   .data('accounttype', '@Html.Raw(Model.AccountType)')
                                   .data('branchaccountname', '@Html.Raw(Model.BranchAccountName)')
                                   .data('mode', '@Model.Mode')
                                   .data('trialbalancestagingid', '@(Model.TrialBalanceStagingId ?? "")');

    $(function () {
        console.log('Reconciliation modal script loaded');

        // Grab modal and its data attributes
        const $modal = $('#reconciliationResultModal');
        const branchId = $modal.data('branchid');
        const sourceBranchAccountId = $modal.data('branchaccountid');

        console.log('Modal data - BranchId:', branchId, 'BranchAccountId:', sourceBranchAccountId);

        // Bind finalize button (only exists when there is a difference)
        $('#btnFinalReconcile').on('click', function () {
            finalizeReconciliation();
        });
    });

    function finalizeReconciliation() {
        const selectedAccount = $('#DiffBranchAccountId').val();
        const selectedAccountText = $('#DiffBranchAccountId option:selected').text();
        const memo = $('#Memo').val();
        const accountingDay = $('#AccountingDay').val();
        const adjustmentType = $('input[name="adjustmentType"]:checked').val();
        const modal = $('#reconciliationResultModal');
        const branchId = modal.data('branchid');
        const sourceBranchAccountId = modal.data('branchaccountid');

        console.log('Branch Account:', branchId, 'selectedAccount:', selectedAccount);

        // Validation
        if (!selectedAccount) {
            console.log('checkfinal:', selectedAccount);
            if (typeof appalert === 'function') {
                appalert('Please select a GL account for adjustment.', 3, 1);
            } else {
                alert('Please select a GL account for adjustment.');
            }
            return;
        }

        if (!accountingDay) {
            console.log('checkfinal:', accountingDay);
            if (typeof appalert === 'function') {
                appalert('Please select Accounting day.', 3, 1);
            } else {
                alert('Please select accounting day.');
            }
            return;
        }
        if (!memo) {
            console.log('checkfinal:', memo);
            if (typeof appalert === 'function') {
                appalert('Please Enter Memo.', 3, 1);
            } else {
                alert('Please Enter Memo.');
            }
            return;
        }

        if (!adjustmentType) {
            if (typeof appalert === 'function') {
                appalert('Please select adjustment type (Surplus or Deficit).', 3, 1);
            } else {
                alert('Please select adjustment type (Surplus or Deficit).');
            }
            return;
        }

        // Get server-side values from data attributes (safe approach)
        const memberBalance = parseFloat(modal.data('memberbalance'));
        const trialBalanceBalance = parseFloat(modal.data('trialbalancebalance'));
        const difference = Math.abs(memberBalance - trialBalanceBalance);

        // Get string values from data attributes
        const accountType = modal.data('accounttype');
        const sourceBranchAccountName = modal.data('branchaccountname');
        const mode = modal.data('mode'); // This is a string like "member" or "loan"
        const trialBalanceStagingId = modal.data('trialbalancestagingid');

        const requestData = {
            BranchId: branchId,
            TrialBalanceBranchAccountId: sourceBranchAccountId,
            DiffBranchAccountId: selectedAccount,
            SurplusDeficit: adjustmentType,
            MemberBalance: memberBalance,
            TrialBalanceBalance: trialBalanceBalance,
            Difference: difference,
            TrialBalanceStagingId: trialBalanceStagingId,
            Memo: memo,
            AccountingDate: accountingDay,
            AccountType: accountType,
            Mode: mode,
            SourceBranchAccountName: sourceBranchAccountName
        };

        console.log('Request data:', requestData);

        const status = adjustmentType === 'surplus' ? 'Surplus' : 'Deficit';

        const message = `
    <div class="container-fluid p-0" style="max-height: 600px; overflow-y: auto;">
    <!-- Header -->
    <div class="bg-light border-bottom rounded-top p-4 mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="mdi mdi-shield-check fs-4 text-secondary"></i>
            </div>
            <div>
                <h3 class="h4 mb-1 text-primary fw-bold ">Confirm Reconciliation</h3>
                <p class="text-muted mb-0">Review all details before proceeding</p>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Configuration Card -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="mdi mdi-cog-outline text-muted fs-5 me-2"></i>
                        <h5 class="card-title mb-0 text-dark">Configuration</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-medium ps-0" style="width: 40%;">Mode:</td>
                                    <td class="pe-0">
                                        <span class="badge bg-light text-dark border">${mode.toUpperCase()}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-medium ps-0">Account Type:</td>
                                    <td class="text-dark fw-medium pe-0">${accountType}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-medium ps-0">Adjustment:</td>
                                    <td class="pe-0">
                                        <span class="badge ${status === 'Surplus' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning'} border-0">
                                            ${status.toUpperCase()}
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Amounts Card -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="mdi mdi-calculator text-muted fs-5 me-2"></i>
                        <h5 class="card-title mb-0 text-dark">Amounts</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-medium ps-0" style="width: 40%;">Member Balance:</td>
                                    <td class="text-dark fw-bold text-end pe-0">${memberBalance.toLocaleString()}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-medium ps-0">Trial Balance:</td>
                                    <td class="text-dark fw-bold text-end pe-0">${trialBalanceBalance.toLocaleString()}</td>
                                </tr>
                                <tr class="bg-light">
                                    <td class="text-dark fw-bold ps-0 border-top">Difference:</td>
                                    <td class="fw-bold fs-6 text-end pe-0 border-top ${difference > 0 ? 'text-danger' : 'text-success'}">
                                        ${difference.toLocaleString()}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Account Details Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <i class="mdi mdi-account-switch text-muted fs-5 me-2"></i>
                <h5 class="card-title mb-0 text-dark">Account Details</h5>
            </div>

            <!-- GL Accounts Table -->
            <div class="mb-4">
                <h6 class="text-muted fw-semibold mb-3">GL Accounts</h6>
                <div class="table-responsive">
                    <table class="table table-bordered bg-light mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-dark fw-semibold border" style="width: 50%;">Account</th>
                                <th class="text-dark fw-semibold border" style="width: 50%;">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="border">
                                    <div class="fw-bold text-dark mb-1">Branch Account Reference</div>
                                    <div class="text-muted small">ID: ${sourceBranchAccountId}</div>
                                </td>
                                <td class="border">
                                    <div class="text-dark fw-medium">${sourceBranchAccountName || 'N/A'}</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="border">
                                    <div class="fw-bold text-dark mb-1">Adjustment Branch Account Ref.</div>
                                    <div class="text-muted small">ID: ${selectedAccount}</div>
                                </td>
                                <td class="border">
                                    <div class="text-dark fw-medium">${selectedAccountText}</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Transaction Details Table -->
            <div>
                <h6 class="text-muted fw-semibold mb-3">Transaction Details</h6>
                <div class="table-responsive">
                    <table class="table table-bordered bg-light mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-dark fw-semibold border" style="width: 50%;">Field</th>
                                <th class="text-dark fw-semibold border" style="width: 50%;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-muted fw-medium border">Memo</td>
                                <td class="text-dark fw-medium border">${memo}</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-medium border">Accounting Date</td>
                                <td class="text-dark fw-medium border">${accountingDay}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Section -->
    <div class="card border-warning bg-warning bg-opacity-10 mb-3">
        <div class="card-body">
            <div class="d-flex align-items-start">
                <div class="flex-shrink-0 mt-1">
                    <input type="checkbox" id="confirmReconciliation" class="form-check-input" style="transform: scale(1.3);">
                </div>
                <div class="flex-grow-1 ms-3">
                    <label for="confirmReconciliation" class="form-check-label cursor-pointer">
                        <div class="d-flex align-items-center mb-2">
                            <i class="mdi mdi-shield-check-outline text-warning fs-5 me-2"></i>
                            <span class="fw-bold text-dark">Confirmation Required</span>
                        </div>
                        <p class="text-muted mb-0">
                            I confirm that I have reviewed all the reconciliation details above and want to proceed with balancing the accounts. This action will create adjustment journal entries.
                        </p>
                    </label>
                </div>
            </div>
            <div id="confirmationError" class="text-danger small mt-2 d-none">
                <i class="mdi mdi-alert-circle-outline me-1"></i>Please check the confirmation box to proceed.
            </div>
        </div>
    </div>

    <!-- Warning Footer -->
    <div class="card border-secondary bg-light">
        <div class="card-body">
            <div class="d-flex align-items-start">
                <i class="mdi mdi-information-outline text-muted fs-5 me-3 mt-1"></i>
                <div>
                    <strong class="text-dark d-block mb-2">Important Notice</strong>
                    <p class="text-muted mb-0">
                        This action will create permanent adjustment entries in the general ledger. Please ensure all details are correct before proceeding as this operation cannot be undone.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
`;

                // Add CSS for better checkbox styling and larger dialog size
                const style = document.createElement('style');
                style.textContent = `
            .alertify .ajs-dialog {
                max-width: 900px !important;
                width: 90% !important;
            }
            .alertify .ajs-content {
                padding: 20px !important;
                max-height: 70vh !important;
            }
            .alertify .ajs-body {
                max-height: 70vh !important;
            }
            .alertify .ajs-dialog .ajs-content input[type="checkbox"] {
                transform: scale(1.2);
                margin-right: 8px;
            }
            .alertify .ajs-header {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
                color: white;
                font-weight: 600;
                font-size: 1.2rem;
                padding: 20px !important;
            }
            .alertify .ajs-footer {
                padding: 15px 20px !important;
            }
            .alertify .ajs-commands button {
                font-weight: 500 !important;
                padding: 8px 20px !important;
            }
        `;
        document.head.appendChild(style);

        // Use the same pattern as showReconciliationConfirmation
        if (typeof alertify !== 'undefined' && alertify.confirm) {
            const alertifyDialog = alertify.confirm(
               /* "Confirm Final Reconciliation",*/
                message,
                function () {
                    // Check if confirmation checkbox is checked
                    const confirmCheckbox = document.getElementById('confirmReconciliation');
                    const confirmationError = document.getElementById('confirmationError');

                    if (!confirmCheckbox || !confirmCheckbox.checked) {
                        // Show error message
                        if (confirmationError) {
                            confirmationError.style.display = 'block';
                        }

                        // Show additional alert message
                        if (typeof appalert === 'function') {
                            appalert('Please check the confirmation box to proceed.', 3, 1);
                        } else {
                            alert('Please check the confirmation box to proceed.');
                        }

                        // Return false to prevent dialog from closing
                        return false;
                    }

                    if (typeof appalert === 'function') {
                        appalert('Processing final reconciliation...', 0, 0);
                    }
                    performFinalReconciliation(requestData).then(success => {
                        if (!success && typeof appalert === 'function') {
                            appalert('Final reconciliation failed!', 2, 1);
                        }
                    });

                    // Return true to allow dialog to close only when checkbox is checked
                    return true;
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation cancelled', 3, 1);
                    }
                    // Return true to allow dialog to close on cancel
                    return true;
                }
            ).set('closable', false); // Prevent closing via ESC or clicking outside

            // Add event listener to reset error when checkbox is clicked
            setTimeout(() => {
                const confirmCheckbox = document.getElementById('confirmReconciliation');
                const confirmationError = document.getElementById('confirmationError');

                if (confirmCheckbox && confirmationError) {
                    confirmCheckbox.addEventListener('change', function () {
                        if (this.checked) {
                            confirmationError.style.display = 'none';
                        }
                    });
                }
            }, 100);

        } else {
            // Fallback for when alertify is not available
            const userConfirmed = confirm("Confirm final reconciliation?");
            if (userConfirmed) {
                if (typeof appalert === 'function') {
                    appalert('Processing final reconciliation...', 0, 0);
                }
                performFinalReconciliation(requestData).then(success => {
                    if (!success && typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                });
            } else {
                if (typeof appalert === 'function') {
                    appalert('Final reconciliation cancelled', 3, 1);
                }
            }
        }

        // Use the same pattern as showReconciliationConfirmation
        if (typeof alertify !== 'undefined' && alertify.confirm) {
            alertify.confirm(
              
                message,
                function () {
                    // Check if confirmation checkbox is checked
                    const confirmCheckbox = document.getElementById('confirmReconciliation');
                    if (confirmCheckbox && !confirmCheckbox.checked) {
                        if (typeof appalert === 'function') {
                            appalert('Please check the confirmation box to proceed.', 3, 1);
                        } else {
                            alert('Please check the confirmation box to proceed.');
                        }
                        return;
                    }

                    if (typeof appalert === 'function') {
                        appalert('Processing final reconciliation...', 0, 0);
                    }
                    performFinalReconciliation(requestData).then(success => {
                        if (!success && typeof appalert === 'function') {
                            appalert('Final reconciliation failed!', 2, 1);
                        }
                    });
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation cancelled', 3, 1);
                    }
                }
            );
        } else {
            // Fallback for when alertify is not available
            const userConfirmed = confirm("Confirm final reconciliation?");
            if (userConfirmed) {
                if (typeof appalert === 'function') {
                    appalert('Processing final reconciliation...', 0, 0);
                }
                performFinalReconciliation(requestData).then(success => {
                    if (!success && typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                });
            } else {
                if (typeof appalert === 'function') {
                    appalert('Final reconciliation cancelled', 3, 1);
                }
            }
        }
    }

    async function performFinalReconciliation(requestData) {
        try {
            $('#btnFinalReconcile').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...');

            const token = $('input[name="__RequestVerificationToken"]').val();

            const response = await fetch('@Url.Action("FinalizeReconciliation", "Reconciliation")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();
            console.log('Final reconciliation response:', result);

            if (result.success) {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation completed successfully!', 1, 1);
                } else {
                    alert(result.message || 'Reconciliation completed successfully!');
                }

                // Close the modal
                $('#reconciliationResultModal').modal('hide');

                // refresh or update UI
                setTimeout(() => location.reload(), 1200);
                return true;
            } else {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation failed!', 2, 1);
                } else {
                    alert(result.message || 'Reconciliation failed!');
                }
                return false;
            }
        } catch (error) {
            console.error('Final reconciliation error:', error);
            if (typeof appalert === 'function') {
                appalert('Error during final reconciliation: ' + (error.message || error), 2, 1);
            } else {
                alert('Error during final reconciliation: ' + (error.message || error));
            }
            return false;
        } finally {
            $('#btnFinalReconcile').prop('disabled', false).html('<i class="mdi mdi-check-all me-1"></i>Reconcile');
        }
    }
</script>