        document.head.appendChild(style);

        // Use the same pattern as showReconciliationConfirmation
        if (typeof alertify !== 'undefined' && alertify.confirm) {
            const alertifyDialog = alertify.confirm(
                "Confirm Final Reconciliation",
                message,
                function () {
                    // Check if confirmation checkbox is checked
                    const confirmCheckbox = document.getElementById('confirmReconciliation');
                    const confirmationError = document.getElementById('confirmationError');

                    if (!confirmCheckbox || !confirmCheckbox.checked) {
                        // Show error message
                        if (confirmationError) {
                            confirmationError.style.display = 'block';
                        }

                        // Show additional alert message
                        if (typeof appalert === 'function') {
                            appalert('Please check the confirmation box to proceed.', 3, 1);
                        } else {
                            alert('Please check the confirmation box to proceed.');
                        }

                        // Return false to prevent dialog from closing
                        return false;
                    }

                    if (typeof appalert === 'function') {
                        appalert('Processing final reconciliation...', 0, 0);
                    }
                    performFinalReconciliation(requestData).then(success => {
                        if (!success && typeof appalert === 'function') {
                            appalert('Final reconciliation failed!', 2, 1);
                        }
                    });

                    // Return true to allow dialog to close only when checkbox is checked
                    return true;
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation cancelled', 3, 1);
                    }
                    // Return true to allow dialog to close on cancel
                    return true;
                }
            ).set('closable', false); // Prevent closing via ESC or clicking outside

            // Add event listener to reset error when checkbox is clicked
            setTimeout(() => {
                const confirmCheckbox = document.getElementById('confirmReconciliation');
                const confirmationError = document.getElementById('confirmationError');

                if (confirmCheckbox && confirmationError) {
                    confirmCheckbox.addEventListener('change', function () {
                        if (this.checked) {
                            confirmationError.style.display = 'none';
                        }
                    });
                }
            }, 100);

        } else {
            // Fallback for when alertify is not available
            const userConfirmed = confirm("Confirm final reconciliation?");
            if (userConfirmed) {
                if (typeof appalert === 'function') {
                    appalert('Processing final reconciliation...', 0, 0);
                }
                performFinalReconciliation(requestData).then(success => {
                    if (!success && typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                });
            } else {
                if (typeof appalert === 'function') {
                    appalert('Final reconciliation cancelled', 3, 1);
                }
            }
        }

        // Use the same pattern as showReconciliationConfirmation
        if (typeof alertify !== 'undefined' && alertify.confirm) {
            alertify.confirm(
                "Confirm Final Reconciliation",
                message,
                function () {
                    // Check if confirmation checkbox is checked
                    const confirmCheckbox = document.getElementById('confirmReconciliation');
                    if (confirmCheckbox && !confirmCheckbox.checked) {
                        if (typeof appalert === 'function') {
                            appalert('Please check the confirmation box to proceed.', 3, 1);
                        } else {
                            alert('Please check the confirmation box to proceed.');
                        }
                        return;
                    }

                    if (typeof appalert === 'function') {
                        appalert('Processing final reconciliation...', 0, 0);
                    }
                    performFinalReconciliation(requestData).then(success => {
                        if (!success && typeof appalert === 'function') {
                            appalert('Final reconciliation failed!', 2, 1);
                        }
                    });
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation cancelled', 3, 1);
                    }
                }
            );
        } else {
            // Fallback for when alertify is not available
            const userConfirmed = confirm("Confirm final reconciliation?");
            if (userConfirmed) {
                if (typeof appalert === 'function') {
                    appalert('Processing final reconciliation...', 0, 0);
                }
                performFinalReconciliation(requestData).then(success => {
                    if (!success && typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                });
            } else {
                if (typeof appalert === 'function') {
                    appalert('Final reconciliation cancelled', 3, 1);
                }
            }
        }
    }

    async function performFinalReconciliation(requestData) {
        try {
            $('#btnFinalReconcile').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...');

            const token = $('input[name="__RequestVerificationToken"]').val();

            const response = await fetch('@Url.Action("FinalizeReconciliation", "Reconciliation")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();
            console.log('Final reconciliation response:', result);

            if (result.success) {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation completed successfully!', 1, 1);
                } else {
                    alert(result.message || 'Reconciliation completed successfully!');
                }

                // Close the modal
                $('#reconciliationResultModal').modal('hide');

                // refresh or update UI
                setTimeout(() => location.reload(), 1200);
                return true;
            } else {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation failed!', 2, 1);
                } else {
                    alert(result.message || 'Reconciliation failed!');
                }
                return false;
            }
        } catch (error) {
            console.error('Final reconciliation error:', error);
            if (typeof appalert === 'function') {
                appalert('Error during final reconciliation: ' + (error.message || error), 2, 1);
            } else {
                alert('Error during final reconciliation: ' + (error.message || error));
            }
            return false;
        } finally {
            $('#btnFinalReconcile').prop('disabled', false).html('<i class="mdi mdi-check-all me-1"></i>Reconcile');
        }
    }
</script>