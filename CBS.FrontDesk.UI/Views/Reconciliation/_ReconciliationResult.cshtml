@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.TrialBalanceReconciliationData

<div class="modal fade" id="reconciliationResultModal" tabindex="-1" aria-hidden="true"
     data-branchid="@Model.BranchId" data-branchaccountid="@Model.BranchAccountId">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-scale-balance me-2"></i> Trial Balance Reconciliation Result
                            </h1>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                @* Anti-forgery token for fetch POST *@
                @Html.AntiForgeryToken()

                <!-- Tips Section -->
                <div class="card mb-4">
                    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
                        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips</span>
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseReconGuidance" aria-expanded="false"
                                aria-controls="collapseReconGuidance">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseReconGuidance" class="collapse">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-primary">Understanding the Difference</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-check-circle text-success me-2"></i><strong>Surplus:</strong> Member balance is greater than trial balance</li>
                                        <li><i class="mdi mdi-alert-circle text-warning me-2"></i><strong>Deficit:</strong> Trial balance is greater than member balance</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-primary">Next Steps</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Select the appropriate GL account</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Choose surplus or deficit</li>
                                        <li><i class="mdi mdi-arrow-right-circle me-2"></i>Review and confirm reconciliation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reconciliation Results -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-calculator me-2"></i>Balance Comparison</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-warning">@Model.AccountType</h5>
                                            <small class="text-muted">Account Type Selected</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border-end">
                                            <h5 class="text-primary">@Model.MemberBalance.ToString("C")</h5>
                                            <small class="text-muted">Member Balance</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div>
                                            <h5 class="text-info">@Model.TrialBalanceBalance.ToString("C")</h5>
                                            <small class="text-muted">Trial Balance</small>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="text-center">
                                    <h4 class="@(Model.IsMemberBalanceGreater ? "text-success" : "text-danger")">
                                        Difference: @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("C")
                                    </h4>
                                    <p class="mb-0">
                                        <i class="mdi @(Model.IsMemberBalanceGreater ? "mdi-arrow-up-bold text-success" : "mdi-arrow-down-bold text-warning") me-1"></i>
                                        @Model.Statement
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-information-outline me-2"></i>Reconciliation Details</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Branch Code:</strong></td>
                                        <td>@Model.BranchCode</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Source GL:</strong></td>
                                        <td>@Model.BranchAccountId</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Trial Side:</strong></td>
                                        <td><span class="badge bg-secondary">@Model.TrialSide</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <span class="badge @(Model.MemberBalance == Model.TrialBalanceBalance ? "bg-success" : "bg-warning")">
                                                @(Model.MemberBalance == Model.TrialBalanceBalance ? "Balanced" : "Needs Adjustment")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Memo & Accounting Date aligned perfectly -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <!-- Memo Field -->
                            <div class="col-12 col-md-8 d-flex flex-column">
                                @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                                @Html.TextBoxFor(m => m.Memo, new { @class = "form-control", placeholder = "Memo", maxlength = "80" })
                                @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger" })
                            </div>

                            <!-- Accounting Date Field -->
                            <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                                <label for="AccountingDay" class="form-label mb-1">
                                    📅 Accounting Date
                                </label>
                                @Html.TextBoxFor(
                                    m => m.AccountingDate,
                                    new
                                    {
                                        @class = "form-control accounting-date",
                                        type = "date",
                                        id = "AccountingDay",
                                        required = "required",
                                        value = DateTime.Today.ToString("yyyy-MM-dd"),
                                        max = DateTime.Today.ToString("yyyy-MM-dd")
                                    })
                                                                @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Adjustment Section — only rendered when there is a difference (your original logic) -->
                @if (Model.MemberBalance != Model.TrialBalanceBalance)
                {
                    <div class="card" id="adjustmentCard">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="mdi mdi-adjust me-2"></i>Reconciliation Adjustment</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="DiffBranchAccountId" class="form-label fw-semibold">Select GL Account for Adjustment</label>
                                        @Html.DropDownListFor(m => m.DiffBranchAccountId,
                                            new SelectList(ViewBag.DiifBrachAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                                            "--- Select Branch Account ---",
                                            new { @class = "form-control select2", id = "DiffBranchAccountId" })
                                        @Html.ValidationMessageFor(m => m.DiffBranchAccountId, "", new { @class = "text-danger" })
                                        <div class="form-text">Choose the GL account to apply the adjustment</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Adjustment Type</label>
                                        <div class="mt-2">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="surplus" value="surplus"
                                                       @(Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-success" for="surplus">
                                                    <i class="mdi mdi-plus-circle-outline me-1"></i>Surplus
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="adjustmentType" id="deficit" value="deficit"
                                                       @(!Model.IsMemberBalanceGreater ? "checked" : "")>
                                                <label class="form-check-label text-warning" for="deficit">
                                                    <i class="mdi mdi-minus-circle-outline me-1"></i>Deficit
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-text">
                                            @if (Model.IsMemberBalanceGreater)
                                            {
                                                <span class="text-success">Member balance is greater - typically use Surplus</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Trial balance is greater - typically use Deficit</span>
                                            }
                                        </div>
                                        <hr />
                                        <div>
                                            <strong>Difference Amount:</strong>
                                            <span class="fs-5 ms-2 @(Model.IsMemberBalanceGreater ? "text-success" : "text-warning")">
                                                @Math.Abs(Model.MemberBalance - Model.TrialBalanceBalance).ToString("C")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Reconcile button aligned to the right *@
                            <div class="d-flex justify-content-end mt-4">
                                <button type="button" id="btnFinalReconcile" class="btn btn-primary">
                                    <i class="mdi mdi-check-all me-1"></i>Reconcile
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center">
                        <i class="mdi mdi-check-circle-outline me-2 fs-4"></i>
                        <strong>Balances are already reconciled!</strong> No adjustment needed.
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('.select2').select2();
    });

    $(function () {
        console.log('Reconciliation modal script loaded');

        // Grab modal and its data attributes
        const $modal = $('#reconciliationResultModal');
        const branchId = $modal.data('branchid');
        const sourceBranchAccountId = $modal.data('branchaccountid');

        console.log('Modal data - BranchId:', branchId, 'BranchAccountId:', sourceBranchAccountId);

        // Bind finalize button (only exists when there is a difference)
        $('#btnFinalReconcile').on('click', function () {
            finalizeReconciliation();
        });

    });

    function ensureSelect2Init(selectorOrJq) {
        var $el = (selectorOrJq && selectorOrJq.jquery) ? selectorOrJq : $(selectorOrJq);
        if (!$el || $el.length === 0) return;
        if ($.fn.select2 && !$el.data('select2')) {
            try { $el.select2({ width: '100%' }); } catch (e) { console.warn('select2 init failed', e); }
        }
    }

    
    function finalizeReconciliation() {
        const selectedAccount = $('#DiffBranchAccountId').val();
        const adjustmentType = $('input[name="adjustmentType"]:checked').val();
        const modal = $('#reconciliationResultModal');
        const branchId = modal.data('branchid');
        const sourceBranchAccountId = modal.data('branchaccountid');

        console.log('Branch Account:', branchId, 'selectedAccount:', selectedAccount);

        // Validation - using appalert like in showReconciliationConfirmation
        if (!selectedAccount) {
            console.log('checkfinal:', selectedAccount);
            if (typeof appalert === 'function') {
                appalert('Please select a GL account for adjustment.', 3, 1);
            } else {
                alert('Please select a GL account for adjustment.');
            }
            return;
        }

        if (!adjustmentType) {
            if (typeof appalert === 'function') {
                appalert('Please select adjustment type (Surplus or Deficit).', 3, 1);
            } else {
                alert('Please select adjustment type (Surplus or Deficit).');
            }
            return;
        }

        // compute numeric difference using server-rendered values
        const difference = Math.abs(@(Model.MemberBalance - Model.TrialBalanceBalance));

        const requestData = {
            BranchId: branchId,
            TrialBalanceBranchAccountId: sourceBranchAccountId,
            DiffBranchAccountId: selectedAccount,
            SurplusDeficit: adjustmentType,
            MemberBalance: @Model.MemberBalance,
            TrialBalanceBalance: @Model.TrialBalanceBalance,
            Difference: difference,
            TrialBalanceStagingId: '@Model.TrialBalanceStagingId',
            Memo: $('#Memo').val(),
            AccountingDate: $('#AccountingDay').val(),
            AccountType: '@Model.AccountType'
        };

        const message = `
        <table style="width:100%; border-collapse: collapse;">
            <tr>
                <th style="text-align:left; padding:4px; border-bottom:1px solid #ccc;">Field</th>
                <th style="text-align:left; padding:4px; border-bottom:1px solid #ccc;">Value</th>
            </tr>
            <tr>
                <td style="padding:4px;">Source GL</td>
                <td style="padding:4px;">${sourceBranchAccountId}</td>
            </tr>
            <tr>
                <td style="padding:4px;">Adjustment GL</td>
                <td style="padding:4px;">${$('#DiffBranchAccountId option:selected').text()}</td>
            </tr>
            <tr>
                <td style="padding:4px;">Adjustment Type</td>
                <td style="padding:4px;">${adjustmentType.toUpperCase()}</td>
            </tr>
            <tr>
                <td style="padding:4px;">Difference Amount</td>
                <td style="padding:4px;">${difference.toLocaleString()}</td>
            </tr>
        </table>
        <p>This action will balance the accounts.</p>
    `;


        // Use the same pattern as showReconciliationConfirmation
        if (typeof alertify !== 'undefined' && alertify.confirm) {
            alertify.confirm(
                "Confirm Final Reconciliation",
                message,
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Processing final reconciliation...', 0, 0);
                    }
                    performFinalReconciliation(requestData).then(success => {
                        if (!success && typeof appalert === 'function') {
                            appalert('Final reconciliation failed!', 2, 1);
                        }
                    });
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Final reconciliation cancelled', 3, 1);
                    }
                }
            );
        } else {
            if (confirm(message)) {
                if (typeof appalert === 'function') {
                    appalert('Processing final reconciliation...', 0, 0);
                }
                performFinalReconciliation(requestData).then(success => {
                    if (!success && typeof appalert === 'function') {
                        appalert('Final reconciliation failed!', 2, 1);
                    }
                });
            }
        }
    }

    async function performFinalReconciliation(requestData) {
        try {
            $('#btnFinalReconcile').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...');

            const token = $('input[name="__RequestVerificationToken"]').val();

            const response = await fetch('@Url.Action("FinalizeReconciliation", "Reconciliation")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();
            console.log('Final reconciliation response:', result);

            if (result.success) {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation completed successfully!', 1, 1);
                } else {
                    alert(result.message || 'Reconciliation completed successfully!');
                }

                // Close the modal
                $('#reconciliationResultModal').modal('hide');

                // refresh or update UI
                setTimeout(() => location.reload(), 1200);
                return true;
            } else {
                if (typeof appalert === 'function') {
                    appalert(result.message || 'Reconciliation failed!', 2, 1);
                } else {
                    alert(result.message || 'Reconciliation failed!');
                }
                return false;
            }
        } catch (error) {
            console.error('Final reconciliation error:', error);
            if (typeof appalert === 'function') {
                appalert('Error during final reconciliation: ' + (error.message || error), 2, 1);
            } else {
                alert('Error during final reconciliation: ' + (error.message || error));
            }
            return false;
        } finally {
            $('#btnFinalReconcile').prop('disabled', false).html('<i class="mdi mdi-check-all me-1"></i>Reconcile');
        }
    }
</script>