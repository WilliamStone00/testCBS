@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.GetBalance
@{
    ViewBag.Title = "Member / Loan Reconciliation";
}

@* Header + Tips for Member / Loan Reconciliation *@
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-swap-horizontal-bold me-2"></i> Member And Loan Balance Reconciliation
                </h1>
                <p class="card-text">
                    Use this page to quickly check balances and reconcile either a member account or a loan account.
                    Choose the mode (Member or Loan), pick the account type and branch, then inspect balances and branch account details.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i>  Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReconTips" aria-expanded="false" aria-controls="collapseReconTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseReconTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">Workflow Guide</h6>
                    <div class="steps">
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">1</div>
                            <div class="step-content d-inline-block">
                                <strong>Select Branch</strong>
                                <div class="small text-muted">Choose the branch you want to reconcile</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">2</div>
                            <div class="step-content d-inline-block">
                                <strong>Choose Mode</strong>
                                <div class="small text-muted">Select Member for account balances or Loan for loan balances</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">3</div>
                            <div class="step-content d-inline-block">
                                <strong>Select Branch Account</strong>
                                <div class="small text-muted">Choose the specific GL account for reconciliation</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">4</div>
                            <div class="step-content d-inline-block">
                                <strong>Select Account Type</strong>
                                <div class="small text-muted">Choose the specific account type to view balances</div>
                            </div>
                        </div>
                        <div class="step-item">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">5</div>
                            <div class="step-content d-inline-block">
                                <strong>Get Balance & Reconcile</strong>
                                <div class="small text-muted">Get the balance and proceed with reconciliation</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">Quick Reference</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="mdi mdi-account-circle-outline text-success me-2"></i>
                            <strong>Member Mode:</strong> For savings, checking, and deposit accounts
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-cash-usd-outline text-warning me-2"></i>
                            <strong>Loan Mode:</strong> For personal, business, and mortgage loans
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-alert-circle-outline text-info me-2"></i>
                            <strong>Validation:</strong> All steps must be completed in sequence
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-shield-check-outline text-success me-2"></i>
                            <strong>Security:</strong> Balances are fetched in real-time from core systems
                        </li>
                    </ul>
                </div>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="small text-muted">
                    <i class="mdi mdi-lightbulb-on-outline me-1"></i>
                    <strong>Pro Tip:</strong> Complete each step sequentially. Use the Get Balance button when ready, and Reset if you need to start over. Reconciliation is only available after balance is loaded.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Progress Indicator -->
<div class="card mb-3" id="progressCard">
    <div class="card-body">
        <h6 class="text-primary mb-3"><i class="mdi mdi-progress-check me-1"></i>Reconciliation Progress</h6>
        <div class="progress mb-2" style="height: 8px;">
            <div class="progress-bar" id="progressBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="row text-center small">
            <div class="col">
                <div class="step-indicator" data-step="1">
                    <i class="mdi mdi-office-building-outline fs-5 mb-1 text-muted"></i>
                    <div>Select Branch</div>
                </div>
            </div>
            <div class="col">
                <div class="step-indicator" data-step="2">
                    <i class="mdi mdi-account-circle-outline fs-5 mb-1 text-muted"></i>
                    <div>Choose Mode</div>
                </div>
            </div>
            <div class="col">
                <div class="step-indicator" data-step="3">
                    <i class="mdi mdi-bank-outline fs-5 mb-1 text-muted"></i>
                    <div>Branch Account</div>
                </div>
            </div>
            <div class="col">
                <div class="step-indicator" data-step="4">
                    <i class="mdi mdi-chart-bar fs-5 mb-1 text-muted"></i>
                    <div>Account Type</div>
                </div>
            </div>
            <div class="col">
                <div class="step-indicator" data-step="5">
                    <i class="mdi mdi-calculator fs-5 mb-1 text-muted"></i>
                    <div>Get Balance</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>Reconciliation Setup</h5>

        <div class="row g-3 align-items-start">
            <!-- Branch Selection -->
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 text-primary"><i class="mdi mdi-office-building-outline me-2"></i>Step 1: Select Branch</h6>
                    </div>
                    <div class="card-body">
                        <label for="BranchId" class="form-label fw-semibold">🏢 Select Branch</label>
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <div class="mt-1 small text-muted">Choose a branch to continue and load branch accounts.</div>
                    </div>
                </div>
            </div>

            <!-- Mode Selection -->
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 text-primary"><i class="mdi mdi-account-circle-outline me-2"></i>Step 2: Choose Reconciliation Mode</h6>
                    </div>
                    <div class="card-body">
                        <label class="form-label fw-semibold">Choose Mode</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reconMode" id="modeMember" value="member" checked>
                                <label class="form-check-label ms-2" for="modeMember">
                                    <i class="mdi mdi-account-circle-outline me-1"></i>Member Accounts
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reconMode" id="modeLoan" value="loan">
                                <label class="form-check-label ms-2" for="modeLoan">
                                    <i class="mdi mdi-cash-usd-outline me-1"></i>Loan Accounts
                                </label>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <span id="modeHelpMember" class="text-success"><strong>Member:</strong> Savings, Loan, Teller accounts</span>
                            <span id="modeHelpLoan" class="text-warning d-none"><strong>Loan:</strong> Main_Loan, Project_Loans</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">

                <!-- Account Type Column (right) -->
                <div class="col-md-6">
                    <div class="card border-primary h-100">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 text-primary">
                                <i class="mdi mdi-chart-bar me-2"></i>Step 3: Select Account Type & Get Balance
                            </h6>
                        </div>

                        <div class="card-body">
                            <div id="memberAccountSection">
                                <label for="AccountType" class="form-label fw-semibold">Select Member Account Type</label>
                                @Html.DropDownListFor(m => m.AccountType,
                                             new SelectList(new List<SelectListItem>(), "Value", "Text"),
                                             "--- First Select Branch ---",
                                             new { @class = "form-control select2", id = "AccountType", disabled = "disabled" })
                                @Html.ValidationMessageFor(m => m.AccountType, "", new { @class = "text-danger" })
                                <div class="mt-1 small text-muted">
                                    <span id="accountTypeLoading" class="text-info d-none">
                                        <i class="mdi mdi-loading mdi-spin me-1"></i>Loading member account types...
                                    </span>
                                    <span id="accountTypeReady" class="d-none">
                                        <i class="mdi mdi-check-circle-outline text-success me-1"></i>Select an account type to view balance
                                    </span>
                                    <span id="accountTypeInitial">
                                        <i class="mdi mdi-information-outline me-1"></i>Select a branch first to load account types
                                    </span>
                                </div>
                            </div>

                            <div id="loanAccountSection" class="d-none mt-3">
                                <!-- Taxable radio buttons (added before the dropdown) -->
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">Taxable?</label>

                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.IsTaxable, true, new { @class = "form-check-input", id = "IsTaxableTrue" })
                                        <label class="form-check-label" for="IsTaxableTrue">Is Taxable</label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.IsTaxable, false, new { @class = "form-check-input", id = "IsTaxableFalse" })
                                        <label class="form-check-label" for="IsTaxableFalse">Not Taxable</label>
                                    </div>

                                    @Html.ValidationMessageFor(m => m.IsTaxable, "", new { @class = "text-danger small d-block" })
                                </div>

                                <!-- existing dropdown -->
                                <label for="LoanType" class="form-label fw-semibold">Select Loan Account Type</label>
                                @Html.DropDownListFor(m => m.LoanType,
                                    new SelectList(ViewBag.LoanAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                                    "--- Select Loan Account Type ---",
                                    new { @class = "form-control select2", id = "LoanType" })
                                @Html.ValidationMessageFor(m => m.LoanType, "", new { @class = "text-danger" })
                                <div class="mt-1 small text-muted">
                                    <span id="accountTypeLoading" class="text-info d-none">
                                        <i class="mdi mdi-loading mdi-spin me-1"></i>Loading loan account types...
                                    </span>
                                    <span id="accountTypeReady" class="d-none">
                                        <i class="mdi mdi-check-circle-outline text-success me-1"></i>Select an account type to view balance
                                    </span>
                                </div>
                            </div>


                            <!-- Balance Display -->
                            <div id="balanceInfo" class="mt-3 d-none" aria-live="polite">
                                <div class="card bg-light text-black">
                                    <div class="card-body p-3">
                                        <h6 class="card-title mb-2 text-primary"><i class="mdi mdi-information-outline me-1"></i> Account Information</h6>
                                        <div class="row small">
                                            <div class="col-6"><strong>Count:</strong></div>
                                            <div class="col-6" id="accountIdDisplay">-</div>

                                            <div class="col-6 mt-2"><strong>Balance:</strong></div>
                                            <div class="col-6 mt-2" id="balanceDisplay">-</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Balance Action Buttons -->
                            <div id="balanceActions" class="mt-3 d-none">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                                    <button type="button" id="btnGetBalance" class="btn btn-primary">
                                        <i class="mdi mdi-calculator me-1"></i>Get Balance
                                    </button>
                                    <button type="button" id="btnResetBalance" class="btn btn-outline-secondary">
                                        <i class="mdi mdi-refresh me-1"></i>Reset
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Branch Account Column (left) -->
                <div class="col-md-6">
                    <div class="card border-primary h-100">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 text-primary">
                                <i class="mdi mdi-bank-outline me-2"></i>Step 4: Select Branch Account
                            </h6>
                            @*<button type="button" id="btnLoadDetails" class="btn btn-outline-info btn-sm" disabled>
                                    <i class="mdi mdi-information-outline me-1"></i>Details
                                </button>*@
                        </div>

                        <div class="card-body">
                            <label for="BranchAccountId" class="form-label fw-semibold">Branch Account Reference</label>
                            @Html.DropDownList("BranchAccountId",
                                new List<SelectListItem> { new SelectListItem { Text = "--- Select Branch Account ---", Value = "" } },
                                new { @class = "form-control select2", id = "BranchAccountId" })
                            <div class="mt-2 small text-muted">
                                <i class="mdi mdi-information-outline me-1"></i>
                                This account will be used for reconciliation adjustments
                            </div>

                            <!-- Reconciliation Button -->
                            <div id="reconciliationActions" class="mt-3 d-none">
                                <div class="d-grid">
                                    <button type="button" id="btnReconcile" class="btn btn-primary">
                                        <i class="mdi mdi-check-circle-outline me-1"></i>Reconcile
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for branch account details -->
<div class="modal fade" id="branchAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Branch Account Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="branchAccountModalBody">
                <div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            'use strict';

            // Store current balance data and mode
            let currentBalanceData = null;
            let currentMode = 'member';
            let currentAccountTypeId = null;
            let currentBranchId = null;
            let branchChangeTimeout;

            // Optimized Select2 initialization - skip for large datasets
            function ensureSelect2Init(selectorOrJq) {
                var $el = (selectorOrJq && selectorOrJq.jquery) ? selectorOrJq : $(selectorOrJq);
                if (!$el || $el.length === 0) return;
                
                // Check if Select2 is available and not already initialized
                if ($.fn.select2 && !$el.data('select2')) {
                    const optionCount = $el.find('option').length;
                    // Skip Select2 for dropdowns with many options to improve performance
                    if (optionCount > 50) {
                        console.log('Skipping Select2 for large dropdown with', optionCount, 'options');
                        return;
                    }
                    try { 
                        $el.select2({ 
                            width: '100%',
                            minimumResultsForSearch: 10 // Only show search if enough items
                        }); 
                    } catch (e) { 
                        console.warn('select2 init failed', e); 
                    }
                }
            }

            // -----------------------------
            // Optimized Member Account Type Functions
            // -----------------------------

            /**
             * Load member account types based on branch selection - Returns Promise
             */
            window.loadMemberAccountTypes = function (branchId) {
                return new Promise((resolve, reject) => {
                    if (!branchId) {
                        resetMemberAccountTypes();
                        resolve([]);
                        return;
                    }

                    const $dropdown = $('#AccountType');
                    const $loadingSpan = $('#accountTypeLoading');
                    const $readySpan = $('#accountTypeReady');
                    const $initialSpan = $('#accountTypeInitial');

                    // Show loading state
                    $loadingSpan.removeClass('d-none');
                    $readySpan.addClass('d-none');
                    $initialSpan.addClass('d-none');
                    $dropdown.prop('disabled', true).empty().append($('<option>').val('').text('Loading account types...'));

                    $.ajax({
                        url: '@Url.Action("GetMemberAccountTypesByBranch", "Reconciliation")',
                        type: 'GET',
                        data: { branchId },
                        success: function (response) {
                            if (!response || !response.success) {
                                appalert(response?.message || "Failed to load account types.", 2, 1);
                                reject(new Error('Failed to load account types'));
                                return;
                            }

                            let accountTypes = [];

                            // Handle different response formats
                            if (Array.isArray(response)) {
                                accountTypes = response;
                            } else if (response && Array.isArray(response.data)) {
                                accountTypes = response.data;
                            } else if (response && response.success && Array.isArray(response.data)) {
                                accountTypes = response.data;
                            } else {
                                appalert("No account types found for this branch.", 2, 1);
                                reject(new Error('No account types found'));
                                return;
                            }

                            $dropdown.empty().append($('<option>').val('').text('--- Select Member Account Type ---'));

                            accountTypes.forEach(function (type) {
                                const value = type.Value;
                                const text = type.Text;
                                $dropdown.append($('<option>').val(value).text(text));
                            });
                            $dropdown.prop('disabled', false);

                            // Update UI state
                            $loadingSpan.addClass('d-none');
                            $readySpan.removeClass('d-none');

                            // Reinitialize select2 (optimized)
                            ensureSelect2Init($dropdown);

                            resolve(accountTypes);
                        },
                        error: function (xhr, status, error) {
                            appalert("Error loading account types.", 0, 1);
                            $dropdown.empty().append($('<option>').val('').text('Error loading account types'));
                            $dropdown.prop('disabled', true);

                            $loadingSpan.addClass('d-none');
                            $initialSpan.removeClass('d-none');
                            
                            reject(error);
                        }
                    });
                });
            };

            function resetMemberAccountTypes() {
                // Reset member account types
                $('#AccountType').empty().append($('<option>').val('').text('--- First Select Branch ---')).prop('disabled', true);
                $('#accountTypeLoading').addClass('d-none');
                $('#accountTypeReady').addClass('d-none');
                $('#accountTypeInitial').removeClass('d-none');

                // Reinitialize select2
                ensureSelect2Init($('#AccountType'));
            }

            // -----------------------------
            // Optimized Progress Tracking Functions
            // -----------------------------
            function updateProgress() {
                // Use requestAnimationFrame for non-blocking UI updates
                requestAnimationFrame(() => {
                    let progress = 0;
                    const steps = [];

                    // Step 1: Branch selected
                    if ($('#BranchId').val()) {
                        progress += 20;
                        steps.push(1);
                    }

                    // Step 2: Mode selected (always has default)
                    progress += 20;
                    steps.push(2);

                    // Step 3: Branch account selected
                    if ($('#BranchAccountId').val()) {
                        progress += 20;
                        steps.push(3);
                    }

                    // Step 4: Account type selected
                    const accountTypeSelected = (currentMode === 'member' && $('#AccountType').val()) ||
                                              (currentMode === 'loan' && $('#LoanType').val());
                    if (accountTypeSelected) {
                        progress += 20;
                        steps.push(4);
                    }

                    // Step 5: Balance loaded
                    if (currentBalanceData) {
                        progress += 20;
                        steps.push(5);
                    }

                    // Update progress bar
                    $('#progressBar').css('width', progress + '%').attr('aria-valuenow', progress);

                    // Update step indicators
                    $('.step-indicator').each(function() {
                        const step = $(this).data('step');
                        if (steps.includes(step)) {
                            $(this).find('i').removeClass('text-muted').addClass('text-success');
                            $(this).find('div').removeClass('text-muted').addClass('text-success fw-semibold');
                        } else {
                            $(this).find('i').removeClass('text-success').addClass('text-muted');
                            $(this).find('div').removeClass('text-success fw-semibold').addClass('text-muted');
                        }
                    });
                });
            }

            // -----------------------------
            // Validation Functions
            // -----------------------------
            function validateBranchSelected() {
                const branchId = $('#BranchId').val();
                if (!branchId) {
                    const message = 'Please select a branch first to continue.';
                    if (typeof appalert === 'function') {
                        appalert(message, 3, 1);
                    } else {
                        alert(message);
                    }
                    return false;
                }
                return true;
            }

            function validateBranchAccountSelected() {
                const branchAccountId = $('#BranchAccountId').val();
                if (!branchAccountId) {
                    const message = 'Please select a branch account before loading balances.';
                    if (typeof appalert === 'function') {
                        appalert(message, 3, 1);
                    } else {
                        alert(message);
                    }
                    return false;
                }
                return true;
            }

            function validateAccountTypeSelected() {
                const accountTypeId = currentMode === 'member' ? $('#AccountType').val() : $('#LoanType').val();
                if (!accountTypeId) {
                    const message = 'Please select an account type before getting balance.';
                    if (typeof appalert === 'function') {
                        appalert(message, 3, 1);
                    } else {
                        alert(message);
                    }
                    return false;
                }
                return true;
            }

            /**
             * Optimized branch accounts loading
             */
            async function loadBranchAccounts(branchId, $targetDropdown) {
                $targetDropdown = $targetDropdown || $('#BranchAccountId');
                if (!$targetDropdown || !$targetDropdown.length) return;

                const placeholderLoading = 'Loading branch accounts...';
                const placeholderEmpty = '--- Select Branch Account reference ---';
                const placeholderNoItems = 'No branch accounts available';
                const placeholderError = 'Error loading branch accounts';

                // Set loading state
                $targetDropdown.prop('disabled', true).empty().append($('<option>').val('').text(placeholderLoading));

                if (!branchId) {
                    $targetDropdown.prop('disabled', false).empty().append($('<option>').val('').text(placeholderEmpty));
                    try { if ($.fn.select2) $targetDropdown.trigger('change.select2'); } catch (e) {}
                    return;
                }

                const url = '@Url.Action("GetBranchAccountsByBranch", "Reconciliation")';
                console.log('Fetching branch accounts from:', url, 'branchId=', branchId);

                try {
                    const resp = await fetch(url + '?branchId=' + encodeURIComponent(branchId), {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-cache',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!resp.ok) {
                        const text = await resp.text().catch(() => '');
                        console.error('Branch accounts fetch failed. status=', resp.status, resp.statusText, 'body=', text);
                        $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text(placeholderError));
                        try { if ($.fn.select2) $targetDropdown.trigger('change.select2'); } catch (e) {}
                        return;
                    }

                    const payload = await resp.json().catch(() => null);
                    let items = [];

                    if (Array.isArray(payload)) items = payload;
                    else if (payload && Array.isArray(payload.data)) items = payload.data;
                    else if (payload && Array.isArray(payload.items)) items = payload.items;
                    else if (payload && payload.success && Array.isArray(payload.data)) items = payload.data;

                    $targetDropdown.empty().prop('disabled', false);

                    if (items && items.length) {
                        $targetDropdown.append($('<option>').val('').text(placeholderEmpty));
                        items.forEach(acc => {
                            const id = acc.id || acc.Id || acc.Value || acc.value || acc.Id?.toString?.() || '';
                            const name = acc.name || acc.Name || acc.Text || acc.text || acc.Description || id;
                            $targetDropdown.append($('<option>').val(id).text(name));
                        });
                    } else {
                        $targetDropdown.append($('<option>').val('').text(placeholderNoItems));
                    }

                    // Update select2 if used (optimized)
                    try { if ($.fn.select2) $targetDropdown.trigger('change.select2'); } catch (e) { /* ignore */ }

                    // Update progress
                    updateProgress();
                } catch (err) {
                    console.error('Error loading branch accounts:', err);
                    $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text(placeholderError));
                    try { if ($.fn.select2) $targetDropdown.trigger('change.select2'); } catch (e) {}
                }
            }

            // -----------------------------
            // Optimized Branch Change Handler
            // -----------------------------
            async function handleBranchChange(branchId) {
                currentBranchId = branchId;

                // Immediate UI feedback
                $('#BranchAccountId').empty().append(
                    $('<option>').val('').text('--- Select Branch Account ---')
                ).prop('disabled', true).addClass('branch-loading');

                $('#reconciliationActions').addClass('d-none');
                toggleBalanceActions(false);

                if (!branchId) {
                    resetMemberAccountTypes();
                    return;
                }

                // Show loading states
                if (currentMode === 'member') {
                    $('#AccountType').prop('disabled', true).html('<option value="">Loading account types...</option>').addClass('branch-loading');
                }

                try {
                    // Execute both requests in parallel for maximum performance
                    const [branchAccounts] = await Promise.all([
                        loadBranchAccounts(branchId, $('#BranchAccountId')),
                        currentMode === 'member' ? loadMemberAccountTypes(branchId) : Promise.resolve()
                    ]);
                    
                    console.log('Branch data loaded successfully');
                } catch (error) {
                    console.error('Error loading branch data:', error);
                    // Show error states
                    $('#BranchAccountId').html('<option value="">Error loading accounts</option>');
                    if (currentMode === 'member') {
                        $('#AccountType').html('<option value="">Error loading account types</option>');
                    }
                } finally {
                    // Remove loading states
                    $('#BranchAccountId').removeClass('branch-loading');
                    $('#AccountType').removeClass('branch-loading');
                }
            }

            // -----------------------------
            // Balance loading functionality
            // -----------------------------
            async function loadBalance() {
                // Validate branch selection
                if (!validateBranchSelected()) {
                    return null;
                }

                // Validate account type selection
                if (!validateAccountTypeSelected()) {
                    return null;
                }

                const accountTypeId = currentMode === 'member' ? $('#AccountType').val() : $('#LoanType').val();
                if (!accountTypeId) return null;

                const isLoan = (currentMode === 'loan');
                const isMember = (currentMode === 'member');

                // Show loading state
                $('#btnGetBalance').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Loading...');

                // Create FormData with proper naming for model binding
                const formData = new FormData();
                formData.append('mode', currentMode);
                formData.append('accountTypeId', accountTypeId);
                formData.append('loan', isLoan);
                formData.append('member', isMember);
                formData.append('BranchId', $('#BranchId').val());

                // Use the correct property names for your model binding
                if (isMember) {
                    formData.append('AccountType', accountTypeId);
                } else if (isLoan) {
                    formData.append('LoanType', accountTypeId);
                }

                // Read antiforgery token
                const tokenInput = $('input[name="__RequestVerificationToken"]');
                const token = tokenInput.length ? tokenInput.val() : '';

                try {
                    const url = '@Url.Action("GetAccountBalance", "Reconciliation")';
                    const resp = await fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (!resp.ok) {
                        const txt = await resp.text().catch(() => '');
                        console.error('loadBalance HTTP', resp.status, resp.statusText, txt);
                        return null;
                    }

                    const json = await resp.json().catch(() => null);
                    if (!json) return null;

                    console.log('Balance response:', json);

                    // Handle the response - data might be an array or single object
                    let balanceData = null;

                    if (json.success && json.data) {
                        // If data is an array, take the first item
                        if (Array.isArray(json.data)) {
                            balanceData = json.data[0] || {};
                        } else {
                            balanceData = json.data;
                        }
                    }

                    // If no data from success path, check if response itself has the properties
                    if (!balanceData && json.TotalBalance !== undefined) {
                        balanceData = json;
                    }

                    // Update progress after successful balance load
                    updateProgress();

                    return balanceData;

                } catch (err) {
                    console.error('Error loading balance:', err);
                    return null;
                } finally {
                    // Reset button state
                    $('#btnGetBalance').prop('disabled', false).html('<i class="mdi mdi-calculator me-1"></i>Get Balance');
                }
            }

            // -----------------------------
            // Reconciliation Functionality
            // -----------------------------
            async function reconcileTrialBalance() {
                const branchId = $('#BranchId').val();
                const branchAccountId = $('#BranchAccountId').val();

                // Extract branch account name from the selected option text
                const branchAccountName = $('#BranchAccountId option:selected').text();
                const BRANCHName = $('#BranchId option:selected').text();

                // Skip if it's a placeholder/loading text
                const branchName = (branchAccountName.includes('--- Select') ||
                                   branchAccountName.includes('Loading') ||
                                   branchAccountName.includes('Error')) ? '' : branchAccountName;

                const branchName2 = (BRANCHName.includes('--- Select') ||
                                     BRANCHName.includes('Loading') ||
                                     BRANCHName.includes('Error')) ? '' : BRANCHName;

                if (!branchId || !branchAccountId || !currentBalanceData) {
                    console.error('Missing required data for reconciliation');
                    return false;
                }

                // Show loading state
                $('#btnReconcile').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Processing...');

                try {
                    const formData = new FormData();
                    formData.append('BranchId', branchId);
                    formData.append('BRANCHName', branchName2);
                    formData.append('BranchAccountId', branchAccountId);
                    formData.append('BranchAccountName', branchName);
                    formData.append('TotalBalance', currentBalanceData.TotalBalance || 0);
                    formData.append('AccountCount', currentBalanceData.AccountCount || 0);
                    formData.append('LoanCount', currentBalanceData.LoanCount || 0);
                    formData.append('mode', currentMode);
                    formData.append('accountTypeId', currentAccountTypeId);

                    if (currentMode === 'member') {
                        formData.append('AccountType', currentAccountTypeId);
                        formData.append('member', 'true');
                    } else if (currentMode === 'loan') {
                        formData.append('LoanType', currentAccountTypeId);
                        formData.append('loan', 'true');
                    }

                    const tokenInput = $('input[name="__RequestVerificationToken"]');
                    const token = tokenInput.length ? tokenInput.val() : '';

                    const url = '@Url.Action("ReconcileTrialBalance", "Reconciliation")';
                    const resp = await fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'text/html',
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (!resp.ok) {
                        const txt = await resp.text().catch(() => '');
                        console.error('Reconciliation HTTP error:', resp.status, resp.statusText, txt);
                        return false;
                    }

                    const html = await resp.text();
                    console.log('Reconciliation response received as HTML');

                    if (html && html.trim().length > 0) {
                        $('#reconciliationResultModal').remove();
                        $('body').append(html);

                        const modalElement = document.getElementById('reconciliationResultModal');
                        if (modalElement) {
                            const modal = new bootstrap.Modal(modalElement);
                            modal.show();
                            initializeModalScripts();
                            return true;
                        } else {
                            console.error('Modal element not found in HTML response');
                            if (typeof appalert === 'function') {
                                appalert('Error: Could not load reconciliation results', 2, 1);
                            }
                            return false;
                        }
                    } else {
                        console.error('Empty HTML response received');
                        if (typeof appalert === 'function') {
                            appalert('No reconciliation data received from server', 2, 1);
                        } else {
                            alert('No reconciliation data received from server');
                        }
                        return false;
                    }

                } catch (err) {
                    console.error('Error during reconciliation:', err);
                    if (typeof appalert === 'function') {
                        appalert('Error during reconciliation: ' + err.message, 2, 1);
                    } else {
                        alert('Error during reconciliation: ' + err.message);
                    }
                    return false;
                } finally {
                    $('#btnReconcile').prop('disabled', false).html('<i class="mdi mdi-check-circle-outline me-1"></i>Reconcile Now');
                }
            }

            function initializeModalScripts() {
                if ($.fn.select2) {
                    $('#adjustmentBranchAccounts').select2({ width: '100%' });
                }

                $('#btnFinalReconcile').off('click').on('click', function() {
                    finalizeReconciliation();
                });

                const modal = $('#reconciliationResultModal');
                const branchId = modal.data('branchid');
                if (branchId) {
                    loadAdjustmentBranchAccounts(branchId);
                }
            }

            function loadAdjustmentBranchAccounts(branchId) {
                if (!branchId) return;

                const url = '@Url.Action("GetBranchAccountsByBranch", "Reconciliation")' + '?branchId=' + encodeURIComponent(branchId);

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        if (response.success && response.data) {
                            const $dropdown = $('#adjustmentBranchAccounts');
                            $dropdown.empty();
                            $dropdown.append($('<option>').val('').text('--- Select GL Account ---'));

                            response.data.forEach(function (account) {
                                const id = account.id || account.Id || account.Value || '';
                                const name = account.name || account.Name || account.Text || id;
                                $dropdown.append($('<option>').val(id).text(name));
                            });

                            if ($.fn.select2) {
                                $dropdown.trigger('change.select2');
                            }
                        }
                    },
                    error: function () {
                        $('#adjustmentBranchAccounts').html('<option value="">Error loading branch accounts</option>');
                    }
                });
            }

            function showReconciliationConfirmation() {
                if (!currentBalanceData) {
                    if (typeof appalert === 'function') {
                        appalert('Please get the balance first before reconciling.', 3, 1);
                    } else {
                        alert('Please get the balance first before reconciling.');
                    }
                    return;
                }

                const balanceAmount = currentBalanceData.TotalBalance || 0;
                const count = currentMode === 'loan' ? (currentBalanceData.LoanCount || 0) : (currentBalanceData.AccountCount || 0);
                const branchAccountText = $('#BranchAccountId option:selected').text();

                const message = `Do you want to reconcile the trial balance for?\n` +
                              `Branch Account: ${branchAccountText}\n` +
                              `Balance: ${balanceAmount.toLocaleString()}\n` +
                              `Count: ${count}\n` +
                              `Mode: ${currentMode}`;

                if (typeof alertify !== 'undefined' && alertify.confirm) {
                    alertify.confirm(
                        "Reconcile Trial Balance",
                        message,
                        function () {
                            if (typeof appalert === 'function') {
                                appalert('Processing reconciliation...', 0, 0);
                            }
                            reconcileTrialBalance().then(success => {
                                if (!success && typeof appalert === 'function') {
                                    appalert('Reconciliation failed!', 2, 1);
                                }
                            });
                        },
                        function () {
                            if (typeof appalert === 'function') {
                                appalert('Transaction cancelled', 3, 1);
                            }
                        }
                    );
                } else {
                    if (confirm(message)) {
                        if (typeof appalert === 'function') {
                            appalert('Processing reconciliation...', 0, 0);
                        }
                        reconcileTrialBalance().then(success => {
                            if (!success && typeof appalert === 'function') {
                                appalert('Reconciliation failed!', 2, 1);
                            }
                        });
                    }
                }
            }

            // -----------------------------
            // UI Helpers
            // -----------------------------
            function formatCurrency(value) {
                if (value === null || value === undefined) return '-';
                try {
                    return new Intl.NumberFormat('en-US', {
                        style: 'currency',
                    }).format(value);
                } catch (e) {
                    return value;
                }
            }

            function showBalance(data) {
                currentBalanceData = data;

                if (!data) {
                    $('#accountIdDisplay').text('-');
                    $('#balanceDisplay').text('-');
                    $('#balanceInfo').addClass('d-none');
                    return;
                }

                $('#balanceDisplay').text(data.TotalBalance.toLocaleString());

                if (currentMode === 'loan') {
                    $('#accountIdDisplay').text(data.LoanCount.toLocaleString() !== undefined ? data.LoanCount : '-');
                    $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Loan Count:');
                } else {
                    $('#accountIdDisplay').text(data.AccountCount.toLocaleString() !== undefined ? data.AccountCount : '-');
                    $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Account Count:');
                }

                $('#balanceInfo').removeClass('d-none');
                $('#reconciliationActions').removeClass('d-none');

                updateProgress();
            }

            function hideBalance() {
                $('#accountIdDisplay').text('-');
                $('#balanceDisplay').text('-');
                $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Count:');
                $('#balanceInfo').addClass('d-none');
                currentBalanceData = null;
                updateProgress();
            }

            function toggleBalanceActions(show) {
                if (show) {
                    $('#balanceActions').removeClass('d-none');
                } else {
                    $('#balanceActions').addClass('d-none');
                    hideBalance();
                }
            }

            function setButtonState(button, disabled) {
                if (button) {
                    button.prop('disabled', disabled);
                    if (disabled) {
                        button.addClass('disabled');
                    } else {
                        button.removeClass('disabled');
                    }
                }
            }

            // -----------------------------
            // DOM Ready with Optimized Event Handlers
            // -----------------------------
            $(function () {
                
                // Initialize select2 for all dropdowns (optimized)
                ensureSelect2Init('#AccountType');
                ensureSelect2Init('#LoanType');
                ensureSelect2Init('#BranchId');
                ensureSelect2Init('#BranchAccountId');

                // Store current branch ID when changed
                $('#BranchId').on('change', function() {
                    currentBranchId = $(this).val();
                    updateProgress();
                });

                // Debounced Branch Change Handler - MAIN PERFORMANCE FIX
                $('#BranchId').on('change', function() {
                    const branchId = $(this).val();
                    
                    // Clear any pending timeout
                    clearTimeout(branchChangeTimeout);
                    
                    // Add slight debounce to prevent rapid firing
                    branchChangeTimeout = setTimeout(async () => {
                        await handleBranchChange(branchId);
                    }, 100);
                });

                // Mode switching
                $('input[name="reconMode"]').on('change', function() {
                    const mode = $(this).val();
                    currentMode = mode;

                    if (mode === 'member') {
                        $('#memberAccountSection').removeClass('d-none');
                        $('#loanAccountSection').addClass('d-none');
                        $('#modeHelpMember').removeClass('d-none');
                        $('#modeHelpLoan').addClass('d-none');
                        $('#LoanType').val('').trigger('change');
                        $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Account Count:');

                        // Load member account types if branch is selected
                        if (currentBranchId) {
                            loadMemberAccountTypes(currentBranchId);
                        } else {
                            resetMemberAccountTypes();
                        }
                    } else {
                        $('#memberAccountSection').addClass('d-none');
                        $('#loanAccountSection').removeClass('d-none');
                        $('#modeHelpMember').addClass('d-none');
                        $('#modeHelpLoan').removeClass('d-none');
                        $('#AccountType').val('').trigger('change');
                        $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Loan Count:');
                    }

                    toggleBalanceActions(false);
                    updateProgress();
                });

                // Account Type change -> Show balance actions
                $('#AccountType').on('change', function() {
                    const accountTypeId = $(this).val();
                    currentAccountTypeId = accountTypeId;

                    if (accountTypeId) {
                        toggleBalanceActions(true);
                    } else {
                        toggleBalanceActions(false);
                    }
                    updateProgress();
                });

                // Loan Type change -> Show balance actions
                $('#LoanType').on('change', function() {
                    const accountTypeId = $(this).val();
                    currentAccountTypeId = accountTypeId;

                    if (accountTypeId) {
                        toggleBalanceActions(true);
                    } else {
                        toggleBalanceActions(false);
                    }
                    updateProgress();
                });

                // Get Balance button click
                $('#btnGetBalance').on('click', async function() {
                    setButtonState($(this), true);
                    try {
                        const balanceData = await loadBalance();
                        showBalance(balanceData);
                    } catch (error) {
                        console.error('Failed to load balance:', error);
                        showBalance(null);
                        if (typeof appalert === 'function') {
                            appalert('Failed to load balance. Please try again.', 2, 1);
                        }
                    } finally {
                        setButtonState($(this), false);
                    }
                });

                // Reset Balance button click
                $('#btnResetBalance').on('click', function() {
                    hideBalance();
                    if (currentMode === 'member') {
                        $('#AccountType').val('').trigger('change');
                    } else {
                        $('#LoanType').val('').trigger('change');
                    }
                });

                // Branch Account change handler
                $('#BranchAccountId').on('change', function() {
                    const branchAccountId = $(this).val();

                    // Enable/disable details button
                    $('#btnLoadDetails').prop('disabled', !branchAccountId);

                    // Show/hide reconciliation button
                    if (branchAccountId) {
                        $('#reconciliationActions').removeClass('d-none');
                    } else {
                        $('#reconciliationActions').addClass('d-none');
                    }

                    updateProgress();
                });

                // Reconciliation button click
                $('#btnReconcile').on('click', function() {
                    showReconciliationConfirmation();
                });

                // Branch Account Details button click
                $('#btnLoadDetails').on('click', async function() {
                    const accountId = $('#BranchAccountId').val();
                    if (!accountId) return;

                    const $modalBody = $('#branchAccountModalBody');
                    const $modal = $('#branchAccountModal');

                    $modalBody.html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');

                    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                        const modal = new bootstrap.Modal($modal[0]);
                        modal.show();
                    } else {
                        $modal.addClass('show').css('display', 'block');
                    }

                    try {
                        const html = await loadBranchAccountDetailsHtml(accountId);
                        $modalBody.html(html);
                    } catch (error) {
                        console.error('Failed to load account details:', error);
                        $modalBody.html('<div class="text-danger">Failed to load account details.</div>');
                    }
                });

                // If editing and branch is pre-selected, load its accounts
                const preSelectedBranch = $('#BranchId').val();
                if (preSelectedBranch) {
                    currentBranchId = preSelectedBranch;
                    setTimeout(() => {
                        handleBranchChange(preSelectedBranch);
                    }, 100);
                }

                // Initialize in member mode
                $('#modeMember').prop('checked', true);
                $('#accountIdDisplay').closest('.row').find('.col-6:first strong').text('Account Count:');

                // Initial progress update
                updateProgress();
            });

        })(jQuery);
    </script>
}