@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.CheckbookDetailDto

@{
    ViewBag.Title = "Checkbook Details";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="mdi mdi-book-information-variant me-2"></i>
                    Checkbook Details - @Model.CheckBookId
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Checkbook Information</h6>
                                <dl class="row mb-0">
                                    <dt class="col-sm-5">Checkbook ID:</dt>
                                    <dd class="col-sm-7">@Model.CheckBookId</dd>

                                    <dt class="col-sm-5">Category:</dt>
                                    <dd class="col-sm-7">@Model.Category</dd>

                                    <dt class="col-sm-5">Status:</dt>
                                    <dd class="col-sm-7">
                                        @{
                                            var statusClass = Model.Status.ToLower() == "active" ? "bg-label-success" :
                                                            Model.Status.ToLower() == "inactive" ? "bg-label-warning" : "bg-label-secondary";
                                        }
                                        <span class="badge @statusClass">@Model.Status</span>
                                    </dd>

                                    <dt class="col-sm-5">Customer ID:</dt>
                                    <dd class="col-sm-7">@Model.CustomerId</dd>

                                    <dt class="col-sm-5">Account Number:</dt>
                                    <dd class="col-sm-7">@Model.AccountNumber</dd>

                                    <dt class="col-sm-5">Branch Code:</dt>
                                    <dd class="col-sm-7">@Model.BranchCode</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="mdi mdi-book-open-page-variant me-2"></i>
                                    Check Leaves (@Model.CheckLeaves.Count)
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (Model.CheckLeaves != null && Model.CheckLeaves.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Check Leaf ID</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var leaf in Model.CheckLeaves)
                                                {
                                                    <tr>
                                                        <td>@leaf.CheckLeafId</td>
                                                        <td>
                                                            @{
                                                                var leafStatusClass = leaf.Status.ToLower() == "used" ? "bg-label-success" :
                                                                                    leaf.Status.ToLower() == "available" ? "bg-label-primary" :
                                                                                    leaf.Status.ToLower() == "lost" ? "bg-label-danger" : "bg-label-warning";
                                                            }
                                                            <span class="badge @leafStatusClass">@leaf.Status</span>
                                                        </td>
                                                        <td>
                                                            <a href="@Url.Action("RequestLossForCheckLeaf", "LossManagement", new { checkLeafId = leaf.CheckLeafId })"
                                                               class="btn btn-sm btn-label-warning">
                                                                <i class="mdi mdi-alert-outline me-1"></i>Report Loss
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <i class="mdi mdi-information-outline me-2"></i>
                                        No check leaves found for this checkbook.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <a href="@Url.Action("Index", "LossManagement")" class="btn btn-label-secondary">
                            <i class="mdi mdi-arrow-left me-1"></i> Back to Search
                        </a>
                        <a href="@Url.Action("RequestLossForCheckbook", "LossManagement", new { checkBookId = Model.CheckBookId })"
                           class="btn btn-warning">
                            <i class="mdi mdi-alert-outline me-1"></i> Report Loss for Entire Checkbook
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
