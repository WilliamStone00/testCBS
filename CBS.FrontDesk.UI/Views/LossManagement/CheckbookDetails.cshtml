@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.CheckbookDetailDto

@{
    ViewBag.Title = "Checkbook Details";
}

<div class="row">
    @Html.Partial("_Header")
</div>

<div class="container mt-4">
    <h3 class="mb-4 text-primary">
        <i class="mdi mdi-book-information-variant me-2"></i>
        Checkbook Details
    </h3>

    <!-- Checkbook Information -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0">Checkbook Information</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Checkbook ID:</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Category:</dt>
                        <dd class="col-sm-8">@Model.CheckBookCategoryId</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Customer ID:</dt>
                        <dd class="col-sm-8">@Model.CustomerId</dd>

                        <dt class="col-sm-4">Account Number:</dt>
                        <dd class="col-sm-8">@Model.AccountNumber</dd>

                        <dt class="col-sm-4">Branch Code:</dt>
                        <dd class="col-sm-8">@Model.BranchId</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>




    <!-- Load Check Leaves Button -->
    @*<div class="text-end mb-3">
            <button class="btn btn-outline-primary" id="loadCheckLeavesBtn">
                <i class="mdi mdi-eye me-1"></i> View Check Leaves
            </button>
        </div>*@

    <!-- Filter Section -->
    @*<div class="row">
            <div class="col-12">
                @Html.Partial("_Filters")
            </div>
        </div>*@

    <!-- Check Leaves Table -->
    <div id="userTableView">
        @Html.Partial("_CheckLeavesTable")
    </div>
</div>


@section Scripts{
    
    <script>

        function collectCheckbookFilterParams() {
            return {
              
                CheckbookId: Model.CheckbookId,
                options: {}
            };
        }

          function loadCheckleavesData() {
              initDataTable('#myDataTable1',
                  '@Url.Action("LoadCheckleavesData", "LossManagement")',
                  [
                      { data: 'CreatedDate', render: d => d ? moment(d).format('DD/MM/YYYY HH:mm:ss') : '' },
                      {
                          data: 'ChequeBookId'
                      },
                      {
                          data: 'CategoryName'
                      },
                      {
                          data: 'Status'
                      },
                      {
                          data: 'CheckleavesId', orderable: false,
                          render: id => `
                              <div class="btn-group btn-group-sm">
                                  <button class="btn btn-outline-primary"
                                      onclick="loadModal('Check Leaf Details', '@Url.Action("CheckLeafDetails", "LossManagement")', {KEY: '${id}'})">
                                      <i class="mdi mdi-eye-outline me-1"></i> Details
                                  </button>
                                  <button class="btn btn-outline-warning"
                                      onclick="loadModal('Report Loss for Check Leaf', '@Url.Action("RequestLossForCheckLeaf", "LossManagement")', {KEY: '${id}'})">
                                      <i class="mdi mdi-alert-outline me-1"></i> Req. Lost
                                  </button>
                              </div>`
                      }
              ], () => ({ options: {} }));
          }
    $(document).ready(function () {
        loadCheckleavesData();
    });

   </script>
    
    
    
    }
