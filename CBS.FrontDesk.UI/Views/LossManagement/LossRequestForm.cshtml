@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.LossRequestDto

@{
    ViewBag.Title = "Loss Declaration Request";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    Loss Declaration Request
                </h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("SubmitLossRequest", "LossManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.CheckBookID)
                    @Html.HiddenFor(model => model.CheckLeafID)
                    @Html.HiddenFor(model => model.CustomerID)

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="CustomerID">Customer ID</label>
                                @Html.TextBoxFor(model => model.CustomerID, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="AccountID">Account Number</label>
                                @Html.TextBoxFor(model => model.AccountID, new { @class = "form-control", required = "required" })
                                <div class="invalid-feedback">Please enter account number.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="BranchID">Branch ID</label>
                                @Html.TextBoxFor(model => model.BranchID, new { @class = "form-control", required = "required" })
                                <div class="invalid-feedback">Please enter branch ID.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="NationalIDNumber">National ID Number</label>
                                @Html.TextBoxFor(model => model.NationalIDNumber, new { @class = "form-control", required = "required" })
                                <div class="invalid-feedback">Please enter national ID number.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="LossDate">Loss Date</label>
                                @Html.TextBoxFor(model => model.LossDate, new { @class = "form-control", type = "date", required = "required" })
                                <div class="invalid-feedback">Please select loss date.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" for="LossReporteBy">Reported By</label>
                                @Html.TextBoxFor(model => model.LossReporteBy, new { @class = "form-control", required = "required" })
                                <div class="invalid-feedback">Please enter reporter name.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="LossReason">Loss Reason</label>
                        @Html.TextAreaFor(model => model.LossReason, new { @class = "form-control", rows = "4", required = "required", placeholder = "Please provide details about the loss..." })
                        <div class="invalid-feedback">Please enter loss reason.</div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="mdi mdi-send me-1"></i> Submit Loss Declaration
                            </button>
                            <a href="@Url.Action("Index", "LossManagement")" class="btn btn-label-secondary">Cancel</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}
