@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.CheckbookDetailDto

<div class="checkbook-details-modal">
    <!-- Checkbook Information -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0">
                <i class="mdi mdi-book-information-variant me-2"></i>
                Checkbook Information
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Checkbook ID:</dt>
                        <dd class="col-sm-8">@Model.CheckBookId</dd>

                        <dt class="col-sm-4">Category:</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Customer ID:</dt>
                        <dd class="col-sm-8">@Model.CustomerId</dd>

                        <dt class="col-sm-4">Account Number:</dt>
                        <dd class="col-sm-8">@Model.AccountNumber</dd>

                        <dt class="col-sm-4">Branch Code:</dt>
                        <dd class="col-sm-8">@Model.BranchCode</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Check Leaves Table - Updated to match checkbooks table design -->
    @if (Model?.CheckLeaves != null && Model.CheckLeaves.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="mdi mdi-book-open-page-variant me-2"></i>
                    Check Leaves for Checkbook: @Model.CheckBookId
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" style="table-layout: fixed;">
                        <thead class="table-light">
                            <tr>
                                <th width="40%">Check Leaf ID</th>
                                <th width="30%">Status</th>
                                <th width="30%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leaf in Model.CheckLeaves)
                            {
                                <tr>
                                    <td>@leaf.CheckLeafId</td>
                                    <td>@leaf.Status</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Check Leaf Details -->
                                            <button type="button"
                                                    class="btn btn-icon btn-label-info btn-sm"
                                                    onclick="loadCheckLeafDetails('@leaf.CheckLeafId')"
                                                    data-bs-toggle="tooltip"
                                                    title="View Check Leaf Details">
                                                <span class="tf-icons mdi mdi-information-outline"></span>
                                            </button>

                                            <!-- Request Loss for Check Leaf -->
                                            <button type="button"
                                                    class="btn btn-icon btn-label-warning btn-sm"
                                                    onclick="requestLossForCheckLeaf('@leaf.CheckLeafId')"
                                                    data-bs-toggle="tooltip"
                                                    title="Request Loss for this Check Leaf">
                                                <span class="tf-icons mdi mdi-alert-outline"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="mdi mdi-alert-circle-outline me-2"></i>
            No check leaves found for this checkbook.
        </div>
    }
</div>