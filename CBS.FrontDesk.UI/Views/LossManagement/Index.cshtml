@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.CustomerCheckbooksDto

@{
    ViewBag.Title = "Loss Management";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-book-alert me-2"></i> Loss Management System
                </h1>
                <p class="card-text">
                    Search for customer checkbooks and manage loss declarations efficiently.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Use the filters below to narrow down checkbook search results.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Loss Management Guidelines</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGuidelines" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseGuidelines" class="collapse show">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i><strong>Customer Member Reference:</strong> Unique identifier for the customer whose checkbooks you want to manage.</li>
                <li><i class="mdi mdi-book-search text-info me-2"></i><strong>Checkbook Search:</strong> Enter the customer reference to retrieve all associated checkbooks.</li>
                <li><i class="mdi mdi-eye-outline text-primary me-2"></i><strong>View Check Leaves:</strong> Inspect individual checks within each checkbook for detailed status.</li>
                <li><i class="mdi mdi-alert-outline text-warning me-2"></i><strong>Loss Reporting:</strong> Report lost or stolen checkbooks or individual check leaves promptly.</li>
                <li><i class="mdi mdi-book-information-variant text-secondary me-2"></i><strong>Detailed Information:</strong> Access comprehensive details for each checkbook and its leaves.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Advanced Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Checkbook Search Filters</h5>
    <form id="checkbookFilterForm">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle switches for additional filters -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleStatus" onclick="document.getElementById('statusFilter').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleStatus">Show Status Filter</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCategory" onclick="document.getElementBy                             *
                            Id('categoryFilter').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleCategory">Show Category Filter</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDate" onclick="document.getElementById('dateFilter').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleDate">Show Date Filter</label>
                    </div>
                </div>
            </div>

            <!-- Default Filters -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Customer Member Reference</label>
                    <input type="text" id="customerId" name="customerId" class="form-control" placeholder="Enter customer ID" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Checkbook ID</label>
                    <input type="text" id="checkbookId" name="checkbookId" class="form-control" placeholder="Enter specific checkbook ID" />
                </div>
            </div>

            <!-- Status Filter -->
            <div id="statusFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Checkbook Status</label>
                        <select id="status" name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Lost">Lost</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Category Filter -->
            <div id="categoryFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Checkbook Category</label>
                        <select id="category" name="category" class="form-select">
                            <option value="">All Categories</option>
                            <option value="Personal">Personal</option>
                            <option value="Business">Business</option>
                            <option value="Savings">Savings</option>
                            <option value="Premium">Premium</option>
                            <option value="Corporate">Corporate</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Date Filter -->
            <div id="dateFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Issue Date From</label>
                        <input type="date" id="issueDateFrom" name="issueDateFrom" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Issue Date To</label>
                        <input type="date" id="issueDateTo" name="issueDateTo" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> Search Checkbooks</button>
                <button id="resetFilterBtn" type="reset" class="btn btn-secondary me-2 w-100"><i class="mdi mdi-refresh"></i> Reset Filters</button>
                @* <button id="clearResultsBtn" class="btn btn-label-secondary w-100"><i class="mdi mdi-close"></i> Clear Results</button>*@
            </div>
        </div>
    </form>
</div>



<div id="userTableView">
    @Html.Partial("_CheckbooksTable")
</div>
@*<div id="datalistingview">
        @Html.Partial("_CheckbooksTable")
    </div>*@
<!-- DataTable Partial -->
<!--<div id="datalistingview">-->
<!-- Checkbooks table will be loaded here via DataTable -->
<!--</div>-->
<!-- Modal Structure -->
<div class="modal fade" id="mainModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Checkbook Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Content will be loaded here via AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
        /* ================================
           🔧 1. Generic Utility Functions
        ================================= */

        // Universal DataTable initializer
        function initDataTable(tableId, url, columns, getFiltersFn) {
            return $(tableId).DataTable({
                serverSide: true,
                destroy: true,
                searching: false,
                order: [[0, 'asc']],
                ajax: {
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = getFiltersFn();
                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };
                        return JSON.stringify(filters);
                    }
                },
                columns: columns,
                language: {
                    emptyTable: "No matching records found",
                    zeroRecords: "No matching records found"
                }
            });
        }

        // Generic modal loader
        function loadModal(title, url, params = {}) {
            $.ajax({
                type: "GET",
                url: url,
                data: params,
                success: function (data) {
                    $("#modalBody").html(data);
                    $("#mainModal .modal-title").html(title);
                    $("#mainModal").modal("show");
                },
                error: function (err) {
                    if (err.status === 401)
                        window.location.href = '/Authentication/Login';
                    else
                        appalert("Error loading content: " + err.statusText, 0, 1);
                }
            });
        }

        // Confirmation wrapper
        function confirmAction(title, message, onConfirm) {
            alertify.confirm(title, message, onConfirm, () => appalert('Operation cancelled', 3, 1))
                .set('labels', { ok: 'Yes, Proceed', cancel: 'Cancel' });
        }

        /* ================================
           📘 2. DataTable Loaders
        ================================= */

    function collectCheckbookFilterParams() {
        return {
            customerId: $('#customerId').val(),
            branchId: $('#branchId').val(),
            checkBookCategoryId: $('#category').val(),
            status: $('#status').val(),
            startDate: $('#issueDateFrom').val(),
            endDate: $('#issueDateTo').val(),
            options: {}
        };
    }

        function loadCheckbooksData() {
            initDataTable('#myDataTable', '@Url.Action("LoadCheckbooksData", "LossManagement")', [
                { data: 'CreatedDate', render: d => d ? moment(d).format('DD/MM/YYYY HH:mm:ss') : '' },
                { data: 'CategoryName' },
                { data: 'CustomerId' },
                { data: 'NumberOfLeaves' },
                { data: 'Status' },
                {
                    data: 'Id', orderable: false,
                    render: id => `
                        <div class="btn-group btn-group-sm">
                            <a href="@Url.Action("CheckbookDetails", "LossManagement")?KEY=${id}"
                               class="btn btn-outline-primary">
                               <i class="mdi mdi-book-information-variant me-1"></i> Details
                            </a>
                           <a href="@Url.Action("RequestLossForCheckBook", "LossManagement")?KEY=${id}"
                                   class="btn btn-sm btn-outline-warning">
                                   <i class="mdi mdi-alert-outline me-1"></i> Req. Lost
                                </a>
                        </div>`
                }
            ], collectCheckbookFilterParams);
        }

      
        /* ================================
           🧾 3. Loss Request Handlers
        ================================= */

        function submitLossRequest(form) {
            $.validator.unobtrusive.parse(form);
            if (!$(form).valid()) return false;

            confirmAction("Confirm Loss Request", `
                <div class="text-start">
                    <p>📝 This loss request will be <strong>submitted</strong> for processing.</p>
                    <p><strong>Do you want to proceed?</strong></p>
                </div>`, () => {
                    const modalEl = document.getElementById('mainModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    $.ajax({
                        type: 'POST',
                        url: form.action,
                        data: new FormData(form),
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success) {
                                alertify.success(response.message || 'Loss request submitted successfully');
                                $('#myDataTable').DataTable().ajax.reload();
                            } else {
                                appalert(response.message || 'Error submitting loss request', 2, 1);
                            }
                        },
                        error: function (err) {
                            if (err.status === 401)
                                window.location.href = '/Authentication/Login';
                            else
                                appalert(err.responseJSON?.message || err.statusText || 'An error occurred', 3, 1);
                        }
                    });
                });
            return false;
        }

        function approveLossRequest(requestId) {
            confirmAction('Approve Loss Request', 'Are you sure you want to approve this loss request?', () => {
                $.post('/LossManagement/ApproveLossRequest', { requestId }, response => {
                    response.success ? toastr.success(response.message) : toastr.error(response.message);
                    $('#lossRequestsTable').DataTable().ajax.reload();
                });
            });
        }

        function rejectLossRequest(requestId) {
            alertify.confirm('Reject Loss Request', `
                <div class="text-start">
                    <p>Please enter a reason for rejecting this loss request:</p>
                    <textarea id="rejectReasonTextarea" class="form-control" rows="4" placeholder="Enter rejection reason..."></textarea>
                </div>`, () => {
                    const reason = $('#rejectReasonTextarea').val().trim();
                    if (reason.length >= 10) {
                        $.post('/LossManagement/RejectLossRequest', { requestId, reason }, response => {
                            response.success ? appalert(response.message, 1, 1) : toastr.error(response.message);
                            $('#lossRequestsTable').DataTable().ajax.reload();
                        });
                    } else {
                        appalert("Rejection reason must be at least 10 characters.", 2, 1);
                    }
                }, () => toastr.info("Rejection cancelled."));
        }

        /* ================================
           🚀 4. Initialization
        ================================= */

        $(document).ready(function () {
            $('#applyFilterBtn').on('click', e => {
                e.preventDefault();
                if ($.fn.DataTable.isDataTable('#myDataTable')) $('#myDataTable').DataTable().destroy();
                loadCheckbooksData();
            });

            $('#resetFilterBtn').on('click', e => {
                e.preventDefault();
                $('#checkbookFilterForm').trigger('reset');
                if ($.fn.DataTable.isDataTable('#myDataTable')) $('#myDataTable').DataTable().destroy();
            });

            $('#clearResultsBtn').on('click', e => {
                e.preventDefault();
                if ($.fn.DataTable.isDataTable('#myDataTable')) $('#myDataTable').DataTable().destroy();
            });

            $('#issueDateFrom').val(new Date().toISOString().split('T')[0]);
        });
</script>
}
