@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-book-alert me-2"></i> @GlobalLossManagement.loss_management_system
                </h1>
                <p class="card-text">
                    @GlobalLossManagement.search_for_customer_checkbooks_and_manage_loss_declarations_efficiently.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalLossManagement.use_the_filters_below_to_narrow_down_checkbook_search_results.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

