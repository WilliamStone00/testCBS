@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.LossManagementSystem.CustomerCheckbooksDto

@if (Model?.Checkbooks != null && Model.Checkbooks.Any())
{
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="mdi mdi-book-multiple me-2"></i>
                Checkbooks for Customer: @Model.CustomerId
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" style="table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            <th width="30%">Checkbook ID</th>
                            <th width="25%">Category</th>
                            <th width="20%">Status</th>
                            <th width="25%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checkbook in Model.Checkbooks)
                        {
                            <tr>
                                <td>@checkbook.CheckBookId</td>
                                <td>@checkbook.Category</td>
                                <td>@checkbook.Status</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Details Action - Shows checkbook details AND check leaves -->
                                        <button type="button"
                                                class="btn btn-icon btn-label-info btn-sm"
                                                onclick="loadCheckbookDetails(@checkbook.CheckBookId)"
                                                data-bs-toggle="tooltip"
                                                title="View Checkbook Details and Check Leaves">
                                            <span class="tf-icons mdi mdi-information-outline"></span>
                                        </button>

                                        <!-- Request Loss Action -->
                                        <button type="button"
                                                class="btn btn-icon btn-label-warning btn-sm"
                                                onclick="requestLossForCheckbook(@checkbook.CheckBookId)"
                                                data-bs-toggle="tooltip"
                                                title="Request Loss for Entire Checkbook">
                                            <span class="tf-icons mdi mdi-alert-outline"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="mdi mdi-alert-circle-outline me-2"></i>
        No checkbooks found for this customer.
    </div>
}