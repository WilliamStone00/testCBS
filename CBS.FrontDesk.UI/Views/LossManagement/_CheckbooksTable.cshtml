@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalShared.Checkbooks</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.CreatedDate</th>
                    <th>@GlobalShared.Category_name</th>
                    <th>@GlobalShared.Customer_ID</th>
                    <th>@GlobalShared.NumOfLeaves</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>