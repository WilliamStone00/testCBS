<!-- INDEX PAGE -->
@{
    ViewBag.Title = "Menu Master Management";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row justify-content-end mb-2">
                    <div class="demo-inline-spacing text-end">
                        <a type="button" onclick="LoadDataGen('RolePermission','myDataTable','_RolePermissionData',0,'datalistingview',null,null,'list')" class="btn btn-icon btn-label-primary btn-sm" data-bs-toggle="tooltip" title="View List">
                            <i class="mdi mdi-view-list mdi-18px"></i>
                        </a>
                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_RolePermission','new','RolePermission','')" class="btn btn-icon btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New">
                            <i class="mdi mdi-plus mdi-18px"></i>
                        </a>
                    </div>
                </div>
                <hr />

                <div class="accordion accordion-popout" id="accordionPopoutIcon">
                    <div class="accordion-item">
                        <h2 class="accordion-header d-flex justify-content-between align-items-center" id="accordionPopoutIconThree">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                                <i class="mdi mdi-account-group-outline me-2"></i>ROLE MANAGEMENT
                            </button>
                        </h2>
                        <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                            <div class="accordion-body">
                                <div id="mainviewChange">
                                    <div id="datalistingview">
                                        @Html.Partial("_RolePermission")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/RolePermission.js"></script>
}
