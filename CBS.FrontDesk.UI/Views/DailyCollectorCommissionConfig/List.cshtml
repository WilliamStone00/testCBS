@{
    ViewBag.Title = "Commission Configurations Listing";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold">
                    <i class="mdi mdi-format-list-bulleted-type me-2"></i> Commission Configurations Listing
                </h1>
                <p class="card-text">
                    View existing commission configurations and use advanced filters to find specific records
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Use filters to search by branch, collector, effective dates, and status
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> Quick Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-home-city text-success me-2"></i><strong>Branch:</strong> Filter configurations by branch</li>
                <li><i class="mdi mdi-account text-info me-2"></i><strong>Collector:</strong> Find configurations for specific collectors</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i><strong>Effective Date:</strong> Filter by effective date range</li>
                <li><i class="mdi mdi-toggle-switch text-warning me-2"></i><strong>Status:</strong> Show only active or inactive configurations</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4" id="filtersSection">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Filter Configurations</h5>

    <form id="commissionFilterForm" autocomplete="off">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                    "--- All Branches ---", new { @class = "form-control select2", id = "branchId" })
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Collector</label>
                @Html.DropDownList("CollectorId", new SelectList(ViewBag.Collectors ?? new List<object>(), "Id", "FullName"),
                    "--- All Collectors ---", new { @class = "form-control select2", id = "collectorId" })
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="isCentralised" name="IsCentralised" value="true" />
                    <label class="form-check-label fw-bold" for="isCentralised">Centralised Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="isActive" name="IsActive" value="true" />
                    <label class="form-check-label fw-bold" for="isActive">Active Only</label>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Effective From Start</label>
                <input type="date" id="effectiveFromStart" name="EffectiveFromStart" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Effective From End</label>
                <input type="date" id="effectiveFromEnd" name="EffectiveFromEnd" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Effective On Date</label>
                <input type="date" id="effectiveOn" name="EffectiveOn" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" id="search" name="Search" class="form-control" placeholder="Search..." />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>
                <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>
</div>

<div id="datalistingview">
    @Html.Partial("_CommissionConfigDataTable")
</div>
@*Commission Config Details Modal*@
<div class="modal fade" id="configDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-file-document-outline me-1"></i> Commission Configuration Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        var configTable = null;
        var debugMode = true; // Set to false in production

        function log(message, data) {
            if (debugMode) {
                var timestamp = new Date().toISOString().split('T')[1].split('.')[0];
                if (data) {
                    console.log(`[${timestamp}] [Commission Config] ${message}:`, data);
                } else {
                    console.log(`[${timestamp}] [Commission Config] ${message}`);
                }
            }
        }

        function logTableState(message) {
            console.group(`[${new Date().toISOString().split('T')[1].split('.')[0]}] 📊 TABLE STATE: ${message}`);

            // Check if table exists
            console.log('Table element exists:', $('#myDataTable').length > 0);

            // Check if DataTable is initialized
            var isDataTable = $.fn.DataTable.isDataTable('#myDataTable');
            console.log('Is DataTable initialized:', isDataTable);

            if (isDataTable && configTable) {
                var dt = $('#myDataTable').DataTable();
                console.log('DataTable instance exists:', !!dt);
                console.log('DataTable page info:', dt.page.info());
                console.log('Rows in current view:', dt.rows({ page: 'current' }).count());
                console.log('Total rows in DataTable:', dt.rows().count());
                console.log('DataTable settings:', {
                    searching: dt.settings()[0].oFeatures.bFilter,
                    serverSide: dt.settings()[0].oFeatures.bServerSide,
                    processing: dt.settings()[0].oFeatures.bProcessing
                });

                // Log the actual data in the DataTable
                var allData = dt.data().toArray();
                console.log('All data in DataTable:', allData);
            }

            console.groupEnd();
        }

        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        function collectFilters() {
            var filters = {
                BranchId: emptyToNull($('#branchId').val()),
                CollectorId: emptyToNull($('#collectorId').val()),
                IsCentralised: $('#isCentralised').is(':checked') ? true : null,
                IsActive: $('#isActive').is(':checked') ? true : null,
                EffectiveOn: emptyToNull($('#effectiveOn').val()),
                EffectiveFromStart: emptyToNull($('#effectiveFromStart').val()),
                EffectiveFromEnd: emptyToNull($('#effectiveFromEnd').val()),
                Search: emptyToNull($('#search').val()),
                dataTableOptions: {}
            };

            log('📋 Collected filters', filters);
            return filters;
        }

        function escapeHtml(str) {
            if (!str && str !== 0) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function parseDotNetDate(dateValue) {
            if (!dateValue) return null;

            // Handle /Date(1772233200000)/ format
            if (typeof dateValue === 'string' && dateValue.indexOf('/Date(') === 0) {
                var matches = /\/Date\((\d+)\)\//.exec(dateValue);
                if (matches) {
                    return new Date(parseInt(matches[1]));
                }
            }

            // Handle regular date strings
            return new Date(dateValue);
        }

        function formatDate(dateValue, format) {
            if (!dateValue) return '-';

            try {
                var date = parseDotNetDate(dateValue);
                if (!date || isNaN(date.getTime())) return '-';

                if (window.moment) {
                    return moment(date).format(format || 'DD/MM/YYYY');
                } else {
                    return date.toLocaleDateString();
                }
            } catch (e) {
                log('Error formatting date:', e);
                return '-';
            }
        }

        function initDataTable() {
            log('🚀 Initializing DataTable - START');
            logTableState('Before initialization');

            // Check if DataTable is already initialized
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                log('⚠️ DataTable already initialized, destroying existing instance');
                $('#myDataTable').DataTable().destroy(true);
                configTable = null;
            }

            if (!$('#myDataTable').length) {
                console.error('❌ Table element #myDataTable not found in DOM');
                appalert('Table element #myDataTable not found', 0, 1);
                return false;
            }

            log('🆕 Creating new DataTable instance');

            configTable = $('#myDataTable').DataTable({
                searching: false,
                responsive: true,
                serverSide: true,
                destroy: true, // Allow destroying and recreating
                order: [[0, 'desc']],
                ajax: {
                    url: '/DailyCollectorCommissionConfig/LoadConfigData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        log('📤 AJAX - Preparing request data');
                        log('DataTable request params:', d);

                        const filters = collectFilters();
                        filters.dataTableOptions = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumn: d.columns && d.order && d.order[0] ? d.columns[d.order[0].column].data : 'EffectiveFrom',
                            sortDirection: d.order && d.order[0] ? d.order[0].dir : 'desc'
                        };

                        var requestData = JSON.stringify(filters);
                        log('📦 Full request payload:', JSON.parse(requestData));
                        return requestData;
                    },
                    dataSrc: function (json) {
                        log('📥 AJAX response received - START');
                        log('Raw response:', json);

                        // Log response metadata
                        console.group('📊 Response Metadata');
                        console.log('draw:', json.draw);
                        console.log('recordsTotal:', json.recordsTotal);
                        console.log('recordsFiltered:', json.recordsFiltered);
                        console.log('data array length:', json.data?.length);
                        console.groupEnd();

                        if (json.data && json.data.length > 0) {
                            log('✅ Data records found - processing first record');

                            var firstRecord = json.data[0];

                            console.group('📄 First Record Details');
                            console.log('Property names:', Object.keys(firstRecord));
                            console.log('Property values:', firstRecord);

                            // Detailed property check - now looking for PascalCase
                            log('Property presence check (PascalCase):', {
                                EffectiveFrom: {
                                    exists: 'EffectiveFrom' in firstRecord,
                                    value: firstRecord.EffectiveFrom,
                                    type: typeof firstRecord.EffectiveFrom
                                },
                                EffectiveTo: {
                                    exists: 'EffectiveTo' in firstRecord,
                                    value: firstRecord.EffectiveTo,
                                    type: typeof firstRecord.EffectiveTo
                                },
                                ScopeLevel: {
                                    exists: 'ScopeLevel' in firstRecord,
                                    value: firstRecord.ScopeLevel,
                                    type: typeof firstRecord.ScopeLevel
                                },
                                BranchId: {
                                    exists: 'BranchId' in firstRecord,
                                    value: firstRecord.BranchId,
                                    type: typeof firstRecord.BranchId
                                },
                                CollectorId: {
                                    exists: 'CollectorId' in firstRecord,
                                    value: firstRecord.CollectorId,
                                    type: typeof firstRecord.CollectorId
                                },
                                RuleCount: {
                                    exists: 'RuleCount' in firstRecord,
                                    value: firstRecord.RuleCount,
                                    type: typeof firstRecord.RuleCount
                                },
                                TotalPercentage: {
                                    exists: 'TotalPercentage' in firstRecord,
                                    value: firstRecord.TotalPercentage,
                                    type: typeof firstRecord.TotalPercentage
                                },
                                IsActive: {
                                    exists: 'IsActive' in firstRecord,
                                    value: firstRecord.IsActive,
                                    type: typeof firstRecord.IsActive
                                },
                                Id: {
                                    exists: 'Id' in firstRecord,
                                    value: firstRecord.Id,
                                    type: typeof firstRecord.Id
                                }
                            });

                            console.groupEnd();

                            // Simulate column rendering for first record
                            log('🎨 Simulating column rendering for first record with PascalCase:');
                            console.group('Column Rendering Simulation');

                            // Column 0: EffectiveFrom
                            var col0 = firstRecord.EffectiveFrom;
                            var rendered0 = formatDate(col0, 'DD/MM/YYYY');
                            console.log('Column 0 (EffectiveFrom):', { original: col0, rendered: rendered0 });

                            // Column 1: ScopeLevel
                            var col1 = firstRecord.ScopeLevel;
                            var rendered1 = col1 ? col1.split('_').map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ') : '-';
                            console.log('Column 1 (ScopeLevel):', { original: col1, rendered: rendered1 });

                            // Column 2: BranchId
                            console.log('Column 2 (BranchId):', { original: firstRecord.BranchId, rendered: firstRecord.BranchId || '-' });

                            // Column 3: CollectorId
                            console.log('Column 3 (CollectorId):', { original: firstRecord.CollectorId, rendered: firstRecord.CollectorId || '-' });

                            // Column 4: effective period (combined)
                            var from = formatDate(firstRecord.EffectiveFrom);
                            var to = firstRecord.EffectiveTo ? formatDate(firstRecord.EffectiveTo) : 'No end date';
                            console.log('Column 4 (effective period):', { from: from, to: to, combined: from + ' to ' + to });

                            // Column 5: RuleCount
                            var col5 = firstRecord.RuleCount;
                            var rendered5 = col5 !== null && col5 !== undefined ? col5 + ' rule' + (col5 !== 1 ? 's' : '') : '-';
                            console.log('Column 5 (RuleCount):', { original: col5, rendered: rendered5 });

                            // Column 6: TotalPercentage
                            var col6 = firstRecord.TotalPercentage;
                            var rendered6 = col6 !== null && col6 !== undefined ? parseFloat(col6).toFixed(2) + '%' : '-';
                            console.log('Column 6 (TotalPercentage):', { original: col6, rendered: rendered6 });

                            // Column 7: IsActive
                            var col7 = firstRecord.IsActive;
                            var rendered7 = col7 ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>';
                            console.log('Column 7 (IsActive):', { original: col7, rendered: rendered7 });

                            // Column 8: Id (actions)
                            console.log('Column 8 (Id/actions):', { original: firstRecord.Id, rendered: 'HTML dropdown with actions' });

                            console.groupEnd();

                            log(`📊 Processing complete for ${json.data.length} records`);
                        } else {
                            log('⚠️ No data records found in response');

                            if (json.data && json.data.length === 0) {
                                console.warn('⚠️ Data array is empty - no records to display');
                            }

                            if (!json.data) {
                                console.error('❌ Data property missing from response');
                            }
                        }

                        if (json.error) {
                            console.error('❌ Server returned error:', json.error);
                            appalert('Server error: ' + json.error, 0, 1);
                            return [];
                        }

                        if (!json.data) {
                            console.warn('⚠️ No data property in response', json);
                            return [];
                        }

                        if (!Array.isArray(json.data)) {
                            console.warn('⚠️ Data property is not an array', json.data);
                            return [];
                        }

                        log(`📊 Final: Received ${json.data.length} records out of ${json.recordsTotal || 0} total`);

                        // Important: Ensure the response has the correct structure
                        return {
                            draw: json.draw,
                            recordsTotal: json.recordsTotal,
                            recordsFiltered: json.recordsFiltered,
                            data: json.data
                        };
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('❌ DataTable AJAX error:', {
                            status: jqXHR.status,
                            statusText: jqXHR.statusText,
                            textStatus: textStatus,
                            errorThrown: errorThrown,
                            responseText: jqXHR.responseText ? jqXHR.responseText.substring(0, 200) : null
                        });

                        var msg = 'Failed to load data. Please try again.';
                        try {
                            var response = JSON.parse(jqXHR.responseText);
                            msg = response.message || response.error || msg;
                        } catch {
                            if (jqXHR.responseText) {
                                msg = 'Server error: ' + jqXHR.responseText.substring(0, 100);
                            }
                        }
                        appalert(msg, 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'EffectiveFrom',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 0 (EffectiveFrom) for row ${meta.row}:`, { data: data, row: row });
                            }
                            return formatDate(data, 'DD/MM/YYYY');
                        }
                    },
                    {
                        data: 'ScopeLevel',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 1 (ScopeLevel) for row ${meta.row}:`, { data: data, row: row });
                            }
                            if (!data) return '-';
                            // Format scope level nicely
                            return data.split('_')
                                .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
                                .join(' ');
                        }
                    },
                    {
                        data: 'BranchId',
                        defaultContent: '-',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 2 (BranchId) for row ${meta.row}:`, { data: data, row: row });
                            }
                            return data || '-';
                        }
                    },
                    {
                        data: 'CollectorId',
                        defaultContent: '-',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 3 (CollectorId) for row ${meta.row}:`, { data: data, row: row });
                            }
                            return data || '-';
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            if (!row) return '-';
                            if (type === 'display') {
                                log(`🎨 Rendering column 4 (effective period) for row ${meta.row}:`, row);
                            }
                            var from = formatDate(row.EffectiveFrom);
                            var to = row.EffectiveTo ? formatDate(row.EffectiveTo) : 'No end date';
                            return from + ' to ' + to;
                        }
                    },
                    {
                        data: 'RuleCount',
                        defaultContent: '-',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 5 (RuleCount) for row ${meta.row}:`, { data: data, row: row });
                            }
                            if (data === null || data === undefined) return '-';
                            return data + ' rule' + (data !== 1 ? 's' : '');
                        }
                    },
                    {
                        data: 'TotalPercentage',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 6 (TotalPercentage) for row ${meta.row}:`, { data: data, row: row });
                            }
                            if (data === null || data === undefined) return '-';
                            return parseFloat(data).toFixed(2) + '%';
                        }
                    },
                    {
                        data: 'IsActive',
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                log(`🎨 Rendering column 7 (IsActive) for row ${meta.row}:`, { data: data, row: row });
                            }
                            return data ?
                                '<span class="badge bg-success">Active</span>' :
                                '<span class="badge bg-danger">Inactive</span>';
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row, meta) {
                            if (!data) return '<span class="text-muted">No ID</span>';

                            if (type === 'display') {
                                log(`🎨 Rendering column 8 (actions) for row ${meta.row}:`, { id: data, row: row });
                            }

                            var recordId = encodeURIComponent(data);
                            var safeId = (data || '').replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                            var btnId = 'actionDropdown_' + safeId;

                            return `
                                    <div class="dropdown text-center">
                                        <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                                type="button" id="${btnId}"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="mdi mdi-cog-outline"></i> Actions
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                            <li><button type="button" class="dropdown-item btn-details" data-id="${recordId}">
                                                <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                            </button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button type="button" class="dropdown-item btn-edit" data-id="${recordId}">
                                                <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                                            </button></li>
                                            <li><button type="button" class="dropdown-item btn-delete text-danger" data-id="${recordId}">
                                                <i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete
                                            </button></li>
                                        </ul>
                                    </div>
                                `;
                        }
                    }
                ],
                language: {
                    emptyTable: 'No commission configurations found',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    lengthMenu: 'Show _MENU_ entries',
                    processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>',
                    zeroRecords: 'No matching records found'
                },
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                initComplete: function (settings, json) {
                    log('✅ DataTable initialization complete');
                    console.group('📊 InitComplete Details');
                    console.log('Settings:', settings);
                    console.log('JSON response:', json);
                    console.log('Records total:', json?.recordsTotal);
                    console.log('Records filtered:', json?.recordsFiltered);
                    console.log('Data length:', json?.data?.length);

                    // Log first record if available
                    if (json?.data?.length > 0) {
                        console.log('First record sample:', json.data[0]);
                    }
                    console.groupEnd();

                    logTableState('After initComplete');
                },
                drawCallback: function (settings) {
                    var api = this.api();
                    var data = api.data();
                    var pageInfo = api.page.info();

                    log(`📊 DataTable redraw callback - START`);
                    console.group('📊 DrawCallback Details');
                    console.log('Rows in current view:', api.rows({ page: 'current' }).count());
                    console.log('Total rows in DataTable:', api.rows().count());
                    console.log('Page info:', pageInfo);

                    if (data.length > 0) {
                        console.log('First row data:', data[0]);
                    } else {
                        console.warn('No data in DataTable after draw');
                    }
                    console.groupEnd();

                    logTableState('After draw callback');
                },
                preDrawCallback: function (settings) {
                    log('🔄 DataTable pre-draw callback');
                    return true;
                },
                rowCallback: function (row, data, index) {
                    log(`📌 Row callback for index ${index}:`, {
                        row: row,
                        data: data,
                        id: data?.Id,
                        effectiveFrom: data?.EffectiveFrom
                    });
                }
            });

            log('🚀 DataTable initialization - COMPLETE');
            logTableState('After initialization');
            return true;
        }

        function initDataTableIfNeeded() {
            log('🔍 Checking if DataTable needs initialization');
            logTableState('Before check');

            if ($.fn.DataTable.isDataTable('#myDataTable') && configTable) {
                log('✅ DataTable already initialized');

                // Force a reload to ensure data is displayed
                var dt = $('#myDataTable').DataTable();
                if (dt.rows().count() === 0) {
                    log('⚠️ DataTable has 0 rows, forcing reload');
                    dt.ajax.reload();
                }

                logTableState('After check (already initialized)');
                return true;
            }

            if (!$('#myDataTable').length) {
                console.error('❌ Table element #myDataTable not found');
                appalert('Table element #myDataTable not found', 0, 1);
                return false;
            }

            log('🆕 DataTable needs initialization - proceeding');
            return initDataTable();
        }

        function loadData() {
            log('🔄 Loading data - manual refresh triggered');
            logTableState('Before loadData');

            if (!initDataTableIfNeeded()) {
                console.error('❌ Failed to initialize DataTable');
                return;
            }

            if (configTable) {
                log('🔄 Reloading DataTable data via ajax.reload()');
                configTable.ajax.reload(function (json) {
                    log('✅ Data reload callback executed', json);

                    // Force a redraw after reload
                    configTable.draw();

                    logTableState('After ajax.reload');
                }, false); // false = keep current paging
            }
        }

        function resetFilters() {
            log('🔄 Resetting filters');
            var form = document.getElementById('commissionFilterForm');
            if (form) form.reset();

            if ($.fn.select2) {
                $('#branchId, #collectorId').val(null).trigger('change');
            }

            loadData();
            appalert('Filters reset', 3, 1);
        }

        function enterEditMode() {
            log('✏️ Entering edit mode');
            $('#filtersSection').hide();
            try {
                if (window.configTable && $.fn.DataTable.isDataTable('#myDataTable')) {
                    log('🗑️ Destroying DataTable instance');
                    window.configTable.destroy(true);
                    window.configTable = null;
                }
            } catch (e) {
                console.warn('⚠️ Failed to destroy configTable', e);
            }
            logTableState('After entering edit mode');
        }

        function exitEditModeAndReload() {
            log('🔄 Exiting edit mode and reloading');
            $('#filtersSection').show();
            AddORUpdateGen(null, 'datalistingview', '_CommissionConfigDataTable', 'get', 'DailyCollectorCommissionConfig');
            setTimeout(function () {
                try {
                    log('⏰ Timeout executed - reinitializing DataTable');
                    initDataTableIfNeeded();
                } catch (e) {
                    console.error('❌ Failed to init datatable after exiting edit mode', e);
                }
            }, 300);
        }

        $(document).ready(function () {
            log('🚀 DOCUMENT READY - STARTING APPLICATION');
            console.log('%c🎯 Commission Config Page Loaded', 'color: blue; font-size: 14px; font-weight: bold;');

            // Log environment info
            console.group('🌍 Environment Info');
            console.log('jQuery version:', $.fn.jquery);
            console.log('DataTable available:', typeof $.fn.DataTable !== 'undefined');
            console.log('Moment available:', typeof moment !== 'undefined');
            console.log('Bootstrap available:', typeof bootstrap !== 'undefined');
            console.log('Select2 available:', typeof $.fn.select2 !== 'undefined');
            console.groupEnd();

            if (typeof $.fn.DataTable === 'undefined') {
                console.error('❌ DataTable plugin not loaded!');
                appalert('DataTable plugin failed to load', 0, 1);
                return;
            }

            // Log initial DOM state
            logTableState('Document ready - initial');

            // Bind filter button events
            $('#applyFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                log('🔍 Apply filter button clicked');
                loadData();
            });

            $('#resetFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                log('🔄 Reset filter button clicked');
                resetFilters();
            });

            // Initialize Select2 if available
            if ($.fn.select2) {
                $('#branchId, #collectorId').select2({
                    width: '100%',
                    placeholder: 'Select option',
                    allowClear: true
                });
                log('✅ Select2 initialized');
            }

            // Initialize DataTable
            log('🎬 Calling initDataTableIfNeeded()');
            initDataTableIfNeeded();

            // Details button handler
            $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                log('👁️ Details button clicked', { raw: raw, id: id });

                if (!id) {
                    appalert('Missing id for details', 0, 1);
                    return;
                }

                var modalEl = document.getElementById('configDetailsModal');
                if (!modalEl) {
                    appalert('Details modal not found', 0, 1);
                    return;
                }

                var bsModal = new bootstrap.Modal(modalEl);
                $('#configDetailsModal .modal-body').html('<div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                bsModal.show();

                $.get('/DailyCollectorCommissionConfig/InitializeData', { KEY: id })
                    .done(function (html) {
                        log('✅ Details loaded successfully');
                        $('#configDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
                    })
                    .fail(function (xhr) {
                        log('❌ Failed to load details', { status: xhr.status });
                        $('#configDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                        appalert('Failed to load details', 0, 1);
                    });
            });

            // Edit button handler
            $(document).off('click', '.btn-edit').on('click', '.btn-edit', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                log('✏️ Edit button clicked', { raw: raw, id: id });

                if (!id) {
                    appalert('Missing id for edit', 0, 1);
                    return;
                }

                enterEditMode();
                AddORUpdateGen(id, 'datalistingview', '_CommissionConfigForm', 'get', 'DailyCollectorCommissionConfig');
            });

            // Cancel edit button handler
            $(document).off('click', '.btn-cancel-edit').on('click', '.btn-cancel-edit', function (e) {
                e.preventDefault();
                log('❌ Cancel edit clicked');
                exitEditModeAndReload();
            });

            // Delete button handler
            $(document).off('click', '.btn-delete').on('click', '.btn-delete', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                log('🗑️ Delete button clicked', { raw: raw, id: id });

                if (!id) {
                    appalert('Missing id for delete', 0, 1);
                    return;
                }

                DeleteRecordDataTable('DailyCollectorCommissionConfig', id, 'myDataTable', '_CommissionConfigDataTable', 0, 'datalistingview', null, 'list');
            });

            // Add new button handler
            $(document).on('click', '[onclick*="AddORUpdateGen"][onclick*="new"]', function (e) {
                e.preventDefault();
                log('➕ Add new button clicked');
                enterEditMode();
                AddORUpdateGen(null, 'datalistingview', '_CommissionConfigForm', 'new', 'DailyCollectorCommissionConfig');
            });

            // Enter key triggers apply
            $('#commissionFilterForm input').off('keypress').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    log('⏎ Enter key pressed in filter input');
                    loadData();
                }
            });

            log('✅ DOCUMENT READY - COMPLETE');
        });
    </script>
}