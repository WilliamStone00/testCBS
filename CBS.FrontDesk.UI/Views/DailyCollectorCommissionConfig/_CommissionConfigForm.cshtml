@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.DailyCollectorCommissionScomand
@using CBS.FrontDesk.UI.Helper
@using System.Globalization

@{
    // Set default dates for new records
    var today = DateTime.Today;
    var defaultEffectiveFrom = Model != null && Model.EffectiveFrom != DateTime.MinValue ? Model.EffectiveFrom : today.AddMonths(6);
    var defaultEffectiveTo = Model != null && Model.EffectiveTo.HasValue && Model.EffectiveTo.Value != DateTime.MinValue ? Model.EffectiveTo.Value : today.AddMonths(6);

    // Format dates for input (YYYY-MM-DD) and display using DateHelper
    var effectiveFromForInput = defaultEffectiveFrom?.ToString("yyyy-MM-dd");
    var effectiveFromForDisplay = DateHelper.FormatNullableDate(defaultEffectiveFrom);

    var effectiveToForInput = defaultEffectiveTo.ToString("yyyy-MM-dd");
    var effectiveToForDisplay = DateHelper.FormatDate(defaultEffectiveTo);

    var todayValue = Model?.EffectiveFrom != null
    ? Model.EffectiveFrom?.ToString("yyyy-MM-dd")
    : DateTime.Today.ToString("yyyy-MM-dd");

    var todayDisplay = Model?.EffectiveFrom != null
       ? Model.EffectiveFrom?.ToString("dd/MM/yyyy")
       : DateTime.Today.ToString("dd/MM/yyyy");
}

<div class="card mb-3">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "DailyCollectorCommissionConfig")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="View List">
            <i class="mdi mdi-view-list mdi-18px"></i> View List
        </a>
        @*<button type="button" onclick="AddORUpdateGen(null,'datalistingview','_CommissionConfigForm','new','DailyCollectorCommissionConfig')"
                class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Configuration">
            <i class="mdi mdi-plus mdi-18px"></i> ADD NEW
        </button>*@
    </div>
</div>

<div class="card mb-1">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "DailyCollectorCommissionConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);", id = "commissionConfigForm" }))
        {
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.IsCentralised, new { id = "IsCentralised" })

            <div class="row gy-3">
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-cog-outline me-1"></i> Configuration Type
                    </h6>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="fw-bold me-3">Configuration Scope:</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeSingle" value="single" @(Model != null && !Model.IsCentralised && !string.IsNullOrEmpty(Model.CollectorId) ? "checked" : (!Model?.IsCentralised == true ? "" : "checked"))>
                            <label class="form-check-label" for="scopeSingle">Single Collector</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeAll" value="all" @(Model != null && !Model.IsCentralised && string.IsNullOrEmpty(Model.CollectorId) ? "checked" : "")>
                            <label class="form-check-label" for="scopeAll">All Collectors</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeCentralised" value="centralised" @(Model != null && Model.IsCentralised ? "checked" : "")>
                            <label class="form-check-label" for="scopeCentralised">Centralised</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-12" id="branchField" style="@(Model != null && Model.IsCentralised ? "display: none;" : "display: block;")">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name", Model?.BranchId),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label>Branch</label>
                    </div>
                </div>

                <div class="col-md-6" id="collectorField" style="@(Model != null && (Model.IsCentralised || string.IsNullOrEmpty(Model.BranchId)) ? "display: none;" : "display: block;")">
                    <div class="form-floating shadow-sm">
                        <select id="CollectorId" name="CollectorId" class="form-control select2" @(Model != null && (Model.IsCentralised || string.IsNullOrEmpty(Model.BranchId)) ? "disabled" : "")>
                            <option value="">--- Select Collector ---</option>
                            @if (ViewBag.Collectors != null)
                            {
                                foreach (var collector in ViewBag.Collectors)
                                {
                                    <option value="@collector.Value" @(Model != null && Model.CollectorId == collector.Value ? "selected" : "")>@collector.Text</option>
                                }
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.CollectorId, "", new { @class = "text-danger" })
                        <label>Collector</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        <input type="date"
                               id="EffectiveFrom"
                               name="EffectiveFrom"
                               value="@todayValue"
                               class="form-control date-input"
                               placeholder="Effective From"
                               data-display-format="dd/MM/yyyy" />
                        <label>
                            Effective From
                            <small class="text-muted">(@todayDisplay)</small>
                        </label>
                        @Html.ValidationMessageFor(m => m.EffectiveFrom, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        <input type="date"
                               id="EffectiveTo"
                               name="EffectiveTo"
                               value="@effectiveToForInput"
                               class="form-control date-input"
                               placeholder="Effective To"
                               data-display-format="dd/MM/yyyy" />
                        <label>Effective To (Optional) <small class="text-muted">(@effectiveToForDisplay)</small></label>
                        @Html.ValidationMessageFor(m => m.EffectiveTo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                        <label class="form-check-label" for="IsActive">Is Active</label>
                    </div>
                </div>

                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-chart-pie me-1"></i> Commission Rules
                    </h6>
                </div>

                <div class="col-12" id="rulesContainer">
                    @if (Model?.Rules != null && Model.Rules.Any())
                    {
                        for (int i = 0; i < Model.Rules.Count; i++)
                        {
                            <div class="row rule-item mb-2">
                                <div class="col-md-5">
                                    <select name="Rules[@i].Stakeholder" class="form-select">
                                        <option value="">-- Select Stakeholder --</option>
                                        <option value="COLLECTOR" @(Model.Rules[i].Stakeholder == "COLLECTOR" ? "selected" : "")>COLLECTOR</option>
                                        <option value="BRANCH" @(Model.Rules[i].Stakeholder == "BRANCH" ? "selected" : "")>BRANCH</option>
                                    </select>
                                </div>

                                <div class="col-md-5">
                                    <input type="number"
                                           name="Rules[@i].Percentage"
                                           value="@Model.Rules[i].Percentage.ToString("0.00", CultureInfo.InvariantCulture)"
                                           class="form-control percentage-input"
                                           placeholder="Percentage"
                                           step="0.01"
                                           min="0"
                                           max="100" />
                                </div>

                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger remove-rule">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row rule-item mb-2">
                            <div class="col-md-5">
                                <select name="Rules[0].Stakeholder" class="form-select">
                                    <option value="">-- Select Stakeholder --</option>
                                    <option value="COLLECTOR">COLLECTOR</option>
                                    <option value="BRANCH">BRANCH</option>
                                </select>
                            </div>

                            <div class="col-md-5">
                                <input type="number"
                                       name="Rules[0].Percentage"
                                       class="form-control percentage-input"
                                       placeholder="Percentage"
                                       step="0.01"
                                       min="0"
                                       max="100" />
                            </div>

                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger remove-rule">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-12">
                    <button type="button" id="addRuleBtn" class="btn btn-sm btn-info">
                        <i class="mdi mdi-plus"></i> Add Rule
                    </button>
                    <span class="text-muted ms-3" id="totalPercentageDisplay">
                        Total: @(Model?.Rules != null && Model.Rules.Any() ? Model.Rules.Sum(r => r.Percentage).ToString("0.00") : "0")%
                    </span>
                </div>

                <div class="col-12 text-end mt-3">
                    @if (string.IsNullOrEmpty(Model?.Id))
                    {
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="fas fa-save me-1"></i> Create Configuration
                        </button>
                        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                            Reset
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-save me-1"></i> Update
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-cancel-edit">Cancel</button>
                </div>
            </div>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
        // Re-initialize Select2 if available
        if ($.fn.select2) {
            $('#BranchId, #CollectorId').select2({ width: '100%' });
        }

        // Trigger scope initialization
        var hasId = $('#Id').val() && $('#Id').val() !== '';
        if (hasId) {
            // Trigger change event on the checked radio to ensure proper visibility
            var checkedScope = $('input[name="ConfigScope"]:checked').val();
            if (checkedScope) {
                $('input[name="ConfigScope"][value="' + checkedScope + '"]').trigger('change');
            }
        } else {
            // For new records, ensure the form is visible when ADD NEW is clicked
            // The AddORUpdateGen function should handle showing the form
        }

        // Handle date input display
        $('.date-input').each(function () {
            var $this = $(this);
            var dateValue = $this.val();
            if (dateValue) {
                // The input type="date" will show in browser's local format
                // We're showing the formatted date in the label using DateHelper
                console.log('Date set to:', dateValue);
            }
        });
    });

    // Override or enhance the AddORUpdateGen function if needed
    window.showCommissionConfigForm = function () {
        $('#configFormContainer').show();
        // Reset form for new record
        $('#commissionConfigForm')[0].reset();
        $('#Id').val('');
        // Set default dates
        var today = new Date();
        var sixMonthsLater = new Date();
        sixMonthsLater.setMonth(today.getMonth() + 6);

        $('#EffectiveFrom').val(today.toISOString().split('T')[0]);
        $('#EffectiveTo').val(sixMonthsLater.toISOString().split('T')[0]);

        // Reset scope to default (Single Collector)
        $('#scopeSingle').prop('checked', true).trigger('change');
    };
</script>