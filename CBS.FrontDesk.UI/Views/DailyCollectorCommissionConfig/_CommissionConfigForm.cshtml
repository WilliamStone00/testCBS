@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.DailyCollectorCommissionShareConfig

<div class="card mb-3">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "DailyCollectorCommissionConfig")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="View List">
            <i class="mdi mdi-view-list mdi-18px"></i> View List
        </a>
        <button type="button" onclick="AddORUpdateGen(null,'datalistingview','_CommissionConfigForm','new','DailyCollectorCommissionConfig')"
                class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Configuration">
            <i class="mdi mdi-plus mdi-18px"></i> ADD NEW
        </button>
    </div>
</div>

@*<div class="card mb-3" id="configFormContainer" style="display: none;">*@
<div class="card mb-1">
    <div class="modal-body" >
        @using (Html.BeginForm("CreateOrUpdate", "DailyCollectorCommissionConfig", FormMethod.Post,new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);"}))
        {
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.CreatedAt)

            <div class="row gy-3">
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-cog-outline me-1"></i> Configuration Type
                    </h6>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="fw-bold me-3">Configuration Scope:</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeSingle" value="single" checked>
                            <label class="form-check-label" for="scopeSingle">Single Collector</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeAll" value="all">
                            <label class="form-check-label" for="scopeAll">All Collectors</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input config-scope" type="radio" name="ConfigScope" id="scopeCentralised" value="centralised">
                            <label class="form-check-label" for="scopeCentralised">Centralised</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-12" id="branchField">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label>Branch</label>
                    </div>
                </div>

                <div class="col-md-6" id="collectorField">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.CollectorId,
                            new SelectList(ViewBag.Collectors ?? new List<object>(), "Value", "Text"),
                            "--- Select Collector ---",
                            new
                                 {
                                @class = "form-control select2",
                                id = "CollectorId",
                                disabled = "disabled"  // Initially disabled until branch is selected
                            })
                        @Html.ValidationMessageFor(m => m.CollectorId, "", new { @class = "text-danger" })
                        <label>Collector</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.EffectiveFrom,
                            new { @class = "form-control", type = "date", placeholder = "Effective From" })
                        @Html.ValidationMessageFor(m => m.EffectiveFrom, "", new { @class = "text-danger" })
                        <label>Effective From</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.EffectiveTo,
                            new { @class = "form-control", type = "date", placeholder = "Effective To" })
                        @Html.ValidationMessageFor(m => m.EffectiveTo, "", new { @class = "text-danger" })
                        <label>Effective To (Optional)</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                        <label class="form-check-label" for="IsActive">Is Active</label>
                    </div>
                </div>

                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-chart-pie me-1"></i> Commission Rules
                    </h6>
                </div>

                <div class="col-12" id="rulesContainer">
                    @if (Model.Rules != null && Model.Rules.Any())
                    {
                        for (int i = 0; i < Model.Rules.Count; i++)
                        {
                            <div class="row rule-item mb-2">
                                <div class="col-md-5">
                                    <input type="text" name="Rules[@i].Stakeholder" value="@Model.Rules[i].Stakeholder"
                                           class="form-control" placeholder="Stakeholder (e.g., COLLECTOR)" />
                                </div>
                                <div class="col-md-5">
                                    <input type="number" name="Rules[@i].Percentage" value="@Model.Rules[i].Percentage"
                                           class="form-control percentage-input" placeholder="Percentage" step="0.01" min="0" max="100" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger remove-rule"><i class="mdi mdi-delete"></i></button>
                                </div>
                                @Html.HiddenFor(m => m.Rules[i].Id)
                                @Html.HiddenFor(m => m.Rules[i].ConfigId)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row rule-item mb-2">
                            <div class="col-md-5">
                                <input type="text" name="Rules[0].Stakeholder" class="form-control" placeholder="Stakeholder (e.g., COLLECTOR)" />
                            </div>
                            <div class="col-md-5">
                                <input type="number" name="Rules[0].Percentage" class="form-control percentage-input" placeholder="Percentage" step="0.01" min="0" max="100" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger remove-rule"><i class="mdi mdi-delete"></i></button>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-12">
                    <button type="button" id="addRuleBtn" class="btn btn-sm btn-info">
                        <i class="mdi mdi-plus"></i> Add Rule
                    </button>
                    <span class="text-muted ms-3" id="totalPercentageDisplay">Total: 0%</span>
                </div>

                <div class="col-12 text-end mt-3">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="fas fa-save me-1"></i> Create Configuration
                        </button>
                        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                            Reset
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">Update</button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-cancel-edit">Cancel</button>
                </div>
            </div>
        }
    </div>
</div>


