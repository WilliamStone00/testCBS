@{
    ViewBag.Title = "Daily Collector Commission Configuration";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-percent me-2"></i> Daily Collector Commission Configuration
                </h1>
                <p class="card-text">
                    Configure commission sharing rules for daily collectors across branches
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Configure commission splits between collectors and branches based on centralised or branch-specific rules.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> Quick Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i><strong>Configuration Types:</strong> Choose between Single Collector, All Collectors, or Centralised configuration</li>
                <li><i class="mdi mdi-percent text-info me-2"></i><strong>Commission Rules:</strong> Define percentage splits between stakeholders (COLLECTOR, BRANCH, etc.)</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i><strong>Effective Period:</strong> Set effective from/to dates for when the commission rule applies</li>
                <li><i class="mdi mdi-toggle-switch text-warning me-2"></i><strong>Active Status:</strong> Only active configurations will be applied during commission calculation</li>
                <li><i class="mdi mdi-refresh text-info me-2"></i><strong>Refresh:</strong> Always refresh data to make sure your results are up to date</li>
            </ul>
        </div>
    </div>
</div>

    <div id="datalistingview">
        @Html.Partial("_CommissionConfigForm")
    </div>


<!-- Commission Config Details Modal -->
<div class="modal fade" id="configDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-file-document-outline me-1"></i> Commission Configuration Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script >

        (function ($) {
            'use strict';

            function normalizeResponse(raw) {
                if (!raw) return { success: false, message: 'Empty response' };
                if (typeof raw === 'object') return raw;
                if (typeof raw === 'string') {
                    var t = raw.trim();
                    try {
                        return JSON.parse(t);
                    } catch (e) {
                        var start = t.indexOf('{'), end = t.lastIndexOf('}');
                        if (start >= 0 && end > start) {
                            try { return JSON.parse(t.substring(start, end + 1)); } catch (e2) { }
                        }
                    }
                }
                return { success: false, message: 'Unexpected server response' };
            }

            function showMsg(msg, level) {
                if (typeof appalert === 'function') appalert(msg || 'No message', level || 1, 1);
                else if (level && level <= 2) console.log((level === 1 ? 'OK: ' : 'WARN: ') + (msg || ''));
                else alert(msg || 'No message');
            }

            function getAntiForgeryToken() {
                return $('input[name="__RequestVerificationToken"]').first().val() || null;
            }

            function reloadListing(response) {
                try {
                    if (typeof LoadDataGen === 'function') {
                        LoadDataGen('DailyCollectorCommissionConfig',
                            'myDataTable',
                            '_CommissionConfigDataTable',
                            0,
                            'datalistingview',
                            null,
                            'list');
                        return;
                    }
                } catch (e) {
                    console.warn('LoadDataGen call failed', e);
                }

                if ($('#datalistingview').length) {
                    $.get('/DailyCollectorCommissionConfig/InitializeData', { path: 'list', partialView: '_CommissionConfigDataTable' })
                        .done(function (html) { $('#datalistingview').html(html); })
                        .fail(function () { location.reload(); });
                    return;
                }

                location.reload();
            }

            window.__categorySubmitAjaxFull = function (form) {
                try { $.validator.unobtrusive.parse(form); } catch (e) { }
                var $form = $(form);
                if ($form.length && !$form.valid()) return false;

                var isMultipart = ($form.attr('enctype') || '').toLowerCase() === 'multipart/form-data';
                var token = getAntiForgeryToken();
                var $submit = $form.find('[type="submit"]').first();
                var origHtml = $submit.data('orig-html') || $submit.html();
                $submit.data('orig-html', origHtml);
                $submit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');

                var doAjax = function () {
                    var ajaxOptions = {
                        url: $form.attr('action'),
                        type: ($form.attr('method') || 'POST').toUpperCase(),
                        dataType: 'text',
                        success: function (raw) {
                            var res = normalizeResponse(raw);
                            if (res && res.success) {
                                showMsg(res.message || 'Operation successful', 1);
                                if (res.reloadDataView === "Yes" || res.reload === true) reloadListing(res);

                                // Hide form and show filters after successful save
                                $('#configFormContainer').hide();
                                $('#filtersSection').show();
                            } else {
                                showMsg((res && res.message) ? res.message : 'Operation failed', 2);
                            }
                        },
                        error: function (xhr) {
                            var parsed = normalizeResponse(xhr.responseText);
                            if (parsed && parsed.message) showMsg(parsed.message, parsed.success ? 1 : 2);
                            else if (xhr.status === 401) window.location.href = '/Authentication/Login';
                            else {
                                showMsg(xhr.statusText || 'Network error', 4);
                                console.error('submitAjax error', xhr.status, xhr.responseText);
                            }
                        },
                        complete: function () {
                            $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                        }
                    };

                    if (isMultipart) {
                        ajaxOptions.data = new FormData(form);
                        ajaxOptions.processData = false;
                        ajaxOptions.contentType = false;
                        if (token) ajaxOptions.headers = { 'RequestVerificationToken': token };
                    } else {
                        ajaxOptions.data = $form.serialize();
                        if (token) ajaxOptions.headers = { 'RequestVerificationToken': token };
                    }

                    $.ajax(ajaxOptions);
                };

                if (window.alertify && typeof alertify.confirm === 'function') {
                    try {
                        alertify.confirm("Confirmation", "Are you sure you want to perform this action?",
                            function () { doAjax(); },
                            function () { showMsg('Transaction cancelled', 3); })
                            .set('labels', { ok: 'Yes', cancel: 'No' });
                    } catch (e) {
                        if (confirm('Are you sure?')) doAjax(); else showMsg('Cancelled', 3);
                    }
                } else {
                    if (confirm('Are you sure you want to perform this action?')) doAjax();
                    else showMsg('Transaction cancelled', 3);
                }

                return false;
            };

            //window.categorySubmitAjax = window.__categorySubmitAjaxFull;

            //$(document).on('submit', 'form[action*="CreateOrUpdate"][action*="DailyCollectorCommissionConfig"]', function (e) {
            //    e.preventDefault();
            //    return window.categorySubmitAjax(this);
            //});

        })(jQuery);

    </script>
    <script>
  $(document).ready(function() {
    // Initialize select2
    if ($.fn.select2) {
        $('#BranchId, #CollectorId').select2({ width: '100%' });
    }

    // Hide form initially if not in edit mode
    if ('@Model.Id' === '') {
        $('#configFormContainer').hide();
    } else {
        $('#configFormContainer').show();
        initializeScopeBasedOnModel();
    }

    // Scope change handler
    $('.config-scope').change(function() {
        var scope = $(this).val();

        if (scope === 'single') {
            $('#branchField').show();
            $('#collectorField').show();
            $('#IsCentralised').val(false);
            // Clear and disable collector dropdown until branch is selected
            $('#CollectorId').empty().append('<option value="">--- Select Collector ---</option>').trigger('change');
            $('#CollectorId').prop('disabled', true);
        } else if (scope === 'all') {
            $('#branchField').show();
            $('#collectorField').hide();
            $('#CollectorId').val('').trigger('change');
            $('#CollectorId').prop('disabled', false);
            $('#IsCentralised').val(false);
        } else if (scope === 'centralised') {
            $('#branchField').hide();
            $('#collectorField').hide();
            $('#BranchId').val('').trigger('change');
            $('#CollectorId').val('').trigger('change');
            $('#CollectorId').prop('disabled', false);
            $('#IsCentralised').val(true);
        }
    });

    // Branch change handler - load collectors when branch is selected
    $('#BranchId').change(function() {
        var branchId = $(this).val();
        var scope = $('input[name="ConfigScope"]:checked').val();

        // Only load collectors if Single Collector is selected and branch is selected
        if (scope === 'single' && branchId) {
            loadCollectorsByBranch(branchId);
        } else if (scope === 'single' && !branchId) {
            // If branch is cleared, disable and clear collector dropdown
            $('#CollectorId').empty().append('<option value="">--- Select Collector ---</option>').trigger('change');
            $('#CollectorId').prop('disabled', true);
        }
    });

    // Function to load collectors by branch
    function loadCollectorsByBranch(branchId) {
        // Show loading state
        $('#CollectorId').empty().append('<option value="">Loading collectors...</option>').trigger('change');
        $('#CollectorId').prop('disabled', true);

        // Get anti-forgery token if needed
        var token = getAntiForgeryToken();

        $.ajax({
            url: '/DailyCollectorCommissionConfig/GetCollectorsByBranch',
            type: 'GET',
            data: { branchId: branchId },
            dataType: 'json',
            headers: token ? { 'RequestVerificationToken': token } : {},
            success: function(response) {
                $('#CollectorId').empty().append('<option value="">--- Select Collector ---</option>');

                if (response && response.length > 0) {
                    $.each(response, function(index, item) {
                        $('#CollectorId').append($('<option>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                    $('#CollectorId').prop('disabled', false);
                } else {
                    $('#CollectorId').append('<option value="">No collectors found</option>');
                    console.log('No collectors found for branch:', branchId);
                }

                $('#CollectorId').trigger('change');
            },
            error: function(xhr, status, error) {
                console.error('Error loading collectors:', error);
                $('#CollectorId').empty().append('<option value="">Error loading collectors</option>').trigger('change');

                if (xhr.status === 401) {
                    window.location.href = '/Authentication/Login';
                } else {
                    showMsg('Failed to load collectors. Please try again.', 4);
                }
            },
            complete: function() {
                // Reinitialize select2 if needed
                if ($.fn.select2) {
                    $('#CollectorId').select2({ width: '100%' });
                }
            }
        });
    }

    // Add rule
    $('#addRuleBtn').click(function() {
        var index = $('.rule-item').length;
        var newRow = `
            <div class="row rule-item mb-2">
                <div class="col-md-5">
                    <input type="text" name="Rules[${index}].Stakeholder" class="form-control" placeholder="Stakeholder (e.g., COLLECTOR)" />
                </div>
                <div class="col-md-5">
                    <input type="number" name="Rules[${index}].Percentage" class="form-control percentage-input" placeholder="Percentage" step="0.01" min="0" max="100" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger remove-rule"><i class="mdi mdi-delete"></i></button>
                </div>
            </div>
        `;
        $('#rulesContainer').append(newRow);
        updateTotalPercentage();
    });

    // Remove rule
    $(document).on('click', '.remove-rule', function() {
        if ($('.rule-item').length > 1) {
            $(this).closest('.rule-item').remove();
            reindexRules();
            updateTotalPercentage();
        } else {
            appalert('At least one rule is required', 3, 1);
        }
    });

    // Update total on percentage change
    $(document).on('input', '.percentage-input', function() {
        updateTotalPercentage();
    });

    // Form validation before submit
    $('#commissionConfigForm').on('submit', function(e) {
        var total = updateTotalPercentage();
        if (Math.abs(total - 100) > 0.01) {
            e.preventDefault();
            appalert('Total percentage must equal 100%', 2, 1);
            return false;
        }

        var scope = $('input[name="ConfigScope"]:checked').val();
        if (scope === 'single' && !$('#CollectorId').val()) {
            e.preventDefault();
            appalert('Please select a collector for single collector configuration', 2, 1);
            return false;
        }
        if (scope !== 'centralised' && !$('#BranchId').val()) {
            e.preventDefault();
            appalert('Please select a branch', 2, 1);
            return false;
        }
    });

    function initializeScopeBasedOnModel() {
        var isCentralised = '@Model.IsCentralised' === 'True';
        var hasCollector = '@(!string.IsNullOrEmpty(Model.CollectorId))' === 'True';

        if (isCentralised) {
            $('#scopeCentralised').prop('checked', true).trigger('change');
        } else if (hasCollector) {
            $('#scopeSingle').prop('checked', true).trigger('change');
            // If in edit mode with Single Collector, enable collector dropdown
            if ('@Model.BranchId') {
                $('#CollectorId').prop('disabled', false);
            }
        } else {
            $('#scopeAll').prop('checked', true).trigger('change');
        }
    }

    function reindexRules() {
        $('.rule-item').each(function(index) {
            $(this).find('input[name^="Rules"]').each(function() {
                var name = $(this).attr('name');
                var newName = name.replace(/Rules\[\d+\]/, 'Rules[' + index + ']');
                $(this).attr('name', newName);
            });
        });
    }

    function updateTotalPercentage() {
        var total = 0;
        $('.percentage-input').each(function() {
            var val = parseFloat($(this).val()) || 0;
            total += val;
        });
        $('#totalPercentageDisplay').text('Total: ' + total.toFixed(2) + '%');
        return total;
    }

    // Helper function to get anti-forgery token (reuse from your existing code)
    function getAntiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').first().val() || null;
    }

    // Helper function to show messages (reuse from your existing code)
    function showMsg(msg, level) {
        if (typeof appalert === 'function') appalert(msg || 'No message', level || 1, 1);
        else if (level && level <= 2) console.log((level === 1 ? 'OK: ' : 'WARN: ') + (msg || ''));
        else alert(msg || 'No message');
    }

    // Initial total calculation
    setTimeout(updateTotalPercentage, 500);
});
    </script>
}