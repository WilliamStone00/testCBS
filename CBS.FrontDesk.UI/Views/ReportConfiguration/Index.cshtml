    function ShowModal1(key, partialView, controller, path) {

        // Build URL safely
        var url = '/' + controller + '/Initilization?KEY=' + encodeURIComponent(key || '') +
            '&partialView=' + encodeURIComponent(partialView || '') +
            '&path=' + encodeURIComponent(path || '');

        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (html) {

                const modalEl = document.getElementById('genericModal');
                if (!modalEl) {
                    console.error('genericModal not found in DOM');
                    return;
                }

                const modalContent = modalEl.querySelector('.modal-content');
                if (!modalContent) {
                    console.error('.modal-content not found inside genericModal');
                    return;
                }

                // Inject Partial View HTML
                modalContent.innerHTML = html;

                // Initialize Bootstrap Modal
                const modal = new bootstrap.Modal(modalEl, {
                    backdrop: 'static',
                    keyboard: false
                });

                modal.show();

                // 🔥 Initialize dynamic content AFTER modal is shown
                modalEl.addEventListener('shown.bs.modal', function () {

                    // Re-parse unobtrusive validation
                    if ($.validator && $.validator.unobtrusive) {
                        $.validator.unobtrusive.parse(modalContent);
                    }

                    // Re-init Select2 inside modal
                    if ($.fn.select2) {
                        $(modalContent).find('.select2').select2({
                            dropdownParent: $('#genericModal')
                        });
                    }

                    // Custom initializer (if exists)
                    if (typeof window.initializeReportLineMapping === 'function') {
                        window.initializeReportLineMapping(modalContent);
                    }

                }, { once: true });

            },
            error: function (xhr) {
                console.error('Modal load error:', xhr);
                if (typeof appalert === 'function') {
                    appalert('Failed to load content', 0, 1);
                } else {
                    alert('Failed to load content');
                }
            }
        });
    }


        function showCreateModal(){
            ShowModal1(null, '_CreateOrUpdate', 'ReportLineMapping', 'new');
        }

               // ✅ Fonction pour ouvrir la modal d’édition
           function openReportLineMappingEditModal(reportId) {
                if (!reportId) {
