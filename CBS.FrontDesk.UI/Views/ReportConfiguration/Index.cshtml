@*@{
        ViewBag.Title = "Report Configuration";
    }*@


<!-- Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold">
                    <i class="mdi mdi-cog-outline me-2"></i> REPORT CONFIGURATION
                </h1>
                <p class="card-text text-muted">
                    Manage all report components: Definitions, Sections, Lines and Line Mappings.
                </p>
                <hr class="my-3" style="border-top: 2px solid rgba(0, 0, 0, 0.1);">
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips for Managing Report Configuration</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-format-list-bulleted-type text-primary me-2"></i>
                    <strong>Definitions:</strong> Provide clear identifiers and report types.
                </li>
                <li>
                    <i class="mdi mdi-view-list-outline text-success me-2"></i>
                    <strong>Sections:</strong> Organize your reports by logical areas or categories.
                </li>
                <li>
                    <i class="mdi mdi-file-tree-outline text-warning me-2"></i>
                    <strong>Lines:</strong> Configure your calculations, values, and formulas accurately.
                </li>
                <li>
                    <i class="mdi mdi-link-variant text-info me-2"></i>
                    <strong>Line Mappings:</strong> Match and map your data correctly for consistent outputs.
                </li>
            </ul>
        </div>
    </div>
</div>


<!-- Tabs -->
<div class="card shadow-sm border-0">

    <!-- Card Body -->
    <div class="card-body">

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="reportTabs">
            <li class="nav-item">
                <a class="nav-link active"
                   data-bs-toggle="tab"
                   href="#definitionContainer"
                   onclick="LoadDataGen('ReportConfiguration', 'myDataTable_definition', 'ReportConfiguration/ReportDefinition/_List', 0, 'definitionContainer',null,'definition')"
                   @* data-url="@Url.Action("InitializeData", "ReportConfiguration")"
                   data-params='{"path":"definition","partialView":"ReportConfiguration/ReportDefinition/_List"}'
                   *@>
                    <i class="mdi mdi-file-document-box-outline me-1"></i> Definition
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   data-bs-toggle="tab"
                   href="#sectionContainer"
                   onclick="LoadDataGen('ReportConfiguration', 'myDataTable_section', 'ReportConfiguration/ReportSection/_List', 0, 'sectionContainer',null,'section')"
                   @*data-url="@Url.Action("InitializeData", "ReportConfiguration")"
                   data-params='{"path":"section","partialView":"ReportConfiguration/ReportSection/_List"}'*@>
                    <i class="mdi mdi-view-list-outline me-1"></i> Section
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   data-bs-toggle="tab"
                   href="#lineContainer"
                   onclick="LoadDataGen('ReportConfiguration', 'myDataTable_line', 'ReportConfiguration/ReportLine/_List', 0, 'lineContainer',null,'line')">
                    @* data-url="@Url.Action("InitializeData", "ReportConfiguration")"
                        data-params='{"path":"line","partialView":"ReportConfiguration/ReportLine/_List"}'>*@
                    <i class="mdi mdi-format-line-weight me-1"></i> Line
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   data-bs-toggle="tab"
                   href="#mappingContainer"
                   onclick="LoadDataGen('ReportConfiguration', 'myDataTable_line_mapping', 'ReportConfiguration/ReportLineMapping/_List', 0, 'mappingContainer',null,'line_mapping')">
                    @*    data-url="@Url.Action("InitializeData", "ReportConfiguration")"
                        data-params='{"path":"line_mapping","partialView":"ReportConfiguration/ReportLineMapping/_List"}'*@


                    <i class="mdi mdi-link-variant me-1"></i> Mapping
                </a>
            </li>
        </ul>

        <!-- Tab content -->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="definitionContainer"></div>
            <div class="tab-pane fade" id="sectionContainer"></div>
            <div class="tab-pane fade" id="lineContainer"></div>
            <div class="tab-pane fade" id="mappingContainer"></div>

        </div>

        <div id="datalistingview">
        </div>

    </div>
</div>

