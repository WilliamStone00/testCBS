                $("#reportModalBody").load('@Url.Action("Initilization", "ReportLineMapping")',
                { path: "edit", partialView: "_CreateOrUpdate", KEY: reportId },
                function (response, status, xhr) {
                if (status === "success") {

                // ✅ Initialize Select2 inside modal AFTER content is loaded
                initSelect2("#reportModalBody");

                var modalElement = document.getElementById('reportModal');
                var modal = new bootstrap.Modal(modalElement);
                modal.show();

                } else {
                console.error("Error loading edit form:", xhr.status, xhr.statusText);
                alert("Failed to load the edit form. Please try again.");
                }
                }
                );
            }
     
    </script>
