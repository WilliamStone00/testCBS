@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportDefinition.ReportDefinition>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Definitions</h5>
   <a href="javascript:void(0);" class="btn btn-sm btn-primary" onclick="openReportDefinitionCreateModal()">
    <i class="mdi mdi-plus"></i> New
   </a>
</div>

    <div class="table-responsive mb-3">
        <table class="table table-hover table-bordered align-middle text-nowrap" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 17%;">Code</th>
                    <th style="width: 30%;">Name</th>
                    <th style="width: 17%;">Type</th>
                    <th style="width: 12%;">Currency</th>
                    <th style="width: 12%;">Active</th>
                    <th style="width: 12%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.ReportType</td>
                        <td>@item.Currency</td>
                        <td>@(item.IsActive ? "Yes" : "No")</td>
                        <td>
                            <a href="javascript:void(0);" class="btn btn-sm btn-info" onclick="openReportDefinitionEditModal('@item.Id')">
                                <i class="mdi mdi-pencil"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


