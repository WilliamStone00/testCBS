@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportLineMapping.ReportLineMapping>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Line Mappings</h5>
    <a href="javascript:void(0);" class="btn btn-sm btn-primary" onclick="openReportLineMappingCreateModal()">
        <i class="mdi mdi-plus"></i> New
    </a>
</div>

<table class="table table-hover table-bordered align-middle text-nowrap" id="myDataTable_line_mapping">
    <thead>
        <tr>
            <th>Match Type</th>
            @*<th>From</th>
            <th>To</th>*@
            <th>Side</th>
            <th>Sign</th>
            <th>Include Liaison</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MatchType</td>
                @*<td>@item.FromValue</td>
                <td>@item.ToValue</td>*@
                <td>@item.Side</td>
                <td>@item.Sign</td>
                <td>@(item.IncludeLiaison ? "Yes" : "No")</td>

                <td>
                    <a href="javascript:void(0);" class="btn btn-sm btn-info"
                       onclick="openReportLineMappingEditModal('@item.Id')">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
