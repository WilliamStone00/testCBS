@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReportingV2.ReportLine.ReportLine>

<div class="d-flex justify-content-between mb-2">
    <h5>Report Lines</h5>
    <a href="javascript:void(0);" class="btn btn-sm btn-primary" onclick="openReportLineCreateModal()">
        <i class="mdi mdi-plus"></i> New
    </a>
</div>

<table class="table table-hover table-bordered align-middle text-nowrap" id="myDataTable_line">
    <thead>
        <tr>
            <th>Ref Code</th>
            <th>Caption</th>
            <th>Sort</th>
            <th>Calc Mode</th>
            <th>Show</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RefCode</td>
                <td>@item.Caption</td>
                <td>@item.SortOrder</td>
                <td>@item.CalcMode</td>
                <td>@(item.ShowInOutput ? "Yes" : "No")</td>
                <td>
                    <a href="javascript:void(0);" class="btn btn-sm btn-info"
                       onclick="openReportLineEditModal('@item.Id')">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
