@* _AffiliateData.cshtml *@
@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered nowrap" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:150px">@AccountingV2.CreatedDate</th>
                        <th style="min-width:110px">Branch</th>
                        <th style="min-width:90px">@AccountingV2.Code</th>
                        <th>@AccountingV2.Name</th>
                        <th style="min-width:110px">Class</th>
                        <th style="min-width:140px">AffiliateAccountId</th>
                        <th style="width:160px">@AccountingV2.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* DataTables will populate tbody via AJAX *@
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        const tableSelector = '#myDataTable';
        const ajaxUrl = '@Url.Action("GetAffiliateData", "BranchAccount")';

        function formatDateUtc(value) {
            if (!value) return '';
            try {
                const d = new Date(value);
                if (isNaN(d.getTime())) return value;
                return d.toLocaleString();
            } catch (e) {
                return value;
            }
        }

        function renderBoolBadge(data) {
            if (data === true || data === 'true' || data === 1) {
                return '<span class="badge bg-success">Yes</span>';
            }
            if (data === false || data === 'false' || data === 0) {
                return '<span class="badge bg-secondary">No</span>';
            }
            return '<span class="text-muted">—</span>';
        }

        // Initialize DataTable
        const dt = $(tableSelector).DataTable({
            processing: true,
            serverSide: true,
            responsive: true,
            ajax: {
                url: ajaxUrl,
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    return JSON.stringify(d);
                }
            },
            columns: [
                {   data: 'createdDate',
                    name: 'createdDate',
                    render: function (data, type, row) {
                        return formatDateUtc(data);
                    }
                },
                { data: 'branchId', name: 'branchId' },
                { data: 'code', name: 'code' },
                { data: 'name', name: 'name' },
                { data: 'class', name: 'class' },
                { data: 'affiliateAccountId', name: 'affiliateAccountId' },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        const id = row.id || row.Id || '';
                        const name = row.name || row.Name || '';
                        return `
                            <div class="d-flex gap-1 justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="${id}" title="Edit ${name}">
                                    <i class="mdi mdi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-details" data-id="${id}" title="Details ${name}">
                                    <i class="mdi mdi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" title="Delete ${name}">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </div>
                        `;
                    }
                }
            ],
           
            order: [[0, 'desc']],
            lengthMenu: [10, 25, 50, 100],
            pageLength: 25
        });

        // Delegated handlers for action buttons
        $('#affiliateListingView').on('click', '.btn-edit', function () {
            const id = $(this).data('id');
            openPartialInModal('@Url.Action("InitializeData", "BranchAccount")', { KEY: id, partialView: '_CreateAffiliate', path: 'get', serviceOption: 'AffiliateAccount' });
        });

        $('#affiliateListingView').on('click', '.btn-details', function () {
            const id = $(this).data('id');
            showAffiliateDetails(id);
        });

        $('#affiliateListingView').on('click', '.btn-delete', function () {
            const id = $(this).data('id');
            if (!id) return;
            if (!confirm('Delete this affiliate?')) return;
            $.post('@Url.Action("Delete", "BranchAccount")', { id: id })
                .done(function () { dt.ajax.reload(null, false); })
                .fail(function () { alert('Delete failed (see console).'); });
        });

    })();
    </script>
}
