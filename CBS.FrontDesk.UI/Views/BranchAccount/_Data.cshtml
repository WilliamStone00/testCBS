@* ----------------------- _AffiliateData.cshtml (table only) ----------------------- *@
@using Resources
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:10%" />  @* Created Date *@
                    <col style="width:15%" />  @* Branch Name *@
                    @*<col style="width:15%" />*@  @* Code *@
                    <col style="width:25%" />  @* Name *@
                    <col style="width:12%" />  @* Class *@
                    <col style="width:15%" />  @* Chart Of Account *@
                    @*<col style="width:15%" />*@  @* Chart Of Account *@
                    <col style="width:15%" />  @* Chart Of Account *@
                    <col style="width:8%" />   @* Actions *@
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.CreatedDate</th>
                        <th>Code Post</th>
                        @*<th>@GlobalShared.Branch_Name</th>*@
                        <th>@GlobalShared.Code</th>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Class</th>
                        @*<th>@GlobalShared.Chart_Of_Account</th>*@
                        <th>Nature</th>
                        <th>@GlobalShared.Actions</th>
                    </tr>
                </thead>
                <tbody><!-- filled by DataTables --></tbody>
            </table>
        </div>
    </div>
</div>


