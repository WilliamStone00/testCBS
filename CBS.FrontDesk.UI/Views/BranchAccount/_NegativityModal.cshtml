@model CBS.FrontDesk.Data.Entity.Accounting_V2.BranchAccount.UpdateAccountNegativityRequest
@using Resources;


<div class="modal fade" id="manageNegativityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-light">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary">
                                <i class="mdi mdi-bank-off me-2"></i>@BranchAccountRessources.Account_Negativity_Management
                            </h1>
                            <p class="card-text">
                                @BranchAccountRessources.Configure_negative_balance_allowances_for_branch_accounts_by_class_or_specific_account.
                            </p>
                            <div class="alert alert-info mt-3 py-2">
                                <i class="mdi mdi-alert-outline me-1"></i>
                                @BranchAccountRessources.Use_this_tool_to_manage_whether_accounts_can_have_negative_balances_Disabling_negativity_prevents_overdrafts.
                            </div>
                              <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i>  Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNegativityTips" aria-expanded="false">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseNegativityTips" class="collapse">
                    <div class="card-body">
                        <ul>
                            <li>
                                <i class="mdi mdi-filter-outline text-success me-2"></i>
                                <strong>@GlobalShared.Branch_Selection:</strong> @BranchAccountRessources.Start_by_selecting_a_branch_to_view_and_manage_its_account_negativity_settings.
                            </li>
                            <li>
                                <i class="mdi mdi-account-group text-primary me-2"></i>
                                <strong>@GlobalShared.Account_Class:</strong> @BranchAccountRessources.Apply_settings_to_all_accounts_within_a_specific_class_Asset_Liability_Equity.
                            </li>
                            <li>
                                <i class="mdi mdi-bank text-info me-2"></i>
                                <strong>@GlobalShared.Specific_Account:</strong> @BranchAccountRessources.Target_individual_branch_accounts_for_precise_negativity_control.
                            </li>
                            <li>
                                <i class="mdi mdi-check-circle text-success me-2"></i>
                                <strong>@GlobalShared.Allow_Negative:</strong> @BranchAccountRessources.When_enabled_accounts_can_have_negative_balances_useful_for_overdraft_facilities.
                            </li>
                            <li>
                                <i class="mdi mdi-close-circle text-danger me-2"></i>
                                <strong>@GlobalShared.Disallow_Negative:</strong> @BranchAccountRessources.When_disabled_accounts_must_maintain_positive_balances_at_all_times.
                            </li>
                            <li>
                                <i class="mdi mdi-alert-box text-warning me-2"></i>
                                <strong>@GlobalShared.Important:</strong> @BranchAccountRessources.Disabling_negativity_for_active_accounts_may_block_transactions_that_would_create_overdrafts.
                            </li>
                            <li>
                                <i class="mdi mdi-backup-restore text-secondary me-2"></i>
                                <strong>@GlobalShared.Bulk_Operations:</strong> @BranchAccountRessources.Use_By_Account_Class_to_apply_changes_to_multiple_accounts_simultaneously.
                            </li>
                            <li>
                                <i class="mdi mdi-shield-check text-success me-2"></i>
                                <strong>@GlobalShared.Risk_Management:</strong> @BranchAccountRessources.Regularly_review_negativity_settings_to_prevent_unauthorized_overdrafts.
                            </li>
                            <li>
                                <i class="mdi mdi-history text-info me-2"></i>
                                <strong>@GlobalShared.Audit_Trail:</strong> @BranchAccountRessources.All_negativity_changes_are_logged_with_user_timestamp_and_previous_settings.
                            </li>
                            <li>
                                <i class="mdi mdi-currency-usd-off text-danger me-2"></i>
                                <strong>@GlobalShared.Compliance:</strong> @BranchAccountRessources.Certain_account_types_like_reserve_accounts_may_legally_require_positive_balances.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.BranchId, GlobalUserManagement.Branch, new { @class = "form-label small" })
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- " + @GlobalUserManagement.SelectBranch + " ---",
                            new { @class = "form-select form-select-sm select2", id = "NegBranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
                    </div>

                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="d-flex gap-3 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="negativityMode"
                                       id="negModeClass" value="class" checked>
                                <label class="form-check-label" for="negModeClass">
                                    @BranchAccountRessources.By_Account_Class
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="negativityMode"
                                       id="negModeSpecific" value="specific">
                                <label class="form-check-label" for="negModeSpecific">
                                    @BranchAccountRessources.By_Specific_Account
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CLASS Section (Default) -->
                <div id="classSection" class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label">@GlobalShared.Account_Class</label>
                        @Html.DropDownList("NegClassId",
                            new SelectList(ViewBag.classes, "Value", "Text"),
                            "--- Select Class ---",
                            new { @class = "form-select form-select-sm select2", id = "NegClassId" })

                    </div>
                </div>

                <!-- SPECIFIC ACCOUNT Section (Hidden initially) -->
                <div id="specificAccountSection" class="row mb-3" style="display: none;">
                    <div class="col-md-12">
                        <label class="form-label">@GlobalShared.Branch_Account</label>
                        <select id="NegBranchAccountId" class="form-select form-select-sm select2"
                                disabled>
                            <option value="">--- @GlobalShared.First_select_Branch ---</option>
                        </select>
                    </div>
                </div>

                <!-- Negativity Option -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox"
                                   id="AllowNegativeBalance" checked>
                            <label class="form-check-label" for="AllowNegativeBalance">
                                @BranchAccountRessources.Allow_Negative_Balance
                            </label>
                        </div>
                        <small class="text-muted">
                            @BranchAccountRessources.When_enabled_accounts_can_have_negative_balances_When_disabled_all_balances_must_be_positive.
                        </small>
                    </div>
                </div>

                <!-- Summary Section -->
                <div id="negativitySummary" class="alert alert-info" style="display: none;">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-information-outline me-2"></i>
                        <div>
                            <strong>@GlobalShared.Summary:</strong>
                            <div id="summaryText" class="small"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnApplyNegativity">
                    <i class="mdi mdi-check-circle me-1"></i> @GlobalShared.Apply_Changes
                </button>
            </div>
        </div>
    </div>
</div>
