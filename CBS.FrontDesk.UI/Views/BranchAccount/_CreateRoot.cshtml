@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountRequest
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-1">
            <div class="card-body text-center py-2">
                <h1 class="card-title text-primary fs-4 mb-1">
                    <i class="mdi mdi-bank-outline me-2"></i> Root Branch Account Setup
                </h1>
                <div class="alert alert-info mt-2 py-1 mb-0">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Use this form to create branch-specific ledger accounts. Ensure the Account Number is unique within the branch and the Affiliate (Chart of Account) is selected correctly.
                </div>
                <hr class="my-2" style="border: 1px solid rgba(128,128,128,0.4);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary py-2">
        <span><i class="mdi mdi-help-circle-outline me-2"></i> Tips for Root Branch Account</span>
        <button class="btn btn-light btn-sm py-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBranchAccountTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseBranchAccountTips" class="collapse">
        <div class="card-body py-2">
            <ul class="mb-0">
                <li class="mb-1"><i class="mdi mdi-pound-box text-success me-2"></i><strong>Account Number:</strong> Digits only (e.g. <code>114000000110</code>), min length 12.</li>
                <li class="mb-1"><i class="mdi mdi-form-textbox text-info me-2"></i><strong>Account Name (EN/FR):</strong> Provide both English and Français.</li>
                <li class="mb-0"><i class="mdi mdi-shape-outline text-warning me-2"></i><strong>Class:</strong> Choose the accounting class (Asset, Liability, etc.).</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-2 mb-2">
    <div class="modal-body p-2">
        @using (Html.BeginForm("CreateOrUpdate", "BranchAccount", FormMethod.Post,
                  new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Scope)
            @Html.HiddenFor(m => m.Language)
            @Html.HiddenFor(m => m.RequiresMapping)
            @Html.HiddenFor(m => m.UpdateReference)
            @Html.HiddenFor(m => m.IsOrigin)
            @Html.HiddenFor(m => m.AffiliateId)
            @Html.HiddenFor(m => m.ChangeType)
            @* Ensure ROOT *@
            @Html.Hidden("ParentId", null)

            <div class="mt-1">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                <div class="row mb-2">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ParentAccountNumber, "Parent Account Number", new { @class = "form-label small text-muted mb-1" })
                        <input type="text" class="form-control form-control-sm" readonly value="(ROOT)" />
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Scope, "Scope", new { @class = "form-label small text-muted mb-1" })
                        <input type="text" class="form-control form-control-sm" readonly value="@Model.Scope" />
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.BranchId, "Branch", new { @class = "form-label mb-1" })
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- " + @GlobalUserManagement.SelectBranch + " ---",
                            new { @class = "form-select form-select-sm select2" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6 mb-2">
                        @Html.LabelFor(m => m.Class, "Account Class", new { @class = "form-label fw-semibold mb-1" })
                        @Html.DropDownListFor(
                            m => m.Class,
                            new SelectList(ViewBag.Classes ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Select Class ---",
                            new
                                 {
                                @class = "form-select form-select-sm select2",
                                onchange = "onClassChanged(this.value)",
                                // optional: pass the fetch URL via data attribute for flexibility
                                data_url = Url.Action("ListByClass", "AffiliateAccount")
                            })
                        @Html.ValidationMessageFor(m => m.Class, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-2">
                        @Html.LabelFor(m => m.AffiliateAccountId, "Affiliate Account (Chart of Accounts)", new { @class = "form-label mb-1" })
                        @Html.DropDownListFor(
                            m => m.AffiliateAccountId,
                            new SelectList(ViewBag.AffiliateAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Select Affiliate Account (Chart of Account) ---",
                            new
                                 {
                                @class = "form-select form-select-sm select2",
                                @aria_label = "Affiliate Account",
                                // start disabled until class is chosen (optional)
                                disabled = (string.IsNullOrWhiteSpace(Model?.Class) ? "disabled" : null)
                            })
                        @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger" })
                    </div>
                </div>



                <hr class="my-2" />

                <div class="row g-1">
                    <div class="col-md-2 mb-2">
                        @Html.LabelFor(m => m.Code, "Account Number", new { @class = "form-label fw-semibold mb-1" })
                        @Html.TextBoxFor(
                            m => m.Code,
                            new
                                 {
                                @class = "form-control form-control-sm",
                                placeholder = "Enter the account number (digits only, min 12)",
                                minlength = "12",
                                maxlength = "20",
                                pattern = "\\d+",
                                title = "Digits only. Minimum length 12."
                            })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-5 mb-2">
                        @Html.LabelFor(m => m.NameEn, "Account Name (English)", new { @class = "form-label fw-semibold mb-1" })
                        @Html.TextBoxFor(m => m.NameEn, new { @class = "form-control form-control-sm", placeholder = "Account name in English", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-5 mb-2">
                        @Html.LabelFor(m => m.NameFr, "Account Name (French)", new { @class = "form-label fw-semibold mb-1" })
                        @Html.TextBoxFor(m => m.NameFr, new { @class = "form-control form-control-sm", placeholder = "Nom du compte en français", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger" })
                    </div>

                </div>


                @* PostingAllowed removed *@

                <div class="row mb-2">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.Notes, "Notes / Description", new { @class = "form-label mb-1" })
                        @Html.TextBoxFor(m => m.Notes, new { @class = "form-control form-control-sm", placeholder = "Optional notes (max 100 chars)", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="text-end">
                    @if (string.IsNullOrWhiteSpace(Model?.UpdateReference))
                    {
                        <button type="submit" class="btn btn-primary btn-sm me-2" data-bs-dismiss="modal"><i class="fas fa-save me-1"></i> Save</button>
                        <button type="reset" class="btn btn-outline-secondary btn-sm">Reset</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary btn-sm me-2" data-bs-dismiss="modal"><i class="mdi mdi-refresh"></i> Update</button>
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
                    }
                </div>
            </div>
        }
    </div>
</div>
