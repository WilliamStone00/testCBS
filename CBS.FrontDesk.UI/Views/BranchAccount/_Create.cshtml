@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountRequest
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank-outline me-2"></i> Branch Account Node Setup
                </h1>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Use this form to create branch-specific ledger accounts. Ensure the Code is unique within the branch and the Affiliate (Chart of Account) is selected correctly.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-help-circle-outline me-2"></i> Tips for Branch Account</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBranchAccountTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseBranchAccountTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-pound-box text-success me-2"></i><strong>Code:</strong> Use a short, meaningful code (e.g. <code>BR001</code>).</li>
                <li><i class="mdi mdi-form-textbox text-info me-2"></i><strong>Name (EN/FR):</strong> Provide both English and Français.</li>
                <li><i class="mdi mdi-shape-outline text-warning me-2"></i><strong>Class:</strong> Pick the accounting class (e.g., Asset, Liability).</li>
                <li><i class="mdi mdi-toggle-switch text-primary me-2"></i><strong>Posting Allowed:</strong> Check if this account should accept postings.</li>
                <li><i class="mdi mdi-office-building-marker text-secondary me-2"></i><strong>Affiliate Account:</strong> Link to the correct chart-of-account (affiliate).</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "BranchAccount", FormMethod.Post,
                  new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.BranchId)
            @Html.HiddenFor(m => m.Scope)
            @Html.HiddenFor(m => m.ParentId)
            @Html.HiddenFor(m => m.Language)
            @Html.HiddenFor(m => m.Class)
            @Html.HiddenFor(m => m.AffiliateAccountId)
            @Html.HiddenFor(m => m.IsOrigin)
            @Html.HiddenFor(m => m.RequiresMapping)
            @Html.HiddenFor(m => m.AffiliateId)

            <div class="mt-2">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ParentAccountNumber, "Parent Account ", new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.ParentAccountNumber" />
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Scope, new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.Scope" />
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Code, new { @class = "form-label fw-semibold" })

                        @* Keep the real model-bound Code hidden; we'll compose it from prefix + editable *@
                        @Html.HiddenFor(m => m.Code, new { id = "Code" })

                        <div class="input-group">
                            <span class="input-group-text" id="codePrefix" title="Fixed part derived from parent account"></span>
                            <input id="codeEditable"
                                   type="text"
                                   class="form-control"
                                   placeholder="Type allowed digits here"
                                   inputmode="numeric"
                                   aria-describedby="codePrefix codeHelp" />
                        </div>
                        <small id="codeHelp" class="text-muted d-block mt-1"></small>

                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.Label("Class", new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.Class" />
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.NameEn, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.NameEn, new { @class = "form-control", placeholder = "Name (English)", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.NameFr, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.NameFr, new { @class = "form-control", placeholder = "Name (Français)", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger" })
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.AffiliateAccountId,"Affiliate Account", new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.AffiliateAccountId,
                            new SelectList(ViewBag.AffiliateAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select Affiliate Account (Chart of Account) ---",
                            new { @class = "form-select select2", @aria_label = "Affiliate Account", @disabled = "disabled" })
                        @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.BranchId,"Branch", new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- " + @GlobalUserManagement.SelectBranch + " ---",
                            new { @class = "form-select select2" , @aria_label = "Branch", @disabled = "disabled" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.PostingAllowed, new { @class = "form-check-input", id = "postingAllowed" })
                            @Html.LabelFor(m => m.PostingAllowed, "Posting allowed", new { @class = "form-check-label fw-bold ms-2" })
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Notes, new { @class = "form-control", placeholder = "Notes", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="text-end">
                    @if (string.IsNullOrWhiteSpace(Model?.Id))
                    {
                        <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> Save</button>
                        <button type="reset" class="btn btn-outline-secondary">Reset</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2"><i class="mdi mdi-refresh"></i> Update</button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    }
                </div>
            </div>
        }
    </div>
</div>



