@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
<script>
  (function ($) {
    'use strict';

    let table = null;

    //-------------------------- Negativity Management ----------------------------

// ─────────────────────────────────────────────────────────────────────────────
// Management Account Negativity - Loads modal via AJAX
// ─────────────────────────────────────────────────────────────────────────────

$(document).on('click', '#btnManageAccountNeg', function (e) {
    e.preventDefault();
    loadNegativityModal();
});

function loadNegativityModal() {
    const $container = $('#negativityModalContainer');

    // Show loading indicator
    $container.html(`
        <div class="modal fade" id="manageNegativityModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-body text-center py-5">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading negativity management...</p>
                    </div>
                </div>
            </div>
        </div>
    `);

    // Show the loading modal immediately
    const loadingModal = new bootstrap.Modal($('#manageNegativityModal')[0], { backdrop: 'static' });
    loadingModal.show();

    // Load the actual modal content
    $.ajax({
        url: '@Url.Action("GetNegativityModal", "BranchAccount")',
        type: 'GET',
        success: function(html) {
            // Replace container with loaded content
            $container.html(html);

            // Initialize the modal after it's loaded
            initializeNegativityModal();

            // Show the actual modal
            const modal = new bootstrap.Modal($('#manageNegativityModal')[0], { backdrop: 'static' });
            modal.show();
        },
        error: function(xhr) {
            console.error('Error loading negativity modal:', xhr);
            $container.html(`
                <div class="modal fade" id="manageNegativityModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger">
                                    <i class="mdi mdi-alert-circle me-1"></i> Error
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-danger">
                                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                                    Failed to load negativity management modal. Please try again.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            `);

            // Show error modal
            const errorModal = new bootstrap.Modal($('#manageNegativityModal')[0]);
            errorModal.show();
        }
    });
}

function initializeNegativityModal() {
    const $modal = $('#manageNegativityModal');

    // Initialize Select2 in modal
    try {
        $modal.find('.select2').each(function () {
            const $s = $(this);
            if (!$s.data('select2')) {
                $s.select2({ dropdownParent: $modal });
            }
        });
    } catch (e) {
        console.warn('Select2 init failed in negativity modal', e);
    }

    // Reset form
    $('#NegBranchId').val(null).trigger('change');
    $('#NegClassId').val(null).trigger('change');
    $('#NegBranchAccountId').val(null).trigger('change').prop('disabled', true);
    $('#AllowNegativeBalance').prop('checked', true);
    $('#negModeClass').prop('checked', true);
    $('#classSection').show();
    $('#specificAccountSection').hide();
    $('#negativitySummary').hide();

    // Attach event handlers
    attachNegativityModalEvents();
}

function attachNegativityModalEvents() {
    // Handle mode switching
    $('#manageNegativityModal').on('change', 'input[name="negativityMode"]', function() {
        const mode = $(this).val();

        if (mode === 'class') {
            $('#classSection').show();
            $('#specificAccountSection').hide();
            $('#NegClassId').prop('disabled', false);
            $('#NegBranchAccountId').prop('disabled', true);
        } else {
            $('#classSection').hide();
            $('#specificAccountSection').show();
            $('#NegClassId').prop('disabled', true);

            // Enable branch account dropdown if branch is selected
            const branchId = $('#NegBranchId').val();
            if (branchId) {
                $('#NegBranchAccountId').prop('disabled', false);
                loadBranchAccountsForNegativity(branchId);
            }
        }

        updateNegativitySummary();
    });

    // Handle branch change
    $('#manageNegativityModal').on('change', '#NegBranchId', function() {
        const branchId = $(this).val();

        // Clear dependent fields
        $('#NegClassId').val(null).trigger('change');
        $('#NegBranchAccountId').val(null).trigger('change');

        if (branchId) {
            // If in specific account mode, load branch accounts
            if ($('#negModeSpecific').is(':checked')) {
                $('#NegBranchAccountId').prop('disabled', false);
                loadBranchAccountsForNegativity(branchId);
            }
        } else {
            $('#NegBranchAccountId').prop('disabled', true);
        }

        updateNegativitySummary();
    });

    // Handle class change
    $('#manageNegativityModal').on('change', '#NegClassId', function() {
        updateNegativitySummary();
    });

    // Handle branch account change
    $('#manageNegativityModal').on('change', '#NegBranchAccountId', function() {
        updateNegativitySummary();
    });

    // Handle negativity checkbox change
    $('#manageNegativityModal').on('change', '#AllowNegativeBalance', function() {
        updateNegativitySummary();
    });

    // Apply negativity settings
    $('#manageNegativityModal').on('click', '#btnApplyNegativity', function() {
        const branchId = $('#NegBranchId').val();
        const mode = $('input[name="negativityMode"]:checked').val();
        const allowNegative = $('#AllowNegativeBalance').is(':checked');

        if (!branchId) {
            appalert('Please select a branch first.', 3, 1);
            return;
        }

        // Prepare data based on mode
        const requestData = {
            BranchId: branchId,
            AllowNegative: allowNegative,
            ApplyToClass: (mode === 'class'),
            ApplyToSpecificAccount: (mode === 'specific')
        };

        if (mode === 'class') {
            const classId = $('#NegClassId').val();
            if (!classId) {
                appalert('Please select an account class.', 3, 1);
                return;
            }
            requestData.ClassId = classId;
            requestData.BranchAccountId = null;
        } else {
            const accountId = $('#NegBranchAccountId').val();
            if (!accountId) {
                appalert('Please select a branch account.', 3, 1);
                return;
            }
            requestData.BranchAccountId = accountId;
            requestData.ClassId = null;
        }

        // Show confirmation
        const action = allowNegative ? 'allow' : 'disallow';
        const target = mode === 'class' ?
            `all accounts of class "${$('#NegClassId option:selected').text()}"` :
            `account "${$('#NegBranchAccountId option:selected').text()}"`;

        alertify.confirm(
            "Confirm Account Negativity Update",
            `Are you sure you want to ${action} negative balance for ${target}?`,
            function() {
                // Submit the request
                applyNegativitySettings(requestData);
            },
            function() {
                appalert('Operation cancelled.', 3, 1);
            }
        );
    });
}

// Load branch accounts for negativity management
function loadBranchAccountsForNegativity(branchId) {
    const $dropdown = $('#NegBranchAccountId');
    if (!branchId) {
        $dropdown.html('<option value="">--- Select Branch first ---</option>');
        return;
    }

    $dropdown.html('<option value="">Loading accounts...</option>').prop('disabled', true);

    $.ajax({
        url: '@Url.Action("GetBranchAccountsByBranch", "BranchAccount")',
        type: 'GET',
        data: { branchId: branchId },
        success: function(response) {
            $dropdown.empty().prop('disabled', false);

            if (!response || response.length === 0) {
                $dropdown.append('<option value="">No accounts found</option>');
                return;
            }

            $dropdown.append('<option value="">--- Select Branch Account ---</option>');

            // Handle different response formats
            let items = [];
            if (Array.isArray(response)) {
                items = response;
            } else if (response.data && Array.isArray(response.data)) {
                items = response.data;
            }

            items.forEach(function(account) {
                const id = account.Id || account.Value || account.id || '';
                const text = account.Name || account.Text || account.name || '';
                const code = account.Code || account.code || '';
                const displayText = code ? `${code} - ${text}` : text;

                if (id && displayText) {
                    $dropdown.append(new Option(displayText, id));
                }
            });

            // Reinitialize Select2
            try {
                $dropdown.trigger('change.select2');
            } catch (e) {
                console.warn('Select2 refresh failed', e);
            }
        },
        error: function(xhr) {
            console.error('Error loading branch accounts:', xhr);
            $dropdown.html('<option value="">Error loading accounts</option>').prop('disabled', false);
        }
    });
}

// Update summary text
function updateNegativitySummary() {
    const $summary = $('#negativitySummary');
    const $summaryText = $('#summaryText');

    const branchId = $('#NegBranchId').val();
    const mode = $('input[name="negativityMode"]:checked').val();
    const allowNegative = $('#AllowNegativeBalance').is(':checked');
    const branchText = $('#NegBranchId option:selected').text();

    if (!branchId) {
        $summary.hide();
        return;
    }

    let summary = `<strong>Branch:</strong> ${branchText}<br>`;
    summary += `<strong>Mode:</strong> ${mode === 'class' ? 'By Account Class' : 'By Specific Account'}<br>`;

    if (mode === 'class') {
        const classId = $('#NegClassId').val();
        const classText = $('#NegClassId option:selected').text();

        if (classId) {
            summary += `<strong>Class:</strong> ${classText}<br>`;
            summary += `<strong>Action:</strong> ${allowNegative ? 'Allow' : 'Disallow'} negative balance for all accounts of this class`;
        } else {
            summary += `<strong>Class:</strong> Not selected yet`;
        }
    } else {
        const accountId = $('#NegBranchAccountId').val();
        const accountText = $('#NegBranchAccountId option:selected').text();

        if (accountId) {
            summary += `<strong>Account:</strong> ${accountText}<br>`;
            summary += `<strong>Action:</strong> ${allowNegative ? 'Allow' : 'Disallow'} negative balance for this specific account`;
        } else {
            summary += `<strong>Account:</strong> Not selected yet`;
        }
    }

    $summaryText.html(summary);
    $summary.show();
}

// Submit negativity settings to server
// Submit negativity settings to server - Modal stays open version
function applyNegativitySettings(data) {
    const $btn = $('#btnApplyNegativity');
    const $modal = $('#manageNegativityModal');
    const originalText = $btn.html();

    $btn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i> Processing...');

    $.ajax({
        url: '@Url.Action("UpdateAccountNegativity", "BranchAccount")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(response) {
            // Reset button state
            $btn.prop('disabled', false).html(originalText);

            if (response && response.success) {
                // Show success message WITH option to close
                const successHtml = `
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="mdi mdi-check-circle-outline me-2" style="font-size: 1.25rem;"></i>
                            <div class="flex-grow-1">
                                <strong class="me-2">Success!</strong>
                                ${response.message || 'Account negativity settings updated successfully!'}
                            </div>
                            <button type="button" class="btn btn-success btn-sm" onclick="closeNegativityModal()">
                                <i class="mdi mdi-check me-1"></i> Close
                            </button>
                        </div>
                    </div>
                `;

                // Remove any existing alerts and add new success message
                $modal.find('.alert').remove();
                $modal.find('.modal-body').prepend(successHtml);

                // Optional: Reset form or keep values
                // $('#NegBranchId').val(null).trigger('change');
                // updateNegativitySummary();

                // Reload table in background
                if (table) {
                    table.ajax.reload(null, false);
                }
            } else {
                // Show error message
                const errorHtml = `
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                        <strong>Error!</strong> ${response?.message || 'Failed to update negativity settings.'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                $modal.find('.alert').remove();
                $modal.find('.modal-body').prepend(errorHtml);
            }
        },
        error: function(xhr) {
            console.error('Error updating negativity:', xhr);

            // Reset button state
            $btn.prop('disabled', false).html(originalText);

            // Show error
            const errorHtml = `
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>Server Error!</strong> An error occurred. Please try again.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            $modal.find('.alert').remove();
            $modal.find('.modal-body').prepend(errorHtml);
        }
    });
}

// Helper function to close the modal
function closeNegativityModal() {
    const modal = bootstrap.Modal.getInstance($('#manageNegativityModal')[0]);
    if (modal) {
        modal.hide();
        // Optional: Reset form when closing
        setTimeout(() => {
            $('#NegBranchId').val(null).trigger('change');
            $('#NegClassId').val(null).trigger('change');
            $('#AllowNegativeBalance').prop('checked', true);
            $('#manageNegativityModal .alert').remove();
        }, 300);
    }
}

//--------------------------------- End of negativity management -------------------------

    // ─────────────────────────────────────────────────────────────────────────────
    // Delegated change: fire when Class changes INSIDE the edit modal (AJAX-loaded)
    // ─────────────────────────────────────────────────────────────────────────────
    $(document).on('change', '#branchEditModal #Class', function () {
      const $scope = $('#branchEditModal');
      onClassChanged(this.value, $scope);
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Root creation: load _CreateRoot with no ParentId (root node)
    // ─────────────────────────────────────────────────────────────────────────────
    const branchRootPartialName = '_CreateRoot';

    $(document).on('click', '#btnAddRootBranch', function (e) {
      e.preventDefault();
      openBranchRootForm();
    });

    function openBranchRootForm() {
      const data = {
        KEY: '',
        path: 'new',
        partialView: branchRootPartialName,
        serviceOption: 'root'
      };

      $('#branchEditModal .modal-body').html(
        '<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>'
      );

      $.get('@Url.Action("InitializeData", "BranchAccount")', data)
        .done(function (html) {
          const $modal = $('#branchEditModal');
          $modal.find('.modal-body').html(html);

          // Force ParentId to null/empty (ensure ROOT)
          try {
            $modal.find('input[name$="ParentId"], select[name$="ParentId"], #ParentId')
                  .val('').trigger('change');
          } catch (_) { /* no-op */ }

          // Modal-safe Select2 init (idempotent)
          try {
            $modal.find('.select2').each(function () {
              const $s = $(this);
              if (!$s.data('select2')) $s.select2({ dropdownParent: $modal });
            });
          } catch (e) { console.warn('select2 init failed', e); }

          // If Class already has a value (server populated), preload affiliates within this scope
          const clsVal = $modal.find('#Class').val();
          if (clsVal) onClassChanged(clsVal, $modal);

          (bootstrap.Modal.getInstance($modal[0]) ||
            new bootstrap.Modal($modal[0], { backdrop: 'static' })
          ).show();
        })
        .fail(function (xhr) {
          $('#branchEditModal .modal-body').html(
            '<div class="alert alert-danger">Unable to load form. ' + (xhr.responseText || '') + '</div>'
          );
        });
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Collect branch filters
    // ─────────────────────────────────────────────────────────────────────────────
    function collectBranchFilters() {
      return {
        BranchId:           $('#BranchId').val() || null,
        AffiliateAccountId: $('#AffiliateAccountId').val() || null,
        Code:               $.trim($('#AccountNumber').val()) || null,
        Name:               $.trim($('#AccountName').val()) || null,
        PostingAllowed:     $('#PostingAllowed').val() || null,
        IncludeDeleted:     $('#IncludeDeleted').is(':checked'),
        CreatedFromUtc:     $('#CreatedFromUtc').val() || null,
        CreatedToUtc:       $('#CreatedToUtc').val() || null
      };
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Init DataTable
    // ─────────────────────────────────────────────────────────────────────────────
    function initTableIfNeeded() {
      if (table && $.fn.DataTable.isDataTable('#myDataTable')) return;

      table = $('#myDataTable').DataTable({
        serverSide: true,
        responsive: true,
        destroy: true,
        ajax: {
          url: '@Url.Action("LoadBranchData", "BranchAccount")',
          type: 'POST',
          contentType: 'application/json; charset=utf-8',
          data: function (d) {
            const filters = collectBranchFilters();
            filters.options = {
              draw: d.draw,
              start: d.start,
              length: d.length,
              skip: d.start,
              pageSize: d.length,
              searchValue: d.search?.value || '',
              sortColumnName: '',
              sortColumnDirection: ''
            };
            return JSON.stringify(filters);
          }
        },
        columns: [
          {
            data: 'CreatedDate',
            name: 'CreatedDate',
            render: function (val) {
              return val ? (window.moment ? moment(val).format('DD/MM/YYYY HH:mm:ss') : val) : '-';
            }
          },
          { data: 'BranchName', name: 'Branch Name' },
          { data: 'Code', name: 'Code' },
          { data: 'Name', name: 'Name' },
          { data: 'Class', name: 'Class' },
          { data: 'AffiliateAccountName', name: 'AffiliateAccountName' },
          {
            data: null,
            orderable: false,
            searchable: false,
            render: function (row) {
              const id   = encodeURIComponent(String(row.Id || ''));
              const name = String(row.Name || '').replace(/"/g, '&quot;');
              const btnId = 'act_' + (row.Id || 'x');
              return `
                <div class="dropdown text-center">
                  <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="mdi mdi-cog-outline"></i> Actions
                  </button>
                  <ul class="dropdown-menu" aria-labelledby="${btnId}">
                    <li>
                      <button type="button" class="dropdown-item btn-details" data-id="${id}" data-name="${name}">
                        <i class="mdi mdi-eye me-1 text-primary"></i> Details
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item btn-edit" data-id="${id}" data-name="${name}">
                        <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item btn-add-branch" data-parent-id="${id}">
                        <i class="mdi mdi-bank-plus me-1 text-success"></i> Add Branch Account Node
                      </button>
                    </li>
                  </ul>
                </div>`;
            }
          }
        ],
        order: [[0, 'desc']],
        lengthMenu: [10, 25, 50, 100],
        pageLength: 10,
        language: { emptyTable: 'No records found' }
      });
    }

    function reloadTable() {
      initTableIfNeeded();
      table.ajax.reload(null, false);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Filter buttons (⚠ fixed form id to #affiliateFilterForm)
    // ─────────────────────────────────────────────────────────────────────────────
    $('#applyBranchFilterBtn').on('click', function (e) {
      e.preventDefault();
      reloadTable();
    });

    $('#resetBranchFilterBtn').on('click', function (e) {
      e.preventDefault();
      const $f = $('#affiliateFilterForm'); // ✅ fixed
      if ($f.length && $f[0]) $f[0].reset();
      if ($.fn.select2) $('#BranchId,#AffiliateAccountId').val(null).trigger('change');
      if (table) table.ajax.reload(null, false);
    });

    // Enter to apply filters (⚠ fixed form id)
    $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
      if (e.which === 13) { e.preventDefault(); reloadTable(); }
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Optional Select2 on the page-level filters
    // ─────────────────────────────────────────────────────────────────────────────
    if ($.fn.select2) {
      try {
        $('#BranchId').select2({ width: '100%', placeholder: '@GlobalUserManagement.SelectBranch' });
        $('#AffiliateAccountId').select2({ width: '100%', placeholder: 'Chart Of Account' });
      } catch (e) { console.warn('select2 init failed', e); }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Details (view-only modal)
    // ─────────────────────────────────────────────────────────────────────────────
    $(document).on('click', '.btn-details', function (e) {
      e.preventDefault();
      const id = decodeURIComponent($(this).data('id') || '');
      if (!id) return;

      $.get('/BranchAccount/InitializeData2', { KEY: id, partialView: '_DetailsPartial', path: 'get' })
          .done(html => {
              const $modal = $('#branchDetailsModal');
              $modal.find('.modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
              new bootstrap.Modal($modal[0]).show();
              $modal.find('.modal-body').html(html || '<div class="text-center text-muted">No details.</div>')
          })
        .fail(() => $modal.find('.modal-body').html('<div class="text-danger p-3">Failed to load details.</div>'));
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Edit / Add (loads _Create) – modal-safe select2 + preload
    // ─────────────────────────────────────────────────────────────────────────────
    const branchFormUrl = '@Url.Action("InitializeData", "BranchAccount")';
    const branchPartialName = '_Create';

    // Toolbar action (not shown in your markup, kept for completeness)
    $(document).on('click', '#actionsAddBranch', function (e) {
      e.preventDefault();
      const parentId = $('#AffiliateAccountId').val() || '';
      openBranchForm({ key: parentId, path: 'new' });
    });

    // Per-row add/edit
    $(document).on('click', '.btn-add-branch, .btn-edit', function (e) {
      e.preventDefault();
      const $btn = $(this);
      if ($btn.hasClass('btn-add-branch')) {
        const parentId = $btn.data('parent-id') ? decodeURIComponent(String($btn.data('parent-id'))) : '';
        openBranchForm({ key: parentId, path: 'new' });
      } else {
        const id = $btn.data('id') ? decodeURIComponent(String($btn.data('id'))) : '';
        openBranchForm({ key: id, path: 'edit' });
      }
    });

    function openBranchForm({ key, path }) {
      const data = {
        KEY: key || '',
        path: path || 'new',
        partialView: branchPartialName,
        serviceOption: ''
      };


      $.get(branchFormUrl, data)
          .done(function (html) {

            const $modal = $('#branchEditModal');
            $modal.find('.modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');

          $modal.find('.modal-body').html(html);

          // Modal-safe Select2 init (idempotent)
          try {
            $modal.find('.select2').each(function () {
              const $s = $(this);
              if (!$s.data('select2')) $s.select2({ dropdownParent: $modal });
            });
          } catch (_) {}

          // If Class already set (edit), preload affiliate list in SCOPE
          const clsVal = $modal.find('#Class').val();
          if (clsVal) onClassChanged(clsVal, $modal);

          (bootstrap.Modal.getInstance($modal[0]) ||
            new bootstrap.Modal($modal[0], { backdrop: 'static' })
          ).show();
        })
        .fail(function (xhr) {
          $modal.find('.modal-body').html(
            '<div class="alert alert-danger">Unable to load form. ' + (xhr.responseText || '') + '</div>'
          );
        });
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Utilities: normalize items + build options
    // ─────────────────────────────────────────────────────────────────────────────
    function normalizeItems(res) {
      if (!res) return [];
      if (typeof res === "string") { try { return JSON.parse(res); } catch { return []; } }
      if (Array.isArray(res)) return res;
      if (res.items && Array.isArray(res.items)) return res.items;
      if (res.data  && Array.isArray(res.data))  return res.data;
      if (typeof res === "object") return Object.keys(res).map(k => res[k]);
      return [];
    }

    function buildOptionsHtml(items, placeholder) {
      let src = `<option value="">${placeholder}</option>`;
      const arr = normalizeItems(items);

      arr.forEach(function (x) {
        const id = x.Value ?? x.Id ?? "";
        const name = x.Text ?? "";
        if (id) src += `<option value="${String(id)}">${String(name)}</option>`;
      });

      return src;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Scope-aware onClassChanged (works for page or modal)
    // cls: selected value; $scope: jQuery scope (modal) or omitted for document
    // ─────────────────────────────────────────────────────────────────────────────
    window.onClassChanged = function (cls, $scope) {
      const $root = ($scope && $scope.length) ? $scope : $(document);
      const $aff  = $root.find('#AffiliateAccountId');
      const $cls  = $root.find('#Class');

      const url = $cls.data('url') || '@Url.Action("ListByClass", "AffiliateAccount")';

      if (!cls) {
        const html = buildOptionsHtml([], '--- Select Affiliate Account (Chart of Account) ---');
        $aff.html(html).prop('disabled', true).trigger('change');
        return;
      }

      $aff.prop('disabled', true)
          .html('<option value="">Loading…</option>')
          .trigger('change');

      $.ajax({
        url: url,
        type: 'GET',
        dataType: 'json',
        data: { cls: cls },
        success: function (res) {
          const html = buildOptionsHtml(res, '--- Select Affiliate Account (Chart of Account) ---');
          $aff.html(html).prop('disabled', false).trigger('change');
        },
        error: function (xhr) {
          console.error('ListByClass error:', xhr?.responseText || xhr);
          $aff.html('<option value="">Failed to load. Choose class again.</option>')
              .prop('disabled', true)
              .trigger('change');
        }
      });
    };

    // ─────────────────────────────────────────────────────────────────────────────
    // Optional: preload on full page (non-modal) edit pages
    // ─────────────────────────────────────────────────────────────────────────────
    $(function () {
      const $cls = $('#Class');
      if ($cls.length) {
        const val = $cls.val();
        if (val) onClassChanged(val); // document scope
      }
    });

  })(jQuery);
</script>
