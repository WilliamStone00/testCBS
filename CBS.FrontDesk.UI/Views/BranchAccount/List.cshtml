@* ----------------------- BranchAccount Index (filters + scripts) ----------------------- *@
@model CBS.FrontDesk.Data.Entity.Accounting_V2.BranchAccount.BranchAccountQuery
@using Resources
@{
    ViewBag.Title = "Branch Account Filters";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>@ViewBag.Title
                </h1>
                <p class="card-text">Use the filters below to search and manage Branch Accounts.</p>
                <hr />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i>@AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>Filters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="row g-2">

            <!-- Branch -->
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- " + @GlobalUserManagement.SelectBranch + " ---",
                        new { @class = "form-select select2", id = "BranchId" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label for="BranchId">@GlobalUserManagement.Branch</label>
                </div>
            </div>

            <!-- Chart Of Account (Ho PCMF / AffiliateAccountId) -->
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(
                        m => m.AffiliateAccountId,
                        new SelectList(ViewBag.AffiliateAccounts ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- Chart Of Account ---",
                        new { @class = "form-select select2", id = "AffiliateAccountId" })
                    @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger" })
                    <label for="AffiliateAccountId">Chart Of Account (Ho PCMF)</label>
                </div>
            </div>

            <!-- Code (Account Number) -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "Account Number", id = "AccountNumber" })
                    <label for="AccountNumber">Account Number</label>
                </div>
            </div>

            <!-- Name (Account Name) -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Account Name", id = "AccountName" })
                    <label for="AccountName">Account Name</label>
                </div>
            </div>

            <!-- Posting Allowed -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownList("PostingAllowed",
                        new List<SelectListItem> {
                            new SelectListItem { Text = "Any", Value = "" },
                            new SelectListItem { Text = "Yes", Value = "true" },
                            new SelectListItem { Text = "No",  Value = "false" }
                        },
                        new { @class = "form-select", id = "PostingAllowed" })
                    <label for="PostingAllowed">Posting Allowed</label>
                </div>
            </div>

            <!-- Include Deleted -->
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mt-2">
                    @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                    <label class="form-check-label ms-2" for="IncludeDeleted">@AccountingV2.IncludeDeleted</label>
                </div>
            </div>

            <!-- Created From / To (UTC) -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.CreatedFromUtc, new { @class = "form-control", type = "date", placeholder = "Created From (UTC)", id = "CreatedFromUtc" })
                    <label for="CreatedFromUtc">@AccountingV2.CreatedFrom (UTC)</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.CreatedToUtc, new { @class = "form-control", type = "date", placeholder = "Created To (UTC)", id = "CreatedToUtc" })
                    <label for="CreatedToUtc">@AccountingV2.CreatedTo (UTC)</label>
                </div>
            </div>

        </div>

        <div class="row mt-3">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

<!-- DETAILS modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX --></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT modal -->
<div class="modal fade" id="affiliateEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX --></div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
(function ($) {
      'use strict';

      let table = null;

      function collectFilters() {
        // Only pick the current, visible filter fields
        return {
          BranchId:        $('#BranchId').val() || null,
          AffiliateAccountId: $('#AffiliateAccountId').val() || null,
          Code:            $.trim($('#AccountNumber').val()) || null,
          Name:            $.trim($('#AccountName').val()) || null,
          PostingAllowed:  $('#PostingAllowed').val() || null,
          IncludeDeleted:  $('#IncludeDeleted').is(':checked'),
          CreatedFromUtc:  $('#CreatedFromUtc').val() || null,
          CreatedToUtc:    $('#CreatedToUtc').val() || null
        };
      }

      function initTableIfNeeded() {
        if (table && $.fn.DataTable.isDataTable('#myDataTable')) return;

        table = $('#myDataTable').DataTable({
          serverSide: true,
          responsive: true,
          destroy: true,
          ajax: {
            url: '@Url.Action("LoadBranchData", "BranchAccount")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: function (d) {
                const filters = collectFilters();
                filters.options = {
                    draw: d.draw,
                    start: d.start,
                    length: d.length,
                    skip: d.start,
                    pageSize: d.length,
                    searchValue: d.search?.value || '',
                    sortColumnName: '',
                    sortColumnDirection: ''
                };
                return JSON.stringify(filters);
            }
          },
          columns: [
            {
              data: 'CreatedDate',
              render: function (val) {
                return val ? (window.moment ? moment(val).format('DD/MM/YYYY HH:mm:ss') : val) : '-';
              },
              name: 'CreatedDate'
            },
            { data: 'Code', name: 'Code' },
            { data: 'Name', name: 'Name' },
            { data: 'Class', name: 'Class' },
              { data: 'AffiliateAccountName', name: 'Chart Of Account' },
            {
              data: 'Id',
              orderable: false,
              searchable: false,
              render: function (data, type, row) {
                const id = encodeURIComponent(String(row.Id || data || ''));
                const name = String(row.Name || '').replace(/"/g, '&quot;');
                const btnId = 'act_' + (row.Id || data || 'x');
                return `
                  <div class="dropdown text-center">
                    <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                      <i class="mdi mdi-cog-outline"></i> Actions
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="${btnId}">
                      <li>
                        <button type="button" class="dropdown-item btn-details" data-id="${id}" data-name="${name}">
                          <i class="mdi mdi-eye me-1 text-primary"></i> Details
                        </button>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <button type="button" class="dropdown-item btn-edit" data-id="${id}" data-name="${name}">
                          <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                        </button>
                      </li>
                     
                    </ul>
                  </div>`;
              }
            }
          ],
          order: [[0, 'desc']],
          lengthMenu: [10, 25, 50, 100],
          pageLength: 10,
          language: { emptyTable: 'No records found' }
        });
      }

      function reloadTable() {
        initTableIfNeeded();
        table.ajax.reload(null, false);
      }

      // Buttons
      $('#applyAffiliateFilterBtn').on('click', function (e) {
        e.preventDefault();
        reloadTable();
      });

      $('#resetAffiliateFilterBtn').on('click', function (e) {
        e.preventDefault();
        const $f = $('#affiliateFilterForm');
        $f[0].reset();
        if ($.fn.select2) $('#BranchId,#AffiliateAccountId').val(null).trigger('change');
        if (table) table.ajax.reload(null, false);
      });

      // Enter key applies filters
      $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
        if (e.which === 13) {
          e.preventDefault();
          reloadTable();
        }
      });

      // Select2 (optional)
      if ($.fn.select2) {
        try {
          $('#BranchId').select2({ width: '100%', placeholder: '@GlobalUserManagement.SelectBranch' });
          $('#AffiliateAccountId').select2({ width: '100%', placeholder: 'Chart Of Account' });
        } catch (e) { console.warn('select2 init failed', e); }
      }

      // Details
      $(document).on('click', '.btn-details', function (e) {
        e.preventDefault();
        const id = decodeURIComponent($(this).data('id') || '');
        if (!id) return;
        const $modal = $('#affiliateDetailsModal');
        $('#affiliateDetailsModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
        new bootstrap.Modal($modal[0]).show();
        $.get('/BranchAccount/InitializeData2', { KEY: id, partialView: '_DetailsPartial', path: 'get' })
          .done(html => $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details.</div>'))
          .fail(() => $('#affiliateDetailsModal .modal-body').html('<div class="text-danger p-3">Failed to load details.</div>'));
      });

      // Edit / Add
      const branchFormUrl = '@Url.Action("InitializeData", "BranchAccount")';
      const branchPartialName = '_Create';
      $(document).on('click', '.btn-edit, .btn-add-branch', function (e) {
        e.preventDefault();
        const $btn = $(this);
        const id = $btn.data('id') ? decodeURIComponent(String($btn.data('id'))) : '';
        const parentId = $btn.data('parent-id') ? decodeURIComponent(String($btn.data('parent-id'))) : '';

        const data = { partialView: branchPartialName, serviceOption: '' };
        if ($btn.hasClass('btn-add-branch')) {
          data.KEY = parentId || id || '';
          data.path = 'new';
        } else {
          data.KEY = id || parentId || '';
          data.path = 'edit';
        }

        $('#affiliateEditModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
        $.get(branchFormUrl, data)
          .done(function (html) {
            $('#affiliateEditModal .modal-body').html(html);
            try {
              $('#affiliateEditModal .select2').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) $(this).select2({ dropdownParent: $('#affiliateEditModal') });
              });
            } catch (_) {}
            (bootstrap.Modal.getInstance($('#affiliateEditModal')[0]) || new bootstrap.Modal($('#affiliateEditModal')[0], { backdrop: 'static' })).show();
          })
          .fail(function (xhr) {
            $('#affiliateEditModal .modal-body').html('<div class="alert alert-danger">Unable to load form. ' + (xhr.responseText || '') + '</div>');
          });
      });

})(jQuery);
    </script>
}
