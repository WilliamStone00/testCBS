@* ----------------------- BranchAccount Index (compact, no PostingAllowed) ----------------------- *@
@model CBS.FrontDesk.Data.Entity.Accounting_V2.BranchAccount.BranchAccountQuery
@using Resources
@{
    ViewBag.Title = "Branch Account Filters";
}

<style>
    .compact .card {
        margin-bottom: .5rem !important;
    }

    .compact .card-body {
        padding: .75rem !important;
    }

    .compact .card-header {
        padding: .5rem .75rem !important;
    }

    .compact .form-label {
        margin-bottom: .2rem !important;
    }

    .compact .form-check {
        margin-bottom: 0 !important;
    }

    .compact .row.g-1 > [class^="col-"] {
        margin-bottom: .5rem;
    }

    /* Negativity Modal Styles */
    #manageNegativityModal .modal-header {
        background-color: #fff3cd;
        border-bottom: 1px solid #ffeaa7;
    }

    #manageNegativityModal .modal-title {
        color: #856404;
    }

    #manageNegativityModal .form-check-input:checked {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    #manageNegativityModal .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
    }

    #negativitySummary {
        background-color: #e7f3ff;
        border-color: #b6d4fe;
        color: #0c5460;
    }

        #negativitySummary i {
            color: #0d6efd;
        }
</style>

<div class="compact">

    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center py-2">
                    <h5 class="card-title text-primary mb-1">
                        <i class="mdi mdi-account-group me-2"></i>@ViewBag.Title
                    </h5>
                    <p class="card-text small mb-0">@BranchAccountRessources.Use_the_filters_below_to_search_and_manage_Branch_Accounts.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span class="small"><i class="mdi mdi-information-outline me-2"></i>@GlobalShared.Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseTips" class="collapse">
            <div class="card-body py-2">
                <ul class="mb-0 small">
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>@GlobalShared.Code:</strong> @BranchAccountRessources.Use_full_or_partial_affiliate_code_for_quick_lookup</li>
                    <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>@GlobalShared.Name:</strong> @BranchAccountRessources.Matches_against_affiliate_name</li>
                    <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>@GlobalShared.Status:</strong> @BranchAccountRessources.Choose_All_Active_Inactive_All_will_not_filter_by_active_state</li>
                    <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>@GlobalShared.Created_Dates:</strong> @BranchAccountRessources.Toggle_date_filters_to_limit_by_creation_range_UTC</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-2 mb-2">
        <h6 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i>@GlobalShared.Filters</h6>

        <form id="affiliateFilterForm" autocomplete="off">
            <div class="row g-1">

                <!-- Branch -->
                <div class="col-md-6">
                    @Html.LabelFor(m => m.BranchId, GlobalUserManagement.Branch, new { @class = "form-label small" })
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- " + @GlobalUserManagement.SelectBranch + " ---",
                        new { @class = "form-select form-select-sm select2", id = "BranchId" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
                </div>

                <!-- Chart Of Account (MFI / AffiliateAccountId) -->
                <div class="col-md-6">
                    @Html.LabelFor(m => m.AffiliateAccountId, "Chart Of Account (MFI)", new { @class = "form-label small" })
                    @Html.DropDownListFor(
                        m => m.AffiliateAccountId,
                        new SelectList(ViewBag.AffiliateAccounts, "Value", "Text"),
                        "--- Chart Of Account ---",
                        new { @class = "form-select form-select-sm select2", id = "AffiliateAccountId" })
                    @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger small" })
                </div>

                <!-- Code (Account Number) -->
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Code, "Account Number", new { @class = "form-label small" })
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-sm", placeholder = "Account Number", id = "AccountNumber" })
                </div>

                <!-- Name (Account Name) -->
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Name, "Account Name", new { @class = "form-label small" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-sm", placeholder = "Account Name", id = "AccountName" })
                </div>

                <!-- Created From / To (UTC) -->
                <div class="col-md-6">
                    @Html.LabelFor(m => m.CreatedFromUtc, GlobalShared.Created_From + " (UTC)", new { @class = "form-label small" })
                    @Html.TextBoxFor(m => m.CreatedFromUtc, new { @class = "form-control form-control-sm", type = "date", placeholder = "Created From (UTC)", id = "CreatedFromUtc" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.CreatedToUtc, GlobalShared.Created_To + " (UTC)", new { @class = "form-label small" })
                    @Html.TextBoxFor(m => m.CreatedToUtc, new { @class = "form-control form-control-sm", type = "date", placeholder = "Created To (UTC)", id = "CreatedToUtc" })
                </div>

                <!-- Include Deleted -->
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                        <label class="form-check-label ms-2 small" for="IncludeDeleted">@GlobalShared.Include_Deleted</label>
                    </div>
                </div>

            </div>

            <div class="row mt-2">
                <div class="col-md-12 d-flex gap-2">
                    <button id="applyBranchFilterBtn" type="button" class="btn btn-primary btn-sm flex-fill">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                    </button>
                    <button id="resetBranchFilterBtn" type="button" class="btn btn-secondary btn-sm flex-fill">
                        <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="row">
        <!-- Global actions -->
        <div class="d-flex justify-content-end gap-2 mb-2">
            <button id="btnManageAccountNeg" type="button" class="btn btn-warning btn-sm">
                <i class="mdi mdi-bank-plus me-1"></i> @BranchAccountRessources.Management_Account_Negativity
            </button>

            <button id="btnAddRootBranch" type="button" class="btn btn-success btn-sm">
                <i class="mdi mdi-bank-plus me-1"></i> @BranchAccountRessources.Add_Management_Account
            </button>
        </div>
    </div>

</div>


<div id="datalistingview">
    @Html.Partial("_Data")
</div>

<!-- DETAILS modal -->
<div class="modal fade" id="branchDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX --></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT/CREATE modal -->
<div class="modal fade" id="branchEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX --></div>
        </div>
    </div>
</div>

<!-- Placeholder for negativity modal (will be loaded via AJAX) -->
<div id="negativityModalContainer"></div>



@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
<script>
  (function ($) {
    'use strict';

    let table = null;

    //-------------------------- Negativity Management ----------------------------

// ─────────────────────────────────────────────────────────────────────────────
// Management Account Negativity - Loads modal via AJAX
// ─────────────────────────────────────────────────────────────────────────────

 $(document).on('click', '#btnManageAccountNeg', function (e) {
    e.preventDefault();
    loadNegativityModal();
});

 function loadNegativityModal() {
    const $container = $('#negativityModalContainer');

    // Clean up any existing modal
    cleanupExistingModal();

    // Show loading placeholder (NOT a modal)
    $container.html();

    // Load modal content
    $.ajax({
        url: '@Url.Action("GetNegativityModal", "BranchAccount")',
        type: 'GET',
        success: function (html) {

            // Replace container with actual modal HTML
            $container.html(html);

            // Initialize modal logic (events, validation, etc.)
            initializeNegativityModal();

            // Show modal ONLY after everything is ready
            const modalElement = document.getElementById('manageNegativityModal');
            const modalInstance = new bootstrap.Modal(modalElement, {
                backdrop: 'static',
                keyboard: false
            });

            modalInstance.show();
        },
        error: function (xhr) {
            console.error('Error loading negativity modal:', xhr);

            $container.html(`
                <div class="modal fade" id="manageNegativityModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger">
                                    <i class="mdi mdi-alert-circle me-1"></i> Error
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-danger">
                                    Failed to load negativity management modal.
                                    Please try again.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `);

            // Show error modal
            const errorModal = new bootstrap.Modal(
                document.getElementById('manageNegativityModal')
            );
            errorModal.show();
        }
    });
}


    // Clean up any existing modal instances
    function cleanupExistingModal() {
    // Remove any existing modal backdrop
    $('.modal-backdrop').remove();

    // Clean up body classes
    $('body').removeClass('modal-open').css('padding-right', '');

    // Clean up Select2 instances
    $('.select2').each(function() {
        if ($(this).data('select2')) {
            $(this).select2('destroy');
        }
    });

    // Dispose of any existing modal instances
    const existingModalEl = document.getElementById('manageNegativityModal');
    if (existingModalEl) {
        const existingModal = bootstrap.Modal.getInstance(existingModalEl);
        if (existingModal) {
            existingModal.hide();
            existingModal.dispose();
        }
    }

    // Clear the loading modal reference
    if (window.loadingNegativityModal) {
        try {
            window.loadingNegativityModal.hide();
            window.loadingNegativityModal.dispose();
        } catch (e) {
            console.warn('Error disposing loading modal:', e);
        }
        window.loadingNegativityModal = null;
    }
}

    function initializeNegativityModal() {
    const $modal = $('#manageNegativityModal');

    // Initialize Select2 in modal
    try {
        $modal.find('.select2').each(function () {
            const $s = $(this);
            if (!$s.data('select2')) {
                $s.select2({ dropdownParent: $modal });
            }
        });
    } catch (e) {
        console.warn('Select2 init failed in negativity modal', e);
    }

    // Reset form
    $('#NegBranchId').val(null).trigger('change');
    $('#NegClassId').val(null).trigger('change');
    $('#NegBranchAccountId').val(null).trigger('change').prop('disabled', true);
    $('#AllowNegativeBalance').prop('checked', true);
    $('#negModeClass').prop('checked', true);
    $('#classSection').show();
    $('#specificAccountSection').hide();
    $('#negativitySummary').hide();

    // Attach event handlers
    attachNegativityModalEvents();
}

    function attachNegativityModalEvents() {
    const $modal = $('#manageNegativityModal');

    // Clear any existing alerts when modal is shown
    $modal.on('show.bs.modal', function() {
        $(this).find('.alert').remove();
    });

    // Clean up when modal is hidden
    $modal.on('hidden.bs.modal', function() {
        // Clean up Select2 instances
        $(this).find('.select2').each(function() {
            if ($(this).data('select2')) {
                $(this).select2('destroy');
            }
        });

        // Clean up the container
        setTimeout(() => {
            $('#negativityModalContainer').empty();
            cleanupExistingModal();
        }, 300);
    });

    // Clear alerts when user starts new selection
    $modal.on('change', '#NegBranchId, #NegClassId, #NegBranchAccountId, input[name="negativityMode"], #AllowNegativeBalance', function() {
        $modal.find('.alert').remove();
    });

    // Handle mode switching
    $modal.on('change', 'input[name="negativityMode"]', function() {
        const mode = $(this).val();

        if (mode === 'class') {
            $('#classSection').show();
            $('#specificAccountSection').hide();
            $('#NegClassId').prop('disabled', false);
            $('#NegBranchAccountId').prop('disabled', true);
        } else {
            $('#classSection').hide();
            $('#specificAccountSection').show();
            $('#NegClassId').prop('disabled', true);

            // Enable branch account dropdown if branch is selected
            const branchId = $('#NegBranchId').val();
            if (branchId) {
                $('#NegBranchAccountId').prop('disabled', false);
                loadBranchAccountsForNegativity(branchId);
            }
        }

        updateNegativitySummary();
    });

    // Handle branch change
    $modal.on('change', '#NegBranchId', function() {
        const branchId = $(this).val();

        // Clear dependent fields
        $('#NegClassId').val(null).trigger('change');
        $('#NegBranchAccountId').val(null).trigger('change');

        if (branchId) {
            // If in specific account mode, load branch accounts
            if ($('#negModeSpecific').is(':checked')) {
                $('#NegBranchAccountId').prop('disabled', false);
                loadBranchAccountsForNegativity(branchId);
            }
        } else {
            $('#NegBranchAccountId').prop('disabled', true);
        }

        updateNegativitySummary();
    });

    // Handle class change
    $modal.on('change', '#NegClassId', function() {
        updateNegativitySummary();
    });

    // Handle branch account change
    $modal.on('change', '#NegBranchAccountId', function() {
        updateNegativitySummary();
    });

    // Handle negativity checkbox change
    $modal.on('change', '#AllowNegativeBalance', function() {
        updateNegativitySummary();
    });

    // Apply negativity settings
    $modal.on('click', '#btnApplyNegativity', function() {
        // Clear any existing alerts
        $modal.find('.alert').remove();

        const branchId = $('#NegBranchId').val();
        const mode = $('input[name="negativityMode"]:checked').val();
        const allowNegative = $('#AllowNegativeBalance').is(':checked');

        if (!branchId) {
            // Show error in modal
            const errorHtml = `
                <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                    <i class="mdi mdi-alert-outline me-2"></i>
                    <strong>Warning!</strong> Please select a branch first.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $modal.find('.modal-body').prepend(errorHtml);
            return;
        }

        // Prepare data based on mode
        const requestData = {
            BranchId: branchId,
            AllowNegative: allowNegative,
            ApplyToClass: (mode === 'class'),
            ApplyToSpecificAccount: (mode === 'specific')
        };

        if (mode === 'class') {
            const classId = $('#NegClassId').val();
            if (!classId) {
                const errorHtml = `
                    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        <strong>Warning!</strong> Please select an account class.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                $modal.find('.modal-body').prepend(errorHtml);
                return;
            }
            requestData.ClassId = classId;
            requestData.BranchAccountId = null;
        } else {
            const accountId = $('#NegBranchAccountId').val();
            if (!accountId) {
                const errorHtml = `
                    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                        <i class="mdi mdi-alert-outline me-2"></i>
                        <strong>Warning!</strong> Please select a branch account.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                $modal.find('.modal-body').prepend(errorHtml);
                return;
            }
            requestData.BranchAccountId = accountId;
            requestData.ClassId = null;
        }

        // Show confirmation using Bootstrap modal
        const action = allowNegative ? 'allow' : 'disallow';
        const target = mode === 'class' ?
            `all accounts of class "${$('#NegClassId option:selected').text()}"` :
            `account "${$('#NegBranchAccountId option:selected').text()}"`;

        showBootstrapConfirmation(action, target, requestData);
    });
}

       // Load branch accounts for negativity management
       function loadBranchAccountsForNegativity(branchId) {
    const $dropdown = $('#NegBranchAccountId');
    if (!branchId) {
        $dropdown.html('<option value="">--- Select Branch first ---</option>');
        return;
    }

    $dropdown.html('<option value="">Loading accounts...</option>').prop('disabled', true);

    $.ajax({
        url: '@Url.Action("GetBranchAccountsByBranch", "BranchAccount")',
        type: 'GET',
        data: { branchId: branchId },
        success: function(response) {
            $dropdown.empty().prop('disabled', false);

            if (!response || response.length === 0) {
                $dropdown.append('<option value="">No accounts found</option>');
                return;
            }

            $dropdown.append('<option value="">--- Select Branch Account ---</option>');

            // Handle different response formats
            let items = [];
            if (Array.isArray(response)) {
                items = response;
            } else if (response.data && Array.isArray(response.data)) {
                items = response.data;
            }

            items.forEach(function(account) {
                const id = account.Id || account.Value || account.id || '';
                const text = account.Name || account.Text || account.name || '';
                const code = account.Code || account.code || '';
                const displayText = code ? `${code} - ${text}` : text;

                if (id && displayText) {
                    $dropdown.append(new Option(displayText, id));
                }
            });

            // Reinitialize Select2
            try {
                $dropdown.trigger('change.select2');
            } catch (e) {
                console.warn('Select2 refresh failed', e);
            }
        },
        error: function(xhr) {
            console.error('Error loading branch accounts:', xhr);
            $dropdown.html('<option value="">Error loading accounts</option>').prop('disabled', false);
        }
    });
}

        // Update summary text
    function updateNegativitySummary() {
    const $summary = $('#negativitySummary');
    const $summaryText = $('#summaryText');

    const branchId = $('#NegBranchId').val();
    const mode = $('input[name="negativityMode"]:checked').val();
    const allowNegative = $('#AllowNegativeBalance').is(':checked');
    const branchText = $('#NegBranchId option:selected').text();

    if (!branchId) {
        $summary.hide();
        return;
    }

    let summary = `<strong>Branch:</strong> ${branchText}<br>`;
    summary += `<strong>Mode:</strong> ${mode === 'class' ? 'By Account Class' : 'By Specific Account'}<br>`;

    if (mode === 'class') {
        const classId = $('#NegClassId').val();
        const classText = $('#NegClassId option:selected').text();

        if (classId) {
            summary += `<strong>Class:</strong> ${classText}<br>`;
            summary += `<strong>Action:</strong> ${allowNegative ? 'Allow' : 'Disallow'} negative balance for all accounts of this class`;
        } else {
            summary += `<strong>Class:</strong> Not selected yet`;
        }
    } else {
        const accountId = $('#NegBranchAccountId').val();
        const accountText = $('#NegBranchAccountId option:selected').text();

        if (accountId) {
            summary += `<strong>Account:</strong> ${accountText}<br>`;
            summary += `<strong>Action:</strong> ${allowNegative ? 'Allow' : 'Disallow'} negative balance for this specific account`;
        } else {
            summary += `<strong>Account:</strong> Not selected yet`;
        }
    }

    $summaryText.html(summary);
    $summary.show();
}

    // Bootstrap confirmation modal function
    function showBootstrapConfirmation(action, target, requestData) {
    // First clean up any existing confirmation modal
    cleanupConfirmationModal();

    // Create confirmation modal HTML
    const confirmationHtml = `
        <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-warning">
                            <i class="mdi mdi-alert-circle-outline me-1"></i> Confirm Update
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to <strong>${action}</strong> negative balance for:</p>
                        <div class="alert alert-info mb-0">
                            <strong>${target}</strong>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="mdi mdi-close me-1"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-warning btn-sm" id="btnConfirmApply">
                            <i class="mdi mdi-check me-1"></i> Yes, Apply Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `;

    // Add to body and show
    $('body').append(confirmationHtml);
    const confirmationModal = new bootstrap.Modal($('#confirmationModal')[0]);
    confirmationModal.show();

    // Handle confirmation
    $('#confirmationModal').on('click', '#btnConfirmApply', function() {
        confirmationModal.hide();
        // Submit the request
        applyNegativitySettings(requestData);
    });

    // Clean up when modal is hidden
    $('#confirmationModal').on('hidden.bs.modal', function() {
        cleanupConfirmationModal();
    });
}

    // Clean up confirmation modal
    function cleanupConfirmationModal() {
    const confirmationModalEl = document.getElementById('confirmationModal');
    if (confirmationModalEl) {
        const confirmationModal = bootstrap.Modal.getInstance(confirmationModalEl);
        if (confirmationModal) {
            confirmationModal.hide();
            confirmationModal.dispose();
        }
        $(confirmationModalEl).remove();
    }
    // Clean up backdrop
    $('.modal-backdrop').not('.show').remove();
}

    // Submit negativity settings to server - Modal stays open version
    function applyNegativitySettings(data) {
        const $btn = $('#btnApplyNegativity');
        const $modal = $('#manageNegativityModal');
        const originalText = $btn.html();

        $btn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i> Processing...');

        $.ajax({
            url: '@Url.Action("UpdateAccountNegativity", "BranchAccount")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                // Reset button state
                $btn.prop('disabled', false).html(originalText);

                if (response && response.success) {
                    // Show success message
                    const successHtml = `
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" id="successAlert">
                            <div class="d-flex align-items-center">
                                <i class="mdi mdi-check-circle-outline me-2" style="font-size: 1.25rem;"></i>
                                <div class="flex-grow-1">
                                    <strong class="me-2">Success!</strong>
                                    ${response.message || 'Account negativity settings updated successfully!'}
                                </div>
                                <button type="button" class="btn btn-success btn-sm" id="btnCloseAfterSuccess">
                                    <i class="mdi mdi-check me-1"></i> Done
                                </button>
                            </div>
                        </div>
                    `;

                    // Remove any existing alerts and add new success message
                    $modal.find('.alert').remove();
                    $modal.find('.modal-body').prepend(successHtml);

                    // Add click handler for the "Done" button
                    $modal.off('click', '#btnCloseAfterSuccess').on('click', '#btnCloseAfterSuccess', function() {
                        closeNegativityModal();
                    });

                    // Reload table in background
                    if (table) {
                        table.ajax.reload(null, false);
                    }
                } else {
                    // Show error message
                    const errorHtml = `
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            <strong>Error!</strong> ${response?.message || 'Failed to update negativity settings.'}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;

                    $modal.find('.alert').remove();
                    $modal.find('.modal-body').prepend(errorHtml);
                }
            },
            error: function(xhr) {
                console.error('Error updating negativity:', xhr);

                // Reset button state
                $btn.prop('disabled', false).html(originalText);

                // Show error
                const errorHtml = `
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                        <strong>Server Error!</strong> An error occurred. Please try again.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                $modal.find('.alert').remove();
                $modal.find('.modal-body').prepend(errorHtml);
            }
        });
    }

       // Helper function to close the modal
       function closeNegativityModal() {
    const modalEl = document.getElementById('manageNegativityModal');
    if (!modalEl) return;

    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) {
        modal.hide();
    }

    // Clean up after modal is hidden
    setTimeout(() => {
        cleanupExistingModal();
        $('#negativityModalContainer').empty();
    }, 300);
}

    // Global function for onclick attribute (if needed)
    window.closeNegativityModalGlobal = closeNegativityModal;

//--------------------------------- End of negativity management -------------------------


    // ─────────────────────────────────────────────────────────────────────────────
    // Delegated change: fire when Class changes INSIDE the edit modal (AJAX-loaded)
    // ─────────────────────────────────────────────────────────────────────────────
    $(document).on('change', '#branchEditModal #Class', function () {
      const $scope = $('#branchEditModal');
      onClassChanged(this.value, $scope);
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Root creation: load _CreateRoot with no ParentId (root node)
    // ─────────────────────────────────────────────────────────────────────────────
    const branchRootPartialName = '_CreateRoot';

    $(document).on('click', '#btnAddRootBranch', function (e) {
      e.preventDefault();
      openBranchRootForm();
    });

    function openBranchRootForm() {
      const data = {
        KEY: '',
        path: 'new',
        partialView: branchRootPartialName,
        serviceOption: 'root'
      };

      $('#branchEditModal .modal-body').html(
        '<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>'
      );

      $.get('@Url.Action("InitializeData", "BranchAccount")', data)
        .done(function (html) {
          const $modal = $('#branchEditModal');
          $modal.find('.modal-body').html(html);

          // Force ParentId to null/empty (ensure ROOT)
          try {
            $modal.find('input[name$="ParentId"], select[name$="ParentId"], #ParentId')
                  .val('').trigger('change');
          } catch (_) { /* no-op */ }

          // Modal-safe Select2 init (idempotent)
          try {
            $modal.find('.select2').each(function () {
              const $s = $(this);
              if (!$s.data('select2')) $s.select2({ dropdownParent: $modal });
            });
          } catch (e) { console.warn('select2 init failed', e); }

          // If Class already has a value (server populated), preload affiliates within this scope
          const clsVal = $modal.find('#Class').val();
          if (clsVal) onClassChanged(clsVal, $modal);

          (bootstrap.Modal.getInstance($modal[0]) ||
            new bootstrap.Modal($modal[0], { backdrop: 'static' })
          ).show();
        })
        .fail(function (xhr) {
          $('#branchEditModal .modal-body').html(
            '<div class="alert alert-danger">Unable to load form. ' + (xhr.responseText || '') + '</div>'
          );
        });
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Collect branch filters
    // ─────────────────────────────────────────────────────────────────────────────
    function collectBranchFilters() {
      return {
        BranchId:           $('#BranchId').val() || null,
        AffiliateAccountId: $('#AffiliateAccountId').val() || null,
        Code:               $.trim($('#AccountNumber').val()) || null,
        Name:               $.trim($('#AccountName').val()) || null,
        PostingAllowed:     $('#PostingAllowed').val() || null,
        IncludeDeleted:     $('#IncludeDeleted').is(':checked'),
        CreatedFromUtc:     $('#CreatedFromUtc').val() || null,
        CreatedToUtc:       $('#CreatedToUtc').val() || null
      };
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Init DataTable
    // ─────────────────────────────────────────────────────────────────────────────
    function initTableIfNeeded() {
      if (table && $.fn.DataTable.isDataTable('#myDataTable')) return;

      table = $('#myDataTable').DataTable({
        serverSide: true,
        responsive: true,
        destroy: true,
        ajax: {
          url: '@Url.Action("LoadBranchData", "BranchAccount")',
          type: 'POST',
          contentType: 'application/json; charset=utf-8',
          data: function (d) {
            const filters = collectBranchFilters();
            filters.options = {
              draw: d.draw,
              start: d.start,
              length: d.length,
              skip: d.start,
              pageSize: d.length,
              searchValue: d.search?.value || '',
              sortColumnName: '',
              sortColumnDirection: ''
            };
            return JSON.stringify(filters);
          }
        },
        columns: [
          {
            data: 'CreatedDate',
            name: 'CreatedDate',
            render: function (val) {
              return val ? (window.moment ? moment(val).format('DD/MM/YYYY HH:mm:ss') : val) : '-';
            }
            },
            {
                data: 'PostCode',
                name: 'PostCode',
                render: function (data, type, row) {
                    return data ? data : '-';
                }
            },
         /* { data: 'BranchName', name: 'Branch Name' },*/
          { data: 'Code', name: 'Code' },
          { data: 'Name', name: 'Name' },
          { data: 'Class', name: 'Class' },
          /*{ data: 'AffiliateAccountName', name: 'AffiliateAccountName' },*/
            {
                data: 'Nature',
                name: 'Nature',
                render: function (data, type, row) {
                    return data ? data : '-';
                }
            },
            
          {
            data: null,
            orderable: false,
            searchable: false,
            render: function (row) {
              const id   = encodeURIComponent(String(row.Id || ''));
              const name = String(row.Name || '').replace(/"/g, '&quot;');
              const btnId = 'act_' + (row.Id || 'x');
              return `
                <div class="dropdown text-center">
                  <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="mdi mdi-cog-outline"></i> Actions
                  </button>
                  <ul class="dropdown-menu" aria-labelledby="${btnId}">
                    <li>
                      <button type="button" class="dropdown-item btn-details" data-id="${id}" data-name="${name}">
                        <i class="mdi mdi-eye me-1 text-primary"></i> Details
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item btn-edit" data-id="${id}" data-name="${name}">
                        <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item btn-add-branch" data-parent-id="${id}">
                        <i class="mdi mdi-bank-plus me-1 text-success"></i> Add Branch Account Node
                      </button>
                    </li>
                  </ul>
                </div>`;
            }
          }
        ],
        order: [[0, 'desc']],
        lengthMenu: [10, 25, 50, 100],
        pageLength: 10,
        language: { emptyTable: 'No records found' }
      });
    }

    function reloadTable() {
      initTableIfNeeded();
      table.ajax.reload(null, false);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Filter buttons (⚠ fixed form id to #affiliateFilterForm)
    // ─────────────────────────────────────────────────────────────────────────────
    $('#applyBranchFilterBtn').on('click', function (e) {
      e.preventDefault();
      reloadTable();
    });

    $('#resetBranchFilterBtn').on('click', function (e) {
      e.preventDefault();
      const $f = $('#affiliateFilterForm'); // ✅ fixed
      if ($f.length && $f[0]) $f[0].reset();
      if ($.fn.select2) $('#BranchId,#AffiliateAccountId').val(null).trigger('change');
      if (table) table.ajax.reload(null, false);
    });

    // Enter to apply filters (⚠ fixed form id)
    $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
      if (e.which === 13) { e.preventDefault(); reloadTable(); }
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Optional Select2 on the page-level filters
    // ─────────────────────────────────────────────────────────────────────────────
    if ($.fn.select2) {
      try {
        $('#BranchId').select2({ width: '100%', placeholder: '@GlobalUserManagement.SelectBranch' });
        $('#AffiliateAccountId').select2({ width: '100%', placeholder: 'Chart Of Account' });
      } catch (e) { console.warn('select2 init failed', e); }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Details (view-only modal)
    // ─────────────────────────────────────────────────────────────────────────────
    $(document).on('click', '.btn-details', function (e) {
      e.preventDefault();
      const id = decodeURIComponent($(this).data('id') || '');
      if (!id) return;

      $.get('/BranchAccount/InitializeData2', { KEY: id, partialView: '_DetailsPartial', path: 'get' })
          .done(html => {
              const $modal = $('#branchDetailsModal');
              $modal.find('.modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
              new bootstrap.Modal($modal[0]).show();
              $modal.find('.modal-body').html(html || '<div class="text-center text-muted">No details.</div>')
          })
        .fail(() => $modal.find('.modal-body').html('<div class="text-danger p-3">Failed to load details.</div>'));
    });

    // ─────────────────────────────────────────────────────────────────────────────
    // Edit / Add (loads _Create) – modal-safe select2 + preload
    // ─────────────────────────────────────────────────────────────────────────────
    const branchFormUrl = '@Url.Action("InitializeData", "BranchAccount")';
    const branchPartialName = '_Create';

    // Toolbar action (not shown in your markup, kept for completeness)
    $(document).on('click', '#actionsAddBranch', function (e) {
      e.preventDefault();
      const parentId = $('#AffiliateAccountId').val() || '';
      openBranchForm({ key: parentId, path: 'new' });
    });

    // Per-row add/edit
    $(document).on('click', '.btn-add-branch, .btn-edit', function (e) {
      e.preventDefault();
      const $btn = $(this);
      if ($btn.hasClass('btn-add-branch')) {
        const parentId = $btn.data('parent-id') ? decodeURIComponent(String($btn.data('parent-id'))) : '';
        openBranchForm({ key: parentId, path: 'new' });
      } else {
        const id = $btn.data('id') ? decodeURIComponent(String($btn.data('id'))) : '';
        openBranchForm({ key: id, path: 'edit' });
      }
    });

    function openBranchForm({ key, path }) {
      const data = {
        KEY: key || '',
        path: path || 'new',
        partialView: branchPartialName,
        serviceOption: ''
      };


      $.get(branchFormUrl, data)
          .done(function (html) {

            const $modal = $('#branchEditModal');
            $modal.find('.modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');

          $modal.find('.modal-body').html(html);

          // Modal-safe Select2 init (idempotent)
          try {
            $modal.find('.select2').each(function () {
              const $s = $(this);
              if (!$s.data('select2')) $s.select2({ dropdownParent: $modal });
            });
          } catch (_) {}

          // If Class already set (edit), preload affiliate list in SCOPE
          const clsVal = $modal.find('#Class').val();
          if (clsVal) onClassChanged(clsVal, $modal);

          (bootstrap.Modal.getInstance($modal[0]) ||
            new bootstrap.Modal($modal[0], { backdrop: 'static' })
          ).show();
        })
        .fail(function (xhr) {
          $modal.find('.modal-body').html(
            '<div class="alert alert-danger">Unable to load form. ' + (xhr.responseText || '') + '</div>'
          );
        });
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Utilities: normalize items + build options
    // ─────────────────────────────────────────────────────────────────────────────
    function normalizeItems(res) {
      if (!res) return [];
      if (typeof res === "string") { try { return JSON.parse(res); } catch { return []; } }
      if (Array.isArray(res)) return res;
      if (res.items && Array.isArray(res.items)) return res.items;
      if (res.data  && Array.isArray(res.data))  return res.data;
      if (typeof res === "object") return Object.keys(res).map(k => res[k]);
      return [];
    }

    function buildOptionsHtml(items, placeholder) {
      let src = `<option value="">${placeholder}</option>`;
      const arr = normalizeItems(items);

      arr.forEach(function (x) {
        const id = x.Value ?? x.Id ?? "";
        const name = x.Text ?? "";
        if (id) src += `<option value="${String(id)}">${String(name)}</option>`;
      });

      return src;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Scope-aware onClassChanged (works for page or modal)
    // cls: selected value; $scope: jQuery scope (modal) or omitted for document
    // ─────────────────────────────────────────────────────────────────────────────
    window.onClassChanged = function (cls, $scope) {
      const $root = ($scope && $scope.length) ? $scope : $(document);
      const $aff  = $root.find('#AffiliateAccountId');
      const $cls  = $root.find('#Class');

      const url = $cls.data('url') || '@Url.Action("ListByClass", "AffiliateAccount")';

      if (!cls) {
        const html = buildOptionsHtml([], '--- Select Affiliate Account (Chart of Account) ---');
        $aff.html(html).prop('disabled', true).trigger('change');
        return;
      }

      $aff.prop('disabled', true)
          .html('<option value="">Loading…</option>')
          .trigger('change');

      $.ajax({
        url: url,
        type: 'GET',
        dataType: 'json',
        data: { cls: cls },
        success: function (res) {
          const html = buildOptionsHtml(res, '--- Select Affiliate Account (Chart of Account) ---');
          $aff.html(html).prop('disabled', false).trigger('change');
        },
        error: function (xhr) {
          console.error('ListByClass error:', xhr?.responseText || xhr);
          $aff.html('<option value="">Failed to load. Choose class again.</option>')
              .prop('disabled', true)
              .trigger('change');
        }
      });
    };

    // ─────────────────────────────────────────────────────────────────────────────
    // Optional: preload on full page (non-modal) edit pages
    // ─────────────────────────────────────────────────────────────────────────────
    $(function () {
      const $cls = $('#Class');
      if ($cls.length) {
        const val = $cls.val();
        if (val) onClassChanged(val); // document scope
      }
    });

  })(jQuery);
</script>
}


