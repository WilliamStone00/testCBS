@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <div class="row g-2">
                <!-- Row 1: Branch, Code, Name -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Branch</label>
                    <select id="BranchId" name="BranchId" class="form-control select2">
                        <option value="">-- All branches --</option>
                        @* fill with ViewBag.Branches or similar *@
                        @* <option value="01589560">Central</option> *@
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">@AccountingV2.Code</label>
                    <input type="text" id="Code" name="Code" class="form-control" placeholder="Affiliate code" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">@AccountingV2.Name</label>
                    <input type="text" id="Name" name="Name" class="form-control" placeholder="Affiliate name" />
                </div>
            </div>

            <div class="row g-2 mt-3">
                <!-- Row 2: Class, AffiliateAccountId, ParentId -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Class</label>
                    <input type="text" id="Class" name="Class" class="form-control" placeholder="e.g. Asset, Liability" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Affiliate</label>
                    <select id="AffiliateAccountId" name="AffiliateAccountId" class="form-control select2">
                        <option value="">-- All affiliates --</option>
                        @* fill via ViewBag.Affiliates *@
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Parent Id</label>
                    <input type="text" id="ParentId" name="ParentId" class="form-control" placeholder="Parent affiliate id" />
                </div>
            </div>

            <div class="row g-2 mt-3">
                <!-- Row 3: PathContains, DepthFrom/To, PostingAllowed -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Path contains</label>
                    <input type="text" id="PathContains" name="PathContains" class="form-control" placeholder="/1/10/" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Depth from</label>
                    <input type="number" id="DepthFrom" name="DepthFrom" class="form-control" min="0" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Depth to</label>
                    <input type="number" id="DepthTo" name="DepthTo" class="form-control" min="0" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Posting allowed</label>
                    <select id="PostingAllowed" name="PostingAllowed" class="form-control">
                        <option value="">Any</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 mt-3">
                <!-- Row 4: Created dates + IncludeDeleted -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Created from (UTC)</label>
                    <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Created to (UTC)</label>
                    <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control" />
                </div>

                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check ms-2">
                        <input class="form-check-input" type="checkbox" id="IncludeDeleted" name="IncludeDeleted" />
                        <label class="form-check-label fw-bold ms-2" for="IncludeDeleted">Include deleted</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-6 d-grid">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
            </div>
            <div class="col-md-6 d-grid">
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-outline-secondary">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Place for DataTable or partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

