@model CBS.FrontDesk.Data.Entity.Accounting_V2.BranchAccount.BranchAccountQuery
@{
    ViewBag.Title = "Branch Account Filters";
}
@using Resources

<div class="row mb-3">
    <div class="col-12">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>Branch Account Filters
                </h1>
                <p class="card-text">Use the filters below to search and sort the listing.</p>
                <hr />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>Filters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="row g-2">

            <!-- Row: Branch + HoPcmfAccountId -->
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "Name"),
                        "---" + @GlobalUserManagement.SelectBranch + "---",
                        new { @class = "form-control select2", id = "BranchId" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label>@GlobalUserManagement.Branch</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.AffiliateAccountId, new SelectList(ViewBag.HoPcmfAccountId, "Id", "Name"), "---HoPcmfAccountId---",
                        new { @class = "form-select select2", id = "AffiliateAccountId" })
                    @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger" })
                    <label>HoPcmfAccountId</label>
                </div>
            </div>

            <!-- Row: 4 checkbox columns (first row of optional filters) -->
            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkCode" data-target="#Code" />
                    <label class="form-check-label" for="chkCode">@AccountingV2.Code</label>
                </div>
                <input type="text" id="Code" name="Code" class="form-control mt-1" placeholder="Affiliate code" style="display:none;" />
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkName" data-target="#Name" />
                    <label class="form-check-label" for="chkName">@AccountingV2.Name</label>
                </div>
                <input type="text" id="Name" name="Name" class="form-control mt-1" placeholder="Affiliate name" style="display:none;" />
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox"
                           class="filter-toggle form-check-input"
                           id="chkParentId"
                           data-target="#ParentId" />
                    <label class="form-check-label" for="chkParentId">Parent Id</label>
                </div>

                <!-- ParentId is a plain textbox, hidden by default and disabled when hidden -->
                <input type="text"
                       id="ParentId"
                       name="ParentId"
                       class="form-control mt-1"
                       placeholder="Parent affiliate id"
                       style="display:none;"
                       disabled
                       aria-hidden="true" />
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkPathContains" data-target="#PathContains" />
                    <label class="form-check-label" for="chkPathContains">Path contains</label>
                </div>
                <input type="text" id="PathContains" name="PathContains" class="form-control mt-1" placeholder="/1/10/" style="display:none;" />
            </div>

            <!-- Row: 4 checkbox columns (second row of optional filters) -->
            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkDepthFrom" data-target="#DepthFrom" />
                    <label class="form-check-label" for="chkDepthFrom">Depth from</label>
                </div>
                <input type="number" id="DepthFrom" name="DepthFrom" class="form-control mt-1" min="0" style="display:none;" />
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkDepthTo" data-target="#DepthTo" />
                    <label class="form-check-label" for="chkDepthTo">Depth to</label>
                </div>
                <input type="number" id="DepthTo" name="DepthTo" class="form-control mt-1" min="0" style="display:none;" />
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkPostingAllowed" data-target="#PostingAllowed" />
                    <label class="form-check-label" for="chkPostingAllowed">Posting allowed</label>
                </div>
                <select id="PostingAllowed" name="PostingAllowed" class="form-control mt-1" style="display:none;">
                    <option value="">Any</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkIncludeDeleted" data-target="#IncludeDeleted" />
                    <label class="form-check-label" for="chkIncludeDeleted">Include deleted</label>
                </div>
                <input type="checkbox" id="IncludeDeleted" name="IncludeDeleted" class="form-check-input mt-1" style="display:none;" />
            </div>

            <!-- Created dates spread under checkboxes to keep layout compact -->
            <div class="col-md-6">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkCreatedFromUtc" data-target="#CreatedFromUtc" />
                    <label class="form-check-label" for="chkCreatedFromUtc">Created from (UTC)</label>
                </div>
                <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control mt-1" style="display:none;" />
            </div>

            <div class="col-md-6">
                <div class="form-check">
                    <input type="checkbox" class="filter-toggle form-check-input" id="chkCreatedToUtc" data-target="#CreatedToUtc" />
                    <label class="form-check-label" for="chkCreatedToUtc">Created to (UTC)</label>
                </div>
                <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control mt-1" style="display:none;" />
            </div>

        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

<!-- DETAILS modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- content loaded by AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT modal -->
<div class="modal fade" id="affiliateEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- edit form loaded by AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // single table instance using id #myDataTable
            let myDataTableInstance = null;

            function escapeHtml(str) {
                if (str === undefined || str === null) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // delegated: toggles for optional filters
            $(document).on('change', '.filter-toggle', function () {
                const target = $(this).data('target');
                if (!target) return;
                if (this.checked) {
                    $(target).stop(true, true).slideDown(150).prop('disabled', false).attr('aria-hidden', 'false').focus();
                } else {
                    $(target).stop(true, true).slideUp(150, function () {
                        $(this).prop('disabled', true).attr('aria-hidden', 'true').val('');
                    });
                }
            });

            // initialize visibility on load and ensure hidden inputs are disabled
            $('.filter-toggle').each(function () {
                const target = $(this).data('target');
                if (!target) return;
                if (this.checked) {
                    $(target).show().prop('disabled', false).attr('aria-hidden', 'false');
                } else {
                    $(target).hide().prop('disabled', true).attr('aria-hidden', 'true');
                }
            });

            function collectAffiliateFilters() {
                const filters = {};
                $('#affiliateFilterForm .filter-toggle:checked').each(function () {
                    const target = $(this).data('target');
                    if (!target) return;
                    const $el = $(target);
                    const name = $el.attr('name') || $el.prop('id');
                    if (!name) return;
                    let val;
                    if ($el.is(':checkbox')) val = $el.is(':checked') ? true : false;
                    else val = $el.val();
                    if (val !== undefined && val !== '' && val !== null) filters[name] = val;
                });

                return filters;
            }

            function initMyDataTableIfNeeded() {
                if ($.fn.DataTable.isDataTable('#myDataTable') && myDataTableInstance) return;

                if (!$('#myDataTable').length) {
                    $('#affiliateListingView').html('<table id="myDataTable" class="table table-striped table-bordered w-100"></table>');
                }

                myDataTableInstance = $('#myDataTable').DataTable({
                    serverSide: true,
                    responsive: true,
                    destroy: true,
                    ajax: {
                        url: '@Url.Action("LoadBranchData", "BranchAccount")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: function (d) {
                            const filters = collectAffiliateFilters();
                            const payload = {
                                ...filters,
                                options: {
                                    draw: d.draw,
                                    start: d.start,
                                    length: d.length,
                                    searchValue: d.search?.value || '',
                                    sortColumnName: (d.columns && d.columns[d.order[0].column].data) || 'CreatedDate',
                                    sortColumnDirection: d.order[0].dir || 'desc'
                                }
                            };
                            return JSON.stringify(payload);
                        },
                        error: function (jqXHR) {
                            console.error('Data load failed', jqXHR);
                            if (typeof appalert === 'function') {
                                let msg = 'Failed to load data';
                                try { msg = jqXHR.responseJSON?.message || msg; } catch { }
                                appalert(msg, 0, 1);
                            }
                        }
                    },
                    columns: [
                        {
                            data: 'CreatedDate',
                            render: function (data) {
                                return data ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data) : '-';
                            }
                        },
                        { data: 'BranchId' },
                        { data: 'Code' },
                        { data: 'Name' },
                        { data: 'Class' },
                        { data: 'AffiliateAccountId' },
                        {
                            data: 'Id',
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row) {
                                var rawId = String(row.id || row.Id || data || '');
                                var recordId = encodeURIComponent(rawId);
                                var safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                                var btnId = 'actionDropdown_' + safeId;
                                var name = escapeHtml(row.name || row.Name || '');
                                var isDeleted = row.isDeleted === true || row.isDeleted === 'true' || row.isDeleted === 1;

                                var detailsBtn = `<button type="button" class="dropdown-item btn-details" data-id="${recordId}" data-name="${name}">
                                                 <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                               </button>`;

                                var editBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-edit" data-id="${recordId}" data-name="${name}">
                                  <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                                </button>` : '';

                                // ADD: button to create a Branch Account using current row as parent
                                // data-parent-id is the parent reference passed to the partial
                                var addBranchBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-add-branch" data-parent-id="${recordId}" data-name="${name}">
                                       <i class="mdi mdi-bank-plus me-1 text-info"></i> Add Branch Account
                                     </button>` : '';

                                return `
                                     <div class="dropdown text-center">
                                         <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                                 type="button" id="${btnId}"
                                                 data-bs-toggle="dropdown" aria-expanded="false">
                                             <i class="mdi mdi-cog-outline"></i> Actions
                                         </button>
                                         <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                             <li>${detailsBtn}</li>
                                             ${!isDeleted ? `<li><hr class="dropdown-divider"></li>` : ''}
                                             ${!isDeleted ? `<li>${editBtn}</li>` : ''}
                                             ${!isDeleted ? `<li>${addBranchBtn}</li>` : ''}
                                         </ul>
                                     </div>
                                 `.trim();
                            }

                        }
                    ],
                    order: [[0, 'desc']],
                    lengthMenu: [10, 25, 50, 100],
                    pageLength: 10
                });
            }

            function loadAffiliateData() {
                initMyDataTableIfNeeded();
                if (myDataTableInstance) myDataTableInstance.ajax.reload(null, false);
            }

            function resetAffiliateFilters() {
                $('#affiliateFilterForm')[0].reset();
                $('.filter-toggle').each(function () {
                    const t = $(this).data('target');
                    if (t) $(t).hide().val('').prop('disabled', true).attr('aria-hidden', 'true');
                });
                if (myDataTableInstance) {
                    myDataTableInstance.destroy();
                    myDataTableInstance = null;
                }
                $('#affiliateListingView').html('');
            }

            // Apply / Reset handlers
            $('#applyAffiliateFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                loadAffiliateData();
            });

            $('#resetAffiliateFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                resetAffiliateFilters();
            });

            // Enter key triggers load
            $('#affiliateFilterForm').off('keypress').on('keypress', 'input,select', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadAffiliateData();
                }
            });

            // init select2 safely if present (do NOT init select2 on #ParentId since it's a textbox)
            if ($.fn.select2) {
                try {
                    // initialize all elements that have the .select2 class
                    $('.select2').each(function () {
                        try { $(this).select2({ width: '100%' }); } catch (inner) { console.warn('select2 init failed for an element', inner); }
                    });
                } catch (err) {
                    console.warn('select2 init failed', err);
                    if (typeof appalert === 'function') appalert('select2 init failed: ' + (err && err.message ? err.message : err), 2, 1);
                }
            }

            // DETAILS button
            $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                if (!id) { if (typeof appalert === 'function') appalert('Missing id for details', 0, 1); return; }

                var modalEl = document.getElementById('affiliateDetailsModal');
                if (!modalEl) { if (typeof appalert === 'function') appalert('Details modal not found', 0, 1); return; }
                try { var bsModal = new bootstrap.Modal(modalEl); } catch (ex) { var bsModal = null; }

                $('#affiliateDetailsModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');
                if (bsModal) bsModal.show();

                $.get('/BranchAccount/InitializeData2', { KEY: id, partialView: '_DetailsPartial', path: 'get' })
                    .done(function (html) {
                        $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
                        try {
                            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                document.querySelectorAll('#affiliateDetailsModal [data-bs-toggle="tooltip"]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } catch (e) { /* ignore */ }
                    })
                    .fail(function () {
                        $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                        if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
                    });
            });

            //************************************************************************

           // controller endpoint that returns the partial
            var branchFormUrl = '@Url.Action("InitializeData", "BranchAccount")';

            // name of the partial view you want returned (change if your partial has a different name)
            var branchPartialName = '_Create';

            $(document).off('click', '.btn-edit, .btn-add-branch').on('click', '.btn-edit, .btn-add-branch', function (e) {
                e.preventDefault();
                var $btn = $(this);

                // For edit: data-id (encoded); for create: data-parent-id
                var encodedId = $btn.data('id');          // may be undefined for create
                var encodedParent = $btn.data('parent-id') || $btn.data('parentId') || $btn.data('parent'); // tolerate variations

                // decode if needed (we encoded with encodeURIComponent earlier)
                var id = encodedId ? decodeURIComponent(String(encodedId)) : '';
                var parentId = encodedParent ? decodeURIComponent(String(encodedParent)) : '';

                // Build params for InitializeData
                // - KEY : id or parentId depending on path
                // - partialView : name of the partial to render
                // - path : "new" for create, "edit" for update (controller uses "new" and else->GetById)
                // - serviceOption : optional (left empty here)
                var data = {
                    partialView: branchPartialName,
                    serviceOption: '' // provide value if needed
                };

                if ($btn.hasClass('btn-add-branch')) {
                    // Create new: use parentId as KEY and path=new
                    data.KEY = parentId || id || ''; // prefer explicit parentId, fallback to id
                    data.path = 'new';
                } else {
                    // Edit: use id as KEY and path=edit (controller treats anything other than "new" and "list" as get-by-id)
                    data.KEY = id || parentId || '';
                    data.path = 'edit';
                }

                // Optional: show a loading spinner in modal
                $('#affiliateEditModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

                // Request the partial view from server (jQuery will encode data into query string)
                $.get(branchFormUrl, data)
                    .done(function (html) {
                        $('#affiliateEditModal .modal-body').html(html);

                        // initialize any plugins inside the partial (select2, datepickers etc)
                        try {
                            $('#affiliateEditModal .select2').each(function () {
                                if ($(this).hasClass('select2-hidden-accessible')) return;
                                $(this).select2({ dropdownParent: $('#affiliateEditModal') });
                            });
                        } catch (ex) {
                            console.warn('Modal init error', ex);
                        }

                        // show bootstrap modal
                        var modalEl = document.getElementById('affiliateEditModal');
                        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl, { backdrop: 'static' });
                        modal.show();
                    })
                    .fail(function (xhr, status, err) {
                        var msg = 'Unable to load form. ' + (xhr.responseText || status || err);
                        $('#affiliateEditModal .modal-body').html('<div class="alert alert-danger">' + msg + '</div>');
                        console.error('Load partial failed', xhr, status, err);
                    });
            });

            function AjaxPost(form) {
                try {
                    var $form = $(form);
                    if (!$form || $form.length === 0) {
                        console.warn('AjaxPost called with invalid form');
                        return false;
                    }

                    // Prevent concurrent submissions
                    if (window._ajaxSubmitState.isSubmitting) {
                        console.warn('Submission blocked: another submit in progress.');
                        if (typeof appalert === 'function') appalert('A request is already in progress. Please wait...', 2, 1);
                        return false;
                    }

                    // set submitting flag + request id
                    window._ajaxSubmitState.isSubmitting = true;
                    var thisRequestId = ++window._ajaxSubmitState.lastRequestId;

                    // Parse and validate
                    safeParseUnobtrusive($form);
                    if (!safeValidate($form)) {
                        window._ajaxSubmitState.isSubmitting = false;
                        return false;
                    }

                    // small helper to normalize server validation payloads to a single HTML/text message
                    function buildValidationMessage(json) {
                        // prefer errorsHtml (server-rendered <ul> etc.)
                        if (json.errorsHtml) return json.errorsHtml;

                        // If server returned errors object { FieldName: ["err1","err2"], ... }
                        if (json.errors && typeof json.errors === 'object') {
                            var sb = '<ul style="margin:0;padding-left:18px;">';
                            Object.keys(json.errors).forEach(function (k) {
                                var arr = json.errors[k] || [];
                                arr.forEach(function (m) {
                                    var key = (k || '').split('.').pop();
                                    sb += '<li><strong>' + $('<div/>').text(key).html() + '</strong>: ' + $('<div/>').text(m).html() + '</li>';
                                });
                            });
                            sb += '</ul>';
                            return sb;
                        }

                        // fallback to message string
                        if (json.message) return $('<div/>').text(json.message).html();

                        return 'Validation failed. Please check the form.';
                    }

                    // confirmation
                    var confirmAction = function (onOk, onCancel) {
                        if (window.alertify && typeof alertify.confirm === 'function') {
                            alertify.confirm("Confirmation", "Are you sure you want to perform this action? ", onOk, onCancel);
                        } else {
                            var ok = confirm("Are you sure you want to perform this action?");
                            if (ok) onOk(); else onCancel();
                        }
                    };

                    confirmAction(function () {
                        var hasFiles = ($form.attr('enctype') || '').toLowerCase().indexOf('multipart') !== -1;
                        var dataToSend, processDataFlag = true, contentTypeFlag = 'application/x-www-form-urlencoded; charset=UTF-8';

                        if (hasFiles) {
                            dataToSend = new FormData(form);
                            processDataFlag = false;
                            contentTypeFlag = false;
                            var anti = $form.find('input[name="__RequestVerificationToken"]').val();
                            try {
                                if (anti && !dataToSend.has('__RequestVerificationToken')) dataToSend.append('__RequestVerificationToken', anti);
                            } catch (ex) {
                                if (anti) dataToSend.append('__RequestVerificationToken', anti);
                            }
                        } else {
                            dataToSend = $form.serialize();
                        }

                        var $submit = $form.find(':submit:first');
                        if ($submit.length === 0) $submit = $('#btnSubmit').length ? $('#btnSubmit') : ($('#btnSubmitUpload').length ? $('#btnSubmitUpload') : $form.find('button[type="submit"]'));
                        $submit.prop('disabled', true).addClass('disabled');

                        var ajaxCfg = {
                            url: $form.attr('action'),
                            type: ($form.attr('method') || 'POST').toUpperCase(),
                            data: dataToSend,
                            processData: processDataFlag,
                            contentType: contentTypeFlag,
                            dataType: 'json',
                            timeout: 30000 // 30s timeout
                        };

                        var jqxhr = $.ajax(ajaxCfg)
                            .done(function (res) {
                                // ignore stale responses
                                if (thisRequestId !== window._ajaxSubmitState.lastRequestId) {
                                    console.warn('Stale response ignored for requestId', thisRequestId);
                                    return;
                                }

                                // HTML fallback (partial)
                                if (typeof res === 'string' && res.trim().charAt(0) === '<') {
                                    var $modal = $form.closest('.modal');
                                    if ($modal.length) $modal.find('.modal-content').html(res);
                                    else if ($('#mainWorkspace').length) $('#mainWorkspace').html(res);
                                    else $form.replaceWith(res);
                                    safeParseUnobtrusive($('#mainWorkspace'));
                                    return;
                                }

                                var json = res || {};

                                // SUCCESS PATH
                                if (json.success) {
                                    if (json.status === "Exist") {
                                        if (typeof appalert === 'function') appalert(json.message, 3, 1); else alert(json.message);
                                    } else if (json.status === "Failed") {
                                        if (typeof appalert === 'function') appalert(json.message, 2, 1); else alert(json.message);
                                    } else {
                                        if (typeof appalert === 'function') appalert(json.message, 1, 1); else alert(json.message || 'Saved successfully');
                                    }

                                    if (json.html) {
                                        if ($('#mainWorkspace').length) $('#mainWorkspace').html(json.html);
                                        else if ($('#affiliateListingView').length) $('#affiliateListingView').html(json.html);
                                        safeParseUnobtrusive($('#mainWorkspace'));
                                    }

                                    // Only reload on explicit server instruction AND on success
                                    if (json.reloadDataView === "Yes") {
                                        try {
                                            if (typeof reloadListing === 'function') reloadListing();
                                            else if (typeof window.reloadAffiliateTable === 'function') window.reloadAffiliateTable();
                                            else if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
                                        } catch (e) { console.warn('reload failed', e); }
                                    }

                                    var $modal = $form.closest('.modal');
                                    if ($modal.length) {
                                        try { bootstrap.Modal.getInstance($modal[0]).hide(); } catch (e) { $modal.modal && $modal.modal('hide'); }
                                    }

                                    // FAILURE PATH
                                } else {
                                    var status = json.Status || json.status || '';

                                    // Detect validation failures explicitly (server should return validation: true) or presence of errorsHtml/errors object
                                    var isValidation = !!json.validation || !!json.errorsHtml || (json.errors && typeof json.errors === 'object');

                                    if (isValidation) {
                                        // build message (HTML)
                                        var msgHtml = buildValidationMessage(json);

                                        // show via appalert if available (try HTML, fallback to plain text)
                                        if (typeof appalert === 'function') {
                                            try {
                                                // if appalert expects text, it may still show HTML; wrap in try
                                                appalert(msgHtml, 2, 1);
                                            } catch (e) {
                                                var textOnly = $('<div/>').html(msgHtml).text();
                                                appalert(textOnly, 2, 1);
                                            }
                                        } else {
                                            alert($('<div/>').html(msgHtml).text());
                                        }

                                        // inject small validation summary inside the form (so the modal stays open)
                                        if ($form.find('.validation-aggregate').length === 0) {
                                            $form.prepend('<div class="validation-aggregate alert alert-danger mt-2"></div>');
                                        }
                                        $form.find('.validation-aggregate').html(msgHtml);
                                        safeParseUnobtrusive($form);

                                        // DO NOT replace form or close modal — let user fix inputs.

                                    } else {
                                        // Non-validation failure (business rule, exist, etc.)
                                        if (status === "Exist") {
                                            if (typeof appalert === 'function') appalert(json.message, 3, 1); else alert(json.message || 'Already exists.');
                                        } else {
                                            if (typeof appalert === 'function') appalert(json.message || 'Operation failed', 2, 1); else alert(json.message || 'Operation failed');
                                        }

                                        if (json.html) {
                                            if ($('#mainWorkspace').length) $('#mainWorkspace').html(json.html);
                                            else $form.replaceWith(json.html);
                                            safeParseUnobtrusive($('#mainWorkspace'));
                                        }
                                    }
                                }
                            })
                            .fail(function (xhr, status, err) {
                                // ignore stale responses
                                if (thisRequestId !== window._ajaxSubmitState.lastRequestId) {
                                    console.warn('Stale fail ignored for requestId', thisRequestId);
                                    return;
                                }

                                console.error('AjaxPost failed', status, err, xhr);
                                if (xhr && xhr.status === 401) {
                                    window.location.href = '/Authentication/Login';
                                    return;
                                }

                                // If server returned HTML (validation) in responseText, show it inside modal or workspace
                                if (xhr && xhr.responseText && xhr.responseText.trim().charAt(0) === '<') {
                                    var $modal = $form.closest('.modal');
                                    if ($modal.length) $modal.find('.modal-content').html(xhr.responseText);
                                    else if ($('#mainWorkspace').length) $('#mainWorkspace').html(xhr.responseText);
                                    safeParseUnobtrusive($('#mainWorkspace'));
                                } else {
                                    var msg = (xhr && xhr.responseText) ? xhr.responseText : (err || status || 'Server error');
                                    if (typeof appalert === 'function') appalert(msg, 0, 1); else alert(msg);
                                }
                            })
                            .always(function () {
                                // clear submitting flag only if this was the latest request
                                if (thisRequestId === window._ajaxSubmitState.lastRequestId) {
                                    window._ajaxSubmitState.isSubmitting = false;
                                } else {
                                    console.info('Newer request present, leaving submitting state true');
                                }

                                if (thisRequestId === window._ajaxSubmitState.lastRequestId) {
                                    try { $submit.prop('disabled', false).removeClass('disabled'); } catch (e) { /*ignore*/ }
                                }
                            });

                        // store xhr so it can be aborted externally if needed
                        window._ajaxSubmitState.lastXhr = jqxhr;

                    }, function () {
                        // confirm cancel
                        window._ajaxSubmitState.isSubmitting = false;
                        if (typeof appalert === 'function') appalert('Transaction cancelled', 3, 1); else console.info('Transaction cancelled');
                    });

                } catch (ex) {
                    window._ajaxSubmitState.isSubmitting = false;
                    console.error('AjaxPost top-level error', ex);
                    if (typeof appalert === 'function') appalert('Unexpected error: ' + ex.message, 0, 1); else alert('Unexpected error: ' + ex.message);
                }

                return false; // prevent normal submit
            }

            window.AjaxPost = AjaxPost;

            //******************************************************************* */

            // handle edit form submit inside modal (delegated)
            $(document).off('submit', '#editAccountForm').on('submit', '#editAccountForm', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('#saveButton');
                var originalHtml = $btn.html();
                var formData = $form.serialize();
                var token = $form.find('input[name="__RequestVerificationToken"]').val();

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving');

                $.ajax({
                    url: '/BranchAccount/CreateOrUpdate',
                    type: 'POST',
                    data: formData,
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    success: function (res) {
                        $btn.prop('disabled', false).html(originalHtml);
                        if (res && res.success) {
                            try {
                                var modalEl = document.getElementById('affiliateEditModal');
                                var bs = bootstrap.Modal.getInstance(modalEl);
                                if (bs) bs.hide();
                            } catch (err) { /* ignore */ }

                            if (myDataTableInstance) myDataTableInstance.ajax.reload(null, false);
                            if (typeof appalert === 'function') appalert(res.message || 'Saved', 3, 1);
                        } else {
                            if (typeof appalert === 'function') appalert(res?.message || 'Save failed', 0, 1);
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                        if (typeof appalert === 'function') appalert('Save request failed', 0, 1);
                    }
                });
            });

            // optionally auto-initialize table on page load:
            // initMyDataTableIfNeeded();
        });
    </script>
}
