    // -------------------------------
    // File extraction
    // -------------------------------
        // Small helpers
        function sanitizeId(s) { return (s || '').toString().replace(/[^a-zA-Z0-9_]/g, '_'); }
        function fmtMoney(n) { return (Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

        window.extractFile = function (fileId) {
            if (!fileId) { appalert('No file to extract.', 3, 1); return; }

            // Confirmation (kept from your version)
            var confirmDialog = window.alertify && typeof alertify.confirm === 'function' ? alertify.confirm : null;
            var doConfirm = function (onOk, onCancel) {
                if (confirmDialog) {
                    try {
                        alertify.confirm("Confirmation", "Are you sure you want to extract this file?", onOk, onCancel)
                            .set('labels', { ok: 'Yes', cancel: 'No' });
                        return;
                    } catch (e) { /* fallback */ }
                }
                if (window.confirm("Are you sure you want to extract this file?")) onOk(); else if (typeof onCancel === 'function') onCancel();
            };

            doConfirm(function () {
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/ManualDailyCollection/extract',
                    type: 'POST',
                    data: { KEY: fileId },
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    dataType: 'json',
                    beforeSend: function () {
                        // no modal yet; optional toast:
                        if (typeof appalert === 'function') appalert('Extracting…', 2, 0);
                    }
                })
                    .done(function (response) {
                        try {
                            var status = ((response && (response.status ?? response.Status)) || '').toString().toLowerCase();
                            var data = response && (response.data ?? response.Data ?? null);

                            // Build body HTML for modal
                            var bodyEl = document.getElementById('extractionModalBody');
                            if (status === 'success' && data) {
                                if (typeof appalert === 'function') appalert(response.statusDescription || 'File extracted successfully.', 1, 1);

                                // remember last id if needed
                                window.currentFileUploadId = data.FileUploadId ?? data.fileUploadId ?? window.currentFileUploadId;

                                // Build HTML (dashboard + listing)
                                var modalHtml = buildExtractionModalHtml(data);
                                bodyEl.innerHTML = modalHtml;

                                // Initialize table
                                var tableId = '#extractedDetailsTable_' + sanitizeId(data.FileUploadId ?? data.fileUploadId ?? Date.now());
                                var detailsArray = data.details ?? data.Details ?? [];
                                if (!Array.isArray(detailsArray)) detailsArray = [];

                                if (typeof $.fn.DataTable === 'function') {
                                    // Enhance via DataTables
                                    $(tableId).DataTable({
                                        destroy: true,
                                        data: detailsArray,
                                        columns: [
                                            { title: "Member Ref.", data: function (row) { return row.memberReference ?? row.MemberReference ?? row.MemberRef ?? ''; } },
                                            { title: "Member Name", data: function (row) { return row.memberName ?? row.MemberName ?? row.name ?? ''; } },
                                            { title: "Account No.", data: function (row) { return row.accountNumber ?? row.AccountNumber ?? row.fullAccountNumber ?? row.FullAccountNumber ?? ''; } },
                                            { title: "Member Branch", data: function (row) { return row.memberBranchName ?? row.MemberBranchName ?? ''; } },
                                            { title: "Amount", className: "text-end", data: function (row) { return row.amount ?? row.Amount ?? 0; }, render: $.fn.dataTable.render.number(',', '.', 2) }
                                        ],
                                        responsive: true,
                                        pageLength: 10,
                                        lengthMenu: [10, 25, 50, 100]
                                    });
                                } else {
                                    // Plain HTML fallback (no DataTables)
                                    var tbody = document.querySelector(tableId + ' tbody');
                                    if (tbody) {
                                        var rows = detailsArray.map(function (r) {
                                            return '<tr>'
                                                + '<td>' + (r.memberReference ?? r.MemberReference ?? r.MemberRef ?? '') + '</td>'
                                                + '<td>' + (r.memberName ?? r.MemberName ?? r.name ?? '') + '</td>'
                                                + '<td>' + (r.accountNumber ?? r.AccountNumber ?? r.fullAccountNumber ?? r.FullAccountNumber ?? '') + '</td>'
                                                + '<td>' + (r.memberBranchName ?? r.MemberBranchName ?? '') + '</td>'
                                                + '<td class="text-end">' + fmtMoney(r.amount ?? r.Amount ?? 0) + '</td>'
                                                + '</tr>';
                                        }).join('');
                                        tbody.innerHTML = rows || '<tr><td colspan="5" class="text-center text-muted">No details.</td></tr>';
                                    }
                                }

                                // Refresh main list if you want
                                if (typeof handleExtractSuccess === 'function') handleExtractSuccess(fileId);
                            } else {
                                var msg = (response && (response.message || response.statusDescription)) || 'Extraction failed.';
                                bodyEl.innerHTML =
                                    '<div class="alert alert-warning" role="alert">'
                                    + '<i class="mdi mdi-alert-outline me-1"></i>' + msg + '</div>';
                                if (typeof appalert === 'function') appalert(msg, 4, 1);
                            }

                            // Finally show the modal (after content is ready)
                            new bootstrap.Modal(document.getElementById('extractionModal')).show();
                        } catch (err) {
                            console.error('extractFile: success handler error', err, response);
                            showExtractionErrorModal('An unexpected error occurred while building extraction results.', err);
                        }
                    })
                    .fail(function (xhr, status, err) {
                        console.error('extractFile: ajax error', status, err, xhr);
                        showExtractionErrorModal('An error occurred during extraction. Please try again.', err, xhr);
                    });
            }, function () {
                if (typeof appalert === 'function') appalert("Extraction cancelled.", 3, 1);
            });
        }; // end extractFile

        function showExtractionErrorModal(message, err, xhr) {
            var bodyEl = document.getElementById('extractionModalBody');
            bodyEl.innerHTML =
                '<div class="alert alert-danger" role="alert">'
                + '<i class="mdi mdi-alert-circle-outline me-2"></i>' + message
                + (err ? '<div class="small text-muted mt-1">' + (err.message || err) + '</div>' : '')
                + (xhr && xhr.responseText ? '<div class="small text-muted mt-1">' + xhr.responseText + '</div>' : '')
                + '</div>';
            new bootstrap.Modal(document.getElementById('extractionModal')).show();
        }

        // Print helper (modal)
        function printExtractionModal() {
            var html = document.getElementById('extractionModalBody').innerHTML;
            var w = window.open('', 'printExtract');
            w.document.write('<html><head><title>Extraction Result</title>');
            w.document.write('<link rel="stylesheet" href="/Content/bootstrap.min.css" />');
            w.document.write('<link rel="stylesheet" href="/Content/site.css" />');
            w.document.write('</head><body class="p-3">');
            w.document.write(html);
            w.document.write('</body></html>');
            w.document.close(); w.focus(); w.print(); w.close();
        }
    // -------------------------------
    // NEW RESET FUNCTIONS (optional)
