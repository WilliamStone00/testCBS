@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse
@{
    ViewBag.Title = "Manual Daily Collection";
}
@using Resources

<!-- Header -->
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-upload-multiple me-2"></i> @GlobalDailyCollectorManagement.MAD</h1>
        <p class="card-text">@ChequeManagements.Headertextforindex</p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @ChequeManagements.importanttextindex
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips"><i class="mdi mdi-chevron-down"></i></button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>📂 @ChequeManagements.UploadNewFile</strong>
                    @ChequeManagements.UploadNewFileINSTR
                    <em>Tip:</em> @ChequeManagements.tipUploadNewFile
                </li>
                <li class="list-group-item">
                    <strong>📜 @ChequeManagements.ViewAllFiles</strong>
                    @ChequeManagements.ViewAllFilestext
                    <em>Tip:</em> ViewAllFilestiptext
                </li>
                <li class="list-group-item">
                    <strong>🔎 @ChequeManagements.FileD</strong>
                    @ChequeManagements.FileDetailsTEXT1
                    <em>Tip:</em>  @ChequeManagements.FileDetailsTIPtext
                </li>
                <li class="list-group-item">
                    <strong>📥 @ChequeManagements.DownloadTemplate:</strong>
                    @ChequeManagements.DownloadTemplatetext
                    <em>Tip:</em> @ChequeManagements.DownloadTemplatetetTIPStext.
                </li>
                <li class="list-group-item">
                    <strong>🗑️ @ChequeManagements.DeleteInvalidFile:</strong>
                    @ChequeManagements.DeleteInvalidFiletext
                    <em>Tip:</em> @ChequeManagements.DeleteInvalidFileTIPStext
                </li>
                <li class="list-group-item">
                    <strong>👤 @ChequeManagements.UserRolesPermissions</strong>
                    @ChequeManagements.UserRolesPermissionsTEXT
                    <em>Tip:</em> @ChequeManagements.UserRolesPermissionsTIPSTEXT
                </li>
                <li class="list-group-item">
                    <strong>⏳ @ChequeManagements.ProcessingTime</strong>
                    @ChequeManagements.ProcessingTimetext
                    <em>Tip:</em> @ChequeManagements.ProcessingTimetiptext.
                </li>
                <li class="list-group-item">
                    <strong>❓ @ChequeManagements.NeedHelp</strong>
                    @ChequeManagements.Lookforthehelpicon (<i class="mdi mdi-help-circle-outline text-info"></i>) @ChequeManagements.Lookforthehelpicontext
                    <em>Tip:</em>  @ChequeManagements.LookforthehelpiconTiptext
                </li>
        </div>
    </div>

    <!-- Main Content Area -->

    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <!-- CORRECTED: The onclick functions now target 'mainWorkspace' -->
            <a type="button" onclick="LoadDataGen('ManualDailyCollection', 'myDataTable', '_FileList', 0, 'mainWorkspace', null, 'list')" class="btn btn-label-primary btn-sm me-2">
                <i class="mdi mdi-view-list mdi-18px"></i>  @ChequeManagements.ViewAllFiles2
            </a>
            <a type="button" onclick="AddORUpdateGen(null,'mainWorkspace','_UploadForm','new','ManualDailyCollection')" class="btn btn-label-secondary btn-sm">
                <i class="mdi mdi-plus mdi-18px"></i>  @ChequeManagements.UploadFile
            </a>
        </div>
    </div>

    <!-- CORRECTED: The main content div now has the ID 'mainWorkspace' -->
    <div id="mainWorkspace">
        @* The initial upload form is rendered by the server *@
        @Html.Partial("_UploadForm")
    </div>

</div>
@section Scripts {
    @* This line includes jQuery validation scripts, which is good practice *@
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        // ===================================================================
        //
        //  Manual Daily Collection - DataTable Version with Delete Handling
        //  Handles the efficient, single-call AJAX submission with DataTable preview.
        //  Clears the display when delete operation is successful.
        //
        // ===================================================================

        (function ($) {

            // --- Configuration for your global appalert function ---
            const ALERT_STATE = {
                SUCCESS: 1,
                WARNING: 2,
                INFO: 3,
                DANGER: 4
            };
            const ALERT_TYPE = {
                TOASTR: 1,
                ALERTIFY: 2
            };

            // Reference to the DataTable instance
            let previewDataTable = null;
            // Store the current file upload ID for delete operations
            let currentFileUploadId = null;

            function initialize() {
                $('#mainWorkspace').on('submit', '#manualUploadForm', handleUploadSubmit);
            }

            function handleUploadSubmit(e) {
                e.preventDefault();
                const form = this;
                const $form = $(form);
                const actionUrl = $form.attr('action');
                const formData = new FormData(form);
                const $submitButton = $form.find('button[type="submit"]');
                const $resultContainer = $('#uploadResultContainer');

                $.validator.unobtrusive.parse(form);
                if (!$form.valid()) { return false; }

                alertify.confirm("Confirmation", "Are you sure you want to upload this file?",
                    function () {
                        $.ajax({
                            type: 'POST',
                            url: actionUrl,
                            data: formData,
                            contentType: false,
                            processData: false,
                            beforeSend: function () {
                                $submitButton.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Uploading...');
                                $resultContainer.slideUp().html('');
                            },
                            success: function (response) {
                                if (response.success && response.data) {
                                    if (window.appalert) appalert(response.message || "File validated successfully!", ALERT_STATE.SUCCESS, ALERT_TYPE.TOASTR);
                                    const previewHtml = buildPreviewHtml(response.data);
                                    $resultContainer.html(previewHtml).slideDown();
                                    initializeDataTable(response.data);
                                    // Store the current file upload ID for potential delete operations
                                    currentFileUploadId = response.data.FileUploadId || null;
                                    form.reset();
                                    $form.find('.select2').val(null).trigger('change');
                                } else {
                                    if (response.Status === "Exist") {
                                        appalert(response.message, ALERT_STATE.WARNING, ALERT_TYPE.TOASTR);
                                    } else {
                                        appalert(response.message || "Upload Failed.", ALERT_STATE.DANGER, ALERT_TYPE.TOASTR);
                                    }
                                }
                            },
                            error: function (err) {
                                if (err.status === 401) {
                                    window.location.href = '/Authentication/Login';
                                } else {
                                    if (window.appalert) appalert(err.statusText || "An unexpected server error occurred.", ALERT_STATE.DANGER, ALERT_TYPE.TOASTR);
                                }
                            },
                            complete: function () {
                                $submitButton.prop('disabled', false).html('<i class="mdi mdi-cloud-upload-outline me-1"></i> Upload File');
                            }
                        });
                    },
                    function () {
                        appalert('Upload cancelled by user.', ALERT_STATE.INFO, ALERT_TYPE.TOASTR);
                    }
                );
                return false;
            }

            function buildPreviewHtml(data) {
                if (!data) return '<div class="alert alert-danger">Preview data was not received.</div>';

                // Additional check for the specific data structure
                if (!data.FileUploadId) {
                    return '<div class="alert alert-warning">Unexpected data format received from server.</div>';
                }

                // The summary properties are now all consistently PascalCase to match the C# class
                const fullHtml = `
            <fieldset class="fieldset-custom">
                <div class="card-header bg-white border-0">
                    <legend class="legend-custom">File Details: ${data.FileUploadId || 'N/A'}</legend>
                </div>
                <div class="row p-2">
                    <div class="col-sm-6 col-lg-3 mb-3">
                        <div class="card card-border-shadow-warning h-100 p-2">
                             <p class="mb-0 text-heading" style="font-size: 0.85rem;">Uploaded By</p>
                             <h5 class="ms-1 mb-0">${data.UploadedBy || 'N/A'}</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 mb-3">
                        <div class="card card-border-shadow-info h-100 p-2">
                            <p class="mb-0 text-heading" style="font-size: 0.85rem;">Branch</p>
                            <h5 class="ms-1 mb-0">${data.BranchName || 'N/A'}</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 mb-3">
                        <div class="card card-border-shadow-success h-100 p-2">
                            <p class="mb-0 text-heading" style="font-size: 0.85rem;">Total Members</p>
                            <h5 class="ms-1 mb-0">${data.TotalMembers || 0}</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 mb-3">
                        <div class="card card-border-shadow-danger h-100 p-2">
                            <p class="mb-0 text-heading" style="font-size: 0.85rem;">Total Amount</p>
                            <h5 class="ms-1 mb-0">${formatCurrency(data.TotalAmount)}</h5>
                        </div>
                    </div>
                </div>
                <div class="table-responsive mt-3">
                    <table id="previewDataTable" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>Member Ref.</th>
                                <th>Member Name</th>
                                <th>Collector Name</th>
                                <th>Member Branch</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DataTable will populate this automatically -->
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button id="deleteUploadBtn" class="btn btn-danger">Delete</button>
                </div>
            </fieldset>
        `;

                return fullHtml;
            }

            function initializeDataTable(data) {
                // We now reliably check for the PascalCase property
                const detailsList = data.manualEntryDailyCollectorUploadListDtos ||
                    data.ManualEntryDailyCollectorUploadListDtos || [];

                // Destroy existing DataTable if it exists
                if (previewDataTable !== null) {
                    previewDataTable.destroy();
                    previewDataTable = null;
                }

                // Initialize new DataTable
                previewDataTable = $('#previewDataTable').DataTable({
                    data: detailsList,
                    columns: [
                        {
                            data: "memberReference",
                            title: "Member Ref.",
                            render: $.fn.dataTable.render.text() // Sanitize output
                        },
                        {
                            data: "memberName",
                            title: "Member Name",
                            render: $.fn.dataTable.render.text() // Sanitize output
                        },
                        {
                            data: "dailyCollectorName",
                            title: "Collector Name",
                            render: $.fn.dataTable.render.text()
                        },
                        {
                            data: "memberBranchName",
                            title: "Member Branch",
                            render: $.fn.dataTable.render.text()
                        },
                        {
                            data: "amount",
                            title: "Amount",
                            className: "text-end",
                            render: function (data) {
                                return formatCurrency(data);
                            }
                        }
                    ],
                    language: {
                        emptyTable: "No data available in table",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                        infoEmpty: "Showing 0 to 0 of 0 entries",
                        infoFiltered: "(filtered from _MAX_ total entries)",
                        lengthMenu: "Show _MENU_ entries",
                        search: "Search:",
                        zeroRecords: "No matching records found"
                    },
                    responsive: true,
                    lengthMenu: [[5, 10, 25, 50, 100, 500, 1000], [5, 10, 25, 50, 100, 500, 1000]],
                    pageLength: 10,
                    order: [[0, 'asc']],
                    dom: '<"top"lf>rt<"bottom"ip><"clear">'
                });

                // Add click handler for the delete button
                $('#deleteUploadBtn').on('click', function () {
                    handleDeleteUpload();
                });
            }

            function handleDeleteUpload() {
                if (!currentFileUploadId) {
                    appalert('No file upload to delete.', ALERT_STATE.WARNING, ALERT_TYPE.TOASTR);
                    return;
                }

                // Create a custom wrapper for your DeleteRecordDataTable function
                // that will clear the preview when deletion is successful

                // Store reference to the result container
                const $resultContainer = $('#uploadResultContainer');

                // Create a custom callback by overriding the LoadDataTableNew function temporarily
                const originalLoadDataTableNew = window.LoadDataTableNew;

                window.LoadDataTableNew = function (controller, tableID, action, Key2, partialView, order, path, divToLoadTheData) {
                    // Clear the preview container
                    $resultContainer.slideUp().html('');
                    currentFileUploadId = null;

                    // Restore the original function
                    window.LoadDataTableNew = originalLoadDataTableNew;

                    // Call the original function if it exists
                    if (typeof originalLoadDataTableNew === 'function') {
                        return originalLoadDataTableNew.apply(this, arguments);
                    }
                };

                // Call your existing DeleteRecordDataTable function
                DeleteRecordDataTable(
                    'ManualDailyCollection',
                    currentFileUploadId,
                    'myDataTable',
                    '_FileList',
                    0,
                    'mainWorkspace',
                    null,
                    'list'
                );
            }

            function formatCurrency(num) {
                return (typeof num === 'number') ?
                    num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) :
                    '0.00';
            }

            $(document).ready(initialize);

        }(jQuery));

    </script>


}
