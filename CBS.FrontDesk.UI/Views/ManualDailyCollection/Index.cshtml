@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse
@{
    ViewBag.Title = "Manual Daily Collection";
}
@using Resources

<!-- Header -->
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-upload-multiple me-2"></i> @GlobalDailyCollectorManagement.MAD</h1>
        <p class="card-text">@ChequeManagements.Headertextforindex</p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @ChequeManagements.importanttextindex
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips"><i class="mdi mdi-chevron-down"></i></button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>📂 @ChequeManagements.UploadNewFile</strong>
                    @ChequeManagements.UploadNewFileINSTR
                    <em>Tip:</em> @ChequeManagements.tipUploadNewFile
                </li>
                <li class="list-group-item">
                    <strong>📜 @ChequeManagements.ViewAllFiles</strong>
                    @ChequeManagements.ViewAllFilestext
                    <em>Tip:</em> ViewAllFilestiptext
                </li>
                <li class="list-group-item">
                    <strong>🔎 @ChequeManagements.FileD</strong>
                    @ChequeManagements.FileDetailsTEXT1
                    <em>Tip:</em>  @ChequeManagements.FileDetailsTIPtext
                </li>
                <li class="list-group-item">
                    <strong>📥 @ChequeManagements.DownloadTemplate:</strong>
                    @ChequeManagements.DownloadTemplatetext
                    <em>Tip:</em> @ChequeManagements.DownloadTemplatetetTIPStext.
                </li>
                <li class="list-group-item">
                    <strong>🗑️ @ChequeManagements.DeleteInvalidFile:</strong>
                    @ChequeManagements.DeleteInvalidFiletext
                    <em>Tip:</em> @ChequeManagements.DeleteInvalidFileTIPStext
                </li>
                <li class="list-group-item">
                    <strong>👤 @ChequeManagements.UserRolesPermissions</strong>
                    @ChequeManagements.UserRolesPermissionsTEXT
                    <em>Tip:</em> @ChequeManagements.UserRolesPermissionsTIPSTEXT
                </li>
                <li class="list-group-item">
                    <strong>⏳ @ChequeManagements.ProcessingTime</strong>
                    @ChequeManagements.ProcessingTimetext
                    <em>Tip:</em> @ChequeManagements.ProcessingTimetiptext.
                </li>
                <li class="list-group-item">
                    <strong>❓ @ChequeManagements.NeedHelp</strong>
                    @ChequeManagements.Lookforthehelpicon (<i class="mdi mdi-help-circle-outline text-info"></i>) @ChequeManagements.Lookforthehelpicontext
                    <em>Tip:</em>  @ChequeManagements.LookforthehelpiconTiptext
                </li>
        </div>
    </div>

    <!-- Main Content Area -->

    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <!-- CORRECTED: The onclick functions now target 'mainWorkspace' -->
            <a type="button" onclick="LoadDataGen('ManualDailyCollection', 'myDataTable', '_FileList', 0, 'mainWorkspace', null, 'list')" class="btn btn-label-primary btn-sm me-2">
                <i class="mdi mdi-view-list mdi-18px"></i>  @ChequeManagements.ViewAllFiles2
            </a>
            <a type="button" onclick="AddORUpdateGen(null,'mainWorkspace','_UploadForm','new','ManualDailyCollection')" class="btn btn-label-secondary btn-sm">
                <i class="mdi mdi-plus mdi-18px"></i>  @ChequeManagements.UploadFile
            </a>
        </div>
    </div>

    <!-- CORRECTED: The main content div now has the ID 'mainWorkspace' -->
    <div id="mainWorkspace">
        @* The initial upload form is rendered by the server *@
        @Html.Partial("_UploadForm")
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

<script>
        // --- FIXED FUNCTION: Load Collectors Dropdown ---
function loadCollectors(branchId) {
    let $collectorDropdown = $('#CollectorxCollectorId');

    // Reset dropdown
    $collectorDropdown.empty().append('<option value="">--- Loading ---</option>');

    if (branchId) {
        $.getJSON('@Url.Action("GetCollectorsByBranch", "ManualDailyCollection")', { branchId: branchId })
            .done(function (data) {
                $collectorDropdown.empty().append('<option value="">--- Select Daily Collector ---</option>');
                $.each(data, function (i, item) {
                    $collectorDropdown.append($('<option>', {
                        value: item.Value,   // Correct casing
                        text: item.Text     // Correct casing
                    }));
                });
            })
            .fail(function () {
                $collectorDropdown.empty().append('<option value="">--- Error loading collectors ---</option>');
            });
    } else {
        $collectorDropdown.empty().append('<option value="">--- Select Daily Collector ---</option>');
    }
}
    (function ($) {
        let currentFileUploadId = null; // Store the ID of the last successful upload

        // --- INITIALIZATION ---
        function initialize() {
            // Main form submission for the initial upload
            $('#mainWorkspace').on('submit', '#manualUploadForm', handleUploadSubmit);

            // Delegated handlers for buttons inside the dynamic preview containers
            $('#mainWorkspace')
                //.on('click', '#resetPreviewBtn', resetInitialPreview) // Resets the FIRST preview
                .on('click', '#deleteUploadedFileBtn', deleteUploadedFile)
                .on('click', '#extractFileBtn', extractFile)
                .on('click', '#closeExtractedPreviewBtn', resetInitialPreview); // The new "Close" button will also reset everything
        }



        // --- FUNCTION 1: Handles the initial file UPLOAD ---
        function handleUploadSubmit(e) {
            e.preventDefault();
            const form = this;
            const $form = $(form);
            const actionUrl = $form.attr('action');
            const formData = new FormData(form);
            const $submitButton = $form.find('button[type="submit"]');
            const $resultContainer = $('#uploadResultContainer');

            if (!$form.valid()) return false;

            alertify.confirm("Confirmation", "Are you sure you want to upload this file?", function () {
                $.ajax({
                    type: 'POST',
                    url: actionUrl,
                    data: formData,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        $submitButton.prop('disabled', true).html('Uploading...');
                        $resultContainer.slideUp().html('');
                    },
                    success: function (response) {
                        if ((response.success === true || response.isSuccess === true) && response.data) {
                            appalert(response.message || "File processed successfully!", 1, 1);

                            currentFileUploadId = response.data.FileUploadId;

                            const previewHtml = buildInitialPreviewHtml(response.data);
                            $resultContainer.html(previewHtml).slideDown();

                            const tableData = response.data.manualEntryDailyCollectorUploadListDtos || [];

                            $('#previewDetailsTable').DataTable({
                                destroy: true,
                                data: tableData,
                                columns: [
                                    { data: "memberReference", title: "Member Ref." },
                                    { data: "memberName", title: "Member Name" },
                                    { data: "dailyCollectorName", title: "Collector Name" },
                                    { data: "memberBranchName", title: "Member Branch" },
                                    {
                                        data: "amount",
                                        title: "Amount",
                                        className: "text-end",
                                        render: $.fn.dataTable.render.number(',', '.', 2)
                                    }
                                ],
                                responsive: true,
                                pageLength: 5,
                                lengthMenu: [5, 10, 25, 50]
                            });

                            form.reset();
                            $form.find('.select2').val(null).trigger('change');
                        } else {
                            appalert(response.message || "Upload Failed.", 4, 1);
                        }
                    },
                    error: function (err) {
                        appalert(err.statusText || "An error occurred.", 4, 1);
                    },
                    complete: function () {
                        $submitButton.prop('disabled', false).html('<i class="mdi mdi-cloud-upload-outline me-1"></i> Upload');
                    }
                });
            }, function () {
                appalert('Upload cancelled.', 3, 1);
            });
        }

        function buildInitialPreviewHtml(data) {
            const formatCurrency = (num) => (num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return `
        <fieldset class="fieldset-custom">
            <legend class="legend-custom">File Preview: ${data.FileUploadId || 'N/A'}</legend>
            <div class="row g-2">
                <div class="col-6 col-md-3"><div class="card card-border-shadow-warning h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Uploaded By</p><h6 class="ms-1 mb-0">${data.UploadedBy || ''}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-info h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Branch</p><h6 class="ms-1 mb-0">${data.BranchName || ''}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-success h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Members</p><h6 class="ms-1 mb-0">${data.TotalMembers || 0}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-danger h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Amount</p><h6 class="ms-1 mb-0">${formatCurrency(data.TotalAmount)}</h6></div></div></div>
            </div>
            <div class="table-responsive mt-3">
                <table id="previewDetailsTable" class="table table-striped table-bordered" style="width:100%"></table>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button type="button" id="resetPreviewBtn" class="btn btn-outline-secondary me-2">Reset</button>
                <button type="button" id="deleteUploadedFileBtn" class="btn btn-danger me-2">Delete</button>
                <button type="button" id="extractFileBtn" class="btn btn-primary">Extract File</button>
            </div>
        </fieldset>`;
        }

        function buildExtractedPreviewHtml(data) {
            const formatCurrency = (num) => (num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return `
        <fieldset class="fieldset-custom">
            <legend class="legend-custom text-success">Extraction Successful: ${data.FileUploadId || 'N/A'}</legend>
            <div class="row g-2">
                <div class="col-6 col-md-3"><div class="card card-border-shadow-warning h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Collector Name</p><h6 class="ms-1 mb-0">${data.CollectorName || ''}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-info h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Branch</p><h6 class="ms-1 mb-0">${data.BranchName || ''}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-success h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Members</p><h6 class="ms-1 mb-0">${data.TotalMember || 0}</h6></div></div></div>
                <div class="col-6 col-md-3"><div class="card card-border-shadow-danger h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Amount</p><h6 class="ms-1 mb-0">${formatCurrency(data.TotalAmount)}</h6></div></div></div>
            </div>
            <div class="table-responsive mt-3">
                <table id="extractedDetailsTable" class="table table-striped table-bordered" style="width:100%"></table>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button type="button" id="closeExtractedPreviewBtn" class="btn btn-secondary">Close</button>
            </div>
        </fieldset>`;
        }

        // --- FUNCTION 4: Handles FILE EXTRACTION ---
        function extractFile() {
            if (!currentFileUploadId) {
                appalert('No file to extract.', 3, 1);
                return;
            }

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $resultContainer = $('#uploadResultContainer');

            $.ajax({
                url: '/ManualDailyCollection/extract',
                type: 'POST',
                data: { KEY: currentFileUploadId },
                headers: token ? { 'RequestVerificationToken': token } : {},
                dataType: 'json',
                beforeSend: function () {
                    $resultContainer.html('<p class="text-center">Extracting data...</p>');
                },
                success: function (response) {
                    if (response && response.status === "SUCCESS" && response.data) {
                        appalert(response.statusDescription || 'File extracted successfully.', 1, 1);
                        const extractedHtml = buildExtractedPreviewHtml(response.data);
                        $resultContainer.html(extractedHtml);
                        $('#extractedDetailsTable').DataTable({
                            /*destroy: true,*/
                            data: response.data.details || [],
                            columns: [
                                { data: "MemberReference", title: "Member Ref." },
                                { data: "MemberName", title: "Member Name" },
                                { data: "FullAccountNumber", title: "Account No." },
                                { data: "MemberBranchName", title: "Member Branch" },
                                {
                                    data: "amount",
                                    title: "Amount",
                                    className: "text-end",
                                    render: $.fn.dataTable.render.number(',', '.', 2)
                                }
                            ],
                            responsive: true,
                            pageLength: 5,
                            lengthMenu: [5, 10, 25, 50]
                        });
                    } else {
                        appalert((response && response.message) || 'Extraction failed.', 4, 1);
                    }
                },
                error: function () {
                    appalert('An error occurred during extraction.', 4, 1);
                }
            });
        }

        // --- UTILITIES ---
        function resetInitialPreview() {
            $('#uploadResultContainer').slideUp().html('');
            if ($.fn.DataTable.isDataTable('#previewDetailsTable')) {
                $('#previewDetailsTable').DataTable().destroy();
            }
            if ($.fn.DataTable.isDataTable('#extractedDetailsTable')) {
                $('#extractedDetailsTable').DataTable().destroy();
            }
            currentFileUploadId = null;
        }

        function deleteUploadedFile() {
            if (!currentFileUploadId) {
                appalert('No uploaded file to delete.', 3, 1);
                return;
            }
            alertify.confirm('Confirm Delete', 'This will permanently delete the uploaded file. Continue?', function () {
                const token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '/ManualDailyCollection/DeleteFile',
                    type: 'POST',
                    data: { fileUploadId: currentFileUploadId },
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    success: function (response) {
                        if (response && response.success) {
                            appalert(response.message || 'File deleted.', 1, 1);
                            resetInitialPreview();
                        } else {
                            appalert((response && response.message) || 'Could not delete file.', 4, 1);
                        }
                    },
                    error: function () {
                        appalert('Error deleting file.', 4, 1);
                    }
                });
            });
        }

        // --- Start ---
        $(document).ready(initialize);

    }(jQuery));
</script>
}
