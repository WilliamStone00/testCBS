    function resetFirstPreview() {
        // hide & clear first preview area (previewDetailsTable)
        $('#firstPreviewContainer').slideUp(function () { $(this).html(''); });
        if ($.fn.DataTable.isDataTable('#previewDetailsTable')) {
            try { $('#previewDetailsTable').DataTable().destroy(); } catch (e) { /* ignore */ }
            $('#previewDetailsTable').empty();
        }
    }

    function resetExtractedPreview() {
        // hide & clear second preview area (extractedDetailsTable)
        $('#secondPreviewContainer').slideUp(function () { $(this).html(''); });
