<!-- Main Workspace Card -->
<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">
        <div id="mainWorkspace">
            @* The initial upload form is rendered by the server *@
            @Html.Partial("_UploadForm")
        </div>
    </div>

    <div class="card-footer bg-light text-muted text-end">
        <small>
            <i class="mdi mdi-information-outline me-1 text-info"></i>
            Please ensure Branch, Collector and Accounting Date are correctly set before uploading.
        </small>
    </div>
</div>
<!-- File Details Modal -->
<div class="modal fade" id="fileDetailsModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="mdi mdi-file-document-outline me-2"></i>
                    File Upload Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div id="fileDetailsModalBody" class="modal-body">
                <!-- loader placeholder -->
                <div class="d-flex align-items-center py-5 justify-content-center text-muted">
                    <div class="spinner-border me-2" role="status"></div> Loading…
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Close
                </button>
                <button type="button" class="btn btn-primary" onclick="printFileDetailsModal()">
                    <i class="mdi mdi-printer"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Extraction Result Modal -->
<div class="modal fade" id="extractionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-database-import-outline me-2"></i> Extraction Result</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="extractionModalBody" class="modal-body"><!-- injected after success/error --></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Close
                </button>
                <button type="button" class="btn btn-primary" onclick="printExtractionModal()">
                    <i class="mdi mdi-printer"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        // Utility: detect Select2
  function hasSelect2() { return !!(window.jQuery && $.fn && $.fn.select2); }

  // Initialize state on page load
  $(function () {
    var $collector = $('#CollectorxCollectorId');

    // initial disabled hint
    $collector.empty()
              .append(new Option('Select a branch to load collectors', ''))
              .prop('disabled', true);

    if (hasSelect2()) $collector.trigger('change');

    // bind branch change -> load collectors via AJAX
    $('#BranchId').on('change', function () {
      loadCollectorsAjax(this.value);
    });
  });

    let currentFileUploadId = null; // Store the ID of the last successful upload

    // -------------------------------
    // Initialization: delegate handlers
    // -------------------------------
    function initialize() {
        // Avoid duplicate bindings if initialize() is called again
        $('#mainWorkspace')
            .off('submit', '#manualUploadForm')
            .on('submit', '#manualUploadForm', handleUploadSubmit);

        // (optional) also bind a click -> submit trigger
        $('#mainWorkspace')
            .off('click', '#btnUpload')
            .on('click', '#btnUpload', function (e) {
                e.preventDefault();
                $('#manualUploadForm').trigger('submit'); // calls handleUploadSubmit
            });
    }
    $(document).ready(initialize);


    // helper (safe, no lodash)
    function escapeHtml(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function handleUploadSubmit(e) {
        e.preventDefault();

        const form = this;
        const $form = $(form);
        const actionUrl = $form.attr('action');
        const formData = new FormData(form);
        const $submitButton = $form.find('button[type="submit"]');
        const $resultContainer = $('#uploadResultContainer');

        // selections for dialog + server mapping
        const branchId = $('#BranchId').val();
        const branchText = ($('#BranchId option:selected').text() || '').trim();
        const collectorVal = $('#CollectorxCollectorId').val();
        const collectorText = ($('#CollectorxCollectorId option:selected').text() || '').trim();
        const iso = ($('#AccountingDay').val() || '').trim(); // yyyy-MM-dd
        const fileInput = $form.find('input[type="file"][name="uploadedFile"]')[0];
        const file = (fileInput && fileInput.files && fileInput.files[0]) ? fileInput.files[0] : null;

        // guards
        if (!branchId) { appalert("Please select a branch.", 4, 1); return false; }
        if (!collectorVal) { appalert("Please select a collector.", 4, 1); return false; }
        if (!iso) { appalert("Please select a date.", 4, 1); return false; }
        if (!file) { appalert("Please select a file to upload.", 4, 1); return false; }

        // send AccountingDate in dd-MM-yyyy HH:mm:ss for the controller
        const parts = iso.split('-'); // [Y,M,D]
        if (parts.length === 3) {
            const ddMMyyyyHHmmss = `${parts[0]}-${parts[1]}-${parts[2]}`;
            formData.set('AccountingDate', ddMMyyyyHHmmss);
        }

        if ($form.length && typeof $form.valid === 'function' && !$form.valid()) return false;

        // confirmation dialog content — TABLE
        function formatBytes(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024, units = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + units[i];
        }
        const niceDate = `${parts[0]}-${parts[1]}-${parts[2]}`;

        const html = `
    <div class="text-start">
      <p class="mb-2">Please review and confirm:</p>
      <table class="table table-sm table-striped table-bordered align-middle mb-2">
        <thead>
          <tr>
            <th style="width: 40%;">Item</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td><strong>Branch</strong></td><td>${escapeHtml(branchText)}</td></tr>
          <tr><td><strong>Collector</strong></td><td>${escapeHtml(collectorText)}</td></tr>
          <tr><td><strong>Accounting Date</strong></td><td>${escapeHtml(niceDate)}</td></tr>
          <tr><td><strong>File Name</strong></td><td>${escapeHtml(file.name)}</td></tr>
          <tr><td><strong>File Size</strong></td><td>${formatBytes(file.size)}</td></tr>
        </tbody>
      </table>
      <div class="alert alert-warning mb-0" role="alert">
        <i class="mdi mdi-alert-outline me-1"></i>
        The Accounting Date applies to <strong>all rows</strong> in the file.
      </div>
    </div>
  `;

        const dlg = alertify.confirm('Confirm Upload', '', onOk, onCancel).set({
            labels: { ok: 'Confirm Upload', cancel: 'Review' },
            movable: false,
            closable: true,
            reverseButtons: true,
            transition: 'zoom'
        });
        dlg.setContent(html);

        function onOk() {
            $.ajax({
                type: 'POST',
                url: actionUrl,
                data: formData,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    $submitButton.prop('disabled', true).html('Uploading...');
                    $resultContainer.slideUp().html('');
                },
                success: function (response) {
                    if ((response.success === true || response.isSuccess === true) && response.data) {
                        appalert(response.message || "File processed successfully!", 1, 1);

                        window.currentFileUploadId = response.data.FileUploadId || response.data.fileUploadId || window.currentFileUploadId;

                        const previewHtml = buildInitialPreviewHtml(response.data);
                        $resultContainer.html(previewHtml).slideDown();

                        const tableData = response.data.manualEntryDailyCollectorUploadListDtos || [];
                        try {
                            if ($.fn.DataTable.isDataTable('#previewDetailsTable')) {
                                $('#previewDetailsTable').DataTable().clear().destroy();
                                $('#previewDetailsTable').empty();
                            }
                            $('#previewDetailsTable').DataTable({
                                destroy: true,
                                data: tableData,
                                columns: [
                                    { data: "memberReference", title: "Member Ref." },
                                    { data: "memberName", title: "Member Name" },
                                    { data: "dailyCollectorName", title: "Collector Name" },
                                    { data: "memberBranchName", title: "Member Branch" },
                                    {
                                        data: "amount", title: "Amount", className: "text-end",
                                        render: $.fn.dataTable.render.number(',', '.', 2)
                                    }
                                ],
                                responsive: true,
                                pageLength: 5,
                                lengthMenu: [5, 10, 25, 50]
                            });
                        } catch (ex) { console.error('DataTable init error', ex); }

                        form.reset();
                        $form.find('.select2').val(null).trigger('change');

                        const acctDate = document.querySelector('.accounting-date');
                        if (acctDate) {
                            const today = new Date().toISOString().split('T')[0];
                            acctDate.setAttribute('max', today);
                            if (!acctDate.value) acctDate.value = today;
                        }
                    } else {
                        appalert(response.message || "Upload Failed.", 4, 1);
                    }
                },
                error: function (err) {
                    appalert(err.statusText || "An error occurred.", 4, 1);
                },
                complete: function () {
                    $submitButton.prop('disabled', false).html('<i class="mdi mdi-cloud-upload-outline me-1"></i> Upload');
                }
            });
        }

        function onCancel() {
            appalert('Upload cancelled. You can review your selections.', 3, 1);
        }
    }



    function buildInitialPreviewHtml(data) {
        const formatCurrency = (num) => (num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const uploadedBy = data.UploadedBy ?? data.uploadedBy ?? '';
        const branchName = data.BranchName ?? data.branchName ?? '';
        const totalMembers = data.TotalMembers ?? data.totalMember ?? 0;
        const totalAmount = data.TotalAmount ?? data.totalAmount ?? 0;
        const fileId = data.FileUploadId || data.fileUploadId || '';
        const currentFileUploadId = data.FileUploadId || data.fileUploadId || '';

        return `
 <fieldset class="fieldset-custom">
     <div class="row g-2">
     <h5 class="legend-custom text-info">File Preview: ${data.FileUploadId || data.fileUploadId || 'N/A'}</h5>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-warning h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Uploaded By</p><h6 class="ms-1 mb-0">${uploadedBy}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-info h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Branch</p><h6 class="ms-1 mb-0">${branchName}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-success h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Members</p><h6 class="ms-1 mb-0">${totalMembers}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-danger h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Amount</p><h6 class="ms-1 mb-0">${formatCurrency(totalAmount)}</h6></div></div></div>
     </div>
     <div class="table-responsive mt-3">
         <table id="previewDetailsTable" class="table table-striped table-bordered" style="width:100%"></table>
     </div>
     <div class="d-flex justify-content-end mt-3">
         <button type="button" id="resetFirstPreviewBtn" class="btn btn-outline-secondary me-2">Reset upload Preview</button> <!-- NEW -->
         <button type="button" onclick="deleteUploadedFile('${currentFileUploadId}')" class="btn btn-danger me-2">Delete</button>
         <button type="button" onclick="extractFile('${fileId}')" class="btn btn-primary">Extract File</button>
     </div>
 </fieldset>`;
    }

    // -------------------------------
    // Build extracted preview HTML (unchanged)
    // -------------------------------
    function buildExtractedPreviewHtml(data) {
        const formatCurrency = (num) => (num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const fileUploadId = data.FileUploadId ?? data.fileUploadId ?? data.FileUploadId ?? 'N/A';
        const collectorName = data.CollectorName ?? data.collectorName ?? '';
        const branchName = data.BranchName ?? data.branchName ?? '';
        const totalMember = data.TotalMember ?? data.totalMember ?? 0;
        const totalAmount = data.TotalAmount ?? data.totalAmount ?? 0;

        return `
 <fieldset class="fieldset-custom">
     <div class="row g-2">
     <h4 class="legend-custom text-info">Extraction Successful: ${fileUploadId}</h4>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-warning h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Collector Name</p><h6 class="ms-1 mb-0">${collectorName}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-info h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Branch</p><h6 class="ms-1 mb-0">${branchName}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-success h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Members</p><h6 class="ms-1 mb-0">${totalMember}</h6></div></div></div>
         <div class="col-6 col-md-3"><div class="card card-border-shadow-danger h-100 p-2"><div class="card-body p-2 text-center"><p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Amount</p><h6 class="ms-1 mb-0">${formatCurrency(totalAmount)}</h6></div></div></div>
     </div>
     <div class="table-responsive mt-3">
         <table id="extractedDetailsTable" class="table table-striped table-bordered" style="width:100%"></table>
     </div>
     <div class="d-flex justify-content-end mt-3">
         <button type="button" id="resetExtractedPreviewBtn" class="btn btn-outline-secondary me-2">Reset Extracted Preview</button> <!-- NEW -->
         <button type="button" id="closeExtractedPreviewBtn" class="btn btn-secondary">Close</button>
     </div>
 </fieldset>`;
    }
        // Builds the modal body with a dashboard section and listing section
        window.buildExtractionModalHtml = function (data) {
            data = data || {};
            var fileUploadId = data.FileUploadId ?? data.fileUploadId ?? 'N/A';
            var collectorName = data.CollectorName ?? data.collectorName ?? '';
            var branchName = data.BranchName ?? data.branchName ?? '';
            var totalMember = data.TotalMember ?? data.totalMember ?? data.totalMembers ?? 0;
            var totalAmount = data.TotalAmount ?? data.totalAmount ?? 0;
            var tableDomId = 'extractedDetailsTable_' + (fileUploadId ? fileUploadId.toString().replace(/[^a-zA-Z0-9_]/g, '_') : Date.now());

            return [
                '<div class="mb-2 d-flex flex-wrap gap-2">',
                '  <span class="badge bg-light text-dark border"><i class="mdi mdi-identifier me-1"></i>' + fileUploadId + '</span>',
                '  <span class="badge bg-light text-dark border"><i class="mdi mdi-office-building me-1"></i>' + branchName + '</span>',
                '  <span class="badge bg-light text-dark border"><i class="mdi mdi-account-outline me-1"></i>' + collectorName + '</span>',
                '</div>',

                '<div class="row g-3 mb-3">',
                '  <div class="col-12 col-md-6 col-xl-3">',
                '    <div class="card shadow-sm h-100"><div class="card-body d-flex align-items-center">',
