    function resetAllPreviews() {
        resetFirstPreview();
        resetExtractedPreview();
        currentFileUploadId = null;
    }


    //  reset functionalities

    function resetInitialPreview() {
        $('#uploadResultContainer').slideUp(function () {
            $(this).html('');
        });

        if ($.fn.DataTable.isDataTable('#previewDetailsTable')) {
            try { $('#previewDetailsTable').DataTable().destroy(); } catch (e) { console.warn(e); }
            $('#previewDetailsTable').empty();
        }
        if ($.fn.DataTable.isDataTable('#extractedDetailsTable')) {
            try { $('#extractedDetailsTable').DataTable().destroy(); } catch (e) { console.warn(e); }
            $('#extractedDetailsTable').empty();
        }
        currentFileUploadId = null;
    }

    // -------------------------------
    // Robust delete handler (updated)
    // -------------------------------
    // This function will:
    // 1) confirm via alertify (or fallback to native confirm)
    // 2) send an AJAX GET to /ManualDailyCollection/Delete
    // 3) send both KEY and fileUploadId in query to maximize compatibility with your controller signatures
    // 4) call resetInitialPreview() on success
    function confirmDialog(title, message, onOk, onCancel) {
        // Try common alertify signatures; fallback to window.confirm if necessary
        if (window.alertify && typeof alertify.confirm === 'function') {
            try {
                // Newer signature: alertify.confirm(title, message, onok, oncancel)
                alertify.confirm(title, message, function () {
                    if (typeof onOk === 'function') onOk();
                }, function () {
                    if (typeof onCancel === 'function') onCancel();
                }).set('labels', { ok: 'Yes', cancel: 'No' });
                return;
            } catch (ex) {
                try {
                    // Older signature: alertify.confirm(message, onok, oncancel)
                    alertify.confirm(message, function () {
                        if (typeof onOk === 'function') onOk();
                    }, function () {
                        if (typeof onCancel === 'function') onCancel();
                    });
                    return;
                } catch (ex2) {
                    console.warn('alertify confirm failed, falling back to window.confirm', ex, ex2);
                }
            }
        }

        // fallback
        if (window.confirm(message)) {
            if (typeof onOk === 'function') onOk();
        } else {
            if (typeof onCancel === 'function') onCancel();
        }
    }

    function deleteUploadedFile(currentFileUploadId) {
        // prevent default when called as a click event
        //f (e && e.preventDefault) e.preventDefault();


        if (!currentFileUploadId) {
            appalert('No uploaded file to delete.', 3, 1);
            return;
        }

        // Use the robust confirmDialog wrapper
        confirmDialog('Confirm Delete', 'This will permanently delete the uploaded file. Continue?',
            function onOk() {
                console.log('deleteUploadedFile: user confirmed. Sending AJAX request.');

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/ManualDailyCollection/Delete',
                    type: 'GET', // keep GET to match current controller; change to POST if you update controller
                    data: {
                        // supply both parameter names so controller binding works with either signature
                       // KEY: currentFileUploadId,
                        fileUploadId: currentFileUploadId
                    },
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    success: function (response) {
                        console.log('deleteUploadedFile: ajax success response', response);
                        if (response && response.success) {
                            appalert(response.message || 'File deleted.', 1, 1);
                            // reset the preview(s) the same way as original behaviour
                            resetInitialPreview();
                        } else {
                            appalert((response && response.message) || 'Could not delete file.', 4, 1);
                        }
                    },
                    error: function (xhr, status, err) {
                        console.error('deleteUploadedFile: ajax error', status, err, xhr);
                        appalert('Error deleting file.', 4, 1);
                    }
                });
            },
            function onCancel() {
                console.log('deleteUploadedFile: user cancelled.');
                appalert('Delete cancelled.', 3, 1);
            }
        );
    }

  // AJAX loader
  function loadCollectorsAjax(branchId) {
    var $collector = $('#CollectorxCollectorId');

    // Reset + show loading text
    $collector.empty()
              .append(new Option('Please wait… loading collectors...', '', true, true))
              .prop('disabled', true);

    if (hasSelect2()) $collector.trigger('change');

    if (!branchId) {
      $collector.empty()
                .append(new Option('Select a branch to load collectors', ''));
      if (hasSelect2()) $collector.trigger('change');
      return;
    }

    // If your action allows GET returning JSON:
    $.ajax({
      url: '@Url.Action("GetCollectorsByBranch","ManualDailyCollection")',
      type: 'GET',
      dataType: 'json',
      data: { branchId: branchId },
      xhrFields: { withCredentials: true }
      // ---- If your action requires POST + anti-forgery, use this instead:
      // type: 'POST',
      // headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
      // contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
    })
    .done(function (data, textStatus, xhr) {
      // Ensure we got JSON (not an HTML error/login page)
      var ct = (xhr.getResponseHeader('Content-Type') || '').toLowerCase();
      if (ct.indexOf('application/json') === -1) {
        console.error('Expected JSON but received:', ct);
        showError();
        return;
      }

      // Normalize to {text, value}
      function mapItem(x) {
        if (x == null) return null;
        if (typeof x === 'string') return { text: x, value: x };
        return {
          text: (x.text ?? x.Text ?? x.name ?? x.Name ?? x.label ?? x.Label ?? '').toString(),
          value: (x.value ?? x.Value ?? x.id ?? x.Id ?? x.key ?? x.Key ?? '').toString()
        };
      }

      $collector.empty().append(new Option('--- Select Daily Collector ---', ''));

      var items = Array.isArray(data) ? data.map(mapItem).filter(Boolean) : [];
      items.forEach(function (it) { $collector.append(new Option(it.text, it.value)); });

      $collector.prop('disabled', false);
      if (hasSelect2()) $collector.trigger('change');
    })
    .fail(function (xhr) {
      console.error('Collectors AJAX error:', xhr.status, xhr.statusText);
      showError();
    });

    function showError() {
      $collector.empty()
                .append(new Option('Failed to load collectors. Try again.', ''))
                .prop('disabled', true); // keep disabled on error
      if (hasSelect2()) $collector.trigger('change');
    }
  }

