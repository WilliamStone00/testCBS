<!-- TABLE (match columns to your FileUploadResponse) -->
<div class="card p-3 shadow mb-4">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th data-col="collectorName">Collector Name</th>
                    <th data-col="branchName">Branch Name</th>
                    <th data-col="fileName">File Name</th>
                    <th data-col="uploadedOn">Uploaded On</th>
                    <th data-col="salaryProcessingStatus">Status</th>
                    <th data-col="id">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
