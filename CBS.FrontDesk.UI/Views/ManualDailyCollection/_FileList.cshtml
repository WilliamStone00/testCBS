<fieldset class="fieldset-custom">
    <legend class="legend-custom">Previously Uploaded Files</legend>
    <div class="table-responsive">
        <table class="table table-hover" id="filesDataTable" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>File ID</th>
                    <th>Collector ID</th>
                    <th>Branch</th>
                    <th>Uploaded By</th>
                    <th>Total Members</th>
                    <th>Total Amount</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable will populate this via an AJAX call -->
            </tbody>
        </table>
    </div>
</fieldset>

<script>
    // This script block runs ONLY when this partial view is loaded.
    $(document).ready(function () {

        // Helper function to generate the action links
        function generateActionButtons(fileId) {
            const detailsLink = `<a href="#" onclick="AddORUpdateGen('${fileId}', 'mainWorkspace', '_FileDetails', 'details', 'ManualDailyCollection')" class="ms-2">Details</a>`;
            const deleteLink = `<a href="#" onclick="DeleteRecordDataTable('ManualDailyCollection', '${fileId}', 'filesDataTable', '_FileList', 0, 'mainWorkspace', null, 'list')" class="ms-2 text-danger">Delete</a>`;
            return detailsLink + deleteLink;
        }

        // Initialize the DataTable in server-side processing mode
        $('#filesDataTable').DataTable({
            "processing": true,
            "serverSide": true,
            "searching": false, // Using custom filters
            "ajax": {
                "url": "@Url.Action("LoadFilesForDataTable", "ManualDailyCollection")",
                "type": "POST",
                "data": function (d) {
                    // This function constructs the 'query' object for the controller
                    const order = d.order[0] || {};
                    const query = {
                        Options: {
                            draw: d.draw,
                            start: d.start,
                            pageSize: d.length,
                            sortColumn: d.columns[order.column]?.name,
                            sortDirection: order.dir
                        }
                        // You can add your custom filter values here if needed
                    };
                    return { query: query };
                }
            },
            "columns": [
                // The 'data' property MUST match the C# property names from FileUploadSummary
                { "data": "FileUploadId", "name": "FileUploadId" },
                { "data": "CollectorId", "name": "CollectorId" },
                { "data": "BranchName", "name": "BranchName" },
                { "data": "UploadedBy", "name": "UploadedBy" },
                { "data": "TotalMembers", "name": "TotalMembers" },
                {
                    "data": "TotalAmount",
                    "name": "TotalAmount",
                    "render": $.fn.dataTable.render.number(',', '.', 2, '') // Format as currency
                },
                {
                    "data": "FileUploadId",
                    "orderable": false,
                    "render": function(data, type, row) {
                        // Use our helper to build the action links
                        return generateActionButtons(data);
                    }
                }
            ]
        });
    });
</script>