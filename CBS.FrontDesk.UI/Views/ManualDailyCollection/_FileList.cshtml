<div class="card shadow p-3">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-hover" style="width:100%; table-layout: fixed;">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">File Name</th>
                    <th style="width: 20%;">Branch</th>
                    <th style="width: 15%;">Uploaded By</th>
                    <th style="width: 15%;">Uploaded On</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 15%;">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#myDataTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '@Url.Action("LoadFileslist", "ManualDailyCollection")',
                type: 'POST'
            },
            columns: [
                { data: "fileName" },
                { data: "branchName" },
                { data: "uploadedBy" },
                { data: "uploadedOn" },
                { data: "status" },
                { data: "actions", orderable: false, searchable: false }
            ]
        });
    });

    function handleExtractFile(fileId) {
        $.ajax({
            url: '/ManualDailyCollection/extract', // <-- your extract endpoint
            type: 'POST',
            data: { id: fileId },
            success: function (response) {
                appAlert('success', 'File extracted successfully!');
                // maybe reload DataTable here
            },
            error: function () {
                appAlert('danger', 'Failed to extract file.');
            }
        });
    }

    function handleViewDetails(fileId) {
        $.ajax({
            url: '/Manual/Details', // <-- your details endpoint
            type: 'GET',
            data: { id: fileId },
            success: function (partialView) {
                $('#rightPanel').html(partialView); // render details in your panel
            },
            error: function () {
                appAlert('danger', 'Failed to load details.');
            }
        });
    }


    function handleApprove(btn) {
        let id = $(btn).data("fileid");
        alert("Approve file " + id);
    }
    function handleReview(btn) {
        let id = $(btn).data("fileid");
        alert("Review file " + id);
    }
    function handleReject(btn) {
        let id = $(btn).data("fileid");
        alert("Reject file " + id);
    }
</script>
