@model List<CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse>
@using Resources

<fieldset class="fieldset-custom">
    <div class="card-header bg-white border-0">
        <legend class="legend-custom">@ChequeManagements.PreviouslyUploadedFiles</legend>
    </div>
    <div class="table-responsive">
        <table class="table table-hover" id="filesDataTable">
            <thead class="table-light">
                <tr>
                    <th>@ChequeManagements.FileD</th>
                    <th>@ChequeManagements.CollectorId</th>
                    <th>@ChequeManagements.BranchId</th>
                    <th>@ChequeManagements.UPBY</th>
                    <th>@ChequeManagements.TM</th>
                    <th>@ChequeManagements.TA</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td>@file.FileUploadId</td>
                        <td>@file.CollectorId</td>
                        <td>@file.BranchId</td>
                        <td>@file.UploadedBy</td>
                        <td>@file.TotalMembers</td>
                        <td>@string.Format("{0:N2}", file.TotalAmount)</td>
                        <td class="text-center">
                            <a href="#"
                               onclick="AddORUpdateGen('@file.FileUploadId', 'mainWorkspace', '_FileDetails', 'details', 'ManualDailyCollection')"
                               class="text-success" style="margin-right:6px;">Details</a>
                            <a href="#"
                               onclick="DeleteRecordDataTable('ManualDailyCollection', '@file.FileUploadId', 'filesDataTable', '_FileList', 0, 'mainWorkspace', null, 'list')"
                               class="text-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>

<style>
    /* Force compact Actions column */
    #filesDataTable th:last-child,
    #filesDataTable td:last-child {
        width: 100px !important;
        white-space: nowrap;
        text-align: center;
    }

    /* Optional: make whole table more compact */
    #filesDataTable td,
    #filesDataTable th {
        padding: 6px 10px;
        font-size: 0.9rem;
    }
</style>

<script>
    $(document).ready(function () {
        $('#filesDataTable').DataTable({
            autoWidth: false,
            scrollX: false,
            columnDefs: [
                { width: "100px", targets: -1 }, // last column (Actions)
                { className: "text-center", targets: -1 }
            ]
        });
    });
</script>
