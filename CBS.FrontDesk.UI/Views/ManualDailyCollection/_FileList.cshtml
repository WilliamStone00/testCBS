<fieldset class="fieldset-custom">
    <legend class="legend-custom">Previously Uploaded Files</legend>
    <div class="table-responsive">
        <table class="table table-hover" id="filesDataTable" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>File ID</th>
                    <th>FileName</th>
                    <th>Branch</th>
                    <th>Uploaded By</th>
                    <th>Uploaded On</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable will populate this via an AJAX call -->
            </tbody>
        </table>
    </div>
</fieldset>

<script>
$(document).ready(function () {

    // Helper function to generate the action links
    function generateActionButtons(fileId) {
        const detailsLink = `<a href="#" onclick="AddORUpdateGen('${fileId}', 'mainWorkspace', '_FileDetails', 'details', 'ManualDailyCollection')" class="ms-2">Details</a>`;
        const deleteLink = `<a href="#" onclick="DeleteRecordDataTable('ManualDailyCollection', '${fileId}', 'filesDataTable', '_FileList', 0, 'mainWorkspace', null, 'list')" class="ms-2 text-danger">Delete</a>`;
        return detailsLink + deleteLink;
    }

    // Initialize the DataTable
    var table = $('#filesDataTable').DataTable({
        processing: false,
        serverSide: true,
        searching: true,
        ajax: {
            url: '@Url.Action("LoadFilesForDataTable", "ManualDailyCollection")',
            type: "POST",
            data: function (d) {
                const order = d.order[0] || {};
                const query = {
                    Options: {
                        draw: d.draw,
                        start: d.start,
                        pageSize: d.length,
                        sortColumn: d.columns[order.column]?.name,
                        sortDirection: order.dir
                    }
                };
                return { query: query };
            }
        },
        columns: [
            { data: "FileUploadId", name: "FileUploadId" },
            { data: "fileName", name: "FileName" },
            { data: "BranchName", name: "BranchName" },
            { data: "UploadedBy", name: "UploadedBy" },
            { data: "uploadedOn", name: "UploadedOn" },
            {
                data: "salaryProcessingStatus",
                name: "Status",
                render: $.fn.dataTable.render.number(',', '.', 2, '')
            },
            {
                data: "FileUploadId",
                orderable: false,
                render: function(data) {
                    return generateActionButtons(data);
                }
            }
        ],
        columnDefs: [
            { width: "30%", targets: 0 },
            { width: "20%", targets: 1 },
            { width: "15%", targets: 2 },
            { width: "15%", targets: 3 },
            { width: "10%", targets: 4, className: "text-center" },
            { width: "10%", targets: 5, className: "text-center" },
            { width: "10%", targets: 6, className: "text-center" } // Actions
        ],
        drawCallback: function() {
            // Force DataTable to respect column widths after each draw
            table.columns.adjust();
        }
    });

});
</script>
