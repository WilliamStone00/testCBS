@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse
@using Resources

@{
    // MVC5-friendly helpers
    Func<string, string> SafeStr = s => string.IsNullOrWhiteSpace(s) ? "N/A" : s;
    Func<decimal, string> Money = v => string.Format("{0:N2}", v);

    var amount = (Model != null ? Model.TotalAmount : 0m);
    var members = (Model != null ? Model.TotalMembers : 0);
    var branches = 1; // keep as 1 (or wire to a model field later)

    var avgPerMember = members > 0 ? amount / members : 0m;

    // Build a predictable, unique-ish table id per file (avoids re-init issues in modal)
    var tableId = "myDataTable" + (Model != null && !string.IsNullOrWhiteSpace(Model.FileUploadId) ? Model.FileUploadId : "X");
}
<style>
    .table-fit {
        table-layout: fixed
    }

        .table-fit th, .table-fit td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 1px
        }

    @@media (max-width:576px) {
        .table-fit th, .table-fit td {
            white-space: normal
        }
    }
</style>

@if (Model == null)
{
    <div class="alert alert-danger d-flex align-items-start" role="alert">
        <i class="mdi mdi-alert-circle-outline me-2 mt-1"></i>
        <div>
            <strong>@GlobalShared.unable_to_load_dashboard.</strong><br />
            @GlobalManualDailyCollection.no_data_returned_for_this_file_upload.
        </div>
    </div>
}
else
{
    <!-- Header + chips -->
    <div class="d-flex align-items-center justify-content-between flex-wrap mb-3">
        <h4 class="mb-2">@GlobalManualDailyCollection.daily_collection_file_upload_dashboard</h4>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-light text-dark border">
                <i class="mdi mdi-identifier me-1"></i>@SafeStr(Model.FileUploadId)
            </span>
            <span class="badge bg-light text-dark border">
                <i class="mdi mdi-office-building me-1"></i>@SafeStr(Model.BranchName)
            </span>
            <span class="badge bg-light text-dark border">
                <i class="mdi mdi-account-outline me-1"></i>@SafeStr(Model.UploadedBy)
            </span>
        </div>
    </div>

    <!-- KPI row -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar me-3">
                        <span class="avatar-initial rounded bg-label-success">
                            <i class="mdi mdi-cash mdi-20px"></i>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">@GlobalShared.Total_amount</div>
                        <div class="fw-bold fs-4">@Money(amount)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar me-3">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="mdi mdi-account-group mdi-20px"></i>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">@GlobalShared.Total_members</div>
                        <div class="fw-bold fs-4">@members</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar me-3">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="mdi mdi-source-branch mdi-20px"></i>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">@GlobalShared.branches_involved</div>
                        <div class="fw-bold fs-4">@branches</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar me-3">
                        <span class="avatar-initial rounded bg-label-warning">
                            <i class="mdi mdi-calculator-variant mdi-20px"></i>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">@GlobalManualDailyCollection.avgmember</div>
                        <div class="fw-bold fs-4">@Money(avgPerMember)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Insight row -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="mdi mdi-trending-up me-2 text-success"></i>
                        <strong>Collection Efficiency</strong>
                    </div>
                    <div class="text-muted small">
                        @GlobalShared.Members: <strong>@members</strong> &nbsp;•&nbsp; @GlobalShared.branches: <strong>@branches</strong>
                    </div>
                    <div class="mt-2">
                        <span class="badge bg-light text-dark border">@GlobalManualDailyCollection.avgmember: <strong>@Money(avgPerMember)</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="mdi mdi-wallet-outline me-2 text-primary"></i>
                        <strong>@GlobalShared.amount_overview</strong>
                    </div>
                    <div class="display-6 fw-bold">@Money(amount)</div>
                    <div class="text-muted small">@GlobalManualDailyCollection.total_collected_amount_for_this_upload.</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="mdi mdi-information-outline me-2 text-secondary"></i>
                        <strong>@GlobalShared.context</strong>
                    </div>
                    <div class="text-muted small">
                        @GlobalShared.File_ID: <strong>@SafeStr(Model.FileUploadId)</strong><br />
                        @GlobalShared.Uploaded_By: <strong>@SafeStr(Model.UploadedBy)</strong><br />
                        @GlobalShared.Branch: <strong>@SafeStr(Model.BranchName)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
            <h6 class="mb-0"><i class="mdi mdi-format-list-bulleted me-1"></i> @GlobalShared.Details (@members)</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="@tableId" class="table table-hover align-middle w-100 table-fit js-dt">
                    <colgroup>
                        <col style="width:18%">
                        <col style="width:34%">
                        <col style="width:32%">
                        <col style="width:16%">
                    </colgroup>
                    <thead class="table-light">
                        <tr>
                            <th>@GlobalShared.Member_ref</th>
                            <th>@GlobalShared.Name</th>
                            <th>@GlobalShared.member_branch</th>
                            <th class="text-end">@GlobalShared.Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.manualEntryDailyCollectorUploadListDtos != null && Model.manualEntryDailyCollectorUploadListDtos.Count > 0)
                        {
                            foreach (var d in Model.manualEntryDailyCollectorUploadListDtos)
                            {
                                <tr>
                                    <td title="@SafeStr(d.memberReference)">@SafeStr(d.memberReference)</td>
                                    <td title="@SafeStr(d.memberName)">@SafeStr(d.memberName)</td>
                                    <td title="@SafeStr(d.memberBranchName)">@SafeStr(d.memberBranchName)</td>
                                    <td class="text-end" title="@Money(d.amount)">@Money(d.amount)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="mdi mdi-file-search-outline me-1"></i> @GlobalShared.no_file_details_found.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">@GlobalShared.Total</th>
                            <th class="text-end">@Money(amount)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <style>
        /* Keep table within card */
        .table-fit {
            table-layout: fixed;
        }

            .table-fit th, .table-fit td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 1px;
            }

        @@media (max-width: 576px) {
            .table-fit th, .table-fit td {
                white-space: normal;
            }
        }
    </style>


    @* Optional guard/warning *@
    if (members == 0)
    {
        <div class="alert alert-warning mt-3" role="alert">
            <i class="mdi mdi-alert-outline me-1"></i>
            @GlobalManualDailyCollection.no_members_were_included_in_this_upload_please_verify_your_source_file.
        </div>
    }



}
<script>
  (function () {
    var sel = '#@tableId';

    function initDT() {
      if (!(window.jQuery && $.fn && $.fn.DataTable)) return;

      if ($.fn.DataTable.isDataTable(sel)) {
        var api = $(sel).DataTable();
        api.columns.adjust();
        if (api.responsive) api.responsive.recalc();
        return;
      }

      $(sel).DataTable({
        autoWidth: false,
        responsive: true,
        paging: true,
        searching: true,
        order: [[0, 'asc']],
        lengthMenu: [10, 25, 50, 100],
        pageLength: 10,
        columnDefs: [
          { targets: 0, width: '18%' },
          { targets: 1, width: '34%' },
          { targets: 2, width: '32%' },
          { targets: 3, width: '16%', className: 'text-end' }
        ]
      });
    }

    // If inside a Bootstrap modal, init AFTER it's visible
    var $modal = $(sel).closest('.modal');
    if ($modal.length) {
      if ($modal.is(':visible')) {
        initDT();
      } else {
        $modal.one('shown.bs.modal', initDT);
      }

      // Optional cleanup to prevent duplicate init if the same partial is reloaded
      $modal.one('hidden.bs.modal', function () {
        if (window.jQuery && $.fn && $.fn.DataTable && $.fn.DataTable.isDataTable(sel)) {
          $(sel).DataTable().destroy();
        }
      });
    } else {
      // Not in a modal: init immediately
      initDT();
    }
  })();
</script>
