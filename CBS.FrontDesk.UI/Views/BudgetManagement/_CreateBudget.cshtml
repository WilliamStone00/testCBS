@model CBS.FrontDesk.Data.Entity.BudgetConfiguration
<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                Budget Creation
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">

                        @using (Html.BeginForm("AddOrUpdate", "BudgetManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <input type="hidden" name="ServiceOption" value="budget" id="ServiceOption" />
                            <div class="row mt-2 gy-4">

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">

                                        @Html.DropDownListFor(m => m.Budget.BudgetPeriodId, new SelectList(ViewBag.BudgetPeriods == null ? "" : ViewBag.BudgetPeriods, "Text", "Value"), "---Select BudgetPeriods ---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(model => model.Budget.BudgetPeriodId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">

                                        @Html.DropDownListFor(m => m.Budget.UnitId, new SelectList(ViewBag.OrganizationalUnits == null ? "" : ViewBag.OrganizationalUnits, "Text", "Value"), "---Select Organizational Unit---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(model => model.Budget.UnitId, "", new { @class = "text-danger" })
                                    </div>
                                </div>


                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.Budget.Description, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(model => model.Budget.Description, "", new { @class = "text-danger" })

                                        <label for="Description"> Description</label>
                                    </div>
                                </div>

                            </div>

                            if (Model.Budget.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />

                            }
                            else
                            { <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Budget.Id)
                                <input type="hidden" name="Action" value="update" id="Action" />
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>



</div>


