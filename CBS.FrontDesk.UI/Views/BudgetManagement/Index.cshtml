
@{
    ViewBag.Title = "Accounting Configurations";

}

<div class="card mb-12">
    <div class="card-header">
        <h5 class="card-title mb-0">BUDGET CONFIGURATIONS</h5>
    </div>
    <div class="card-body">
        <div class="row">

            <!-- Navigation -->
            <div class="col-12 col-md-3 mx-auto card-separator">
                <div class="d-flex justify-content-between flex-column mb-3 mb-md-0 pe-md-3">
                    <ul class="nav nav-align-left nav-pills flex-column">
                        
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#restock">
                                <i class="mdi mdi-book-open-page-variant me-2"></i>
                                <span class="align-middle">Budget</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#shippingBudgetCategory">
                                <i class="mdi mdi-book-edit me-2"></i>
                                <span class="align-middle">BudgetCategory</span>
                            </button>
                        </li>

               




                    </ul>
                </div>
            </div>
            <!-- Navigation Body -->

            <div class="col-12 col-md-9 pt-4 pt-md-0">
                <div class="tab-content p-0 pe-xl-0 ps-md-3">

                    <div class="tab-pane fade show active" id="restock" role="tabpanel">
                        <div class="row justify-content-end">
                            <div class="demo-inline-spacing text-end">

                                <a type="button" onclick="LoadDataTable('BudgetManagement','myDataTable_Budget','InitializeData',0,'_BudgetData','desc','list','datalistingview_Budget','budget')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_Budget','_CreateBudget','new','BudgetManagement','budget')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">

                                    <span class="tf-icons mdi mdi-bank-plus mdi-18px"></span>
                                </a>

                            </div>
                        </div>
                        <br />

                        <div class="datalistingview_Budget" id="datalistingview_Budget">
                            @Html.Partial("_BudgetData")
                        </div>
                    </div>
                    <div class="tab-pane fade" id="shippingBudgetCategory" role="tabpanel">
                        <div class="row justify-content-end">
                            <div class="demo-inline-spacing text-end">
                                <a type="button" onclick="LoadDataTable('BudgetManagement','myDataTable_BudgetCategory','InitializeData',0,'_BudgetCategoryData','desc','list','datalistingview_BudgetCategory','budgetCategory')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_BudgetCategory','_CreateBudgetCategory','new','BudgetManagement','budgetCategory')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                    <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                </a>
                            </div>
                        </div>
                        <br />
                        <div id="datalistingview_BudgetCategory">
                            @Html.Partial("_BudgetCategoryData")
                        </div>
                    </div>
                    <div class="tab-pane fade" id="shippingBudgetCategory" role="tabpanel">
                        <div class="row justify-content-end">
                            <div class="demo-inline-spacing text-end">
                                <a type="button" onclick="LoadDataTable('BudgetManagement','myDataTable_BudgetItem','InitializeData',0,'_BudgetItemData','desc','list','datalistingview_BudgetItem','budgetItem')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_BudgetItem','_CreateBudgetItem','new','BudgetManagement','budgetItem')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                    <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                </a>
                            </div>
                        </div>
                        <br />
                        <div id="datalistingview_BudgetCategory">
                            @Html.Partial("_BudgetItemData")
                        </div>
                    </div>
                


                </div>

            </div>

        </div>
    </div>








    @section Scripts {@Scripts.Render("~/bundles/jqueryval")
     
    <script src="~/Scripts/Js/Budgetmanagement/Budget.js"></script>
    }

