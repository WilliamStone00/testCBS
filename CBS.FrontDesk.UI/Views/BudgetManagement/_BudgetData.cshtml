@model CBS.FrontDesk.Data.Entity.BudgetConfiguration
    @using Resources
@{
    ViewBag.Title = @GlobalBudgetManagement.BudgetData;
}


 
    <table class="table table-hover" id="myDataTable_BudgetData">
        <thead class="table-light">
            <tr>
                <th>@GlobalBudgetManagement.BudgetCode</th>
                <th>@GlobalBudgetManagement.OrganizationUnit</th>
                <th>@GlobalBudgetManagement.Budget</th>
 
                <th>@GlobalBudgetManagement.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Budgets)
            {
                <tr>
                    <td style="width:25%">@d.BudgetPeriodId</td>
                    <td style="width:20%">@d.UnitId</td>
                    <td style="width:25%">@d.TotalBudgetAmount.ToString("N")</td>
                  
                    <td style="width:30%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Budget','_CreateBudget','update','BudgetManagement','budget')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.BudgetPeriodId @GlobalShared.ToEdit">@GlobalShared.Edit</a>|

                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Details @d.BudgetPeriodId" onclick="ViewDataDetails('BudgetManagement','@d.Id','myDataTable_BudgetData','_BudgetData',0,'datalistingview_Budget','budget')">@GlobalShared.Details</a>|

                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.BudgetPeriodId" onclick="DeleteDataConfiguration('BudgetManagement','@d.Id','myDataTable_BudgetData','_BudgetData',0,'datalistingview_Budget','budget')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
 
 


