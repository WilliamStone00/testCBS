<div class="detail-card p-3">
    <h5 class="text-primary mb-3">
        Global Configuration Details
    </h5>

    <ul class="list-group">
        <li class="list-group-item">
            <strong>Minimum Cheque Leave:</strong> @Model.MinimumOfChequeLeave
        </li>
        <li class="list-group-item">
            <strong>Maximum Cheque Leave:</strong> @Model.MaximumOfChequeLeave
        </li>
        <li class="list-group-item">
            <strong>Cheque Validity (Days):</strong> @Model.ChequeValidityDays
        </li>
        <li class="list-group-item">
            <strong>Centralised:</strong>
            @(Model.IsCentralised ? "Yes" : "No")
        </li>
    </ul>
</div>



