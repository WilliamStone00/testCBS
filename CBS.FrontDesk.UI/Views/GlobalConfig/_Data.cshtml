@model List<CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.GlobalConfig.GlobalConfig>
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalShared.Global_Configurations</legend>

    @if (!Model.Any())
    {
        <p class="text-center">@GlobalConfig.No_configuration_available</p>
    }
    else
    {
        <table class="table table-bordered table-hover" id="myDataTable">
            <thead>
                <tr>
                    <th>@GlobalConfig.Min_Leave</th>
                    <th>@GlobalConfig.Max_Leave</th>
                    <th>@GlobalShared.validity (@GlobalShared.Days)</th>
                    <th>@GlobalShared.Status</th>
                    <th class="text-center">@GlobalShared.Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MinimumOfChequeLeave</td>
                        <td>@item.MaximumOfChequeLeave</td>
                        <td>@item.ChequeValidityDays</td>
                        <td class="text-center">
                            @if (item.IsCentralised)
                            {
                                <span class="badge bg-success">@GlobalShared.Centralised</span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">@GlobalShared.Decentralised</span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="AddORUpdateGen('@item.Id','datalistingview','_Create','update','GlobalConfig')">
                                @GlobalShared.Edit
                            </button>

                            <button class="btn btn-sm btn-outline-info"
                                    onclick="showGlobalConfigDetails('@item.Id')">
                                @GlobalShared.Details
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</fieldset>
