@model List<CBS.FrontDesk.Data.Entity.LoanConf.Fee>

@if (Model.Count == 0)
{
    <div class="text-center my-3">
        <p>No loan fee type is created</p>
    </div>
}
else
{
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:80%">@d.Name</td>
                    <td style="width:5%">@d.FeeBase</td>
                    <td style="width:15%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','Fee')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a> |
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('Fee','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

}



