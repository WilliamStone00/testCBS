@{
    ViewBag.Title = "Members - F2 & F5 Series";
}

<div class="container mt-4">
    <header class="text-center mb-4">
        <h1 class="text-primary fw-bold">F2 & F5 Members Reporting</h1>
        <p class="text-muted">
            The F2 & F5 Series provides users with detailed insights into member situations regarding loan and account balances, movements, and account statements.
            This report offers network-wide access, specifically limited to the <strong>@Session["BankName"]</strong>, and is strictly read-only.
            A list of members is first displayed, where users can click on a member to view the F2 Series for detailed information.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </header>

    <!-- Tips Section -->
    <div class="card mb-4">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> IMPORTANT TIPS</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseTips" class="collapse">
            <div class="card-body">
                <ul>
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Use the search bar to quickly find members by their account number, name, or phone number.</li>
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure you select the correct member to view their F2 Series for accurate insights.</li>
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Click on "View List" to load all members before performing specific searches.</li>
                    <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Only authorized personnel are allowed to access this data as it is strictly read-only.</li>
                    <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Ensure all interactions comply with the organization's data privacy policies.</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="accordionMembers" class="accordion accordion-popout">
        <div class="accordion-item active">
            <h2 class="accordion-header" id="membersHeading">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#membersCollapse" aria-expanded="true" aria-controls="membersCollapse">
                    <i class="mdi mdi-file-document me-2"></i> Members Overview - F2 & F5 Series
                </button>
            </h2>
            <div id="membersCollapse" class="accordion-collapse collapse show" aria-labelledby="membersHeading" data-bs-parent="#accordionMembers">
                <div class="accordion-body">

                    <div class="card mb-4 shadow">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0"><i class="mdi mdi-account-circle-outline"></i> Members Overview</h5>
                            <button type="button" onclick="LoadMembers('All')" class="btn btn-label-primary">
                                <i class="mdi mdi-view-list me-2"></i>View List
                            </button>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="card mb-4 shadow">
                        <div class="card-body">
                            <label for="manualSearchInput" class="form-label fw-bold">Search Members</label>
                            <div class="input-group">
                                <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="Search by account number, member's name, or phone number..." />
                                <button class="btn btn-primary" onclick="manualSearch()">Search</button>
                            </div>
                            <small class="text-muted mt-2 d-block">Example: Enter "12345", "John Doe", or "0701234567" to find a member.</small>
                        </div>
                    </div>

                    <!-- Members Data Listing -->
                    <div id="datalistingview">
                        @Html.Partial("_MembersData")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/MembersFSeries/Members.js"></script>
}
