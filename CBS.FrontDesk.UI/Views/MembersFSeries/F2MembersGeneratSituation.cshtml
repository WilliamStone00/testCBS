function validateLoanRepayment() {
    console.log('Validating Loan Repayment form...');

    var isValid = true;
    var byLoanChecked = $('#repaymentByLoan').is(':checked');
    var byRepaymentChecked = $('#repaymentByRepayment').is(':checked');

    console.log('Validation - By Loan checked:', byLoanChecked);
    console.log('Validation - By Repayment checked:', byRepaymentChecked);

    // Clear existing validation
    $('#loanRepaymentLoan, #loanRepaymentDateFrom, #loanRepaymentDateTo').removeClass('is-invalid');

    // Validate date fields (always required)
    if (!$('#loanRepaymentDateFrom').val()) {
        $('#loanRepaymentDateFrom').addClass('is-invalid');
        isValid = false;
        console.log('Date From is missing');
    }

    if (!$('#loanRepaymentDateTo').val()) {
        $('#loanRepaymentDateTo').addClass('is-invalid');
        isValid = false;
        console.log('Date To is missing');
    }

    // Validate loan selection only if By Specific Loan is checked
    if (byLoanChecked) {
        var loanValue = $('#loanRepaymentLoan').val();
        console.log('Loan value:', loanValue);

        if (!loanValue || loanValue === '') {
            $('#loanRepaymentLoan').addClass('is-invalid');
            isValid = false;
            console.log('Loan selection is required but missing');

            // Show the section if it's hidden (defensive)
            if ($('#loanSelectionSection').hasClass('d-none')) {
                console.log('WARNING: Loan section hidden but By Loan is checked! Fixing...');
                $('#loanSelectionSection').removeClass('d-none');
                $('#loanRepaymentLoan').attr('required', 'required');
            }
        }
    }

    // Additional date range validation
    var fromDate = $('#loanRepaymentDateFrom').val();
    var toDate = $('#loanRepaymentDateTo').val();

    if (fromDate && toDate) {
        var fromDateObj = new Date(fromDate);
        fromDateObj.setHours(0, 0, 0, 0);
        var toDateObj = new Date(toDate);
        toDateObj.setHours(0, 0, 0, 0);

        if (fromDateObj > toDateObj) {
            $('#loanRepaymentDateFrom').addClass('is-invalid');
            $('#loanRepaymentDateTo').addClass('is-invalid');
            isValid = false;
            console.log('Date range invalid: From date after To date');
        }

        // Check for future dates
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        if (fromDateObj > today) {
            $('#loanRepaymentDateFrom').addClass('is-invalid');
            isValid = false;
            console.log('From date cannot be in the future');
        }

        if (toDateObj > today) {
            $('#loanRepaymentDateTo').addClass('is-invalid');
            isValid = false;
            console.log('To date cannot be in the future');
        }
    }

    console.log('Loan Repayment validation result:', isValid ? 'VALID' : 'INVALID');
    return isValid;
}

