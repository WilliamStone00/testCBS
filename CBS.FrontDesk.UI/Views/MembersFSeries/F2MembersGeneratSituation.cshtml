        function updateSelectedAccountsList() {
            var selectedValues = $('#accountSituationIds').val() || [];
            var selectedOptions = $('#accountSituationIds option:selected');
            var container = $('#selectedAccountsList');

            if (!container.length) {
                $('#accountSituationIds').after('<div id="selectedAccountsList" class="mt-2"></div>');
                container = $('#selectedAccountsList');
            }

            if (selectedValues.length === 0) {
                container.html('<div class="text-muted small">No accounts selected yet</div>');
                $('#SelectedAccountIds').val('');
                return;
            }

            var html = '';
            selectedOptions.each(function() {
                var value = $(this).val();
                var text = $(this).text();
                html += '<div class="selected-account-item mb-2">' +
                    '<span>' + text + '</span>' +
                    '<span class="remove-account" data-value="' + value + '" title="Remove account">' +
                    ' <i class="mdi mdi-close-circle"></i>' +
                    '</span>' +
                    '</div>';
            });

            container.html(html);
            $('#SelectedAccountIds').val(JSON.stringify(selectedValues));

            $('.remove-account').off('click').on('click', function() {
                var valueToRemove = $(this).data('value');
                var currentValues = $('#accountSituationIds').val() || [];
                var newValues = currentValues.filter(function(val) {
                    return val !== valueToRemove;
                });

                $('#accountSituationIds').val(newValues).trigger('change');
                updateSelectedAccountsList();
            });
        }

