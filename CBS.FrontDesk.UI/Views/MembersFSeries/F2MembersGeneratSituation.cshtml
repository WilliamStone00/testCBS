        function setDefaultDates() {
            var today = new Date();
            var toDate = today.toISOString().split('T')[0];

            var fromDate = new Date();
            fromDate.setDate(today.getDate() - 30);
            var fromDateStr = fromDate.toISOString().split('T')[0];

            $('input[type="date"]').each(function() {
                var $this = $(this);
                if ($this.attr('id')) {
                    if ($this.attr('id').includes('DateFrom') || $this.attr('id').includes('DateTo')) {
                        var isFrom = $this.attr('id').includes('DateFrom');
                        var dateValue = isFrom ? fromDateStr : toDate;

                        if (!$this.attr('id').includes('interestVadPenalty')) {
                            $this.val(dateValue);
                        }
                    }
                }
            });
        }

