        // ============================================================
        // REPORT GENERATION FUNCTIONS
        // ============================================================

        function generateReportAjax(form) {
            console.log("=== STARTING REPORT GENERATION ===");

            var $submitBtn = $(form).find('button[type="submit"]');
            var originalBtnText = $submitBtn.html();

            $submitBtn.prop('disabled', true);
            $submitBtn.html('<i class="mdi mdi-loading mdi-spin me-2"></i> Processing...');

            $('#loadingOverlay').removeClass('d-none');

            if (!validateForm()) {
                if (typeof appalert === 'function') {
                    appalert('Please fill all required fields', 2, 1);
                }
                $submitBtn.prop('disabled', false).html(originalBtnText);
                $('#loadingOverlay').addClass('d-none');
                return false;
            }

            var formData = buildFormData();

            alertify.confirm(
                "Confirmation",
                "Are you sure you want to generate this report?",
                function () {
                    $.ajax({
                        type: 'POST',
                        url: '/MembersFSeriesReport/GenerateReport',
                        data: formData,
                        contentType: false,
                        processData: false,

                        success: function (response) {
                            if (response.success && response.redirectUrl) {
                                window.open(response.redirectUrl, '_blank');
                                if (typeof appalert === 'function') {
                                    appalert("✅ Viewer launched in a new tab.", 1, 1);
                                }
                            } else {
                                if (typeof appalert === 'function') {
                                    appalert(response.message || "❌ Failed to launch report viewer.", 3, 1);
                                }
                            }
                        },

                        error: function (xhr) {
                            if (typeof appalert === 'function') {
                                appalert("❌ Server error: " + (xhr.responseText || "Unexpected error."), 3, 1);
                            }
                        },

                        complete: function () {
                            $submitBtn.prop('disabled', false).html(originalBtnText);
                            $('#loadingOverlay').addClass('d-none');
                        }
                    });
                },
                function () {
                    if (typeof appalert === 'function') {
                        appalert('Report generation cancelled', 3, 1);
                    }
                    $submitBtn.prop('disabled', false).html(originalBtnText);
                    $('#loadingOverlay').addClass('d-none');
                }
            );

            return false;
        }

        function buildFormData() {
            var reportType = $('#ReportType').val();

            if (!reportType || reportType === '') {
                reportType = $('input[name="ReportTypeRadio"]:checked').val();
                $('#ReportType').val(reportType);
            }

            if (reportType === 'LoanRepayment') {
                return buildLoanRepaymentFormData();
            }

            if (reportType === 'LoanSituation') {
                return buildLoanSituationFormData();
            }

            var formData = new FormData();

            formData.append('ReportType', reportType || '');
            formData.append('CustomerId', $('#CustomerId').val() || '');
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val() || '');

            switch (reportType) {
                case 'MemberSituation':
                    var accountIds = $('#memberAccountIds').val() || [];
                    accountIds.forEach(function(id) {
                        formData.append('AccountIds', id);
                    });
                    formData.append('LoanStatus', $('#memberLoanStatus').val() || '');
                    formData.append('DateTo', $('#memberDateTo').val() || '');
                    break;

                case 'AccountSituation':
                    var accountIds = $('#accountSituationIds').val() || [];
                    accountIds.forEach(function(id) {
                        formData.append('AccountIds', id);
                    });
                    formData.append('DateTo', $('#accountSituationDateTo').val() || '');
                    break;

                case 'AccountStatement':
                    formData.append('AccountTypeId', $('#accountStatementAccount').val() || '');
                    formData.append('DateFrom', $('#accountDateFrom').val() || '');
                    formData.append('DateTo', $('#accountDateTo').val() || '');
                    break;

                case 'InterestVadPenalty':
                    var selectedType = $('input[name="interestVadPenaltyType"]:checked').val() || '';
                    formData.append('InterestVadPenaltyType', selectedType);
                    formData.append('DateFrom', $('#interestVadPenaltyDateFrom').val() || '');
                    formData.append('DateTo', $('#interestVadPenaltyDateTo').val() || '');
                    break;

                case 'LoanSituation':
                    // This case is handled above by buildLoanSituationFormData()
                    // But we'll keep it here as a fallback
                    formData.append('LoanStatus', $('#LoanHistoryStatus').val() || 'all');
                    formData.append('DateFrom', $('#loanSituationDateFrom').val() || '');
                    formData.append('DateTo', $('#loanSituationDateTo').val() || '');
                    break;
            }

            return formData;
        }

