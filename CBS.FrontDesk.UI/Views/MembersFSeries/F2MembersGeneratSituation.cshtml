@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk

@{
    ViewBag.Title = "F2-F5 Series - General Situation";
}

<div class="container mt-4">
    <header class="text-center mb-4">
        <h1 class="text-primary fw-bold">F2-F5 Members General Situation</h1>
        <p class="text-muted">
            This page offers an overview of member situations across the network (<strong>@Session["BankName"]</strong>),
            including insights into loans, account balances, movements, and account statements. This is strictly read-only access.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </header>

    <div id="accordionPopoutIcon" class="accordion accordion-popout">
        <div class="accordion-item active">
            <h2 class="accordion-header" id="accordionPopoutIconThree">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-file-document me-2"></i>
                    Members General Situation (F2-F5 Series)
                </button>
            </h2>
            <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                <div class="accordion-body">
                    <!-- Instructions Section -->
                    <div class="alert alert-info mb-4">
                        <p class="mb-0">
                            <i class="mdi mdi-information-outline me-2"></i>
                            <strong>How to Use This Page:</strong>
                        </p>
                        <ul class="mt-2">
                            <li>Click on the respective tabs below to view member profile details, accounts, and transactions.</li>
                            <li>Each tab provides detailed and specific insights into the selected member's data.</li>
                            <li>All actions on this page are read-only, and data is limited to the network under <strong>@Session["BankName"]</strong>.</li>
                        </ul>
                    </div>

                    <!-- Members Overview -->
                    <div class="card mb-4 shadow">
                        <div class="card-body">
                            @Html.Partial("_Tabs")
                        </div>
                    </div>

                    <!-- Members Data Listing -->
                    <div id="datalistingview">
                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="card mb-3 border-2">
                                    <div id="datalistingview_inner">
                                        @Html.Partial("_CustomerCard")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Print Statements Modal -->
                    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="searchModalLabel">Print statements from all @Model.Customer.name accounts</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.PrintDate.DateFrom, new { @class = "form-control date-picker", @id = "DateFrom" })
                                                @Html.ValidationMessageFor(m => m.PrintDate.DateFrom, "", new { @class = "text-danger" })
                                                <label for="DateFrom">Start date</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.PrintDate.DateTo, new { @class = "form-control date-picker", @id = "DateTo" })
                                                @Html.ValidationMessageFor(m => m.PrintDate.DateTo, "", new { @class = "text-danger" })
                                                <label for="DateTo">End date</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mt-3">
                                            <button class="btn btn-primary" onclick="ExportIndividaulReport('@Model.CustomerId','all_by_dates_customer_account_transaction')">Print</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/MembersFSeries/FSeries.js"></script>
}
