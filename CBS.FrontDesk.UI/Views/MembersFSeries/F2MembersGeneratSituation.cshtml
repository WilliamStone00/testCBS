function updateSelectedAccountsList() {
    var selectedValues = $('#accountSituationIds').val() || [];
    var selectedOptions = $('#accountSituationIds option:selected');
    var container = $('#selectedAccountsList');

    if (!container.length) {
        $('#accountSituationIds').after('<div id="selectedAccountsList" class="mt-2"></div>');
        container = $('#selectedAccountsList');
    }

    if (selectedValues.length === 0) {
        container.html('<div class="text-muted small">No accounts selected yet</div>');
        $('#SelectedAccountIds').val('');
        return;
    }

    var html = '';
    selectedOptions.each(function() {
        var value = $(this).val();
        var text = $(this).text();
        html += '<div class="selected-account-item mb-2">' +
            '<span>' + text + '</span>' +
            '<span class="remove-account" data-value="' + value + '" title="Remove account">' +
            ' <i class="mdi mdi-close-circle"></i>' +
            '</span>' +
            '</div>';
    });

    container.html(html);
    $('#SelectedAccountIds').val(JSON.stringify(selectedValues));

    $('.remove-account').off('click').on('click', function() {
        var valueToRemove = $(this).data('value');
        var currentValues = $('#accountSituationIds').val() || [];
        var newValues = currentValues.filter(function(val) {
            return val !== valueToRemove;
        });

        $('#accountSituationIds').val(newValues).trigger('change');
        updateSelectedAccountsList();
    });
}

function resetForm() {
    // Reset form
    $('#reportForm')[0].reset();

    // Reset Select2 if exists
    if ($.fn.select2) {
        $('.select2').val(null).trigger('change');
    }

    // Reset dates
    setDefaultDates();

    // Re-initialize form fields
    initializeFormFields();

    // Reset ReportType hidden field
    $('#ReportType').val('MemberSituation');

    // Reset radio buttons
    $('input[name="ReportTypeRadio"]').prop('checked', false);
    $('#memberSituation').prop('checked', true);

    // Call switchReport to reset UI
    switchReport('MemberSituation');

    // Clear validation
    $('.form-control').removeClass('is-invalid');

    // Clear selected accounts list
    $('#selectedAccountsList').html('<div class="text-muted small">No accounts selected yet</div>');
    $('#SelectedAccountIds').val('');

    // Reset loan repayment radio to default
    $('#repaymentByLoan').prop('checked', true).trigger('change');

    // Reset Interest/VAD/Penalty radio in the form to default
    $('#interestReport').prop('checked', true);
    $('#interestVadPenaltyHelp').html('<strong>Interest Report Selected:</strong> Generate interest calculation report for the selected date range');

    // Hide validation messages
    $('#dateValidationMessage').hide();

    appalert('Form has been reset', 3, 1);
}

