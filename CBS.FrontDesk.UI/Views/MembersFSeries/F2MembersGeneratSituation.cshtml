function generateReportAjax(form) {
    console.log("=== STARTING REPORT GENERATION ===");

    // Get submit button
    var $submitBtn = $(form).find('button[type="submit"]');
    var originalBtnText = $submitBtn.html();

    // Disable button and show loading
    $submitBtn.prop('disabled', true);
    $submitBtn.html('<i class="mdi mdi-loading mdi-spin me-2"></i> Processing...');

    // Show loading overlay
    $('#loadingOverlay').removeClass('d-none');

    // DEBUG
    console.log('DEBUG - ReportType value before validation:', $('#ReportType').val());
    console.log('DEBUG - Radio button checked:', $('input[name="ReportTypeRadio"]:checked').val());

    // Validate form
    if (!validateForm()) {
        appalert('Please fill all required fields', 2, 1);
        $submitBtn.prop('disabled', false).html(originalBtnText);
        $('#loadingOverlay').addClass('d-none');
        return false;
    }

    // Build form data
    var formData = buildFormData();
    console.log("Form data to send:", formData);

    // Confirmation dialog
    alertify.confirm(
        "Confirmation",
        "Are you sure you want to generate this report?",
        function () {

            $.ajax({
                type: 'POST',
                url: '/MembersFSeriesReport/GenerateReport',
                data: formData,
                contentType: false,
                processData: false,

                success: function (response) {
                    if (response.success && response.redirectUrl) {
                        window.open(response.redirectUrl, '_blank');
                        appalert("✅ Viewer launched in a new tab.", 1, 1);
                    } else {
                        appalert(response.message || "❌ Failed to launch report viewer.", 3, 1);
                    }
                },

                error: function (xhr) {
                    appalert(
                        "❌ Server error: " + (xhr.responseText || "Unexpected error."),
                        3,
                        1
                    );
                },

                complete: function () {
                    // Restore UI state
                    $submitBtn.prop('disabled', false).html(originalBtnText);
                    $('#loadingOverlay').addClass('d-none');
                }
            });
        },
        function () {
            // Cancel
            appalert('Report generation cancelled', 3, 1);
            $submitBtn.prop('disabled', false).html(originalBtnText);
            $('#loadingOverlay').addClass('d-none');
        }
    );

    return false;
}

function buildFormData() {
    var reportType = $('#ReportType').val();
    console.log('Building form data for report type:', reportType);

    // CRITICAL: If ReportType is empty, try to get it from the radio button
    if (!reportType || reportType === '') {
        reportType = $('input[name="ReportTypeRadio"]:checked').val();
        console.log('ReportType was empty, got from radio:', reportType);
        $('#ReportType').val(reportType); // Update hidden field
    }

    // SPECIAL HANDLING FOR DIFFERENT REPORT TYPES
    if (reportType === 'LoanRepayment') {
        return buildLoanRepaymentFormData();
    }

    if (reportType === 'LoanSituation') {
        return buildLoanSituationFormData();
    }

    // Create FormData object for other report types
    var formData = new FormData();

    // Always include ReportType and CustomerId
    formData.append('ReportType', reportType || '');
    formData.append('CustomerId', $('#CustomerId').val() || '');
    formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val() || '');

    switch (reportType) {
        case 'MemberSituation':
            // Get selected account IDs
            var accountIds = $('#memberAccountIds').val() || [];
            console.log('Member Situation - Account IDs:', accountIds);

            accountIds.forEach(function(id) {
                formData.append('AccountIds', id);
            });

            formData.append('LoanStatus', $('#memberLoanStatus').val() || '');
            formData.append('DateTo', $('#memberDateTo').val() || '');
            break;

        case 'AccountSituation':
            var accountIds = $('#accountSituationIds').val() || [];
            accountIds.forEach(function(id) {
                formData.append('AccountIds', id);
            });
            formData.append('DateTo', $('#accountSituationDateTo').val() || '');
            break;

        case 'AccountStatement':
            formData.append('AccountTypeId', $('#accountStatementAccount').val() || '');
            formData.append('DateFrom', $('#accountDateFrom').val() || '');
            formData.append('DateTo', $('#accountDateTo').val() || '');
            break;

        case 'InterestVadPenalty':
            var selectedType = $('input[name="interestVadPenaltyType"]:checked').val() || '';
            formData.append('InterestVadPenaltyType', selectedType);
            formData.append('DateFrom', $('#interestVadPenaltyDateFrom').val() || '');
            formData.append('DateTo', $('#interestVadPenaltyDateTo').val() || '');
            break;
    }

    // Log all form data entries for debugging
    console.log('Form Data Entries:');
    for (var pair of formData.entries()) {
        console.log(pair[0] + ': ' + pair[1]);
    }

    return formData;
}

function prepareCrystalReport() {
    console.log('=== PREPARING CRYSTAL REPORT ===');

    // Show loading
    $('#loadingOverlay').removeClass('d-none');

    $.ajax({
        url: '@Url.Action("PrepareReport", "MembersFSeriesReport")',
        type: 'POST',
        dataType: 'json',
        success: function (response) {
            if (response.success && response.redirectUrl) {
                window.open(response.redirectUrl, '_blank');
                appalert("✅ Viewer launched in a new tab.", 1, 1);
            } else {
                appalert(response.message || "❌ Failed to launch report viewer.", 3, 1);
            }
        },
        error: function (xhr) {
            appalert("❌ Server error: " + (xhr.responseText || "Unexpected error."), 3, 1);
        },
        complete: function () {
            $('#loadingOverlay').addClass('d-none');
        }
    });
}

function validateForm() {
    var isValid = true;
    var reportType = $('#ReportType').val();

    // CRITICAL: If ReportType is empty, try to get it from radio button
    if (!reportType || reportType === '') {
        reportType = $('input[name="ReportTypeRadio"]:checked').val();
        console.log('Validation - ReportType was empty, got from radio:', reportType);
        if (reportType) {
            $('#ReportType').val(reportType);
        }
    }

    console.log('Validating form for report type:', reportType);

    // Clear all validation first
    $('.form-control').removeClass('is-invalid');

    // SPECIAL HANDLING FOR DIFFERENT REPORT TYPES
    if (reportType === 'LoanRepayment') {
        return validateLoanRepayment();
    }

    if (reportType === 'LoanSituation') {
        return validateLoanSituation();
    }

    // Validate based on report type
    switch (reportType) {
        case 'MemberSituation':
            if (!$('#memberAccountIds').val() || $('#memberAccountIds').val().length === 0) {
                $('#memberAccountIds').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#memberLoanStatus').val()) {
                $('#memberLoanStatus').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#memberDateTo').val()) {
                $('#memberDateTo').addClass('is-invalid');
                isValid = false;
            }
            break;

        case 'AccountSituation':
            if (!$('#accountSituationIds').val() || $('#accountSituationIds').val().length === 0) {
                $('#accountSituationIds').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#accountSituationDateTo').val()) {
                $('#accountSituationDateTo').addClass('is-invalid');
                isValid = false;
            }
            break;

        case 'AccountStatement':
            if (!$('#accountStatementAccount').val()) {
                $('#accountStatementAccount').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#accountDateFrom').val()) {
                $('#accountDateFrom').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#accountDateTo').val()) {
                $('#accountDateTo').addClass('is-invalid');
                isValid = false;
            }
            break;

        case 'InterestVadPenalty':
            if (!$('#interestVadPenaltyDateFrom').val()) {
                $('#interestVadPenaltyDateFrom').addClass('is-invalid');
                isValid = false;
            }
            if (!$('#interestVadPenaltyDateTo').val()) {
                $('#interestVadPenaltyDateTo').addClass('is-invalid');
                isValid = false;
            }

            var fromDate = $('#interestVadPenaltyDateFrom').val();
            var toDate = $('#interestVadPenaltyDateTo').val();

            if (fromDate && toDate) {
                var fromDateObj = new Date(fromDate);
                fromDateObj.setHours(0, 0, 0, 0);
                var toDateObj = new Date(toDate);
                toDateObj.setHours(0, 0, 0, 0);
                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (fromDateObj > today || toDateObj > today) {
                    $('#interestVadPenaltyDateFrom, #interestVadPenaltyDateTo').addClass('is-invalid');
                    isValid = false;
                }

                if (fromDateObj > toDateObj) {
                    $('#interestVadPenaltyDateFrom').addClass('is-invalid');
                    isValid = false;
                }
            }
            break;

        default:
            // If no report type is selected, it's invalid
            console.log('No report type selected!');
            isValid = false;
            appalert('Please select a report type', 2, 1);
            break;
    }

    console.log('Validation result:', isValid ? 'VALID' : 'INVALID');
    return isValid;
}

