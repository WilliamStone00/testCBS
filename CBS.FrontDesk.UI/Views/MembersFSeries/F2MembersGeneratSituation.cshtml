function setupDateValidation() {
    // Add max attribute to all date fields to prevent future dates
    $('input[type="date"]').each(function() {
        if (!$(this).attr('max')) {
            var today = new Date().toISOString().split('T')[0];
            $(this).attr('max', today);
        }
    });

    // Validate date ranges on change
    $('input[type="date"]').on('change', function() {
        validateDateRange($(this));
    });
}

function validateDateRange(dateInput) {
    var inputId = dateInput.attr('id');
    var dateValue = dateInput.val();

    if (!dateValue) return true;

    // Check if date is in the future
    var today = new Date();
    var selectedDate = new Date(dateValue);

    if (selectedDate > today) {
        dateInput.addClass('is-invalid');
        dateInput.addClass('date-validation-error');
        dateInput.next('.invalid-feedback').text('Date cannot be in the future');
        return false;
    }

    // Remove future date error if fixed
    dateInput.removeClass('date-validation-error');

    // Check date ranges for pairs
    if (inputId.includes('DateFrom')) {
        var toId = inputId.replace('DateFrom', 'DateTo');
        var toDate = $('#' + toId).val();

        if (toDate && dateValue && new Date(dateValue) > new Date(toDate)) {
            dateInput.addClass('is-invalid');
            dateInput.next('.invalid-feedback').text('From date cannot be after To date');
            return false;
        }
    }

    if (inputId.includes('DateTo')) {
        var fromId = inputId.replace('DateTo', 'DateFrom');
        var fromDate = $('#' + fromId).val();

        if (fromDate && dateValue && new Date(dateValue) < new Date(fromDate)) {
            dateInput.addClass('is-invalid');
            dateInput.next('.invalid-feedback').text('To date cannot be before From date');
            return false;
        }
    }

    // Clear validation if all good
    dateInput.removeClass('is-invalid');
    return true;
}

function setupInterestVadPenaltyDateValidation() {
    $('#interestVadPenaltyDateFrom, #interestVadPenaltyDateTo').off('change').on('change', function() {
        var fromDate = $('#interestVadPenaltyDateFrom').val();
        var toDate = $('#interestVadPenaltyDateTo').val();
        var messageDiv = $('#dateValidationMessage');
        var messageText = $('#dateValidationText');

        if (!fromDate || !toDate) return;

        var fromDateObj = new Date(fromDate);
        var toDateObj = new Date(toDate);
        var today = new Date();

        // Reset styles
        $('#interestVadPenaltyDateFrom, #interestVadPenaltyDateTo').removeClass('is-invalid');
        messageDiv.hide();

        // Check for future dates
        if (fromDateObj > today || toDateObj > today) {
            $('#interestVadPenaltyDateFrom, #interestVadPenaltyDateTo').addClass('is-invalid');
            messageText.text('Dates cannot be in the future');
            messageDiv.removeClass('alert-warning').addClass('alert-danger').show();
            return false;
        }

        // Check if from date is after to date
        if (fromDateObj > toDateObj) {
            $('#interestVadPenaltyDateFrom').addClass('is-invalid');
            messageText.text('From date cannot be after To date');
            messageDiv.removeClass('alert-danger').addClass('alert-warning').show();
            return false;
        }

        return true;
    });
}

