        function waitForElement(selector, callback, maxAttempts = 20) {
            let attempts = 0;

            function check() {
                const $element = $(selector);
                if ($element.length && $element.hasClass('select2-hidden-accessible')) {
                    console.log(`Element ${selector} is ready`);
                    callback();
                    return true;
                }

                attempts++;
                if (attempts < maxAttempts) {
                    console.log(`Waiting for ${selector} to be ready... attempt ${attempts}`);
                    setTimeout(check, 100);
                } else {
                    console.warn(`Element ${selector} not ready after ${maxAttempts} attempts`);
                    // Still try to initialize as fallback
                    callback();
                }
                return false;
            }

            check();
        }

