@model CBS.FrontDesk.Data.Entity.Accountgetid
@using Resources

@functions {
    string FormatDate(DateTime date)
    {
        return date != DateTime.MinValue ? date.ToString("dd/MM/yyyy") : string.Empty;
    }

    string FormatNullableDate(DateTime? date)
    {
        return date.HasValue && date.Value != DateTime.MinValue
            ? date.Value.ToString("dd/MM/yyyy")
            : string.Empty;
    }
}


<fieldset class="fieldset-custom">

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-bank-outline me-2"></i> Account Details
            </h1>
            <p class="card-text text-muted mb-1">
                Here are the complete details of the selected account.
            </p>
        </div>
    </div>

    <div class="row">

        <!-- LEFT COLUMN -->
        <div class="col-md-6">
            <h6 class="text-primary">
                <i class="mdi mdi-information-outline me-2"></i> Basic Information
            </h6>

            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Account ID:</td><td>@Model.Id</td></tr>
                <tr><td class="fw-bold">Account Number:</td><td>@Model.AccountNumber</td></tr>
                <tr><td class="fw-bold">Account Name:</td><td>@(Model.AccountName ?? "-")</td></tr>
                <tr><td class="fw-bold">Customer Name:</td><td>@Model.CustomerName</td></tr>
                <tr><td class="fw-bold">Account Type:</td><td>@Model.AccountType</td></tr>
                <tr><td class="fw-bold">Profile Type:</td><td>@(Model.ProfileType ?? "-")</td></tr>
                <tr><td class="fw-bold">Product ID:</td><td>@Model.ProductId</td></tr>
                <tr><td class="fw-bold">Bank ID:</td><td>@Model.BankId</td></tr>
                <tr><td class="fw-bold">Branch ID:</td><td>@Model.BranchId</td></tr>
                <tr><td class="fw-bold">Branch Code:</td><td>@(Model.BranchCode ?? "-")</td></tr>
                <tr><td class="fw-bold">Teller ID:</td><td>@(Model.TellerId ?? "-")</td></tr>
                <tr><td class="fw-bold">Is Teller Account:</td><td>@(Model.IsTellerAccount ? "Yes" : "No")</td></tr>
            </table>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-md-6">
            <h6 class="text-primary">
                <i class="mdi mdi-currency-usd me-2"></i> Financial Summary
            </h6>

            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Current Balance:</td><td>@Model.Balance.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Previous Balance:</td><td>@Model.PreviousBalance.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Opening Balance:</td><td>@Model.OpeningBalance.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Blocked Amount:</td><td>@Model.BlockedAmount.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Interest Generated:</td><td>@Model.InterestGenerated.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Last Interest Posted:</td><td>@Model.LastInterestPosted.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Last Operation:</td><td>@(Model.LastOperation ?? "-")</td></tr>
                <tr><td class="fw-bold">Last Operation Amount:</td><td>@Model.LastOperationAmount.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Available Balance:</td><td>@Model.AvailableBalance.ToString("N2")</td></tr>
            </table>
        </div>

    </div>

    <!-- STATUS SECTION -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary">
                <i class="mdi mdi-shield-check-outline me-2"></i> Account Status & Controls
            </h6>

            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Status:</td><td>@Model.Status</td></tr>
                <tr><td class="fw-bold">Is Active:</td><td>@(Model.IsActive ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Is Blocked:</td><td>@(Model.IsBlocked ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Blocked Reason:</td><td>@(Model.ReasonOfBlocked ?? "-")</td></tr>
                <tr><td class="fw-bold">Cash In Blocked:</td><td>@(Model.IsCashInBlocked ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Withdrawal Blocked:</td><td>@(Model.IsWithdrawalBlocked ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Transfer Blocked:</td><td>@(Model.IsTransferBlocked ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Openning Of Day Status:</td><td>@Model.OpenningOfDayStatus</td></tr>
            </table>
        </div>
    </div>

    <!-- OVERDRAFT SECTION -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary">
                <i class="mdi mdi-chart-line me-2"></i> Overdraft Configuration
            </h6>

            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">OD Enabled:</td><td>@(Model.IsOverdraftEnabled ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Overdraft Limit:</td><td>@Model.OverdraftLimit.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Overdraft Used:</td><td>@Model.OverdraftUsed.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Available OD:</td><td>@Model.AvailableOverdraft.ToString("N2")</td></tr>
                <tr><td class="fw-bold">Interest Rate:</td><td>@Model.InterestRate %</td></tr>
                <tr><td class="fw-bold">Penalty Rate:</td><td>@Model.PenaltyRate %</td></tr>
                <tr><td class="fw-bold">Auto Recover:</td><td>@(Model.AutoRecoverOnDeposit ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Activation Date:</td><td>@FormatNullableDate(Model.OverdraftActivationDate)</td></tr>
                <tr><td class="fw-bold">Expiry Date:</td><td>@FormatNullableDate(Model.OverdraftExpiryDate)</td></tr>
                <tr><td class="fw-bold">Activated By:</td><td>@(Model.ActivatedBy ?? "-")</td></tr>
                <tr><td class="fw-bold">Salary OD Account:</td><td>@(Model.IsSalaryOverdraftAccount ? "Yes" : "No")</td></tr>
            </table>
        </div>
    </div>

    <!-- TIMELINE -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary">
                <i class="mdi mdi-timeline-clock-outline me-2"></i> Timeline & Audit
            </h6>

            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Date Blocked:</td><td>@FormatNullableDate(Model.DateBlocked)</td></tr>
                <tr><td class="fw-bold">Date Released:</td><td>@FormatNullableDate(Model.DateReleased)</td></tr>
                <tr><td class="fw-bold">Last Interest Calculated:</td><td>@FormatNullableDate(Model.LastInterestCalculatedDate)</td></tr>
                <tr><td class="fw-bold">Date Of Last Operation:</td><td>@FormatNullableDate(Model.DateOfLastOperation)</td></tr>
                <tr><td class="fw-bold">Closed On:</td><td>@FormatNullableDate(Model.ClosedOn)</td></tr>
                <tr><td class="fw-bold">Last Closure Reason:</td><td>@(Model.LastClosureReason ?? "-")</td></tr>
            </table>
        </div>
    </div>

</fieldset>

