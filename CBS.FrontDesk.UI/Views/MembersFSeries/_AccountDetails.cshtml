@model CBS.FrontDesk.Data.Entity.Accountgetid
@using Resources
@using CBS.FrontDesk.UI.Helper;

<fieldset class="fieldset-custom">
    @Html.HiddenFor(m => m.BankName)
    @Html.HiddenFor(m => m.BranchPrintingdetails)
    @Html.HiddenFor(m => m.PrintedBy)
    @Html.HiddenFor(m => m.printedOn)

    <!-- Header Card with Gradient -->
    <div class="card bg-gradient-light mb-4 shadow-lg border-0">
        <div class="card-body text-white py-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="display-6 fw-bold mb-2">
                        <i class="mdi mdi-bank-outline me-2"></i> @GlobalShared.Account_details
                    </h1>
                    <p class="text-black">
                        <i class="mdi mdi-information-outline me-1"></i> @GlobalMembersFSeries.complete_information_for_account @Model.AccountNumber
                    </p>
                </div>
                <div class="text-end">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") p-3 fs-6 shadow-sm">
                        <i class="mdi @(Model.IsActive ? "mdi-check-circle" : "mdi-close-circle") me-1"></i>
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Basic Information Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-information-outline me-2"></i>@GlobalShared.Basic_Information
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalShared.Account_ID</th>
                            <td class="fw-semibold">@Model.Id</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Account_Number</th>
                            <td><span class="badge bg-light bg-opacity-10 text-primary p-2">@Model.AccountNumber</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Account_Name</th>
                            <td>@(Model.AccountName ?? "-")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Customer_Name</th>
                            <td class="fw-bold">@Model.CustomerName</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Account_type</th>
                            <td><span class="badge bg-info">@Model.AccountType</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.profile_type</th>
                            <td>@(Model.ProfileType ?? "-")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Product_ID</th>
                            <td>@Model.ProductId</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Branch</th>
                            <td>@Model.BranchName <span class="text-muted">(@Model.BranchCode)</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.teller_id</th>
                            <td>@(Model.TellerId ?? "-")</td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalShared.teller_account</th>
                            <td>
                                <span class="badge @(Model.IsTellerAccount ? "bg-warning" : "bg-secondary")">
                                    @(Model.IsTellerAccount ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Financial Summary Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-currency-usd me-2"></i>@GlobalShared.Financial_Summary
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalShared.Opening_Balance</th>
                            <td class="fw-semibold">@Model.OpeningBalance.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Current_balance</th>
                            <td class="fw-bold text-primary h5 mb-0">@Model.Balance.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Previous_Balance</th>
                            <td>@Model.PreviousBalance.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.available_balance</th>
                            <td class="fw-bold text-success">@Model.AvailableBalance.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Blocked_Amount</th>
                            <td class="text-danger">@Model.BlockedAmount.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Interest_Generated</th>
                            <td>@Model.InterestGenerated.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.last_interest_posted</th>
                            <td>@Model.LastInterestPosted.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Last_operation</th>
                            <td>@(Model.LastOperation ?? "-")</td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalShared.Last_operation_amount</th>
                            <td class="fw-semibold">@Model.LastOperationAmount.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Status & Controls Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-shield-check-outline me-2"></i>@GlobalMembersFSeries.account_status_controls
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalShared.Status</th>
                            <td><span class="badge bg-info">@Model.Status</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.account_state</th>
                            <td>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") me-2">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                                <span class="badge @(Model.IsBlocked ? "bg-danger" : "bg-success")">
                                    @(Model.IsBlocked ? "Blocked" : "Unblocked")
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.blocked_reason</th>
                            <td>@(Model.ReasonOfBlocked ?? "-")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.cash_in_blocked</th>
                            <td>
                                <span class="badge @(Model.IsCashInBlocked ? "bg-danger" : "bg-success")">
                                    @(Model.IsCashInBlocked ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.withdrawal_blocked</th>
                            <td>
                                <span class="badge @(Model.IsWithdrawalBlocked ? "bg-danger" : "bg-success")">
                                    @(Model.IsWithdrawalBlocked ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.transfer_blocked</th>
                            <td>
                                <span class="badge @(Model.IsTransferBlocked ? "bg-danger" : "bg-success")">
                                    @(Model.IsTransferBlocked ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.opening_day_status</th>
                            <td><span class="badge bg-secondary">@Model.OpenningOfDayStatus</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Overdraft Configuration Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-chart-line me-2"></i>@GlobalMembersFSeries.overdraft_configuration
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalMembersFSeries.od_enabled</th>
                            <td>
                                <span class="badge @(Model.IsOverdraftEnabled ? "bg-success" : "bg-secondary")">
                                    @(Model.IsOverdraftEnabled ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.overdraft_limit</th>
                            <td class="fw-semibold">@Model.OverdraftLimit.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.overdraft_used</th>
                            <td class="text-warning">@Model.OverdraftUsed.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.available_od</th>
                            <td class="text-success">@Model.AvailableOverdraft.ToString("N2")</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Interest_Rate</th>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@Model.InterestRate %</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.penalty_rate</th>
                            <td><span class="badge bg-danger bg-opacity-10 text-danger">@Model.PenaltyRate %</span></td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.auto_recover</th>
                            <td>
                                <span class="badge @(Model.AutoRecoverOnDeposit ? "bg-success" : "bg-secondary")">
                                    @(Model.AutoRecoverOnDeposit ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.activation_date</th>
                            <td>@DateHelper.FormatNullableDate(Model.OverdraftActivationDate)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Expiry_Date</th>
                            <td>@DateHelper.FormatNullableDate(Model.OverdraftExpiryDate)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Activated_by</th>
                            <td>@(Model.ActivatedBy ?? "-")</td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.salary_od_account</th>
                            <td>
                                <span class="badge @(Model.IsSalaryOverdraftAccount ? "bg-success" : "bg-secondary")">
                                    @(Model.IsSalaryOverdraftAccount ? "Yes" : "No")
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Account Opening Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-calendar-plus me-2"></i>@GlobalShared.account_opening
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalShared.opening_date</th>
                            <td><span class="fw-semibold">@DateHelper.FormatNullableDate(Model.CreatedDate)</span></td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalShared.account_manager</th>
                            <td>@Model.AccountManager</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Timeline & Audit Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-primary">
                <i class="mdi mdi-timeline-clock-outline me-2"></i>@GlobalShared.Timeline & @GlobalShared.Audit
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light" style="width: 200px;">@GlobalShared.Date_Blocked</th>
                            <td>@DateHelper.FormatNullableDate(Model.DateBlocked)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Date_Released</th>
                            <td>@DateHelper.FormatNullableDate(Model.DateReleased)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.last_interest_calculated</th>
                            <td>@DateHelper.FormatNullableDate(Model.LastInterestCalculatedDate)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.Date_of_Last_Operation</th>
                            <td>@DateHelper.FormatNullableDate(Model.DateOfLastOperation)</td>
                        </tr>
                        <tr class="border-bottom">
                            <th class="ps-4 bg-light">@GlobalShared.closed_on</th>
                            <td>@DateHelper.FormatNullableDate(Model.ClosedOn)</td>
                        </tr>
                        <tr>
                            <th class="ps-4 bg-light">@GlobalMembersFSeries.last_closure_reason</th>
                            <td>@(Model.LastClosureReason ?? "-")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</fieldset>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .table th {
        font-weight: 600;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header {
        background-color: #f8f9fa;
    }

    .badge {
        padding: 0.5em 0.8em;
        font-weight: 500;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,.02);
    }

    .ps-4 {
        padding-left: 1.5rem !important;
    }
</style>