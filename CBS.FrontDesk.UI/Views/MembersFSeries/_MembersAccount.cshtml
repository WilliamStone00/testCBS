@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    decimal totalBalance = Model.Accounts.Sum(x => x.balance);
    decimal totalBlocked = Model.Accounts.Sum(x => x.blockedAmount);
    decimal totalActual = totalBalance - totalBlocked;
}

<div class="container-fluid px-3 py-3">
    <!-- Member Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
            <div class="text-black fw-bold">
                <i class="mdi mdi-account-circle-outline me-2 text-secondary"></i>
                @GlobalShared.Members_name: <span class="text-dark">@Model.Customer.name</span>
            </div>
            <div class="text-black fw-bold fs-6">
                <i class="mdi mdi-cash-multiple text-warning me-1"></i> @GlobalShared.Total_Account_Balance:
                <span class="text-black">@totalBalance.ToString("#,##0.0")</span>
            </div>
        </div>
    </div>
     
      
        <!-- Accounts Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-bold text-black">
            <i class="mdi mdi-bank me-1 text-black"></i> @GlobalShared.Accounts
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover" id="myDataTableT">
                    <thead class="table-light">
                        <tr>
                            <th>S.N</th>
                            <th>@GlobalShared.Account_Number</th>
                            <th>@GlobalShared.Ordinary_accounts</th>
                            <th>@GlobalShared.Balance</th>
                            <th>@GlobalShared.Blocked</th>
                            <th>@GlobalShared.Actual_balance</th>
                            <th style="display:none">@GlobalShared.Balance</th>
                            <th style="display:none">@GlobalShared.Blocked</th>
                            <th>@GlobalShared.Account_Status</th>
                            <th>@GlobalShared.Action</th>
                            @*<th>Print</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var d in Model.Accounts.OrderBy(t => t.accountType))
                        {
                           
                            decimal ActualBalance = d.balance - d.blockedAmount;
                            <tr>
                                <td style="width:5%" class="text-center">@index</td>
                                <td style="width: 15%">@d.accountNumber</td>
                                <td style="width: 37%">@d.product.Name</td>
                                <td style="width: 10%" class="text-end">@d.balance.ToString("N2")</td>
                                <td style="width: 10%" class="text-end">@d.blockedAmount.ToString("N2")</td>
                                <td style="width: 10%" class="text-end">@ActualBalance.ToString("N2")</td>

                                <!-- Hidden fields for calculations or scripts -->
                                <td style="display:none">
                                    <input type="number" class="form-control amount-input shadow-input-boxes" readonly value="@d.balance">
                                </td>
                                <td style="display:none">
                                    <input type="number" class="form-control blocked-input shadow-input-boxes" readonly value="@d.blockedAmount">
                                </td>

                                <!-- In your table cell, use inline logic -->
                                <td style="width: 8%" class="text-center">
                                    @{
                                        var status = d.status ?? "";
                                        var badgeClass = "";
                                        var icon = "";

                                        if (!string.IsNullOrWhiteSpace(status))
                                        {
                                            switch (status.Trim().ToLowerInvariant())
                                            {
                                                case "active":
                                                    badgeClass = "bg-primary text-white";
                                                    icon = "✔️";
                                                    break;

                                                case "inactive":
                                                    badgeClass = "bg-light text-dark border";
                                                    icon = "⏸️";
                                                    break;

                                                case "closed":
                                                    badgeClass = "bg-secondary text-white";
                                                    icon = "🔒";
                                                    break;

                                                case "blocked":
                                                    badgeClass = "bg-danger text-white";
                                                    icon = "⛔";
                                                    break;

                                                case "suspended":
                                                    badgeClass = "bg-warning text-dark";
                                                    icon = "⚠️";
                                                    break;

                                                case "dormant":
                                                    badgeClass = "bg-info text-dark";
                                                    icon = "💤";
                                                    break;

                                                case "inprogress":
                                                    badgeClass = "bg-secondary text-white";
                                                    icon = "🔄";
                                                    break;

                                                case "pending":
                                                    badgeClass = "bg-purple text-white";
                                                    icon = "⏳";
                                                    break;

                                                default:
                                                    badgeClass = "bg-light text-muted border";
                                                    icon = "❓";
                                                    break;
                                            }
                                        }

                                    }
                                    <span class="badge rounded-pill @badgeClass">
                                        @icon @d.status
                                    </span>
                                </td>

                                <td style="width: 10%" class="text-center">
                                    <a href="#"
                                       class="btn btn-sm btn-label-primary"
                                       onclick="ShowModal(@d.id,'_AccountDetails', 'MembersFSeries', 'GetaccountById');"
                                       data-bs-toggle="tooltip"
                                       title="View details for @d.accountNumber">

                                        <i class="mdi mdi-eye-outline me-1"></i> @GlobalShared.Details
                                    </a>
                                </td>

                                @*<td style="width: 10%" class="text-center">
                                    <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space"
                                       onclick="PrintSingleObject('MembersFSeries', '@d.accountNumber','customer_account_transaction_rpt','ReportParameterLess')"
                                       data-bs-toggle="tooltip" title="Print statement for @d.accountNumber">
                                        <span class="tf-icons mdi mdi-printer mdi-18px"></span>
                                    </a>
                                </td>*@
                            </tr>

                             index++; 
                                }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold text-end">
                            <td  class="text-end"></td>
                            <td colspan="2" class="text-end">@GlobalShared.Total:</td>
                            <td class="text-black text-end">@totalBalance.ToString("N2")</td>
                            <td class="text-warning text-end">@totalBlocked.ToString("N2")</td>
                            <td class="text-info text-end">@totalActual.ToString("N2")</td>
                            <td></td>
                            @*<td class="text-center">
                                <button class="btn btn-outline-primary btn-sm" onclick="ModalShowUp()" title="Print all account statements">
                                    <i class="mdi mdi-printer"></i> PRINT ALL
                                </button>
                            </td>*@
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

</div>
<!-- Modal Container -->
<div class="modal fade" id="genericModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"></div>
    </div>
</div>

