                                </tr>
                                <tr><td class="k">Loan Term Id</td><td class="v">@Txt(loan.LoanTermId)</td></tr>
                                <tr><td class="k">Loan Target Id</td><td class="v">@Txt(loan.LoanTargetId)</td></tr>

                            </table>
                        </div>
