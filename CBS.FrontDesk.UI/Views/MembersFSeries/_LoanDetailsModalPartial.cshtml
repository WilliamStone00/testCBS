        </div>

        <div class="tab-content pt-3 loan-tab-content-scroll">
            <div class="tab-content pt-3">

                <!-- ===================== OVERVIEW ===================== -->
                <div class="tab-pane fade show active" id="t_overview">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <!-- header + quick badges -->
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-card-account-details-outline"></i> Identity & Status
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                        }
                                        @if (isRefinanced)
                                        {
                                            <span class="badge bg-primary">REFINANCED</span>
                                        }

                                        <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                        </span>

                                        <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                            @Txt(loan.LoanStatus)
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• Legacy LoanId: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                                <!-- related loan action -->
                                @if (!string.IsNullOrWhiteSpace(relatedLoanId))
                                {
                                    <div class="mt-2">
                                        <a class="btn btn-sm btn-outline-info"
                                           href="@Url.Action("LoanDetails","CashDesk", new { loanId = relatedLoanId })">
                                            <i class="mdi mdi-open-in-new me-1"></i>
                                            Open @(isRestructured ? "Restructured" : "Related") Loan
                                        </a>
                                    </div>
                                }

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Identity -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Identity</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Customer Name</td>
                                        <td class="v fw-bold">@Txt(loan.CustomerName)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Contract Code</td>
                                        <td class="v">@Txt(loan.LoanContractCode)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Id</td>
                                        <td class="v">@Txt(loan.Id)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Customer Id</td>
                                        <td class="v">@Txt(loan.CustomerId)</td>
                                    </tr>

                                    <!-- Origin / Migration -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Origin</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Origin</td>
                                        <td class="v">
                                            @if (isMigrated)
                                            {
                                                <span class="badge bg-dark">MIGRATED</span>
                                                <span class="text-muted ms-2">• @FDateNullable(loan.MigrationDate)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">NATIVE (CORE)</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Status -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Status</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Status</td>
                                        <td class="v">
                                            <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                                @Txt(loan.LoanStatus)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr><td class="k">Journey Status</td><td class="v">@Txt(loan.LoanJourneyStatus)</td></tr>
                                    <tr><td class="k">Loan Category</td><td class="v">@Txt(loan.LoanCategory)</td></tr>
                                    <tr><td class="k">Loan Type</td><td class="v">@Txt(loan.LoanType)</td></tr>
                                    <tr><td class="k">Type Category</td><td class="v">@Txt(loan.LoanTypeCategory)</td></tr>

                                    <!-- Restructure / Refinance -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Restructure / Refinance</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Status</td>
                                        <td class="v">
                                            @if (isRestructured)
                                            {
                                                <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                                if (!string.IsNullOrWhiteSpace(loan.NewLoanId))
                                                {
                                                    <span class="text-muted ms-2">• New LoanId: <b>@Txt(loan.NewLoanId)</b></span>
                                                }
                                            }
                                            else if (isRefinanced)
                                            {
                                                <span class="badge bg-primary">REFINANCED</span>
                                                if (string.IsNullOrWhiteSpace(relatedLoanId))
                                                {
                                                    <span class="text-muted ms-2">• Related loan not available</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Disbursement -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Disbursement</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Is Disbursed?</td>
                                        <td class="v">
                                            <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                                @(loan.IsLoanDisbursted ? "YES" : "NO")
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                            {
                                                <span class="text-muted ms-2">• @Txt(loan.DisbursmentStatus)</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Ownership -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Ownership</td>
                                    </tr>
                                    <tr><td class="k">Loan Manager</td><td class="v">@Txt(loan.LoanManager)</td></tr>
                                    <tr><td class="k">Disbursed By</td><td class="v">@Txt(loan.LoanDisbursedBy)</td></tr>

                                    <!-- Flags -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Flags</td>
                                    </tr>
                                    <tr><td class="k">Write-Off</td><td class="v">@(loan.IsWriteOffLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Current Loan</td><td class="v">@(loan.IsCurrentLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Completed</td><td class="v">@(loan.IsCompleted ? "YES" : "NO")</td></tr>

                                    <!-- Audit -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Audit</td>
                                    </tr>
                                    <tr><td class="k">Last Event Date</td><td class="v">@FDate(loan.LastEventData)</td></tr>

                                </table>
                            </div>
                        </div>


                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-clock-outline"></i> Dates & Schedule
                                    </div>

                                    <!-- top quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                        }
                                        @if (isRefinanced)
                                        {
                                            <span class="badge bg-primary">REFINANCED</span>
                                        }

                                        <span class="badge @(stopInterest ? "bg-dark" : "bg-light text-dark border")">
                                            INT: @(stopInterest ? "STOPPED" : "RUNNING")
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• Legacy LoanId: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                                <!-- restructure link -->
                                @if (!string.IsNullOrWhiteSpace(relatedLoanId))
                                {
                                    <div class="mt-2">
                                        <a class="btn btn-sm btn-outline-info"
                                           href="@Url.Action("LoanDetails","CashDesk", new { loanId = relatedLoanId })">
                                            <i class="mdi mdi-open-in-new me-1"></i> Open Related Loan
                                        </a>
                                    </div>
                                }

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Timeline -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Timeline</td>
                                    </tr>
                                    <tr><td class="k">Loan Date</td><td class="v">@FDate(loan.LoanDate)</td></tr>
                                    <tr><td class="k">Disbursement Date</td><td class="v">@FDate(loan.DisbursementDate)</td></tr>

                                    <!-- Installments -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Installment Schedule</td>
                                    </tr>
                                    <tr><td class="k">First Installment Date</td><td class="v">@FDateShort(loan.FirstInstallmentDate)</td></tr>
                                    <tr><td class="k">Next Installment Date</td><td class="v">@FDateShort(loan.NextInstallmentDate)</td></tr>
                                    <tr><td class="k">Maturity Date</td><td class="v">@FDateShort(loan.MaturityDate)</td></tr>

                                    <!-- Processing -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Processing Dates</td>
                                    </tr>
                                    <tr><td class="k">Last Refund Date</td><td class="v">@FDate(loan.LastRefundDate)</td></tr>
                                    <tr><td class="k">Last Interest Calc Date</td><td class="v">@FDate(loan.LastInterestCalculatedDate)</td></tr>
                                    <tr><td class="k">Last Delinquency Proc</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                                    <!-- Structuring -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Structuring</td>
                                    </tr>
                                    <tr><td class="k">Structuring Date</td><td class="v">@FDate(loan.LoanStructuringDate)</td></tr>
                                    <tr><td class="k">Structuring Status</td><td class="v">@Txt(loan.LoanStructuringStatus)</td></tr>

                                    <!-- Interest stop control -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Interest Stop / Controls</td>
                                    </tr>
                                    <tr><td class="k">Interest Stop?</td><td class="v">@(stopInterest ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Stopped By</td><td class="v">@Txt(loan.StoppedBy)</td></tr>
                                    <tr>
                                        <td class="k">Stop Date</td>
                                        <td class="v">
                                            @if (stopDateMissing)
                                            {
                                                <span class="text-danger fw-bold">STOPPED BUT DATE MISSING</span>
                                            }
                                            else
                                            {
                                                @FDate(loan.DateInterestWastStoped)
                                            }
                                        </td>
                                    </tr>
                                    <tr><td class="k">Stop Comment</td><td class="v">@Txt(loan.InterestStoppedComment)</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- initiation / disbursement branches (UPDATED + FULL TRACEABILITY + MIGRATION/RESTRUCTURE/REFINANCE) -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-source-branch"></i>
                                        Initiation, Approval & Disbursement Traceability
                                    </div>

                                    <!-- TOP BADGES (VERY VISIBLE) -->
                                    <div class="d-flex flex-wrap gap-2">

                                        <!-- MIGRATION BADGE -->
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED LOAN" : "NATIVE LOAN")
                                        </span>

                                        <!-- RESTRUCTURE / REFINANCE BADGES -->
                                        @if (isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">
                                                RESTRUCTURED
                                            </span>
                                        }
                                        @if (isRefinanced)
                                        {
                                            <span class="badge bg-primary">
                                                REFINANCED
                                            </span>
                                        }

                                        <!-- DISBURSEMENT + POSTING BADGES -->
                                        <span class="badge @(string.Equals(loan.DisbursmentStatus,"Disbursed",StringComparison.OrdinalIgnoreCase) || loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            DISB: @(loan.IsLoanDisbursted ? "YES" : "NO")
                                        </span>

                                        <span class="badge @(loan.RDisbursementAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            DISB POST: @(loan.RDisbursementAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>

                                        <span class="badge @(loan.RApprovalAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            APRV POST: @(loan.RApprovalAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>
                                    </div>
                                </div>

                                <!-- MIGRATION / RESTRUCTURE / REFINANCE DETAILS (CLEAR BLOCK) -->
                                <div class="row g-3 mb-2">

                                    @if (isMigrated)
                                    {
                                        <div class="col-lg-12">
                                            <div class="alert alert-dark py-2 mb-0">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-database-import-outline me-1"></i>
                                                    This is a <u>MIGRATED</u> loan.
                                                </div>
                                                <div class="small-note">
                                                    Migration information is shown below for audit traceability.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="small-note">Legacy LoanId (Upload)</div>
                                            <div class="fw-bold">@Txt(loan.LoanId)</div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="small-note">Migration Date</div>
                                            <div class="fw-bold">@FDateNullable(loan.MigrationDate)</div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="small-note">Upload Flag</div>
                                            <div class="fw-bold">@(loan.IsUpload ? "YES" : "NO")</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-lg-12">
                                            <div class="alert alert-light border py-2 mb-0">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-check-decagram-outline me-1 text-success"></i>
                                                    This is a <u>NATIVE</u> (non-migrated) loan.
                                                </div>
                                                <div class="small-note">
                                                    All initiation/approval/disbursement states are from the core workflow.
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (isRestructured)
                                    {
                                        <div class="col-md-6">
                                            <div class="small-note">Restructure Status</div>
                                            <div class="fw-bold text-info">
                                                YES • This loan has been restructured
                                            </div>
                                            <div class="small-note">
                                                Related (New) LoanId: <span class="fw-bold">@Txt(loan.NewLoanId)</span>
                                            </div>
                                        </div>

                                        <div class="col-md-6 d-flex align-items-end justify-content-md-end">
                                            @if (!string.IsNullOrWhiteSpace(loan.NewLoanId))
                                            {
                                                <a class="btn btn-sm btn-outline-info"
                                                   href="@Url.Action("LoanDetails", "CashDesk", new { loanId = loan.NewLoanId })">
                                                    <i class="mdi mdi-open-in-new me-1"></i>
                                                    Open Restructured Loan
                                                </a>
                                            }

                                        </div>
                                    }

                                    @if (isRefinanced)
                                    {
                                        <div class="col-md-12">
                                            <div class="alert alert-primary py-2 mb-0">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-swap-horizontal-bold me-1"></i>
                                                    This loan is in a <u>REFINANCING</u> context.
                                                </div>
                                                <div class="small-note">
                                                    If you have ParentLoanId / RefinancedLoanId, display it here and add the open button.
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>

                                <div class="row g-3">

                                    <!-- Initiation -->
                                    <div class="col-md-4">
                                        <div class="small-note">Initiating BranchId</div>
                                        <div class="fw-bold">@Txt(loan.InitiatingBranchId)</div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">Loan Branch (Current / Owner)</div>
                                        <div class="fw-bold">@Txt(loan.BranchName) (@Txt(loan.BranchCode))</div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">Disbursement Branch (Routing)</div>
                                        <div class="fw-bold">@Txt(loan.RDisbursementBranchName) (@Txt(loan.RDisbursementBranchCode))</div>
                                    </div>

                                    <!-- Disbursement -->
                                    <div class="col-md-4">
                                        <div class="small-note">Disbursement Status</div>
                                        <div class="fw-bold">
                                            @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                            @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                            {
                                                <span class="text-muted">• @Txt(loan.DisbursmentStatus)</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">Disbursement Reference</div>
                                        <div class="fw-bold">@Txt(loan.RDisbursementReference)</div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">R Disbursement Date</div>
                                        <div class="fw-bold">@FDateNullable(loan.RDisbursementDate)</div>
                                    </div>

                                    <!-- Actors -->
                                    <div class="col-md-4">
                                        <div class="small-note">Disbursed By (Refinancing/Route)</div>
                                        <div class="fw-bold">@Txt(loan.RDisbursedBy)</div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">Loan Disbursed By (Core)</div>
                                        <div class="fw-bold">@Txt(loan.LoanDisbursedBy)</div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="small-note">Loan Manager</div>
                                        <div class="fw-bold">@Txt(loan.LoanManager)</div>
                                    </div>

                                    <!-- Posting + Consistency -->
                                    <div class="col-md-6">
                                        <div class="small-note">Accounting Posting Status</div>
                                        <div class="fw-bold">
                                            Disbursement:
                                            <span class="@(loan.RDisbursementAccountingPostingStatus ? "text-success" : "text-warning")">
                                                @(loan.RDisbursementAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                            </span>
                                            <span class="text-muted">•</span>
                                            Approval:
                                            <span class="@(loan.RApprovalAccountingPostingStatus ? "text-success" : "text-warning")">
                                                @(loan.RApprovalAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                            </span>
                                        </div>

                                        <div class="small-note mt-1">
                                            Consistency:
                                            @if (loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                            {
                                                <span class="fw-bold text-success">FULLY POSTED</span>
                                            }
                                            else if (!loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                            {
                                                <span class="fw-bold text-danger">APPROVAL POSTED BUT DISBURSEMENT NOT POSTED</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-warning">PENDING / INCOMPLETE</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Quick audit references -->
                                    <div class="col-md-6">
                                        <div class="small-note">Audit / Trace Keys</div>
                                        <div class="fw-bold">
                                            LoanAppId: <span class="text-muted">@Txt(loan.LoanApplicationId)</span>
                                            <span class="text-muted">•</span>
                                            ApplicationCode: <span class="text-muted">@Txt(loan.ApplicationCode)</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- ===================== DAILY INTEREST ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-percent-outline"></i> Daily Interest Calculations
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(hasDailyInts ? "bg-success" : "bg-secondary")">
                                            DAYS: @dailyInts.Count
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            INT: @sumInterest.ToString("N0")
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            VAT: @sumVat.ToString("N0")
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            LAST: @(lastIntDate.HasValue ? lastIntDate.Value.ToString("dd/MM/yyyy") : "N/A")
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <div class="small-note">
                                        Shows daily accrual postings for this loan (interest + VAT). Use filter to search.
                                    </div>

                                    <div class="d-flex gap-2">
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="Filter (date, amount, rate...)"
                                               onkeyup="filterTable(this,'tblDailyInterest')" />

                                        @if (hasDailyInts)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    onclick="copyText('@sumInterest.ToString("N0")')"
                                                    title="Copy total interest">
                                                <i class="mdi mdi-content-copy"></i>
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (!hasDailyInts)
                                {
                                    <div class="alert alert-light border mb-0">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        No daily interest records found for this loan.
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm kv-table align-middle mb-0" id="tblDailyInterest">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="min-width:120px;">Date</th>
                                                    <th class="text-end" style="min-width:130px;">Prev Balance</th>
                                                    <th class="text-end" style="min-width:130px;">New Balance</th>
                                                    <th class="text-end" style="min-width:120px;">Interest</th>
                                                    <th class="text-end" style="min-width:90px;">Rate</th>
                                                    <th class="text-end" style="min-width:90px;">VAT</th>
                                                    <th class="text-end" style="min-width:90px;">VAT%</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var d in dailyInts)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="fw-bold">@d.Date.ToString("dd/MM/yyyy")</span>
                                                            <div class="small-note text-muted">@d.Date.ToString("HH:mm")</div>
                                                        </td>

                                                        <td class="text-end">@d.PreviouseBalance.ToString("N0")</td>
                                                        <td class="text-end">@d.NewBalance.ToString("N0")</td>

                                                        <td class="text-end fw-bold">@d.InterestCalculated.ToString("N0")</td>

                                                        <td class="text-end">
                                                            @d.InterestRate.ToString("N2")<span class="text-muted">%</span>
                                                        </td>

                                                        <td class="text-end">@d.CalculatedVat.ToString("N0")</td>

                                                        <td class="text-end">
                                                            @d.VatRate.ToString("N2")<span class="text-muted">%</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <tfoot class="table-light">
                                                <tr>
                                                    <td class="fw-bold">Totals</td>
                                                    <td></td>
                                                    <td></td>
                                                    <td class="text-end fw-bold">@sumInterest.ToString("N0")</td>
                                                    <td></td>
                                                    <td class="text-end fw-bold">@sumVat.ToString("N0")</td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>


                </div>

                <!-- ===================== FINANCIALS ===================== -->
                <div class="tab-pane fade" id="t_financials">
                    <div class="row g-3">

                        <!-- LEFT: AMOUNTS -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-cash-multiple"></i> Financial Snapshot
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">AMOUNTS</span>
                                        <span class="badge @(loan.Balance > 0 ? "bg-warning text-dark" : "bg-success")">
                                            BAL: @Money(loan.Balance)
                                        </span>
                                        <span class="badge @(loan.DueAmount > 0 ? "bg-danger" : "bg-success")">
                                            DUE: @Money(loan.DueAmount)
                                        </span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Core amounts -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Core Amounts</td>
                                    </tr>
                                    <tr><td class="k">Loan Amount</td><td class="v">@Money(loan.LoanAmount)</td></tr>
                                    <tr><td class="k">Principal</td><td class="v">@Money(loan.Principal)</td></tr>
                                    <tr><td class="k">Requested</td><td class="v">@Money(loan.RequestedAmount)</td></tr>

                                    <!-- Position -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Position</td>
                                    </tr>
                                    <tr><td class="k">Paid</td><td class="v text-success">@Money(loan.Paid)</td></tr>
                                    <tr><td class="k">Balance</td><td class="v text-danger">@Money(loan.Balance)</td></tr>
                                    <tr><td class="k">Due Amount</td><td class="v text-warning">@Money(loan.DueAmount)</td></tr>
                                    <tr><td class="k">Total Principal Paid</td><td class="v">@Money(loan.TotalPrincipalPaid)</td></tr>
                                    <tr><td class="k">Restructured Balance</td><td class="v">@Money(loan.RestructuredBalance)</td></tr>

                                    <!-- Flags -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Flags</td>
                                    </tr>
                                    <tr><td class="k">Mortgage</td><td class="v">@(loan.IsMortgage ? "YES" : "NO")</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- RIGHT: INTEREST / VAT / CHARGES -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-percent-outline"></i> Interest, VAT & Charges
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">RATES</span>
                                        <span class="badge bg-light text-dark border">INT: @Percent(loan.InterestRate)</span>
                                        <span class="badge bg-light text-dark border">VAT: @Percent(loan.VatRate)</span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Rates -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Rates</td>
                                    </tr>
                                    <tr><td class="k">Interest Rate</td><td class="v">@Percent(loan.InterestRate)</td></tr>
                                    <tr><td class="k">VAT Rate</td><td class="v">@Percent(loan.VatRate)</td></tr>

                                    <!-- Interest -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Interest</td>
                                    </tr>
                                    <tr><td class="k">Forecasted</td><td class="v">@Money(loan.InterestForcasted)</td></tr>
                                    <tr><td class="k">Accrued</td><td class="v">@Money(loan.AccrualInterest)</td></tr>
                                    <tr><td class="k">Last Calc</td><td class="v">@Money(loan.LastCalculatedInterest)</td></tr>
                                    <tr><td class="k">Accrued Paid</td><td class="v">@Money(loan.AccrualInterestPaid)</td></tr>

                                    <!-- VAT / Tax -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">VAT / Tax</td>
                                    </tr>
                                    <tr><td class="k">Tax</td><td class="v">@Money(loan.Tax)</td></tr>
                                    <tr><td class="k">Tax Paid</td><td class="v">@Money(loan.TaxPaid)</td></tr>

                                    <!-- Fees / Penalties -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Fees & Penalties</td>
                                    </tr>
                                    <tr><td class="k">Fee</td><td class="v">@Money(loan.Fee)</td></tr>
                                    <tr><td class="k">Fee Paid</td><td class="v">@Money(loan.FeePaid)</td></tr>

                                    <tr><td class="k">Penalty</td><td class="v">@Money(loan.Penalty)</td></tr>
                                    <tr><td class="k">Penalty Paid</td><td class="v">@Money(loan.PenaltyPaid)</td></tr>
                                    <tr><td class="k">Last Penalty</td><td class="v">@Money(loan.LastCalculatedPenaltyAmount)</td></tr>
                                    <tr><td class="k">Penalty Calc Date</td><td class="v">@FDateNullable(loan.LastPenaltyCalculationDate)</td></tr>

                                    <!-- Upfront -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Upfront Interest</td>
                                    </tr>
                                    <tr><td class="k">Paid Upfront?</td><td class="v">@(loan.InterestMustBePaidUpFront ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Upfront Amount</td><td class="v">@Money(loan.InterestAmountUpfront)</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- COVERAGE / GUARANTEES -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-lock-outline"></i> Coverage & Guarantees
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">LIQ: @loan.PercentageOfLiquidityCoverage.ToString("0.00")%</span>
                                        <span class="badge bg-light text-dark border">COLL: @loan.PercentageOfCollateralCoverage.ToString("0.00")%</span>
                                        <span class="badge bg-light text-dark border">ALL: @loan.PercentageOfOverAllCoverage.ToString("0.00")%</span>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">

                                    <!-- Member Funds -->
                                    <div class="col-lg-12">
                                        <div class="small-note fw-bold">Member Funds</div>
                                    </div>
                                    <div class="col-md-3"><div class="small-note">Savings</div><div class="fw-bold">@Money(loan.Savings)</div></div>
                                    <div class="col-md-3"><div class="small-note">O-Shares</div><div class="fw-bold">@Money(loan.OShares)</div></div>
                                    <div class="col-md-3"><div class="small-note">P-Shares</div><div class="fw-bold">@Money(loan.PShares)</div></div>
                                    <div class="col-md-3"><div class="small-note">Deposit</div><div class="fw-bold">@Money(loan.Deposit)</div></div>

                                    <!-- Guarantees -->
                                    <div class="col-lg-12 mt-2">
                                        <div class="small-note fw-bold">Guarantees & Salary</div>
                                    </div>
                                    <div class="col-md-3"><div class="small-note">Salary</div><div class="fw-bold">@Money(loan.Salary)</div></div>
                                    <div class="col-md-3"><div class="small-note">Shortee</div><div class="fw-bold">@Money(loan.Shortee)</div></div>
                                    <div class="col-md-3"><div class="small-note">Co-Obligor</div><div class="fw-bold">@Money(loan.Co_Obligor)</div></div>
                                    <div class="col-md-3"><div class="small-note">Co-op Guarantor</div><div class="fw-bold">@Money(loan.Co_OperationGurantor)</div></div>

                                    <!-- Coverage totals -->
                                    <div class="col-lg-12 mt-2">
                                        <div class="small-note fw-bold">Coverage Totals</div>
                                    </div>
                                    <div class="col-md-3"><div class="small-note">Other Fund</div><div class="fw-bold">@Money(loan.OtherGuaranteeFund)</div></div>
                                    <div class="col-md-3"><div class="small-note">Total Guaranteed</div><div class="fw-bold">@Money(loan.TotalFundGuranteed)</div></div>
                                    <div class="col-md-3"><div class="small-note">Saving Balance</div><div class="fw-bold">@Money(loan.SavingBalance)</div></div>
                                    <div class="col-md-3"><div class="small-note">Blocked Saving</div><div class="fw-bold">@Money(loan.BlockedSaving)</div></div>

                                    <div class="col-md-6"><div class="small-note">Guarantor</div><div class="fw-bold">@Txt(loan.Garantor)</div></div>
                                </div>
                            </div>
                        </div>

                        <!-- OLD VS CURRENT -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">
                                <div class="loan-card-title"><i class="mdi mdi-compare"></i> Old vs Current (Restructure / Adjustments)</div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Previous Values</td>
                                    </tr>
                                    <tr><td class="k">Old Capital</td><td class="v">@Money(loan.OldCapital)</td></tr>
                                    <tr><td class="k">Old Interest</td><td class="v">@Money(loan.OldInterest)</td></tr>
                                    <tr><td class="k">Old VAT</td><td class="v">@Money(loan.OldVAT)</td></tr>
                                    <tr><td class="k">Old Penalty</td><td class="v">@Money(loan.OldPenalty)</td></tr>
                                    <tr><td class="k">Old Balance</td><td class="v">@Money(loan.OldBalance)</td></tr>
                                    <tr><td class="k">Old Due Amount</td><td class="v">@Money(loan.OldDueAmount)</td></tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ===================== REPAYMENTS ===================== -->
                <div class="tab-pane fade" id="t_repayment">
                    <div class="row g-3">

                        @{
                            // totals for quick badges + footer
                            var totalPaid = refunds?.Sum(x => x.Amount) ?? 0m;
                            var totalPaidInterest = refunds?.Sum(x => x.Interest) ?? 0m;
                            var totalPaidVat = refunds?.Sum(x => x.Tax) ?? 0m;
                            var totalPaidPenalty = refunds?.Sum(x => x.Penalty) ?? 0m;
                            var totalPaidAll = totalPaid + totalPaidInterest + totalPaidVat + totalPaidPenalty;

                            // amort totals (optional)
                            var totalDuePrincipal = amort?.Sum(x => x.Principal) ?? 0m;
                            var totalDueInterest = amort?.Sum(x => x.Interest) ?? 0m;
                            var totalDueVat = amort?.Sum(x => x.Tax) ?? 0m;
                            var totalDueAll = amort?.Sum(x => x.TotalDue) ?? 0m;
                        }

                        <!-- Summary -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-history"></i> Repayment Summary
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">REFUNDS: @refunds.Count</span>
                                        <span class="badge bg-light text-dark border">AMORT: @amort.Count</span>
                                        <span class="badge @(totalPaidAll > 0 ? "bg-success" : "bg-secondary")">
                                            TOTAL PAID: @Money(totalPaidAll)
                                        </span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Terms -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Terms</td></tr>
                                    <tr><td class="k">Cycle</td><td class="v">@Txt(loan.RepaymentCycle)</td></tr>
                                    <tr><td class="k">Installments</td><td class="v">@loan.NumberOfInstallments</td></tr>
                                    <tr><td class="k">Duration</td><td class="v">@loan.LoanDuration</td></tr>
                                    <tr><td class="k">Term</td><td class="v">@Txt(loan.LoanTermName)</td></tr>

                                    <!-- Last payment -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Latest</td></tr>
                                    <tr><td class="k">Last Payment</td><td class="v">@Money(loan.LastPayment)</td></tr>
                                    <tr><td class="k">Refund Count</td><td class="v">@loan.RefundCount</td></tr>
                                    <tr><td class="k">Last Refund Amount</td><td class="v">@MoneyN(loan.LastRefundAmount)</td></tr>
                                    <tr><td class="k">Last Refund Ref</td><td class="v">@Txt(loan.LastRefundReference)</td></tr>

                                    <!-- Totals paid -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Totals Paid (Refunds)</td></tr>
                                    <tr><td class="k">Principal Paid</td><td class="v text-success">@Money(totalPaid)</td></tr>
                                    <tr><td class="k">Interest Paid</td><td class="v">@Money(totalPaidInterest)</td></tr>
                                    <tr><td class="k">VAT Paid</td><td class="v">@Money(totalPaidVat)</td></tr>
                                    <tr><td class="k">Penalty Paid</td><td class="v">@Money(totalPaidPenalty)</td></tr>
                                    <tr><td class="k">Total Paid</td><td class="v fw-bold">@Money(totalPaidAll)</td></tr>

                                </table>

                                <div class="small-note mt-2">
                                    Tip: Use the search boxes to audit refunds and schedule quickly.
                                </div>
                            </div>
                        </div>

                        <!-- Listings card -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-format-list-bulleted"></i> Listings
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="pill"><span class="k">Refunds</span><span class="v">@refunds.Count</span></span>
                                        <span class="pill"><span class="k">Amort</span><span class="v">@amort.Count</span></span>
                                        <span class="pill"><span class="k">Docs</span><span class="v">@docs.Count</span></span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Schedule Totals (Amort)</td></tr>
                                    <tr><td class="k">Total Due</td><td class="v fw-bold">@Money(totalDueAll)</td></tr>
                                    <tr><td class="k">Principal Due</td><td class="v">@Money(totalDuePrincipal)</td></tr>
                                    <tr><td class="k">Interest Due</td><td class="v">@Money(totalDueInterest)</td></tr>
                                    <tr><td class="k">VAT Due</td><td class="v">@Money(totalDueVat)</td></tr>
                                </table>

                                <div class="small-note mt-2">Lists below are scrollable and searchable.</div>
                            </div>
                        </div>

                        <!-- Refunds -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-cash-check"></i> Repayment History (Refunds)
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap">
                                        <input class="form-control form-control-sm" style="max-width:260px"
                                               placeholder="Search refunds..." onkeyup="filterTable(this,'refundTable')" />
                                    </div>
                                </div>

                                <div class="list-scroll">
                                    <table class="table table-sm table-striped table-hover table-tight mb-0" id="refundTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:160px;">Date</th>
                                                <th class="text-end" style="min-width:120px;">Principal</th>
                                                <th class="text-end" style="min-width:110px;">Interest</th>
                                                <th class="text-end" style="min-width:90px;">VAT</th>
                                                <th class="text-end" style="min-width:100px;">Penalty</th>

                                                <!-- NEW -->
                                                <th class="text-end" style="min-width:140px;">Total Paid</th>

                                                <!-- Details -->
                                                <th style="min-width:140px;">Channel</th>
                                                <th style="min-width:220px;">Details</th>
                                                <th style="min-width:180px;">Reference</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (refunds.Any())
                                            {
                                                foreach (var r in refunds)
                                                {
                                                    var rowTotal = (r.Amount + r.Interest + r.Tax + r.Penalty);

                                                    <tr>
                                                        <td>
                                                            @if (r.DateOfPayment == DateTime.MinValue)
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="fw-bold">@r.DateOfPayment.ToString("dd/MM/yyyy")</span>
                                                                <div class="small-note text-muted">@r.DateOfPayment.ToString("HH:mm:ss")</div>
                                                            }
                                                        </td>

                                                        <td class="text-end">@r.Amount.ToString("N0")</td>
                                                        <td class="text-end">@r.Interest.ToString("N0")</td>
                                                        <td class="text-end">@r.Tax.ToString("N0")</td>
                                                        <td class="text-end">@r.Penalty.ToString("N0")</td>

                                                        <!-- NEW total -->
                                                        <td class="text-end fw-bold">@rowTotal.ToString("N0")</td>

                                                        <td>@r.PaymentChannel</td>

                                                        <!-- NEW details (audit friendly) -->
                                                        <td>
                                                            <div class="small-note">
                                                                <span class="text-muted">Method:</span> <b>@Txt(r.PaymentMethod)</b>
                                                                @* Add more fields here if your Refund model has them *@
                                                                @* • Teller: @Txt(r.TellerName) • TxRef: @Txt(r.TransactionReference) *@
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <span class="text-muted">@Txt(r.PaymentMethod)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="9" class="text-center text-muted p-3">No refunds found for this loan.</td></tr>
                                            }
                                        </tbody>

                                        @if (refunds.Any())
                                        {
                                            <tfoot class="table-light">
                                                <tr>
                                                    <td class="fw-bold">Totals</td>
                                                    <td class="text-end fw-bold">@totalPaid.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalPaidInterest.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalPaidVat.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalPaidPenalty.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalPaidAll.ToString("N0")</td>
                                                    <td colspan="3"></td>
                                                </tr>
                                            </tfoot>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Amortization -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-month-outline"></i> Amortization Schedule
                                    </div>
                                    <input class="form-control form-control-sm" style="max-width:260px"
                                           placeholder="Search amortization..." onkeyup="filterTable(this,'amortTable')" />
                                </div>

                                <div class="list-scroll">
                                    <table class="table table-sm table-striped table-hover table-tight mb-0" id="amortTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:60px;">#</th>
                                                <th style="min-width:140px;">Due Date</th>
                                                <th class="text-end" style="min-width:120px;">Principal</th>
                                                <th class="text-end" style="min-width:110px;">Interest</th>
                                                <th class="text-end" style="min-width:90px;">VAT</th>
                                                <th class="text-end" style="min-width:120px;">Total</th>
                                                <th style="min-width:120px;">Status</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (amort.Any())
                                            {
                                                var i = 1;
                                                foreach (var a in amort)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@(a.DateOfPayment == DateTime.MinValue ? "-" : a.DateOfPayment.ToString("dd/MM/yyyy"))</td>
                                                        <td class="text-end">@a.Principal.ToString("N0")</td>
                                                        <td class="text-end">@a.Interest.ToString("N0")</td>
                                                        <td class="text-end">@a.Tax.ToString("N0")</td>
                                                        <td class="text-end fw-bold">@a.TotalDue.ToString("N0")</td>
                                                        <td>@a.Status</td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="7" class="text-center text-muted p-3">No amortization schedule found.</td></tr>
                                            }
                                        </tbody>

                                        @if (amort.Any())
                                        {
                                            <tfoot class="table-light">
                                                <tr>
                                                    <td colspan="2" class="fw-bold">Totals</td>
                                                    <td class="text-end fw-bold">@totalDuePrincipal.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalDueInterest.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalDueVat.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@totalDueAll.ToString("N0")</td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        }
                                    </table>
                                </div>

                                <div class="small-note mt-2">
                                    Note: If empty, ensure <code>LoanAmortizations</code> is loaded server-side.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ===================== RISK ===================== -->
                <div class="tab-pane fade" id="t_risk">
                    <div class="row g-3">

                        @{
                            var isDelinquent = loan.IsDeliquentLoan;
                            var delinquentDays = loan.DeliquentDays;

                            // severity (simple + clear)
                            var sevClass =
                                delinquentDays >= 90 ? "sev-critical" :
                                delinquentDays >= 30 ? "sev-high" :
                                delinquentDays >= 1 ? "sev-med" : "sev-ok";

                            var sevText =
                                delinquentDays >= 90 ? "CRITICAL" :
                                delinquentDays >= 30 ? "HIGH" :
                                delinquentDays >= 1 ? "MED" : "OK";
                        }

                        <!-- ===================== DELINQUENCY ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-alert-decagram-outline"></i> Delinquency
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge badge-sev @sevClass">
                                            <span class="dot"></span> @sevText
                                        </span>

                                        <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                            @(isDelinquent ? "DELINQUENT" : "OK")
                                        </span>

                                        <span class="badge @(delinquentDays > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            DAYS: @delinquentDays.ToString("N0")
                                        </span>

                                        <span class="badge bg-light text-dark border">
                                            PAR: @Txt(loan.PAR)
                                        </span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Status -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Status</td></tr>
                                    <tr>
                                        <td class="k">Is Delinquent</td>
                                        <td class="v">
                                            <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                                @(isDelinquent ? "YES" : "NO")
                                            </span>
                                            @if (isDelinquent && delinquentDays > 0)
                                            {
                                                <span class="text-muted ms-2">• Severity: <b class="sev-text @sevClass">@sevText</b></span>
                                            }
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="k">Delinquent Days</td>
                                        <td class="v">
                                            <b class="sev-text @sevClass">@delinquentDays.ToString("N0")</b>
                                            @if (delinquentDays == 0)
                                            {
                                                <span class="text-muted ms-2">• On-time</span>
                                            }
                                        </td>
                                    </tr>

                                    <tr><td class="k">Delinquent Status</td><td class="v">@Txt(loan.DeliquentStatus)</td></tr>

                                    <!-- Amounts -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Amounts</td></tr>
                                    <tr>
                                        <td class="k">Delinquent Amount</td>
                                        <td class="v">
                                            <span class="fw-bold @(loan.DeliquentAmount > 0 ? "text-danger" : "text-muted")">
                                                @Money(loan.DeliquentAmount)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="k">Delinquent Interest</td>
                                        <td class="v">@Money(loan.DeliquentInterest)</td>
                                    </tr>

                                    <!-- Configuration -->
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Configuration</td></tr>
                                    <tr><td class="k">PAR Bucket</td><td class="v">@Txt(loan.PAR)</td></tr>
                                    <tr><td class="k">Config Name</td><td class="v">@Txt(loan.LoanDeliquencyConfigurationName)</td></tr>
                                    <tr><td class="k">Last Processed</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                                </table>

                                @if (isDelinquent && delinquentDays >= 30)
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i>
                                        <b>Attention:</b> This loan is past due. Review collection actions and COBAC classification.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ===================== PENALTY ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-gavel"></i> Penalty
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(loan.Penalty > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            PEN: @Money(loan.Penalty)
                                        </span>
                                        <span class="badge @(loan.PenaltyPaid > 0 ? "bg-success" : "bg-light text-dark border")">
                                            PAID: @Money(loan.PenaltyPaid)
                                        </span>
                                        <span class="badge @(loan.IsWriteOffLoan ? "bg-danger" : "bg-light text-dark border")">
                                            W/O: @(loan.IsWriteOffLoan ? "YES" : "NO")
                                        </span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Amounts</td></tr>
                                    <tr><td class="k">Penalty</td><td class="v fw-bold @(loan.Penalty > 0 ? "text-warning" : "text-muted")">@Money(loan.Penalty)</td></tr>
                                    <tr><td class="k">Penalty Paid</td><td class="v @(loan.PenaltyPaid > 0 ? "text-success" : "text-muted")">@Money(loan.PenaltyPaid)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Calculation</td></tr>
                                    <tr><td class="k">Last Calc Date</td><td class="v">@FDateNullable(loan.LastPenaltyCalculationDate)</td></tr>
                                    <tr><td class="k">Last Calc Amount</td><td class="v">@Money(loan.LastCalculatedPenaltyAmount)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Flags</td></tr>
                                    <tr>
                                        <td class="k">Write-Off</td>
                                        <td class="v">
                                            <span class="badge @(loan.IsWriteOffLoan ? "bg-danger" : "bg-light text-dark border")">
                                                @(loan.IsWriteOffLoan ? "YES" : "NO")
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ===================== INTEREST STOP / CONTROLS ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-lock-outline"></i> Interest Controls
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(stopInterest ? "bg-dark" : "bg-light text-dark border")">
                                            INT: @(stopInterest ? "STOPPED" : "RUNNING")
                                        </span>

                                        @if (stopInterest && stopDateMissing)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="mdi mdi-alert-circle-outline me-1"></i> STOP DATE MISSING
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-md-3">
                                        <div class="small-note">Stop Interest</div>
                                        <div class="fw-bold">@(stopInterest ? "YES" : "NO")</div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="small-note">Stopped By</div>
                                        <div class="fw-bold">@Txt(loan.StoppedBy)</div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="small-note">Stop Date</div>
                                        <div class="fw-bold">
                                            @if (stopInterest && stopDateMissing)
                                            {
                                                <span class="text-danger fw-bold">STOPPED BUT DATE MISSING</span>
                                            }
                                            else
                                            {
                                                @FDate(loan.DateInterestWastStoped)
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="small-note">Comment</div>
                                        <div class="fw-bold">@Txt(loan.InterestStoppedComment)</div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <!-- ===================== PRODUCT & PURPOSE ===================== -->
                <div class="tab-pane fade" id="t_product">
                    <div class="row g-3">

                        @{
                            var isMortgage = loan.IsMortgage;

                            var taxable =
                                !string.IsNullOrWhiteSpace(loan.TaxableStatus)
                                && loan.TaxableStatus.Equals("Taxable", StringComparison.OrdinalIgnoreCase);

                            var product = loan?.LoanApplication?.LoanProduct;
                        }

                        <!-- ===================== PRODUCT ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-package-variant-closed"></i> Product
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMortgage ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            MORT: @(isMortgage ? "YES" : "NO")
                                        </span>

                                        <!-- ✅ TAX badge (very visible) -->
                                        <span class="badge badge-tax @(taxable ? "badge-taxable" : "badge-nontaxable")">
                                            <span class="dot"></span>
                                            TAX: @(taxable ? "TAXABLE" : "NON-TAXABLE")
                                        </span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Product Identity -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Identity</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Code</td>
                                        <td class="v fw-bold">@Txt(product?.ProductCode)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Name</td>
                                        <td class="v">@Txt(product?.ProductName)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Product Id</td>
                                        <td class="v">@Txt(loan?.LoanApplication?.LoanProductId)</td>
                                    </tr>

                                    <!-- Term -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Term</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Term Name</td>
                                        <td class="v">@Txt(loan.LoanTermName) @Txt(loan?.LoanApplication?.LoanTermName)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Term Id</td>
                                        <td class="v">@Txt(loan.LoanTermId)</td>
                                    </tr>

                                    <!-- Flags -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Flags</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Mortgage?</td>
                                        <td class="v">
                                            <span class="badge @(isMortgage ? "bg-warning text-dark" : "bg-light text-dark border")">
                                                @(isMortgage ? "YES" : "NO")
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="k">Tax Status</td>
                                        <td class="v">
                                            <span class="badge badge-tax @(taxable ? "badge-taxable" : "badge-nontaxable")">
                                                <span class="dot"></span>
                                                @(taxable ? "TAXABLE" : "NON-TAXABLE")
                                            </span>
                                            <span class="text-muted ms-2">• @Txt(loan.TaxableStatus)</span>
                                        </td>
                                    </tr>

                                </table>

                                <div class="small-note mt-2">
                                    Tip: Product fields come from <b>LoanApplication → LoanProduct</b>. Ensure it is included in <code>GetLoan()</code>.
                                </div>
                            </div>
                        </div>

                        <!-- ===================== PURPOSE & TARGET ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-target-account"></i> Purpose & Target
                                    </div>

                                    <!-- quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (!string.IsNullOrWhiteSpace(loan.PcmfPurposeCode))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                PCMF: @Txt(loan.PcmfPurposeCode)
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(loan.TargetType))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                TARGET: @Txt(loan.TargetType)
                                            </span>
                                        }
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Purpose -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Purpose</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Purpose Name</td>
                                        <td class="v fw-bold">@Txt(loan.PurposeName)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">PCMF Purpose Id</td>
                                        <td class="v">@Txt(loan.PcmfLoanPurposeId)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">PCMF Key</td>
                                        <td class="v">@Txt(loan.PcmfPurposeKey)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">PCMF Code</td>
                                        <td class="v">@Txt(loan.PcmfPurposeCode)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">PCMF Slug</td>
                                        <td class="v">@Txt(loan.PcmfPurposeSlug)</td>
                                    </tr>

                                    <!-- Target -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Target</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Target Type</td>
                                        <td class="v">@Txt(loan.TargetType)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Target</td>
                                        <td class="v">@Txt(loan.LoanTarget)</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Target Id</td>
                                        <td class="v">@Txt(loan.LoanTargetId)</td>
                                    </tr>

                                    <!-- Reference -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Reference</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Application Code</td>
                                        <td class="v">@Txt(loan.ApplicationCode)</td>
                                    </tr>

                                </table>

                                <div class="small-note mt-2">
                                    Tip: PCMF Purpose + Target should match reporting mappings (PCMF/COBAC).
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- ===================== DOCUMENTS ===================== -->
                <div class="tab-pane fade" id="t_documents">
                    <div class="row g-3">

                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <!-- header + quick badges -->
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-folder-multiple-outline"></i> Documents
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            FILES: @docs.Count
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanApplicationId))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                APP: @Txt(loan.LoanApplicationId)
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- search -->
                                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                    <div class="small-note">
                                        Keep ID, guarantee, collateral, contract, and approval docs for audit.
                                    </div>

                                    <input class="form-control form-control-sm" style="max-width:260px"
                                           placeholder="Search documents..." onkeyup="filterTable(this,'docTable')" />
                                </div>

                                <div class="table-responsive mt-2 list-scroll">
                                    <table class="table table-sm table-striped table-hover table-tight align-middle mb-0" id="docTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:220px;">File</th>
                                                <th style="min-width:140px;">Type</th>
                                                <th style="min-width:170px;">Document</th>
                                                <th class="text-end" style="min-width:140px;">Date</th>
                                                <th class="text-end" style="min-width:170px;">Download</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (docs.Any())
                                            {
                                                foreach (var d in docs)
                                                {
                                                    var docName = d.Document != null ? d.Document.Name : "";
                                                    var docCode = d.FileName;

                                                    <tr>
                                                        <td>
                                                            <span class="fw-bold">@Txt(d.FileName)</span>
                                                            @if (!string.IsNullOrWhiteSpace(d.FileExtension))
                                                            {
                                                                <span class="text-muted ms-1">(@Txt(d.FileExtension))</span>
                                                            }
                                                        </td>

                                                        <td>@Txt(d.FileExtension)</td>

                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(docName) || !string.IsNullOrWhiteSpace(docCode))
                                                            {
                                                                <span class="fw-bold">@Txt(docName)</span>
                                                                if (!string.IsNullOrWhiteSpace(docCode))
                                                                {
                                                                    <span class="text-muted ms-1">• @Txt(docCode)</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">N/A</span>
                                                            }
                                                        </td>

                                                        <td class="text-end">@FDate(d.Date)</td>

                                                        <td class="text-end">
                                                            <!-- download is the full path (but hidden from UI) -->
                                                            <a class="btn btn-sm btn-outline-primary"
                                                               href="@Txt(d.FilePath)" target="_blank" rel="noopener">
