                                    <i class="mdi mdi-clipboard-check-outline"></i> Controls
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-light text-dark border">
                                        TAX: @Txt(loan.TaxableStatus)
                                    </span>
                                    <span class="badge @(loan.InterestMustBePaidUpFront ? "bg-primary" : "bg-light text-dark border")">
                                        UPFRONT: @(loan.InterestMustBePaidUpFront ? "YES" : "NO")
