                                                                    </div>

                                                                    <div class="row g-2">
                                                                        <div class="col-md-4">
                                                                            <div class="small-note">Interest GL</div>
                                                                            <div class="fw-bold">@GlText(interestGlId)</div>
                                                                            <div class="small-note text-muted">Id: @Txt(interestGlId)</div>
                                                                        </div>

                                                                        <div class="col-md-4">
                                                                            <div class="small-note">Penalty GL</div>
                                                                            <div class="fw-bold">@GlText(penaltyGlId)</div>
                                                                            <div class="small-note text-muted">Id: @Txt(penaltyGlId)</div>
                                                                        </div>

                                                                        <div class="col-md-4">
                                                                            <div class="small-note">VAT GL</div>
                                                                            <div class="fw-bold">@GlText(vatGlId)</div>
                                                                            <div class="small-note text-muted">Id: @Txt(vatGlId)</div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="small-note text-muted mt-2 mb-0">
                                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                                        These GLs are used by interest accrual / penalties / VAT flows depending on configuration and tax mode.
                                                                    </div>
