                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===================== LOAN COVERAGE ANALYSIS TAB ===================== -->
                <div class="tab-pane fade" id="t_coverage">
                    @{

                        // --- Policy source (as you requested) ---
                        // If your LoanProduct has policies by term, swap this line accordingly.
                        // Example: var policy = app?.LoanProduct?.LoanProductPolicies?.FirstOrDefault(x => x.TermId == app.LoanTermId);
                        var policy = app?.LoanProduct.Policy;

                        // --- Base values ---
                        var approvedAmount = app?.Amount ?? loan?.LoanAmount ?? 0m;
                        var requestedAmount = app?.RequestedAmount ?? loan?.RequestedAmount ?? 0m;

                        var balance = loan?.Balance ?? 0m;
                        var due = loan?.DueAmount ?? 0m;
                        var paid = loan?.Paid ?? 0m;
                        var principal = loan?.Principal ?? 0m;

                        // Rates (application based)
                        var intRate = app?.InterestRate ?? loan?.InterestRate ?? 0m;
                        var vatRate = app?.VatRate ?? loan?.VatRate ?? 0m;

                        // Computed interest (loan runtime)
                        var intForecast = loan?.InterestForcasted ?? 0m;
                        var intAccrued = loan?.AccrualInterest ?? 0m;
                        var intLastCalc = loan?.LastCalculatedInterest ?? 0m;
                        var intAccruedPaid = loan?.AccrualInterestPaid ?? 0m;

                        // Charges
                        var tax = loan?.Tax ?? 0m;
                        var taxPaid = loan?.TaxPaid ?? 0m;
                        var fee = loan?.Fee ?? 0m;
                        var feePaid = loan?.FeePaid ?? 0m;
                        var penalty = loan?.Penalty ?? 0m;
                        var penaltyPaid = loan?.PenaltyPaid ?? 0m;

                        var lastPenalty = loan?.LastCalculatedPenaltyAmount ?? 0m;
                        var penaltyCalcDate = loan?.LastPenaltyCalculationDate;

                        var paidUpfront = (policy?.InterestMustBePaidUpFront ?? app?.IsInterestPaidUpFront ?? loan?.InterestMustBePaidUpFront ?? false);
                        var upfrontAmount = (app?.InterestAmountUpfront ?? loan?.InterestAmountUpfront ?? 0m);

                        // --- Savings snapshot at application time ---
                        var savingBalanceAtApp = app?.SavingBalance ?? loan?.SavingBalance ?? 0m;
                        var blockedSavingAtApp = app?.BlockedSaving ?? loan?.BlockedSaving ?? 0m;

                        // --- Down payment: POLICY based ---
                        var downPctRequired = policy?.MinimumDownPaymentPercentage ?? 0m;     // % (e.g., 20)
                        var downAmountRequired = approvedAmount > 0m ? (downPctRequired / 100m) * approvedAmount : 0m;

                        // Provided down payment from application
                        var downPaid = app?.DownPaymentCoverageAmountProvided ?? 0m;
                        var downPaidPct = approvedAmount > 0m ? (downPaid / approvedAmount) * 100m : 0m;

                        var downPaymentRequiredByPolicy = downPctRequired > 0m;
                        var downOk = !downPaymentRequiredByPolicy || downPaid >= downAmountRequired;

                        // --- Blocking behavior: POLICY + application flags ---
                        var mustBlockSavings = (policy?.BlockSavingAccount ?? app?.BlockSavingAccount ?? false);
                        var savingBlockRate = app?.SavingAccountCoverageRate ?? 0m; // % of loan to block (if you use it)
                        var requiredSavingsBlock = (mustBlockSavings && approvedAmount > 0m && savingBlockRate > 0m)
                            ? (savingBlockRate / 100m) * approvedAmount
                            : 0m;

                        var missingSavingsBlock = mustBlockSavings ? Math.Max(0m, requiredSavingsBlock - blockedSavingAtApp) : 0m;

                        // --- Guarantors coverage ---
                        var guarantors = app?.Guarantors ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanGuarantor>();
                        var guarantorCover = guarantors.Sum(x => x?.GuaranteeAmount ?? 0m);

                        // --- Collateral coverage rate (% only) ---
                        var collateralRate = app?.CollateralCoverageRate ?? 0m;

                        // --- Other coverage amounts from application (volume-based) ---
                        var coverDeposit = app?.DepositAccountCoverageAmount ?? 0m;
                        var coverSalary = app?.SalaryAccountCoverageAmount ?? 0m;
                        var coverTermDeposit = app?.TermDeposiAccountCoverageAmount ?? 0m;

                        // Shares are NOT coverage (eligibility only)
                        var shareRequired = policy?.MinimumShareAccountBalanceForTheRequestAmount ?? 0m; // policy requirement (if you use it)
                        var sharesRequiredAmount = app?.ShareAccountCoverageAmount ?? 0m;
                        var prefSharesAmount = app?.PreferenceShareAccountCoverageAmount ?? 0m;

                        // --- Your special rule:
                        // If (Loan BALANCE) is within (Saving Balance) during the granted period => treated as covered.
                        // We express it as a "Liquidity Coverage" check.
                        var liquidityCoveredBySavings = (savingBalanceAtApp > 0m && balance > 0m && savingBalanceAtApp >= balance);

                        // --- Coverage volume calculation (policy-aware) ---
                        // Coverage volume should represent REAL money protection/coverage:
                        // Down payment paid + deposit/salary/term deposit coverage + guarantors.
                        // Blocked saving is not double-counted unless it represents coverage pledged.
                        // (If your DepositAccountCoverageAmount already includes savings pledge, do NOT also add blocked saving.)
                        var coverageVolume =
                            downPaid
                            + coverDeposit
                            + coverSalary
                            + coverTermDeposit
                            + guarantorCover;

                        var coveragePct = approvedAmount > 0m ? (coverageVolume / approvedAmount) * 100m : 0m;

                        // If collateral is rate-only, include it as % uplift (not volume)
                        var coveragePctWithCollateral = coveragePct + collateralRate;

                        // Coverage target configured in application (if used)
                        var targetPct = app?.TotalLoanRiskCoverage ?? 0m;

                        // Final decision logic (professional + explainable):
                        // A file is "Covered" if:
                        // 1) Down payment requirement satisfied (if any), AND
                        // 2) Coverage % meets target OR liquidityCoveredBySavings is true
                        //    (because you said balance within saving balance => covered)
                        var meetsTarget = targetPct <= 0m ? (coveragePctWithCollateral > 0m) : (coveragePctWithCollateral >= targetPct);

                        var isCovered = downOk && (meetsTarget || liquidityCoveredBySavings);

                        // Risk label
                        var risk =
                            isCovered && liquidityCoveredBySavings ? "LOW" :
                            isCovered ? "MEDIUM" :
                            "HIGH";

                        var riskBadge =
                            risk == "LOW" ? "bg-success" :
                            risk == "MEDIUM" ? "bg-warning text-dark" :
                            "bg-danger";

                        var advice = new List<string>();

                        if (downPaymentRequiredByPolicy && !downOk)
                        {
                            advice.Add($"Down payment is below policy minimum ({downPctRequired:0.##}%). Required: {Money(downAmountRequired)}");
                        }

                        if (mustBlockSavings && missingSavingsBlock > 0m)
                        {
                            advice.Add($"Savings blocking is required. Please block an additional {Money(missingSavingsBlock)} to reach the required coverage.");
                        }

                        if (!liquidityCoveredBySavings && savingBalanceAtApp <= 0m)
                        {
                            advice.Add("Member saving balance at application time is zero or not available; liquidity coverage cannot be established.");
                        }

                        if (!meetsTarget && !liquidityCoveredBySavings)
                        {
                            advice.Add("Coverage is below the configured target and not supported by liquidity coverage. Consider adding guarantors/collateral or adjusting amount/term.");
                        }

                        if (liquidityCoveredBySavings && mustBlockSavings && blockedSavingAtApp <= 0m)
                        {
                            advice.Add("Although savings balance can cover the loan balance, it is not blocked. Block the required portion to comply with policy.");
                        }

                        Func<decimal, decimal> Pct = (vol) => approvedAmount > 0m ? (vol / approvedAmount) * 100m : 0m;                        // Helper

                        // --- Member accounts list (must be provided by controller) ---
                        // Expected: IEnumerable<MemberAccountVm> in ViewBag.MemberAccounts
                        var memberAccounts = ViewBag.MemberAccounts as IEnumerable<CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.MemberAccountVm> ?? Enumerable.Empty<CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.MemberAccountVm>();

                        // ===============================
                        // Totals for footer & analysis
                        // ===============================
                        decimal totalActual = 0m;
                        decimal totalBlocked = 0m;
                        decimal totalAvailable = 0m;

                        foreach (var a in memberAccounts)
                        {
                            var available = Math.Max(0m, a.Balance - a.BlockedAmount);

                            totalActual += a.Balance;
                            totalBlocked += a.BlockedAmount;
                            totalAvailable += available;
                        }

                        // ============================
                        // Current-date liquidity analysis
                        // ============================

                        decimal eligibleLiquidityNow = 0m;
                        decimal excludedLiquidity = 0m;

                        foreach (var a in memberAccounts)
                        {
                            // Exclude shares explicitly
                            var isShare =
                                a.AccountType == "PreferenceShare" ||
                                a.AccountType == "OrdinaryShare";

                            if (isShare)
                            {
                                excludedLiquidity += a.Balance;
                                continue;
                            }

                            // Only what is AVAILABLE can cover risk
                            var available = Math.Max(0m, a.Balance - a.BlockedAmount);
                            eligibleLiquidityNow += available;
                        }

                        var currentLoanBalance = loan.Balance;
                        var liquidityGap = eligibleLiquidityNow - currentLoanBalance;

                        var currentlyCovered = eligibleLiquidityNow >= currentLoanBalance;

                        var currentRisk =
                            currentlyCovered ? "LOW" :
                            liquidityGap >= -(currentLoanBalance * 0.2m) ? "MEDIUM" :
                            "HIGH";

                        var currentRiskBadge =
                            currentRisk == "LOW" ? "bg-success" :
                            currentRisk == "MEDIUM" ? "bg-warning text-dark" :
                            "bg-danger";
                    }

                    <div class="row g-3">

                        <!-- ===================== COVERAGE DECISION ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-shield-check-outline"></i> Coverage Decision (Policy + Application + Liquidity Rule)
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            COVER: @Money(coverageVolume) (@coveragePctWithCollateral.ToString("0.00")%)
                                        </span>
                                        @if (targetPct > 0m)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                TARGET: @targetPct.ToString("0.00")%
                                            </span>
                                        }
                                        <span class="badge @(isCovered ? "bg-success" : "bg-danger")">
                                            FILE: @(isCovered ? "COVERED" : "NOT COVERED")
                                        </span>
                                        <span class="badge @riskBadge">RISK: @risk</span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (isCovered)
                                    {
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            <b>Status:</b> This loan file is covered based on policy checks and the liquidity rule.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger py-2 mb-2">
                                            <i class="mdi mdi-alert-circle-outline me-1"></i>
                                            <b>Status:</b> This loan file is not covered. Requirements are missing or insufficient.
                                        </div>
                                    }

                                    <div class="alert @(liquidityCoveredBySavings ? "alert-success" : "alert-warning") py-2 mb-0">
                                        <i class="mdi mdi-bank-outline me-1"></i>
                                        <b>Liquidity Rule:</b>
                                        @if (balance <= 0m)
                                        {
                                            <span>No outstanding balance detected on the loan.</span>
                                        }
                                        else if (liquidityCoveredBySavings)
                                        {
                                            <span>
                                                Balance (@Money(balance)) is within member saving balance at application time (@Money(savingBalanceAtApp)).
                                                This supports coverage during the granted period.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Saving balance at application time (@Money(savingBalanceAtApp)) does not cover current loan balance (@Money(balance)).
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- ===== Mini panels ===== -->
                                <div class="row g-3 mt-1">

                                    <!-- Down payment -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-cash-check me-1"></i> Down Payment (Policy)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Min % (Policy)</td><td class="v">@downPctRequired.ToString("0.##")%</td></tr>
                                                <tr><td class="k">Required Amount</td><td class="v">@Money(downAmountRequired)</td></tr>
                                                <tr><td class="k">Provided Amount</td><td class="v">@Money(downPaid)</td></tr>
                                                <tr>
                                                    <td class="k">Provided %</td>
                                                    <td class="v">
                                                        @downPaidPct.ToString("0.00")%
                                                        <span class="ms-2 badge @(downOk ? "bg-success" : "bg-danger")">@(downOk ? "OK" : "NOT OK")</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Savings snapshot -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-lock-outline me-1"></i> Savings Snapshot (Application Time)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Current Balance</td><td class="v">@Money(savingBalanceAtApp)</td></tr>
                                                <tr><td class="k">Blocked Amount</td><td class="v">@Money(blockedSavingAtApp)</td></tr>
                                                <tr><td class="k">Blocking Required?</td><td class="v">@(mustBlockSavings ? "YES" : "NO")</td></tr>
                                                <tr><td class="k">Required Block</td><td class="v">@(mustBlockSavings ? Money(requiredSavingsBlock) : "N/A")</td></tr>
                                                <tr>
                                                    <td class="k">Gap</td>
                                                    <td class="v">
                                                        @(mustBlockSavings ? Money(missingSavingsBlock) : "N/A")
                                                        @if (mustBlockSavings)
                                                        {
                                                            <span class="ms-2 badge @(missingSavingsBlock <= 0m ? "bg-success" : "bg-warning text-dark")">
                                                                @(missingSavingsBlock <= 0m ? "OK" : "ACTION")
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            </table>

                                            @if (mustBlockSavings && missingSavingsBlock > 0m)
                                            {
                                                <div class="text-muted small mt-2">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    Recommend blocking the missing amount to prevent withdrawals during the granted period.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Shares eligibility -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-account-check-outline me-1"></i> Eligibility (Shares - Not Coverage)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Required Shares (Application)</td><td class="v">@Money(sharesRequiredAmount)</td></tr>
                                                <tr><td class="k">Preference Shares</td><td class="v">@Money(prefSharesAmount)</td></tr>
                                                <tr><td class="k">Policy Share Min</td><td class="v">@Money(shareRequired)</td></tr>
                                                <tr><td class="k">Shares Blocking (Policy)</td><td class="v">@(policy?.BlockShareAccount == true ? "YES" : "NO")</td></tr>
                                            </table>

                                            <div class="text-muted small mt-2">
                                                <i class="mdi mdi-information-outline me-1"></i>
                                                Shares are required for assessment but are excluded from coverage computation.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Coverage breakdown -->
                                    <div class="col-lg-12">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-chart-donut me-1"></i> Coverage Breakdown (Volume & % of Approved Amount)
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Component</th>
                                                            <th class="text-end">Volume</th>
                                                            <th class="text-end">% of Approved</th>
                                                            <th class="text-end">Notes</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>Down Payment</td>
                                                            <td class="text-end">@Money(downPaid)</td>
                                                            <td class="text-end">@Pct(downPaid).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Policy checked</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Deposit Coverage</td>
                                                            <td class="text-end">@Money(coverDeposit)</td>
                                                            <td class="text-end">@Pct(coverDeposit).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Salary Coverage</td>
                                                            <td class="text-end">@Money(coverSalary)</td>
                                                            <td class="text-end">@Pct(coverSalary).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Term Deposit Coverage</td>
                                                            <td class="text-end">@Money(coverTermDeposit)</td>
                                                            <td class="text-end">@Pct(coverTermDeposit).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Guarantor Coverage</td>
                                                            <td class="text-end">@Money(guarantorCover)</td>
                                                            <td class="text-end">@Pct(guarantorCover).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Sum of guarantors’ guarantee amounts</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Collateral Coverage</td>
                                                            <td class="text-end">—</td>
                                                            <td class="text-end">@collateralRate.ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Rate-based (no valuation amount)</td>
                                                        </tr>
                                                        <tr class="table-light">
                                                            <td class="fw-bold">Total Coverage (Excl. Shares)</td>
                                                            <td class="text-end fw-bold">@Money(coverageVolume)</td>
                                                            <td class="text-end fw-bold">@coveragePctWithCollateral.ToString("0.00")%</td>
                                                            <td class="text-end text-muted">
                                                                FILE: <span class="fw-bold">@(isCovered ? "COVERED" : "NOT COVERED")</span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (advice.Any())
                                            {
                                                <div class="mt-3">
                                                    <div class="fw-bold small mb-1"><i class="mdi mdi-lightbulb-on-outline me-1"></i> Insights & Advice</div>
                                                    <ul class="mb-0 small text-muted">
                                                        @foreach (var item in advice)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-3 small text-muted">
                                                    <i class="mdi mdi-check-circle-outline me-1"></i>
                                                    No critical gaps detected based on current policy and application information.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- ===================== CURRENT DATE LIQUIDITY COVERAGE ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3 border border-info">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-clock-outline"></i>
                                        Coverage Analysis — As At Today
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">ELIGIBLE LIQUIDITY: @Money(eligibleLiquidityNow)</span>
                                        <span class="badge bg-light text-dark border">LOAN BALANCE: @Money(currentLoanBalance)</span>
                                        <span class="badge @(currentlyCovered ? "bg-success" : "bg-danger")">STATUS: @(currentlyCovered ? "COVERED" : "NOT COVERED")</span>
                                        <span class="badge @currentRiskBadge">RISK: @currentRisk</span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (currentlyCovered)
                                    {
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            <b>Liquidity Status:</b> As at today, eligible balances can cover the outstanding loan balance.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger py-2 mb-2">
                                            <i class="mdi mdi-alert-circle-outline me-1"></i>
                                            <b>Liquidity Risk:</b> Current eligible balances are insufficient to cover the loan balance.
                                        </div>
                                    }

                                    <table class="table table-sm kv-table mb-0">
                                        <tr><td class="k">Eligible Balances (Excl. Shares)</td><td class="v">@Money(eligibleLiquidityNow)</td></tr>
                                        <tr><td class="k">Excluded (Shares)</td><td class="v">@Money(excludedLiquidity)</td></tr>
                                        <tr><td class="k">Outstanding Loan Balance</td><td class="v">@Money(currentLoanBalance)</td></tr>
                                        <tr>
                                            <td class="k">Liquidity Gap</td>
                                            <td class="v @(liquidityGap >= 0 ? "text-success" : "text-danger")">@Money(liquidityGap)</td>
                                        </tr>
                                    </table>

                                    <div class="mt-2 text-muted small">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        Uses real-time balances; excludes shares; serves as a risk monitoring indicator.
                                    </div>

                                    @if (!currentlyCovered)
                                    {
                                        <div class="alert alert-warning py-2 mt-3 mb-0">
                                            <i class="mdi mdi-lightbulb-on-outline me-1"></i>
                                            <b>Advice:</b> Consider additional blocking / guarantor reinforcement / closer monitoring.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- ===================== COVERAGE DECISION (POLICY + YOUR RULE) ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-shield-check-outline"></i> Coverage Decision (Policy + Application + Liquidity Rule)
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            COVER: @Money(coverageVolume) (@coveragePctWithCollateral.ToString("0.00")%)
                                        </span>
                                        @if (targetPct > 0m)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                TARGET: @targetPct.ToString("0.00")%
                                            </span>
                                        }
                                        <span class="badge @(isCovered ? "bg-success" : "bg-danger")">
                                            FILE: @(isCovered ? "COVERED" : "NOT COVERED")
                                        </span>
                                        <span class="badge @riskBadge">RISK: @risk</span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (isCovered)
                                    {
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            <b>Status:</b> This loan file is covered based on policy checks and the liquidity rule.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger py-2 mb-2">
                                            <i class="mdi mdi-alert-circle-outline me-1"></i>
                                            <b>Status:</b> This loan file is not covered. Requirements are missing or insufficient.
                                        </div>
                                    }

                                    <div class="alert @(liquidityCoveredBySavings ? "alert-success" : "alert-warning") py-2 mb-0">
                                        <i class="mdi mdi-bank-outline me-1"></i>
                                        <b>Liquidity Rule:</b>
                                        @if (balance <= 0m)
                                        {
                                            <span>No outstanding balance detected on the loan.</span>
                                        }
                                        else if (liquidityCoveredBySavings)
                                        {
                                            <span>
                                                Balance (@Money(balance)) is within member saving balance at application time (@Money(savingBalanceAtApp)).
                                                This supports coverage during the granted period.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Saving balance at application time (@Money(savingBalanceAtApp)) does not cover current loan balance (@Money(balance)).
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- ===== Mini panels ===== -->
                                <div class="row g-3 mt-1">

                                    <!-- Down payment (Policy) -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-cash-check me-1"></i> Down Payment (Policy)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Min % (Policy)</td><td class="v">@downPctRequired.ToString("0.##")%</td></tr>
                                                <tr><td class="k">Required Amount</td><td class="v">@Money(downAmountRequired)</td></tr>
                                                <tr><td class="k">Provided Amount</td><td class="v">@Money(downPaid)</td></tr>
                                                <tr>
                                                    <td class="k">Provided %</td>
                                                    <td class="v">
                                                        @downPaidPct.ToString("0.00")%
                                                        <span class="ms-2 badge @(downOk ? "bg-success" : "bg-danger")">@(downOk ? "OK" : "NOT OK")</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Savings snapshot + blocking advice -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-lock-outline me-1"></i> Savings Snapshot (Application Time)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Current Balance</td><td class="v">@Money(savingBalanceAtApp)</td></tr>
                                                <tr><td class="k">Blocked Amount</td><td class="v">@Money(blockedSavingAtApp)</td></tr>
                                                <tr><td class="k">Blocking Required?</td><td class="v">@(mustBlockSavings ? "YES" : "NO")</td></tr>
                                                <tr><td class="k">Required Block</td><td class="v">@(mustBlockSavings ? Money(requiredSavingsBlock) : "N/A")</td></tr>
                                                <tr>
                                                    <td class="k">Gap</td>
                                                    <td class="v">
                                                        @(mustBlockSavings ? Money(missingSavingsBlock) : "N/A")
                                                        @if (mustBlockSavings)
                                                        {
                                                            <span class="ms-2 badge @(missingSavingsBlock <= 0m ? "bg-success" : "bg-warning text-dark")">
                                                                @(missingSavingsBlock <= 0m ? "OK" : "ACTION")
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            </table>

                                            @if (mustBlockSavings && missingSavingsBlock > 0m)
                                            {
                                                <div class="text-muted small mt-2">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    Recommend blocking the missing amount to prevent withdrawals during the granted period.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Shares eligibility (Policy) -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-account-check-outline me-1"></i> Eligibility (Shares - Not Coverage)
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Required Shares (Application)</td><td class="v">@Money(sharesRequiredAmount)</td></tr>
                                                <tr><td class="k">Preference Shares</td><td class="v">@Money(prefSharesAmount)</td></tr>
                                                <tr><td class="k">Policy Share Min</td><td class="v">@Money(shareRequired)</td></tr>
                                                <tr><td class="k">Shares Blocking (Policy)</td><td class="v">@(policy?.BlockShareAccount == true ? "YES" : "NO")</td></tr>
                                            </table>

                                            <div class="text-muted small mt-2">
                                                <i class="mdi mdi-information-outline me-1"></i>
                                                Shares are required for assessment but are excluded from coverage computation.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Coverage breakdown table -->
                                    <div class="col-lg-12">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-chart-donut me-1"></i> Coverage Breakdown (Volume & % of Approved Amount)
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Component</th>
                                                            <th class="text-end">Volume</th>
                                                            <th class="text-end">% of Approved</th>
                                                            <th class="text-end">Notes</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>Down Payment</td>
                                                            <td class="text-end">@Money(downPaid)</td>
                                                            <td class="text-end">@Pct(downPaid).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Policy checked</td>
                                                        </tr>

                                                        <tr>
                                                            <td>Deposit Coverage</td>
                                                            <td class="text-end">@Money(coverDeposit)</td>
                                                            <td class="text-end">@Pct(coverDeposit).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>

                                                        <tr>
                                                            <td>Salary Coverage</td>
                                                            <td class="text-end">@Money(coverSalary)</td>
                                                            <td class="text-end">@Pct(coverSalary).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>

                                                        <tr>
                                                            <td>Term Deposit Coverage</td>
                                                            <td class="text-end">@Money(coverTermDeposit)</td>
                                                            <td class="text-end">@Pct(coverTermDeposit).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Application coverage amount</td>
                                                        </tr>

                                                        <tr>
                                                            <td>Guarantor Coverage</td>
                                                            <td class="text-end">@Money(guarantorCover)</td>
                                                            <td class="text-end">@Pct(guarantorCover).ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Sum of guarantors’ guarantee amounts</td>
                                                        </tr>

                                                        <tr>
                                                            <td>Collateral Coverage</td>
                                                            <td class="text-end">—</td>
                                                            <td class="text-end">@collateralRate.ToString("0.00")%</td>
                                                            <td class="text-end text-muted">Rate-based (no valuation amount)</td>
                                                        </tr>

                                                        <tr class="table-light">
                                                            <td class="fw-bold">Total Coverage (Excl. Shares)</td>
                                                            <td class="text-end fw-bold">@Money(coverageVolume)</td>
                                                            <td class="text-end fw-bold">@coveragePctWithCollateral.ToString("0.00")%</td>
                                                            <td class="text-end text-muted">
                                                                FILE: <span class="fw-bold">@(isCovered ? "COVERED" : "NOT COVERED")</span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (advice.Any())
                                            {
                                                <div class="mt-3">
                                                    <div class="fw-bold small mb-1"><i class="mdi mdi-lightbulb-on-outline me-1"></i> Insights & Advice</div>
                                                    <ul class="mb-0 small text-muted">
                                                        @foreach (var item in advice)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-3 small text-muted">
                                                    <i class="mdi mdi-check-circle-outline me-1"></i>
                                                    No critical gaps detected based on current policy and application information.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- ===================== CURRENT DATE LIQUIDITY COVERAGE ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3 border border-info">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-clock-outline"></i>
                                        Coverage Analysis — As At Today
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            ELIGIBLE LIQUIDITY: @Money(eligibleLiquidityNow)
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            LOAN BALANCE: @Money(currentLoanBalance)
                                        </span>
                                        <span class="badge @(currentlyCovered ? "bg-success" : "bg-danger")">
                                            STATUS: @(currentlyCovered ? "COVERED" : "NOT COVERED")
                                        </span>
                                        <span class="badge @currentRiskBadge">
                                            RISK: @currentRisk
                                        </span>
                                    </div>
                                </div>

                                <div class="mt-3">

                                    @if (currentlyCovered)
                                    {
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            <b>Liquidity Status:</b>
                                            As at today, the member’s eligible balances are sufficient to cover the outstanding loan balance.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger py-2 mb-2">
                                            <i class="mdi mdi-alert-circle-outline me-1"></i>
                                            <b>Liquidity Risk:</b>
                                            Current eligible balances are insufficient to fully cover the loan balance.
                                        </div>
                                    }

                                    <table class="table table-sm kv-table mb-0">
                                        <tr>
                                            <td class="k">Eligible Balances (Excl. Shares)</td>
                                            <td class="v">@Money(eligibleLiquidityNow)</td>
                                        </tr>
                                        <tr>
                                            <td class="k">Excluded (Shares)</td>
                                            <td class="v">@Money(excludedLiquidity)</td>
                                        </tr>
                                        <tr>
                                            <td class="k">Outstanding Loan Balance</td>
                                            <td class="v">@Money(currentLoanBalance)</td>
                                        </tr>
                                        <tr>
                                            <td class="k">Liquidity Gap</td>
                                            <td class="v @(liquidityGap >= 0 ? "text-success" : "text-danger")">
                                                @Money(liquidityGap)
                                            </td>
                                        </tr>
                                    </table>

                                    <div class="mt-2 text-muted small">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        This analysis uses <b>real-time account balances</b> and excludes shares.
                                        It complements the original loan application coverage and serves as a
                                        <b>risk monitoring indicator</b>.
                                    </div>

                                    @if (!currentlyCovered)
                                    {
                                        <div class="alert alert-warning py-2 mt-3 mb-0">
                                            <i class="mdi mdi-lightbulb-on-outline me-1"></i>
                                            <b>Advice:</b>
                                            Consider additional blocking, guarantor reinforcement, or closer repayment monitoring
                                            to mitigate liquidity risk.
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>


                        <!-- ===================== GUARANTORS LIST ===================== -->
                        <div class="col-lg-12">
                            @{
                                var totalGuar = guarantors.Sum(g => g?.GuaranteeAmount ?? 0m);
                                var guarPct = approvedAmount > 0m ? (totalGuar / approvedAmount) * 100m : 0m;

                                var guarStatus =
                                    !guarantors.Any() ? "NONE" :
                                    totalGuar <= 0m ? "INSUFFICIENT" :
                                    "PROVIDED";

                                var guarBadge =
                                    guarStatus == "PROVIDED" ? "bg-success" :
                                    guarStatus == "INSUFFICIENT" ? "bg-danger" :
                                    "bg-secondary";
                            }

                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-account-multiple-check-outline"></i> Guarantors & What They Cover
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">COUNT: @guarantors.Count</span>
                                        <span class="badge bg-light text-dark border">TOTAL: @Money(totalGuar)</span>
                                        <span class="badge bg-light text-dark border">COVER: @guarPct.ToString("0.00")%</span>
                                        <span class="badge @guarBadge">STATUS: @guarStatus</span>
                                    </div>
                                </div>

                                @if (!guarantors.Any())
                                {
                                    <div class="alert alert-info py-2 mt-3 mb-0">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        No guarantors were provided on this loan application.
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive mt-3">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="min-width:240px;">Guarantor</th>
                                                    <th style="min-width:120px;">Type</th>
                                                    <th style="min-width:160px;">Relationship</th>
                                                    <th style="min-width:140px;">Phone</th>
                                                    <th style="min-width:220px;">Account</th>
                                                    <th class="text-end" style="min-width:160px;">Guarantee Volume</th>
                                                    <th class="text-end" style="min-width:140px;">% of Approved</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var g in guarantors)
                                                {
                                                    var amt = g?.GuaranteeAmount ?? 0m;
                                                    var pct = approvedAmount > 0m ? (amt / approvedAmount) * 100m : 0m;

                                                    <tr>
                                                        <td class="fw-semibold">
                                                            @Txt(g?.GuarantorName)
                                                            <div class="text-muted small">ID: @Txt(g?.IdCardNumber)</div>
                                                        </td>
                                                        <td>@Txt(g?.GuarantorType)</td>
                                                        <td>@Txt(g?.Relationship)</td>
                                                        <td>
                                                            @Txt(g?.PhoneNumber)
                                                            @if (!string.IsNullOrWhiteSpace(g?.Email))
                                                            {
                                                                <div class="text-muted small">@Txt(g.Email)</div>
                                                            }
                                                        </td>
                                                        <td><span class="code-strong">@Txt(g?.AccountNumber)</span></td>
                                                        <td class="text-end fw-bold">@Money(amt)</td>
                                                        <td class="text-end">@pct.ToString("0.00")%</td>
                                                    </tr>
                                                }

                                                <tr class="table-light">
                                                    <td colspan="5" class="fw-bold">Total</td>
                                                    <td class="text-end fw-bold">@Money(totalGuar)</td>
                                                    <td class="text-end fw-bold">@guarPct.ToString("0.00")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-2 text-muted small">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        <b>Coverage per guarantor</b> is computed as <span class="code-strong">GuaranteeAmount ÷ ApprovedAmount</span>.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ===================== MEMBER ACCOUNTS + BLOCKING INTERFACE ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-lock-plus-outline"></i> Member Accounts & Blocking Controls
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="openBlockAccountModal()">
                                        <i class="mdi mdi-lock-outline me-1"></i> Block an Account
                                    </button>
                                </div>

                                <div class="text-muted small mt-2">
                                    Analysis is based on <b>current balances as at today</b>.
                                    Preference & Ordinary Shares are <b>excluded from coverage</b> but required for eligibility.
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="table table-sm table-hover align-middle mb-0" id="memberAccountsTable">

                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:180px;">Account Number</th>
                                                <th style="min-width:220px;">Account Name</th>

                                                <!-- NEW -->
                                                <th class="text-end" style="min-width:160px;">Actual Balance</th>

                                                <th class="text-end" style="min-width:160px;">Blocked</th>
                                                <th class="text-end" style="min-width:160px;">Available for Coverage</th>
                                                <th style="min-width:160px;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (!memberAccounts.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-3">
                                                        No member accounts found.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                foreach (var a in memberAccounts)
                                                {
                                                    var available = Math.Max(0m, a.Balance - a.BlockedAmount);

                                                    <tr>
                                                        <td class="code-strong">@Txt(a.AccountNumber)</td>
                                                        <td>@Txt(a.AccountName)</td>

                                                        <!-- Actual -->
                                                        <td class="text-end fw-bold">@Money(a.Balance)</td>

                                                        <!-- Blocked -->
                                                        <td class="text-end">@Money(a.BlockedAmount)</td>

                                                        <!-- Available -->
                                                        <td class="text-end @(available <= 0 ? "text-muted" : "fw-semibold")">
                                                            @Money(available)
                                                        </td>

                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-warning js-open-block"
                                                                    data-acct="@a.AccountNumber"
                                                                    data-name="@a.AccountName"
                                                                    data-type="@a.AccountType"
                                                                    data-balance="@a.Balance"
                                                                    data-blocked="@a.BlockedAmount"
                                                                    data-available="@(Math.Max(0m, a.Balance - a.BlockedAmount))"
                                                                    data-loanbalance="@loan.Balance"
                                                                    data-totaleligible="@eligibleLiquidityNow">
                                                                <i class="mdi mdi-lock-plus-outline me-1"></i> Block
                                                            </button>
                                                            @if (a.BlockedAmount > 0)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-success js-open-release ms-1"
                                                                        data-acct="@a.AccountNumber"
                                                                        data-name="@a.AccountName"
                                                                        data-type="@a.AccountType"
                                                                        data-balance="@a.Balance"
                                                                        data-blocked="@a.BlockedAmount"
                                                                        data-loanbalance="@loan.Balance"
                                                                        data-totaleligible="@eligibleLiquidityNow">
                                                                    <i class="mdi mdi-lock-open-outline me-1"></i> Release
                                                                </button>
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>

                                        <!-- ===================== FOOTER TOTALS ===================== -->
                                        <tfoot class="table-light">
                                            <tr class="fw-bold">
                                                <td colspan="2">TOTAL</td>
                                                <td class="text-end">@Money(totalActual)</td>
                                                <td class="text-end">@Money(totalBlocked)</td>
                                                <td class="text-end">@Money(totalAvailable)</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>

                                    </table>
                                </div>

                                @if (mustBlockSavings && missingSavingsBlock > 0m)
                                {
                                    <div class="alert alert-warning py-2 mt-3 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i>
                                        <b>Blocking Required:</b>
                                        Additional savings to block:
                                        <b>@Money(missingSavingsBlock)</b>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ===================== OLD VS CURRENT ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">
                                <div class="loan-card-title"><i class="mdi mdi-compare"></i> Old vs Current (Restructure / Adjustments)</div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Previous Values</td>
                                    </tr>
                                    <tr><td class="k">Old Capital</td><td class="v">@Money(loan.LoanApplication.OldLoanCapital)</td></tr>
                                    <tr><td class="k">Old Interest</td><td class="v">@Money(loan.LoanApplication.OldLoanInterest)</td></tr>
                                    <tr><td class="k">Old VAT</td><td class="v">@Money(loan.LoanApplication.OldLoanVat)</td></tr>
                                    <tr><td class="k">Old Penalty</td><td class="v">@Money(loan.LoanApplication.OldLoanPenalty)</td></tr>
                                    <tr><td class="k">Old Balance</td><td class="v">@Money(loan.LoanApplication.RestructuredBalance)</td></tr>
                                </table>
                            </div>
                        </div>
                    </div>



                </div>


                <div class="tab-pane fade" id="t_application">
                    @{
                        var hasApp = app != null;
                        var savingCoverage = hasApp ? (app.SavingAccountCoverageRate / 100m) * app.RequestedAmount : 0m;
                        var totalRefinancing = hasApp ? (app.RequestedAmount + app.RestructuredBalance) : 0m;
                        var fees = hasApp ? (app.LoanApplicationFees ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanApplicationFee>()) : new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanApplicationFee>();
                    }

                    <div class="app-card">
                        <div class="app-hd">
                            <p class="app-title"><i class="mdi mdi-file-document-edit-outline"></i> Loan Application</p>
                            <p class="app-hint">Complete application details used to originate this loan.</p>
                        </div>

                        <div class="app-bd">
                            @if (!hasApp)
                            {
                                <div class="alert alert-light border mb-0">
                                    <i class="mdi mdi-alert-circle-outline"></i>
                                    No Loan Application found for this loan.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped app-table mb-0">
                                        <tbody>

                                            <!-- General Information -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">GENERAL INFORMATION</td>
                                            </tr>
                                            <tr><td>Member Code</td><td>@app.CustomerId</td></tr>
                                            <tr><td>Loan Application Code</td><td>@app.Id</td></tr>
                                            <tr>
                                                <td>Loan Application Type</td>
                                                <td>
                                                    @if ((app.LoanApplicationType ?? "Normal") != "Normal")
                                                    {
                                                        <span class="badge bg-warning text-dark">@app.LoanApplicationType</span>
                                                        if (!string.IsNullOrWhiteSpace(app.LoanId))
                                                        {
                                                            <br />
                                                            <a href="@Url.Action("LoanDetails","Loan", new { loanId = app.LoanId })" target="_blank">
                                                                Details &raquo; @app.LoanId
                                                            </a>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary text-white">New Loan</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Loan Type</td>
                                                <td>
                                                    @if ((app.LoanType ?? "") == "Main_Loan")
                                                    {
                                                        <span class="badge bg-primary text-white">@app.LoanType</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@app.LoanType</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr><td>Loan Category</td><td>@app.LoanCategory</td></tr>
                                            <tr><td>Targeted Population</td><td>@app.LoanTarget</td></tr>

                                            <!-- Product Information -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">PRODUCT INFORMATION</td>
                                            </tr>
                                            <tr><td>Product Code</td><td>@app.LoanProduct.ProductCode</td></tr>
                                            <tr><td>Product Name</td><td>@app.LoanProduct.ProductName</td></tr>
                                            <tr><td>Product Term</td><td>@app.LoanProduct.LoanTerm.Name</td></tr>

                                            <!-- Application Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">APPLICATION DETAILS</td>
                                            </tr>
                                            <tr><td>Application Date</td><td>@(app.ApplicationDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>Approval Date</td><td>@(app.ApprovalDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>Disbursement Date</td><td>@(app.DisbursementDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>Loan Manager</td><td>@app.LoanManager</td></tr>

                                            <!-- Migration Status -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">MIGRATION STATUS</td>
                                            </tr>
                                            <tr>
                                                <td>Migrated Loan</td>
                                                <td>
                                                    @if (!app.IsUpload)
                                                    {
                                                        <span class="badge bg-primary text-white">TSC Loan</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Migrated Loan</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Refinancing Details -->
                                            @if ((app.LoanApplicationType ?? "") == "Refinancing")
                                            {
                                                <tr class="app-sec">
                                                    <td colspan="2" class="text-center">REFINANCING DETAILS</td>
                                                </tr>
                                                <tr><td>Requested Amount</td><td>@app.RequestedAmount.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Restructured Balance</td><td>@app.RestructuredBalance.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Refinanced Amount</td><td>@totalRefinancing.ToString("#,##0.0") FCFA</td></tr>

                                                <tr class="app-subsec">
                                                    <td colspan="2" class="text-center">OLD LOAN INFORMATION</td>
                                                </tr>
                                                <tr><td>Old Loan Amount</td><td>@app.OldLoanAmount.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Old Loan Capital</td><td>@app.OldLoanCapital.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Old Loan Interest</td><td>@app.OldLoanInterest.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Old Loan VAT</td><td>@app.OldLoanVat.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>Old Loan Penalty</td><td>@app.OldLoanPenalty.ToString("#,##0.0") FCFA</td></tr>
                                            }

                                            <!-- Loan Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">LOAN DETAILS</td>
                                            </tr>
                                            <tr><td>Loan Product ID</td><td>@app.LoanProductId</td></tr>
                                            <tr><td>Total Loan Amount</td><td><strong>@app.Amount.ToString("#,##0.0") FCFA</strong></td></tr>
                                            <tr><td>Interest Rate</td><td>@app.InterestRate.ToString("#,##0.0")%</td></tr>
                                            <tr><td>Loan Manager</td><td>@app.LoanManager</td></tr>

                                            <tr>
                                                <td>Fees</td>
                                                <td>
                                                    @if (app.LoanApplicationFees != null && app.LoanApplicationFees.Any())
                                                    {
                                                        <ul class="list-unstyled mb-1">
                                                            @foreach (var fi in app.LoanApplicationFees)
                                                            {
                                                                <li>@fi.FeeLable: @(fi.FeeAmount.ToString("#,##0.0") + " FCFA")</li>
                                                            }
                                                        </ul>
                                                        <div class="mt-1">
                                                            <strong>Total Fee Amount:</strong> @app.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.0") FCFA<br />
                                                            <strong>Total Amount Paid:</strong> @app.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.0") FCFA
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No fee added.</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Downpayments and Coverage -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">DOWNPAYMENTS & COVERAGE</td>
                                            </tr>
                                            <tr><td>Total Downpayment Provided</td><td><strong>@app.DownPaymentCoverageAmountProvided.ToString("#,##0.0") FCFA</strong></td></tr>
                                            <tr><td>Share Covered Amount</td><td>@app.ShareAccountCoverageAmount.ToString("#,##0.0") FCFA</td></tr>
                                            <tr><td>Saving Coverage Provided</td><td>@app.SavingAccountCoverageRate.ToString("#,##0.0")% of @app.RequestedAmount.ToString("#,##0"): [@savingCoverage.ToString("#,##0")] FCFA</td></tr>

                                            <tr>
                                                <td>Preference Share Coverage Used</td>
                                                <td>
                                                    @if (app.IsPreferenceShareAccountCoverageAmount)
                                                    {
                                                        <span class="badge bg-primary text-white">Yes — Coverage Amount: @app.PreferenceShareAccountCoverageAmount.ToString("#,##0.0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">No</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Deposit Coverage Used</td>
                                                <td>
                                                    @if (app.IsDepositAccountCoverageAmount)
                                                    {
                                                        <span class="badge bg-primary text-white">Yes — Coverage Amount: @app.DepositAccountCoverageAmount.ToString("#,##0.0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">No</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Additional Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">ADDITIONAL DETAILS</td>
                                            </tr>
                                            <tr><td>VAT Rate</td><td>@app.VatRate.ToString("#,##0.0")%</td></tr>
                                            <tr><td>Grace Period before 1st Installment</td><td>@app.GracePeriodBeforeFirstPayment Months</td></tr>
                                            <tr><td>Grace Period after Due Date</td><td>@app.GracePeriodAfterMaturityDate Days</td></tr>
                                            <tr><td>Approval Status</td><td>@app.ApprovalStatus</td></tr>
                                            <tr>
                                                <td>Approved</td>
                                                <td>
                                                    @if (app.IsApproved)
                                                    {<span class="badge bg-primary text-white">Approved</span> }
                                                    else
                                                    { <span class="badge bg-warning text-dark">Pending</span>}
                                                </td>
                                            </tr>

                                            <!-- Guarantors -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">GUARANTORS</td>
                                            </tr>
                                            @if (app.Guarantors?.Any() == true)
                                            {
                                                foreach (var g in app.Guarantors)
                                                {
                                                    <tr><td>Guarantor Name</td><td>@g.GuarantorName</td></tr>
                                                    <tr><td>Relationship</td><td>@g.Relationship</td></tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">No guarantors provided.</td></tr>
                                            }

                                            <!-- Collateral -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">COLLATERAL</td>
                                            </tr>
                                            @if (app.Collateras?.Any() == true)
                                            {
                                                foreach (var c in app.Collateras)
                                                {
                                                    <tr><td>Collateral Type / Location</td><td>@c.Location</td></tr>
                                                    <tr><td>Collateral Value</td><td>@c.Amount.ToString("#,##0.0") FCFA</td></tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">No collateral provided.</td></tr>
                                            }

                                            <!-- Attached Documents -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">ATTACHED DOCUMENTS</td>
                                            </tr>
                                            @if (app.DocumentAttachedToLoans?.Any() == true)
                                            {
                                                foreach (var d in app.DocumentAttachedToLoans)
                                                {
                                                    <tr><td>Document</td><td>@d.FileName @d.FileExtension</td></tr>
                                                    <tr><td>Uploaded</td><td>@d.Date.ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                                                    <tr>
                                                        <td>Open</td>
                                                        <td>
                                                            <a href="@d.FilePath" target="_blank" class="btn btn-sm btn-primary">
                                                                <i class="mdi mdi-open-in-new"></i> Read Content
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">No documents attached.</td></tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="t_contract">
                    @{
                        // Detect a contract-like document by name
                        var contractDoc = docs.FirstOrDefault(d =>
                            ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("contract", StringComparison.OrdinalIgnoreCase) >= 0
                            || ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("contrat", StringComparison.OrdinalIgnoreCase) >= 0
                            || ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("agreement", StringComparison.OrdinalIgnoreCase) >= 0
                        );

                        var contractPath = contractDoc?.FilePath;
                        var isPdf = !string.IsNullOrWhiteSpace(contractPath) && contractPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                    }

                    <div class="row g-3">
                        <div class="col-lg-5">
                            <div class="app-card">
                                <div class="app-hd">
                                    <p class="app-title"><i class="mdi mdi-file-sign"></i> Application Contract</p>
                                    <p class="app-hint">Contract reference & document access.</p>
                                </div>
                                <div class="app-bd">
                                    <table class="table table-bordered table-striped mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="fw-bold" style="width:42%;background:#fafafa;">Contract Code</td>
                                                <td>@(loan?.LoanContractCode ?? "N/A")</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold" style="background:#fafafa;">Contract Document</td>
                                                <td>
                                                    @if (contractDoc == null || string.IsNullOrWhiteSpace(contractPath))
                                                    {
                                                        <span class="text-muted">No contract document detected. Upload a file named “contract/contrat/agreement”.</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex gap-2 flex-wrap align-items-center">
                                                            <span class="badge bg-light text-dark border">
                                                                @contractDoc.FileName@contractDoc.FileExtension
                                                            </span>
                                                            <a class="btn btn-sm btn-primary" target="_blank" href="@contractPath">
                                                                <i class="mdi mdi-open-in-new"></i> Open
                                                            </a>
                                                        </div>
                                                        <div class="text-muted small mt-2">Uploaded: @contractDoc.Date.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <div class="small text-muted mt-2">
                                        Tip: PDF previews render inside the page. Other formats open in a new tab.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="app-card">
                                <div class="app-hd">
                                    <p class="app-title"><i class="mdi mdi-eye-outline"></i> Contract Preview</p>
                                    <p class="app-hint">Preview available for PDF contracts.</p>
                                </div>
                                <div class="app-bd">
                                    @if (string.IsNullOrWhiteSpace(contractPath))
                                    {
                                        <div class="alert alert-light border mb-0">
                                            <i class="mdi mdi-information-outline"></i> No contract file to preview.
                                        </div>
                                    }
                                    else if (isPdf)
                                    {
                                        <iframe src="@contractPath"
                                                style="width:100%;height:560px;border:1px solid #e5e7eb;border-radius:12px;"></iframe>
                                    }
                                    else
                                    {
                                        <div class="alert alert-light border mb-0">
                                            <i class="mdi mdi-alert-circle-outline"></i>
                                            Preview is best for PDF. Click <b>Open</b> to view this document.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===================== FINANCIALS (PRO + POLICY-AWARE) ===================== -->
                <div class="tab-pane fade" id="t_financials">


                    <div class="row g-3">

                        <!-- ===================== LEFT: FINANCIAL SNAPSHOT ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-cash-multiple"></i> Financial Snapshot
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">POSITION</span>
                                        <span class="badge @(balance > 0 ? "bg-warning text-dark" : "bg-success")">BAL: @Money(balance)</span>
                                        <span class="badge @(due > 0 ? "bg-danger" : "bg-success")">DUE: @Money(due)</span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Core Amounts</td></tr>
                                    <tr><td class="k">Loan Amount (Approved)</td><td class="v">@Money(approvedAmount)</td></tr>
                                    <tr><td class="k">Requested Amount</td><td class="v">@Money(requestedAmount)</td></tr>
                                    <tr><td class="k">Principal</td><td class="v">@Money(principal)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Position</td></tr>
                                    <tr><td class="k">Paid</td><td class="v text-success">@Money(paid)</td></tr>
                                    <tr><td class="k">Balance</td><td class="v text-danger">@Money(balance)</td></tr>
                                    <tr><td class="k">Due Amount</td><td class="v text-warning">@Money(due)</td></tr>
                                    <tr><td class="k">Total Principal Paid</td><td class="v">@Money(loan.TotalPrincipalPaid)</td></tr>
                                    <tr><td class="k">Restructured Balance</td><td class="v">@Money(loan.RestructuredBalance)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Flags</td></tr>
                                    <tr><td class="k">Mortgage</td><td class="v">@(loan.IsMortgage ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Interest Running</td><td class="v">@(app?.IsInterestRunning == true ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Stop Interest</td><td class="v">@(app?.StopInterestCalculation == true ? "YES" : "NO")</td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- ===================== RIGHT: INTEREST / VAT / CHARGES ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-percent-outline"></i> Interest, VAT & Charges
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">RATES</span>
                                        <span class="badge bg-light text-dark border">INT: @Percent(intRate)</span>
                                        <span class="badge bg-light text-dark border">VAT: @Percent(vatRate)</span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Rates</td></tr>
                                    <tr><td class="k">Interest Rate</td><td class="v">@Percent(intRate)</td></tr>
                                    <tr><td class="k">VAT Rate</td><td class="v">@Percent(vatRate)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Interest</td></tr>
                                    <tr><td class="k">Forecasted</td><td class="v">@Money(intForecast)</td></tr>
                                    <tr><td class="k">Accrued</td><td class="v">@Money(intAccrued)</td></tr>
                                    <tr><td class="k">Last Calculated</td><td class="v">@Money(intLastCalc)</td></tr>
                                    <tr><td class="k">Accrued Paid</td><td class="v">@Money(intAccruedPaid)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">VAT / Tax</td></tr>
                                    <tr><td class="k">Tax</td><td class="v">@Money(tax)</td></tr>
                                    <tr><td class="k">Tax Paid</td><td class="v">@Money(taxPaid)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Fees & Penalties</td></tr>
                                    <tr><td class="k">Fee</td><td class="v">@Money(fee)</td></tr>
                                    <tr><td class="k">Fee Paid</td><td class="v">@Money(feePaid)</td></tr>
                                    <tr><td class="k">Penalty</td><td class="v">@Money(penalty)</td></tr>
                                    <tr><td class="k">Penalty Paid</td><td class="v">@Money(penaltyPaid)</td></tr>
                                    <tr><td class="k">Last Penalty</td><td class="v">@Money(lastPenalty)</td></tr>
                                    <tr><td class="k">Penalty Calc Date</td><td class="v">@FDateNullable(penaltyCalcDate)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Upfront Interest (Policy)</td></tr>
                                    <tr><td class="k">Paid Upfront?</td><td class="v">@(paidUpfront ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Upfront Amount</td><td class="v">@Money(upfrontAmount)</td></tr>

                                </table>
                            </div>
                        </div>



                    </div>


                </div>
            </div>

            <!-- ===================== REPAYMENTS ===================== -->
            <div class="tab-pane fade" id="t_repayment">
                <div class="row g-3">

                    @{
                        // totals for quick badges + footer
                        var totalPaid = refunds?.Sum(x => x.Amount) ?? 0m;
                        var totalPaidInterest = refunds?.Sum(x => x.Interest) ?? 0m;
                        var totalPaidVat = refunds?.Sum(x => x.Tax) ?? 0m;
                        var totalPaidPenalty = refunds?.Sum(x => x.Penalty) ?? 0m;
                        var totalPaidAll = totalPaid + totalPaidInterest + totalPaidVat + totalPaidPenalty;

                        // amort totals (optional)
                        var totalDuePrincipal = amort?.Sum(x => x.Principal) ?? 0m;
                        var totalDueInterest = amort?.Sum(x => x.Interest) ?? 0m;
                        var totalDueVat = amort?.Sum(x => x.Tax) ?? 0m;
                        var totalDueAll = amort?.Sum(x => x.TotalDue) ?? 0m;
                    }

                    <!-- Summary -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-history"></i> Repayment Summary
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-light text-dark border">REFUNDS: @refunds.Count</span>
                                    <span class="badge bg-light text-dark border">AMORT: @amort.Count</span>
                                    <span class="badge @(totalPaidAll > 0 ? "bg-success" : "bg-secondary")">
                                        TOTAL PAID: @Money(totalPaidAll)
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Terms -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Terms</td></tr>
                                <tr><td class="k">Cycle</td><td class="v">@Txt(loan.RepaymentCycle)</td></tr>
                                <tr><td class="k">Installments</td><td class="v">@loan.NumberOfInstallments</td></tr>
                                <tr><td class="k">Duration</td><td class="v">@loan.LoanDuration</td></tr>
                                <tr><td class="k">Term</td><td class="v">@Txt(loan.LoanTermName)</td></tr>

                                <!-- Last payment -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Latest</td></tr>
                                <tr><td class="k">Last Payment</td><td class="v">@Money(loan.LastPayment)</td></tr>
                                <tr><td class="k">Refund Count</td><td class="v">@loan.RefundCount</td></tr>
                                <tr><td class="k">Last Refund Amount</td><td class="v">@MoneyN(loan.LastRefundAmount)</td></tr>
                                <tr><td class="k">Last Refund Ref</td><td class="v">@Txt(loan.LastRefundReference)</td></tr>

                                <!-- Totals paid -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Totals Paid (Refunds)</td></tr>
                                <tr><td class="k">Principal Paid</td><td class="v text-success">@Money(totalPaid)</td></tr>
                                <tr><td class="k">Interest Paid</td><td class="v">@Money(totalPaidInterest)</td></tr>
                                <tr><td class="k">VAT Paid</td><td class="v">@Money(totalPaidVat)</td></tr>
                                <tr><td class="k">Penalty Paid</td><td class="v">@Money(totalPaidPenalty)</td></tr>
                                <tr><td class="k">Total Paid</td><td class="v fw-bold">@Money(totalPaidAll)</td></tr>

                            </table>

                            <div class="small-note mt-2">
                                Tip: Use the search boxes to audit refunds and schedule quickly.
                            </div>
                        </div>
                    </div>

                    <!-- Listings card -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-format-list-bulleted"></i> Listings
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="pill"><span class="k">Refunds</span><span class="v">@refunds.Count</span></span>
                                    <span class="pill"><span class="k">Amort</span><span class="v">@amort.Count</span></span>
                                    <span class="pill"><span class="k">Docs</span><span class="v">@docs.Count</span></span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Schedule Totals (Amort)</td></tr>
                                <tr><td class="k">Total Due</td><td class="v fw-bold">@Money(totalDueAll)</td></tr>
                                <tr><td class="k">Principal Due</td><td class="v">@Money(totalDuePrincipal)</td></tr>
                                <tr><td class="k">Interest Due</td><td class="v">@Money(totalDueInterest)</td></tr>
                                <tr><td class="k">VAT Due</td><td class="v">@Money(totalDueVat)</td></tr>
                            </table>

                            <div class="small-note mt-2">Lists below are scrollable and searchable.</div>
                        </div>
                    </div>

                    <!-- Refunds -->
                    <div class="col-lg-12">
                        <div class="loan-card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-cash-check"></i> Repayment History (Refunds)
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    <input class="form-control form-control-sm" style="max-width:260px"
                                           placeholder="Search refunds..." onkeyup="filterTable(this,'refundTable')" />
                                </div>
                            </div>

                            <div class="list-scroll">
                                <table class="table table-sm table-striped table-hover table-tight mb-0" id="refundTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width:160px;">Date</th>
                                            <th class="text-end" style="min-width:120px;">Principal</th>
                                            <th class="text-end" style="min-width:110px;">Interest</th>
                                            <th class="text-end" style="min-width:90px;">VAT</th>
                                            <th class="text-end" style="min-width:100px;">Penalty</th>

                                            <!-- NEW -->
                                            <th class="text-end" style="min-width:140px;">Total Paid</th>

                                            <!-- Details -->
                                            <th style="min-width:140px;">Channel</th>
                                            <th style="min-width:220px;">Details</th>
                                            <th style="min-width:180px;">Reference</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (refunds.Any())
                                        {
                                            foreach (var r in refunds)
                                            {
                                                var rowTotal = (r.Amount + r.Interest + r.Tax + r.Penalty);

                                                <tr>
                                                    <td>
                                                        @if (r.DateOfPayment == DateTime.MinValue)
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold">@r.DateOfPayment.ToString("dd/MM/yyyy")</span>
                                                            <div class="small-note text-muted">@r.DateOfPayment.ToString("HH:mm:ss")</div>
                                                        }
                                                    </td>

                                                    <td class="text-end">@r.Amount.ToString("N0")</td>
                                                    <td class="text-end">@r.Interest.ToString("N0")</td>
                                                    <td class="text-end">@r.Tax.ToString("N0")</td>
                                                    <td class="text-end">@r.Penalty.ToString("N0")</td>

                                                    <!-- NEW total -->
                                                    <td class="text-end fw-bold">@rowTotal.ToString("N0")</td>

                                                    <td>@r.PaymentChannel</td>

                                                    <!-- NEW details (audit friendly) -->
                                                    <td>
                                                        <div class="small-note">
                                                            <span class="text-muted">Method:</span> <b>@Txt(r.PaymentMethod)</b>
                                                            @* Add more fields here if your Refund model has them *@
                                                            @* • Teller: @Txt(r.TellerName) • TxRef: @Txt(r.TransactionReference) *@
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <span class="text-muted">@Txt(r.PaymentMethod)</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="9" class="text-center text-muted p-3">No refunds found for this loan.</td></tr>
                                        }
                                    </tbody>

                                    @if (refunds.Any())
                                    {
                                        <tfoot class="table-light">
                                            <tr>
                                                <td class="fw-bold">Totals</td>
                                                <td class="text-end fw-bold">@totalPaid.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidInterest.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidVat.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidPenalty.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidAll.ToString("N0")</td>
                                                <td colspan="3"></td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Amortization -->
                    <div class="col-lg-12">
                        <div class="loan-card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-calendar-month-outline"></i> Amortization Schedule
                                </div>
                                <input class="form-control form-control-sm" style="max-width:260px"
                                       placeholder="Search amortization..." onkeyup="filterTable(this,'amortTable')" />
                            </div>

                            <div class="list-scroll">
                                <table class="table table-sm table-striped table-hover table-tight mb-0" id="amortTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width:60px;">#</th>
                                            <th style="min-width:140px;">Due Date</th>
                                            <th class="text-end" style="min-width:120px;">Principal</th>
                                            <th class="text-end" style="min-width:110px;">Interest</th>
                                            <th class="text-end" style="min-width:90px;">VAT</th>
                                            <th class="text-end" style="min-width:120px;">Total</th>
                                            <th style="min-width:120px;">Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (amort.Any())
                                        {
                                            var i = 1;
                                            foreach (var a in amort)
                                            {
                                                <tr>
                                                    <td>@i</td>
                                                    <td>@(a.DateOfPayment == DateTime.MinValue ? "-" : a.DateOfPayment.ToString("dd/MM/yyyy"))</td>
                                                    <td class="text-end">@a.Principal.ToString("N0")</td>
                                                    <td class="text-end">@a.Interest.ToString("N0")</td>
                                                    <td class="text-end">@a.Tax.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@a.TotalDue.ToString("N0")</td>
                                                    <td>@a.Status</td>
                                                </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="7" class="text-center text-muted p-3">No amortization schedule found.</td></tr>
                                        }
                                    </tbody>

                                    @if (amort.Any())
                                    {
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="2" class="fw-bold">Totals</td>
                                                <td class="text-end fw-bold">@totalDuePrincipal.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueInterest.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueVat.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueAll.ToString("N0")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>

                            <div class="small-note mt-2">
                                Note: If empty, ensure <code>LoanAmortizations</code> is loaded server-side.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===================== RISK ===================== -->
            <div class="tab-pane fade" id="t_risk">
                <div class="row g-3">

                    @{
                        var isDelinquent = loan.IsDeliquentLoan;
                        var delinquentDays = loan.DeliquentDays;

                        // severity (simple + clear)
                        var sevClass =
                            delinquentDays >= 90 ? "sev-critical" :
                            delinquentDays >= 30 ? "sev-high" :
                            delinquentDays >= 1 ? "sev-med" : "sev-ok";

                        var sevText =
                            delinquentDays >= 90 ? "CRITICAL" :
                            delinquentDays >= 30 ? "HIGH" :
                            delinquentDays >= 1 ? "MED" : "OK";
                    }

                    <!-- ===================== DELINQUENCY ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-alert-decagram-outline"></i> Delinquency
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge badge-sev @sevClass">
                                        <span class="dot"></span> @sevText
                                    </span>

                                    <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                        @(isDelinquent ? "DELINQUENT" : "OK")
                                    </span>

                                    <span class="badge @(delinquentDays > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        DAYS: @delinquentDays.ToString("N0")
                                    </span>

                                    <span class="badge bg-light text-dark border">
                                        PAR: @Txt(loan.PAR)
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Status -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Status</td></tr>
                                <tr>
                                    <td class="k">Is Delinquent</td>
                                    <td class="v">
                                        <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                            @(isDelinquent ? "YES" : "NO")
                                        </span>
                                        @if (isDelinquent && delinquentDays > 0)
                                        {
                                            <span class="text-muted ms-2">• Severity: <b class="sev-text @sevClass">@sevText</b></span>
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <td class="k">Delinquent Days</td>
                                    <td class="v">
                                        <b class="sev-text @sevClass">@delinquentDays.ToString("N0")</b>
                                        @if (delinquentDays == 0)
                                        {
                                            <span class="text-muted ms-2">• On-time</span>
                                        }
                                    </td>
                                </tr>

                                <tr><td class="k">Delinquent Status</td><td class="v">@Txt(loan.DeliquentStatus)</td></tr>

                                <!-- Amounts -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Amounts</td></tr>
                                <tr>
                                    <td class="k">Delinquent Amount</td>
                                    <td class="v">
                                        <span class="fw-bold @(loan.DeliquentAmount > 0 ? "text-danger" : "text-muted")">
                                            @Money(loan.DeliquentAmount)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="k">Delinquent Interest</td>
                                    <td class="v">@Money(loan.DeliquentInterest)</td>
                                </tr>

                                <!-- Configuration -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Configuration</td></tr>
                                <tr><td class="k">PAR Bucket</td><td class="v">@Txt(loan.PAR)</td></tr>
                                <tr><td class="k">Config Name</td><td class="v">@Txt(loan.LoanDeliquencyConfigurationName)</td></tr>
                                <tr><td class="k">Last Processed</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                            </table>

                            @if (isDelinquent && delinquentDays >= 30)
                            {
                                <div class="alert alert-warning py-2 mt-2 mb-0">
                                    <i class="mdi mdi-alert-outline me-1"></i>
                                    <b>Attention:</b> This loan is past due. Review collection actions and COBAC classification.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ===================== PENALTY ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-gavel"></i> Penalty
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge @(loan.Penalty > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        PEN: @Money(loan.Penalty)
                                    </span>
                                    <span class="badge @(loan.PenaltyPaid > 0 ? "bg-success" : "bg-light text-dark border")">
                                        PAID: @Money(loan.PenaltyPaid)
                                    </span>
                                    <span class="badge @(loan.IsWriteOffLoan ? "bg-danger" : "bg-light text-dark border")">
                                        W/O: @(loan.IsWriteOffLoan ? "YES" : "NO")
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">
                                <tr class="table-light"><td colspan="2" class="fw-bold small">Amounts</td></tr>
                                <tr><td class="k">Penalty</td><td class="v fw-bold @(loan.Penalty > 0 ? "text-warning" : "text-muted")">@Money(loan.Penalty)</td></tr>
                                <tr><td class="k">Penalty Paid</td><td class="v @(loan.PenaltyPaid > 0 ? "text-success" : "text-muted")">@Money(loan.PenaltyPaid)</td></tr>

                                <tr class="table-light"><td colspan="2" class="fw-bold small">Calculation</td></tr>
                                <tr><td class="k">Last Calc Date</td><td class="v">@FDateNullable(loan.LastPenaltyCalculationDate)</td></tr>
                                <tr><td class="k">Last Calc Amount</td><td class="v">@Money(loan.LastCalculatedPenaltyAmount)</td></tr>

                                <tr class="table-light"><td colspan="2" class="fw-bold small">Flags</td></tr>
                                <tr>
                                    <td class="k">Write-Off</td>
                                    <td class="v">
                                        <span class="badge @(loan.IsWriteOffLoan ? "bg-danger" : "bg-light text-dark border")">
                                            @(loan.IsWriteOffLoan ? "YES" : "NO")
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- ===================== INTEREST STOP / CONTROLS ===================== -->
                    <div class="col-lg-12">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-lock-outline"></i> Interest Controls
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge @(stopInterest ? "bg-dark" : "bg-light text-dark border")">
                                        INT: @(stopInterest ? "STOPPED" : "RUNNING")
                                    </span>

                                    @if (stopInterest && stopDateMissing)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="mdi mdi-alert-circle-outline me-1"></i> STOP DATE MISSING
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-md-3">
                                    <div class="small-note">Stop Interest</div>
                                    <div class="fw-bold">@(stopInterest ? "YES" : "NO")</div>
                                </div>

                                <div class="col-md-3">
                                    <div class="small-note">Stopped By</div>
                                    <div class="fw-bold">@Txt(loan.StoppedBy)</div>
                                </div>

                                <div class="col-md-3">
                                    <div class="small-note">Stop Date</div>
                                    <div class="fw-bold">
                                        @if (stopInterest && stopDateMissing)
                                        {
                                            <span class="text-danger fw-bold">STOPPED BUT DATE MISSING</span>
                                        }
                                        else
                                        {
                                            @FDate(loan.DateInterestWastStoped)
                                        }
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="small-note">Comment</div>
                                    <div class="fw-bold">@Txt(loan.InterestStoppedComment)</div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- ===================== PRODUCT & PURPOSE ===================== -->
            <div class="tab-pane fade" id="t_product">
                <div class="row g-3">


                    <!-- ===================== PRODUCT ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-package-variant-closed"></i> Product
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge @(isMortgage ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        MORT: @(isMortgage ? "YES" : "NO")
                                    </span>

                                    <!-- ✅ TAX badge (very visible) -->
                                    <span class="badge badge-tax @(taxable ? "badge-taxable" : "badge-nontaxable")">
                                        <span class="dot"></span>
                                        TAX: @(taxable ? "TAXABLE" : "NON-TAXABLE")
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Product Identity -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Identity</td>
                                </tr>
                                <tr>
                                    <td class="k">Code</td>
                                    <td class="v fw-bold">@Txt(product?.ProductCode)</td>
                                </tr>
                                <tr>
                                    <td class="k">Name</td>
                                    <td class="v">@Txt(product?.ProductName)</td>
                                </tr>
                                <tr>
                                    <td class="k">Loan Product Id</td>
                                    <td class="v">@Txt(loan?.LoanApplication?.LoanProductId)</td>
                                </tr>

                                <!-- Term -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Term</td>
                                </tr>
                                <tr>
                                    <td class="k">Term Name</td>
                                    <td class="v">@Txt(loan.LoanTermName) @Txt(loan?.LoanApplication?.LoanTermName)</td>
                                </tr>
                                <tr>
                                    <td class="k">Term Id</td>
                                    <td class="v">@Txt(loan.LoanTermId)</td>
                                </tr>

                                <!-- Flags -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Flags</td>
                                </tr>
                                <tr>
                                    <td class="k">Mortgage?</td>
                                    <td class="v">
                                        <span class="badge @(isMortgage ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            @(isMortgage ? "YES" : "NO")
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="k">Tax Status</td>
                                    <td class="v">
                                        <span class="badge badge-tax @(taxable ? "badge-taxable" : "badge-nontaxable")">
                                            <span class="dot"></span>
                                            @(taxable ? "TAXABLE" : "NON-TAXABLE")
                                        </span>
                                        <span class="text-muted ms-2">• @Txt(loan.TaxableStatus)</span>
                                    </td>
                                </tr>

                            </table>

                            <div class="small-note mt-2">
                                Tip: Product fields come from <b>LoanApplication → LoanProduct</b>. Ensure it is included in <code>GetLoan()</code>.
                            </div>
                        </div>
                    </div>

                    <!-- ===================== PURPOSE & TARGET ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-target-account"></i> Purpose & Target
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    @if (!string.IsNullOrWhiteSpace(loan.PcmfPurposeCode))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            PCMF: @Txt(loan.PcmfPurposeCode)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(loan.TargetType))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            TARGET: @Txt(loan.TargetType)
                                        </span>
                                    }
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Purpose -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Purpose</td>
                                </tr>
                                <tr>
                                    <td class="k">Purpose Name</td>
                                    <td class="v fw-bold">@Txt(loan.PurposeName)</td>
                                </tr>
                                <tr>
                                    <td class="k">PCMF Purpose Id</td>
                                    <td class="v">@Txt(loan.PcmfLoanPurposeId)</td>
                                </tr>
                                <tr>
                                    <td class="k">PCMF Key</td>
                                    <td class="v">@Txt(loan.PcmfPurposeKey)</td>
                                </tr>
                                <tr>
                                    <td class="k">PCMF Code</td>
                                    <td class="v">@Txt(loan.PcmfPurposeCode)</td>
                                </tr>
                                <tr>
                                    <td class="k">PCMF Slug</td>
                                    <td class="v">@Txt(loan.PcmfPurposeSlug)</td>
                                </tr>

                                <!-- Target -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Target</td>
                                </tr>
                                <tr>
                                    <td class="k">Target Type</td>
