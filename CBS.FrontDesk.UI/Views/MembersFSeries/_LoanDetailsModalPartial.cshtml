                                <tr><td class="k">LoanAppId</td><td class="v fw-bold">@Txt(loan.LoanApplicationId)</td></tr>
                                <tr><td class="k">Loan Id (Legacy)</td><td class="v">@Txt(loan.LoanId)</td></tr>
                                <tr><td class="k">Account No.</td><td class="v">@Txt(loan.AccountNumber)</td></tr>

                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Mapping Keys</td>
                                </tr>
                                <tr><td class="k">Loan Term Id</td><td class="v">@Txt(loan.LoanTermId)</td></tr>
                                <tr><td class="k">Loan Target Id</td><td class="v">@Txt(loan.LoanTargetId)</td></tr>
                                <tr><td class="k">PCMF Purpose Id</td><td class="v">@Txt(loan.PcmfLoanPurposeId)</td></tr>

                            </table>

                            <div class="small-note mt-2">
                                Tip: These ids are the main join keys for audit + reconciliation.
                            </div>
                        </div>
                    </div>

                    <!-- ===================== HEALTH CHECKS ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-file-cog-outline"></i> Data Health
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-light text-dark border">DOCS: @docs.Count</span>
                                    <span class="badge bg-light text-dark border">RFDS: @refunds.Count</span>
                                    <span class="badge bg-light text-dark border">AMRT: @amort.Count</span>

                                    <span class="badge @(isDelinq ? "bg-warning text-dark" : "bg-success")">
                                        DEL: @(isDelinq ? "YES" : "NO")
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Integrity Checks</td>
                                </tr>

                                <tr>
                                    <td class="k">Posting GLs</td>
                                    <td class="v">
                                        @if (string.IsNullOrWhiteSpace(loan.AffiliateChartOfAccountIdForPrincipalAmount)
                                           || string.IsNullOrWhiteSpace(loan.AffiliateChartOfAccountIdForInterest)
                                           || string.IsNullOrWhiteSpace(loan.AffiliateChartOfAccountIdForVat)
                                           || string.IsNullOrWhiteSpace(loan.AffiliateChartOfAccountIdForPenalty)
                                           || string.IsNullOrWhiteSpace(loan.AffiliateChartOfAccountIdForTransit))
                                        {
                                            <span class="badge bg-danger">MISSING</span>
                                            <span class="text-muted ms-2">• Check Principal/Interest/VAT/Penalty/Transit</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                            <span class="text-muted ms-2">• All required GLs present</span>
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <td class="k">Classification</td>
                                    <td class="v">
                                        <span class="badge bg-light text-dark border">@Txt(loan.Classification.ToString())</span>
                                        <span class="text-muted ms-2">• Provisioned: <b>@Money(loan.ProvisionedAmount)</b></span>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="k">Interest Stop</td>
                                    <td class="v">
                                        <span class="badge @(loan.StopInterestCalculation ? "bg-dark" : "bg-light text-dark border")">
                                            @(loan.StopInterestCalculation ? "STOPPED" : "RUNNING")
                                        </span>
                                        @if (loan.StopInterestCalculation && (loan.DateInterestWastStoped == DateTime.MinValue))
                                        {
                                            <span class="text-danger fw-bold ms-2">• DATE MISSING</span>
                                        }
                                    </td>
                                </tr>

                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">Counts</td>
                                </tr>
                                <tr><td class="k">Documents</td><td class="v fw-bold">@docs.Count</td></tr>
                                <tr><td class="k">Refunds</td><td class="v fw-bold">@refunds.Count</td></tr>
                                <tr><td class="k">Amortizations</td><td class="v fw-bold">@amort.Count</td></tr>

                            </table>

                            <div class="small-note mt-2">
                                Tip: If AMRT = 0, ensure <code>LoanAmortizations</code> is loaded server-side.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

<!-- ===================== RELEASE BLOCK MODAL ===================== -->
<div class="modal fade" id="releaseBlockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title">
                    <i class="mdi mdi-lock-open-outline me-1"></i> Release Blocked Amount
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("ReleaseBlockedAmount", "Loan", FormMethod.Post, new { id = "releaseBlockForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Account</label>

                            <select class="form-select" id="relAccountNumber" name="AccountNumber" required>
                                <option value="">-- Select Account --</option>

                                @foreach (var a in memberAccounts)
                                {
                                    var blocked = a.BlockedAmount;
                                    if (blocked <= 0) { continue; } // ✅ show only accounts that actually have blocked funds

                                    <option value="@a.AccountNumber"
                                            data-name="@a.AccountName"
                                            data-type="@a.AccountType"
                                            data-balance="@a.Balance"
                                            data-blocked="@a.BlockedAmount"
                                            data-available="@(Math.Max(0m, a.Balance - a.BlockedAmount))">
                                        @a.AccountNumber — @a.AccountName (Blocked: @Money(a.BlockedAmount))
                                    </option>
                                }
                            </select>

                            <div class="form-text text-muted">Select an account that has blocked funds.</div>
                        </div>


                        <div class="col-md-6">
                            <label class="form-label">Currently Blocked</label>
                            <input type="text" class="form-control" id="relBlocked" value="0" readonly />
                            <div class="form-text text-muted">Release amount must not exceed blocked amount.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Amount to Release</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="relAmount" name="Amount" required />
                            <div class="invalid-feedback">Amount must be ≤ blocked.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Reason / Comment</label>
                            <input type="text" class="form-control" name="Comment" id="relComment"
                                   placeholder="e.g., partial repayment received; reduce block" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Loan Reference</label>
                            <input type="text" class="form-control" name="LoanId" value="@loan.Id" readonly />
                        </div>

                    </div>

                    <div class="alert alert-warning py-2 mt-3 mb-0">
                        <i class="mdi mdi-alert-outline me-1"></i>
                        Releasing blocked funds may reduce coverage protection. Ensure the loan risk remains acceptable.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" id="relSubmitBtn">
                        <i class="mdi mdi-lock-open-outline me-1"></i> Release
                    </button>
                </div>
            }

        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        // =========================
        // IDS / SELECTORS
        // =========================
        const BLOCK_MODAL_ID = 'blockAccountModal';
        const BLOCK_FORM_ID = 'blockAccountForm';

        const REL_MODAL_ID = 'releaseBlockModal';
        const REL_FORM_ID = 'releaseBlockForm';

        const BTN_BLOCK = '.js-open-block';
        const BTN_RELEASE = '.js-open-release';

        // Block controls
        const SEL_ACCOUNT = 'blkAccountNumber';
        const INP_AVAILABLE = 'blkAvailable';
        const INP_AMOUNT = 'blkAmount';
        const INP_COMMENT = 'blkComment';
        const BTN_SUBMIT = 'blkSubmitBtn';

        // Release controls
        const REL_ACCT = 'relAccountNumber';
        const REL_BLOCKED = 'relBlocked';
        const REL_AMOUNT = 'relAmount';
        const REL_COMMENT = 'relComment';
        const REL_SUBMIT = 'relSubmitBtn';

        // =========================
        // Helpers
        // =========================
        function el(id) { return document.getElementById(id); }

        function safeDec(v, fallback = 0) {
            if (v === null || v === undefined) return fallback;
            if (typeof v === 'number') return isFinite(v) ? v : fallback;
            const s = String(v).replace(/,/g, '').trim();
            const n = parseFloat(s);
            return isFinite(n) ? n : fallback;
        }

        function fmtMoney(n) {
            n = safeDec(n, 0);
            try { return n.toLocaleString(); } catch { return String(n); }
        }

        function getModalInstance(modalEl) {
            if (!window.bootstrap || !bootstrap.Modal) return null;
            return bootstrap.Modal.getOrCreateInstance(modalEl);
        }

        function isShareAccount(accountType) {
            const t = String(accountType || '').toLowerCase();
            return t === 'preferenceshare' || t === 'ordinaryshare';
        }

        function isSavingsAccount(accountType) {
            // Adjust if your system has more variants
            const t = String(accountType || '').toLowerCase();
            return t.includes('saving') || t === 'saving';
        }

        // =========================
        // BUSINESS RULES
        // =========================
        function specialCoverageControl({ loanBalance, totalEligible, accountType, available }) {
            // Rule:
            // If loan balance > total eligible coverage, only allow blocking from SAVINGS (not shares)
            // and only if this specific account has enough AVAILABLE.
            if (loanBalance <= totalEligible) return { ok: true };

            if (!isSavingsAccount(accountType)) {
                return {
                    ok: false,
                    msg: "Loan balance is higher than total eligible coverage. Blocking is only allowed from member SAVINGS accounts."
                };
            }

            if (available <= 0) {
                return {
                    ok: false,
                    msg: "Selected savings account has no available balance (it may already be blocked)."
                };
            }

            return { ok: true };
        }

        // =========================
        // BLOCK MODAL
        // =========================
        function resetBlockModal() {
            const selectEl = el(SEL_ACCOUNT);
            if (selectEl) selectEl.value = '';

            const availableEl = el(INP_AVAILABLE);
            if (availableEl) availableEl.value = '0';

            const amountEl = el(INP_AMOUNT);
            if (amountEl) {
                amountEl.value = '';
                amountEl.removeAttribute('max');
                amountEl.classList.remove('is-invalid');
            }

            const commentEl = el(INP_COMMENT);
            if (commentEl) commentEl.value = '';

            const submitBtn = el(BTN_SUBMIT);
            if (submitBtn) submitBtn.disabled = false;

            // remove alerts if any
            const msg = document.querySelector('#blockAccountModal .js-rule-msg');
            if (msg) msg.remove();
        }

        function showBlockRuleMessage(message) {
            const modalEl = el(BLOCK_MODAL_ID);
            if (!modalEl) return;

            let msg = modalEl.querySelector('.js-rule-msg');
            if (!msg) {
                msg = document.createElement('div');
                msg.className = 'alert alert-danger py-2 mt-2 js-rule-msg';
                msg.innerHTML = `<i class="mdi mdi-alert-circle-outline me-1"></i>${message}`;
                const body = modalEl.querySelector('.modal-body');
                if (body) body.prepend(msg);
            } else {
                msg.innerHTML = `<i class="mdi mdi-alert-circle-outline me-1"></i>${message}`;
            }
        }

        function setBlockAvailable(av) {
            const availableEl = el(INP_AVAILABLE);
            if (availableEl) availableEl.value = fmtMoney(av);

            const amountEl = el(INP_AMOUNT);
            if (amountEl) {
                amountEl.value = '';
                amountEl.setAttribute('max', String(av));
                amountEl.classList.remove('is-invalid');
            }

            const submitBtn = el(BTN_SUBMIT);
            if (submitBtn) submitBtn.disabled = false;
        }

        function validateBlockAmount() {
            const amountEl = el(INP_AMOUNT);
            const submitBtn = el(BTN_SUBMIT);
            if (!amountEl) return true;

            const max = safeDec(amountEl.getAttribute('max'), 0);
            const val = safeDec(amountEl.value, 0);
            const ok = val > 0 && val <= max;

            amountEl.classList.toggle('is-invalid', !ok);
            if (submitBtn) submitBtn.disabled = !ok;

            return ok;
        }

        function openBlockModalFromButton(btn) {
            const modalEl = el(BLOCK_MODAL_ID);
            if (!modalEl) { console.error(`#${BLOCK_MODAL_ID} not found`); return; }

            const modal = getModalInstance(modalEl);
            if (!modal) { console.error('Bootstrap Modal not found. Load bootstrap.bundle.min.js'); return; }

            resetBlockModal();

            // read button data
            const acct = btn.getAttribute('data-acct') || '';
            const name = btn.getAttribute('data-name') || '';
            const type = btn.getAttribute('data-type') || '';
            const available = safeDec(btn.getAttribute('data-available'), 0);

            const loanBalance = safeDec(btn.getAttribute('data-loanbalance'), 0);
            const totalEligible = safeDec(btn.getAttribute('data-totaleligible'), 0);

            // Shares cannot be blocked here
            if (isShareAccount(type)) {
                showBlockRuleMessage("You cannot block funds from Share accounts (Ordinary/Preference). Select a Savings / Deposit / Salary account.");
                const submitBtn = el(BTN_SUBMIT);
                if (submitBtn) submitBtn.disabled = true;
                modal.show();
                return;
            }

            // Special control
            const rule = specialCoverageControl({ loanBalance, totalEligible, accountType: type, available });
            if (!rule.ok) {
                showBlockRuleMessage(rule.msg);
                const submitBtn = el(BTN_SUBMIT);
                if (submitBtn) submitBtn.disabled = true;
                modal.show();
                return;
            }

            // preselect in dropdown if exists
            const selectEl = el(SEL_ACCOUNT);
            if (selectEl) {
                selectEl.value = acct;
                if (selectEl.value !== acct) selectEl.value = '';
            }

            setBlockAvailable(available);
            const commentEl = el(INP_COMMENT);
            if (commentEl && name) commentEl.value = `Block on ${name} for loan coverage`;

            modal.show();
        }

        // =========================
        // RELEASE MODAL
        // =========================
        function resetReleaseModal() {
            [REL_ACCT, REL_BLOCKED, REL_AMOUNT, REL_COMMENT].forEach(id => {
                const x = el(id);
                if (!x) return;
                if (id === REL_BLOCKED) x.value = '0';
                else x.value = '';
                x.classList && x.classList.remove('is-invalid');
            });

            const btn = el(REL_SUBMIT);
            if (btn) btn.disabled = false;

            const msg = document.querySelector('#releaseBlockModal .js-rule-msg');
            if (msg) msg.remove();
        }

        function setReleaseBlockedUI(blocked) {
            const blockedEl = el(REL_BLOCKED);
            if (blockedEl) blockedEl.value = fmtMoney(blocked);

            const amountEl = el(REL_AMOUNT);
            if (amountEl) {
                amountEl.value = '';
                amountEl.setAttribute('max', String(blocked));
                amountEl.classList.remove('is-invalid');
            }
        }

        function validateReleaseAmount() {
            const amountEl = el(REL_AMOUNT);
            const submitBtn = el(REL_SUBMIT);
            if (!amountEl) return true;

            const max = safeDec(amountEl.getAttribute('max'), 0);
            const val = safeDec(amountEl.value, 0);

            const ok = val > 0 && val <= max;
            amountEl.classList.toggle('is-invalid', !ok);
            if (submitBtn) submitBtn.disabled = !ok;

            return ok;
        }

        function openReleaseModalFromButton(btn) {
            const modalEl = el(REL_MODAL_ID);
            if (!modalEl) { console.error(`#${REL_MODAL_ID} not found`); return; }

            const modal = getModalInstance(modalEl);
            if (!modal) { console.error('Bootstrap Modal not found. Load bootstrap.bundle.min.js'); return; }

            resetReleaseModal();

            const acct = btn.getAttribute('data-acct') || '';
            const name = btn.getAttribute('data-name') || '';
            const type = btn.getAttribute('data-type') || '';
            const blocked = safeDec(btn.getAttribute('data-blocked'), 0);

            if (blocked <= 0) {
                const submitBtn = el(REL_SUBMIT);
                if (submitBtn) submitBtn.disabled = true;
            }

            if (isShareAccount(type)) {
                // You may decide to allow release from shares if policy blocks shares.
                // For now: allow release only if blocked > 0 (no special restriction).
            }

            const acctEl = el(REL_ACCT);
            if (acctEl) acctEl.value = acct;

            setReleaseBlockedUI(blocked);

            const commentEl = el(REL_COMMENT);
            if (commentEl && name) commentEl.value = `Release block on ${name}`;

            modal.show();
        }

        // =========================
        // Delegated click (DataTables safe)
        // =========================
        document.addEventListener('click', function (e) {
            const blockBtn = e.target.closest(BTN_BLOCK);
            if (blockBtn) {
                e.preventDefault();
                e.stopPropagation();
                openBlockModalFromButton(blockBtn);
                return;
            }

            const relBtn = e.target.closest(BTN_RELEASE);
            if (relBtn) {
                e.preventDefault();
                e.stopPropagation();
                openReleaseModalFromButton(relBtn);
                return;
            }
        });

        // =========================
        // Block dropdown change -> update available
        // =========================
        document.addEventListener('change', function (e) {
            if (!e.target || e.target.id !== 'relAccountNumber') return;

            const opt = e.target.options[e.target.selectedIndex];
            const blocked = safeDec(opt?.getAttribute('data-blocked'), 0);

            // set UI
            setReleaseBlockedUI(blocked);

            // clear amount
            const amountEl = el('relAmount');
            if (amountEl) amountEl.value = '';

            // auto-fill comment
            const name = opt?.getAttribute('data-name') || '';
            const commentEl = el('relComment');
            if (commentEl && name) commentEl.value = `Release block on ${name}`;
        });


        // =========================
        // Live validation
        // =========================
        document.addEventListener('input', function (e) {
            if (e.target && e.target.id === INP_AMOUNT) validateBlockAmount();
            if (e.target && e.target.id === REL_AMOUNT) validateReleaseAmount();
        });

        // =========================
        // Submit guards
        // =========================
        document.addEventListener('submit', function (e) {
            const form = e.target;

            if (form && form.id === BLOCK_FORM_ID) {
                const selectEl = el(SEL_ACCOUNT);
                if (selectEl && !String(selectEl.value || '').trim()) {
                    e.preventDefault();
                    selectEl.classList.add('is-invalid');
                    const submitBtn = el(BTN_SUBMIT);
                    if (submitBtn) submitBtn.disabled = true;
                    return;
                }
                if (!validateBlockAmount()) { e.preventDefault(); return; }
            }

            if (form && form.id === REL_FORM_ID) {
                if (!validateReleaseAmount()) { e.preventDefault(); return; }
            }
        }, true);

        // =========================
        // Reset on close
        // =========================
        document.addEventListener('hidden.bs.modal', function (e) {
            if (e.target && e.target.id === BLOCK_MODAL_ID) resetBlockModal();
            if (e.target && e.target.id === REL_MODAL_ID) resetReleaseModal();
        });

    })();
</script>
