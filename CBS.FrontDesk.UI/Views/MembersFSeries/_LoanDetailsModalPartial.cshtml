        }

        .old-loan-brief .tile-body {
            font-size: .92rem;
        }
</style>

@if (!hasLoan)
{
    <div class="alert alert-warning m-3">
        @Html.Raw(@GlobalMembersFSeries.no_loan_selected_please_click_details_on_a_loan_row).
    </div>
    return;
}

<div class="loan-details-shell">


    <div class="loan-details-header-v2">

        <!-- ROW 1: Title + actions -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">

                <div class="meta-inline">
                    <span class="lbl">@GlobalMembersFSeries.loan_contract_number</span>
                    <span id="copyContract" class="val code-strong" data-copy="@Txt(loan.LoanContractCode)">
                        @Txt(loan.LoanContractCode)
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy Contract Code" onclick="copyFromEl('copyContract')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.print()">
                    <i class="mdi mdi-printer-outline me-1"></i> @GlobalShared.Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
                </button>
            </div>
        </div>

        <!-- ROW 2: Info grid -->
        <div class="loan-meta-grid">

            <div class="meta-item">
                <div class="lbl">@GlobalShared.Members_name</div>
                <div class="val">@Txt(loan.CustomerName)</div>
            </div>

            <div class="meta-item">
                <div class="lbl">@GlobalShared.Member_account_number/@GlobalShared.Reference</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyCustomerId" class="code-pill" data-copy="@Txt(loan.CustomerId)">@Txt(loan.CustomerId)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy CustomerId" onclick="copyFromEl('copyCustomerId')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="meta-item">
                <div class="lbl">@GlobalShared.Loan_ID</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyLoanId" class="code-pill" data-copy="@Txt(loan.Id)">@Txt(loan.Id)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy LoanId" onclick="copyFromEl('copyLoanId')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="meta-item">
                <div class="lbl">@GlobalMembersFSeries.loan_account_number</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyAccountNo" class="code-pill" data-copy="@Txt(loan.AccountNumber)">@Txt(loan.AccountNumber)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy Account" onclick="copyFromEl('copyAccountNo')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            @*<div class="meta-item">
                    <div class="lbl">Branch</div>
                    <div class="val">@Txt(loan.BranchName) (@Txt(loan.BranchCode))</div>
                </div>*@

            <div class="meta-item">
                <div class="lbl">@GlobalShared.branch_info</div>
                <div class="val">
                    @*<span class="text-muted">Init:</span>
                        <b id="copyInitBranch" data-copy="@Txt(loan.InitiatingBranchId)">@Txt(loan.InitiatingBranchId)</b>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon ms-1"
                                title="Copy Initiating BranchId" onclick="copyFromEl('copyInitBranch')">
                            <i class="mdi mdi-content-copy"></i>
                        </button>*@

                    <span class="mx-2 text-muted">•</span>

                    <span class="text-muted">@GlobalMembersFSeries.disb:</span>
                    <b id="copyDisbBranch" data-copy="@($"{Txt(loan.RDisbursementBranchName)} ({Txt(loan.RDisbursementBranchCode)})")">
                        @Txt(loan.RDisbursementBranchName) (@Txt(loan.RDisbursementBranchCode))
                    </b>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon ms-1"
                            title="Copy Disbursement Branch" onclick="copyFromEl('copyDisbBranch')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <!-- ✅ NEW: ORIGIN TILE (fills the red area) -->
            <div class="meta-item @originCardClass">
                <div class="lbl d-flex justify-content-between align-items-center">
                    <span>@GlobalShared.loan_origin</span>
                    <span class="badge @originBadgeClass">@originText</span>
                </div>

                <div class="val">
                    @if (isMigrated)
                    {
                        <div class="small-note">
                            <i class="mdi mdi-database-import-outline me-1"></i>
                            @GlobalShared.migration_date: <b>@FDateNullable(loan.MigrationDate)</b>
                        </div>
                        @*<div class="small-note text-muted">
                                Upload Flag: <b>@(loan.IsUpload ? "YES" : "NO")</b>
                            </div>*@
                    }
                    else
                    {
                <div class="small-note">
                    <i class="mdi mdi-shield-check-outline me-1 text-success"></i>
                    @GlobalMembersFSeries.core_workflow_loan_nonmigrated.
                </div>
                    }
                </div>
            </div>

        </div>

        <!-- ROW 3: Chips -->
        <div class="loan-chips mt-2">

            <!-- STATUS -->
            <span class="chip">
                <span class="k">@GlobalShared.Status</span>
                <span class="b @statusBadgeClass">@Txt(loan.LoanStatus)</span>
            </span>

            <!-- CATEGORY -->
            <span class="chip">
                <span class="k">@GlobalShared.Category</span>
                <span class="b badge-soft-secondary">@Txt(loan.LoanCategory)</span>
            </span>

            <!-- TYPE -->
            <span class="chip">
                <span class="k">@GlobalShared.Type</span>
                <span class="b badge-soft-dark">@Txt(loan.LoanType)</span>
            </span>

            <!-- ✅ DELIQUENCY (SINGLE CHIP WITH DETAILS) -->
            @if (isDelinq)
            {
                <span class="chip">
                    <span class="k">@GlobalMembersFSeries.deliquent</span>
                    <span class="b badge-soft-danger">
                        @GlobalShared.Yes •
                        Amt: @Money(loan.DeliquentAmount) •
                        Days: @loan.DeliquentDays •
                        Int: @Money(loan.DeliquentInterest)
                    </span>
                </span>
            }
            else
            {
                <span class="chip">
                    <span class="k">@GlobalMembersFSeries.deliquent</span>
                    <span class="b badge-soft-success">@GlobalShared.No</span>
                </span>
            }


            <!-- INTEREST STATE -->
            <span class="chip">
                <span class="k">@GlobalShared.Interest</span>
                <span class="b @interestBadgeClass">@interestState</span>
            </span>

            <!-- ORIGIN -->
            <span class="chip">
                <span class="k">@GlobalShared.origin</span>
                <span class="b @originBadgeClass">@(isMigrated ? "MIGRATED" : "NATIVE")</span>
            </span>

            <!-- ✅ REFINANCED -->
            @if (isRefinanced)
            {
                <span class="chip">
                    <span class="k">@GlobalShared.Refinanced</span>
                    <span class="b badge-soft-primary">@GlobalShared.Yes</span>
                </span>
            }

            <!-- ✅ RESTRUCTURED -->
            @if (isRestructured)
            {
                <span class="chip">
                    <span class="k">@GlobalShared.Restructured</span>
                    <span class="b badge-soft-warning">@GlobalShared.Yes</span>
                </span>
            }

            <!-- ✅ NEW LOAN ID (when present) -->
            @if (!string.IsNullOrWhiteSpace(relatedLoanId))
            {
                <span class="chip">
                    <span class="k">@GlobalShared.New_Loan</span>
                    <span class="b badge-soft-info">
                        <span id="copyNewLoanId" class="code-strong" data-copy="@Txt(relatedLoanId)">
                            @Txt(relatedLoanId)
                        </span>
                        <button type="button"
                                class="btn btn-xs btn-outline-secondary btn-icon"
                                title="Copy New LoanId"
                                onclick="copyFromEl('copyNewLoanId')">
                            <i class="mdi mdi-content-copy"></i>
                        </button>
                    </span>
                </span>
            }
            else
            {
                <span class="chip">
                    <span class="k">@GlobalShared.New_Loan</span>
                    <span class="b badge-soft-secondary">
                        -
                    </span>
                </span>
            }


            <!-- ✅ ADVANCE (single chip with details) -->
            @if (hasAdvance)
            {
                <span class="chip">
                    <span class="k">@GlobalShared.advance</span>
                    <span class="b badge-soft-info">
                        @GlobalShared.Yes • Amt: @Money(loan.AdvancedPaymentAmount) • @GlobalShared.Days: @loan.AdvancedPaymentDays
                    </span>
                </span>
            }


        </div>


    </div>


    <div class="p-3">

        <!-- NAV -->
        <!-- NAV (scrollable) -->
        <div class="loan-tabs-wrap">
            <ul class="nav nav-tabs loan-tabs" role="tablist">

                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#t_overview" type="button" title="Overview">
                        <i class="mdi mdi-view-dashboard-outline"></i><span>@GlobalShared.Overview</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_coverage" type="button" title="Loan Coverage Analysis">
                        <i class="mdi mdi-shield-check-outline"></i><span>@GlobalShared.coverage</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_application" type="button">
                        <i class="mdi mdi-file-document-edit-outline"></i>
                        <span>@GlobalShared.application</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_contract" type="button">
                        <i class="mdi mdi-file-sign"></i>
                        <span>@GlobalMembersFSeries.contract</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_financials" type="button" title="Financials">
                        <i class="mdi mdi-cash-multiple"></i><span>@GlobalShared.money</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_repayment" type="button" title="Repayments">
                        <i class="mdi mdi-history"></i><span>@GlobalShared.payments</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_risk" type="button" title="Delinquency & Risk">
                        <i class="mdi mdi-alert-decagram-outline"></i><span>@GlobalShared.Risk</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_product" type="button" title="Product & Purpose">
                        <i class="mdi mdi-package-variant-closed"></i><span>@GlobalShared.Product</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_documents" type="button" title="Documents">
                        <i class="mdi mdi-folder-multiple-outline"></i><span>Docs</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_pcmf" type="button" title="PCMF">
                        <i class="mdi mdi-shield-check-outline"></i><span>PCMF</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_cobac" type="button" title="COBAC / Compliance">
                        <i class="mdi mdi-shield-star-outline"></i><span>COBAC</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_system" type="button" title="System / Posting">
                        <i class="mdi mdi-bank-outline"></i><span>@GlobalShared.Posting</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_audit" type="button" title="Audit / Extra">
                        <i class="mdi mdi-clipboard-text-outline"></i><span>@GlobalShared.Audit</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content pt-3 loan-tab-content-scroll">
            <div class="tab-content pt-3">

                <!-- ===================== OVERVIEW ===================== -->
                <div class="tab-pane fade show active" id="t_overview">
                    <div class="row g-3">

                        <!-- ===================== LEFT: IDENTITY & STATUS ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                @{

                                    var _isRefinanced =
                                        appType.Equals("Refinanced", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Refinancing", StringComparison.OrdinalIgnoreCase);

                                    var _isRestructured =
                                        appType.Equals("Restructured", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Restructuring", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Rescheduled", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Reschedule", StringComparison.OrdinalIgnoreCase);

                                    var showContextBrief = _isRefinanced || _isRestructured;

                                    // local helper: "N/A" safe check
                                    Func<string, bool> IsValidId = (s) =>
                                        !string.IsNullOrWhiteSpace(s)
                                        && !s.Trim().Equals("N/A", StringComparison.OrdinalIgnoreCase);

                                    // local related id (does not override your global relatedLoanId, safe)
                                    var _relatedLoanId = IsValidId(loan.LoanId) ? loan.LoanId.Trim() : null;

                                    // Old snapshot values
                                    var oldAmt = app?.OldLoanAmount ?? 0m;
                                    var oldCap = app?.OldLoanCapital ?? 0m;
                                    var oldInt = app?.OldLoanInterest ?? 0m;
                                    var oldVat = app?.OldLoanVat ?? 0m;
                                    var oldPen = app?.OldLoanPenalty ?? 0m;

                                    // Refinancing requested amount
                                    var reqAmt = app?.RequestedAmount ?? 0m;

                                    // Overrides (if used)
                                    var hasOverride = app != null && app.IsOverRightOldLoanInterestAndBalance;
                                    var ovBal = app?.NewBalance ?? 0m;
                                    var ovInt = app?.NewInterest ?? 0m;
                                    var ovVat = app?.NewVAT ?? 0m;
                                    var ovPen = app?.NewPenalty ?? 0m;

                                    var stopOldInt = app != null && app.StopInterestCalculation;
                                }

                                <!-- header + quick badges -->
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-card-account-details-outline"></i> @GlobalShared.Identity & @GlobalShared.Status
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">@GlobalShared.Restructured</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">@GlobalShared.Refinanced</span>
                                        }

                                        <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                        </span>

                                        <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                            @Txt(loan.LoanStatus)
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• @GlobalShared.legacy_loanid: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                                <!-- ✅ Context banner + actions + brief preview (Refinance/Restructure/Reschedule) -->
                                @if (showContextBrief)
                                {
                                    <div class="mt-2">

                                        <div class="alert @(_isRefinanced ? "alert-primary" : "alert-info") py-2 mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <div class="fw-bold">
                                                    <i class="mdi @(_isRefinanced ? "mdi-swap-horizontal-bold" : "mdi-file-refresh-outline") me-1"></i>
                                                    @(_isRefinanced ? "REFINANCING CONTEXT" : "RESTRUCTURING / RESCHEDULING CONTEXT")
                                                </div>
                                                <div class="small-note mb-0">
                                                    @GlobalMembersFSeries.old_snapshot_requestedchanged_values_are_displayed_below_for_traceability.
                                                </div>
                                            </div>

                                            <div class="d-flex gap-2 flex-wrap">

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#overviewOldLoanBrief"
                                                        aria-expanded="false"
                                                        aria-controls="overviewOldLoanBrief">
                                                    <i class="mdi mdi-eye-outline me-1"></i> @GlobalMembersFSeries.preview_old_loan_brief
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                                    <a class="btn btn-sm btn-outline-dark"
                                                       target="_blank" rel="noopener"
                                                       href="@Url.Action("LoanDetails","MembersFSeries", new { loanId = _relatedLoanId })">
                                                        <i class="mdi mdi-open-in-new me-1"></i> @GlobalMembersFSeries.open_related_loan_more_details
                                                    </a>
                                                }

                                            </div>
                                        </div>

                                        <div class="collapse" id="overviewOldLoanBrief">
                                            <div class="card border-0 shadow-sm old-loan-brief">
                                                <div class="card-body p-3">

                                                    <!-- title line -->
                                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                        <div>
                                                            <div class="fw-bold">
                                                                <i class="mdi mdi-history me-1"></i> @GlobalMembersFSeries.old_loan_brief_from_loan_application
                                                            </div>
                                                            <div class="text-muted small">
                                                                @GlobalShared.Type: <b>@Txt(app?.LoanApplicationType)</b>
                                                                <span class="mx-2 text-muted">•</span>
                                                                @GlobalMembersFSeries.old_loan_ref: <b>@Txt(app?.LoanId)</b>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex gap-2 flex-wrap">
                                                            @if (hasOverride)
                                                            {
                                                                <span class="badge bg-warning text-dark">
                                                                    <i class="mdi mdi-alert-outline me-1"></i> @GlobalShared.override_applied
                                                                </span>
                                                            }
                                                            @if (stopOldInt)
                                                            {
                                                                <span class="badge bg-dark">
                                                                    <i class="mdi mdi-stop-circle-outline me-1"></i> @GlobalShared.interest_stopped
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- old snapshot -->
                                                    <div class="row g-2">
                                                        <div class="col-md-3">
                                                            <div class="label-muted">@GlobalShared.old_amount</div>
                                                            <div class="value-strong">@Money(oldAmt)</div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="label-muted">@GlobalShared.old_capital</div>
                                                            <div class="value-strong">@Money(oldCap)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">@GlobalShared.old_interest</div>
                                                            <div class="value-strong">@Money(oldInt)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">@GlobalShared.old_vat</div>
                                                            <div class="value-strong">@Money(oldVat)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">@GlobalShared.old_penalty</div>
                                                            <div class="value-strong">@Money(oldPen)</div>
                                                        </div>
                                                    </div>

                                                    @if (_isRefinanced)
                                                    {
                                                        <hr class="my-2" />

                                                        <div class="row g-2 align-items-stretch">
                                                            <div class="col-lg-6">
                                                                <div class="brief-tile">
                                                                    <div class="tile-title">
                                                                        <i class="mdi mdi-cash-plus me-1"></i> @GlobalMembersFSeries.refinancing_request
                                                                    </div>
                                                                    <div class="tile-body">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span class="text-muted">@GlobalShared.Requested_Amount</span>
                                                                            <span class="fw-bold">@Money(reqAmt)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">@GlobalShared.old_loan_amount</span>
                                                                            <span class="fw-bold">@Money(oldAmt)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">@GlobalShared.Difference</span>
                                                                            <span class="fw-bold">@Money(reqAmt - oldAmt)</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-lg-6">
                                                                <div class="brief-tile">
                                                                    <div class="tile-title">
                                                                        <i class="mdi mdi-information-outline me-1"></i> @GlobalMembersFSeries.current_loan_summary
                                                                    </div>
                                                                    <div class="tile-body">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span class="text-muted">@GlobalMembersFSeries.lamount</span>
                                                                            <span class="fw-bold">@Money(loan.LoanAmount)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">@GlobalShared.Current_balance</span>
                                                                            <span class="fw-bold">@Money(loan.Balance)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">@GlobalShared.Interest_Rate</span>
                                                                            <span class="fw-bold">@Percent(loan.InterestRate)</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <hr class="my-2" />

                                                        <div class="brief-tile">
                                                            <div class="tile-title">
                                                                <i class="mdi mdi-compare-horizontal me-1"></i> @GlobalMembersFSeries.changes_summary (@GlobalShared.restructure / @GlobalShared.reschedule)
                                                            </div>

                                                            <div class="tile-body">
                                                                <div class="row g-2">
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">@GlobalShared.New_Balance</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovBal) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">@GlobalShared.new_interest</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovInt) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">@GlobalMembersFSeries.new_vat</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovVat) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">@GlobalShared.new_penalty</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovPen) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="small text-muted mt-2">
                                                                    @GlobalMembersFSeries.note_changes_are_shown_only_when_override_values_were_captured_in_the_loan_application.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                }

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Identity -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.Identity</td>
                                    </tr>
                                    <!-- Origin / Migration -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.origin</td>
                                    </tr>
                                    <tr>
                                        <td class="k">@GlobalShared.loan_origin</td>
                                        <td class="v">
                                            @if (isMigrated)
                                            {
                                                <span class="badge bg-dark">@GlobalShared.Migrated</span>
                                                <span class="text-muted ms-2">• @FDateNullable(loan.MigrationDate)</span>
                                            }
                                            else
                                            {
                                        <span class="badge bg-light text-dark border">@GlobalMembersFSeries.native_core</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Status -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.Status</td>
                                    </tr>
                                    <tr>
                                        <td class="k">@GlobalShared.Loan_Status</td>
                                        <td class="v">
                                            <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                                @Txt(loan.LoanStatus)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr><td class="k">@GlobalShared.journey_status</td><td class="v">@Txt(loan.LoanJourneyStatus)</td></tr>
                                    <tr><td class="k">@GlobalShared.Loan_Category</td><td class="v">@Txt(loan.LoanCategory)</td></tr>
                                    <tr><td class="k">@GlobalShared.Loan_Type</td><td class="v">@Txt(loan.LoanType)</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.type_category</td><td class="v">@Txt(loan.LoanTypeCategory)</td></tr>

                                    <!-- Restructure / Refinance -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.restructure / @GlobalShared.refinance</td>
                                    </tr>
                                    <tr>
                                        <td class="k">@GlobalShared.Status</td>
                                        <td class="v">
                                            @if (_isRestructured)
                                            {
                                                <span class="badge bg-info text-dark">@GlobalShared.Restructured / @GlobalShared.Rescheduled</span>
                                                if (!string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                        <span class="text-muted ms-2">• @GlobalShared.related_loanid: <b>@Txt(_relatedLoanId)</b></span>
                                                }
                                            }
                                            else if (_isRefinanced)
                                            {
                                        <span class="badge bg-primary">@GlobalShared.Refinanced</span>
                                                if (string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                        <span class="text-muted ms-2">• @GlobalMembersFSeries.related_loan_not_available</span>
                                                }
                                            }
                                            else
                                            {
                                        <span class="text-muted">@GlobalShared.None</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Disbursement -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.disbursement</td>
                                    </tr>
                                    <tr>
                                        <td class="k">@GlobalMembersFSeries.is_disbursed?</td>
                                        <td class="v">
                                            <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                                @(loan.IsLoanDisbursted ? "YES" : "NO")
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                            {
                                                <span class="text-muted ms-2">• @Txt(loan.DisbursmentStatus)</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Ownership -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.ownership</td>
                                    </tr>
                                    <tr><td class="k">@GlobalShared.loan_manager</td><td class="v">@Txt(loan.LoanManager)</td></tr>
                                    <tr><td class="k">@GlobalShared.disbursed_by</td><td class="v">@Txt(loan.LoanDisbursedBy)</td></tr>

                                    <!-- Flags -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.flags</td>
                                    </tr>
                                    <tr><td class="k">@GlobalShared.writeoff</td><td class="v">@(loan.IsWriteOffLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">@GlobalShared.current_loan</td><td class="v">@(loan.IsCurrentLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">@GlobalShared.Completed</td><td class="v">@(loan.IsCompleted ? "YES" : "NO")</td></tr>

                                    <!-- Audit -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.Audit</td>
                                    </tr>
                                    <tr><td class="k">@GlobalMembersFSeries.last_event_date</td><td class="v">@FDate(loan.LastEventData)</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- ===================== RIGHT: DATES & SCHEDULE ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-clock-outline"></i> @GlobalMembersFSeries.dates_schedule
                                    </div>

                                    <!-- top quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">@GlobalShared.Restructured</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">@GlobalShared.Refinanced</span>
                                        }

                                        <span class="badge @(stopInterest ? "bg-dark" : "bg-light text-dark border")">
                                            INT: @(stopInterest ? "STOPPED" : "RUNNING")
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        @GlobalShared.migration_date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• @GlobalShared.legacy_loanid: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Timeline -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">@GlobalShared.Timeline</td>
                                </tr>
                                <tr><td class="k">@GlobalShared.Loan_Date</td><td class="v">@FDate(loan.LoanDate)</td></tr>
                                <tr><td class="k">@GlobalShared.disbursement_date</td><td class="v">@FDate(loan.DisbursementDate)</td></tr>

                                <!-- Installments -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">@GlobalMembersFSeries.installment_schedule</td>
                                </tr>
                                <tr><td class="k">@GlobalShared.first_installment_date</td><td class="v">@FDateShort(loan.FirstInstallmentDate)</td></tr>
                                <tr><td class="k">@GlobalShared.next_installment_date</td><td class="v">@FDateShort(loan.NextInstallmentDate)</td></tr>
                                <tr><td class="k">@GlobalShared.maturity_date</td><td class="v">@FDateShort(loan.MaturityDate)</td></tr>

                                    <!-- Processing -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalMembersFSeries.processing_dates</td>
                                    </tr>
                                    <tr><td class="k">@GlobalMembersFSeries.last_refund_date</td><td class="v">@FDate(loan.LastRefundDate)</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.last_interest_calc_date</td><td class="v">@(loan.LastInterestCalculatedDate.HasValue ? FDate(loan.LastInterestCalculatedDate.Value): "-")</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.last_delinquency_proc</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                                <!-- Structuring -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">@GlobalShared.structuring</td>
                                </tr>
                                <tr><td class="k">@GlobalShared.structuring_date</td><td class="v">@FDate(loan.LoanStructuringDate)</td></tr>
                                <tr><td class="k">@GlobalShared.structuring_status</td><td class="v">@Txt(loan.LoanStructuringStatus)</td></tr>

                                <!-- Interest stop control -->
                                <tr class="table-light">
                                    <td colspan="2" class="fw-bold small">@GlobalShared.interest_stop / @GlobalShared.controls</td>
                                </tr>
                                <tr><td class="k">@GlobalShared.interest_stop?</td><td class="v">@(stopInterest ? "YES" : "NO")</td></tr>
                                <tr><td class="k">@GlobalShared.stopped_by</td><td class="v">@Txt(loan.StoppedBy)</td></tr>
                                <tr>
                                    <td class="k">@GlobalShared.stop_date</td>
                                    <td class="v">
                                        @if (stopDateMissing)
                                        {
                                            <span class="text-danger fw-bold">@GlobalMembersFSeries.stopped_but_date_missing</span>
                                        }
                                        else
                                        {
                                            @FDate(loan.DateInterestWastStoped)
                                        }
                                    </td>
                                </tr>
                                <tr><td class="k">@GlobalShared.stop_comment</td><td class="v">@Txt(loan.InterestStoppedComment)</td></tr>

                            </table>
                            </div>
                        </div>

                        <!-- initiation / disbursement branches (GROUPED + CLEAN TRACEABILITY) -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-source-branch"></i>
                                        @GlobalMembersFSeries.initiation_approval_disbursement_traceability
                                    </div>

                                    <!-- TOP BADGES -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED LOAN" : "NATIVE LOAN")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">@GlobalShared.Restructured</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">@GlobalShared.Refinanced</span>
                                        }

                                        <span class="badge @(string.Equals(loan.DisbursmentStatus, "Disbursed", StringComparison.OrdinalIgnoreCase) || loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            DISB: @(loan.IsLoanDisbursted ? "YES" : "NO")
                                        </span>

                                        <span class="badge @(loan.RDisbursementAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            @GlobalMembersFSeries.disb_post: @(loan.RDisbursementAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>

                                        <span class="badge @(loan.RApprovalAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            @GlobalMembersFSeries.aprv_post: @(loan.RApprovalAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>
                                    </div>
                                </div>

                                @{
                                    var isInterBranch =
                                        !string.IsNullOrWhiteSpace(loan.InitiatingBranchId)
                                        && !string.IsNullOrWhiteSpace(loan.BranchId)
                                        && !string.Equals(loan.InitiatingBranchId, loan.BranchId, StringComparison.OrdinalIgnoreCase);
                                }

                                <!-- ===================== MIGRATED ONLY ===================== -->
                                @if (isMigrated)
                                {
                                    <div class="alert alert-dark py-2 mb-0">
                                        <div class="fw-bold">
                                            <i class="mdi mdi-database-import-outline me-1"></i>
                                            @Html.Raw(@GlobalMembersFSeries.this_is_a_migrated_loan).
                                        </div>
                                        <div class="small-note mb-0">
                                            @GlobalMembersFSeries.migration_information_is_shown_below_for_audit_traceability.
                                        </div>

                                        <div class="row g-3 mt-2">
                                            <div class="col-md-4">
                                                <div class="small-note">@GlobalMembersFSeries.legacy_loanid_upload</div>
                                                <div class="fw-bold">@Txt(loan.LoanId)</div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="small-note">@GlobalShared.migration_date</div>
                                                <div class="fw-bold">@FDateNullable(loan.MigrationDate)</div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="small-note">@GlobalShared.upload_flag</div>
                                                <div class="fw-bold">@(loan.IsUpload ? "YES" : "NO")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- ===================== NATIVE SUMMARY ===================== -->
                                    <div class="alert alert-light border py-2 mb-3">
                                        <div class="fw-bold">
                                            <i class="mdi mdi-check-decagram-outline me-1 text-success"></i>
                                            @Html.Raw(@GlobalMembersFSeries.this_is_a_native_nonmigrated_loan).
                                        </div>
                                        <div class="small-note mb-0">
                                            @GlobalMembersFSeries.initiationapprovaldisbursement_states_are_from_the_core_workflow.
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 1: BRANCH TRACE ===================== -->
                                    <div class="card border-0 shadow-sm mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-map-marker-path me-1"></i> @GlobalShared.branch_trace
                                                </div>

                                                <span class="badge @(isInterBranch ? "bg-warning text-dark" : "bg-success")">
                                                    @(isInterBranch ? "INTER-BRANCH: YES" : "INTER-BRANCH: NO")
                                                </span>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.initiating_branchid</div>
                                                    <div class="fw-bold">@Txt(loan.InitiatingBranchId)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.loan_branch_current_owner</div>
                                                    <div class="fw-bold">@Txt(loan.BranchName) (@Txt(loan.BranchCode))</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.disbursement_branch_routing</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursementBranchName) (@Txt(loan.RDisbursementBranchCode))</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 2: DISBURSEMENT INFO ===================== -->
                                    <div class="card border-0 shadow-sm mb-3">
                                        <div class="card-body p-3">
                                            <div class="fw-bold mb-2">
                                                <i class="mdi mdi-cash-fast me-1"></i> @GlobalShared.disbursement_information
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalShared.Disbursement_Status</div>
                                                    <div class="fw-bold">
                                                        @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                                        @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                                        {
                                                            <span class="text-muted">• @Txt(loan.DisbursmentStatus)</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.disbursement_reference</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursementReference)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalShared.disbursement_date</div>
                                                    <div class="fw-bold">@FDateNullable(loan.RDisbursementDate)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.disbursed_by_refinancingroute</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursedBy)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalMembersFSeries.loan_disbursed_by_core</div>
                                                    <div class="fw-bold">@Txt(loan.LoanDisbursedBy)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">@GlobalShared.loan_manager</div>
                                                    <div class="fw-bold">@Txt(loan.LoanManager)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 3: POSTING + AUDIT ===================== -->
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body p-3">

                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-shield-check-outline me-1"></i> @GlobalMembersFSeries.accounting_posting_audit
                                                </div>



                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge @(taxable ? "badge-taxable" : "badge-nontax")">
                                                        <i class="mdi @(taxable ? "mdi-check-decagram-outline" : "mdi-close-circle-outline") me-1"></i>
                                                        @taxLabel
                                                    </span>

                                                    <span class="badge @(loan.RDisbursementAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                                        @GlobalMembersFSeries.disb_post: @(loan.RDisbursementAccountingPostingStatus ? "DONE" : "PENDING")
                                                    </span>

                                                    <span class="badge @(loan.RApprovalAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                                        @GlobalMembersFSeries.aprv_post: @(loan.RApprovalAccountingPostingStatus ? "DONE" : "PENDING")
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="row g-3 align-items-start">

                                                <!-- LEFT: Posting status -->
                                                <div class="col-md-6">
                                                    <div class="small-note">@GlobalMembersFSeries.accounting_posting_status</div>

                                                    <div class="fw-bold">
                                                        @GlobalShared.disbursement:
                                                        <span class="@(loan.RDisbursementAccountingPostingStatus ? "text-success" : "text-warning")">
                                                            @(loan.RDisbursementAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                                        </span>
                                                        <span class="text-muted">•</span>
                                                        @GlobalShared.Approval:
                                                        <span class="@(loan.RApprovalAccountingPostingStatus ? "text-success" : "text-warning")">
                                                            @(loan.RApprovalAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                                        </span>
                                                    </div>

                                                    <div class="small-note mt-1">
                                                        @GlobalShared.consistency:
                                                        @if (loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                                        {
                                                            <span class="fw-bold text-success">@GlobalMembersFSeries.fully_posted</span>
                                                        }
                                                        else if (!loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                                        {
                                                            <span class="fw-bold text-danger">@GlobalMembersFSeries.approval_posted_but_disbursement_not_posted</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold text-warning">@GlobalShared.Pending / @GlobalShared.incomplete</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- RIGHT: Audit keys -->
                                                <div class="col-md-6">
                                                    <div class="small-note">@GlobalMembersFSeries.audit_trace_keys</div>
                                                    <div class="fw-bold">
                                                        @GlobalMembersFSeries.loanappid: <span class="text-muted">@Txt(loan.LoanApplicationId)</span>
                                                        <span class="text-muted">•</span>
                                                        @GlobalMembersFSeries.applicationcode: <span class="text-muted">@Txt(loan.ApplicationCode)</span>
                                                    </div>
                                                </div>

                                                <!-- FULL WIDTH: GLs used -->
                                                <div class="col-12">
                                                    <div class="p-2 border rounded bg-light">

                                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                            <div class="fw-bold">
                                                                <i class="mdi mdi-bank-outline me-1"></i> @GlobalMembersFSeries.gls_used_approval_disbursement
                                                            </div>

                                                            <div class="small-note text-muted">
                                                                @GlobalMembersFSeries.codename_shown_for_users_id_shown_for_traceability
                                                            </div>
                                                        </div>

                                                        @{
                                                            // Core GLs (these exist on your loan model)
                                                            var principalGlId = loan.AffiliateChartOfAccountIdForPrincipalAmount;
                                                            var transitGlId = loan.AffiliateChartOfAccountIdForTransit;

                                                            // Optional GLs
                                                            var vatGlId = loan.AffiliateChartOfAccountIdForVat;
                                                            var interestGlId = loan.AffiliateChartOfAccountIdForInterest;
                                                            var penaltyGlId = loan.AffiliateChartOfAccountIdForPenalty;

                                                            // Helper: show VAT only when taxable
                                                            var showVat = taxable && !string.IsNullOrWhiteSpace(vatGlId);

                                                            // ✅ We’ll define “GLs used for approval/disbursement” as the mapping set the posting builder relies on.
                                                            // Disbursement typically hits Principal + Transit (+ VAT if taxable and your posting computes VAT).
                                                            // Approval also relies on same mapping for the approval postings/validation in most workflows.
                                                        }

                                                        <div class="row g-2">

                                                            <!-- Core GLs -->
                                                            <div class="col-lg-6">
                                                                <div class="p-2 border rounded bg-white h-100">
                                                                    <div class="fw-bold mb-2">
                                                                        <i class="mdi mdi-format-list-bulleted me-1"></i> @GlobalMembersFSeries.core_gls
                                                                    </div>

                                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                                        <div>
                                                                            <div class="small-note">@GlobalMembersFSeries.principal_gl</div>
                                                                            <div class="fw-bold">@GlText(principalGlId)</div>
                                                                        </div>
                                                                        <div class="text-end">
                                                                            <div class="small-note text-muted">Id</div>
