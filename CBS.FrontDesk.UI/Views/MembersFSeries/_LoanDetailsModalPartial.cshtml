@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    var loan = Model?.Loan;
    bool hasLoan = loan != null && !string.IsNullOrWhiteSpace(loan.Id);

    string FDate(DateTime dt) => dt == DateTime.MinValue ? "-" : dt.ToString("dd/MM/yyyy HH:mm:ss");
    string FDateShort(DateTime dt) => dt == DateTime.MinValue ? "-" : dt.ToString("dd/MM/yyyy");
    string FDateNullable(DateTime? dt) => dt.HasValue && dt.Value != DateTime.MinValue ? dt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-";

    string Money(decimal v) => v.ToString("N0");
    string MoneyN(decimal? v) => v.HasValue ? v.Value.ToString("N0") : "-";
    string Percent(decimal v) => v.ToString("0.00") + "%";
    string Txt(string s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    bool isDelinq = hasLoan && (loan.IsDeliquentLoan || loan.DeliquentDays > 0 || loan.DeliquentAmount > 0);
    bool hasAdvance = hasLoan && (loan.AdvancedPaymentDays > 0 || loan.AdvancedPaymentAmount > 0);
    bool stopped = hasLoan && loan.StopInterestCalculation;

    // Safe lists (adjust namespaces if needed in your project)
    var docs = loan?.LoanApplication?.DocumentAttachedToLoans ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.DocumentAttachedToLoan>();
    var refunds = loan?.Refunds ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.Refund>();
    var amort = loan?.LoanAmortizations ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanAmortization>();
    var isMigrated =
    loan.IsUpload
    || (loan.MigrationDate.HasValue && loan.MigrationDate.Value > DateTime.MinValue);

    var app = loan?.LoanApplication;

    var appType = (app?.LoanApplicationType ?? "").Trim();

    var isRefinanced =
        appType.Equals("Refinanced", StringComparison.OrdinalIgnoreCase)
        || appType.Equals("Refinancing", StringComparison.OrdinalIgnoreCase);

    var isRestructured =
        appType.Equals("Restructured", StringComparison.OrdinalIgnoreCase)
        || appType.Equals("Restructuring", StringComparison.OrdinalIgnoreCase)
        || appType.Equals("Rescheduled", StringComparison.OrdinalIgnoreCase)
        || appType.Equals("Reschedule", StringComparison.OrdinalIgnoreCase);

    // Related loan id must be valid (not null/blank and not N/A)
    var relatedLoanId =
        !string.IsNullOrWhiteSpace(loan.NewLoanId)
        && !loan.NewLoanId.Equals("N/A", StringComparison.OrdinalIgnoreCase)
            ? loan.NewLoanId
            : null;

    var showOldLoanBrief = isRefinanced || isRestructured;


    var stopInterest = loan.StopInterestCalculation;
    var stopDateMissing = stopInterest && (loan.DateInterestWastStoped == DateTime.MinValue);
    var dailyInts = loan?.DailyInterestCalculations ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.DailyInterestCalculation>();

    // sort: latest first
    dailyInts = dailyInts
        .OrderByDescending(x => x.Date)
        .ToList();

    var hasDailyInts = dailyInts.Any();

    var sumInterest = dailyInts.Sum(x => x.InterestCalculated);
    var sumVat = dailyInts.Sum(x => x.CalculatedVat);

    var lastIntDate = hasDailyInts ? dailyInts.Max(x => x.Date) : (DateTime?)null;
    var glMap = ViewBag.GlMap as IDictionary<string, string> ?? new Dictionary<string, string>();

    Func<string, IHtmlString> GlText = (id) =>
    {
        if (string.IsNullOrWhiteSpace(id)) return new HtmlString("<span class='text-muted'>-</span>");
        return glMap.TryGetValue(id, out var txt)
            ? new HtmlString($"<span class='fw-bold'>{txt}</span>")
            : new HtmlString($"<span class='text-warning fw-bold'>UNKNOWN GL</span>");
    };
    //// ----------------------------
    //// 1) MIGRATION ORIGIN
    //// ----------------------------
    //var isMigrated =
    //    loan.IsUpload
    //    || (loan.MigrationDate != DateTime.MinValue && loan.MigrationDate != default(DateTime))
    //    || !string.IsNullOrWhiteSpace(loan.LoanId); // legacy id often exists for migrated

    var originText = isMigrated ? "MIGRATED LOAN" : "NATIVE (CORE)";
    var originBadgeClass = isMigrated ? "badge-soft-warning" : "badge-soft-success";
    var originCardClass = isMigrated ? "origin-migrated" : "origin-native";

    // ----------------------------
    // 2) INTEREST STATE
    // ----------------------------
    var hasInterest = loan.InterestRate > 0m;

    var interestState =
        !hasInterest ? "NO INTEREST"
        : (loan.StopInterestCalculation ? "STOPPED" : "RUNNING");


    var interestBadgeClass =
     !hasInterest ? "badge-soft-secondary"
     : (loan.StopInterestCalculation ? "badge-soft-dark" : "badge-soft-success");


    // ----------------------------
    // 3) STATUS CHIP COLOR
    // ----------------------------
    var isOpen = string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase);
    var statusBadgeClass = isOpen ? "badge-soft-success" : "badge-soft-secondary";
    var isMortgage = loan.IsMortgage;

    var taxable =
        !string.IsNullOrWhiteSpace(loan.TaxableStatus)
        && loan.TaxableStatus.Equals("Taxable", StringComparison.OrdinalIgnoreCase);

    var product = loan?.LoanApplication?.LoanProduct;
    var taxLabel = taxable ? "TAXABLE" : "NON-TAXABLE";

}


