@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    var loan = Model.Loan;
    var totalRefinancing = loan.RequestedAmount + loan.RestructuredBalance;
}

<div class="card-body">

    <!-- General Information -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">General Information</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Loan ID</td><td class="text-end">@loan.Id</td></tr>
                <tr><td class="fw-bold">Loan Application ID</td><td class="text-end">@loan.LoanApplicationId</td></tr>
                <tr><td class="fw-bold">Customer</td><td class="text-start">@loan.CustomerName (@loan.CustomerId)</td></tr>
                <tr><td class="fw-bold">Branch</td><td class="text-start">@loan.BranchName (@loan.BranchCode)</td></tr>
                <tr>
                    <td class="fw-bold">Loan Type</td>
                    <td class="text-start">
                        @if (loan.LoanType == "Main_Loan")
                        {
                            <span class="badge bg-secondary">Main Loan</span>
                        }
                        else
                        {
                            <span class="badge bg-light border">@loan.LoanType</span>
                        }
                    </td>
                </tr>
                <tr><td class="fw-bold">Category</td><td class="text-start">@loan.LoanCategory</td></tr>
                <tr><td class="fw-bold">Target</td><td class="text-start">@loan.LoanTarget</td></tr>
                <tr><td class="fw-bold">Manager</td><td class="text-start">@loan.LoanManager</td></tr>
                <tr><td class="fw-bold">Journey</td><td class="text-start">@loan.LoanJourneyStatus</td></tr>
                <tr><td class="fw-bold">Status</td><td class="text-start">@loan.LoanStatus</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Loan Financial Summary -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Loan Financial Summary</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Requested Amount</td><td class="text-end">@loan.RequestedAmount.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Approved Amount</td><td class="text-end">@loan.LoanAmount.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Principal Paid</td><td class="text-end">@loan.TotalPrincipalPaid.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Paid (Total)</td><td class="text-end">@loan.Paid.ToString("N0") FCFA</td></tr>
                <tr class="text-danger"><td class="fw-bold">Balance</td><td class="text-danger text-end">@loan.Balance.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Due Amount</td><td class="text-end">@loan.DueAmount.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Penalty</td><td class="text-end">@loan.Penalty.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Tax</td><td class="text-end">@loan.Tax.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Fee</td><td class="text-end">@loan.Fee.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Last Payment</td><td class="text-end">@loan.LastPayment.ToString("N0") FCFA</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Interest Details -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Interest Details</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Forecasted Interest</td><td class="text-end">@loan.InterestForcasted.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Interest Rate</td><td class="text-end">@loan.InterestRate.ToString("0.0") %</td></tr>
                <tr><td class="fw-bold">Accrued Interest</td><td class="text-end">@loan.AccrualInterest.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Last Calculated Interest</td><td class="text-end">@loan.LastCalculatedInterest.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Last Calculated Date</td><td class="text-end">@loan.LastInterestCalculatedDate.ToString("dd/MM/yyyy")</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Disbursement -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Disbursement & Schedule</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Loan Date</td><td class="text-end">@loan.LoanDate.ToString("dd/MM/yyyy")</td></tr>
                <tr><td class="fw-bold">Disbursement Date</td><td class="text-end">@loan.DisbursementDate.ToString("dd/MM/yyyy")</td></tr>
                <tr><td class="fw-bold">First Installment</td><td class="text-end">@loan.FirstInstallmentDate.ToString("dd/MM/yyyy")</td></tr>
                <tr><td class="fw-bold">Next Installment</td><td class="text-end">@loan.NextInstallmentDate.ToString("dd/MM/yyyy")</td></tr>
                <tr><td class="fw-bold">Maturity Date</td><td class="text-end">@loan.MaturityDate.ToString("dd/MM/yyyy")</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Guarantees -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Guarantees & Coverage</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Savings Pledged</td><td class="text-end">@loan.Savings.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Shares (Ordinary)</td><td class="text-end">@loan.OShares.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Shares (Preferred)</td><td class="text-end">@loan.PShares.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Total Guarantee Fund</td><td class="text-end">@loan.TotalFundGuranteed.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Liquidity Coverage</td><td class="text-end">@loan.PercentageOfLiquidityCoverage %</td></tr>
                <tr><td class="fw-bold">Collateral Coverage</td><td class="text-end">@loan.PercentageOfCollateralCoverage %</td></tr>
                <tr><td class="fw-bold">Overall Coverage</td><td class="text-end">@loan.PercentageOfOverAllCoverage %</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Delinquency -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Delinquency & Risk</div>
        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr><td class="fw-bold">Is Delinquent</td><td class="text-start"><span class="badge bg-@(loan.IsDeliquentLoan ? "danger" : "success")">@((loan.IsDeliquentLoan ? "Yes" : "No"))</span></td></tr>
                <tr><td class="fw-bold">Delinquent Days</td><td class="text-end">@loan.DeliquentDays</td></tr>
                <tr><td class="fw-bold">Delinquent Amount</td><td class="text-end">@loan.DeliquentAmount.ToString("N0") FCFA</td></tr>
                <tr><td class="fw-bold">Last Processed</td><td class="text-end">@loan.LastDeliquecyProcessedDate?.ToString("dd/MM/yyyy")</td></tr>
                <tr><td class="fw-bold">Is Restructured</td><td class="text-start"><span class="badge bg-@(loan.IsRestructured ? "warning" : "secondary")">@((loan.IsRestructured ? "Yes" : "No"))</span></td></tr>
                <tr><td class="fw-bold">Write-Off</td><td class="text-start"><span class="badge bg-@(loan.IsWriteOffLoan ? "danger" : "secondary")">@((loan.IsWriteOffLoan ? "Yes" : "No"))</span></td></tr>
                <tr><td class="fw-bold">Stopped Interest Calculation</td><td class="text-start"><span class="badge bg-@(loan.StopInterestCalculation ? "danger" : "success")">@((loan.StopInterestCalculation ? $"Yes by {loan.StoppedBy}" : "No"))</span></td></tr>
            </tbody>
        </table>
    </div>

    <!-- Repayment -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Repayment Summary & History</div>
        <table class="table table-bordered table-sm mb-0">
            <thead class="table-light">
                <tr><th>Date</th><th>Amount</th><th>Interest</th><th>Penalty</th><th>VAT</th><th>Balance After</th></tr>
            </thead>
            <tbody>
                @if (loan.Refunds?.Any() == true)
                {
                    foreach (var r in loan.Refunds.OrderByDescending(x => x.DateOfPayment))
                    {
                        <tr>
                            <td>@r.DateOfPayment.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@r.Amount.ToString("N0")</td>
                            <td class="text-end">@r.Interest.ToString("N0")</td>
                            <td class="text-end">@r.Penalty.ToString("N0")</td>
                            <td class="text-end">@r.Tax.ToString("N0")</td>
                            <td class="text-end">@r.Balance.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-muted text-center">No repayments recorded.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Interest Calculations -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light text-dark fw-bold border-bottom">Interest Calculations (Top 10)</div>
        @if (loan.DailyInterestCalculations.Any() == true)
        {
            var top10 = loan.DailyInterestCalculations.OrderByDescending(x => x.Date).Take(10).ToList();
            var totalVat = top10.Sum(x => x.CalculatedVat);
            var projectedNewBalance = loan.Balance + loan.AccrualInterest;

            <table class="table table-bordered table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Prev Bal</th><th>Rate</th><th>Interest</th><th>VAT %</th><th>VAT</th><th>New Bal</th></tr>
                </thead>
                <tbody>
                    @foreach (var calc in top10)
                    {
                        <tr>
                            <td>@calc.Date.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@calc.PreviouseBalance.ToString("N0")</td>
                            <td class="text-end">@calc.InterestRate.ToString("0.00")</td>
                            <td class="text-end">@calc.InterestCalculated.ToString("N0")</td>
                            <td class="text-end">@calc.VatRate.ToString("0.00")</td>
                            <td class="text-end">@calc.CalculatedVat.ToString("N0")</td>
                            <td class="text-end">@calc.NewBalance.ToString("N0")</td>
                        </tr>
                    }
                    <tr class="table-light fw-bold text-end">
                        <td colspan="3">Forecasted</td>
                        <td>@loan.AccrualInterest.ToString("N0")</td>
                        <td></td>
                        <td>@totalVat.ToString("N0")</td>
                        <td class="text-danger">Projected: @projectedNewBalance.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="p-3 text-muted">No interest calculations available.</div>
        }
    </div>

</div>
