                                    <!-- Savings snapshot -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-lock-outline me-1"></i> @GlobalMembersFSeries.savings_snapshot_application_time
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">@GlobalShared.Current_balance</td><td class="v">@Money(savingBalanceAtApp)</td></tr>
                                                <tr><td class="k">@GlobalShared.Blocked_Amount</td><td class="v">@Money(blockedSavingAtApp)</td></tr>
                                                <tr><td class="k">@GlobalShared.blocking_required?</td><td class="v">@(mustBlockSavings ? "YES" : "NO")</td></tr>
                                                <tr><td class="k">@GlobalShared.required_block</td><td class="v">@(mustBlockSavings ? Money(requiredSavingsBlock) : "N/A")</td></tr>
                                                <tr>
                                                    <td class="k">Gap</td>
                                                    <td class="v">
                                                        @(mustBlockSavings ? Money(missingSavingsBlock) : "N/A")
                                                        @if (mustBlockSavings)
                                                        {
                                                            <span class="ms-2 badge @(missingSavingsBlock <= 0m ? "bg-success" : "bg-warning text-dark")">
                                                                @(missingSavingsBlock <= 0m ? "OK" : "ACTION")
