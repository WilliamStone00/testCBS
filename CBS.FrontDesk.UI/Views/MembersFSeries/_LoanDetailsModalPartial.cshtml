                                        <td colspan="2" class="fw-bold small">Counts</td>
                                    </tr>
                                    <tr><td class="k">Documents</td><td class="v fw-bold">@docs.Count</td></tr>
                                    <tr><td class="k">Refunds</td><td class="v fw-bold">@refunds.Count</td></tr>
                                    <tr><td class="k">Amortizations</td><td class="v fw-bold">@amort.Count</td></tr>

                                </table>

                                <div class="small-note mt-2">
                                    Tip: If AMRT = 0, ensure <code>LoanAmortizations</code> is loaded server-side.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

