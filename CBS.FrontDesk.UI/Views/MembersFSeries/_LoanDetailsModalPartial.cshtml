            margin-bottom: 6px;
        }

        .old-loan-brief .tile-body {
            font-size: .92rem;
        }
</style>

@if (!hasLoan)
{
    <div class="alert alert-warning m-3">
        No loan selected. Please click <b>Details</b> on a loan row.
    </div>
    return;
}

<div class="loan-details-shell">


    <div class="loan-details-header-v2">

        <!-- ROW 1: Title + actions -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">

                <div class="meta-inline">
                    <span class="lbl">Loan Contract Number</span>
                    <span id="copyContract" class="val code-strong" data-copy="@Txt(loan.LoanContractCode)">
                        @Txt(loan.LoanContractCode)
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy Contract Code" onclick="copyFromEl('copyContract')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.print()">
                    <i class="mdi mdi-printer-outline me-1"></i> Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i> Close
                </button>
            </div>
        </div>

        <!-- ROW 2: Info grid -->
        <div class="loan-meta-grid">

            <div class="meta-item">
                <div class="lbl">Member's Name</div>
                <div class="val">@Txt(loan.CustomerName)</div>
            </div>

            <div class="meta-item">
                <div class="lbl">Member Account Number/Reference</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyCustomerId" class="code-pill" data-copy="@Txt(loan.CustomerId)">@Txt(loan.CustomerId)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy CustomerId" onclick="copyFromEl('copyCustomerId')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="meta-item">
                <div class="lbl">Loan Id</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyLoanId" class="code-pill" data-copy="@Txt(loan.Id)">@Txt(loan.Id)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy LoanId" onclick="copyFromEl('copyLoanId')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <div class="meta-item">
                <div class="lbl">Loan Account Number</div>
                <div class="val d-flex align-items-center gap-2">
                    <span id="copyAccountNo" class="code-pill" data-copy="@Txt(loan.AccountNumber)">@Txt(loan.AccountNumber)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                            title="Copy Account" onclick="copyFromEl('copyAccountNo')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            @*<div class="meta-item">
                    <div class="lbl">Branch</div>
                    <div class="val">@Txt(loan.BranchName) (@Txt(loan.BranchCode))</div>
                </div>*@

            <div class="meta-item">
                <div class="lbl">Branch Info</div>
                <div class="val">
                    @*<span class="text-muted">Init:</span>
                        <b id="copyInitBranch" data-copy="@Txt(loan.InitiatingBranchId)">@Txt(loan.InitiatingBranchId)</b>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon ms-1"
                                title="Copy Initiating BranchId" onclick="copyFromEl('copyInitBranch')">
                            <i class="mdi mdi-content-copy"></i>
                        </button>*@

                    <span class="mx-2 text-muted">•</span>

                    <span class="text-muted">Disb:</span>
                    <b id="copyDisbBranch" data-copy="@($"{Txt(loan.RDisbursementBranchName)} ({Txt(loan.RDisbursementBranchCode)})")">
                        @Txt(loan.RDisbursementBranchName) (@Txt(loan.RDisbursementBranchCode))
                    </b>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon ms-1"
                            title="Copy Disbursement Branch" onclick="copyFromEl('copyDisbBranch')">
                        <i class="mdi mdi-content-copy"></i>
                    </button>
                </div>
            </div>

            <!-- ✅ NEW: ORIGIN TILE (fills the red area) -->
            <div class="meta-item @originCardClass">
                <div class="lbl d-flex justify-content-between align-items-center">
                    <span>Loan Origin</span>
                    <span class="badge @originBadgeClass">@originText</span>
                </div>

                <div class="val">
                    @if (isMigrated)
                    {
                        <div class="small-note">
                            <i class="mdi mdi-database-import-outline me-1"></i>
                            Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                        </div>
                        @*<div class="small-note text-muted">
                                Upload Flag: <b>@(loan.IsUpload ? "YES" : "NO")</b>
                            </div>*@
                    }
                    else
                    {
                        <div class="small-note">
                            <i class="mdi mdi-shield-check-outline me-1 text-success"></i>
                            Core workflow loan (non-migrated).
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ROW 3: Chips -->
        <div class="loan-chips mt-2">

            <!-- STATUS -->
            <span class="chip">
                <span class="k">Status</span>
                <span class="b @statusBadgeClass">@Txt(loan.LoanStatus)</span>
            </span>

            <!-- CATEGORY -->
            <span class="chip">
                <span class="k">Category</span>
                <span class="b badge-soft-secondary">@Txt(loan.LoanCategory)</span>
            </span>

            <!-- TYPE -->
            <span class="chip">
                <span class="k">Type</span>
                <span class="b badge-soft-dark">@Txt(loan.LoanType)</span>
            </span>

            <!-- ✅ DELIQUENCY (SINGLE CHIP WITH DETAILS) -->
            @if (isDelinq)
            {
                <span class="chip">
                    <span class="k">Deliquent</span>
                    <span class="b badge-soft-danger">
                        YES •
                        Amt: @Money(loan.DeliquentAmount) •
                        Days: @loan.DeliquentDays •
                        Int: @Money(loan.DeliquentInterest)
                    </span>
                </span>
            }
            else
            {
                <span class="chip">
                    <span class="k">Deliquent</span>
                    <span class="b badge-soft-success">NO</span>
                </span>
            }


            <!-- INTEREST STATE -->
            <span class="chip">
                <span class="k">Interest</span>
                <span class="b @interestBadgeClass">@interestState</span>
            </span>

            <!-- ORIGIN -->
            <span class="chip">
                <span class="k">Origin</span>
                <span class="b @originBadgeClass">@(isMigrated ? "MIGRATED" : "NATIVE")</span>
            </span>

            <!-- ✅ REFINANCED -->
            @if (isRefinanced)
            {
                <span class="chip">
                    <span class="k">Refinanced</span>
                    <span class="b badge-soft-primary">YES</span>
                </span>
            }

            <!-- ✅ RESTRUCTURED -->
            @if (isRestructured)
            {
                <span class="chip">
                    <span class="k">Restructured</span>
                    <span class="b badge-soft-warning">YES</span>
                </span>
            }

            <!-- ✅ NEW LOAN ID (when present) -->
            @if (!string.IsNullOrWhiteSpace(relatedLoanId))
            {
                <span class="chip">
                    <span class="k">New Loan</span>
                    <span class="b badge-soft-info">
                        <span id="copyNewLoanId" class="code-strong" data-copy="@Txt(relatedLoanId)">
                            @Txt(relatedLoanId)
                        </span>
                        <button type="button"
                                class="btn btn-xs btn-outline-secondary btn-icon"
                                title="Copy New LoanId"
                                onclick="copyFromEl('copyNewLoanId')">
                            <i class="mdi mdi-content-copy"></i>
                        </button>
                    </span>
                </span>
            }
            else
            {
                <span class="chip">
                    <span class="k">New Loan</span>
                    <span class="b badge-soft-secondary">
                        -
                    </span>
                </span>
            }


            <!-- ✅ ADVANCE (single chip with details) -->
            @if (hasAdvance)
            {
                <span class="chip">
                    <span class="k">Advance</span>
                    <span class="b badge-soft-info">
                        YES • Amt: @Money(loan.AdvancedPaymentAmount) • Days: @loan.AdvancedPaymentDays
                    </span>
                </span>
            }


        </div>


    </div>


    <div class="p-3">

        <!-- NAV -->
        <!-- NAV (scrollable) -->
        <div class="loan-tabs-wrap">
            <ul class="nav nav-tabs loan-tabs" role="tablist">

                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#t_overview" type="button" title="Overview">
                        <i class="mdi mdi-view-dashboard-outline"></i><span>Overview</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_coverage" type="button" title="Loan Coverage Analysis">
                        <i class="mdi mdi-shield-check-outline"></i><span>Coverage</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_application" type="button">
                        <i class="mdi mdi-file-document-edit-outline"></i>
                        <span>APPLICATION</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_contract" type="button">
                        <i class="mdi mdi-file-sign"></i>
                        <span>CONTRACT</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_financials" type="button" title="Financials">
                        <i class="mdi mdi-cash-multiple"></i><span>Money</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_repayment" type="button" title="Repayments">
                        <i class="mdi mdi-history"></i><span>Payments</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_risk" type="button" title="Delinquency & Risk">
                        <i class="mdi mdi-alert-decagram-outline"></i><span>Risk</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_product" type="button" title="Product & Purpose">
                        <i class="mdi mdi-package-variant-closed"></i><span>Product</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_documents" type="button" title="Documents">
                        <i class="mdi mdi-folder-multiple-outline"></i><span>Docs</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_pcmf" type="button" title="PCMF">
                        <i class="mdi mdi-shield-check-outline"></i><span>PCMF</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_cobac" type="button" title="COBAC / Compliance">
                        <i class="mdi mdi-shield-star-outline"></i><span>COBAC</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_system" type="button" title="System / Posting">
                        <i class="mdi mdi-bank-outline"></i><span>Posting</span>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#t_audit" type="button" title="Audit / Extra">
                        <i class="mdi mdi-clipboard-text-outline"></i><span>Audit</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content pt-3 loan-tab-content-scroll">
            <div class="tab-content pt-3">

                <!-- ===================== OVERVIEW ===================== -->
                <div class="tab-pane fade show active" id="t_overview">
                    <div class="row g-3">

                        <!-- ===================== LEFT: IDENTITY & STATUS ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">

                                @{

                                    var _isRefinanced =
                                        appType.Equals("Refinanced", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Refinancing", StringComparison.OrdinalIgnoreCase);

                                    var _isRestructured =
                                        appType.Equals("Restructured", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Restructuring", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Rescheduled", StringComparison.OrdinalIgnoreCase)
                                        || appType.Equals("Reschedule", StringComparison.OrdinalIgnoreCase);

                                    var showContextBrief = _isRefinanced || _isRestructured;

                                    // local helper: "N/A" safe check
                                    Func<string, bool> IsValidId = (s) =>
                                        !string.IsNullOrWhiteSpace(s)
                                        && !s.Trim().Equals("N/A", StringComparison.OrdinalIgnoreCase);

                                    // local related id (does not override your global relatedLoanId, safe)
                                    var _relatedLoanId = IsValidId(loan.LoanId) ? loan.LoanId.Trim() : null;

                                    // Old snapshot values
                                    var oldAmt = app?.OldLoanAmount ?? 0m;
                                    var oldCap = app?.OldLoanCapital ?? 0m;
                                    var oldInt = app?.OldLoanInterest ?? 0m;
                                    var oldVat = app?.OldLoanVat ?? 0m;
                                    var oldPen = app?.OldLoanPenalty ?? 0m;

                                    // Refinancing requested amount
                                    var reqAmt = app?.RequestedAmount ?? 0m;

                                    // Overrides (if used)
                                    var hasOverride = app != null && app.IsOverRightOldLoanInterestAndBalance;
                                    var ovBal = app?.NewBalance ?? 0m;
                                    var ovInt = app?.NewInterest ?? 0m;
                                    var ovVat = app?.NewVAT ?? 0m;
                                    var ovPen = app?.NewPenalty ?? 0m;

                                    var stopOldInt = app != null && app.StopInterestCalculation;
                                }

                                <!-- header + quick badges -->
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-card-account-details-outline"></i> Identity & Status
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">REFINANCED</span>
                                        }

                                        <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                        </span>

                                        <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                            @Txt(loan.LoanStatus)
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• Legacy LoanId: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                                <!-- ✅ Context banner + actions + brief preview (Refinance/Restructure/Reschedule) -->
                                @if (showContextBrief)
                                {
                                    <div class="mt-2">

                                        <div class="alert @(_isRefinanced ? "alert-primary" : "alert-info") py-2 mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <div class="fw-bold">
                                                    <i class="mdi @(_isRefinanced ? "mdi-swap-horizontal-bold" : "mdi-file-refresh-outline") me-1"></i>
                                                    @(_isRefinanced ? "REFINANCING CONTEXT" : "RESTRUCTURING / RESCHEDULING CONTEXT")
                                                </div>
                                                <div class="small-note mb-0">
                                                    Old snapshot + requested/changed values are displayed below for traceability.
                                                </div>
                                            </div>

                                            <div class="d-flex gap-2 flex-wrap">

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#overviewOldLoanBrief"
                                                        aria-expanded="false"
                                                        aria-controls="overviewOldLoanBrief">
                                                    <i class="mdi mdi-eye-outline me-1"></i> Preview Old Loan (Brief)
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                                    <a class="btn btn-sm btn-outline-dark"
                                                       target="_blank" rel="noopener"
                                                       href="@Url.Action("LoanDetails","MembersFSeries", new { loanId = _relatedLoanId })">
                                                        <i class="mdi mdi-open-in-new me-1"></i> Open Related Loan (More Details)
                                                    </a>
                                                }

                                            </div>
                                        </div>

                                        <div class="collapse" id="overviewOldLoanBrief">
                                            <div class="card border-0 shadow-sm old-loan-brief">
                                                <div class="card-body p-3">

                                                    <!-- title line -->
                                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                        <div>
                                                            <div class="fw-bold">
                                                                <i class="mdi mdi-history me-1"></i> Old Loan Brief (From Loan Application)
                                                            </div>
                                                            <div class="text-muted small">
                                                                Type: <b>@Txt(app?.LoanApplicationType)</b>
                                                                <span class="mx-2 text-muted">•</span>
                                                                Old Loan Ref: <b>@Txt(app?.LoanId)</b>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex gap-2 flex-wrap">
                                                            @if (hasOverride)
                                                            {
                                                                <span class="badge bg-warning text-dark">
                                                                    <i class="mdi mdi-alert-outline me-1"></i> Override Applied
                                                                </span>
                                                            }
                                                            @if (stopOldInt)
                                                            {
                                                                <span class="badge bg-dark">
                                                                    <i class="mdi mdi-stop-circle-outline me-1"></i> Interest Stopped
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- old snapshot -->
                                                    <div class="row g-2">
                                                        <div class="col-md-3">
                                                            <div class="label-muted">Old Amount</div>
                                                            <div class="value-strong">@Money(oldAmt)</div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="label-muted">Old Capital</div>
                                                            <div class="value-strong">@Money(oldCap)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">Old Interest</div>
                                                            <div class="value-strong">@Money(oldInt)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">Old VAT</div>
                                                            <div class="value-strong">@Money(oldVat)</div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="label-muted">Old Penalty</div>
                                                            <div class="value-strong">@Money(oldPen)</div>
                                                        </div>
                                                    </div>

                                                    @if (_isRefinanced)
                                                    {
                                                        <hr class="my-2" />

                                                        <div class="row g-2 align-items-stretch">
                                                            <div class="col-lg-6">
                                                                <div class="brief-tile">
                                                                    <div class="tile-title">
                                                                        <i class="mdi mdi-cash-plus me-1"></i> Refinancing Request
                                                                    </div>
                                                                    <div class="tile-body">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span class="text-muted">Requested Amount</span>
                                                                            <span class="fw-bold">@Money(reqAmt)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">Old Loan Amount</span>
                                                                            <span class="fw-bold">@Money(oldAmt)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">Difference</span>
                                                                            <span class="fw-bold">@Money(reqAmt - oldAmt)</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-lg-6">
                                                                <div class="brief-tile">
                                                                    <div class="tile-title">
                                                                        <i class="mdi mdi-information-outline me-1"></i> Current Loan Summary
                                                                    </div>
                                                                    <div class="tile-body">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span class="text-muted">L.Amount</span>
                                                                            <span class="fw-bold">@Money(loan.LoanAmount)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">Current Balance</span>
                                                                            <span class="fw-bold">@Money(loan.Balance)</span>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between mt-1">
                                                                            <span class="text-muted">Interest Rate</span>
                                                                            <span class="fw-bold">@Percent(loan.InterestRate)</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <hr class="my-2" />

                                                        <div class="brief-tile">
                                                            <div class="tile-title">
                                                                <i class="mdi mdi-compare-horizontal me-1"></i> Changes Summary (Restructure / Reschedule)
                                                            </div>

                                                            <div class="tile-body">
                                                                <div class="row g-2">
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">New Balance</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovBal) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">New Interest</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovInt) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">New VAT</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovVat) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="label-muted">New Penalty</div>
                                                                        <div class="value-strong">
                                                                            @(hasOverride ? Money(ovPen) : "<span class='text-muted'>N/A</span>")
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="small text-muted mt-2">
                                                                    Note: “Changes” are shown only when override values were captured in the Loan Application.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                }

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Identity -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Identity</td>
                                    </tr>
                                    <!-- Origin / Migration -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Origin</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Origin</td>
                                        <td class="v">
                                            @if (isMigrated)
                                            {
                                                <span class="badge bg-dark">MIGRATED</span>
                                                <span class="text-muted ms-2">• @FDateNullable(loan.MigrationDate)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">NATIVE (CORE)</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Status -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Status</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Loan Status</td>
                                        <td class="v">
                                            <span class="badge @(string.Equals(loan.LoanStatus, "Open", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">
                                                @Txt(loan.LoanStatus)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr><td class="k">Journey Status</td><td class="v">@Txt(loan.LoanJourneyStatus)</td></tr>
                                    <tr><td class="k">Loan Category</td><td class="v">@Txt(loan.LoanCategory)</td></tr>
                                    <tr><td class="k">Loan Type</td><td class="v">@Txt(loan.LoanType)</td></tr>
                                    <tr><td class="k">Type Category</td><td class="v">@Txt(loan.LoanTypeCategory)</td></tr>

                                    <!-- Restructure / Refinance -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Restructure / Refinance</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Status</td>
                                        <td class="v">
                                            @if (_isRestructured)
                                            {
                                                <span class="badge bg-info text-dark">RESTRUCTURED / RESCHEDULED</span>
                                                if (!string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                                    <span class="text-muted ms-2">• Related LoanId: <b>@Txt(_relatedLoanId)</b></span>
                                                }
                                            }
                                            else if (_isRefinanced)
                                            {
                                                <span class="badge bg-primary">REFINANCED</span>
                                                if (string.IsNullOrWhiteSpace(_relatedLoanId))
                                                {
                                                    <span class="text-muted ms-2">• Related loan not available</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Disbursement -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Disbursement</td>
                                    </tr>
                                    <tr>
                                        <td class="k">Is Disbursed?</td>
                                        <td class="v">
                                            <span class="badge @(loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                                @(loan.IsLoanDisbursted ? "YES" : "NO")
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                            {
                                                <span class="text-muted ms-2">• @Txt(loan.DisbursmentStatus)</span>
                                            }
                                        </td>
                                    </tr>

                                    <!-- Ownership -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Ownership</td>
                                    </tr>
                                    <tr><td class="k">Loan Manager</td><td class="v">@Txt(loan.LoanManager)</td></tr>
                                    <tr><td class="k">Disbursed By</td><td class="v">@Txt(loan.LoanDisbursedBy)</td></tr>

                                    <!-- Flags -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Flags</td>
                                    </tr>
                                    <tr><td class="k">Write-Off</td><td class="v">@(loan.IsWriteOffLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Current Loan</td><td class="v">@(loan.IsCurrentLoan ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Completed</td><td class="v">@(loan.IsCompleted ? "YES" : "NO")</td></tr>

                                    <!-- Audit -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Audit</td>
                                    </tr>
                                    <tr><td class="k">Last Event Date</td><td class="v">@FDate(loan.LastEventData)</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- ===================== RIGHT: DATES & SCHEDULE ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-calendar-clock-outline"></i> Dates & Schedule
                                    </div>

                                    <!-- top quick badges -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED" : "NATIVE")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">REFINANCED</span>
                                        }

                                        <span class="badge @(stopInterest ? "bg-dark" : "bg-light text-dark border")">
                                            INT: @(stopInterest ? "STOPPED" : "RUNNING")
                                        </span>
                                    </div>
                                </div>

                                <!-- migrated hint -->
                                @if (isMigrated)
                                {
                                    <div class="small-note mt-2">
                                        <i class="mdi mdi-database-import-outline me-1"></i>
                                        Migration Date: <b>@FDateNullable(loan.MigrationDate)</b>
                                        @if (!string.IsNullOrWhiteSpace(loan.LoanId))
                                        {
                                            <span class="text-muted">• Legacy LoanId: <b>@Txt(loan.LoanId)</b></span>
                                        }
                                    </div>
                                }

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <!-- Timeline -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Timeline</td>
                                    </tr>
                                    <tr><td class="k">Loan Date</td><td class="v">@FDate(loan.LoanDate)</td></tr>
                                    <tr><td class="k">Disbursement Date</td><td class="v">@FDate(loan.DisbursementDate)</td></tr>

                                    <!-- Installments -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Installment Schedule</td>
                                    </tr>
                                    <tr><td class="k">First Installment Date</td><td class="v">@FDateShort(loan.FirstInstallmentDate)</td></tr>
                                    <tr><td class="k">Next Installment Date</td><td class="v">@FDateShort(loan.NextInstallmentDate)</td></tr>
                                    <tr><td class="k">Maturity Date</td><td class="v">@FDateShort(loan.MaturityDate)</td></tr>

                                    <!-- Processing -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Processing Dates</td>
                                    </tr>
                                    <tr><td class="k">Last Refund Date</td><td class="v">@FDate(loan.LastRefundDate)</td></tr>
                                    <tr><td class="k">Last Interest Calc Date</td><td class="v">@FDate(loan.LastInterestCalculatedDate)</td></tr>
                                    <tr><td class="k">Last Delinquency Proc</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                                    <!-- Structuring -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Structuring</td>
                                    </tr>
                                    <tr><td class="k">Structuring Date</td><td class="v">@FDate(loan.LoanStructuringDate)</td></tr>
                                    <tr><td class="k">Structuring Status</td><td class="v">@Txt(loan.LoanStructuringStatus)</td></tr>

                                    <!-- Interest stop control -->
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">Interest Stop / Controls</td>
                                    </tr>
                                    <tr><td class="k">Interest Stop?</td><td class="v">@(stopInterest ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">Stopped By</td><td class="v">@Txt(loan.StoppedBy)</td></tr>
                                    <tr>
                                        <td class="k">Stop Date</td>
                                        <td class="v">
                                            @if (stopDateMissing)
                                            {
                                                <span class="text-danger fw-bold">STOPPED BUT DATE MISSING</span>
                                            }
                                            else
                                            {
                                                @FDate(loan.DateInterestWastStoped)
                                            }
                                        </td>
                                    </tr>
                                    <tr><td class="k">Stop Comment</td><td class="v">@Txt(loan.InterestStoppedComment)</td></tr>

                                </table>
                            </div>
                        </div>

                        <!-- initiation / disbursement branches (GROUPED + CLEAN TRACEABILITY) -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-source-branch"></i>
                                        Initiation, Approval & Disbursement Traceability
                                    </div>

                                    <!-- TOP BADGES -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge @(isMigrated ? "bg-dark" : "bg-light text-dark border")">
                                            @(isMigrated ? "MIGRATED LOAN" : "NATIVE LOAN")
                                        </span>

                                        @if (_isRestructured)
                                        {
                                            <span class="badge bg-info text-dark">RESTRUCTURED</span>
                                        }
                                        @if (_isRefinanced)
                                        {
                                            <span class="badge bg-primary">REFINANCED</span>
                                        }

                                        <span class="badge @(string.Equals(loan.DisbursmentStatus, "Disbursed", StringComparison.OrdinalIgnoreCase) || loan.IsLoanDisbursted ? "bg-success" : "bg-secondary")">
                                            DISB: @(loan.IsLoanDisbursted ? "YES" : "NO")
                                        </span>

                                        <span class="badge @(loan.RDisbursementAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            DISB POST: @(loan.RDisbursementAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>

                                        <span class="badge @(loan.RApprovalAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                            APRV POST: @(loan.RApprovalAccountingPostingStatus ? "DONE" : "PENDING")
                                        </span>
                                    </div>
                                </div>

                                @{
                                    var isInterBranch =
                                        !string.IsNullOrWhiteSpace(loan.InitiatingBranchId)
                                        && !string.IsNullOrWhiteSpace(loan.BranchId)
                                        && !string.Equals(loan.InitiatingBranchId, loan.BranchId, StringComparison.OrdinalIgnoreCase);
                                }

                                <!-- ===================== MIGRATED ONLY ===================== -->
                                @if (isMigrated)
                                {
                                    <div class="alert alert-dark py-2 mb-0">
                                        <div class="fw-bold">
                                            <i class="mdi mdi-database-import-outline me-1"></i>
                                            This is a <u>MIGRATED</u> loan.
                                        </div>
                                        <div class="small-note mb-0">
                                            Migration information is shown below for audit traceability.
                                        </div>

                                        <div class="row g-3 mt-2">
                                            <div class="col-md-4">
                                                <div class="small-note">Legacy LoanId (Upload)</div>
                                                <div class="fw-bold">@Txt(loan.LoanId)</div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="small-note">Migration Date</div>
                                                <div class="fw-bold">@FDateNullable(loan.MigrationDate)</div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="small-note">Upload Flag</div>
                                                <div class="fw-bold">@(loan.IsUpload ? "YES" : "NO")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- ===================== NATIVE SUMMARY ===================== -->
                                    <div class="alert alert-light border py-2 mb-3">
                                        <div class="fw-bold">
                                            <i class="mdi mdi-check-decagram-outline me-1 text-success"></i>
                                            This is a <u>NATIVE</u> (non-migrated) loan.
                                        </div>
                                        <div class="small-note mb-0">
                                            All initiation/approval/disbursement states are from the core workflow.
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 1: BRANCH TRACE ===================== -->
                                    <div class="card border-0 shadow-sm mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-map-marker-path me-1"></i> Branch Trace
                                                </div>

                                                <span class="badge @(isInterBranch ? "bg-warning text-dark" : "bg-success")">
                                                    @(isInterBranch ? "INTER-BRANCH: YES" : "INTER-BRANCH: NO")
                                                </span>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="small-note">Initiating BranchId</div>
                                                    <div class="fw-bold">@Txt(loan.InitiatingBranchId)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Loan Branch (Current / Owner)</div>
                                                    <div class="fw-bold">@Txt(loan.BranchName) (@Txt(loan.BranchCode))</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Disbursement Branch (Routing)</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursementBranchName) (@Txt(loan.RDisbursementBranchCode))</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 2: DISBURSEMENT INFO ===================== -->
                                    <div class="card border-0 shadow-sm mb-3">
                                        <div class="card-body p-3">
                                            <div class="fw-bold mb-2">
                                                <i class="mdi mdi-cash-fast me-1"></i> Disbursement Information
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="small-note">Disbursement Status</div>
                                                    <div class="fw-bold">
                                                        @(loan.IsLoanDisbursted ? "DISBURSED" : "NOT DISBURSED")
                                                        @if (!string.IsNullOrWhiteSpace(loan.DisbursmentStatus))
                                                        {
                                                            <span class="text-muted">• @Txt(loan.DisbursmentStatus)</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Disbursement Reference</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursementReference)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">R Disbursement Date</div>
                                                    <div class="fw-bold">@FDateNullable(loan.RDisbursementDate)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Disbursed By (Refinancing/Route)</div>
                                                    <div class="fw-bold">@Txt(loan.RDisbursedBy)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Loan Disbursed By (Core)</div>
                                                    <div class="fw-bold">@Txt(loan.LoanDisbursedBy)</div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="small-note">Loan Manager</div>
                                                    <div class="fw-bold">@Txt(loan.LoanManager)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ===================== GROUP 3: POSTING + AUDIT ===================== -->
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body p-3">

                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                <div class="fw-bold">
                                                    <i class="mdi mdi-shield-check-outline me-1"></i> Accounting Posting & Audit
                                                </div>



                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge @(taxable ? "badge-taxable" : "badge-nontax")">
                                                        <i class="mdi @(taxable ? "mdi-check-decagram-outline" : "mdi-close-circle-outline") me-1"></i>
                                                        @taxLabel
                                                    </span>

                                                    <span class="badge @(loan.RDisbursementAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                                        DISB POST: @(loan.RDisbursementAccountingPostingStatus ? "DONE" : "PENDING")
                                                    </span>

                                                    <span class="badge @(loan.RApprovalAccountingPostingStatus ? "bg-success" : "bg-warning text-dark")">
                                                        APRV POST: @(loan.RApprovalAccountingPostingStatus ? "DONE" : "PENDING")
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="row g-3 align-items-start">

                                                <!-- LEFT: Posting status -->
                                                <div class="col-md-6">
                                                    <div class="small-note">Accounting Posting Status</div>

                                                    <div class="fw-bold">
                                                        Disbursement:
                                                        <span class="@(loan.RDisbursementAccountingPostingStatus ? "text-success" : "text-warning")">
                                                            @(loan.RDisbursementAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                                        </span>
                                                        <span class="text-muted">•</span>
                                                        Approval:
                                                        <span class="@(loan.RApprovalAccountingPostingStatus ? "text-success" : "text-warning")">
                                                            @(loan.RApprovalAccountingPostingStatus ? "POSTED" : "NOT POSTED")
                                                        </span>
                                                    </div>

                                                    <div class="small-note mt-1">
                                                        Consistency:
                                                        @if (loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                                        {
                                                            <span class="fw-bold text-success">FULLY POSTED</span>
                                                        }
                                                        else if (!loan.RDisbursementAccountingPostingStatus && loan.RApprovalAccountingPostingStatus)
                                                        {
                                                            <span class="fw-bold text-danger">APPROVAL POSTED BUT DISBURSEMENT NOT POSTED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold text-warning">PENDING / INCOMPLETE</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- RIGHT: Audit keys -->
                                                <div class="col-md-6">
                                                    <div class="small-note">Audit / Trace Keys</div>
                                                    <div class="fw-bold">
                                                        LoanAppId: <span class="text-muted">@Txt(loan.LoanApplicationId)</span>
                                                        <span class="text-muted">•</span>
                                                        ApplicationCode: <span class="text-muted">@Txt(loan.ApplicationCode)</span>
                                                    </div>
                                                </div>

                                                <!-- FULL WIDTH: GLs used -->
                                                <div class="col-12">
                                                    <div class="p-2 border rounded bg-light">

                                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                            <div class="fw-bold">
                                                                <i class="mdi mdi-bank-outline me-1"></i> GLs Used (Approval & Disbursement)
                                                            </div>

                                                            <div class="small-note text-muted">
                                                                Code/Name shown for users • Id shown for traceability
                                                            </div>
                                                        </div>

                                                        @{
                                                            // Core GLs (these exist on your loan model)
                                                            var principalGlId = loan.AffiliateChartOfAccountIdForPrincipalAmount;
                                                            var transitGlId = loan.AffiliateChartOfAccountIdForTransit;

                                                            // Optional GLs
                                                            var vatGlId = loan.AffiliateChartOfAccountIdForVat;
                                                            var interestGlId = loan.AffiliateChartOfAccountIdForInterest;
                                                            var penaltyGlId = loan.AffiliateChartOfAccountIdForPenalty;

                                                            // Helper: show VAT only when taxable
                                                            var showVat = taxable && !string.IsNullOrWhiteSpace(vatGlId);

                                                            // ✅ We’ll define “GLs used for approval/disbursement” as the mapping set the posting builder relies on.
                                                            // Disbursement typically hits Principal + Transit (+ VAT if taxable and your posting computes VAT).
                                                            // Approval also relies on same mapping for the approval postings/validation in most workflows.
                                                        }

                                                        <div class="row g-2">

                                                            <!-- Core GLs -->
                                                            <div class="col-lg-6">
                                                                <div class="p-2 border rounded bg-white h-100">
                                                                    <div class="fw-bold mb-2">
                                                                        <i class="mdi mdi-format-list-bulleted me-1"></i> Core GLs
                                                                    </div>

                                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                                        <div>
                                                                            <div class="small-note">Principal GL</div>
                                                                            <div class="fw-bold">@GlText(principalGlId)</div>
                                                                        </div>
                                                                        <div class="text-end">
                                                                            <div class="small-note text-muted">Id</div>
                                                                            <div class="small-note text-muted">@Txt(principalGlId)</div>
                                                                        </div>
                                                                    </div>

                                                                    <hr class="my-2" />

                                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                                        <div>
                                                                            <div class="small-note">Transit GL</div>
                                                                            <div class="fw-bold">@GlText(transitGlId)</div>
                                                                        </div>
                                                                        <div class="text-end">
                                                                            <div class="small-note text-muted">Id</div>
                                                                            <div class="small-note text-muted">@Txt(transitGlId)</div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="small-note text-muted mt-2">
                                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                                        These GLs are always required for principal movement and routing.
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Disbursement GLs Used -->
                                                            <div class="col-lg-6">
                                                                <div class="p-2 border rounded bg-white h-100">
                                                                    <div class="fw-bold mb-2">
                                                                        <i class="mdi mdi-cash-check me-1"></i> Disbursement GLs Used
                                                                    </div>

                                                                    <div class="row g-2">
                                                                        <div class="col-md-6">
                                                                            <div class="small-note">Principal GL</div>
                                                                            <div class="fw-bold">@GlText(principalGlId)</div>
                                                                            <div class="small-note text-muted">Id: @Txt(principalGlId)</div>
                                                                        </div>

                                                                        <div class="col-md-6">
                                                                            <div class="small-note">Transit GL</div>
                                                                            <div class="fw-bold">@GlText(transitGlId)</div>
                                                                            <div class="small-note text-muted">Id: @Txt(transitGlId)</div>
                                                                        </div>

                                                                        @if (showVat)
                                                                        {
                                                                            <div class="col-md-6">
                                                                                <div class="small-note">VAT GL (Taxable)</div>
                                                                                <div class="fw-bold">@GlText(vatGlId)</div>
                                                                                <div class="small-note text-muted">Id: @Txt(vatGlId)</div>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="col-md-6">
                                                                                <div class="small-note">VAT GL</div>
                                                                                <div class="fw-bold text-muted">Not used</div>
                                                                                <div class="small-note text-muted">
                                                                                    @(taxable ? "VAT GL missing" : "Non-taxable posting")
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    <div class="small-note text-muted mt-2">
                                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                                        Disbursement posts principal movement via Principal/Transit.
                                                                        VAT is only applied when taxable.
                                                                    </div>
                                                                </div>
