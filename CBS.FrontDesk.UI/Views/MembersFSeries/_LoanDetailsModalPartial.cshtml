                </div>

                <!-- ===================== LOAN COVERAGE ANALYSIS TAB ===================== -->
                <div class="tab-pane fade" id="t_coverage">
                    @{

                        // --- Policy source (as you requested) ---
                        // If your LoanProduct has policies by term, swap this line accordingly.
                        // Example: var policy = app?.LoanProduct?.LoanProductPolicies?.FirstOrDefault(x => x.TermId == app.LoanTermId);
                        var policy = app?.LoanProduct.Policy;

                        // --- Base values ---
                        var approvedAmount = app?.Amount ?? loan?.LoanAmount ?? 0m;
                        var requestedAmount = app?.RequestedAmount ?? loan?.RequestedAmount ?? 0m;

                        var balance = loan?.Balance ?? 0m;
                        var due = loan?.DueAmount ?? 0m;
                        var paid = loan?.Paid ?? 0m;
                        var principal = loan?.Principal ?? 0m;

                        // Rates (application based)
                        var intRate = app?.InterestRate ?? loan?.InterestRate ?? 0m;
                        var vatRate = app?.VatRate ?? loan?.VatRate ?? 0m;

                        // Computed interest (loan runtime)
                        var intForecast = loan?.InterestForcasted ?? 0m;
                        var intAccrued = loan?.AccrualInterest ?? 0m;
                        var intLastCalc = loan?.LastCalculatedInterest ?? 0m;
                        var intAccruedPaid = loan?.AccrualInterestPaid ?? 0m;

                        // Charges
                        var tax = loan?.Tax ?? 0m;
                        var taxPaid = loan?.TaxPaid ?? 0m;
                        var fee = loan?.Fee ?? 0m;
                        var feePaid = loan?.FeePaid ?? 0m;
                        var penalty = loan?.Penalty ?? 0m;
                        var penaltyPaid = loan?.PenaltyPaid ?? 0m;

                        var lastPenalty = loan?.LastCalculatedPenaltyAmount ?? 0m;
                        var penaltyCalcDate = loan?.LastPenaltyCalculationDate;

                        var paidUpfront = (policy?.InterestMustBePaidUpFront ?? app?.IsInterestPaidUpFront ?? loan?.InterestMustBePaidUpFront ?? false);
                        var upfrontAmount = (app?.InterestAmountUpfront ?? loan?.InterestAmountUpfront ?? 0m);

                        // --- Savings snapshot at application time ---
                        var savingBalanceAtApp = app?.SavingBalance ?? loan?.SavingBalance ?? 0m;
                        var blockedSavingAtApp = app?.BlockedSaving ?? loan?.BlockedSaving ?? 0m;

                        // --- Down payment: POLICY based ---
                        var downPctRequired = policy?.MinimumDownPaymentPercentage ?? 0m;     // % (e.g., 20)
                        var downAmountRequired = approvedAmount > 0m ? (downPctRequired / 100m) * approvedAmount : 0m;

                        // Provided down payment from application
                        var downPaid = app?.DownPaymentCoverageAmountProvided ?? 0m;
                        var downPaidPct = approvedAmount > 0m ? (downPaid / approvedAmount) * 100m : 0m;

                        var downPaymentRequiredByPolicy = downPctRequired > 0m;
                        var downOk = !downPaymentRequiredByPolicy || downPaid >= downAmountRequired;

                        // --- Blocking behavior: POLICY + application flags ---
                        var mustBlockSavings = (policy?.BlockSavingAccount ?? app?.BlockSavingAccount ?? false);
                        var savingBlockRate = app?.SavingAccountCoverageRate ?? 0m; // % of loan to block (if you use it)
                        var requiredSavingsBlock = (mustBlockSavings && approvedAmount > 0m && savingBlockRate > 0m)
                            ? (savingBlockRate / 100m) * approvedAmount
                            : 0m;

                        var missingSavingsBlock = mustBlockSavings ? Math.Max(0m, requiredSavingsBlock - blockedSavingAtApp) : 0m;

                        // --- Guarantors coverage ---
                        var guarantors = app?.Guarantors ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanGuarantor>();
                        var guarantorCover = guarantors.Sum(x => x?.GuaranteeAmount ?? 0m);

                        // --- Collateral coverage rate (% only) ---
                        var collateralRate = app?.CollateralCoverageRate ?? 0m;

                        // --- Other coverage amounts from application (volume-based) ---
                        var coverDeposit = app?.DepositAccountCoverageAmount ?? 0m;
                        var coverSalary = app?.SalaryAccountCoverageAmount ?? 0m;
                        var coverTermDeposit = app?.TermDeposiAccountCoverageAmount ?? 0m;

                        // Shares are NOT coverage (eligibility only)
                        var shareRequired = policy?.MinimumShareAccountBalanceForTheRequestAmount ?? 0m; // policy requirement (if you use it)
                        var sharesRequiredAmount = app?.ShareAccountCoverageAmount ?? 0m;
                        var prefSharesAmount = app?.PreferenceShareAccountCoverageAmount ?? 0m;

                        // --- Your special rule:
                        // If (Loan BALANCE) is within (Saving Balance) during the granted period => treated as covered.
                        // We express it as a "Liquidity Coverage" check.
                        var liquidityCoveredBySavings = (savingBalanceAtApp > 0m && balance > 0m && savingBalanceAtApp >= balance);

                        // --- Coverage volume calculation (policy-aware) ---
                        // Coverage volume should represent REAL money protection/coverage:
                        // Down payment paid + deposit/salary/term deposit coverage + guarantors.
                        // Blocked saving is not double-counted unless it represents coverage pledged.
                        // (If your DepositAccountCoverageAmount already includes savings pledge, do NOT also add blocked saving.)
                        var coverageVolume =
                            downPaid
                            + coverDeposit
                            + coverSalary
                            + coverTermDeposit
                            + guarantorCover;

                        var coveragePct = approvedAmount > 0m ? (coverageVolume / approvedAmount) * 100m : 0m;

                        // If collateral is rate-only, include it as % uplift (not volume)
                        var coveragePctWithCollateral = coveragePct + collateralRate;

                        // Coverage target configured in application (if used)
                        var targetPct = app?.TotalLoanRiskCoverage ?? 0m;

                        // Final decision logic (professional + explainable):
                        // A file is "Covered" if:
                        // 1) Down payment requirement satisfied (if any), AND
                        // 2) Coverage % meets target OR liquidityCoveredBySavings is true
                        //    (because you said balance within saving balance => covered)
                        var meetsTarget = targetPct <= 0m ? (coveragePctWithCollateral > 0m) : (coveragePctWithCollateral >= targetPct);

                        var isCovered = downOk && (meetsTarget || liquidityCoveredBySavings);

                        // Risk label
                        var risk =
                            isCovered && liquidityCoveredBySavings ? "LOW" :
                            isCovered ? "MEDIUM" :
                            "HIGH";

                        var riskBadge =
                            risk == "LOW" ? "bg-success" :
                            risk == "MEDIUM" ? "bg-warning text-dark" :
                            "bg-danger";

                        var advice = new List<string>();

                        if (downPaymentRequiredByPolicy && !downOk)
                        {
                            advice.Add($"Down payment is below policy minimum ({downPctRequired:0.##}%). Required: {Money(downAmountRequired)}");
                        }

                        if (mustBlockSavings && missingSavingsBlock > 0m)
                        {
                            advice.Add($"Savings blocking is required. Please block an additional {Money(missingSavingsBlock)} to reach the required coverage.");
                        }

                        if (!liquidityCoveredBySavings && savingBalanceAtApp <= 0m)
                        {
                            advice.Add("Member saving balance at application time is zero or not available; liquidity coverage cannot be established.");
                        }

                        if (!meetsTarget && !liquidityCoveredBySavings)
                        {
                            advice.Add("Coverage is below the configured target and not supported by liquidity coverage. Consider adding guarantors/collateral or adjusting amount/term.");
                        }

                        if (liquidityCoveredBySavings && mustBlockSavings && blockedSavingAtApp <= 0m)
                        {
                            advice.Add("Although savings balance can cover the loan balance, it is not blocked. Block the required portion to comply with policy.");
                        }

                        Func<decimal, decimal> Pct = (vol) => approvedAmount > 0m ? (vol / approvedAmount) * 100m : 0m;                        // Helper

                        // --- Member accounts list (must be provided by controller) ---
                        // Expected: IEnumerable<MemberAccountVm> in ViewBag.MemberAccounts
                        var memberAccounts = ViewBag.MemberAccounts as IEnumerable<CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.MemberAccountVm> ?? Enumerable.Empty<CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.MemberAccountVm>();

                        // ===============================
                        // Totals for footer & analysis
                        // ===============================
                        decimal totalActual = 0m;
                        decimal totalBlocked = 0m;
                        decimal totalAvailable = 0m;

                        foreach (var a in memberAccounts)
                        {
                            var available = Math.Max(0m, a.Balance - a.BlockedAmount);

                            totalActual += a.Balance;
                            totalBlocked += a.BlockedAmount;
                            totalAvailable += available;
                        }

                        // ============================
                        // Current-date liquidity analysis
                        // ============================

                        decimal eligibleLiquidityNow = 0m;
                        decimal excludedLiquidity = 0m;

                        foreach (var a in memberAccounts)
                        {
                            // Exclude shares explicitly
                            var isShare =
                                a.AccountType == "PreferenceShare" ||
                                a.AccountType == "OrdinaryShare";

                            if (isShare)
                            {
                                excludedLiquidity += a.Balance;
                                continue;
                            }

                            // Only what is AVAILABLE can cover risk
                            var available = Math.Max(0m, a.Balance - a.BlockedAmount);
                            eligibleLiquidityNow += available;
                        }

                        var currentLoanBalance = loan.Balance;
                        var liquidityGap = eligibleLiquidityNow - currentLoanBalance;

                        var currentlyCovered = eligibleLiquidityNow >= currentLoanBalance;

                        var currentRisk =
                            currentlyCovered ? "LOW" :
                            liquidityGap >= -(currentLoanBalance * 0.2m) ? "MEDIUM" :
                            "HIGH";

                        var currentRiskBadge =
                            currentRisk == "LOW" ? "bg-success" :
                            currentRisk == "MEDIUM" ? "bg-warning text-dark" :
                            "bg-danger";
                    }

                    <div class="row g-3">

                        <!-- ===================== COVERAGE DECISION ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-shield-check-outline"></i> @GlobalMembersFSeries.coverage_decision_policy_application_liquidity_rule
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">
                                            @GlobalShared.cover: @Money(coverageVolume) (@coveragePctWithCollateral.ToString("0.00")%)
                                        </span>
                                        @if (targetPct > 0m)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @GlobalShared.target: @targetPct.ToString("0.00")%
                                            </span>
                                        }
                                        <span class="badge @(isCovered ? "bg-success" : "bg-danger")">
                                            @GlobalShared.File: @(isCovered ? "COVERED" : "NOT COVERED")
                                        </span>
                                        <span class="badge @riskBadge">@GlobalShared.Risk: @risk</span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (isCovered)
                                    {
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            <b>@GlobalShared.Status:</b> @GlobalMembersFSeries.this_loan_file_is_covered_based_on_policy_checks_and_the_liquidity_rule.
                                        </div>
                                    }
                                    else
                                    {
                                <div class="alert alert-danger py-2 mb-2">
                                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                                    <b>@GlobalShared.Status:</b> @GlobalMembersFSeries.this_loan_file_is_not_covered_requirements_are_missing_or_insufficient.
                                </div>
                                    }

                                    <div class="alert @(liquidityCoveredBySavings ? "alert-success" : "alert-warning") py-2 mb-0">
                                        <i class="mdi mdi-bank-outline me-1"></i>
                                        <b>@GlobalShared.liquidity_rule:</b>
                                        @if (balance <= 0m)
                                        {
                                            <span>@GlobalMembersFSeries.no_outstanding_balance_detected_on_the_loan.</span>
                                        }
                                        else if (liquidityCoveredBySavings)
                                        {
                                    <span>
                                        @GlobalShared.Balance (@Money(balance)) @GlobalMembersFSeries.is_within_member_saving_balance_at_application_time (@Money(savingBalanceAtApp)).
                                        @GlobalMembersFSeries.this_supports_coverage_during_the_granted_period.
                                    </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @GlobalMembersFSeries.saving_balance_at_application_time (@Money(savingBalanceAtApp)) @GlobalMembersFSeries.does_not_cover_current_loan_balance (@Money(balance)).
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- ===== Mini panels ===== -->
                                <div class="row g-3 mt-1">

                                    <!-- Down payment -->
                                    <div class="col-lg-4">
                                        <div class="p-2 rounded border">
                                            <div class="fw-bold small mb-2">
                                                <i class="mdi mdi-cash-check me-1"></i> @GlobalMembersFSeries.down_payment_policy
                                            </div>

                                            <table class="table table-sm kv-table mb-0">
                                                <tr><td class="k">Min % (Policy)</td><td class="v">@downPctRequired.ToString("0.##")%</td></tr>
                                                <tr><td class="k">@GlobalShared.required_amount</td><td class="v">@Money(downAmountRequired)</td></tr>
                                                <tr><td class="k">@GlobalMembersFSeries.provided_amount</td><td class="v">@Money(downPaid)</td></tr>
                                                <tr>
                                                    <td class="k">@GlobalShared.provided %</td>
                                                    <td class="v">
                                                        @downPaidPct.ToString("0.00")%
                                                        <span class="ms-2 badge @(downOk ? "bg-success" : "bg-danger")">@(downOk ? "OK" : "NOT OK")</span>
                                                    </td>
                                                </tr>
