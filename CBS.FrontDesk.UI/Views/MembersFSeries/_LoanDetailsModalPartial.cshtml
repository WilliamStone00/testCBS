                                                        <td>
                                                            @Txt(g?.PhoneNumber)
                                                            @if (!string.IsNullOrWhiteSpace(g?.Email))
                                                            {
                                                                <div class="text-muted small">@Txt(g.Email)</div>
                                                            }
                                                        </td>
                                                        <td><span class="code-strong">@Txt(g?.AccountNumber)</span></td>
                                                        <td class="text-end fw-bold">@Money(amt)</td>
                                                        <td class="text-end">@pct.ToString("0.00")%</td>
                                                    </tr>
                                                }

                                                <tr class="table-light">
                                                    <td colspan="5" class="fw-bold">@GlobalShared.Total</td>
                                                    <td class="text-end fw-bold">@Money(totalGuar)</td>
                                                    <td class="text-end fw-bold">@guarPct.ToString("0.00")%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-2 text-muted small">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        @Html.(@GlobalMembersFSeries.coverage_per_guarantor_is_computed_as_guaranteeamount_approvedamount).
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ===================== MEMBER ACCOUNTS + BLOCKING INTERFACE ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-lock-plus-outline"></i> @GlobalMembersFSeries.member_accounts_blocking_controls
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="openBlockAccountModal()">
                                        <i class="mdi mdi-lock-outline me-1"></i> @GlobalMembersFSeries.block_an_account
                                    </button>
                                </div>

                                <div class="text-muted small mt-2">
                                    @Html.Raw(@GlobalMembersFSeries.analysis_is_based_on_current_balances_as_at_today).
                                    @Html.Raw(@GlobalMembersFSeries.preference_ordinary_shares_are_excluded_from_coverage_but_required_for_eligibility).
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="table table-sm table-hover align-middle mb-0" id="memberAccountsTable">

                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:180px;">@GlobalShared.Account_Number</th>
                                                <th style="min-width:220px;">@GlobalShared.Account_Name</th>

                                                <!-- NEW -->
                                                <th class="text-end" style="min-width:160px;">@GlobalShared.Actual_balance</th>

                                                <th class="text-end" style="min-width:160px;">@GlobalShared.Blocked</th>
                                                <th class="text-end" style="min-width:160px;">@GlobalMembersFSeries.available_for_coverage</th>
                                                <th style="min-width:160px;">@GlobalShared.Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (!memberAccounts.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-3">
                                                        @GlobalMembersFSeries.no_member_accounts_found.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                foreach (var a in memberAccounts)
                                                {
                                                    var available = Math.Max(0m, a.Balance - a.BlockedAmount);

                                                    <tr>
                                                        <td class="code-strong">@Txt(a.AccountNumber)</td>
                                                        <td>@Txt(a.AccountName)</td>

                                                        <!-- Actual -->
                                                        <td class="text-end fw-bold">@Money(a.Balance)</td>

                                                        <!-- Blocked -->
                                                        <td class="text-end">@Money(a.BlockedAmount)</td>

                                                        <!-- Available -->
                                                        <td class="text-end @(available <= 0 ? "text-muted" : "fw-semibold")">
                                                            @Money(available)
                                                        </td>

                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-warning js-open-block"
                                                                    data-acct="@a.AccountNumber"
                                                                    data-name="@a.AccountName"
                                                                    data-type="@a.AccountType"
                                                                    data-balance="@a.Balance"
                                                                    data-blocked="@a.BlockedAmount"
                                                                    data-available="@(Math.Max(0m, a.Balance - a.BlockedAmount))"
                                                                    data-loanbalance="@loan.Balance"
                                                                    data-totaleligible="@eligibleLiquidityNow">
                                                                <i class="mdi mdi-lock-plus-outline me-1"></i> @GlobalShared.block
                                                            </button>
                                                            @if (a.BlockedAmount > 0)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-success js-open-release ms-1"
                                                                        data-acct="@a.AccountNumber"
                                                                        data-name="@a.AccountName"
                                                                        data-type="@a.AccountType"
                                                                        data-balance="@a.Balance"
                                                                        data-blocked="@a.BlockedAmount"
                                                                        data-loanbalance="@loan.Balance"
                                                                        data-totaleligible="@eligibleLiquidityNow">
                                                                    <i class="mdi mdi-lock-open-outline me-1"></i> @GlobalShared.release
                                                                </button>
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>

                                        <!-- ===================== FOOTER TOTALS ===================== -->
                                        <tfoot class="table-light">
                                            <tr class="fw-bold">
                                                <td colspan="2">@GlobalShared.Total</td>
                                                <td class="text-end">@Money(totalActual)</td>
                                                <td class="text-end">@Money(totalBlocked)</td>
                                                <td class="text-end">@Money(totalAvailable)</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>

                                    </table>
                                </div>

                                @if (mustBlockSavings && missingSavingsBlock > 0m)
                                {
                                    <div class="alert alert-warning py-2 mt-3 mb-0">
                                        <i class="mdi mdi-alert-outline me-1"></i>
                                        <b>Blocking Required:</b>
                                        @GlobalMembersFSeries.additional_savings_to_block:
                                        <b>@Money(missingSavingsBlock)</b>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ===================== OLD VS CURRENT ===================== -->
                        <div class="col-lg-12">
                            <div class="loan-card p-3">
                                <div class="loan-card-title"><i class="mdi mdi-compare"></i> @GlobalMembersFSeries.old_vs_current_restructure_adjustments</div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-bold small">@GlobalShared.previous_values</td>
                                    </tr>
                                    <tr><td class="k">@GlobalShared.old_capital</td><td class="v">@Money(loan.LoanApplication.OldLoanCapital)</td></tr>
                                    <tr><td class="k">@GlobalShared.old_interest</td><td class="v">@Money(loan.LoanApplication.OldLoanInterest)</td></tr>
                                    <tr><td class="k">@GlobalShared.old_vat</td><td class="v">@Money(loan.LoanApplication.OldLoanVat)</td></tr>
                                    <tr><td class="k">@GlobalShared.old_penalty</td><td class="v">@Money(loan.LoanApplication.OldLoanPenalty)</td></tr>
                                    <tr><td class="k">@GlobalShared.old_balance</td><td class="v">@Money(loan.LoanApplication.RestructuredBalance)</td></tr>
                                </table>
                            </div>
                        </div>
                    </div>



                </div>


                <div class="tab-pane fade" id="t_application">
                    @{
                        var hasApp = app != null;
                        var savingCoverage = hasApp ? (app.SavingAccountCoverageRate / 100m) * app.RequestedAmount : 0m;
                        var totalRefinancing = hasApp ? (app.RequestedAmount + app.RestructuredBalance) : 0m;
                        var fees = hasApp ? (app.LoanApplicationFees ?? new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanApplicationFee>()) : new List<CBS.FrontDesk.Data.Entity.LoanConf.LoanApplicationFee>();
                    }

                    <div class="app-card">
                        <div class="app-hd">
                            <p class="app-title"><i class="mdi mdi-file-document-edit-outline"></i> @GlobalShared.loan_application</p>
                            <p class="app-hint">@GlobalMembersFSeries.complete_application_details_used_to_originate_this_loan.</p>
                        </div>

                        <div class="app-bd">
                            @if (!hasApp)
                            {
                                <div class="alert alert-light border mb-0">
                                    <i class="mdi mdi-alert-circle-outline"></i>
                                    @GlobalMembersFSeries.no_loan_application_found_for_this_loan.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped app-table mb-0">
                                        <tbody>

                                            <!-- General Information -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.General_Information</td>
                                            </tr>
                                            <tr><td>@GlobalShared.Member_code</td><td>@app.CustomerId</td></tr>
                                            <tr><td>@GlobalShared.loan_application_code</td><td>@app.Id</td></tr>
                                            <tr>
                                                <td>@GlobalShared.loan_application_type</td>
                                                <td>
                                                    @if ((app.LoanApplicationType ?? "Normal") != "Normal")
                                                    {
                                                        <span class="badge bg-warning text-dark">@app.LoanApplicationType</span>
                                                        if (!string.IsNullOrWhiteSpace(app.LoanId))
                                                        {
                                                            <br />
                                                            <a href="@Url.Action("LoanDetails","Loan", new { loanId = app.LoanId })" target="_blank">
                                                                @GlobalShared.Details &raquo; @app.LoanId
                                                            </a>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary text-white">@GlobalShared.New_Loan</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>@GlobalShared.Loan_Type</td>
                                                <td>
                                                    @if ((app.LoanType ?? "") == "Main_Loan")
                                                    {
                                                        <span class="badge bg-primary text-white">@app.LoanType</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@app.LoanType</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr><td>@GlobalShared.Loan_Category</td><td>@app.LoanCategory</td></tr>
                                            <tr><td>@GlobalShared.targeted_population</td><td>@app.LoanTarget</td></tr>

                                            <!-- Product Information -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Product_Information</td>
                                            </tr>
                                            <tr><td>@GlobalShared.Product_Code</td><td>@app.LoanProduct.ProductCode</td></tr>
                                            <tr><td>@GlobalShared.Product_Name</td><td>@app.LoanProduct.ProductName</td></tr>
                                            <tr><td>@GlobalShared.product_term</td><td>@app.LoanProduct.LoanTerm.Name</td></tr>

                                            <!-- Application Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.application_details</td>
                                            </tr>
                                            <tr><td>@GlobalShared.Application_Date</td><td>@(app.ApplicationDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>@GlobalShared.Approval_date</td><td>@(app.ApprovalDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>@GlobalShared.disbursement_date</td><td>@(app.DisbursementDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td></tr>
                                            <tr><td>@GlobalShared.loan_manager</td><td>@app.LoanManager</td></tr>

                                            <!-- Migration Status -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.migration_status</td>
                                            </tr>
                                            <tr>
                                                <td>@GlobalShared.migrated_loan</td>
                                                <td>
                                                    @if (!app.IsUpload)
                                                    {
                                                        <span class="badge bg-primary text-white">@GlobalShared.tsc_loan</span>
                                                    }
                                                    else
                                                    {
                                                <span class="badge bg-warning text-dark">@GlobalShared.migrated_loan</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Refinancing Details -->
                                            @if ((app.LoanApplicationType ?? "") == "Refinancing")
                                            {
                                                <tr class="app-sec">
                                                    <td colspan="2" class="text-center">@GlobalShared.refinancing_details</td>
                                                </tr>
                                                <tr><td>@GlobalShared.Requested_Amount</td><td>@app.RequestedAmount.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.restructured_balance</td><td>@app.RestructuredBalance.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.refinanced_amount</td><td>@totalRefinancing.ToString("#,##0.0") FCFA</td></tr>

                                                <tr class="app-subsec">
                                                    <td colspan="2" class="text-center">@GlobalShared.old_loan_information</td>
                                                </tr>
                                                <tr><td>@GlobalShared.old_loan_amount</td><td>@app.OldLoanAmount.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.old_loan_capital</td><td>@app.OldLoanCapital.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.old_loan_interest</td><td>@app.OldLoanInterest.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.old_loan_vat</td><td>@app.OldLoanVat.ToString("#,##0.0") FCFA</td></tr>
                                                <tr><td>@GlobalShared.old_loan_penalty</td><td>@app.OldLoanPenalty.ToString("#,##0.0") FCFA</td></tr>
                                            }

                                            <!-- Loan Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Loan_Details</td>
                                            </tr>
                                            <tr><td>@GlobalShared.loan_product_id</td><td>@app.LoanProductId</td></tr>
                                            <tr><td>@GlobalShared.Total_Loan_Amount</td><td><strong>@app.Amount.ToString("#,##0.0") FCFA</strong></td></tr>
                                            <tr><td>@GlobalShared.Interest_Rate</td><td>@app.InterestRate.ToString("#,##0.0")%</td></tr>
                                            <tr><td>@GlobalShared.loan_manager</td><td>@app.LoanManager</td></tr>

                                            <tr>
                                                <td>@GlobalShared.Fees</td>
                                                <td>
                                                    @if (app.LoanApplicationFees != null && app.LoanApplicationFees.Any())
                                                    {
                                                        <ul class="list-unstyled mb-1">
                                                            @foreach (var fi in app.LoanApplicationFees)
                                                            {
                                                                <li>@fi.FeeLable: @(fi.FeeAmount.ToString("#,##0.0") + " FCFA")</li>
                                                            }
                                                        </ul>
                                                        <div class="mt-1">
                                                            <strong>@GlobalShared.Total_Fee_Amount:</strong> @app.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.0") FCFA<br />
                                                            <strong>@GlobalShared.Total_Amount_Paid:</strong> @app.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.0") FCFA
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">@GlobalShared.No_Fee_Added.</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Downpayments and Coverage -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalMembersFSeries.downpayments_coverage</td>
                                            </tr>
                                            <tr><td>@GlobalMembersFSeries.total_downpayment_provided</td><td><strong>@app.DownPaymentCoverageAmountProvided.ToString("#,##0.0") FCFA</strong></td></tr>
                                            <tr><td>@GlobalShared.share_covered_amount</td><td>@app.ShareAccountCoverageAmount.ToString("#,##0.0") FCFA</td></tr>
                                            <tr><td>@GlobalMembersFSeries.saving_coverage_provided</td><td>@app.SavingAccountCoverageRate.ToString("#,##0.0")% of @app.RequestedAmount.ToString("#,##0"): [@savingCoverage.ToString("#,##0")] FCFA</td></tr>

                                            <tr>
                                                <td>@GlobalMembersFSeries.preference_share_coverage_used</td>
                                                <td>
                                                    @if (app.IsPreferenceShareAccountCoverageAmount)
                                                    {
                                                        <span class="badge bg-primary text-white">@GlobalMembersFSeries.yes_coverage_amount: @app.PreferenceShareAccountCoverageAmount.ToString("#,##0.0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalShared.No</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>@GlobalMembersFSeries.deposit_coverage_used</td>
                                                <td>
                                                    @if (app.IsDepositAccountCoverageAmount)
                                                    {
                                                        <span class="badge bg-primary text-white">@GlobalMembersFSeries.yes_coverage_amount: @app.DepositAccountCoverageAmount.ToString("#,##0.0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalShared.No</span>
                                                    }
                                                </td>
                                            </tr>

                                            <!-- Additional Details -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Additional_Details</td>
                                            </tr>
                                            <tr><td>@GlobalShared.Vat_rate</td><td>@app.VatRate.ToString("#,##0.0")%</td></tr>
                                            <tr><td>@GlobalMembersFSeries.grace_period_before_1st_installment</td><td>@app.GracePeriodBeforeFirstPayment @GlobalShared.months</td></tr>
                                            <tr><td>@GlobalMembersFSeries.grace_period_after_due_date</td><td>@app.GracePeriodAfterMaturityDate Days</td></tr>
                                            <tr><td>@GlobalShared.Approval_status</td><td>@app.ApprovalStatus</td></tr>
                                            <tr>
                                                <td>@GlobalShared.Approved</td>
                                                <td>
                                                    @if (app.IsApproved)
                                                    {<span class="badge bg-primary text-white">@GlobalShared.Approved</span> }
                                                    else
                                                    { <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>}
                                                </td>
                                            </tr>

                                            <!-- Guarantors -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Guarantors</td>
                                            </tr>
                                            @if (app.Guarantors?.Any() == true)
                                            {
                                                foreach (var g in app.Guarantors)
                                                {
                                                    <tr><td>@GlobalShared.guarantor_name</td><td>@g.GuarantorName</td></tr>
                                                    <tr><td>@GlobalShared.Relationship</td><td>@g.Relationship</td></tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">@GlobalShared.no_guarantors_provided.</td></tr>
                                            }

                                            <!-- Collateral -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Collateral</td>
                                            </tr>
                                            @if (app.Collateras?.Any() == true)
                                            {
                                                foreach (var c in app.Collateras)
                                                {
                                                    <tr><td>@GlobalShared.collateral_type / @GlobalShared.Location</td><td>@c.Location</td></tr>
                                                    <tr><td>@GlobalShared.collateral_value</td><td>@c.Amount.ToString("#,##0.0") FCFA</td></tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">@GlobalShared.no_collateral_provided.</td></tr>
                                            }

                                            <!-- Attached Documents -->
                                            <tr class="app-sec">
                                                <td colspan="2" class="text-center">@GlobalShared.Attached_Documents</td>
                                            </tr>
                                            @if (app.DocumentAttachedToLoans?.Any() == true)
                                            {
                                                foreach (var d in app.DocumentAttachedToLoans)
                                                {
                                                    <tr><td>@GlobalShared.Document</td><td>@d.FileName @d.FileExtension</td></tr>
                                                    <tr><td>@GlobalShared.uploaded</td><td>@d.Date.ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                                                    <tr>
                                                        <td>@GlobalShared.Open</td>
                                                        <td>
                                                            <a href="@d.FilePath" target="_blank" class="btn btn-sm btn-primary">
                                                                <i class="mdi mdi-open-in-new"></i> @GlobalShared.Read_Content
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted">@GlobalShared.No_Documents_Attached.</td></tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="t_contract">
                    @{
                        // Detect a contract-like document by name
                        var contractDoc = docs.FirstOrDefault(d =>
                            ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("contract", StringComparison.OrdinalIgnoreCase) >= 0
                            || ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("contrat", StringComparison.OrdinalIgnoreCase) >= 0
                            || ((d.FileName ?? "") + " " + (d.FileExtension ?? "")).IndexOf("agreement", StringComparison.OrdinalIgnoreCase) >= 0
                        );

                        var contractPath = contractDoc?.FilePath;
                        var isPdf = !string.IsNullOrWhiteSpace(contractPath) && contractPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                    }

                    <div class="row g-3">
                        <div class="col-lg-5">
                            <div class="app-card">
                                <div class="app-hd">
                                    <p class="app-title"><i class="mdi mdi-file-sign"></i> @GlobalShared.application_contract</p>
                                    <p class="app-hint">@GlobalMembersFSeries.contract_reference_document_access.</p>
                                </div>
                                <div class="app-bd">
                                    <table class="table table-bordered table-striped mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="fw-bold" style="width:42%;background:#fafafa;">@GlobalShared.contract_code</td>
                                                <td>@(loan?.LoanContractCode ?? "N/A")</td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold" style="background:#fafafa;">@GlobalShared.contract_document</td>
                                                <td>
                                                    @if (contractDoc == null || string.IsNullOrWhiteSpace(contractPath))
                                                    {
                                                        <span class="text-muted">@GlobalMembersFSeries.no_contract_document_detected_upload_a_file_named_contractcontratagreement.</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex gap-2 flex-wrap align-items-center">
                                                            <span class="badge bg-light text-dark border">
                                                                @contractDoc.FileName@contractDoc.FileExtension
                                                            </span>
                                                            <a class="btn btn-sm btn-primary" target="_blank" href="@contractPath">
                                                                <i class="mdi mdi-open-in-new"></i> @GlobalShared.Open
                                                            </a>
                                                        </div>
                                                        <div class="text-muted small mt-2">@GlobalShared.uploaded: @contractDoc.Date.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <div class="small text-muted mt-2">
                                        @GlobalShared.Tip: @GlobalMembersFSeries.pdf_previews_render_inside_the_page_other_formats_open_in_a_new_tab.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="app-card">
                                <div class="app-hd">
                                    <p class="app-title"><i class="mdi mdi-eye-outline"></i> @GlobalShared.contract_preview</p>
                                    <p class="app-hint">@GlobalMembersFSeries.preview_available_for_pdf_contracts.</p>
                                </div>
                                <div class="app-bd">
                                    @if (string.IsNullOrWhiteSpace(contractPath))
                                    {
                                        <div class="alert alert-light border mb-0">
                                            <i class="mdi mdi-information-outline"></i> @GlobalMembersFSeries.no_contract_file_to_preview.
                                        </div>
                                    }
                                    else if (isPdf)
                                    {
                                        <iframe src="@contractPath"
                                                style="width:100%;height:560px;border:1px solid #e5e7eb;border-radius:12px;"></iframe>
                                    }
                                    else
                                    {
                                        <div class="alert alert-light border mb-0">
                                            <i class="mdi mdi-alert-circle-outline"></i>
                                            @Html.Raw(@GlobalMembersFSeries.preview_is_best_for_pdf_click_open_to_view_this_document).
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===================== FINANCIALS (PRO + POLICY-AWARE) ===================== -->
                <div class="tab-pane fade" id="t_financials">


                    <div class="row g-3">

                        <!-- ===================== LEFT: FINANCIAL SNAPSHOT ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-cash-multiple"></i> @GlobalShared.financial_snapshot
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">@GlobalShared.position</span>
                                        <span class="badge @(balance > 0 ? "bg-warning text-dark" : "bg-success")">@GlobalMembersFSeries.bal: @Money(balance)</span>
                                        <span class="badge @(due > 0 ? "bg-danger" : "bg-success")">@GlobalShared.due: @Money(due)</span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">
                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalMembersFSeries.core_amounts</td></tr>
                                    <tr><td class="k">@GlobalShared.Loan_Amount (@GlobalShared.Approved)</td><td class="v">@Money(approvedAmount)</td></tr>
                                    <tr><td class="k">@GlobalShared.Requested_Amount</td><td class="v">@Money(requestedAmount)</td></tr>
                                    <tr><td class="k">@GlobalShared.Principal</td><td class="v">@Money(principal)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.position</td></tr>
                                    <tr><td class="k">@GlobalShared.Paid</td><td class="v text-success">@Money(paid)</td></tr>
                                    <tr><td class="k">@GlobalShared.Balance</td><td class="v text-danger">@Money(balance)</td></tr>
                                    <tr><td class="k">@GlobalShared.Due_Amount</td><td class="v text-warning">@Money(due)</td></tr>
                                    <tr><td class="k">@GlobalShared.total_principal_paid</td><td class="v">@Money(loan.TotalPrincipalPaid)</td></tr>
                                    <tr><td class="k">@GlobalShared.restructured_balance</td><td class="v">@Money(loan.RestructuredBalance)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">Flags#</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.mortgage</td><td class="v">@(loan.IsMortgage ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.interest_running</td><td class="v">@(app?.IsInterestRunning == true ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">@GlobalShared.stop_interest</td><td class="v">@(app?.StopInterestCalculation == true ? "YES" : "NO")</td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- ===================== RIGHT: INTEREST / VAT / CHARGES ===================== -->
                        <div class="col-lg-6">
                            <div class="loan-card p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div class="loan-card-title mb-0">
                                        <i class="mdi mdi-percent-outline"></i> @GlobalMembersFSeries.interest_vat_charges
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">@GlobalShared.rates</span>
                                        <span class="badge bg-light text-dark border">INT: @Percent(intRate)</span>
                                        <span class="badge bg-light text-dark border">@GlobalShared.VAT: @Percent(vatRate)</span>
                                    </div>
                                </div>

                                <table class="table table-sm kv-table mb-0 mt-2">

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.rates</td></tr>
                                    <tr><td class="k">@GlobalShared.Interest_Rate</td><td class="v">@Percent(intRate)</td></tr>
                                    <tr><td class="k">@GlobalShared.Vat_rate</td><td class="v">@Percent(vatRate)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.Interest</td></tr>
                                    <tr><td class="k">@GlobalShared.forecasted</td><td class="v">@Money(intForecast)</td></tr>
                                    <tr><td class="k">@GlobalShared.accrued</td><td class="v">@Money(intAccrued)</td></tr>
                                    <tr><td class="k">@GlobalShared.last_calculated</td><td class="v">@Money(intLastCalc)</td></tr>
                                    <tr><td class="k">@GlobalShared.accrued_paid</td><td class="v">@Money(intAccruedPaid)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.VAT / @GlobalShared.Tax</td></tr>
                                    <tr><td class="k">@GlobalShared.Tax</td><td class="v">@Money(tax)</td></tr>
                                    <tr><td class="k">@GlobalShared.tax_paid</td><td class="v">@Money(taxPaid)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalMembersFSeries.fees_penalties</td></tr>
                                    <tr><td class="k">@GlobalShared.Fee</td><td class="v">@Money(fee)</td></tr>
                                    <tr><td class="k">@GlobalShared.fee_paid</td><td class="v">@Money(feePaid)</td></tr>
                                    <tr><td class="k">@GlobalShared.Penalty</td><td class="v">@Money(penalty)</td></tr>
                                    <tr><td class="k">@GlobalShared.penalty_paid</td><td class="v">@Money(penaltyPaid)</td></tr>
                                    <tr><td class="k">@GlobalShared.last_penalty</td><td class="v">@Money(lastPenalty)</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.penalty_calc_date</td><td class="v">@FDateNullable(penaltyCalcDate)</td></tr>

                                    <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalMembersFSeries.upfront_interest_policy</td></tr>
                                    <tr><td class="k">@GlobalMembersFSeries.paid_upfront?</td><td class="v">@(paidUpfront ? "YES" : "NO")</td></tr>
                                    <tr><td class="k">@GlobalShared.upfront_amount</td><td class="v">@Money(upfrontAmount)</td></tr>

                                </table>
                            </div>
                        </div>



                    </div>


                </div>
            </div>

            <!-- ===================== REPAYMENTS ===================== -->
            <div class="tab-pane fade" id="t_repayment">
                <div class="row g-3">

                    @{
                        // totals for quick badges + footer
                        var totalPaid = refunds?.Sum(x => x.Principal) ?? 0m;
                        var totalPaidInterest = refunds?.Sum(x => x.Interest) ?? 0m;
                        var totalPaidVat = refunds?.Sum(x => x.Tax) ?? 0m;
                        var totalPaidPenalty = refunds?.Sum(x => x.Penalty) ?? 0m;
                        var totalPaidAll = totalPaid + totalPaidInterest + totalPaidVat + totalPaidPenalty;

                        // amort totals (optional)
                        var totalDuePrincipal = amort?.Sum(x => x.Principal) ?? 0m;
                        var totalDueInterest = amort?.Sum(x => x.Interest) ?? 0m;
                        var totalDueVat = amort?.Sum(x => x.Tax) ?? 0m;
                        var totalDueAll = amort?.Sum(x => x.TotalDue) ?? 0m;
                    }

                    <!-- Summary -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-history"></i> @GlobalShared.repayment_summary
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-light text-dark border">@GlobalShared.Refunds: @refunds.Count</span>
                                    <span class="badge bg-light text-dark border">@GlobalMembersFSeries.amort: @amort.Count</span>
                                    <span class="badge @(totalPaidAll > 0 ? "bg-success" : "bg-secondary")">
                                        @GlobalShared.Total_Paid: @Money(totalPaidAll)
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Terms -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.Terms</td></tr>
                                <tr><td class="k">@GlobalShared.cycle</td><td class="v">@Txt(loan.RepaymentCycle)</td></tr>
                                <tr><td class="k">@GlobalShared.installments</td><td class="v">@loan.NumberOfInstallments</td></tr>
                                <tr><td class="k">@GlobalShared.Duration</td><td class="v">@loan.LoanDuration</td></tr>
                                <tr><td class="k">@GlobalShared.term</td><td class="v">@Txt(loan.LoanTermName)</td></tr>

                                <!-- Last payment -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.latest</td></tr>
                                <tr><td class="k">@GlobalShared.last_payment</td><td class="v">@Money(loan.LastPayment)</td></tr>
                                <tr><td class="k">@GlobalShared.refund_count</td><td class="v">@loan.RefundCount</td></tr>
                                <tr><td class="k">@GlobalMembersFSeries.last_refund_amount</td><td class="v">@MoneyN(loan.LastRefundAmount)</td></tr>
                                <tr><td class="k">@GlobalMembersFSeries.last_refund_ref</td><td class="v">@Txt(loan.LastRefundReference)</td></tr>

                                <!-- Totals paid -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalMembersFSeries.totals_paid_refunds</td></tr>
                                <tr><td class="k">@GlobalShared.principal_paid</td><td class="v text-success">@Money(totalPaid)</td></tr>
                                <tr><td class="k">@GlobalShared.interest_paid</td><td class="v">@Money(totalPaidInterest)</td></tr>
                                <tr><td class="k">@GlobalShared.Vat_Paid</td><td class="v">@Money(totalPaidVat)</td></tr>
                                <tr><td class="k">@GlobalShared.penalty_paid</td><td class="v">@Money(totalPaidPenalty)</td></tr>
                                <tr><td class="k">@GlobalShared.Total_Paid</td><td class="v fw-bold">@Money(totalPaidAll)</td></tr>

                            </table>

                            <div class="small-note mt-2">
                                @GlobalShared.Tip: @GlobalMembersFSeries.use_the_search_boxes_to_audit_refunds_and_schedule_quickly.
                            </div>
                        </div>
                    </div>

                    <!-- Listings card -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-format-list-bulleted"></i> @GlobalShared.listings
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="pill"><span class="k">@GlobalShared.Refunds</span><span class="v">@refunds.Count</span></span>
                                    <span class="pill"><span class="k">@GlobalMembersFSeries.amort</span><span class="v">@amort.Count</span></span>
                                    <span class="pill"><span class="k">@GlobalMembersFSeries.docs</span><span class="v">@docs.Count</span></span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalMembersFSeries.schedule_totals_amort</td></tr>
                                <tr><td class="k">@GlobalShared.total_due</td><td class="v fw-bold">@Money(totalDueAll)</td></tr>
                                <tr><td class="k">@GlobalShared.principal_due</td><td class="v">@Money(totalDuePrincipal)</td></tr>
                                <tr><td class="k">@GlobalShared.interest_due</td><td class="v">@Money(totalDueInterest)</td></tr>
                                <tr><td class="k">@GlobalShared.vat_due</td><td class="v">@Money(totalDueVat)</td></tr>
                            </table>

                            <div class="small-note mt-2">@GlobalMembersFSeries.lists_below_are_scrollable_and_searchable.</div>
                        </div>
                    </div>

                    <!-- Refunds -->
                    <div class="col-lg-12">
                        <div class="loan-card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-cash-check"></i> @GlobalMembersFSeries.repayment_history_refunds
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    <input class="form-control form-control-sm" style="max-width:260px"
                                           placeholder="Search refunds..." onkeyup="filterTable(this,'refundTable')" />
                                </div>
                            </div>

                            <div class="list-scroll">
                                <table class="table table-sm table-striped table-hover table-tight mb-0" id="refundTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width:160px;">@GlobalShared.Date</th>
                                            <th class="text-end" style="min-width:120px;">@GlobalShared.Principal</th>
                                            <th class="text-end" style="min-width:110px;">@GlobalShared.Interest</th>
                                            <th class="text-end" style="min-width:90px;">@GlobalShared.VAT</th>
                                            <th class="text-end" style="min-width:100px;">@GlobalShared.Penalty</th>

                                            <!-- NEW -->
                                            <th class="text-end" style="min-width:140px;">@GlobalShared.Total_Paid</th>

                                            <!-- Details -->
                                            <th style="min-width:140px;">@GlobalShared.channel</th>
                                            <th style="min-width:220px;">@GlobalShared.Details</th>
                                            <th style="min-width:180px;">@GlobalShared.Reference</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (refunds.Any())
                                        {
                                            foreach (var r in refunds)
                                            {
                                                var rowTotal = (r.Principal + r.Interest + r.Tax + r.Penalty);

                                                <tr>
                                                    <td>
                                                        @if (r.DateOfPayment == DateTime.MinValue)
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold">@r.DateOfPayment.ToString("dd/MM/yyyy")</span>
                                                            <div class="small-note text-muted">@r.DateOfPayment.ToString("HH:mm:ss")</div>
                                                        }
                                                    </td>

                                                    <td class="text-end">@r.Principal.ToString("N0")</td>
                                                    <td class="text-end">@r.Interest.ToString("N0")</td>
                                                    <td class="text-end">@r.Tax.ToString("N0")</td>
                                                    <td class="text-end">@r.Penalty.ToString("N0")</td>

                                                    <!-- NEW total -->
                                                    <td class="text-end fw-bold">@rowTotal.ToString("N0")</td>

                                                    <td>@r.PaymentChannel</td>

                                                    <!-- NEW details (audit friendly) -->
                                                    <td>
                                                        <div class="small-note">
                                                            <span class="text-muted">@GlobalShared.method:</span> <b>@Txt(r.PaymentMethod)</b>
                                                            @* Add more fields here if your Refund model has them *@
                                                            @* • Teller: @Txt(r.TellerName) • TxRef: @Txt(r.TransactionReference) *@
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <span class="text-muted">@Txt(r.PaymentMethod)</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="9" class="text-center text-muted p-3">@GlobalMembersFSeries.no_refunds_found_for_this_loan.</td></tr>
                                        }
                                    </tbody>

                                    @if (refunds.Any())
                                    {
                                        <tfoot class="table-light">
                                            <tr>
                                                <td class="fw-bold">@GlobalShared.Totals</td>
                                                <td class="text-end fw-bold">@totalPaid.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidInterest.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidVat.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidPenalty.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalPaidAll.ToString("N0")</td>
                                                <td colspan="3"></td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Amortization -->
                    <div class="col-lg-12">
                        <div class="loan-card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-calendar-month-outline"></i> @GlobalMembersFSeries.amortization_schedule
                                </div>
                                <input class="form-control form-control-sm" style="max-width:260px"
                                       placeholder="Search amortization..." onkeyup="filterTable(this,'amortTable')" />
                            </div>

                            <div class="list-scroll">
                                <table class="table table-sm table-striped table-hover table-tight mb-0" id="amortTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width:60px;">#</th>
                                            <th style="min-width:140px;">Due Date</th>
                                            <th class="text-end" style="min-width:120px;">@GlobalShared.Principal</th>
                                            <th class="text-end" style="min-width:110px;">@GlobalShared.Interest</th>
                                            <th class="text-end" style="min-width:90px;">@GlobalShared.VAT</th>
                                            <th class="text-end" style="min-width:120px;">@GlobalShared.Total</th>
                                            <th style="min-width:120px;">Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (amort.Any())
                                        {
                                            var i = 1;
                                            foreach (var a in amort)
                                            {
                                                <tr>
                                                    <td>@i</td>
                                                    <td>@(a.DateOfPayment == DateTime.MinValue ? "-" : a.DateOfPayment.ToString("dd/MM/yyyy"))</td>
                                                    <td class="text-end">@a.Principal.ToString("N0")</td>
                                                    <td class="text-end">@a.Interest.ToString("N0")</td>
                                                    <td class="text-end">@a.Tax.ToString("N0")</td>
                                                    <td class="text-end fw-bold">@a.TotalDue.ToString("N0")</td>
                                                    <td>@a.Status</td>
                                                </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="7" class="text-center text-muted p-3">@GlobalMembersFSeries.no_amortization_schedule_found.</td></tr>
                                        }
                                    </tbody>

                                    @if (amort.Any())
                                    {
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="2" class="fw-bold">@GlobalShared.Totals</td>
                                                <td class="text-end fw-bold">@totalDuePrincipal.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueInterest.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueVat.ToString("N0")</td>
                                                <td class="text-end fw-bold">@totalDueAll.ToString("N0")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>

                            <div class="small-note mt-2">
                                @GlobalShared.Note: @Html.Raw(@GlobalMembersFSeries.if_empty_ensure_loanamortizations_is_loaded_serverside).
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===================== RISK ===================== -->
            <div class="tab-pane fade" id="t_risk">
                <div class="row g-3">

                    @{
                        var isDelinquent = loan.IsDeliquentLoan;
                        var delinquentDays = loan.DeliquentDays;

                        // severity (simple + clear)
                        var sevClass =
                            delinquentDays >= 90 ? "sev-critical" :
                            delinquentDays >= 30 ? "sev-high" :
                            delinquentDays >= 1 ? "sev-med" : "sev-ok";

                        var sevText =
                            delinquentDays >= 90 ? "CRITICAL" :
                            delinquentDays >= 30 ? "HIGH" :
                            delinquentDays >= 1 ? "MED" : "OK";
                    }

                    <!-- ===================== DELINQUENCY ===================== -->
                    <div class="col-lg-6">
                        <div class="loan-card p-3">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="loan-card-title mb-0">
                                    <i class="mdi mdi-alert-decagram-outline"></i> @GlobalShared.Delinquency
                                </div>

                                <!-- quick badges -->
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge badge-sev @sevClass">
                                        <span class="dot"></span> @sevText
                                    </span>

                                    <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                        @(isDelinquent ? "DELINQUENT" : "OK")
                                    </span>

                                    <span class="badge @(delinquentDays > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        @GlobalShared.Days: @delinquentDays.ToString("N0")
                                    </span>

                                    <span class="badge bg-light text-dark border">
                                        @GlobalMembersFSeries.par: @Txt(loan.PAR)
                                    </span>
                                </div>
                            </div>

                            <table class="table table-sm kv-table mb-0 mt-2">

                                <!-- Status -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.Status</td></tr>
                                <tr>
                                    <td class="k">@GlobalMembersFSeries.is_delinquent</td>
                                    <td class="v">
                                        <span class="badge @(isDelinquent ? "bg-danger" : "bg-success")">
                                            @(isDelinquent ? "YES" : "NO")
                                        </span>
                                        @if (isDelinquent && delinquentDays > 0)
                                        {
                                            <span class="text-muted ms-2">• @GlobalShared.severity: <b class="sev-text @sevClass">@sevText</b></span>
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <td class="k">@GlobalShared.Delinquent_Days</td>
                                    <td class="v">
                                        <b class="sev-text @sevClass">@delinquentDays.ToString("N0")</b>
                                        @if (delinquentDays == 0)
                                        {
                                            <span class="text-muted ms-2">• On-time</span>
                                        }
                                    </td>
                                </tr>

                                <tr><td class="k">@GlobalShared.delinquent_status</td><td class="v">@Txt(loan.DeliquentStatus)</td></tr>

                                <!-- Amounts -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.amounts</td></tr>
                                <tr>
                                    <td class="k">@GlobalMembersFSeries.delinquent_amount</td>
                                    <td class="v">
                                        <span class="fw-bold @(loan.DeliquentAmount > 0 ? "text-danger" : "text-muted")">
                                            @Money(loan.DeliquentAmount)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="k">@GlobalMembersFSeries.delinquent_interest</td>
                                    <td class="v">@Money(loan.DeliquentInterest)</td>
                                </tr>

                                <!-- Configuration -->
                                <tr class="table-light"><td colspan="2" class="fw-bold small">@GlobalShared.Configuration</td></tr>
                                <tr><td class="k">@GlobalMembersFSeries.par_bucket</td><td class="v">@Txt(loan.PAR)</td></tr>
                                <tr><td class="k">@GlobalShared.config_name</td><td class="v">@Txt(loan.LoanDeliquencyConfigurationName)</td></tr>
                                <tr><td class="k">@GlobalShared.last_processed</td><td class="v">@FDateNullable(loan.LastDeliquecyProcessedDate)</td></tr>

                            </table>

                            @if (isDelinquent && delinquentDays >= 30)
                            {
                                <div class="alert alert-warning py-2 mt-2 mb-0">
                                    <i class="mdi mdi-alert-outline me-1"></i>
                                    <b>@GlobalShared.attention:</b> @GlobalMembersFSeries.this_loan_is_past_due_review_collection_actions_and_cobac_classification.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ===================== PENALTY ===================== -->
