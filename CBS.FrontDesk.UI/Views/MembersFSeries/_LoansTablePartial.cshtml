@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk

@if (Model == null || !Model.Loans.Any())
{
    <div class="alert alert-info text-center">No loans found for this member.</div>
}
else
{
    var totalPaid = Model.Loans.Sum(x => x.Paid);
    var totalBalanceLoan = Model.Loans.Sum(x => x.Balance);
<div class="table-responsive">
    <table class="table table-striped table-hover" id="myDataTableT">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>L.Repayment</th>
                <th>L.Amount</th>
                <th>I.Rate</th>
                <th>A.INT</th>
                <th>Paid</th>
                <th>Balance</th>
                <th>D.Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                string badgeClass = "badge bg-secondary"; // Default

                if (loan.LoanStatus == "Pending")
                {
                    badgeClass = "badge bg-warning text-dark";
                }
                else if (loan.LoanStatus == "Open" || loan.LoanStatus == "Disbursed")
                {
                    badgeClass = "badge bg-primary";
                }
                else if (loan.LoanStatus == "Rejected")
                {
                    badgeClass = "badge bg-danger";
                }
                else if (loan.LoanStatus == "Refinanced")
                {
                    badgeClass = "badge bg-info text-dark";
                }
                else if (loan.LoanStatus == "Rescheduled")
                {
                    badgeClass = "badge bg-dark";
                }
                else if (loan.LoanStatus == "Restructured")
                {
                    badgeClass = "badge bg-secondary text-white";
                }

                <tr>
                    <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">
                        @(loan.LastRefundDate != DateTime.MinValue ? loan.LastRefundDate.ToString("dd/MM/yyyy") : "-")
                    </td>
                    <td class="text-end">@loan.LoanAmount.ToString("N0")</td>
                    <td class="text-end">@loan.InterestRate.ToString("0.0")%</td>
                    <td class="text-end">@loan.AccrualInterest.ToString("N0")</td>
                    <td class="text-end">@loan.Paid.ToString("N0")</td>
                    <td class="text-end text-danger">@loan.Balance.ToString("N0")</td>
                    <td class="text-end text-warning">@loan.DueAmount.ToString("N0")</td>
                    <td class="text-start">
                        <span class="@badgeClass">@loan.LoanStatus</span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                onclick="loadLoanDetails('@loan.Id')">
                            <i class="mdi mdi-eye-outline me-1"></i> Details
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td class="text-end">Totals:</td>
                <td></td> <!-- Last Repayment -->
                <td class="text-end">@Model.Loans.Sum(x => x.LoanAmount).ToString("N0")</td>
                <td></td> <!-- I.Rate -->
                <td class="text-end">@Model.Loans.Sum(x => x.AccrualInterest).ToString("N0")</td>
                <td class="text-end text-primary">@Model.Loans.Sum(x => x.Paid).ToString("N0")</td>
                <td class="text-end text-danger">@Model.Loans.Sum(x => x.Balance).ToString("N0")</td>
                <td class="text-end text-warning">@Model.Loans.Sum(x => x.DueAmount).ToString("N0")</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-3 p-3 border rounded bg-light">
        <h6 class="fw-bold text-primary mb-2">
            <i class="mdi mdi-information-outline me-1"></i> Column Definitions
        </h6>
        <ul class="small mb-0">
            <li><strong>Date</strong>: The date the loan was disbursed or recorded.</li>
            <li><strong>L.Repayment</strong>: The date of the last loan repayment made by the member.</li>
            <li><strong>L.Amount</strong>: Total loan amount disbursed to the member.</li>
            <li><strong>I.Rate</strong>: Interest rate applied on the loan (annualized).</li>
            <li><strong>A.INT</strong> (Accrued Interest): Interest accumulated over time but not yet paid.</li>
            <li><strong>Paid</strong>: Total amount paid back by the member (principal + interest).</li>
            <li><strong>Balance</strong>: Remaining loan balance yet to be paid.</li>
            <li><strong>D.Amount</strong> (Due Amount): The total amount currently expected per installment. It equals the remaining <strong>Balance</strong> plus <strong>Accrued Interest</strong>, <strong>VAT</strong>, and any applicable <strong>Penalty</strong> charges.</li>
            <li><strong>Status</strong>: Current status of the loan (e.g. Open, Pending, Restructured, etc.).</li>
            <li><strong>Action</strong>: Button to view loan details or take further actions.</li>
        </ul>


    </div>

</div>

    <!-- ✅ Totals Summary Section -->
    @*<div class="card mt-3 shadow-sm">
            <div class="card-header bg-light text-dark fw-bold">Account & Loan Totals</div>
            <div class="card-body p-3">
                <div class="row mb-2">
                    <div class="col-md-4 fw-bold">Total Loans Paid:</div>
                    <div class="col-md-8 text-end text-success">@totalPaid.ToString("N0") FCFA</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4 fw-bold">Total Outstanding Loan Balance:</div>
                    <div class="col-md-8 text-end text-danger">@totalBalanceLoan.ToString("N0") FCFA</div>
                </div>
                <div class="row mb-2 border-top pt-2">
                    <div class="col-md-4 fw-bold">Account Balance:</div>
                    <div class="col-md-8 text-end">@totalBalance.ToString("N0") FCFA</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4 fw-bold">Blocked Amount:</div>
                    <div class="col-md-8 text-end text-warning">@totalBlocked.ToString("N0") FCFA</div>
                </div>
                <div class="row border-top pt-2">
                    <div class="col-md-4 fw-bold">Available Actual Balance:</div>
                    <div class="col-md-8 text-end text-primary fw-bold">@totalActual.ToString("N0") FCFA</div>
                </div>
            </div>
        </div>*@
}
