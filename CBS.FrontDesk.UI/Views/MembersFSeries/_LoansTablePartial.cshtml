@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
<style>
     .loan-table-wrapper {
         width: 100%;
         overflow-x: hidden !important; /* ✅ remove extra bottom bar */
         overflow-y: hidden;
         border: 1px solid #e6e6e6;
         border-radius: 8px;
         background: #fff;
     }


     /* Make sure the table is wider than viewport so scrolling is meaningful */
     .loan-table {
         min-width: 1900px; /* increased because of advanced payment columns */
         white-space: nowrap; /* prevent wrapping */
     }

         /* OPTIONAL: sticky first 2 columns */
         .loan-table .sticky-col {
             position: sticky;
             left: 0;
             z-index: 2;
             background: inherit;
             box-shadow: 2px 0 0 rgba(0,0,0,.04);
         }

         .loan-table .sticky-col-2 {
             position: sticky;
             left: 160px; /* must match Date column width */
             z-index: 2;
             background: inherit;
             box-shadow: 2px 0 0 rgba(0,0,0,.04);
         }

         /* control first column width so left offsets stay correct */
         .loan-table .col-date {
             min-width: 160px;
         }
     /* ===================== STATUS PILLS ===================== */
     .status-pill {
         display: inline-flex;
         align-items: center;
         width: fit-content;
         padding: .30rem .60rem;
         border-radius: 999px;
         font-weight: 800;
         font-size: .78rem;
         letter-spacing: .35px;
         text-transform: uppercase;
         line-height: 1;
         white-space: nowrap;
     }

     .status-open {
         background: rgba(13,110,253,.12);
         color: #0d6efd;
         border: 1px solid rgba(13,110,253,.25);
     }

     .status-disbursed {
         background: rgba(25,135,84,.12);
         color: #198754;
         border: 1px solid rgba(25,135,84,.25);
     }

     .status-closed {
         background: rgba(108,117,125,.12);
         color: #6c757d;
         border: 1px solid rgba(108,117,125,.25);
     }

     .status-rejected {
         background: rgba(220,53,69,.12);
         color: #dc3545;
         border: 1px solid rgba(220,53,69,.25);
     }

     .status-pending {
         background: rgba(255,193,7,.20);
         color: #856404;
         border: 1px solid rgba(255,193,7,.35);
     }

     .status-refinanced {
         background: rgba(13,202,240,.15);
         color: #0aa2c0;
         border: 1px solid rgba(13,202,240,.30);
     }

     .status-rescheduled {
         background: rgba(33,37,41,.08);
         color: #212529;
         border: 1px solid rgba(33,37,41,.18);
     }

     .status-restructured {
         background: rgba(111,66,193,.12);
         color: #6f42c1;
         border: 1px solid rgba(111,66,193,.25);
     }

     .num-strong {
         font-weight: 800;
     }
     /* Fixed widths for stable sticky offsets */
     .loan-table .col-date {
         width: var(--w-date);
         min-width: var(--w-date);
         max-width: var(--w-date);
     }

     /* L.Type dynamic but bounded */
     .loan-table .col-type {
         width: auto !important;
         min-width: 180px;
         max-width: 520px;
         overflow: hidden;
         text-overflow: ellipsis;
     }

     /* Status content-sized */
     .loan-table .col-status {
         width: 1%;
         white-space: nowrap;
         text-align: center;
         padding-left: .35rem !important;
         padding-right: .35rem !important;
     }

     .loan-table .col-action {
         width: var(--w-action);
         min-width: var(--w-action);
         max-width: var(--w-action);
         text-align: center;
         padding-right: .25rem !important;
         padding-left: .25rem !important;
     }
     /* =====================================================================================
    DataTables FixedColumns: force SOLID WHITE background (no transparency)
    Applies to the fixed-left and fixed-right cloned tables.
    ===================================================================================== */

     /* Whole fixed tables */
     table.dtfc-fixed-left,
     table.dtfc-fixed-right {
         background: #fff !important;
     }

         /* Cells (body) */
         table.dtfc-fixed-left th,
         table.dtfc-fixed-left td,
         table.dtfc-fixed-right th,
         table.dtfc-fixed-right td {
             background: #fff !important; /* ✅ solid white */
             background-clip: padding-box;
         }

     /* Header area inside fixed tables */
     div.dtfc-left-top-blocker,
     div.dtfc-right-top-blocker,
     div.dtfc-left-top-blocker th,
     div.dtfc-right-top-blocker th {
         background: #f8f9fa !important; /* match table-light */
     }

     /* Footer area inside fixed tables */
     div.dtfc-left-bottom-blocker,
     div.dtfc-right-bottom-blocker,
     div.dtfc-left-bottom-blocker td,
     div.dtfc-right-bottom-blocker td {
         background: #f8f9fa !important;
     }

     /* Optional: keep row striping consistent in fixed columns */
     table.dtfc-fixed-left tbody tr:nth-child(odd) td,
     table.dtfc-fixed-right tbody tr:nth-child(odd) td {
         background: #f8f9fa !important;
     }

     /* Optional: a clean separator line between fixed and scrollable area */
     table.dtfc-fixed-left {
         box-shadow: 2px 0 0 rgba(0,0,0,.06);
     }

     table.dtfc-fixed-right {
         box-shadow: -2px 0 0 rgba(0,0,0,.06);
     }
     /* =========================================================
    FIXEDCOLUMNS: REMOVE TRANSPARENCY (force solid backgrounds)
    Put this at the VERY END of CSS
    ========================================================= */

     /* The fixed-column containers themselves */
     .dtfc-fixed-left,
     .dtfc-fixed-right,
     .dtfc-fixed-left .dtfc-fixed-left,
     .dtfc-fixed-right .dtfc-fixed-right,
     .dtfc-fixed-left table,
     .dtfc-fixed-right table {
         background: #fff !important;
     }

         /* Force every cell to have a background (header/body/footer) */
         .dtfc-fixed-left th, .dtfc-fixed-left td,
         .dtfc-fixed-right th, .dtfc-fixed-right td {
             background: #fff !important;
             background-clip: padding-box !important;
         }

         /* Header should look like Bootstrap table-light */
         .dtfc-fixed-left thead th,
         .dtfc-fixed-right thead th {
             background: #f8f9fa !important;
         }

         /* Footer should look like Bootstrap table-light */
         .dtfc-fixed-left tfoot td,
         .dtfc-fixed-right tfoot td {
             background: #f8f9fa !important;
         }

         /* Match Bootstrap striped rows inside fixed columns */
         .dtfc-fixed-left tbody tr:nth-child(odd) td,
         .dtfc-fixed-right tbody tr:nth-child(odd) td {
             background: #f2f2f2 !important; /* close to Bootstrap stripe */
         }

         /* Match Bootstrap hover inside fixed columns */
         .dtfc-fixed-left tbody tr:hover td,
         .dtfc-fixed-right tbody tr:hover td {
             background: #e9ecef !important;
         }

     /* Optional: clean separators between fixed and scrollable area */
     .dtfc-fixed-left {
         box-shadow: 2px 0 0 rgba(0,0,0,.08) !important;
     }

     .dtfc-fixed-right {
         box-shadow: -2px 0 0 rgba(0,0,0,.08) !important;
     }
</style>


@if (Model == null || Model.Loans == null || !Model.Loans.Any())
{
    <div class="alert alert-info text-center">No loans found for this member.</div>
}
else
{
    var totalLoanAmount = Model.Loans.Sum(x => x.LoanAmount);
    var totalAccruedInt = Model.Loans.Sum(x => x.AccrualInterest);
    var totalPaid = Model.Loans.Sum(x => x.Paid);
    var totalBalance = Model.Loans.Sum(x => x.Balance);
    var totalDue = Model.Loans.Sum(x => x.DueAmount);

    var totalDelinqAmt = Model.Loans.Sum(x => x.DeliquentAmount);
    var totalDelinqInt = Model.Loans.Sum(x => x.DeliquentInterest);
    var totalPenalty = Model.Loans.Sum(x => x.Penalty);

    var totalAdvDays = Model.Loans.Sum(x => x.AdvancedPaymentDays);
    var totalAdvAmt = Model.Loans.Sum(x => x.AdvancedPaymentAmount);

    <div class="loan-table-wrapper">
        <div class="loan-table-container">
            <table class="table table-striped table-hover align-middle loan-table" id="LoansByMemberTable">
                <thead class="table-light">
                    <tr>
                        <th class="sticky-col col-date">Date</th>
                        <th class="sticky-col-2 col-type">L.Type</th>

                        <th class="text-end">L.Repayment</th>
                        <th class="text-end">L.Amount</th>
                        <th class="text-end">I.Rate</th>
                        <th class="text-end">A.INT</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Balance</th>
                        <th class="text-end">D.Amount</th>

                        <th class="text-center">Delinq?</th>
                        <th class="text-end">Delinq Days</th>
                        <th class="text-end">Delinq Amt</th>
                        <th class="text-end">Delinq Int</th>
                        <th class="text-start">Delinq Status</th>
                        <th class="text-start">PAR</th>
                        <th class="text-end">Penalty</th>
                        <th class="text-end">Penalty Paid</th>
                        <th class="text-end">Last Delinq Proc</th>

                        <th class="text-center">Advance?</th>
                        <th class="text-end">Adv Days</th>
                        <th class="text-end">Adv Amount</th>

                        <th class="text-center">Stop Int?</th>
                        <th class="text-start">Stopped By</th>
                        <th class="text-end">Stop Date</th>

                        <th class="text-center sticky-right-2 col-status">Status</th>
                        <th class="text-center sticky-right col-action">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        var status = (loan.LoanStatus ?? "").Trim();
                        var statusLower = status.ToLowerInvariant();

                        var statusPillClass = "status-closed";
                        switch (statusLower)
                        {
                            case "pending": statusPillClass = "status-pending"; break;
                            case "open": statusPillClass = "status-open"; break;
                            case "disbursed": statusPillClass = "status-disbursed"; break;
                            case "rejected": statusPillClass = "status-rejected"; break;
                            case "refinanced": statusPillClass = "status-refinanced"; break;
                            case "rescheduled": statusPillClass = "status-rescheduled"; break;
                            case "restructured": statusPillClass = "status-restructured"; break;
                            default: statusPillClass = "status-closed"; break;
                        }

                        var isDelinq = loan.IsDeliquentLoan || loan.DeliquentDays > 0 || loan.DeliquentAmount > 0;
                        var delinqBadge = isDelinq ? "badge bg-danger" : "badge bg-success";
                        var rowClass = isDelinq ? "table-danger" : "";

                        var hasAdvance = loan.AdvancedPaymentDays > 0 || loan.AdvancedPaymentAmount > 0;
                        var advBadge = hasAdvance ? "badge bg-info text-dark" : "badge bg-light text-dark border";

                        var stopIntBadge = loan.StopInterestCalculation ? "badge bg-dark" : "badge bg-light text-dark border";

                        <tr class="@rowClass">
                            <td class="sticky-col col-date">@loan.LoanDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="sticky-col-2 col-type" title="@loan.LoanType">@loan.LoanType</td>

                            <td class="text-end">
                                @(loan.LastRefundDate != DateTime.MinValue ? loan.LastRefundDate.ToString("dd/MM/yyyy HH:mm:ss") : "-")
                            </td>

                            <td class="text-end">@loan.LoanAmount.ToString("N0")</td>
                            <td class="text-end">@loan.InterestRate.ToString("0.0")%</td>
                            <td class="text-end">@loan.AccrualInterest.ToString("N0")</td>
                            <td class="text-end">@loan.Paid.ToString("N0")</td>
                            <td class="text-end text-danger num-strong">@loan.Balance.ToString("N0")</td>
                            <td class="text-end text-warning num-strong">@loan.DueAmount.ToString("N0")</td>

                            <td class="text-center"><span class="@delinqBadge">@(isDelinq ? "YES" : "NO")</span></td>
                            <td class="text-end">@loan.DeliquentDays.ToString("N0")</td>
                            <td class="text-end">@loan.DeliquentAmount.ToString("N0")</td>
                            <td class="text-end">@loan.DeliquentInterest.ToString("N0")</td>
                            <td class="text-start">@(string.IsNullOrWhiteSpace(loan.DeliquentStatus) ? "-" : loan.DeliquentStatus)</td>
                            <td class="text-start">@(string.IsNullOrWhiteSpace(loan.PAR) ? "-" : loan.PAR)</td>
                            <td class="text-end">@loan.Penalty.ToString("N0")</td>
                            <td class="text-end">@loan.PenaltyPaid.ToString("N0")</td>
                            <td class="text-end">
                                @(loan.LastDeliquecyProcessedDate.HasValue ? loan.LastDeliquecyProcessedDate.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")
                            </td>

                            <td class="text-center"><span class="@advBadge">@(hasAdvance ? "YES" : "NO")</span></td>
                            <td class="text-end">@loan.AdvancedPaymentDays.ToString("N0")</td>
                            <td class="text-end">@loan.AdvancedPaymentAmount.ToString("N0")</td>

                            <td class="text-center"><span class="@stopIntBadge">@(loan.StopInterestCalculation ? "YES" : "NO")</span></td>
                            <td class="text-start">@((string.IsNullOrWhiteSpace(loan.StoppedBy)) ? "-" : loan.StoppedBy)</td>
                            <td class="text-end">
                                @(loan.DateInterestWastStoped != DateTime.MinValue ? loan.DateInterestWastStoped.ToString("dd/MM/yyyy HH:mm:ss") : "-")
                            </td>

                            <td class="text-center sticky-right-2 col-status">
                                <span class="status-pill @statusPillClass">@status</span>
                            </td>
                            <td class="text-center sticky-right col-action">
                                <a class="btn btn-sm btn-outline-primary px-2"
                                   target="_blank"
                                   href="@Url.Action("LoanDetails", "MembersFSeries", new { loanId = loan.Id })">
                                    <i class="mdi mdi-eye-outline"></i>
                                </a>
                            </td>

                            @*<td class="text-center sticky-right col-action">
            <button type="button"
                    class="btn btn-sm btn-outline-primary px-2"
                    title="Details"
                    onclick="loadLoanDetails('@loan.Id')">
                <i class="mdi mdi-eye-outline"></i>
            </button>
        </td>*@
                        </tr>
                    }
                </tbody>

                <tfoot class="table-light fw-bold">
                    <tr>
                        <td class="text-end sticky-col col-date">Totals:</td>
                        <td class="sticky-col-2 col-type"></td>
                        <td></td>

                        <td class="text-end">@totalLoanAmount.ToString("N0")</td>
                        <td></td>
                        <td class="text-end">@totalAccruedInt.ToString("N0")</td>
                        <td class="text-end text-primary">@totalPaid.ToString("N0")</td>
                        <td class="text-end text-danger">@totalBalance.ToString("N0")</td>
                        <td class="text-end text-warning">@totalDue.ToString("N0")</td>

                        <td></td>
                        <td></td>
                        <td class="text-end">@totalDelinqAmt.ToString("N0")</td>
                        <td class="text-end">@totalDelinqInt.ToString("N0")</td>
                        <td></td>
                        <td></td>
                        <td class="text-end">@totalPenalty.ToString("N0")</td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td class="text-end">@totalAdvDays.ToString("N0")</td>
                        <td class="text-end">@totalAdvAmt.ToString("N0")</td>

                        <td></td>
                        <td></td>
                        <td></td>

                        <td class="sticky-right-2 col-status"></td>
                        <td class="sticky-right col-action"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="mt-3 p-3 border rounded bg-light">
        <h6 class="fw-bold text-primary mb-2">
            <i class="mdi mdi-information-outline me-1"></i> Column Definitions (Full)
        </h6>

        <ul class="small mb-0">
            <li><strong>Date</strong>: Loan creation / contract date & time.</li>
            <li><strong>L.Type</strong>: Loan product / loan category name (e.g., Main_Loan, Exceptional_Loan).</li>

            <li><strong>L.Repayment</strong>: Last repayment date/time (LastRefundDate). Shows “-” if no repayment yet.</li>
            <li><strong>L.Amount</strong>: Original loan principal amount disbursed/contracted.</li>
            <li><strong>I.Rate</strong>: Loan interest rate (%) configured for the loan.</li>
            <li><strong>A.INT</strong>: Accrued interest accumulated on the loan (interest generated to date).</li>
            <li><strong>Paid</strong>: Total amount already paid by the member on this loan.</li>
            <li><strong>Balance</strong>: Remaining outstanding principal/total balance to be settled.</li>
            <li><strong>D.Amount</strong>: Due amount currently expected/required (amount due as of now).</li>

            <li><strong>Delinq?</strong>: <em>YES</em> if the loan is delinquent (days &gt; 0 or delinquent amount detected), otherwise <em>NO</em>.</li>
            <li><strong>Delinq Days</strong>: Number of delinquent days (how long the loan has been overdue).</li>
            <li><strong>Delinq Amt</strong>: Total overdue/delinquent amount.</li>
            <li><strong>Delinq Int</strong>: Delinquent interest accumulated (interest related to delinquency/overdue state).</li>
            <li><strong>Delinq Status</strong>: Delinquency classification/status (e.g., Normal / PAR states / configuration name).</li>
            <li><strong>PAR</strong>: Portfolio-at-Risk bucket (from delinquency configuration / PAR category).</li>

            <li><strong>Penalty</strong>: Total penalties calculated on this loan.</li>
            <li><strong>Penalty Paid</strong>: Total penalties already paid.</li>
            <li><strong>Last Delinq Proc</strong>: Last date/time the delinquency engine processed this loan.</li>

            <li><strong>Advance?</strong>: <em>YES</em> if member has paid in advance for future periods, otherwise <em>NO</em>.</li>
            <li><strong>Adv Days</strong>: Number of days covered by advance payments.</li>
            <li><strong>Adv Amount</strong>: Amount paid in advance.</li>

            <li><strong>Stop Int?</strong>: <em>YES</em> if interest calculation is stopped for this loan, otherwise <em>NO</em>.</li>
            <li><strong>Stopped By</strong>: Reason/user/source that stopped interest calculation (or “-” if not applicable).</li>
            <li><strong>Stop Date</strong>: Date/time interest calculation was stopped (or “-” if not applicable).</li>

            <li><strong>Status</strong>: Current loan lifecycle status (Open, Disbursed, Closed, Pending, Rejected, Rescheduled, Restructured, Refinanced, etc.).</li>
            <li><strong>Action</strong>: Opens loan details view (eye button) for full drill-down (schedule, history, documents, etc.).</li>
        </ul>
    </div>

}


<script>
    $(function () {
        const id = "#LoansByMemberTable";

        if ($.fn.DataTable.isDataTable(id)) {
            $(id).DataTable().destroy();
        }

        $(id).DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: true,

            scrollX: true,          // ✅ horizontal scroll
            scrollCollapse: true,
            responsive: false,      // important when using scrollX
            fixedHeader: true,
            fixedColumns: { leftColumns: 2, rightColumns: 2 },
            initComplete: function () {
                const api = this.api();
                setTimeout(function () { api.columns.adjust().draw(false); }, 0);
            }

        });
    });
</script>