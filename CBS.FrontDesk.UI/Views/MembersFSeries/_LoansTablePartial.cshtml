@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    decimal totalBalance = Model.Accounts.Sum(x => x.balance);
    decimal totalBlocked = Model.Accounts.Sum(x => x.blockedAmount);
    decimal totalActual = totalBalance - totalBlocked;
}


@if (Model == null || !Model.Loans.Any())
{
    <div class="alert alert-info text-center">No loans found for this member.</div>
}
else
{
    var totalPaid = Model.Loans.Sum(x => x.Paid);
    var totalBalanceLoan = Model.Loans.Sum(x => x.Balance);
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Loan Amt</th>
                    <th>Int. Rate</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model.Loans)
                {
                    <tr>
                        <td>@loan.LoanDate</td>
                        <td>@loan.LoanAmount.ToString("N0")</td>
                        <td>@(loan.InterestRate)%</td>
                        <td>@loan.Paid.ToString("N0")</td>
                        <td class="text-danger">@loan.Balance.ToString("N0")</td>
                        <td>@loan.LoanStatus</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="loadLoanDetails('@loan.Id')">
                                <i class="mdi mdi-eye-outline me-1"></i> Details
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Total:</td>
                    <td class="text-black fw-bold">@totalPaid.ToString("N0")</td>
                    <td class="text-danger fw-bold">@totalBalance.ToString("N0")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}




