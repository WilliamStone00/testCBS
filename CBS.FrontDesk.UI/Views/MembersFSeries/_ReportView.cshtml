@using CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation
@model ReportParameters
@using Resources
@using System.Web.Mvc

<div class="container-fluid">

    <hr />
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-chart-bar me-2"></i> @GlobalMembersFSeries.individual_members_operation_report_generator
                    </h1>
                    <p class="card-text">
                        @GlobalMembersFSeries.generate_detailed_financial_reports_for_members_accounts_and_loans_select_your_report_type_customize_parameters_and_generate_professional_reports_instantly.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalMembersFSeries.report_generation_guide</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReportTips" aria-expanded="false" aria-controls="collapseReportTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseReportTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">@GlobalShared.report_types_overview</h6>
                    <div class="steps">
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-account-multiple-outline"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.member_situation</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.comprehensive_member_account_overview_with_balances_and_status</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-account-box-multiple-outline"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.account_situation</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.multiple_account_analysis_with_selection_options</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-bank-transfer"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.Account_Statement</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.detailed_transaction_history_for_specific_accounts</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-cash-multiple"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.Loan_Repayment</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.loan_payment_schedules_and_repayment_progress</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-chart-line"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.Loan_History</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.overall_loan_portfolio_analysis_and_statistics</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-percent"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>@GlobalShared.Interest/@GlobalMembersFSeries.vad/@GlobalShared.Penalty</strong>
                                <div class="small text-muted">@GlobalMembersFSeries.interest_vad_and_penalty_reports_with_date_range_filtering</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">@GlobalShared.quick_reference</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-text-outline text-success me-2"></i>
                            <strong>@GlobalShared.Date_Range:</strong> @GlobalMembersFSeries.most_reports_support_custom_date_filtering
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-format-list-bulleted-type text-warning me-2"></i>
                            <strong>@GlobalShared.multiple_formats:</strong> @GlobalMembersFSeries.pdf_excel_and_printready_formats_available
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-filter-outline text-info me-2"></i>
                            <strong>@GlobalShared.flexible_filtering:</strong> @GlobalMembersFSeries.filter_by_account_type_loan_type_and_date_range
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-shield-check-outline text-success me-2"></i>
                            <strong>@GlobalShared.Secure:</strong> @GlobalMembersFSeries.all_reports_are_generated_with_enterprisegrade_security
                        </li>
                    </ul>

                    <div class="mt-3 p-3 bg-light rounded">
                        <div class="small text-muted">
                            <i class="mdi mdi-lightbulb-on-outline me-1"></i>
                            <strong>@GlobalShared.Pro_Tip:</strong> @GlobalMembersFSeries.select_your_report_type_first_then_fill_in_the_required_parameters_use_reset_to_clear_all_fields_and_start_over.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Type Selection -->
    <div class="card mb-3">
        <div class="card-header bg-light">
            <h5 class="mb-0 text-primary"><i class="mdi mdi-filter-outline me-2"></i>@GlobalShared.Step 1: @GlobalShared.Select_Report_Type</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <!-- Radio buttons -->
                    <div class="d-flex flex-wrap gap-3">

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="memberSituation"
                                   value="MemberSituation"
                                   checked
                                  onclick="switchReport('MemberSituation')">
                            <label class="form-check-label" for="memberSituation">
                                <i class="mdi mdi-account-multiple-outline me-2"></i>
                                @GlobalShared.member_situation
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="accountSituation"
                                   value="AccountSituation"
                                   onclick="switchReport('AccountSituation')">
                            <label class="form-check-label" for="accountSituation">
                                <i class="mdi mdi-account-box-multiple-outline me-2"></i>
                                @GlobalShared.account_situation
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="accountStatement"
                                   value="AccountStatement"
                                   onclick="switchReport('AccountStatement')">
                            <label class="form-check-label" for="accountStatement">
                                <i class="mdi mdi-bank-transfer me-2"></i>
                                @GlobalShared.Account_Statement
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="loanRepayment"
                                   value="LoanRepayment"
                                   onclick="switchReport('LoanRepayment')">
                            <label class="form-check-label" for="loanRepayment">
                                <i class="mdi mdi-cash-multiple me-2"></i>
                                @GlobalShared.Loan_Repayment
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="loanSituation"
                                   value="LoanSituation"
                                   onclick="switchReport('LoanSituation')">
                            <label class="form-check-label" for="loanSituation">
                                <i class="mdi mdi-chart-line me-2"></i>
                                @GlobalShared.Loan_History
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="interestVadPenalty"
                                   value="InterestVadPenalty"
                                   @*onclick="switchReport('InterestVadPenalty')"*@>
                            <label class="form-check-label" for="interestVadPenalty">
                                <i class="mdi mdi-percent me-2"></i>
                                @GlobalShared.Interest/@GlobalShared.VAT/@GlobalShared.Penalty
                            </label>
                        </div>

                    </div>


                    <!-- Help text -->
                    <div class="mt-2 small text-muted">
                        <span id="reportTypeHelp" class="text-success">
                            <strong>@GlobalMembersFSeries.member_situation_selected:</strong> @GlobalMembersFSeries.generate_comprehensive_member_account_reports_with_balances_and_activity_details
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Parameters Section -->
    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("GenerateReport", "MembersFSeriesReport", FormMethod.Post, new { id = "reportForm", @class = "needs-validation", novalidate = "novalidate", onsubmit = "return generateReportAjax(this);" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReportType, new { id = "ReportType", @value = "MemberSituation" })
                @Html.HiddenFor(m => m.CustomerId)
                <!-- Hidden field for selected accounts (JSON array) -->
                @Html.Hidden("SelectedAccountIds", "", new { id = "SelectedAccountIds" })

                <!-- Member Situation Form (Default) -->
                <div id="memberSituationForm" class="report-form-section">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                 @*Account Selection (Multiple)*@ 
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-account-card-outline me-2 text-primary"></i>
                                        @GlobalShared.Select_Accounts
                                    </label>
                                    <div class="form-floating">
                                        @Html.ListBox("AccountIds",
                                            (IEnumerable<SelectListItem>)ViewBag.Accounts,
                                            new { @class = "form-control select2", id = "memberAccountIds", multiple = "multiple" })
                                        <label for="memberAccountIds">@GlobalMembersFSeries.select_multiple_accounts</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_at_least_one_account
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            @GlobalMembersFSeries.select_one_or_multiple_member_accounts_for_the_report
                                        </div>
                                    </div>
                                </div>

                                 @*Loan Status Filter*@ 
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-hand-coin-outline me-2 text-primary"></i>
                                        @GlobalMembersFSeries.loan_status_filter
                                    </label>
                                    <div class="form-floating">
                                        <select class="form-control" id="memberLoanStatus" name="LoanStatus">
                                            <option value="" disabled selected>@GlobalShared.select_filter</option>
                                            <option value="all">@GlobalShared.All_loans</option>
                                            <option value="approved">@GlobalShared.Approved</option>
                                            <option value="rescheduled">@GlobalShared.Rescheduled</option>
                                            <option value="refinanced">@GlobalShared.Refinanced</option>
                                            <option value="restructured">@GlobalShared.Restructured</option>
                                            <option value="current">@GlobalShared.Current</option>
                                        </select>
                                        <label for="memberLoanStatus">@GlobalShared.filter_by_loan_status</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_a_loan_status_filter
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            @GlobalMembersFSeries.filter_loans_by_their_current_status
                                        </div>
                                    </div>
                                </div>
                                <hr />

                                 @*Date Range Section*@ 
                                <div id="memberDateSection">
                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                                @GlobalShared.Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox(
                                                    "DateTo",
                                                    DateTime.Now.ToString("yyyy-MM-dd"),
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "memberDateTo"
                                                    })
                                                <label for="memberDateTo">@GlobalShared.operation_date</label>
                                                <div class="invalid-feedback">
                                                    @GlobalMembersFSeries.please_select_an_end_date
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Situation Form -->
                <div id="accountSituationForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Account Selection (Multiple) -->
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-account-box-multiple-outline me-2 text-primary"></i>
                                        @GlobalShared.Select_Accounts
                                    </label>
                                    <div class="form-floating">
                                        @Html.ListBox("AccountIds_Situation",
                                            (IEnumerable<SelectListItem>)ViewBag.Accounts,
                                            new { @class = "form-control select2", id = "accountSituationIds", multiple = "multiple" })
                                        <label for="accountSituationIds">@GlobalMembersFSeries.select_multiple_accounts</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_at_least_one_account
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            @GlobalMembersFSeries.select_one_or_multiple_accounts_for_situation_analysis
                                        </div>
                                    </div>
                                </div>


                                <!-- Date Range -->
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                            @GlobalShared.Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox(
                                                "DateTo_Situation",
                                                DateTime.Now.ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "accountSituationDateTo",
                                                    max = DateTime.Now.ToString("dd-MM-yyyy")
                                                })
                                            <label for="accountSituationDateTo">@GlobalShared.operation_date</label>
                                            <div class="invalid-feedback">
                                                @GlobalMembersFSeries.please_select_the_operation_date
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Statement Form -->
                <div id="accountStatementForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Account Selection -->
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-bank me-2 text-primary"></i>
                                        @GlobalShared.account_selection
                                    </label>
                                    <div class="form-floating">
                                        @Html.DropDownList("AccountTypeId_Statement",
                                            (IEnumerable<SelectListItem>)ViewBag.Account,
                                            "Select Account",
                                            new { @class = "form-control select2", required = "required", id = "accountStatementAccount" })
                                        <label for="accountStatementAccount">@GlobalShared.Select_account</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_an_account
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                <!-- From Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                        @GlobalShared.From_Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateFrom_Statement",
                                            new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"),
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "accountDateFrom",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="accountDateFrom">@GlobalShared.Start_Date</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_a_start_date
                                        </div>
                                    </div>
                                </div>

                                <!-- To Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                        @GlobalShared.To_Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateTo_Statement",
                                            DateTime.Now.ToString("yyyy-MM-dd"),
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "accountDateTo",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="accountDateTo">@GlobalShared.End_Date</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_an_end_date
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loan Repayment Form -->
                <div id="loanRepaymentForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Selection Method - Now Radio Buttons -->
                                <div class="col-md-12 mb-3">
                                    <label class="fw-medium mb-2">
                                        <i class="mdi mdi-filter-outline me-2 text-primary"></i>
                                        @GlobalShared.Report_Type
                                    </label>
                                    <div class="d-flex gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="repaymentByLoan" name="repaymentType" value="byLoan" checked>
                                            <label class="form-check-label" for="repaymentByLoan">
                                                @GlobalMembersFSeries.by_specific_loan
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="repaymentByRepayment" name="repaymentType" value="byRepayment">
                                            <label class="form-check-label" for="repaymentByRepayment">
                                                @GlobalMembersFSeries.by_repayment_period
                                            </label>
                                        </div>
                                    </div>
                                    <!-- Add this help text div -->
                                    <div class="mt-2 small text-muted" id="repaymentTypeHelp">
                                        <strong>@GlobalMembersFSeries.by_specific_loan_selected:</strong> @GlobalMembersFSeries.generate_repayment_schedule_for_a_specific_loan
                                    </div>
                                </div>

                                <!-- Loan Selection Section -->
                                <!-- Loan Selection Section -->
                                <div id="loanSelectionSection" class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-hand-coin-outline me-2 text-primary"></i>
                                        @GlobalShared.loan_selection
                                    </label>
                                    <div class="form-floating">
                                        @Html.DropDownList("LoanId_Repayment",
                                            (IEnumerable<SelectListItem>)ViewBag.Loans,
                                            "Select Loan",
                                            new { @class = "form-control select2", id = "loanRepaymentLoan" })
                                        <label for="loanRepaymentLoan">@GlobalShared.select_loan</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_a_loan
                                        </div>
                                    </div>
                                </div>
                                <!-- Date Range Section - ALWAYS VISIBLE -->
                                <div id="loanRepaymentDateSection" class="mt-3">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                                @GlobalShared.From_Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox("DateFrom_Repayment",
                                                    new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"),
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "loanRepaymentDateFrom",
                                                        max = DateTime.Now.ToString("yyyy-MM-dd")
                                                    })
                                                <label for="loanRepaymentDateFrom">@GlobalShared.Start_Date</label>
                                                <div class="invalid-feedback">
                                                    @GlobalMembersFSeries.please_select_a_start_date
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                                @GlobalShared.To_Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox("DateTo_Repayment",
                                                    DateTime.Now.ToString("yyyy-MM-dd"),
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "loanRepaymentDateTo",
                                                        max = DateTime.Now.ToString("yyyy-MM-dd")
                                                    })
                                                <label for="loanRepaymentDateTo">@GlobalShared.End_Date</label>
                                                <div class="invalid-feedback">
                                                    @GlobalMembersFSeries.please_select_an_end_date
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loan Situation Form -->
                <div id="loanSituationForm" class="report-form-section d-none">
                    <div class="card border-primary">                       
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-hand-coin-outline me-2 text-primary"></i>
                                        @GlobalMembersFSeries.loan_status_filter
                                    </label>
                                    <div class="form-floating">
                                        <select class="form-control" id="LoanHistoryStatus" name="LoanStatus">
                                            <option value="" disabled selected>@GlobalShared.select_filter</option>
                                            <option value="all">@GlobalShared.All_loans</option>
                                            <option value="approved">@GlobalShared.Approved</option>
                                            <option value="rescheduled">@GlobalShared.Rescheduled</option>
                                            <option value="refinanced">@GlobalShared.Refinanced</option>
                                            <option value="restructured">@GlobalShared.Restructured</option>
                                            <option value="current">@GlobalShared.Current</option>
                                        </select>
                                        <label for="memberLoanStatus">@GlobalShared.filter_by_loan_status</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_a_loan_status_filter
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            @GlobalMembersFSeries.filter_loans_by_their_current_status
                                        </div>
                                    </div>
                                </div>

                                <!-- From Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                        @GlobalShared.From_Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateFrom_LoanSituation",
                                            new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"),
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "loanSituationDateFrom",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="loanSituationDateFrom">@GlobalShared.Start_Date</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_a_start_date
                                        </div>
                                    </div>
                                </div>

                                <!-- To Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                        @GlobalShared.To_Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateTo_LoanSituation",
                                            DateTime.Now.ToString("yyyy-MM-dd"),
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "loanSituationDateTo",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="loanSituationDateTo">@GlobalShared.End_Date</label>
                                        <div class="invalid-feedback">
                                            @GlobalMembersFSeries.please_select_an_end_date
                                        </div>
                                    </div>
                                </div>


                            </div>
                            <div class="alert alert-info mt-3 mb-0">
                                <div class="d-flex">
                                    <div class="me-2">
                                        <i class="mdi mdi-information-outline"></i>
                                    </div>
                                    <div>
                                        <h6 class="alert-heading mb-1">@GlobalMembersFSeries.loan_portfolio_analysis</h6>
                                        <p class="mb-0 small">
                                            @GlobalMembersFSeries.this_report_provides_comprehensive_analysis_of_the_entire_loan_portfolio_including_performance_metrics_risk_analysis_and_portfolio_health.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interest/VAD/Penalty Form -->
                <div id="interestVadPenaltyForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Report Type Selection -->
                                <div class="col-md-12 mb-3">
                                    <label class="fw-medium mb-2">
                                        <i class="mdi mdi-filter-outline me-2 text-primary"></i>
                                        @GlobalShared.Select_Report_Type
                                    </label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="interestReport" name="interestVadPenaltyType" value="Interest" checked>
                                            <label class="form-check-label" for="interestReport">
                                                <i class="mdi mdi-cash-usd me-2 text-success"></i>
                                                @GlobalShared.interest_report
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="vadReport" name="interestVadPenaltyType" value="VAD">
                                            <label class="form-check-label" for="vadReport">
                                                <i class="mdi mdi-scale-balance me-2 text-warning"></i>
                                                @GlobalShared.vat_report
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="penaltyReport" name="interestVadPenaltyType" value="Penalty">
                                            <label class="form-check-label" for="penaltyReport">
                                                <i class="mdi mdi-alert-circle me-2 text-danger"></i>
                                                @GlobalShared.penalty_report
                                            </label>
                                        </div>
                                    </div>
                                    <div class="mt-2 small text-muted" id="interestVadPenaltyHelp">
                                        <strong>@GlobalMembersFSeries.interest_report_selected:</strong> @GlobalMembersFSeries.generate_interest_calculation_report_for_the_selected_date_range
                                    </div>
                                </div>

                                <!-- Date Range Section -->
                                <div class="row g-3 mt-2">
                                    <div class="col-md-6">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                            @GlobalShared.From_Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox("DateFrom_InterestVadPenalty",
                                                new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "interestVadPenaltyDateFrom",
                                                    max = DateTime.Now.ToString("yyyy-MM-dd")
                                                })
                                            <label for="interestVadPenaltyDateFrom">@GlobalShared.Start_Date</label>
                                            <div class="invalid-feedback">
                                                @GlobalMembersFSeries.please_select_a_start_date_cannot_be_in_the_future
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                            @GlobalShared.To_Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox("DateTo_InterestVadPenalty",
                                                DateTime.Now.ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "interestVadPenaltyDateTo",
                                                    max = DateTime.Now.ToString("yyyy-MM-dd")
                                                })
                                            <label for="interestVadPenaltyDateTo">@GlobalShared.End_Date</label>
                                            <div class="invalid-feedback">
                                                @GlobalMembersFSeries.please_select_an_end_date_cannot_be_in_the_future
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- Date Validation Message -->
                                <div class="col-12 mt-2">
                                    <div class="alert alert-warning small mb-0" id="dateValidationMessage" style="display: none;">
                                        <i class="mdi mdi-alert me-2"></i>
                                        <span id="dateValidationText"></span>
                                    </div>
                                </div>

                                <!-- Information Alert -->
                                <div class="col-12 mt-3">
                                    <div class="alert alert-info">
                                        <div class="d-flex">
                                            <div class="me-2">
                                                <i class="mdi mdi-information-outline"></i>
                                            </div>
                                            <div>
                                                <h6 class="alert-heading mb-1">@GlobalShared.report_information</h6>
                                                <p class="mb-0 small">
                                                    <strong>@GlobalShared.interest_report:</strong> @GlobalMembersFSeries.shows_interest_calculations_and_accruals<br>
                                                    <strong>@GlobalShared.vat_report:</strong> @GlobalMembersFSeries.shows_value_added_tax_details_and_calculations<br>
                                                    <strong>@GlobalShared.penalty_report:</strong> @GlobalMembersFSeries.shows_penalty_charges_and_calculations
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4 pt-3 border-top">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-3">
                            <button type="button" class="btn btn-light btn-lg px-4" id="btnResetReport">
                                <i class="mdi mdi-refresh me-2"></i> @GlobalShared.Reset_Form
                            </button>
                            <button type="submit" id="btnGenerateReport" class="btn btn-primary btn-lg px-4">
                                <i class="mdi mdi-printer-outline me-2"></i> @GlobalShared.Generate_Report
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="position-fixed top-0 left-0 w-100 h-100 d-none" style="background: rgba(0,0,0,0.5); z-index: 9999;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center">
            <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">@GlobalShared.Loading...</span>
            </div>
            <div class="text-white mt-3 fs-5">@GlobalShared.generating_report...</div>
        </div>
    </div>
</div>

<style>
    /* Existing styles remain the same, just adding new ones for checkboxes */
    /* Smooth transitions for loan repayment sections */
    #loanSelectionSection {
        transition: all 0.3s ease-in-out;
        overflow: hidden;
    }

        /* When hiding loan section */
        #loanSelectionSection.d-none {
            opacity: 0;
            max-height: 0;
            padding: 0;
            margin: 0;
        }

        /* When showing loan section */
        #loanSelectionSection:not(.d-none) {
            opacity: 1;
            max-height: 500px;
        }

    /* Date range section is always visible */
    #loanRepaymentDateSection {
        opacity: 1;
        max-height: 500px;
        transition: all 0.3s ease-in-out;
    }

    /* Checkbox styling */
    .form-check {
        margin-bottom: 0.5rem;
    }

    .form-check-input {
        margin-right: 0.5rem;
    }

    .form-check-label {
        font-weight: 500;
        color: #495057;
    }

    /* Selected accounts list */
    .selected-account-item {
        display: inline-block;
        background: #e9ecef;
        border-radius: 4px;
        padding: 4px 8px;
        margin: 2px;
        font-size: 0.85rem;
    }

        .selected-account-item .remove-account {
            cursor: pointer;
            margin-left: 5px;
            color: #dc3545;
        }

            .selected-account-item .remove-account:hover {
                color: #bd2130;
            }

    /* Conditional sections */
    .conditional-section {
        transition: all 0.3s ease;
    }

    /* Remove the flex-wrap from the radio buttons container for better mobile */
    @@media (max-width: 768px) {
        .d-flex.flex-wrap.gap-3 {
            flex-direction: column;
            gap: 10px !important;
        }

        .form-check-label {
            min-height: 60px;
            padding: 10px 15px;
        }
    }

    /* Interest/VAD/Penalty specific styles */
    #interestVadPenaltyForm .form-check-label i {
        font-size: 1.1rem;
        margin-right: 5px;
    }

    .date-validation-error {
        border-color: #dc3545 !important;
    }
</style>

