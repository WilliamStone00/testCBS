@using CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation
@model ReportParameters
@using System.Web.Mvc

<div class="container-fluid">

    <hr />
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-chart-bar me-2"></i> Financial Report Generator
                    </h1>
                    <p class="card-text">
                        Generate detailed financial reports for members, accounts, and loans. Select your report type,
                        customize parameters, and generate professional reports instantly.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Report Generation Guide</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReportTips" aria-expanded="false" aria-controls="collapseReportTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseReportTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">Report Types Overview</h6>
                    <div class="steps">
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-account-multiple-outline"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Member Situation</strong>
                                <div class="small text-muted">Comprehensive member account overview with balances and status</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-account-box-multiple-outline"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Account Situation</strong>
                                <div class="small text-muted">Multiple account analysis with selection options</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-bank-transfer"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Account Statement</strong>
                                <div class="small text-muted">Detailed transaction history for specific accounts</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-cash-multiple"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Loan Repayment</strong>
                                <div class="small text-muted">Loan payment schedules and repayment progress</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-chart-line"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Loan History</strong>
                                <div class="small text-muted">Overall loan portfolio analysis and statistics</div>
                            </div>
                        </div>
                        <div class="step-item mb-3">
                            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px;">
                                <i class="mdi mdi-percent"></i>
                            </div>
                            <div class="step-content d-inline-block">
                                <strong>Interest/VAD/Penalty</strong>
                                <div class="small text-muted">Interest, VAD, and Penalty reports with date range filtering</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-primary mb-3">Quick Reference</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-text-outline text-success me-2"></i>
                            <strong>Date Range:</strong> Most reports support custom date filtering
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-format-list-bulleted-type text-warning me-2"></i>
                            <strong>Multiple Formats:</strong> PDF, Excel, and Print-ready formats available
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-filter-outline text-info me-2"></i>
                            <strong>Flexible Filtering:</strong> Filter by account type, loan type, and date range
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-shield-check-outline text-success me-2"></i>
                            <strong>Secure:</strong> All reports are generated with enterprise-grade security
                        </li>
                    </ul>

                    <div class="mt-3 p-3 bg-light rounded">
                        <div class="small text-muted">
                            <i class="mdi mdi-lightbulb-on-outline me-1"></i>
                            <strong>Pro Tip:</strong> Select your report type first, then fill in the required parameters. Use Reset to clear all fields and start over.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Type Selection -->
    <div class="card mb-3">
        <div class="card-header bg-light">
            <h5 class="mb-0 text-primary"><i class="mdi mdi-filter-outline me-2"></i>Step 1: Select Report Type</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <!-- Radio buttons -->
                    <div class="d-flex flex-wrap gap-3">

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="memberSituation"
                                   value="MemberSituation"
                                   checked
                                  onclick="switchReport('MemberSituation')">
                            <label class="form-check-label" for="memberSituation">
                                <i class="mdi mdi-account-multiple-outline me-2"></i>
                                Member Situation
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="accountSituation"
                                   value="AccountSituation"
                                   onclick="switchReport('AccountSituation')">
                            <label class="form-check-label" for="accountSituation">
                                <i class="mdi mdi-account-box-multiple-outline me-2"></i>
                                Account Situation
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="accountStatement"
                                   value="AccountStatement"
                                   onclick="switchReport('AccountStatement')">
                            <label class="form-check-label" for="accountStatement">
                                <i class="mdi mdi-bank-transfer me-2"></i>
                                Account Statement
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="loanRepayment"
                                   value="LoanRepayment"
                                   @*onclick="switchReport('LoanRepayment')">*@
                            <label class="form-check-label" for="loanRepayment">
                                <i class="mdi mdi-cash-multiple me-2"></i>
                                Loan Repayment
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="loanSituation"
                                   value="LoanSituation"
                                   onclick="switchReport('LoanSituation')">
                            <label class="form-check-label" for="loanSituation">
                                <i class="mdi mdi-chart-line me-2"></i>
                                Loan History
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="ReportTypeRadio"
                                   id="interestVadPenalty"
                                   value="InterestVadPenalty"
                                   @*onclick="switchReport('InterestVadPenalty')"*@>
                            <label class="form-check-label" for="interestVadPenalty">
                                <i class="mdi mdi-percent me-2"></i>
                                Interest/VAT/Penalty
                            </label>
                        </div>

                    </div>


                    <!-- Help text -->
                    <div class="mt-2 small text-muted">
                        <span id="reportTypeHelp" class="text-success">
                            <strong>Member Situation Selected:</strong> Generate comprehensive member account reports with balances and activity details
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Parameters Section -->
    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("GenerateReport", "MembersFSeriesReport", FormMethod.Post, new { id = "reportForm", @class = "needs-validation", novalidate = "novalidate", onsubmit = "return generateReportAjax(this);" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReportType, new { id = "ReportType", @value = "MemberSituation" })
                @Html.HiddenFor(m => m.CustomerId)
                <!-- Hidden field for selected accounts (JSON array) -->
                @Html.Hidden("SelectedAccountIds", "", new { id = "SelectedAccountIds" })

                <!-- Member Situation Form (Default) -->
                <div id="memberSituationForm" class="report-form-section">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                 Account Selection (Multiple) 
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-account-card-outline me-2 text-primary"></i>
                                        Select Accounts
                                    </label>
                                    <div class="form-floating">
                                        @Html.ListBox("AccountIds",
                                            (IEnumerable<SelectListItem>)ViewBag.Accounts,
                                            new { @class = "form-control select2", id = "memberAccountIds", multiple = "multiple" })
                                        <label for="memberAccountIds">Select multiple accounts</label>
                                        <div class="invalid-feedback">
                                            Please select at least one account
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            Select one or multiple member accounts for the report
                                        </div>
                                    </div>
                                </div>

                                 @*Loan Status Filter*@ 
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-hand-coin-outline me-2 text-primary"></i>
                                        Loan Status Filter
                                    </label>
                                    <div class="form-floating">
                                        <select class="form-control" id="memberLoanStatus" name="LoanStatus">
                                            <option value="" disabled selected>Select Filter</option>
                                            <option value="all">All Loans</option>
                                            <option value="approved">Approved</option>
                                            <option value="rescheduled">Rescheduled</option>
                                            <option value="refinanced">Refinanced</option>
                                            <option value="restructured">Restructured</option>
                                            <option value="current">Current</option>
                                        </select>
                                        <label for="memberLoanStatus">Filter by loan status</label>
                                        <div class="invalid-feedback">
                                            Please select a loan status filter
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            Filter loans by their current status
                                        </div>
                                    </div>
                                </div>
                                <hr />

                                 @*Date Range Section*@ 
                                <div id="memberDateSection">
                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                                Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox(
                                                    "DateTo",
                                                    DateTime.Now.ToString("yyyy-MM-dd"),
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "memberDateTo"
                                                    })
                                                <label for="memberDateTo">operation date</label>
                                                <div class="invalid-feedback">
                                                    Please select an end date
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Situation Form -->
                <div id="accountSituationForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Account Selection (Multiple) -->
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-account-box-multiple-outline me-2 text-primary"></i>
                                        Select Accounts
                                    </label>
                                    <div class="form-floating">
                                        @Html.ListBox("AccountIds_Situation",
                                            (IEnumerable<SelectListItem>)ViewBag.Accounts,
                                            new { @class = "form-control select2", id = "accountSituationIds", multiple = "multiple" })
                                        <label for="accountSituationIds">Select multiple accounts</label>
                                        <div class="invalid-feedback">
                                            Please select at least one account
                                        </div>
                                        <div class="mt-1 small text-muted">
                                            Select one or multiple accounts for situation analysis
                                        </div>
                                    </div>
                                </div>


                                <!-- Date Range -->
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                            Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox(
                                                "DateTo_Situation",
                                                DateTime.Now.ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "accountSituationDateTo",
                                                    max = DateTime.Now.ToString("yyyy-MM-dd")
                                                })
                                            <label for="accountSituationDateTo">Operation date</label>
                                            <div class="invalid-feedback">
                                                Please select the Operation date
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Statement Form -->
                <div id="accountStatementForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Account Selection -->
                                <div class="col-md-12">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-bank me-2 text-primary"></i>
                                        Account Selection
                                    </label>
                                    <div class="form-floating">
                                        @Html.DropDownList("AccountTypeId_Statement",
                                            (IEnumerable<SelectListItem>)ViewBag.Account,
                                            "Select Account",
                                            new { @class = "form-control select2", required = "required", id = "accountStatementAccount" })
                                        <label for="accountStatementAccount">Select account</label>
                                        <div class="invalid-feedback">
                                            Please select an account
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                <!-- From Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                        From Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateFrom_Statement", "{0:yyyy-MM-dd}",
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "accountDateFrom",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="accountDateFrom">Start date</label>
                                        <div class="invalid-feedback">
                                            Please select a start date
                                        </div>
                                    </div>
                                </div>

                                <!-- To Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                        To Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateTo_Statement", "{0:yyyy-MM-dd}",
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "accountDateTo",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="accountDateTo">End date</label>
                                        <div class="invalid-feedback">
                                            Please select an end date
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loan Repayment Form -->
                <div id="loanRepaymentForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Selection Method - Now Radio Buttons -->
                                <div class="col-md-12 mb-3">
                                    <label class="fw-medium mb-2">
                                        <i class="mdi mdi-filter-outline me-2 text-primary"></i>
                                        Report Type
                                    </label>
                                    <div class="d-flex gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="repaymentByLoan" name="repaymentType" value="byLoan" checked>
                                            <label class="form-check-label" for="repaymentByLoan">
                                                By Specific Loan
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="repaymentByRepayment" name="repaymentType" value="byRepayment">
                                            <label class="form-check-label" for="repaymentByRepayment">
                                                By Repayment Period
                                            </label>
                                        </div>
                                    </div>
                                    <!-- Add this help text div -->
                                    <div class="mt-2 small text-muted" id="repaymentTypeHelp">
                                        <strong>By Specific Loan Selected:</strong> Generate repayment schedule for a specific loan
                                    </div>
                                </div>

                                <!-- Loan Selection Section -->
                                <div id="loanSelectionSection">
                                    <div class="col-md-12">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-hand-coin-outline me-2 text-primary"></i>
                                            Loan Selection
                                        </label>
                                        <div class="form-floating">
                                            @Html.DropDownList("LoanId_Repayment",
                                                (IEnumerable<SelectListItem>)ViewBag.Loans,
                                                "Select Loan",
                                                new { @class = "form-control select2", id = "loanRepaymentLoan" })
                                            <label for="loanRepaymentLoan">Select loan</label>
                                            <div class="invalid-feedback">
                                                Please select a loan
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Date Range Section - ALWAYS VISIBLE -->
                                <div id="loanRepaymentDateSection" class="mt-3">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                                From Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox("DateFrom_Repayment", "{0:yyyy-MM-dd}",
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "loanRepaymentDateFrom",
                                                        max = DateTime.Now.ToString("yyyy-MM-dd")
                                                    })
                                                <label for="loanRepaymentDateFrom">Start date</label>
                                                <div class="invalid-feedback">
                                                    Please select a start date
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="fw-medium">
                                                <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                                To Date
                                            </label>
                                            <div class="form-floating">
                                                @Html.TextBox("DateTo_Repayment", "{0:yyyy-MM-dd}",
                                                    new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        id = "loanRepaymentDateTo",
                                                        max = DateTime.Now.ToString("yyyy-MM-dd")
                                                    })
                                                <label for="loanRepaymentDateTo">End date</label>
                                                <div class="invalid-feedback">
                                                    Please select an end date
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loan Situation Form -->
                <div id="loanSituationForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- From Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                        From Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateFrom_LoanSituation", "{0:yyyy-MM-dd}",
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "loanSituationDateFrom",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="loanSituationDateFrom">Start date</label>
                                        <div class="invalid-feedback">
                                            Please select a start date
                                        </div>
                                    </div>
                                </div>

                                <!-- To Date -->
                                <div class="col-md-6">
                                    <label class="fw-medium">
                                        <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                        To Date
                                    </label>
                                    <div class="form-floating">
                                        @Html.TextBox("DateTo_LoanSituation", "{0:yyyy-MM-dd}",
                                            new
                                            {
                                                @class = "form-control datepicker",
                                                type = "date",
                                                required = "required",
                                                id = "loanSituationDateTo",
                                                max = DateTime.Now.ToString("yyyy-MM-dd")
                                            })
                                        <label for="loanSituationDateTo">End date</label>
                                        <div class="invalid-feedback">
                                            Please select an end date
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="alert alert-info mt-3 mb-0">
                                <div class="d-flex">
                                    <div class="me-2">
                                        <i class="mdi mdi-information-outline"></i>
                                    </div>
                                    <div>
                                        <h6 class="alert-heading mb-1">Loan Portfolio Analysis</h6>
                                        <p class="mb-0 small">
                                            This report provides comprehensive analysis of the entire loan portfolio
                                            including performance metrics, risk analysis, and portfolio health.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interest/VAD/Penalty Form -->
                <div id="interestVadPenaltyForm" class="report-form-section d-none">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Report Type Selection -->
                                <div class="col-md-12 mb-3">
                                    <label class="fw-medium mb-2">
                                        <i class="mdi mdi-filter-outline me-2 text-primary"></i>
                                        Select Report Type
                                    </label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="interestReport" name="interestVadPenaltyType" value="Interest" checked>
                                            <label class="form-check-label" for="interestReport">
                                                <i class="mdi mdi-cash-usd me-2 text-success"></i>
                                                Interest Report
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="vadReport" name="interestVadPenaltyType" value="VAD">
                                            <label class="form-check-label" for="vadReport">
                                                <i class="mdi mdi-scale-balance me-2 text-warning"></i>
                                                VAT Report
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="penaltyReport" name="interestVadPenaltyType" value="Penalty">
                                            <label class="form-check-label" for="penaltyReport">
                                                <i class="mdi mdi-alert-circle me-2 text-danger"></i>
                                                Penalty Report
                                            </label>
                                        </div>
                                    </div>
                                    <div class="mt-2 small text-muted" id="interestVadPenaltyHelp">
                                        <strong>Interest Report Selected:</strong> Generate interest calculation report for the selected date range
                                    </div>
                                </div>

                                <!-- Date Range Section -->
                                <div class="row g-3 mt-2">
                                    <div class="col-md-6">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-start me-2 text-primary"></i>
                                            From Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox("DateFrom_InterestVadPenalty", "{0:yyyy-MM-dd}",
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "interestVadPenaltyDateFrom",
                                                    max = DateTime.Now.ToString("yyyy-MM-dd")
                                                })
                                            <label for="interestVadPenaltyDateFrom">Start date</label>
                                            <div class="invalid-feedback">
                                                Please select a start date (cannot be in the future)
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="fw-medium">
                                            <i class="mdi mdi-calendar-end me-2 text-primary"></i>
                                            To Date
                                        </label>
                                        <div class="form-floating">
                                            @Html.TextBox("DateTo_InterestVadPenalty", "{0:yyyy-MM-dd}",
                                                new
                                                {
                                                    @class = "form-control datepicker",
                                                    type = "date",
                                                    required = "required",
                                                    id = "interestVadPenaltyDateTo",
                                                    max = DateTime.Now.ToString("yyyy-MM-dd")
                                                })
                                            <label for="interestVadPenaltyDateTo">End date</label>
                                            <div class="invalid-feedback">
                                                Please select an end date (cannot be in the future)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Date Validation Message -->
                                <div class="col-12 mt-2">
                                    <div class="alert alert-warning small mb-0" id="dateValidationMessage" style="display: none;">
                                        <i class="mdi mdi-alert me-2"></i>
                                        <span id="dateValidationText"></span>
                                    </div>
                                </div>

                                <!-- Information Alert -->
                                <div class="col-12 mt-3">
                                    <div class="alert alert-info">
                                        <div class="d-flex">
                                            <div class="me-2">
                                                <i class="mdi mdi-information-outline"></i>
                                            </div>
                                            <div>
                                                <h6 class="alert-heading mb-1">Report Information</h6>
                                                <p class="mb-0 small">
                                                    <strong>Interest Report:</strong> Shows interest calculations and accruals<br>
                                                    <strong>VAT Report:</strong> Shows Value Added Tax details and calculations<br>
                                                    <strong>Penalty Report:</strong> Shows penalty charges and calculations
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4 pt-3 border-top">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-3">
                            <button type="button" class="btn btn-light btn-lg px-4" id="btnResetReport">
                                <i class="mdi mdi-refresh me-2"></i> Reset Form
                            </button>
                            <button type="submit" id="btnGenerateReport" class="btn btn-primary btn-lg px-4">
                                <i class="mdi mdi-printer-outline me-2"></i> Generate Report
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="position-fixed top-0 left-0 w-100 h-100 d-none" style="background: rgba(0,0,0,0.5); z-index: 9999;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center">
            <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="text-white mt-3 fs-5">Generating Report...</div>
        </div>
    </div>
</div>

<style>
    /* Existing styles remain the same, just adding new ones for checkboxes */
    /* Smooth transitions for loan repayment sections */
    #loanSelectionSection {
        transition: all 0.3s ease-in-out;
        overflow: hidden;
    }

        /* When hiding loan section */
        #loanSelectionSection.d-none {
            opacity: 0;
            max-height: 0;
            padding: 0;
            margin: 0;
        }

        /* When showing loan section */
        #loanSelectionSection:not(.d-none) {
            opacity: 1;
            max-height: 500px;
        }

    /* Date range section is always visible */
    #loanRepaymentDateSection {
        opacity: 1;
        max-height: 500px;
        transition: all 0.3s ease-in-out;
    }

    /* Checkbox styling */
    .form-check {
        margin-bottom: 0.5rem;
    }

    .form-check-input {
        margin-right: 0.5rem;
    }

    .form-check-label {
        font-weight: 500;
        color: #495057;
    }

    /* Selected accounts list */
    .selected-account-item {
        display: inline-block;
        background: #e9ecef;
        border-radius: 4px;
        padding: 4px 8px;
        margin: 2px;
        font-size: 0.85rem;
    }

        .selected-account-item .remove-account {
            cursor: pointer;
            margin-left: 5px;
            color: #dc3545;
        }

            .selected-account-item .remove-account:hover {
                color: #bd2130;
            }

    /* Conditional sections */
    .conditional-section {
        transition: all 0.3s ease;
    }

    /* Remove the flex-wrap from the radio buttons container for better mobile */
    @@media (max-width: 768px) {
        .d-flex.flex-wrap.gap-3 {
            flex-direction: column;
            gap: 10px !important;
        }

        .form-check-label {
            min-height: 60px;
            padding: 10px 15px;
        }
    }

    /* Interest/VAD/Penalty specific styles */
    #interestVadPenaltyForm .form-check-label i {
        font-size: 1.1rem;
        margin-right: 5px;
    }

    .date-validation-error {
        border-color: #dc3545 !important;
    }
</style>

