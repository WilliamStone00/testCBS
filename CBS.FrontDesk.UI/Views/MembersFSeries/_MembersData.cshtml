@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalMembersFSeries.select_member_to_see_account_situation</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Registration_Date</th>
                    <th>@GlobalShared.Name</th>
                    <th>@GlobalShared.members_account_number</th>
                    <th>@GlobalShared.Phone_Number</th>
                    <th>@GlobalShared.Members_Profile</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>