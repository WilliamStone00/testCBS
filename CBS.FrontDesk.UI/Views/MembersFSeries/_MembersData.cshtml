    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalMembersFSeries.RegistrationDate</th>
                    <th>@GlobalMembersFSeries.Name</th>
                    <th>@GlobalMembersFSeries.MembersAccountNumber</th>
                    <th>@GlobalMembersFSeries.PhoneNumber</th>
                    <th>@GlobalMembersFSeries.MembersProfile</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>