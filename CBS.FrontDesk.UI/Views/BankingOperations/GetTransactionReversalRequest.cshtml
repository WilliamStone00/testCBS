@model CBS.FrontDesk.Data.Entity.Accounting.TransactionReversalDetailRequestDto
@{
    ViewBag.Title = "View Transaction Reversal Request";

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Transaction ReferenceId : @Model.ReferenceId
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Transaction Reversal Request Details</th>

                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">

                            <tr>
                                <td>Request Message</td>
                                <td>@Model.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>Requested By </td>
                                <td> @Model.IssuedBy </td>
                            </tr>
                             
                            <tr>
                                <td> Status</td>
                                @if (@Model.Status.ToString().ToUpper().Equals("PENDING"))
                                {
                                    <td class="badge bg-label-primary rounded-pill text-uppercase">
                                        @Model.Status
                                    </td>
                                }
                                else
                                {
                                    if (@Model.Status.ToUpper().Equals("APPROVE"))
                                    {
                                        <td class="badge bg-label-success rounded-pill text-uppercase">
                                            @Model.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-header">Transaction Reversal Request Status</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.Status.ToUpper().Equals("APPROVE"))
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">The transaction reversal request issued by  @Model.IssuedBy with reference :@Model.ReferenceId has already been approved.</h6>
                                </div>
                                <div class="col-12 shift-right">
                                    <a href="/TellerCashDemand/GetAllTransasctionReversalRequest" class="btn btn-primary click-to-go-back-to-menu">Click to view pending transaction reversal request. </a>
                                </div>

                            }
                            else
                            {
                                if (@Model.Status.ToUpper().Equals("REJECTED"))
                                {
                                    <div class="alert alert-outline-danger" role="alert">
                                        <h6 class="alert-heading mb-1">The transaction reversal request issued by @Model.IssuedBy with reference :@Model.ReferenceId has already been rejected.</h6>
                                    </div>
                                    <div class="col-12 shift-right">
                                        <a href="/BankingOperations/GetAllTransasctionReversalRequest" class="btn btn-primary ">Click to view pending transaction reversal request. </a>
                                    </div>

                                }
                                else
                                {
                                    <div class="alert alert-outline-primary" role="alert">
                                        <h6 class="alert-heading mb-1">Transaction reversal request with transaction referenceId :@Model.ReferenceId is pending for approval</h6>
                                      
                                        
                                        <p class="mb-0">Select your decision and click on Approved Account Replenishment button to approved the request</p>
                                    </div>
                                    @*<div class="col-12 shift-right">
                                        <a href="/BankingOperations/GetAllTransasctionReversalRequest" class="btn btn-primary">Click to view pending transaction reversal request. </a>
                                    </div>*@
                                }

                            }

                        </div>
                        @using (Html.BeginForm("CreateTransactionReversalRequestApproval", "BankingOperations", FormMethod.Post))
                        {
                            <!-- Account Details -->
                            @Html.HiddenFor(model => model.Id)
                    
                            <input type="hidden" name="option" value="Status" id="option" />

                            if (@Model.Status.ToUpper().Equals("APPROVE"))
                            {
                              

                            }
                            else
                            {
                                if (@Model.Status.ToUpper().Equals("REJECTED"))
                                {
                                    

                                }
                                else
                                {<div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            <label for="Account">Make decision</label>
                                            @Html.DropDownListFor(m => m.Status, new SelectList(ViewBag.Decisions == null ? "" : ViewBag.Decisions, "Text", "Value"), "---Select Decision ---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                          
                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                            @Html.ValidationMessageFor(model => model.ApprovedMessage, "", new { @class = "text-danger" })

                                            <label for="Description"> Approved Message Description</label>
                                        </div>

                                    </div>
                                    <div class="col-12 shift-right">
                                        <button type="submit" class="btn btn-primary deactivate-account">Click to approve to transaction reversal request.</button>
                                    </div>
                                }


                            }



                        }


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")}