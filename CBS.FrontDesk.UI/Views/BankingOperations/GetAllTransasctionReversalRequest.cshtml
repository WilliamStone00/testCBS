@model IEnumerable<CBS.FrontDesk.Data.Entity.Accounting.TransactionReversalDetailRequestDto>
@{
    ViewBag.Title = "Transaction Reversal Detail Data";

}
<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
               ACCOUNTING TRANSACTION REVERSAL REQUEST.
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">
                        <h2>List Of Transaction Reversal Request</h2>

                        <table class="table table-hover" id="ListOfTransactionReversalRequestData">
                            <thead class="table-light">
                                <tr>
                                    <th>ReferenceId</th>
                                    <th>RequestMessage</th>
                                    <th>IssuedBy</th>
                                    <th>IssuedDate</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {


                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ReferenceId)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.RequestMessage)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.IssuedBy)
                                        </td>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.IssuedDate)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </td>


                                        @if (item.Status.ToUpper().Equals("PENDING"))
                                        {
                                            <td class="badge bg-label-primary rounded-pill text-uppercase">

                                                @Html.ActionLink("Click to approve", "GetTransactionReversalRequest", new { @Key = item.Id }, new { @style = "color: inherit;" })

                                            </td>


                                        }
                                        else
                                        {
                                            if (item.Status.ToUpper().Equals("APPROVE"))
                                            {
                                                <td class="badge bg-label-success rounded-pill text-uppercase">
                                                    @Html.ActionLink("APPROVED", "GetTransactionReversalRequest", new { @Key = item.Id }, new { @style = "color: inherit;" })
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="badge bg-label-danger rounded-pill text-uppercase">
                                                    @Html.ActionLink("REJECTED", "GetTransactionReversalRequest", new { @Key = item.Id }, new { @style = "color: inherit;" })
                                                </td>
                                            }

                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/BankingOperations.js"></script>
 
}


