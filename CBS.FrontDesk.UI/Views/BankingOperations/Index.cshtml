@model CBS.FrontDesk.Data.Entity.Accounting.BankingOperations
@{
    ViewBag.Title = "BankOperations";
}

<div class="card mb-12">
    <div class="card-header">
        <h5 class="card-title mb-0">BANKING OPERATIONS-CASH MANAGEMENT</h5>
    </div>
    <div class="card-body">
        <div class="row">

            <!-- Navigation -->
            <div class="col-12 col-md-4 mx-auto card-separator">
                <div class="d-flex justify-content-between flex-column mb-3 mb-md-0 pe-md-3">
                    <div id="datalistingview_CashInfusion">
                        @Html.Partial("_CashInfusion")
                    </div>
                </div>
            </div>
            <!-- Navigation Body -->
            <div class="col-12 col-md-8 pt-4 pt-md-0">
                <div class="tab-content p-0 pe-xl-0 ps-md-3  card-separator">
                    <div class="tab-pane fade show active" id="restock" role="tabpanel">

                        <br />

                        <div id="datalistingview_CashInfusion">
                            @Html.Partial("_JournalEntries")
                        </div>
                        <br />
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>




@section Scripts { @Scripts.Render("~/bundles/jqueryval")
  

    <script src="~/Scripts/Js/main.js/MultipleManualEntry.js"></script>
}

