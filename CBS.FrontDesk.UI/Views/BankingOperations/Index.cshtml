@model CBS.FrontDesk.Data.Entity.Accounting.BankingOperations
@{
    ViewBag.Title = "BankOperations";
}

<div class="card mb-12">
    <div class="card-header">
        <h5 class="card-title mb-0">BANKING OPERATIONS-CASH MANAGEMENT</h5>
    </div>
    <div class="card-body">
        <div class="row">

            <!-- Navigation -->
            <div class="col-12 col-md-3 mx-auto card-separator">
                <div class="d-flex justify-content-between flex-column mb-3 mb-md-0 pe-md-3">
                    <ul class="nav nav-align-left nav-pills flex-column">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#restock">
                                <i class="mdi mdi-book-open-page-variant me-2"></i>
                                <span class="align-middle">Cash Replenishment</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#shipping">
                                <i class="mdi mdi-book-edit me-2"></i>
                                <span class="align-middle">Manual Accounting Entry</span>
                            </button>
                        </li>

                    </ul>
                </div>
            </div>
            <!-- Navigation Body -->
            <div class="col-12 col-md-9 pt-4 pt-md-0">
                <div class="tab-content p-0 pe-xl-0 ps-md-3">
                    <div class="tab-pane fade show active" id="restock" role="tabpanel">
                        <div class="row justify-content-end">
                            <div class="demo-inline-spacing text-end">
                                <a type="button" onclick="LoadDataGen('BankingOperations','myDataTable_CashInfusion','_CashInfusionData',0,'datalistingview_CashInfusion',null,'CashInfusion')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_CashInfusion','_CashInfusion','new','BankingOperations','CashInfusion')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                    <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                </a>
                            </div>
                        </div>
                        <br />

                        <div id="datalistingview_CashInfusion">
                            @Html.Partial("_CashInfusion")
                        </div>
                    </div>

                    <div class="tab-pane fade" id="shipping" role="tabpanel">
                        <div class="row justify-content-end">
                            <div class="demo-inline-spacing text-end">
                                <a type="button" onclick="LoadDataGen('BankingOperation','myDataTable_ManualAccountingEntry','_ManualAccountingEntryData',0,'datalistingview_ManualAccountingEntry',null,'ManualAccountingEntry')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_ManualAccountingEntry','_ManualAccountingEntry','new','BankingOperation','ManualAccountingEntry')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                    <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                </a>
                            </div>
                        </div>
                        <br />

                        <div id="datalistingview_ManualAccountingEntry">
                            @Html.Partial("_ManualAccountingEntry")
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>




@section Scripts {@Scripts.Render("~/bundles/jqueryval")

}

