<style>
    /* General table cell formatting */
    #myDataTable th,
    #myDataTable td {
        vertical-align: middle !important;
        text-align: center !important;
        white-space: nowrap; /* default: prevent wrapping */
        width: auto !important; /* let browser auto-size */
    }

        /* 🔵 Branch column (4th column) */
        #myDataTable th:nth-child(4),
        #myDataTable td:nth-child(4) {
            min-width: 220px !important; /* increase width */
            white-space: normal !important; /* allow wrapping */
            word-wrap: break-word; /* break long words */
            max-width: 260px !important; /* limit width */
        }
</style>



@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.accountingyear>

<fieldset class="fieldset-custom">
    <h6 class="d-flex justify-content-between align-items-center text-primary mb-3">
        <span><i class="mdi mdi-calendar-clock-outline me-2"></i> Accounting Year Configuration</span>


    </h6>
    @if (Model == null || !Model.Any())
    {
        <div class="text-center my-3">
            <p>No accounting years have been defined yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle border text-center"
                   id="myDataTable" @*style="table-layout: fixed; width: 100%;"*@>
                <thead class="bg-light fw-semibold text-uppercase small text-center align-middle">
                    <tr>
                        <th style="display:none;">Id</th>
                        <th class="py-2">Start Accounting Date</th>
                        <th class="py-2">End Accounting Date</th>
                        <th class="py-2">Branch</th>
                        <th class="py-2">Year</th>
                        <th class="py-2">Status</th>
                        <th class="py-2" style="width:120px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr data-id="@d.Id" class="text-center align-middle">

                            <td style="display:none;">@d.Id</td>

                            <td>@d.StartDate</td>
                            <td>@d.EndDate</td>

                            <td class="text-nowrap">@d.BranchName</td>

                            <td>@d.Year</td>

                            <td>
                                @if (d.Status?.ToUpper() == "OPEN")
                                {
                                    <span class="badge bg-success bg-opacity-75 px-3">Open</span>
                                }
                                else if (d.Status?.ToUpper() == "CLOSE")
                                {
                                    <span class="badge bg-secondary bg-opacity-75 px-3">Close</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-75 px-3">Lock</span>
                                }
                            </td>

                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm px-3 btn-update-year"
                                            data-id="@d.Id">
                                        <i class="mdi mdi-content-save-outline me-1"></i> Update
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>


    }
</fieldset>
