@model CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.accountingyear

@using Resources
@{
    ViewBag.Title = "Accounting Year";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Accounting Year
        </h1>

        @*<div class="alert alert-info mt-3 py-2">
                <i class="mdi mdi-information-outline me-1 "></i>
                Configure Posting rules for <strong>Accounting year .</strong>

            </div>*@
    </div>
</div>





<!-- Modal for Create Accounting Year -->
<div class="modal fade" id="accountingYearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="accountingYearModalContent" class="p-3">
                @* Partial view (_Update) will be loaded here *@
            </div>
        </div>
    </div>
</div>

<div id="datalistingview">

</div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
$(document).ready(function () {

    // Load accounting years listing
    $.ajax({
        url: '@Url.Action("GetAll", "AccountingYear")',
        type: 'GET',
        success: function (partialViewResult) {
            $("#datalistingview").html(partialViewResult);

            // ✅ Add New Year
            $("#btnAddYear").on("click", function () {
                $.ajax({
                    url: '@Url.Action("New", "AccountingYear")',
                    type: 'GET',
                    beforeSend: function () {
                        $("#accountingYearModalContent").html(`
                            <div class="text-center my-4">
                                <div class="spinner-border text-success" role="status"></div>
                                <p class="mt-2">Loading form...</p>
                            </div>
                        `);
                    },
                    success: function (html) {
                        $("#accountingYearModal .modal-content").html(html);
                        const modalEl = document.getElementById('accountingYearModal');
                        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        bsModal.show();
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ Error loading form:", error);
                        appalert("Failed to load Add Accounting Year view: " + error, 1, 4);
                    }
                });
            });

            // ✅ Update Year
            $(".btn-update-year").on("click", function () {
                const id = $(this).data("id");
                if (!id) {
                    appalert("Invalid ID for update.", 3, 1);
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetDetails", "AccountingYear")',
                    type: 'GET',
                    data: { id: id },
                    beforeSend: function () {
                        $("#accountingYearModalContent").html(`
                           
                        `);
                        const modalEl = document.getElementById('accountingYearModal');
                        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        bsModal.show();
                    },
                    success: function (html) {
                        $("#accountingYearModalContent").html(html);
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ Error loading update form:", error);
                        appalert("Failed to load update view: " + error, 1, 4);
                    }
                });
            });
        },
        error: function (xhr, status, error) {
            appalert("Failed to load accounting years: " + error, 1, 4);
            console.error(error);
        }
    });

    // ✅ Save Accounting Year via Ajax (your existing logic)
    window.CreatAccountingYearSaveAjax = function (form) {
        if (!$(form).valid()) return false;

        const branchText = $('#BranchId option:selected').text();
        const yearText = $('#Year option:selected').text();
        const statusText = $('#Status option:selected').text();

        if (!$('#BranchId').val()) { appalert("Select a branch.", 3, 1); return false; }
        if (!$('#Year').val()) { appalert("Select an accounting year.", 3, 1); return false; }
        if (!$('#Status').val()) { appalert("Select a status.", 3, 1); return false; }

        const title = "Confirm Accounting Year Details";
        const message = `
            <p>Please review the details below before confirming:</p>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><th>Branch</th><td>${branchText}</td></tr>
                    <tr><th>Accounting Year</th><td>${yearText}</td></tr>
                    <tr><th>Status</th><td>${statusText}</td></tr>
                </tbody>
            </table>
            <div class="form-check mt-3">
                <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
                <label for="alertifyConfirmCheckbox" class="form-check-label">
                    I confirm that the above details are correct.
                </label>
            </div>
        `;

        alertify.confirm(title, message,
            function () {
                if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                    appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                    return false;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    beforeSend: function () {
                        $('.alertify .ajs-ok').prop('disabled', true)
                            .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                    },
                    success: function (response) {
                        if (response && response.success) {
                            appalert(response.message || "✅ Saved successfully!", 1, 1);
                            alertify.dismissAll();
                            if (String(response.reloadDataView).toLowerCase() === "yes") {
                                form.reset();
                                $('.select2').val(null).trigger('change');
                            }
                        } else {
                            appalert(response?.message || "❌ Failed to save accounting year.", 2, 1);
                        }
                    },
                    error: function (xhr) {
                        appalert("❌ Error: " + (xhr?.statusText || "Request failed"), 0, 1);
                    },
                    complete: function () {
                        $('.alertify .ajs-ok').prop('disabled', false).html('Yes, Continue');
                    }
                });
            },
            function () {
                appalert("🚫 Operation cancelled.", 2, 1);
            }
        ).set({
            labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
            onshow: function () {
                const okBtn = $('.alertify .ajs-ok');
                okBtn.prop('disabled', true);
                $('#alertifyConfirmCheckbox').off('change').on('change', function () {
                    okBtn.prop('disabled', !this.checked);
                });
            }
        });

        return false;
    };

});
    </script>
}
