@model CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.accountingyear
@using Resources
@{
    ViewBag.Title = "Accounting Year";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Accounting Year
        </h1>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseJournalTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseJournalTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><strong>Add Year:</strong> Opens modal with spinner before loading form.</li>
                <li><strong>Update Year:</strong> Click Update button in table row to open modal.</li>
                <li><strong>Validations:</strong> Branch, Year, and Status required.</li>
                <li><strong>Confirmation:</strong> Checkbox required before saving.</li>
                <li><strong>Form Submission:</strong> Uses FormData + anti-forgery token.</li>
                <li><strong>Auto Reset:</strong> Form and Select2 cleared after save.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Add Year Button -->
<div class="card mb-3">
    <div class="card-body d-flex justify-content-end align-items-center">
        <button type="button" id="btnAddYear" class="btn btn-success btn-sm px-2">
            <i class="mdi mdi-plus-circle-outline me-1"></i> Add New
        </button>
    </div>
</div>

<!-- Advance Filters -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <div class="card p-3 mb-2 bg-light">

            <!-- ✔️ TOGGLE BRANCH FILTER -->
            <div class="row mb-1">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>
            </div>

            <!-- ✔️ HIDDEN BRANCH FILTER -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>


            <!-- STATUS & YEAR -->
            <div class="row mb-1">
                <div class="col-md-6 mb-1">
                    <label class="form-label fw-bold">Status</label>
                    @Html.DropDownList("Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2 mb-1", @id = "Status" })
                </div>

                <div class="col-md-6 mb-1">
                    <label class="form-label fw-bold">Accounting Year</label>
                    @Html.DropDownList("Year",
                        new SelectList(ViewBag.YearB, "Value", "Text"),
                        "Select Year",
                        new { @class = "form-control select2 mb-1", @id = "year" })
                </div>
            </div>


            <!-- DATE RANGE -->
            <div class="row mb-1">
                <div class="col-md-6 mb-1">
                    <label class="form-label fw-bold" for="startDate">Start Date</label>
                    <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                </div>
                <div class="col-md-6 mb-1">
                    <label class="form-label fw-bold" for="endDate">End Date</label>
                    <input type="date" id="endDate" name="EndDate" class="form-control mb-1" />
                </div>
            </div>




            <!-- ACTION BUTTONS -->
            <div class="row g-2 mt-2">
                <div class="col-12 col-md-6">
                    <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="mdi mdi-magnify me-1"></i> Apply Filters
                    </button>
                </div>
                <div class="col-12 col-md-6">
                    <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                        <i class="mdi mdi-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>

        </div>



    </form>
</div>


<!-- Modal -->
<div class="modal fade" id="accountingYearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="accountingYearModalContent" class="p-3"></div>
        </div>
    </div>
</div>


<div id="datalistingview">
    @Html.Partial("_Datatable")
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    $(function () {
        const addUrl = '@Url.Action("New", "AccountingYear")';
        const updateUrl = '@Url.Action("GetDetails", "AccountingYear")';

        // ==========================
        // Load DataTable
        // ==========================
        function loadAccountingYearData() {
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                $('#myDataTable').DataTable().clear().destroy();
            }

            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: false,
                order: [[0, 'desc']],
                ajax: {
                    url: '/AccountingYear/LoadAccountingYearData',
                    type: 'POST',
                    data: function (d) {
                        return {
                            BranchId: $('#branchFilter').hasClass('d-none') ? null : $('#branchId').val(),
                            StartDate: $('#startDate').val(),
                            EndDate: $('#endDate').val(),
                            Status: $('#Status').val(),
                            Year: $('#year').val(),
                            Options: {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                skip: d.start,
                                pageSize: d.length,
                                searchValue: d.search?.value || '',
                                sortColumnName: d.columns[d.order[0].column].data,
                                sortColumnDirection: d.order[0].dir
                            }
                        };
                    },
                    error: function (xhr) {
                        console.error('❌ Load error:', xhr);
                        appalert('❌ Failed to load accounting year data. Status: ' + xhr.status, 4, 1);
                    }
                },
                columns: [
                    { data: 'StartDate', render: d => d ? moment(d).format('DD/MM/YYYY') : '' },
                    { data: 'EndDate', render: d => d ? moment(d).format('DD/MM/YYYY') : '' },
                    { data: 'BranchName' },
                    { data: 'Year' },
                    {
                        data: 'Status',
                        render: function (status) {
                            let badgeClass = 'badge bg-secondary';
                            switch ((status || '').toLowerCase()) {
                                case 'open': badgeClass = 'badge bg-success'; break;
                                case 'lock': badgeClass = 'badge bg-warning text-dark'; break;
                                case 'close': badgeClass = 'badge bg-danger'; break;
                            }
                            return `<span class="${badgeClass}">${status || ''}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: (_, __, row) => {
                            const status = (row.Status || "").toLowerCase();
                            const btnId = `actionDropdown${row.Id}`;
                            const disableStyle = "pointer-events:none; opacity:0.5;";

                            const startStr = row.StartDate ? moment(row.StartDate).format('YYYY-MM-DD') : '';
                            const endStr = row.EndDate ? moment(row.EndDate).format('YYYY-MM-DD') : '';

                            const buttons = [
                                {
                                    class: 'btn-update-year',
                                    text: 'Update',
                                    icon: 'mdi-pencil-outline',
                                    color: '#6f42c1',
                                    style: ''
                                },
                                {
                                    class: 'btn-lock-year',
                                    text: 'Lock',
                                    icon: 'mdi-lock-outline',
                                    color: '#fd7e14',
                                    style: status === 'lock' ? disableStyle : ''
                                },
                                {
                                    class: 'btn-open-year',
                                    text: 'Open',
                                    icon: 'mdi-lock-open-outline',
                                    color: '#198754',
                                    style: status === 'open' ? disableStyle : ''
                                },
                                {
                                    class: 'btn-close-year',
                                    text: 'Close',
                                    icon: 'mdi-close-circle-outline',
                                    color: '#dc3545',
                                    style: status === 'close' ? disableStyle : ''
                                }
                            ];

                            const dropdownItems = buttons.map(b => `
                                <li>
                                    <a class="dropdown-item ${b.class}"
                                       href="#"
                                       data-id="${row.Id}"
                                       data-branch="${row.BranchId}"
                                       data-branchname="${row.BranchName}"
                                       data-year="${row.Year}"
                                       data-status="${b.text.toUpperCase()}"
                                       data-start="${startStr}"
                                       data-end="${endStr}"
                                       style="color:${b.color}; font-weight:500; ${b.style}">
                                        <i class="mdi ${b.icon} me-1" style="color:${b.color};"></i>
                                        ${b.text}
                                    </a>
                                </li>
                            `).join('');

                            return `
                                <div class="dropdown text-center">
                                    <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                            type="button" id="${btnId}"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i> Actions
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                        ${dropdownItems}
                                    </ul>
                                </div>
                            `;
                        }
                    }
                ]
            });
        }


       


        // ==========================
        // Generic post function
        // ==========================
        function postAccountingYear(payload, $btn) {
            const $icon = $btn.find('i');
            const $text = $btn.find('.btn-text');

            $btn.prop('disabled', true);
            $icon.removeClass().addClass('mdi mdi-loading mdi-spin');

            $.ajax({
                url: '/AccountingYear/Action',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message || payload.status + ' successful!');
                        loadAccountingYearData();
                    } else {
                        toastr.error(response.message || payload.status + ' failed!');
                        $btn.prop('disabled', false);
                        $icon.removeClass().addClass('mdi mdi-cog-outline');
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("An error occurred: " + error);
                    $btn.prop('disabled', false);
                    $icon.removeClass().addClass('mdi mdi-cog-outline');
                }
            });
        }

        // ==========================
        // Handle LOCK / OPEN / CLOSE / UPDATE
        // ==========================
       function handleButtonClick(selector, statusText) {
    $(document).on("click", selector, function (e) {
        e.preventDefault();
        const $btn = $(this);

        const itemId     = $btn.data('id');
        const branchId   = $btn.data('branch');
        const branchText = $btn.data('branchname') || "";
        const year       = $btn.data('year');
        const status     = statusText;
        const startDate  = $btn.data('start');
        const endDate    = $btn.data('end');

        const openingDateText = startDate ? moment(startDate).format("DD/MM/YYYY") : "";
        const closingDateText = endDate ? moment(endDate).format("DD/MM/YYYY") : "";

        // Determine if this is a dangerous action
        const isDanger = status === "CLOSE"; // You can add 'LOCK' if needed

        const message = `
            <div style="${isDanger ? 'border:2px solid red; padding:10px; border-radius:5px;' : ''}">
                <p>Confirm details before continuing:</p>
                <table class="table table-sm table-bordered">
                    <tr><th>Branch</th><td>${branchText || branchId}</td></tr>
                    <tr><th>Year</th><td>${year}</td></tr>
                    <tr><th>Action</th><td>${status}</td></tr>
                    <tr><th>Start Date</th><td>${openingDateText}</td></tr>
                    <tr><th>End Date</th><td>${closingDateText}</td></tr>
                </table>
                <div class="form-check mt-3">
                    <input type="checkbox" id="alertifyConfirmCheckbox" class="form-check-input">
                    <label for="alertifyConfirmCheckbox" class="form-check-label">
                        I confirm the above details.
                    </label>
                </div>
            </div>
        `;

        alertify.confirm(
            isDanger ? "⚠️ DANGER: Confirm Accounting Year Action" : "Confirm Accounting Year",
            message,
            function () {
                if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                    appalert("Check the box to confirm.", 3, 1);
                    return false;
                }

                const payload = {
                    id: itemId,
                    branchId: branchId,
                    year: year,
                    status: status,
                    startDate: startDate,
                    endDate: endDate
                };

                postAccountingYear(payload, $btn);
            },
            function () {
                appalert("🚫 Operation cancelled.", 2, 1);
            }
        ).set({
            labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
            onshow: function () {
                const okBtn = $('.alertify .ajs-ok');
                okBtn.prop('disabled', true);
                $('#alertifyConfirmCheckbox').off('change').on('change', function () {
                    okBtn.prop('disabled', !this.checked);
                });
            }
        });
    });
}

        // Initialize action buttons
        handleButtonClick(".btn-lock-year", "LOCK");
        handleButtonClick(".btn-open-year", "OPEN");
        handleButtonClick(".btn-close-year", "CLOSE");

        // ==========================
        // Filter buttons
        // ==========================
        $('#applyFilterBtn').on('click', function (e) {
            e.preventDefault();
            loadAccountingYearData();
        });

        $('#resetFilterBtn').on('click', function (e) {
            e.preventDefault();
            $('#journalHeaderFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');
            $('#branchFilter').addClass('d-none');
            $('#toggleBranch').prop('checked', false);
            appalert('🧹 Filters reset.', 1, 1);
        });

        // ==========================
        // Add / Update Modals
        // ==========================
        $('#btnAddYear').on('click', function () {
            $.ajax({
                url: addUrl,
                type: 'GET',
                beforeSend: function () {
                    $("#accountingYearModalContent").html(`
                        <div class="text-center my-4">
                            <div class="spinner-border text-success"></div>
                            <p>Loading form...</p>
                        </div>`);
                },
                success: function (html) {
                    $("#accountingYearModal .modal-content").html(html);

                    // ✅ Initialize Select2 INSIDE the modal
                    $('#accountingYearModal .select2').select2({
                        dropdownParent: $('#accountingYearModal'),
                        width: '100%'
                    });

                    bootstrap.Modal
                        .getOrCreateInstance(document.getElementById('accountingYearModal'))
                        .show();
                },
                error: function (xhr, status, error) {
                    appalert("Failed to load Add view: " + error, 1, 4);
                }
            });
        });

        $(document).on('click', '.btn-update-year', function () {
            const id = $(this).data('id');
            if (!id) { appalert("Invalid ID for update.", 3, 1); return; }

            $.ajax({
                url: updateUrl,
                type: 'GET',
                data: { id: id },
                beforeSend: function () {
                    $("#accountingYearModalContent").html(`
                        <div class="text-center my-4">
                            <div class="spinner-border text-success"></div>
                            <p>Loading form...</p>
                        </div>`);
                },
                success: function (html) {
                    $("#accountingYearModal .modal-content").html(html);

                    // ✅ Initialize Select2 INSIDE the modal
                    $('#accountingYearModal .select2').select2({
                        dropdownParent: $('#accountingYearModal'),
                        width: '100%'
                    });

                    bootstrap.Modal
                        .getOrCreateInstance(document.getElementById('accountingYearModal'))
                        .show();
                },
                error: function (xhr, status, error) {
                    appalert("Failed to load Update view: " + error, 1, 4);
                }
            });
        });

        // Initial load
        //loadAccountingYearData();





        window.CreatAccountingYearSaveAjax = function (form) {
            const $form = $(form);
            if (!$form.valid()) return false;

            // ================================
            // Helper: Get selected text safely
            // ================================
            function getSelectText(selector) {
                const $el = $form.find(selector);
                if (!$el.length) return "---";

                if ($el.is('select')) {
                    return $el.find('option:selected').text() || "---";
                }
                return $el.val() || "---";
            }

            // ================================
            // Collect values for confirmation
            // ================================
            const fields = {
                "Branch": getSelectText('#BranchId'),
                "Accounting Year": getSelectText('#YearB'),
                "Status": getSelectText('#StatusB'),
                "Opening Date": $form.find('#openingDate').val() || "---",
                "Closing Date": $form.find('#closingDate').val() || "---"
            };

            // ================================
            // Build confirmation table
            // ================================
            let tableRows = '';
            for (const key in fields) {
                tableRows += `<tr><th>${key}</th><td>${fields[key]}</td></tr>`;
            }

            const title = $form.find('#Id').val()
                ? "Update Accounting Year"
                : "Create Accounting Year";

            const message = `
        <p>Please review the details before submitting:</p>
        <table class="table table-sm table-bordered">
            <tbody>${tableRows}</tbody>
        </table>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
            <label class="form-check-label" for="alertifyConfirmCheckbox">
                I confirm that the above details are correct.
            </label>
        </div>
    `;

            // ================================
            // Alertify confirmation
            // ================================
            alertify.confirm(title, message,
                function () {

                    if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                        appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                        return false;
                    }

                    const token = $form.find('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        type: 'POST',
                        url: $form.attr('action'),
                        data: new FormData($form[0]),
                        processData: false,
                        contentType: false,
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        beforeSend: function () {
                            $('.alertify .ajs-ok')
                                .prop('disabled', true)
                                .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                        },
                        success: function (response) {
                            if (response?.success) {
                                appalert(response.message || "✅ Accounting Year saved successfully!", 1, 1);
                                alertify.dismissAll();

                                if (String(response.reloadDataView).toLowerCase() === "yes") {
                                    $form[0].reset();
                                    $form.find('select').val('');
                                }
                            } else {
                                appalert(response?.message || "❌ Failed to save Accounting Year.", 2, 1);
                            }
                        },
                        error: function (xhr) {
                            appalert("❌ Error: " + (xhr?.statusText || "Request failed"), 0, 1);
                        },
                        complete: function () {
                            $('.alertify .ajs-ok')
                                .prop('disabled', false)
                                .html('Yes, Continue');
                        }
                    });
                },
                function () {
                    appalert("🚫 Operation cancelled.", 2, 1);
                }
            ).set({
                labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
                onshow: function () {
                    const okBtn = $('.alertify .ajs-ok');
                    okBtn.prop('disabled', true);

                    $('#alertifyConfirmCheckbox')
                        .off('change')
                        .on('change', function () {
                            okBtn.prop('disabled', !this.checked);
                        });
                }
            });

            return false;
        };

    });




    </script>
}

