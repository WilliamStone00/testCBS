@model CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.accountingyear

<style>
    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #198754;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .form-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background-color: #ffffff;
        padding: 20px;
        margin-bottom: 20px;
    }

    .btn-save {
        min-width: 120px;
    }
</style>

@using (Html.BeginForm("CreateOrUpdate", "AccountingYear", FormMethod.Post, new { id = "accountingyear", enctype = "multipart/form-data", onsubmit = "return CreatAccountingYearSaveAjax(this);" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "Id" })

    <div class="container mt-2">
        <div class="header-viewer">
            <h6>
                <i class="mdi mdi-cog-outline me-1"></i>
                @(Model.Id == null ? "Add Accounting Year" : "Update Accounting Year")
            </h6>
            <p class="mb-0">
                @(Model.Id == null
                    ? "Fill in the details to create a new accounting year."
                    : "Modify details below and update this accounting year.")
            </p>
        </div>

        <div class="form-card">
            <!-- Branch -->
            <div class="mb-3">
                @Html.LabelFor(m => m.BranchId, "Branch", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.BranchId,
                    new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name", Model.BranchId),
                    "--- Select Branch ---",
                    new { @class = "form-control select2", required = "required", id = "BranchId" }
                )
            </div>

            <!-- Accounting Year -->
            <div class="mb-3">
                @Html.LabelFor(m => m.YearB, "Accounting Year", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.YearB,
                    new SelectList(ViewBag.Year ?? new List<SelectListItem>(), "Value", "Text", Model.YearB),
                    "--- Select Accounting Year ---",
                    new { @class = "form-control select2", required = "required", id = "YearB" }
                )
            </div>

            <!-- Status -->
            <div class="mb-3">
                @Html.LabelFor(m => m.StatusB, "Status", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.StatusB,
                    new SelectList(ViewBag.Status ?? new List<SelectListItem>(), "Value", "Text", Model.StatusB),
                    "--- Select Status ---",
                    new { @class = "form-control select2", required = "required", id = "StatusB" }
                )
            </div>

            <!-- Dates Row -->
            <div class="row mb-3">
                <!-- Opening Date -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.StartDate, "Opening Date", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(
                         m => m.StartDate,
                          new
         {
        @class = "form-control",
        type = "datetime-local",
        id = "openingDate",
        value = Model.StartDate.HasValue
                ? Model.StartDate.Value.ToString("yyyy-MM-ddTHH:mm")
                : ""
    }
)
                </div>

                <!-- Closing Date -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.EndDate, "Closing Date", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(
                       m => m.EndDate,
                         new  {
                             @class = "form-control",
                             type = "datetime-local",
                             id = "closingDate",
                             value = Model.EndDate.HasValue
                                     ? Model.EndDate.Value.ToString("yyyy-MM-ddTHH:mm")
                                     : ""
                         }
                         )
                </div>
            </div>

            <!-- Save/Update -->
            <div class="text-end">
                <button type="button" class="btn btn-primary btn-save" onclick="CreatAccountingYearSaveAjax(this.form)">
                    <i class="mdi mdi-content-save-outline me-1"></i>
                    @(Model.Id == null ? "Save" : "Update")
                </button>
            </div>
        </div>
    </div>
}
