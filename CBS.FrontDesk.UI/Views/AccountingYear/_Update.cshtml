@model CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.accountingyear

@using (Html.BeginForm(
    "CreatAccountingYear",
    "AccountingYear",
    FormMethod.Post,
    new { id = "accountingyear", enctype = "multipart/form-data", onsubmit = "return CreatAccountingYearSaveAjax(this);" }
))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "id" })

    <style>
        .header-viewer {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 1rem;
            text-align: center;
            font-size: 0.95rem;
            color: #555;
            border-left: 4px solid #198754;
        }

            .header-viewer h6 {
                font-weight: 700;
                color: #198754;
                margin-bottom: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

        .form-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background-color: #ffffff;
            padding: 20px;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 500;
            color: #212529;
        }

        .form-control {
            background-color: #f8f9fa;
            border: 1px solid #ced4da;
            border-radius: 4px;
            padding: 8px 12px;
            font-size: 0.95rem;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #198754;
            }

        .btn-save {
            min-width: 120px;
        }
    </style>

    <div class="container mt-2">

        <div class="header-viewer">
            <h6><i class="mdi mdi-cog-outline me-1"></i> Add Accounting Year</h6>
            <p class="mb-0">Fill in the details to create a new accounting year.</p>
        </div>

        <div class="form-card">

            <!-- Branch -->
            <div class="mb-3">
                @Html.LabelFor(m => m.BranchId, "Branch", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.BranchId,
                    new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                    "--- Select Branch ---",
                    new { @class = "form-control select2", required = "required" }
                )
            </div>

            <!-- Accounting Year -->
            <div class="mb-3">
                @Html.LabelFor(m => m.Year, "Accounting Year", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.Year,
                    (IEnumerable<SelectListItem>)ViewBag.Year,
                    "--- Select Accounting Year ---",
                    new { @class = "form-control select2", required = "required" }
                )
            </div>

            <!-- Status -->
            <div class="mb-3">
                @Html.LabelFor(m => m.Status, "Status", new { @class = "form-label" })
                @Html.DropDownListFor(
                    m => m.Status,
                    (IEnumerable<SelectListItem>)ViewBag.Status,
                    "--- Select Status ---",
                    new { @class = "form-control select2", required = "required" }
                )
            </div>

            <!-- Save Button -->
            <div class="text-end">
                <button type="button" class="btn btn-primary btn-save" onclick="CreatAccountingYearSaveAjax(this.form)">
                    <i class="mdi mdi-content-save-outline me-1"></i> Save
                </button>
            </div>

        </div>
    </div>
}