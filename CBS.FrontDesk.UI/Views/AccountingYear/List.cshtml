@model CBS.FrontDesk.Data.Entity.AccountingV2.AccountingYear.CreateYear
@using Resources

@{
    ViewBag.Title = "Creation Of Accounting Year";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Creation Of Accounting Year
        </h1>
    </div>
</div>


<!-- Add Year Button -->
<div class="card mb-3">
    <div class="card-body d-flex justify-content-end align-items-center">
        <button type="button" id="btncreateYear" class="btn btn-success btn-sm px-2">
            <i class="mdi mdi-plus-circle-outline me-1"></i> Add New
        </button>
    </div>
</div>




<!-- Advance Filters -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <div class="card p-3 mb-2 bg-light">




            <!-- DATE RANGE -->
            <div class="row mb-1">
                <!-- Filter by ID -->
                <div class="col-md-4">
                    <label for="filterId" class="form-label fw-bold">Accounting Year ID</label>
                    <input type="text" id="filterId" class="form-control" placeholder="Search by ID">
                </div>

                <!-- Filter by Code -->
                <div class="col-md-4">
                    <label for="filterCode" class="form-label fw-bold">Year Code</label>
                    <input type="text" id="filterCode" class="form-control" placeholder="Search by Code">
                </div>
            </div>




            <!-- ACTION BUTTONS -->
            <div class="row g-2 mt-2">
                <div class="col-12 col-md-6">
                    <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="mdi mdi-magnify me-1"></i> Apply Filters
                    </button>
                </div>
                <div class="col-12 col-md-6">
                    <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                        <i class="mdi mdi-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>

        </div>



    </form>
</div>





<div class="modal fade" id="CreatYearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="CreatYearModalContent" class="p-3"></div>
        </div>
    </div>
</div>



<div id="datalistingview">
    @Html.Partial("_DataTableYear")
</div>













@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    $(function () {
        const addUrl = '@Url.Action("Create", "AccountingYear")';
        const updateUrl = '@Url.Action("GetyearDetails", "AccountingYear")';




        function loadYearData() {

            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                $('#myDataTable').DataTable().clear().destroy();
            }

            $('#myDataTable').DataTable({
                serverSide: true,
                responsive: true,
                searching: false, // disable built-in search
                order: [[0, 'desc']],
                ajax: {
                    url: '/AccountingYear/LoadYearData',
                    type: 'POST',
                    data: function (d) {
                        return {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                            Id: $('#filterId').val().trim(),
                            Code: $('#filterCode').val().trim(),
                            Options: {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                skip: d.start,
                                pageSize: d.length,
                                searchValue: d.search?.value || '',
                                sortColumnName: d.columns[d.order[0].column].data,
                                sortColumnDirection: d.order[0].dir
                            }
                        };
                    },
                    error: function (xhr) {
                        console.error('❌ Load error:', xhr);
                        appalert('❌ Failed to load accounting year data. Status: ' + xhr.status, 4, 1);
                    }
                },
                columns: [
                    { data: 'Id' },
                    { data: 'Code' },
                    { data: 'IsDeleted' },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
                <button class="btn btn-sm btn-primary btn-updates-year" data-id="${row.Id}">
                    <i class="mdi mdi-pencil-outline"></i> Edit
                </button>
            `;
                        }
                    }
                ]
            });
        }





        // APPLY FILTER
        $('#applyFilterBtn').on('click', function (e) {
            e.preventDefault();

            // Optional: Validate inputs here if needed

            loadYearData(); // Reload DataTable with current filters
        });

        // RESET FILTER
        $('#resetFilterBtn').on('click', function (e) {
            e.preventDefault();

            // Reset the form fields
            $('#journalHeaderFilterForm').trigger('reset');

            // Reset Select2 dropdowns
            $('.select2').val('').trigger('change');

            // Hide branch filter section if present


            // Feedback to user
            appalert('🧹 Filters reset.', 1, 1);

            // Reload DataTable with default (no filters)
            //loadAccountingYearData();
        });


        // ==========================
        // Add / Update Modals
        // ==========================
        $('#btncreateYear').on('click', function () {
            $.ajax({
                url: addUrl,
                type: 'GET',
                beforeSend: function () {
                    $("#CreatYearModalContent").html(`
                        <div class="text-center my-4">
                            <div class="spinner-border text-success"></div>
                            <p>Loading form...</p>
                        </div>`);
                },
                success: function (html) {
                    $("#CreatYearModal .modal-content").html(html);

                    // ✅ Initialize Select2 INSIDE the modal
                    $('#CreatYearModal .select2').select2({
                        dropdownParent: $('#CreatYearModal'),
                        width: '100%'
                    });

                    bootstrap.Modal
                        .getOrCreateInstance(document.getElementById('CreatYearModal'))
                        .show();
                },
                error: function (xhr, status, error) {
                    appalert("Failed to load Add view: " + error, 1, 4);
                }
            });
        });

        $(document).on('click', '.btn-updates-year', function () {
            const id = $(this).data('id');
            if (!id) { appalert("Invalid ID for update.", 3, 1); return; }

            $.ajax({
                url: updateUrl,
                type: 'GET',
                data: { id: id },
                beforeSend: function () {
                    $("#CreatYearModalContent").html(`
                        <div class="text-center my-4">
                            <div class="spinner-border text-success"></div>
                            <p>Loading form...</p>
                        </div>`);
                },
                success: function (html) {
                    $("#CreatYearModal .modal-content").html(html);

                    // ✅ Initialize Select2 INSIDE the modal
                    $('#CreatYearModal .select2').select2({
                        dropdownParent: $('#CreatYearModal'),
                        width: '100%'
                    });

                    bootstrap.Modal
                        .getOrCreateInstance(document.getElementById('CreatYearModal'))
                        .show();
                },
                error: function (xhr, status, error) {
                    appalert("Failed to load Update view: " + error, 1, 4);
                }
            });
        });




        window.CreatYearSaveAjax = function (form) {
            const $form = $(form);

            if (!$form.valid()) return false;

            // ================================
            // Helper: Safe value reader
            // ================================
            function getValue(selector) {
                const $el = $form.find(selector);
                return $el.length ? ($el.val() || "---") : "---";
            }

            // ================================
            // Collect values for confirmation
            // ================================
            const fields = {
                "Accounting Year ID": getValue('#Id'),
                "Year Code": getValue('#Code')
            };

            // ================================
            // Build confirmation table
            // ================================
            let tableRows = '';
            for (const key in fields) {
                tableRows += `<tr><th>${key}</th><td>${fields[key]}</td></tr>`;
            }

            const isUpdate = !!getValue('#Id') && getValue('#Id') !== "---";

            const title = isUpdate
                ? "Update Accounting Year"
                : "Create Accounting Year";

            const message = `
        <p>Please review the details before submitting:</p>
        <table class="table table-sm table-bordered">
            <tbody>${tableRows}</tbody>
        </table>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
            <label class="form-check-label" for="alertifyConfirmCheckbox">
                I confirm that the above details are correct.
            </label>
        </div>
    `;

            // ================================
            // Alertify confirmation
            // ================================
            alertify.confirm(title, message,
                function () {

                    if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                        appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                        return false;
                    }

                    const token = $form.find('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        type: 'POST',
                        url: $form.attr('action'),
                        data: new FormData($form[0]),
                        processData: false,
                        contentType: false,
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        beforeSend: function () {
                            $('.alertify .ajs-ok')
                                .prop('disabled', true)
                                .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                        },
                        success: function (response) {
                            if (response?.success) {
                                appalert(
                                    response.message || "✅ Accounting Year saved successfully!",
                                    1,
                                    1
                                );

                                alertify.dismissAll();

                                // Close modal
                                const modalEl = document.getElementById('CreatYearModal');
                                bootstrap.Modal.getInstance(modalEl)?.hide();

                                // Optional refresh
                                if (String(response.reloadDataView).toLowerCase() === "yes") {
                                    location.reload();
                                }
                            } else {
                                appalert(response?.message || "❌ Failed to save Accounting Year.", 2, 1);
                            }
                        },
                        error: function (xhr) {
                            appalert(
                                "❌ Error: " + (xhr?.responseText || xhr?.statusText || "Request failed"),
                                0,
                                1
                            );
                        },
                        complete: function () {
                            $('.alertify .ajs-ok')
                                .prop('disabled', false)
                                .html('Yes, Continue');
                        }
                    });
                },
                function () {
                    appalert("🚫 Operation cancelled.", 2, 1);
                }
            ).set({
                labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
                onshow: function () {
                    const okBtn = $('.alertify .ajs-ok');
                    okBtn.prop('disabled', true);

                    $('#alertifyConfirmCheckbox')
                        .off('change')
                        .on('change', function () {
                            okBtn.prop('disabled', !this.checked);
                        });
                }
            });

            return false;
        };




    });




    </script>
}