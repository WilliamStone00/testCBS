@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalShared.branch_members</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>R.Date</th>
                    <th>@GlobalShared.Name</th>
                    <th>M.Acc.Num</th>
                    <th>@GlobalShared.Telephone</th>
                    <th>@GlobalShared.Members_Profile</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>