@model CBS.FrontDesk.Data.Entity.MemberAdjustmentConsole.MemberAdjustmentModel
    @using Resources
@using (Html.BeginForm("MemberAdjustmentRequest", "MemberAdjustmentConsole", FormMethod.Post, new { id = "memberNameAdjustmentForm", onsubmit = "return postMemberAdjustmentRequest(this);" }))
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <!-- Current Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-primary">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-account-circle-outline me-2"></i>@GlobalMemberAdjustmentConsole.current_member_information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.OldFirstName, $"{@GlobalShared.current_first_name}", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.OldFirstName, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.OldLastName, $"{@GlobalShared.current_last_name}", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.OldLastName, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- New Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-warning">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-pencil-outline me-2"></i>@GlobalMemberAdjustmentConsole.new_member_information
                        </h5>
                    </div>
                    <div class="card-body">
                        <form id="memberNameAdjustmentForm">
                            @Html.HiddenFor(m => m.MemberId)
                            @Html.HiddenFor(m => m.BranchId)
                            @Html.HiddenFor(m => m.OldFirstName)
                            @Html.HiddenFor(m => m.OldLastName)
                            @Html.HiddenFor(m => m.IsMemberProfileModified)
                            @Html.HiddenFor(m => m.IsMemberAccountModified)
                            @Html.HiddenFor(m => m.AdjustmentType)

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    @Html.LabelFor(m => m.NewFirstName, "New First Name", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.NewFirstName, new { @class = "form-control", required = "required", placeholder = @GlobalShared.enter_new_first_name })
                                    <div class="invalid-feedback">@GlobalMemberAdjustmentConsole.please_enter_a_new_first_name</div>
                                    @Html.ValidationMessageFor(m => m.NewFirstName, "", new { @class = "text-danger small" })
                                </div>
                            </div> 
                            
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    @Html.LabelFor(m => m.NewLastName, "New Last Name", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.NewLastName,new { @class = "form-control", required = "required", placeholder = @GlobalShared.enter_new_last_name })
                                    <div class="invalid-feedback">@GlobalMemberAdjustmentConsole.please_enter_a_new_last_name</div>
                                    @Html.ValidationMessageFor(m => m.NewLastName, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    @Html.LabelFor(m => m.Reason, "Reason for Name Change", new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "3", required = "required", placeholder = @GlobalMemberAdjustmentConsole.please_provide_a_reason_for_this_name_change })
                                    <div class="invalid-feedback">@GlobalShared.please_provide_a_reason</div>
                                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            <i class="mdi mdi-close me-1"></i>@GlobalShared.Cancel
                                        </button>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-content-save-check me-1"></i>@GlobalShared.submit_name_change
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
