@model CBS.FrontDesk.Data.Entity.MemberAdjustmentConsole.MemberAdjustmentModel
@using (Html.BeginForm("MemberAdjustmentRequest", "MemberAdjustmentConsole", FormMethod.Post, new { id = "memberStatusAdjustmentForm", onsubmit = "return postMemberAdjustmentRequest(this);" }))
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <!-- Current Status Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-primary">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-account-check-outline me-2"></i>Current Member Status Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Current Member ID -->
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.MemberId, "Current Member ID", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.MemberId, new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Old Status -->
                            <div class="col-md-6 mb-3">
                                @Html.Label("OldStatus", "Old Status", new { @class = "form-label" })
                                <input type="text" class="form-control"
                                       value="@(Model.OldStatus ? "Active" : "Inactive")" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- New Status Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-warning">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-pencil-outline me-2"></i>New Member Status Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <form id="memberStatusAdjustmentForm">
                            @Html.HiddenFor(m => m.MemberId)
                            @Html.HiddenFor(m => m.BranchId)
                            @Html.HiddenFor(m => m.AccountId)
                            @Html.HiddenFor(m => m.OldStatus)

                            <div class="row">
                                <!-- New Status -->
                                <div class="col-md-6 mb-3">
                                    @Html.LabelFor(m => m.NewStatus, "New Status (Active / Inactive)", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.NewStatus,
             new List<SelectListItem>
             {
                                            new SelectListItem { Text = "Active", Value = "true" },
                                            new SelectListItem { Text = "Inactive", Value = "false" }
             },
             new { @class = "form-select", required = "required" })
                                    <div class="invalid-feedback">Please select a new status</div>
                                    @Html.ValidationMessageFor(m => m.NewStatus, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Reason -->
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    @Html.LabelFor(m => m.Reason, "Reason for Status Change", new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Reason,
             new { @class = "form-control", rows = "3", required = "required", placeholder = "Please provide a reason for this status change" })
                                    <div class="invalid-feedback">Please provide a reason</div>
                                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            <i class="mdi mdi-close me-1"></i>Cancel
                                        </button>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-content-save-check me-1"></i>Submit Status Change
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}