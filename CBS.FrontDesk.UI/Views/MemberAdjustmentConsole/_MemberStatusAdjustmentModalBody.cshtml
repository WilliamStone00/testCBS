@model CBS.FrontDesk.Data.Entity.MemberAdjustmentConsole.MemberAdjustmentModel
    @using Resources
@using (Html.BeginForm("MemberAdjustmentRequest", "MemberAdjustmentConsole", FormMethod.Post, new { id = "memberStatusAdjustmentForm", onsubmit = "return postMemberAdjustmentRequest(this);" }))
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <!-- Current Status Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-primary">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-account-check-outline me-2"></i>@GlobalMemberAdjustmentConsole.current_member_status_information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Current Member ID -->
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.MemberId, $"{@GlobalShared.current_member_id}", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.MemberId, new { @class = "form-control", @readonly = "readonly" })
                            </div>

                            <!-- Old Status -->
                            <div class="col-md-6 mb-3">
                                @Html.Label("OldStatus", "Old Status", new { @class = "form-label" })
                                <input type="text" class="form-control"
                                       value="@(Model.OldStatus ? "Active" : "Inactive")" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- New Status Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-light-warning">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-pencil-outline me-2"></i>@GlobalMemberAdjustmentConsole.new_member_status_information
                        </h5>
                    </div>
                    <div class="card-body">
                        <form id="memberStatusAdjustmentForm">
                            @Html.HiddenFor(m => m.MemberId)
                            @Html.HiddenFor(m => m.BranchId)
                            @Html.HiddenFor(m => m.IsMemberProfileModified)
                            @Html.HiddenFor(m => m.IsMemberAccountModified)
                            @Html.HiddenFor(m => m.AdjustmentType)
                            @Html.HiddenFor(m => m.AccountId)
                            @Html.HiddenFor(m => m.OldStatus)

                            <div class="row">
                                <!-- New Status -->
                                <div class="col-md-6 mb-3">
                                    @Html.LabelFor(m => m.NewStatus, $"{@GlobalShared.new_status} ({@GlobalShared.Active} / {@GlobalShared.InActive})", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.NewStatus,
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Active", Value = "true" },
                                            new SelectListItem { Text = "Inactive", Value = "false" }
                                        },
                                       new { @class = "form-select", required = "required" })
                                    <div class="invalid-feedback">@GlobalShared.please_select_a_new_status</div>
                                    @Html.ValidationMessageFor(m => m.NewStatus, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Reason -->
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    @Html.LabelFor(m => m.Reason, $"{@GlobalMemberAdjustmentConsole.reason_for_status_change}", new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Reason,
                                    new { 
                                        @class = "form-control", rows = "3", required = "required", placeholder = @GlobalMemberAdjustmentConsole.please_provide_a_reason_for_this_status_change })
                                    <div class="invalid-feedback">@GlobalShared.please_provide_a_reason</div>
                                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            <i class="mdi mdi-close me-1"></i>@GlobalShared.Cancel
                                        </button>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-content-save-check me-1"></i>@GlobalMemberAdjustmentConsole.submit_status_change
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}