@{
    ViewBag.Title = "Member Adjustment Console";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-tune-variant me-2"></i> Member Adjustment Console
                </h1>
                <p class="card-text text-muted mb-1">
                    Review, approve, and track member adjustment requests across branches.
                </p>
                <p class="card-text text-warning fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                    Use filters to narrow down pending or processed requests.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 💡 Tips Section -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-info">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips for Using the Adjustment Console</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>Member ID or Customer ID:</strong> Filter specific requests quickly.</li>
                <li><i class="mdi mdi-bank-outline text-success me-2"></i> <strong>Branch Filter:</strong> View requests from specific branches.</li>
                <li><i class="mdi mdi-calendar-range-outline text-warning me-2"></i> <strong>Date Range:</strong> Narrow down requests by request date.</li>
                <li><i class="mdi mdi-account-check-outline text-info me-2"></i> <strong>Requested / Approved By:</strong> Track who initiated or approved changes.</li>
                <li><i class="mdi mdi-file-check-outline text-danger me-2"></i> <strong>Status:</strong> Easily separate pending, approved, or rejected entries.</li>
                <li><i class="mdi mdi-export-variant text-success me-2"></i> <strong>Export:</strong> Use the export button to download your current view.</li>
            </ul>
        </div>
    </div>
</div>

<!-- 🔍 Filter Panel -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i> Adjustment Request Filters</h5>

    <div class="card p-3 mb-2 bg-light">
        <!-- Toggle Checkboxes -->
        <div class="row mb-1">
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleBranch" />
                <label class="form-check-label fw-bold" for="toggleBranch">Filter by Branch</label>
            </div>
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleDate" />
                <label class="form-check-label fw-bold" for="toggleDate">Filter by Date Range</label>
            </div>
        </div>

        <!-- Branch Filter -->
        <div id="branchFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-12 mb-1">
                <label for="branchId" class="form-label fw-bold">Branch</label>
                @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-select select2", @id = "branchId" })
            </div>
        </div>

        <!-- Date Range Filter -->
        <div id="dateFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-6 mb-1">
                <label for="startDate" class="form-label fw-bold">Start Date</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="endDate" class="form-label fw-bold">End Date</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>

        <!-- Other Filters -->

        <div class="row mb-1">
            <div class="col-md-4 mb-1">
                <label for="customerId" class="form-label fw-bold">Customer ID</label>
                <input type="text" id="customerId" class="form-control" placeholder="Enter member account number/refernce" />
            </div>
            <div class="col-md-4 mb-1">
                <label for="status" class="form-label fw-bold">Status</label>
                <select id="status" class="form-select">
                    <option value="">All</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>

        </div>
        <div class="row mb-1">
            <div class="col-md-6 mb-1">
                <label for="requestedBy" class="form-label fw-bold">Requested By</label>
                <input type="text" id="requestedBy" class="form-control" placeholder="Requested By" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="approvedBy" class="form-label fw-bold">Approved By</label>
                <input type="text" id="approvedBy" class="form-control" placeholder="Approved By" />
            </div>
        </div>

    </div>

    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> Apply Filter
            </button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100">
                <i class="mdi mdi-refresh"></i> Reset
            </button>
        </div>
    </div>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_MemberAdjustmentData")
</div>


<div class="modal fade" id="memberAdjustmentModal" tabindex="-1" aria-labelledby="memberAdjustmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="memberAdjustmentLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">Processing, please wait...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary" id="memberAdjustmentModalTitle">
                                <i class="mdi mdi-file-document-edit-outline me-2"></i> member Adjustment Details
                            </h1>
                            <p class="card-text" id="memberAdjustmentModalDescription">
                                View original and new member values, and approval history.
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collapsible Tips -->
            <div class="card mx-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> When to Use This</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdjustmentTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseAdjustmentTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-cash-edit text-primary me-2"></i><strong>Waivers:</strong> Use for interest, VAT, penalty waivers.</li>
                            <li><i class="mdi mdi-pencil-box-outline text-success me-2"></i><strong>Corrections:</strong> Use for fixing calculation or data errors.</li>
                            <li><i class="mdi mdi-close-box-outline text-danger me-2"></i><strong>Exclusions:</strong> Not for rescheduling or refinancing.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-0" style="max-height: 70vh; overflow-y: auto;">
                <div class="px-3" id="memberAdjustmentDetailsContainer">


                </div>
            </div>
            <!-- Modal Footer -->
            <div class="modal-footer justify-content-between">

                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Close
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>




@section Scripts {
    <script src="~/Scripts/Js/Crud/CustomerAdjustment/Customer/MemberAdjustmentConsole.js"></script>

}
