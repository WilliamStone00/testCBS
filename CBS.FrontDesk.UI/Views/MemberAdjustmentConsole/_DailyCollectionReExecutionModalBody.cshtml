@using Resources

@model CBS.FrontDesk.Data.Entity.MemberAdjustmentConsole.MemberAdjustmentModel

<!-- Modal Header (standard close only) -->
<div class="modal-header">
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

@using (Html.BeginForm("MemberAdjustmentRequest", "MemberAdjustmentConsole", FormMethod.Post, new { id = "reexecuteDailySavingForm" }))
{
    <div class="modal-body">

        @Html.HiddenFor(m => m.AdjustmentType)
        <!-- ================= FORM FIELDS ================= -->

        <div class="mb-3">
            @Html.LabelFor(m => m.BranchId, @GlobalShared.Branch, htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(
                  m => m.BranchId,
                  new SelectList(ViewBag.Branches, "Id", "Name"),
                  "---" + GlobalShared.SelectBranch + "---",
                  new { @class = "form-select select2" }
              )
        </div>
        <!-- File ID -->
        <div class="mb-3">
            @Html.LabelFor(m => m.DailySavingReExecutionFileId, $"{@GlobalMemberAdjustmentConsole.daily_saving_reexecution_fileid}", htmlAttributes: new { @class = "form -label fw-bold" })
            @Html.TextBoxFor(m => m.DailySavingReExecutionFileId, new { @class = "form-control", placeholder = $"{@GlobalMemberAdjustmentConsole.enter_re_execution_file_id}", required = "required" })
        </div>

        <!-- Number of Daily Savers -->
        <div class="mb-3">
            @Html.LabelFor(m => m.TotalDailySavers, $"{@GlobalShared.total_daily_savers}", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.TotalDailySavers, new { @class = "form-control", type = "number", min = "1", placeholder = $"{@GlobalMemberAdjustmentConsole.enter_number_of_affected_savers}", required = "required" })
        </div>

        <!-- Reason -->
        <div class="mb-3">
            @Html.LabelFor(m => m.Reason, htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.TextAreaFor(m => m.Reason, 3, 50, new { @class = "form-control", placeholder = $"{@GlobalMemberAdjustmentConsole.provide_a_clear_and_detailed_reason}", required = "required" })
        </div>

    </div>

    <!-- ================= FOOTER ================= -->
    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            @GlobalShared.Cancel
        </button>

        <button type="submit" id="btnReexecuteSubmit"
                class="btn btn-success">
            <i class="mdi mdi-check-circle-outline me-1"></i>
            @GlobalShared.re_execute
        </button>
    </div>
}
