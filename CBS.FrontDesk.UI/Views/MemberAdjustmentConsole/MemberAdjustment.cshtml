<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_IndividualData")
</div>

<!-- Member Name / Profile Adjustment Modal -->
<div class="modal fade" id="memberAdjustmentModal" tabindex="-1" aria-labelledby="memberAdjustmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="memberAdjustmentLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">Applying adjustments, please wait...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary" id="memberAdjustmentModalTitle">
                                <i class="mdi mdi-account-edit-outline me-2"></i> Member Profile Adjustment
                            </h1>
                            <p class="card-text lead" id="memberAdjustmentModalDescription">
                                Review and confirm changes to member details, account status, and category updates.
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> When to Use This</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdjustmentTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseAdjustmentTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-pencil-box-outline text-success me-2"></i><strong>Profile Updates:</strong> Use for correcting member names, IDs, or categories.</li>
                            <li><i class="mdi mdi-cash-check text-primary me-2"></i><strong>Account Adjustments:</strong> Update balance, membership status, or account activity.</li>
                            <li><i class="mdi mdi-close-box-outline text-danger me-2"></i><strong>Exclusions:</strong> Not intended for loan modifications or financial rescheduling.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                <div id="memberNameAdjustmentsContainer" class="details-grid">
                    <div class="loading-container text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading member adjustment details...</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between">
                <div class="d-flex flex-row gap-4 flex-wrap">
                    <span class="text-muted fw-semibold">
                        Member Reference: <span class="text-dark" id="memberReference">N/A</span>
                    </span>
                    <span class="text-muted fw-semibold">
                        Member Name: <span class="text-dark" id="memberName">N/A</span>
                    </span>
                    <span class="text-muted fw-semibold">
                        Branch: <span class="text-dark" id="branchName">N/A</span>
                    </span>
                </div>

                <div class="text-center w-100">
                    <small class="text-muted">Powered by FLX-CBS</small>
                </div>

                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Close
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // ==============================
        // Collect Filters
        // ==============================
        function collectMemberExportParams() {
            return {
                CustomerId: $('#customerId').val(),
                FirstName: $('#firstName').val(),
                LastName: $('#lastName').val(),
                BranchId: $('#mainBranchId').val(),
                Gender: $('#gender').val(),
                MaritalStatus: $('#maritalStatus').val(),
                WorkingStatus: $('#workingStatus').val(),
                MembershipApprovalStatus: $('#membershipApprovalStatus').val(),
                LegalForm: $('#legalForm').val(),
                CustomerType: $('#customerType').val(),
                AgeCategoryStatus: $('#ageCategoryStatus').val(),
                DateOfBirthFrom: $('#dobFrom').val(),
                DateOfBirthTo: $('#dobTo').val(),
                CreatedFrom: $('#createdFrom').val(),
                CreatedTo: $('#createdTo').val(),
                ShowAll: false,
                options: {}
            };
        }

        // ==============================
        // DataTable Loader
        // ==============================
        function loadMemberData() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                searching: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/MemberAdjustmentConsole/LoadMembersData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectMemberExportParams();

                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column]?.data || 'CreateDate',
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    }
                },
                columns: [
                    {
                        data: 'CreateDate',
                        name: 'CreateDate',
                        render: function (data) {
                            if (!data) return '';
                            if (typeof moment !== 'undefined') {
                                return moment(data).format('DD/MM/YYYY HH:mm:ss');
                            }
                            const dt = new Date(data);
                            return isNaN(dt.getTime()) ? '' : dt.toLocaleString();
                        }
                    },
                    { data: 'FullName', name: 'FullName' },
                    { data: 'CustomerId', name: 'CustomerId' },
                    { data: 'Phone', name: 'Phone' },
                    {
                        data: 'CustomerType',
                        name: 'CustomerType',
                        render: function (data, type, row) {
                            const label = data || '';
                            const isApproved = row.MembershipApprovalStatus === 'Approved';
                            const badgeClass = isApproved ? 'bg-primary' : 'bg-warning text-dark';
                            return `<span class="badge ${badgeClass}">${label}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
                                                                <div class="text-center dropdown">
                                                                    <button class="btn btn-sm btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                                        <i class="mdi mdi-eye"></i> Action
                                                                    </button>
                                                                    <ul class="dropdown-menu">

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="window.open('/Individual/CustomerProfile?KEY=${row.CustomerId}', '_blank')">
                                                                                <i class="mdi mdi-account-circle-outline me-2 text-primary"></i> Profile
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberNamesDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-rename-box me-2 text-warning"></i> Initiate Member Name Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberStatusDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-toggle-switch me-2 text-danger"></i> Activate Or Deactivate Member Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberActiveStatusDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-account-check-outline me-2 text-success"></i> Initiate Member Active Status Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberMembershipStatusDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-card-account-details-outline me-2 text-info"></i> Initiate Membership Status Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberReferenceDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-identifier me-2 text-secondary"></i> Member Reference Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberCategoryDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-account-group-outline me-2 text-primary"></i> Member Category Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberAccountBalanceDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-cash-multiple me-2 text-success"></i> Member Account Balance Adjustment
                                                                            </button>
                                                                        </li>

                                                                        <li>
                                                                            <button class="dropdown-item text-dark"
                                                                                    onclick="openMemberAdjustmentModal('/MemberAdjustmentConsole/GetMemberBlockAmountDetailPartial?id=${row.CustomerId}','N/A','${row.CustomerId}','${row.FullName}','${row.BranchName}')">
                                                                                <i class="mdi mdi-lock-outline me-2 text-danger"></i> Block Amount Adjustment
                                                                            </button>
                                                                        </li>


                                                                    </ul>
                                                                </div>`;
                        }
                    }
                ]
            });
        }

        // ==============================
        // Modal Loader
        // ==============================
        function openMemberAdjustmentModal(url, memberAdjustmentReference, memberRef, memberName, branchName) {
            $('#memberAdjustmentLoader').removeClass('d-none');

            $.get(url)
                .done(function (html) {
                    var modalEl = document.getElementById('memberAdjustmentModal');
                    var modal = new bootstrap.Modal(modalEl);
                    var contentDiv = document.getElementById('memberNameAdjustmentsContainer');

                    document.getElementById("memberReference").textContent = memberRef || "N/A";
                    document.getElementById("memberName").textContent = memberName || "N/A";
                    document.getElementById("branchName").textContent = branchName || "N/A";

                    contentDiv.innerHTML = html;
                    const $sel = $('#branchId');
                    // ===================== Initialize Select2 =====================
                    if ($.fn.select2 && $sel.hasClass('select2')) $sel.trigger('change.select2');

                    modal.show();
                })
                .fail(function (_, __, error) {
                    console.error('Error loading partial:', error);
                    if (typeof appAlertError !== 'undefined') appAlertError("Failed to load member details. Please try again.");
                })
                .always(function () {
                    $('#memberAdjustmentLoader').addClass('d-none');
                });
        }

        // ==============================
        // Reset Filters
        // ==============================
        function resetMemberFilters() {
            $('#memberFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');

            $('#branchFilter, #demographicFilters, #approvalFilters, #dateFilters').addClass('d-none');
            $('#toggleBranch, #toggleDemographics, #toggleApproval, #toggleDates').prop('checked', false);

            loadMemberData();
        }

        // ==============================
        // Init
        // ==============================
        $(document).ready(function () {
            // loadMemberData(); // enable if you want auto-load

            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                loadMemberData();
            });

            $('#resetFilterBtn').on('click', function (e) {
                e.preventDefault();
                resetMemberFilters();
            });

            $('#exportBtn').on('click', function (e) {
                e.preventDefault();
                exportMemberData();
            });
        });

        // ==============================
        // Export (optional)
        // ==============================
        function exportMemberData() {
            const filters = collectMemberExportParams();
            const params = new URLSearchParams();

            for (const key in filters) {
                if (typeof filters[key] === 'object') {
                    for (const subKey in filters[key]) {
                        params.append(`${key}.${subKey}`, filters[key][subKey]);
                    }
                } else {
                    params.append(key, filters[key] ?? '');
                }
            }

            window.location.href = `/Individual/DownloadMembers?${params.toString()}`;
        }

        // ==============================
        // If you use onsubmit in partials:
        // postMemberAdjustmentRequest(form) remains as-is in your codebase.
        // ==============================
    </script>

