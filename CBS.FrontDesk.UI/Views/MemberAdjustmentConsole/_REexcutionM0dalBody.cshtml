<!-- Modal Header (standard close only) -->
<div class="modal-header">
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="reexecuteDailySavingForm">
    <div class="modal-body">

        <!-- ================= HEADER CARD ================= -->
        <div class="card bg-light mb-3">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">
                    <i class="mdi mdi-refresh me-2"></i>
                    RE-EXECUTE DAILY SAVING
                </h3>
                <p class="card-text">
                    Use this form to re-execute daily saving processing for affected members.
                    Please verify the details carefully before submitting.
                </p>
                <hr style="border: 2px solid rgba(128,128,128,0.5);" />
            </div>
        </div>

        <!-- ================= FORM FIELDS ================= -->
        <!-- File ID -->
        <div class="mb-3">
            <label class="form-label fw-bold">
                File ID
            </label>
            <input type="text"
                   id="DailySavingReExecutionFileId"
                   class="form-control"
                   placeholder="Enter re-execution file ID"
                   required />
        </div>

        <!-- Number of Daily Savers -->
        <div class="mb-3">
            <label class="form-label fw-bold">
               Total Number of Daily Savers
            </label>
            <input type="number"
                   id="TotalDailySavers"
                   class="form-control"
                   min="1"
                   placeholder="Enter number of affected savers"
                   required />
        </div>

        <!-- Reason -->
        <div class="mb-3">
            <label class="form-label fw-bold">
                Reason for Re-execution
            </label>
            <textarea id="Reason"
                      class="form-control"
                      rows="3"
                      required
                      placeholder="Provide a clear and detailed reason"></textarea>
        </div>

    </div>

    <!-- ================= FOOTER ================= -->
    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-success">
            <i class="mdi mdi-check-circle-outline me-1"></i>
            Re-execute
        </button>
    </div>
</form>
