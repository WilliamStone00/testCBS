                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.ToBranchFloatAccountNumberHeadOffice_B, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.ToBranchFloatAccountNumber</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.SpecifyTheLedgerAccountToWhichHeadOfficeFundsWillBeCreditedForTheFloatTransfer."></i>
