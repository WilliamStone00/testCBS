@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
    @using Resources
<div class="col">






    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @Model.Teller.name.ToUpper() @GlobalTellerManagement.FloatAccountProfile
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalTellerManagement.MobileMoneyFloatAccountProfileThisSectionAllowsYouToComfigure.
            <strong>@GlobalTellerManagement.Instructions:</strong>
            1. <strong>@GlobalTellerManagement.TellerCode:</strong> @GlobalTellerManagement.EnterAUniqueCodeForTheTellerManagingThisAccount.
            2. <strong>@GlobalTellerManagement.TellerName:</strong> @GlobalTellerManagement.ProvideTheFullMameOfTheTeller.
            3. <strong>@GlobalTellerManagement.SetAsPrimaryTeller:</strong> @GlobalTellerManagement.CheckThisOptionIfThisTellerIsThePrimaryContactForTheAccount.
            4. <strong>@GlobalTellerManagement.AccountNumber:</strong> @GlobalTellerManagement.InputTheAccountNumberAssociatedWithTheMobileMoneyFloat.
            5. <strong>@GlobalTellerManagement.HolderOfThePhone:</strong> @GlobalTellerManagement.SpecifyTheNameOfThePersonResponsibleForTheMobileMoneyPhone.
            6. <strong>@GlobalTellerManagement.FloatNumber:</strong> @GlobalTellerManagement.EnterTheFloatNumberForTransactionProcessing."></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "TellerManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <input type="hidden" name="ServiceOption" value="primary_teller" id="ServiceOption" />
                            <fieldset class="fieldset-custom">
                                <legend><strong>@GlobalTellerManagement.Profile</strong></legend>
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-2">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Teller.code, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Teller.code, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.TellerCode</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterAUniqueCodeForTheTellerManagingThisAccount."></i>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Teller.name, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Teller.name, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.TellerName</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.ProvideTheFullMameOfTheTeller."></i>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.Teller.activeStatus, new { @class = "form-check-input", id = "isPrimary", disabled = "disabled" })
                                            <label class="form-check-label" for="isPrimary">@GlobalTellerManagement.ActiveStatus</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.CheckThisOptionIfTheTellerIsCurrentlyActive."></i>
                                        </div>
                                        <span id="activeStatusBadge" class="badge @((Model.Teller.activeStatus ? "bg-success" : "bg-danger")) mt-2">
                                            @((Model.Teller.activeStatus ? "Till is Active" : "In-active"))
                                        </span>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.MobileMoneyTellerConfiguration.AccountNumber, new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"), "---"+ GlobalShared.Select+"---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.AccountNumber, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.FloatLedgerAccountNumber</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.SpecifyTheAccountAssociatedWith @Model.Teller.name @GlobalTellerManagement.formManagingFloat."></i>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyUserKeepingThePhone, new SelectList(ViewBag.Users, "Text", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyUserKeepingThePhone, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.SelectDesignatedUserOfThePhone</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.SpecifyTheNameOfThePersonResponsibleForTheFloatOp."></i>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyFloatNumber, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyFloatNumber, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.FloatPhoneNumber</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterTheFloatNumberForTransactionProcessing."></i>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.MobileMoneyTellerConfiguration.MapMobileMoneyToNoneMemberMobileMoneyReference, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MapMobileMoneyToNoneMemberMobileMoneyReference, "", new { @class = "text-danger" })
                                            <label>@GlobalTellerManagement.EnterThe16DigitAccountNumberDesignated @Model.Teller.TellerType @GlobalTellerManagement.transactionsForNonMembers.</label>
                                            <i class="mdi mdi-help-circle text-muted ms-1"
                                               data-bs-toggle="tooltip"
                                               title="@GlobalTellerManagement.ProvideThe16DigitAccountNumberThatServesAsReference  @Model.Teller.TellerType @GlobalTellerManagement.transactions."></i>
                                        </div>
                                    </div>


                                </div>
                            </fieldset>
                            <div class="mt-4">
                                @if (Model.Teller.id == null)
                                {
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                }
                                else
                                            {
                            <button type="submit" class="btn btn-primary me-2">@GlobalTellerManagement.UpdateFloatProfile</button>
                                    @Html.HiddenFor(m => m.MobileMoneyTellerConfiguration.Id)
                                    <input type="hidden" name="Action" value="float_number_profile" id="Action" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>





            ,
            @if (Model.Teller.TellerType == "MomocashCollectionMTN" || Model.Teller.TellerType == "MomocashCollectionOrange")
