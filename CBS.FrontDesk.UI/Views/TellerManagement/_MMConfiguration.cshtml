                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.PhoneNumberToRecieveAlert, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.PhoneNumbersToReceiveAlert</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterThePhoneNumbersWhereAlertsWillBeSent"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyAlertMessageInEnglish, new { @class = "form-control", placeholder = @GlobalTellerManagement.EnterEnglishAlertMessage, @style = "height: 74px;" })
                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyAlertMessageInEnglish, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.AlertMessageEnglish</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterTheMessageContentForEnglishAlerts."></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyAlertMessageInFrench, new { @class = "form-control", placeholder = @GlobalTellerManagement.EnterFrenchAlertMessage, @style = "height: 74px;" })
                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyAlertMessageInFrench, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.AlertMessageFrench</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterTheMessageContentForFrenchAlerts."></i>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                                <div class="mt-4">
                                    @if (Model.Teller.id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    {
                                <button type="submit" class="btn btn-primary me-2">@GlobalTellerManagement.UpdateMonitoringAlertProfile</button>
                                        @Html.HiddenFor(m => m.MobileMoneyTellerConfiguration.Id)
                                        <input type="hidden" name="Action" value="sms_alert_profile" id="Action" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            }

        </div>

    </div>

</div>

