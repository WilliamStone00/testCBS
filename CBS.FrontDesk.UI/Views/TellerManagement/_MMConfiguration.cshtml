                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyMinimumBalanceAlertLevel, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.MinimumBalanceForAlert</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="EnterTheMinimumBalanceLevelAtWhichAlertsShouldBeTriggered."></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
