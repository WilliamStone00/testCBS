                                                @Html.ValidationMessageFor(m => m.MobileMoneyTellerConfiguration.MobileMoneyMaximumBalanceAlertLevel, "", new { @class = "text-danger" })
                                                <label>@GlobalTellerManagement.MaximumBalanceForAlert</label>
                                                <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="@GlobalTellerManagement.EnterTheMaximumBalanceLevelAtWhichAlertsShouldBeTriggered."></i>
