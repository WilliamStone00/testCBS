@{
    ViewBag.Title = "Teller Management";
}
@using Resources
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalTellerManagement.TellersAccountManagement
                </h4>
                <p class="card-text text-muted">
                    @GlobalTellerManagement.ManageAndConfigureTellerAccountsEffectively.
                </p>
            </div>
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i> @GlobalTellerManagement.ManageTellerAccounts
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <h5 class="text-success">Actions</h5>
                                            <div class="btn-group">
                                                <!-- View List Button -->
                                                <a type="button"
                                                   onclick="LoadDataGen('TellerManagement', 'myDataTable', '_PrimaryTellerData', 0, 'datalistingview', null, null, 'list')"
                                                   class="btn btn-default btn-sm"
                                                   data-bs-toggle="tooltip"
                                                   title="@GlobalTellerManagement.ViewTheListOfTellers">
                                                    <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                                </a>
                                                <!-- Add New Button -->
                                                <a type="button"
                                                   onclick="AddORUpdateGen(null, 'datalistingview', '_PrimaryTeller', 'new', 'TellerManagement', null)"
                                                   class="btn btn-default btn-sm"
                                                   data-bs-toggle="tooltip"
                                                   title="@GlobalTellerManagement.AddANewTeller">
                                                    <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.AddNew
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_PrimaryTeller")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    function ToggleRemoteClose(tellerId, enable) {
        const action = enable ? "ENABLE" : "DISABLE";
        const emoji = enable ? "🔓" : "🔒";

        const confirmTitle = `${emoji} Confirm Remote Close Update`;
        const confirmMsg = `
        <div class="text-start">
            <p>You are about to <strong>${action}</strong> the <u>Remote Close of Day</u> feature for this teller.</p>
            <ul class="mb-0 ps-3">
                <li><strong>ENABLE:</strong> Allows the daily collector to close their cash operations from the mobile app, while physically in front of the Primary Teller.</li>
                <li><strong>DISABLE:</strong> Restricts the collector from closing remotely. Only in-branch closure is allowed.</li>
            </ul>
            <p class="mt-2 text-danger fw-bold">Please confirm that this change is intentional.</p>
        </div>
    `;

        alertify.confirm(
            confirmTitle,
            confirmMsg,
            function () {
                // ✅ Confirmed by user
                $.ajax({
                    url: `/TellerManagement/ToggleRemoteClose`,
                    type: "POST",
                    data: JSON.stringify({ tellerId: tellerId, enable: enable }),
                    contentType: "application/json",
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message, 1, 1); // ✅ success alert
                            // 🔁 Reload table data only
                            LoadDataGen('TellerManagement', 'myDataTable', '_PrimaryTellerData', 0, 'datalistingview', null, null, 'list');
                        } else {
                            appalert(response.message, 2, 1); // ❌ failure alert
                        }
                    },
                    error: function () {
                        appalert("🚨 A network or server error occurred. Please try again.", 2, 1);
                    }
                });
            },
            function () {
                appalert("🚨 Action canceled.", 2, 1);
            }
        ).set({
            labels: { ok: `${action} NOW`, cancel: "Cancel" },
            title: confirmTitle
        });
    }

    </script>
}
