@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<table class="table table-hover" id="myDataTable_teller">
    <thead class="table-light">
        <tr>
            <th>Teller</th>
            <th>Code</th>
            <th>Min-Max Amount</th>
            <th>Teller type</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Tellers)
        {
            <tr>
                <td style="width:30%">@d.name</td>
                <td style="width:10%">@d.code</td>
                <td style="width:20%">@d.MinAmount-@d.MaxAmount</td>
                <td style="width:10%">
                    @if (d.isPrimary)
                    {
                        <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">Primary</span></label>
                    }
                    else
                    {
                        <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">-</span></label>
                    }
                </td>
                <td style="width:10%">
                    @if (d.activeStatus)
                    {
                        <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">Active</span></label>
                    }
                    else
                    {
                        <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">In-Active</span></label>
                    }
                </td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_PrimaryTeller','get','TellerManagement',null)" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('TellerManagement','@d.id','myDataTable','_PrimaryTellerData',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

