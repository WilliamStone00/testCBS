@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
    @using Resources
<fieldset class="fieldset-custom">
    <legend>Teller Data</legend>
    @if (Model.Tellers.Any())
    {
        <table class="table table-hover table-responsive table-auto" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalTellerManagement.Teller</th>
                    <th>@GlobalTellerManagement.Code</th>
                    <th>@GlobalTellerManagement.MaxLimit</th>
                    <th>@GlobalTellerManagement.TellerType</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalTellerManagement.Branch</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Tellers)
                {
                    <tr>
                        <td>@d.name</td>
                        <td>@d.code</td>
                        <td>
                            @d.MinimumAmountToManage.ToString("#,##0.0") - @d.MaximumAmountToManage.ToString("#,##0.0")
                        </td>
                        <td>
                            @if (d.isPrimary)
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalTellerManagement.Primary</span></label>
                            }
                            else
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">-</span></label>
                            }
                        </td>
                        <td>
                            @if (d.activeStatus)
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalShared.Active</span></label>
                            }
                            else
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalTellerManagement.InActive</span></label>
                            }
                        </td>
                        <td>@d.Branch.Name</td>
                        <td>
                            <div class="d-inline me-2">
                                <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview','_PrimaryTeller','get','TellerManagement',null)"
                                   data-bs-toggle="tooltip" data-bs-placement="top" title="@GlobalShared.Select @d.name @GlobalShared.ToEdit">
                                    <i class="mdi mdi-pencil text-primary"></i> @GlobalShared.Edit
                                </a>
                            </div>

                            @if (d.TellerType == "MobileMoneyMTN" || d.TellerType == "MomocashCollectionMTN" || d.TellerType == "MomocashCollectionOrange" || d.TellerType == "MobileMoneyORANGE")
                            {
                                <div class="d-inline me-2">
                                    <a href="/TellerManagement/MMConfiguration?key=@d.id" target="_parent"
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="Configure @d.TellerType">
                                        <i class="mdi mdi-cog-outline text-warning"></i> @GlobalTellerManagement.MMConfig
                                    </a>
                                </div>
                            }

                            @*<div class="d-inline me-2">
                                <a href="#" data-bs-toggle="tooltip" data-bs-placement="top" title="@GlobalShared.Delete @d.name"
                                   onclick="DeleteRecordDataTable('TellerManagement','@d.id','myDataTable','_PrimaryTellerData',0,'datalistingview')">
                                    <i class="mdi mdi-delete-outline text-danger"></i> @GlobalShared.Delete
                                </a>
                            </div>*@

                            <div class="d-inline">
                                @if (d.AllowRemoteTellerClose)
                                {
                                    <a href="#" class="badge bg-success fs-tiny" title="Click to disable remote close"
                                       onclick="ToggleRemoteClose('@d.id', false)">
                                        🔓 Enabled
                                    </a>
                                }
                                else
                                {
                            <a href="#" class="badge bg-secondary fs-tiny" title="Click to enable remote close"
                               onclick="ToggleRemoteClose('@d.id', true)">
                                🔒 Disabled

                            </a>
                                }
                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center my-5">
            <p>@GlobalTellerManagement.NoDataAvailableClickBelowToAddNew:</p>
            <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_PrimaryTeller','new','TellerManagement',null)" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
                <span class="tf-icons mdi mdi-plus mdi-18px"></span>
            </a>
        </div>
    }
</fieldset>
