@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration

    @using (Html.BeginForm("AddOrUpdate", "TellerManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {    <input type="hidden" name="ServiceOption" value="primary_teller" id="ServiceOption" />
        
        <div class="row mt-2 gy-4">
            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Teller.name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Teller.name, "", new { @class = "text-danger" })
                        <label>Teller name</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Teller.code, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Teller.code, "", new { @class = "text-danger" })
                        <label>Teller code</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Teller.MinAmount, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Teller.MinAmount, "", new { @class = "text-danger" })
                        <label>Min amount teller can hold</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Teller.MaxAmount, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Teller.MaxAmount, "", new { @class = "text-danger" })
                        <label>Max amount teller can hold</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Teller.isPrimary, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">Set as primary teller</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Teller.activeStatus, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">Active status</label>
                    </div>
                </div>
                @*<div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.Teller.chartOfAccountId, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select chart of account of account---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.Teller.chartOfAccountId, "", new { @class = "text-danger" })
                        <label>Teller account (This account holds the amount that is used for daily operations)</label>
                    </div>
                </div>*@
                @*<div class="col-12">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.Teller.isDebit, new { @class = "form-check-input" })
                <label class="form-check-label" for="isActive">Check this option if this account should be debited.</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.Teller.operationEventAttributeId, new SelectList(ViewBag.OperationEventAttributes, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true"})
                @Html.ValidationMessageFor(m => m.Teller.operationEventAttributeId, "", new { @class = "text-danger" })
                <label>Select operation event attribute. (The operation account under the selected chart or account)</label>
            </div>
        </div>*@
            </div>
        </div>
        <div class="mt-4">
            @if (Model.Teller.id == null)
            {
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">Update</button>
                @Html.HiddenFor(m => m.Teller.id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }
