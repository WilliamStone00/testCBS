@model CBS.FrontDesk.Data.Entity.SavingProducts.OpeningOfTheDay


<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-octagram-plus me-2"></i>
               PROVISSIONING PRIMARY TELLER
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">

                        @using (Html.BeginForm("Primary", "TellerProvissioing", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row mt-2 gy-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.amount, "", new { @class = "text-danger" })
                                        <label style="color:blue">Enter provission amount</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note10000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note10000, "", new { @class = "text-danger " })
                                        <label>Note-10,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note5000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note5000, "", new { @class = "text-danger " })
                                        <label>Note-5,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note2000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note2000, "", new { @class = "text-danger " })
                                        <label>Note-2,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note1000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note1000, "", new { @class = "text-danger " })
                                        <label>Note-1,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note500, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note500, "", new { @class = "text-danger " })
                                        <label>Note-500</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin500, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin500, "", new { @class = "text-danger " })
                                        <label>Coin-500</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin100, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin100, "", new { @class = "text-danger " })
                                        <label>Coin-100</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin50, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin50, "", new { @class = "text-danger " })
                                        <label>Coin-50</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin25, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin25, "", new { @class = "text-danger " })
                                        <label>Coin-25</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin10, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin10, "", new { @class = "text-danger " })
                                        <label>Coin-10</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin5, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin5, "", new { @class = "text-danger " })
                                        <label>Coin-5</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin1, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.coin1, "", new { @class = "text-danger " })
                                        <label>Coin-1</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.PrimaryTellerProvissioning.primaryTellerId, new SelectList(ViewBag.PrimaryTeller, "id", "name"), "---Select teller---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.primaryTellerId, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">Select teller account</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.PrimaryTellerProvissioning.userId, new SelectList(ViewBag.TellerRoles, "id", "name"), "---Select user---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.userId, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">Select teller user</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Transfer</button>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>



</div>
