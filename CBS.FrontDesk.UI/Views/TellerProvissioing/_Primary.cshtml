            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box float-start">Amount provisioned: @Model.PrimaryTellerProvissioning.Amount.ToString("#,##0.0")</span>
                </div>
            </div>
            <div class="col-md-6" hidden="hidden">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.PrimaryTellerProvissioning.Amount">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblBalance">Balance: @Model.PrimaryTellerProvissioning.Amount.ToString("#,##0.0")</span>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.PrimaryTellerProvissioning.currencyNotes.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.PrimaryTellerProvissioning.currencyNotes.note10000, "", new { @class = "text-danger " })
                    <label>N10,000</label>
                </div>
            </div>
            <div class="col-md-2">
