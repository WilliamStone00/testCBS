@model CBS.FrontDesk.Data.Entity.SavingProducts.OpeningOfTheDay

<fieldset class="fieldset-custom">
    <legend id="select_base">Data listings </legend>
    @if (Model.CashReplenishmentPrimaryTellers.Count == 0)
    {
        <div class="text-center my-3">
            <p>No Data Found</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Branch</th>
                        <th>Reference</th>
                        <th>Status</th>
                        <th>Provisioned by</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.CashReplenishmentPrimaryTellers)
                    {
                        <tr>
                            <td style="width:20%">@d.ProvisionedDate</td>
                            <td style="width:10%">@d.Amount.ToString("#,##0.0")</td>
                            <td style="width:20%">@d.Branch.Name</td>
                            <td style="width:10%">@d.ReplenishmentReferenceNumber</td>
                            <td style="width:10%">
                                @if (d.Status)
                                {
                                    <span class="badge bg-info">Provisioned</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Awaiting provision</span>
                                }
                            </td>
                            <td style="width:20%">@d.ProvisionedBy</td>
                            <td style="width:10%">
                                @if (d.Status)
                                {
                                    <a href="/TellerProvissioing/Deatils?ProvisionKey=@d.Id" target="_blank" mr-2" data-toggle="tooltip" data-placement="top" title="Privision @d.Amount into operation.">Details</a>

                                }
                                else
                                {
                                    <a href="/TellerProvissioing/Primary?ProvisionKey=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="Privision @d.Amount into operation.">Provision</a>

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
