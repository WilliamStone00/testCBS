@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>@AccountingV2.AffiliateManagement
                </h1>
                <p class="card-text">
                    @AccountingV2.AffiliateManagementtext
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<!-- Affiliate Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle for Date Filters -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Search</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="text" id="code" name="Code" class="form-control" placeholder="Affiliate code" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="name" name="Name" class="form-control" placeholder="Affiliate name" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Status</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select id="isActive" name="IsActive" class="form-control w-50">
                            <option value="">@AccountingV2.All</option>
                            <option value="true">@AccountingV2.Active</option>
                            <option value="false">@AccountingV2.Inactive</option>
                        </select>

                        <div class="form-check ms-3">
                            <input class="form-check-input" type="checkbox" id="includeDeleted" name="IncludeDeleted" />
                            <label class="form-check-label fw-bold" for="includeDeleted">@AccountingV2.IncludeDeleted</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Created Date Filters toggle -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates" onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleCreatedDates">@AccountingV2.ShowCreatedDateFilters</label>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">@AccountingV2.Affiliatetext1.</small>
                </div>
            </div>

            <div id="createdDateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedFrom (UTC)</label>
                        <input type="date" id="createdFromUtc" name="CreatedFromUtc" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedTo (UTC)</label>
                        <input type="date" id="createdToUtc" name="CreatedToUtc" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Hidden / DataTable options could go here if you need to include page/length options -->
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

    @section Scripts {
        <script>
            (function () {
                // Config
                const ajaxLoadUrl = '/ChartOfAccountV2/LoadData';           // server action that accepts COADATATABLE_Query
                const ajaxInitializeUrl = '/ChartOfAccountV2/InitializeData'; // action that returns partials

                var affiliateTable = null;

                // utility
                function emptyToNull(v) {
                    return (v === undefined || v === null || v === '') ? null : v;
                }
                function escapeHtml(str) {
                    if (!str && str !== 0) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                }

                // Build server-side COADATATABLE_Query payload
                function collectAffiliateFilters(dtOptions) {
                    // dtOptions is the DataTables request object (d) - optional
                    var opts = dtOptions || { draw: 0, start: 0, length: 10 };

                    return {
                        Code: emptyToNull($('#code').val() || $('#Code').val()),
                        Name: emptyToNull($('#name').val() || $('#Name').val()),
                        Class: emptyToNull($('#Class').val()),
                        ParentId: emptyToNull($('#ParentId').val()),
                        PathContains: emptyToNull($('#PathContains').val()),
                        DepthFrom: ($('#DepthFrom').val() === '' ? null : parseInt($('#DepthFrom').val(), 10)),
                        DepthTo: ($('#DepthTo').val() === '' ? null : parseInt($('#DepthTo').val(), 10)),
                        PostingAllowed: (function () {
                            var v = ($('#PostingAllowed').length ? $('#PostingAllowed').val() : $('#isActive').val());
                            if (v === undefined || v === '') return null;
                            if (v === 'true' || v === true) return true;
                            if (v === 'false' || v === false) return false;
                            return null;
                        })(),
                        CreatedFromUtc: emptyToNull($('#createdFromUtc').val() || $('#CreatedFromUtc').val()),
                        CreatedToUtc: emptyToNull($('#createdToUtc').val() || $('#CreatedToUtc').val()),
                        IncludeDeleted: $('#includeDeleted').is(':checked') === true
                    };
                }

                function initAffiliateDataTableIfNeeded() {
                    // if already initialized, do nothing
                    if ($.fn.DataTable.isDataTable('#myDataTable') && affiliateTable) return;

                    // ensure element exists
                    if (!$('#myDataTable').length) {
                        if (typeof appalert === 'function') appalert('Table element #myDataTable not found', 0, 1);
                        console.warn('#myDataTable missing');
                        return;
                    }

                    affiliateTable = $('#myDataTable').DataTable({
                        serverSide: true,
                        searching: false,
                        responsive: true,
                        destroy: false,
                        order: [[0, 'desc']],
                        ajax: {
                            url: ajaxLoadUrl,
                            type: 'POST',
                            contentType: 'application/json',
                            data: function (d) {
                                // collect filters and attach datatable options
                                const payload = collectAffiliateFilters(d);
                                return JSON.stringify(payload);
                            },
                            dataSrc: function (json) {
                                // DataTables expects { draw, recordsTotal, recordsFiltered, data }
                                if (!json) return [];
                                // keep defensive defaults
                                json.recordsTotal = Number(json.recordsTotal || 0);
                                json.recordsFiltered = Number(json.recordsFiltered || json.recordsTotal || 0);
                                return Array.isArray(json.data) ? json.data : [];
                            },
                            error: function (xhr, status, err) {
                                var msg = 'Failed to load data. Please try again.';
                                try { msg = xhr.responseJSON?.message || msg; } catch (e) { }
                                if (typeof appalert === 'function') appalert(msg, 0, 1);
                                console.error('Affiliate load error', xhr, status, err);
                            }
                        },
                        columns: [
                            {
                                data: 'CreatedDate',
                                name: 'CreatedDate',
                                render: function (data, type) {
                                    if (type === 'display' || type === 'filter') {
                                        if (!data) return '-';
                                        try {
                                            // Use moment if available
                                            if (window.moment) return moment(data).format('DD/MM/YYYY HH:mm:ss');
                                            return new Date(data).toLocaleString();
                                        } catch (e) { return data; }
                                    }
                                    return data;
                                }
                            },
                            { data: 'Code', name: 'Code', defaultContent: '-' },
                            { data: 'NameEn', name: 'NameEn', defaultContent: '-' },
                            { data: 'Class', name: 'Class', defaultContent: '-' },
                            { data: 'ParentId', name: 'ParentId', defaultContent: '-' },
                            { data: 'Path', name: 'Path', defaultContent: '-' },
                            {
                                data: 'Id',
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function (data, type, row) {
                                    var rawId = String(row.Id || row.id || data || '');
                                    var recordId = encodeURIComponent(rawId);
                                    var safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                                    var btnId = 'actionDropdown_' + safeId;

                                    var name = escapeHtml(row.NameEn || row.Name || '');
                                    var isDeleted = row.IsDeleted === true || row.isDeleted === 1 || row.isDeleted === 'true';

                                    var detailsBtn = `<button type="button" class="dropdown-item btn-details" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button>`;
                                    var editBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-edit" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit</button>` : '';
                                    var deleteBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-delete text-danger" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button>` : '';

                                    return `
                                            <div class="dropdown text-center">
                                                <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="mdi mdi-cog-outline"></i> Actions
                                                </button>
                                                <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                                    <li>${detailsBtn}</li>
                                                    ${!isDeleted ? `<li><hr class="dropdown-divider"></li>` : ''}
                                                    ${!isDeleted ? `<li>${editBtn}</li>` : ''}
                                                    ${!isDeleted ? `<li>${deleteBtn}</li>` : ''}
                                                </ul>
                                            </div>
                                        `.trim();
                                }
                            }
                        ],
                        lengthMenu: [10, 25, 50],
                        pageLength: 10,
                        language: { emptyTable: 'No affiliate records found' },
                        initComplete: function () {
                            // initialize tooltips if present
                            try {
                                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                                        new bootstrap.Tooltip(el);
                                    });
                                }
                            } catch (e) { /* ignore */ }
                        }
                    });
                }

                // load table (initializes if needed)
                function loadAffiliateData() {
                    initAffiliateDataTableIfNeeded();
                    if (affiliateTable) affiliateTable.ajax.reload(null, false);
                }

                // reset filters
                function resetAffiliateFilters() {
                    var form = document.getElementById('affiliateFilterForm');
                    if (form) form.reset();

                    // hide created date filters if any toggle exists
                    $('#createdDateFilters').addClass('d-none');
                    $('#toggleCreatedDates').prop('checked', false);

                    if (affiliateTable) affiliateTable.ajax.reload(null, false);
                    else initAffiliateDataTableIfNeeded();

                    if (typeof appalert === 'function') appalert('Filters reset', 3, 1);
                }

                // ---------- Modal focus helpers (avoid aria-hidden + focused descendant) ----------
                function showModalAndFocus(modalEl) {
                    if (!modalEl) return null;
                    var bs = null;
                    try { bs = new bootstrap.Modal(modalEl); } catch (e) { bs = null; }
                    // show a11y safe: set spinner then show
                    if (bs) bs.show();
                    $(modalEl).off('shown.bs.modal.focusFix').on('shown.bs.modal.focusFix', function () {
                        try {
                            var focusTarget = modalEl.querySelector('.btn-close, .modal-footer .btn[data-bs-dismiss="modal"]');
                            if (focusTarget) {
                                focusTarget.focus();
                            } else {
                                var dialog = modalEl.querySelector('.modal-dialog');
                                if (dialog) { dialog.setAttribute('tabindex', '-1'); dialog.focus(); }
                            }
                        } catch (err) { /* ignore */ }
                    });
                    $(modalEl).off('hide.bs.modal.blurFix').on('hide.bs.modal.blurFix', function () {
                        try {
                            var active = document.activeElement;
                            if (modalEl.contains(active)) active.blur();
                        } catch (err) { /* ignore */ }
                    });
                    return bs;
                }

                // ---------- Delegated actions: details / edit / delete ----------
                $(document).on('click', '#applyAffiliateFilterBtn', function (e) {
                    e.preventDefault();
                    // initialize + load
                    loadAffiliateData();
                });

                $(document).on('click', '#resetAffiliateFilterBtn', function (e) {
                    e.preventDefault();
                    resetAffiliateFilters();
                });

                // Details
                $(document).on('click', '.btn-details', function (e) {
                    e.preventDefault();
                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { if (typeof appalert === 'function') appalert('Missing id for details', 0, 1); return; }

                    var modalEl = document.getElementById('affiliateDetailsModal');
                    if (!modalEl) { if (typeof appalert === 'function') appalert('Details modal not found', 0, 1); return; }

                    // spinner and show modal
                    $('#affiliateDetailsModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');
                    var bs = showModalAndFocus(modalEl);

                    // call InitializeData -> controller will return the partial (ensure it returns the correct model for partial)
                    $.get(ajaxInitializeUrl, {
                        KEY: id,
                        partialView: '_DetailsPartial',
                        path: 'get'
                    })
                        .done(function (html) {
                            $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
                            try {
                                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                    document.querySelectorAll('#affiliateDetailsModal [data-bs-toggle="tooltip"]').forEach(function (el) {
                                        new bootstrap.Tooltip(el);
                                    });
                                }
                            } catch (e) { /* ignore */ }
                        })
                        .fail(function (xhr) {
                            $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                            if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
                            console.error('Details load failed', xhr);
                        });
                });

                // Edit
                $(document).on('click', '.btn-edit', function (e) {
                    e.preventDefault();

                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { if (typeof appalert === 'function') appalert('Missing id for edit', 0, 1); return; }

                    // If you have AddORUpdateGen helper (client-side partial loader), prefer it:
                    if (typeof AddORUpdateGen === 'function') {
                        // load edit partial into the listing container (or a specific container you use)
                        AddORUpdateGen(id, 'affiliateListingView', '_EditPartial', 'get', 'ChartOfAccountV2');
                        return;
                    }

                    // fallback: load into modal (same accessibility pattern)
                    var modalEl = document.getElementById('affiliateEditModal');
                    if (!modalEl) { if (typeof appalert === 'function') appalert('Edit modal not found', 0, 1); return; }

                    $('#affiliateEditModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');
                    var bs = showModalAndFocus(modalEl);

                    // request edit partial - ensure controller returns AddAffiliateAccountCommand model for _EditPartial
                    $.get(ajaxInitializeUrl, {
                        KEY: id,
                        partialView: '_EditPartial',
                        path: 'get'
                    })
                        .done(function (html) {
                            $('#affiliateEditModal .modal-body').html(html || '<div class="text-center text-muted">No edit form available.</div>');
                        })
                        .fail(function (xhr) {
                            $('#affiliateEditModal .modal-body').html('<div class="text-center text-danger">Error loading edit form</div>');
                            if (typeof appalert === 'function') appalert('Failed to load edit form', 0, 1);
                            console.error('Edit load failed', xhr);
                        });
                });

                // Delete (example using DeleteRecordDataTable helper if present)
                $(document).on('click', '.btn-delete', function (e) {
                    e.preventDefault();
                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { if (typeof appalert === 'function') appalert('Missing id for delete', 0, 1); return; }

                    if (typeof DeleteRecordDataTable === 'function') {
                        DeleteRecordDataTable('ChartOfAccountV2', id, 'myDataTable', '_DataTable', 0, 'affiliateListingView', null, 'list');
                        return;
                    }

                    if (!confirm('Are you sure you want to delete this record?')) return;

                    $.post('/ChartOfAccountV2/Delete', { id: id })
                        .done(function (res) {
                            if (res && res.success) {
                                if (affiliateTable) affiliateTable.ajax.reload(null, false);
                                if (typeof appalert === 'function') appalert('Deleted', 3, 1);
                            } else {
                                if (typeof appalert === 'function') appalert(res?.message || 'Delete failed', 0, 1);
                            }
                        })
                        .fail(function (xhr) {
                            if (typeof appalert === 'function') appalert('Delete request failed', 0, 1);
                            console.error('Delete failed', xhr);
                        });
                });

                // Optional: automatically initialize table on page load if you want
                // but per your earlier note, we load on Apply so we won't init here automatically.
                // If you prefer auto-load on page load, uncomment:
                // $(document).ready(function() { loadAffiliateData(); });

            })();
        </script>
    }
