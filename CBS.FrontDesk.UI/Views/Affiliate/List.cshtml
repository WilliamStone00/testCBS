@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>@AccountingV2.AffiliateManagement
                </h1>
                <p class="card-text">
                    @AccountingV2.AffiliateManagementtext
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<!-- Affiliate Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle for Date Filters -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Search</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="text" id="code" name="Code" class="form-control" placeholder="Affiliate code" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="name" name="Name" class="form-control" placeholder="Affiliate name" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Status</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select id="isActive" name="IsActive" class="form-control w-50">
                            <option value="">@AccountingV2.All</option>
                            <option value="true">@AccountingV2.Active</option>
                            <option value="false">@AccountingV2.Inactive</option>
                        </select>

                        <div class="form-check ms-3">
                            <input class="form-check-input" type="checkbox" id="includeDeleted" name="IncludeDeleted" />
                            <label class="form-check-label fw-bold" for="includeDeleted">@AccountingV2.IncludeDeleted</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Created Date Filters toggle -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates" onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleCreatedDates">@AccountingV2.ShowCreatedDateFilters</label>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">@AccountingV2.Affiliatetext1.</small>
                </div>
            </div>

            <div id="createdDateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedFrom (UTC)</label>
                        <input type="date" id="createdFromUtc" name="CreatedFromUtc" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedTo (UTC)</label>
                        <input type="date" id="createdToUtc" name="CreatedToUtc" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Hidden / DataTable options could go here if you need to include page/length options -->
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

@section Scripts {
    <script>
        (function () {
            const ajaxUrl = '@Url.Action("LoadAffiliateData", "Affiliate")';

            var affiliateTable = null;

            function emptyToNull(v) {
                return (v === undefined || v === null || v === '') ? null : v;
            }

            function collectAffiliateFilters() {
                var isActiveVal = $('#isActive').val();
                var isActive = isActiveVal === '' ? null : (isActiveVal === 'true');

                return {
                    Code: emptyToNull($('#code').val()),
                    Name: emptyToNull($('#name').val()),
                    IsActive: isActive,
                    IncludeDeleted: $('#includeDeleted').is(':checked'),
                    CreatedFromUtc: emptyToNull($('#createdFromUtc').val()),
                    CreatedToUtc: emptyToNull($('#createdToUtc').val())
                };
            }

            // Initialize or reload DataTable
            function loadAffiliateData() {
                if (affiliateTable) {
                    affiliateTable.destroy();
                }

                affiliateTable = $('#myDataTable').DataTable({
                    serverSide: true,
                     destroy: true,
                    searching: false,
                    responsive: true,
                    order: [[0, 'desc']],
                    ajax: {
                        url: ajaxUrl,
                        type: 'POST',
                        contentType: 'application/json',
                        data: function (d) {
                            var filters = collectAffiliateFilters();

                            // Create the payload that matches your controller's expected model
                            var payload = {
                                Code: filters.Code,
                                Name: filters.Name,
                                IsActive: filters.IsActive,
                                IncludeDeleted: filters.IncludeDeleted,
                                CreatedFromUtc: filters.CreatedFromUtc,
                                CreatedToUtc: filters.CreatedToUtc,
                                Draw: d.draw,
                                Start: d.start,
                                Length: d.length,
                                SearchValue: d.search.value,
                                SortColumnName: d.columns[d.order[0].column].data,
                                SortColumnDirection: d.order[0].dir
                            };

                            console.log('Sending payload:', payload); // Debug log
                            return JSON.stringify(payload);
                        },
                        dataSrc: function (json) {
                            console.log('Received response:', json); // Debug log

                            if (json && json.data) {
                                json.recordsTotal = json.recordsTotal;
                                json.recordsFiltered = json.recordsFiltered;
                                return json.data;
                            }
                            return [];
                        },
                        error: function (xhr, error, thrown) {
                            console.error('AJAX Error:', error, thrown);
                            alert('Failed to load affiliate data. Please check console for details.');
                        }
                    },
                    columns: [
                        {
                            data: 'CreatedDate',
                            name: 'CreatedDate',
                            render: function (data, type) {
                                if (type === 'display' || type === 'filter') {
                                    return data ? new Date(data).toLocaleDateString() : '';
                                }
                                return data;
                            }
                        },
                        { data: 'Code', name: 'Code' },
                        { data: 'Name', name: 'Name' },
                        {
                            data: 'IsActive',
                            name: 'IsActive',
                            className: 'text-center',
                            orderable: true,
                            render: function (data) {
                                return data
                                    ? '<span class="badge bg-success">Active</span>'
                                    : '<span class="badge bg-secondary">Inactive</span>';
                            }
                        },
                        {
                            data: 'IsHeadOffice',
                            name: 'IsHeadOffice',
                            className: 'text-center',
                            render: function (data) {
                                return data
                                    ? '<span class="badge bg-info">Head Office</span>'
                                    : '<span class="badge bg-light text-dark">Branch</span>';
                            }
                        },
                        {
                            data: 'IsDeleted',
                            name: 'IsDeleted',
                            className: 'text-center',
                            render: function (data) {
                                return data ? '<span class="badge bg-danger">Deleted</span>' : '<span class="badge bg-success">Live</span>';
                            }
                        },
                        {
                            data: 'ModifiedDate',
                            name: 'ModifiedDate',
                            render: function (data, type) {
                                if (type === 'display' || type === 'filter') {
                                    return data ? new Date(data).toLocaleDateString() : '';
                                }
                                return data;
                            }
                        },
                        {
                            data: 'Id',
                            orderable: false,
                            searchable: false,
                            className: 'text-center',
                          render: function (id, type, row) {
                                        // row.Id and row.Name assumed to exist
                                        var recId = row.Id || '';
                                        var name = (row.Name || '').replace(/'/g, "\\'"); // escape single quotes for titles

                                        return `
                                            <div style="width:100%; display:flex; justify-content:center; gap:.5rem;">
                                                <a href="#"
                                                   onclick="AddORUpdateGen('${recId}', 'datalistingview', '_CreateAffiliate', 'get', 'Affiliate')"
                                                   class="btn btn-sm btn-outline-primary"
                                                   data-toggle="tooltip"
                                                   title="Edit ${name}">Edit</a>

                                                <a href="#"
                                                   onclick="DeleteRecordDataTable('Affiliate', '${recId}', 'myDataTable', '_Data', 0, 'datalistingview', null, 'list')"
                                                   class="btn btn-sm btn-outline-danger"
                                                   data-toggle="tooltip"
                                                   title="Delete ${name}">Delete</a>
                                            </div>
                             `;
                           }
                        }
                    ],
                    language: {
                        emptyTable: 'No affiliates found'
                    }
                });
            }

            // Wire Apply / Reset buttons
            $('#applyAffiliateFilterBtn').on('click', function () {
                if (affiliateTable) {
                    affiliateTable.ajax.reload();
                } else {
                    loadAffiliateData();
                }
            });

            $('#resetAffiliateFilterBtn').on('click', function () {
                // Reset form
                document.getElementById('affiliateFilterForm').reset();

                // Hide created date filters
                $('#createdDateFilters').addClass('d-none');
                $('#toggleCreatedDates').prop('checked', false);

                // Reload table with reset filters
                if (affiliateTable) {
                    affiliateTable.ajax.reload();
                }
            });

            // Delegated action handlers
            $(document).on('click', '.edit-affiliate', function (e) {
                e.preventDefault();
                const id = $(this).data('id');
                window.location = '@Url.Action("Edit", "Affiliate")/' + id;
            });

            $(document).on('click', '.delete-affiliate', function (e) {
                e.preventDefault();
                const id = $(this).data('id');
                if (!confirm('Are you sure you want to delete this affiliate?')) return;

                $.post('@Url.Action("Delete", "Affiliate")/' + id)
                    .done(function() {
                        if (affiliateTable) affiliateTable.ajax.reload();
                    })
                    .fail(function(err) {
                        console.error(err);
                        alert('Failed to delete affiliate.');
                    });
            });

            // Auto-load on page load
            $(document).ready(function () {
                loadAffiliateData();
            });
        })();
    </script>
}