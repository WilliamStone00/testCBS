@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>@AccountingV2.AffiliateManagement
                </h1>
                <p class="card-text">
                    @AccountingV2.AffiliateManagementtext
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<!-- Affiliate Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle for Date Filters -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Search</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="text" id="code" name="Code" class="form-control" placeholder="Affiliate code" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="name" name="Name" class="form-control" placeholder="Affiliate name" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Status</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select id="isActive" name="IsActive" class="form-control w-50">
                            <option value="">@AccountingV2.All</option>
                            <option value="true">@AccountingV2.Active</option>
                            <option value="false">@AccountingV2.Inactive</option>
                        </select>

                        <div class="form-check ms-3">
                            <input class="form-check-input" type="checkbox" id="includeDeleted" name="IncludeDeleted" />
                            <label class="form-check-label fw-bold" for="includeDeleted">@AccountingV2.IncludeDeleted</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Created Date Filters toggle -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates" onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleCreatedDates">@AccountingV2.ShowCreatedDateFilters</label>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">@AccountingV2.Affiliatetext1.</small>
                </div>
            </div>

            <div id="createdDateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedFrom (UTC)</label>
                        <input type="date" id="createdFromUtc" name="CreatedFromUtc" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@AccountingV2.CreatedTo (UTC)</label>
                        <input type="date" id="createdToUtc" name="CreatedToUtc" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Hidden / DataTable options could go here if you need to include page/length options -->
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            // Config (adjust routes if necessary)
            const ajaxLoadUrl = '/Affiliate/LoadAffiliateData';
            const ajaxInitializeUrl = '/Affiliate/InitializeData';
            const detailsModalSelector = '#affiliateDetailsModal';
            const editModalSelector = '#affiliateEditModal';
            const tableSelector = '#myDataTable';

            // expose table globally so other scripts can reload it
            window.affiliateTable = window.affiliateTable || null;

            // Helpers
            function emptyToNull(v) {
                return (v === undefined || v === null || v === '') ? null : v;
            }

            function escapeHtml(str) {
                if (str === undefined || str === null) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function showAppAlert(msg, type) {
                // type: 3 = success, otherwise treat as error/info
                if (typeof appalert === 'function') {
                    appalert(msg, type === 3 ? 3 : 0, 1);
                } else {
                    try { alert(msg); } catch (e) { console.log((type === 3 ? 'SUCCESS: ' : 'INFO: ') + msg); }
                }
            }

            // Build AffiliateQuery payload (matches server AffiliateQuery)
            function collectAffiliateFilters() {
                // isActive select returns "" | "true" | "false"
                var isActiveRaw = $('#isActive').val();
                var isActive = (isActiveRaw === '' || isActiveRaw === undefined) ? null : (isActiveRaw === 'true');

                return {
                    Code: emptyToNull($('#code').val() || $('#Code').val()),
                    Name: emptyToNull($('#name').val() || $('#Name').val()),
                    IsActive: isActive,
                    IncludeDeleted: $('#includeDeleted').is(':checked') ? true : false,
                    CreatedFromUtc: emptyToNull($('#createdFromUtc').val() || $('#CreatedFromUtc').val()),
                    CreatedToUtc: emptyToNull($('#createdToUtc').val() || $('#CreatedToUtc').val()),
                    // Options will be added by datatable ajax data builder
                    Options: {}
                };
            }

            // Initialize DataTable once
            function initAffiliateDataTableIfNeeded() {
                if ($.fn.DataTable.isDataTable(tableSelector) && window.affiliateTable) return;

                if (!$(tableSelector).length) {
                    showAppAlert('Table element ' + tableSelector + ' not found', 0);
                    console.warn(tableSelector + ' missing');
                    return;
                }

                window.affiliateTable = $(tableSelector).DataTable({
                    serverSide: true,
                    searching: false,
                    responsive: true,
                    order: [[0, 'desc']], // CreatedDate desc
                    ajax: {
                        url: ajaxLoadUrl,
                        type: 'POST',
                        contentType: 'application/json',
                        data: function (d) {
                            var payload = collectAffiliateFilters();

                            // Attach DataTable paging/sort/search info into AffiliateQuery.Options
                            var sortColumnName = 'CreatedDate';
                            var sortColumnDirection = 'desc';
                           
                            payload.options = {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                skip: d.start,
                                pageSize: d.length,
                                searchValue: (d.search && d.search.value) ? d.search.value : '',
                                sortColumnName: sortColumnName,
                                sortColumnDirection: sortColumnDirection
                            };

                            return JSON.stringify(payload);
                        },
                        //dataSrc: function (json) {
                        //    if (!json) return [];
                        //    // ensure datatable fields present
                        //    json.draw = json.draw || 0;
                        //    json.recordsTotal = Number(json.recordsTotal || json.recordsFiltered || 0);
                        //    json.recordsFiltered = Number(json.recordsFiltered || json.recordsTotal || 0);
                        //    return Array.isArray(json.data) ? json.data : [];
                        //},
                        error: function (xhr, status, err) {
                            var msg = 'Failed to load affiliate data. Please try again.';
                            try { msg = xhr.responseJSON?.message || msg; } catch (e) { /* ignore */ }
                            showAppAlert(msg, 0);
                            console.error('LoadAffiliateData error', xhr, status, err);
                        }
                    },
                    columns: [
                        {
                            data: 'CreatedDate',
                            name: 'CreatedDate',
                            render: function (data, type) {
                                if (type === 'display' || type === 'filter') {
                                    if (!data) return '-';
                                    try {
                                        if (window.moment) return moment(data).format('DD/MM/YYYY HH:mm:ss');
                                        var dt = new Date(data);
                                        return isNaN(dt.getTime()) ? data : dt.toLocaleString();
                                    } catch (e) { return data; }
                                }
                                return data;
                            }
                        },
                        { data: 'Code', name: 'Code', defaultContent: '-' },
                        { data: 'Name', name: 'Name', defaultContent: '-' },
                        {
                            data: 'IsActive',
                            name: 'IsActive',
                            defaultContent: '-',
                            render: function (data, type) {
                                if (type === 'display' || type === 'filter') {
                                    if (data === true || data === 'true' || data === 1) return '<span class="badge bg-success">Active</span>';
                                    if (data === false || data === 'false' || data === 0) return '<span class="badge bg-secondary">Inactive</span>';
                                    return '-';
                                }
                                return data;
                            }
                        },
                        {
                            data: 'IsHeadOffice', name: 'HeadOffice', defaultContent: '-',
                            render: function (data, type) {
                                if (type === 'display' || type === 'filter') {
                                    if (data === true || data === 'true' || data === 1) return '<span class="badge bg-success">True</span>';
                                    if (data === false || data === 'false' || data === 0) return '<span class="badge bg-secondary">False</span>';
                                    return '-';
                                }
                                return data;
                            }
                        },
                        {
                            data: 'Id',
                            orderable: false,
                            searchable: false,
                            className: 'text-center',
                            render: function (data, type, row) {
                                var rawId = String(row.Id || row.id || data || '');
                                var recordId = encodeURIComponent(rawId);
                                var safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                                var btnId = 'actionDropdown_' + safeId;
                                var name = escapeHtml(row.Name || row.name || '');
                                var isDeleted = row.IsDeleted === true || row.isDeleted === 1 || row.isDeleted === 'true';

                                var detailsBtn = `<button type="button" class="dropdown-item btn-details" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button>`;
                                var editBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-edit" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit</button>` : '';
                                var deleteBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-delete text-danger" data-id="${recordId}" data-name="${name}"><i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button>` : '';

                                return `
                                <div class="dropdown text-center">
                                        <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="mdi mdi-cog-outline"></i> Actions
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                            <li>${detailsBtn}</li>
                                            ${!isDeleted ? `
                                            <li><hr class="dropdown-divider"></li>` : ''}
                                            ${!isDeleted ? `
                                            <li>${editBtn}</li>` : ''}
                                            ${!isDeleted ? `
                                            <li>${deleteBtn}</li>` : ''}
                                        </ul>
                                </div>`.trim();
                                                            }
                        }
                    ],
                    lengthMenu: [10, 25, 50],
                    pageLength: 10,
                    language: { emptyTable: 'No affiliate records found' },
                    initComplete: function () {
                        try {
                            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } catch (e) { /* ignore */ }
                    }
                });
            }

            // Load / reload wrapper
            function loadAffiliateData() {
                initAffiliateDataTableIfNeeded();
                if (window.affiliateTable) window.affiliateTable.ajax.reload(null, false);
            }

            // Reset filters
            function resetAffiliateFilters() {
                var form = document.getElementById('affiliateFilterForm');
                if (form) form.reset();

                // hide date filters UI if toggled
                $('#createdDateFilters').addClass('d-none');
                $('#toggleCreatedDates').prop('checked', false);

                loadAffiliateData();
                showAppAlert('Filters reset', 3);
            }

            // Utility to show modal and manage focus safely
            function showModalAndFocus(modalEl) {
                if (!modalEl) return null;
                var bs = null;
                try { bs = new bootstrap.Modal(modalEl); } catch (e) { bs = null; }
                if (bs) bs.show();

                $(modalEl).off('shown.bs.modal.focusFix').on('shown.bs.modal.focusFix', function () {
                    try {
                        var el = modalEl.querySelector('.btn-close, .modal-footer .btn[data-bs-dismiss="modal"]');
                        if (el) el.focus();
                        else {
                            var dialog = modalEl.querySelector('.modal-dialog');
                            if (dialog) { dialog.setAttribute('tabindex', '-1'); dialog.focus(); }
                        }
                    } catch (err) { /* ignore */ }
                });

                $(modalEl).off('hide.bs.modal.blurFix').on('hide.bs.modal.blurFix', function () {
                    try {
                        var active = document.activeElement;
                        if (modalEl.contains(active)) active.blur();
                    } catch (err) { /* ignore */ }
                });

                return bs;
            }

            // Event wiring
            $(document).ready(function () {
                // Apply / Reset buttons
                $(document).off('click', '#applyAffiliateFilterBtn').on('click', '#applyAffiliateFilterBtn', function (e) {
                    e.preventDefault();
                    loadAffiliateData();
                });

                $(document).off('click', '#resetAffiliateFilterBtn').on('click', '#resetAffiliateFilterBtn', function (e) {
                    e.preventDefault();
                    resetAffiliateFilters();
                });

                // Enter key to apply search
                $(document).off('keypress', '#affiliateFilterForm input').on('keypress', '#affiliateFilterForm input', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        loadAffiliateData();
                    }
                });

                // Details handler
                $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
                    e.preventDefault();
                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { showAppAlert('Missing id for details', 0); return; }

                    var modalEl = document.querySelector(detailsModalSelector);
                    if (!modalEl) { showAppAlert('Details modal not found', 0); return; }

                    $(detailsModalSelector + ' .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');
                    showModalAndFocus(modalEl);

                    $.get(ajaxInitializeUrl, { KEY: id, partialView: '_DetailsPartial', path: 'get' })
                        .done(function (html) {
                            $(detailsModalSelector + ' .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
                            try {
                                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                    document.querySelectorAll(detailsModalSelector + ' [data-bs-toggle="tooltip"]').forEach(function (el) {
                                        new bootstrap.Tooltip(el);
                                    });
                                }
                            } catch (e) { /* ignore */ }
                        })
                        .fail(function (xhr) {
                            $(detailsModalSelector + ' .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                            showAppAlert('Failed to load details', 0);
                            console.error('Details load failed', xhr);
                        });
                });

                // Edit handler -> load edit partial into modal
                $(document).off('click', '.btn-edit').on('click', '.btn-edit', function (e) {
                    e.preventDefault();
                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { showAppAlert('Missing id for edit', 0); return; }

                    var modalEl = document.querySelector(editModalSelector);
                    if (!modalEl) { showAppAlert('Edit modal not found', 0); return; }

                    $(editModalSelector + ' .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>');
                    showModalAndFocus(modalEl);

                    $.get(ajaxInitializeUrl, { KEY: id, partialView: '_EditPartial', path: 'get' })
                        .done(function (html) {
                            $(editModalSelector + ' .modal-body').html(html || '<div class="text-center text-muted">No edit form available.</div>');
                        })
                        .fail(function () {
                            $(editModalSelector + ' .modal-body').html('<div class="text-center text-danger">Error loading edit form</div>');
                            showAppAlert('Failed to load edit form', 0);
                        });
                });

                // Delete handler
                $(document).off('click', '.btn-delete').on('click', '.btn-delete', function (e) {
                    e.preventDefault();
                    var raw = $(this).data('id');
                    var id = raw ? decodeURIComponent(raw) : null;
                    if (!id) { showAppAlert('Missing id for delete', 0); return; }

                    if (!confirm('Are you sure you want to delete this record?')) return;

                    $.post('/Affiliate/Delete', { id: id })
                        .done(function (res) {
                            if (res && res.success) {
                                if (window.affiliateTable) window.affiliateTable.ajax.reload(null, false);
                                showAppAlert(res.message || 'Deleted', 3);
                            } else {
                                showAppAlert(res?.message || 'Delete failed', 0);
                            }
                        })
                        .fail(function (xhr) {
                            showAppAlert('Delete request failed', 0);
                            console.error('Delete failed', xhr);
                        });
                });

                // Delegated submit for edit form loaded into modal (if your partial uses #editAccountForm)
                $(document).off('submit', '#editAccountForm').on('submit', '#editAccountForm', function (e) {
                    e.preventDefault();

                    var $form = $(this);
                    var $btn = $form.find('#saveButton');
                    var originalHtml = $btn.html();
                    var formData = $form.serialize();
                    var token = $form.find('input[name="__RequestVerificationToken"]').val();

                    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving');

                    $.ajax({
                        url: '/ChartOfAccountV2/UpdateAccountName',
                        type: 'POST',
                        data: formData,
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        success: function (res) {
                            $btn.prop('disabled', false).html(originalHtml);
                            if (res && res.success) {
                                try {
                                    var modalEl = document.getElementById('affiliateEditModal');
                                    var bs = bootstrap.Modal.getInstance(modalEl);
                                    if (bs) bs.hide();
                                } catch (err) { /* ignore */ }

                                if (window.affiliateTable) window.affiliateTable.ajax.reload(null, false);
                                showAppAlert(res.message || 'Saved', 3);
                            } else {
                                showAppAlert(res?.message || 'Save failed', 0);
                            }
                        },
                        error: function (xhr) {
                            $btn.prop('disabled', false).html(originalHtml);
                            showAppAlert('Save request failed', 0);
                        }
                    });
                });

                // NOTE: We intentionally do not auto-load on page ready; user clicks Apply Filter.
                // If you want to auto-load uncomment the next line:
                // loadAffiliateData();
            });
        })();
    </script>
}