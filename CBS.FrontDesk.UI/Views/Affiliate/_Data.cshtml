@* _AffiliateData.cshtml *@
@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th>@AccountingV2.CreatedDate</th>
                        <th>@AccountingV2.Code</th>
                        <th>@AccountingV2.Name</th>
                        <th>@AccountingV2.Active</th>
                        <th>@AccountingV2.HeadOffice</th>
                        @*<th>@AccountingV2.Deleted</th>
                        <th>@AccountingV2.ModifiedDate</th>*@
                        <th style="width:160px">@AccountingV2.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* DataTables will populate tbody via AJAX *@
                </tbody>
            </table>
        </div>
    </div>
</div>



