@model CBS.FrontDesk.Data.Entity.Accounting_V2.Affiliate.AffiliateCommand
@using Resources

<div class="modal-body">
    @using (Html.BeginForm("CreateOrUpdate", "Affiliate", FormMethod.Post, new { id = "affiliateForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="mt-2">
            <h4 class="mb-3 text-primary"><i class="mdi mdi-account-plus me-2"></i> @GlobalShared.Create</h4>

            <div class="row g-2">
                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = AccountingV2.placeholdercodetext , id = "code", maxlength = "50" })
                        <label for="code">@GlobalShared.Code</label>
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Affiliate name", id = "name", maxlength = "50" })
                        <label for="name">@GlobalShared.Name</label>
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActive" })
                        <label class="form-check-label fw-bold ms-2" for="isActive">@GlobalShared.IsActive</label>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsHeadOffice, new { @class = "form-check-input", id = "isHeadOffice" })
                        <label class="form-check-label fw-bold ms-2" for="isHeadOffice">@GlobalShared.Is_Head_Office</label>
                    </div>
                </div>
            </div>

            <div class="text-end">
                @if (string.IsNullOrWhiteSpace(Model?.Id))
                {
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> @GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2"><i class="mdi mdi-refresh"></i> @GlobalBank.Update</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                }
            </div>
        </div>
    }
</div>
