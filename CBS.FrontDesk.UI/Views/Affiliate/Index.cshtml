@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.NumConfig

@{
    ViewBag.Title = "Cheque Number Configuration";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-multiple-outline me-2"></i>@AccountingV2.AffiliateManagement
                </h1>
                <p class="card-text">
                    @AccountingV2.affiliatetext
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @AccountingV2.affilliatetext2
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-pound-box text-success me-2"></i>
                    <strong>@AccountingV2.Code:</strong>@AccountingV2.codetext1 , <code>BR001</code> or <code>HQ01</code>) @AccountingV2.codetext2 .
                </li>
                <li>
                    <i class="mdi mdi-form-textbox text-info me-2"></i>
                    <strong>@AccountingV2.Name:</strong>@AccountingV2.Nametext1 , <code>@AccountingV2.CentralBranch</code> or <code>@AccountingV2.HeadOffice</code>).
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-warning me-2"></i>
                    <strong>@AccountingV2.IsActive:</strong>@AccountingV2.IsActivetext
                </li>
                <li>
                    <i class="mdi mdi-office-building-marker text-primary me-2"></i>
                    <strong>@AccountingV2.IsHeadOffice:</strong>@AccountingV2.IsHeadOfficetext
                </li>
                <li>
                    <i class="mdi mdi-content-save text-secondary me-2"></i>
                    <strong>@AccountingV2.SaveorUpdate:</strong>@AccountingV2.Click <strong>@AccountingV2.Save</strong>@AccountingV2.affoiliatetext4 <strong>@AccountingV2.Update</strong>@AccountingV2.affiliatetext3
                </li>
                <li>
                    <i class="mdi mdi-refresh text-success me-2"></i>
                    <strong>@AccountingV2.Reset:</strong>@AccountingV2.resettext
                </li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-4">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("List", "Affiliate")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="@GlobalShared.ViewList">
                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
            </a>
            <a type="button"
               onclick="AddORUpdateGen(null,'datalistingview','_CreateAffiliate','new','Affiliate')"
               class="btn btn-label-secondary btn-sm"
               data-bs-toggle="tooltip" title="Add New Configuration">
                <i class="mdi mdi-plus mdi-18px"></i> Add
            </a>
        </div>
    </div>

    <!-- Placeholder for modals/forms -->
    @Html.Partial("_model")

    <!-- DataTable Partial -->
    <div id="datalistingview">
        @Html.Partial("_CreateAffiliate")
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")


}

