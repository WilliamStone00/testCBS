@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.NumConfig

@{
    ViewBag.Title = "Cheque Number Configuration";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-multiple-outline me-2"></i>@Affiliate.Affiliate_Management
                </h1>
                <p class="card-text">
                    @Affiliate.Create_and_manage_affiliates_within_your_organization_Each_affiliate_has_a_unique
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @Affiliate.Use_this_section_to_define_and_update_affiliate_details
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-pound-box text-success me-2"></i>
                    <strong>@Affiliate.Account_Number:</strong>@Affiliate.Enter_a_short_unique_identifier (e.g., <code>BR001</code> @GlobalShared.or <code>HQ01</code>) @Affiliate.for_each_affiliate .
                </li>
                <li>
                    <i class="mdi mdi-form-textbox text-info me-2"></i>
                    <strong>@GlobalShared.Name:</strong>@Affiliate.Provide_a_descriptive_name (e.g., <code>@GlobalShared.Central_Branch</code> @GlobalShared.or <code>@GlobalShared.HeadOffice</code>).
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-warning me-2"></i>
                    <strong>@GlobalShared.IsActive:</strong>@Affiliate.Enable_this_option_if_the_affiliate_is_currently_operational
                </li>
                <li>
                    <i class="mdi mdi-office-building-marker text-primary me-2"></i>
                    <strong>@GlobalShared.Is_Head_Office:</strong>@Affiliate.Check_this_box_to_mark_the_affiliate_as_the_main_administrative_or_head_office
                </li>
                <li>
                    <i class="mdi mdi-content-save text-secondary me-2"></i>
                    <strong>@GlobalShared.SaveorUpdate:</strong>@GlobalShared.Click <strong>@GlobalShared.Save</strong>@Affiliate.to_create_a_new_affiliate_or <strong>@GlobalShared.Update</strong>@Affiliate.to_modify_existing_details
                </li>
                <li>
                    <i class="mdi mdi-refresh text-success me-2"></i>
                    <strong>@GlobalShared.Reset:</strong>@Affiliate.Use_the_reset_button_to_clear_all_inputs_and_start_fresh
                </li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-4">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("List", "Affiliate")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="@GlobalShared.ViewList">
                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
            </a>
            <a type="button"
               onclick="AddORUpdateGen(null,'datalistingview','_CreateAffiliate','new','Affiliate')"
               class="btn btn-label-secondary btn-sm"
               data-bs-toggle="tooltip" title="Add New Configuration">
                <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add
            </a>
        </div>
    </div>

    <!-- Placeholder for modals/forms -->
    @Html.Partial("_model")

    <!-- DataTable Partial -->
    <div id="datalistingview">
        @Html.Partial("_CreateAffiliate")
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")


}

