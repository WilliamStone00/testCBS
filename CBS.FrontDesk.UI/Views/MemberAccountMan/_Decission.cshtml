@model CBS.FrontDesk.Data.Entity.MemberAccountManagement.ManageAccountStatusCommand

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h5 class="modal-title">
            <i class="mdi mdi-cog-outline me-2"></i>
            <span id="actionModalTitle">Process Request</span>
        </h5>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Approve or reject account status change requests. Provide a reason for your decision.
        </div>
        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
    </div>
</div>

<div class="card mb-4 border-0 bg-light">
    <div class="card-body py-3">
        <div class="row">
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Member Name</label>
                <p class="fw-bold text-dark mb-0">@Model.MemberName</p>
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Member Reference</label>
                <p class="fw-bold text-dark mb-0">@Model.MemberReference</p>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Account Number</label>
                <p class="fw-bold text-dark mb-0">@Model.AccountNumber</p>
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Account Type</label>
                <p class="fw-bold text-dark mb-0">@Model.AccountType</p>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Requested Action</label>
                <p class="fw-bold text-dark mb-0">@Model.Action</p>
            </div>
            <div class="col-6">
                <label class="form-label small text-muted mb-1">Current Status</label>
                <p class="fw-bold mb-0">
                    <span class="badge @(Model.Status switch {
                        "PendingApproval" => "bg-warning",
                        "Approved" => "bg-info",
                        "Rejected" => "bg-danger",
                        "Applied" => "bg-success",
                        "Failed" => "bg-dark",
                        "Cancelled" => "bg-secondary",
                        _ => "bg-secondary"
                    })">@Model.Status</span>
                </p>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <label class="form-label small text-muted mb-1">Request Reason</label>
                <p class="fw-bold text-dark mb-0">@Model.RequestReason</p>
            </div>
        </div>
    </div>
</div>

<form id="actionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="workflowId" name="workflowId" value="@Model.Id">
    <input type="hidden" id="decision" name="decision" value="">

    <div class="mb-3">
        <label for="decisionNote" class="form-label fw-bold text-dark">
            <i class="mdi mdi-text-box-edit-outline me-1"></i>
            Decision Note / Reason
            <span class="text-danger">*</span>
        </label>
        <textarea id="decisionNote" name="decisionNote" class="form-control" rows="5"
                  placeholder="Please provide a detailed reason for your decision. This information will be recorded in the request history."
                  required minlength="10"></textarea>
        <div class="form-text text-muted">
            <small>
                <i class="mdi mdi-information-outline me-1"></i>
                Required field. Minimum 10 characters.
            </small>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="mdi mdi-close-circle-outline me-1"></i> Cancel
        </button>
        <button type="button" class="btn btn-success me-2" id="actionApproveBtn">
            <i class="mdi mdi-check-circle-outline me-1"></i> Approve
        </button>
        <button type="button" class="btn btn-danger" id="actionRejectBtn">
            <i class="mdi mdi-close-circle-outline me-1"></i> Reject
        </button>
    </div>
</form>

