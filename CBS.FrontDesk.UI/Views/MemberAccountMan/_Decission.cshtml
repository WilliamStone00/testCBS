@model CBS.FrontDesk.Data.Entity.MemberAccountManagement.ManageAccountStatusCommand
@using CBS.FrontDesk.Data.Entity.MemberAccountManagement
@using Resources
<div class="card shadow-lg border-0">

    <!-- Card Body - Scrollable Area -->
    <div class="card-body p-4" style="max-height: 70vh; overflow-y: auto;">
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h5 class="modal-title">
                    <i class="mdi mdi-cog-outline me-2"></i>
                    <span id="actionModalTitle">@GlobalShared.update_account_status</span>
                </h5>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @GlobalMemberAccountMan.update_the_status_of_this_account_request_select_the_new_status_and_provide_a_reason.
                </div>
                <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
            </div>
        </div>

        <!-- Account Information Section -->
        <div class="card mb-4 border-0 bg-light">
            <div class="card-header bg-secondary bg-opacity-10 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="mdi mdi-account-details me-2"></i>@GlobalShared.Account_Information
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.Member_name</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@Model.MemberName</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.Member_reference</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@Model.MemberReference</p>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.Account_Number</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@Model.AccountNumber</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.Account_type</label>
                            <p class="fw-bold text-dark mb-0 fs-5">@Model.AccountType</p>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.requested_action</label><br>
                            <span class="badge bg-light bg-opacity-10 text-primary px-3 py-2 fs-6">@Model.Action</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.Current_Status</label><br>
                            @{
                                string badgeClass;
                                string statusText = Model.Status ?? "Unknown";

                                switch (statusText)
                                {
                                    case "PendingApproval":
                                    case "Pending Approval":
                                        badgeClass = "bg-warning text-dark";
                                        statusText = "Pending Approval";
                                        break;
                                    case "Approved":
                                        badgeClass = "bg-info text-white";
                                        break;
                                    case "Rejected":
                                        badgeClass = "bg-danger text-white";
                                        break;
                                    case "Applied":
                                        badgeClass = "bg-success text-white";
                                        break;
                                    case "Failed":
                                        badgeClass = "bg-dark text-white";
                                        break;
                                    case "Cancelled":
                                        badgeClass = "bg-secondary text-white";
                                        break;
                                    case "Draft":
                                        badgeClass = "bg-secondary text-white";
                                        break;
                                    default:
                                        badgeClass = "bg-secondary text-white";
                                        break;
                                }
                            }
                            <span class="badge @badgeClass px-3 py-2 fs-6">@statusText</span>
                        </div>
                    </div>
                </div>

                <!-- Request Details Section -->
                <div class="row g-3 mt-2">

                    <!-- Request Reason -->
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded shadow-sm">
                            <label class="text-muted small text-uppercase mb-1">@GlobalShared.request_reason</label>
                            <p class="fw-bold text-dark mb-0 fs-5">
                                @(string.IsNullOrEmpty(Model.RequestReason) ? "N/A" : Model.RequestReason)
                            </p>
                        </div>
                    </div>

                    <!-- Conditional Amount (Only for Partial Block/Unblock) -->
                    @if (Model.Action == AccountManagementAction.BlockPartial ||
                    Model.Action == AccountManagementAction.UnblockPartial)
                    {
                        <div class="col-md-6">
                            <div class="bg-white p-3 rounded shadow-sm">
                                <label class="text-muted small text-uppercase mb-1">@GlobalShared.Amount</label>
                                <p class="fw-bold text-dark mb-0 fs-5">
                                    @Model.Amount.ToString("N1")
                                </p>
                            </div>
                        </div>
                    }


                </div>


            </div>
        </div>

        <!-- Action Form Section -->
        <div class="card border-0 bg-light">
            <div class="card-header bg-secondary bg-opacity-10 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="mdi mdi-format-list-bulleted me-2"></i>@GlobalMemberAccountMan.status_update_form
                </h6>
            </div>
            <div class="card-body">
                <form id="actionForm" class="needs-validation" novalidate>
                    @Html.HiddenFor(m => m.Id)       <!-- keeps the normal Id binding -->
                    @Html.Hidden("workflowId", Model.Id) <!-- extra field with same value but different name -->

                    <div class="mb-4">
                        <label for="decisionStatus" class="form-label fw-bold text-dark">
                            <i class="mdi mdi-format-list-bulleted me-1 text-primary"></i>
                            @GlobalShared.Decision
                            <span class="text-danger">*</span>
                        </label>
                        <select id="decisionStatus" name="decisionStatus" class="form-control select2" required>
                            <option value="">-- @GlobalShared.select_new_status --</option>
                            <option value="Draft">@GlobalShared.draft</option>
                            <option value="PendingApproval">@GlobalShared.pending_approval</option>
                            <option value="Approve">@GlobalShared.Approved</option>
                            <option value="Reject">@GlobalShared.Rejected</option>
                            <option value="Cancel">@GlobalShared.Cancelled</option>
                            <option value="Apply">@GlobalShared.applied</option>
                            <option value="Fail">@GlobalShared.Failed</option>
                        </select>
                        <div class="invalid-feedback">
                            @GlobalShared.please_select_a_new_status.
                        </div>
                        <div class="form-text text-muted mt-2">
                            <small>
                                <i class="mdi mdi-information-outline me-1"></i>
                                @GlobalMemberAccountMan.select_the_new_status_for_this_request.
                            </small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="decisionNote" class="form-label fw-bold text-dark">
                            <i class="mdi mdi-text-box-edit-outline me-1 text-primary"></i>
                            @GlobalShared.decision_note / @GlobalShared.Reason
                            <span class="text-danger">*</span>
                        </label>
                        <textarea id="decisionNote" name="decisionNote" class="form-control" rows="4"
                                  placeholder="@GlobalMemberAccountMan.please_provide_a_detailed_reason_for_this_status_change."
                                  required minlength="5"></textarea>
                        <div class="invalid-feedback">
                            @GlobalShared.please_provide_a_reason (@GlobalShared.minimum_5_characters).
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <span id="noteCharCount">0</span>/500 characters
                            </small>
                        </div>
                    </div>

                    <!-- Additional Information Alert -->
                    <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                        <i class="mdi mdi-alert-circle-outline me-2 fs-5"></i>
                        <div>
                            <strong>@GlobalShared.Important:</strong> @GlobalMemberAccountMan.changing_the_status_will_trigger_workflow_actions.
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Card Footer - FIXED: Now at same level as card-body, not inside it -->
    <div class="card-footer bg-white border-top py-3">
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                <i class="mdi mdi-close-circle-outline me-1"></i> @GlobalShared.Cancel
            </button>
            <button type="button" class="btn btn-primary px-4" id="actionSubmitBtn">
                <i class="mdi mdi-content-save-outline me-1"></i> @GlobalShared.Submit
            </button>
        </div>
    </div>
</div>

