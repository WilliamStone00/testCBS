@model CBS.FrontDesk.Data.Entity.MemberAccountManagement.ManageAccountStatusCommand
@using Resources
@functions {
    string FormatDate(DateTime date)
    {
        return date != DateTime.MinValue ? date.ToString("dd/MM/yyyy") : string.Empty;
    }

    string FormatNullableDate(DateTime? date)
    {
        return date.HasValue && date.Value != DateTime.MinValue
            ? date.Value.ToString("dd/MM/yyyy")
            : string.Empty;
    }
}

<fieldset class="fieldset-custom">
    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-account-details me-2"></i> @GlobalMemberAccountMan.account_status_request_details
            </h1>
            <p class="card-text text-muted mb-1">
                @GlobalMemberAccountMan.complete_information_about_the_account_status_change_request
            </p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Account Information -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-account me-2"></i> @GlobalShared.Member_Information</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold" style="width: 40%;">Request ID:</td><td>@Model.Id</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Member_name:</td><td>@Model.MemberName</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Member_reference:</td><td>@Model.MemberReference</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Account_ID:</td><td>@Model.AccountId</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Account_Number:</td><td>@Model.AccountNumber</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Account_type:</td><td>@Model.AccountType</td></tr>
            </table>
        </div>

        <!-- Right Column - Branch Information -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-domain me-2"></i> @GlobalShared.Branch_Information</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold" style="width: 40%;">Branch ID:</td><td>@Model.BranchId</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Branch_Name:</td><td>@Model.BranchName</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Branch_Code:</td><td>@Model.BranchCode</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Correlation_Id:</td><td>@Model.CorrelationId</td></tr>
            </table>
        </div>
    </div>

    <!-- Action Details -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> @GlobalShared.action_details</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold" style="width: 20%;">@GlobalShared.Action:</td><td>@Model.Action</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Status:</td><td>@Model.Status</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Amount:</td><td>@Model.Amount.ToString("N2")</td></tr>
                <tr><td class="fw-bold">@GlobalShared.effective_date:</td><td>@FormatNullableDate(Model.EffectiveDate)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.request_reason:</td><td>@Model.RequestReason</td></tr>
                @if (!string.IsNullOrEmpty(Model.DecisionNote))
                {
                    <tr><td class="fw-bold">@GlobalShared.decision_note:</td><td>@Model.DecisionNote</td></tr>
                }
                @if (!string.IsNullOrEmpty(Model.BlockReason))
                {
                    <tr><td class="fw-bold">@GlobalShared.block_reason:</td><td>@Model.BlockReason</td></tr>
                }
            </table>
        </div>
    </div>

    <!-- Request Timeline -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> @GlobalMemberAccountMan.request_timeline</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <td class="fw-bold" style="width: 20%;">@GlobalShared.Requested_by:</td>
                    <td>@Model.RequestedByName</td>
                    <td class="fw-bold" style="width: 20%;">@GlobalShared.requested_on:</td>
                    <td>@FormatNullableDate(Model.RequestedOn)</td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.DecidedByName))
                {
                    <tr>
                        <td class="fw-bold">@GlobalShared.decided_by:</td>
                        <td>@Model.DecidedByName</td>
                        <td class="fw-bold">Decided On:</td>
                        <td>@FormatNullableDate(Model.DecidedOn)</td>
                    </tr>
                }
                @if (Model.AppliedOn > DateTime.MinValue)
                {
                    <tr>
                        <td class="fw-bold">Applied On:</td>
                        <td colspan="3">@FormatNullableDate(Model.AppliedOn)</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.ApplyError))
                {
                    <tr>
                        <td class="fw-bold text-danger">@GlobalShared.apply_error:</td>
                        <td colspan="3" class="text-danger">@Model.ApplyError</td>
                    </tr>
                }

            </table>
        </div>
    </div>

    <!-- Status Badge -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            @{
                string badgeClass = "bg-secondary";
                switch (Model.Status)
                {
                    case "PendingApproval":
                        badgeClass = "bg-warning";
                        break;
                    case "Approved":
                        badgeClass = "bg-info";
                        break;
                    case "Rejected":
                        badgeClass = "bg-danger";
                        break;
                    case "Applied":
                        badgeClass = "bg-success";
                        break;
                    case "Failed":
                        badgeClass = "bg-dark";
                        break;
                    case "Cancelled":
                        badgeClass = "bg-secondary";
                        break;
                }
            }
            <span class="badge @badgeClass p-3" style="font-size: 1.2rem;">
                @GlobalShared.Current_Status: @Model.Status
            </span>
        </div>
    </div>
</fieldset>