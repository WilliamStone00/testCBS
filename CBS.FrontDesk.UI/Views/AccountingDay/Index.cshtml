<script type="text/javascript">

    function AjaxPostAndUpdateOpenCloseOfDay(form) {
        console.log("Form Action:", form.action);
        console.log("Form Method:", form.method);

        if (!validateDate()) return false;

        var formData = new FormData(form);
        for (var pair of formData.entries()) console.log(pair[0] + ', ' + pair[1]);

        $.validator.unobtrusive.parse(form);
        if (!$(form).valid()) return false;

        // ---------- Gather context ----------
        var selectedRaw = $('#dateInput').val(); // "yyyy-MM-ddTHH:mm"
        var selected = selectedRaw ? new Date(selectedRaw) : null;

        var now = new Date();
        var todayDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var selectedDateOnly = selected ? new Date(selected.getFullYear(), selected.getMonth(), selected.getDate()) : null;
        var isPastDate = !!selected && (selectedDateOnly < todayDateOnly);

        var selectedAction = ($('input[name="OpenOrCloseAccountingDay"]:checked').val() || '').trim() || 'N/A';
        var isCentralized = $('#centralizeOptionCheckbox').is(':checked');

        var selectedBranchesTexts = $('#branchesSelection input.form-check-input[type="checkbox"][id^="branch_"]:checked')
            .map(function () { return $(this).closest('.form-check').find('label').text().trim(); })
            .get();
        var branchCount = selectedBranchesTexts.length;
        var branchListPreview = branchCount
            ? (selectedBranchesTexts.slice(0, 5).join(', ') + (branchCount > 5 ? (' … (+' + (branchCount - 5) + ' more)') : ''))
            : 'None';

        // ---------- Helpers ----------
        var requiredPhrase = 'i confirmed and acknowledge'; // exact phrase (case-insensitive)
        var fmtDateTime = function (d) {
            if (!d) return 'N/A';
            const pad = n => (n < 10 ? '0' + n : n);
            return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear()
                + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        };
        var fmtToday = (function (d) {
            const pad = n => (n < 10 ? '0' + n : n);
            return pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
        })(now);

        // ---------- Build dialog body ----------
        var summaryHtml = `
        <div class="border rounded p-2 mb-2">
            <h6 class="mb-2">Review Summary</h6>
            <ul class="mb-0">
                <li><strong>Today:</strong> ${fmtToday}</li>
                <li><strong>Accounting Date:</strong> ${fmtDateTime(selected)}</li>
                <li><strong>Action:</strong> ${selectedAction}</li>
                <li><strong>Centralized Opening:</strong> ${isCentralized ? 'Yes' : 'No'}</li>
                <li><strong>Branches Selected:</strong> ${branchCount} (${branchListPreview})</li>
            </ul>
        </div>
        <div id="ackErrorsGeneral"></div>
        <div class="form-check mb-2">
            <input type="checkbox" id="ackGeneral" class="form-check-input">
            <label for="ackGeneral" class="form-check-label">
                I have reviewed the summary above and understand this action will be applied to the selected branches.
            </label>
        </div>
    `;

        var pastWarning = `
        <div class="border rounded p-2 mb-2">
            <div class="alert alert-warning mb-2">
                <strong>Past Accounting Date Selected</strong><br/>
                You selected <u>${fmtDateTime(selected)}</u>, which is <em>earlier</em> than today (${fmtToday}).
            </div>
            <div id="ackErrors"></div>
            <div class="mb-2">
                <label for="ackPhrase" class="form-label">Type this phrase to proceed:</label>
                <input type="text" id="ackPhrase" class="form-control"
                       placeholder='Type: "I confirmed and acknowledge"'>
                <small class="text-muted">Phrase must match exactly (case-insensitive).</small>
            </div>
            <div class="form-check">
                <input type="checkbox" id="ackCheckbox" class="form-check-input">
                <label for="ackCheckbox" class="form-check-label">
                    I understand I am posting for a past accounting date.
                </label>
            </div>
        </div>
    `;

        var baseMsg = `<p>Are you sure you want to perform this action?</p>`;
        var dialogHtml = summaryHtml + (isPastDate ? pastWarning : '') + baseMsg;

        // ---------- AJAX config ----------
        var ajaxConfig = {
            type: $(form).attr('method') || 'POST',
            url: form.action,
            data: formData,
            contentType: false,   // FormData
            processData: false,   // FormData
            cache: false,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (response) {
                console.log("Response:", response);
                if (response.success) {
                    if (response.status === "Exist") {
                        appalert(response.message, 3, 1);
                    } else if (response.status === "Failed") {
                        appalert(response.message, 2, 1);
                    } else {
                        appalert(response.message, 1, 1);
                    }

                    if (response.option === 'Update' && response.reloadDataView === "Yes") {
                        LoadDataMain(response.controllerName, response.option, response.divLoaderList, response.tableName, response.dataLoaderActionName, "KEY", "List");
                    } else if (response.optype === 'Insert' && response.reloadDataView === "Yes") {
                        EditResetMain("KEY", response.option, response.divLoaderCreator, response.controllerName, response.reinitializedActionName, response.groupID);
                    } else if (response.reloadDataView === "Yes") {
                        LoadDataMain(response.controllerName, response.option, response.divLoaderList, response.tableName, response.dataLoaderActionName, "KEY", "List");
                    }
                } else {
                    if (response.Status === "Exist") {
                        appalert(response.message, 3, 1);
                    } else {
                        appalert(response.message, 2, 1);
                    }
                }
            },
            error: function (err) {
                console.log("Error:", err);
                if (err.status === 401) {
                    window.location.href = '/Authentication/Login';
                } else {
                    appalert(err.statusText, 0, 1);
                }
            }
        };

        // ---------- Alertify dialog (Proceed before Cancel) ----------
        var dlg = alertify.confirm().set({
            title: 'Confirmation',
            labels: { ok: 'Proceed', cancel: 'Cancel' }, // Proceed first
            reverseButtons: false,                       // keep default order: OK then Cancel
            closable: true,
            movable: true,
            onok: function (ev) {
                // Always require the general acknowledgment
                var generalTicked = $('#ackGeneral').is(':checked');
                if (!generalTicked) {
                    if (ev && typeof ev.preventDefault === 'function') ev.preventDefault();
                    $('#ackErrorsGeneral').html('<div class="alert alert-danger mb-2">Please tick the general confirmation checkbox.</div>');
                    return false;
                }

                // For past date, enforce typed phrase + checkbox
                if (isPastDate) {
                    var typed = ($('#ackPhrase').val() || '').trim().toLowerCase();
                    var ticked = $('#ackCheckbox').is(':checked');
                    var errors = [];
                    if (typed !== requiredPhrase) errors.push('Please type the exact phrase: "I confirmed and acknowledge".');
                    if (!ticked) errors.push('Please tick the past-date confirmation checkbox.');
                    if (errors.length) {
                        if (ev && typeof ev.preventDefault === 'function') ev.preventDefault(); // keep dialog open
                        $('#ackErrors').html('<div class="alert alert-danger mb-2">' + errors.join('<br/>') + '</div>');
                        return false;
                    }
                }

                // Passed checks → submit
                console.log("AJAX Config:", ajaxConfig);
                $.ajax(ajaxConfig);
            },
            oncancel: function () {
                appalert('Transaction cancelled', 3, 1);
            }
        });

        if (typeof dlg.setContent === 'function') dlg.setContent(dialogHtml);
        else if (typeof dlg.setting === 'function') dlg.setting('message', dialogHtml);

        dlg.show();
        return false;
    }


