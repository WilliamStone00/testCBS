    $(document).ready(function () {
       
        updateBranchesVisibility();
        toggleBranchSelection();

        $("#checkAllBranches").change(function () {
            var isChecked = $(this).is(":checked");
            $(".branch-item input[type=checkbox]").prop("checked", isChecked);
        });

        $("#branchSearch").on("input", function () {
            var searchValue = $(this).val().toLowerCase();
            $(".branch-item").each(function () {
                var branchName = $(this).data("branch-name").toLowerCase();
                $(this).toggle(branchName.indexOf(searchValue) > -1);
            });
        });

        $("#centralizeOptionCheckbox").change(function () {
            toggleBranchSelection();
        });

        function updateBranchesVisibility() {
            var branchCount = $(".branch-item").length;
            if (branchCount <= 1) {
                $("#centralizeOptionWrapper").hide();
                $("#branchSearchWrapper").hide();
                $("#selectAll").hide();
                $(".branch-item input[type=checkbox]").prop("checked", true);
                $(".branch-item input[type=checkbox]").prop("disabled", true);
                $("#checkAllBranches").hide();
            } else {
                $("#centralizeOptionWrapper").show();
                $("#selectAll").show();
                $("#branchSearchWrapper").show();
                $(".branch-item input[type=checkbox]").prop("disabled", false);
                $("#checkAllBranches").show();
            }
        }

        function toggleBranchSelection() {
            var isCentralized = $('#centralizeOptionCheckbox').is(':checked');
            $('#branchSearchWrapper, #branchesSelection .branch-list, #checkAllBranchesWrapper').toggle(!isCentralized);
        }
    });
    function validateDate() {
        var dateInput = document.getElementById("dateInput").value;
        var selectedDate = new Date(dateInput);

        // Normalize both dates to the start of the day (midnight)
        selectedDate.setHours(0, 0, 0, 0);

        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);

        if (selectedDate > currentDate) {
            appalert("The Date cannot be greater than today's date.", 2, 1);
            return false;
        }

        return true;
    }


