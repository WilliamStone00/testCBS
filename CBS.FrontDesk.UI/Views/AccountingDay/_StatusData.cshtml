@using Resources
<fieldset class="fieldset-custom" id="queryFieldset" style="display: none;">
    <legend id="select_base" style="font-size: 14px;">@AccountingDay_StatusData.AccountingDaysHistories</legend>
    <hr style="border: 2px solid blue;" />
    <div id="dataTableContainer" style="display: none;">
        <div class="table-responsive mb-3">
            <table class="table table-striped table-hover" id="myDataTable" style="border-collapse: collapse; width: 100%;">
                <thead>
                    <tr>
                        <th style="border: 1px solid black; box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); padding: 8px;">@AccountingDay_StatusData.BranchName</th>
                        <th style="border: 1px solid black; box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); padding: 8px;">@AccountingDay_StatusData.OpenDay</th>
                        <th style="border: 1px solid black; box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); padding: 8px;">@AccountingDay_StatusData.Time</th>
                        <th style="border: 1px solid black; box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); padding: 8px;">@AccountingDay_StatusData.Status</th>
                        <th style="border: 1px solid black; box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); padding: 8px;">@AccountingDay_StatusData.Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data rows will be inserted here -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Data not found message container -->
    <div id="dataNotFound" style="display: none;">
        <p class="alert alert-warning mb-0">@AccountingDay_StatusData.NoDataFound.</p>
    </div>
</fieldset>
