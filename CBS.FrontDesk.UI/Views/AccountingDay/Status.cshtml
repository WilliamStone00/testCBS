@{
    ViewBag.Title = "Accounting Day Status";
}
@using Resources



<div class="row">
    <div class="col-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-excel me-2"></i> @AccountingDay_StatusData.AccountingDayStatus
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            <br />
                                            @Html.Partial("_StatusQuery")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="accountingDayModal" tabindex="-1" aria-labelledby="accountingDayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-4">
            <div class="modal-header border-0">
                <h4 class="modal-title text-center w-100" id="modalLabel"> @AccountingDay_StatusData.ACCOUNTINGDAYDETAILS</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr />
            <div class="modal-body">
                <div id="modalContent">

                </div>
            </div>
            <hr />
            <div class="modal-footer border-0">
                <div class="text-center w-100">
                    <small class="text-muted"> @AccountingDay_StatusData.PoweredByFLXCBS</small>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/AccountingDay/AccountingDayStatus.js"></script>
}










