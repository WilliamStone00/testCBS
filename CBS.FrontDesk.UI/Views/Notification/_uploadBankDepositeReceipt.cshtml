@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

<div class="card-body">

    @if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
    {

        @Html.Partial("_GeneralErrorDiv")
    }

    @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostBankTransaction(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->


        @Html.HiddenFor(m => m.UploadBankReciept.Id)


        <input type="hidden" name="ServiceOption" value="UploadBankDepositReceipt" id="ServiceOption" />

        <fieldset class="fieldset-custom">
            <legend id="select_base">Bank Deposit Reciept Identification</legend>
            <div class="row">
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.UploadBankReciept.BankTransactionReference, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.UploadBankReciept.BankTransactionReference, "", new { @class = "text-danger" })

                        <label for="Amount"> Bank Transaction Reference</label>
                    </div>
                </div>
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @*   @Html.TextAreaFor(m => m.BankCashOut.ValueDate, new { @class = "form-control", @style = "height: 200px;" })*@
                        @Html.TextBoxFor(model => model.UploadBankReciept.ValueDate, new { @class = "form-control date-picker", @type = "datetime-local", @id = "html5-datetime-local-input" })
                        @Html.ValidationMessageFor(model => model.UploadBankReciept.ValueDate, "", new { @class = "text-danger" })

                        <label for="ValueDate">Date Of Bank CashOut</label>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @*   @Html.TextAreaFor(m => m.BankCashOut.ValueDate, new { @class = "form-control", @style = "height: 200px;" })*@
                        @Html.TextAreaFor(model => model.UploadBankReciept.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(model => model.UploadBankReciept.Description, "", new { @class = "text-danger" })


                        <label>Naration</label>
                    </div>
                </div>
                <div class="col-md-6 mb-sm-4">
                    <div class="upload-container">
                        <div class="image-preview">
                            <img src="@Url.Content(Model.UploadBankReciept.FileUpload)" alt="No Image Found" id="previewimage" class="img-fluid" />
                        </div>
                        <label for="imageuploadSignature" class="custom-file-upload">
                            <i class="fas fa-cloud-upload-alt"></i> Choose Photo
                        </label>
                        <input type="file" name="UploadBankReciept.UploadedFile" accept="image/jpeg,image/png,image/JPG" id="imageuploadSignature" onchange="ShowImagePreview(this, document.getElementById('previewimage'))" />
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary me-2" id="btnSave">Validate</button>
            <input type="hidden" name="Action" value="insert" id="Action" />

        </div>

    }






</div>

