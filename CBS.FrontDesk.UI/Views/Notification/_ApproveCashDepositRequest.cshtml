@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = "View Cash Deposit Request Details";

}
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{

    @Html.Partial("_GeneralErrorDiv")
}
<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    @GlobalNotification.request_reference_id :@Model.DepositNotificationDto.Id @GlobalShared.Amount : XFA @Model.DepositNotificationDto.Amount
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@GlobalNotification.cash_replenishment_details</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>@GlobalShared.Branch_Office</td>
                                    <td>@Model.DepositNotificationDto.BranchOffice </td>
                                </tr>
                            }

                            <tr>
                                <td>@GlobalNotification.amount_to_deposit</td>
                                <td>XAF @{(Convert.ToDecimal(Model.DepositNotificationDto.Amount)).ToString("N");} </td>
                            </tr>
                            <tr>
                                <td> @GlobalShared.Message</td>
                                <td>@Model.DepositNotificationDto.Message </td>
                            </tr>
                            <tr>
                                <td>@GlobalShared.Issued_By </td>
                                <td> @Model.DepositNotificationDto.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>@GlobalShared.Issued_Date</td>
                                <td>@Model.DepositNotificationDto.IssueDate </td>
                            </tr>
                            <tr>
                                <td>@GlobalShared.Status</td>
                                @if (@Model.DepositNotificationDto.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.DepositNotificationDto.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-title">@GlobalNotification.bank_deposit_request_status</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.DepositNotificationDto.IsApproved)
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">@GlobalNotification.the_deposit_cash_request_of_fcfa @{(Convert.ToDecimal(Model.DepositNotificationDto.Amount)).ToString("N");} @GlobalShared.Issued_By @Model.DepositNotificationDto.IssuedBy @GlobalShared.is_already_approved.</h6>

                                </div>
                            }
                            else
                            {<div class="alert alert-outline-primary" role="alert">
                                 <h6 class="alert-heading mb-1">@GlobalShared.reference_id :@Model.DepositNotificationDto.Id  @GlobalNotification.with_amount XFA @{(Convert.ToDecimal(Model.DepositNotificationDto.Amount)).ToString("N");} @GlobalShared.has_not_yet_been_approved</h6>
                                 <p class="mb-0">@GlobalNotification.select_source_account_to_which_the_vault_will_be </p>
                                </div>
                            }

                        </div>
                        @if (@Model.DepositNotificationDto.IsApproved)
                        {

                        }
                        else
                        {
                            using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                            {
                                <!-- Account Details -->

                                @Html.HiddenFor(model => model.DepositNotificationDto.Id)
                                <input type="hidden" name="option" value="" id="option" />
                                <input type="hidden" name="ServiceOption" value="DepositNotificationApproval" id="ServiceOption" />
                                <input type="hidden" id="selectedID" name="selectedID" value="" />
                                if (Model.DepositNotificationDto.IsApproved)
                                {
                                    <div class="form-check mb-3">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.DepositNotificationDto.IsApproved, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalShared.the_cash_replenishment_request_of_issued_by @Model.DepositNotificationDto.IssuedBy @GlobalShared.has_been_approved</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">@GlobalNotification.already_approved_account_replenishment</button>
                                    </div>

                                }
                                else
                                {

                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">

                                            @Html.DropDownListFor(m => m.DepositNotificationDto.Status, new SelectList(ViewBag.DepositDecisions == null ? "" : ViewBag.DepositDecisions, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.Status, "", new { @class = "text-danger" })
                                            <label for="Account">@GlobalShared.make_decision</label>
                                        </div>
                                    </div>
                                    <div id="hideBranchID">
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.correpondingBranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "correpondingBranchId" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.correpondingBranchId, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalShared.Select_Branch</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="hideAccountId">
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.BankAccountId, new SelectList(ViewBag.Branch == null ? "" : ViewBag.Branch, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.BankAccountId, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalNotification.select_bank_account </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.DepositNotificationDto.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.ApprovedMessage, "", new { @class = "text-danger" })

                                            <label for="Description"> @GlobalShared.Comment</label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Validate</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />

                                    </div>

                                }



                            }

                        }


                    </div>
                                </div>

            </div>
        </div>


    </div>
</div>


