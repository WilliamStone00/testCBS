@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "View Cash Deposit Request Details";

}
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{

    @Html.Partial("_GeneralErrorDiv")
}
<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId :@Model.DepositNotificationDto.Id Amount : XFA @Model.DepositNotificationDto.Amount
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Cash Replenishment Details</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>Branch Office</td>
                                    <td>@Model.DepositNotificationDto.BranchOffice </td>
                                </tr>
                            }

                            <tr>
                                <td>Amount to deposit</td>
                                <td>XAF @Model.DepositNotificationDto.Amount.ToString("N") </td>
                            </tr>
                            <tr>
                                <td> Message</td>
                                <td>@Model.DepositNotificationDto.Message </td>
                            </tr>
                            <tr>
                                <td>Issued By </td>
                                <td> @Model.DepositNotificationDto.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>Issued Date</td>
                                <td>@Model.DepositNotificationDto.IssueDate </td>
                            </tr>
                            <tr>
                                <td>Status</td>
                                @if (@Model.DepositNotificationDto.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.DepositNotificationDto.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-title">Bank Deposit Request Status</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.DepositNotificationDto.IsApproved)
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">The deposit cash request of FCFA @Model.DepositNotificationDto.Amount.ToString("N") Issued by @Model.DepositNotificationDto.IssuedBy is already approved.</h6>

                                </div>
                            }
                            else
                            {<div class="alert alert-outline-primary" role="alert">
                                    <h6 class="alert-heading mb-1">ReferenceId :@Model.DepositNotificationDto.Id  with Amount XFA @Model.DepositNotificationDto.Amount.ToString("N") has not yet been approved</h6>
                                    <p class="mb-0">Select source account to which the vault will be </p>
                                </div>
                            }

                        </div>
                        @if (@Model.DepositNotificationDto.IsApproved)
                        {

                        }
                        else
                        {
                            using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                            {
                                <!-- Account Details -->

                                @Html.HiddenFor(model => model.DepositNotificationDto.Id)
                                <input type="hidden" name="option" value="Status" id="option" />
                                <input type="hidden" name="ServiceOption" value="DepositNotificationApproval" id="ServiceOption" />
                                if (Model.DepositNotificationDto.IsApproved)
                                {
                                    <div class="form-check mb-3">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.DepositNotificationDto.IsApproved, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">The cash replenishment request of issued by @Model.DepositNotificationDto.IssuedBy has been approved</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Already Approved Account Replenishment</button>
                                    </div>

                                }
                                else
                                {

                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">

                                            @Html.DropDownListFor(m => m.DepositNotificationDto.ApprovedBy, new SelectList(ViewBag.DepositDecisions == null ? "" : ViewBag.DepositDecisions, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.ApprovedBy, "", new { @class = "text-danger" })
                                            <label for="Account">Make decision</label>
                                        </div>
                                    </div>
                                    if (Model.DepositNotificationDto.HasBankAccount)
                                    {
                                        @Html.HiddenFor(m => m.DepositNotificationDto.BankAccountId)
                                        @Html.HiddenFor(m => m.DepositNotificationDto.BankAccountOwner)
                                    }
                                    else
                                    {
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.BankAccountOwner, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "BranchID" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.BankAccountOwner, "", new { @class = "text-danger" })
                                                <label for="Account">Select Account Owner</label>
                                            </div>
                                        </div>
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.DepositNotificationDto.BankAccountId, new SelectList(ViewBag.Branch == null ? "" : ViewBag.Branch, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "LoadBankAccountID" })
                                                @Html.ValidationMessageFor(model => model.DepositNotificationDto.BankAccountId, "", new { @class = "text-danger" })
                                                <label for="Account">Select Bank Account </label>
                                            </div>
                                        </div>
                                    }

                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.DepositNotificationDto.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                            @Html.ValidationMessageFor(model => model.DepositNotificationDto.ApprovedMessage, "", new { @class = "text-danger" })

                                            <label for="Description"> Comment</label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary me-2">Validate</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />

                                    </div>

                                }



                            }

                        }


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>


