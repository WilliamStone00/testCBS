@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = "View Cash Replenishment Details";
}
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{

    @Html.Partial("_GeneralErrorDiv")
}

    <div class="row invoice-preview">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-bank-plus me-2"></i>
                        @GlobalNotification.request_reference_id :@Model.CashReplenimentRequestdto.Id @GlobalShared.Amount : XFA @Model.CashReplenimentRequestdto.AmountRequested
                    </button>
                </h2>
                <div class="card-body">

                    <br />
                    <div class="collapse show">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>@GlobalNotification.cash_replenishment_details</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody class="table-border-bottom-0">
                                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                                {
                                    <tr>
                                        <td>@GlobalShared.Branch_Office</td>
                                        <td>@Model.CashReplenimentRequestdto.BranchOffice </td>
                                    </tr>
                                }
                                <tr>
                                    <td>@GlobalNotification.invoice_number</td>
                                    <td>@Model.CashReplenimentRequestdto.ReferenceId </td>
                                </tr>
                                <tr>
                                    <td>@GlobalShared.Amount Requested</td>
                                    <td>XAF @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") </td>
                                </tr>
                                <tr>
                                    <td>@GlobalNotification.request_message</td>
                                    <td>@Model.CashReplenimentRequestdto.RequestMessage </td>
                                </tr>
                                <tr>
                                    <td>@GlobalShared.Requested_by </td>
                                    <td> @Model.CashReplenimentRequestdto.TempId1 </td>
                                </tr>
                                <tr>
                                    <td>@GlobalShared.Requested_Date</td>
                                    <td>@Model.CashReplenimentRequestdto.IssuedDate </td>
                                </tr>
                                <tr>
                                    <td>@GlobalShared.Status</td>
                                    @if (@Model.CashReplenimentRequestdto.IsApproved)
                                    {
                                        <td class="badge bg-label-success rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequestdto.Status
                                        </td>

                                    }
                                    else
                                    {
                                        if (@Model.CashReplenimentRequestdto.Status.ToUpper().Equals("PENDING"))
                                        {
                                            <td class="badge bg-label-primary rounded-pill text-uppercase">
                                                @Model.CashReplenimentRequestdto.Status
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="badge bg-label-danger rounded-pill text-uppercase">
                                                @Model.CashReplenimentRequestdto.Status
                                            </td>
                                        }

                                    }

                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card card-action mb-5">
                        <h5 class="card-title">@GlobalNotification.cash_replenishment_request_status</h5>
                        <div class="card-body">
                            <div class="mb-3 col-12 mb-0">
                                @if (@Model.CashReplenimentRequestdto.IsApproved)
                                {
                                    <div class="alert alert-outline-success" role="alert">
                                        <h6 class="alert-heading mb-1">@GlobalNotification.TheCashReplenishmentRequestOf @Model.CashReplenimentRequestdto.TempId1 @GlobalShared.is_already_approved.</h6>
                                        <p class="mb-0">@Model.CashReplenimentRequestdto.AmountApproved.ToString("N") @GlobalNotification.wasReplenished</p>
                                    </div>
                                }
                                else
                                {<div class="alert alert-outline-primary" role="alert">
                                     <h6 class="alert-heading mb-1">@GlobalShared.reference_id :@Model.CashReplenimentRequestdto.Id  @GlobalNotification.with_amount XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") @GlobalShared.has_not_yet_been_approved</h6>
                                     <p class="mb-0">@GlobalNotification.select_source_account_to_which_the_vault_will_be </p>
                                    </div>
                                }

                            </div>
                            @if (@Model.CashReplenimentRequestdto.IsApproved)
                            {

                            }
                            else
                            {
                                using (Html.BeginForm("AddOrUpdate", "Notification", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdateValidationDecision(this);", @id = "formValidationExamples" }))
                                {
                                    <!-- Account Details -->
                                    @Html.HiddenFor(v => v.CashReplenimentRequestdto.BranchId)
                                    @Html.HiddenFor(model => model.CashReplenimentRequestdto.Id)
                                    <input type="hidden" name="option" value="Status" id="option" />
                                    <input type="hidden" name="ServiceOption" value="CashRequestApproval" id="ServiceOption" />
                                    if (Model.CashReplenimentRequestdto.IsApproved)
                                    {
                                        <div class="form-check mb-3">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.CashReplenimentRequestdto.IsApproved, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalShared.the_cash_replenishment_request_of_issued_by @Model.CashReplenimentRequestdto.TempId1 @GlobalShared.has_been_approved_by @Model.CashReplenimentRequestdto.TempId2</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary">@GlobalNotification.already_approved_account_replenishment</button>
                                        </div>

                                    }
                                    else
                                    {
                                        @*if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                                            {
                                                <div class="form-check mb-3">
                                                    <div class="form-floating form-floating-outline">

                                                        @Html.DropDownListFor(m => m.CashReplenimentRequestdto.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                        @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.BranchId, "", new { @class = "text-danger" })
                                                        <label for="Account">Branch Office</label>
                                                    </div>
                                                </div>
                                            }*@

                                        @*<div class="form-check mb-3">
                                                <div class="form-floating form-floating-outline">

                                                    @Html.DropDownListFor(m => m.CashReplenimentRequestdto.AccountId, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                    @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.AccountId, "", new { @class = "text-danger" })
                                                    <label for="Account">Select debiting account</label>
                                                </div>
                                            </div>*@
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.CashReplenimentRequestdto.TempId2, new SelectList(ViewBag.Decisions == null ? "" : ViewBag.Decisions, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "CorrespondingBranchID" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.ApprovedBy, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalShared.make_decision</label>
                                            </div>
                                        </div>
                                        <div class="form-check mb-3" id="hideBranchID">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.CashReplenimentRequestdto.CorrespondingBranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.CorrespondingBranchId, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalShared.Select_Branch</label>
                                            </div>
                                        </div>
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.CashReplenimentRequestdto.AmountApproved, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.AmountApproved, "", new { @class = "text-danger" })

                                                <label for="Description"> @GlobalShared.Approved_Amount</label>
                                            </div>
                                        </div>
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.CashReplenimentRequestdto.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.ApprovedMessage, "", new { @class = "text-danger" })

                                                <label for="Description"> @GlobalShared.approved_message_description</label>
                                            </div>
                                        </div>
                                        <div class="col-12 text-end">
                                            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Validate</button>
                                            <input type="hidden" name="Action" value="insert" id="Action" />

                                        </div>

                                    }



                                }

                            }


                        </div>
                    </div>

                </div>
            </div>


        </div>
    </div>




