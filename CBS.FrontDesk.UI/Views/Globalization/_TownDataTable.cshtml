@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel
@using Resources
<!-- Town Table -->
<hr />
<h6 class="text-secondary mb-3"><i class="bi bi-list-check"></i> @GlobalGlobalization.Existing_Towns</h6>

<div class="table-responsive">
    <table id="townTable" class="table table-bordered table-striped table-hover table-sm w-100">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.SubDivision</th>
                <th>@GlobalGlobalization.Town_Name</th>
                <th style="width: 120px;">@GlobalShared.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Towns != null && Model.Towns.Count > 0)
            {
                foreach (var town in Model.Towns)
                {
                    <tr>
                        <td>@town.SubdivisionName</td>
                        <td>@town.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="openGlobalizationModal(
                                            '@town.Id',
                                            'globalizationModal',
                                            'globalizationFormContainer',
                                            'Globalization',
                                            'InitializeData',
                                            '_TownForm',
                                            '',
                                            'Edit Town',
                                            'globalizationModalTitleText',
                                            'id'
                                        )">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteEntity({
                                            key: '@town.Id',
                                            type: 'town',
                                            deleteUrl: '/Globalization/Delete',
                                            reloadUrl: '/Globalization/InitializeData',
                                            containerId: 'townTableContainer',
                                            partialView: '_TownDataTable',
                                            path: 'town',
                                            parentKey: '@town.SubdivisionId'
                                        })">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        <i class="bi bi-info-circle me-1"></i> @GlobalGlobalization.No_towns_found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
