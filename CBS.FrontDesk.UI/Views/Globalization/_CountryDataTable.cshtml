@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel
@using Resources
<hr />
<h6 class="text-secondary mb-3"><i class="bi bi-list-check"></i> @GlobalShared.Existing_Countries</h6>

<div class="table-responsive">
    <table id="countryTable" class="table table-bordered table-striped table-hover table-sm w-100">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.Code</th>
                <th>@GlobalShared.Name</th>
                <th style="width: 120px;">@GlobalShared.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Countries != null && Model.Countries.Count > 0)
            {
                foreach (var country in Model.Countries)
                {
                    <tr>
                        <td>@country.Code</td>
                        <td>@country.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="AddORUpdateGen('@country.Id', 'countryFormContainer', '_CountryForm', 'update', 'Globalization', null, null)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteEntity({
                                            key: '@country.Id',
                                            type: 'country',
                                            deleteUrl: '/Globalization/Delete',
                                            reloadUrl: '/Globalization/InitializeData',
                                            containerId: 'countryTableContainer',
                                            partialView: '_CountryDataTable',
                                            path: 'list'
                                        })">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        <i class="bi bi-info-circle me-1"></i> @GlobalShared.No_countries_found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
