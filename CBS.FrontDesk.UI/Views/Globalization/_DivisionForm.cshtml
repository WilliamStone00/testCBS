@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel

<!-- Section Title -->
<div class="col-12">
    <h6 class="text-primary border-bottom pt-2 pb-2">
        <i class="bi bi-diagram-3"></i> Division Management
    </h6>
</div>

<!-- Division Form -->
@using (Html.BeginForm("SaveDivision", "Globalization", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <div class="row g-3 mb-4" id="divisionForm">
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                <select id="RegionId" name="Division.RegionId" class="form-select select2" required>
                    <option value="">--- Select Region ---</option>
                    @foreach (var region in Model.Regions)
                    {
                        <option value="@region.Id">@region.Name</option>
                    }
                </select>
                <label for="RegionId">Region</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                <input type="text" name="Division.Name" class="form-control" placeholder="Division Name" required />
                <label>Division Name</label>
            </div>
        </div>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-success px-4">
                <i class="bi bi-save2"></i> Save Division
            </button>
        </div>
    </div>
}

<!-- Success Message -->
<div id="successMessageDivision" class="alert alert-success d-none"></div>
