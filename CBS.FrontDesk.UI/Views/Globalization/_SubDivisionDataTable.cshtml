@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel

<div class="table-responsive">
    <table id="subDivisionTable" class="table table-bordered table-striped table-hover table-sm w-100">
        <thead class="table-light">
            <tr>
                <th>Division</th>
                <th>SubDivision Name</th>
                <th style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SubDivisions != null && Model.SubDivisions.Count > 0)
            {
                foreach (var sub in Model.SubDivisions)
                {
                    <tr>
                        <td>@sub.DivisionName</td>
                        <td>@sub.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="openGlobalizationModal(
                                            '@sub.Id',
                                            'globalizationModal',
                                            'globalizationFormContainer',
                                            'Globalization',
                                            'InitializeData',
                                            '_SubDivisionForm',
                                            '',
                                            'Edit SubDivision',
                                            'globalizationModalTitleText',
                                            'id'
                                        )">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteEntity({
                                            key: '@sub.Id',
                                            type: 'subdivision',
                                            deleteUrl: '/Globalization/Delete',
                                            reloadUrl: '/Globalization/InitializeData',
                                            containerId: 'subDivisionTableContainer',
                                            partialView: '_SubDivisionDataTable',
                                            path: 'subdivision',
                                            parentKey: '@sub.DivisionId'
                                        })">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        <i class="bi bi-info-circle me-1"></i> No subdivisions found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#subDivisionTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                autoWidth: false
            });
        });
    </script>
}
