@model CBS.FrontDesk.Data.Entity.Config.GlobalizationViewModel
@using Resources
<!-- Section Title -->
<div class="col-12">
    <h6 class="text-primary border-bottom pt-2 pb-2">
        <i class="bi bi-globe2"></i> @GlobalGlobalization.Region_Management
    </h6>
</div>

<!-- Region Form -->
@using (Html.BeginForm("SaveRegion", "Globalization", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <div class="row g-3 mb-4" id="regionForm">
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                <select id="CountryId" name="Region.CountryId" class="form-select select2" required>
                    <option value="">--- @GlobalShared.Select_Country ---</option>
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country.Id">@country.Name</option>
                    }
                </select>
                <label for="CountryId">@GlobalShared.Country</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating shadow-sm">
                <input type="text" name="Region.Name" class="form-control" placeholder="@GlobalGlobalization.Region_Name" required />
                <label>@GlobalGlobalization.Region_Name</label>
            </div>
        </div>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-secondary px-4">
                <i class="bi bi-save2"></i> @GlobalGlobalization.Save_Region
            </button>
        </div>
    </div>
}

<!-- Success Message -->
<div id="successMessageRegion" class="alert alert-success d-none"></div>
