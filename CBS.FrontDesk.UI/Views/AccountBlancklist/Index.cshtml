@model CBS.FrontDesk.Data.Entity.Accounting_V2.AccountBlackList.AccountBlacklist
@using Resources
@{
    ViewBag.Title = "Account Blacklist - Menu Configuration";
    var isAffiliate = Model?.isAffiliate == true;
    // Optional: Chart of Accounts for centralized mode should be provided by controller via ViewBag.ChartOfAccounts
    // Example: ViewBag.ChartOfAccounts = new List<SelectListItem>{ new SelectListItem("Cash","1"), ... }
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-shield-account-outline me-2"></i> Account Blacklist (Menu configuration)
                </h1>
                <p class="card-text text-muted mb-1">Use this screen to upload/account map items that will be blacklisted or routed differently on specific menus.</p>
                <p class="card-text text-info fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Items uploaded here will affect menu-level account visibility and operations.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBlacklistTips" aria-expanded="false" aria-controls="collapseBlacklistTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseBlacklistTips" class="collapse">
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>Upload mode</strong>
                    <div class="small text-muted mt-1">
                        Check <strong>Is Centralized</strong> to manage a centralized chart-of-accounts and menu routing. Uncheck to manage branch-specific accounts.
                    </div>
                </li>

                <li class="list-group-item">
                    <strong>Transaction Type</strong>
                    <div class="small text-muted mt-1">
                        Choose the transaction category (Manual entries, Other Cash In/Out, Member↔GL, GL↔GL).
                    </div>
                </li>

                <li class="list-group-item">
                    <strong>File formats</strong>
                    <div class="small text-muted mt-1">
                        Use the templates available (Download Template button). Files should be within 10MB.
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Workspace Card -->
<div class="card shadow-sm border-0 mb-4">
    <div id="mainWorkspace" data-is-affiliate="@(isAffiliate ? "true" : "false")">
        @using (Html.BeginForm("UploadAffiliate", "FileUpload", FormMethod.Post, new { enctype = "multipart/form-data", @onsubmit = "return fileupload(this);" }))
        {
            @Html.AntiForgeryToken()

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="mb-0 text-primary d-flex align-items-center">
                        <i class="mdi mdi-cloud-upload-outline me-2"></i>
                        Upload / Configure Account Blacklist
                        <span class="badge bg-success ms-2">Required</span>
                    </h6>
                </div>

                <div class="card-body">
                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                        <i class="mdi mdi-information-outline me-2"></i>
                        <div>Files should not exceed <strong>10MB</strong>. Use templates if available.</div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">
                        <!-- IS AFFILIATE CHECKBOX (existing) -->
                        <div class="col-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.isAffiliate, new { @class = "form-check-input", id = "IsAffiliateCheckbox" })
                                <label class="form-check-label" for="IsAffiliateCheckbox">Check to Upload Affiliate COA</label>
                            </div>
                        </div>

                        <!-- NEW: IsCentralized checkbox (affects which account selectors are shown) -->
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" id="IsCentralizedCheckbox" name="IsCentralized" class="form-check-input" />
                                <label class="form-check-label" for="IsCentralizedCheckbox">Is Centralized (use centralized CoA)</label>
                            </div>
                        </div>

                        <!-- CENTRALIZED COA + Transaction type -->
                        <div class="col-12 centralized-row d-none">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label for="CentralizedCoA" class="form-label fw-semibold">Chart of Accounts (Centralized)</label>
                                    @Html.DropDownList("CentralizedCoA",
                                        ViewBag.ChartOfAccounts as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                                        "--- Select centralized CoA ---",
                                        new { @class = "form-control select2", id = "CentralizedCoA" })
                                </div>

                                <div class="col-md-6">
                                    <label for="TransactionType" class="form-label fw-semibold">Transaction Type</label>
                                    <select id="TransactionType" name="TransactionType" class="form-control select2">
                                        <option value="">--- Select Transaction Type ---</option>
                                        <option value="ManualEntries">Manual entries</option>
                                        <option value="OtherCashIn">Other Cash in</option>
                                        <option value="OtherCashOut">Other cash out</option>
                                        <option value="MemberToGL">Member to GL</option>
                                        <option value="GLToMember">GL to Member</option>
                                        <option value="GLToGL">GL to GL</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- NON-CENTRALIZED: Branch selector + Branch Account + Transaction Type -->
                        <div class="col-12 non-centralized-row @(isAffiliate ? "d-none" : "")">
                            <div class="row g-2">
                                <!-- BRANCH DROPDOWN -->
                                <div class="col-md-6 branch-dropdown">
                                    <label for="BranchId" class="form-label fw-semibold">🏢 Select Branch</label>
                                    @Html.DropDownListFor(m => m.BranchID,
                                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                                        "--- " + @GlobalUserManagement.SelectBranch + " ---",
                                        new { @class = "form-control select2", id = "BranchId" })
                                    @Html.ValidationMessageFor(m => m.BranchID, "", new { @class = "text-danger" })
                                </div>

                                <!-- BRANCH ACCOUNT (populated via AJAX) -->
                                <div class="col-md-6">
                                    <label for="BranchAccountId" class="form-label fw-semibold">Branch Account reference</label>
                                    @Html.DropDownListFor(m => m.branchAccountId,
                                        new SelectList(Enumerable.Empty<SelectListItem>()),
                                        "--- Select Branch Account reference ---",
                                        new { @class = "form-control select2", id = "BranchAccountId" })
                                </div>

                                <!-- Transaction Type (same as centralized) -->
                                <div class="col-md-6 mt-2">
                                    <label for="TransactionTypeLocal" class="form-label fw-semibold">Transaction Type</label>
                                    <select id="TransactionTypeLocal" name="TransactionType" class="form-control select2">
                                        <option value="">--- Select Transaction Type ---</option>
                                        <option value="ManualEntries">Manual entries</option>
                                        <option value="OtherCashIn">Other Cash in</option>
                                        <option value="OtherCashOut">Other cash out</option>
                                        <option value="MemberToGL">Member to GL</option>
                                        <option value="GLToMember">GL to Member</option>
                                        <option value="GLToGL">GL to GL</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 col-12">
                            <label id="fileLabel" class="form-label fw-semibold">
                                Select file to upload
                            </label>
                            <div class="input-group">
                                <input type="file" name="file" id="file" class="form-control" required />
                                <button type="submit" class="btn btn-primary" id="btnSubmitUpload">
                                    <i class="mdi mdi-cloud-upload-outline me-1"></i> Upload File
                                </button>
                            </div>
                        </div>

                        <!-- DYNAMIC TEMPLATE DOWNLOAD BUTTONS -->
                        <div class="col-12 text-end mt-3">
                            <div class="d-flex justify-content-end gap-2">
                                <a id="centralTemplateLink" href="@Url.Action("CentralTemplate", "FileUpload")" class="btn btn-outline-primary d-none">
                                    <i class="mdi mdi-file-download-outline me-1"></i> Download Central Template
                                </a>

                                <a id="branchTemplateLink" href="@Url.Action("BranchAccountTemplate", "FileUpload")" class="btn btn-outline-primary">
                                    <i class="mdi mdi-file-download-outline me-1"></i> Download Branch Template
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }  <!-- using block closed -->
    </div>

    <div class="card-footer bg-light text-muted text-end">
        <small>
            <i class="mdi mdi-information-outline me-1 text-info"></i> Template files make uploads fast and reliable.
        </small>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            'use strict';

            // Helper: init select2 for provided selector (safe)
            function ensureSelect2Init(selectorOrJq) {
                var $el = (selectorOrJq && selectorOrJq.jquery) ? selectorOrJq : $(selectorOrJq);
                if (!$el || $el.length === 0) return;
                if ($.fn.select2 && !$el.data('select2')) {
                    try { $el.select2({ width: '100%' }); } catch (e) { console.warn('select2 init failed', e); }
                }
            }

            // Toggle UI for centralized vs non-centralized
            function setCentralized(isCentralized) {
                if (isCentralized) {
                    $('.centralized-row').removeClass('d-none').show();
                    $('.non-centralized-row').addClass('d-none').hide();

                    $('#CentralizedCoA').prop('disabled', false);
                    $('#BranchId').prop('disabled', true);
                    $('#BranchAccountId').prop('disabled', true);

                    // show central template link
                    $('#centralTemplateLink').removeClass('d-none').show();
                    $('#branchTemplateLink').addClass('d-none').hide();

                    // optionally update the file label
                    $('#fileLabel').text('Select centralized mapping file (COA)');
                } else {
                    $('.centralized-row').addClass('d-none').hide();
                    $('.non-centralized-row').removeClass('d-none').show();

                    $('#CentralizedCoA').prop('disabled', true);
                    $('#BranchId').prop('disabled', false);
                    $('#BranchAccountId').prop('disabled', false);

                    $('#centralTemplateLink').addClass('d-none').hide();
                    $('#branchTemplateLink').removeClass('d-none').show();

                    $('#fileLabel').text('Select Trial Balance (6 columns) or branch mapping file');
                }

                // refresh select2 visuals
                try {
                    if ($.fn.select2) {
                        $('.select2').each(function () {
                            try { $(this).trigger('change.select2'); } catch (e) { /* ignore */ }
                        });
                    }
                } catch (e) { /* ignore */ }
            }

            // Load branch accounts by branchId and populate BranchAccountId dropdown
            function loadBranchAccounts(branchId, $targetDropdown) {
                $targetDropdown = $targetDropdown || $('#BranchAccountId');
                $targetDropdown.empty().prop('disabled', true).append($('<option>').val('').text('Loading branch accounts...'));

                if (!branchId) {
                    $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text('--- Select Branch Account reference ---'));
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetBranchAccountsByBranch", "FileUpload")',
                    type: 'GET',
                    data: { branchId: branchId },
                    timeout: 10000,
                    success: function (response) {
                        $targetDropdown.empty().prop('disabled', false);

                        var items = [];
                        if (Array.isArray(response)) items = response;
                        else if (response && response.data) items = response.data;
                        else if (response && response.success && Array.isArray(response.data)) items = response.data;

                        if (items && items.length) {
                            $targetDropdown.append($('<option>').val('').text('--- Select Branch Account reference ---'));
                            items.forEach(function (acc) {
                                var id = acc.id || acc.Id || acc.Value || acc.value || acc.valueId || '';
                                var name = acc.name || acc.Name || acc.Text || acc.text || acc.NameEn || acc.Description || '';
                                $targetDropdown.append($('<option>').val(id).text(name));
                            });
                        } else {
                            $targetDropdown.append($('<option>').val('').text('No branch accounts available'));
                        }

                        try { if ($.fn.select2) $targetDropdown.trigger('change.select2'); } catch (e) { /* ignore */ }
                    },
                    error: function (xhr, status, err) {
                        console.error('Error loading branch accounts:', err);
                        $targetDropdown.empty().prop('disabled', false).append($('<option>').val('').text('Error loading branch accounts'));
                    }
                });
            }

            // File upload behavior kept from your original; no change to business logic except hooking UI
            window.fileupload = window.fileupload || function (form) {
                // original fileupload implementation - keep as-is
                try {
                    var $form = $(form);
                    if (!$form || $form.length === 0) {
                        console.warn('fileupload called without a valid form element.');
                        return false;
                    }

                    // parse and validate
                    try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($form); } catch (ex) { /* ignore */ }
                    if ($.validator && typeof $form.valid === 'function' && !$form.valid()) return false;

                    var confirmed = confirm("Are you sure you want to perform this action?");
                    if (!confirmed) return false;

                    var fd = new FormData(form);
                    var anti = $form.find('input[name="__RequestVerificationToken"]').val();
                    if (anti && !fd.has('__RequestVerificationToken')) fd.append('__RequestVerificationToken', anti);

                    var $btn = $form.find('#btnSubmitUpload');
                    $btn.prop('disabled', true).addClass('disabled');

                    $.ajax({
                        type: 'POST',
                        url: $form.attr('action'),
                        data: fd,
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            try {
                                // preserve your original handling
                                if (typeof response === 'string' && response.trim().charAt(0) === '<') {
                                    $('#mainWorkspace').html(response);
                                    try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($('#mainWorkspace')); } catch (e) { }
                                    return;
                                }
                                var json = response;
                                if (typeof response === 'string') {
                                    try { json = JSON.parse(response); } catch (e) { /* not JSON */ }
                                }

                                if (json && typeof json === 'object') {
                                    if (json.success) {
                                        if (json.status === "Exist") { if (typeof appalert === 'function') appalert(json.message, 3, 1); else alert(json.message); }
                                        else if (json.status === "Failed") { if (typeof appalert === 'function') appalert(json.message, 2, 1); else alert(json.message); }
                                        else { if (typeof appalert === 'function') appalert(json.message, 1, 1); else alert(json.message || 'Upload succeeded.'); }

                                        // redirect logic preserved
                                        if (json.data) {
                                            if (json.data.AutoMatchedAccounts > 0) {
                                                setTimeout(function () {
                                                    if (typeof appalert === 'function') appalert('Auto matched accounts: ' + json.data.AutoMatchedAccounts + '. Redirecting...', 1,1);
                                                    window.open('/FileUpload/AwaitingCorrespondence', '_blank');
                                                }, 1500);
                                            } else if (json.data.awaitingCorrespondenceCreated > 0) {
                                                setTimeout(function () {
                                                    if (typeof appalert === 'function') appalert('Awaiting correspondence created: ' + json.data.awaitingCorrespondenceCreated + '. Redirecting...', 1,1);
                                                    window.open('/FileUpload/List', '_blank');
                                                }, 1500);
                                            } else if (json.data.requiresMappingAccounts > 0) {
                                                var listUrl = '@Url.Action("List", "FileUpload")';
                                                window.open(listUrl, '_blank');
                                            }
                                        }

                                        if (json.html) {
                                            $('#mainWorkspace').html(json.html);
                                            try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($('#mainWorkspace')); } catch (e) { }
                                        }
                                    } else {
                                        var status = json.Status || json.status;
                                        if (status === "Exist") { if (typeof appalert === 'function') appalert(json.message, 3, 1); else alert(json.message || 'Already exists.'); }
                                        else { if (typeof appalert === 'function') appalert(json.message, 2, 1); else alert(json.message || 'Operation failed.'); }
                                        if (json.html) {
                                            $('#mainWorkspace').html(json.html);
                                            try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($('#mainWorkspace')); } catch (e) { }
                                        }
                                    }
                                } else {
                                    $('#mainWorkspace').html(response);
                                    try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($('#mainWorkspace')); } catch (e) { }
                                }
                            } catch (ex) {
                                console.error('fileupload success handler error', ex);
                            }
                        },
                        error: function (err) {
                            console.error('fileupload error:', err);
                            if (err && err.status === 401) { window.location.href = '/Authentication/Login'; return; }
                            var errMsg = (err && err.statusText) ? err.statusText : 'Server error';
                            if (err && err.responseText && err.responseText.trim().charAt(0) === '<') {
                                $('#mainWorkspace').html(err.responseText);
                                try { if ($.validator && $.validator.unobtrusive) $.validator.unobtrusive.parse($('#mainWorkspace')); } catch (e) { }
                            } else {
                                if (typeof appalert === 'function') appalert(errMsg, 0, 1); else alert(errMsg);
                            }
                        },
                        complete: function () {
                            $btn.prop('disabled', false).removeClass('disabled');
                        }
                    });

                } catch (ex) {
                    console.error('fileupload top-level error', ex);
                    if (typeof appalert === 'function') appalert('Unexpected error: ' + ex.message, 0, 1); else alert('Unexpected error: ' + ex.message);
                    return false;
                }
                return false;
            };

            // DOM ready
            $(function () {
                // init select2 for visible controls
                ensureSelect2Init('#BranchId');
                ensureSelect2Init('#BranchAccountId');
                ensureSelect2Init('#CentralizedCoA');
                ensureSelect2Init('#TransactionType');
                ensureSelect2Init('#TransactionTypeLocal');

                // hook IsCentralized checkbox
                var $centralChk = $('#IsCentralizedCheckbox');
                // init from data-attribute fallback (page default non-centralized)
                var initialCentral = $centralChk.is(':checked') || false;
                setCentralized(initialCentral);

                $centralChk.off('change.central').on('change.central', function () {
                    setCentralized($(this).is(':checked'));
                });

                // Branch change -> load accounts
                $('#BranchId').off('change.branch').on('change.branch', function () {
                    var branchId = $(this).val();
                    loadBranchAccounts(branchId, $('#BranchAccountId'));
                });

                // If a branch is already selected (edit mode), load its accounts
                var preBranch = $('#BranchId').val();
                if (preBranch) loadBranchAccounts(preBranch, $('#BranchAccountId'));

                // Ensure selecting TransactionType syncs across both selects (if desired)
                $('#TransactionType').on('change', function () {
                    var v = $(this).val();
                    $('#TransactionTypeLocal').val(v).trigger('change');
                });
                $('#TransactionTypeLocal').on('change', function () {
                    var v = $(this).val();
                    $('#TransactionType').val(v).trigger('change');
                });
            });
        })(jQuery);
    </script>
}
