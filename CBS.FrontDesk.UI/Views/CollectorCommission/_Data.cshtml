@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:18%" /> 
                    <col style="width:25%" /> 
                    <col style="width:21%" /> 
                    <col style="width:13%" /> 
                    <col style="width:13%" /> 
                    <col style="width:10%" /> 
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.CreatedDate</th>
                        <th> @GlobalShared.Branch_Name </th>
                        <th> @GlobalShared.Collector_Name </th>
                        <th>  @GlobalShared.Amount_Paid </th>
                        <th>  @GlobalShared.Month </th>
                        <th style="width:160px">@GlobalShared.Actions</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
