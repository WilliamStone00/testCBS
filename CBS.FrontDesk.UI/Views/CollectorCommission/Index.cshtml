    // Function to populate all PCMF dropdowns
    function populateAllPcmfDropdowns(accounts) {
        // List of dropdown IDs that need PCMF accounts
        var dropdownIds = ['PaymentGl', 'ExpenseGL'];

        $.each(dropdownIds, function (index, dropdownId) {
            var dropdown = $('#' + dropdownId);

            // Skip if dropdown doesn't exist
            if (dropdown.length === 0) return true;

            // destroy existing instance if any
            if (dropdown.hasClass('select2-hidden-accessible')) {
                dropdown.select2('destroy');
            }

            // Clear and populate
            dropdown.empty();

            // Set appropriate placeholder text based on dropdown ID
            var placeholder = dropdownId === 'PaymentGl'
                ? '--- Branch Commission Account ---'
                : '--- Expense Commission Account ---';

            dropdown.append('<option value="">' + placeholder + '</option>');

            if (accounts && accounts.length) {
                $.each(accounts, function (i, account) {
                    dropdown.append($('<option>').val(account.Value).text(account.Text));
                });
            } else {
                dropdown.append('<option value="">No accounts available</option>');
            }

            // Re-initialize Select2
            if ($.fn.select2) {
                dropdown.select2({
                    dropdownParent: $('body'),
                    width: '100%'
                });
            }
        });
    }

