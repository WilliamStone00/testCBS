    // Helper function to format date as "MM/dd/yyyy hh:mm:ss AM"
    function formatDateForPayload(date) {
        var month = (date.getMonth() + 1).toString().padStart(2, '0');
        var day = date.getDate().toString().padStart(2, '0');
        var year = date.getFullYear();
        var hours = '12';
        var minutes = '00';
        var seconds = '00';
        var ampm = 'AM';

        return month + '/' + day + '/' + year + ' ' + hours + ':' + minutes + ':' + seconds + ' ' + ampm;
    }

    function processPayment() {
        // Validate form
        if (!$('#DailyCollectorAccount').val()) {
            appalert('Please select a Daily Collector Account', 3, 1);
            return;
        }

        if (!dailyCollectorId) {
            appalert('Please search and select a customer first', 3, 1);
            return;
        }

        if (!$('#Incentives').val()) {
            appalert('Please enter incentives amount', 3, 1);
            return;
        }

        // NEW CHECK: If incentives > 0, require ExpenseGL selection
        var incentives = parseFormattedCurrency($('#Incentives').val()) || 0;
        var expenseGL = $('#ExpenseGL').val();
        var memo = $('#Memo').val();
        var memoinsentive = $('#MemoIncentive').val();

        if (incentives > 0) {
            if (!expenseGL) {
                appalert('Incentives amount is greater than zero. Please select a Expense General Ledger Account (ExpenseGL)', 4, 1);
                $('#ExpenseGL').focus();
                return;
            }
        }
        if (memo == null || memo === '') {
            appalert('Please enter description for Memo', 4, 1);
            $('#Memo').focus();
            return;
        }
        if (memoinsentive == null || memoinsentive === '') {
            appalert('Please Enter description for Memo Insentives', 4, 1);
            $('#MemoIncentive').focus();
            return;
        }

        if (!$('#PaymentGl').val()) {
            appalert('Please select a Branch Commission Account', 3, 1);
            return;
        }

        if (!$('#AccountingDay').val()) {
            appalert('Please select accounting date', 3, 1);
            return;
        }

        // Get month and year from hidden fields
        var month = $('#MonthHidden').val();
        var year = $('#YearHidden').val();

        if (!month || !year) {
            appalert('Month and Year information is missing', 3, 1);
            return;
        }

        // Calculate amounts
        var incentives = parseFormattedCurrency($('#Incentives').val()) || 0;
        var dailyCollectorShare = parseFormattedCurrency($('#DaillyCollectorShare').val()) || 0;
        var branchShare = parseFormattedCurrency($('#BranchShare').val()) || 0;

        // Calculate totals according to business logic
        var collectorTotalCommision = dailyCollectorShare + branchShare;
        var totalAmountToShare = incentives + dailyCollectorShare;

        // Prepare SharedAmounts data - use the actual data from commission
        var sharedAmounts = [];
        if (treatmentCommissionData && treatmentCommissionData.SharedAmounts) {
            sharedAmounts = treatmentCommissionData.SharedAmounts.map(function (item) {
                return {
                    StakeHolderId: item.StakeHolderId || dailyCollectorId,
                    Stakeholder: item.Stakeholder || 'Daily Collector',
                    Percentage: item.Percentage || 0,
                    Amount: item.Amount || 0
                };
            });
        } else {
            // Fallback: create shared amounts based on calculated values
            sharedAmounts = [
                {
                    StakeHolderId: dailyCollectorId,
                    Stakeholder: 'Daily Collector',
                    Percentage: 60,
                    Amount: dailyCollectorShare
                },
                {
                    StakeHolderId: 'branch',
                    Stakeholder: 'Branch',
                    Percentage: 40,
                    Amount: branchShare
                }
            ];
        }

        // Format date to match target format: "MM/dd/yyyy hh:mm:ss AM"
        var accountingDate = $('#AccountingDay').val();
        var dateObj = new Date(accountingDate);
        var formattedDate = formatDateForPayload(dateObj);

        // Prepare payload to match CollectorComissionResponse model
        var payload = {
            // Map to CollectorComissionResponse properties
            CustomerId: dailyCollectorId,
            AccountNumber: selectedAccountNumber,
            BranchCommisionGLId: $('#BranchCommisionGLIdHidden').val(),
            ExpenseGL: $('#ExpenseGL').val(), // ADDED: Include ExpenseGL in payload
            Incentives: incentives,
            CollectorTotalCommision: collectorTotalCommision,
            AccountingDate: formattedDate,
            BranchId: $('#BranchIdHidden').val(),
            Total: totalAmountToShare,
            DailyCollectorShare: dailyCollectorShare,
            BranchShare: branchShare,
            CollectorId: $('#CollectorIdHidden').val(),
            CollectorName: $('#CollectorNameHidden').val(),
            DailyCollectorAccount: $('#DailyCollectorAccount').val(),
            Month: month.toString(),
            Year: parseInt(year),
            Memo: $('#Memo').val(),
            MemoIncentive: $('#MemoIncentive').val(),
            SharedAmounts: sharedAmounts
        };

        console.log('Submitting payment payload (CollectorComissionResponse):', payload);

        // --- NEW: Show confirmation dialog with payment summary ---

        // Get account names for better display
        var dailyCollectorAccountText = $('#DailyCollectorAccount option:selected').text() || 'Not selected';
        var paymentGlText = $('#PaymentGl option:selected').text() || 'Not selected';
        var expenseGLText = $('#ExpenseGL option:selected').text() || 'Not selected';
        var collectorName = $('#CollectorNameHidden').val() || $('#customerName').text() || 'N/A';

        // Build summary message
        var summaryMessage = '';
        summaryMessage += '<div style="text-align: left; font-size: 14px;">';
        summaryMessage += '<h4 style="margin-bottom: 15px; color: #0d6efd;">📋 Payment Summary</h4>';

        // Collector Information
        summaryMessage += '<div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px;">';
        summaryMessage += '<strong style="color: #495057;">👤 COLLECTOR INFORMATION</strong><hr style="margin: 5px 0; opacity: 0.2;">';
        summaryMessage += '<table style="width: 100%; border-collapse: collapse;">';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Name:</strong></td><td style="padding: 3px 0;">' + collectorName + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Account:</strong></td><td style="padding: 3px 0;">' + dailyCollectorAccountText + '</td></tr>';
        summaryMessage += '</table></div>';

        // Commission Details
        summaryMessage += '<div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px;">';
        summaryMessage += '<strong style="color: #495057;">💰 COMMISSION DETAILS</strong><hr style="margin: 5px 0; opacity: 0.2;">';
        summaryMessage += '<table style="width: 100%; border-collapse: collapse;">';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Daily Collector Share:</strong></td><td style="padding: 3px 0; text-align: right; color: #198754;">' + formatCurrency(dailyCollectorShare) + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Branch Share:</strong></td><td style="padding: 3px 0; text-align: right; color: #0d6efd;">' + formatCurrency(branchShare) + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Incentives:</strong></td><td style="padding: 3px 0; text-align: right; color: ' + (incentives > 0 ? '#dc3545' : '#6c757d') + ';">' + formatCurrency(incentives) + '</td></tr>';
        summaryMessage += '<tr style="border-top: 1px solid #dee2e6;"><td style="padding: 5px 0 0 0;"><strong>Total to Post:</strong></td><td style="padding: 5px 0 0 0; text-align: right; color: #0d6efd;"><strong>' + formatCurrency(totalAmountToShare) + '</strong></td></tr>';
        summaryMessage += '</table></div>';

        // GL Accounts
        summaryMessage += '<div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px;">';
        summaryMessage += '<strong style="color: #495057;">🏦 GL ACCOUNTS</strong><hr style="margin: 5px 0; opacity: 0.2;">';
        summaryMessage += '<table style="width: 100%; border-collapse: collapse;">';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Branch Commission GL:</strong></td><td style="padding: 3px 0;">' + paymentGlText + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Expense GL:</strong></td><td style="padding: 3px 0;">' + expenseGLText + (incentives > 0 ? '' : ' <span style="color: #6c757d;">(not required - incentives=0)</span>') + '</td></tr>';
        summaryMessage += '</table></div>';

        // Period Information
        summaryMessage += '<div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px;">';
        summaryMessage += '<strong style="color: #495057;">📅 PERIOD</strong><hr style="margin: 5px 0; opacity: 0.2;">';
        summaryMessage += '<table style="width: 100%; border-collapse: collapse;">';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Month/Year:</strong></td><td style="padding: 3px 0;">' + month + '/' + year + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Accounting Date:</strong></td><td style="padding: 3px 0;">' + formatDateToDMY(accountingDate) + '</td></tr>';
        summaryMessage += '</table></div>';

        // Memo Section
        summaryMessage += '<div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-bottom: 15px;">';
        summaryMessage += '<strong style="color: #495057;">📝 MEMO DETAILS</strong><hr style="margin: 5px 0; opacity: 0.2;">';
        summaryMessage += '<table style="width: 100%; border-collapse: collapse;">';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Memo:</strong></td><td style="padding: 3px 0;">' + $('#Memo').val() + '</td></tr>';
        summaryMessage += '<tr><td style="padding: 3px 0;"><strong>Memo Incentive:</strong></td><td style="padding: 3px 0;">' + $('#MemoIncentive').val() + '</td></tr>';
        summaryMessage += '</table></div>';

        summaryMessage += '</div>';

        // Show confirmation dialog using alertify
        alertify.confirm(
            'Confirm Payment Posting',
            summaryMessage,
            function() {
                // Proceed with payment - User clicked OK
                executePayment(payload);
            },
            function() {
                // Cancel - User clicked Cancel
                appalert('Payment posting cancelled', 2, 1);
                $('#btnPostPayment').prop('disabled', false).html('<i class="mdi mdi-check-circle me-1"></i> Post');
            }
        ).set('labels', {ok: '✅ Proceed', cancel: '❌ Cancel'})
         .set('closable', false)
         .set('movable', false)
         .set('resizable', false)
         .set('transition', 'fade')
         .set('pinnable', false);
    }

    // --- NEW: Extract the AJAX call to a separate function ---
    function executePayment(payload) {
        $.ajax({
            url: '@Url.Action("ProcessPayment", "CollectorCommission")',
            type: 'POST',
            data: JSON.stringify(payload),
            contentType: 'application/json',
            beforeSend: function () {
                $('#btnPostPayment').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Processing...');
            },
            success: function (response) {
                if (response.success) {
                    appalert('Payment processed successfully!', 1, 1);
                    $('#treatmentModal').modal('hide');
                    resetPaymentForm();
                    collectorReference = null;
                    dailyCollectorId = null;
                    selectedAccountNumber = null;

                    // Refresh commission data
                    if (typeof getCommissionData === 'function') {
                        getCommissionData();
                    }

                    // Refresh job monitor
                    refreshJobMonitor();

                    // If auto-refresh is enabled, restart it
                    if (isAutoRefreshEnabled) {
                        stopAutoRefresh();
                        startAutoRefresh();
                    }
                } else {
                    if (response.errors) {
                        var errorMessages = [];
                        for (var field in response.errors) {
                            if (response.errors.hasOwnProperty(field)) {
                                errorMessages = errorMessages.concat(response.errors[field]);
                            }
                        }
                        appalert('Validation errors: ' + errorMessages.join(', '), 4, 1);
                    } else {
                        appalert('Error processing payment: ' + response.message, 4, 1);
                    }
                }
            },
            error: function (xhr, status, error) {
                appalert('Error processing payment: ' + error, 4, 1);
            },
            complete: function () {
                $('#btnPostPayment').prop('disabled', false).html('<i class="mdi mdi-check-circle me-1"></i> Post');
            }
        });
    }

    // Function to set commission data from main form
    function setCommissionData(data) {
        treatmentCommissionData = data;
        populateCommissionAmounts();
        populateHiddenFields();
    }

