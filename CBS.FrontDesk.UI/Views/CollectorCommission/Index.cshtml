    function populateHiddenFields() {
        if (!treatmentCommissionData) return;

        console.log('Populating hidden fields with data:', treatmentCommissionData);

        // Set hidden fields from current commission data
        $('#CollectorIdHidden').val(treatmentCommissionData.CollectorId || '');
        $('#BranchIdHidden').val(treatmentCommissionData.BranchId || '');
        $('#CollectorNameHidden').val(treatmentCommissionData.CollectorName || '');

        // Extract month and year from the Month field (format: "2025-11")
        var monthYear = treatmentCommissionData.Month || '';
        if (monthYear) {
            var parts = monthYear.split('-');
            if (parts.length === 2) {
                var year = parts[0];
                var month = parts[1];

                $('#MonthHidden').val(month);  // Store just the month (11)
                $('#YearHidden').val(year);    // Store just the year (2025)

                console.log('Extracted Month:', month);
                console.log('Extracted Year:', year);
            }
        } else {
            // Fallback: try to get from MonthYear field if available
            var monthYearInput = $('#MonthYear').val();
            if (monthYearInput) {
                var parts = monthYearInput.split('-');
                if (parts.length === 2) {
                    $('#MonthHidden').val(parts[1]);
                    $('#YearHidden').val(parts[0]);
                }
            }
        }

        console.log('Setting Month (extracted):', $('#MonthHidden').val());
        console.log('Setting Year (extracted):', $('#YearHidden').val());
        console.log('Setting CollectorId:', treatmentCommissionData.CollectorId);
        console.log('Setting BranchId:', treatmentCommissionData.BranchId);

        // Also set SharedAmounts if available
        if (treatmentCommissionData.SharedAmounts) {
            console.log('SharedAmounts available:', treatmentCommissionData.SharedAmounts);
        }
    }

    function populateCommissionAmounts() {
        if (!treatmentCommissionData || !treatmentCommissionData.SharedAmounts) return;

        // Find Daily Collector and Branch amounts
        var dailyCollectorAmount = 0;
        var branchAmount = 0;

        $.each(treatmentCommissionData.SharedAmounts, function(index, item) {
            if (item.Stakeholder && item.Stakeholder.toLowerCase().includes('collector')) {
                dailyCollectorAmount = item.Amount || 0;
            }
            if (item.Stakeholder && item.Stakeholder.toLowerCase().includes('branch')) {
                branchAmount = item.Amount || 0;
            }
        });

        // Set the values with formatted currency (visible fields)
        $('#DaillyCollectorShare').val(formatCurrency(dailyCollectorAmount));
        $('#BranchShare').val(formatCurrency(branchAmount));

        // Also set hidden fields with raw values
        $('#DailyCollectorShareHidden').val(dailyCollectorAmount);
        $('#BranchShareHidden').val(branchAmount);

        // Calculate initial total (incentives + daily collector share)
        calculateTotal();

        // Sync all fields
        syncHiddenFields();
    }

    function formatIncentivesInput(input) {
        var value = input.value.replace(/,/g, '');
        if (value === '' || value === '0') {
            calculateTotal();
            return;
        }

        var numberValue = parseFloat(value);
        if (!isNaN(numberValue)) {
            calculateTotal();
        }
    }

    function finalizeIncentivesFormat(input) {
        var value = input.value.replace(/,/g, '');
        if (value === '') {
            input.value = '0.00';
        } else {
            var numberValue = parseFloat(value);
            if (!isNaN(numberValue)) {
                input.value = formatCurrency(numberValue);
            }
        }
        calculateTotal();
        syncHiddenFields();
    }

    function calculateTotal() {
        var incentives = parseFormattedCurrency($('#Incentives').val()) || 0;
        var collectorShare = parseFormattedCurrency($('#DaillyCollectorShare').val()) || 0;
        var total = incentives + collectorShare;
        $('#Total').val(formatCurrency(total));
        $('#TotalHidden').val(total);
    }

    // NEW FUNCTION: Sync all hidden fields with visible fields
    function syncHiddenFields() {
        // Sync all visible fields with their hidden counterparts
        $('#TotalHidden').val(parseFormattedCurrency($('#Total').val()) || 0);
        $('#BranchShareHidden').val(parseFormattedCurrency($('#BranchShare').val()) || 0);
        $('#DailyCollectorShareHidden').val(parseFormattedCurrency($('#DaillyCollectorShare').val()) || 0);
        $('#IncentivesHidden').val(parseFormattedCurrency($('#Incentives').val()) || 0);

        // Sync other fields
        $('#DailyCollectorAccountHidden').val($('#DailyCollectorAccount').val() || '');
        $('#CollectorNameHidden').val($('#customerName').text() || '');

        console.log('Hidden fields synced');
    }

    function searchCustomer(customerRef) {
        $.ajax({
            url: '@Url.Action("GetCustomerAccounts", "CollectorCommission")',
            type: 'GET',
            data: { customerId: customerRef },
            beforeSend: function () {
                $('#btnSearchCustomer').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Searching...');
            },
            success: function (response) {
                if (response.success) {
                    // Store customer data globally
                    customerData = response.customer;
                    customerAccounts = response.accounts;

                    displayCustomerInfo(response.customer);
                    populateAccounts(response.accounts);
                    $('#accountSelection').removeClass('d-none');

                    // Set the CustomerId in the hidden field - use the ID from the customer object
                    $('#CustomerIdHidden').val(response.customer.Id || customerRef);

                    // Also store the collector reference separately
                    dailyCollectorId = response.customer.Id || customerRef;

                    // Set collector name in hidden field
                    $('#CollectorNameHidden').val(response.customer.FirstName + ' ' + response.customer.LastName);

                    updatePaymentSummary();
                    syncHiddenFields();
                    appalert('Customer found successfully!', 1, 1);
                } else {
                    appalert('Customer not found: ' + response.message, 4, 1);
                    $('#customerInfo').addClass('d-none');
                    $('#accountSelection').addClass('d-none');
                    $('#paymentDetails').addClass('d-none');
                    $('#CustomerIdHidden').val('');
                    $('#CollectorNameHidden').val('');
                    updatePaymentSummary();
                    syncHiddenFields();
                }
            },
            error: function (xhr, status, error) {
                appalert('Error searching customer: ' + error, 4, 1);
                $('#customerInfo').addClass('d-none');
                $('#accountSelection').addClass('d-none');
                $('#paymentDetails').addClass('d-none');
                $('#CustomerIdHidden').val('');
                $('#CollectorNameHidden').val('');
                updatePaymentSummary();
                syncHiddenFields();
            },
            complete: function () {
                $('#btnSearchCustomer').prop('disabled', false).html('<i class="mdi mdi-magnify"></i> Search');
            }
        });
    }

    function displayCustomerInfo(customer) {
        $('#customerName').text(customer.FirstName + ' ' + customer.LastName);
        $('#customerId').text(customer.CustomerId || customer.Id || 'N/A');
        $('#customerPhone').text(customer.Phone || 'N/A');
        $('#customerEmail').text(customer.Email || 'N/A');
        $('#customerInfo').removeClass('d-none');
    }

    function populateAccounts(accounts) {
        var dropdown = $('#DailyCollectorAccount');

        // Destroy existing Select2 if any
        if (dropdown.hasClass('select2-hidden-accessible')) {
            dropdown.select2('destroy');
        }

        dropdown.empty().append('<option value="">Select Account</option>');
        if (accounts && accounts.length) {
            $.each(accounts, function (index, account) {
                dropdown.append($('<option>').val(account.Value).text(account.Text));
            });
        } else {
            dropdown.append('<option value="">No accounts available</option>');
        }

        // Re-initialize Select2 with modal as parent
        if ($.fn.select2) {
            dropdown.select2({
                dropdownParent: $('#treatmentModal'),
                width: '100%'
            });
        }
    }

    function updatePaymentSummary() {
        var customerId = dailyCollectorId || $('#CustomerIdHidden').val();
        var customerName = $('#customerName').text();
        var accountValue = $('#DailyCollectorAccount').val();
        var accountText = $('#DailyCollectorAccount').find('option:selected').text();
        var accountNumber = selectedAccountNumber || $('#AccountNumberHidden').val();

        var customerSummary = customerId ? 'Customer: ' + customerName + ' (' + customerId + ')' : 'Customer: Not selected';
        var accountSummary = accountValue ? 'Account: ' + accountText : 'Account: Not selected';
        var accountNumberSummary = accountNumber ? 'Account #: ' + accountNumber : 'Account #: Not selected';

        $('#paymentSummaryCustomer').text(customerSummary);
        $('#paymentSummaryAccount').text(accountSummary);
        $('#paymentSummaryAccountNumber').text(accountNumberSummary);
    }

