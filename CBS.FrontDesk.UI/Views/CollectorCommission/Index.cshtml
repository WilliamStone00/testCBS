@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.CollectorComissionResponse
@{
    var jobMonitorModel = ViewBag.JobMonitor as CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.JobMonitorViewModel
        ?? new CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.JobMonitorViewModel
        {
            LastUpdated = DateTime.Now,
            AutoRefreshEnabled = false,
            HasActiveJob = false,
            CountdownSeconds = 10
        };
}


<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-cash me-2"></i>Collector Commission Management
                </h1>
                <p class="card-text">
                    @*CollectorCommissionText*@
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    we are going to manage Dailly Collector Commissions on this page
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseCommissionTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-month text-success me-2"></i>
                    <strong>MonthYear:</strong> MonthYearText1 <code>09/2025</code> MonthYearText2.
                </li>
                <li>
                    <i class="mdi mdi-account-group text-info me-2"></i>
                    <strong>Collector:</strong> CollectorText1 <code>SelectCollector</code> CollectorText2.
                </li>
                <li>
                    <i class="mdi mdi-office-building text-warning me-2"></i>
                    <strong>Branch:</strong> BranchText
                </li>
                <li>
                    <i class="mdi mdi-cash-sync text-primary me-2"></i>
                    <strong>OperationType:</strong> OperationTypeText
                </li>
                <li>
                    <i class="mdi mdi-download-box text-secondary me-2"></i>
                    <strong>Export:</strong> Click <strong>Export</strong> ExportText
                </li>
                <li>
                    <i class="mdi mdi-cash-check text-success me-2"></i>
                    <strong>Treatment:</strong> TreatmentText
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Commission Filter Card -->
<div class="card mb-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Get Commission</h6>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionFilter" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="collapseCommissionFilter" class="collapse show">
        <div class="card-body">
            <!-- Branch selector (full width) -->
            <div class="row mb-2">
                <div class="col-md-12">
                    <div class="form-group mb-2">
                        <label for="BranchId" class="form-label fw-semibold">🏢 Select Branch</label>
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <div class="mt-1 small text-muted">
                            Choose a branch to continue and load branch accounts.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collector and MonthYear row -->
            <div class="row mb-2">
                <div class="col-md-6 mb-2">
                    <div class="form-group mb-2">
                        <label for="CollectorId" class="form-label fw-semibold">👤 Collector</label>
                        @Html.DropDownList("CollectorId",
                            new List<SelectListItem> { new SelectListItem { Text = "--- Select Collector ---", Value = "" } },
                            new { @class = "form-control select2", id = "CollectorId" })
                        <span id="accountTypeLoading" class="text-info d-none">
                            <i class="mdi mdi-loading mdi-spin me-1"></i>Loading Collector account ...
                        </span>
                    </div>
                </div>

                <div class="col-md-6 mb-2">
                    <div class="form-group mb-2">
                        <label for="MonthYear" class="form-label fw-semibold">📅 Month / Year</label>
                        <input type="month" id="MonthYear" name="MonthYear" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="row mb-2">
                <div class="col-12 text-end">
                    <button type="button" id="btnGetCommission" class="btn btn-primary me-2">
                        <i class="mdi mdi-search me-1"></i> Get Commission
                    </button>
                    <button type="button" id="btnReset" class="btn btn-secondary">
                        <i class="mdi mdi-refresh me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <!-- Commission Summary Card -->
    <div id="commissionSummary" class="card mb-4 d-none">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Commission Summary</h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionSummary" aria-expanded="true">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
        <div id="collapseCommissionSummary" class="collapse show">
            <div class="card-body">
                <!-- Basic Information Section -->
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-account-group me-2"></i>Collector Information</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium">Collector:</span>
                                    <span id="summaryCollectorName">-</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium">Branch:</span>
                                    <span id="summaryBranchName">-</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium">Period:</span>
                                    <span id="summaryPeriod">-</span>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span class="fw-medium">Payment Status:</span>
                                    <span id="summaryPaymentStatus">-</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card h-100 border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-chart-bar me-2"></i>Activity Overview</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalMembers">0</h5>
                                            <small class="text-muted">Total Savers with Activity</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalValue">0.00</h5>
                                            <small class="text-muted">Total Savings Collected</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalFee">0.00</h5>
                                            <small class="text-muted">Total Charged</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalToDistribute">0.00</h5>
                                            <small class="text-muted">Amount to Distribute</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Distribution Section -->
                <div class="row">
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-cash-multiple me-2"></i>Distribution Breakdown</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover" id="distributionTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Stakeholder</th>
                                                <th class="text-end">Percentage</th>
                                                <th class="text-end">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Distribution data will be loaded here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 text-end">
                        <button type="button" id="btnList" class="btn btn-success me-2">
                            <i class="mdi mdi-cash-multiple me-1"></i> Collector List
                        </button>

                        <button type="button" id="btnExport" class="btn btn-success me-2">
                            <i class="mdi mdi-export me-1"></i>Export
                        </button>

                        <!-- Dynamic Treatment/Retreat Button -->
                        <button type="button" id="btnTreatment" class="btn btn-warning d-none">
                            <i class="mdi mdi-cash-check me-1"></i>Treatment
                        </button>

                        <button type="button" id="btnRetreat" class="btn btn-danger d-none">
                            <i class="mdi mdi-cash-remove me-1"></i>Retreat
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Background Job Monitoring Dashboard - Using the partial view -->
    @Html.Partial("_JobMonitor", jobMonitorModel)

    <!-- Commission Details Table -->
    <div id="commissionDetails" class="card d-none">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Savers Details</h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionDetails" aria-expanded="true">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
        <div id="collapseCommissionDetails" class="collapse show">
            <div class="card-body">
                <table id="commissionTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Member Id</th>
                            <th>Member Name</th>
                            <th>Total Activity Amount</th>
                            <th>Fee Charged</th>
                            <th>Payment Status</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Table data will be loaded here -->
                    </tbody>
                    <!-- Footer for totals -->
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="2" class="text-end">Totals:</td>
                            <td id="totalActivityAmount">0.00</td>
                            <td id="totalFeeAmount">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Export Modal -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_ExportCommission")
        </div>
    </div>
</div>

<!-- Treatment Modal -->
<div class="modal fade" id="treatmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_CommissionTreatment")
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Fix Select2 dropdown z-index in Bootstrap modals */
        .select2-container--open {
            z-index: 99999 !important;
        }

        .select2-dropdown {
            z-index: 99999 !important;
        }

        /* make sure select2 dropdown appears above the modal when appended to body */
        .select2-container--open .select2-dropdown {
            z-index: 3000 !important;
        }

        /* Style for formatted currency inputs */
        .formatted-currency {
            text-align: right;
            font-family: monospace;
        }

        /* safe global rules to prevent flex children from causing overflow */
        .input-group .form-control {
            min-width: 0;
        }

        .input-group {
            max-width: 260px;
            width: 100%;
            box-sizing: border-box;
        }

            .input-group .form-control {
                min-width: 0;
            }

        /* Status badge styles */
        .status-not-debited {
            color: #dc3545;
            font-weight: bold;
        }

        .status-debited {
            color: #198754;
            font-weight: bold;
        }

        .status-pending {
            color: #ffc107;
            font-weight: bold;
        }

        .status-paid {
            color: #198754;
            font-weight: bold;
        }

        .status-processed {
            color: #198754;
            font-weight: bold;
        }
        /* Highlight ExpenseGL field when incentives > 0 and not selected */
        .incentives-input.positive-value ~ .col-md-8 .select2-selection {
            border-left: 3px solid #ffc107;
            transition: border-color 0.3s ease;
        }

            .incentives-input.positive-value ~ .col-md-8 .select2-selection:focus {
                border-color: #86b7fe;
                border-left-color: #dc3545;
                box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
            }


        /* Job Monitor Dashboard Styles */
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        #jobDashboardContent .card {
            transition: all 0.3s ease;
        }

            #jobDashboardContent .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        #jobProgressBar {
            transition: width 0.5s ease-in-out;
        }

        #refreshIcon {
            transition: transform 0.3s ease;
        }

            #refreshIcon.fa-spin {
                animation: fa-spin 2s infinite linear;
            }

        @@keyframes fa-spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(359deg);
            }
        }

        /* Status badge animations */
        .badge {
            transition: all 0.3s ease;
        }

        /* Countdown timer styling */
        #countdownTimer {
            font-feature-settings: "tnum";
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            #jobDashboardContent .col-4,
            #jobDashboardContent .col-6 {
                margin-bottom: 8px;
            }

            #jobDashboardContent .bg-light {
                padding: 8px 4px;
            }
        }
        /* End  Job monitoring*/

    </style>

    <script>
    // =========================================================================
    // GLOBAL VARIABLES                                                       //
    // =========================================================================
    var commissionTable = null;
    var currentCommissionData = null;
    var treatmentCommissionData = null;
    var collectorReference = null;
    var dailyCollectorId = null;
    var selectedAccountNumber = null;
    var customerData = null;
    var customerAccounts = null;
    const listUrl   = '@Url.Action("List", "CollectorCommission")';

    $(document).ready(function () {
        console.log('Document ready - initializing DataTable...');

        // Initialize DataTable with error handling
        try {
            commissionTable = $('#commissionTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "emptyTable": "No commission data available"
                },
                "footerCallback": function (row, data, start, end, display) {
                    var api = this.api();

                    function toNumber(val) {
                        if (typeof val === 'string') {
                            // remove HTML tags, trim, remove commas, handle parentheses
                            val = val.replace(/<[^>]*>/g, '').trim();
                            var isParens = /^\(.*\)$/.test(val);
                            val = val.replace(/[(),]/g, ''); // remove commas and parentheses
                            var n = parseFloat(val.replace(/[^\d.-]/g, '')) || 0;
                            return isParens ? -n : n;
                        }
                        if (typeof val === 'number') return val;
                        return 0;
                    }

                    // Page totals
                    var pageActivity = api.column(2, { page: 'current' }).data().reduce(function (a, b) { return a + toNumber(b); }, 0);
                    var pageFee = api.column(3, { page: 'current' }).data().reduce(function (a, b) { return a + toNumber(b); }, 0);

                    // Grand totals (all pages)
                    var totalActivity = api.column(2, { page: 'all' }).data().reduce(function (a, b) { return a + toNumber(b); }, 0);
                    var totalFee = api.column(3, { page: 'all' }).data().reduce(function (a, b) { return a + toNumber(b); }, 0);

                    // Put results in footer (example: show "page / total")
                    $('#totalActivityAmount').html(formatCurrency(pageActivity) + ' / ' + formatCurrency(totalActivity));
                    $('#totalFeeAmount').html(formatCurrency(pageFee) + ' / ' + formatCurrency(totalFee));
                }
            });
            console.log('DataTable initialized successfully');
        } catch (error) {
            console.error('Error initializing DataTable:', error);
            $('#commissionTable').addClass('table table-striped table-bordered');
        }

        // Initialize Select2 for main form dropdowns
        if ($.fn.select2) {
            $('#BranchId').select2();
            $('#CollectorId').select2();
        }

        // Branch change event
        $('#BranchId').change(function () {
            var branchId = $(this).val();
            if (branchId) {
                loadCollectors(branchId);
            } else {
                $('#CollectorId').html('<option value="">--- Select Collector ---</option>');
                if ($.fn.select2) {
                    $('#CollectorId').select2();
                }
            }
        });

        // Real-time validation for incentives and ExpenseGL
        $('#Incentives').on('input change blur', function () {
            var incentives = parseFormattedCurrency($(this).val()) || 0;
            var expenseGL = $('#ExpenseGL').val();

            if (incentives > 0) {
                $(this).addClass('positive-value');

                if (!expenseGL) {
                    // Add visual warning
                    $('.field-warning-expensegl').remove();
                    $('#ExpenseGL').parent().append(
                        '<small class="text-warning field-warning-expensegl">' +
                        '<i class="mdi mdi-alert-circle me-1"></i>Required when incentives is greater than 0</small>'
                    );
                } else {
                    $('.field-warning-expensegl').remove();
                }
            } else {
                $(this).removeClass('positive-value');
                $('.field-warning-expensegl').remove();
            }
        });

        $('#ExpenseGL').on('change', function () {
            var incentives = parseFormattedCurrency($('#Incentives').val()) || 0;
            if (incentives > 0 && $(this).val()) {
                $('.field-warning-expensegl').remove();
            }
        });

        // Get Commission button click
        $('#btnGetCommission').click(function () {
            // Validate required fields
            if (!$('#BranchId').val()) {
                appalert('Please select a branch', 3, 1);
                return;
            }
            if (!$('#CollectorId').val()) {
                appalert('Please select a collector', 3, 1);
                return;
            }
            if (!$('#MonthYear').val()) {
                appalert('Please select month and year', 3, 1);
                return;
            }
            getCommissionData();
        });

        // Reset button click
        $('#btnReset').click(function () {
            resetForm();
        });

        // Export button click
        $('#btnExport').click(function () {
            $('#exportModal').modal('show');
        });

        // list button click
        $('#btnList').click(function () {
            const url = listUrl;
            window.open(url, '_blank');
        });

        // Treatment button click
        $('#btnTreatment').click(function () {
            // Check if we have commission data
            if (!currentCommissionData) {
                appalert('Please get commission data first', 3, 1);
                return;
            }

            // Get branch ID from the main form
            var branchId = $('#BranchId').val();
            if (!branchId) {
                appalert('Please select a branch first', 3, 1);
                return;
            }

            // Store collector reference from current commission data
            if (currentCommissionData.CollectorId) {
                collectorReference = currentCommissionData.CollectorId;
                console.log('Stored collector reference:', collectorReference);
            }

            // Load PCMF accounts for this branch before showing modal
            loadPcmfAccountsByBranch(branchId);
        });

        // Retreat button click
        $('#btnRetreat').click(function () {
            // Check if we have commission data
            if (!currentCommissionData) {
                appalert('Please get commission data first', 3, 1);
                return;
            }

            // Get branch ID from the main form
            var branchId = $('#BranchId').val();
            if (!branchId) {
                appalert('Please select a branch first', 3, 1);
                return;
            }

            // Store collector reference from current commission data
            if (currentCommissionData.CollectorId) {
                collectorReference = currentCommissionData.CollectorId;
                console.log('Stored collector reference for retreat:', collectorReference);
            }

            // Load retreat modal or process retreat directly
            processRetreat(branchId);
        });
    });

    // =========================================================================
    // BACKGROUND JOB MONITORING DASHBOARD - UPDATED FOR PARTIAL VIEW         //
    // =========================================================================

    let autoRefreshInterval;
    let countdownInterval;
    let countdownValue = 10;
    let isAutoRefreshEnabled = $('#autoRefreshToggle').is(':checked');

    // Initialize job monitor with server-side data
    function initializeJobMonitor(serverModel) {
        console.log('Initializing job monitor with model:', serverModel);

        if (serverModel && serverModel.AutoRefreshEnabled) {
            startAutoRefresh();
        }
    }

    // Call initialize when document is ready
    $(document).ready(function() {
        // The initializeJobMonitor function will be called from the partial view's script
        // No need to call it here as it's in the partial view
    });

    // Refresh button click handler (using event delegation)
    $(document).on('click', '#refreshJobStatus', function() {
        refreshJobMonitor();
    });

    // Auto-refresh toggle (using event delegation)
    $(document).on('change', '#autoRefreshToggle', function() {
        if ($(this).is(':checked')) {
            startAutoRefresh();
        } else {
            stopAutoRefresh();
        }
    });

    function refreshJobMonitor() {
        // Rotate refresh icon
        $('#refreshIcon').addClass('fa-spin');

        $.ajax({
            url: '@Url.Action("RefreshJobMonitor", "CollectorCommission")',
            type: 'GET',
            success: function (html) {
                // Extract just the job dashboard content and replace it
                var newContent = $(html).find('#jobDashboardContent').html();
                $('#jobDashboardContent').html(newContent);

                // Update last updated time
                $('#jobLastUpdated').html('<i class="mdi mdi-clock-outline me-1"></i>' + new Date().toLocaleTimeString());
            },
            error: function (xhr, status, error) {
                console.error('Error refreshing job monitor:', error);
            },
            complete: function () {
                $('#refreshIcon').removeClass('fa-spin');
            }
        });
    }

    function startAutoRefresh() {
        stopAutoRefresh();

        countdownValue = 10;
        $('#countdownSeconds').text(countdownValue);
        $('#countdownTimer').removeClass('d-none');
        isAutoRefreshEnabled = true;

        countdownInterval = setInterval(function() {
            countdownValue--;
            $('#countdownSeconds').text(countdownValue);

            if (countdownValue <= 0) {
                countdownValue = 10;
                refreshJobMonitor();
            }
        }, 1000);

        autoRefreshInterval = setInterval(function() {
            countdownValue = 10;
        }, 30000);
    }

    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
        if (countdownInterval) {
            clearInterval(countdownInterval);
            countdownInterval = null;
        }
        $('#countdownTimer').addClass('d-none');
        isAutoRefreshEnabled = false;
    }

    // =========================================================================
    // CURRENCY FORMATTING FUNCTIONS
    // =========================================================================

    function formatCurrency(amount) {
        try {
            // If amount is a string with commas, remove them for parsing
            if (typeof amount === 'string') {
                amount = parseFloat(amount.replace(/,/g, '')) || 0;
            }

            // Format with commas for thousands separators (1 decimal place)
            return new Intl.NumberFormat('en-US', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
            }).format(amount || 0);

        } catch (e) {
            // Fallback formatting
            var num = parseFloat(amount) || 0;
            return num.toFixed(1).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        }
    }

    function formatDateToDMY(dateString) {
        if (!dateString) return '';

        const date = new Date(dateString);

        return date.toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        });
    }

    function parseFormattedCurrency(formattedValue) {
        if (!formattedValue) return 0;
        // Remove commas and parse as float
        return parseFloat(formattedValue.toString().replace(/,/g, '')) || 0;
    }

