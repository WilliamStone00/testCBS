    function updateTreatmentButton(mainPaymentStatus, hasNotDebitedMembers, hasDebitedMembers) {
        console.log('Updating treatment button:', {
            mainPaymentStatus: mainPaymentStatus,
            hasNotDebitedMembers: hasNotDebitedMembers,
            hasDebitedMembers: hasDebitedMembers
        });

        // Hide both buttons first
        $('#btnTreatment').addClass('d-none');
        $('#btnRetreat').addClass('d-none');

        // Logic for showing the appropriate button
        if (mainPaymentStatus === 'Paid' || mainPaymentStatus === 'Processed') {
            // Main status is paid - check member statuses
            if (hasNotDebitedMembers && hasDebitedMembers) {
                // Mixed status: some NOT_DEBITED, some DEBITED - show Retreat button
                $('#btnRetreat').removeClass('d-none').prop('disabled', false)
                    .html('<i class="mdi mdi-cash-remove me-1"></i>Retreat');
            } else if (hasNotDebitedMembers) {
                // All members are NOT_DEBITED but main status is paid - show Retreat button
                $('#btnRetreat').removeClass('d-none').prop('disabled', false)
                    .html('<i class="mdi mdi-cash-remove me-1"></i>Retreat');
            } else {
                // All members are DEBITED and main status is paid - show disabled Treatment button
                $('#btnTreatment').removeClass('d-none').prop('disabled', true)
                    .html('<i class="mdi mdi-cash-check me-1"></i>Already Processed');
            }
        } else {
            // Main status is not paid (Pending, etc.) - show Treatment button
            $('#btnTreatment').removeClass('d-none').prop('disabled', false)
                .html('<i class="mdi mdi-cash-check me-1"></i>Treatment');
        }
    }

