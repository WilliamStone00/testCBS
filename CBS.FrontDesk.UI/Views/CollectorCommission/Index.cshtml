    function extractAccountNumber(accountText) {
        // Extract account number from text like "John Doe - 123456789"
        if (!accountText) return '';
        var parts = accountText.split(' - ');
        return parts.length > 1 ? parts[1].trim() : accountText;
    }

    function initializeTreatmentModal() {
        if (currentCommissionData) {
            treatmentCommissionData = currentCommissionData;
            populateCommissionAmounts();
            populateHiddenFields();
