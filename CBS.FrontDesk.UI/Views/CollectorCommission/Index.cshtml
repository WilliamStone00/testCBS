    // Start export process
    exportToExcel(exportData);
});

function updateProgress(percent, message) {
    $('.progress-bar').css('width', percent + '%');
    $('#progressText').text(message);
}

// Your existing exportToExcel function (already in your code)
function exportToExcel(exportData) {
    updateProgress(25, 'Generating Excel file...');

    // Prepare the data for export - match the C# model structure
    var exportPayload = {
        CommissionData: exportData.commissionData,
        ExportOptions: {
            Format: exportData.format,
            IncludeSummary: exportData.includeSummary,
            FileName: exportData.fileName,
            ReportType: exportData.reportType
        }
    };

    // Make AJAX call to export endpoint
    $.ajax({
        url: '@Url.Action("ExportCommissionToExcel", "CollectorCommission")',
        type: 'POST',
        data: JSON.stringify(exportPayload),
        contentType: 'application/json',
        xhrFields: {
            responseType: 'blob' // Important for file download
        },
        beforeSend: function () {
            $('#btnConfirmExport').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Exporting...');
        },
        success: function (data, status, xhr) {
            updateProgress(100, 'Download ready!');

            // Get filename from response headers
            var filename = 'Commission_Report.xlsx';
            var disposition = xhr.getResponseHeader('Content-Disposition');
            if (disposition && disposition.indexOf('attachment') !== -1) {
                var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                var matches = filenameRegex.exec(disposition);
                if (matches != null && matches[1]) {
                    filename = matches[1].replace(/['"]/g, '');
                }
            }

            // Create blob and download
            var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            var link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Close modal after successful export
            setTimeout(function () {
                $('#exportModal').modal('hide');
                $('#exportProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
            }, 1000);
        },
        error: function (xhr, status, error) {
            appalert('Error exporting data: ' + error, 4, 1);
            $('#exportProgress').addClass('d-none');
            $('.progress-bar').css('width', '0%');
        },
        complete: function () {
            $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
        }
    });
}

