@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.CollectorComissionResponse

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-cash me-2"></i>Collector Commission Management
                </h1>
                <p class="card-text">
                    @*CollectorCommissionText*@
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    we are going to manage Dailly Collector Commissions on this page
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseCommissionTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-month text-success me-2"></i>
                    <strong>MonthYear:</strong> MonthYearText1 <code>09/2025</code> MonthYearText2.
                </li>
                <li>
                    <i class="mdi mdi-account-group text-info me-2"></i>
                    <strong>Collector:</strong> CollectorText1 <code>SelectCollector</code> CollectorText2.
                </li>
                <li>
                    <i class="mdi mdi-office-building text-warning me-2"></i>
                    <strong>Branch:</strong> BranchText
                </li>
                <li>
                    <i class="mdi mdi-cash-sync text-primary me-2"></i>
                    <strong>OperationType:</strong> OperationTypeText
                </li>
                <li>
                    <i class="mdi mdi-download-box text-secondary me-2"></i>
                    <strong>Export:</strong> Click <strong>Export</strong> ExportText
                </li>
                <li>
                    <i class="mdi mdi-cash-check text-success me-2"></i>
                    <strong>Treatment:</strong> TreatmentText
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Commission Filter Card -->
<div class="card mb-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Get Commission</h6>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionFilter" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>
    <div id="collapseCommissionFilter" class="collapse show">
        <div class="card-body">
            <!-- Branch selector (full width) -->
            <div class="row mb-2">
                <div class="col-md-12">
                    <div class="form-group mb-2">
                        <label for="BranchId" class="form-label fw-semibold">🏢 Select Branch</label>
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <div class="mt-1 small text-muted">
                            Choose a branch to continue and load branch accounts.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collector and MonthYear row -->
            <div class="row mb-2">
                <div class="col-md-6 mb-2">
                    <div class="form-group mb-2">
                        <label for="CollectorId" class="form-label fw-semibold">👤 Collector</label>
                        @Html.DropDownList("CollectorId",
                            new List<SelectListItem> { new SelectListItem { Text = "--- Select Collector ---", Value = "" } },
                            new { @class = "form-control select2", id = "CollectorId" })
                        <div id="collectorLoader" class="spinner-border spinner-border-sm text-primary d-none" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-2">
                    <div class="form-group mb-2">
                        <label for="MonthYear" class="form-label fw-semibold">📅 Month / Year</label>
                        <input type="month" id="MonthYear" name="MonthYear" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="row mb-2">
                <div class="col-12 text-end">
                    <button type="button" id="btnGetCommission" class="btn btn-primary me-2">
                        <i class="mdi mdi-search me-1"></i> Get Commission
                    </button>
                    <button type="button" id="btnReset" class="btn btn-secondary">
                        <i class="mdi mdi-refresh me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <!-- Commission Summary Card -->
    <div id="commissionSummary" class="card mb-4 d-none">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Commission Summary</h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionSummary" aria-expanded="true">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
        <div id="collapseCommissionSummary" class="collapse show">
            <div class="card-body">
                <!-- Basic Information Section -->
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-account-group me-2"></i>Collector Information</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium">Collector:</span>
                                    <span id="summaryCollectorName">-</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium">Branch:</span>
                                    <span id="summaryBranchName">-</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="fw-medium">Period:</span>
                                    <span id="summaryPeriod">-</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card h-100 border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-chart-bar me-2"></i>Activity Overview</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalMembers">0</h5>
                                            <small class="text-muted">Total Savers with Activity</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalValue">0.00</h5>
                                            <small class="text-muted">Total Savings Collected</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalFee">0.00</h5>
                                            <small class="text-muted">Total Charged</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3">
                                            <h5 class="text-primary mb-1" id="summaryTotalToDistribute">0.00</h5>
                                            <small class="text-muted">Amount to Distribute</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Distribution Section -->
                <div class="row">
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="mdi mdi-cash-multiple me-2"></i>Distribution Breakdown</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover" id="distributionTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Stakeholder</th>
                                                <th class="text-end">Percentage</th>
                                                <th class="text-end">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Distribution data will be loaded here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 text-end">
                        <button type="button" id="btnExport" class="btn btn-success me-2">
                            <i class="mdi mdi-export me-1"></i>Export
                        </button>
                        <button type="button" id="btnTreatment" class="btn btn-warning">
                            <i class="mdi mdi-cash-check me-1"></i>Treatment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Commission Details Table -->
    <div id="commissionDetails" class="card d-none">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0"><i class="mdi mdi-card-account-details-outline me-1"></i> Savers Details</h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommissionDetails" aria-expanded="true">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
        <div id="collapseCommissionDetails" class="collapse show">
            <div class="card-body">
                <table id="commissionTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Member Id</th>
                            <th>Member Name</th>
                            <th>Total Activity Amount</th>
                            <th>Fee Charged</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Table data will be loaded here -->
                    </tbody>
                    <!-- Footer for totals -->
                    <tfoot>
                        <tr class="table-info fw-bold">
                            <td colspan="2" class="text-end">Totals:</td>
                            <td id="totalActivityAmount">0.00</td>
                            <td id="totalFeeAmount">0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Export Modal -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_ExportCommission")
        </div>
    </div>
</div>

<!-- Treatment Modal -->
<div class="modal fade" id="treatmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_CommissionTreatment")
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Fix Select2 dropdown z-index in Bootstrap modals */
        .select2-container--open {
            z-index: 99999 !important;
        }

        .select2-dropdown {
            z-index: 99999 !important;
        }
    </style>

    <script>
        // =========================================================================
        // GLOBAL VARIABLES
        // =========================================================================
        var commissionTable = null;
        var currentCommissionData = null;
        var treatmentCommissionData = null;

        $(document).ready(function () {
            console.log('Document ready - initializing DataTable...');

            // Initialize DataTable with error handling
            try {
                commissionTable = $('#commissionTable').DataTable({
                    "paging": true,
                    "searching": true,
                    "ordering": true,
                    "info": true,
                    "autoWidth": false,
                    "responsive": true,
                    "language": {
                        "emptyTable": "No commission data available"
                    },
                    "footerCallback": function (row, data, start, end, display) {
                        // Calculate totals for the current page
                        var api = this.api();
                        var totalActivity = 0;
                        var totalFee = 0;

                        // Remove formatting to get numeric data
                        api.column(2, { page: 'current' }).data().each(function (value, index) {
                            totalActivity += parseFloat(value.replace(/[^\d.-]/g, '')) || 0;
                        });

                        api.column(3, { page: 'current' }).data().each(function (value, index) {
                            totalFee += parseFloat(value.replace(/[^\d.-]/g, '')) || 0;
                        });

                        // Update footer
                        $('#totalActivityAmount').html(formatCurrency(totalActivity));
                        $('#totalFeeAmount').html(formatCurrency(totalFee));
                    }
                });
                console.log('DataTable initialized successfully');
            } catch (error) {
                console.error('Error initializing DataTable:', error);
                $('#commissionTable').addClass('table table-striped table-bordered');
            }

            // Initialize Select2 for main form dropdowns
            if ($.fn.select2) {
                $('#BranchId').select2();
                $('#CollectorId').select2();
            }

            // Branch change event
            $('#BranchId').change(function () {
                var branchId = $(this).val();
                if (branchId) {
                    loadCollectors(branchId);
                } else {
                    $('#CollectorId').html('<option value="">--- Select Collector ---</option>');
                    if ($.fn.select2) {
                        $('#CollectorId').select2();
                    }
                }
            });

            // Get Commission button click
            $('#btnGetCommission').click(function () {
                // Validate required fields
                if (!$('#BranchId').val()) {
                    appalert('Please select a branch', 3, 1);
                    return;
                }
                if (!$('#CollectorId').val()) {
                    appalert('Please select a collector', 3, 1);
                    return;
                }
                if (!$('#MonthYear').val()) {
                    appalert('Please select month and year', 3, 1);
                    return;
                }
                getCommissionData();
            });

            // Reset button click
            $('#btnReset').click(function () {
                resetForm();
            });

            // Export button click
            $('#btnExport').click(function () {
                $('#exportModal').modal('show');
            });

            // Treatment button click
            $('#btnTreatment').click(function () {
                // Check if we have commission data
                if (!currentCommissionData) {
                    appalert('Please get commission data first', 3, 1);
                    return;
                }

                // Reset the modal form first
                resetPaymentForm();

                // Set the data in the modal
                if (typeof setCommissionData === 'function') {
                    setCommissionData(currentCommissionData);
                }

                $('#treatmentModal').modal('show');
            });
        });

        // =========================================================================
        // MAIN FORM FUNCTIONS
        // =========================================================================

        function loadCollectors(branchId) {
            $('#collectorLoader').removeClass('d-none');
            $('#CollectorId').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("GetCollectorsByBranch", "CollectorCommission")',
                type: 'GET',
                data: { branchId: branchId },
                success: function (response) {
                    console.log('Collectors response:', response);

                    var options = '<option value="">--- Select Collector ---</option>';

                    if (response && response.length > 0) {
                        $.each(response, function (index, collector) {
                            var collectorId = collector.Value;
                            var collectorName = collector.Text;

                            if (collectorId && collectorName) {
                                options += '<option value="' + collectorId + '">' + collectorName + '</option>';
                            }
                        });
                    }

                    $('#CollectorId').html(options);

                    // Re-initialize Select2 if you're using it
                    if ($.fn.select2) {
                        $('#CollectorId').select2();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading collectors:', error);
                    appalert('Error loading collectors. Please try again.', 4, 1);
                },
                complete: function () {
                    $('#collectorLoader').addClass('d-none');
                    $('#CollectorId').prop('disabled', false);
                }
            });
        }

   function getCommissionData() {
    var monthYear = $('#MonthYear').val();
    if (!monthYear) {
        appalert('Please select Month and Year', 3, 1);
        return;
    }

    var parts = monthYear.split('-');
    var year = parseInt(parts[0]);
    var month = parseInt(parts[1]);

    var model = {
        Year: year,
        Month: month,
        CollectorId: $('#CollectorId').val(),
        BranchId: $('#BranchId').val()
    };

    console.log('Sending request with model:', model);

    $.ajax({
        url: '@Url.Action("GetCommissionData", "CollectorCommission")',
        type: 'POST',
        data: JSON.stringify(model),
        contentType: 'application/json',
        beforeSend: function () {
            $('#commissionSummary').addClass('d-none');
            $('#commissionDetails').addClass('d-none');
        },
        success: function (response) {
            console.log('Full Commission response:', response);
            console.log('MemberStats from response:', response.data?.MemberStats);
            console.log('SharedAmounts from response:', response.data?.SharedAmounts);

            if (response && response.success) {
                // Store the complete response data
                currentCommissionData = response.data;
                displayCommissionData(response.data);
            } else {
                appalert(response.message || 'Error loading commission data', 4, 1);
            }
        },
        error: function (xhr, status, error) {
            console.error('Error loading commission data:', error);
            appalert('Error loading commission data: ' + error, 4, 1);
        }
    });
}

        function displayCommissionData(data) {
            console.log('Displaying commission data:', data);

            if (!data) {
                appalert('No commission data available', 3, 1);
                return;
            }

            // Update basic information
            $('#summaryCollectorName').text(data.CollectorName || 'N/A');
            $('#summaryBranchName').text(data.BranchName || 'N/A');
            $('#summaryPeriod').text(data.Month || 'N/A');

            // Update activity overview
            $('#summaryTotalMembers').text(data.TotalMembersWithActivity || 0);
            $('#summaryTotalValue').text(formatCurrency(data.TotalValueCollected || 0));
            $('#summaryTotalFee').text(formatCurrency(data.TotalFeeCharged || 0));
            $('#summaryTotalToDistribute').text(formatCurrency(data.TotalAmountToDistribute || 0));

            // Update distribution table
            var distributionTable = $('#distributionTable tbody');
            distributionTable.empty();

            if (data.SharedAmounts && data.SharedAmounts.length > 0) {
                $.each(data.SharedAmounts, function(index, item) {
                    var row = '<tr>' +
                        '<td>' + (item.Stakeholder || 'N/A') + '</td>' +
                        '<td class="text-end">' + (item.Percentage ? item.Percentage.toFixed(1) + '%' : 'N/A') + '</td>' +
                        '<td class="text-end">' + formatCurrency(item.Amount || 0) + '</td>' +
                        '</tr>';
                    distributionTable.append(row);
                });
            } else {
                distributionTable.append('<tr><td colspan="3" class="text-center">No distribution data available</td></tr>');
            }

            $('#commissionSummary').removeClass('d-none');

            // Update table - safely handle DataTable operations
            try {
                if (commissionTable && typeof commissionTable.clear === 'function') {
                    // Use DataTable API if available
                    commissionTable.clear();

                    if (data.MemberStats && data.MemberStats.length > 0) {
                        var totalActivity = 0;
                        var totalFee = 0;

                        $.each(data.MemberStats, function (index, member) {
                            var activityAmount = member.TotalActivityAmount || 0;
                            var feeAmount = member.FeeCharged || 0;

                            totalActivity += activityAmount;
                            totalFee += feeAmount;

                            commissionTable.row.add([
                                member.MemberId || '-',
                                member.MemberName || '-',
                                formatCurrency(activityAmount),
                                formatCurrency(feeAmount),
                            ]);
                        });

                        // Update totals in footer
                        $('#totalActivityAmount').text(formatCurrency(totalActivity));
                        $('#totalFeeAmount').text(formatCurrency(totalFee));
                    } else {
                        // Add a "no data" row if memberStats is empty
                        commissionTable.row.add([
                            'No data', 'No data', 'No data', 'No data'
                        ]);
                    }

                    commissionTable.draw();
                } else {
                    // Fallback: manual table update if DataTable not available
                    console.warn('DataTable not available, using manual table update');
                    var tbody = $('#commissionTable tbody');
                    tbody.empty();

                    if (data.MemberStats && data.MemberStats.length > 0) {
                        var totalActivity = 0;
                        var totalFee = 0;

                        $.each(data.MemberStats, function (index, member) {
                            var activityAmount = member.TotalActivityAmount || 0;
                            var feeAmount = member.FeeCharged || 0;

                            totalActivity += activityAmount;
                            totalFee += feeAmount;

                            var row = '<tr>' +
                                '<td>' + (member.MemberId || '-') + '</td>' +
                                '<td>' + (member.MemberName || '-') + '</td>' +
                                '<td>' + formatCurrency(activityAmount) + '</td>' +
                                '<td>' + formatCurrency(feeAmount) + '</td>' +
                                '</tr>';
                            tbody.append(row);
                        });

                        // Update totals in footer
                        $('#totalActivityAmount').text(formatCurrency(totalActivity));
                        $('#totalFeeAmount').text(formatCurrency(totalFee));
                    } else {
                        tbody.append('<tr><td colspan="4" class="text-center">No commission data available</td></tr>');
                    }
                }
            } catch (error) {
                console.error('Error updating commission table:', error);
                appalert('Commission data loaded but could not display table. Check console for details.', 4, 1);
            }

            $('#commissionDetails').removeClass('d-none');
        }

        function resetForm() {
            $('#BranchId').val('');
            $('#CollectorId').html('<option value="">--- Select Collector ---</option>');
            $('#MonthYear').val('');
            $('#commissionSummary').addClass('d-none');
            $('#commissionDetails').addClass('d-none');
            currentCommissionData = null; // Clear stored data

            try {
                if (commissionTable && typeof commissionTable.clear === 'function') {
                    commissionTable.clear().draw();
                } else {
                    $('#commissionTable tbody').empty();
                }
            } catch (error) {
                console.error('Error resetting table:', error);
                $('#commissionTable tbody').empty();
            }

            // Reset totals
            $('#totalActivityAmount').text('0.00');
            $('#totalFeeAmount').text('0.00');

            // Re-initialize Select2 if needed
            if ($.fn.select2) {
                $('#CollectorId').select2();
            }
        }

        function formatCurrency(amount) {
            try {
                // Format without currency symbol, just the number with 2 decimal places
                return new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(amount || 0);
            } catch (e) {
                return (amount || 0).toFixed(2);
            }
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            try {
                return new Date(dateString).toLocaleDateString();
            } catch (e) {
                return '-';
            }
        }

        // =========================================================================
        // TREATMENT MODAL FUNCTIONS
        // =========================================================================

        // Initialize treatment modal events when modal is shown
        $(document).on('shown.bs.modal', '#treatmentModal', function () {
            initializeTreatmentModal();

            // Initialize Select2 dropdowns with modal as parent
            if ($.fn.select2) {
                $('#DailyCollectorAccount').select2({
                    dropdownParent: $('#treatmentModal')
                });
                $('#PaymentGl').select2({
                    dropdownParent: $('#treatmentModal')
                });
            }
        });

        // Event delegation for treatment modal elements
        $(document).on('click', '#btnSearchCustomer', function () {
            var customerRef = $('#customerReference').val();
            if (customerRef) {
                searchCustomer(customerRef);
            } else {
                appalert('Please enter a customer reference', 3, 1);
            }
        });

        $(document).on('input', '#Incentives', function () {
            calculateTotal();
        });

        $(document).on('change', '#DailyCollectorAccount', function () {
            if ($(this).val()) {
                $('#paymentDetails').removeClass('d-none');
            } else {
                $('#paymentDetails').addClass('d-none');
            }
        });

        $(document).on('click', '#btnResetPayment', function () {
            resetPaymentForm();
        });

        $(document).on('submit', '#paymentForm', function (e) {
            e.preventDefault();
            processPayment();
        });

        function initializeTreatmentModal() {
            if (currentCommissionData) {
                treatmentCommissionData = currentCommissionData;
                populateCommissionAmounts();
            }
        }

        function populateCommissionAmounts() {
            if (!treatmentCommissionData || !treatmentCommissionData.SharedAmounts) return;

            // Find Daily Collector and Branch amounts
            var dailyCollectorAmount = 0;
            var branchAmount = 0;

            $.each(treatmentCommissionData.SharedAmounts, function(index, item) {
                if (item.Stakeholder && item.Stakeholder.toLowerCase().includes('collector')) {
                    dailyCollectorAmount = item.Amount || 0;
                }
                if (item.Stakeholder && item.Stakeholder.toLowerCase().includes('branch')) {
                    branchAmount = item.Amount || 0;
                }
            });

            // Set the values
            $('#DaillyCollectorShare').val(dailyCollectorAmount.toFixed(2));
            $('#BranchShare').val(branchAmount.toFixed(2));

            // Calculate initial total (incentives + daily collector share)
            calculateTotal();

            // Set hidden fields
            $('#CollectorId').val(treatmentCommissionData.CollectorId || '');
            $('#BranchId').val(treatmentCommissionData.BranchId || '');
            $('#Month').val(treatmentCommissionData.Month || '');
            $('#Year').val(treatmentCommissionData.Year || '');
        }

        function calculateTotal() {
            var incentives = parseFloat($('#Incentives').val()) || 0;
            var collectorShare = parseFloat($('#DaillyCollectorShare').val()) || 0;
            var total = incentives + collectorShare;
            $('#Total').val(total.toFixed(2));
        }

        function searchCustomer(customerRef) {
            $.ajax({
                url: '@Url.Action("GetCustomerAccounts", "CollectorCommission")',
                type: 'GET',
                data: { customerId: customerRef },
                beforeSend: function () {
                    $('#btnSearchCustomer').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Searching...');
                },
                success: function (response) {
                    if (response.success) {
                        displayCustomerInfo(response.customer);
                        populateAccounts(response.accounts);
                        $('#accountSelection').removeClass('d-none');
                    } else {
                        alert('Customer not found: ' + response.message);
                        $('#customerInfo').addClass('d-none');
                        $('#accountSelection').addClass('d-none');
                        $('#paymentDetails').addClass('d-none');
                    }
                },
                error: function (xhr, status, error) {
                    alert('Error searching customer: ' + error);
                    $('#customerInfo').addClass('d-none');
                    $('#accountSelection').addClass('d-none');
                    $('#paymentDetails').addClass('d-none');
                },
                complete: function () {
                    $('#btnSearchCustomer').prop('disabled', false).html('<i class="mdi mdi-magnify"></i> Search');
                }
            });
        }

        function displayCustomerInfo(customer) {
            $('#customerName').text(customer.FirstName + ' ' + customer.LastName);
            $('#customerId').text(customer.CustomerId);
            $('#customerPhone').text(customer.Phone || 'N/A');
            $('#customerEmail').text(customer.Email || 'N/A');
            $('#customerInfo').removeClass('d-none');
        }

        function populateAccounts(accounts) {
            var options = '<option value="">Select Account</option>';
            $.each(accounts, function (index, account) {
                options += '<option value="' + account.Value + '">' + account.Text + '</option>';
            });
            $('#DailyCollectorAccount').html(options);

            // Re-initialize Select2 with modal as parent
            if ($.fn.select2) {
                $('#DailyCollectorAccount').select2({
                    dropdownParent: $('#treatmentModal')
                });
            }
        }

        function resetPaymentForm() {
            $('#paymentForm')[0].reset();
            $('#customerInfo').addClass('d-none');
            $('#accountSelection').addClass('d-none');
            $('#paymentDetails').addClass('d-none');
            $('#DailyCollectorAccount').html('<option value="">Select Account</option>');
            populateCommissionAmounts(); // Restore commission amounts
        }

        function processPayment() {
            // Validate form
            if (!$('#DailyCollectorAccount').val()) {
                appalert('Please select a Daily Collector Account', 3, 1);
                return;
            }

            var formData = $('#paymentForm').serialize();

            $.ajax({
                url: '@Url.Action("ProcessPayment", "CollectorCommission")',
                type: 'POST',
                data: formData,
                beforeSend: function () {
                    $('button[type="submit"]').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Processing...');
                },
                success: function (response) {
                    if (response.success) {
                        alert('Payment processed successfully!');
                        $('#treatmentModal').modal('hide');
                        resetPaymentForm();
                        // Optionally refresh the main page data
                        if (typeof getCommissionData === 'function') {
                            getCommissionData();
                        }
                    } else {
                        appalert('Error processing payment: ' + response.message, 4,1);
                    }
                },
                error: function (xhr, status, error) {
                    alert('Error processing payment: ' + error);
                },
                complete: function () {
                    $('button[type="submit"]').prop('disabled', false).html('<i class="mdi mdi-check-circle me-1"></i> Post');
                }
            });
        }

        $(document).on('click', '#btnConfirmExport', function () {
    var exportData = {
        format: $('#exportFormat').val(),
        includeSummary: $('#includeSummary').is(':checked'),
        fileName: $('#fileName').val() || 'Commission_Report',
        reportType: $('#reportType').val(),
        commissionData: window.currentCommissionData // Use the global variable
    };

    // Validate commission data
    if (!exportData.commissionData) {
