    $(document).on('click', '#btnConfirmExport', function () {
        // Validate commission data
        if (!window.currentCommissionData) {
            appalert('Please load commission data first before exporting.', 3, 1);
            return;
        }

        // Debug: Check what's in SharedAmounts before sending
        console.log('Current Commission Data:', window.currentCommissionData);
        console.log('SharedAmounts:', window.currentCommissionData.SharedAmounts);

        var exportData = {
            format: $('#exportFormat').val(),
            includeSummary: $('#includeSummary').is(':checked'),
            fileName: $('#fileName').val() || 'Commission_Report',
            reportType: $('#reportType').val(),
            commissionData: window.currentCommissionData
        };

        // Show progress
        $('#exportProgress').removeClass('d-none');
        updateProgress(0, 'Preparing export data...');

        // Start export process
        exportToExcel(exportData);
    });

    function updateProgress(percent, message) {
        $('.progress-bar').css('width', percent + '%');
        $('#progressText').text(message);
    }

    function exportToExcel(exportData) {
        updateProgress(25, 'Generating Excel file...');

        // Prepare the data for export - ensure proper structure
        var exportPayload = {
            CommissionData: {
                // Basic info
                CollectorName: exportData.commissionData.CollectorName,
                BranchName: exportData.commissionData.BranchName,
                Month: exportData.commissionData.Month,
                Year: exportData.commissionData.Year,
                CollectorId: exportData.commissionData.CollectorId,
                BranchId: exportData.commissionData.BranchId,

                // Summary data
                TotalMembersWithActivity: exportData.commissionData.TotalMembersWithActivity,
                TotalValueCollected: exportData.commissionData.TotalValueCollected,
                TotalFeeCharged: exportData.commissionData.TotalFeeCharged,
                TotalAmountToDistribute: exportData.commissionData.TotalAmountToDistribute,

                // CRITICAL: Ensure SharedAmounts is properly structured
                SharedAmounts: exportData.commissionData.SharedAmounts ?
                    exportData.commissionData.SharedAmounts.map(function(item) {
                        return {
                            Stakeholder: item.Stakeholder,
                            Percentage: item.Percentage,
                            Amount: item.Amount
                        };
                    }) : [],

                // Member stats
                MemberStats: exportData.commissionData.MemberStats ?
                    exportData.commissionData.MemberStats.map(function(member) {
                        return {
                            MemberId: member.MemberId,
                            MemberName: member.MemberName,
                            TotalActivityAmount: member.TotalActivityAmount,
                            FeeCharged: member.FeeCharged,
                            PaymentStatus: member.PaymentStatus,
                            lastTransactionDate: member.lastTransactionDate // ✅ camelCase
                        };
                    }) : []
            },
            ExportOptions: {
                Format: exportData.format,
                IncludeSummary: exportData.includeSummary,
                FileName: exportData.fileName,
                ReportType: exportData.reportType
            }
        };

        console.log('Export Payload:', exportPayload);
        console.log('SharedAmounts in payload:', exportPayload.CommissionData.SharedAmounts);

        // Make AJAX call to export endpoint
        $.ajax({
            url: '@Url.Action("ExportCommissionToExcel", "CollectorCommission")',
            type: 'POST',
            data: JSON.stringify(exportPayload),
            contentType: 'application/json',
            xhrFields: {
                responseType: 'blob'
            },
            beforeSend: function () {
                $('#btnConfirmExport').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Exporting...');
            },
            success: function (data, status, xhr) {
                updateProgress(100, 'Download ready!');
                appalert('Excel file downloaded successfully!', 1, 1);

                // Get filename from response headers
                var filename = 'Commission_Report.xlsx';
                var disposition = xhr.getResponseHeader('Content-Disposition');
                if (disposition && disposition.indexOf('attachment') !== -1) {
                    var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    var matches = filenameRegex.exec(disposition);
                    if (matches != null && matches[1]) {
                        filename = matches[1].replace(/['"]/g, '');
                    }
                }

                // Create blob and download
                var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Close modal after successful export
                setTimeout(function () {
                    $('#exportModal').modal('hide');
                    $('#exportProgress').addClass('d-none');
                    $('.progress-bar').css('width', '0%');
                }, 1000);
            },
            error: function (xhr, status, error) {
                console.error('Export error:', error);
                console.error('Response:', xhr.responseText);
                appalert('Error exporting data: ' + error, 4, 1);
                $('#exportProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
            },
            complete: function () {
                $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
            }
        });
    }

    // Reset export form when modal is hidden
    $(document).on('hidden.bs.modal', '#exportModal', function () {
        $('#exportProgress').addClass('d-none');
        $('.progress-bar').css('width', '0%');
        $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
    });
    </script>
