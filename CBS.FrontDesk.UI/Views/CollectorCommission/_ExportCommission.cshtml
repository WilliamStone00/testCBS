@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.CollectorComissionResponse

<div class="modal-body">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-export me-2"></i>Export Commission
                    </h1>
                    <p class="card-text">
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Export commission data with date filtering and serial numbers
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Export Format</label>
            <select class="form-select" id="exportFormat">
                <option value="excel">Excel (.xlsx)</option>
                <option value="csv">CSV (.csv)</option>
                <option value="pdf">PDF (.pdf)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Report Type</label>
            <select class="form-select" id="reportType">
                <option value="full">Full Report</option>
                <option value="dateRange">Date Range Report</option>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Date Range (Optional)</label>
            <div class="input-group">
                <input type="date" class="form-control" id="startDate">
                <span class="input-group-text">To</span>
                <input type="date" class="form-control" id="endDate">
            </div>
            <small class="text-muted">Leave empty to export all data</small>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">File Name</label>
            <input type="text" class="form-control" id="fileName" value="Commission_Report" placeholder="Enter file name">
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="includeSummary" checked>
                <label class="form-check-label fw-semibold" for="includeSummary">Include Summary Report</label>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close me-1"></i>Cancel
    </button>
    <button type="button" class="btn btn-success" id="btnConfirmExport">
        <i class="mdi mdi-export me-1"></i>Export
    </button>
</div>

<!-- Export Progress -->
<div id="exportProgress" class="mt-3 d-none">
    <div class="progress mb-2">
        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
    </div>
    <small class="text-muted" id="progressText">Preparing export...</small>
</div>