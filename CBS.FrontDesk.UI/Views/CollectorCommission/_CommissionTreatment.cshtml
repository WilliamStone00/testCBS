@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.CollectorComissionResponse



<div class="modal-body">

    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-account-cash me-2"></i>Commission Treatment
                    </h1>
                    <p class="card-text">
                        @*CollectorCommissionText*@
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Here we can treat a collectors file
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Search Section -->
    <div class="card mb-8">
        <div class="card-header bg-light">
            <h6 class="card-title mb-0">
                <i class="mdi mdi-account-search me-2"></i> Customer Search
            </h6>
        </div>

        <hr />
        
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <label class="form-label">Customer Reference</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="customerReference" placeholder="Enter Customer Reference">
                        <button class="btn btn-primary" type="button" id="btnSearchCustomer">
                            <i class="mdi mdi-magnify"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Customer Info Display -->
            <div id="customerInfo" class="mt-3 p-3 border rounded d-none">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Customer Name:</strong> <span id="customerName"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Customer Id:</strong> <span id="customerId"></span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-6">
                        <strong>Phone:</strong> <span id="customerPhone"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Email:</strong> <span id="customerEmail"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Details Section -->
    <div class="card">
        <div class="card-header bg-light">
            <h6 class="card-title mb-1">
                <i class="mdi mdi-cash-usd me-2"></i> Payment Details
            </h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("ProcessPayment", "CollectorCommission", FormMethod.Post, new { id = "paymentForm" }))
            {
                <!-- Stacked: Incentives, Daily Collector Share, Total -->
                <div class="row mb-2">
                    <div class="col-12">
                        <label class="form-label">Incentives</label>
                        @Html.TextBoxFor(m => m.Incentives, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Enter incentives" })
                        @Html.ValidationMessageFor(m => m.Incentives)
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <label class="form-label">Daily Collector Share</label>
                        @Html.TextBoxFor(m => m.DaillyCollectorShare, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Enter daily collector share" })
                        @Html.ValidationMessageFor(m => m.DaillyCollectorShare)
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <label class="form-label">Total</label>
                        @Html.TextBoxFor(m => m.Total, new { @class = "form-control", @readonly = "readonly", placeholder = "Calculated total" })
                    </div>
                </div>

                <!-- Branch Share above the two side-by-side fields -->
                <div class="row">
                    <div class="col-12">
                        <label class="form-label">Branch Share</label>
                        @Html.TextBoxFor(m => m.BranchShare, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Enter branch share" })
                        @Html.ValidationMessageFor(m => m.BranchShare)
                    </div>
                </div>

                <!-- Two fields side-by-side: Daily Collector Account + Payment GL -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Daily Collector Account</label>
                        <select id="DailyCollectorAccount" name="DailyCollectorAccount" class="form-select select2">
                            <option value="">Select Account</option>
                            @* Add options or populate via AJAX *@
                        </select>
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PaymentGl, "HO PCMF (optional)", new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.PaymentGl,
                            new SelectList(ViewBag.HoPcmfAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Link to HO PCMF (optional) ---",
                            new { @class = "form-select select2", id = "PaymentGl" })
                        @Html.ValidationMessageFor(m => m.PaymentGl, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 text-end">
                        <button type="button" class="btn btn-secondary" id="btnResetPayment">
                            <i class="mdi mdi-refresh me-1"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-check-circle me-1"></i> Post
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        // Calculate total when incentives or collector share changes
        $('#Incentives, #DaillyCollectorShare').on('input', function () {
            calculateTotal();
        });

        // Customer search
        $('#btnSearchCustomer').click(function () {
            var customerRef = $('#customerReference').val();
            if (customerRef) {
                searchCustomer(customerRef);
            }
        });

        // Reset payment form
        $('#btnResetPayment').click(function () {
            $('#paymentForm')[0].reset();
            $('#customerInfo').addClass('d-none');
            $('#DaillyCollectorAccount').html('<option value="">SelectAccount</option>');
        });

        // Form submission
        $('#paymentForm').submit(function (e) {
            e.preventDefault();
            processPayment();
        });
    });

    function calculateTotal() {
        var incentives = parseFloat($('#Incentives').val()) || 0;
        var collectorShare = parseFloat($('#DaillyCollectorShare').val()) || 0;
        var total = incentives + collectorShare;
        $('#Total').val(total.toFixed(2));
    }

    function searchCustomer(customerRef) {
        $.ajax({
            url: '@Url.Action("GetCustomerAccounts", "CollectorCommission")',
            type: 'GET',
            data: { customerId: customerRef },
            beforeSend: function () {
                // Show loader
            },
            success: function (response) {
                if (response.success) {
                    displayCustomerInfo(response.customer);
                    populateAccounts(response.accounts);
                } else {
                    alert('Customer not found: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('Error searching customer: ' + error);
            }
        });
    }

    function displayCustomerInfo(customer) {
        $('#customerName').text(customer.FirstName + ' ' + customer.LastName);
        $('#customerId').text(customer.CustomerId);
        $('#customerPhone').text(customer.Phone || 'N/A');
        $('#customerEmail').text(customer.Email || 'N/A');
        $('#customerInfo').removeClass('d-none');
    }

    function populateAccounts(accounts) {
        var options = '<option value="">SelectAccount</option>';
        $.each(accounts, function (index, account) {
            options += '<option value="' + account.Value + '">' + account.Text + '</option>';
        });
        $('#DaillyCollectorAccount').html(options);
    }

    function processPayment() {
        var formData = $('#paymentForm').serialize();

        $.ajax({
            url: '@Url.Action("ProcessPayment", "CollectorCommission")',
            type: 'POST',
            data: formData,
            success: function (response) {
                if (response.success) {
                    alert('Payment processed successfully!');
                    $('#treatmentModal').modal('hide');
                    $('#paymentForm')[0].reset();
                } else {
                    alert('Error processing payment: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('Error processing payment: ' + error);
            }
        });
    }
</script>
