@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorCommission.CollectorComissionResponse

<div class="modal-body">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-account-cash me-2"></i>Commission Treatment
                    </h1>
                    <p class="card-text">
                        @*CollectorCommissionText*@
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Here we can treat a collectors file
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Search Section -->
    <div class="card mb-3">
        <div class="card-header bg-light">
            <h6 class="card-title mb-0">
                <i class="mdi mdi-account-search me-2"></i> Customer Search
            </h6>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <label class="form-label">Customer Reference</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="customerReference" placeholder="Enter Customer Reference">
                        <button class="btn btn-primary" type="button" id="btnSearchCustomer">
                            <i class="mdi mdi-magnify"></i> Search
                        </button>
                    </div>
                </div>
            </div>

            <!-- Daily Collector Account (appears after successful customer search) -->
            <div id="accountSelection" class="mt-3 d-none">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label">Daily Collector Account</label>
                        <select id="DailyCollectorAccount" name="DailyCollectorAccount" class="form-select select2">
                            <option value="">Select Account</option>
                            @* Accounts will be populated via AJAX *@
                        </select>
                    </div>
                </div>
            </div>

            <!-- Customer Info Display -->
            <div id="customerInfo" class="mt-3 p-3 border rounded d-none">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Customer Name:</strong> <span id="customerName"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Customer Id:</strong> <span id="customerId"></span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-6">
                        <strong>Phone:</strong> <span id="customerPhone"></span>
                    </div>
                    <div class="col-md-6">
                        <strong>Email:</strong> <span id="customerEmail"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Details Section (appears after account selection) -->
    <div id="paymentDetails" class="card d-none">
        <div class="card-header bg-light">
            <h6 class="card-title mb-1">
                <i class="mdi mdi-cash-usd me-2"></i> Payment Details
            </h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("ProcessPayment", "CollectorCommission", FormMethod.Post, new { id = "paymentForm" }))
            {
                <!-- Hidden fields to store data from main form -->
                <input type="hidden" id="CollectorId" name="CollectorId" value="" />
                <input type="hidden" id="BranchId" name="BranchId" value="" />
                <input type="hidden" id="Month" name="Month" value="" />
                <input type="hidden" id="Year" name="Year" value="" />

                <!-- Incentives, Daily Collector Share, Total - side by side -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Incentives</label>
                        @Html.TextBoxFor(m => m.Incentives, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Enter incentives" })
                        @Html.ValidationMessageFor(m => m.Incentives)
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Daily Collector Share</label>
                        @Html.TextBoxFor(m => m.DaillyCollectorShare, new { @class = "form-control", type = "number", step = "0.01", @readonly = "readonly", placeholder = "Auto-filled" })
                        @Html.ValidationMessageFor(m => m.DaillyCollectorShare)
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Total</label>
                        @Html.TextBoxFor(m => m.Total, new { @class = "form-control", @readonly = "readonly", placeholder = "Calculated total" })
                    </div>
                </div>

                <!-- Branch Share and HO PCMF side by side -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Branch Share</label>
                        @Html.TextBoxFor(m => m.BranchShare, new { @class = "form-control", type = "number", step = "0.01", @readonly = "readonly", placeholder = "Auto-filled" })
                        @Html.ValidationMessageFor(m => m.BranchShare)
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PaymentGl, "Payment Account", new { @class = "form-label" })
                        @Html.DropDownListFor(
                      m => m.PaymentGl,
                      new SelectList(ViewBag.HoPcmfAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                      "--- Sellect Account ---",
                      new { @class = "form-select select2", id = "PaymentGl" })
                        @Html.ValidationMessageFor(m => m.PaymentGl, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                    <label for="AccountingDay" class="form-label mb-1">
                        📅 Accounting Date
                    </label>
                    @Html.TextBoxFor(
                        m => m.AccountingDate,
                        new
                        {
                            @class = "form-control accounting-date",
                            type = "date",
                            id = "AccountingDay",
                            required = "required",
                            data_val = "true",
                            data_val_required = "Accounting date is required",
                            value = DateTime.Today.ToString("yyyy-MM-dd"),
                            max = DateTime.Today.ToString("yyyy-MM-dd")
                        })
                    @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                </div>

                <div class="row">
                    <div class="col-12 text-end">
                        <button type="button" class="btn btn-secondary" id="btnResetPayment">
                            <i class="mdi mdi-refresh me-1"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-check-circle me-1"></i> Post
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>