@* _AffiliateData.cshtml *@
@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:18%" />  @* CreatedDate *@
                    <col style="width:20%" />  @* Account Number *@
                    <col style="width:30%" />  @* Name *@
                    <col style="width:17%" />  @* Class *@
                    <col style="width:15%" />  @* Actions *@
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>@AccountingV2.CreatedDate</th>
                        <th>Account Number</th>
                        <th>@AccountingV2.Name</th>
                        <th>@AccountingV2.Class</th>
                        <th style="width:160px">@AccountingV2.Actions</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
