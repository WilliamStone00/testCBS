@model CBS.FrontDesk.Data.Entity.Accounting_V2.AffiliateAccount.AffiliateAccountQuery
@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}

<style>
    .compact .card {
        margin-bottom: .5rem !important
    }

    .compact .card-body {
        padding: .75rem !important
    }

    .compact .card-header {
        padding: .5rem .75rem !important
    }

    .compact .form-label {
        margin-bottom: .2rem !important
    }

    .compact .form-check {
        margin-bottom: 0 !important
    }

    .compact .row.g-1 > [class^="col-"] {
        margin-bottom: .5rem
    }
</style>

<div class="compact">
    <!-- Header -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center py-2">
                    <h5 class="card-title text-primary mb-1">
                        <i class="mdi mdi-account-group me-2"></i>@AccountingV2.AffiliateAccountManagement
                    </h5>
                    <p class="card-text small mb-0">@AccountingV2.AffiliateManagementtext</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tips -->
    <div class="card mb-2">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span class="small"><i class="mdi mdi-information-outline me-2"></i>@GlobalShared.Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseAffiliateTips" class="collapse">
            <div class="card-body py-2">
                <ul class="mb-0 small">
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>@GlobalShared.Code:</strong> @AccountingV2.codetext</li>
                    <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>@GlobalShared.Name:</strong> @AccountingV2.Nametext</li>
                    <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>@GlobalShared.Status:</strong> @AccountingV2.Statustext</li>
                    <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>@GlobalShared.Created_Dates:</strong> @AccountingV2.CreatedDatestext</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm p-2 mb-2">
        <h6 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i>@AccountingV2.AffiliateFilters</h6>

        @using (Html.BeginForm("Index", "AffiliateAccount", FormMethod.Get, new { id = "affiliateFilterForm", autocomplete = "off" }))
        {
            <div class="card p-2 mb-2 bg-light">
                <!-- Row 1 -->
                <div class="row g-1">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Class, "Class", new { @class = "form-label fw-bold small" })
                        @Html.DropDownListFor(
                          m => m.Class,
                          new SelectList(ViewBag.Classes ?? new List<SelectListItem>(), "Value", "Text"),
                          "--- Select Class ---",
                          new { @class = "form-select form-select-sm select2", id = "Class" }
                        )
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Code, GlobalShared.Code, new { @class = "form-label fw-bold small" })
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-sm", placeholder = "Account Number / Code" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Name, GlobalShared.Name, new { @class = "form-label fw-bold small" })
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-sm", placeholder = "Affiliate name" })
                    </div>
                </div>

                <!-- Show Created Date toggle -->
                @*<div class="row mt-2 align-items-center">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="toggleCreatedDates"
                                   onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                            <label class="form-check-label fw-bold small" for="toggleCreatedDates">@AccountingV2.ShowCreatedDateFilters</label>
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <small class="text-muted">@AccountingV2.Affiliatetext1.</small>
                    </div>
                </div>*@

                <!-- Created Dates -->
               @*<div id="createdDateFilters" class="d-none">*@
                    <div class="row g-1 mt-1">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.CreatedFromUtc, GlobalShared.Created_From + " (UTC)", new { @class = "form-label fw-bold small" })
                            @Html.TextBoxFor(m => m.CreatedFromUtc, new { @class = "form-control form-control-sm", type = "date" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.CreatedToUtc, GlobalShared.Created_To + " (UTC)", new { @class = "form-label fw-bold small" })
                            @Html.TextBoxFor(m => m.CreatedToUtc, new { @class = "form-control form-control-sm", type = "date" })
                        </div>
                    </div>
                @*</div>*@

                <!-- Include Deleted -->
                <div class="row g-1 mt-1">
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                            @Html.LabelFor(m => m.IncludeDeleted, @AccountingV2.IncludeDeleted, new { @class = "form-check-label fw-bold small" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-12 d-flex gap-2">
                    <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary btn-sm flex-fill">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                    </button>
                    <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary btn-sm flex-fill">
                        <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end mb-2">
        <button id="btnAddRootAffiliate" type="button" class="btn btn-success btn-sm">
            <i class="mdi mdi-plus-circle-outline me-1"></i> @GlobalShared.Add Account Number
        </button>
    </div>

    <!-- Data -->
    <div id="datalistingview">
        @Html.Partial("_Data")
    </div>

    <!-- Details Modal -->
    <div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit/Create Modal -->
    <div class="modal fade" id="affiliateEditModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
(function($, w){
  'use strict';

  // ===== ROUTES =====
  const dataUrl        = '@Url.Action("LoadAffiliateData", "AffiliateAccount")';
  const detailUrl      = '@Url.Action("DetailsPartial", "AffiliateAccount")';
  const initUrl        = '@Url.Action("InitializeData", "AffiliateAccount")';
  const pcmfByClassUrl = '@Url.Action("ListByClass", "ChartOfAccountV2")';

  // ===== STATE =====
  let table = null, tableInitialized = false;

  // Delegate changes inside modals
  $(document).on('change', '#affiliateEditModal #Class', function () {
    onAffiliateClassChange(this.value);
  });
  $(document).on('change', '#affiliateDetailsModal #Class', function () {
    onAffiliateClassChange(this.value);
  });

  // ===== UTIL =====
  function normalizeItems(res){
    if(!res) return [];
    if (typeof res === 'string') { try { return JSON.parse(res); } catch { return []; } }
    if (Array.isArray(res)) return res;
    if (res.items && Array.isArray(res.items)) return res.items;
    if (res.data  && Array.isArray(res.data))  return res.data;
    if (typeof res === 'object') return Object.keys(res).map(k => res[k]);
    return [];
  }

  function fillOptions($sel, items, placeholder){
    $sel.empty();
    if (placeholder) $sel.append(new Option(placeholder, ''));
    normalizeItems(items).forEach(x => {
      const id   = x.Value ?? x.Id ?? x.id ?? '';
      const text = x.Text ?? x.text ?? (x.Code ? (x.Name ? (x.Code + ' - ' + x.Name) : x.Code) : (x.Name || ''));
      $sel.append(new Option(text, id));
    });
    if ($.fn.select2 && $sel.hasClass('select2')) $sel.trigger('change.select2');
  }

  // ===== CLASS → HO PCMF CHAINING =====
  function loadPcmfByClass(cls){
    const $pcmf = $('#HoPcmfAccountId');
    if ($pcmf.length === 0) return;
    if (!cls) { fillOptions($pcmf, [], '--- Link to HO PCMF (optional) ---'); return; }

    $pcmf.prop('disabled', true)
        .html('<option value="">Loading…</option>')
        .trigger('change');

    $.getJSON(pcmfByClassUrl, { cls: cls })
      .done(res => {
        fillOptions($pcmf, res, '--- Link to HO PCMF (optional) ---');
        $pcmf.prop('disabled', false).trigger('change');
      })
      .fail(() => {
        fillOptions($pcmf, [], '--- Link to HO PCMF (optional) ---');
      });
  }

  // Expose inline handler (kept simple: value only)
  w.onAffiliateClassChange = function (cls) { loadPcmfByClass(cls); };

  // ===== FILTERS =====
  function getFilters(){
    const createdFrom = $('#CreatedFromUtc').val();
    const createdTo   = $('#CreatedToUtc').val();

    return {
      Options: {},
      Code: $.trim($('#Code').val()) || null,
      Name: $.trim($('#Name').val()) || null,
      Class: $('#Class').val() || null, // filter control id
      ParentId: $('#ParentId').val() || null,
      HoPcmfAccountId: $('#HoPcmfAccountId').val() || null,
      CreatedFromUtc: createdFrom || null,
      CreatedToUtc: createdTo || null,
      IncludeDeleted: $('#IncludeDeleted').is(':checked')
    };
  }

  // ===== MODALS =====
  function showModalLoading(targetSel){
    const $m = $(targetSel);
    $(`${targetSel} .modal-body`).html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
    // If Class already set (edit), preload PCMF in this modal scope
    const clsVal = $m.find('#Class').val();
    if (clsVal) onAffiliateClassChange(clsVal);
    (bootstrap.Modal.getInstance($m[0]) || new bootstrap.Modal($m[0], { backdrop: 'static' })).show();
  }

  function loadIntoEditModal(url, data){
  
    $.get(url, data)
        .done(html => {
        showModalLoading('#affiliateEditModal');
        $('#affiliateEditModal .modal-body').html(html);
        if ($.fn.select2){
          try {
            $('#affiliateEditModal .select2').each(function(){
              if (!$(this).hasClass('select2-hidden-accessible')){
                $(this).select2({ dropdownParent: $('#affiliateEditModal') });
              }
            });
          } catch(e){ console.warn('select2 in modal init failed', e); }
        }
        // after load: if Class has value, chain PCMF
        const cls = $('#affiliateEditModal #Class').val();
        if (cls) onAffiliateClassChange(cls);
      })
      .fail(() => $('#affiliateEditModal .modal-body').html('<div class="p-3 text-danger">Unable to load content. Please try again.</div>'));
  }

  function loadIntoDetailsModal(url, data){

    $.get(url, data)
        .done(html => {
        showModalLoading('#affiliateDetailsModal');
        $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details.</div>');
        const cls = $('#affiliateDetailsModal #Class').val();
        if (cls) onAffiliateClassChange(cls);
      })
      .fail(() => $('#affiliateDetailsModal .modal-body').html('<div class="p-3 text-danger">Failed to load details.</div>'));
  }

  // ===== ACTION BUTTONS =====
  function actionButtons(row){
    const id = encodeURIComponent(String(row.Id || ''));
    const btnId = 'act_' + (row.Id || Math.random().toString(36).slice(2));
    return `
      <div class="dropdown text-center">
        <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="mdi mdi-cog-outline"></i> Actions
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="${btnId}">
          <li><button type="button" class="dropdown-item btn-detail" data-id="${id}">
            <i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
          <li><button type="button" class="dropdown-item btn-add" data-parentid="${id}">
            <i class="mdi mdi-plus me-1 text-success"></i> Add Affiliate Account Node</button></li>
          <li><button type="button" class="dropdown-item btn-edit" data-id="${id}">
            <i class="mdi mdi-pencil-outline me-1 text-info"></i> Edit</button></li>
        </ul>
      </div>`;
  }

  // ===== DATATABLE =====
  function initDataTable(){
    const selector = '#myDataTable';
    if ($.fn.DataTable.isDataTable(selector)){
      try { $(selector).DataTable().destroy(); } catch(e){ console.warn('destroy failed', e); }
      $(selector + ' tbody').empty();
    }

    table = $(selector).DataTable({
      serverSide: true,
      processing: false,
      responsive: true,
      autoWidth: false,
      pageLength: 10,
      order: [[0, 'desc']],
      columnDefs: [
        { targets: 0, width: '18%' },
        { targets: 1, width: '20%' },
        { targets: 2, width: '30%' },
        { targets: 3, width: '17%' },
        { targets: 4, width: '15%', className: 'text-end', orderable: false, searchable: false }
      ],
      ajax: {
        url: dataUrl,
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: function(d){
          const filters = getFilters();
          filters.Options = {
            draw: d.draw,
            start: d.start,
            length: d.length,
            skip: d.start,
            pageSize: d.length,
            searchValue: d.search?.value || '',
            sortColumnName: '',
            sortColumnDirection: ''
          };
          return JSON.stringify(filters);
        },
        dataSrc: function(json){
          if (!json) return [];
          if (Array.isArray(json.data)) return json.data;
          if (Array.isArray(json.result)) return json.result;
          if (Array.isArray(json.items)) return json.items;
          for (var k in json){ if (Array.isArray(json[k])) return json[k]; }
          return [];
        },
        error: function(){
          $(selector + ' tbody').html('<tr><td colspan="5" class="text-center text-danger">Failed to load data.</td></tr>');
        }
      },
      columns: [
        {
          data: 'CreatedDate', name: 'CreatedDate',
          render: function(data, type, row){
            const v = row.CreatedDate || row.createdDate || row.CreatedOn || row.createdOn;
            return v ? (window.moment ? moment(v).format('DD/MM/YYYY HH:mm:ss') : v) : '-';
          }
        },
        {
          data: 'Code', name: 'AccountNumber',
          render: function(d,t,row){ return row.AccountNumber || row.accountNumber || row.Code || row.code || ''; }
        },
        { data: 'Name',  name: 'Name',  render: (d,t,row) => row.Name || row.name || row.NameEn || row.nameEn || '' },
        { data: 'Class', name: 'Class', render: (d,t,row) => row.Class || row.class || '' },
        { data: null, orderable: false, searchable: false, className: 'text-end', render: (d,t,row) => actionButtons(row) }
      ],
      language: { emptyTable: 'No affiliates found' }
    });

    tableInitialized = true;
  }

  function reloadTable(){
    if (!tableInitialized){
      if ($('#myDataTable').length === 0){ console.error('myDataTable markup missing. Ensure _Data partial is present.'); return; }
      initDataTable();
    } else if (table && table.ajax){
      table.ajax.reload(null, false);
    }
  }

  // ===== INIT + EVENTS =====
  $(function(){
    if ($.fn.select2){
      try { $('#Class1,#ParentId,#HoPcmfAccountId').select2({ width:'100%' }); } catch(e){ console.warn('select2 init failed', e); }
    }

    $('#applyAffiliateFilterBtn').on('click', function(e){ e.preventDefault(); reloadTable(); });

    $('#resetAffiliateFilterBtn').on('click', function(){
      const $f = $('#affiliateFilterForm'); if ($f.length) $f[0].reset();
      if ($.fn.select2){ try { $('#Class1,#ParentId,#HoPcmfAccountId').val(null).trigger('change'); } catch(_){} }
      $('#createdDateFilters').addClass('d-none');
      reloadTable();
    });

    $('#affiliateFilterForm').on('keypress', 'input,select', function(e){
      if (e.which === 13){ e.preventDefault(); reloadTable(); }
    });

    // Buttons
    $(document).on('click', '#btnAddRootAffiliate', function(){
      loadIntoEditModal('@Url.Action("InitializeData", "AffiliateAccount")', { KEY:'', partialView:'_CreateAffiliateRoot', path:'new', serviceOption:'root' });
    });

    $('#datalistingview').on('click', '.btn-detail', function(){
      const id = $(this).data('id'); if (!id) return;
      loadIntoDetailsModal('@Url.Action("DetailsPartial", "AffiliateAccount")', { id: id, partialView: '_AffiliateModals' });
    });

    $('#datalistingview').on('click', '.btn-add', function(){
      const parentId = $(this).data('parentid') || '';
      loadIntoEditModal('@Url.Action("InitializeData", "AffiliateAccount")', { KEY: parentId, partialView: '_CreateAffiliate', path: 'new', serviceOption: 'AffiliateAccount' });
    });

    $('#datalistingview').on('click', '.btn-edit', function(){
      const id = $(this).data('id'); if (!id) return;
      loadIntoEditModal('@Url.Action("InitializeData", "AffiliateAccount")', { KEY: id, partialView: '_CreateAffiliate', path: 'get', serviceOption: 'AffiliateAccount' });
    });
  });

  // Optional: preload on full-page edit forms (not modal)
  $(function () {
    const $cls = $('#Class');
    if ($cls.length) {
      const val = $cls.val();
      if (val) onAffiliateClassChange(val);
    }
  });

})(jQuery, window);
    </script>
}
