@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountRequest
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank-outline me-2"></i> Affiliate Account Node Setup
                </h1>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Create or edit an Affiliate ledger account node under the selected parent.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-help-circle-outline me-2"></i> Tips for Affiliate Account</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Parent:</strong> inherited from the selected node.</li>
                <li><strong>Class:</strong> auto-inherited; you can allow override if your rules permit.</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "AffiliateAccount", FormMethod.Post,
               new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Scope) @* "Affiliate" *@
            @Html.HiddenFor(m => m.Language)
            @Html.HiddenFor(m => m.IsOrigin)
            @Html.HiddenFor(m => m.ParentId) @* set when KEY provided *@
            @Html.HiddenFor(m => m.HoPcmfAccountId) @* set when KEY provided *@
            @Html.HiddenFor(m => m.AffiliateId) @* set when KEY provided *@
            @Html.HiddenFor(m => m.Class) @* set when KEY provided *@

            <div class="mt-2">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ParentId, "Parent Account Reference", new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.ParentId" />
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Scope, "Scope", new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.Scope" />
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Code, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "Code", maxlength = "50" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.Label("Class", new { @class = "form-label small text-muted" })
                        <input type="text" class="form-control" readonly value="@Model.Class" />
                        @* If you want to allow change: replace with DropDownListFor Model.Class (like root) *@
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.NameEn, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.NameEn, new { @class = "form-control", placeholder = "Name (English)", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.NameFr, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.NameFr, new { @class = "form-control", placeholder = "Name (Français)", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger" })
                    </div>
                </div>

                <hr />
@*
                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.AffiliateId, "Affiliate", new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.AffiliateId,
                            ViewBag.Affiliates as IEnumerable<SelectListItem> ?? new List<SelectListItem>(),
                            "--- Select Affiliate ---",
                            new { @class = "form-select select2", @disabled = (Model?.IsOrigin ?? false) ? null : null })
                        @Html.ValidationMessageFor(m => m.AffiliateId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.HoPcmfAccountId, "HO PCMF (optional)", new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.HoPcmfAccountId,
                            ViewBag.HoPcmfAccounts as IEnumerable<SelectListItem> ?? new List<SelectListItem>(),
                            "--- Link to HO PCMF (optional) ---",
                            new { @class = "form-select select2" })
                        @Html.ValidationMessageFor(m => m.HoPcmfAccountId, "", new { @class = "text-danger" })
                    </div>
                </div>*@

                <div class="row mb-3">
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.PostingAllowed, new { @class = "form-check-input", id = "PostingAllowed" })
                            @Html.LabelFor(m => m.PostingAllowed, new { @class = "form-check-label fw-bold ms-2" })
                        </div>
                    </div>
                   @* <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RequiresMapping, new { @class = "form-check-input", id = "RequiresMapping" })
                            @Html.LabelFor(m => m.RequiresMapping, new { @class = "form-check-label fw-bold ms-2" })
                        </div>
                    </div>*@
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Notes, new { @class = "form-control", placeholder = "Notes", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="text-end">
                    @if (string.IsNullOrWhiteSpace(Model?.Id))
                    {
                        <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> Save</button>
                        <button type="reset" class="btn btn-outline-secondary">Reset</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2"><i class="mdi mdi-refresh"></i> Update</button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    }
                </div>
            </div>
        }
    </div>
</div>
