@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountRequest
@using Resources

@{
    // Server-side helpers for conditional hints (no JS)
    var updateType = (Model?.AccountUpdateKind ?? string.Empty).Trim();
    var utUpper = updateType.ToUpperInvariant();

    bool needsOldCode = utUpper.Contains("CODE");
    bool needsOldNameEn = utUpper == "NAMEEN" || utUpper == "NAMES" || utUpper == "CODEANDNAMES";
    bool needsOldNameFr = utUpper == "NAMEFR" || utUpper == "NAMES" || utUpper == "CODEANDNAMES";

    // ✅ NEW: when updating code, we must capture the NEW code too
    bool needsNewCode = needsOldCode;

    var isUpdate = !string.IsNullOrWhiteSpace(Model?.UpdateReference) || !string.IsNullOrWhiteSpace(updateType);
}

<style>
    .compact .card {
        margin-bottom: .5rem !important
    }

    .compact .card-body {
        padding: .75rem !important
    }

    .compact .card-header {
        padding: .5rem .75rem !important
    }

    .compact .form-label {
        margin-bottom: .2rem !important
    }

    .compact .form-check {
        margin-bottom: 0 !important
    }

    .compact .row.g-1 > [class^="col-"] {
        margin-bottom: .5rem
    }

    .required::after {
        content: " *";
        color: #dc3545
    }
</style>

<div class="compact">

    <!-- Header -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center py-2">
                    <h5 class="card-title text-primary mb-1">
                        <i class="mdi mdi-bank-outline me-2"></i> @AffiliateAccount.Affiliate_Account_Node_Setup
                    </h5>
                    <p class="small mb-0">
                        @AffiliateAccount.Create_or_edit_an_Affiliate_ledger_account_node_under_the_selected_parent.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tips -->
    <div class="card mb-2">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span class="small"><i class="mdi mdi-help-circle-outline me-2"></i> @AffiliateAccount.Tips_for_Affiliate_Account</span>
            <span class="small text-muted">@((isUpdate ? "Update request" : "Create request"))</span>
        </h6>
        <div class="card-body py-2">
            <ul class="mb-0 small">
                <li><strong>@GlobalShared.Parent:</strong> @AffiliateAccount.inherited_from_the_selected_node.</li>
                <li><strong>@GlobalShared.Class:</strong> @AffiliateAccount.choose_the_correct_account_class_PCMF_options_will_filter_by_class.</li>
                <li><strong>@GlobalShared.Update_Type:</strong> @AffiliateAccount.choose_what_is_changing_Provide_the_corresponding_previous_values_below.</li>
            </ul>
        </div>
    </div>

    <!-- Form -->
    <div class="card shadow-sm p-2 mb-2">
        <div class="modal-body">
            @using (Html.BeginForm("CreateOrUpdate", "AffiliateAccount", FormMethod.Post,
                   new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
            {
                @Html.AntiForgeryToken()

                @* Hidden/base *@
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Scope) @* "Affiliate" *@
                @Html.HiddenFor(m => m.Language)
                @Html.HiddenFor(m => m.Class)
                @Html.HiddenFor(m => m.UpdateReference)
                @Html.HiddenFor(m => m.ChangeType)
                @Html.HiddenFor(m => m.IsOrigin)
                @Html.HiddenFor(m => m.AffiliateId) @* usually set from context *@
                @Html.HiddenFor(m => m.ParentId) @* set when KEY provided *@

                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-2" })

                <div class="row g-1">
                    <!-- Parent reference (readonly) -->
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ParentAccountNumber, "Parent Account Number", new { @class = "form-label small text-muted" })
                        @Html.TextBoxFor(m => m.ParentAccountNumber, new { @class = "form-control form-control-sm", @readonly = "readonly" })
                    </div>

                    <!-- Scope (readonly) -->
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Scope, "Scope", new { @class = "form-label small text-muted" })
                        @Html.TextBoxFor(m => m.Scope, new { @class = "form-control form-control-sm", @readonly = "readonly" })
                    </div>

                    <!-- HO PCMF (Optional) -->
                    <div class="col-md-7">
                        @Html.LabelFor(m => m.HoPcmfAccountId, "HO PCMF (Optional)", new { @class = "form-label fw-semibold small" })
                        @Html.DropDownListFor(
                            m => m.HoPcmfAccountId,
                            new SelectList(ViewBag.HoPcmfAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Link to HO PCMF (optional) ---",
                            new { @class = "form-select form-select-sm select2", id = "HoPcmfAccountId" })
                        @Html.ValidationMessageFor(m => m.HoPcmfAccountId, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Account Number (Code) -->
                    <div class="col-md-5">
                        @Html.LabelFor(m => m.Code, "Account Number", new { @class = "form-label required fw-semibold small" })
                        @Html.TextBoxFor(
                            m => m.Code,
                            new
                            {
                                @class = "form-control form-control-sm",
                                placeholder = "e.g., 100000000000",
                                maxlength = "50",
                                autocomplete = "off",
                                inputmode = "numeric",
                                pattern = "\\d{12,}",
                                @data_val = "true",
                                @data_val_regex = "Account Number must be numeric with at least 12 digits.",
                                @data_val_regex_pattern = "^\\d{12,}$"
                            })
                        <div class="form-text small">@AffiliateAccount.Numeric_only_at_least_12_digits_Unique_within_the_Affiliate.</div>
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                    </div>

                    @if (isUpdate)
                    {
                        <!-- ===== UPDATE SECTION (No JavaScript) ===== -->
                        <div class="col-12">
                            <div class="border rounded p-2 mt-1">
                                <div class="row g-1">
                                    <!-- Update Type -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.AccountUpdateKind, "Update Type", new { @class = "form-label fw-semibold small required" })
                                        @Html.DropDownListFor(
                                            m => m.AccountUpdateKind,
                                            new SelectList(new[]
                                            {
                                                new { Value = "Code",         Text = "Code only" },
                                                new { Value = "NameEn",       Text = "Name (English) only" },
                                                new { Value = "NameFr",       Text = "Name (French) only" },
                                                new { Value = "Names",        Text = "Names (English & French)" },
                                                new { Value = "CodeAndNames", Text = "Code + Names" }
                                            }, "Value", "Text", updateType),
                                            "--- Select update type ---",
                                            new { @class = "form-select form-select-sm select2" })
                                        <div class="form-text small">@AffiliateAccount.Choose_what_is_changing.</div>
                                        @Html.ValidationMessageFor(m => m.AccountUpdateKind, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Old Account Number -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.CodeOld, "Old Account Number",
                                            new { @class = "form-label fw-semibold small" + (needsOldCode ? " required" : "") })
                                        @Html.TextBoxFor(
                                            m => m.CodeOld,
                                            new
                                            {
                                                @class = "form-control form-control-sm",
                                                placeholder = "Previous account number (≥12 digits)",
                                                inputmode = "numeric",
                                                pattern = "\\d{12,}",
                                                autocomplete = "off"
                                            })
                                        <div class="form-text small">@AffiliateAccount.Required_only_if_Update_Type_includes <strong>Code</strong>.</div>
                                        @Html.ValidationMessageFor(m => m.CodeOld, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- ✅ NEW: New Account Number (only when updating Code) -->
                                    @if (needsNewCode)
                                    {
                                        <div class="col-md-4">
                                            @Html.LabelFor(m => m.Code, "New Account Number",
                                                new { @class = "form-label fw-semibold small required" })
                                            @Html.TextBoxFor(
                                                m => m.Code,
                                                new
                                                {
                                                    @class = "form-control form-control-sm",
                                                    placeholder = "NEW account number (≥12 digits)",
                                                    inputmode = "numeric",
                                                    pattern = "\\d{12,}",
                                                    autocomplete = "off",
                                                    @data_val = "true",
                                                    @data_val_regex = "New Account Number must be numeric with at least 12 digits.",
                                                    @data_val_regex_pattern = "^\\d{12,}$"
                                                })
                                            <div class="form-text small">@AffiliateAccount.Required_because_Update_Type_includes <strong>Code</strong>.</div>
                                            @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                                        </div>
                                    }

                                    <!-- Old Name (English) -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.NameEnOld, "Old Name (English)",
                                            new { @class = "form-label fw-semibold small" + (needsOldNameEn ? " required" : "") })
                                        @Html.TextBoxFor(
                                            m => m.NameEnOld,
                                            new { @class = "form-control form-control-sm", placeholder = "Previous English name", maxlength = "150" })
                                        <div class="form-text small">
                                            @AffiliateAccount.Required_if_Update_Type_is <strong>NameEn</strong>, <strong>Names</strong>, @GlobalShared.or <strong>CodeAndNames</strong>.
                                        </div>
                                        @Html.ValidationMessageFor(m => m.NameEnOld, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Old Name (French) -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.NameFrOld, "Old Name (French)",
                                            new { @class = "form-label fw-semibold small" + (needsOldNameFr ? " required" : "") })
                                        @Html.TextBoxFor(
                                            m => m.NameFrOld,
                                            new { @class = "form-control form-control-sm", placeholder = "Ancien nom en français", maxlength = "150" })
                                        <div class="form-text small">
                                            @AffiliateAccount.Required_if_Update_Type_is <strong>NameFr</strong>, <strong>Names</strong>, @GlobalShared.or <strong>CodeAndNames</strong>.
                                        </div>
                                        @Html.ValidationMessageFor(m => m.NameFrOld, "", new { @class = "text-danger small" })
                                    </div>



                                    <!-- Post Code -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.PostCode, "Code Post", new { @class = "form-label fw-semibold small" })
                                        @Html.TextBoxFor(m => m.PostCode, new
                                        {
                                            @class = "form-control form-control-sm",
                                            maxlength = "20",
                                            placeholder = "Code Post"
                                        })
                                        @Html.ValidationMessageFor(m => m.PostCode, "", new { @class = "text-danger small" })
                                    </div>


                                    <!-- Nature -->
                                    <div class="col-md-4">
                                        @Html.LabelFor(m => m.Nature, new { @class = "form-label required fw-semibold small" })
                                        @Html.DropDownListFor(
                                            m => m.Nature,
                                            new List<SelectListItem>
                                            {
                                                new SelectListItem { Text = "Debit", Value = "Debit" },
                                                new SelectListItem { Text = "Credit", Value = "Credit" }
                                            },
                                            "--- Select Nature ---",
                                            new { @class = "form-select form-select-sm select2" })
                                        @Html.ValidationMessageFor(m => m.Nature, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <div class="small text-muted mt-1">
                                    <strong>@GlobalShared.Note:</strong> @AffiliateAccount.For_update_requests_provide_the_previous_values_for_each_field_you_re_changing.
                                    @AffiliateAccount.Your_server_side_validator_will_enforce_requirements_based_on_the_selected_Update_Type.
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ===== /UPDATE SECTION ===== -->

                    <hr class="my-2" />

                    <!-- Name EN -->
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.NameEn, "Name (English)", new { @class = "form-label required fw-semibold small" })
                        @Html.TextBoxFor(m => m.NameEn, new { @class = "form-control form-control-sm", placeholder = "English name", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Name FR -->
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.NameFr, "Nom (Français)", new { @class = "form-label required fw-semibold small" })
                        @Html.TextBoxFor(m => m.NameFr, new { @class = "form-control form-control-sm", placeholder = "Nom en français", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        @Html.LabelFor(m => m.Notes, "Notes", new { @class = "form-label fw-semibold small" })
                        @Html.TextBoxFor(m => m.Notes, new { @class = "form-control form-control-sm", placeholder = "Short internal note (max 100 chars)", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-2">
                    @if (string.IsNullOrWhiteSpace(Model?.UpdateReference))
                    {
                        <button type="submit" class="btn btn-primary btn-sm" data-bs-dismiss="modal">
                            <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Save
                        </button>
                        <button type="reset" class="btn btn-outline-secondary btn-sm">
                            <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset
                        </button>
                    }
                    else
                    {
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Update
                </button>
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
                    }
                </div>
            }
        </div>
    </div>
</div>
