@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

@{
    ViewBag.Title = "Cash Replenishment Request";

}



                    <div class="change-group">

                        @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                        
                            <input type="hidden" name="ServiceOption" value="CashInfusionModel" id="ServiceOption" />
                            <div class="row mt-2 gy-4">

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(model => model.CashInfusionModel.Amount, new { @class = "form-control", placeholder = "XFA 0.0" })
                                        @Html.ValidationMessageFor(model => model.CashInfusionModel.Amount, "", new { @class = "text-danger" })
                                        <label for="Amount">Amount</label>
                                    </div>
                                </div>


                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.CashInfusionModel.RequestMessage, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(model => model.CashInfusionModel.RequestMessage, "", new { @class = "text-danger" })

                                        <label for="Description"> RequestMessage</label>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-4">
                                @if (Model.CashInfusionModel.Id == null)
                                {
                                    <button type="submit" class="btn btn-primary me-2">Save</button>
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                }
                                else
                                { <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.CashInfusionModel.Id)
                                    <input type="hidden" name="Action" value="update" id="Action" />
                                }
                            </div>
                        }

                    </div>
          