
@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

@{
    ViewBag.Title = "Cash Replenishment Request";

}



<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                BRANCH CASH DEPOSIT REQUEST
            </button>
        </h2>

        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">

                <div id="datalistingview_CashDepositRequest">
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <table class="table table-hover" id="HeadOfficeDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Branch Office</th>
                                            <th>Issued By</th>
                                            <th>Amount(FCFA)</th>
                                            <th>Issued Date</th>
                                            <th>Status</th>
                                            <th>Message</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{

                                            foreach (var d in Model.ListDepositNotificationDto)
                                            {


                                                <tr>
                                                    <td style="width:15%">@d.BranchOffice</td>
                                                    <td style="width:15%">@d.Temp1</td>
                                                    <td style="width:15%">
                                                        @{
                                                            var formatedAmount = Convert.ToDecimal(d.Amount).ToString("N");
                                                            @formatedAmount
                                                        }
                                                    </td>
                                                    <td style="width:15%">@d.IssueDate</td>
                                                    @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                    {
                                                        if (d.IsOwner)
                                                        {
                                                            if (d.HasAccount56)
                                                            {
                                                                <td style="width:15%">
                                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                                        <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                                    </span>
                                                                </td>

                                                            }
                                                            else
                                                            {
                                                                <td style="width:15%">
                                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                                        <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                                    </span>
                                                                </td>

                                                            }
                                                        }
                                                        else
                                                        {

                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>
                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                                    {


                                                        if (d.IsOwner)
                                                        {
                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-primary fs-6">
                                                                    <i class="fas fa-arrow-circle-down"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>

                                                        }
                                                        else
                                                        {
                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>
                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-danger fs-6">
                                                                <i class="fas fa-money-bill-wave"></i> <i class="fas fa-times"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                    {

                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-black fs-6">
                                                                <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-success fs-6">
                                                                <i class="fas fa-badge-check"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                                    {

                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-warning fs-6">
                                                                <i class="fas fa-share text-primary"></i><i class="fas fa-university"></i>@d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-primary fs-6">
                                                                <i class="fas fa-hourglass-half text-warning"></i>
                                                                <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                    <td style="width:15%">@d.Temp2</td>


                                                    <td style="width:10%">

                                                        @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                        {

                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Upload Deposit Reciept </a>


                                                            @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>*@
                                                        }

                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                        {


                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ApproveCashDepositRequest','approveDepositNotification','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to approve">Approve</a>


                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Bank_CashOut.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Upload Deposit Reciept </a>

                                                        }
                                                        else
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequestStatus','CashFlowManagement')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                        }

                                                    </td>
                                                </tr>





                                            }

                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="table table-hover" id="BranchOfficeDataTable">


                                    <thead class="table-light">
                                        <tr>

                                            <th>Issued By</th>
                                            <th>Amount</th>
                                            <th>Issued Date</th>
                                            <th>Status</th>
                                            <th>Approved By</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>



                                    <tbody>
                                        @{

                                            foreach (var d in Model.ListDepositNotificationDto)
                                            {
                                                if (d.BranchOffice.ToLower().Contains("head office"))
                                                {
                                                    continue;
                                                }
                                                <tr>

                                                    <td style="width:20%">@d.Temp1</td>
                                                    <td style="width:15%">
                                                        @{
                                                            var formatedAmount = Convert.ToDecimal(d.Amount).ToString("N");
                                                            @formatedAmount
                                                        }
                                                    </td>
                                                    <td style="width:15%">@d.IssueDate</td>
                                                    @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                    {
                                                        if (d.IsOwner)
                                                        {
                                                            if (d.HasAccount56)
                                                            {
                                                                <td style="width:15%">
                                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                                        <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                                    </span>
                                                                </td>

                                                            }
                                                            else
                                                            {
                                                                <td style="width:15%">
                                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                                        <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                                    </span>
                                                                </td>

                                                            }
                                                        }
                                                        else
                                                        {

                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>
                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                                    {


                                                        if (d.IsOwner)
                                                        {
                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-primary fs-6">
                                                                    <i class="fas fa-arrow-circle-down"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>

                                                        }
                                                        else
                                                        {
                                                            <td style="width:15%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>
                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-danger fs-6">
                                                                <i class="fas fa-money-bill-wave"></i> <i class="fas fa-times"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                    {

                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-black fs-6">
                                                                <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-success fs-6">
                                                                <i class="fas fa-badge-check"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                                    {

                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-warning fs-6">
                                                                <i class="fas fa-share text-primary"></i><i class="fas fa-university"></i>@d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                                                    {
                                                        <td style="width:15%">
                                                            <span class="badge rounded-pill bg-primary fs-6">
                                                                <i class="fas fa-hourglass-half text-warning"></i>
                                                                <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }


                                                    <td style="width:20%">@d.Temp2</td>

                                                    <td style="width:15%">

                                                        @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                        {

                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Upload Reciept </a>


                                                            @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>*@
                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>

                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                        {


                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ApproveCashDepositRequest','approveDepositNotification','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to approve">Approve</a>


                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Upload Deposit Reciept </a>

                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                                        {
                                                            if (d.IsOwner)
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to approve">View Status</a>


                                                            }
                                                            else
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_BranchToBranchDepositRequest','bankDepositCashClearing','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to approve">Cash Clearing</a>

                                                            }


                                                        }

                                                    </td>
                                                </tr>

                                            }
                                        }
                                    </tbody>
                                </table>
                            }

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>



</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/CashFlowManagementDeposit.js"></script>
}

