
@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.CashReplenishmentRequest;

}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-check me-2"></i> @GlobalCashFlowManagement.CASHMOVEMENT
                </h1>
                <p class="card-text">
                    @GlobalCashFlowManagement.AllCashMovementInTSCAreValidated.
                </p>
                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalCashFlowManagement.InCaseTheyAreLimitedResources.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalCashFlowManagement.TIPSFORCASHMOVEMENTVAULTTOBANK</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalCashFlowManagement.Scenario:</strong> @GlobalCashFlowManagement.IHaveCashInMyOfficeIWant.</li>
                <li><i class="mdi mdi-check-circle-outline  text-primary me-2"></i> <strong>@GlobalCashFlowManagement.Action:  </strong> @GlobalCashFlowManagement.FillInTheCashDenominationInWhich.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalCashFlowManagement.Reason:</strong> @GlobalCashFlowManagement.EnterTheReasonWhyYouWhich.</li>

            </ul>
        </div>
    </div>
</div>

<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                @GlobalCashFlowManagement.BANKCASHDEPOSITVALIDATIONHISTORY
            </button>
        </h2>

        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">

                <div id="datalistingview_CashDepositRequest">
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            @Html.Partial("_SearchOptions")
                  
                            <div id="datalistingview_pendingEntries">

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>



</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/CashFlowManagementDeposit.js"></script>
}

