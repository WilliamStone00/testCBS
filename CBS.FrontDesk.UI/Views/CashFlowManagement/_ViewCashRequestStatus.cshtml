@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "View Cash Replenishment Details";

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId :@Model.CashReplenimentRequestdto.Id Amount : XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N")
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Cash Replenishment Details</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>Branch Office</td>
                                    <td>@Model.CashReplenimentRequestdto.BranchOffice </td>
                                </tr>
                            }
                            <tr>
                                <td>Invoice Number</td>
                                <td>@Model.CashReplenimentRequestdto.ReferenceId </td>
                            </tr>
                            <tr>
                                <td>Amount Requested</td>
                                <td>XAF @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>Request Message</td>
                                <td>@Model.CashReplenimentRequestdto.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>Requested By </td>
                                <td> @Model.CashReplenimentRequestdto.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>Requested Date</td>
                                <td>@Model.CashReplenimentRequestdto.IssuedDate </td>
                            </tr>
                            <tr>
                                <td>Status</td>
                                @if (@Model.CashReplenimentRequestdto.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.CashReplenimentRequestdto.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.CashReplenimentRequestdto.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequestdto.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequestdto.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-header">Cash Replenishment Request Status</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.CashReplenimentRequestdto.IsApproved)
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">@Model.CashReplenimentRequestdto.RequestMessage account is active.</h6>
                                    <p class="mb-0">Un-check the box and click on de-activate button to de-activate account</p>
                                </div>
                            }
                            else
                            {<div class="alert alert-outline-primary" role="alert">
                                    <h6 class="alert-heading mb-1">ReferenceId :@Model.CashReplenimentRequestdto.Id  with Amount XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") has not yet been approved</h6>
                                    <p class="mb-0">Select source account to which the vault will be </p>
                                </div>
                            }
                            <div class="text-end" style="padding-right:2em">

                                <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Close">
                                    <span class="tf-icons mdi mdi-close mdi-18px"></span>
                                </a>

                            </div>
                        </div>

                    </div>
                </div>
               
            </div>
        </div>


    </div>
</div>
