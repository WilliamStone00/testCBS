@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.ViewCashReplenishmentDetails;

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">


        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    @GlobalCashFlowManagement.RequestReferenceId :@Model.CashReplenimentRequestdto.Id @GlobalCashFlowManagement.Amount : XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N")
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th colspan="2"> <h5 class="card-title">@GlobalCashFlowManagement.CashReplenishmentRequestDetails</h5></th>

                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>@GlobalCashFlowManagement.BranchOffice</td>
                                    <td>@Model.CashReplenimentRequestdto.BranchOffice </td>
                                </tr>
                            }
                            <tr>
                                <td>@GlobalCashFlowManagement.InvoiceNumber</td>
                                <td id="referenceId">@Model.CashReplenimentRequestdto.ReferenceId </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.AmountRequested</td>
                                <td id="amountRequested">XAF @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestMessage</td>
                                <td>@Model.CashReplenimentRequestdto.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedBy </td>
                                <td id="IssuedBy"> @Model.CashReplenimentRequestdto.TempId1 </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedDate</td>
                                <td id="IssuedDate">@Model.CashReplenimentRequestdto.IssuedDate </td>
                            </tr>

                            @if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                            {
                                <tr>
                                    <td>@GlobalCashFlowManagement.Status</td>
                                    <td class="badge bg-label-success  text-lowercase">
                                        @Model.CashReplenimentRequestdto.Status

                                        @if (Model.CashReplenimentRequestdto.CorrespondingBranchId == "xxx")
                                        {
                                            <div> @GlobalCashFlowManagement.AuthourizedForCashOut</div>
                                        }
                                        else
                                        {
                                            <div> @GlobalCashFlowManagement.RequestHasBeenRedirectedTo @Model.CashReplenimentRequestdto.CorrespondingBranch</div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedMessage</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedBy </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedDate</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedAmount</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.AmountApproved </td>
                                </tr>

                                <tr>
                                    <td>@GlobalCashFlowManagement.BankTransaction</td>
                                    <td>
                                        @*  <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                        <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">@GlobalCashFlowManagement.BankTransactionDetails</a>
                                    </td>
                                </tr>


                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                            {

                                <tr>
                                    <td>@GlobalCashFlowManagement.Status</td>
                                    <td class="badge bg-label-primary rounded-pill">
                                        @Model.CashReplenimentRequestdto.Status, @GlobalCashFlowManagement.HasNotYetBeenApprovedByHeadOffice
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                                        {
                                            <input type="hidden" name="option" value="Status" id="option" />

                                            <input type="hidden" name="ServiceOption" value="CashInfusionModel" id="ServiceOption" />
                                            <input type="hidden" name="Id" value="@Model.CashReplenimentRequestdto.Id" id="Id" />
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-danger me-2">@GlobalCashFlowManagement.CancelCashRequisitionRequest</button>
                                                <input type="hidden" name="Action" value="update" id="Action" />

                                            </div>

                                        }
                                    </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success rounded-pill">
                                        @Model.CashReplenimentRequestdto.Status
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBCO.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-primary text-uppercase">
                                        @Model.CashReplenimentRequestdto.Status,Has been redirected to @Model.CashReplenimentRequestdto.CorrespondingBranch for BANK CASH OUT
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>

                                </tr>
                                <tr>
                                    <td>Action</td>

                                    <td class="badge bg-label-warning">
                                        <button type="button" class="btn btn-warning" data-toggle="modal" data-target="#acknowledgementModal">
                                            Acknowledge
                                        </button>
                                    </td>

                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                            {

                                <tr>
                                    <td>@GlobalCashFlowManagement.Status</td>
                                    <td class="badge bg-label-warning nav-pills">
                                        @Model.CashReplenimentRequestdto.Status @GlobalCashFlowManagement.HasBeenRedirectedTo @Model.CashReplenimentRequestdto.CorrespondingBranch @GlobalCashFlowManagement.ForBranchTransfer
                                    </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedMessage</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedBy </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>@GlobalCashFlowManagement.ApprovedDate</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                            {



                                <tr>
                                    <td>@GlobalCashFlowManagement.BankTransaction</td>
                                    <td>
                                        @*  <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                        <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="@GlobalCashFlowManagement.View @Model.CashReplenimentRequestdto.ReferenceId @GlobalCashFlowManagement.CashRequest">@GlobalCashFlowManagement.BankTransactionDetails</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td></td>
                                    <td>
                                    </td>
                                </tr>

                            }

                        </tbody>
                    </table>
                    <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.Close">
                        <span class="tf-icons mdi mdi-close mdi-18px"></span>
                    </a>
                </div>

            </div>
        </div>

        @Html.Partial("_Acknowledgement")
        @Html.Partial("_ViewBankTransaction")
    </div>
</div>
 