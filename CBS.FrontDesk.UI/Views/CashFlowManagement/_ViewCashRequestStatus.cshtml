@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "View Cash Replenishment Details";

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
   

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId :@Model.CashReplenimentRequestdto.Id Amount : XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N")
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th colspan="2"> <h5 class="card-title">Cash Replenishment Request Details</h5></th>

                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>Branch Office</td>
                                    <td>@Model.CashReplenimentRequestdto.BranchOffice </td>
                                </tr>
                            }
                            <tr>
                                <td>Invoice Number</td>
                                <td id="referenceId">@Model.CashReplenimentRequestdto.ReferenceId </td>
                            </tr>
                            <tr>
                                <td>Amount Requested</td>
                                <td id="amountRequested">XAF @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>Request Message</td>
                                <td>@Model.CashReplenimentRequestdto.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>Requested By </td>
                                <td id="IssuedBy"> @Model.CashReplenimentRequestdto.TempId1 </td>
                            </tr>
                            <tr>
                                <td>Requested Date</td>
                                <td id="IssuedDate">@Model.CashReplenimentRequestdto.IssuedDate </td>
                            </tr>

                            @if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success  text-lowercase">
                                        @Model.CashReplenimentRequestdto.Status

                                        @if (Model.CashReplenimentRequestdto.CorrespondingBranchId == "xxx")
                                        {
                                            <div> Authourized for cash out</div>
                                        }
                                        else
                                        {
                                            <div> Request has been redirected to @Model.CashReplenimentRequestdto.CorrespondingBranch</div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                                <tr>
                                    <td>Approved Amount</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.AmountApproved </td>
                                </tr>

                                <tr>
                                    <td>Bank Transaction</td>
                                    <td>
                                        @*  <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                        <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>
                                    </td>
                                </tr>


                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-primary rounded-pill">
                                        @Model.CashReplenimentRequestdto.Status,Has not yet been approved by head office
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                                        {
                                            <input type="hidden" name="option" value="Status" id="option" />

                                            <input type="hidden" name="ServiceOption" value="CashInfusionModel" id="ServiceOption" />
                                            <input type="hidden" name="Id" value="@Model.CashReplenimentRequestdto.Id" id="Id" />
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-danger me-2">Cancel Cash Requisition Request</button>
                                                <input type="hidden" name="Action" value="update" id="Action" />

                                            </div>

                                        }
                                    </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success rounded-pill">
                                        @Model.CashReplenimentRequestdto.Status
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBCO.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-primary rounded-pill text-uppercase">
                                        @Model.CashReplenimentRequestdto.Status,Has been redirected to @Model.CashReplenimentRequestdto.CorrespondingBranch for BANK CASH OUT
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>

                                </tr>
                                <tr>
                                    <td>Bank Transaction</td>

                                    <td class="badge bg-label-warning rounded-pill">
                                        NOT YET COMPLETED
                                    </td>

                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                            {

                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-warning nav-pills">
                                        @Model.CashReplenimentRequestdto.Status Has been redirected to @Model.CashReplenimentRequestdto.CorrespondingBranch for Branch Transfer
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.CashReplenimentRequestdto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.CashReplenimentRequestdto.TempId2 </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.CashReplenimentRequestdto.ApprovedDate </td>
                                </tr>
                            }
                            else if (@Model.CashReplenimentRequestdto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                            {



                                <tr>
                                    <td>Bank Transaction</td>
                                    <td>
                                        @*  <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                        <a href="#" onclick="LoadInfomation('@Model.CashReplenimentRequestdto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.CashReplenimentRequestdto.ReferenceId Cash Request">Bank Transaction Details</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td></td>
                                    <td>
                                    </td>
                                </tr>

                            }

                        </tbody>
                    </table>
                    <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Close">
                        <span class="tf-icons mdi mdi-close mdi-18px"></span>
                    </a>
                </div>
           
            </div>
        </div>

        @Html.Partial("_ViewBankTransaction")
    </div>
</div>
