@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

<div class="card-body">



    @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostBankTransaction(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(v => v.BankCashOut.ReferenceId)
        @Html.HiddenFor(v => v.BankCashOut.TransactionType, "CASH OUT")

        @Html.HiddenFor(m => m.BankCashOut.Balance)
        @Html.HiddenFor(m => m.BankCashOut.ToAccountId)


        <input type="hidden" name="ServiceOption" value="bankCashOutApproval" id="ServiceOption" />
        <fieldset class="fieldset-custom">
            <legend id="select_base">Bank accounts information present</legend>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BankCashOut.FromAccountId, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "AccountId" })
                        @Html.ValidationMessageFor(model => model.BankCashOut.FromAccountId, "", new { @class = "text-danger" })
                        <label for="AccountId">Select Bank Account</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex justify-content-end">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex flex-column align-items-end text-end">
                                    <h3 class="mb-3">XAF @Model.BankCashOut.Amount</h3>
                                    <p class="mb-0">Amount authorized by @Model.BankCashOut.ApprovedBy</p>
                                    <p class="mb-0">On the @Model.BankCashOut.ApprovedDate</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6" hidden="hidden">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.BankCashOut.Amount">
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="BranchToBranchTransfer.ReferenceId" value="@Model.BankCashOut.ReferenceId">
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblBalance">Balance: 0</span>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="fieldset-custom">
            <legend id="select_base">Cash Denomination Recieve From Bank</legend>
            <div class="row">

                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.note10000, "", new { @class = "text-danger " })
                        <label>N10,000</label>

                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.note5000, new { @class = "form-control", @id = "Notes_note5000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.note5000, "", new { @class = "text-danger " })
                        <label>N5,000</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.note2000, new { @class = "form-control", @id = "Notes_note2000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.note2000, "", new { @class = "text-danger " })
                        <label>N2,000</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.note1000, new { @class = "form-control", @id = "Notes_note1000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.note1000, "", new { @class = "text-danger " })
                        <label>N1,000</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.note500, new { @class = "form-control", @id = "Notes_note500", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.note500, "", new { @class = "text-danger " })
                        <label>N500</label>
                    </div>
                </div>
                <br>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin500, new { @class = "form-control", @id = "Notes_coin500", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin500, "", new { @class = "text-danger " })
                        <label>C500</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin100, new { @class = "form-control", @id = "Notes_coin100", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin100, "", new { @class = "text-danger " })
                        <label>C100</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin50, new { @class = "form-control", @id = "Notes_coin50", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin50, "", new { @class = "text-danger " })
                        <label>C50</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin25, new { @class = "form-control", @id = "Notes_coin25", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin25, "", new { @class = "text-danger " })
                        <label>C25</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin10, new { @class = "form-control", @id = "Notes_coin10", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin10, "", new { @class = "text-danger " })
                        <label>C10</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin5, new { @class = "form-control", @id = "Notes_coin5", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin5, "", new { @class = "text-danger " })
                        <label>C5</label>
                    </div>
                </div>
                <div class="col-md-2 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.CurrencyNotes.coin1, new { @class = "form-control", @id = "Notes_coin1", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BankCashOut.CurrencyNotes.coin1, "", new { @class = "text-danger " })
                        <label>C1</label>
                    </div>
                </div>

            </div>
        </fieldset>
        <fieldset class="fieldset-custom">
            <legend id="select_base">Bank Cash Out Identification</legend>
            <div class="row">
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BankCashOut.BankTransactionReference, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.BankCashOut.BankTransactionReference, "", new { @class = "text-danger" })

                        <label for="Amount"> Bank Transaction Reference</label>
                    </div>
                </div>
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @*   @Html.TextAreaFor(m => m.BankCashOut.ValueDate, new { @class = "form-control", @style = "height: 200px;" })*@
                        @Html.TextBoxFor(model => model.BankCashOut.ValueDate, new { @class = "form-control date-picker", @type = "datetime-local", @id = "html5-datetime-local-input" })
                        @Html.ValidationMessageFor(model => model.BankCashOut.ValueDate, "", new { @class = "text-danger" })

                        <label for="ValueDate">Date Of Bank CashOut</label>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-sm-4">
                    <div class="form-floating form-floating-outline">
                        @*   @Html.TextAreaFor(m => m.BankCashOut.ValueDate, new { @class = "form-control", @style = "height: 200px;" })*@
                        @Html.TextAreaFor(model => model.BankCashOut.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(model => model.BankCashOut.Description, "", new { @class = "text-danger" })


                        <label>Naration</label>
                    </div>
                </div>
                <div class="col-md-6 mb-sm-4">
                    <div class="upload-container">
                        <div class="image-preview">
                            <img src="@Url.Content(Model.BankCashOut.FileUpload)" alt="No Image Found" id="previewimage" class="img-fluid" />
                        </div>
                        <label for="imageuploadSignature" class="custom-file-upload">
                            <i class="fas fa-cloud-upload-alt"></i> Choose Photo
                        </label>
                        <input type="file" name="BankCashOut.UploadedFile" accept="image/jpeg,image/png,image/JPG" id="imageuploadSignature" onchange="ShowImagePreview(this, document.getElementById('previewimage'))" />
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary me-2" id="btnSave">Validate</button>
            <input type="hidden" name="Action" value="insert" id="Action" />

        </div>

    }






</div>
