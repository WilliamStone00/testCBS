                                            }
                                            else
                                            {
                                                if (d.IsRedirectedTo)
                                                {
                                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_branchToBranchTransfer','BranchToBranchTransfer','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to approve">Branch Transfer</a>

                                                }
                                                else
