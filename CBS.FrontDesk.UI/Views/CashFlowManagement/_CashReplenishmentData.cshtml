                                                            }
                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                                        {
                                                            if (d.IsOwner)
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Cash Clearing </a>
                                                            }
                                                            else
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_ViewCashRequestStatus','status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                            }
                                                        }
                                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBCO.ToString()))
                                                        {


                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Bank Cash Out </a>

                                                        }


                                                    </td>
                                                </tr>
 
                            }
                        }
                    </tbody>
                </table>
            }
        </div>



      
    </div>
</div>

