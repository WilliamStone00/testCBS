@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

@{
    ViewBag.Title = "Pending Cash Deposit Request";
 
}

<div class="table-responsive mb-3">
    @if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
    {
        @Html.Partial("_GeneralErrorDiv")
    }
    <hr />
    <div class="change-group">
        <div class="table-responsive mb-3">
            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
            {
                <table class="table table-hover" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th>Branch Office</th>
                            <th>Issued By</th>
                            <th>Amount(FCFA)</th>
                            <th>Issued Date</th>
                            <th>Status</th>
                            <th>Message</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{

                            foreach (var d in Model.ListCashReplenimentRequestDto)
                            {


                                <tr>
                                    <td style="width:15%">@d.BranchOffice</td>
                                    <td style="width:15%">@d.TempId1</td>
                                    <td style="width:15%">
                                        @{
                                            var formatedAmount = Convert.ToDecimal(d.AmountRequested).ToString("N");
                                            @formatedAmount
                                        }
                                    </td>
                                    <td style="width:15%">@d.IssuedDate</td>
                                    @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                    {
                                        if (d.IsOwner)
                                        {
                                            if (d.HasAccount56)
                                            {
                                                <td style="width:10%">
                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                        <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                    </span>
                                                </td>

                                            }
                                            else
                                            {
                                                <td style="width:10%">
                                                    <span class="badge rounded-pill bg-dark fs-6">
                                                        <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                    </span>
                                                </td>

                                            }
                                        }
                                        else
                                        {

                                            <td style="width:10%">
                                                <span class="badge rounded-pill bg-dark fs-6">
                                                    <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                </span>
                                            </td>
                                        }

                                    }
                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                    {


                                        if (d.IsOwner)
                                        {
                                            <td style="width:10%">
                                                <span class="badge rounded-pill bg-primary fs-6">
                                                    <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                                </span>
                                            </td>

                                        }
                                        else
                                        {
                                            <td style="width:10%">
                                                <span class="badge rounded-pill bg-dark fs-6">
                                                    <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                                </span>
                                            </td>
                                        }

                                    }
                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
