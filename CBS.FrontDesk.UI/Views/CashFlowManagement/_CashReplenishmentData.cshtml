                                            }
                                            else
                                            {
                                                if (d.IsRedirectedTo)
                                                {
                                                    if (d.CashReplishmentRequestStatus == "ORDER")
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Bank Cash Out </a>

                                                    }
                                                    else
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_ViewCashRequestStatus','status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                    }

                                                }
                                                else
                                                {
                                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_ViewCashRequestStatus','status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                }
                                            }
                                            @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_pendingCashMovement','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>*@
                                        }

