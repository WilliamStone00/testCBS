@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.ViewCashReplenishmentDetails;

}
<div class="table-responsive">
    <div class="modal fade" id="exLargeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="exampleModalLabel3">
                        @GlobalCashFlowManagement.BankDepositReceiptInformation :@GlobalCashFlowManagement.Loading ...
                    </h4>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>
                <div class="modal-body">
                    <div class="row invoice-preview">
                        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

                            <div class="accordion-item active">
                              
                                <div class="card-body">

                                    <br />
                                    <div class="collapse show">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th colspan="2"> <h5 class="card-title">@GlobalCashFlowManagement.BankDepositReceiptInformationDetails</h5></th>

                                                </tr>
                                            </thead>
                                            <tbody class="table-border-bottom-0">
                                                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                                                {
                                                    <tr>
                                                        <td>@GlobalCashFlowManagement.BranchOffice</td>
                                                        <td id="BranchName">@GlobalCashFlowManagement.Loading ...</td>
                                                    </tr>
                                                }

                                                <tr>
                                                    <td>@GlobalCashFlowManagement.BalanceBeforeTransaction </td>
                                                    <td id="Balance">@GlobalCashFlowManagement.Loading ... </td>
                                                </tr>

                                                <tr>
                                                    <td>@GlobalCashFlowManagement.Amount </td>
                                                    <td id="Amount">@GlobalCashFlowManagement.Loading ... </td>
                                                </tr>
                                                <tr>
                                                    <td>@GlobalCashFlowManagement.BankTransactionDate</td>
                                                    <td id="BankTransactionDate"> @GlobalCashFlowManagement.Loading ... </td>
                                                </tr>
                                                <tr>
                                                    <td>@GlobalCashFlowManagement.BankTransactionReference</td>
                                                    <td id="TransactionId">@GlobalCashFlowManagement.Loading ... </td>
                                                </tr>
                                                <tr>
                                                    <td>@GlobalCashFlowManagement.BankDepositReciept</td>
                                                    <td>
                                                        <div class="image-preview">
                                                            <img src="@Url.Content(Model.BankCashOut.FileUpload)" alt="No Image Found" id="previewimage" class="img-fluid" />
                                                        </div>

                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
      
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @GlobalShared.Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>




