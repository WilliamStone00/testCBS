@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
    @using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.ViewCashReplenishmentDetails;

}
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{
    @Html.Partial("_GeneralErrorDiv")
}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    @GlobalCashFlowManagement.RequestReferenceId :@Model.CashReplenimentRequestdto.Id @GlobalCashFlowManagement.Amount : FCFA @Model.CashReplenimentRequestdto.AmountRequested
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@GlobalCashFlowManagement.CashReplenishmentDetails</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>@GlobalCashFlowManagement.BranchOffice</td>
                                    <td>@Model.CashReplenimentRequestdto.BranchOffice </td>
                                </tr>
                            }
                            <tr>
                                <td>@GlobalCashFlowManagement.InvoiceNumber</td>
                                <td>@Model.CashReplenimentRequestdto.ReferenceId </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.AmountRequested</td>
                                <td>XAF @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestMessage</td>
                                <td>@Model.CashReplenimentRequestdto.RequestMessage </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedBy </td>
                                <td> @Model.CashReplenimentRequestdto.TempId1 </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.RequestedDate</td>
                                <td>@Model.CashReplenimentRequestdto.IssuedDate </td>
                            </tr>
                            <tr>
                                <td>@GlobalCashFlowManagement.Status</td>
                                @if (@Model.CashReplenimentRequestdto.IsApproved)
                                {
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.CashReplenimentRequestdto.Status
                                    </td>

                                }
                                else
                                {
                                    if (@Model.CashReplenimentRequestdto.Status.ToUpper().Equals("PENDING"))
                                    {
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequestdto.Status
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.CashReplenimentRequestdto.Status
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">
                    <h5 class="card-title">@GlobalCashFlowManagement.CashReplenishmentRequestStatus</h5>
                    <div class="card-body">
                        <div class="mb-3 col-12 mb-0">
                            @if (@Model.CashReplenimentRequestdto.IsApproved)
                            {
                                <div class="alert alert-outline-success" role="alert">
                                    <h6 class="alert-heading mb-1">@GlobalCashFlowManagement.TheCashReplenishmentRequestOf @Model.CashReplenimentRequestdto.TempId1  @GlobalCashFlowManagement.IsAlreadyBeenApprovedBy @Model.CashReplenimentRequestdto.TempId2.</h6>
                                    <p class="mb-0">@{(Convert.ToDecimal(Model.CashReplenimentRequestdto.AmountApproved)).ToString("N");} @GlobalCashFlowManagement.WasReplenished</p>
                                </div>
                            }
                            else
                            {<div class="alert alert-outline-primary" role="alert">
                                 <h6 class="alert-heading mb-1">@GlobalCashFlowManagement.ReferenceId :@Model.CashReplenimentRequestdto.Id  @GlobalCashFlowManagement.withAmount XFA @Model.CashReplenimentRequestdto.AmountRequested.ToString("N") @GlobalCashFlowManagement.HasNotYetBeenApproved</h6>
                                 <p class="mb-0">@GlobalCashFlowManagement.SelectSourceAccountToWhichTheVaultWillBe </p>
                                </div>
                            }

                        </div>
                        @if (@Model.CashReplenimentRequestdto.IsApproved)
                        {

                        }
                        else
                        {
                            using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                            {
                                <!-- Account Details -->
                                @Html.HiddenFor(v => v.CashReplenimentRequestdto.BranchId)
                                @Html.HiddenFor(model => model.CashReplenimentRequestdto.Id)
                                <input type="hidden" name="option" value="Status" id="option" />
                                <input type="hidden" name="ServiceOption" value="CashRequestApproval" id="ServiceOption" />
                                if (Model.CashReplenimentRequestdto.IsApproved)
                                {
                                    <div class="form-check mb-3">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.CashReplenimentRequestdto.IsApproved, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalCashFlowManagement.TheCashReplenishmentRequestOfIssuedBy @Model.CashReplenimentRequestdto.TempId1 @GlobalCashFlowManagement.HasBeenApproved</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">@GlobalCashFlowManagement.AlreadyApprovedAccountReplenishment</button>
                                    </div>

                                }
                                else
                                {
                                    @*if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                    {
                        <div class="form-check mb-3">
                            <div class="form-floating form-floating-outline">

                                @Html.DropDownListFor(m => m.CashReplenimentRequestdto.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.BranchId, "", new { @class = "text-danger" })
                                <label for="Account">Branch Office</label>
                            </div>
                        </div>
                    }*@

                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">

                                            @Html.DropDownListFor(m => m.CashReplenimentRequestdto.TempId2, new SelectList(ViewBag.Decisions == null ? "" : ViewBag.Decisions, "Text", "Value"), "", new { @class = "form-control select2", @search = "true", @id = "MakeDecision" })
                                            @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.ApprovedBy, "", new { @class = "text-danger" })
                                            <label for="Account">@GlobalCashFlowManagement.MakeDecision</label>
                                        </div>
                                    </div>
                                    <div id="hideBranchID">
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.CashReplenimentRequestdto.CorrespondingBranchId, new SelectList(ViewBag.ZoneBranch == null ? "" : ViewBag.ZoneBranch, "Text", "Value"), "", new { @class = "form-control select2", @search = "true",  @id = "CorrespondingBranchID" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.CorrespondingBranchId, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalCashFlowManagement.SelectBranch</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="hideAccountId">
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">

                                                @Html.DropDownListFor(m => m.CashReplenimentRequestdto.TempId3, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.TempId3, "", new { @class = "text-danger" })
                                                <label for="Account">@GlobalCashFlowManagement.SelectDebitingAccount</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="hideAmount">
                                        <div class="form-check mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.CashReplenimentRequestdto.AmountApproved, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.AmountApproved, "", new { @class = "text-danger" })

                                                <label for="Description"> @GlobalCashFlowManagement.ApprovedAmount</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-check mb-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.CashReplenimentRequestdto.ApprovedMessage, new { @class = "form-control", @style = "height: 200px;" })
                                            @Html.ValidationMessageFor(model => model.CashReplenimentRequestdto.ApprovedMessage, "", new { @class = "text-danger" })

                                            <label for="Description"> @GlobalCashFlowManagement.ApprovedMessageDescription</label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <input type="hidden" id="selectedDecision" name="name" value="" />
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Validate</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />

                                    </div>

                                }



                            }

                        }


                    </div>
                                </div>

            </div>
        </div>


    </div>
</div>


