@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                CASH REQUISITION FOR VAULT
            </button>
        </h2>
        <div class="demo-inline-spacing text-end" style="padding-right:2em">

            <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
            </a>
            <a type="button" onclick="AddORUpdateGen(null,'datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','new','CashFlowManagement')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                <span class="tf-icons mdi mdi-plus mdi-18px"></span>
            </a>

        </div>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="datalistingview_CashReplenishmentRequest">
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <table class="table table-hover" id="myRequestDataTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>RequestMessage</th>
                                        <th>AmountRequested</th>
                                        <th>IssuedBy</th>
                                        <th>IssuedDate</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{

                                        foreach (var d in Model.ListCashReplenimentRequest)
                                        {
                                            <tr>

                                                <td style="width:25%">@d.RequestMessage</td>
                                                <td style="width:15%">@d.AmountRequested</td>
                                                <td style="width:25%">@d.IssuedBy</td>
                                                <td style="width:15%">@d.IssuedDate</td>


                                                <td style="width:20%">

                                                    @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','update','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Edit|</a>
        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','status','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Status|</a>*@
                                                    @if (d.Status.Equals("awaiting_corresponding_entry_posting"))
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashRequest','approve','CashFlowManagement')" class="mr-2" id="approving_decision" data-toggle="tooltip" data-placement="top" title="Approve @d.IssuedBy Cash Request">Cash In Fusion</a>

                                                    }
                                                    else
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashRequest','approve','CashFlowManagement')" class="mr-2" id="approving_decision" data-toggle="tooltip" data-placement="top" title="Approve @d.IssuedBy Cash Request">Approve</a>

                                                    }

                                                    @*<a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.AmountRequested" onclick="DeleteRecordDataTable('CashFlowManagement','@d.Id','ListOfCashReplenishmentData','_CashReplenishmentRequestData',0,'datalistingview_CashReplenimentRequest')">Delete</a>*@
                                                </td>
                                            </tr>

                                        }



                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>

            </div>

        </div>



    </div>

</div>



        @section Scripts {@Scripts.Render("~/bundles/jqueryval")
        <script src="~/Scripts/Js/main.js/CashFlowManagement.js"></script>

        }
