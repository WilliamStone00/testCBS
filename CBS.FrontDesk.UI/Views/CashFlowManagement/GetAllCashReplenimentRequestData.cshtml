@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                CASH REQUISITION 
            </button>
        </h2>

        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="datalistingview_CashReplenishmentRequest">
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <table class="table table-hover" id="GetAllCashRequestDataTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Branch Office</th>
                                        <th>AmountRequested</th>
                                        <th>Status</th>
                                        <th>IssuedBy</th>
                                        <th>IssuedDate</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{

                                        foreach (var d in Model.ListCashReplenimentRequest)
                                        {
                                            if (d.BranchOffice.ToLower().Contains("head office"))
                                            {
                                                continue;
                                            }
                                            <tr>

                                                <td style="width:15%">@d.BranchOffice</td>
                                                <td style="width:15%">@d.AmountRequested</td>

                                                @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                {
                                                    if (d.IsOwner)
                                                    {
                                                        if (d.HasAccount56)
                                                        {
                                                            <td style="width:10%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>

                                                        }
                                                        else
                                                        {
                                                            <td style="width:10%">
                                                                <span class="badge rounded-pill bg-dark fs-6">
                                                                    <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                                </span>
                                                            </td>

                                                        }
                                                    }
                                                    else
                                                    {

                                                        <td style="width:10%">
                                                            <span class="badge rounded-pill bg-dark fs-6">
                                                                <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                                {


                                                    if (d.IsOwner)
                                                    {
                                                        <td style="width:10%">
                                                            <span class="badge rounded-pill bg-primary fs-6">
                                                                <i class="fas fa-arrow-circle-down"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>

                                                    }
                                                    else
                                                    {
                                                        <td style="width:10%">
                                                            <span class="badge rounded-pill bg-dark fs-6">
                                                                <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                {
                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-danger fs-6">
                                                            <i class="fas fa-money-bill-wave"></i> <i class="fas fa-times"></i> @d.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                {

                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-black fs-6">
                                                            <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                                        </span>
                                                    </td>

                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                {
                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-success fs-6">
                                                            <i class="fas fa-badge-check"></i> @d.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBCO.ToString()))
                                                {


                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-warning fs-6">
                                                            <i class="fas fa-share text-primary"></i><i class="fas fa-hand-holding-usd text-success"></i>@d.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                                {

                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-warning fs-6">
                                                            <i class="fas fa-share text-primary"></i><i class="fas fa-university"></i>@d.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }
                                                else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Bank_CashOut.ToString()))
                                                {
                                                    <td style="width:10%">
                                                        <span class="badge rounded-pill bg-primary fs-6">
                                                            <i class="fas fa-hourglass-half text-warning"></i>
                                                            <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }

                                                <td style="width:20%">@d.TempId1</td>
                                                <td style="width:20%">@d.IssuedDate</td>
                                                <td style="width:20%">

                                                    @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                                    {
                                                        if (d.IsOwner)
                                                        {
                                                            if (d.HasAccount56)
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Bank Cash Out</a>

                                                            }
                                                            else
                                                            {
                                                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>

                                                            }
                                                        }
                                                        else
                                                        {

                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Bank Cash Out</a>

                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                                                    {


                                                        if (d.IsOwner)
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>


                                                        }

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View</a>

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                                    {


                                                        if (d.IsOwner)
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>


                                                        }
                                                        else
                                                        {

                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashRequest','approve','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Approve</a>

                                                        }
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','complete_status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Complete</a>

                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBCO.ToString()))
                                                    {

                                                        if (d.IsOwner)
                                                        {
                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>


                                                        }
                                                        else
                                                        {

                                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_branchToBranchTransfer','BranchToBranchTransfer','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Branch Transfer</a>

                                                        }
                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_branchToBranchTransfer','BranchToBranchTransfer','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Branch Transfer</a>


                                                    }
                                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Bank_CashOut.ToString()))
                                                    {
                                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Bank Cash Out</a>
                                                    }

                                                </td>
                                            </tr>

                                        }



                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>

            </div>

        </div>



    </div>

</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/CashFlowManagement.js"></script>

}
