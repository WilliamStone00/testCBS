@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity


<div class="card-body">

    @if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
    {
        @Html.Partial("_GeneralErrorDiv")
    }

    @if (Convert.ToBoolean(ViewBag.IsSystemError) == true)
    {
        @Html.Partial("_SystemError")
    }

    @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostBankTransaction(this);", @id = "formValidationExamples" }))
    {
        <input type="hidden" name="ServiceOption" value="BranchToBranchTransfer" id="ServiceOption" />

        <fieldset class="fieldset-custom">
            <legend id="select_base">Branch To Branch Cash Transfer @Model.BranchToBranchTransfer.Accountinfor</legend>
            <div class="row mt-2 gy-4">

                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <div class="col-sm-12 col-lg-12">
                            <div class="d-flex justify-content-between align-items-start border-end pb-3 pb-sm-0 card-widget-6">
                                <div>
                                    @{
                                        var formattedAmount = Convert.ToDecimal(Model.CashReplenimentRequestdto.AmountApproved).ToString("N");
                                    }
                                    <h3 class="mb-3">XAF @formattedAmount</h3>
                                    <p class="mb-0">Amount authorized by @Model.CashReplenimentRequestdto.TempId2 </p>

                                </div>
                                <div class="avatar me-sm-6">
                                    <span class="avatar-initial rounded bg-label-secondary">
                                        <i class="mdi mdi-wallet-outline mdi-24px"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6" hidden="hidden">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.CashReplenimentRequestdto.AmountApproved">
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="BranchToBranchTransfer.ReferenceId" value="@Model.BranchToBranchTransfer.ReferenceId">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblBalance">Balance: 0</span>
                    </div>
                </div>
                @Html.HiddenFor(m => m.BranchToBranchTransfer.ReferenceId)
                @Html.HiddenFor(m => m.BranchToBranchTransfer.ToAccountId)
                @Html.HiddenFor(m => m.BranchToBranchTransfer.FromAccountId)
                <legend>Denomination</legend>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note10000, "", new { @class = "text-danger " })
                        <label>N10,000</label>

                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note5000, new { @class = "form-control", @id = "Notes_note5000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note5000, "", new { @class = "text-danger " })
                        <label>N5,000</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note2000, new { @class = "form-control", @id = "Notes_note2000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note2000, "", new { @class = "text-danger " })
                        <label>N2,000</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note1000, new { @class = "form-control", @id = "Notes_note1000", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note1000, "", new { @class = "text-danger " })
                        <label>N1,000</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note500, new { @class = "form-control", @id = "Notes_note500", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.note500, "", new { @class = "text-danger " })
                        <label>N500</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin500, new { @class = "form-control", @id = "Notes_coin500", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin500, "", new { @class = "text-danger " })
                        <label>C500</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin100, new { @class = "form-control", @id = "Notes_coin100", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin100, "", new { @class = "text-danger " })
                        <label>C100</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin50, new { @class = "form-control", @id = "Notes_coin50", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin50, "", new { @class = "text-danger " })
                        <label>C50</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin25, new { @class = "form-control", @id = "Notes_coin25", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin25, "", new { @class = "text-danger " })
                        <label>C25</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin10, new { @class = "form-control", @id = "Notes_coin10", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin10, "", new { @class = "text-danger " })
                        <label>C10</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin5, new { @class = "form-control", @id = "Notes_coin5", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin5, "", new { @class = "text-danger " })
                        <label>C5</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin1, new { @class = "form-control", @id = "Notes_coin1", @oninput = "calculateCashBalance()", @Value = "0" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.CurrencyNotesRequest.coin1, "", new { @class = "text-danger " })
                        <label>C1</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.BranchToBranchTransfer.Description, new { @class = "form-control", @style = "height: 70px;" })
                        @Html.ValidationMessageFor(m => m.BranchToBranchTransfer.Description, "", new { @class = "text-danger " })
                        <label for="formValidationDob">Branch to branch transfer description</label>
                    </div>
                </div>

            </div>
            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary me-2">Validate</button>
            </div>
        </fieldset>
    }

</div>