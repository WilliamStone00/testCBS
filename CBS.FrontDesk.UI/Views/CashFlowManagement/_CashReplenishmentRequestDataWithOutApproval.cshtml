
@model  CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

@{
    ViewBag.Title = "Cash Replenishment Data";

}

<table class="table table-hover" id="ListOfCashReplenishmentData">
    @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
    {
        <thead class="table-light">
            <tr>
                <th>BranchOffice</th>
                <th>IssuedBy</th>
                <th>Amount Requested</th>

                <th>IssuedDate</th>
                <th>Action</th>
            </tr>
        </thead>

    }
    else
    {
        <thead class="table-light">
            <tr>
                <th>IssuedBy</th>
                <th>Amount Requested</th>

                <th>IssuedDate</th>
                <th>Action</th>
            </tr>
        </thead>
    }


    <tbody>

        @foreach (var d in Model.ListCashReplenimentRequestDto)
        {
            if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
            {
                <tr>
                    <td style="width:20%">@d.BranchOffice</td>
                    <td style="width:20%">@d.IssuedBy</td>
                    <td style="width:20%">@d.AmountRequested</td>

                    <td style="width:20%">@d.IssuedDate</td>

                    <td style="width:20%">

                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','update','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Edit</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Status</a>
                        @* <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashReplenimentRequest','approve','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.IssuedBy Cash Request">Approve|</a>
        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.AmountRequested" onclick="DeleteRecordDataTable('CashFlowManagement','@d.Id','ListOfCashReplenishmentData','_CashReplenishmentRequestData',0,'datalistingview_CashReplenimentRequest')">Delete</a>*@
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td style="width:25%">@d.IssuedBy</td>
                    <td style="width:25%"> @d.AmountRequested</td>
                    <td style="width:30%">@d.IssuedDate</td>

                    <td style="width:20%">

                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashReplenishmentRequest','update','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Edit</a>
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','status','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.IssuedBy Cash Request to edit">Status</a>
                        @*  <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ApproveCashReplenimentRequest','approve','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.IssuedBy Cash Request">Approve|</a>
        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.AmountRequested" onclick="DeleteRecordDataTable('CashFlowManagement','@d.Id','ListOfCashReplenishmentData','_CashReplenishmentRequestData',0,'datalistingview_CashReplenimentRequest')">Delete</a>*@
                    </td>
                </tr>
            }


        }
    </tbody>
</table>