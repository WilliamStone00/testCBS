<div id="datalistingview_CashReplenishmentRequest">

    <table class="table table-hover" id="myRequestDataTable">
        <thead class="table-light">
            <tr>
                <th>Approved By</th>

                <th>AmountApproved</th>

                <th>Approved Date</th>
                <th>ApprovedMessage</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{

                foreach (var d in Model.ListCashReplenimentRequest)
                {
                    <tr>
                        <td style="width:15%">@d.ApprovedBy</td>
                        <td style="width:15%">@d.AmountApproved</td>
                        <td style="width:25%">@d.ApprovedDate</td>
                        <td style="width:25%">@d.ApprovedMessage</td>
                        <td style="width:20%">

                            @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.awaiting_corresponding_entry_posting.ToString()))
                            {
                                if (d.HasAccount56)
                                {
                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateBankCashOutApproval','bankCashOutApproval','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">BankCashOut</a>

                                }
                                else
                                {
                                    <a href="#" onclick="AddORUpdateGen('@d.ReferenceId','datalistingview_CashReplenishmentRequest','_branchToBranchTransfer','BranchToBranchTransfer','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Branch To Branch Transfer</a>

                                }
                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                            {
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pendding.ToString()))
                            {
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>

                            }
                            else if (d.Status.Equals("completed"))
                            {
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','complete_status','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Complete Status</a>

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                            {
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_CreateCashInfusion','awaiting_corresponding_entry_posting','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>

                            }
                            else
                            {
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashReplenishmentRequest','_ViewCashRequestStatus','cashreplenishmentstatus','CashFlowManagement')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">View Status</a>

                            }

                        </td>
                    </tr>

                }



            }
        </tbody>
    </table>

</div>
