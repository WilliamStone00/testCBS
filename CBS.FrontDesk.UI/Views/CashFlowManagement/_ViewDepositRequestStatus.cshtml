@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "View Cash Replenishment Details";

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId :@Model.DepositNotificationDto.Id Amount : XFA @Model.DepositNotificationDto.Amount.ToString("N")
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th colspan="2"> <h5 class="card-title">Bank Deposit Request Details</h5></th>

                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>Branch Office</td>
                                    <td id="branchName">@Model.DepositNotificationDto.BranchOffice </td>
                                </tr>
                            }
                            <tr>
                                <td>Invoice Number</td>
                                <td id="referenceId">@Model.DepositNotificationDto.Id </td>
                            </tr>
                            <tr>
                                <td>Amount Requested</td>
                                <td id="amountRequested">XAF @Model.DepositNotificationDto.Amount.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>Request Message</td>
                                <td>@Model.DepositNotificationDto.Message </td>
                            </tr>
                            <tr>
                                <td>Requested By </td>
                                <td id="IssuedBy"> @Model.DepositNotificationDto.IssuedBy </td>
                            </tr>
                            <tr>
                                <td>Requested Date</td>
                                <td id="IssuedDate">@Model.DepositNotificationDto.IssueDate </td>
                            </tr>

                            @if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approve.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status,but  waiting for action from manager
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.DepositNotificationDto.ApprovedMessage </td>
                                </tr>
                                <tr>
                                    <td>Approved By </td>
                                    <td id="ApprovedBy"> @Model.DepositNotificationDto.ApprovedBy </td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedDate </td>
                                </tr>


                                if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                {



                                }

                            }
                            else
                            {
                                if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                                {
                                    <tr>
                                        <td>Status</td>
                                        <td class="badge bg-label-primary rounded-pill text-uppercase">
                                            @Model.DepositNotificationDto.Status,Has not yet been approved by head office
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                    {
                                        <tr>
                                            <td>Status</td>
                                            <td class="badge bg-label-success rounded-pill text-uppercase">
                                                @Model.DepositNotificationDto.Status
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Approved Message</td>
                                            <td>@Model.DepositNotificationDto.ApprovedMessage </td>
                                        </tr>
                                        <tr>
                                            <td>Approved By </td>
                                            <td id="ApprovedBy"> @Model.DepositNotificationDto.ApprovedBy </td>
                                        </tr>
                                        <tr>
                                            <td>Approved Date</td>
                                            <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedDate </td>
                                        </tr>
                                        <tr>
                                            <td>Bank Transaction</td>
                                            <td>
                                                @*  <a href="#" onclick="LoadInfomation('@Model.DepositNotificationDto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.DepositNotificationDto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                                <a href="#" onclick="LoadInfomation('@Model.DepositNotificationDto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.DepositNotificationDto.IssuedBy BankDeposit Request">Bank Transaction Details</a>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approve.ToString()))
                                        {
                                            <tr>
                                                <td>Status</td>
                                                <td class="badge bg-label-primary rounded-pill text-uppercase">
                                                    @Model.DepositNotificationDto.Status,Awaiting for fund transfer
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Status</td>
                                                <td class="badge bg-label-success rounded-pill text-uppercase">
                                                    @Model.DepositNotificationDto.Status,but  waiting for action from manager
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Approved Message</td>
                                                <td>@Model.DepositNotificationDto.ApprovedMessage </td>
                                            </tr>
                                            <tr>
                                                <td>Approved By </td>
                                                <td id="ApprovedBy"> @Model.DepositNotificationDto.ApprovedBy </td>
                                            </tr>
                                            <tr>
                                                <td>Approved Date</td>
                                                <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedDate </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>Status</td>
                                                <td class="badge bg-label-danger rounded-pill text-uppercase">
                                                    @Model.DepositNotificationDto.Status and aborted
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Approved Message</td>
                                                <td>@Model.DepositNotificationDto.ApprovedMessage </td>
                                            </tr>
                                            <tr>
                                                <td>Approved By </td>
                                                <td id="ApprovedBy"> @Model.DepositNotificationDto.ApprovedBy </td>
                                            </tr>
                                            <tr>
                                                <td>Approved Date</td>
                                                <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedDate </td>
                                            </tr>
                                        }

                                    }
                                }

                            }


                            @if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.awaiting_corresponding_entry_posting.ToString()))
                            {
                                <tr>
                                    <td>Bank Transaction</td>
                                    <td>
                                        @*  <a href="#" onclick="LoadInfomation('@Model.DepositNotificationDto.ReferenceId')" class="mr-2" id="exLargeModal" data-toggle="tooltip" data-placement="top" title="View @Model.DepositNotificationDto.ReferenceId Cash Request">Bank Transaction Details</a>*@
                                        <a href="#" onclick="LoadInfomation('@Model.DepositNotificationDto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.DepositNotificationDto.Id Cash Request">Bank Transaction Details</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td></td>
                                    <td>
                                    </td>
                                </tr>

                            }

                        </tbody>
                    </table>
                    <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Close">
                        <span class="tf-icons mdi mdi-close mdi-18px"></span>
                    </a>
                </div>
                @*@if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                    {
                        <td class="badge bg-label-success rounded-pill text-uppercase">
                            @Model.DepositNotificationDto.Status,but  waiting for action from manager
                        </td>

                    }
                    else
                    {
                        if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                        {
                            <td class="badge bg-label-primary rounded-pill text-uppercase">
                                @Model.DepositNotificationDto.Status,Has not yet been approved by head office
                            </td>
                        }
                        else
                        {
                            if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                            {
                                <div class="card card-action mb-5">
                                    <h5 class="card-title">Cash Replenishment Request Status</h5>
                                    <div class="card-body">
                                        <div class="mb-3 col-12 mb-0">

                                                <div class="alert alert-outline-primary" role="alert">
                                                    <h6 class="alert-heading mb-1">ReferenceId :@Model.DepositNotificationDto.Id  with Amount XFA @Model.DepositNotificationDto.AmountRequested.ToString("N") has been approved</h6>

                                                </div>

                                            <div class="text-end" style="padding-right:2em">



                                            </div>
                                        </div>

                                    </div>
                                </div>

                            }
                            else
                            {
                                if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.awaiting_corresponding_entry_posting.ToString()))
                                {
                                    <td class="badge bg-label-primary rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status,Awaiting for bank transfer
                                    </td>
                                }
                                else
                                {
                                    <td class="badge bg-label-danger rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status and aborted
                                    </td>

                                }

                            }
                        }

                    }
                    @if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                    {

                    }
                    else
                    {

                    }*@

            </div>
        </div>

        @Html.Partial("_ViewBankDepositTransaction")
    </div>
</div>
 