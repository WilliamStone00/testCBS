@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "View Cash Replenishment Details";

}
<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    @{
                        var formatedAmount = Convert.ToDecimal(Model.DepositNotificationDto.Amount).ToString("N");
                    }
                    Request ReferenceId: @Model.DepositNotificationDto.Id Amount: XFA @formatedAmount
                </button>
            </h2>
            <div class="card-body">
                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <h5 class="card-title">Bank Deposit Request Details</h5>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                            {
                                <tr>
                                    <td>Branch Office</td>
                                    <td id="branchName">@Model.DepositNotificationDto.BranchOffice</td>
                                </tr>
                            }
                            <tr>
                                <td>Invoice Number</td>
                                <td id="referenceId">@Model.DepositNotificationDto.Id</td>
                            </tr>
                            <tr>
                                <td>Amount Requested</td>
                                <td id="amountRequested">XAF @formatedAmount</td>
                            </tr>
                            <tr>
                                <td>Request Message</td>
                                <td>@Model.DepositNotificationDto.Message</td>
                            </tr>
                            <tr>
                                <td>Requested By</td>
                                <td id="IssuedBy">@Model.DepositNotificationDto.IssuedBy</td>
                            </tr>
                            <tr>
                                <td>Requested Date</td>
                                <td id="IssuedDate">@Model.DepositNotificationDto.IssueDate</td>
                            </tr>

                            @if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status, but waiting for action from manager
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.DepositNotificationDto.ApprovedMessage</td>
                                </tr>
                                <tr>
                                    <td>Approved By</td>
                                    <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedBy</td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedDate">@Model.DepositNotificationDto.ApprovedDate</td>
                                </tr>
                            }
                            else if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-success rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.DepositNotificationDto.ApprovedMessage</td>
                                </tr>
                                <tr>
                                    <td>Approved By</td>
                                    <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedBy</td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedDate">@Model.DepositNotificationDto.ApprovedDate</td>
                                </tr>
                                <tr>
                                    <td>Bank Transaction</td>
                                    <td>
                                        <a href="#" onclick="LoadInfomation('@Model.DepositNotificationDto.Id')" class="mr-2 btn btn-primary waves-effect waves-light" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#exLargeModal" title="View @Model.DepositNotificationDto.IssuedBy BankDeposit Request">Bank Transaction Details</a>
                                    </td>
                                </tr>
                            }
                            else if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-primary rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status, Has not yet been approved by head office
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        @using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
                                        {
                                            <input type="hidden" name="option" value="Status" id="option" />
                                            <input type="hidden" name="ServiceOption" value="DepositNotification" id="ServiceOption" />
                                            <input type="hidden" name="Id" value="@Model.DepositNotificationDto.Id" id="Id" />
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-danger me-2">Cancel Cash Deposit Request</button>
                                                <input type="hidden" name="Action" value="update" id="Action" />
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            else if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-danger rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.DepositNotificationDto.ApprovedMessage</td>
                                </tr>
                                <tr>
                                    <td>Approved By</td>
                                    <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedBy</td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedDate">@Model.DepositNotificationDto.ApprovedDate</td>
                                </tr>
                            }
                            else if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Cancel.ToString()))
                            {
                                <tr>
                                    <td>Status</td>
                                    <td class="badge bg-label-danger rounded-pill text-uppercase">
                                        @Model.DepositNotificationDto.Status
                                    </td>
                                </tr>
                                <tr>
                                    <td>Approved Message</td>
                                    <td>@Model.DepositNotificationDto.ApprovedMessage</td>
                                </tr>
                                <tr>
                                    <td>Approved By</td>
                                    <td id="ApprovedBy">@Model.DepositNotificationDto.ApprovedBy</td>
                                </tr>
                                <tr>
                                    <td>Approved Date</td>
                                    <td id="ApprovedDate">@Model.DepositNotificationDto.ApprovedDate</td>
                                </tr>
                            }


                        </tbody>
                    </table>
                    <a type="button" onclick="LoadDataGen('CashFlowManagement','ListOfCashReplenishmentData','_CashReplenishmentRequestDataWithOutApproval',0,'datalistingview_CashReplenishmentRequest')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Close">
                        <span class="tf-icons mdi mdi-close mdi-18px"></span>
                    </a>
                </div>
            </div>
        </div>

        @if (@Model.DepositNotificationDto.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
        {
            @Html.Partial("_ViewBankDepositTransaction")
        }

    </div>
</div>


