@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@using Resources
@if (Convert.ToBoolean(ViewBag.IsAuthourized) == false)
{
    @Html.Partial("_GeneralErrorDiv")
}

@if (Convert.ToBoolean(ViewBag.IsSystemError) == true)
{
    @Html.Partial("_SystemError")
}

@using (Html.BeginForm("AddOrUpdate", "CashFlowManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <input type="hidden" name="ServiceOption" value="BankDepositCashClearing" id="ServiceOption" />
    <fieldset class="fieldset-custom">
        <legend id="select_base">@GlobalCashFlowManagement.CashClearing @Model.BankDepositCashClearing.AccountInfo </legend>
        <div class="row mt-2 gy-4">

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <div class="col-sm-12 col-lg-12">
                        <div class="d-flex justify-content-between align-items-start border-end pb-3 pb-sm-0 card-widget-6">
                            <div>
                                @{
                                    var formattedAmount = Convert.ToDecimal(Model.DepositNotificationDto.Amount).ToString("N");
                                }
                                <h3 class="mb-3">XAF @formattedAmount</h3>

                                <p class="mb-0">@GlobalCashFlowManagement.AuthorizedBy @Model.DepositNotificationDto.Temp2 </p>
                                <p class="mb-0">@GlobalCashFlowManagement.TransferBy @Model.BankDepositCashClearing.TransferBy </p>
                                <p class="mb-0">@GlobalCashFlowManagement.TransactionDoneOnThe @Model.BankDepositCashClearing.CreatedDate </p>
                            </div>
                            <div class="avatar me-sm-6">
                                <span class="avatar-initial rounded bg-label-secondary">
                                    <i class="mdi mdi-wallet-outline mdi-24px"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6" hidden="hidden">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@GlobalCashFlowManagement.TotalAmount: 0.0</span>-->-->
                    <!--<input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.BankDepositCashClearing.AmountExpected">-->
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblBalanceDeposit">@GlobalCashFlowManagement.Balance: 0</span>
                </div>
            </div>
            @Html.HiddenFor(m => m.BankDepositCashClearing.ReferenceId)
            @Html.HiddenFor(m => m.BankDepositCashClearing.ToAccountId)
            @Html.HiddenFor(m => m.BankDepositCashClearing.FromAccountId)
            <legend>@GlobalCashFlowManagement.Denomination</legend>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.HiddenFor(model => model.DepositNotificationDto.Amount, new { @class = "form-control amount-input shadow-input-boxes", @id = "balanceInVault" })
                    @Html.TextBoxFor(m => m.BankDepositCashClearing.CurrencyNotes.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateCashBalance()", @Value = Model.BankDepositCashClearing.CurrencyNotes.note10000 })
                    @Html.ValidationMessageFor(m => m.BankDepositCashClearing.CurrencyNotes.note10000, "", new { @class = "text-danger " })
                    <label>N10,000</label>
                </div>
            </div>
