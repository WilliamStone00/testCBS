@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
<div class="container">
    @*<fieldset class="fieldset">*@
    <div class="card-body">
        @using (Html.BeginForm("", ""))
        {
            <input type="hidden" name="ServiceOption" value="SearchAndFilter" id="ServiceOption" />
            <input type="hidden" name="Action" value="insert" id="Action" />
            <div class="row justify-content-center mt-2 gy-4">
                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                {
                    <!-- Branch Dropdown -->
                    <div class="col-md-4 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                model => model.QueryModel.BranchId,
                                new SelectList(ViewBag.Branches ?? "", "Value", "Text"),
                                new { @class = "form-control select2", @search = "true" }
                            )
                            @Html.ValidationMessageFor(model => model.QueryModel.BranchId, "", new { @class = "text-danger" })
                            <label>Select Branch Office</label>
                        </div>
                    </div>
                    <!-- Request Issuer in the branch Dropdown -->
                    <div class="col-md-3 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                model => model.QueryModel.IssuedBy,
                                new SelectList(ViewBag.UsersInBranch ?? "", "Value", "Text"),
                                new { @class = "form-control select2", @search = "true", @id = "QueryModel_IssuedBy" }
                            )
                            @Html.ValidationMessageFor(model => model.QueryModel.IssuedBy, "", new { @class = "text-danger" })
                            <label>Select users in the branch</label>
                        </div>
                    </div>
                    <div class="col-md-2 mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(model => model.QueryModel.ValidateApproverUnionWide, new { @class = "form-check-input", @id = "ValidateApproverUnionWide" })
                            <label class="form-check-label" for="QueryModel_ValidateApproverUnionWide">
                                Check if the approver is out of the issuing branch
                            </label>
                        </div>
                    </div>
                    <!-- Request Approver in the branch Dropdown -->
                    <div class="col-md-3 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                model => model.QueryModel.ApprovedBy,
                                new SelectList(ViewBag.UsersInandOutBranch ?? "", "Value", "Text"),
                                new { @class = "form-control select2", @search = "true", @id = "QueryModel_ApprovedBy" }
                            )
                            @Html.ValidationMessageFor(model => model.QueryModel.ApprovedBy, "", new { @class = "text-danger" })
                            <label>Select users in the system</label>
                        </div>
                    </div>
                    <!-- Filtering Option Dropdown -->
                    <div class="col-md-4 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                model => model.QueryModel.Status,
                                new SelectList(ViewBag.filteringOptions ?? "", "Value", "Text"),
                                new { @class = "form-control select2", @search = "true", @id = "QueryModel_Status" }
                            )
                            @Html.ValidationMessageFor(model => model.QueryModel.Status, "", new { @class = "text-danger" })
                            <label>Select Filtering Option</label>
                        </div>
                    </div>
                    <!-- From Date -->
                    <div class="col-md-4 mb-sm-4">
                        <div class="form-floating form-floating-outline mb-4">
                            @Html.TextBoxFor(model => model.QueryModel.FromDate, new
                            {
                                @class = "form-control",
                                type = "datetime-local",
                                id = "fromDate"
                            })
                            <label for="fromDate">From Date</label>
                            @Html.ValidationMessageFor(model => model.QueryModel.FromDate, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- To Date -->
                    <div class="col-md-4 mb-sm-4">
                        <div class="form-floating form-floating-outline mb-4">
                            @Html.TextBoxFor(model => model.QueryModel.ToDate, new
                            {
                                @class = "form-control",
                                type = "datetime-local",
                                id = "toDate"
                            })
                            <label for="toDate">To Date</label>
                            @Html.ValidationMessageFor(model => model.QueryModel.ToDate, "", new { @class = "text-danger" })
                        </div>
                    </div>

                }
                else
                {
                    <!-- Filtering Option Dropdown for Non-Head Office -->
                    <div class="col-md-12 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(
                                model => model.QueryModel.Status,
               new SelectList(ViewBag.filteringOptions ?? "", "Value", "Text"),


                                new { @class = "form-control select2", @search = "true", @id = "QueryModel_Status" }
                            )
                            @Html.ValidationMessageFor(model => model.QueryModel.Status, "", new { @class = "text-danger" })
                            <label>Select Filtering Option</label>
                        </div>
                    </div>
                }

                <!-- Hidden Input -->
                <input type="hidden" id="selectedBranchID" value="" />

                <!-- Submit Button -->
                <div class="col-md-12 text-end mt-3">
                    <a href="javascript:void(0);"
                       class="btn btn-primary d-inline-flex align-items-center gap-2"
                       id="print_btn"
                       onclick="Search()">
                        <i class="mdi mdi-magnify"></i>
                        Search Journal Entry
                    </a>
                </div>

            </div>


        }

    </div>
    @*</fieldset>*@

</div>









