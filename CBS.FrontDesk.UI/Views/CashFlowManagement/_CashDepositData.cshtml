@using Resources
@{
    ViewBag.Title = @GlobalCashFlowManagement.PendingAccountingEntry;
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
{
    <table class="table table-hover" id="HeadOfficeDataTable">
        <thead class="table-light">
            <tr>
                <th>@GlobalCashFlowManagement.BranchOffice</th>
                <th>@GlobalCashFlowManagement.IssuedBy</th>
                <th>@GlobalCashFlowManagement.Amount (FCFA)</th>
                <th>@GlobalCashFlowManagement.IssuedDate</th>
                <th>@GlobalCashFlowManagement.Status</th>
                <th>@GlobalCashFlowManagement.Message</th>
                <th>@GlobalCashFlowManagement.Action</th>
            </tr>
        </thead>
        <tbody>
            @{

                foreach (var d in Model.ListDepositNotificationDto)
                {


                    <tr>
                        <td style="width:15%">@d.BranchOffice</td>
                        <td style="width:15%">@d.Temp1</td>
                        <td style="width:15%">
                            @{
                                var formatedAmount = Convert.ToDecimal(d.Amount).ToString("N");
                                @formatedAmount
                            }
                        </td>
                        <td style="width:15%">@d.IssueDate</td>
                        @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                        {
                            if (d.IsOwner)
                            {
                                if (d.HasAccount56)
                                {
                                    <td style="width:15%">
                                        <span class="badge rounded-pill bg-dark fs-6">
                                            <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                        </span>
                                    </td>

                                }
                                else
                                {
                                    <td style="width:15%">
                                        <span class="badge rounded-pill bg-dark fs-6">
                                            <i class="fas fa-eye"></i> @d.Status.ToUpper()
                                        </span>
                                    </td>

                                }
                            }
                            else
                            {

                                <td style="width:15%">
                                    <span class="badge rounded-pill bg-dark fs-6">
                                        <i class="fas fa-money-bill-wave"></i> @d.Status.ToUpper()
                                    </span>
                                </td>
                            }

                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Branch_CashClearing.ToString()))
                        {


                            if (d.IsOwner)
                            {
                                <td style="width:15%">
                                    <span class="badge rounded-pill bg-primary fs-6">
                                        <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                    </span>
                                </td>

                            }
                            else
                            {
                                <td style="width:15%">
                                    <span class="badge rounded-pill bg-dark fs-6">
                                        <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                    </span>
                                </td>
                            }

                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                        {
                            <td style="width:15%">
                                <span class="badge rounded-pill bg-danger fs-6">
                                    <i class="fas fa-money-bill-wave"></i> <i class="fas fa-times"></i> @d.Status.ToUpper()
                                </span>
                            </td>
                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Cancel.ToString()))
                        {
                            <td style="width:15%">
                                <span class="badge rounded-pill bg-danger fs-6">
                                    <i class="fas fa-money-bill-wave"></i> <i class="fas fa-times"></i> @d.Status.ToUpper()
                                </span>
                            </td>
                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                        {

                            <td style="width:15%">
                                <span class="badge bg-black fs-6">
                                    <i class="fas fa-spinner fa-spin"></i> @d.Status.ToUpper()
                                </span>
                            </td>

                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                        {
                            <td style="width:15%">
                                <span class="badge rounded-pill bg-success fs-6">
                                    <i class="fas fa-badge-check"></i> @d.Status.ToUpper()
                                </span>
                            </td>
                        }

                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                        {

                            <td style="width:15%">
                                <span class="badge rounded-pill bg-warning fs-6">
                                    <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                </span>
                            </td>
                        }
                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                        {
                            <td style="width:15%">
                                <span class="badge rounded-pill bg-warning fs-6">
                                    <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                </span>
                            </td>

                        }

                        <td style="width:15%">@d.Message</td>


                        <td style="width:10%">

                            @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                            {

                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToUpload">@GlobalCashFlowManagement.UploadDepositReciept </a>


                                @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>*@
                            }

                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
                            {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.View</a>

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Cancel.ToString()))
                            {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.View</a>

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Pending.ToString()))
                            {

                                if (d.IsOwner)
                                {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.View</a>
                                }
                                else
                                {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ApproveCashDepositRequest','approveDepositNotification','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToApprove">@GlobalCashFlowManagement.Approve</a>

                                }

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                            {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequest','CashFlowManagement')" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.View</a>

                            }
                            else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_Bank_CashOut.ToString()))
                            {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToUpload">@GlobalCashFlowManagement.UploadDepositReciept </a>

                            }
                            else
                            {
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_ViewDepositRequestStatus','depositRequestStatus','CashFlowManagement')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.ApprovedBy @GlobalCashFlowManagement.CashRequestToEdit">@GlobalCashFlowManagement.View</a>

                            }

                        </td>
                    </tr>





                }

            }
        </tbody>
    </table>
}
else
