                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Completed.ToString()))
                                    {
                                        <td style="width:15%">
                                            <span class="badge   bg-dark fs-6">
                                                <i class="fas fa-badge-check"></i> @d.Status.ToUpper()
                                            </span>
                                        </td>
                                    }

                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.RedirectToBranchBTB.ToString()))
                                    {

                                        <td style="width:15%">
                                            <span class="badge   bg-warning fs-6">
                                                <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                            </span>
                                        </td>
                                    }
                                    else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Awaiting_uploaded_bank_deposit_receipt.ToString()))
                                    {
                                        <td style="width:15%">
                                            <span class="badge   bg-warning fs-6">
                                                <i class="fas fa-spinner fa-spin"></i>@d.Status.ToUpper()
                                            </span>
                                        </td>
                                    }

                                    <td style="width:15%">@d.Message</td>


                                    <td style="width:10%">

                                        @if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Approved.ToString()))
                                        {

                                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_uploadBankDepositeReceipt','uploadBankDepositReceipt','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to Upload">Upload Deposit Reciept </a>


                                            @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_CashDepositRequest','_CreateCashInfusion','cashInFusion','CashFlowManagement')" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select @d.ApprovedBy Cash Request to edit">Cash Clearing</a>*@
                                        }

                                        else if (d.Status.Equals(CBS.FrontDesk.Data.Entity.Accounting.CashReplishmentRequestStatus.Rejected.ToString()))
