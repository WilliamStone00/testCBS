@model CBS.BusinessService.ThirdPartyBankAccount.ThirdPartyInstitution
    @using Resources
<div class="card-body">

    @using (Html.BeginForm("Update", "ThirdPartyInstitution", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>@GlobalThirdPartyInstitution.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.InstitionType, new SelectList(ViewBag.InstitionType == null ? "" : ViewBag.InstitionType, "Id", "OperationEventName"), "---"+ @GlobalThirdPartyInstitution.SelectOperationEvent + "---", new { @class = "form-control select2", @search = "true", id = "OperationEventId" })
                    @Html.ValidationMessageFor(model => model.InstitionType, "", new { @class = "text-danger" })
                    <label for="OperationEventId">@GlobalThirdPartyInstitution.InstitionType</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    <label>@GlobalThirdPartyInstitution.Code</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountManager, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountManager, "", new { @class = "text-danger" })
                    <label>@GlobalThirdPartyInstitution.AccountManagerAtTheBank</label>
                </div>
            </div>
        </div>


        <div class="mt-4">

            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>

        </div>
    }
</div>