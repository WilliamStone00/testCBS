

@{
    ViewBag.Title = "Loan Type Settings";
}
@using Resources
<div id="datalistingview">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2 shadow-sm">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary fw-bold">
                        <i class="mdi mdi-bank me-2"></i> @GlobalLoanType.institution_loan_types
                    </h1>
                    <p class="card-text">
                        @GlobalLoanType.manage_different_types_of_loans_offered_by_the_bank
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseLoanTypeTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseLoanTypeTips" class="collapse">
            <div class="card-body">
                <ul class="mb-0">
                    <li class="mb-2">
                        <i class="mdi mdi-tag-outline text-success me-2"></i>
                        <strong>@GlobalLoanType.convention:</strong> @GlobalLoanType.use_unique_meaningful_codes_eg_hl_for_home_loan_pl_for_personal_loan_codes_are_casesensitive_and_cannot_be_changed_after_creation.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-format-title text-info me-2"></i>
                        <strong>@GlobalLoanType.name_standardization:</strong> @GlobalLoanType.keep_names_clear_and_consistent_use_loan_suffix_for_clarity_eg_education_loan_instead_of_just_education.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-order-numeric-ascending text-warning me-2"></i>
                        <strong>@GlobalLoanType.display_order:</strong> @GlobalLoanType.set_numerical_order_0_1_2_etc_to_control_how_loan_types_appear_in_dropdowns_lower_numbers_appear_first.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-text-box-outline text-primary me-2"></i>
                        <strong>@GlobalLoanType.description_best_practices:</strong> @GlobalLoanType.include_key_terms_eligibility_criteria_and_typical_usage_this_helps_staff_and_customers_understand_the_loan_purpose.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-toggle-switch text-danger me-2"></i>
                        <strong>@GlobalShared.Active/ @GlobalShared.InActive @GlobalShared.Status:</strong> @GlobalLoanType.mark_types_as_inactive_instead_of_deleting_when_no_longer_offered_this_preserves_historical_data.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-shield-check text-success me-2"></i>
                        <strong>@GlobalShared.Security:</strong> @GlobalLoanType.only_authorized_personnel_should_modify_loan_types_as_changes_affect_loan_processing_and_reporting.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-connection text-info me-2"></i>
                        <strong>@GlobalLoanType.system_integration:</strong> @GlobalLoanType.loan_types_are_linked_to_interest_rates_fees_and_repayment_schedules_verify_connections_before_making_changes.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-backup-restore text-warning me-2"></i>
                        <strong>@GlobalLoanType.version_control:</strong> @GlobalLoanType.always_document_changes_the_system_tracks_modification_history_for_audit_purposes.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-chart-bar text-primary me-2"></i>
                        <strong>@GlobalLoanType.reporting_impact:</strong> @GlobalLoanType.changes_affect_financial_reports_portfolio_analysis_and_regulatory_compliance_reports.
                    </li>
                    <li class="mb-2">
                        <i class="mdi mdi-alert-circle text-secondary me-2"></i>
                        <strong>@GlobalShared.testing:</strong> @GlobalLoanType.test_new_loan_types_in_the_test_environment_before_deploying_to_production.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <button type="button" onclick="showCreateModal()" class="btn btn-label-primary btn-sm me-2">
                <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add New
            </button>
            <button type="button" onclick="refreshTable()" class="btn btn-label-secondary btn-sm">
                <i class="mdi mdi-refresh mdi-18px"></i> @GlobalShared.Refresh
            </button>
        </div>
    </div>

    <!-- DataTable -->
    <div class="card p-3 shadow mb-4">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-table"></i> @GlobalLoanType.loan_types_catalog
            <small class="text-muted ms-2">
                <span id="recordCount" class="badge bg-info">@GlobalShared.Loading...</span>
            </small>
        </h5>
        <div class="table-responsive">
            <table id="loanTypeDataTable" class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Code</th>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Description</th>
                        <th>@GlobalShared.display_order</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div class="modal fade" id="genericModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"></div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        var dataTable = null;

        /* ===========================
           Select2
        ============================ */
        function initSelect2(container) {
            $(container).find('.select2').each(function () {
                const $select = $(this);

                if ($select.hasClass('select2-hidden-accessible')) {
                    $select.select2('destroy');
                }

                $select.select2({
                    width: '100%',
                    dropdownParent: $(container),
                    placeholder: $select.attr('data-placeholder') || 'Select an option',
                    allowClear: true
                });
            });
        }

        /* ===========================
           Modal
        ============================ */
        function showCreateModal() {
            ShowModal(null, '_CreateEditLoanType', 'LoanType', 'create');
        }

        function ShowModal(key, partialView, controller, path) {
            var url = '/' + controller + '/InitializeData?KEY=' + encodeURIComponent(key || '') +
                '&partialView=' + encodeURIComponent(partialView) +
                '&path=' + encodeURIComponent(path);

            $.get(url).done(function (html) {
                const modalEl = document.getElementById('genericModal');
                modalEl.querySelector('.modal-content').innerHTML = html;

                const modal = new bootstrap.Modal(modalEl);
                initSelect2(modalEl);
                modal.show();
            }).fail(function () {
                appalert('Failed to load content', 0, 1);
            });
        }

        /* ===========================
           Load Data
        ============================ */
        function loadData() {
            var tbody = $('#loanTypeDataTable tbody');

            // 🔥 show loading row ONLY temporarily
            tbody.html(`
                <tr class="loading-row">
                    <td colspan="6" class="text-center py-4 text-muted">
                        Loading loan types data...
                    </td>
                </tr>
            `);

            $.ajax({
                url: '/LoanType/GetAll',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.success && Array.isArray(response.data)) {
                        renderTable(response.data);
                    } else {
                        showEmpty('Failed to load data');
                    }
                },
                error: function () {
                    showEmpty('Error loading data');
                }
            });
        }

        function showEmpty(message) {
            var tbody = $('#loanTypeDataTable tbody');

            if ($.fn.DataTable.isDataTable('#loanTypeDataTable')) {
                dataTable.destroy();
                dataTable = null;
            }

            tbody.html(`
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        ${message}
                    </td>
                </tr>
            `);

            $('#recordCount').text('0 records');
        }

        /* ===========================
           Render Table
        ============================ */
        function renderTable(data) {
            var tbody = $('#loanTypeDataTable tbody');

            // 🔥 Destroy DataTable FIRST
            if ($.fn.DataTable.isDataTable('#loanTypeDataTable')) {
                dataTable.destroy();
                dataTable = null;
            }

            // 🔥 Remove loading / old rows
            tbody.empty();

            if (!data.length) {
                showEmpty('No loan type records found');
                return;
            }

            $('#recordCount').text(data.length + ' records');

            data.forEach(function (item) {
                tbody.append(`
                    <tr>
                        <td><strong>${escapeHtml(item.Code)}</strong></td>
                        <td>${escapeHtml(item.Name)}</td>
                        <td>${escapeHtml(item.Description)}</td>
                        <td>${item.DisplayOrder}</td>
                        <td>
                            ${item.IsActive
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-secondary">Inactive</span>'}
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                        data-bs-toggle="dropdown">
                                    Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item btn-details text-info" data-id="${item.Id}">
                                            Details
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item btn-edit text-primary" data-id="${item.Id}">
                                            Edit
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item btn-delete text-danger"
                                                data-id="${item.Id}" disabled>
                                            Delete
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                `);
            });

            initializeDataTable();
        }

        /* ===========================
           DataTable Init
        ============================ */
        function initializeDataTable() {
            dataTable = $('#loanTypeDataTable').DataTable({
                searching: true,
                responsive: true,
                order: [[3, 'asc'], [0, 'asc']],
                lengthMenu: [10, 25, 50, 75, 100],
                pageLength: 10,
                columnDefs: [{ orderable: false, targets: 5 }],
                drawCallback: function () {
                    $('.dropdown-toggle').dropdown();
                }
            });
        }

     
        /* ===========================
           Utils
        ============================ */
        function escapeHtml(text) {
            if (!text) return '';
            return text.toString().replace(/[&<>"']/g, m => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            })[m]);
        }

        /* ===========================
           Events
        ============================ */
        $(document).ready(function () {
            loadData();

            $(document).on('click', '.btn-details', function () {
                ShowModal($(this).data('id'), '_LoanTypeDetails', 'LoanType', 'details');
            });

            $(document).on('click', '.btn-edit', function () {
                ShowModal($(this).data('id'), '_CreateEditLoanType', 'LoanType', 'edit');
            });

            $('#genericModal').on('hidden.bs.modal', function () {
                loadData();
            });
        });
    </script>
}
