<style>
    table {
        table-layout: auto;
    }

        table th, table td {
            white-space: nowrap; /* Prevent text from wrapping */
        }
</style>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">Data listings</legend>
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Date</th>
                    <th>@GlobalShared.Amount</th>
                    <th>@GlobalShared._operator</th>
                    <th>@GlobalShared.source</th>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Initiated_By</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

</fieldset>

