@model CBS.FrontDesk.Data.Entity.SavingProducts.MobileMoneyCashTopup


@if (ViewBag.HasError)
{

    @Html.Partial("_GeneralErrorDiv")


}
else
{
    using (Html.BeginForm("Validate", "MobileMoneyCashTopup", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.ValidateMobileMoneyCashTopup.Id)
        <fieldset class="fieldset-custom">
            <legend id="select_base">@Model.OperatorType.ToUpper() TRANSFER PENDING VALIDATION: REF (@Model.RequestReference)</legend>
            <div class="row mt-2 gy-4">
                <!-- Request Approval Status (Radio Buttons) -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <label for="RequestApprovalStatus"><b>Approval Status</b></label>
                        <br />
                        <div class="border p-3 mt-2">
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Pending", new { @class = "form-check-input", id = "statusPending" })
                                <label class="form-check-label" for="statusPending">Pending</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Approved", new { @class = "form-check-input", id = "statusApproved" })
                                <label class="form-check-label" for="statusApproved">Approved</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "Rejected", new { @class = "form-check-input", id = "statusRejected" })
                                <label class="form-check-label" for="statusRejected">Rejected</label>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalStatus, "", new { @class = "text-danger " })
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="Select the current approval status for the transfer request."></i>
                    </div>
                </div>

                <!-- Display Requested Amount -->
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box float-end">
                            Requested Amount: @Model.Amount.ToString("#,##0.0")
                        </span>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="This is the amount requested in the transfer."></i>
                    </div>
                </div>

                <!-- Request Approval Note (Readonly) -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalNote, new { @class = "form-control", @style = "height: 70px;" })
                        @Html.ValidationMessageFor(m => m.ValidateMobileMoneyCashTopup.RequestApprovalNote, "", new { @class = "text-danger " })
                        <label for="formValidationApprovalNote">Approval Note</label>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="Enter any notes regarding the approval status."></i>
                    </div>
                </div>

                <!-- Request Details Section (Modal Trigger) -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#detailsModal">View Request Details</button>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="Click to view the detailed information of the request."></i>
                    </div>
                </div>

                <!-- Request Note -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.RequestNote, new { @class = "form-control", @style = "height: 70px;", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.RequestNote, "", new { @class = "text-danger " })
                        <label for="formValidationDob">Request Note</label>
                        <i class="mdi mdi-help-circle text-muted ms-1" data-bs-toggle="tooltip" title="This note contains additional information about the request."></i>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary me-2">Approve</button>
            </div>
        </fieldset>
    }

    <!-- Modal to show details of the MobileMoneyCashTopup -->
    <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailsModalLabel">Request Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <table class="table">
                        <tr>
                            <th>Requested Date & Time:</th>
                            <td>@Model.RequestDate</td>
                        </tr>
                        <tr>
                            <th>Transaction Reference:</th>
                            <td>@Model.MobileMoneyTransactionId</td>
                        </tr>
                        <tr>
                            <th>Request Reference:</th>
                            <td>@Model.RequestReference</td>
                        </tr>
                        <tr>
                            <th>Requested Amount:</th>
                            <td>@Model.Amount.ToString("#,##0.0")</td>
                        </tr>
                        <tr>
                            <th>Initiated By:</th>
                            <td>@Model.RequestInitiatedBy</td>
                        </tr>
                        <tr>
                            <th>Operator Type:</th>
                            <td>@Model.OperatorType</td>
                        </tr>
                        <tr>
                            <th>Source Type:</th>
                            <td>@Model.SourceType</td>
                        </tr>
                        <tr>
                            <th>Branch:</th>
                            <td>@Model.Branch.BranchCode, @Model.Branch.Name</td>
                        </tr>
                        <tr>
                            <th>Request Note:</th>
                            <td>@Model.RequestNote</td>
                        </tr>
                        <tr>
                            <th>Approval Status:</th>
                            <td>@Model.RequestApprovalStatus</td>
                        </tr>
                        <tr>
                            <th>Member Reference & Account Number:</th>
                            <td>@Model.MobileMoneyMemberReference & @Model.AccountNumber</td>
                        </tr>
                        <tr>
                            <th>Approval Note:</th>
                            <td>@Model.RequestApprovalNote</td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

}
