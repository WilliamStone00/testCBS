@model List<CBS.FrontDesk.Data.Entity.SavingProducts.MobileMoneyCashTopup>
<style>
    table {
        table-layout: auto;
    }

        table th, table td {
            white-space: nowrap; /* Prevent text from wrapping */
        }
</style>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalShared.data_listings</legend>
    @if (Model.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalShared.no_data_found</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Date</th>
                        <th>@GlobalShared.Amount</th>
                        <th>@GlobalShared._operator</th>
                        <th>@GlobalShared.source</th>
                        <th>@GlobalShared.Branch</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.Initiated_By</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.RequestDate</td>
                            <td>@d.Amount.ToString("#,##0.0")</td>
                            <td>
                                @if (d.OperatorType == "MobileMoneyMTN")
                                {
                                    <span class="badge bg-facebook">MTN</span>
                                }
                                else
                                {
                                    <span class="badge bg-instagram">Orange</span>
                                }
                            </td>
                            <td>@d.SourceType</td> <!-- Corrected source column -->
                            <td>@d.Branch.Name</td>
                            <td>
                                @if (d.RequestApprovalStatus == "Approved")
                                {
                                    <span class="badge bg-info">@GlobalShared.Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@d.RequestApprovalStatus</span>
                                }
                            </td>
                            <td>@d.RequestInitiatedBy</td>
                            <td>
                                <a href="/MobileMoneyCashTopup/RequestValidation?Id=@d.Id" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Validate @d.Amount to topup @d.OperatorType">@GlobalShared.Validate</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
