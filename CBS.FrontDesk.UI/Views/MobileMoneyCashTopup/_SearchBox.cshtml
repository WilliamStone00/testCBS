
@model CBS.FrontDesk.Data.Entity.SavingProducts.MobileMoneyCashTopup
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalShared.request_filters</legend>
    <hr />
    <div class="row g-4">
        <div class="col-md-6">
            <label for="branchInput">@GlobalShared.Branch</label>
            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ @GlobalShared.Select_Branch+"---", new { @class = "form-control select2", @id = "branchInput" })
        </div>
        <div class="col-md-6">
            <label>Status</label>
            <div class="d-flex flex-wrap">
                <!-- Use flexbox for horizontal alignment -->
                <div class="form-check me-3">
                    <!-- Add margin to the right for spacing -->
                    <input class="form-check-input" type="radio" name="status" id="statusPending" value="Pending">
                    <label class="form-check-label" for="statusPending">@GlobalShared.Pending</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="radio" name="status" id="statusApproved" value="Approved">
                    <label class="form-check-label" for="statusApproved">@GlobalShared.Approved</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="radio" name="status" id="statusRejected" value="Rejected">
                    <label class="form-check-label" for="statusRejected">@GlobalShared.Rejected</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="status" id="statusAll" value="All" checked>
                    <label class="form-check-label" for="statusAll">@GlobalShared.All 3</label>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-12">
            <button class="btn btn-primary" id="searchButton">@GlobalShared.Search</button>
        </div>
    </div>
</fieldset>
