@model CBS.FrontDesk.Data.Entity.LoanCommitee.LoanCommitee
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Add users in to commitee groups
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="card mb-4">
                            <div class="card-body d-sm-flex d-block">
                                <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                    <a type="button" onclick="LoadDataGen('LoanCommitee','myDataTable_commitee_members','_LoanCommiteeMemberData',0,'datalistingview',null,'LoanCommiteeMember','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <br />
                        @using (Html.BeginForm("AddOrUpdate", "LoanCommitee", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row g-4">

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanCommiteeMember.LoanCommiteeGroupId, new SelectList(ViewBag.Groups, "Id", "Name"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanCommiteeMember.LoanCommiteeGroupId, "", new { @class = "text-danger" })
                                        <label>Select group</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanCommiteeMember.UserId, new SelectList(ViewBag.Users, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanCommiteeMember.UserId, "", new { @class = "text-danger" })
                                        <label>Select user</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                @if (ViewBag.Key == null)
                                {
                                    <button type="submit" class="btn btn-primary me-2">Create</button>
                                    <input type="hidden" name="ServiceOption" value="commitee_member" id="ServiceOption" />
                                    <input type="hidden" name="Action" value="insert" id="Action" />

                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.LoanCommiteeMember.Id)
                                    <button type="submit" class="btn btn-primary me-2">Create</button>
                                    <input type="hidden" name="ServiceOption" value="commitee_member" id="ServiceOption" />
                                    <input type="hidden" name="Action" value="update" id="Action" />

                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
      
        </div>

    </div>



</div>