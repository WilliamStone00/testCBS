@model CBS.FrontDesk.Data.Entity.LoanCommitee.LoanCommitee


@if (Model != null && Model.LoanCommiteeMembers.Any())
{<div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <a type="button" onclick="LoadDataGen('LoanCommitee','myDataTable_commitee_members','_LoanCommiteeMemberData',0,'datalistingview',null,'LoanCommiteeMember','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                </a>
            </div>
        </div>
    </div>
    <br />
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable_commitee_members">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Member</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanCommiteeMembers)
                {
                    <tr>
                        <td style="width:60%">@d.LoanCommiteeGroup.Name</td>
                        <td style="width:20%">@d.UserId</td>
                        <td style="width:20%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanCommitee','update','LoanCommitee','LoanCommiteeGroup')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select to edit">Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete" onclick="DeleteRecordDataTable('LoanCommitee','@d.Id','myDataTable_commitee_members','_LoanCommiteeMemberData',0,'datalistingview')">Delete</a>|
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No commitee member are available at the moment.
    </div>
}
