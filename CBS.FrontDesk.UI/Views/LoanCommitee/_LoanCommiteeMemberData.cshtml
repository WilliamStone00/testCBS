@model CBS.FrontDesk.Data.Entity.LoanCommitee.LoanCommitee
@using Resources

@if (Model != null && Model.LoanCommiteeMembers.Any())
{<div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <a type="button" onclick="LoadDataGen('LoanCommitee','myDataTable_commitee_members','_LoanCommiteeMemberData',0,'datalistingview',null,'LoanCommiteeMember','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                </a>
            </div>
        </div>
    </div>
    <br />
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable_commitee_members">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Name</th>
                    <th>@GlobalShared.Member</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanCommiteeMembers)
                {
                    <tr>
                        <td style="width:45%">@d.LoanCommiteeGroup.Name</td>
                        <td style="width:40%">
                            @{
                                string memberInfo = d.User.name;
                                if (d.User.Brancch != null)
                                {
                                    memberInfo += " - " + d.User.Brancch.Name;
                                }
                                else
                                {
                                    memberInfo += " - N/A";
                                }


                            }
                            @memberInfo
                        </td>
                        <td style="width:15%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanCommiteeMember','update','LoanCommitee','LoanCommiteeMember')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select  @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete" onclick="DeleteRecordDataTable('LoanCommitee','@d.Id','myDataTable_commitee_members','_LoanCommiteeMemberData',0,'datalistingview')">@GlobalShared.Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
else
{
    <div class="text-center my-3">
        <p>No commitee member are available at the moment.</p>
    </div>
    
}
