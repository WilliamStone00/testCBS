@model CBS.FrontDesk.Data.Entity.Accounting.OperationEvent
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "OperationEvent", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.OperationEventName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OperationEventName, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.EventCode, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EventCode, "", new { @class = "text-danger" })
                    <label>>@GlobalShared.event_code</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label>>@GlobalShared.Description</label>
                </div>
            </div>

                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.CheckBoxFor(m => m.HasMultipleEntries, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">&nbsp;&nbsp; &nbsp;&nbsp;>@GlobalOperationEvent.check_this_box_if_event_has_multiple_entries</label>
                    </div>
                   
                </div>

            


        </div>
   
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">>@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">>@GlobalShared.Reset</button>
        </div>
    }
</div>