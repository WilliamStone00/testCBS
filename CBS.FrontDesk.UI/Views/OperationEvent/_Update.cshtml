@model CBS.FrontDesk.Data.Entity.Accounting.OperationEvent
    @using Resources
<div class="card-body">

    @using (Html.BeginForm("Update", "OperationEvent", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.OperationEventName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OperationEventName, "", new { @class = "text-danger" })
                    <label>>@GlobalOperationEvent.Name</label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label class="form-check-label">>@GlobalOperationEvent.Description</label>
                </div>
            </div>
           

    
        </div>
    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">>@GlobalShared.Update</button>

    </div>
}
</div>