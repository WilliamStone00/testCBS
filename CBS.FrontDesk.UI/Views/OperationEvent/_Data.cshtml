@model List<CBS.FrontDesk.Data.Entity.Accounting.OperationEvent>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>OperationEventName</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:35%">@d.OperationEventName</td>
                <td style="width:40%">@d.Description</td>
                <td style="width:25%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','OperationEvent')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.OperationEventName to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.OperationEventName" onclick="DeleteRecordDataTable('OperationEvent','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

