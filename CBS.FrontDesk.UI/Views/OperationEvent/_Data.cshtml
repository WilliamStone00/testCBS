@model List<CBS.FrontDesk.Data.Entity.Accounting.OperationEvent>
    @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>>@GlobalOperationEvent.operation_event_name</th>
            <th>>@GlobalShared.Description</th>
            <th>>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {

            <tr>
                <td style="width:35%">@d.OperationEventName</td>
                <td style="width:25%">@d.Description</td>

                <td style="width:40%">
                    <button type="button" onclick="EditResetModal('@d.Id','modalBody','modalContent','OperationEventAttribute','InitializeData','_Create','new','modalLabel','Add EventAttribute')" class="btn btn-primary waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#modalCenter">
                        >@GlobalOperationEvent.event_attribute
                    </button>
                    <button onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','AccountingEntryRule')" class="mr-2 btn  btn-primary" data-toggle="tooltip" data-placement="top" title=">@GlobalOperationEvent.create_accounting_rule_for_event @d.OperationEventName @GlobalShared.ToEdit">>@GlobalShared.set_rule</button>
                    <button onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','OperationEvent')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title=">@GlobalShared.Select @d.OperationEventName >@GlobalShared.ToEdit">>@GlobalShared.Edit</button>
                    <button class="mr-2 btn  btn-danger" data-toggle="tooltip" data-placement="top" title=">@GlobalShared.Delete @d.OperationEventName" onclick="DeleteRecordDataTable('OperationEvent','@d.Id','myDataTable','_Data',0,'datalistingview')">>@GlobalShared.Delete</button>

</td>


            </tr>


        }
    </tbody>
</table>
<div class="card">
    <div class="card-body">
        <div id="datalistingview">
            @Html.Partial("_modal")

        </div>
    </div>
</div>
