@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk

<input type="hidden" id="customerId" value="@Model.Customer.CustomerId" />
<input type="hidden" id="memberName" value="@Model.Customer.name" />
<input type="hidden" id="branchName" value="@Model.Branch.Name" />
<input type="hidden" id="branchCode" value="@Model.Branch.BranchCode" />
<input type="hidden" id="accountantName" value="@Session["FullName"].ToString()" /> <!-- Assuming User is available -->


<div class="form-wrapper">
    <div class="change-group">
        <div class="row mb-3 align-items-center">
            <!-- Member's Name, Branch Name, and Branch Code Section -->
            <div class="col-md-12">
                <div class="form-floating">
                    <span class="formatted-amount shadow-sm d-block py-3 px-4 bg-light rounded border border-secondary">
                        <strong>Member's Name:</strong> @Model.Customer.name &nbsp; | &nbsp;
                        <strong>Branch Name:</strong> @Model.Branch.Name &nbsp; | &nbsp;
                        <strong>Branch Code:</strong> @Model.Branch.BranchCode
                    </span>
                </div>
            </div>
        </div>
    </div>


    <fieldset class="fieldset-custom">
        <div class="container">
            <!-- Accounts Table -->
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <!-- Merged Header Row -->
                            <tr>
                                <th colspan="7" class="text-center fw-bold bg-light text-dark">MEMBER'S ACCOUNT BALANCES</th>
                            </tr>
                            <tr>
                                <th style="display:none;">ProductID</th>
                                <th style="display:none;">AccountNumber</th>
                                <th>Accounts</th>
                                <th>Balance</th>
                                <th>Amount to Debit</th>
                                <th>AB.Validation</th>
                                <th>Confirm</th>
                            </tr>
                        </thead>
                        <tbody id="memberAccountsTable">
                            @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                            {
                                <tr>
                                    <td style="display:none;">@d.ProductId</td>
                                    <td style="display:none;">@d.AccountNumber</td>
                                    <td>@d.AccountType</td>
                                    <td class="balance-span">@d.Balance.ToString("#,##0.0")</td> <!-- Balance -->
                                    <td>
                                        <input type="number" class="form-control amount-input" value="0" oninput="updateTotals()">
                                    </td>
                                    <td class="status-indicator"></td> <!-- New column for ❌ (Error Indicator) -->
                                    <td>
                                        <input type="checkbox" class="form-check-input" disabled>
                                    </td> <!-- Selection Checkbox -->
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="text-align: right;"><strong>Total Debited:</strong></td>
                                <td id="totalDebitedAmount">0</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Loan Repayment Table -->
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <!-- Merged Header Row -->
                            <tr>
                                <th colspan="10" class="text-center fw-bold bg-light text-dark">MEMBER'S OPENED LOANS</th>
                            </tr>
                            <tr>
                                <th style="display:none;">L. Ref</th>
                                <th>Date</th>
                                <th>L.Amount</th>
                                <th>A.I</th>
                                <th>Balance</th>
                                <th>Capital</th>
                                <th>Interest</th>
                                <th>VAT (19.25%)</th> <!-- ✅ NEW VAT COLUMN -->
                                <th>Penalty</th>
                                <th>Total</th>
                                <th>Conf</th>
                            </tr>
                        </thead>
                        <tbody id="loanRepaymentTable">
                            @foreach (var d in Model.Loans)
                            {
                                <tr id="row-@d.Id">
                                    <td style="display:none;">@d.Id</td>
                                    <td>@d.LoanDate.ToString("dd/MM/yy")</td>
                                    <td>@d.LoanAmount.ToString("#,##0.0")</td> <!-- ✅ Fixed Loan Amount Formatting -->
                                    <td>@d.AccrualInterest.ToString("#,##0.0")</td>
                                    <td>@d.Balance.ToString("#,##0.0")</td>

                                    <td>
                                        <input type="number" class="form-control capital-input" id="capital-@d.Id" value="0" oninput="updateTotals()">
                                    </td>
                                    <td>
                                        <input type="number" class="form-control interest-input" id="interest-@d.Id" value="0" oninput="updateTotals()">
                                    </td>
                                    <td>
                                        <input type="text" class="form-control vat-input" id="vat-@d.Id" value="0" readonly> <!-- ✅ NEW VAT FIELD -->
                                    </td>
                                    <td>
                                        <input type="number" class="form-control penalty-input" id="penalty-@d.Id" value="0" oninput="updateTotals()">
                                    </td>
                                    <td><span class="total-span" id="total-@d.Id">0</span></td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" disabled>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" style="text-align: right;"><strong>Total Repayment:</strong></td>
                                <td id="totalRepaymentAmount">0</td>
                                <td colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="7" style="text-align: right;"><strong>Balance Remaining:</strong></td>
                                <td>
                                    <span id="remainingBalance">0</span>
                                    <span id="balanceIndicator" style="font-size: 1.5rem;"></span>
                                </td>
                                <td colspan="2"></td>
                            </tr>
                            <tr style="display:none;">
                                <td colspan="7" style="text-align: right;"><strong>Total Calculated VAT (If applicable):</strong></td>
                                <td id="calculatedVat">0</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>

                    </table>
                </div>
            </div>

            <!-- Note Section -->
            <div class="row">
                <div class="col-md-12 mt-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.BulkDeposit.Note,
                            new { @class = "form-control shadow-input-boxes", @id = "Note", rows = "3", placeholder = "Enter reason for transaction...", style = "height: 90px;" })
                        @Html.ValidationMessageFor(m => m.BulkDeposit.Note, "", new { @class = "text-danger " })
                        <label for="Note">Transaction Note (Reason)</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-end mt-4">
                <button class="btn btn-primary me-2" onclick="PostLoanRepayment()">
                    <i class="mdi mdi-check me-1"></i> Confirm Repayment
                </button>
                <button class="btn btn-secondary" onclick="Reprint()">
                    <i class="mdi mdi-printer me-1"></i> Reprint Receipt
                </button>
            </div>
        </div>
    </fieldset>
</div>

