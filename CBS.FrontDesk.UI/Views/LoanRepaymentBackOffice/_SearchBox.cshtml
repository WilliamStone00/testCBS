

@using Resources
<fieldset class="fieldset-custom">
    <div class="row">
        <div class="col-md-8 mx-auto">

            <!-- Search Bar -->
            <div class="input-group shadow">
                <input type="text" id="manualSearchInput" class="form-control" placeholder="@GlobalShared.EnterMemberReferenceNumber: 0120050001" maxlength="10">
                <button class="btn btn-primary" onclick="GetMember()">
                    <i class="mdi mdi-magnify"></i> @GlobalShared.Search
                </button>
            </div>
            <small class="form-text text-muted mt-2">

                @GlobalLoanRepaymentBackOffice.enter_the10_digit_member_reference_number. <br />
                @GlobalLoanRepaymentBackOffice.perform_secure_cash_deposits_into_member_accounts.

            </small>
        </div>
    </div>
</fieldset>
<input type="hidden" class="form-control shadow-box" value="" id="currentselectedOperation" />