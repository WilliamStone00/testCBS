@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = "Loan Repayment - Member Balances";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="container">
    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank me-2"></i> @GlobalLoanRepaymentBackOffice.BackOfficeLoanRepaymentManagement
                    </h1>
                    <p class="card-text">
                        @GlobalLoanRepaymentBackOffice.ProcessLoanRepaymentsFrom <strong>@GlobalLoanRepaymentBackOffice.membersBalances</strong> @GlobalLoanRepaymentBackOffice.EfficientlyBySelectingTheAccountToDebitAndEntering.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Help Tips Section -->
    <div class="row mb-0">
        <div class="col-12">
            <div class="accordion" id="helpTipsAccordion">
                <div class="card">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span>
                            <i class="mdi mdi-information-outline me-2"></i> @GlobalLoanRepaymentBackOffice.HELPTIPS
                        </span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                        <div class="card-body">
                            <div class="accordion" id="helpDetailsAccordion">
                                <!-- Loan Repayment Guide -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepaymentGuide" aria-expanded="false" aria-controls="collapseLoanRepaymentGuide">
                                            @GlobalLoanRepaymentBackOffice.LoanRepaymentProcess
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRepaymentGuide" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ol>
                                                <li>@GlobalLoanRepaymentBackOffice.First, <strong>@GlobalLoanRepaymentBackOffice.selectAndEnterAmountsToDebitFromMembersAccounts</strong>.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.EnsureThe <strong>@GlobalLoanRepaymentBackOffice.total_amount_debited_matches_the_loan_repayment_sum</strong>.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.NextEnterThe <strong>@GlobalLoanRepaymentBackOffice.capital_repayment_interest_VAT_and_penalty</strong> @GlobalLoanRepaymentBackOffice.inTheLoanTable.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.Click <strong>"@GlobalLoanRepaymentBackOffice.Confirm_Transaction"</strong> @GlobalLoanRepaymentBackOffice.to_validate_the_payment.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.IfAllValuesMatchTheRepaymentIsProcessedSuccessfully.</li>
                                            </ol>
                                            <strong>NB:</strong> @GlobalLoanRepaymentBackOffice.A_mismatch_between_debited_accounts_and_loan_repayment_details_will_prevent_submission.
                                        </div>
                                    </div>
                                </div>

                                <!-- Loan Repayment Fees -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanFees" aria-expanded="false" aria-controls="collapseLoanFees">
                                            Loan Repayment Fees & Charges
                                        </button>
                                    </h2>
                                    <div id="collapseLoanFees" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ul>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.Interest:</strong> @GlobalLoanRepaymentBackOffice.Based_on_the_outstanding_balance.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.VAT:</strong> @GlobalLoanRepaymentBackOffice.Automatically_calculated_from_interest.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.Penalty:</strong> @GlobalLoanRepaymentBackOffice.Applied_to_overdue_repayments.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.Processing_fees:</strong> @GlobalLoanRepaymentBackOffice.May_apply_depending_on_loan_agreement.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Refund Policy -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRefundPolicy" aria-expanded="false" aria-controls="collapseLoanRefundPolicy">
                                            @GlobalLoanRepaymentBackOffice.Refund_Policy_for_Loan_Repayments
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRefundPolicy" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <p>@GlobalLoanRepaymentBackOffice.Loan_repayments <strong>@GlobalLoanRepaymentBackOffice.cannot_be_refunded</strong>, @GlobalLoanRepaymentBackOffice.except_in_cases_of:</p>
                                            <ul>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.Overpayment:</strong> @GlobalLoanRepaymentBackOffice.Refund_request_must_be_submitted.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.System_Errors:</strong> @GlobalLoanRepaymentBackOffice.If_a_duplicate_transaction_occurs.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div> <!-- End of Help Details Accordion -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="row my-3">
                <div class="accordion" id="collapsibleSection">
                    <div class="card accordion-item mb-1">
                        <h2 class="accordion-header" id="headingDeliveryAddress">

                            <button type="button"
                                    class="accordion-button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#accordionPopoutIcon-3"
                                    aria-expanded="true"
                                    aria-controls="accordionPopoutIcon-3">
                                <i class="mdi mdi-bank me-2"></i>
                                <span id="cashDeskOperations">@GlobalLoanRepaymentBackOffice.Loan_Repayment_Management_Back_Office</span>
                            </button>
                        </h2>
                        <hr />
                        <div id="collapseDeliveryAddress"
                             data-bs-parent="#collapsibleSection">
                            <div class="accordion-body">

                                @Html.Partial("_SearchBox")
                                <div id="datalistingview">


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanRepaymentBackOffice/LoanRepaymentBackOffice.js"></script>
    <script src="~/Scripts/Js/Crud/LoanRepaymentBackOffice/VAT.js"></script>
}
