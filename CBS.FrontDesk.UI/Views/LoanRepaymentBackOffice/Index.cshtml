@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = "Loan Repayment - Member Balances";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="container">
    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank me-2"></i> @GlobalLoanRepaymentBackOffice.back_office_loan_repayment_management
                    </h1>
                    <p class="card-text">
                        @GlobalLoanRepaymentBackOffice.process_loan_repayments_from <strong>@GlobalLoanRepaymentBackOffice.members_balances</strong> @GlobalLoanRepaymentBackOffice.efficiently_by_selecting_the_account_to_debit_and_entering.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Help Tips Section -->
    <div class="row mb-0">
        <div class="col-12">
            <div class="accordion" id="helpTipsAccordion">
                <div class="card">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span>
                            <i class="mdi mdi-information-outline me-2"></i> @GlobalShared.HELP_TIPS
                        </span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                        <div class="card-body">
                            <div class="accordion" id="helpDetailsAccordion">
                                <!-- Loan Repayment Guide -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepaymentGuide" aria-expanded="false" aria-controls="collapseLoanRepaymentGuide">
                                            @GlobalLoanRepaymentBackOffice.loan_repayment_process
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRepaymentGuide" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ol>
                                                <li>@GlobalShared.first, <strong>@GlobalLoanRepaymentBackOffice.select_and_enter_amounts_to_debit_from_members_accounts</strong>.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.ensure_the <strong>@GlobalLoanRepaymentBackOffice.total_amount_debited_matches_the_loan_repayment_sum</strong>.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.next_enter_the <strong>@GlobalLoanRepaymentBackOffice.capital_repayment_interest_vat_and_penalty</strong> @GlobalLoanRepaymentBackOffice.in_the_loan_table.</li>
                                                <li>@GlobalShared.Click <strong>"@GlobalShared.confirm_transaction"</strong> @GlobalLoanRepaymentBackOffice.to_validate_the_payment.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.if_all_values_match_the_repayment_is_processed_successfully.</li>
                                            </ol>
                                            <strong>NB:</strong> @GlobalLoanRepaymentBackOffice.a_mismatch_between_debited_accounts_and_loan_repayment_details_will_prevent_submission.
                                        </div>
                                    </div>
                                </div>

                                <!-- Loan Repayment Fees -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanFees" aria-expanded="false" aria-controls="collapseLoanFees">
                                            @GlobalLoanRepaymentBackOffice.loan_repayment_fees_charges
                                        </button>
                                    </h2>
                                    <div id="collapseLoanFees" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ul>
                                                <li><strong>@GlobalShared.Interest:</strong> @GlobalLoanRepaymentBackOffice.based_on_the_outstanding_balance.</li>
                                                <li><strong>@GlobalShared.VAT:</strong> @GlobalLoanRepaymentBackOffice.automatically_calculated_from_interest.</li>
                                                <li><strong>@GlobalShared.Penalty:</strong> @GlobalLoanRepaymentBackOffice.applied_to_overdue_repayments.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.processing_fees:</strong> @GlobalLoanRepaymentBackOffice.may_apply_depending_on_loan_agreement.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Refund Policy -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRefundPolicy" aria-expanded="false" aria-controls="collapseLoanRefundPolicy">
                                            @GlobalLoanRepaymentBackOffice.refund_policy_for_loan_repayments
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRefundPolicy" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <p>@GlobalShared.loan_repayments <strong>@GlobalLoanRepaymentBackOffice.cannot_be_refunded</strong>, @GlobalLoanRepaymentBackOffice.except_in_cases_of:</p>
                                            <ul>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.overpayment:</strong> @GlobalLoanRepaymentBackOffice.refund_request_must_be_submitted.</li>
                                                <li><strong>@GlobalShared.system_errors:</strong> @GlobalLoanRepaymentBackOffice.if_a_duplicate_transaction_occurs.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div> <!-- End of Help Details Accordion -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="row my-3">
                <div class="accordion" id="collapsibleSection">
                    <div class="card accordion-item mb-1">
                        <h2 class="accordion-header" id="headingDeliveryAddress">

                            <button type="button"
                                    class="accordion-button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#accordionPopoutIcon-3"
                                    aria-expanded="true"
                                    aria-controls="accordionPopoutIcon-3">
                                <i class="mdi mdi-bank me-2"></i>
                                <span id="cashDeskOperations">@GlobalLoanRepaymentBackOffice.loan_repayment_management_back_office</span>
                            </button>
                        </h2>
                        <hr />
                        <div id="collapseDeliveryAddress"
                             data-bs-parent="#collapsibleSection">
                            <div class="accordion-body">

                                @Html.Partial("_SearchBox")
                                <div id="datalistingview">


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanRepaymentBackOffice/LoanRepaymentBackOffice.js"></script>
    <script src="~/Scripts/Js/Crud/LoanRepaymentBackOffice/VAT.js"></script>
}
