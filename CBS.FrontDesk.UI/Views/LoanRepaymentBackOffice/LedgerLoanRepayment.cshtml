@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    ViewBag.Title = "Loan Repayment - Ledger/Standing Order";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="container">
    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank-transfer me-2"></i> @GlobalLoanRepaymentBackOffice.ledger_bank_standing_order_loan_repayment_management
                    </h1>
                    <p class="card-text">
                        @GlobalLoanRepaymentBackOffice.process_loan_repayments_from <strong>@GlobalLoanRepaymentBackOffice.ledger_or_standing_order_balances</strong> @GlobalLoanRepaymentBackOffice.by_selecting_the_appropriate_ledger_account_and_entering_loan_repayment_details.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Help Tips Section -->
    <div class="row mb-0">
        <div class="col-12">
            <div class="accordion" id="helpTipsAccordion">
                <div class="card">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span>
                            <i class="mdi mdi-information-outline me-2"></i> @GlobalShared.HELP_TIPS
                        </span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                        <div class="card-body">
                            <div class="accordion" id="helpDetailsAccordion">
                                <!-- Loan Repayment Guide -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepaymentGuide" aria-expanded="false" aria-controls="collapseLoanRepaymentGuide">
                                            @GlobalLoanRepaymentBackOffice.loan_repayment_process
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRepaymentGuide" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ol>
                                                <li>@GlobalLoanRepaymentBackOffice.select_the <strong>@GlobalLoanRepaymentBackOffice.ledger_or_bank_standing_order_account</strong> @GlobalShared.to_debit.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.enter_the <strong>@GlobalLoanRepaymentBackOffice.amounts_to_repay_for_principal_interest_vat_and_penalties</strong>.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.ensure_the <strong>@GlobalLoanRepaymentBackOffice.ledger_debit_equals_the_total_loan_repayment_amount</strong>.</li>
                                                <li>@GlobalShared.Click <strong>"@GlobalShared.confirm_transaction"</strong> @GlobalShared.to_process.</li>
                                                <li>@GlobalLoanRepaymentBackOffice.check_confirmation_to_ensure_the_repayment_was_successful.</li>
                                            </ol>
                                            <strong>NB:</strong> @GlobalLoanRepaymentBackOffice.inconsistency_between_selected_ledge_amount.
                                        </div>
                                    </div>
                                </div>

                                <!-- Repayment Fees -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanFees" aria-expanded="false" aria-controls="collapseLoanFees">
                                            @GlobalLoanRepaymentBackOffice.loan_repayment_fees_deductions
                                        </button>
                                    </h2>
                                    <div id="collapseLoanFees" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <ul>
                                                <li><strong>@GlobalShared.Interest:</strong> @GlobalLoanRepaymentBackOffice.calculated_on_the_loans_outstanding_balance.</li>
                                                <li><strong>@GlobalShared.VAT:</strong> @GlobalLoanRepaymentBackOffice.derived_from_the_interest_portion.</li>
                                                <li><strong>@GlobalShared.Penalty:</strong> @GlobalLoanRepaymentBackOffice.applicable_for_overdue_installments.</li>
                                                <li><strong>@GlobalLoanRepaymentBackOffice.administrative_charges:</strong> @GlobalLoanRepaymentBackOffice.may_apply_based_on_loan_policy.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Refund Policy -->
                                <div class="accordion-item mt-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRefundPolicy" aria-expanded="false" aria-controls="collapseLoanRefundPolicy">
                                            Refund Policy for Ledger-Based Repayments
                                        </button>
                                    </h2>
                                    <div id="collapseLoanRefundPolicy" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                        <div class="accordion-body">
                                            <p>  @GlobalLoanRepaymentBackOffice.repayments_made_from_ledgers <strong>  @GlobalLoanRepaymentBackOffice.cannot_be_reversed</strong> @GlobalLoanRepaymentBackOffice.except_in_cases_of:</p>
                                            <ul>
                                                <li><strong>  @GlobalLoanRepaymentBackOffice.excess_debit:</strong>   @GlobalLoanRepaymentBackOffice.refund_request_to_be_validated_by_management.</li>
                                                <li><strong>  @GlobalShared.System_Error:</strong>   @GlobalLoanRepaymentBackOffice.verified_duplicate_transactions_may_be_corrected.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                            </div> <!-- End of Help Details Accordion -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="row my-3">
                <div class="accordion" id="collapsibleSection">
                    <div class="card accordion-item mb-1">
                        <h2 class="accordion-header">
                            <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseLedgerRepayment" aria-expanded="true" aria-controls="collapseLedgerRepayment">
                                <i class="mdi mdi-bank-transfer me-2"></i>
                                <span>@GlobalLoanRepaymentBackOffice.ledger_standing_order_repayment_panel</span>
                            </button>
                        </h2>
                        <hr />
                        <div id="collapseLedgerRepayment" class="collapse show" data-bs-parent="#collapsibleSection">
                            <div class="accordion-body">
                                @Html.Partial("_SearchBox")
                                <div id="datalistingview">
                                    <!-- Ledger repayment data listing appears here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanRepaymentBackOffice/LedgerLoanRepayment.js"></script>
}
