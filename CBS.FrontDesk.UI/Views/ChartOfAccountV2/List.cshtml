@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>Chart Of Account Management
                </h1>
                <p class="card-text">@AccountingV2.AffiliateManagementtext</p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Search</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <!-- matches DTO.Code -->
                            <input type="text" id="Code" name="Code" class="form-control" placeholder="Affiliate code" />
                        </div>
                        <div class="col-6">
                            <!-- matches DTO.Name -->
                            <input type="text" id="Name" name="Name" class="form-control" placeholder="Affiliate name" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Status</label>
                    <div class="d-flex gap-2 align-items-center">
                        <!-- postingAllowed mapped via select (null / true / false) -->
                        <select id="PostingAllowed" name="PostingAllowed" class="form-control w-50">
                            <option value="">Any</option>
                            <option value="true">@AccountingV2.Yes</option>
                            <option value="false">@AccountingV2.No</option>
                        </select>

                        <div class="form-check ms-3">
                            <!-- matches DTO.IncludeDeleted -->
                            <input class="form-check-input" type="checkbox" id="IncludeDeleted" name="IncludeDeleted" />
                            <label class="form-check-label fw-bold" for="IncludeDeleted">@AccountingV2.IncludeDeleted</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <label class="form-label fw-bold">OtherFilters</label>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <!-- matches DTO.Class -->
                            <input type="text" id="Class" name="Class" class="form-control" placeholder="Class (e.g. Asset)" />
                        </div>

                        <div class="col-md-6">
                            <!-- matches DTO.ParentId -->
                            <input type="text" id="ParentId" name="ParentId" class="form-control" placeholder="Parent Id" />
                        </div>

                        <div class="col-md-12 mt-2">
                            <!-- matches DTO.PathContains -->
                            <input type="text" id="PathContains" name="PathContains" class="form-control" placeholder="Path contains (e.g. /1/10/)" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@AccountingV2.Depth</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <!-- matches DTO.DepthFrom -->
                            <input type="number" id="DepthFrom" name="DepthFrom" class="form-control" min="0" />
                        </div>
                        <div class="col-6">
                            <!-- matches DTO.DepthTo -->
                            <input type="number" id="DepthTo" name="DepthTo" class="form-control" min="0" />
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="form-label fw-bold">@AccountingV2.CreatedFrom (UTC)</label>
                            <!-- matches DTO.CreatedFromUtc -->
                            <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">@AccountingV2.CreatedTo (UTC)</label>
                            <!-- matches DTO.CreatedToUtc -->
                            <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial (initial or empty) -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

<!-- DETAILS modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- content loaded by AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT modal -->
<div class="modal fade" id="affiliateEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- edit form loaded by AJAX -->
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var affiliateTable = null;

        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        function collectAffiliateFilters() {
            return {
                Code: emptyToNull($('#Code').val()),
                Name: emptyToNull($('#Name').val()),
                PostingAllowed: (function () {
                    var v = $('#PostingAllowed').val();
                    return (v === '' ? null : (v === 'true'));
                })(),
                IncludeDeleted: $('#IncludeDeleted').is(':checked') ? true : null,
                Class: emptyToNull($('#Class').val()),
                ParentId: emptyToNull($('#ParentId').val()),
                PathContains: emptyToNull($('#PathContains').val()),
                DepthFrom: ($('#DepthFrom').val() === '' ? null : parseInt($('#DepthFrom').val(), 10)),
                DepthTo: ($('#DepthTo').val() === '' ? null : parseInt($('#DepthTo').val(), 10)),
                CreatedFromUtc: emptyToNull($('#CreatedFromUtc').val()),
                CreatedToUtc: emptyToNull($('#CreatedToUtc').val()),
                options: {}
            };
        }

        function escapeHtml(str) {
            if (!str && str !== 0) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function initAffiliateDataTableIfNeeded() {
            if ($.fn.DataTable.isDataTable('#myDataTable') && affiliateTable) return;

            if (!$('#myDataTable').length) {
                if (typeof appalert === 'function') appalert('Table element #myDataTable not found on page', 0, 1);
                return;
            }

            affiliateTable = $('#myDataTable').DataTable({
                serverSide: true,
                searching: false,
                responsive: true,
                destroy: false,
                order: [[0, 'desc']], // createdDate desc by default
                ajax: {
                    url: '/ChartOfAccountV2/LoadData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        var filters = collectAffiliateFilters();
                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: 'createdDate',
                            sortColumnDirection: 'desc'
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (jqXHR) {
                        var msg = 'Failed to load data. Please try again.';
                        try { msg = jqXHR.responseJSON?.message || msg; } catch (e) { }
                        if (typeof appalert === 'function') appalert(msg, 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        render: function (data) {
                            return data ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data) : '-';
                        }
                    },
                    { data: 'Code', defaultContent: '-' },
                    { data: 'NameEn', name: 'name', defaultContent: '-' },
                    { data: 'Class', defaultContent: '-' },
                    { data: 'ParentId', defaultContent: '-' },
                    { data: 'Path', defaultContent: '-' },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var rawId = String(row.id || row.Id || data || '');
                            var recordId = encodeURIComponent(rawId);
                            var safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                            var btnId = 'actionDropdown_' + safeId;

                            var name = escapeHtml(row.name || row.Name || '');
                            var isDeleted = row.isDeleted === true || row.isDeleted === 'true' || row.isDeleted === 1;

                            var detailsBtn = `<button type="button" class="dropdown-item btn-details" data-id="${recordId}" data-name="${name}">
                                                            <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                                          </button>`;

                            var editBtn = !isDeleted ? `<button type="button" class="dropdown-item btn-edit" data-id="${recordId}" data-name="${name}">
                                                                       <i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit
                                                                     </button>` : '';

                            return `
                                            <div class="dropdown text-center">
                                                <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                                        type="button" id="${btnId}"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="mdi mdi-cog-outline"></i> Actions
                                                </button>
                                                <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                                    <li>${detailsBtn}</li>
                                                    ${!isDeleted ? `<li><hr class="dropdown-divider"></li>` : ''}
                                                    ${!isDeleted ? `<li>${editBtn}</li>` : ''}
                                                </ul>
                                            </div>
                                        `.trim();
                        }
                    }
                ],
                language: { emptyTable: 'No affiliate records found' },
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                initComplete: function () {
                    try {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                                new bootstrap.Tooltip(el);
                            });
                        }
                    } catch (e) { /* ignore */ }
                }
            });
        }

        function loadAffiliateData() {
            initAffiliateDataTableIfNeeded();
            if (affiliateTable) affiliateTable.ajax.reload(null, false);
            else console.warn('affiliateTable not initialized');
        }

        function resetAffiliateFilters() {
            var form = document.getElementById('affiliateFilterForm');
            if (form) form.reset();

            // If select2 present for fields like ParentId, clear them here:
            if ($.fn.select2) {
                try {
                    if ($('#ParentId').hasClass('select2-hidden-accessible')) {
                        $('#ParentId').val(null).trigger('change');
                    }
                } catch (e) { /* ignore */ }
            }

            if (affiliateTable) {
                affiliateTable.ajax.reload(null, false);
            } else {
                initAffiliateDataTableIfNeeded();
            }

            if (typeof appalert === 'function') appalert('Filters reset', 3, 1);
        }

        function enterEditMode() {
            // Hide filters area (if you have an id for filters wrapper)
            $('#filtersSection').addClass('d-none');

            try {
                if (window.affiliateTable && $.fn.DataTable.isDataTable('#myDataTable')) {
                    window.affiliateTable.destroy(true);
                    window.affiliateTable = null;
                }
            } catch (e) {
                console.warn('Failed to destroy affiliateTable', e);
            }
            $('body').addClass('edit-mode');
        }

        function exitEditModeAndReload() {
            $('#filtersSection').removeClass('d-none');

            // Replace listing partial (example call - adapt AddORUpdateGen to your helper)
            if (typeof AddORUpdateGen === 'function') {
                AddORUpdateGen(null, 'datalistingview', '_AffiliateDataTable', 'get', 'Affiliate');
            }

            $('body').removeClass('edit-mode');

            setTimeout(function () {
                try { initAffiliateDataTableIfNeeded(); } catch (e) { console.error(e); }
            }, 300);
        }

        $(document).ready(function () {
            // wire buttons (avoid double-binding)
            $('#applyAffiliateFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                loadAffiliateData();
            });

            $('#resetAffiliateFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                resetAffiliateFilters();
            });

            // Enter key triggers apply on form fields
            $('#affiliateFilterForm input').off('keypress').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadAffiliateData();
                }
            });

            // init select2 safely if used
            if ($.fn.select2) {
                try {
                    if ($('#ParentId').length) {
                        $('#ParentId').select2({ width: '100%', placeholder: 'Select Parent' });
                    }
                } catch (err) {
                    if (typeof appalert === 'function') appalert('select2 init failed: ' + (err && err.message ? err.message : err), 2, 1);
                    console.warn('select2 init failed', err);
                }
            }

            // DETAILS button (replace existing handler)
            $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                if (!id) {
                    if (typeof appalert === 'function') appalert('Missing id for details', 0, 1);
                    return;
                }

                var modalEl = document.getElementById('affiliateDetailsModal');
                if (!modalEl) {
                    if (typeof appalert === 'function') appalert('Details modal not found (#affiliateDetailsModal)', 0, 1);
                    return;
                }

                // Ensure we have a Bootstrap modal instance
                var bsModal = null;
                try { bsModal = new bootstrap.Modal(modalEl); } catch (ex) { bsModal = null; }

                // Show a spinner while loading and display modal so aria-hidden flips to false first
                $('#affiliateDetailsModal .modal-body').html(
                    '<div class="text-center py-4"><div class="spinner-border" role="status" aria-hidden="true"></div></div>'
                );

                if (bsModal) bsModal.show();

                // After modal shown, move keyboard/screenreader focus to a predictable element inside the modal
                $(modalEl).off('shown.bs.modal.focusFix').on('shown.bs.modal.focusFix', function () {
                    try {
                        var closeBtn = modalEl.querySelector('.btn-close, .modal-footer .btn[data-bs-dismiss="modal"]');
                        if (closeBtn) {
                            closeBtn.focus();
                        } else {
                            var dialog = modalEl.querySelector('.modal-dialog');
                            if (dialog) { dialog.setAttribute('tabindex', '-1'); dialog.focus(); }
                        }
                    } catch (err) { /* ignore focus errors */ }
                });

                // Ensure we blur active child if the modal hides (to avoid aria-hidden + focused descendant)
                $(modalEl).off('hide.bs.modal.blurFix').on('hide.bs.modal.blurFix', function () {
                    try {
                        var active = document.activeElement;
                        if (modalEl.contains(active)) active.blur();
                    } catch (err) { /* ignore */ }
                });

                // Call InitializeData to load the details partial (controller expects KEY, partialView, path)
                $.get('/ChartOfAccountV2/InitializeData', {
                    KEY: id,
                    partialView: '_DetailsPartial',
                    path: 'get'
                })
                    .done(function (html) {
                        $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');

                        // init tooltip only inside modal
                        try {
                            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                document.querySelectorAll('#affiliateDetailsModal [data-bs-toggle="tooltip"]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } catch (e) { /* ignore */ }
                    })
                    .fail(function () {
                        $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                        if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
                    });
            });


            // delegated handler for Edit — loads _EditPartial into modal and shows it
            $(document).off('click', '.btn-edit').on('click', '.btn-edit', function (e) {
                e.preventDefault();

                var $btn = $(this);
                // remove focus from the clicked button to avoid aria-hidden+focus conflict
                try { $btn.blur(); } catch (err) { /* ignore */ }

                var raw = $btn.data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                if (!id) { if (typeof appalert === 'function') appalert('Missing id for edit', 0, 1); return; }

                var modalEl = document.getElementById('affiliateEditModal');
                if (!modalEl) { if (typeof appalert === 'function') appalert('Edit modal not found (#affiliateEditModal)', 0, 1); return; }

                // prepare spinner content
                var spinner = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                $('#affiliateEditModal .modal-body').html(spinner);

                // show modal
                var bsModal = null;
                try { bsModal = new bootstrap.Modal(modalEl); } catch (ex) { /* ignore */ }
                if (bsModal) bsModal.show();

                // Load edit partial from controller (InitializeData with path=get returning _EditPartial)
                $.get('/ChartOfAccountV2/InitializeData', { KEY: id, partialView: '_EditPartial', path: 'get' })
                    .done(function (html) {
                        $('#affiliateEditModal .modal-body').html(html || '<div class="text-center text-muted">No edit form available.</div>');
                        // initialize tooltips inside modal if any
                        try {
                            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                document.querySelectorAll('#affiliateEditModal [data-bs-toggle="tooltip"]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } catch (e) { /* ignore */ }
                    })
                    .fail(function () {
                        $('#affiliateEditModal .modal-body').html('<div class="text-center text-danger">Error loading edit form</div>');
                        if (typeof appalert === 'function') appalert('Failed to load edit form', 0, 1);
                    });
            });

            // Delegated handler for the edit form loaded into the modal.
            // Put this inside your existing $(document).ready(...) or after it.
            $(document).off('submit', '#editAccountForm').on('submit', '#editAccountForm', function (e) {
                e.preventDefault();

                var $form = $(this);
                var $btn = $form.find('#saveButton');
                var originalHtml = $btn.html();

                // serialize form data
                var formData = $form.serialize();

                // get anti-forgery token (if present)
                var token = $form.find('input[name="__RequestVerificationToken"]').val();

                // disable button and show spinner
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving');

                $.ajax({
                    url: '/ChartOfAccountV2/UpdateAccountName',
                    type: 'POST',
                    data: formData,
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    success: function (res) {
                        $btn.prop('disabled', false).html(originalHtml);

                        if (res && res.success) {
                            // hide modal
                            try {
                                var modalEl = document.getElementById('affiliateEditModal');
                                var bs = bootstrap.Modal.getInstance(modalEl);
                                if (bs) bs.hide();
                            } catch (err) { /* ignore */ }

                            // reload datatable if present
                            if (typeof affiliateTable !== 'undefined' && affiliateTable) {
                                affiliateTable.ajax.reload(null, false);
                            }

                            if (typeof appalert === 'function') appalert(res.message || 'Saved', 3, 1);
                        } else {
                            if (typeof appalert === 'function') appalert(res?.message || 'Save failed', 0, 1);
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html(originalHtml);
                        if (typeof appalert === 'function') appalert('Save request failed', 0, 1);
                    }
                });
            });


        });
    </script>
}

