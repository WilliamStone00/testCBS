@model CBS.FrontDesk.Data.Entity.AccountingV2.EndOfYearClosure.EndOfYear
@using Resources
@{
    ViewBag.Title = "Manual Journal Entry - Copy";
}

@using (Html.BeginForm("PostAdjustment", "EndOfYearClosure", FormMethod.Post,
    new { enctype = "multipart/form-data", id = "journalFormCopy", onsubmit = "return journalEntrySubmitAjaxCopy(this);" }))
{
    <div class="card shadow-sm mt-3">
        <div class="card-body p-4">
         

            <!-- ================= HEADER ================= -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-primary mb-0">
                    <i class="mdi mdi-book-plus-outline me-2"></i>
                    @GlobalEndOfYearClosure.End_Of_Year_Adjustment_Entry
                </h4>

                <div class="col-md-6 mb-2 text-end">
                    @Html.TextBoxFor(m => m.AccountingDate,
                        new
                        {
                            @class = "form-control form-control-sm d-inline-block accounting-date",
                            style = "width: 180px",
                            type = "date",
                            id = "AccountingDate",
                            @readonly = "readonly"
                        })
                </div>
            </div>

            <!-- ================= INTERBRANCH ================= -->
            <div class="mb-2">
                @*<div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="enableInterbranchCopy">
                    <label class="form-check-label fw-bold" for="enableInterbranchCopy">
                        @ManualEntry.EnableInterbranchTransaction
                    </label>
                </div>*@

                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="enableInterbranchCopy" disabled="disabled">
                    <label class="form-check-label fw-bold" for="enableInterbranchCopy">
                        @GlobalEndOfYearClosure.Enable_Interbranch_Transaction
                    </label>
                </div>


                <div class="row g-2 align-items-end">
                  <div class="col-md-8">
                        <label for="BranchIdCopy" class="form-label fw-bold">Branch</label>
                        @Html.DropDownList(
                            "BranchIdCopy",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", id = "BranchIdCopy", disabled = "disabled" }
                        )
                  </div>  
                    <div class="col-md-4" id="counterpartyBranchDivCopy" style="display:none;">
                        <label for="CounterpartyBranchIdCopy" class="form-label fw-bold">@GlobalEndOfYearClosure.CounterpartyBranch</label>
                        @Html.DropDownList(
                            "CounterpartyBranchIdCopy",
                            new SelectList(ViewBag.CounterBranches, "Id", "Name", Model?.CounterpartyBranchId),
                            "Select Counterparty Branch",
                            new { @class = "form-control select2", id = "CounterpartyBranchIdCopy" }
                        )
                    </div>

                    <div class="col-md-4">
                        <label for="AdjustmentType" class="form-label fw-bold">Adjustment Type</label>
                        @Html.DropDownListFor(model => model.AdjustmentType,
                            new SelectList(ViewBag.AdjustmentType, "Value", "Text"),
                            "--- Select Adjustment ---",
                            new { @class = "form-control select2 mb-1", id = "AdjustmentType" })
                    </div>
                </div>
            </div>

            <!-- ================= TABLE ================= -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center" id="myDataTableCopy">
                    <thead class="table-light">
                        <tr>
                            <th style="width:30%">@GlobalShared.Account</th>
                            <th style="width:30%">@GlobalShared.Narration</th>
                            <th style="width:15%">@GlobalShared.Debit</th>
                            <th style="width:15%">@GlobalShared.Credit</th>
                            <th style="width:10%">@GlobalShared.Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">@GlobalShared.Totals:</td>
                            <td id="totalDebitCopy" class="text-end">0.00</td>
                            <td id="totalCreditCopy" class="text-end">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-2">
                <span id="differenceCopy" class="fw-bold text-danger">@GlobalEndOfYearClosure.Diff: 0.00</span>
            </div>

            <!-- ================= ACTION BUTTONS ================= -->
            <div class="mt-3 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-primary" id="addRowBtnCopy">
                        <i class="mdi mdi-plus"></i> @GlobalShared.Add_Row
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="clearRowsBtnCopy">
                        <i class="mdi mdi-trash-can-outline"></i> @GlobalShared.ClearAllRows
                    </button>
                </div>
            </div>

            <!-- ================= MEMO ================= -->
            <div class="mt-4">
                <label class="form-label fw-bold" for="Payload_MemoCopy">@GlobalEndOfYearClosure.Memo</label>
                @Html.TextAreaFor(
                    m => m.Payload.Memo,
                    new
                    {
                        @class = "form-control shadow-sm",
                        rows = "3",
                        placeholder = GlobalEndOfYearClosure.Enter_any_remark_or_note_about_this_journal_entry,
                        required = "required",
                        id = "Payload_MemoCopy"
                    })
            </div>

            <!-- ================= SUBMIT ================= -->
            <div class="mt-4 text-end">
                <button type="submit" id="postEntriesBtnCopy" class="btn btn-primary px-4" disabled>
                    <i class="mdi mdi-check-circle-outline me-1"></i>
                    @GlobalEndOfYearClosure.PostEntries
                </button>
            </div>
        </div>
    </div>
}