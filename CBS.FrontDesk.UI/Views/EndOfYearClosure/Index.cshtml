
<style>
    .workflow-header {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
    }

    .workflow-tabs {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 30px;
        font-size: 16px;
        margin-top: 25px;
        border-bottom: 2px solid #eee;
    }

        .workflow-tabs li {
            cursor: pointer;
            padding-bottom: 6px;
            font-weight: 500;
            color: #444;
        }

            .workflow-tabs li.active {
                color: #4169e1;
                border-bottom: 3px solid #4169e1;
                font-weight: 600;
            }

    .workflow-view {
        padding: 20px;
        background: white;
        margin-top: 10px;
        border-radius: 6px;
    }
    .workflow-tabs .step-number {
        font-weight: bold;
        margin-right: 4px;
    }

