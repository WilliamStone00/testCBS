<style>
    .workflow-header {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
    }

    .workflow-tabs {
        list-style: none;
        padding: 0;
        display: flex;
        justify-content: space-between; /* spread tabs across full width */
        font-size: 16px;
        margin-top: 25px;
        border-bottom: 2px solid #eee;
    }

        .workflow-tabs li {
            cursor: pointer;
            padding: 10px 15px; /* add padding for spacing */
            font-weight: 500;
            color: #444;
            text-align: center;
            flex: 1; /* make each tab take equal width */
            transition: all 0.3s;
        }

            .workflow-tabs li:not(:last-child) {
                margin-right: 10px; /* small extra spacing between tabs */
            }

            .workflow-tabs li.active {
                color: #4169e1;
                border-bottom: 3px solid #4169e1;
                font-weight: 600;
            }

        .workflow-tabs .step-number {
            font-weight: bold;
            margin-right: 6px;
        }

        .workflow-tabs .step-label {
            color: #333;
        }

    .workflow-view {
        padding: 20px;
        background: white;
        margin-top: 20px;
        border-radius: 6px;
    }
</style>



