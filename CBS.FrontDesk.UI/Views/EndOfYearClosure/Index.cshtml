    /* ==========================================================
     Review End-of-Year Closure (AJAX Submit)
    ========================================================== */
    window.ReviewClosureSubmitAjax = function (form) {
        console.log("Validate button clicked");

        if (!$(form).valid()) return false;

        const $form = $(form);

        // 1️⃣ Branch
        const branchData = $('#BranchId').select2('data')[0];
        if (!branchData) {
            appalert("⚠️ Select a branch before proceeding.", 3, 1);
            return false;
        }
        const branchId = branchData.id;
        const branchText = branchData.text;

        // 2️⃣ Build checklist
        const checklist = [];
        let hasSelected = false;
        let validationFailed = false;

        $form.find('.list-group-item').each(function () {
            const $item = $(this);
            const id = $item.find('.task-id').val();
            const isCompleted = $item.find('.task-checkbox').is(':checked');
            const comment = $item.find('.task-comment').val()?.trim() || "";

            if (isCompleted) {
                hasSelected = true;
                if (!comment) {
                    appalert("❗ Please add a comment for selected task.", 3, 1);
                    $item.find('.task-comment').focus();
                    validationFailed = true;
                    return false;
                }
            }

            checklist.push({ id, isCompleted, comment });
        });

        if (validationFailed) return false;

        if (!hasSelected) {
            appalert("⚠️ Please select at least one task before submitting.", 3, 1);
            return false;
        }

        // 3️⃣ Confirmation modal
        const title = "Confirm Review Completion";
        const message = `
            <p>Please verify before submitting.</p>
            <table class="table table-sm table-bordered">
                <tr><th>Branch</th><td>${branchText}</td></tr>
                <tr><th>Selected Tasks</th><td>${checklist.filter(c => c.isCompleted).length}</td></tr>
            </table>
            <div class="form-check mt-3">
                <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
                <label class="form-check-label" for="alertifyConfirmCheckbox">
                    I confirm that all reviewed tasks are correct.
                </label>
            </div>
        `;

        alertify.confirm(
            title,
            message,
            function () {
                if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                    appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                    return false;
                }

                const token = $form.find('input[name="__RequestVerificationToken"]').val();

                // ✅ Build FormData
                const formData = new FormData();
                formData.append('BranchId', branchId);
                formData.append('CompletedByUserId', ''); // optional

                checklist.forEach((c, i) => {
                    formData.append(`CheckListModel[${i}].YearEndChecklistDefinitionId`, c.id);
                    formData.append(`CheckListModel[${i}].IsCompleted`, c.isCompleted);
                    formData.append(`CheckListModel[${i}].Comment`, c.comment);
                });

                if (token) formData.append('__RequestVerificationToken', token);

                // ✅ AJAX POST
                $.ajax({
                    type: "POST",
                    url: $form.attr('action'),
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $('.alertify .ajs-ok')
                            .prop('disabled', true)
                            .html('<span class="spinner-border spinner-border-sm"></span> Submitting...');
                    },
                    success: function (response) {
                        if (response?.success) {
                            appalert("✅ Review completed successfully!", 1, 1);
                            alertify.dismissAll();
                            $form[0].reset();
                            $('.select2').val(null).trigger('change');
                        } else {
                            appalert(response?.message || "❌ Review failed.", 2, 1);
                        }
                    },
                    error: function (xhr) {
                        appalert("❌ Error: " + (xhr?.statusText || "Request failed"), 0, 1);
                    },
                    complete: function () {
                        $('.alertify .ajs-ok')
                            .prop('disabled', false)
                            .html('Yes, Continue');
                    }
                });

            },
            function () {
                appalert("🚫 Review cancelled.", 2, 1);
            }
        ).set({
            labels: { ok: "Yes, Continue", cancel: "Cancel" },
            onshow: function () {
                const okBtn = $('.alertify .ajs-ok').prop('disabled', true);
                $('#alertifyConfirmCheckbox')
                    .off('change')
                    .on('change', function () {
                        okBtn.prop('disabled', !this.checked);
                    });
            }
        });

        return false;
    };





    window.CloseYearSubmitAjax = function (form) {
        if (!$(form).valid()) return false;

        const $form = $(form);

        // ===== Branch (Select2-safe) =====
        const $branchSelect = $form.find('#BranchIdcl'); // your dropdown id
        const branchData = $branchSelect.select2('data')[0];
        if (!branchData || !branchData.id) {
            appalert("⚠️ Please select a branch.", 3, 1);
            return false;
        }
        const branchVal = branchData.id;
        const branchText = branchData.text;

        // ===== Branch Liaison GL =====
        const $branchLiaisonGL = $form.find('#BranchLiaisonGlId');
        const branchLiaisonData = $branchLiaisonGL.select2('data')[0];
        if (!branchLiaisonData || !branchLiaisonData.id) {
            appalert("⚠️ Please select a Branch Liaison GL.", 3, 1);
            return false;
        }
        const branchLiaisonVal = branchLiaisonData.id;
        const branchLiaisonText = branchLiaisonData.text;

        // ===== Head Office GL =====
        const $hoLiaisonGL = $form.find('#HoLiaisonGlId');
        const hoLiaisonData = $hoLiaisonGL.select2('data')[0];
        if (!hoLiaisonData || !hoLiaisonData.id) {
            appalert("⚠️ Please select a Head Office GL.", 3, 1);
            return false;
        }
        const hoLiaisonVal = hoLiaisonData.id;
        const hoLiaisonText = hoLiaisonData.text;

        // ===== Head Office Result GL =====
        const $hoResultGL = $form.find('#HoResultGlId');
        const hoResultData = $hoResultGL.select2('data')[0];
        if (!hoResultData || !hoResultData.id) {
            appalert("⚠️ Please select a Head Office Result GL.", 3, 1);
            return false;
        }
        const hoResultVal = hoResultData.id;
        const hoResultText = hoResultData.text;

        // ===== Accounting Date =====
        // Pick the first non-empty accounting date input with class "accounting-date"
        const accountingDate = $form.find('.accounting-date')
            .map(function () { return this.value; })
            .get()
            .find(v => v); // first non-empty value

        if (!accountingDate) {
            appalert("⚠️ Please select an accounting date.", 3, 1);
            return false;
        }

        // ===== Accounting Year & HOBranchId from controller (hidden inputs) =====
        const accountingYear = $form.find('#AccountingYear').val() || "";
        const hoBranchId = $form.find('#HOBranchId').val() || "";

        // ===== Confirmation Modal =====
        const title = "Confirm Close of Year";
        const message = `
        <p>Please review the details before confirming:</p>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr><th>Branch</th><td>${branchText}</td></tr>
                <tr><th>Branch Liaison GL</th><td>${branchLiaisonText}</td></tr>
                <tr><th>Head Office GL</th><td>${hoLiaisonText}</td></tr>
                <tr><th>Head Office Result GL</th><td>${hoResultText}</td></tr>
                <tr><th>Accounting Date</th><td>${accountingDate}</td></tr>
                <tr><th>Accounting Year</th><td>${accountingYear}</td></tr>
            </tbody>
        </table>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
            <label for="alertifyConfirmCheckbox" class="form-check-label">
                I confirm that the above details are correct.
            </label>
        </div>
    `;

        alertify.confirm(title, message,
            function () {
                if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                    appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                    return false;
                }

                const token = $form.find('input[name="__RequestVerificationToken"]').val();

                // Prepare form data
                const formData = new FormData();
                formData.append("BranchId", branchVal);
                formData.append("BranchLiaisonGlId", branchLiaisonVal);
                formData.append("HoLiaisonGlId", hoLiaisonVal);
                formData.append("HoResultGlId", hoResultVal);
                formData.append("AccountingDate", accountingDate);
                formData.append("AccountingYear", accountingYear);
                formData.append("HOBranchId", hoBranchId);

                $.ajax({
                    type: 'POST',
                    url: $form.attr('action'),
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    beforeSend: function () {
                        $('.alertify .ajs-ok').prop('disabled', true)
                            .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                    },
                    success: function (response) {
                        if (response?.success) {
                            appalert(response.message || "✅ Accounting year closed successfully!", 1, 1);
                            alertify.dismissAll();
                            $form[0].reset();
                            $('.select2').val(null).trigger('change');
                        } else {
                            appalert(response?.message || "❌ Failed to close the accounting year.", 2, 1);
                        }
                    },
                    error: function (xhr) {
                        appalert("❌ Error: " + (xhr?.statusText || "Request failed"), 0, 1);
                    },
                    complete: function () {
                        $('.alertify .ajs-ok').prop('disabled', false).html('Yes, Continue');
                    }
                });

            },
            function () {
                appalert("🚫 Operation cancelled.", 2, 1);
            }
        ).set({
            labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
            onshow: function () {
                const okBtn = $('.alertify .ajs-ok');
                okBtn.prop('disabled', true);
                $('#alertifyConfirmCheckbox').off('change').on('change', function () {
                    okBtn.prop('disabled', !this.checked);
                });
            }
        });

        return false;
    };



</script>


