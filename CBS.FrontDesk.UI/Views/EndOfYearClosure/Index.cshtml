@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")


<script>

    ////////////////////////////// CLOSE OF YEAR ////////////////

    // AUTO-SET ORDER BRANCH WHEN MAIN BRANCH IS SELECTED
    $(document).on("change", "#BranchId", function () {
        const selectedBranch = $(this).val();

        // Set the order branch dropdown
        $("#BranchIdcl")
            .val(selectedBranch)
            .trigger("change");

        // Set the copy dropdown
        $("#BranchIdCopy")
            .val(selectedBranch)
            .trigger("change");

        console.log("BranchIdcl auto-set to:", selectedBranch);
    });



    $(document).ready(function () {
        loadBranchAccountsOnPageLoad();
    });

    function loadBranchAccountsOnPageLoad() {

        $.ajax({
            url: '/EndOfYearClosure/GetAccounts',
            type: 'GET',
            dataType: 'json',

            success: function (response) {

                if (!response.success || !response.data) {
                    appalert(response.message || "⚠️ No accounts found for this branch.", 2, 1);
                    return;
                }

                const accounts = response.data;

                // Populate both dropdowns
                populateGLDropdown("#HoLiaisonGlId", accounts);
                populateGLDropdown("#HoResultGlId", accounts);
            },

            error: function () {
                appalert("❌ Error loading GL accounts.", 3, 1);
            }
        });
    }

    function populateGLDropdown(selector, accounts) {
        const $ddl = $(selector);

        $ddl.empty();
        $ddl.append(`<option value="">--- Select GL ---</option>`);

        $.each(accounts, function (i, acc) {
            $ddl.append(`<option value="${acc.Value}">${acc.Text}</option>`);
        });

        $ddl.trigger("change");  // refresh Select2
    }


    $(document).ready(function () {

        $("#BranchIdcl").on("change", function () {
            const branchId = $(this).val();

            if (!branchId) {
                $("#BranchLiaisonGlId").html('<option value="">--- Select GL ---</option>').trigger('change');
                return;
            }

            loadBranchLiaisonGL(branchId);
        });

    });

    function loadBranchLiaisonGL(branchId) {
        console.log('loadBranchLiaisonGL() called with branchId=', branchId);

        const $select = $("#BranchLiaisonGlId");
        if ($select.length === 0) {
            console.error("Element #BranchLiaisonGlId not found in DOM.");
            appalert("⚠️ Branch GL select element not present on page.", 0, 1);
            return;
        }

        // Clear immediately (useful if request takes time)
        $select.prop("disabled", true).html('<option value="">Loading...</option>').trigger('change');

        $.ajax({
            url: '/ManualJournalEntry/GetAccounts',
            type: 'GET',
            data: { branchId: branchId },
            dataType: 'json',
            success: function (response) {
                console.log("GetAccounts response:", response);

                // Normalize response into an array of items: [{ Value, Text }, ...]
                let items = [];
                if (!response) {
                    // nothing
                } else if (Array.isArray(response)) {
                    items = response;
                } else if (Array.isArray(response.data)) {
                    items = response.data;
                } else if (response.success && Array.isArray(response.accounts)) {
                    // fallback if API uses different key
                    items = response.accounts;
                }

                if (!items || items.length === 0) {
                    console.warn("No GL accounts returned for branch:", branchId);
                    appalert(response?.message || "⚠️ No GL accounts found for this branch.", 2, 1);
                    $select.html('<option value="">--- Select GL ---</option>').prop("disabled", false).trigger('change');
                    return;
                }

                // Build options
                const optionsHtml = items.map(a => {
                    // support object keys possibly named Key/Value/Text/Name
                    const val = a.Value ?? a.value ?? a.Id ?? a.Key ?? "";
                    const txt = a.Text ?? a.text ?? a.Name ?? a.name ?? a.Display ?? "";
                    return `<option value="${val}">${txt}</option>`;
                }).join("");

                $select.html('<option value="">--- Select GL ---</option>' + optionsHtml)
                    .prop("disabled", false);

                // If select2 is attached, refresh it properly
                if ($select.hasClass('select2-hidden-accessible')) {
                    try {
                        $select.trigger('change.select2');
                    } catch (err) {
                        // fallback
                        $select.trigger('change');
                    }
                } else {
                    $select.trigger('change');
                }

                appalert("✅ Branch Liaison GL loaded.", 1, 1);
            },
            error: function (xhr, status, error) {
                console.error("Error loading GL accounts:", status, error, xhr);
                const serverMsg = xhr?.responseJSON?.message || xhr?.statusText || error;
                appalert("⚠️ Error loading GL accounts: " + serverMsg, 0, 1);
                $select.html('<option value="">--- Select GL ---</option>').prop("disabled", false).trigger('change');
            }
        });
    }



    /* ==========================================================
     Accounting Date Handler (dd-MM-yyyy, always 31-12-year)
     ========================================================== */

    function setAccountingDate(year) {
        const dateValue = `${year}-12-31`; // format yyyy-MM-dd
        const input1 = document.getElementById("AccountingDate");
        if (input1) input1.value = dateValue;

        const input2 = document.getElementById("AccountingDates");
        if (input2) input2.value = dateValue;
    }

    // Increment year
    function startNewYearEnd(oldYear) {
        const nextYear = Number(oldYear) + 1;
        setAccountingDate(nextYear);
    }

    // Initial set
    setAccountingDate(2025);

    // When starting a new year-end:
    // startNewYearEnd(2025); // → sets 31-12-2026



       /* ==========================================================
   2️⃣ Load Accounting Year When Branch Changes
   ========================================================== */
        $(document).ready(function () {
    $("#BranchId").change(function () {
        const branchId = $(this).val();

        if (!branchId) {
            $("#AccountingYearId").val('');
            $("#TaskAccountingYearId").val('');
            return;
        }

        $.ajax({
            url: '@Url.Action("GetClosureOpenYearByBranchId", "EndOfYearClosure")',
            type: "GET",
            data: { branchId: branchId },
            success: function (data) {
                console.log("years returned:", data); // debug
                if (data && data.length > 0) {
                    const year = data[0].year;
                    const id = data[0].id;

                    // Fill UI (visible textbox) and hidden DB id
                    $("#AccountingYearId").val(year);
                    $("#TaskAccountingYearId").val(id);


                    appalert("Accounting Year loaded successfully", 1, 1);
                } else {
                    $("#AccountingYearId").val('');
                    $("#TaskAccountingYearId").val('');


                    appalert("No Accounting Year found for this branch", 2, 1);
                }
            },
            error: function () {
                $("#AccountingYearId").val('');
                $("#TaskAccountingYearId").val('');

                appalert("Failed to load Accounting Year", 2, 1);
            }
        });
    });
});



        /* ==========================================================
           3️⃣ Workflow Tabs Navigation
           ========================================================== */
        $(document).on("click", ".workflow-tabs li", function () {
            $(".workflow-tabs li").removeClass("active");      // deactivate all tabs
            $(this).addClass("active");                        // activate clicked tab
            $(".workflow-view").addClass("d-none");            // hide all views
            const target = $(this).data("view");              // show selected view
            $("#" + target).removeClass("d-none");
        });

         


        /* ==========================================================
           5️⃣ Initiate End-of-Year Closure (AJAX Submit)
           ========================================================== */
        window.InitiateSubmitAjax = function (form) {
            if (!$(form).valid()) return false;

            const $form = $(form);

            // ===== Branch (Select2-safe) =====
            const $branchSelect = $form.find('#BranchId');
            const branchData = $branchSelect.select2('data')[0];
            if (!branchData || !branchData.id) {
                appalert("Select a branch.", 3, 1);
                return false;
            }
            const branchVal = branchData.id;
            const branchText = branchData.text;

            // ===== Accounting Year =====
            const $yearInput = $form.find('#AccountingYearId');
            const yearVal = $yearInput.val();
            const yearText = yearVal || "---";
            if (!yearVal) {
                appalert("Select an accounting year.", 3, 1);
                return false;
            }



            // ===== Remarks =====
            const $memoInput = $form.find('#Memo');
            const remarksText = $memoInput.val();
            if (!remarksText) {
                appalert("Enter a remark.", 3, 1);
                return false;
            }

            // ===== Confirmation Modal =====
            const title = "Confirm End-of-Year Closure";
            const message = `
                <p>Please review the details below before confirming:</p>
                <table class="table table-sm table-bordered">
                    <tbody>
                        <tr><th>Branch</th><td>${branchText}</td></tr>
                        <tr><th>Accounting Year</th><td>${yearText}</td></tr>

                        <tr><th>Remarks</th><td>${remarksText}</td></tr>
                    </tbody>
                </table>
                <div class="form-check mt-3">
                    <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
                    <label for="alertifyConfirmCheckbox" class="form-check-label">
                        I confirm that the above details are correct.
                    </label>
                </div>
            `;

            alertify.confirm(title, message,
                function () {
                    if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                        appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                        return false;
                    }

                    const token = $form.find('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        type: 'POST',
                        url: $form.attr('action'),
                        data: new FormData($form[0]),
                        processData: false,
                        contentType: false,
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        beforeSend: function () {
                            $('.alertify .ajs-ok').prop('disabled', true)
                                .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                        },
                        success: function (response) {
                            if (response?.success) {
                                appalert(response.message || "✅ Closure initiated successfully!", 1, 1);
                                alertify.dismissAll();
                                if (String(response.reloadDataView).toLowerCase() === "yes") {
                                    $form[0].reset();
                                    $('.select2').val(null).trigger('change');
                                }
                            } else {
                                appalert(response?.message || "❌ Failed to initiate closure.", 2, 1);
                            }
                        },
                        error: function (xhr) {
                            appalert("❌ Error: " + (xhr?.statusText || "Request failed"), 0, 1);
                        },
                        complete: function () {
                            $('.alertify .ajs-ok').prop('disabled', false).html('Yes, Continue');
                        }
                    });

                },
                function () {
                    appalert("🚫 Operation cancelled.", 2, 1);
                }
            ).set({
                labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
                onshow: function () {
                    const okBtn = $('.alertify .ajs-ok');
                    okBtn.prop('disabled', true);
                    $('#alertifyConfirmCheckbox').off('change').on('change', function () {
                        okBtn.prop('disabled', !this.checked);
                    });
                }
            });

            return false;
    };


    //// AdjustMent Journal

    $(function () {

        const tableBody2 = $('#myDataTableCopy tbody');
        let accounts2 = [];

        // ==================== Initialize Select2 ====================
        function initSelect2Copy() {
            $('.account-select-copy, #CounterpartyBranchIdCopy, #BranchIdCopy').select2({
                width: '100%',
                placeholder: 'Select option',
                allowClear: true
            });
        }

        // ==================== Add Row ====================
        function addRowCopy() {
            const index = $('#myDataTableCopy tbody tr').length;


            const row = `
        <tr>
            <td>
                <select name="Lines[${index}].AccountId" class="form-select account-select-copy" required>
                    <option value="">Select Account</option>
                    ${accounts2.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('')}
                </select>
            </td>

            <td>
                <textarea class="form-control narration-input-copy" name="Lines[${index}].Narration"
                    placeholder="Enter narration" rows="1" oninput="autoGrowCopy(this)" required></textarea>
            </td>
            <td><input type="number" step="0.01" class="form-control debit-input-copy" name="Lines[${index}].Debit" placeholder="0.00" min="0" /></td>
            <td><input type="number" step="0.01" class="form-control credit-input-copy" name="Lines[${index}].Credit" placeholder="0.00" min="0" /></td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger deleteRowCopy"><i class="mdi mdi-delete"></i></button>
            </td>
        </tr>
    `;

            $('#myDataTableCopy tbody').append(row);

            // Re-initialize select2
            $('.account-select-copy, .adjustment-type-copy').select2({ width: '100%' });
        }


        // ==================== Auto-grow textarea ====================
        window.autoGrowCopy = function (el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        }

        // ==================== Update Totals ====================
        function updateTotalsCopy() {
            let debitTotal = 0, creditTotal = 0;

            tableBody2.find('.debit-input-copy').each(function () {
                debitTotal += parseFloat($(this).val()) || 0;
            });
            tableBody2.find('.credit-input-copy').each(function () {
                creditTotal += parseFloat($(this).val()) || 0;
            });

            const diff = debitTotal - creditTotal;

            $('#totalDebitCopy').text(`XAF ${debitTotal.toLocaleString()}`);
            $('#totalCreditCopy').text(`XAF ${creditTotal.toLocaleString()}`);

            $('#differenceCopy')
                .text(`Diff: XAF ${diff.toLocaleString()}`)
                .toggleClass('text-danger', diff !== 0)
                .toggleClass('text-success', diff === 0);

            $('#postEntriesBtnCopy').prop('disabled', diff !== 0 || accounts2.length === 0);
        }

        // ==================== Debit/Credit Exclusivity ====================
        tableBody2.on('input', '.debit-input-copy, .credit-input-copy', function () {
            const row = $(this).closest('tr');
            const debit = row.find('.debit-input-copy');
            const credit = row.find('.credit-input-copy');

            if ($(this).hasClass('debit-input-copy') && $(this).val()) {
                credit.val('').prop('disabled', true);
            } else if ($(this).hasClass('credit-input-copy') && $(this).val()) {
                debit.val('').prop('disabled', true);
            } else {
                debit.prop('disabled', false);
                credit.prop('disabled', false);
            }

            updateTotalsCopy();
        });

        // ==================== Load Accounts ====================
        function loadAccountsCopy(branchId) {
            if (!branchId) {
                appalert("⚠️ Please select a branch first.", 2, 1);
                return;
            }

            $.ajax({
                url: '/ManualJournalEntry/GetAccounts',
                type: 'GET',
                data: { branchId: branchId },
                dataType: 'json',
                success: function (response) {
                    if (!response.success || !response.data) {
                        appalert(response.message || "⚠️ No accounts found for this branch.", 2, 1);
                        accounts2 = [];
                        return;
                    }
                    appalert("✅ Accounts loaded successfully.", 1, 1);

                    accounts2 = response.data.map(a => ({ Value: a.Value, Text: a.Text }));
                    const options = accounts2.map(a => `<option value="${a.Value}">${a.Text}</option>`).join('');

                    $('#myDataTableCopy .account-select-copy').each(function () {
                        $(this).html('<option value="">Select Account</option>' + options);
                    });

                    $('#addRowBtnCopy, #postEntriesBtnCopy').prop('disabled', false);
                    initSelect2Copy();
                },
                error: function (err) {
                    appalert("Error loading accounts: " + err.statusText, 0, 1);
                }
            });
        }

        $("#BranchIdCopy").on("change", function () {
            const branchId = $(this).val();
            if (branchId)
                loadAccountsCopy(branchId);
            else {
                $('#myDataTableCopy .account-select-copy')
                    .html('<option value="">Select Account</option>');
                $('#addRowBtnCopy, #postEntriesBtnCopy').prop('disabled', true);
                accounts2 = [];
            }
        });

        // ==================== Interbranch Toggle ====================
        $('#enableInterbranchCopy').change(function () {
            if ($(this).is(':checked')) {
                $('#counterpartyBranchDivCopy').slideDown();
                $('#CounterpartyBranchIdCopy').prop('required', true);
            } else {
                $('#counterpartyBranchDivCopy').slideUp();
                $('#CounterpartyBranchIdCopy').prop('required', false).val('').trigger('change');
            }
        });

        // ==================== Add/Delete/Clear Rows ====================
        $('#addRowBtnCopy').click(() => {
            let canAdd = true;
            tableBody2.find('tr:last').find('input:enabled, select:enabled').each(function () {
                if (!$(this).val()) {
                    canAdd = false;
                    $(this).addClass('is-invalid').css('border-color', 'red');
                } else {
                    $(this).removeClass('is-invalid').css('border-color', '');
                }
            });
            if (!canAdd) {
                appalert("Please fill all fields before adding a new row.", 2, 1);
                return;
            }
            addRowCopy();
        });

        tableBody2.on('click', '.deleteRowCopy', function () {
            $(this).closest('tr').remove();
            updateTotalsCopy();
        });

        $('#clearRowsBtnCopy').click(() => {
            tableBody2.empty();
            addRowCopy();
            updateTotalsCopy();
        });

        // ==================== Initialize ====================
        initSelect2Copy();
        addRowCopy();
        $('#addRowBtnCopy, #postEntriesBtnCopy').prop('disabled', true);



        /* ================================================================
               🔵 CONFIRMATION MODAL LOGIC (PREVIEW BEFORE POSTING)
           ================================================================ */

        const confirmModalCopy = new bootstrap.Modal(document.getElementById('confirmationModal'));

        $('#postEntriesBtnCopy').on('click', function (e) {
            e.preventDefault();

            const rows = $('#myDataTableCopy tbody tr');
            const tbody = $('#confirmTableCopy tbody');
            tbody.empty();

            let totalDebit = 0, totalCredit = 0;

            rows.each(function () {
                const account = $(this).find('.account-select-copy option:selected').text().trim();
                const debit = parseFloat($(this).find('.debit-input-copy').val()) || 0;
                const credit = parseFloat($(this).find('.credit-input-copy').val()) || 0;

                if (account && (debit > 0 || credit > 0)) {
                    tbody.append(`
                    <tr>
                        <td>${account}</td>
                        <td class="text-end">${debit.toFixed(2)}</td>
                        <td class="text-end">${credit.toFixed(2)}</td>
                    </tr>
                `);

                    totalDebit += debit;
                    totalCredit += credit;
                }
            });

            $('#confirmTotalDebitCopy').text(totalDebit.toFixed(2));
            $('#confirmTotalCreditCopy').text(totalCredit.toFixed(2));

            if (rows.length === 0 || (totalDebit === 0 && totalCredit === 0)) {
                appalert("Please add at least one valid entry before posting.", 2, 1);
                return;
            }

            if ($('#enableInterbranchCopy').is(':checked')) {
                $('#confirmCounterpartyBranchCopy')
                    .text($('#CounterpartyBranchIdCopy option:selected').text());
                $('#confirmCounterpartyDivCopy').show();
            } else {
                $('#confirmCounterpartyDivCopy').hide();
            }

            $('#confirmAccountingDateCopy').text($('#AccountingDate').val());

            confirmModalCopy.show();
        });

        // ==================== Confirm Post (Actual Submit) ====================
        $('#confirmPostBtnCopy').on('click', function () {
            confirmModalCopy.hide();
            $('#postEntriesBtnCopy').prop('disabled', true);

            const form = document.getElementById('journalFormCopy');
            journalEntrySubmitAjaxCopy(form);
        });

        // Prevent default form submit
        $('#journalFormCopy').submit(function (e) {
            e.preventDefault();
        });


        /* ================================================================
                      🔵 AJAX SUBMIT (FINAL POST)
           ================================================================ */

        window.journalEntrySubmitAjaxCopy = function (form) {

            // GET ADJUSTMENT TYPE FROM DROPDOWN (OUTSIDE TABLE)
            const adjustmentType = $("#AdjustmentType").val();

            const entries = [];
            $("#myDataTableCopy tbody tr").each(function () {
                const $row = $(this);

                const accountId = $row.find(".account-select-copy").val();
                const narration = $row.find(".narration-input-copy").val();
                const debit = parseFloat($row.find(".debit-input-copy").val()) || 0;
                const credit = parseFloat($row.find(".credit-input-copy").val()) || 0;

                if (accountId && (debit > 0 || credit > 0)) {
                    entries.push({
                        AffiliateAccountId: accountId,
                        Naration: narration,
                        AdjustmentType: adjustmentType,     // 👈 PASS DROPDOWN VALUE HERE
                        Dr: debit > 0,
                        Cr: credit > 0,
                        Amount: debit > 0 ? debit : credit
                    });
                }
            });

            // HEADER PAYLOAD INCLUDING ADJUSTMENT TYPE
            const payload = {
                BranchId: $("#BranchIdCopy").val() || null,
                CounterpartyBranchId: $("#CounterpartyBranchIdCopy").val() || null,
                AccountingDate: $("#AccountingDate").val(),
                AdjustmentType: adjustmentType,          // 👈 INCLUDED AT TOP LEVEL TOO
                PostMode: "MANUAL",
                Payload: {
                    Memo: $("#Payload_MemoCopy").val(),
                    AllowUnbalanced: false,
                    Entries: entries
                }
            };

            $.ajax({
                url: '/EndOfYearClosure/PostAdjustment',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                beforeSend: function () {
                    $('#postEntriesBtnCopy').prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Posting...');
                },
                success: function (res) {
                    if (res.success) {
                        appalert(res.message || 'Journal entry posted successfully', 1, 1);
                        $('#journalFormCopy')[0].reset();
                        $('#myDataTableCopy tbody').empty();
                        $('#addRowBtnCopy, #postEntriesBtnCopy').prop('disabled', true);
                    } else {
                        appalert(res.message || 'Failed to post journal entry', 2, 1);
                    }
                },
                error: function (xhr) {
                    appalert("Error posting journal entry: " + xhr.statusText, 0, 1);
                },
                complete: function () {
                    $('#postEntriesBtnCopy').prop('disabled', false)
                        .html('<i class="mdi mdi-check-circle-outline me-1"></i> Post Entries');
                }
            });
        };

    });


