@model CBS.FrontDesk.Data.Entity.AccountingV2.EndOfYearClosure.EndOfYear
@using System.Linq

@using (Html.BeginForm(
    "CloseYear",
    "EndOfYearClosure",
    FormMethod.Post,
    new { enctype = "multipart/form-data", onsubmit = "return CloseYearSubmitAjax(this);" }))
{
    @Html.AntiForgeryToken()

    <!-- Main Card -->
    <div class="card p-3 mb-2">

        <!-- Hidden Accounting Year -->
        @Html.HiddenFor(m => m.AccountingYear, new { id = "AccountingYear" })

        <!-- Branch Selection -->
        <div class="row mb-1">
            <div class="col-md-6 mb-2">
                @Html.Label(
                    "BranchId",
                    "Branch",
                    new { @class = "form-label fw-bold", @for = "BranchIdcl" })

                @Html.DropDownList(
                    "BranchId",
                    new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                    "--- Select Branch ---",
                    new
                    {
                        @class = "form-control select2 mb-2",
                        id = "BranchIdcl",
                        disabled = "disabled"
                    })
            </div>
        </div>

        <!-- Result GLs -->
        <div class="row mb-1">

            <!-- Branch Result GL -->
            <!-- Branch Result GL -->
            <div class="col-md-6 mb-2">
                @Html.Label(
                    "BranchResultGlId",
                    "Branch Result GL",
                    new { @class = "form-label fw-semibold" })

                <div class="input-group">
                    @Html.DropDownList(
                        "BranchResultGlId",
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text = "--- Select Branch Result GL ---",
                                Value = ""
                            }
                        },
                        new
                        {
                            @class = "form-control select2",
                            id = "BranchResultGlId",
                            required = "required"
                        })

                    @*<button type="button"
                            class="btn btn-outline-secondary"
                            id="btnLoadBranchResultGl"
                            title="Load Branch Result GL">
                        <i class="fa fa-sync"></i>
                    </button>*@
                </div>
            </div>


            <!-- Head Office Result GL -->
            <div class="col-md-6 mb-2">
                @Html.Label(
                    "HoResultGlId",
                    "Head Office Result GL",
                    new { @class = "form-label fw-semibold" })

                @Html.DropDownList(
                    "HoResultGlId",
                    new List<SelectListItem>
                    {
                        new SelectListItem
                        {
                            Text = "--- Select Head Office Result GL ---",
                            Value = ""
                        }
                    },
                    new
                    {
                        @class = "form-control select2 mb-2",
                        id = "HoResultGlId",
                        required = "required"
                    })
            </div>

        </div>

        <!-- Action Button -->
        <div class="row mb-2">
            <div class="col-md-12 text-end">
                <button type="submit" class="btn btn-primary">
                    Reset Income and Expense
                </button>
            </div>
        </div>

    </div>
}
