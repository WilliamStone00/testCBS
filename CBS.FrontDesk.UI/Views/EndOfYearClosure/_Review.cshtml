@model CBS.FrontDesk.Data.Entity.AccountingV2.EndOfYearClosure.EndOfYearTaskViewModel
@using System.Linq

<div class="container mt-4">
    <h3>End of Year Tasks</h3>
    <div class="list-group">

        @for (int i = 0; i < Model.Tasks.Count; i++)
        {
            var item = Model.Tasks[i];

            <div class="list-group-item">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="Tasks[@i].IsSelected"
                           value="true" />

                    <input type="hidden" name="Tasks[@i].Id" value="@item.Id" />

                    <label class="form-check-label fw-bold">
                        @item.Title
                    </label>
                </div>

                <small class="text-muted d-block mt-1">
                    @item.Description
                </small>

                <!-- COMMENT PER TASK -->
                <div class="mt-2">
                    <label class="form-label">Comment</label>
                    <textarea class="form-control"
                              name="Tasks[@i].Comment"
                              rows="2"
                              placeholder="Add note for this task">@item.Comment</textarea>
                </div>
            </div>
        }

        <!-- SAVE -->
        <div class="row mb-2 mt-3">
            <div class="col-md-12 text-end">
                <button type="submit" class="btn btn-primary">Validate</button>
            </div>
        </div>

    </div>
</div>
