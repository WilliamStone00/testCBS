@model CBS.FrontDesk.Data.Entity.Accounting_V2.FallBack.ReconcileFallbackRequest
@using Resources
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-check-circle me-2"></i> @AffiliateToBranchFallback.Reconcile_Fallback_Transaction
        </h1>
        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            <strong>Info:</strong> @AffiliateToBranchFallback.Reconcile_the_fallback_transaction_by_mapping_source_and_destination_GL_accounts.
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

@using (Html.BeginForm("Reconcile", "AffiliateToBranchFallback", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

   

        <div class="card-body">
            <!-- Collapsible Source Section -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white" data-bs-toggle="collapse" data-bs-target="#sourceSection" style="cursor: pointer;">
                    <h6 class="mb-0">
                        <i class="mdi mdi-arrow-top-right me-2"></i> @GlobalShared.Source_Transaction_Readonly
                        <i class="mdi mdi-chevron-down float-end"></i>
                    </h6>
                </div>
                <div id="sourceSection" class="collapse show">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@GlobalShared.Source_GL_Account</label>
                                @Html.TextBoxFor(m => m.SourceGlAccountNumber, new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly",
                                    style = "background-color:#f8f9fa;"
                                })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@GlobalShared.Source_Amount</label>
                                @Html.TextBoxFor(m => m.SourceAmount, new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly",
                                    style = "background-color:#f8f9fa;"
                                })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@GlobalShared.Source_SIT</label>
                                @Html.TextBoxFor(m => m.SourceSit, new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly",
                                    style = "background-color:#f8f9fa;"
                                })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@GlobalShared.Source_Description</label>
                                @Html.TextBoxFor(m => m.SourceDescription, new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly",
                                    style = "background-color:#f8f9fa;"
                                })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Destination Section -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="mdi mdi-arrow-bottom-left me-2"></i>@GlobalShared.Destination_Transaction</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@GlobalShared.Destination_GL_Account </label>
                            @if (ViewBag.BranchAccount != null)
                            {
                                @Html.DropDownListFor(m => m.DestinationGlAccountNumber, new SelectList(ViewBag.BranchAccount, "Id", "name"), "--- Select branch Account ---", new { @class = "form-control select2" })
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="mdi mdi-alert me-2"></i>@AffiliateToBranchFallback.Branch_accounts_not_available_Please_try_refreshing_the_page.
                                </div>
                                @Html.HiddenFor(m => m.DestinationGlAccountNumber)
                            }
                            @Html.ValidationMessageFor(m => m.DestinationGlAccountNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@GlobalShared.Destination_Amount </label>
                            @Html.TextBoxFor(m => m.DestinationAmount, new
                            {
                                @class = "form-control",
                                required = "required",
                                type = "number",
                                step = "0.01",
                                min = "0"
                            })
                            @Html.ValidationMessageFor(m => m.DestinationAmount, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@GlobalShared.Destination_SIT *</label>
                            @Html.TextBoxFor(m => m.DestinationSit, new
                            {
                                @class = "form-control",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.DestinationSit, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@GlobalShared.Destination_Description </label>
                            @Html.TextBoxFor(m => m.DestinationDescription, new
                            {
                                @class = "form-control",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.DestinationDescription, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2 btn-back-to-list">Cancel</button>
            <button type="submit" class="btn btn-success">
                <i class="mdi mdi-check-circle me-1"></i> @GlobalShared.Complete_Reconciliation
            </button>
        </div>
  
}