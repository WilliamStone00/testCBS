@section Scripts {
    <script>
        var fallbackTable = null;
        var currentFallbackData = [];

        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        function collectFallbackFilters() {
            return {
                BranchId: emptyToNull($('#branchId').val()),
                OperationCode: emptyToNull($('#operationCode').val()),
                Reference: emptyToNull($('#reference').val()),
                Status: emptyToNull($('#status').val()),
                SupposedGlContains: emptyToNull($('#supposedGlContains').val()),
                FallbackGlContains: emptyToNull($('#fallbackGlContains').val()),
                From: emptyToNull($('#fromDate').val()),
                To: emptyToNull($('#toDate').val()),
                options: {}
            };
        }

        function updateStatistics(stats) {
            if (stats) {
                $('#toBeReconciledCount').text(stats.toBeReconciled || 0);
                $('#alreadyReconciledCount').text(stats.alreadyReconciled || 0);
                $('#totalCount').text(stats.total || 0);
            }
        }

        function initDataTableIfNeeded() {
            if ($.fn.DataTable.isDataTable('#fallbackDataTable') && fallbackTable) {
                return;
            }

            if (!$('#fallbackDataTable').length) {
                appalert('Table element #fallbackDataTable not found on page', 0, 1);
                return;
            }

            fallbackTable = $('#fallbackDataTable').DataTable({
                serverSide: true,
                searching: true,
                responsive: true,
                destroy: false,
                order: [[0, 'desc']],
                ajax: {
                    url: '/AffiliateToBranchFallback/LoadFallbackData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectFallbackFilters();
                        filters.DataTable = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: 'createdDate',
                            sortColumnDirection: 'desc'
                        };
                        return JSON.stringify(filters);
                    },
                    dataSrc: function (json) {
                        // Update statistics from server response
                        if (json.statistics) {
                            updateStatistics(json.statistics);
                        }

                        // Store current data for export
                        currentFallbackData = json.data || [];
                        console.log('Current fallback data stored for export:', currentFallbackData.length, 'records');

                        return json.data;
                    },
                    error: function (jqXHR) {
                        var msg = 'Failed to load data. Please try again.';
                        try { msg = jqXHR.responseJSON?.message || msg; } catch { }
                        appalert(msg, 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'createdDate',
                        render: function (data) {
                            return data ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data) : '-';
                        }
                    },
                    { data: 'branchName', defaultContent: '-' },
                    { data: 'operationCode', defaultContent: '-' },
                    { data: 'reference', defaultContent: '-' },
                    {
                        data: 'supposedGlAccountNumber',
                        render: function (data, type, row) {
                            return data || row.supposedGlAccountName || '-';
                        }
                    },
                    {
                        data: 'fallbackBranchAccountNumber',
                        render: function (data, type, row) {
                            return data || row.fallbackBranchAccountName || '-';
                        }
                    },
                    {
                        data: 'amount',
                        render: function (v) { return (v == null) ? '-' : parseFloat(v).toFixed(2); }
                    },
                    {
                        data: 'isResolved',
                        render: function (val) {
                            return (val === true || val === 'true')
                                ? '<span class="badge bg-success">Resolved</span>'
                                : '<span class="badge bg-warning">Pending</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var rawId = String(row.id || data || '');
                            var recordId = encodeURIComponent(rawId);
                            var safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                            var btnId = 'actionDropdown_' + safeId;

                            var isResolved = row.isResolved === true || row.isResolved === 'true';

                            var viewBtn = `<button type="button" class="dropdown-item btn-view" data-id="${recordId}">
                                                            <i class="mdi mdi-eye me-1 text-primary"></i> View Details
                                                          </button>`;

                            var reconcileBtn = !isResolved ?
                                `<button type="button" class="dropdown-item btn-reconcile" data-id="${recordId}">
                                                    <i class="mdi mdi-check-circle me-1 text-success"></i> Reconcile
                                                 </button>` : '';

                            return `
                                                <div class="dropdown text-center">
                                                    <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                                            type="button" id="${btnId}"
                                                            data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="mdi mdi-cog-outline"></i> Actions
                                                    </button>
                                                    <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                                        <li>${viewBtn}</li>
                                                        ${!isResolved ? `<li><hr class="dropdown-divider"></li>` : ''}
                                                        ${!isResolved ? `<li>${reconcileBtn}</li>` : ''}
                                                    </ul>
                                                </div>
                                            `.trim();
                        }
                    }
                ],
                language: { emptyTable: 'No fallback records found' },
                lengthMenu: [10, 25, 50],
                pageLength: 10
            });
        }

        function loadFallbackData() {
            initDataTableIfNeeded();
            if (fallbackTable) {
                fallbackTable.ajax.reload(null, false);
            }
        }

        function resetFallbackFilters() {
            var form = document.getElementById('fallbackFilterForm');
            if (form) form.reset();
            if (fallbackTable) {
                fallbackTable.ajax.reload(null, false);
            } else {
                initDataTableIfNeeded();
            }
        }

        // Update the loadDetailsInModal function
        function loadDetailsInModal(id) {
            $.get('/AffiliateToBranchFallback/InitializeData', {
                KEY: id,
                partialView: '_FallbackDetails',
                path: 'details'
            }, function (data) {
                $('#detailsModalBody').html(data);

                // Re-initialize accordion behavior after loading content
                initAccordionBehavior();

                $('#detailsModal').modal('show');
            }).fail(function () {
                appalert('Failed to load details', 0, 1);
            });
        }

        // Function to handle accordion behavior
        function initAccordionBehavior() {
            // Update accordion icons based on state
            $('.collapse').on('show.bs.collapse', function () {
                $(this).prev('.card-header').find('.accordion-icon').removeClass('mdi-chevron-down').addClass('mdi-chevron-up');
            });

            $('.collapse').on('hide.bs.collapse', function () {
                $(this).prev('.card-header').find('.accordion-icon').removeClass('mdi-chevron-up').addClass('mdi-chevron-down');
            });
        }

        // ==================== EXPORT FUNCTIONS ====================
        function buildFallbackExportData(records) {
            console.log('=== BUILDING FALLBACK EXPORT DATA ===');
            console.log('Raw records received:', records);

            const exportData = records.map((record, index) => {
                // Extract data using the entity property names
                const getValue = (propNames, defaultValue = '') => {
                    for (const prop of propNames) {
                        if (record[prop] !== undefined && record[prop] !== null && record[prop] !== '') {
                            return record[prop];
                        }
                    }
                    return defaultValue;
                };

                // Handle date values properly
                const parseDate = (dateValue) => {
                    if (!dateValue) return null;
                    try {
                        if (dateValue instanceof Date) return dateValue;
                        if (typeof dateValue === 'string') {
                            const date = new Date(dateValue);
                            return isNaN(date.getTime()) ? null : date;
                        }
                        return null;
                    } catch {
                        return null;
                    }
                };

                // Handle numeric values
                const parseNumber = (numValue, defaultValue = 0) => {
                    if (numValue === undefined || numValue === null || numValue === '') return defaultValue;
                    const num = parseFloat(numValue);
                    return isNaN(num) ? defaultValue : num;
                };

                // Handle boolean values
                const parseBoolean = (boolValue) => {
                    if (boolValue === undefined || boolValue === null) return false;
                    if (typeof boolValue === 'boolean') return boolValue;
                    if (typeof boolValue === 'string') {
                        return boolValue.toLowerCase() === 'true' || boolValue === '1';
                    }
                    if (typeof boolValue === 'number') return boolValue === 1;
                    return false;
                };

                // Build the fallback record matching the C# entity
                const builtRecord = {
                    "Id": getValue(['id', 'Id'], ''),
                    "BranchId": getValue(['branchId', 'BranchId'], ''),
                    "BranchName": getValue(['branchName', 'BranchName'], ''),
                    "OperationCode": getValue(['operationCode', 'OperationCode'], ''),
                    "Reference": getValue(['reference', 'Reference'], ''),
                    "SupposedGlAccountNumber": getValue(['supposedGlAccountNumber', 'SupposedGlAccountNumber'], ''),
                    "SupposedGlAccountName": getValue(['supposedGlAccountName', 'SupposedGlAccountName'], ''),
                    "FallbackBranchAccountNumber": getValue(['fallbackBranchAccountNumber', 'FallbackBranchAccountNumber'], ''),
                    "FallbackBranchAccountName": getValue(['fallbackBranchAccountName', 'FallbackBranchAccountName'], ''),
                    "Amount": parseNumber(getValue(['amount', 'Amount'])),
                    "Status": parseBoolean(getValue(['isResolved', 'IsResolved'])) ? "Resolved" : "Pending",
                    "ResolutionTips": getValue(['resolutionTips', 'ResolutionTips'], ''),
                    "CreatedDate": parseDate(getValue(['createdDate', 'CreatedDate'])),
                    "ResolvedOn": parseDate(getValue(['resolvedOn', 'ResolvedOn'])),
                    "ResolvedBy": getValue(['resolvedBy', 'ResolvedBy'], ''),
                    "IsBranchAccountAutoCreated": parseBoolean(getValue(['isBranchAccountAutoCreated', 'IsBranchAccountAutoCreated'])),
                    "AutoCreatedStatus": parseBoolean(getValue(['isBranchAccountAutoCreated', 'IsBranchAccountAutoCreated'])) ? "Auto-Created" : "Manual",
                    "RequestedAffiliateAccountIdOrBranchCode": getValue(['requestedAffiliateAccountIdOrBranchCode', 'RequestedAffiliateAccountIdOrBranchCode'], ''),
                    "RequestedBranchAccountCode": getValue(['requestedBranchAccountCode', 'RequestedBranchAccountCode'], '')
                };

                return builtRecord;
            });

            console.log('=== FINAL FALLBACK EXPORT DATA BUILT ===');
            console.log('Total records built:', exportData.length);
            return exportData;
        }

        function setupExportModal() {
            if (!fallbackTable || currentFallbackData.length === 0) {
                appalert('Please load fallback data first by applying filters.', 3, 1);
                $('#exportModal').modal('hide');
                return;
            }

            console.log('=== SETTING UP EXPORT MODAL ===');
            console.log('Current data available for export:', currentFallbackData.length, 'records');

            $('#btnConfirmExport').off('click').on('click', function () {
                confirmExport();
            });
        }

        function confirmExport() {
            const exportFormat = $('#exportFormat').val();
            const reportType = $('#reportType').val();
            const includeStatistics = $('#includeStatistics').is(':checked');
            const fileName = $('#fileName').val() || 'Fallback_Reconciliation_Report';

            $('#exportProgress').removeClass('d-none');
            updateExportProgress(0, 'Preparing export data...');

            exportFallbackData({
                format: exportFormat,
                reportType: reportType,
                includeStatistics: includeStatistics,
                fileName: fileName
            });
        }

        function exportFallbackData(exportOptions) {
            console.log('=== EXPORTING FALLBACK DATA ===');
            console.log('Number of records to export:', currentFallbackData.length);
            console.log('Export options:', exportOptions);

            updateExportProgress(25, 'Building export data structure...');

            // Build the export data
            const manuallyBuiltData = buildFallbackExportData(currentFallbackData);

            // Build payload matching the C# entity
            const exportPayload = {
                Data: manuallyBuiltData,
                TotalRecords: manuallyBuiltData.length,
                ExportOptions: {
                    Format: exportOptions.format || 'excel',
                    ReportType: exportOptions.reportType || 'detailed',
                    IncludeStatistics: exportOptions.includeStatistics !== false,
                    FileName: exportOptions.fileName || 'Fallback_Reconciliation_Report'
                },
                Filters: collectFallbackFilters()
            };

            console.log('=== FALLBACK EXPORT PAYLOAD READY ===');
            console.log('Data records count:', exportPayload.Data.length);

            updateExportProgress(50, 'Sending data to server...');
            performFallbackExport(exportPayload, exportOptions);
        }

        function performFallbackExport(exportPayload, exportOptions) {
            console.log('=== SENDING FALLBACK DATA TO BACKEND ===');

            updateExportProgress(75, 'Generating Excel file...');

            $.ajax({
                url: '/AffiliateToBranchFallback/ExportFallbackData',
                type: 'POST',
                data: JSON.stringify(exportPayload),
                contentType: 'application/json',
                xhrFields: {
                    responseType: 'blob'
                },
                beforeSend: function () {
                    $('#btnConfirmExport').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Exporting...');
                },
                success: function (data, status, xhr) {
                    console.log('=== FALLBACK EXPORT SUCCESSFUL ===');

                    updateExportProgress(100, 'Download ready!');

                    // Get filename
                    var filename = exportPayload.ExportOptions.FileName + '_' +
                        new Date().toISOString().slice(0, 10) + '.xlsx';

                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    if (disposition && disposition.indexOf('attachment') !== -1) {
                        var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                        var matches = filenameRegex.exec(disposition);
                        if (matches != null && matches[1]) {
                            filename = matches[1].replace(/['"]/g, '');
                        }
                    }

                    // Create blob and download
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = filename;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    appalert('Excel file downloaded successfully! ' +
                        exportPayload.Data.length +
                        ' fallback records exported.', 1, 1);

                    setTimeout(function () {
                        $('#exportModal').modal('hide');
                        $('#exportProgress').addClass('d-none');
                        $('.progress-bar').css('width', '0%');
                        $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
                    }, 1000);
                },
                error: function (xhr, status, error) {
                    console.error('Fallback export error:', error);
                    console.error('Response:', xhr.responseText);

                    let errorMessage = 'Error exporting fallback data';
                    try {
                        const errorResponse = JSON.parse(xhr.responseText);
                        errorMessage = errorResponse.message || errorMessage;
                    } catch (e) {
                        errorMessage = error || errorMessage;
                    }

                    appalert(errorMessage, 4, 1);
                    $('#exportProgress').addClass('d-none');
                    $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
                }
            });
        }

        function updateExportProgress(percent, message) {
            $('#exportProgress .progress-bar').css('width', percent + '%');
            $('#progressText').text(message);
        }

        $(document).ready(function () {
            $('#applyFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                loadFallbackData();
            });

            $('#resetFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                resetFallbackFilters();
            });

            $('#fallbackFilterForm input').off('keypress').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadFallbackData();
                }
            });

            // View details in modal
            $(document).off('click', '.btn-view').on('click', '.btn-view', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                if (!id) { appalert('Missing id for details', 0, 1); return; }

                loadDetailsInModal(id);
            });

            // Reconcile
            $(document).off('click', '.btn-reconcile').on('click', '.btn-reconcile', function (e) {
                e.preventDefault();
                var raw = $(this).data('id');
                var id = raw ? decodeURIComponent(raw) : null;
                if (!id) { appalert('Missing id for reconciliation', 0, 1); return; }

                AddORUpdateGen(id, 'datalistingview', '_ReconcileFallback', 'get', 'AffiliateToBranchFallback', 'reconcile');
            });

            // Back to list
            $(document).off('click', '.btn-back-to-list').on('click', '.btn-back-to-list', function (e) {
                e.preventDefault();
                AddORUpdateGen(null, 'datalistingview', '_FallbackDataTable', 'get', 'AffiliateToBranchFallback');
            });

            // Export button click
            $('#btnExportFallback').off('click').on('click', function (e) {
                e.preventDefault();
                console.log('Fallback export button clicked');

                if (!fallbackTable) {
                    appalert('Please load fallback data first by applying filters.', 3, 1);
                    return;
                }

                const recordCount = currentFallbackData.length;
                if (recordCount === 0) {
                    appalert('No data available to export. Please apply filters to load data first.', 3, 1);
                    return;
                }

                console.log(`Exporting ${recordCount} fallback records`);
                $('#exportModal').modal('show');
            });

            // Export modal events
            $('#exportModal').on('show.bs.modal', function () {
                console.log('Export modal opening...');
                setupExportModal();
            });

            $('#exportModal').on('hidden.bs.modal', function () {
                console.log('Export modal closed');
                $('#exportProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
                $('#btnConfirmExport').prop('disabled', false).html('<i class="mdi mdi-export me-1"></i> Export');
            });

            initAccordionBehavior();
        });
    </script>
}