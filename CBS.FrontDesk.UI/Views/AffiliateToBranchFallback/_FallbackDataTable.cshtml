@using Resources

<div class="table-responsive">
    <table id="fallbackDataTable" class="table table-striped table-bordered table-hover w-100">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.CreatedDate</th>
                <th>@GlobalShared.Branch</th>
                <th>@GlobalShared.Operation_Code</th>
                <th>@GlobalShared.Reference</th>
                <th>Supposed GL</th>
                <th>Fallback GL</th>
                <th>@GlobalShared.Amount</th>
                <th>@GlobalShared.Status</th>
                <th>@GlobalShared.Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- Data will be loaded by DataTables -->
        </tbody>
    </table>
</div>
