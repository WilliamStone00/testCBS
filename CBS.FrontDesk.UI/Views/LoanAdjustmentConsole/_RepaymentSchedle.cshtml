@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>Repayment Schedule</legend>
    <hr style="border: 2px solid green;" />
    @if (Model.LoanAmortizations.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalLoan.no_repayment_schedule_generated_for @Model.IndividualCustomer.CustomerList.name</p>
        </div>
    }
    else
    {

        @*decimal totalRefunds = Model.LoanAmortizations.Sum(r => r.Amount);
            decimal totalCapital = Model.LoanAmount;
            decimal totalInterest = Model.LoanAmortizations.Sum(r => r.Interest);
            decimal totalTax = Model.LoanAmortizations.Sum(r => r.TaxPaid);
            decimal totalFines = Model.LoanAmortizations.Sum(r => r.PenaltyPaid);
            decimal totalBalance = Model.Balance;

            <hr style="border: 2px solid green;" />
            <div class="card-body d-flex justify-content-between flex-wrap gap-4">
                <div class="d-flex gap-4" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalCapital.ToString("#,##0.0")</h4>
                        <small>Capital</small>
                    </div>
                </div>
                <div class="d-flex gap-4" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalRefunds.ToString("#,##0.0")</h4>
                        <small>Total paid</small>
                    </div>
                </div>
                <div class="d-flex gap-4" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalBalance.ToString("#,##0.0")</h4>
                        <small>Balance</small>
                    </div>
                </div>
            </div>

            <div class="card-body d-flex justify-content-between flex-wrap gap-3">
                <div class="d-flex gap-12" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalCapital.ToString("#,##0.0")</h4>
                        <small>Capital</small>
                    </div>
                </div>
                <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-warning rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalInterest.ToString("#,##0.0")</h4>
                        <small>Interest</small>
                    </div>
                </div>
                <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-info rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalTax.ToString("#,##0.0")</h4>
                        <small>VAT</small>
                    </div>
                </div>
                <div class="d-flex gap-3" style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <i class="mdi mdi-currency-usd mdi-24px"></i>
                        </div>
                    </div>
                    <div class="card-info">
                        <h4 class="mb-0">@totalFines.ToString("#,##0.0")</h4>
                        <small>Fines</small>
                    </div>
                </div>
            </div>
            <hr style="border: 2px solid green;" />*@

        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%">SN</th>
                        <th style="width: 10%">@GlobalShared.Date</th>
                        <th style="width: 15%">@GlobalShared.Description</th>
                        <th style="width: 10%">@GlobalShared.Principal</th>
                        <th style="width: 10%">@GlobalShared.Interest</th>
                        <th style="width: 10%">@GlobalShared.VAT</th>
                        <th style="width: 10%">@GlobalShared.Penalty</th>
                        <th style="width: 10%">@GlobalShared.Paid</th>
                        <th style="width: 10%">@GlobalShared.Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- First Additional Row -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">@GlobalShared.Principal:</td>
                        <td colspan="6">@Model.Principal.ToString("#,##0.0")</td>
                    </tr>
                    <!-- Second Additional Row -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">@GlobalShared.Date:</td>
                        <td colspan="6">@DateTime.Now.ToShortDateString()</td>
                    </tr>
                    @foreach (var d in Model.LoanAmortizations.OrderBy(app => app.Sno))
                    {
                        <tr>
                            <td>@d.Sno</td>
                            <td>@d.NextPaymentDate.ToShortDateString()</td>
                            <td>@d.Description</td>
                            <td>@d.Principal.ToString("#,##0.0")</td>
                            <td>@d.Interest.ToString("#,##0.0")</td>
                            <td>@d.Tax.ToString("#,##0.0")</td>
                            <td>@d.Penalty.ToString("#,##0.0")</td>
                            <td>@d.Paid.ToString("#,##0.0")</td>
                            <td>@d.Due.ToString("#,##0.0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Total:</td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Interest).ToString("#,##0.0")</td>
                        <td colspan="2"></td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Paid).ToString("#,##0.0")</td>
                        <td>@Model.LoanAmortizations.Sum(x => x.Due).ToString("#,##0.0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</fieldset>
