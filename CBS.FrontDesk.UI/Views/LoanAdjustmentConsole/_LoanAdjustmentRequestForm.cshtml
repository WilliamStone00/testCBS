@model CBS.FrontDesk.Data.LoanAdjustmentP.LoanAdjustmentRequestDto
@using Resources
@using (Html.BeginForm("SubmitAdjustment", "LoanAdjustmentConsole", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateResetLoanValue(this);" }))

{

    <!-- Hidden inputs filled by script -->
    <input type="hidden" id="LoanId" name="LoanId" />
    <input type="hidden" id="CustomerId" name="CustomerId" />
    <input type="hidden" id="BranchId" name="BranchId" />

    <div class="px-4">

        <!-- SECTION: OLD LOAN DATA -->
        <!-- 📊 Financial Fields -->
        <fieldset class="border rounded-3 p-3 mb-3">
            <legend class="float-none w-auto px-2 text-primary fw-bold small">💰  @GlobalShared.financial_fields</legend>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Loan_Amount</label>
                    <input type="text" id="oldLoanAmountLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Balance</label>
                    <input type="text" id="oldBalanceLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Interest</label>
                    <input type="text" id="oldInterestLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.VAT</label>
                    <input type="text" id="oldVatLabel" class="form-control bg-light text-danger" readonly />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Penalty</label>
                    <input type="text" id="oldPenaltyLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Due_Amount</label>
                    <input type="text" id="oldDueAmountLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Interest_Rate %</label>
                    <input type="text" id="oldIntRateLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Vat_rate %</label>
                    <input type="text" id="oldVatRateLabel" class="form-control bg-light text-danger" readonly />
                </div>
            </div>
        </fieldset>

        <!-- 🕒 Status Fields -->
        <fieldset class="border rounded-3 p-3">
            <legend class="float-none w-auto px-2 text-secondary fw-bold small">📅  @GlobalShared.Status & @GlobalShared.timeline_fields</legend>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Loan_Date</label>
                    <input type="text" id="oldLoanDateLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.disbursement_date</label>
                    <input type="text" id="oldDisbursementDateLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Loan_Status</label>
                    <input type="text" id="oldLoanStatusLabel" class="form-control bg-light text-danger" readonly />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalLoanAdjustmentConsole.next_installment_date</label>
                    <input type="text" id="oldNextInstallmentLabel" class="form-control bg-light text-danger" readonly />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold"> @GlobalShared.Total_Amount_Paid</label>
                    <input type="text" id="oldPaidLabel" class="form-control bg-light text-danger" readonly />
                </div>
            </div>
        </fieldset>



        <!-- SECTION: NEW OVERRIDE INPUTS -->
       
            <fieldset class="border rounded-3 p-3 mb-3">
                <legend class="float-none w-auto px-2 text-primary fw-bold small"> ✏️  @GlobalLoanAdjustmentConsole.override_with_new_values</legend>
                <!-- 🔹 Row 1: Loan Amount, Balance, Interest, VAT -->
                <div class="row">
                    <div class="col-md-3 mb-2">
                        @Html.LabelFor(m => m.NewLoanAmount, $"{@GlobalShared.Loan_Amount}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewLoanAmount, new { @class = "form-control", type = "number", step = "0.01", id = "NewLoanAmount" })
                        @Html.ValidationMessageFor(m => m.NewLoanAmount, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 mb-2">
                        @Html.LabelFor(m => m.NewBalance, $" {@GlobalShared.Balance}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewBalance, new { @class = "form-control", type = "number", step = "0.01", id = "NewBalance" })
                        @Html.ValidationMessageFor(m => m.NewBalance, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 mb-2">
                        @Html.LabelFor(m => m.NewInterest, $"{@GlobalShared.Interest}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewInterest, new { @class = "form-control", type = "number", step = "0.01", id = "NewInterest" })
                        @Html.ValidationMessageFor(m => m.NewInterest, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 mb-2">
                        @Html.LabelFor(m => m.NewVat, $"{@GlobalShared.VAT}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewVat, new { @class = "form-control", type = "number", step = "0.01", id = "NewVat" })
                        @Html.ValidationMessageFor(m => m.NewVat, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- 🔹 Row 2: Penalty, Due Amount, Int Rate, VAT Rate -->
                <div class="row">
                    <!-- Penalty -->
                    <div class="col-md-4 mb-2">
                        @Html.LabelFor(m => m.NewPenalty, $"{@GlobalShared.Penalty}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewPenalty, new { @class = "form-control", type = "number", step = "0.01", id = "NewPenalty", placeholder = "Penalty Amount" })
                        @Html.ValidationMessageFor(m => m.NewPenalty, "", new { @class = "text-danger" })
                    </div>

                    <!-- Interest Rate -->
                    <div class="col-md-4 mb-2">
                        @Html.LabelFor(m => m.NewIntRate, $"{@GlobalShared.Interest_Rate} %", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewIntRate, new { @class = "form-control", type = "number", step = "0.01", id = "NewIntRate", placeholder = "e.g. 2.5" })
                        @Html.ValidationMessageFor(m => m.NewIntRate, "", new { @class = "text-danger" })
                    </div>

                    <!-- VAT Rate -->
                    <div class="col-md-4 mb-2">
                        @Html.LabelFor(m => m.NewVatRate, $"{@GlobalShared.Vat_rate} %", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewVatRate, new { @class = "form-control", type = "number", step = "0.01", id = "NewVatRate", placeholder = "e.g. 19.25" })
                        @Html.ValidationMessageFor(m => m.NewVatRate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        @Html.LabelFor(m => m.NewLoanDate, $"{@GlobalShared.Loan_Date}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewLoanDate, new { @class = "form-control", type = "date", id = "NewLoanDate" })
                    </div>

                    <div class="col-md-3 mb-3">
                        @Html.LabelFor(m => m.NewDisbursementDate, $"{@GlobalShared.disbursement_date}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewDisbursementDate, new { @class = "form-control", type = "date", id = "NewDisbursementDate" })
                    </div>

                    <div class="col-md-3 mb-3">
                        @Html.LabelFor(m => m.NewLoanStatus, $"{@GlobalShared.Loan_Status}", new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.NewLoanStatus, new SelectList(
                            new[] {
                                new { Value = "Open", Text = $"{@GlobalShared.Open}" },
                                new { Value = "Closed", Text = $"{@GlobalShared.Closed}" },
                                new { Value = "Refinanced", Text = $"{@GlobalShared.Refinanced}" },
                                new { Value = "Pending", Text = $"{@GlobalShared.Pending}" }
                            }, "Value", "Text"),
                            $"-- {@GlobalShared.Select_status} --", new { @class = "form-control", id = "NewLoanStatus" })
                        @Html.ValidationMessageFor(m => m.NewLoanStatus, "", new { @class = "text-danger" })
                    </div>


                    <div class="col-md-3 mb-3">
                        @Html.LabelFor(m => m.NewNextInstallmentDate, $"{@GlobalShared.next_installment_date}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewNextInstallmentDate, new { @class = "form-control", type = "date", id = "NewNextInstallmentDate" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        @Html.LabelFor(m => m.NewPaid, $"{@GlobalShared.Total_Amount_Paid}", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NewPaid, new { @class = "form-control", type = "number", step = "0.01", id = "NewPaid" })
                    </div>
                </div>

                <!-- 🔹 Second Row: Due Amount only -->
                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label for="newDueAmount" class="form-label fw-bold"> @GlobalShared.Due_Amount</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.NewDueAmount, new { @class = "form-control", type = "number", step = "0.01", id = "newDueAmount", placeholder = "Total Due" })
                            <span class="input-group-text bg-light">FCFA</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.NewDueAmount, "", new { @class = "text-danger" })

                        <small class="text-muted mt-1 d-block">
                            💰 <strong> @GlobalShared.formatted:</strong> <span id="dueAmountFormatted">0.00</span>
                        </small>
                    </div>
                </div>

                <!-- Reason (leave as is) -->
                <div class="mb-1">
                    @Html.LabelFor(m => m.Reason, $"{@GlobalLoanAdjustmentConsole.reason_for_adjustment}", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "4",
                        placeholder = $"{@GlobalLoanAdjustmentConsole.provide_a_detailed_reason_for_this_manual_adjustment_or_waiver}...",
                        id = "Reason"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
                </div>

                <div class="text-end mt-3">
                    <button type="submit" id="submitRequestBtn" class="btn btn-primary" disabled>
                        <i class="bi bi-send"></i>  @GlobalLoanAdjustmentConsole.submit_adjustment_request
                    </button>

                </div>
            </fieldset>
</div>
}
