@{
    ViewBag.Title = "Loan Adjustment Console";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-tune-variant me-2"></i> @GlobalLoanAdjustmentConsole.loan_adjustment_console
                </h1>
                <p class="card-text text-muted mb-1">
                    @GlobalLoanAdjustmentConsole.review_approve_and_track_loan_adjustment_requests_across_branches.
                </p>
                <p class="card-text text-warning fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                    @GlobalLoanAdjustmentConsole.use_filters_to_narrow_down_pending_or_processed_requests.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 💡 Tips Section -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-info">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> @GlobalLoanAdjustmentConsole.tips_for_using_the_adjustment_console</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>@GlobalShared.Loan ID or Customer ID:</strong> @GlobalLoanAdjustmentConsole.filter_specific_requests_quickly.</li>
                <li><i class="mdi mdi-bank-outline text-success me-2"></i> <strong>@GlobalShared.Branch Filter:</strong> @GlobalLoanAdjustmentConsole.view_requests_from_specific_branches.</li>
                <li><i class="mdi mdi-calendar-range-outline text-warning me-2"></i> <strong>@GlobalShared.Date Range:</strong> @GlobalLoanAdjustmentConsole.narrow_down_requests_by_request_date.</li>
                <li><i class="mdi mdi-account-check-outline text-info me-2"></i> <strong>@GlobalShared.requested / @GlobalShared.Approved_by:</strong> @GlobalLoanAdjustmentConsole.track_who_initiated_or_approved_changes.</li>
                <li><i class="mdi mdi-file-check-outline text-danger me-2"></i> <strong>@GlobalShared.Status:</strong> @GlobalLoanAdjustmentConsole.easily_separate_pending_approved_or_rejected_entries.</li>
                <li><i class="mdi mdi-export-variant text-success me-2"></i> <strong>@GlobalShared.Export:</strong> @GlobalLoanAdjustmentConsole.use_the_export_button_to_download_your_current_view.</li>
            </ul>
        </div>
    </div>
</div>

<!-- 🔍 Filter Panel -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i> @GlobalLoanAdjustmentConsole.adjustment_request_filters</h5>

    <div class="card p-3 mb-2 bg-light">
        <!-- Toggle Checkboxes -->
        <div class="row mb-1">
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleBranch" />
                <label class="form-check-label fw-bold" for="toggleBranch">@GlobalShared.Filter_by_Branch</label>
            </div>
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleDate" />
                <label class="form-check-label fw-bold" for="toggleDate">@GlobalShared.Filter_by_Date_Range</label>
            </div>
        </div>

        <!-- Branch Filter -->
        <div id="branchFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-12 mb-1">
                <label for="branchId" class="form-label fw-bold">@GlobalShared.Branch</label>
                @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-select select2", @id = "branchId" })
            </div>
        </div>

        <!-- Date Range Filter -->
        <div id="dateFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-6 mb-1">
                <label for="startDate" class="form-label fw-bold">@GlobalShared.Start_Date</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="endDate" class="form-label fw-bold">@GlobalShared.End_Date</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>

        <!-- Other Filters -->

        <div class="row mb-1">
            <div class="col-md-4 mb-1">
                <label for="loanId" class="form-label fw-bold">@GlobalShared.Loan_ID</label>
                <input type="text" id="loanId" class="form-control" placeholder="@GlobalShared.enter_loan_id" />
            </div>
            <div class="col-md-4 mb-1">
                <label for="customerId" class="form-label fw-bold">@GlobalShared.Customer_ID</label>
                <input type="text" id="customerId" class="form-control" placeholder="@GlobalShared.Member_account_number/@GlobalShared.Reference" />
            </div>
            <div class="col-md-4 mb-1">
                <label for="status" class="form-label fw-bold">Status</label>
                <select id="status" class="form-select">
                    <option value="">@GlobalShared.All</option>
                    <option value="Pending">@GlobalShared.Pending</option>
                    <option value="Approved">@GlobalShared.Approved</option>
                    <option value="Rejected">@GlobalShared.Rejected</option>
                </select>
            </div>

        </div>
        <div class="row mb-1">
            <div class="col-md-6 mb-1">
                <label for="requestedBy" class="form-label fw-bold">@GlobalShared.Requested_by</label>
                <input type="text" id="requestedBy" class="form-control" placeholder="Requested By" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="approvedBy" class="form-label fw-bold">@GlobalShared.Approved_by</label>
                <input type="text" id="approvedBy" class="form-control" placeholder="Approved By" />
            </div>
        </div>

    </div>

    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
            </button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100">
                <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
            </button>
        </div>
    </div>
</div>

<!-- 📋 Adjustment Requests Table -->
<div class="card shadow-sm p-3" id="loanAdjustmentTableContainer">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalShared.adjustment_requests</h5>
    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.requested_at</th>
                    <th>@GlobalShared.Member_name</th>
                    <th>M. AccNo</th>
                    <th>@GlobalShared.old_balance</th>
                    <th>@GlobalShared.New_Balance</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    @Html.Partial("_LoanAdjustmentDetailModal")
</div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanAdjustmentConsole/LoanAdjustmentConsole.js"></script>


}
