@{
    ViewBag.Title = "Loan Adjustment Console";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-tune-variant me-2"></i> Loan Adjustment Console
                </h1>
                <p class="card-text text-muted mb-1">
                    Review, approve, and track loan adjustment requests across branches.
                </p>
                <p class="card-text text-warning fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                    Use filters to narrow down pending or processed requests.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 💡 Tips Section -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-info">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips for Using the Adjustment Console</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>Loan ID or Customer ID:</strong> Filter specific requests quickly.</li>
                <li><i class="mdi mdi-bank-outline text-success me-2"></i> <strong>Branch Filter:</strong> View requests from specific branches.</li>
                <li><i class="mdi mdi-calendar-range-outline text-warning me-2"></i> <strong>Date Range:</strong> Narrow down requests by request date.</li>
                <li><i class="mdi mdi-account-check-outline text-info me-2"></i> <strong>Requested / Approved By:</strong> Track who initiated or approved changes.</li>
                <li><i class="mdi mdi-file-check-outline text-danger me-2"></i> <strong>Status:</strong> Easily separate pending, approved, or rejected entries.</li>
                <li><i class="mdi mdi-export-variant text-success me-2"></i> <strong>Export:</strong> Use the export button to download your current view.</li>
            </ul>
        </div>
    </div>
</div>

<!-- 🔍 Filter Panel -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i> Adjustment Request Filters</h5>

    <div class="card p-3 mb-2 bg-light">
        <!-- Toggle Checkboxes -->
        <div class="row mb-1">
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleBranch" />
                <label class="form-check-label fw-bold" for="toggleBranch">Filter by Branch</label>
            </div>
            <div class="col-md-6 form-check mb-1">
                <input class="form-check-input" type="checkbox" id="toggleDate" />
                <label class="form-check-label fw-bold" for="toggleDate">Filter by Date Range</label>
            </div>
        </div>

        <!-- Branch Filter -->
        <div id="branchFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-12 mb-1">
                <label for="branchId" class="form-label fw-bold">Branch</label>
                @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-select select2", @id = "branchId" })
            </div>
        </div>

        <!-- Date Range Filter -->
        <div id="dateFilterGroup" class="row mb-2" style="display:none;">
            <div class="col-md-6 mb-1">
                <label for="startDate" class="form-label fw-bold">Start Date</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="endDate" class="form-label fw-bold">End Date</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>

        <!-- Other Filters -->

        <div class="row mb-1">
            <div class="col-md-4 mb-1">
                <label for="loanId" class="form-label fw-bold">Loan ID</label>
                <input type="text" id="loanId" class="form-control" placeholder="Enter Loan ID" />
            </div>
            <div class="col-md-4 mb-1">
                <label for="customerId" class="form-label fw-bold">Customer ID</label>
                <input type="text" id="customerId" class="form-control" placeholder="Enter member account number/refernce" />
            </div>
            <div class="col-md-4 mb-1">
                <label for="status" class="form-label fw-bold">Status</label>
                <select id="status" class="form-select">
                    <option value="">All</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>

        </div>
        <div class="row mb-1">
            <div class="col-md-6 mb-1">
                <label for="requestedBy" class="form-label fw-bold">Requested By</label>
                <input type="text" id="requestedBy" class="form-control" placeholder="Requested By" />
            </div>
            <div class="col-md-6 mb-1">
                <label for="approvedBy" class="form-label fw-bold">Approved By</label>
                <input type="text" id="approvedBy" class="form-control" placeholder="Approved By" />
            </div>
        </div>

    </div>

    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> Apply Filter
            </button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100">
                <i class="mdi mdi-refresh"></i> Reset
            </button>
        </div>
    </div>
</div>

<!-- 📋 Adjustment Requests Table -->
<div class="card shadow-sm p-3" id="loanAdjustmentTableContainer">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> Adjustment Requests</h5>
    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Requested At</th>
                    <th>Member Name</th>
                    <th>M. AccNo</th>
                    <th>Old Balance</th>
                    <th>New Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    @Html.Partial("_LoanAdjustmentDetailModal")
</div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanAdjustmentConsole/LoanAdjustmentConsole.js"></script>


}
