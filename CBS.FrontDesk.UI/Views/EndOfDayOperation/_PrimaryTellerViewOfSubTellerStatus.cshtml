@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
<div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

    <div id="accordionPopoutIconxx" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconxThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIconx-3">
                    <i class="mdi mdi-update me-2"></i>
                    Details of operations of @Model.SubTellerProvioningHistory.teller.name for the selected date @Model.SubTellerProvioningHistory.openedDate

                </button>
            </h2>
            <div id="accordionPopoutIconx-3"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewChange">
                        <div class="change-group">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th colspan="2" class="separation-text"><h5 class="card-title">CLOSE OF DAY DETAILS</h5></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Opened date:</strong></td>
                                        <td><span id="calculatedBalance">@Model.SubTellerProvioningHistory.openedDate</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Open of day amount:</strong></td>
                                        <td><span id="notes10000Required">@Model.SubTellerProvioningHistory.openOfDayAmount</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Replenished amount:</strong></td>
                                        <td><span id="notes5000Required">@Model.SubTellerProvioningHistory.ReplenishedAmount</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Close of day amount:</strong></td>
                                        <td><span id="notes2000Required">@Model.SubTellerProvioningHistory.cashAtHand</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Teller account balance:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.tellerAccountBalance</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>System balance:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.accountBalance</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Closed date:</strong></td>
                                        <td><span id="notes1000Required">@Model.SubTellerProvioningHistory.clossedDate</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Closed status:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.clossedStatus</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Primary teller confirmation:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.primaryTellerConfirmationStatus</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Primary teller comentary:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.primaryTellerComment</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Teller Name:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.teller.name</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Teller User:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.teller.inUsedByUserId</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Sub teller commentary:</strong></td>
                                        <td><span id="notes500Required">@Model.SubTellerProvioningHistory.subTellerComment</span></td>
                                    </tr>
                                </tbody>
                            </table>


                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxTwo">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-2"
                        aria-controls="accordionPopoutIconx-2">
                    <i class="mdi mdi-details me-2"></i>
                    Confirmation the operations of @Model.SubTellerProvioningHistory.teller.name for the selected date @Model.SubTellerProvioningHistory.openedDate
                </button>
            </h2>
            <div id="accordionPopoutIconx-2"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewReset">
                        <div class="reset-group">


                            @using (Html.BeginForm("SubtellerVerification", "EndOfDayOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                @Html.HiddenFor(model => model.EndOfDayBySubTellerIDCommand.subTellerProvioningHistoryID)
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.EndOfDayBySubTellerIDCommand.primaryTellerConfirmationStatus, new SelectList(ViewBag.Statuses, "Text", "Value"), "---Select status type---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.EndOfDayBySubTellerIDCommand.primaryTellerConfirmationStatus, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Confirmation status</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.EndOfDayBySubTellerIDCommand.comment, new { @class = "form-control", @style = "height: 75px;" })
                                            @Html.ValidationMessageFor(m => m.EndOfDayBySubTellerIDCommand.comment, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Teller close of day note</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Confirm subteller operations</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxOne">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-1"
                        aria-controls="accordionPopoutIconx-1">
                    <i class="mdi mdi-two-factor-authentication me-2"></i>
                    Transactions
                </button>
            </h2>

            <div id="accordionPopoutIconx-1"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainview_mfa">
                        <div class="reset-group">
                            <div class="card mb-4">
                                <div class="card-body d-sm-flex d-block">
                                    <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                        <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="ExportFile('EndOfDayOperation', null,'GetReport', @Model.EndOfDayBySubTellerIDCommand.subTellerProvioningHistoryID, 'List', 'export_tellers_transactions', null,'@Model.SubTellerProvioningHistory.teller.name','DownloadExcelFile',null,'@Model.SubTellerProvioningHistory.teller.name')" data-bs-toggle="tooltip" title="Export teller transactions">
                                            <span class="tf-icons mdi mdi-printer mdi-18px"></span>
                                        </a>
                                    </div>
                                </div>

                            </div>
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Debit</th>
                                            <th>Credit</th>
                                            <th>Charges</th>
                                            <th>O.Amount</th>
                                            <th>Previous balance</th>
                                            <th>Balance</th>
                                            <th>Fee type</th>
                                            <th>Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var orderedTransactions = Model.TransactionHistories.OrderBy(d => d.CreatedDate);
                                        }

                                        @if (orderedTransactions != null)
                                        {
                                            foreach (var d in orderedTransactions)
                                            {
                                                <tr>
                                                    <td style="width: 20%">@d.CreatedDate</td>
                                                    <td style="width: 10%">@d.Debit</td>
                                                    <td style="width: 10%">@d.Credit</td>
                                                    <td style="width: 10%">@d.Fee</td>
                                                    <td style="width: 10%">@d.OriginalDepositAmount</td>
                                                    <td style="width: 10%">@d.PreviousBalance</td>
                                                    <td style="width: 10%">@d.Balance</td>
                                                    <td style="width: 10%">@d.FeeType</td>
                                                    <td style="width: 10%">@d.Operation</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center my-3">
                                                <p>No Data was found.</p>
                                            </div>
                                        }

                                    </tbody>
                                    @*<tfoot>
                                            <tr>
                                                <td colspan="6"></td>
                                                <td>
                                                    <strong>Balance:</strong>
                                                    @if (Model.TransactionHistories.Any())
                                                    {
                                                        var totalBalance = Model.TransactionHistories.Sum(d => d.amount);
                                                        @totalBalance
                                                    }
                                                    else
                                                    {
                                                        <label>0</label>
                                                    }
                                                </td>
                                                <td colspan="3"></td>
                                            </tr>
                                        </tfoot>*@
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
