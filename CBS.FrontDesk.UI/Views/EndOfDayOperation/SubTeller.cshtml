@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
@{
    ViewBag.Title = "CLOSE OF DAY S.T";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> Closing of Sub-Till
                </h1>
                <p class="card-text text-muted">
                    Ensure all transactions are properly accounted for before closing the sub-till. This process is essential for accurate reconciliation and end-of-day reporting.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                Follow these steps to ensure a successful sub-till closure:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Verify all transactions for the day are accounted for in the sub-till.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure all balances match the expected totals.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Generate the necessary reports for reconciliation.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Confirm any discrepancies are resolved before proceeding.</li>
            </ul>
            <p class="text-muted mb-2">
                Additional notes:
            </p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Make sure to <strong>print your Close of Day report</strong> after completing the process.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> If the <strong>Close of Day button is greyed out</strong>, ensure all conditions for closure are met.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            Closing of Sub-Till
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_CloseOfDayForm")
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("EndOfDayOperation", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
