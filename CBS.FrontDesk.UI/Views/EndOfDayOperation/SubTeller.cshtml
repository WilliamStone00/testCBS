@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
    @using Resources
@{
    ViewBag.Title = @GlobalEndOfDayOperation.CLOSE_OF_DAY_ST;
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @GlobalEndOfDayOperation.ClosingOfSubTill
                </h1>
                <p class="card-text text-muted">
                    @GlobalEndOfDayOperation.EnsureAllTransactionsAreProperlyAccounted.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalShared.HELP_TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                @GlobalEndOfDayOperation.FollowTheseStepsToEnsureASuccessfulSubTillClosure:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalEndOfDayOperation.VerifyAllTransactionsForTheDayAreAccounted.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalEndOfDayOperation.EnsureAllBalancesMatchTheExpectedTotals.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalEndOfDayOperation.GenerateTheNecessaryReportsForReconciliation.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalEndOfDayOperation.ConfirmAnyDiscrepanciesAreResolvedBeforeProceeding.</li>
            </ul>
            <p class="text-muted mb-2">
                @GlobalShared.Additional_Notes:
            </p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalEndOfDayOperation.MakeSureTo <strong>@GlobalEndOfDayOperation.printYourCloseOfDayReport</strong> @GlobalEndOfDayOperation.AfterCompletingTheProcess.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> @GlobalEndOfDayOperation.IfThe <strong>@GlobalEndOfDayOperation.CloseOfDaButtonIsGreyedOut</strong>, @GlobalEndOfDayOperation.ensureAllConditionsForClosureAreMet.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            @GlobalEndOfDayOperation.ClosingOfSubTill
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_CloseOfDayForm")
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("EndOfDayOperation", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
