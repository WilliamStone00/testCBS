@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
@{
    ViewBag.Title = "CLOSE OF DAY Main-Till";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-Main">
                    <i class="mdi mdi-cash-multiple me-2"></i> Closing of Main-Till
                </h1>
                <p class="card-text text-muted">
                    Manage the closing process of the Main till efficiently. Ensure all subtills in the branch have been closed before proceeding.
                </p>
                <p class="card-text text-danger fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    Note: Main tills cannot be closed unless all sub-tills in the branch are closed.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-Main">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                Follow these steps to ensure a smooth closing of the Main till:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Verify that all sub-tills under the same branch have been closed.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure all transactions for the day are accounted for before closing.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Generate and save necessary reports.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Confirm the total balance matches the expected amount.</li>
            </ul>
            <p class="text-muted">Additional notes:</p>
            <ul>
                <li><i class="mdi mdi-information-outline text-Main me-2"></i> If the <strong>Close of Day button is greyed out</strong>, ensure all sub-tills are closed.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> Make sure to <strong>print your End of Day report</strong> after completing the process.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            Closing of Main-Till
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_CloseOfDayForm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function Reprint() {
            ReportView("EndOfDayOperation", null, "GetReportReport", null, null, null, "ReportParameterLess");
        }
    </script>
}
