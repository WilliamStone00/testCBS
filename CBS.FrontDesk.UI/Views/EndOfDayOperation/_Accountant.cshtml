@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
@using Resources


<div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

    <div id="accordionPopoutIconxx" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconxThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIconx-3">
                    <i class="mdi mdi-update me-2"></i>
                    @GlobalEndOfDayOperation.DetailsOfOperationsOf @Model.PrimaryTellerProvisioningHistory.teller.name @GlobalEndOfDayOperation.ForTheSelectedDate @Model.PrimaryTellerProvisioningHistory.openedDate
                </button>
            </h2>
            <div id="accordionPopoutIconx-3"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewChange">
                        <div class="change-group">

                            <div class="row mt-2 gy-4">
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openOfDayAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalEndOfDayOperation.OpenOfDayAmount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openedDate, new { @class = "form-control date-picker", @placeholder = GlobalShared.OperationDate })
                                        <label>@GlobalShared.OpenedDate</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.cashReplenishmentAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalEndOfDayOperation.ReplenishedAmount</label>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.cashAtHand, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalShared.CashAtHand</label>
                                    </div>
                                </div> <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.clossedDate, new { @class = "form-control date-picker", @placeholder = GlobalShared.OperationDate })
                                        <label>@GlobalShared.DateToClose</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.accountBalance, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalShared.SystemDifference</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.clossedStatus, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalEndOfDayOperation.CloseOfDayStatus</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.accountantConfirmationStatus, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalShared.ValidationStatus</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.PrimaryTellerProvisioningHistory.primaryTellerComment, new { @class = "form-control", @style = "height: 75px;" })
                                        <label for="formValidationDob">@GlobalShared.TellerNote</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.PrimaryTellerProvisioningHistory.accountantComment, new { @class = "form-control", @style = "height: 75px;" })
                                        <label for="formValidationDob">@GlobalEndOfDayOperation.AccountantNote</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxTwo">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-2"
                        aria-controls="accordionPopoutIconx-2">
                    <i class="mdi mdi-details me-2"></i>
                    @GlobalEndOfDayOperation.CloseOperationsOf @Model.PrimaryTellerProvisioningHistory.teller.name @GlobalEndOfDayOperation.ForTheSelectedDate @Model.PrimaryTellerProvisioningHistory.openedDate
                </button>
            </h2>
            <div id="accordionPopoutIconx-2"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewReset">
                        <div class="reset-group">
                            @using (Html.BeginForm("Accountant", "EndOfDayOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {@Html.HiddenFor(model => model.EndOfDayAccountantCommand.primaryTellerProvioningHistoryID)
                            <div class="row mt-2 gy-4">
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openOfDayAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalEndOfDayOperation.OpenOfDayAmount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openedDate, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">@GlobalEndOfDayOperation.OpenOfDayDate</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayAccountantCommand.amountRecieved, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayAccountantCommand.amountRecieved, "", new { @class = "text-danger" })
                                        <label style="color:blue">@GlobalEndOfDayOperation.EnterAmountCollected</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.EndOfDayAccountantCommand.accountantConfirmationStatus, new SelectList(ViewBag.Statuses, "Text", "Value"), "---"+ @GlobalEndOfDayOperation.SelectConfirmationStatusType + "---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayAccountantCommand.accountantConfirmationStatus, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">@GlobalShared.ConfirmationStatus</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.EndOfDayAccountantCommand.eodClosedStatus, new SelectList(ViewBag.ClosedStatus, "Text", "Value"), "---"+ @GlobalEndOfDayOperation.SelectClosedStatusType + "---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayAccountantCommand.eodClosedStatus, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">@GlobalShared.ClosedStatus</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.EndOfDayAccountantCommand.comment, new { @class = "form-control", @style = "height: 75px;" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayAccountantCommand.comment, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">@GlobalEndOfDayOperation.AccountantNote</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Close day @Model.PrimaryTellerProvisioningHistory.openedDate</button>
                            </div>
                        }


                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxOne">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-1"
                        aria-controls="accordionPopoutIconx-1">
                    <i class="mdi mdi-two-factor-authentication me-2"></i>
                    @GlobalShared.Transactions
                </button>
            </h2>

            <div id="accordionPopoutIconx-1"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainview_mfa">
                        <div class="reset-group">
                            <div class="card mb-4">
                                <div class="card-body d-sm-flex d-block">
                                    <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                        <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="ExportFile('EndOfDayOperation', null,'GetReport', @Model.PrimaryTellerProvisioningHistory.id, 'List', 'export_tellers_transactions', null,'@Model.PrimaryTellerProvisioningHistory.teller.name','DownloadExcelFile',null,'@Model.PrimaryTellerProvisioningHistory.teller.name')" data-bs-toggle="tooltip" title="@GlobalEndOfDayOperation.ExportTellerTransactions">
                                            <span class="tf-icons mdi mdi-printer mdi-18px"></span>
                                        </a>
                                    </div>
                                </div>

                            </div>
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalShared.Date</th>
                                            <th>@GlobalShared.Debit</th>
                                            <th>@GlobalShared.Credit</th>
                                            <th>@GlobalShared.PreviousBalance</th>
                                            <th>@GlobalShared.Balance</th>
                                            <th>@GlobalShared.Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var orderedTransactions = Model.TransactionHistories.OrderBy(d => d.CreatedDate);
                                        }
                                        @foreach (var d in orderedTransactions)
                                        {
                                            <tr>
                                                <td style="width: 50%">@d.CreatedDate</td>
                                                <td style="width: 10%">@d.Debit</td>
                                                <td style="width: 10%">@d.Credit</td>
                                                <td style="width: 10%">@d.PreviousBalance</td>
                                                <td style="width: 10%">@d.Balance</td>
                                                <td style="width: 10%">@d.Operation</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


