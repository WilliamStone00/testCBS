@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay



<div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

    <div id="accordionPopoutIconxx" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconxThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIconx-3">
                    <i class="mdi mdi-update me-2"></i>
                    Details of operations of @Model.PrimaryTellerProvisioningHistory.teller.name for the selected date @Model.PrimaryTellerProvisioningHistory.openedDate

                </button>
            </h2>
            <div id="accordionPopoutIconx-3"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewChange">
                        <div class="change-group">

                            <div class="row mt-2 gy-4">
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openOfDayAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Open of day amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openedDate, new { @class = "form-control date-picker", @placeholder = "Operation date" })
                                        <label>Opened date</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.cashReplenishmentAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Replenished amount</label>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.cashAtHand, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Cash at hand</label>
                                    </div>
                                </div> <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.clossedDate, new { @class = "form-control date-picker", @placeholder = "Operation date" })
                                        <label>Date to close</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.accountBalance, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">System difference</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.clossedStatus, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Close of day status</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.accountantConfirmationStatus, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Validation status</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.PrimaryTellerProvisioningHistory.primaryTellerComment, new { @class = "form-control", @style = "height: 75px;" })
                                        <label for="formValidationDob">Teller note</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.PrimaryTellerProvisioningHistory.accountantComment, new { @class = "form-control", @style = "height: 75px;" })
                                        <label for="formValidationDob">Accountant note</label>
                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxTwo">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-2"
                        aria-controls="accordionPopoutIconx-2">
                    <i class="mdi mdi-details me-2"></i>
                    Close operations of @Model.PrimaryTellerProvisioningHistory.teller.name for the selected date @Model.PrimaryTellerProvisioningHistory.openedDate
                </button>
            </h2>
            <div id="accordionPopoutIconx-2"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainviewReset">
                        <div class="reset-group">
                            @using (Html.BeginForm("Primary", "EndOfDayOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {@Html.HiddenFor(model => model.EndOfDayPrimaryTellerCommand.primaryTellerProvioningHistoryID)
                            <div class="row mt-2 gy-4">
                                <div class="col-md-8">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openOfDayAmount, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Open of day amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.PrimaryTellerProvisioningHistory.openedDate, new { @class = "form-control", @readonly = true })
                                        <label style="color:blue">Open of day date</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.cashAtHand, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.cashAtHand, "", new { @class = "text-danger" })
                                        <label style="color:blue">Enter amount collected</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note10000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note10000, "", new { @class = "text-danger " })
                                        <label>Note-10,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note5000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note5000, "", new { @class = "text-danger " })
                                        <label>Note-5,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note2000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note2000, "", new { @class = "text-danger " })
                                        <label>Note-2,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note1000, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note1000, "", new { @class = "text-danger " })
                                        <label>Note-1,000</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note500, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.note500, "", new { @class = "text-danger " })
                                        <label>Note-500</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin500, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin500, "", new { @class = "text-danger " })
                                        <label>Coin-500</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin100, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin100, "", new { @class = "text-danger " })
                                        <label>Coin-100</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin50, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin50, "", new { @class = "text-danger " })
                                        <label>Coin-50</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin25, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin25, "", new { @class = "text-danger " })
                                        <label>Coin-25</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin10, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin10, "", new { @class = "text-danger " })
                                        <label>Coin-10</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin5, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin5, "", new { @class = "text-danger " })
                                        <label>Coin-5</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin1, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.currencyNotes.coin1, "", new { @class = "text-danger " })
                                        <label>Coin-1</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.EndOfDayPrimaryTellerCommand.comment, new { @class = "form-control", @style = "height: 75px;" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.comment, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">Teller note</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.EndOfDayPrimaryTellerCommand.clossedStatus, new SelectList(ViewBag.Statuses, "Text", "Value"), "---Select status type---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.EndOfDayPrimaryTellerCommand.clossedStatus, "", new { @class = "text-danger " })
                                        <label for="formValidationDob">Status</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Close day @Model.PrimaryTellerProvisioningHistory.openedDate</button>
                            </div>
                        }


                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconxOne">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIconx-1"
                        aria-controls="accordionPopoutIconx-1">
                    <i class="mdi mdi-two-factor-authentication me-2"></i>
                    Transactions
                </button>
            </h2>

            <div id="accordionPopoutIconx-1"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionPopoutIconx">
                <div class="accordion-body">
                    <div id="mainview_mfa">
                        <div class="reset-group">
                            <div class="card mb-4">
                                <div class="card-body d-sm-flex d-block">
                                    <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                        <a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="ExportFile('EndOfDayOperation', null,'GetReport', @Model.PrimaryTellerProvisioningHistory.id, 'List', 'export_tellers_transactions', null,'@Model.PrimaryTellerProvisioningHistory.teller.name','DownloadExcelFile',null,'@Model.PrimaryTellerProvisioningHistory.teller.name')" data-bs-toggle="tooltip" title="Export teller transactions">
                                            <span class="tf-icons mdi mdi-printer mdi-18px"></span>
                                        </a>
                                    </div>
                                </div>

                            </div>
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Debit</th>
                                            <th>Credit</th>
                                            <th>Previous balance</th>
                                            <th>Balance</th>
                                            <th>Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var orderedTransactions = Model.TransactionHistories.OrderBy(d => d.CreatedDate);
                                        }
                                        @foreach (var d in orderedTransactions)
                                        {
                                            <tr>
                                                <td style="width: 50%">@d.CreatedDate</td>
                                                <td style="width: 10%">@d.Debit</td>
                                                <td style="width: 10%">@d.Credit</td>
                                                <td style="width: 10%">@d.PreviousBalance</td>
                                                <td style="width: 10%">@d.Balance</td>
                                                <td style="width: 10%">@d.Operation</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


