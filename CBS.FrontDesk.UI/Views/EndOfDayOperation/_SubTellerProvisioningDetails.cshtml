@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay
@using Resources

<table>
    <tr>
        <th>@GlobalShared.Attribute</th>
        <th>@GlobalShared.Value</th>
    </tr>
    <tr>
        <td>@GlobalShared.OpenDate</td>
        <td>@Model.SubTellerProvioningHistory.openedDate</td>
    </tr>
    <tr>
        <td>@GlobalEndOfDayOperation.ClosedAmountOfPreviouseDay</td>
        <td>@Model.SubTellerProvioningHistory.previouseBalance.ToString("#,##0.0")</td>
    </tr>
    <tr>
        <td>@GlobalEndOfDayOperation.OpenOfDayAmount</td>
        <td>@Model.SubTellerProvioningHistory.openOfDayAmount.ToString("#,##0.0")</td>
    </tr>
    <tr>
        <td>@GlobalShared.CashAtHand</td>
        <td>@Model.SubTellerProvioningHistory.cashAtHand.ToString("#,##0.0")</td>
    </tr>
    <tr>
        <td>@GlobalEndOfDayOperation.ReplenishedAmount</td>
        <td>@Model.SubTellerProvioningHistory.ReplenishedAmount.ToString("#,##0.0")</td>
    </tr>
    <tr>
        <td>@GlobalShared.ProvisionedBy</td>
        <td>@Model.SubTellerProvioningHistory.provisionedBy</td>
    </tr>
    <tr>
        <td>@GlobalShared.TellerComment</td>
        <td>@Model.SubTellerProvioningHistory.subTellerComment</td>
    </tr>
    <tr>
        <td>@GlobalShared.TellerCode</td>
        <td>@Model.SubTellerProvioningHistory.teller.code</td>
    </tr>
    <tr>
        <td>@GlobalShared.TellerName</td>
        <td>@Model.SubTellerProvioningHistory.teller.name</td>
    </tr>
    <tr>
        <td>@GlobalShared.User</td>
        <td>@Model.SubTellerProvioningHistory.userIdInChargeOfThisTeller</td>
    </tr>
    <tr>
        <td>@GlobalEndOfDayOperation.PrimaryTellerComment</td>
        <td>@Model.SubTellerProvioningHistory.primaryTellerComment</td>
    </tr>
    <tr>
        <td>@GlobalShared.ConfirmationStatus</td>
        <td>@Model.SubTellerProvioningHistory.primaryTellerConfirmationStatus</td>
    </tr>
    <tr>
        <td>@GlobalShared.ClosedDate</td>
        <td>@Model.SubTellerProvioningHistory.clossedDate</td>
    </tr>
    <tr>
        <td>@GlobalShared.ClosedStatus</td>
        <td>@Model.SubTellerProvioningHistory.clossedStatus</td>
    </tr>
</table>

