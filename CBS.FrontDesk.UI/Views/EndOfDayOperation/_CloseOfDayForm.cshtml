@model CBS.FrontDesk.Data.Entity.SavingProducts.EndOfTheDay

@if (ViewBag.HasError)
{

    @Html.Partial("_GeneralErrorDiv")


}
@using (Html.BeginForm("CloseTheDay", "EndOfDayOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{

    <fieldset class="fieldset-custom">
        <legend id="select_base">Close of day parameter</legend>
        <div class="row mt-2 gy-4">
            @Html.HiddenFor(model => model.CloseOfDayRequest.Amount)
            @Html.HiddenFor(model => model.CloseOfDayRequest.CashAtHand)
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box float-start">Close of day balance: @Model.CloseOfDayRequest.Amount.ToString("#,##0.0")</span>
                </div>
            </div>
            <div class="col-md-6" hidden="hidden">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.CloseOfDayRequest.Amount">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblBalance">Balance: @Model.CloseOfDayRequest.Amount.ToString("#,##0.0")</span>
                </div>
            </div>
            <input type="hidden" name="Option" id="Option" value="@ViewBag.Option" />
            <legend>Denomination</legend>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.note10000, "", new { @class = "text-danger " })
                    <label>N10,000</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.note5000, new { @class = "form-control", @id = "Notes_note5000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.note5000, "", new { @class = "text-danger " })
                    <label>N5,000</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.note2000, new { @class = "form-control", @id = "Notes_note2000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.note2000, "", new { @class = "text-danger " })
                    <label>N2,000</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.note1000, new { @class = "form-control", @id = "Notes_note1000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.note1000, "", new { @class = "text-danger " })
                    <label>N1,000</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.note500, new { @class = "form-control", @id = "Notes_note500", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.note500, "", new { @class = "text-danger " })
                    <label>N500</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin500, new { @class = "form-control", @id = "Notes_coin500", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin500, "", new { @class = "text-danger " })
                    <label>C500</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin100, new { @class = "form-control", @id = "Notes_coin100", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin100, "", new { @class = "text-danger " })
                    <label>C100</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin50, new { @class = "form-control", @id = "Notes_coin50", @oninput = "calculateBalance()" })
