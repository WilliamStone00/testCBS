                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.CloseOfDayRequest.Comment, new { @class = "form-control formatted-amount shadow-box", @style = "height: 70px;" })
                        @Html.ValidationMessageFor(m => m.CloseOfDayRequest.Comment, "", new { @class = "text-danger " })
                        <label for="formValidationDob">@GlobalEndOfDayOperation.OpenOfDayNote</label>
                    </div>
                </div>
                @if (ViewBag.Option != "Primary")
                {
                    <div class="col-md-12 mt-3">
                        <div class="form-floating form-floating-outline">
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.ProceedWithDiscrepancy, new { @class = "form-check-input", @id = "proceedCheckbox", onchange = "toggleCloseButton()" })
                                <label class="form-check-label fw-bold text-danger" for="proceedCheckbox">
                                    I acknowledge the difference (deficit or surplus) and wish to proceed with the closure.
                                </label>
                            </div>
                            @Html.ValidationMessageFor(m => m.ProceedWithDiscrepancy, "", new { @class = "text-danger" })
                        </div>
                    </div>
