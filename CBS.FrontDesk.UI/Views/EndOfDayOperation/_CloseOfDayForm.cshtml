                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin25, new { @class = "form-control", @id = "Notes_coin25", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin25, "", new { @class = "text-danger " })
                    <label>C25</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin10, new { @class = "form-control", @id = "Notes_coin10", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin10, "", new { @class = "text-danger " })
                    <label>C10</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin5, new { @class = "form-control", @id = "Notes_coin5", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin5, "", new { @class = "text-danger " })
                    <label>C5</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CloseOfDayRequest.CurrencyNotes.coin1, new { @class = "form-control", @id = "Notes_coin1", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.CurrencyNotes.coin1, "", new { @class = "text-danger " })
                    <label>C1</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.CloseOfDayRequest.Comment, new { @class = "form-control", @style = "height: 70px;" })
                    @Html.ValidationMessageFor(m => m.CloseOfDayRequest.Comment, "", new { @class = "text-danger " })
                    <label for="formValidationDob">Open of day note</label>
                </div>
            </div>

        </div>
        <div class="mt-4">
            <button type="submit" id="btnSave" class="btn btn-primary me-2">Close the day</button>
        </div>
    </fieldset>
}

