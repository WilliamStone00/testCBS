@model CBS.FrontDesk.Data.Entity.GeneralStatisticReport.GeneralStatisticsDashboard
@using Resources
@{
    ViewBag.Title = "General Statistics Dashboard";
}
<style>
    .sticky-top {
        top: 70px; /* adjust if navbar is present */
    }
</style>
<!-- Dashboard Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-chart-box-outline me-2"></i> @GlobalGeneralStatisticReport.General_Statistics_Dashboard
                </h1>
                <p class="card-text">
                    @GlobalGeneralStatisticReport.A_smart_dashboard_for_exploring_membership_trends_account_balances_loan_exposure_demographics_and_compliance_gaps_across_branches_and_periods
                </p>
                <p class="card-text text-black fw-bold">
                    <i class="mdi mdi-lightbulb-on-outline me-1"></i> @GlobalGeneralStatisticReport.Explore_insights_via_tabs_Overview_Loans_Accounts_Demographics_Compliance_Gaps
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>


<!-- Tips Section -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalGeneralStatisticReport.Tips_for_Interpreting_Dashboard_Insights</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">

                <li>
                    <strong>📊 @GlobalShared.Overview:</strong>
                    @GlobalGeneralStatisticReport.Provides_a_quick_summary_of_total_membership_across_genders_and_groups_This_section_helps_you_identify_general_participation_trends_evaluate_growth_and_verify_if_the_member_base_aligns_with_institutional_targets
                </li>

                <li>
                    <strong>📈 @GlobalGeneralStatisticReport.Account_Insights:</strong>
                    @GlobalGeneralStatisticReport.Displays_account_balances_categorized_by_type_eg_savings_deposits_shares_and_ownership_individuals_or_groups_Use_this_view_to_assess_deposit_mobilization_efforts_balance_distributions_and_concentration_risks
                </li>

                <li>
                    <strong>💰 @GlobalGeneralStatisticReport.Loan_Insights:</strong>
                    @GlobalGeneralStatisticReport.Breaks_down_outstanding_and_disbursed_loans_by_status_active_closed_loan_type_and_product_category_Enables_you_to_track_lending_performance_monitor_exposure_and_detect_unhealthy_accumulation_in_certain_categories
                </li>

                <li>
                    <strong>👥 @GlobalShared.Demographics:</strong>
                    @GlobalGeneralStatisticReport.Analyzes_member_composition_by_gender_and_group_form_individuals_vs_cooperatives_This_is_useful_for_compliance_with_gender_or_inclusion_policies_as_well_as_for_assessing_targeted_outreach_effectiveness
                </li>

                <li>
                    <strong>⚠️ @GlobalGeneralStatisticReport.Gaps_in_Compliance:</strong>
                    @GlobalGeneralStatisticReport.Flags_members_who_are_fully_registered_and_approved_but_lack_any_financial_account_savings_or_loan_This_helps_in_identifying_onboarding_or_operational_bottlenecks_that_may_prevent_full_participation_in_the_institution_s_services
                </li>

                <li>
                    <strong>📌 @GlobalShared.Recommendations:</strong>
                    @GlobalGeneralStatisticReport.Use_filters_above_to_narrow_your_analysis_to_a_specific_branch_time_period_or_product_group_After_analyzing_a_dashboard_you_may_export_the_data_or_use_it_to_guide_policy_or_product_interventions
                </li>

            </ul>
        </div>
    </div>
</div>




<!-- Collapsible Filter Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-filter-outline me-2"></i> @GlobalShared.Report_Filters</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilter" aria-expanded="true" aria-controls="collapseFilter">
            <i class="mdi mdi-tune"></i> @GlobalShared.Toggle_Filter
        </button>
    </h6>
    <div id="collapseFilter" class="show">
        <div class="card-body" id="filterView">
            @Html.Partial("_ReportFilter")
        </div>
    </div>
</div>

