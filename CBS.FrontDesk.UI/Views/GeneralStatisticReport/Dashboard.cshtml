@model CBS.FrontDesk.Data.Entity.GeneralStatisticReport.GeneralStatisticsDashboard

@{
    ViewBag.Title = "General Statistics Dashboard";
}
<style>
    .sticky-top {
        top: 70px; /* adjust if navbar is present */
    }
</style>
<!-- Dashboard Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-chart-box-outline me-2"></i> General Statistics Dashboard
                </h1>
                <p class="card-text">
                    A smart dashboard for exploring membership trends, account balances, loan exposure, demographics, and compliance gaps across branches and periods.
                </p>
                <p class="card-text text-black fw-bold">
                    <i class="mdi mdi-lightbulb-on-outline me-1"></i> Explore insights via tabs: 📊 Overview, 💰 Loans, 📈 Accounts, 👥 Demographics, ⚠️ Compliance Gaps.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>


<!-- Tips Section -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> Tips for Interpreting Dashboard Insights</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">

                <li>
                    <strong>📊 Overview:</strong>
                    Provides a quick summary of total membership across genders and groups. This section helps you identify general participation trends, evaluate growth, and verify if the member base aligns with institutional targets.
                </li>

                <li>
                    <strong>📈 Account Insights:</strong>
                    Displays account balances categorized by type (e.g., savings, deposits, shares) and ownership (individuals or groups). Use this view to assess deposit mobilization efforts, balance distributions, and concentration risks.
                </li>

                <li>
                    <strong>💰 Loan Insights:</strong>
                    Breaks down outstanding and disbursed loans by status (active, closed), loan type, and product category. Enables you to track lending performance, monitor exposure, and detect unhealthy accumulation in certain categories.
                </li>

                <li>
                    <strong>👥 Demographics:</strong>
                    Analyzes member composition by gender and group form (individuals vs cooperatives). This is useful for compliance with gender or inclusion policies, as well as for assessing targeted outreach effectiveness.
                </li>

                <li>
                    <strong>⚠️ Gaps in Compliance:</strong>
                    Flags members who are fully registered and approved but lack any financial account (savings or loan). This helps in identifying onboarding or operational bottlenecks that may prevent full participation in the institution's services.
                </li>

                <li>
                    <strong>📌 Recommendations:</strong>
                    Use filters above to narrow your analysis to a specific branch, time period, or product group. After analyzing a dashboard, you may export the data or use it to guide policy or product interventions.
                </li>

            </ul>
        </div>
    </div>
</div>




<!-- Collapsible Filter Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-filter-outline me-2"></i> Report Filters</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilter" aria-expanded="true" aria-controls="collapseFilter">
            <i class="mdi mdi-tune"></i> Toggle Filter
        </button>
    </h6>
    <div id="collapseFilter" class="show">
        <div class="card-body" id="filterView">
            @Html.Partial("_ReportFilter")
        </div>
    </div>
</div>

