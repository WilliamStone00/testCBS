<!-- 🔒 Hidden initially until data is found -->
<div id="dashboardCardContainer" style="display: none;">
    <div class="card mb-3 border-0 shadow-sm">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary bg-light">
            <span><i class="mdi mdi-view-dashboard-outline me-2"></i> @GlobalShared.Dashboard</span>
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDashboard" aria-expanded="true" aria-controls="collapseDashboard">
                <i class="mdi mdi-chevron-down"></i> @GlobalShared.Toggle_Dashboard
            </button>
        </h6>

        <div id="collapseDashboard" class="collapse show">
            <div class="card-body">
                <div id="datalistingview" class="p-3 border rounded bg-light shadow-sm">
                    <!-- Dashboard content will be loaded here via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
   
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <script>
        $(document).ready(function () {
            const filterKey = "tscGeneralStatsFilters";

            // Hide dashboard card and content initially
            $("#dashboardCardContainer").hide();
            $("#datalistingview").hide();

            // Restore saved filters from localStorage
            const saved = localStorage.getItem(filterKey);
            if (saved) {
                const filters = JSON.parse(saved);
                $("#branchInput").val(filters.BranchId).trigger("change");
                $("#startDate").val(filters.StartDate);
                $("#endDate").val(filters.EndDate);
                $("#accountTypes").val(filters.AccountTypes).trigger("change");
                $("#accountProfiles").val(filters.AccountProfiles).trigger("change");
                $("#loanStatus").val(filters.LoanStatus).trigger("change");
                $("#mainReportType").val(filters.MainReportType);
            }

            // Expand filter section on load
            const filterCollapse = bootstrap.Collapse.getOrCreateInstance(document.getElementById('collapseFilter'));
            //filterCollapse.show();

            // Reset all filters and hide dashboard
            $("#resetFilterBtn").click(function () {
                localStorage.removeItem(filterKey);
                $("#branchInput").val("").trigger("change");
                $("#startDate").val("");
                $("#endDate").val("");
                $("#accountTypes").val([]).trigger("change");
                $("#accountProfiles").val([]).trigger("change");
                $("#loanStatus").val("all").trigger("change");
                $("#mainReportType").val("");

                // Hide dashboard
                $("#dashboardCardContainer").hide();
                $("#datalistingview").hide();

                // Re-expand filters
                filterCollapse.show();
            });

            // Apply filter
            $("#applyFilterBtn").click(function () {
                const requestData = {
                    BranchId: $("#branchInput").val(),
                    StartDate: $("#startDate").val(),
                    EndDate: $("#endDate").val(),
                    AccountTypes: $("#accountTypes").val(),
                    AccountProfiles: $("#accountProfiles").val(),
                    LoanStatus: $("#loanStatus").val(),
                    MainReportType: $("#mainReportType").val()
                };

                // Save to localStorage
                localStorage.setItem(filterKey, JSON.stringify(requestData));

                $.ajax({
                    url: "/GeneralStatisticReport/Dashboard",
                    type: "POST",
                    data: requestData,
                    beforeSend: function () {
                        $("#applyFilterBtn").prop("disabled", true).html("<i class='mdi mdi-loading mdi-spin'></i> Loading...");
                    },
                    success: function (response) {
                        if (response && typeof response === "string" && response.trim().length > 0) {
                            $("#datalistingview").html(response);
                            $("#dashboardCardContainer").show();
                            $("#datalistingview").show();

                            renderDashboardCharts();

                            // Collapse filters after load
                            filterCollapse.hide();
                        } else {
                            $("#datalistingview").hide();
                            $("#dashboardCardContainer").hide();
                            alert("No data found for the selected criteria.");
                        }
                    },
                    error: function (xhr) {
                        console.error(xhr);
                        alert("An error occurred while loading the dashboard.");
                        $("#datalistingview").hide();
                        $("#dashboardCardContainer").hide();
                    },
                    complete: function () {
                        $("#applyFilterBtn").prop("disabled", false).html("<i class='mdi mdi-magnify'></i> Apply Filter");
                    }
                });
            });

            // Export logic using AJAX to prevent immediate redirection
            $("#exportBtn").click(function () {
                const params = {
                    BranchId: $("#branchInput").val(),
                    StartDate: $("#startDate").val(),
                    EndDate: $("#endDate").val(),
                    AccountProfiles: $("#accountProfiles").val() || [],
                    LoanStatus: $("#loanStatus").val(),
                    MainReportType: $("#mainReportType").val()
                };

                // Handle AccountTypes manually to be serialized as multiple keys
                const accountTypes = $("#accountTypes").val() || [];
                let queryString = $.param(params, true);

                // Append AccountTypes correctly
                accountTypes.forEach(type => {
                    queryString += `&AccountTypes=${encodeURIComponent(type)}`;
                });

                $.ajax({
                    url: "/GeneralStatisticReport/GeneralReport?" + queryString,
                    type: "POST",
                    success: function (response) {
                        if (response.success && response.redirectUrl) {
                            window.open(response.redirectUrl, '_blank'); // Opens in new tab
                        } else {
                            alert(response.message || "Report export failed.");
                        }
                    },

                    error: function (xhr) {
                        console.error(xhr);
                        alert("An error occurred while exporting the report.");
                    },
                    beforeSend: function () {
                        $("#exportBtn").prop("disabled", true).html("<i class='mdi mdi-loading mdi-spin'></i> Generating...");
                    },
                    complete: function () {
                        $("#exportBtn").prop("disabled", false).html("<i class='mdi mdi-file-export'></i> Export");
                    }
                });
            });

        });
    </script>

    <script>
        $(document).ready(function () {
            // 🔁 Helper to reset a select element
            function resetSelect(selector) {
                $(selector).val('').trigger('change');
            }

            // 🟩 Branch Toggle
            $('#enableBranch').on('change', function () {
                if (this.checked) {
                    $('.branch-section').removeClass('d-none');
                } else {
                    $('.branch-section').addClass('d-none');
                    resetSelect('#branchInput');
                }
            }).trigger('change');

            // 📅 Date Range Toggle
            $('#enableDateRange').on('change', function () {
                if (this.checked) {
                    $('.date-range-section').removeClass('d-none');
                } else {
                    $('.date-range-section').addClass('d-none');
                    $('#startDate').val('');
                    $('#endDate').val('');
                }
            }).trigger('change');

            // 📊 Report Type Toggle
            $('#enableReportType').on('change', function () {
                if (this.checked) {
                    $('.report-type-section').removeClass('d-none');
                } else {
                    $('.report-type-section').addClass('d-none');
                    resetSelect('#mainReportType');
                }
            }).trigger('change');
        });
    </script>




}
