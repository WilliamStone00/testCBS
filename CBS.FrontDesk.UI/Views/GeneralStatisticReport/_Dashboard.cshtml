                                            <td>@miss.CustomerId</td>
                                            <td>@miss.FullName</td>
                                            <td>@miss.Gender</td>
                                            <td>@miss.Age</td>
                                            <td>@miss.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
