        // 📊 Loan Type Chart
const loanTypeCtx = document.getElementById('loanTypeChart');
if (loanTypeCtx) {
    const loanTypeLabels = @Html.Raw(JsonMVC.Serialize(Model.LoanTypeSummaries.Select(x => x.Category)));
