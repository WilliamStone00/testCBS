        }


        // Chart 3: Account Type Pie Chart
        const ctx3 = document.getElementById('accountTypePieChart');
        if (ctx3 && accountLabels.length > 0) {
            const total = accountValues.reduce((a, b) => a + b, 0);

            new Chart(ctx3, {
                type: 'pie',
