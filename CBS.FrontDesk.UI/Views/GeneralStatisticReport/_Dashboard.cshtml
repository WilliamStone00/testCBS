@model CBS.FrontDesk.Data.Entity.GeneralStatisticReport.GeneralStatisticsDashboard
@using Resources
@using CBS.FrontDesk.UI.Helper
@{
    decimal loanBalance = @Model.LoanBreakdowns.Sum(x => x.TotalAmount);
    decimal savingBalance = @Model.AccountTypeSummaries.Where(x => x.AccountType=="Saving").Sum(x => x.TotalAmount);

    decimal difference = savingBalance - loanBalance;
    decimal loanRatio = savingBalance > 0 ? (loanBalance / savingBalance) * 100 : 0;
    bool isCompliant = loanBalance <= savingBalance;

    string icon = isCompliant ? "✅" : "❌";
    string statusClass = isCompliant ? "text-success fw-bold" : "text-danger fw-bold";
    string statusMessage = isCompliant
        ? "Compliant: Savings exceed loans, providing a strong liquidity buffer."
        : "Non-Compliant: Loan balances exceed savings, indicating high credit exposure.";

    var savingsOnly = Model.AccountTypeSummaries
         .Where(x => x.AccountType?.ToLower() == "saving")
         .ToList();

    var savingMenAmount = savingsOnly.Sum(x => x.MenAmount);
    var savingWomenAmount = savingsOnly.Sum(x => x.WomenAmount);
    var savingGroupsAmount = savingsOnly.Sum(x => x.GroupsAmount);

    var loanMenAmount = Model.LoanSummaries.Sum(x => x.MenAmount);
    var loanWomenAmount = Model.LoanSummaries.Sum(x => x.WomenAmount);
    var loanGroupsAmount = Model.LoanSummaries.Sum(x => x.GroupsAmount);
    var categoryLabels = string.Join(",", Model.LoanBreakdowns.Select(c => $"'{c.Category}'"));
    var categoryAmounts = string.Join(",", Model.LoanBreakdowns.Select(c => c.TotalAmount));

    var totalLoan = loanMenAmount + loanWomenAmount + loanGroupsAmount;
    var totalSaving = savingMenAmount + savingWomenAmount + savingGroupsAmount;
    var loanToSavingRatio = totalSaving > 0 ? (decimal)totalLoan / totalSaving * 100 : 0;

    var loanMenPercent = totalLoan > 0 ? (decimal)loanMenAmount / totalLoan * 100 : 0;
    var loanWomenPercent = totalLoan > 0 ? (decimal)loanWomenAmount / totalLoan * 100 : 0;
    var loanGroupsPercent = totalLoan > 0 ? (decimal)loanGroupsAmount / totalLoan * 100 : 0;

    var savingMenPercent = totalSaving > 0 ? (decimal)savingMenAmount / totalSaving * 100 : 0;
    var savingWomenPercent = totalSaving > 0 ? (decimal)savingWomenAmount / totalSaving * 100 : 0;
    var savingGroupsPercent = totalSaving > 0 ? (decimal)savingGroupsAmount / totalSaving * 100 : 0;


    var complianceBreached = loanToSavingRatio > 170;

    var savingTotalPercent = (decimal)totalSaving / @Model.AccountTypeSummaries.Sum(a => a.TotalAmount) * 100;
    var memberShareTotal = @Model.AccountTypeSummaries.Where(a => a.AccountType == "MemberShare").Sum(a => a.TotalAmount);
    var preferenceShareTotal = @Model.AccountTypeSummaries.Where(a => a.AccountType == "PreferenceShare").Sum(a => a.TotalAmount);
    var balanceSavingminusLoan = totalSaving - totalLoan;



    var totalLoans = Model.LoanBreakdowns?.Sum(x => x.Total) ?? 0;
    var totalLoanAmount = Model.LoanBreakdowns?.Sum(x => x.TotalAmount) ?? 0M;


    var grantedThisMonth = Model.LoanSummaries
    .FirstOrDefault(x => x.Category == "LoansGrantedThisMonth");

    var loansGrantedThisMonth = grantedThisMonth?.TotalCount ?? 0;
    var newLoansAmountThisMonth = grantedThisMonth?.TotalAmount ?? 0M;


    // Top 3 categories
    var top3Categories = Model.LoanBreakdowns?.OrderByDescending(x => x.TotalAmount).Take(3).ToList();

}
<style>
    canvas {
        max-height: 200px !important;
    }
</style>
<input type="hidden" id="loanBalance" value="@loanBalance" />
<input type="hidden" id="savingBalance" value="@savingBalance" />

<input type="hidden" id="genderMen" value="@Model.CustomerGenderSummary.Men" />
<input type="hidden" id="genderWomen" value="@Model.CustomerGenderSummary.Women" />
<input type="hidden" id="genderGroups" value="@Model.CustomerGenderSummary.Groups" />

<input type="hidden" id="accountTypeLabels" value="@string.Join(",", Model.AccountTypeSummaries.Select(a => a.AccountType))" />
<input type="hidden" id="accountTypeValues" value="@string.Join(",", Model.AccountTypeSummaries.Select(a => a.TotalAmount))" />



<ul class="nav nav-tabs" id="dashboardTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">📊 @GlobalShared.Overview</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="account-tab" data-bs-toggle="tab" data-bs-target="#account" type="button" role="tab">📈 @GlobalGeneralStatisticReport.Account_Insights</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="loan-tab" data-bs-toggle="tab" data-bs-target="#loan" type="button" role="tab">💰 @GlobalGeneralStatisticReport.Loan_Insights</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="demographics-tab" data-bs-toggle="tab" data-bs-target="#demographics" type="button" role="tab">👥 @GlobalGeneralStatisticReport.Demographic_Insights</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="missing-tab" data-bs-toggle="tab" data-bs-target="#missing" type="button" role="tab">⚠️ @GlobalGeneralStatisticReport.Missing_Records</button>
    </li>
</ul>

<div class="tab-content mt-3" id="dashboardTabContent">
    <div class="tab-pane fade show active" id="overview" role="tabpanel">

        <div class="row mb-4">

            <div class="col-md-12">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <h6>@GlobalShared.Total_members</h6>
                                <h4 class="fw-bold">@Model.MembersWithAccounts.Total.ToString("N0")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <h6>@GlobalShared.Men</h6>
                                <h4 class="fw-bold text-info">@Model.MembersWithAccounts.Men.ToString("N0")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <h6>@GlobalShared.Women</h6>
                                <h4 class="fw-bold text-warning">@Model.MembersWithAccounts.Women.ToString("N0")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm">
                            <div class="card-body text-center">
                                <h6>@GlobalShared.Groups</h6>
                                <h4 class="fw-bold text-danger">@Model.MembersWithAccounts.Groups.ToString("N0")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 📊 GENDER INSIGHT FULL WIDTH -->
        <div class="card shadow-sm p-3 mb-3">
            <h6 class="text-muted mb-2">📊 @GlobalGeneralStatisticReport.Gender_Distribution_Insight</h6>
            <p class="mb-2">
                @GlobalGeneralStatisticReport.Among_the <strong>@Model.MembersWithAccounts.Total.ToString("N0")</strong> @GlobalShared.Members:
                <strong>@Model.MembersWithAccounts.Men.ToString("N0")</strong> (
                @((Model.MembersWithAccounts.Men * 100) / Model.MembersWithAccounts.Total)%)
                @GlobalShared.are <span class="text-info fw-bold">@GlobalShared.Men</span>,
                <strong>@Model.MembersWithAccounts.Women.ToString("N0")</strong> (
                @((Model.MembersWithAccounts.Women * 100) / Model.MembersWithAccounts.Total)%)
                @GlobalShared.are <span class="text-warning fw-bold">@GlobalShared.Women</span>, @GlobalShared.and
                <strong>@Model.MembersWithAccounts.Groups.ToString("N0")</strong> (
                @((Model.MembersWithAccounts.Groups * 100) / Model.MembersWithAccounts.Total)%)
                @GlobalShared.are <span class="text-danger fw-bold">@GlobalShared.Groups</span>.
            </p>
        </div>

        <!-- 📈 INSIGHT ROW -->
        <div class="row mb-4">
            <!-- 📘 Loan Category -->
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body small">
                        <h6 class="text-muted mb-2">📘 @GlobalGeneralStatisticReport.Loan_Category_Analysis</h6>
                        <p class="mb-0">
                            @Html.Raw(@GlobalGeneralStatisticReport.A_total_of_265_loans_have_been_disbursed_worth) <strong>39,550,000</strong>.
                            @Html.Raw(@GlobalGeneralStatisticReport.The_highest_concentration_is_in_Short_and_Medium_Term_loans_reflecting_demand_for_flexible_repayment_options)
                        </p>
                    </div>
                </div>
            </div>

            <!-- 📊 Loan Breakdown -->
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body small">
                        <h6 class="text-muted mb-2">📊 @GlobalGeneralStatisticReport.Sectoral_Loan_Distribution</h6>
                        <p class="mb-0">
                            @Html.Raw(@GlobalGeneralStatisticReport.The_largest_loan_disbursements_are_in_Business_and_Education_sectors),
                            @GlobalGeneralStatisticReport.totaling <strong>28,200,000</strong>. @Html.Raw(@GlobalGeneralStatisticReport.Business_loans_alone_exceed_40_of_total_value)
                        </p>
                    </div>
                </div>
            </div>

            <!-- 📅 Current Month Loans -->
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body small">
                        <h6 class="text-muted mb-2">📅 @GlobalGeneralStatisticReport.Loans_in_June_2025</h6>
                        <p class="mb-0">
                            <strong>17</strong> @GlobalGeneralStatisticReport.new_loans_were_granted_this_month_worth <strong>1,620,000</strong>.
                            @GlobalGeneralStatisticReport.This_suggests_a_healthy_credit_cycle_for_the_ongoing_period
                        </p>
                    </div>
                </div>
            </div>

            <!-- 💼 Account Ownership by Balance -->
            <!-- 💼 Account Ownership -->
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body small">
                        <h6 class="text-muted mb-2">💼 @GlobalGeneralStatisticReport.Account_Ownership_Insight</h6>
                        <p class="mb-0">
                            @GlobalGeneralStatisticReport.Out_of <strong>@Model.MembersWithAccounts.Total.ToString("N0")</strong> @GlobalShared.Members:<br />
                            <strong>@Model.MembersWithAccounts.Men.ToString("N0")</strong> @GlobalShared.Men,
                            <strong>@Model.MembersWithAccounts.Women.ToString("N0")</strong> @GlobalShared.Women,
                            @GlobalShared.and <strong>@Model.MembersWithAccounts.Groups.ToString("N0")</strong> @GlobalGeneralStatisticReport.groups_have_active_accounts.<br />
                            <span class="text-success fw-bold">@GlobalGeneralStatisticReport.Ownership_is_balanced_across_member_types</span>
                        </p>
                    </div>
                </div>
            </div>


        </div>

    </div>
    <div class="tab-pane fade" id="account" role="tabpanel">
        <!-- 🔹 Group 1: Bar Charts -->
        <div class="row mb-4">
            <!-- 📊 Account Balance by Group -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-primary mb-2">📊 @GlobalGeneralStatisticReport.Saving_Account_Balance_by_Group</h6>
                        <canvas id="accountGroupChart" height="120"></canvas> <!-- reduced height -->
                    </div>
                </div>
            </div>

            <!-- 👥 Gender Distribution -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-primary mb-2">💼 @GlobalGeneralStatisticReport.Account_Balances_Against_Account_Type_Composition</h6>
                        <canvas id="accountTypePieChart" height="120"></canvas> <!-- reduced height -->
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔹 Group 2: Pie + Line Charts -->
        <div class="row mb-4">
            <!-- 🏦 Loan vs. Savings Balance Insight -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 @(isCompliant ? "border-success" : "border-danger")">
                    <div class="card-body">
                        <h6 class="text-primary mb-2">🏦 @GlobalGeneralStatisticReport.Loan_vs_Savings_Balance</h6>
                        <p class="mb-1">
                            @GlobalGeneralStatisticReport.Total_Loan_Balance: <strong>@loanBalance.ToString("N0")</strong><br />
                            @GlobalGeneralStatisticReport.Total_Savings_Balance: <strong>@savingBalance.ToString("N0")</strong><br />
                            @GlobalShared.Difference: <strong>@difference.ToString("N0")</strong><br />
                            @GlobalGeneralStatisticReport.Loan_to_Savings_Ratio: <strong>@loanRatio.ToString("N1")%</strong>
                        </p>
                        <p class="@statusClass mt-2">
                            @icon @statusMessage
                        </p>
                    </div>
                </div>
            </div>

            <!-- 📈 Loan vs. Savings Chart -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-primary mb-2">📈 @GlobalGeneralStatisticReport.Loan_vs_Saving_Balance</h6>
                        <canvas id="loanSavingLineChart" height="150"></canvas>
                    </div>
                </div>
            </div>
        </div>



        <!-- 🧾 Account Type Summary -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="text-primary mb-3">📘 @GlobalGeneralStatisticReport.Account_Type_Summary</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@GlobalShared.Account_type</th>
                                <th>@GlobalShared.Men</th>
                                <th>@GlobalShared.Women</th>
                                <th>@GlobalShared.Groups</th>
                                <th>@GlobalShared.Total</th>
                                <th>@GlobalShared.Men_Amount</th>
                                <th>@GlobalShared.Women_Amount</th>
                                <th>@GlobalShared.Groups_Amount</th>
                                <th>@GlobalShared.Total_amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AccountTypeSummaries)
                            {
                                <tr>
                                    <td>@item.AccountType</td>
                                    <td>@item.MenCount.ToString("N0")</td>
                                    <td>@item.WomenCount.ToString("N0")</td>
                                    <td>@item.GroupsCount.ToString("N0")</td>
                                    <td>@item.TotalCount.ToString("N0")</td>
                                    <td>@item.MenAmount.ToString("N0")</td>
                                    <td>@item.WomenAmount.ToString("N0")</td>
                                    <td>@item.GroupsAmount.ToString("N0")</td>
                                    <td class="fw-bold">@item.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold bg-light">
                            <tr>
                                <td>Total</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.MenCount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.WomenCount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.GroupsCount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.TotalCount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.MenAmount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.WomenAmount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.GroupsAmount).ToString("N0")</td>
                                <td>@Model.AccountTypeSummaries.Sum(x => x.TotalAmount).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- 🧠 Account Insight Interpretation (Collapsible) -->
        <div class="card shadow-sm border-info mb-3">
            <div class="card-header text-info d-flex justify-content-between align-items-center">
                <span><i class="mdi mdi-lightbulb-on-outline me-1"></i> @GlobalGeneralStatisticReport.Account_Insight_Interpretation</span>
                <button class="btn btn-outline-info btn-sm" data-bs-toggle="collapse" data-bs-target="#accountInsightCollapse">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>

            <div id="accountInsightCollapse" class="collapse">
                <div class="card-body text-sm text-dark">
                    <ul class="mb-3">
                        <li>
                            <strong>@GlobalGeneralStatisticReport.Liquidity_Position:</strong> @GlobalGeneralStatisticReport.Total_savings (FCFA <b>@totalSaving.ToString("N0")</b>) @GlobalGeneralStatisticReport.exceed_total_loan_volume (FCFA <b>@totalLoan.ToString("N0")</b>) by
                            <b>@balanceSavingminusLoan.ToString("N0")</b>, @GlobalGeneralStatisticReport.yielding_a_loan_to_saving_ratio_of
                            <b>@loanToSavingRatio.ToString("N1")%</b>.
                            <span class="text-success fw-bold">@GlobalGeneralStatisticReport.This_indicates_a_compliant_liquidity_buffer.</span>
                        </li>
                        <li>
                            <strong>@GlobalGeneralStatisticReport.Savings_Dominance:</strong> @Html.Raw(@GlobalGeneralStatisticReport.The_Saving_account_type_holds)
                            <b>@(savingTotalPercent.ToString("N1"))%</b> @GlobalGeneralStatisticReport.of_all_account_balances_confirming_the_cooperatives_strength_in_deposit_mobilization
                        </li>
                        <li>
                            <strong>@GlobalGeneralStatisticReport.Group_Performance:</strong> @GlobalGeneralStatisticReport.Groups_hold_the_highest_savings
                            (FCFA <b>@savingGroupsAmount.ToString("N0")</b>), @GlobalGeneralStatisticReport.contributing
                            <b>@savingGroupsPercent.ToString("N1")%</b> @GlobalGeneralStatisticReport.of_the_total_which_suggests_strong_collective_savings_practices_and_potential_lending_targets
                        </li>
                        <li>
                            <strong>@GlobalGeneralStatisticReport.Member_vs_Preference_Shares:</strong> @GlobalGeneralStatisticReport.Member_shares_dominate_over_preference_shares_with_FCFA
                            <b>@memberShareTotal.ToString("N0")</b> vs.
                            <b>@preferenceShareTotal.ToString("N0")</b>, @GlobalGeneralStatisticReport.indicating_stronger_engagement_through_standard_membership_accounts
                        </li>
                    </ul>
                    <p class="text-muted mt-2">
                        @GlobalGeneralStatisticReport.insights_help_guide_lending_thresholds_identify_deposit_rich_segments_and_track_capital_sustainability_Monitor_trends_regularly_for_strategic_financial_decisions
                    </p>
                </div>
            </div>
        </div>

    </div>
    <div class="tab-pane fade" id="loan" role="tabpanel">


        <div class="row">
            <!-- 📊 Demographic Loan Balance -->
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <i class="mdi mdi-account-cash-outline me-1"></i> @GlobalGeneralStatisticReport.Loan_Balance_by_Demographic
                        <canvas id="loanDemographicChart" height="300"></canvas>
                    </div>
                </div>
            </div>
        </div>



        <!-- 💳 Loan Summary -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="text-primary mb-3">💳 @GlobalGeneralStatisticReport.Loan_Category_Summary</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@GlobalShared.Category</th>
                                <th>@GlobalShared.Men</th>
                                <th>@GlobalShared.Women</th>
                                <th>@GlobalShared.Groups</th>
                                <th>@GlobalShared.Total</th>
                                <th>@GlobalShared.Men_Amount</th>
                                <th>@GlobalShared.Women_Amount</th>
                                <th>@GlobalShared.Groups_Amount</th>
                                <th>@GlobalShared.Total_amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model.LoanSummaries.OrderBy(x => x.TotalAmount))
                            {
                                <tr>
                                    <td>@loan.Category</td>
                                    <td>@loan.MenCount.ToString("N0")</td>
                                    <td>@loan.WomenCount.ToString("N0")</td>
                                    <td>@loan.GroupsCount.ToString("N0")</td>
                                    <td>@loan.TotalCount.ToString("N0")</td>
                                    <td>@loan.MenAmount.ToString("N0")</td>
                                    <td>@loan.WomenAmount.ToString("N0")</td>
                                    <td>@loan.GroupsAmount.ToString("N0")</td>
                                    <td class="fw-bold">@loan.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold bg-light">
                            <tr>
                                <td>Total</td>
                                <td>@Model.LoanSummaries.Sum(x => x.MenCount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.WomenCount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.GroupsCount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.TotalCount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.MenAmount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.WomenAmount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.GroupsAmount).ToString("N0")</td>
                                <td>@Model.LoanSummaries.Sum(x => x.TotalAmount).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="row">

            <!-- 🧾 Loan Amount by Category -->
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm mt-4">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">📊 @GlobalGeneralStatisticReport.Loan_Breakdown_by_Purposes</h6>
                        <canvas id="loanBreakdownChart" height="1000"></canvas>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.LoanBreakdowns?.Any() == true)
        {
            <div class="card mb-4 shadow-sm">
               
                <div class="card-body">
                    <h5 class="text-primary mb-3">📊 @GlobalGeneralStatisticReport.Loan_Breakdown_by_Purposes</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>@GlobalShared.Category</th>
                                    <th>@GlobalShared.Men</th>
                                    <th>@GlobalShared.Women</th>
                                    <th>@GlobalShared.Groups</th>
                                    <th>@GlobalShared.Total</th>
                                    <th>@GlobalShared.Men Amount</th>
                                    <th>@GlobalShared.Women Amount</th>
                                    <th>@GlobalShared.Groups Amount</th>
                                    <th>@GlobalShared.Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LoanBreakdowns)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Men.ToString("N0")</td>
                                        <td>@item.Women.ToString("N0")</td>
                                        <td>@item.Groups.ToString("N0")</td>
                                        <td>@item.Total.ToString("N0")</td>
                                        <td>@item.MenAmount.ToString("N0")</td>
                                        <td>@item.WomenAmount.ToString("N0")</td>
                                        <td>@item.GroupsAmount.ToString("N0")</td>
                                        <td class="fw-bold">@item.TotalAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-bold bg-light">
                                <tr>
                                    <td>@GlobalShared.Total</td>
                                    <td>@Model.LoanBreakdowns.Sum(x => x.Men).ToString("N0")</td>
                                    <td>@Model.LoanBreakdowns.Sum(x => x.Women).ToString("N0")</td>
                                    <td>@Model.LoanBreakdowns.Sum(x => x.Groups).ToString("N0")</td>
