@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
@using Resources

<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalSalaryUpload.SalaryUploadForm</legend>
    <div class="card-body">
        @using (Html.BeginForm("SalaryFile", "SalaryUpload", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <label class="form-label">@GlobalSalaryUpload.SalaryType:</label>

                    @if (ViewBag.HeadOffice=="Yes")
                    {
                        <div class="d-flex align-items-center">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="salaryTypeCivil" name="AddSalaryUploadModelCommand.SalaryType" value="CivilServants" required />
                                <label class="form-check-label" for="salaryTypeCivil">@GlobalSalaryUpload.CivilServants</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="salaryTypePrivate" name="AddSalaryUploadModelCommand.SalaryType" value="PrivateInstitutions" required />
                                <label class="form-check-label" for="salaryTypePrivate">@GlobalSalaryUpload.PrivateInstitutions</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="salaryTypePrivate" name="AddSalaryUploadModelCommand.SalaryType" value="PrivateInstitutions" required />
                                <label class="form-check-label" for="salaryTypePrivate">@GlobalSalaryUpload.PrivateInstitutions</label>
                            </div>
                        </div>
                    }

                    @Html.ValidationMessageFor(m => m.AddSalaryUploadModelCommand.SalaryType, "", new { @class = "text-danger " })
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        <input type="file" id="file" name="AddSalaryUploadModelCommand.File" class="form-control" required />
                        @Html.ValidationMessageFor(m => m.AddSalaryUploadModelCommand.File, "", new { @class = "text-danger " })
                        <label>@GlobalSalaryUpload.SelectSalaryFile</label>
                    </div>
                </div>


            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Upload</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            </div>
        }
    </div>
</fieldset>

