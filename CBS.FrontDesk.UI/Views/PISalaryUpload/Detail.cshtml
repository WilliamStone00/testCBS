@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
    @using Resources
@{
    ViewBag.Title = "PISalaryUpload Summary";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-cabinet me-2"></i> @GlobalPISalaryUpload.salary_summary
                </h1>
                <p class="card-text text-muted">
                    @GlobalPISalaryUpload.view_analyze_and_manage_employee_salary_summaries_efficiently.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card mb-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalShared.Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalarySummaryTips" aria-expanded="false" aria-controls="collapseSalarySummaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalarySummaryTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-file-document-outline text-primary me-2"></i> @GlobalShared.use_the <strong>"@GlobalPISalaryUpload.run_salary_analysis"</strong> @GlobalPISalaryUpload.button_to_analyze_uploaded_salary_data.</li>
                            <li><i class="mdi mdi-eye-outline text-primary me-2"></i> @GlobalShared.click_the <strong>"@GlobalPISalaryUpload.view_result_of_analyzed_salary"</strong> @GlobalPISalaryUpload.button_to_check_previously_analyzed_results.</li>
                            <li><i class="mdi mdi-alert-outline text-warning me-2"></i> @GlobalPISalaryUpload.ensure_all_uploaded_salary_files_are_accurate_and_in_the_correct_format (e.g., Excel, CSV).</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPISalaryUpload.regularly_verify_analyzed_results_against_payroll_to_ensure_accuracy.</li>
                            <li><i class="mdi mdi-database-search-outline text-primary me-2"></i> @GlobalPISalaryUpload.use_search_filters_to_quickly_locate_specific_employee_salary_records.</li>
                            <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i> @GlobalPISalaryUpload.address_anomalies_like_overpayments_or_missing_records_promptly.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalPISalaryUpload.edit_analyzed_salary_records_for_corrections_or_updates_when_necessary.</li>
                            <li><i class="mdi mdi-delete-outline text-danger me-2"></i> @GlobalPISalaryUpload.delete_invalid_uploads_to_maintain_clean_and_accurate_records.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-chart-bar me-1"></i> @GlobalShared.salary_analysis
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" href="/SalaryUpload/UploadedSalaryFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>
                                            @if (Model.ActivateSalaryFileCommand.Status)
                                            {
                                                <a type="button" href="#" class="btn btn-label-danger btn-sm me-2"
                                                   data-bs-toggle="tooltip" title="Deactivate File"
                                                   onclick="ChangeFileStatus('@Model.SalaryUploadModelSummaryDto.FileUploadId', false)">
                                                    <i class="mdi mdi-close-circle mdi-18px"></i> @GlobalShared.Deactivate
                                                </a>
                                            }
                                            else
                                            {
                                                <a type="button" href="#" class="btn btn-label-success btn-sm me-2"
                                                   data-bs-toggle="tooltip" title="Activate File"
                                                   onclick="ChangeFileStatus('@Model.SalaryUploadModelSummaryDto.FileUploadId', true)">
                                                    <i class="mdi mdi-check-circle mdi-18px"></i> @GlobalShared.Activate
                                                </a>
                                             
                                            }

                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryDetailsData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {

            LoadDT("myDataTable", 0)


        });
        function runAnalysis(fileUploadId) {


            alertify.confirm("RUN SALARY ANALYSIS WARNING!!!", "Are you sure you want to run the salary analysis?\nThis action cannot be reverted!",
                function () {
                    var url = "/PISalaryUpload/ExecuteAnalysis";
                    console.log("Executing analysis at URL: " + url);

                    // Prepare data for the request
                    var data = {
                        FileUploadId: fileUploadId
                    };

                    $.ajax({
                        type: "POST",
                        url: url,
                        contentType: "application/json",
                        data: JSON.stringify(data),
                        success: function (response) {
                            if (response.success) {
                                appalert(response.message, 1, 1);
                                // Optionally reload or update the page
                                location.reload();
                            } else {
                                appalert(response.message, 3, 1);
                            }
                        },
                        error: function (err) {
                            appalert(err.statusText, 3, 1);
                        }
                    });
                },
                function () {
                    appalert('Analysis cancelled', 3, 1);
                });
        }
        function ChangeFileStatus(fileUploadId, status) {
            if (!fileUploadId) {
                alert("Invalid File Upload ID.");
                return;
            }

            // Confirm the action before proceeding
            if (!confirm("Are you sure you want to change the file status?")) {
                return;
            }

            // Prepare the data payload
            const model = {
                Id: fileUploadId,
                Status: status // Change this to the desired status if dynamic
            };

            $.ajax({
                url: "/PISalaryUpload/ChangeFileStaus", // Ensure this matches your controller action route
                type: "POST",
                data: model,
                success: function (response) {
                    if (response.success) {
                        appalert(response.message, 1, 1);
                        // Optionally refresh the page or reload a section of the page
                        location.reload();
                    } else {
                        appalert(response.message, 3, 1);
                    }
                },
                error: function (xhr, status, error) {
                    console.error(`Error: ${error}`);
                    appalert(err.statusText, 3, 1);
                }
            });
        }

    </script>
}





