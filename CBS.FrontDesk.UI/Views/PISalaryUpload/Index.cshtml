@using Resources
@{
    ViewBag.Title = "Salary Upload";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-upload-multiple me-2"></i> @GlobalPISalaryUpload.salary_upload_management
                </h1>
                <p class="card-text text-muted">
                    @GlobalPISalaryUpload.easily_manage_and_upload_employee_salary_files.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryUploadTips" aria-expanded="false" aria-controls="collapseSalaryUploadTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryUploadTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPISalaryUpload.ensure_the_salary_file_is_formatted_as <strong>@GlobalPISalaryUpload.salary_code_matricule_name_net_salary_for_cilvil_servants_file</strong>.</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalPISalaryUpload.select_the_appropriate <strong>@GlobalShared.salary_type</strong> @GlobalPISalaryUpload.before_uploading_civil_servants.</li>
                            <li><i class="mdi mdi-view-list-outline text-primary me-2"></i> @GlobalShared.click_on_the <strong>@GlobalShared.ViewList</strong> @GlobalPISalaryUpload.button_to_access_all_previously_uploaded_salary_files.</li>
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalPISalaryUpload.double_check_files_for_formatting_errors.</li>
                            <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> @GlobalPISalaryUpload.keep_track_of_uploaded_files.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalPISalaryUpload.use_the_upload_form_to_add_new_salary_files.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-upload me-1"></i> @GlobalPISalaryUpload.salary_upload
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" href="/PISalaryUpload/UploadedSalaryFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>
                                            <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_SalaryUploadForm','new','PISalaryUpload')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalPISalaryUpload.upload_new_salary_file">
                                                <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.upload_new_file
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryUploadForm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
