
@using Resources


<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <!-- _NumconfogData.cshtml -->
            <table id="myDataTable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>@GlobalShared.Created_Date</th>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Branch</th>
                        <th>@GlobalNumConfig.bank_code_pos.</th>
                        <th>@GlobalNumConfig.branch_code_pos.</th>
                        <th>@GlobalNumConfig.year_pos.</th>
                        <th>@GlobalNumConfig.serial_pos.</th>
                        <th>@GlobalShared.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded by DataTables -->
                </tbody>
            </table>
        </div>
    </div>
</div>


