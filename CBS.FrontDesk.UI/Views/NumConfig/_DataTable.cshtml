@model List<CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeNumber.NumConfig>
@using Resources

<fieldset class="fieldset-custom">
    <div class="table-responsive">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Active</th>
                    <th>Variable Order</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var config in Model)
                {
                    <tr>
                        <td>@config.Name</td>
                        <td>@config.BranchId</td>
                        <td>
                            @if (config.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            @string.Join(" - ", config.Positions.OrderBy(p => p.Order).Select(p => p.VariableName))
                        </td>
                        <td class="text-center">
                            <a href="#"
                               onclick="AddORUpdateGen('@config.Id', 'datalistingview', '_Create', 'get', 'NumConfig')"
                               class="mr-2"
                               data-toggle="tooltip"
                               title="Edit @config.Name">Edit</a>

                            <a href="#"
                               onclick="DeleteRecordDataTable('NumConfig', '@config.Id', 'myDataTable', '_DataTable', 0, 'datalistingview', null,'list')"
                               class="mr-2 text-danger"
                               data-toggle="tooltip"
                               title="Delete @config.Name">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>
