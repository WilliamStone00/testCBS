@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.NumConfig

@{
    ViewBag.Title = "Cheque Number Configuration";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cog-outline me-2"></i> @ChequeManagements.chequeNumberConfiguration 
                </h1>
                <p class="card-text">
                    @ChequeManagements.chequeNumberConfigurationtext
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @ChequeManagements.numimp
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<!--tips-->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i>@ChequeManagements.tipCnum</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseChequeTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseChequeTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-cursor-move text-success me-2"></i>
                    <strong>  @ChequeManagements.DragDrop:</strong>   @ChequeManagements.Dragplaceholders<code>  @ChequeManagements.BranchCodenumtip</code>, <code> {@ChequeManagements.Year}</code>, <code>  {@ChequeManagements.Sequence}</code>)   @ChequeManagements.numtiptext1
                <li>
                    <i class="mdi mdi-eye text-info me-2"></i>
                    <strong>  @ChequeManagements.Preview:</strong>   @ChequeManagements.previewtext
                    @ChequeManagements.Example: <code> {@ChequeManagements.BranchCode}-{@ChequeManagements.Year}-{@ChequeManagements.Sequence}</code>.
                </li>
                <li>
                    <i class="mdi mdi-check-decagram text-warning me-2"></i>
                    <strong>  @ChequeManagements.Validation:</strong>   @ChequeManagements.numvaltext<code>{@ChequeManagements.Sequence}</code>)   @ChequeManagements.numtiptext2
                </li>
                <li>
                    <i class="mdi mdi-content-save text-primary me-2"></i>
                    <strong>  @ChequeManagements.Save:</strong>  @ChequeManagements.numtiptext3<strong>  @ChequeManagements.Reset</strong>  @ChequeManagements.numtiptext4
                </li>
                <li>
                    <i class="mdi mdi-refresh text-secondary me-2"></i>
                    <strong>  @ChequeManagements.Reorder:</strong>  @ChequeManagements.numtiptext5
                </li>
            </ul>
        </div>
    </div>
</div>


<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Configurations</h5>
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a type="button"
               onclick="LoadDataGen('NumConfig', 'myDataTable', 'List', 0, 'datalistingview', null, 'list')"
               class="btn btn-label-primary btn-sm me-2"
               data-bs-toggle="tooltip" title="View List">
                <i class="mdi mdi-view-list mdi-18px"></i>  @ChequeManagements.ViewList
            </a>
            <a type="button"
               onclick="AddORUpdateGen(null,'datalistingview','_Create','new','NumConfig')"
               class="btn btn-label-secondary btn-sm"
               data-bs-toggle="tooltip" title="Add New Configuration">
                <i class="mdi mdi-plus mdi-18px"></i>  @ChequeManagements.AddConfiguration
            </a>
        </div>
    </div>

    <!-- Placeholder for modals/forms -->
    @Html.Partial("_model")

    <!-- DataTable Partial -->
    <div id="datalistingview">
        @Html.Partial("_Create",Model)
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script src="~/Scripts/Js/Crud/ChequeManagement/numconfig/Numconfog.js"></script>

    <script>

        // Toggle numeric inputs
        document.getElementById('toggleNumericPositions').addEventListener('change', function () {
            document.getElementById('numericPositions').style.display = this.checked ? 'flex' : 'none';
        });

        // Drag-and-drop logic
        const dragZone = document.getElementById('dragZone');
        let draggedItem = null;

        function updateNumericPositionsFromDrag() {
            const items = [...dragZone.querySelectorAll('.draggable')];
            items.forEach((item, index) => {
                const varName = item.dataset.variable;
                switch (varName) {
                    case 'BankCode': document.getElementById('bankCodePosition').value = index + 1; break;
                    case 'BranchCode': document.getElementById('branchCodePosition').value = index + 1; break;
                    case 'Year': document.getElementById('yearPosition').value = index + 1; break;
                    case 'SerialNumber': document.getElementById('seriaNumberPosition').value = index + 1; break;
                }
            });
        }

        dragZone.querySelectorAll('.draggable').forEach(item => {
            item.setAttribute('draggable', true);

            item.addEventListener('dragstart', () => {
                draggedItem = item;
                setTimeout(() => item.style.opacity = '0.4', 0);
            });

            item.addEventListener('dragend', () => {
                draggedItem.style.opacity = '1';
                draggedItem = null;
                updateNumericPositionsFromDrag(); // update numeric positions on drag end
            });
        });

        dragZone.addEventListener('dragover', e => {
            e.preventDefault();
            const afterElement = getDragAfterElement(dragZone, e.clientX);
            if (!afterElement) dragZone.appendChild(draggedItem);
            else dragZone.insertBefore(draggedItem, afterElement);
        });

        function getDragAfterElement(container, x) {
            const draggableElements = [...container.querySelectorAll('.draggable')].filter(el => el !== draggedItem);
            let closest = null;
            let offset = Number.NEGATIVE_INFINITY;
            draggableElements.forEach(child => {
                const box = child.getBoundingClientRect();
                const off = x - box.left - box.width / 2;
                if (off < 0 && off > offset) { offset = off; closest = child; }
            });
            return closest;
        }

        function NumconfogSyncBeforeSubmit(form) {
            updateNumericPositionsFromDrag(); // ensure numeric positions always reflect drag order
            return true;
        }

        // Initial sync in case editing an existing config
        updateNumericPositionsFromDrag();
    </script>

}
