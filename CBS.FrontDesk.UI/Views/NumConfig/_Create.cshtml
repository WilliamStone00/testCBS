@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.NumConfig
@using Resources

<div class="modal-body">
    @using (Html.BeginForm("CreateOrUpdate", "NumConfig", FormMethod.Post, new { id = "manualForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @*@Html.AntiForgeryToken()*@
        @*@Html.HiddenFor(m => m.Id)*@

        <div class="mt-2">
            <h4 class="mb-3 text-primary">@ChequeManagements.configName</h4>

            <div class="row g-2">
                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Configuration name", id = "name" })
                        <label>@ChequeManagements.configName</label>
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- " + @GlobalUserManagement.SelectBranch + " ---",
                            new { @class = "form-control select2", id = "branchId" })
                        <label>@GlobalUserManagement.SelectBranch</label>
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <hr />

            <h5 class="mb-2">Number Components & Positions</h5>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="toggleNumericPositions" />
                <label class="form-check-label fw-bold" for="toggleNumericPositions">
                    Show numeric position inputs
                </label>
            </div>

            <div id="numericPositions" class="row g-2 mb-2" style="display:none;">
                <div class="col-md-3">
                    <label class="form-label">Bank Code Position</label>
                    @Html.TextBoxFor(m => m.BankCodePosition, new { type = "number", @class = "form-control", id = "bankCodePosition", min = "0" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Branch Code Position</label>
                    @Html.TextBoxFor(m => m.BranchCodePosition, new { type = "number", @class = "form-control", id = "branchCodePosition", min = "0" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Year Position</label>
                    @Html.TextBoxFor(m => m.YearPosition, new { type = "number", @class = "form-control", id = "yearPosition", min = "0" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Serial Number Position</label>
                    @Html.TextBoxFor(m => m.SeriaNumberPosition, new { type = "number", @class = "form-control", id = "seriaNumberPosition", min = "0" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AcceptSerialNumber, new { @class = "form-check-input", id = "acceptSerialNumber" })
                        <label class="form-check-label fw-bold ms-2" for="acceptSerialNumber">Accept Serial Number</label>
                    </div>
                </div>
            </div>

            <p class="mb-1">Arrange components visually (drag to reorder). Drag-and-drop overrides numeric inputs automatically.</p>

            <div id="dragZone" class="drag-zone mb-3">
                <div class="draggable" data-variable="BankCode">🏦 Bank Code</div>
                <div class="draggable" data-variable="BranchCode">🏢 Branch Code</div>
                <div class="draggable" data-variable="Year">📅 Year</div>
                <div class="draggable" data-variable="SerialNumber">#️⃣ Serial Number</div>
            </div>

            <div class="text-end">
                @if (Model?.Id == null)
                {
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> @ChequeManagements.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2"><i class="mdi mdi-refresh"></i> @GlobalBank.Update</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                }
            </div>
        </div>
    }
</div>

<style>
    .drag-zone {
        display: flex;
        gap: 10px;
        padding: 12px;
        border: 2px dashed #0d6efd;
        border-radius: 8px;
        background: #f8f9fa;
        min-height: 70px;
        align-items: center;
    }

    .draggable {
        padding: 8px 12px;
        background: #e9ecef;
        border-radius: 6px;
        cursor: grab;
        user-select: none;
        border: 1px solid #ced4da;
    }

        .draggable:active {
            cursor: grabbing;
            background: #d6e4ff;
        }

    #numericPositions {
        display: none;
    }

    #toggleNumericPositions:checked ~ #numericPositions {
        display: flex; /* or block, depending on your layout */
    }

</style>


