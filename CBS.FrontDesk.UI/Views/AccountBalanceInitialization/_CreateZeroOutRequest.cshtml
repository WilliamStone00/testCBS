@model CBS.FrontDesk.Data.AccountBalanInitConfiguration

<div class="modal-body bg-light card-border-shadow-dark">
    @using (Html.BeginForm("CreateZeroOutRequest", "AccountBalanceInitialization", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPosting(this);" }))
    {
        @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

        <div class="row gy-3">

            <!-- 🏢 Branch Selection -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pt-2 pb-1">
                    <i class="mdi mdi-office-building-marker-outline me-1"></i> Branch & Account Type
                </h6>
            </div>

            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.InitInfoDto.BranchId, new SelectList(ViewBag.Branches, "Value", "Text"), "--- Select Branch ---", new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(m => m.InitInfoDto.BranchId, "", new { @class = "text-danger" })
                    <label>Branch</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.InitInfoDto.ProductId, new SelectList(ViewBag.AccountTypes, "Value", "Text"), "--- Select Account Type ---", new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(m => m.InitInfoDto.ProductId, "", new { @class = "text-danger" })
                    <label>Account Type</label>
                </div>
            </div>

            <!-- ✅ Submit -->
            <div class="col-12 text-end mt-3">
                <button type="submit" class="btn btn-primary shadow-sm px-4">
                    <i class="fas fa-check-circle me-1"></i> Submit Initialization
                </button>
                <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                    Reset
                </button>
            </div>

        </div> <!-- .row -->
    }
</div>
