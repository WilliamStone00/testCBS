<table class="table table-bordered table-striped" id="depositTable">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Transaction ID</th>
            <th>Account</th>
            <th>Holder</th>
            <th>Total Amount</th>
            <th>Branch</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div class="modal fade" id="postingDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6"><strong>Transaction Ref:</strong> <span id="modalRef"></span></div>
                    <div class="col-md-6"><strong>Date:</strong> <span id="modalDate"></span></div>
                    <div class="col-md-6"><strong>Account:</strong> <span id="modalAccount"></span></div>
                    <div class="col-md-6"><strong>Holder:</strong> <span id="modalHolder"></span></div>
                    <div class="col-md-6"><strong>Product:</strong> <span id="modalProduct"></span></div>
                    <div class="col-md-6"><strong>Branch:</strong> <span id="modalBranch"></span></div>
                </div>
                <hr />
                <h6>Amount Collections</h6>
                <table class="table table-bordered table-sm">
                    <thead class="table-secondary">
                        <tr>
                            <th>Event</th>
                            <th>Liaison</th>
                            <th>Amount (XAF)</th>
                            <th>Principal</th>
                            <th>Narration</th>
                        </tr>
                    </thead>
                    <tbody id="modalAmounts"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
 
