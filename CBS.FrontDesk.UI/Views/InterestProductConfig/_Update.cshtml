

@model CBS.FrontDesk.Data.Entity.AccountingV2.InterestProductConfig.ProductCalculationConfig
@using Resources
@using (Html.BeginForm("CreateOrUpdate", "InterestProductConfig", FormMethod.Post,
new { id = "ProductCalculationConfigForm", enctype = "multipart/form-data", onsubmit = "return SaveInterestProductConfigAjax(this);" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "Id" })


    <div class="container mt-2">

        <!-- HEADER -->
        <div class="card bg-light mb-3">
            <div class="card-body text-center">
                <h3 class="card-title btn-text-primary">
                    <i class="mdi mdi-cog-outline me-2"></i>
                    @(Model.Id == null ? ""+ @GlobalInterestProductConfig.ADD_PRODUCT_CALCULATION_CONFIG + "" : ""+ @GlobalInterestProductConfig.UPDATE_PRODUCT_CALCULATION_CONFIG + "")
                </h3>
                <p class="card-text">
                    @(Model.Id == null
                    ? ""+ @GlobalInterestProductConfig.Fill_in_the_details_to_create_a_new_product_calculation_configuration + ""
                    : ""+ @GlobalInterestProductConfig.Modify_the_details_below_and_update_this_configuration + "")
                </p>
                <hr style="border: 2px solid rgba(128,128,128,0.5);" />
            </div>
        </div>

        <!-- FORM BODY -->
        <div class="card mb-3">
            <div class="card-body">

                <!-- BASIC -->
                <h6 class="mb-3 text-primary">@GlobalShared.Basic_Information</h6>
                <div class="row g-3 mb-4">

                    <div class="col-md-6 mb-1">

                        <div class="position-relative">
                            @Html.LabelFor(m => m.ProductId, "Product",
                                new { @class = "form-label fw-bold" })

                            @Html.DropDownListFor(
                                m => m.ProductId,
                                ViewBag.Products as List<SelectListItem>,
                                "-- "+ GlobalShared.Select_product + "--",
                                new { @class = "form-control  select2" }
                            )
                            @Html.HiddenFor(m => m.ProductName)
                        </div>
                    </div>


                    <div class="col-md-6 mb-1">

                        <div class="position-relative">
                            <label class="form-label fw-bold" for="branchId">@GlobalShared.Branch</label>
                            @Html.DropDownList("BranchId",
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                "---" +GlobalShared.Select_Branch +"---",
                                new { @class = "form-control select2 mb-1", @id = "branchId" })
                        </div>
                    </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsEnabled, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsEnabled, "Enabled",
                                    new { @class = "form-check-label fw-bold" })
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GlobalConfiguration">
                                <label class="form-check-label" for="GlobalConfiguration">
                                    @GlobalShared.Global_Configuration
                                </label>
                            </div>

                        </div>
                </div>

                    <!-- FREQUENCY -->
                    <h6 class="mb-3 text-primary">@GlobalInterestProductConfig.Period_And_Frequency</h6>

                    <div class="row g-3 mb-4" id="frequencyFields">
                        <div class="col-md-6 mb-1">
                            <div class="position-relative">
                                <label class="form-label fw-bold">@GlobalInterestProductConfig.Interest_Frequency</label>
                                @Html.DropDownList("Frequency",
                                    new SelectList(ViewBag.Frequency, "Value", "Text"),
                                    "------"+  @GlobalShared.Select_Frequency  +"------",
                                    new { @class = "form-control select2 mb-1", @id = "Frequency" })
                            </div>
                        </div>

                            <div class="col-md-6 mb-1" id="calcDayMonth">
                                @Html.LabelFor(m => m.CalculationDayOfMonth, ""+ GlobalShared.Calculation_Day (GlobalShared.Month)+"",
                                    new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.CalculationDayOfMonth,
                                    new { @class = "form-control", type = "number" })
                            </div>

                            <div class="col-md-6 mb-1" id="weekField">
                                @Html.LabelFor(m => m.CalculationDayOfWeek, ""+ GlobalShared.Calculation_Day (GlobalShared.Week)+"",
                                    new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.CalculationDayOfWeek,
                                    new { @class = "form-control" })
                            </div>


                            <div class="col-md-6 mb-1" id="firstCalcMonth">
                                @Html.LabelFor(m => m.FirstCalculationMonth, ""+ @GlobalInterestProductConfig.First_Calculation_Month + "",
                                    new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.FirstCalculationMonth,
                                    new { @class = "form-control", type = "number" })
                            </div>

                    </div>

                        <!-- COMPUTATION -->
                    <h6 class="mb-3 text-primary">@GlobalInterestProductConfig.Computation</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4 mb-1">
                                <div class="position-relative">
                                    <label class="form-label fw-bold">@GlobalInterestProductConfig.Computation_Mode</label>
                                    @Html.DropDownList("ComputationMode",
                                        new SelectList(ViewBag.ComputationMode, "Value", "Text"),
                                        "------"+ @GlobalInterestProductConfig.Select_Computation_Mode + "------",
                                        new { @class = "form-control select2 mb-1", @id = "ComputationMode" })
                                </div>
                            </div>
                                <!-- Day fields (only for Average of Points) -->
                                <div class="col-md-4" id="day1Field">
                                    @Html.LabelFor(m => m.Day1, ""+ GlobalShared.Day +"1"+ (@GlobalInterestProductConfig.for_Average_of_Points) +"",
                                        new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.Day1,
                                        new { @class = "form-control", placeholder = "e.g. 1" })
                                </div>

                                <div class="col-md-4" id="day2Field">
                                    @Html.LabelFor(m => m.Day2, ""+ GlobalShared.Day +"2"+ (@GlobalInterestProductConfig.for_Average_of_Points) +"",
                                        new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.Day2,
                                        new { @class = "form-control", placeholder = "e.g. 15" })
                                </div>

                                <!-- ShareMonthFactor & CustomDenominator (always visible) -->
                                <div class="col-md-4" id="shareMonthFactorField">
                                    @Html.LabelFor(m => m.ShareMonthFactor, ""+ @GlobalInterestProductConfig.Share_Month_Factor + "",
                                        new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.ShareMonthFactor,
                                        new { @class = "form-control", type = "number", step = "0.01" })
                                </div>

                                <div class="col-md-4" id="customDenominatorField">
                                    @Html.LabelFor(m => m.CustomDenominator, ""+ @GlobalInterestProductConfig.Custom_Denominator + "",
                                        new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.CustomDenominator,
                                        new { @class = "form-control", type = "number" })
                                </div>

                        </div>

                        <h6 class="mb-3 text-primary">@GlobalInterestProductConfig.Share_Month_Configuration</h6>

                            <div class="row">

                                <!-- CHECKBOX -->
                                <div class="col-md-12 mb-2">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.IsShareMonthProduct,
                                            new { @class = "form-check-input", id = "IsShareMonthProduct" }
                                        )
                                        @Html.LabelFor(
                                            m => m.IsShareMonthProduct,
                                            "Is Share Month Product",
                                            new { @class = "form-check-label fw-bold" }
                                        )
                                    </div>
                                </div>

                                <!-- SHARE MONTH MODE -->
                                <div class="position-relative">
                                    <div class="col-md-12 mb-1 d-none" id="shareMonthModeWrapper">
                                        <label class="form-label fw-bold">@GlobalInterestProductConfig.Share_Month_Mode</label>
                                        @Html.DropDownList(
                                            "ShareMonthMode",
                                            new SelectList(ViewBag.ShareMonthMode, "Value", "Text"),
                                            "------"+ @GlobalInterestProductConfig.Select_Share_Month_Mode + "------",
                                            new { @class = "form-control select2", id = "ShareMonthMode" }
                                        )
                                    </div>
                                </div>
                                    <!-- SHARE MONTH AVERAGE DAYS -->
                                    <div class="col-md-6 d-none" id="shareMonthAverageWrapper">
                                        @Html.LabelFor(
                                            m => m.ShareMonthAverageDaysCsv,
                                            ""+ @GlobalInterestProductConfig.Share_Month_Average_Days + "(CSV)",
                                            new { @class = "form-label fw-bold" }
                                        )
                                        @Html.TextBoxFor(
                                            m => m.ShareMonthAverageDaysCsv,
                                            new { @class = "form-control", placeholder = "e.g. 30,31,28,29" }
                                        )
                                    </div>

                                    <!-- SHARE MONTH FACTOR -->
                                    <div class="col-md-6 d-none" id="shareMonthFactorWrapper">
                                        @Html.LabelFor(
                                            m => m.ShareMonthFactorOverride,
                                            ""+ @GlobalInterestProductConfig.Share_Month_Factor_Override + "",
                                            new { @class = "form-label fw-bold" }
                                        )
                                        @Html.TextBoxFor(
                                            m => m.ShareMonthFactorOverride,
                                            new { @class = "form-control", type = "number", step = "0.0001", min = "0" }
                                        )
                                    </div>

                            </div>



                                <!-- RATE -->
                            <h6 class="mb-3 text-primary">@GlobalShared.Rate_Configuration</h6>
                                <div class="row g-3 mb-4" id="RateConfigContainer">
                                    <div class="position-relative">
                                        <div class="col-md-12 mb-1">
                                            <label class="form-label fw-bold">@GlobalShared.Rate_Source</label>
                                            @Html.DropDownList("RateSource",
                                                new SelectList(ViewBag.RateSource, "Value", "Text"),
                                                "------"+ @GlobalInterestProductConfig.Select_Rate_Source + "------",
                                                new { @class = "form-control select2 mb-1", @id = "RateSource" })
                                        </div>
                                    </div>
                                        <div class="col-md-6" id="FixedRateDiv">
                                            @Html.LabelFor(m => m.FixedRate, "Fixed Rate", new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.FixedRate, new { @class = "form-control", type = "number", step = "0.0001" })
                                        </div>

                                        <div class="col-md-6" id="RateProfileDiv">
                                            @Html.LabelFor(m => m.RateProfileCode, ""+ @GlobalInterestProductConfig.Rate_Profile_Code + "", new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.RateProfileCode, new { @class = "form-control" })
                                        </div>
                                </div>
                                    <h6 class="mb-3 text-primary">@GlobalShared.Tax_Configuration</h6>
                                    <div class="row g-3 mb-4">
                                        <div class="form-check col-md-4">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.ApplyRti, new { @class = "form-check-input", id = "ApplyRti" })
                                                @Html.LabelFor(m => m.ApplyRti, ""+ @GlobalInterestProductConfig.Apply_RTI_Revenue_Tax_on_Interest + "", new { @class = "form-check-label fw-bold" })
                                            </div>


                                        </div>

                                        <div class="col-md-4" id="RtiRateOverrideDiv">
                                            @Html.LabelFor(m => m.RtiRateOverride, ""+ @GlobalInterestProductConfig.RTI_Rate_Override + "", new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.RtiRateOverride, new { @class = "form-control", placeholder = "e.g 0.165 for 16.5%" })
                                        </div>
                                        <div class="form-check col-md-4">

                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.ApplyTprcm, new { @class = "form-check-input", id = "ApplyTprcm" })
                                                @Html.LabelFor(m => m.ApplyTprcm, ""+ @GlobalInterestProductConfig.Apply_TPRCM_IRCM_Tax + "", new { @class = "form-check-label fw-bold" })
                                            </div>

                                        </div>
                                        <div class="col-md-4" id="TprcmRateOverrideDiv">
                                            @Html.LabelFor(m => m.TprcmRateOverride, "TPRCM Rate Override", new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.TprcmRateOverride, new { @class = "form-control", placeholder = "e.g 0.05 for 5%" })
                                        </div>

                                        <div class="col-md-4" id="TaxableThresholdOverrideDiv">
                                            @Html.LabelFor(m => m.TaxableThresholdOverride, ""+ @GlobalInterestProductConfig.Taxable_Threshold_Override + "", new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.TaxableThresholdOverride, new { @class = "form-control", placeholder = "e.g 10000" })
                                        </div>

                                    </div>

                                    <!-- LIMITS -->
                                    <h6 class="mb-3 text-primary">@GlobalInterestProductConfig.Limits_Rules</h6>
                                    <div class="row g-3">

                                        <div class="col-md-6">
                                            @Html.LabelFor(m => m.MinBalanceForInterest, ""+ @GlobalInterestProductConfig.Minimum_Balance_for_Interest + "",
                                                new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.MinBalanceForInterest,
                                                new { @class = "form-control", type = "number", step = "0.01" })
                                        </div>

                                        <div class="col-md-6">
                                            @Html.LabelFor(m => m.MaxBalanceForInterest, ""+ @GlobalInterestProductConfig.Maximum_Balance_for_Interest + "",
                                                new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.MaxBalanceForInterest,
                                                new { @class = "form-control", type = "number", step = "0.01" })
                                        </div>

                                    </div>

            </div>
        </div>

        <!-- SAVE / UPDATE -->
        <div class="text-end">
            <button type="button" class="btn btn-primary btn-save"
                    onclick="SaveInterestProductConfigAjax(this.form)">
                <i class="mdi mdi-content-save-outline me-1"></i>
                @(Model.Id == null ? ""+ GlobalShared.Save +"" : ""+ GlobalShared.Update +"")
            </button>
        </div>

    </div>


}
