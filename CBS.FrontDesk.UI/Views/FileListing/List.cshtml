@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.FileListingQuery
@using Resources
@{
    ViewBag.Title = "Reconciliation File Listing Overview - Filters";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 p-2">
            <div class="card-body text-center py-2">
                <h1 class="card-title text-primary mb-1">
                    <i class="mdi mdi-account-group me-2"></i>Reconciliation Listing
                </h1>
                <p class="card-text small mb-1">
                    @AccountingV2.AffiliateManagementtext
                </p>
                <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary py-1">
        <span class="small"><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body small py-2">
            <ul class="mb-0">
                <li class="mb-1"><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@AccountingV2.Code:</strong> @AccountingV2.codetext</li>
                <li class="mb-1"><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>@AccountingV2.Name:</strong> @AccountingV2.Nametext</li>
                <li class="mb-1"><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>@AccountingV2.Status:</strong> @AccountingV2.Statustext</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>@AccountingV2.CreatedDates:</strong> @AccountingV2.CreatedDatestext</li>
            </ul>
        </div>
    </div>
</div>

<!-- Filters (rearranged, compact spacing) -->
<div class="card shadow p-2 mb-3">
    <h5 class="text-primary mb-2 small">
        <i class="mdi mdi-filter-outline me-1"></i> Filters
    </h5>

    <form id="affiliateFilterForm" autocomplete="off" method="get" action="@Url.Action("Index")" class="mb-0">
        <div class="card p-2 mb-2 bg-light">
            <div class="row mb-2 g-1">

                <!-- Branch (full width) -->
                <div class="col-md-12">
                    @Html.LabelFor(m => m.BranchId, "Branch", new { @class = "form-label small mb-1" })
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- " + @GlobalUserManagement.SelectBranch + " ---",
                        new { @class = "form-select select2 form-select-sm", id = "BranchId", @aria_label = "Branch" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
                </div>

                <!-- Category label above (full width) -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small mb-1" for="Category">Category</label>
                    <select id="Category" name="Category" class="form-select select2 form-select-sm">
                        <option value="">@AccountingV2.All</option>
                        <option value="Branch">Branch</option>
                        <option value="Affiliate">Affiliate</option>
                    </select>
                </div>

                <!-- Status (half width) -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small mb-1" for="Status">@AccountingV2.Status</label>
                    <select id="Status" name="Status" class="form-select select2 form-select-sm">
                        <option value="">@AccountingV2.All</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                    </select>
                </div>

                <!-- Created Date toggle + tip (half width) -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check me-2">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates" />
                        <label class="form-check-label small" for="toggleCreatedDates">@AccountingV2.ShowCreatedDateFilters</label>
                    </div>
                    <small class="text-muted ms-auto">@AccountingV2.Affiliatetext1</small>
                </div>
            </div>

            <!-- CreatedFromUtc, CreatedToUtc (hidden by toggle) -->
            <div id="createdDateFilters" class="d-none">
                <div class="row mb-2 g-1">
                    <div class="col-md-6">
                        <label class="form-label small mb-1" for="CreatedFromUtc">@AccountingV2.CreatedFrom (UTC)</label>
                        <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1" for="CreatedToUtc">@AccountingV2.CreatedTo (UTC)</label>
                        <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-1">
            <div class="col-md-6 pe-1">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
            </div>
            <div class="col-md-6 ps-1">
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial placeholder -->
<div id="datalistingview">
    @Html.Partial("_Data")
</div>

<!-- DETAILS modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-1">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX injects here --></div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT modal -->
<div class="modal fade" id="affiliateEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-1">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX injects here --></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function ($) {
      'use strict';

      // ---------- ROUTES ----------
      const dataUrl     = '@Url.Action("LoadData", "FileListing")';
      const detailUrl   = '@Url.Action("Details", "FileListing")';
      const initUrl     = '@Url.Action("InitializeFile", "FileListing")';
      const deleteUrl   = '@Url.Action("DeleteFile", "FileListing")';
      const downloadUrl = '@Url.Action("DownloadFile", "FileListing")';

      // ---------- STATE ----------
      let table = null;
      let tableInitialized = false;

      // ---------- UTIL ----------
      function safeParseUnobtrusive($scope) {
        try {
          if ($.validator && $.validator.unobtrusive && typeof $.validator.unobtrusive.parse === 'function') {
            $.validator.unobtrusive.parse($scope);
            return true;
          }
        } catch (e) { console.warn('unobtrusive.parse failed', e); }
        return false;
      }

      // ---------- FILTERS ----------
      function getFilters() {
        const createdFrom = $('#CreatedFromUtc').val();
        const createdTo   = $('#CreatedToUtc').val();
        const categoryRaw = $('#Category').val();
        const statusRaw   = $('#Status').val();

        return {
          DataTableOptions: {},
          BranchId: $('#BranchId').val() || null,
          Category: categoryRaw || null,
          Status: statusRaw || null,
          CreatedFromUtc: createdFrom || null,
          CreatedToUtc: createdTo || null,
          IncludeDeleted: $('#IncludeDeleted').is(':checked'),
          SearchText: $.trim($('#SearchText').val()) || null
        };
      }

      // ---------- MODALS ----------
      function showModalLoading(modalId) {
        $(modalId + ' .modal-body').html(
          '<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>'
        );
        (bootstrap.Modal.getInstance($(modalId)[0]) ||
          new bootstrap.Modal($(modalId)[0], { backdrop: 'static' })
        ).show();
      }

      function loadIntoModal(modalId, url, data, onSuccess) {
        showModalLoading(modalId);
        $.get(url, data)
          .done(function (html) {
            $(modalId + ' .modal-body').html(html);
            if (onSuccess) onSuccess(modalId);
          })
          .fail(function () {
            $(modalId + ' .modal-body')
              .html('<div class="p-3 text-danger">Unable to load content. Please try again.</div>');
          });
      }

      function wireModalFormSubmit($modal) {
        $modal.off('submit', 'form').on('submit', 'form', function (e) {
          if (typeof window.AjaxPost === 'function') {
            return window.AjaxPost(this);
          }

          e.preventDefault();
          const $form = $(this);
          safeParseUnobtrusive($form);

          const hasFiles = ($form.attr('enctype') || '').toLowerCase().includes('multipart');
          const ajaxOptions = {
            url: $form.attr('action'),
            type: ($form.attr('method') || 'POST').toUpperCase(),
            success: function (res) {
              if (res && typeof res === 'object' && ('success' in res)) {
                if (res.success) {
                  try { bootstrap.Modal.getInstance($modal[0]).hide(); } catch (_) { $modal.modal('hide'); }
                  reloadTable();
                } else {
                  $modal.find('.modal-body').prepend(
                    `<div class="alert alert-danger mb-2">${res.message || 'Save failed'}</div>`
                  );
                }
              } else {
                $modal.find('.modal-body').html(res);
                safeParseUnobtrusive($modal);
                wireModalFormSubmit($modal);
              }
            },
            error: function () {
              $modal.find('.modal-body').prepend(
                '<div class="alert alert-danger mb-2">Submit failed. Try again.</div>'
              );
            }
          };

          if (hasFiles) {
            const fd = new FormData($form[0]);
            ajaxOptions.data = fd;
            ajaxOptions.processData = false;
            ajaxOptions.contentType = false;
          } else {
            ajaxOptions.data = $form.serialize();
          }

          $.ajax(ajaxOptions);
          return false;
        });
      }

      // ---------- ROW ACTIONS ----------
      function actionButtons(row) {
        const id = encodeURIComponent(String(row.Id || ''));
        const name = String(row.FileName || row.Name || '').replace(/"/g, '&quot;');
        const btnId = 'act_' + (row.Id || Math.random().toString(36).slice(2));
        const downloadLink = downloadUrl + '?id=' + id;

        return `
          <div class="dropdown text-center">
            <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button"
                    id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="mdi mdi-cog-outline"></i> Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="${btnId}">
              <li>
                <button type="button" class="dropdown-item btn-detail" data-id="${id}" title="Details &quot;${name}&quot;">
                  <i class="mdi mdi-eye me-1 text-primary"></i> Details
                </button>
              </li>
              <li>
                <a class="dropdown-item" href="${downloadLink}" target="_blank" title="Download &quot;${name}&quot;">
                  <i class="mdi mdi-download me-1 text-success"></i> Download
                </a>
              </li>
              <li>
                <button type="button" class="dropdown-item btn-delete" data-id="${id}" title="Delete &quot;${name}&quot;">
                  <i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete
                </button>
              </li>
            </ul>
          </div>
        `;
      }

        function mapFileUploadStatus(value) {
            if (value == null) return { label: 'Unknown', class: 'bg-secondary' };

            const v = String(value).trim().toLowerCase();

            switch (v) {
                case '1':
                case 'received':
                    return { label: 'Received', class: 'bg-primary' };
                case '2':
                case 'validating':
                    return { label: 'Validating', class: 'bg-warning text-dark' };
                case '3':
                case 'parsed':
                    return { label: 'Parsed', class: 'bg-info' };
                case '4':
                case 'mapped':
                    return { label: 'Mapped', class: 'bg-info' };
                case '5':
                case 'processing':
                    return { label: 'Processing', class: 'bg-warning text-dark' };
                case '6':
                case 'completed':
                    return { label: 'Completed', class: 'bg-success' };
                case '7':
                case 'failed':
                    return { label: 'Failed', class: 'bg-danger' };
                case '8':
                case 'cancelled':
                case 'canceled':
                    return { label: 'Cancelled', class: 'bg-secondary' };
                default:
                    return { label: String(value), class: 'bg-secondary' };
            }
        }

        function mapReconciliationStatus(value) {
            if (value == null) return { label: 'Unknown', class: 'bg-secondary' };

            const v = String(value).trim().toLowerCase();

            switch (v) {
                case '0':
                case 'notstarted':
                case 'not_started':
                case 'not started':
                    return { label: 'Not Started', class: 'bg-secondary' };
                case '1':
                case 'pending':
                    return { label: 'Pending', class: 'bg-warning text-dark' };
                case '2':
                case 'partialinitiation':
                case 'partial_initiation':
                case 'partial initiation':
                    return { label: 'Partial Initiation', class: 'bg-info' };
                case '3':
                case 'finalinitiation':
                case 'final_initiation':
                case 'final initiation':
                    return { label: 'Final Initiation', class: 'bg-primary' };
                case '4':
                case 'reconciled':
                    return { label: 'Reconciled', class: 'bg-success' };
                default:
                    return { label: String(value), class: 'bg-secondary' };
            }
        }

        function mapFileUploadCategory(value) {
            if (value == null) return { label: 'Unknown', class: 'bg-secondary' };
            const v = String(value).trim().toLowerCase();

            switch (v) {
                case '1':
                case 'hocoa':
                case 'ho_coa':
                    return { label: 'HoCoa', class: 'bg-primary' };
                case '2':
                case 'affiliatecoa':
                case 'affiliate_coa':
                    return { label: 'AffiliateCoa', class: 'bg-info' };
                case '3':
                case 'branchcoa':
                case 'branch_coa':
                    return { label: 'BranchCoa', class: 'bg-info' };
                case '4':
                case 'trialbalance':
                case 'trial_balance':
                    return { label: 'Trial Balance', class: 'bg-warning text-dark' };
                case '5':
                case 'memberbalances':
                case 'member_balances':
                    return { label: 'Member Balances', class: 'bg-success' };
                case '6':
                case 'postingrules':
                    return { label: 'Posting Rules', class: 'bg-secondary' };
                case '7':
                case 'branchcashconfig':
                    return { label: 'Branch Cash Config', class: 'bg-secondary' };
                case '8':
                case 'liaisonmapping':
                    return { label: 'Liaison Mapping', class: 'bg-secondary' };
                case '99':
                case 'other':
                    return { label: 'Other', class: 'bg-dark' };
                case '100':
                case 'affiliateaccount':
                case 'affiliate_account':
                    return { label: 'Affiliate Account', class: 'bg-info' };
                default:
                    return { label: String(value), class: 'bg-secondary' };
            }
        }

      // ---------- DATATABLE ----------
      function initDataTable() {
        const selector = '#myDataTable';
        if ($.fn.DataTable.isDataTable(selector)) {
          try { $(selector).DataTable().destroy(); } catch(e){ console.warn('destroy failed', e); }
          $(selector + ' tbody').empty();
        }

        table = $(selector).DataTable({
          serverSide: true,
          responsive: true,
          autoWidth: false,
          pageLength: 10,
          order: [[0, 'desc']],
          columnDefs: [
            { targets: 0, width: '18%' },
            { targets: 1, width: '25%' },
            { targets: 2, width: '21%' },
            { targets: 3, width: '13%' },
            { targets: 4, width: '13%' },
            { targets: 5, width: '10%', className: 'text-end', orderable: false, searchable: false }
          ],
          ajax: {
            url: dataUrl,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: function (d) {
              const filters = getFilters();
              filters.DataTableOptions = {
                draw: d.draw,
                start: d.start,
                length: d.length,
                searchValue: d.search?.value || '',
                sortColumnName: '',
                sortColumnDirection: ''
              };
              return JSON.stringify(filters);
            },
            dataSrc: function (json) {
              if (!json) return [];
              if (Array.isArray(json.data)) return json.data;
              if (Array.isArray(json.result)) return json.result;
              return [];
            },
            error: function () {
              $(selector + ' tbody').html('<tr><td colspan="6" class="text-center text-danger">Failed to load data.</td></tr>');
            }
          },
          columns: [
            {
              data: 'CreatedDate',
              render: function (data, type, row) {
                const v = row.CreatedDate || row.CreatedOn;
                return v ? (window.moment ? moment(v).format('DD/MM/YYYY HH:mm:ss') : v) : '-';
              }
            },
            {
              data: 'OriginalFileName',
              render: function (data, type, row) {
                  return row.OriginalFileName || row.OriginalFileName || '';
              }
            },
              {
                  data: 'Category',
                  render: function (data, type, row) {
                      const info = mapFileUploadCategory(data);
                      return `<span class="badge ${info.class}">${info.label}</span>`;
                  }
              },
              {
                  data: 'BranchName',
                  render: function (data, type, row) {
                      const info = mapFileUploadCategory(data);
                      return `<span class="badge ${info.class}">${info.label}</span>`;
                  }
              },
              {
                  data: 'Status',
                  render: function (data, type, row) {
                      // data could be numeric (1..8) or string ('Completed')
                      const info = mapFileUploadStatus(data);
                      return `<span class="badge ${info.class}">${info.label}</span>`;
                  }
              },
              {
                  data: 'ReconciliationStatus',
                  render: function (data, type, row) {
                      const info = mapReconciliationStatus(data);
                     return `<span class="badge ${info.class}">${info.label}</span>`;
                  }
              },
            {
              data: null,
              orderable: false,
              searchable: false,
              className: 'text-end',
              render: (d, t, row) => actionButtons(row)
            }
          ],
          language: { emptyTable: 'No files found' }
        });

        tableInitialized = true;
      }

      function reloadTable() {
        if (!tableInitialized) {
          initDataTable();
        } else if (table && table.ajax) {
          table.ajax.reload(null, false);
        }
      }

      // ---------- INIT + EVENTS ----------
      $(document).ready(function () {
        if ($.fn.select2) {
          try { $('#BranchId,#Category,#Status').select2({ width: '100%' }); } catch(e){}
        }

        $('#toggleCreatedDates').on('change', function () {
          if ($(this).is(':checked')) $('#createdDateFilters').removeClass('d-none');
          else $('#createdDateFilters').addClass('d-none');
        });

        $('#applyAffiliateFilterBtn').on('click', function (e) {
          e.preventDefault();
          reloadTable();
        });

        $('#resetAffiliateFilterBtn').on('click', function () {
          $('#affiliateFilterForm')[0].reset();
          if ($.fn.select2) {
            try { $('#BranchId,#Category,#Status').val(null).trigger('change'); } catch(_){}
          }
          $('#createdDateFilters').addClass('d-none');
          reloadTable();
        });

        $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
          if (e.which === 13) { e.preventDefault(); reloadTable(); }
        });

        // Upload File
        $(document).on('click', '#btnUploadFile', function () {
          loadIntoModal('#affiliateEditModal', initUrl, { KEY: '', partialView: '_UploadFile', path: 'new' },
            function(modalId) {
              safeParseUnobtrusive($(modalId));
              if ($.fn.select2) {
                try {
                  $(modalId + ' .select2').each(function () {
                    if (!$(this).hasClass('select2-hidden-accessible')) {
                      $(this).select2({ dropdownParent: $(modalId) });
                    }
                  });
                } catch (e) { console.warn('select2 in modal init failed', e); }
              }
              wireModalFormSubmit($(modalId));
            }
          );
        });

        // Row: Details
        //$('#datalistingview').on('click', '.btn-detail', function () {
        //  const id = $(this).data('id');
        //  if (!id) return;
        //  loadIntoModal('#affiliateDetailsModal', detailUrl, { id: id, partialView: '_Details' });
        //});

          $('#datalistingview').on('click', '.btn-detail', function () {
              const id = $(this).data('id');
              if (!id) return;

              const url = detailUrl + '?id=' + encodeURIComponent(id); // partialView omitted -> full page
              window.open(url, '_blank');
          });


        // Row: Delete
        $('#datalistingview').on('click', '.btn-delete', function () {
          const id = $(this).data('id');
          if (!id || !confirm('Are you sure you want to delete this file?')) return;

          $.post(deleteUrl, { id: decodeURIComponent(String(id)) })
            .done(function (res) {
              if (res && res.success) {
                reloadTable();
              } else {
                alert(res?.message || 'Delete failed');
              }
            })
            .fail(function () {
              alert('Delete request failed. Try again.');
            });
        });

        // Initialize table only when Apply Filter is clicked
        // Table won't load until first filter application
      });

    })(jQuery);
</script>
}