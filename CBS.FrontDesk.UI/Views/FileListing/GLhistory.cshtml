@{
    ViewBag.Title = "GLhistory";
}
@using Resources;
@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.GLHistoryListingQuery

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 p-2">
            <div class="card-body text-center py-2">
                <h1 class="card-title text-primary mb-1">
                    <i class="mdi mdi-bank-transfer me-2"></i>Migration GLs Histories
                </h1>
                <p class="card-text small mb-1">
                    @AccountingV2.AffiliateManagementtext
                </p>
                <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary py-1">
        <span class="small"><i class="mdi mdi-information-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGLHistoryTips" aria-expanded="false" aria-controls="collapseGLHistoryTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseGLHistoryTips" class="collapse">
        <div class="card-body small py-2">
            <ul class="mb-0">
                <li class="mb-1"><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Code:</strong> GL history code</li>
                <li class="mb-1"><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i> <strong>Name:</strong> GL history name</li>
                <li class="mb-1"><i class="mdi mdi-filter-outline text-secondary me-2"></i> <strong>Status:</strong> filter by status</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i> <strong>Created Dates:</strong> use the initiation date filter below</li>
            </ul>
        </div>
    </div>
</div>

<!-- Filters (GL History) -->
<div class="card shadow p-2 mb-3">
    <h5 class="text-primary mb-2 small">
        <i class="mdi mdi-filter-outline me-1"></i> Filters
    </h5>

    @* The form posts to Index (or your GLHistory controller action). Use GET for simple listing/filtering. *@
    <form id="glHistoryFilterForm" autocomplete="off" method="get" action="@Url.Action("Index")" class="mb-0">
        @Html.AntiForgeryToken()
        <div class="card p-2 mb-2 bg-light">
            <div class="row mb-2 g-1">

                <!-- Branch -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="BranchId">Branch</label>
                    @Html.DropDownList("BranchId",
                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-select select2 form-select-sm", id = "BranchId" })
                </div>

                <!-- BranchAccount (full width on small, half on md+) -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="BranchAccountId">Branch Account</label>
                    @* ViewBag.BranchAccounts should contain SelectList/List<SelectListItem> *@
                    @Html.DropDownList("BranchAccountId",
                        new SelectList(ViewBag.BranchAccounts ?? new List<SelectListItem>(), "Value", "Text"),
                        "--- Select Branch Account ---",
                        new { @class = "form-select select2 form-select-sm", id = "BranchAccountId" })
                </div>

                <!-- Reconciliation Type -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="ReconciliationType">Reconciliation Type</label>
                    <select id="ReconciliationType" name="ReconciliationType" class="form-select select2 form-select-sm">
                        <option value="">All</option>
                        <option value="VAULT_CASH">VAULT_CASH</option>
                        <option value="TRIAL_BALANCE">TRIAL_BALANCE</option>
                        <option value="OTHER">OTHER</option>
                    </select>
                </div>

                <!-- Initiation Date -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="InitiationDate">Initiation Date</label>
                    <input type="date" id="InitiationDate" name="InitiationDate" class="form-control form-control-sm" />
                </div>

                <!-- Owner Name -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="OwnerName">Owner Name</label>
                    <input type="text" id="OwnerName" name="OwnerName" class="form-control form-control-sm" placeholder="Owner name" />
                </div>

                <!-- Difference in Amount -->
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="DifferenceInAmount">Difference Amount (exact)</label>
                    <input type="number" step="0.01" id="DifferenceInAmount" name="DifferenceInAmount" class="form-control form-control-sm" placeholder="e.g. 1500.75" />
                </div>

            </div>
        </div>

        <div class="row g-1">
            <div class="col-md-6 pe-1">
                <button id="applyGLHistoryFilterBtn" type="button" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>
            </div>
            <div class="col-md-6 ps-1">
                <button id="resetGLHistoryFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial placeholder -->
<div id="datalistingview">
    @Html.Partial("_DataGLH")
</div>

<!-- DETAILS modal (external) -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX injects here --></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
(function ($) {
    'use strict';

    // FIXED: Use correct controller URL - adjust to match your actual controller
     const dataUrl = '@Url.Action("LoadData2", "FileListing")'; // Changed to GLHistory controller
  const detailUrl = '@Url.Action("DetailsGLH", "FileListing")'; // Changed to GLHistory controller

    const tableSelector = '#myDataTable';
    let table = null;

    // ------------------- FILTERS -------------------
    function getFilters() {
        const formData = $('#glHistoryFilterForm').serializeArray();
        const filters = {};

        formData.forEach(item => {
            if (item.value) {
                filters[item.name] = item.value;
            }
        });

        if (filters.DifferenceInAmount) {
            filters.DifferenceInAmount = parseFloat(filters.DifferenceInAmount);
        }

        return filters;
    }

    // ------------------- MODAL -------------------
    function loadDetailsModal(id) {
        const modal = $('#affiliateDetailsModal');
        modal.find('.modal-body').html('<div class="text-center py-4"><div class="spinner-border"></div></div>');
        const modalInstance = bootstrap.Modal.getOrCreateInstance(modal[0]);
        modalInstance.show();

        $.get(detailUrl, { id: id })
            .done(html => {
                modal.find('.modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
            })
            .fail((xhr, status, error) => {
                console.error('Error loading details:', error);
                modal.find('.modal-body').html('<div class="p-3 text-danger">Failed to load details. Please try again.</div>');
            });
    }

    // ------------------- ACTION BUTTON -------------------
    function actionButtons(data, type, row, meta) {
        if (type !== 'display') return '';

        const id = encodeURIComponent(String(row.Id || row.id || ''));
        return `<div class="dropdown text-center">
            <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" data-bs-toggle="dropdown">
                <i class="mdi mdi-cog-outline"></i> Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><button class="dropdown-item btn-detail" type="button" data-id="${id}" title="Details">
                    <i class="mdi mdi-eye me-1 text-primary"></i>Details
                </button></li>
            </ul>
        </div>`;
    }

    // ------------------- DATATABLE -------------------
    function initDataTable() {
        if ($(tableSelector).length === 0) {
            console.warn('initDataTable: table markup not found:', tableSelector);
            return;
        }

        // If an instance exists, destroy cleanly first
        if ($.fn.DataTable.isDataTable(tableSelector)) {
            try {
                $(tableSelector).DataTable().clear().destroy();
            } catch (err) {
                console.warn('Error during DataTable destroy:', err);
            }
            $(tableSelector).empty();
        }

        table = $(tableSelector).DataTable({
            serverSide: true,
            responsive: true,
            autoWidth: false,
            pageLength: 10,
            order: [[0, 'desc']],
            ajax: {
                url: dataUrl,
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: function (d) {
                    const filters = getFilters();
                    return JSON.stringify({
                        ...filters,
                        Options: {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            searchValue: d.search.value || '',
                            sortColumnName: d.columns && d.order && d.order.length > 0 ? d.columns[d.order[0].column].data : '',
                            sortColumnDirection: d.order && d.order.length > 0 ? d.order[0].dir : 'desc'
                        }
                    });
                },
                dataSrc: function (json) {
                    if (json.data) return json.data;
                    if (json.result) return json.result;
                    if (json.items) return json.items;
                    return [];
                },
                error: function (xhr, error, thrown) {
                    console.error('DataTable AJAX error:', error, thrown);
                    $(tableSelector + ' tbody').html(
                        '<tr><td colspan="6" class="text-center text-danger">Failed to load data. Please try again.</td></tr>'
                    );
                }
            },
            columns: [
                {
                    data: 'InitiationDate',
                    name: 'InitiationDate',
                    render: function (data, type, row) {
                        if (!data) return '-';
                        if (window.moment && moment(data).isValid()) {
                            return moment(data).format('DD/MM/YYYY HH:mm:ss');
                        }
                        return data;
                    }
                },
                { data: 'BranchName', name: 'BranchName' },
                { data: 'GlBalance', name: 'GlBalance' },
                {
                    data: 'DifferenceInAmount',
                    name: 'DifferenceInAmount',
                    render: function (data) {
                        return data != null ? data : '-';
                    }
                },
                {
                    data: 'ReconciliationReference',
                    name: 'ReconciliationReference',
                    render: function (data) {
                        return data != null ? data : '-';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-end',
                    render: actionButtons
                }
            ],
            language: {
                emptyTable: 'No GL History records found',
            }
        });

        // ensure table variable is the DataTable API instance
        table = $(tableSelector).DataTable();
    }

    // ------------------- EVENTS -------------------
    $(document).ready(function(){
        // Initialize select2 if available
        if ($.fn.select2) {
            $('#BranchAccountId, #BranchId, #ReconciliationType').select2({
                width: '100%',
                dropdownParent: $('body')
            });
        }

        // Apply Filter Button - now checks the DOM instance properly
        $('#applyGLHistoryFilterBtn').on('click', function (e) {
            e.preventDefault();
            if ($.fn.DataTable.isDataTable(tableSelector)) {
                $(tableSelector).DataTable().ajax.reload();
            } else {
                initDataTable();
            }
        });

        // Reset Filter Button
        $('#resetGLHistoryFilterBtn').on('click', function(){
            $('#glHistoryFilterForm')[0].reset();
            if ($.fn.select2) {
                $('#BranchAccountId, #BranchId, #ReconciliationType').val(null).trigger('change');
            }
            if ($.fn.DataTable.isDataTable(tableSelector)) {
                $(tableSelector).DataTable().ajax.reload();
            }
        });

        // Enter key support in filters
        $('#glHistoryFilterForm').on('keypress', 'input, select', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#applyGLHistoryFilterBtn').click();
            }
        });

        // Details modal event delegation
        $(document).on('click', '.btn-detail', function(){
            const id = $(this).data('id');
            if (id) {
                loadDetailsModal(id);
            }
        });

        // Initialize DataTable on page load (if table markup exists)
        if ($(tableSelector).length) {
          //  initDataTable();
        } else {
            console.warn('DataTable init skipped: table element not found:', tableSelector);
        }
    });

})(jQuery);
    </script>
}
