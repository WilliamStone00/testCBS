@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.FileUploadData
@using System.Globalization

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 p-2">
            <div class="card-body text-center py-2">
                <h1 class="card-title text-primary mb-1">
                    <i class="mdi mdi-account-group me-2"></i>Reconciliation File Details
                </h1>
                <p class="card-text small mb-1">
                    On this page we have the details of a reconciliation file and we have the possibility to confirm the reconciliation
                </p>
                <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-gradient-light text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
                <i class="mdi mdi-lightbulb-on-outline me-2"></i>Tips
            </h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReconciliationTips">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
    </div>

    <div id="collapseReconciliationTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">
                            <i class="mdi mdi-file-document-outline me-2"></i> File Details
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-information-outline text-info me-2"></i>
                                <strong>Summary Cards:</strong> Quick overview of key metrics at the top
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-tab text-primary me-2"></i>
                                <strong>Tab Navigation:</strong> Switch between Basic Info and Technical Details
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                <strong>Status Indicators:</strong> Color-coded badges show file processing state
                            </li>
                            <li>
                                <i class="mdi mdi-download-outline text-success me-2"></i>
                                <strong>File Information:</strong> Check file size, type, and upload timestamps
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-success mb-2">
                            <i class="mdi mdi-check-circle-outline me-2"></i> Confirmation Process
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-eye-outline text-info me-2"></i>
                                <strong>Review Data:</strong> Always verify Trial and Member Balance data before confirming
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-alert-outline text-warning me-2"></i>
                                <strong>Irreversible Action:</strong> Reconciliation cannot be undone once confirmed
                            </li>
                            <li>
                                <i class="mdi mdi-backup-restore text-secondary me-2"></i>
                                <strong>Data Backup:</strong> Ensure you have backups before proceeding
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">
                            <i class="mdi mdi-table-eye me-2"></i> Data Tables
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-chevron-double-down text-info me-2"></i>
                                <strong>Expand/Collapse:</strong> Click section headers to show/hide data tables
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-magnify text-success me-2"></i>
                                <strong>Search & Filter:</strong> Use search boxes to find specific records
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-sort text-warning me-2"></i>
                                <strong>Sorting:</strong> Click column headers to sort data
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-eye-outline text-primary me-2"></i>
                                <strong>Row Details:</strong> Click "View" buttons to see complete record information
                            </li>
                            <li>
                                <i class="mdi mdi-database-outline text-secondary me-2"></i>
                                <strong>Pagination:</strong> Navigate through large datasets using page controls
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-warning mb-2">
                            <i class="mdi mdi-alert-box-outline me-2"></i> Common Issues
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-file-alert-outline text-danger me-2"></i>
                                <strong>Error JSON:</strong> Check technical details tab for processing errors
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-account-alert-outline text-warning me-2"></i>
                                <strong>Member Data:</strong> Verify all member IDs and account numbers are valid
                            </li>
                            <li>
                                <i class="mdi mdi-cash-multiple text-info me-2"></i>
                                <strong>Balance Validation:</strong> Ensure debit/credit totals match expected values
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert alert-light border">
                        <h6 class="text-dark mb-2">
                            <i class="mdi mdi-rocket-launch-outline text-primary me-2"></i> Quick Steps
                        </h6>
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-file-check-outline text-primary fs-4 d-block mb-1"></i>
                                    <small class="text-muted">1. Review File Details</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-table-eye-outline text-info fs-4 d-block mb-1"></i>
                                    <small class="text-muted">2. Verify Data Tables</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-account-check-outline text-warning fs-4 d-block mb-1"></i>
                                    <small class="text-muted">3. Check Balances</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-check-all text-success fs-4 d-block mb-1"></i>
                                    <small class="text-muted">4. Confirm Reconciliation</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Legend -->
            <div class="row mt-2">
                <div class="col-12">
                    <h6 class="text-dark mb-2">
                        <i class="mdi mdi-palette-outline text-primary me-2"></i> Status Legend
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-success">Completed</span>
                        <span class="badge bg-warning">Pending/Processing</span>
                        <span class="badge bg-danger">Error/Failed</span>
                        <span class="badge bg-info">Active</span>
                        <span class="badge bg-secondary">Inactive/Unknown</span>
                        <span class="badge bg-primary">Reconciled</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    @*<div class="card-header bg-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="mdi mdi-file-document-outline me-2"></i> File Details</h4>
                <span class="badge bg-light text-primary fs-6">@Model.Status</span>
            </div>
        </div>*@
    <div class="card-body">
        <!-- File Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-file-table-outline text-primary fs-1 mb-2"></i>
                        <h5 class="text-muted">Trial Balance</h5>
                        <h3 class="text-primary">@(Model?.TrialBalanceRowCount ?? 0)</h3>
                        <small class="text-muted">Rows</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-account-group-outline text-success fs-1 mb-2"></i>
                        <h5 class="text-muted">Member Balance</h5>
                        <h3 class="text-success">@(Model?.MemberBalanceRowCount ?? 0)</h3>
                        <small class="text-muted">Rows</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-calendar-check-outline text-info fs-1 mb-2"></i>
                        <h5 class="text-muted">Created</h5>
                        <h6 class="text-info">
                            @if (Model?.CreatedDate != DateTime.MinValue)
                            {
                                @Model.CreatedDate.ToString("MMM dd, yyyy")
                            }
                            else
                            {
                                @:"—"
                            }
                        </h6>
                        <small class="text-muted">Date</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-file-download-outline text-warning fs-1 mb-2"></i>
                        <h5 class="text-muted">File Size</h5>
                        <h6 class="text-warning">
                            @{
                                var size = Model?.SizeBytes ?? 0L;
                                string hr;
                                if (size >= 1_000_000_000) { hr = (size / 1_000_000_000.0).ToString("N2", CultureInfo.InvariantCulture) + " GB"; }
                                else if (size >= 1_000_000) { hr = (size / 1_000_000.0).ToString("N2", CultureInfo.InvariantCulture) + " MB"; }
                                else if (size >= 1_000) { hr = (size / 1_000.0).ToString("N2", CultureInfo.InvariantCulture) + " KB"; }
                                else { hr = size + " B"; }
                            }
                            @hr
                        </h6>
                        <small class="text-muted">Size</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- File Details in Tabs -->
        <div class="row">
            <div class="col-12">
                <ul class="nav nav-tabs" id="fileDetailsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
                            <i class="mdi mdi-information-outline me-1"></i> Basic Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="technical-tab" data-bs-toggle="tab" data-bs-target="#technical" type="button" role="tab">
                            <i class="mdi mdi-cog-outline me-1"></i> Technical Details
                        </button>
                    </li>
                </ul>

                <div class="tab-content border border-top-0 rounded-bottom" id="fileDetailsTabsContent">
                    <!-- Basic Info Tab -->
                    <div class="tab-pane fade show active" id="basic" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-muted small" style="width: 25%;">File Name</td>
                                        <td style="width: 25%;">@Html.Encode(Model?.FileName ?? "—")</td>
                                        <td class="fw-bold text-muted small" style="width: 25%;">Created Date</td>
                                        <td style="width: 25%;">
                                            @if (Model?.CreatedDate != DateTime.MinValue)
                                            {
                                                @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss K")
                                            }
                                            else
                                            {
                                                @:"—"
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">Original File</td>
                                        <td>@Html.Encode(Model?.OriginalFileName ?? "—")</td>
                                        <td class="fw-bold text-muted small">Modified Date</td>
                                        <td>
                                            @if (Model?.ModifiedDate != DateTime.MinValue && Model.ModifiedDate > DateTime.MinValue.AddYears(1))
                                            {
                                                @Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss K")
                                            }
                                            else
                                            {
                                                @:"—"
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">Branch ID</td>
                                        <td>@Html.Raw(Model?.BranchId ?? "—")</td>
                                        <td class="fw-bold text-muted small">Status</td>
                                        <td>
                                            <span class="badge
                                            @(Model?.Status?.ToLower() == "completed" ? "bg-success" :
                                              Model?.Status?.ToLower() == "processing" ? "bg-warning" :
                                              Model?.Status?.ToLower() == "error" ? "bg-danger" : "bg-secondary")">
                                                @Html.Encode(Model?.Status ?? "—")
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">Category</td>
                                        <td>@Html.Raw(Model?.Category ?? "—")</td>
                                        <td class="fw-bold text-muted small">Deleted</td>
                                        <td>
                                            <span class="badge @(Model?.IsDeleted == true ? "bg-danger" : "bg-success")">
                                                @(Model?.IsDeleted == true ? "Yes" : "No")
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Technical Details Tab -->
                    <div class="tab-pane fade" id="technical" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-muted small" style="width: 25%;">Content Type</td>
                                        <td style="width: 25%;">@Html.Encode(Model?.ContentType ?? "—")</td>
                                        <td class="fw-bold text-muted small" style="width: 25%;">File ID</td>
                                        <td style="width: 25%;" class="font-monospace small">@Html.Raw(Model?.Id ?? "—")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">Storage Key</td>
                                        <td class="font-monospace small">@Html.Encode(Model?.StorageKey ?? "—")</td>
                                        <td class="fw-bold text-muted small">Notes</td>
                                        <td>@Html.Raw(string.IsNullOrWhiteSpace(Model?.Notes ?? "") ? "—" : Html.Encode(Model.Notes))</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">Checksum</td>
                                        <td class="font-monospace small">@Html.Encode(Model?.Checksum ?? "—")</td>
                                        <td class="fw-bold text-muted small align-top">Error JSON</td>
                                        <td>
                                            @{
                                                var ej = Model?.ErrorJson;
                                                if (string.IsNullOrWhiteSpace(ej))
                                                {
                                                    @:—
                                                }
                                                else
                                                {
                                                    <pre class="small bg-light p-2 rounded border mb-0">@Html.Encode(ej)</pre>
                                                }
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Trial Balance Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient-light text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="mdi mdi-file-table-outline me-2"></i>
                                Trial Balance Data
                                <span class="badge bg-light text-primary ms-2">@Model.TrialBalanceRows.Count rows</span>
                            </h5>
                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#trialBalanceSection">
                                <i class="mdi mdi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div id="trialBalanceSection" class="collapse">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="trialBalanceTable" class="table table-hover table-striped" style="width:100%">
                                    <thead class="table-light">
                                        <tr>
                                            <th><i class="mdi mdi-code-braces me-1"></i>Source Code</th>
                                            <th><i class="mdi mdi-text-box-outline me-1"></i>Source Name</th>
                                            <th class="text-end"><i class="mdi mdi-cash-plus me-1"></i>Opening Debit</th>
                                            <th class="text-end"><i class="mdi mdi-cash-minus me-1"></i>Opening Credit</th>
                                            <th class="text-end"><i class="mdi mdi-cash-plus me-1"></i>Movement Debit</th>
                                            <th class="text-end"><i class="mdi mdi-cash-minus me-1"></i>Movement Credit</th>
                                            <th class="text-end"><i class="mdi mdi-cash-plus me-1"></i>End Debit</th>
                                            <th class="text-end"><i class="mdi mdi-cash-minus me-1"></i>End Credit</th>
                                            <th><i class="mdi mdi-check-circle-outline me-1"></i>Reconciled</th>
                                            <th><i class="mdi mdi-play-circle-outline me-1"></i>Active</th>
                                            <th class="text-center"><i class="mdi mdi-cog-outline me-1"></i>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model?.TrialBalanceRows != null)
                                        {
                                            foreach (var row in Model.TrialBalanceRows)
                                            {
                                                <tr>
                                                    <td><span class="fw-bold text-primary">@row.SourceCode</span></td>
                                                    <td>@row.SourceName</td>
                                                    <td class="text-end">@row.OpeningDebit.ToString("N2")</td>
                                                    <td class="text-end">@row.OpeningCredit.ToString("N2")</td>
                                                    <td class="text-end">@row.MovementDebit.ToString("N2")</td>
                                                    <td class="text-end">@row.MovementCredit.ToString("N2")</td>
                                                    <td class="text-end fw-bold">@row.EndDebit.ToString("N2")</td>
                                                    <td class="text-end fw-bold">@row.EndCredit.ToString("N2")</td>
                                                    <td>
                                                        <span class="badge @(row.IsReconciled ? "bg-success" : "bg-secondary")">
                                                            @(row.IsReconciled ? "Yes" : "No")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(row.IsCurrentlyActive ? "bg-info" : "bg-warning")">
                                                            @(row.IsCurrentlyActive ? "Yes" : "No")
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <button class="btn btn-sm btn-outline-primary btn-trial-details"
                                                                data-row-id="@row.Id"
                                                                data-source-code="@row.SourceCode"
                                                                data-source-name="@row.SourceName"
                                                                data-opening-debit="@row.OpeningDebit"
                                                                data-opening-credit="@row.OpeningCredit"
                                                                data-movement-debit="@row.MovementDebit"
                                                                data-movement-credit="@row.MovementCredit"
                                                                data-end-debit="@row.EndDebit"
                                                                data-end-credit="@row.EndCredit"
                                                                data-branch-account-id="@row.BranchAccountId"
                                                                data-is-reconciled="@row.IsReconciled"
                                                                data-is-active="@row.IsCurrentlyActive"
                                                                data-created-date="@row.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")"
                                                                data-modified-date="@row.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                                            <i class="mdi mdi-eye-outline"></i> View
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Member Balance Section -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient-light text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="mdi mdi-account-group-outline me-2"></i>
                                Member Balance Data
                                <span class="badge bg-light text-success ms-2">@Model.MemberBalanceRows.Count rows</span>
                            </h5>
                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#memberBalanceSection">
                                <i class="mdi mdi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div id="memberBalanceSection" class="collapse">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="memberBalanceTable" class="table table-hover table-striped" style="width:100%">
                                    <thead class="table-light">
                                        <tr>
                                            <th><i class="mdi mdi-identifier me-1"></i>Member ID</th>
                                            <th><i class="mdi mdi-account-cog-outline me-1"></i>Account Type</th>
                                            <th><i class="mdi mdi-credit-card-outline me-1"></i>Account Number</th>
                                            <th><i class="mdi mdi-office-building-outline me-1"></i>Branch Code</th>
                                            <th><i class="mdi mdi-bank-outline me-1"></i>Branch Name</th>
                                            <th class="text-end"><i class="mdi mdi-cash-multiple me-1"></i>Balance</th>
                                            <th><i class="mdi mdi-progress-check me-1"></i>Reconciliation Status</th>
                                            <th><i class="mdi mdi-account-check-outline me-1"></i>Reconciled By</th>
                                            <th class="text-center"><i class="mdi mdi-cog-outline me-1"></i>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model?.MemberBalanceRows != null)
                                        {
                                            foreach (var row in Model.MemberBalanceRows)
                                            {
                                                <tr>
                                                    <td><span class="fw-bold text-success">@row.MemberId</span></td>
                                                    <td>@row.AccountType</td>
                                                    <td>@row.AccountNumber</td>
                                                    <td>@row.BranchCode</td>
                                                    <td>@row.BranchName</td>
                                                    <td class="text-end fw-bold">@row.Balance.ToString("N2")</td>
                                                    <td>
                                                        <span class="badge
                                                            @(row.RecocilationStatus?.ToLower() == "completed" ? "bg-success" :
                                                              row.RecocilationStatus?.ToLower() == "pending" ? "bg-warning" :
                                                              row.RecocilationStatus?.ToLower() == "failed" ? "bg-danger" : "bg-secondary")">
                                                            @row.RecocilationStatus
                                                        </span>
                                                    </td>
                                                    <td>@(string.IsNullOrEmpty(row.ReconciledBy) ? "—" : row.ReconciledBy)</td>
                                                    <td class="text-center">
                                                        <button class="btn btn-sm btn-outline-success btn-member-details"
                                                                data-row-id="@row.Id"
                                                                data-member-id="@row.MemberId"
                                                                data-account-type="@row.AccountType"
                                                                data-account-number="@row.AccountNumber"
                                                                data-branch-code="@row.BranchCode"
                                                                data-branch-name="@row.BranchName"
                                                                data-balance="@row.Balance"
                                                                data-reconciliation-status="@row.RecocilationStatus"
                                                                data-reconciled-by="@row.ReconciledBy"
                                                                data-created-date="@row.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")"
                                                                data-modified-date="@row.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                                            <i class="mdi mdi-eye-outline"></i> View
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
