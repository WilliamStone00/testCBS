            // =============================================
            // MISSING BUTTON CLICK HANDLER - ADD THIS PART
            // =============================================
// Enhanced Confirm Reconciliation with AppAlert
$('#confirmReconciliationBtn').on('click', function () {
    console.log('Confirm button clicked'); // Debug log

    const $btn = $(this);
    const id = $btn.data('id');

    if (!id) {
        if (typeof appalert === 'function') {
            appalert('No file ID provided.', 3, 1);
        } else {
            alert('No file ID provided.');
        }
        return;
    }

    const message = `Are you sure you want to confirm reconciliation for this file?\n\n` +
        `This action will finalize the reconciliation process and cannot be undone.`;

    // Use the same pattern as finalizeReconciliation
    if (typeof alertify !== 'undefined' && alertify.confirm) {
        alertify.confirm(
            "Confirm Reconciliation",
            message,
            function () {
                if (typeof appalert === 'function') {
                    appalert('Processing reconciliation...', 0, 0);
                }
                performReconciliation($btn, id);
            },
            function () {
                if (typeof appalert === 'function') {
                    appalert('Reconciliation cancelled', 3, 1);
                }
            }
        );
    } else {
        if (confirm(message)) {
            if (typeof appalert === 'function') {
                appalert('Processing reconciliation...', 0, 0);
            }
            performReconciliation($btn, id);
        }
    }
});

function performReconciliation($btn, id) {
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status"></span> Processing...');

    fetch('@Url.Action("ConfirmUpload", "FileListing")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        },
        body: JSON.stringify({ id: id })
    })
    .then(r => {
        if (!r.ok) {
            throw new Error('Network response was not ok');
        }
        return r.json();
    })
    .then(data => {
        if (data && data.success) {
            if (typeof appalert === 'function') {
                appalert('Reconciliation confirmed successfully!', 1, 1);
            } else {
                alert('Reconciliation confirmed successfully!');
            }

            // Refresh parent table if exists
            if (window.table && typeof window.table.ajax === 'function') {
                window.table.ajax.reload(null, false);
            }

            // Close the modal if we're in one
            const modalEl = document.getElementById('CorrespondanceDetailsModal');
            if (modalEl) {
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }
        } else {
            const errorMessage = data?.message || 'Reconciliation confirmation failed';
            if (typeof appalert === 'function') {
                appalert(errorMessage, 2, 1);
            } else {
                alert(errorMessage);
            }
        }
    })
    .catch(e => {
        console.error(e);
        const errorMessage = 'Error confirming reconciliation. Please try again.';
        if (typeof appalert === 'function') {
            appalert(errorMessage, 2, 1);
        } else {
            alert(errorMessage);
        }
    })
    .finally(() => {
        $btn.prop('disabled', false).html('<i class="mdi mdi-check-all me-2"></i> Confirm Reconciliation');
    });
}
