@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:18%" /> 
                    <col style="width:23%" /> 
                    <col style="width:21%" /> 
                    <col style="width:13%" /> 
                    <col style="width:7%" /> 
                    <col style="width:7%" /> 
                    <col style="width:10%" /> 
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>@AccountingV2.CreatedDate</th>
                        <th>FileName</th>
                        <th>Category</th>
                        <th> Branch Name</th>
                        <th> File Status</th>
                        <th>Reconciliation Status</th>
                        <th style="width:160px">@AccountingV2.Actions</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
