@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.FileUploadData
@using System.Globalization
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 p-2">
            <div class="card-body text-center py-2">
                <h1 class="card-title text-primary mb-1">
                    <i class="mdi mdi-account-group me-2"></i>@GlobalFileListing.Reconciliation_File_Details
                </h1>
                <p class="card-text small mb-1">
                    @GlobalFileListing.On_this_page_we_have_the_details_of_a_reconciliation_file_and_we_have_the_possibility_to_confirm_the_reconciliation
                </p>
                <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-gradient-light text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
                <i class="mdi mdi-lightbulb-on-outline me-2"></i>@GlobalShared.Tips
            </h6>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReconciliationTips">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </div>
    </div>

    <div id="collapseReconciliationTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">
                            <i class="mdi mdi-file-document-outline me-2"></i> @GlobalShared.File_Details
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-information-outline text-info me-2"></i>
                                <strong>@GlobalFileListing.Summary_Cards:</strong> @GlobalFileListing.Quick_overview_of_key_metrics_at_the_top
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-tab text-primary me-2"></i>
                                <strong>@GlobalFileListing.Tab_Navigation:</strong> @GlobalFileListing.Switch_between_Basic_Info_and_Technical_Details
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                <strong>@GlobalFileListing.Status_Indicators:</strong> @GlobalFileListing.Color_coded_badges_show_file_processing_state
                            </li>
                            <li>
                                <i class="mdi mdi-download-outline text-success me-2"></i>
                                <strong>@GlobalShared.File_Information:</strong> @GlobalFileListing.Check_file_size_type_and_upload_timestamps
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-success mb-2">
                            <i class="mdi mdi-check-circle-outline me-2"></i> @GlobalFileListing.Confirmation_Process
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-eye-outline text-info me-2"></i>
                                <strong>@GlobalShared.Review_Data:</strong> @GlobalFileListing.Always_verify_Trial_and_Member_Balance_data_before_confirming
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-alert-outline text-warning me-2"></i>
                                <strong>@GlobalShared.Irreversible_Action:</strong> @GlobalFileListing.Reconciliation_cannot_be_undone_once_confirmed
                            </li>
                            <li>
                                <i class="mdi mdi-backup-restore text-secondary me-2"></i>
                                <strong>@GlobalShared.Data_Backup:</strong> @GlobalFileListing.Ensure_you_have_backups_before_proceeding
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">
                            <i class="mdi mdi-table-eye me-2"></i> @GlobalShared.Data_Tables
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-chevron-double-down text-info me-2"></i>
                                <strong>@GlobalShared.Expand/@GlobalShared.Collapse:</strong> @GlobalFileListing.Click_section_headers_to_show_hide_data_tables
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-magnify text-success me-2"></i>
                                <strong>@GlobalShared.Search_Filter:</strong> @GlobalFileListing.Use_search_boxes_to_find_specific_records
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-sort text-warning me-2"></i>
                                <strong>@GlobalShared.Sorting:</strong> @GlobalFileListing.Click_column_headers_to_sort_data
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-eye-outline text-primary me-2"></i>
                                <strong>@GlobalShared.Row_Details:</strong> @GlobalFileListing.Click_View_buttons_to_see_complete_record_information
                            </li>
                            <li>
                                <i class="mdi mdi-database-outline text-secondary me-2"></i>
                                <strong>@GlobalShared.Pagination:</strong> @GlobalFileListing.Navigate_through_large_datasets_using_page_controls
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-warning mb-2">
                            <i class="mdi mdi-alert-box-outline me-2"></i> @GlobalShared.Common_Issues
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="mdi mdi-file-alert-outline text-danger me-2"></i>
                                <strong>@GlobalShared.Error_JSON:</strong> @GlobalFileListing.Check_technical_details_tab_for_processing_errors
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-account-alert-outline text-warning me-2"></i>
                                <strong>@GlobalShared.Member_Data:</strong> @GlobalFileListing.Verify_all_member_IDs_and_account_numbers_are_valid
                            </li>
                            <li>
                                <i class="mdi mdi-cash-multiple text-info me-2"></i>
                                <strong>@GlobalShared.Balance_Validation:</strong> @GlobalFileListing.Ensure_debit_credit_totals_match_expected_values
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert alert-light border">
                        <h6 class="text-dark mb-2">
                            <i class="mdi mdi-rocket-launch-outline text-primary me-2"></i> @GlobalShared.Quick_Steps
                        </h6>
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-file-check-outline text-primary fs-4 d-block mb-1"></i>
                                    <small class="text-muted">1. @GlobalShared.Review_File_Details</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-table-eye-outline text-info fs-4 d-block mb-1"></i>
                                    <small class="text-muted">2. @GlobalFileListing.Verify_Data_Tables</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-account-check-outline text-warning fs-4 d-block mb-1"></i>
                                    <small class="text-muted">3. @GlobalFileListing.Check_Balances</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <i class="mdi mdi-check-all text-success fs-4 d-block mb-1"></i>
                                    <small class="text-muted">4. @GlobalShared.Confirm_Reconciliation</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Legend -->
            <div class="row mt-2">
                <div class="col-12">
                    <h6 class="text-dark mb-2">
                        <i class="mdi mdi-palette-outline text-primary me-2"></i> @GlobalShared.Status_Legend
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-success">@GlobalShared.Completed</span>
                        <span class="badge bg-warning">@GlobalShared.Pending/@GlobalShared.Processing</span>
                        <span class="badge bg-danger">@GlobalShared.Error/@GlobalShared.Failed</span>
                        <span class="badge bg-info">@GlobalShared.Active</span>
                        <span class="badge bg-secondary">@GlobalShared.InActive/@GlobalShared.Unknown</span>
                        <span class="badge bg-primary">@GlobalShared.Reconciled</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <!-- File Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-file-table-outline text-primary fs-1 mb-2"></i>
                        <h5 class="text-muted">@GlobalShared.Trial_Balance</h5>
                        <h3 class="text-primary">@(Model?.TrialBalanceRowCount ?? 0)</h3>
                        <small class="text-muted">Rows</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-account-group-outline text-success fs-1 mb-2"></i>
                        <h5 class="text-muted">@GlobalShared.Member_Balance</h5>
                        <h3 class="text-success">@(Model?.MemberBalanceRowCount ?? 0)</h3>
                        <small class="text-muted">Rows</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-calendar-check-outline text-info fs-1 mb-2"></i>
                        <h5 class="text-muted">@GlobalShared.Created</h5>
                        <h6 class="text-info">
                            @if (Model?.CreatedDate != DateTime.MinValue)
                            {
                                @Model.CreatedDate.ToString("MMM dd, yyyy")
                            }
                            else
                            {
                                @:"—"
                            }
                        </h6>
                        <small class="text-muted">@GlobalShared.Date</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center">
                        <i class="mdi mdi-file-download-outline text-warning fs-1 mb-2"></i>
                        <h5 class="text-muted">File Size</h5>
                        <h6 class="text-warning">
                            @{
                                var fileSizeBytes = Model?.SizeBytes ?? 0L;
                                string fileSizeDisplay;
                                if (fileSizeBytes >= 1_000_000_000) { fileSizeDisplay = (fileSizeBytes / 1_000_000_000.0).ToString("N2", CultureInfo.InvariantCulture) + " GB"; }
                                else if (fileSizeBytes >= 1_000_000) { fileSizeDisplay = (fileSizeBytes / 1_000_000.0).ToString("N2", CultureInfo.InvariantCulture) + " MB"; }
                                else if (fileSizeBytes >= 1_000) { fileSizeDisplay = (fileSizeBytes / 1_000.0).ToString("N2", CultureInfo.InvariantCulture) + " KB"; }
                                else { fileSizeDisplay = fileSizeBytes + " B"; }
                            }
                            @fileSizeDisplay
                        </h6>
                        <small class="text-muted">Size</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- File Details in Tabs -->
        <div class="row">
            <div class="col-12">
                <ul class="nav nav-tabs" id="fileDetailsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
                            <i class="mdi mdi-information-outline me-1"></i> @GlobalShared.Basic_Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="technical-tab" data-bs-toggle="tab" data-bs-target="#technical" type="button" role="tab">
                            <i class="mdi mdi-cog-outline me-1"></i> @GlobalShared.Technical_Details
                        </button>
                    </li>
                </ul>

                <div class="tab-content border border-top-0 rounded-bottom" id="fileDetailsTabsContent">
                    <!-- Basic Info Tab -->
                    <div class="tab-pane fade show active" id="basic" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-muted small" style="width: 25%;">@GlobalShared.File_Name</td>
                                        <td style="width: 25%;">@Html.Encode(Model?.FileName ?? "—")</td>
                                        <td class="fw-bold text-muted small" style="width: 25%;">@GlobalShared.Created_Date</td>
                                        <td style="width: 25%;">
                                            @if (Model?.CreatedDate != DateTime.MinValue)
                                            {
                                                @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss K")
                                            }
                                            else
                                            {
                                                @:"—"
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">@GlobalShared.Original_File</td>
                                        <td>@Html.Encode(Model?.OriginalFileName ?? "—")</td>
                                        <td class="fw-bold text-muted small">Modified Date</td>
                                        <td>
                                            @if (Model?.ModifiedDate != DateTime.MinValue && Model.ModifiedDate > DateTime.MinValue.AddYears(1))
                                            {
                                                @Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss K")
                                            }
                                            else
                                            {
                                                @:"—"
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">@GlobalShared.Branch_ID</td>
                                        <td>@Html.Raw(Model?.BranchId ?? "—")</td>
                                        <td class="fw-bold text-muted small">@GlobalShared.Status</td>
                                        <td>
                                            <span class="badge
                                            @(Model?.Status?.ToLower() == " completed" ? "bg-success" :
                                                  Model?.Status?.ToLower() == "processing" ? "bg-warning" :
                                                  Model?.Status?.ToLower() ==  "error" ? "bg-danger" : "bg-secondary" )">
                                                @Html.Encode(Model?.Status ?? "—")
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">@GlobalShared.Category</td>
                                        <td>@Html.Raw(Model?.Category ?? "—")</td>
                                        <td class="fw-bold text-muted small">@GlobalShared.Deleted</td>
                                        <td>
                                            <span class="badge @(Model?.IsDeleted == true ? " bg-danger" : "bg-success" )">
                                                @(Model?.IsDeleted == true ? "Yes" : "No")
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Technical Details Tab -->
                    <div class="tab-pane fade" id="technical" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-muted small" style="width: 25%;">@GlobalShared.Content_Type</td>
                                        <td style="width: 25%;">@Html.Encode(Model?.ContentType ?? "—")</td>
                                        <td class="fw-bold text-muted small" style="width: 25%;">File ID</td>
                                        <td style="width: 25%;" class="font-monospace small">@Html.Raw(Model?.Id ?? "—")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">@GlobalShared.Storage_Key</td>
                                        <td class="font-monospace small">@Html.Encode(Model?.StorageKey ?? "—")</td>
                                        <td class="fw-bold text-muted small">Notes</td>
                                        <td>@Html.Raw(string.IsNullOrWhiteSpace(Model?.Notes ?? "") ? "—" : Html.Encode(Model.Notes))</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted small">@GlobalShared.Checksum</td>
                                        <td class="font-monospace small">@Html.Encode(Model?.Checksum ?? "—")</td>
                                        <td class="fw-bold text-muted small align-top">@GlobalShared.Error_JSON</td>
                                        <td>
                                            @{
                                                var errorJson = Model?.ErrorJson;
                                                if (string.IsNullOrWhiteSpace(errorJson))
                                                {
                                                    @:—
                                                }
                                                else
                                                {
                                                    <pre class="small bg-light p-2 rounded border mb-0">@Html.Encode(errorJson)</pre>
                                                }
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Trial Balance Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient-light text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="mdi mdi-file-table-outline me-2"></i>
                                @GlobalFileListing.Trial_Balance_Data
                                <span class="badge bg-light text-primary ms-2">@Model.TrialBalanceRows.Count rows</span>
                            </h5>
                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#trialBalanceSection">
                                <i class="mdi mdi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div id="trialBalanceSection" class="collapse">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="trialBalanceTable" class="table table-striped" style="width:100%">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalShared.Branch_Acc_Id</th>
                                            <th>@GlobalShared.Branch_Acc_Name</th>
                                            <th class="text-end">@GlobalShared.Opening_Debit</th>
                                            <th class="text-end">@GlobalShared.Opening_Credit</th>
                                            <th class="text-end">@GlobalShared.Movement_Debit</th>
                                            <th class="text-end">@GlobalShared.Movement_Credit</th>
                                            <th class="text-end">@GlobalShared.End_Debit</th>
                                            <th class="text-end">@GlobalShared.End_Credit</th>
                                            <th>@GlobalShared.Reconciled</th>
                                            <th>@GlobalShared.Active</th>
                                            <th class="text-center">@GlobalShared.Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Data will be populated by DataTables -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Member Balance Section -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient-light text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="mdi mdi-account-group-outline me-2"></i>
                                @GlobalFileListing.Member_Balance_Data
                                <span class="badge bg-light text-success ms-2">@Model.MemberBalanceRows.Count rows</span>
                            </h5>
                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#memberBalanceSection">
                                <i class="mdi mdi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div id="memberBalanceSection" class="collapse">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="memberBalanceTable" class="table table-striped" style="width:100%">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalShared.Member_ID</th>
                                            <th>@GlobalShared.Account_type</th>
                                            <th>@GlobalShared.Account_Number</th>
                                            <th>@GlobalShared.Branch_Code</th>
                                            <th>@GlobalShared.Branch_Name</th>
                                            <th class="text-end">@GlobalShared.Balance</th>
                                            <th>@GlobalFileListing.Reconciliation_Status</th>
                                            <th>@GlobalShared.Reconciled_By</th>
                                            <th class="text-center">@GlobalShared.Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Data will be populated by DataTables -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Confirm Reconciliation Button -->
        <div class="row mt-5">
            <div class="col-12 text-center">
                <div class="card border-0 bg-light">
                    <div class="card-body py-4">
                        <h4 class="text-muted mb-3">@GlobalFileListing.Ready_to_Complete_Reconciliation?</h4>
                        <p class="text-muted mb-4">@GlobalFileListing.Once_confirmed_the_reconciliation_process_will_be_finalized_and_cannot_be_undone</p>
                        <button id="confirmReconciliationBtn" data-id="@Html.Raw(Model?.Id ?? " ")" data-branch="@Html.Raw(Model?.BranchId ?? " ")" class="btn btn-primary btn-lg px-5 py-3">
                            <i class="mdi mdi-check-all me-2"></i> @GlobalShared.Confirm_Reconciliation
                        </button>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="mdi mdi-information-outline me-1"></i>
                                @GlobalFileListing.This_will_update_all_records_and_mark_the_file_as_processed
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Modals -->
<div class="modal fade" id="trialBalanceDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2 p-2">
                        <div class="card-body text-center py-2">
                            <h1 class="card-title text-primary mb-1">
                                <i class="mdi mdi-file-table-outline me-2"></i>@GlobalFileListing.Trial_Balance_Details
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </h1>
                            <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body" id="trialBalanceDetailsContent">
                <!-- Content will be populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="memberBalanceDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="row">
                <div class="col-12">
                    <div class="card bg-light mb-2 p-2">
                        <div class="card-body text-center py-2">
                            <h1 class="card-title text-primary mb-1">
                                <i class="mdi mdi-account-group-outline me-2"></i>@GlobalFileListing.Member_Balance_Details
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </h1>
                            <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body" id="memberBalanceDetailsContent">
                <!-- Content will be populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Container for Confirmation Form -->
<div id="confirmReconciliationModalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Reusable decimal formatter function
            function formatDecimal(value) {
                return parseFloat(value).toLocaleString('en-US', {
                    minimumFractionDigits: 1,
                    maximumFractionDigits: 1
                });
            }

            // Prepare data for DataTables
            // Prepare data for DataTables
            const trialBalanceData = [
                @if (Model?.TrialBalanceRows != null)
                {
                    var first = true;
                    foreach (var row in Model.TrialBalanceRows)
                    {
                        if (!first) { @:,
                        }
