            // Confirm Reconciliation Button - Open Modal (Fixed Version)
            $('#confirmReconciliationBtn').on('click', function () {
                console.log('Confirm button clicked - opening modal');
                const $btn = $(this);
                const id = $btn.data('id');
                const branch = $btn.data('branch');

                if (!id) {
                    if (typeof appalert === 'function') {
                        appalert('No file ID provided.', 3, 1);
                    } else {
                        alert('No file ID provided.');
                    }
                    return;
                }

                // Clean up any existing modal instances first
                cleanupExistingModal();

                // Build URL for the GET action that returns the partial view
                const url = '/FileListing/ConfirmUpload?id=' + encodeURIComponent(id) + '&branch=' + encodeURIComponent(branch);

                // Create container for modal if it doesn't exist
                if ($('#confirmReconciliationModalContainer').length === 0) {
                    $('body').append('<div id="confirmReconciliationModalContainer"></div>');
                }

                // Show loading state on the button instead of showing loading modal
                $btn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-2"></i> Loading...');

                // Fetch the partial view
                fetch(url, { credentials: 'same-origin' })
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to load confirmation form');
                        return response.text();
                    })
                    .then(html => {
                        // Replace with the actual modal content
                        $('#confirmReconciliationModalContainer').html(html);

                        // Initialize the new modal
                        const modalEl = document.getElementById('confirmReconciliationModal');
                        if (modalEl) {
                            const modalInstance = new bootstrap.Modal(modalEl, {
                                backdrop: true,
                                keyboard: true
                            });

                            // Properly handle modal hide event to clean up backdrop
                            modalEl.addEventListener('hidden.bs.modal', function () {
                                cleanupExistingModal();
                            });

                            // Show modal only after content is loaded
                            modalInstance.show();

                            // Attach form submit handler
                            $(document).off('submit', '#confirmReconciliationForm');
                            $(document).on('submit', '#confirmReconciliationForm', function (e) {
                                e.preventDefault();
                                submitConfirmForm($(this), modalInstance);
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error loading confirmation form:', error);
                        // Clean up container
                        $('#confirmReconciliationModalContainer').empty();

                        if (typeof appalert === 'function') {
                            appalert('Failed to load confirmation form. Please try again.', 3, 1);
                        } else {
                            alert('Failed to load confirmation form. Please try again.');
                        }
                    })
                    .finally(() => {
                        // Re-enable button
                        $btn.prop('disabled', false).html('<i class="mdi mdi-check-all me-2"></i> Confirm Reconciliation');
                    });
            });

            // Helper function to clean up modal and backdrop
            function cleanupExistingModal() {
                const existingModal = bootstrap.Modal.getInstance(document.getElementById('confirmReconciliationModal'));
                if (existingModal) {
                    existingModal.hide();
                }

                // Remove modal-open class and backdrop
                document.body.classList.remove('modal-open');
                const existingBackdrop = document.querySelector('.modal-backdrop');
                if (existingBackdrop) {
                    existingBackdrop.remove();
                }

                // Clean up container after a delay
                setTimeout(() => {
                    if ($('#confirmReconciliationModalContainer').length) {
                        $('#confirmReconciliationModalContainer').empty();
                    }
                }, 300);
            }

            // Function to handle form submission from the modal
            function submitConfirmForm($form, modalInstance) {
                const $btn = $form.find('button[type="submit"]');
                const originalText = $btn.html();

                // Disable button and show loading
                $btn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-2"></i> Processing...');

                // Get anti-forgery token
                const token = $form.find('input[name="__RequestVerificationToken"]').val();

                // Prepare form data
                const payload = {
                    Id: $form.find('input[name="Id"]').val(),
                    BranchId: $form.find('input[name="BranchId"]').val(),
                    AccountingDate: $form.find('input[name="AccountingDate"]').val(),
                    Memo: $form.find('input[name="Memo"]').val(),
                    ExternalApplicationName: $form.find('input[name="ExternalApplicationName"]').val() || '',
                    ReconciliationKind: $form.find('input[name="ReconciliationKind"]').val() || '',
                    ReconciledBy: $form.find('input[name="ReconciledBy"]').val() || ''
                };

                console.log('Submitting reconciliation:', payload);

                // Submit to POST endpoint
                fetch('/FileListing/ConfirmUpload', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || '',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify(payload)
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(data => {
                    if (data && data.success) {
                        // Success: show message, close modal, and reload page
                        if (typeof appalert === 'function') {
                            appalert(data.message || 'Reconciliation confirmed successfully!', 1, 1);
                        } else {
                            alert(data.message || 'Reconciliation confirmed successfully!');
                        }

                        modalInstance.hide();

                        // Reload the page after a short delay to show updated status
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        // Show error message in the modal
                        const message = (data && data.message) ? data.message : 'Failed to confirm reconciliation.';
                        showFormAlert($form, message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Submission error:', error);
                    showFormAlert($form, 'Error confirming reconciliation. Please try again.', 'danger');
                })
                .finally(() => {
                    // Re-enable button
                    $btn.prop('disabled', false).html(originalText);
                });
            }

            // Helper function to show form alerts in the modal
            function showFormAlert($form, message, type) {
                const $alert = $form.find('#confirmFormAlert');
                const alertClass = type === 'danger' ? 'alert-danger' : type === 'warning' ? 'alert-warning' : 'alert-success';

                if ($alert.length === 0) {
                    $form.find('.modal-body').prepend(
                        `<div id="confirmFormAlert" class="alert ${alertClass} alert-dismissible fade show" role="alert">
                            ${message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`
                    );
                } else {
                    $alert.removeClass('alert-success alert-danger alert-warning')
                          .addClass(alertClass)
                          .html(`${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`)
                          .removeClass('d-none')
                          .show();
                }
            }
        });
    </script>
}