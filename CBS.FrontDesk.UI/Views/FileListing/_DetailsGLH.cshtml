@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.GLHistoryDto
@using System.Globalization
@using Resources

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-bank-transfer me-2"></i>@GlobalFileListing.GL_History_Details
        </h1>
        <p class="card-text text-muted mb-1">
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i>@GlobalShared.Basic_Information</h6>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td class="fw-bold">@GlobalShared.Owner_Name:</td>
                    <td>@Html.Encode(Model?.OwnerName ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Initiator_Name:</td>
                    <td>@Html.Encode(Model?.InitiatorName ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Initiation_Date:</td>
                    <td>@(Model != null ? Model.InitiationDate.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Approved_by:</td>
                    <td>@Html.Encode(Model?.ApprovedByName ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Approval_date:</td>
                    <td>@(Model?.ApprovalDate.HasValue == true ? Model.ApprovalDate.Value.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Till_Name:</td>
                    <td>@Html.Encode(Model?.TillName ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Reconciliation_Type:</td>
                    <td>@Html.Encode(Model?.ReconciliationType ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Narration:</td>
                    <td>@Html.Encode(Model?.Narration ?? "-")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i>@GlobalFileListing.Fee_Settings</h6>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td class="fw-bold">@GlobalFileListing.Gl_Balance:</td>
                    <td>@(Model != null ? Model.GlBalance.ToString("N2", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalFileListing.Difference_Amount:</td>
                    <td>@(Model != null ? Model.DifferenceInAmount.ToString("N2", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Accounting_Date:</td>
                    <td>@(Model != null ? Model.AccountingDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Branch_ID:</td>
                    <td>@Html.Encode(Model?.BranchId ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Cash_In_Hand:</td>
                    <td>@(Model != null ? Model.CashInHand.ToString("N2", CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Branch_Name:</td>
                    <td>@Html.Encode(Model?.BranchName ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Branch_Code:</td>
                    <td>@Html.Encode(Model?.BranchCode ?? "-")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <h6 class="text-primary"><i class="mdi mdi-table-large me-2"></i>@GlobalShared.GL_Mapping</h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalFileListing.Source_GL_Id</th>
                        <th>@GlobalFileListing.SGL_Name</th>
                        <th>@GlobalFileListing.Destination_GL_Id</th>
                        <th>@GlobalFileListing.Destination_GL_Name</th>
                        <th>@GlobalFileListing.Reconciliation_Ref</th>
                        <th>@GlobalFileListing.Journal_Header_Id</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Html.Encode(Model?.SourceGLId ?? "-")</td>
                        <td>@Html.Encode(Model?.SglName ?? "-")</td>
                        <td>@Html.Encode(Model?.DestinationGLId ?? "-")</td>
                        <td>@Html.Encode(Model?.DestinationGLName ?? "-")</td>
                        <td>@Html.Encode(Model?.ReconciliationReference ?? "-")</td>
                        <td>@Html.Encode(Model?.JournalHeaderId ?? "-")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
