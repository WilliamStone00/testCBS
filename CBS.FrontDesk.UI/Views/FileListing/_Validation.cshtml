@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.ConfirmReconciliation

<div class="modal fade" id="confirmReconciliationModal" tabindex="-1" aria-labelledby="confirmReconciliationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "confirmReconciliationForm", @class = "needs-validation", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="col-12">
                        <div class="card bg-light mb-2 p-2">
                            <div class="card-body text-center py-2">
                                <h1 class="card-title text-primary mb-1">
                                    <i class="mdi mdi-account-group me-2"></i>Confirm Reconciliation
                                </h1>
                                <p class="card-text small mb-1">
                                    Take note: Once confirmed, the reconciliation process will be finalized and cannot be undone.
                                </p>
                                <hr style="border: 1px solid rgba(128, 128, 128, 0.35);" />
                            </div>
                        </div>
                    </div>

                    @Html.HiddenFor(m => m.Id)
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Branch ID</label>
                        @Html.TextBoxFor(m => m.BranchId, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-md-8 d-flex flex-column">
                                    @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                                    @Html.TextBoxFor(m => m.Memo, new { @class = "form-control", placeholder = "Memo", maxlength = "80" })
                                    @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger small" })
                                </div>

                                <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                                    <label for="AccountingDay" class="form-label mb-1">
                                        📅 Accounting Date
                                    </label>
                                    @Html.TextBoxFor(
                                        m => m.AccountingDate,
                                        new
                                        {
                                            @class = "form-control accounting-date",
                                            type = "date",
                                            id = "AccountingDay",
                                            required = "required",
                                            value = DateTime.Today.ToString("yyyy-MM-dd"),
                                            max = DateTime.Today.ToString("yyyy-MM-dd")
                                        })
                                    @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger small d-block" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="confirmFormAlert" class="d-none alert" role="alert"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="confirmModalSubmitBtn" class="btn btn-primary">
                        <i class="mdi mdi-check-all me-1"></i> Confirm
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Add event listener for modal close to properly clean up
    document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('confirmReconciliationModal');
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function () {
                // Remove backdrop and modal-open class
                document.body.classList.remove('modal-open');
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) {
                    backdrop.remove();
                }
            });
        }
    });
</script>