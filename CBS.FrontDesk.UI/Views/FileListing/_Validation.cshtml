@model CBS.FrontDesk.Data.Entity.Accounting_V2.Reconciliation.ConfirmReconciliation
@using (Html.BeginForm("", "", FormMethod.Post, new { id = "confirmReconciliationForm", @class = "needs-validation", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()

    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="mdi mdi-check-all me-2"></i> Confirm Reconciliation</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        @* Hidden fields *@
        @Html.HiddenFor(m => m.Id)
        <div class="mb-3">
            <label class="form-label small fw-bold">Branch ID</label>
            @Html.TextBoxFor(m => m.BranchId, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <!-- Memo Field -->
                    <div class="col-12 col-md-8 d-flex flex-column">
                        @Html.LabelFor(m => m.Memo, new { @class = "form-label mb-1" })
                        @Html.TextBoxFor(m => m.Memo, new { @class = "form-control", placeholder = "Memo", maxlength = "80" })
                        @Html.ValidationMessageFor(m => m.Memo, "", new { @class = "text-danger" })
                    </div>

                    <!-- Accounting Date Field -->
                    <div class="col-12 col-md-4 d-flex flex-column align-items-md-end">
                        <label for="AccountingDay" class="form-label mb-1">
                            📅 Accounting Date
                        </label>
                        @Html.TextBoxFor(
                            m => m.AccountingDate,
                            new
                            {
                                @class = "form-control accounting-date",
                                type = "date",
                                id = "AccountingDay",
                                required = "required",
                                value = DateTime.Today.ToString("yyyy-MM-dd"),
                                max = DateTime.Today.ToString("yyyy-MM-dd")
                            })
                        @Html.ValidationMessageFor(m => m.AccountingDate, "", new { @class = "text-danger d-block" })
                    </div>
                </div>
            </div>
        </div>

        @*<div class="mb-3">
                <label class="form-label small fw-bold">External Application</label>
                @Html.TextBoxFor(m => m.ExternalApplicationName, new { @class = "form-control", placeholder = "e.g. ImportTool" })
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Reconciliation Kind</label>
                @Html.TextBoxFor(m => m.ReconciliationKind, new { @class = "form-control", placeholder = "e.g. TrialBalance" })
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Reconciled By</label>
                @Html.TextBoxFor(m => m.ReconciledBy, new { @class = "form-control", placeholder = "User performing reconciliation" })
            </div>*@

        <div id="confirmFormAlert" class="d-none alert" role="alert"></div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" id="confirmModalSubmitBtn" class="btn btn-primary">
            <i class="mdi mdi-check-all me-1"></i> Confirm
        </button>
    </div>
}

<script>
    (function ($) {
        // Make sure this runs after jQuery loaded
        const confirmModalUrl = '@Url.Action("ConfirmModal", "FileListing")'; // GET partial
        const confirmPostUrl = '@Url.Action("ConfirmUpload", "FileListing")'; // POST endpoint (expects JSON)

        // when confirm button clicked - load partial and show modal
        $(document).on('click', '#confirmReconciliationBtn', function (e) {
            e.preventDefault();
            const id = $(this).data('id');
            const branch = $(this).data('branch');

            if (!id) {
                if (typeof appalert === 'function') appalert('Missing file id', 3, 1);
                else alert('Missing file id');
                return;
            }

            // build URL with id param
            const url = confirmModalUrl + '?id=' + encodeURIComponent(id);

            // show a lightweight loading modal while fetching (optional)
            const loadingHtml = `
                <div class="modal fade" id="confirmReconciliationModal" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body text-center p-4">
                                <div class="spinner-border" role="status"></div>
                                <div class="mt-3">Loading confirmation...</div>
                            </div>
                        </div>
                    </div>
                </div>`;
            $('#confirmReconciliationModalContainer').html(loadingHtml);
            const loadingModalEl = document.getElementById('confirmReconciliationModal');
            const loadingModal = new bootstrap.Modal(loadingModalEl, { backdrop: 'static', keyboard: false });
            loadingModal.show();

            // fetch partial
            fetch(url, { credentials: 'same-origin' })
                .then(r => {
                    if (!r.ok) throw new Error('Failed to load confirmation form');
                    return r.text();
                })
                .then(html => {
                    // replace modal content with loaded partial
                    $('#confirmReconciliationModalContainer').html(html);

                    // initialize the modal from the returned partial (expect modal markup in partial)
                    // If the partial has a modal already (header/footer) with id confirmReconciliationModal -> show it
                    let modalEl = document.getElementById('confirmReconciliationModal');
                    // If partial did not include a wrapper modal with that id, create one around the HTML
                    if (!modalEl) {
                        // wrap partial content in modal shell
                        const wrapped = `
                            <div class="modal fade" id="confirmReconciliationModal" tabindex="-1">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content">
                                        ${html}
                                    </div>
                                </div>
                            </div>`;
                        $('#confirmReconciliationModalContainer').html(wrapped);
                        modalEl = document.getElementById('confirmReconciliationModal');
                    }

                    // ensure form uses the id #confirmReconciliationForm
                    const modalInstance = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                    modalInstance.show();

                    // attach submit handler (delegated to document so duplicates won't stack)
                    // But first remove any previous delegated submit handler to avoid double-posts
                    $(document).off('submit', '#confirmReconciliationForm');
                    $(document).on('submit', '#confirmReconciliationForm', function (ev) {
                        ev.preventDefault();
                        submitConfirmForm($(this), modalInstance);
                    });
                })
                .catch(err => {
                    console.error(err);
                    loadingModal.hide();
                    if (typeof appalert === 'function') appalert('Failed to load confirmation dialog.', 2, 1);
                    else alert('Failed to load confirmation dialog.');
                });
        });

        // submit the form inside the modal (collect fields and post JSON)
        function submitConfirmForm($form, modalInstance) {
            const $btn = $form.find('#confirmModalSubmitBtn');
            const originalText = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status"></span> Processing...');

            // collect anti-forgery token
            const token = $form.find('input[name="__RequestVerificationToken"]').val();

            // build payload from inputs
            const payload = {
                id: $form.find('input[name="Id"]').val() || $form.find('input[name="Id"]').attr('value'),
                branchId: $form.find('input[name="BranchId"]').val(),
                accountingDate: $form.find('input[name="AccountingDate"]').val(),
                memo: $form.find('textarea[name="Memo"]').val(),
                externalApplicationName: $form.find('input[name="ExternalApplicationName"]').val(),
                reconciliationKind: $form.find('input[name="ReconciliationKind"]').val(),
                reconciledBy: $form.find('input[name="ReconciledBy"]').val()
            };

            fetch(confirmPostUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            })
            .then(r => {
                if (!r.ok) throw new Error('Network response was not ok');
                return r.json();
            })
            .then(data => {
                if (data && data.success) {
                    // success: close modal, show alert, reload table if present
                    if (typeof appalert === 'function') appalert('Reconciliation confirmed successfully!', 1, 1);
                    else alert('Reconciliation confirmed successfully!');

                    modalInstance.hide();

                    // reload parent DataTable or listing if available
                    if (window.table && typeof window.table.ajax === 'function') {
                        window.table.ajax.reload(null, false);
                    }
                } else {
                    const message = (data && data.message) ? data.message : 'Failed to confirm reconciliation.';
                    showFormAlert($form, message, 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                showFormAlert($form, 'Error confirming reconciliation. Please try again.', 'danger');
            })
            .finally(() => {
                $btn.prop('disabled', false).html(originalText);
            });
        }

        function showFormAlert($form, message, type) {
            const $alert = $form.find('#confirmFormAlert');
            if ($alert.length === 0) {
                $form.prepend(`<div id="confirmFormAlert" class="alert alert-${type}">${message}</div>`);
            } else {
                $alert.removeClass('d-none alert-success alert-danger alert-warning').addClass('alert-' + type).text(message).show();
            }
        }
    })(jQuery);
</script>
