@using Resources

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:12%" />  @* CreatedDate *@
                    <col style="width:18%" />  @* FileName *@
                    <col style="width:8%" />  @* FileType *@
                    <col style="width:14%" />  @* Branch *@
                    <col style="width:10%" />  @* UploadedBy *@
                    <col style="width:10%" />  @* Status *@
                    <col style="width:10%" />  @* FileCode *@
                    <col style="width:18%" />  @* MessageTemplate *@
                    <col style="width:10%" />  @* Actions *@
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>Created Date</th>
                        <th>File Name</th>
                        <th>Type</th>
                        <th>Branch</th>
                        <th>Uploaded By</th>
                        <th>Status</th>
                        <th>File Code</th>
                        <th>Message Template</th>
                        <th style="width:160px">Actions</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
