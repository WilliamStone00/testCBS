@using Resources

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:12%" />  @* CreatedDate *@
                    <col style="width:18%" />  @* FileName *@
                    @*<col style="width:8%" />*@  @* FileType *@
                    <col style="width:14%" />  @* Branch *@
                    <col style="width:10%" />  @* UploadedBy *@
                    <col style="width:10%" />  @* Status *@
                    <col style="width:18%" />  @* Purpose *@
                    <col style="width:18%" />  @* MessageTemplate *@
                    <col style="width:10%" />  @* Actions *@
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Created_Date</th>
                        <th>@GlobalShared.File Name</th>
                        @*<th>Type</th>*@
                        <th>@GlobalShared.Branch</th>
                        <th>@GlobalShared.Uploaded_By</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.Purpose</th>
                        <th>@GlobalShared.Message Template</th>
                        <th style="width:160px">@GlobalShared.Actions</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
