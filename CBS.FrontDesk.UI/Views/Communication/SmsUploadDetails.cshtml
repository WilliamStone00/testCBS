@model CBS.FrontDesk.Data.Entity.Communication.SmsFileUploadDetailsDto
@using Resources

@{
    ViewBag.Title = "SMS Upload Details";
    var file = Model?.File;
    var canSend = false;

    // You can also set this from controller using ViewBag.CanSend
    try
    {
        var st = (file?.Status ?? "").Trim();
        canSend = st.Equals("Viewed", StringComparison.OrdinalIgnoreCase);
    }
    catch { canSend = false; }
}

<style>
    .help-hint {
        font-size: .85rem;
    }

    .req-star {
        color: #dc3545;
        font-weight: 700;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">

        <!-- HEADER -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-success fw-bold mb-2">
                    <i class="mdi mdi-file-document-multiple-outline me-2"></i> SMS UPLOAD DETAILS
                </h1>

                <p class="card-text text-muted mb-2">
                    Review upload metadata, preview rows, then view sending history.
                </p>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.35);" />

                <div class="alert alert-info mt-3 d-flex align-items-center justify-content-center">
                    <i class="mdi mdi-information-outline me-2"></i>
                    <strong>FileUploadId:</strong>&nbsp;<span id="__fileUploadIdText">@($"{file?.Id}")</span>
                </div>
            </div>
        </div>

        <!-- TOP ACTIONS -->
        <div class="row mb-2">
            <div class="col-md-6 text-md-start mb-1 mb-md-0">
                <a href="/Communication/Index" class="btn btn-primary btn-sm shadow-sm px-3 w-100 w-md-auto">
                    <i class="mdi mdi-arrow-left me-1"></i> Back to Listing
                </a>
            </div>

            <div class="col-md-6 text-md-end">
                @if (canSend)
                {
                    <button class="btn btn-success btn-sm shadow-sm px-3 w-100 w-md-auto" id="btnSendSmsFromDetails">
                        <i class="mdi mdi-send-check-outline me-1"></i> Send SMS (Status: Viewed)
                    </button>
                }
                else
                {
            <button class="btn btn-secondary btn-sm shadow-sm px-3 w-100 w-md-auto" disabled
                    data-bs-toggle="tooltip"
                    title="Send is only enabled when Status is 'Viewed'.">
                <i class="mdi mdi-lock-outline me-1"></i> Send Disabled (Status: @($"{file?.Status}"))
            </button>
                }
            </div>
        </div>

        <div class="accordion mb-3" id="smsDetailsAccordion">

            <!-- =================================================== -->
            <!-- 1) FILE METADATA -->
            <!-- =================================================== -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingFileMeta">
                    <button class="accordion-button" type="button"
                            data-bs-toggle="collapse" data-bs-target="#collapseFileMeta"
                            aria-expanded="true" aria-controls="collapseFileMeta">
                        <i class="mdi mdi-information-outline me-2"></i> Upload Metadata
                    </button>
                </h2>

                <div id="collapseFileMeta" class="accordion-collapse collapse show" aria-labelledby="headingFileMeta">
                    <div class="accordion-body">

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">FileUploadId</label>
                                <input class="form-control" readonly value="@($"{file?.Id}")" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">File Code</label>
                                <input class="form-control" readonly value="@($"{file?.FileCode}")" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Branch</label>
                                <input class="form-control" readonly value="@($"{file?.BranchCode} - {file?.BranchName}")" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Status</label>
                                <input class="form-control" readonly value="@($"{file?.Status}")" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Sender Service</label>
                                <input class="form-control" readonly value="@($"{file?.SenderService}")" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Title</label>
                                <input class="form-control" readonly value="@($"{file?.Title}")" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Purpose</label>
                                <input class="form-control" readonly value="@($"{file?.Purpose}")" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">File Name</label>
                                <input class="form-control" readonly value="@($"{file?.FileName}")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Uploaded By / On</label>
                                <input class="form-control" readonly value="@($"{file?.UploadedBy} - {file?.UploadedOn:yyyy-MM-dd HH:mm}")" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Message Template</label>
                                <textarea class="form-control" rows="2" readonly>@($"{file?.MessageTemplate}")</textarea>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="badge bg-dark">Total: @(Model?.TotalRows ?? 0)</span>
                            <span class="badge bg-success">Valid: @(Model?.ValidRows ?? 0)</span>
                            <span class="badge bg-danger">Invalid: @(Model?.InvalidRows ?? 0)</span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- =================================================== -->
            <!-- 2) PREVIEW DATATABLE (SmsUploadDetailDto) -->
            <!-- =================================================== -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingPreviewRows">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#collapsePreviewRows"
                            aria-expanded="false" aria-controls="collapsePreviewRows">
                        <i class="mdi mdi-table-eye-outline me-2"></i> Preview Data (Rows)
                    </button>
                </h2>

                <div id="collapsePreviewRows" class="accordion-collapse collapse" aria-labelledby="headingPreviewRows">
                    <div class="accordion-body">

                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle" id="smsPreviewRowsTable">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Member Ref</th>
                                        <th>Receiver Phone</th>
                                        <th>Receiver Name</th>
                                        <th class="text-center">Status</th>
                                        <th>Validation Error</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <small class="text-muted d-block mt-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            Data source: <b>Model.Rows</b> (SmsUploadDetailDto).
                        </small>

                    </div>
                </div>
            </div>

            <!-- =================================================== -->
            <!-- 3) HISTORY DATATABLE (SmsFileUploadHistoryDto) -->
            <!-- =================================================== -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingHistory">
                    <button class="accordion-button" type="button"
                            data-bs-toggle="collapse" data-bs-target="#collapseHistory"
                            aria-expanded="true" aria-controls="collapseHistory">
                        <i class="mdi mdi-history me-2"></i> Send Details Listing
                        <span class="badge bg-primary ms-2">DataTable</span>
                    </button>
                </h2>

                <div id="collapseHistory" class="accordion-collapse collapse show" aria-labelledby="headingHistory">
                    <div class="accordion-body">

                        <div class="alert alert-secondary">
                            <i class="mdi mdi-filter-outline me-2"></i>
                            Default filter: <b>FileUploadId = @($"{file?.Id}")</b>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle w-100" id="smsHistoryTable">
                                <colgroup>
                                    <col style="width:12%" />  @* Sent On *@
                                    <col style="width:8%" />  @* Row *@
                                    <col style="width:14%" />  @* Recipient *@
                                    <col style="width:18%" />  @* Customer *@
                                    <col style="width:10%" />  @* Status *@
                                    <col style="width:18%" />  @* Error *@
                                    <col style="width:10%" />  @* Notification *@
                                    <col style="width:10%" />  @* Sent By *@
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Sent On</th>
                                        <th>Row</th>
                                        <th>Recipient</th>
                                        <th>Customer</th>
                                        <th>Status</th>
                                        <th>Error</th>
                                        <th>Notification</th>
                                        <th>Sent By</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <small class="text-muted d-block mt-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            Server-side DataTable: <b>GetSmsFileUploadHistoryDataTableQuery</b>
                        </small>

                    </div>
                </div>
            </div>

        </div><!-- end accordion -->
        <!-- hidden values -->
        <input type="hidden" id="__fileUploadId" value="@($"{file?.Id}")" />
        <input type="hidden" id="__senderService" value="@($"{file?.SenderService}")" />
        <input type="hidden" id="__title" value="@($"{file?.Title}")" />
        <input type="hidden" id="__purpose" value="@($"{file?.Purpose}")" />

        <!-- Status panel -->
        <div id="smsDetailsStatus" class="alert d-none"></div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();

            // 1) Preview rows DT (client-side from Model.Rows)
            initPreviewRowsTable(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model?.Rows ?? new List<CBS.FrontDesk.Data.Entity.Communication.SmsUploadDetailDto>())));

            // 2) History DT (server-side)
            initHistoryTable();

            // 3) Send button (only enabled if status == Viewed)
            $('#btnSendSmsFromDetails').on('click', function () {
                sendSmsFromDetails();
            });
        });

        function initPreviewRowsTable(rows) {
            rows = Array.isArray(rows) ? rows : [];

            if ($.fn.DataTable.isDataTable('#smsPreviewRowsTable')) {
                $('#smsPreviewRowsTable').DataTable().destroy();
            }

            $('#smsPreviewRowsTable').DataTable({
                data: rows,
                columns: [
                    { data: "RowNumber", className: "text-center", width: "60px",
                      render: (d) => d ?? '' },

                    { data: "MemberReference",
                      render: (d) => escapeHtml(d ?? '') },

                    { data: "ReceiverPhone",
                      render: (d) => escapeHtml(d ?? '') },

                    { data: "ReceiverName",
                      render: (d) => escapeHtml(d ?? '') },

                    { data: "IsValid", className: "text-center",
                      render: function (ok) {
                          const v = ok === true;
                          return v
                              ? '<span class="badge bg-success"><i class="mdi mdi-check-circle-outline me-1"></i>Valid</span>'
                              : '<span class="badge bg-danger"><i class="mdi mdi-close-circle-outline me-1"></i>Invalid</span>';
                      }
                    },

                    { data: "ValidationError",
                      render: (d) => d ? `<span class="text-danger">${escapeHtml(d)}</span>` : '<span class="text-muted">-</span>' },

                    { data: "Message",
                      render: (d) => d ? `<div style="min-width:260px; white-space:normal;">${escapeHtml(d)}</div>` : '<span class="text-muted">-</span>' }
                ],
                responsive: true,
                pageLength: 10,
                order: [],
                language: { emptyTable: "No preview rows found" }
            });
        }

        function initHistoryTable() {
            const fileUploadId = ($('#__fileUploadId').val() || '').trim();

            if ($.fn.DataTable.isDataTable('#smsHistoryTable')) {
                $('#smsHistoryTable').DataTable().destroy();
            }

            $('#smsHistoryTable').DataTable({
                serverSide: true,
                searching: true,
                orderMulti: false,
                pageLength: 10,
                order: [[0, 'desc']], // CreatedDate desc

                columnDefs: [
                    { targets: 0, width: '12%' },                  // Sent On
                    { targets: 1, width: '8%' },                  // Row
                    { targets: 2, width: '14%' },                  // Recipient
                    { targets: 3, width: '18%' },                  // Customer
                    { targets: 4, width: '10%' },                  // Status
                    { targets: 5, width: '18%' },                  // Error
                    { targets: 6, width: '10%', orderable: false },// Notification (optional)
                    { targets: 7, width: '10%' }                   // Sent By
                ],

                ajax: {
                    url: '/Communication/GetSmsFileUploadHistoryDataTable',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {

                        // DataTables -> our query
                        const q = {
                            Options: {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                searchValue: (d.search && d.search.value) ? d.search.value : null,
                                sortColumn: (d.order && d.order.length > 0) ? d.columns[d.order[0].column].data : null,
                                sortDirection: (d.order && d.order.length > 0) ? d.order[0].dir : null
                            },

                            // default filter
                            FileUploadId: fileUploadId,

                            // optional filters if you later add UI:
                            FileCode: null,
                            BranchId: null,
                            SentBy: null,
                            SenderService: null,
                            Purpose: null,
                            Title: null,
                            IsSentSuccessfully: null,
                            StartDate: null,
                            EndDate: null,
                            SearchTerm: null
                        };

                        return JSON.stringify(q);
                    }
                },
                columns: [
                    { data: "SentOn", name: 'Sent On', render: (d) => formatDate(d) },
                    { data: "RowNumber", name: 'Row' },
                    { data: "Recipient", name: 'Recipient', render: (d) => escapeHtml(d ?? '') },
                    { data: "CustomerName", name: 'Customer', render: (d) => escapeHtml(d ?? '') },
                    {
                        data: "IsSentSuccessfully", name: 'Status',
                        className: "text-center",
                        render: function (ok) {
                            const v = ok === true;
                            return v
                                ? '<span class="badge bg-success"><i class="mdi mdi-check-circle-outline me-1"></i>Sent</span>'
                                : '<span class="badge bg-danger"><i class="mdi mdi-close-circle-outline me-1"></i>Failed</span>';
                        }
                    },
                    {
                        data: "ErrorMessage", name: 'Error',
                        render: (d) => d ? `<span class="text-danger">${escapeHtml(d)}</span>` : '<span class="text-muted">-</span>'
                    },
                    {
                        data: "NotificationStatus", name: 'Notification',
                        render: function (d, t, row) {
                            const ns = escapeHtml(d ?? '');
                            const nid = escapeHtml(row?.NotificationId ?? '');
                            return `<div><b>${ns || '-'}</b><div class="text-muted small">${nid}</div></div>`;
                        }
                    },
                    { data: "SentBy", name: 'Sent By', render: (d) => escapeHtml(d ?? '') }
                ],
                order: [[0, "desc"]],
                language: { emptyTable: "No history found for this upload" }
            });
        }

        function sendSmsFromDetails() {
            const fileUploadId = ($('#__fileUploadId').val() || '').trim();
            if (!fileUploadId) {
                appalert('Missing FileUploadId.', 2, 1);
                return;
            }

            alertify.confirm("Confirmation",
                `Send SMS for this upload (FileUploadId: ${fileUploadId}) ?`,
                function () {

                    const payload = { FileUploadId: fileUploadId };

                    $('#btnSendSmsFromDetails').prop('disabled', true);

                    $.ajax({
                        type: 'POST',
                        url: '/Communication/SendSmsUpload',
                        data: JSON.stringify(payload),
                        contentType: 'application/json',
                        success: function (response) {

                            $('#btnSendSmsFromDetails').prop('disabled', false);

                            if (response && response.success) {
                                showDetailsStatus(`<i class="mdi mdi-check-circle-outline me-2"></i>${escapeHtml(response.message || 'SMS sending completed.')}`, 'success');

                                // Refresh history table
                                if ($.fn.DataTable.isDataTable('#smsHistoryTable')) {
                                    $('#smsHistoryTable').DataTable().ajax.reload(null, false);
                                }

                                appalert(response.message || 'SMS sent successfully.', 1, 1);
                            } else {
                                const msg = response?.message || 'SMS send failed.';
                                showDetailsStatus(escapeHtml(msg), 'danger');
                                appalert(msg, 2, 1);
                            }
                        },
                        error: function (err) {

                            $('#btnSendSmsFromDetails').prop('disabled', false);

                            if (err.status === 401) window.location.href = '/Authentication/Login';
                            else {
                                const msg = err.responseJSON?.message || err.statusText || 'An error occurred while sending SMS.';
                                showDetailsStatus(escapeHtml(msg), 'danger');
                                appalert(msg, 2, 1);
                            }
                        }
                    });

                },
                function () { appalert('Send cancelled', 3, 1); }
            );
        }

        function showDetailsStatus(messageHtml, type) {
            const $s = $('#smsDetailsStatus');
            $s.removeClass('d-none alert-danger alert-success alert-info alert-warning')
              .addClass(`alert alert-${type}`)
              .html(messageHtml);
        }

        function escapeHtml(str) {
            str = (str ?? '').toString();
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Accepts: ISO string, epoch number, /Date(1768564625834)/, or null
        function formatDate(d) {
            if (!d) return '-';

            try {
                let dt = null;

                // 1) ASP.NET: /Date(1768564625834)/  (may also include timezone like /Date(1768564625834+0100)/)
                if (typeof d === 'string' && d.indexOf('/Date(') === 0) {
                    const m = /\/Date\((\-?\d+)(?:[+-]\d+)?\)\//.exec(d);
                    if (m && m[1]) dt = new Date(parseInt(m[1], 10));
                }
                // 2) Epoch milliseconds as number
                else if (typeof d === 'number') {
                    dt = new Date(d);
                }
                // 3) ISO string
                else if (typeof d === 'string') {
                    dt = new Date(d);
                }
                // 4) Already a Date
                else if (d instanceof Date) {
                    dt = d;
                }

                if (!dt || isNaN(dt.getTime())) return escapeHtml(d);

                const yyyy = dt.getFullYear();
                const mm = String(dt.getMonth() + 1).padStart(2, '0');
                const dd = String(dt.getDate()).padStart(2, '0');
                const hh = String(dt.getHours()).padStart(2, '0');
                const mi = String(dt.getMinutes()).padStart(2, '0');

                return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
            } catch {
                return escapeHtml(d);
            }
        }

    </script>
}
