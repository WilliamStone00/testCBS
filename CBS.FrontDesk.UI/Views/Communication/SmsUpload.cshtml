@model CBS.FrontDesk.Data.Entity.Communication.SendSmsFileUploadCommand
@using Resources

@{
    ViewBag.Title = "SMS Upload (Bulk)";
}

<style>
    .upload-feedback {
        transition: all 0.3s ease;
    }

    #uploadStatus {
        transition: opacity 0.3s ease;
    }

    .progress-bar {
        transition: width 0.3s ease;
    }

    .help-hint {
        font-size: .85rem;
    }

    .req-star {
        color: #dc3545;
        font-weight: 700;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">

        <!-- HEADER -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-success fw-bold mb-2">
                    <i class="mdi mdi-message-processing-outline me-2"></i> SMS BULK UPLOAD
                </h1>

                <p class="card-text text-muted mb-2">
                    <strong>Communication Console</strong> — Upload → preview → send SMS in bulk.
                    <br />
                    Upload file, validate rows, preview computed messages, then send only once confirmed.
                </p>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.35);" />

                <div class="alert alert-info mt-3 d-flex align-items-center justify-content-center">
                    <i class="mdi mdi-information-outline me-2"></i>
                    <strong>Important:</strong>&nbsp;Preview is mandatory. Sending requires a valid <b>FileUploadId</b>.
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="row mb-2">
            <div class="col-md-6 text-md-end mb-1 mb-md-0">
                <a href="/Communication/Index" class="btn btn-primary btn-sm shadow-sm px-3 w-100 w-md-auto">
                    <i class="mdi mdi-view-list me-1"></i> SMS Upload Listing
                </a>
            </div>
            <div class="col-md-6 text-md-start">
                <a href="/Communication/DownloadSmsUploadTemplate"
                   class="btn btn-outline-secondary btn-sm shadow-sm px-3 w-100 w-md-auto"
                   data-bs-toggle="tooltip" title="Download template (CSV/Excel)">
                    <i class="mdi mdi-file-download-outline me-1"></i> Download Template
                </a>
            </div>
        </div>

        <div class="accordion mb-2" id="smsUploadAccordion">

            <!-- =================================================== -->
            <!-- 1) UPLOAD + PREVIEW -->
            <!-- =================================================== -->
            @using (Html.BeginForm("PreviewSmsUpload", "Communication", FormMethod.Post,
                new { id = "smsFileForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostSmsUploadPreview(this);" }))
            {
                @Html.AntiForgeryToken()

                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingSmsUpload">
                        <button class="accordion-button" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseSmsUpload"
                                aria-expanded="true" aria-controls="collapseSmsUpload">
                            <i class="mdi mdi-cloud-upload-outline me-2"></i>
                            SMS Upload + Preview
                            <span class="badge bg-success ms-2">Required</span>
                        </button>
                    </h2>

                    <div id="collapseSmsUpload" class="accordion-collapse collapse show" aria-labelledby="headingSmsUpload">
                        <div class="accordion-body">

                            <div class="alert alert-info mb-3">
                                <i class="mdi mdi-information-outline me-2"></i>
                                Fill required details then upload file for preview.
                            </div>

                            <div class="row g-3">

                                <!-- Branch -->
                                @*<div class="col-md-4">
                                    <label class="form-label fw-semibold">
                                        Branch <span class="req-star">*</span>
                                    </label>
                                    @Html.DropDownList("BranchId",
                                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                                        "--- Select Branch ---",
                                        new { @class = "form-select select2", id = "BranchId", required = "required" })
                                    <small class="text-muted help-hint">
                                        Required for audit (branch association).
                                    </small>
                                </div>*@

                                <!-- Sender Service -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Sender Service <span class="req-star">*</span>
                                    </label>
                                    @Html.TextBoxFor(m => m.SenderService,
                                        new { @class = "form-control", id = "SenderService", placeholder = "e.g. CMONEY / CAMCCUL", required = "required" })
                                    @Html.ValidationMessageFor(m => m.SenderService, "", new { @class = "text-danger small" })
                                </div>

                                <!-- Title -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Title <span class="req-star">*</span>
                                    </label>
                                    @Html.TextBoxFor(m => m.Title,
                                        new { @class = "form-control", id = "Title", placeholder = "e.g. Loan Reminder Campaign", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                                </div>

                                <!-- Purpose -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Purpose <span class="text-muted">(optional)</span>
                                    </label>
                                    @Html.TextBoxFor(m => m.Purpose,
                                        new { @class = "form-control", id = "Purpose", placeholder = "Optional: Salary notice / Loan arrears / Promo..." })
                                </div>

                                <!-- Default Message Template -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Default Message Template <span class="text-muted">(optional)</span>
                                    </label>
                                    @Html.TextAreaFor(m => m.DefaultMessageTemplate,
                                        new { @class = "form-control", id = "DefaultMessageTemplate", rows = "2", placeholder = "e.g Dear {Name} , your Balance is {Amount}." })
                                    <small class="text-muted help-hint">
                                        Sent to Preview endpoint as <code>defaultMessageTemplate</code>.
                                    </small>
                                </div>

                                <!-- File -->
                                <div class="col-md-12">
                                    <label for="smsFile" class="form-label fw-semibold">
                                        Select Upload File <span class="req-star">*</span>
                                    </label>

                                    <div class="input-group has-validation">
                                        <input type="file" name="file" class="form-control"
                                               id="smsFile" accept=".csv,.xlsx,.xls"
                                               required data-max-size="10485760" />

                                        <button class="btn btn-primary px-4" type="submit" id="btnSmsUploadPreview">
                                            <span class="upload-text">Upload & Preview</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                            <i class="mdi mdi-cloud-upload-outline ms-1"></i>
                                        </button>

                                        <div class="invalid-feedback">Please select a valid file (max 10MB).</div>
                                    </div>

                                    <div class="form-text">Supported: .csv, .xlsx, .xls</div>
                                </div>

                            </div>

                            <div class="upload-feedback mt-3">
                                <div id="uploadStatus" class="alert d-none"></div>
                            </div>

                        </div>
                    </div>
                </div>
            }

            <!-- =================================================== -->
            <!-- 2) PREVIEW TABLE -->
            <!-- =================================================== -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingSmsPreview">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseSmsPreview"
                            aria-expanded="false" aria-controls="collapseSmsPreview">
                        <i class="mdi mdi-file-document-outline me-2"></i> Preview Result (Rows)
                    </button>
                </h2>

                <div id="collapseSmsPreview" class="accordion-collapse collapse" aria-labelledby="headingSmsPreview">
                    <div class="accordion-body">

                        <div class="table-responsive mb-3">
                            <table class="table table-hover table-bordered align-middle" id="smsPreviewTable">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Member Ref</th>
                                        <th>Receiver Phone</th>
                                        <th>Receiver Name</th>
                                        <th class="text-center">Status</th>
                                        <th>Validation Error</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <span class="badge bg-dark" id="smsSumTotalRows">Total: 0</span>
                                <span class="badge bg-success" id="smsSumValidRows">Valid: 0</span>
                                <span class="badge bg-danger" id="smsSumInvalidRows">Invalid: 0</span>
                            </div>

                            <small class="text-muted d-block mt-2">
                                <i class="mdi mdi-information-outline me-1"></i>
                                Preview uses <b>SmsUploadDetailDto</b> rows (Message + IsValid + ValidationError).
                            </small>
                        </div>

                        <div id="smsGlobalErrors" class="alert alert-warning d-none"></div>

                    </div>
                </div>
            </div>

            <!-- =================================================== -->
            <!-- 3) SEND SMS -->
            <!-- =================================================== -->
            @using (Html.BeginForm("SendSmsUpload", "Communication", FormMethod.Post,
                new { id = "smsSendForm", onsubmit = "return AjaxPostSmsUploadSend(this);" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.FileUploadId, new { id = "FileUploadId" })

                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingSmsSend">
                        <button class="accordion-button" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseSmsSend"
                                aria-expanded="true" aria-controls="collapseSmsSend">
                            <i class="mdi mdi-send-check-outline me-2"></i> Send SMS (From Upload)
                            <span class="badge bg-primary ms-2">Send</span>
                        </button>
                    </h2>

                    <div id="collapseSmsSend" class="accordion-collapse collapse show" aria-labelledby="headingSmsSend">
                        <div class="accordion-body">

                            <div class="alert alert-secondary">
                                <i class="mdi mdi-information-outline me-2"></i>
                                Sending uses <b>SendSmsFileUploadCommand</b> with FileUploadId + SenderService + Title + Purpose + DefaultMessageTemplate.
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">FileUploadId</label>
                                    <input type="text" class="form-control" id="FileUploadIdDisplay" value="N/A" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Sender Service</label>
                                    <input type="text" class="form-control" id="SenderServiceDisplay" value="N/A" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Title</label>
                                    <input type="text" class="form-control" id="TitleDisplay" value="N/A" readonly />
                                </div>
                            </div>

                            <div class="row mt-3 mb-2">
                                <div class="col-md-12 text-end">
                                    <button type="submit" class="btn btn-primary" id="btnSendSmsUpload">
                                        <i class="mdi mdi-check-circle-outline me-2"></i> Send SMS (Uploaded File)
                                    </button>
                                </div>
                            </div>

                            <!-- Send response summary -->
                            <div id="smsSendStatus" class="alert d-none"></div>

                        </div>
                    </div>
                </div>
            }

        </div><!-- end accordion -->

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
$(document).ready(function () {
    $('[data-bs-toggle="tooltip"]').tooltip();

    if ($.fn.select2) {
        try { $('.select2').select2({ width: '100%' }); }
        catch (e) { console.warn('select2 init failed', e); }
    }
});
    </script>

    <script>
    // last preview summary
    window.__smsPreviewSummary = null;

    function AjaxPostSmsUploadPreview(form) {
        $.validator.unobtrusive.parse(form);
        if (!$(form).valid()) return false;

        // file max size check (10MB)
        const f = document.getElementById('smsFile');
        if (f && f.files && f.files[0]) {
            const maxSize = parseInt(f.getAttribute('data-max-size') || '10485760', 10);
            if (f.files[0].size > maxSize) {
                showUploadStatus('File too large. Max allowed is 10MB.', 'danger');
                return false;
            }
        }

        alertify.confirm("Confirmation", "Upload file for validation & preview?",
            function () {

                const btn = $('#btnSmsUploadPreview');
                btn.prop('disabled', true);
                btn.find('.spinner-border').removeClass('d-none');

                const ajaxConfig = {
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    success: function (response) {

                        btn.prop('disabled', false);
                        btn.find('.spinner-border').addClass('d-none');

                        if (response && response.success) {

                            // response.data is SmsUploadPreviewSummaryDto
                            const summary = response.data || null;
                            window.__smsPreviewSummary = summary;

                            showUploadStatus(response.message || 'Preview generated successfully', 'success');

                            // Fill FileUploadId for send step
                            const fileUploadId = summary?.FileUploadId || '';
                            $('#FileUploadId').val(fileUploadId);
                            $('#FileUploadIdDisplay').val(fileUploadId || 'N/A');

                            // show read-only fields
                            $('#SenderServiceDisplay').val($('#SenderService').val() || 'N/A');
                            $('#TitleDisplay').val($('#Title').val() || 'N/A');

                            const rows = summary?.Rows || [];
                            displaySmsPreview(rows);

                            // Use counts from summary
                            $('#smsSumTotalRows').text('Total: ' + (summary?.TotalRows ?? rows.length));
                            $('#smsSumValidRows').text('Valid: ' + (summary?.ValidRows ?? rows.filter(x => x.IsValid === true).length));
                            $('#smsSumInvalidRows').text('Invalid: ' + (summary?.InvalidRows ?? rows.filter(x => x.IsValid !== true).length));

                            // global validation errors
                            const errs = summary?.ValidationErrors || [];
                            if (errs.length > 0) {
                                $('#smsGlobalErrors')
                                    .removeClass('d-none')
                                    .html('<i class="mdi mdi-alert-outline me-2"></i><b>Validation Errors:</b><ul class="mb-0">' +
                                          errs.map(e => `<li>${escapeHtml(e)}</li>`).join('') +
                                          '</ul>');
                            } else {
                                $('#smsGlobalErrors').addClass('d-none').html('');
                            }

                            // auto open preview
                            const previewEl = document.getElementById('collapseSmsPreview');
                            if (previewEl && !previewEl.classList.contains('show')) {
                                new bootstrap.Collapse(previewEl, { toggle: true });
                            }

                        } else {
                            showUploadStatus((response && response.message) ? response.message : 'Preview failed', 'danger');

                            window.__smsPreviewSummary = null;
                            $('#FileUploadId').val('');
                            $('#FileUploadIdDisplay').val('N/A');
                            $('#smsGlobalErrors').addClass('d-none').html('');
                            displaySmsPreview([]);

                            $('#smsSumTotalRows').text('Total: 0');
                            $('#smsSumValidRows').text('Valid: 0');
                            $('#smsSumInvalidRows').text('Invalid: 0');
                        }
                    },
                    error: function (err) {

                        btn.prop('disabled', false);
                        btn.find('.spinner-border').addClass('d-none');

                        if (err.status === 401) window.location.href = '/Authentication/Login';
                        else showUploadStatus(err.responseJSON?.message || err.statusText || 'Upload failed', 'danger');
                    }
                };

                ajaxConfig.contentType = false;
                ajaxConfig.processData = false;
                $.ajax(ajaxConfig);
            },
            function () { appalert('Upload cancelled', 3, 1); }
        );

        return false;
    }

    function AjaxPostSmsUploadSend(form) {
        $.validator.unobtrusive.parse(form);

        const fileUploadId = ($('#FileUploadId').val() || '').trim();
        if (!fileUploadId) {
            appalert('Please upload and preview a file first. FileUploadId is missing.', 2, 1);
            return false;
        }

        const senderService = ($('#SenderService').val() || '').trim();
        const title = ($('#Title').val() || '').trim();

        if (!senderService || !title) {
            appalert('Sender Service and Title are required before sending.', 2, 1);
            return false;
        }

        alertify.confirm("Confirmation",
            `Send SMS for this upload (FileUploadId: ${fileUploadId}) ?`,
            function () {

                const payload = {
                    FileUploadId: fileUploadId,
                    /*SenderService: senderService,
                    Purpose: ($('#Purpose').val() || '').trim(),
                    Title: title,
                    DefaultMessageTemplate: ($('#DefaultMessageTemplate').val() || '').trim()*/
                };

                const btn = $('#btnSendSmsUpload');
                btn.prop('disabled', true);

                $.ajax({
                    type: 'POST',
                    url: form.action,
                    data: JSON.stringify(payload),
                    contentType: 'application/json',
                    success: function (response) {

                        btn.prop('disabled', false);

                        if (response && response.success) {
                            // response.data expected SmsFileUploadSendSummaryDto
                            const s = response.data || null;

                            const html = `
                                <i class="mdi mdi-check-circle-outline me-2"></i>
                                ${escapeHtml(response.message || 'SMS sending completed.')}<br/>
                                <hr/>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-dark">Total: ${(s?.TotalRows ?? 0)}</span>
                                    <span class="badge bg-success">Sent: ${(s?.SentCount ?? 0)}</span>
                                    <span class="badge bg-danger">Failed: ${(s?.FailedCount ?? 0)}</span>
                                    <span class="badge bg-warning text-dark">Skipped: ${(s?.SkippedCount ?? 0)}</span>
                                </div>
                            `;

                            showSendStatus(html, 'success');
                            appalert(response.message || 'SMS upload send completed.', 1, 1);

                        } else {
                            showSendStatus(escapeHtml(response?.message || 'SMS send failed.'), 'danger');
                            appalert(response?.message || 'SMS send failed.', 2, 1);
                        }
                    },
                    error: function (err) {

                        btn.prop('disabled', false);

                        if (err.status === 401) window.location.href = '/Authentication/Login';
                        else {
                            const msg = err.responseJSON?.message || err.statusText || 'An error occurred while sending SMS.';
                            showSendStatus(escapeHtml(msg), 'danger');
                            appalert(msg, 2, 1);
                        }
                    }
                });

            },
            function () { appalert('Send cancelled', 3, 1); }
        );

        return false;
    }

    function displaySmsPreview(rows) {
        rows = Array.isArray(rows) ? rows : [];

        if ($.fn.DataTable.isDataTable('#smsPreviewTable')) {
            $('#smsPreviewTable').DataTable().destroy();
        }

        $('#smsPreviewTable').DataTable({
            data: rows,
            columns: [
                { data: "RowNumber", title: "#", className: "text-center", width: "60px",
                  render: (d) => d ?? '' },

                { data: "MemberReference", title: "Member Ref",
                  render: (d) => escapeHtml(d ?? '') },

                { data: "ReceiverPhone", title: "Receiver Phone",
                  render: (d) => escapeHtml(d ?? '') },

                { data: "ReceiverName", title: "Receiver Name",
                  render: (d) => escapeHtml(d ?? '') },

                { data: "IsValid", title: "Status", className: "text-center",
                  render: function(ok){
                      const v = ok === true;
                      return v
                        ? '<span class="badge bg-success"><i class="mdi mdi-check-circle-outline me-1"></i>Valid</span>'
                        : '<span class="badge bg-danger"><i class="mdi mdi-close-circle-outline me-1"></i>Invalid</span>';
                  }
                },

                { data: "ValidationError", title: "Validation Error",
                  render: (d) => d ? `<span class="text-danger">${escapeHtml(d)}</span>` : '<span class="text-muted">-</span>' },

                { data: "Message", title: "Message",
                  render: (d) => d ? `<div style="min-width:260px; white-space:normal;">${escapeHtml(d)}</div>` : '<span class="text-muted">-</span>' }
            ],
            responsive: true,
            pageLength: 10,
            order: [],
            language: { emptyTable: "No preview data" }
        });
    }

    function showUploadStatus(message, type) {
        const $uploadStatus = $('#uploadStatus');
        $uploadStatus.removeClass('d-none alert-danger alert-success alert-info alert-warning')
            .addClass(`alert alert-${type}`)
            .html(`<i class="mdi mdi-${type === 'success' ? 'check' : 'alert'}-circle-outline me-2"></i>${message}`);
    }

    function showSendStatus(messageHtml, type){
        const $s = $('#smsSendStatus');
        $s.removeClass('d-none alert-danger alert-success alert-info alert-warning')
          .addClass(`alert alert-${type}`)
          .html(messageHtml);
    }

    function escapeHtml(str){
        str = (str ?? '').toString();
        return str
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
    </script>
}
