@using Resources

<div class="modal-body">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-success">
                        <i class="mdi mdi-file-export me-2"></i>@GlobalReconciledLine.export_reconciled_entries
                    </h1>
                    <p class="card-text"></p>

                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        @GlobalReconciledLine.export_reconciled_journal_entries_with_optional_filtering_and_format_selection.
                    </div>

                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Export_Format</label>
            <select class="form-select" id="reconciledExportFormat">
                <option value="excel">Excel (.xlsx)</option>
                <option value="pdf">PDF (.pdf)</option>
                <option value="csv">CSV (.csv)</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Report_Type</label>
            <select class="form-select" id="reconciledReportType">
                <option value="full">@GlobalShared.Full_Report</option>
                <option value="detailed">@GlobalShared.detailed_report</option>
                <option value="summary">@GlobalShared.Summary_Report</option>
                <option value="byBranch">@GlobalShared.By_Branch</option>
                <option value="byAccount">@GlobalShared.by_account</option>
            </select>
        </div>
    </div>

    <!-- Date Range -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.Date_Range (@GlobalShared.Optional)</label>
            <div class="input-group">
                <input type="date" class="form-control" id="reconciledStartDate">
                <span class="input-group-text">To</span>
                <input type="date" class="form-control" id="reconciledEndDate">
            </div>
            <small class="text-muted">@GlobalReconciledLine.leave_empty_to_include_all_dates.</small>
        </div>

        <!-- File Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">@GlobalShared.File_Name</label>
            <input type="text" class="form-control" id="reconciledFileName"
                   value="Reconciled_Entries_Report"
                   placeholder="Enter file name">
        </div>
    </div>

    <!-- Additional Options -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="includeSummary" checked>
                <label class="form-check-label fw-semibold" for="includeSummary">
                    @GlobalReconciledLine.include_summary_sheet
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="includeAllSheets" checked>
                <label class="form-check-label fw-semibold" for="includeAllSheets">
                    @GlobalReconciledLine.include_all_analysis_sheets
                </label>
            </div>
        </div>
    </div>

    <!-- Filter Summary -->
    <!--<div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-warning">
                <i class="mdi mdi-filter-outline me-1"></i>
                <strong>Current Filters Applied:</strong>
                <div id="exportFilterSummary" class="mt-1 small">-->
    <!-- Will be populated by JavaScript -->
    <!--</div>
            </div>
        </div>
    </div>-->

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close me-1"></i>@GlobalShared.Cancel
    </button>

    <button type="button" class="btn btn-success" id="btnConfirmReconciledExport">
        <i class="mdi mdi-export me-1"></i>@GlobalShared.Export
    </button>
</div>