<style>


    .table tbody tr td {
        vertical-align: middle;
        color: #555;
    }

    .table thead th {
        background-color: #f1f1f1;
        font-weight: 600;
        color: #333;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }
</style>





@model System.Collections.Generic.IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.ReconciledLine.Reconciled>
@using Resources
@{
    var header = Model?.FirstOrDefault();
    decimal totalDebit = 0;
    decimal totalCredit = 0;
}

<div class="modal-body">

    <!-- Header Section -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary">
                <i class="mdi mdi-file-document-outline me-2"></i> @GlobalReconciledLine.reconciled_journals
            </h1>
            <p class="card-text">
                <strong>@GlobalReconciledLine.reconciled_line_module</strong> – @GlobalReconciledLine.view_and_analyze_journal_entries_reconciled_by_reference_branch_and_account_check_debit_credit_totals_and_balances_for_each_entry.
            </p>
            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

            <div class="alert alert-info mt-3">
                <i class="mdi mdi-alert-circle-outline me-2"></i>
                <strong>@GlobalShared.Important:</strong> @GlobalReconciledLine.ensure_the_journal_reference_you_select_exists_and_has_reconciled_lines_before_viewing_details.
            </div>
        </div>
    </div>

    <!-- ===================== JOURNAL HEADER ===================== -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-file-document me-1"></i> @GlobalShared.journal_information
    </h6>

    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr>
                <th class="bg-label">@GlobalShared.journal_header</th>
                <td>@header.JournalHeaderId</td>
            </tr>
            <tr>
                <th class="bg-label" id="reference">@GlobalShared.Reference</th>
                <td>@header.ReferenceNumber</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Branch</th>
                <td>@header.BranchName</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Entry_Date</th>
                <td>@header.EntryDate.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.User</th>
                <td>@header.UserName</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.InterBranch</th>
                <td>@(header?.InterbranchStatus == true ? "Yes" : "No")</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Initiated_By</th>
                <td>@header.CreatedBy</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Created_Date</th>
                <td>@header.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Approved_by</th>
                <td>
                    @(string.IsNullOrWhiteSpace(header.ApprovedBy)
                    ? "-"
                    : header.ApprovedBy)
                </td>
            </tr>
            <tr>
                <th class="bg-label">@GlobalShared.Approval_date</th>
                <td>
                    @(header.ApprovalDate != DateTime.MinValue
            ? header.ApprovalDate.ToString("dd/MM/yyyy HH:mm")
            : "-")
                </td>
            </tr>

            <tr>
                <th class="bg-label">@GlobalShared.Rejected_By</th>
                <td>
                    @(string.IsNullOrWhiteSpace(header.RejectedBy)
            ? "-"
            : header.RejectedBy)
                </td>
            </tr>

            <tr>
                <th class="bg-label">@GlobalShared.Rejected_Date</th>
                <td>
                    @(header.RejectedDate != DateTime.MinValue
            ? header.RejectedDate.ToString("dd/MM/yyyy HH:mm")
            : "-")
                </td>
            </tr>

        </tbody>
    </table>

    <!-- ===================== JOURNAL LINES ===================== -->
    <h6 class="fw-bold text-primary border-bottom pb-1 mb-2">
        <i class="mdi mdi-table me-1"></i> @GlobalReconciledLine.reconciled_journal_lines
    </h6>

    <div class="card border-0">
        <div class="card-body card-body-tight">
            <table class="table table-hover table-striped mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@GlobalShared.Account_No</th>
                        <th>@GlobalShared.Account_Name</th>
                        <th>@GlobalShared.Description</th>
                        <th class="text-end">@GlobalShared.Debit (FCFA)</th>
                        <th class="text-end">@GlobalShared.Credit (FCFA)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.OrderBy(x => x.Seq))
                    {
                        totalDebit += line.DebitAmount;
                        totalCredit += line.CreditAmount;

                        <tr>
                            <td>@line.Seq</td>
                            <td>@line.AccountNumber</td>
                            <td>@line.AccountName</td>
                            <td>@line.Description</td>
                            <td class="text-end">
                                @(line.DebitAmount > 0 ? line.DebitAmount.ToString("N0") : "-")
                            </td>
                            <td class="text-end">
                                @(line.CreditAmount > 0 ? line.CreditAmount.ToString("N0") : "-")
                            </td>
                        </tr>
                    }

                    <!-- TOTALS -->
                    <tr class="fw-bold bg-light">
                        <td colspan="4" class="text-end">@GlobalShared.Totals</td>
                        <td class="text-end">@totalDebit.ToString("N0")</td>
                        <td class="text-end">@totalCredit.ToString("N0")</td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>



<!-- ================= MODAL FOOTER ================= -->
<div class="modal-footer d-flex justify-content-between">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close"></i> @GlobalShared.Close
    </button>

    <div>

        <button type="button" id="btnPrintAccountingReport" class="btn btn-primary me-2">
            <i class="mdi mdi-file-excel-outline"></i> @GlobalShared.Print
        </button>


        <button type="button" id="btnExportExcel" class="btn btn-outline-primary me-2">
            <i class="mdi mdi-file-excel-outline"></i> @GlobalShared.Export_Excel
        </button>

    </div>
</div>



<script>

     $(document).on('click', '#btnExportExcel', function () {

      const referenceNumber = '@(header?.ReferenceNumber ?? "")';

      console.log('Export clicked');
      console.log('ReferenceNumber from Razor:', referenceNumber);

      if (!referenceNumber) {
          appalert("Invalid reference number!", 3, 1);
          return;
      }

      const url =
          '@Url.Action("DownloadReconciledLinesExcel", "ReconciledLine")'
          + '?referenceNumber=' + encodeURIComponent(referenceNumber);

      console.log('Redirecting to:', url);
      window.location.href = url;
  });

</script>



