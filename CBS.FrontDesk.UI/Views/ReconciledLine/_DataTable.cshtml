

@using Resources
<div class="card p-3 shadow mb-2">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped align-middle">

             <colgroup>
                  <col style="width:11%"/>  <!-- Entry Date -->
                <col style="width:10%"/>  <!-- Account Number -->
                <col style="width:15%"/>  <!-- Account Name -->
                <col style="width:11%"/>  <!-- Reference -->
                <col style="width:12%"/>  <!-- Auxiliary Ref -->
                <col style="width:18%"/>  <!-- Description -->
                <col style="width:8%"/>   <!-- Debit -->
                <col style="width:8%"/>   <!-- Credit -->
                <col style="width:7%"/>   <!-- Actions -->
 </colgroup>
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Entry_Date</th>
                    <th>@GlobalShared.Account_Number </th>
                    <th>@GlobalShared.Account_Name </th>
                    <th>@GlobalShared.Reference</th>
                    <th>@GlobalShared.Auxiliary_Ref </th>
                    <th>@GlobalShared.Description</th>
                    <th>@GlobalShared.Debit</th>
                    <th>@GlobalShared.Credit</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>