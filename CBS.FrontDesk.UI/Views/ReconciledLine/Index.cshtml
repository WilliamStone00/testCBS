@model  CBS.FrontDesk.Data.Entity.AccountingV2.ReconciledLine.Reconciled
@using Resources
@{
    ViewBag.Title = "Reconciled Ledger Line";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> @GlobalReconciledLine.reconciled_ledger_line
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @GlobalReconciledLine.use_the_filters_below_to_search_and_review_reconciled_ledger_line_efficiently.
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.FILTER_USAGE_GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>@GlobalShared.Branch_Filter:</strong> @GlobalReconciledLine.check_the_box_to_enable_branch_selection_you_can_show_or_hide_it_as_needed.</li>
                <li><strong>@GlobalShared.Operation_type:</strong> @Html.Raw(@GlobalReconciledLine.choose_whether_to_view_cash_in_or_cash_out_operations).</li>
                <li><strong>@GlobalShared.Reconciliation_Status:</strong> @Html.Raw(@GlobalReconciledLine.filter_between_temporary_or_reconciled_journal_entries).</li>
                <li><strong>@GlobalShared.Reference:</strong> @GlobalReconciledLine.enter_a_reference_number_or_keyword_to_search_for_specific_transactions.</li>
                <li><strong>@GlobalShared.Date_Filters:</strong> @GlobalReconciledLine.use_the_toggle_to_show_or_hide_accounting_and_creation_date_filters_you_can_filter_by_range_for_better_results.</li>
                <li><strong>@GlobalShared.Apply_filters:</strong> @Html.Raw(@GlobalReconciledLine.click_search_to_load_matching_results_in_the_table_below).</li>
                <li><strong>@GlobalShared.Reset_Filters:</strong> @GlobalReconciledLine.use_the_reset_button_to_clear_all_filters_and_start_a_new_search.</li>
                <li><strong>@GlobalShared.Tip:</strong> @GlobalReconciledLine.combine_filters_eg_branch_date_for_more_precise_results.</li>
            </ul>
        </div>
    </div>
</div>





<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.ADVANCE_FILTERS
    </h5>

    <form id="FilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-2 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            @GlobalShared.Show_Branch_Filter
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('CounterbranchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            @GlobalReconciledLine.show_counter_party_branch_filter
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            @GlobalShared.Show_Entry_Date_Filters
                        </label>
                    </div>
                </div>

                <div class="col-md-3 mb-1 d-flex align-items-center mt-4">
                    <div class="form-check">
                        @Html.CheckBox("IsInterbranch", false, new { @class = "form-check-input", id = "IsInterbranch" })
                        <label class="form-check-label fw-bold" for="IsInterbranch">@GlobalShared.Is_Interbranch</label>
                    </div>
                </div>


            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">@GlobalShared.Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            $"--- {@GlobalShared.Select_Branch} ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>

                    
                </div>
            </div>
            <div id="CounterbranchFilter" class="d-none">
                <div class="row mb-1">
                    

                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">@GlobalReconciledLine.counterparty_branchid</label>
                        @Html.DropDownList("CounterpartyBranchId",
                            new SelectList(ViewBag.CounterBranches ?? new List<object>(), "Id", "Name"),
                            $"--- {@GlobalShared.Select_Branch} ---",
                            new { @class = "form-control select2 mb-1", @id = "CounterpartyBranchId" })
                    </div>
                </div>
            </div>


           




            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">@GlobalShared.Reference_Number</label>
                    <input type="text" id="referenceNumber" name="ReferenceNumber" class="form-control mb-1" placeholder="Enter Reference Number" />
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">@GlobalShared.Username</label>
                    <input type="text" id="userName" name="UserName" class="form-control mb-1" placeholder="Enter User Name" />
                </div>

                <div class="col-md-4 mb-1">
                    @Html.LabelFor(m => m.BranchAccountId, "Select GL",new { @class = "form-label fw-semibold" })
                    @Html.DropDownListFor(m => m.BranchAccountId,new List<SelectListItem>{new SelectListItem {Text = "--- Select GL ---", Value = "" }},
                          new{@class = "form-control select2 mb-2",@id = "BranchAccountId",required = "required"})
                </div>

            </div>







            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold" for="startDate">@GlobalShared.Start_Entry_Date</label>
                        <input type="datetime" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold" for="endDate">@GlobalShared.End_Entry_Date</label>
                        <input type="datetime" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>


                </div>
            </div>


        </div>





        <div class="row g-2 mt-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Apply_filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset_Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btnExportReconciled" class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> @GlobalShared.Export
                </button>
            </div>
        </div>




    </form>
</div>


<hr />



<div id="datalistingview">
    @Html.Partial("_DataTable")
</div>



<div class="modal fade" id="reconciledExportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
           

            @Html.Partial("_ExportTableReconciled")

        </div>
    </div>
</div>


<div class="modal fade" id="reconciledModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- AJAX will load _Details.cshtml here -->
        </div>
    </div>
</div>



@section Scripts {


    @Scripts.Render("~/bundles/jqueryval")


    <script>
        function loadReconciledLinesData() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: false,
                order: [[0, 'desc']], // CreatedDate desc (adjusted from [[1, 'desc']] since CreatedDate is first column)
                ajax: {
                    url: '/ReconciledLine/LoadDataTable',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectReconciledLinesFilters();
                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (xhr, status, err) {
                        console.error('❌ Error loading reconciled lines:', status, err);
                        appalert('❌ Failed to load reconciled lines. Status: ' + xhr.status, 4, 1);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        name: 'CreatedDate',
                        render: function (data) {
                            return data ? moment(data).format('YYYY-MM-DD HH:mm') : '';
                        }
                    },
                    { data: 'AccountNumber', name: 'AccountNumber' },
                    { data: 'AccountName', name: 'AccountName' },
                    { data: 'ReferenceNumber', name: 'ReferenceNumber' },
                    { data: 'AuxiliaryRef', name: 'AuxiliaryRef' },
                    { data: 'Description', name: 'Description' },
                    {
                        data: 'DebitAmount',
                        name: 'DebitAmount',
                        render: function (data) {
                            return data > 0 ? data.toLocaleString() : '-';
                        }
                    },
                    {
                        data: 'CreditAmount',
                        name: 'CreditAmount',
                        render: function (data) {
                            return data > 0 ? data.toLocaleString() : '-';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
                                <div class="text-center">
                                    <button class="btn btn-sm btn-info view-details" data-id="${row.ReferenceNumber}">
                                        <i class="mdi mdi-eye-outline me-1"></i> Details
                                    </button>
                                </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    appalert('✅ Reconciled lines loaded successfully!', 1, 1);
                },
                drawCallback: function () {
                    const api = this.api();
                    if (api.rows({ page: 'current' }).data().length === 0) {
                        appalert('⚠️ No records found for the selected filters.', 2, 1);
                    }
                }
            });
        }

        function collectReconciledLinesFilters() {
            return {
                BranchId: $('#branchId').val(),
                CounterpartyBranchId: $('#CounterpartyBranchId').val(),
                ReferenceNumber: $('#referenceNumber').val(),
                UserName: $('#userName').val(),
                StartDate: $('#startDate').val(),
                EndDate: $('#endDate').val(),
                IsInterbranch: $('#IsInterbranch').is(':checked'),
                Options: {}
            };
        }
        // ==============================
        // Filter Buttons
        // ==============================
        $(document).ready(function () {

            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                loadReconciledLinesData();
            });

            $('#resetFilterBtn').on('click', function () {
                $('#FilterForm').trigger('reset');
                $('.select2').val('').trigger('change');
                $('#branchFilter, #dateFilters').addClass('d-none');
                appalert('🧹 Filters reset.', 1, 1);
            });

            // Optional initial load
            // loadReconciledLines();
        });

               // Use event delegation because buttons are rendered dynamically
        // Event delegation for dynamically generated buttons
        $('#myDataTable').on('click', '.view-details', function () {
            var referenceNumber = $(this).data('id');

            $.ajax({
                url: '/ReconciledLine/Details',
                type: 'GET',
                data: { referenceNumber: referenceNumber },
                success: function (html) {
                    // Inject the partial view HTML into the modal
                    $('#reconciledModal .modal-content').html(html);
                    // Show the modal
                    $('#reconciledModal').modal('show');
                },
                error: function () {
                    alert('Failed to load details.');
                }
            });
        });





        // ==================== Load GL Accounts by Branch ====================
        function loadBranchAccounts(branchId) {

            if (!branchId) {
                $('#BranchAccountId')
                    .html('<option value="">--- Select GL ---</option>')
                    .trigger('change');
                return;
            }

            $.ajax({
                url: '/ReconciledLine/GetBranchAccounts',
                type: 'GET',
                data: { branchId: branchId },
                dataType: 'json',
                success: function (response) {

                    if (!response.success || !response.data) {
                        appalert(response.message || '⚠️ No GL accounts found for this branch.', 2, 1);
                        return;
                    }

                    let options = '<option value="">--- Select GL ---</option>';

                    $.each(response.data, function (i, item) {
                        options += `<option value="${item.Value}">${item.Text}</option>`;
                    });

                    $('#BranchAccountId')
                        .html(options)
                        .trigger('change');

                    appalert('✅ GL accounts loaded successfully.', 1, 1);
                },
                error: function (err) {
                    appalert('❌ Error loading GL accounts: ' + err.statusText, 0, 1);
                }
            });
        }

        // ==================== Branch Change Event ====================
        $(document).ready(function () {

            $('#branchId').on('change', function () {
                const branchId = $(this).val();
                loadBranchAccounts(branchId);
            });

        });

        $('#btnExportReconciled').on('click', function () {
            const modalEl = document.getElementById('reconciledExportModal');
            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();
        });

        $('#btnConfirmReconciledExport').on('click', function () {
            let filters = collectReconciledLinesFilters(); // Your filter collection function
            let exportOptions = {
                FileName: $("#reconciledFileName").val(),
                Format: $("#reconciledExportFormat").val(),
                ReportType: $("#reconciledReportType").val(),
                StartDate: $("#reconciledStartDate").val(),
                EndDate: $("#reconciledEndDate").val(),
                IncludeSummary: $("#includeSummary").is(":checked")
            };

            let request = { 
                Filters: filters, 
                ExportOptions: exportOptions 
            };

            $("#btnConfirmReconciledExport").prop("disabled", true).html(`<span class="spinner-border spinner-border-sm"></span> Exporting...`);

            $.ajax({
                url: '@Url.Action("ExportReconciledData", "ReconciledLine")',
                type: "POST",
                data: JSON.stringify(request),
                contentType: "application/json",
                xhrFields: { responseType: 'blob' },
                success: function (data, status, xhr) {
                    let disposition = xhr.getResponseHeader("Content-Disposition");
                    let filename = "ReconciledEntries.xlsx";
                    if (disposition && disposition.indexOf("filename=") !== -1) {
                        filename = disposition.split("filename=")[1].trim();
                    }
                    let blob = new Blob([data]);
                    let link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = filename;
                    link.click();
                    $("#reconciledExportModal").modal("hide");
                    toastr.success("Export completed successfully.");
                },
                error: function (xhr) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        toastr.error(response.message || "Export failed.");
                    } catch (e) {
                        toastr.error("Export failed. Please try again.");
                    }
                },
                complete: function () {
                    $("#btnConfirmReconciledExport").prop("disabled", false).html(`<i class="mdi mdi-export"></i> Export`);
                }
            });
        });



    </script>
}