@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
    @using Resources
@if (Model.Tellers.Any())
{
    <table class="table table-hover table-responsive" id="myDataTable_teller">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.Teller</th>
                <th>@GlobalShared.Code</th>
                <th>@GlobalOtherTransaction.min_max_amount_to_manage</th>
                <th>@GlobalShared.teller_type</th>
                <th>@GlobalShared.Status</th>
                <th>@GlobalShared.Branch</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Tellers)
            {
                <tr>
                    <td style="width:20%">@d.name</td>
                    <td style="width:5%">@d.code</td>
                    <td style="width:20%">
                        @d.MinimumAmountToManage.ToString("#,##0.0") - @d.MaximumAmountToManage.ToString("#,##0.0")
                    </td>
                    <td style="width:10%">
                        @if (d.isPrimary)
                        {
                            <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalShared.primary</span></label>
                        }
                        else
                        {
                            <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">-</span></label>
                        }
                    </td>
                    <td style="width:10%">
                        @if (d.activeStatus)
                        {
                            <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalShared.Active</span></label>
                        }
                        else
                        {
                            <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalShared.InActive</span></label>
                        }
                    </td>
                    <td style="width:25%">@d.Branch.Name</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview','_PrimaryTeller','get','TellerManagement',null)" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.name @GlobalShared.ToEdit">@GlobalShared.Edit |</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.name" onclick="DeleteRecordDataTable('TellerManagement','@d.id','myDataTable','_PrimaryTellerData',0,'datalistingview')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
<div class="text-center my-5">
    <p>@GlobalOtherTransaction.no_data_available_click_to_add_new:</p>
    <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_PrimaryTeller','new','TellerManagement',null)" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
    </a>
</div>
}

