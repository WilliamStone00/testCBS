@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Details
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @using (Html.BeginForm("AddOrUpdate", "OtherTransaction", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <input type="hidden" name="ServiceOption" value="primary_OtherTransaction" id="ServiceOption" />
                                <fieldset class="fieldset-custom">
                                    <legend>OtherTransaction details</legend>
                                    <div class="row mt-2 gy-4">

                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.RadioButtonFor(m => m.OtherTransaction.TransactionType, "Income", new { @class = "form-check-input", id = "incomeOption" })
                                                <label class="form-check-label" for="incomeOption">Income</label>
                                            </div>
                                            <div class="form-check">
                                                @Html.RadioButtonFor(m => m.OtherTransaction.TransactionType, "Expense", new { @class = "form-check-input", id = "expenseOption" })
                                                <label class="form-check-label" for="expenseOption">Expenses</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.RadioButtonFor(m => m.OtherTransaction.SourceType, "MemberAccount", new { @class = "form-check-input", id = "incomeOption" })
                                                <label class="form-check-label" for="incomeOption">Pay with member's account</label>
                                            </div>
                                            <div class="form-check">
                                                @Html.RadioButtonFor(m => m.OtherTransaction.SourceType, "CashCollection", new { @class = "form-check-input", id = "expenseOption" })
                                                <label class="form-check-label" for="expenseOption">Collect cash from member</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.OtherTransaction.EventCode, new SelectList(ViewBag.Branches, "Id", "Name"), "---Select branch---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.OtherTransaction.EventCode, "", new { @class = "text-danger" })
                                                <label>Event Code</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.OtherTransaction.AccountNumber, new SelectList(ViewBag.Source, "Value", "Text"), "---Source account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.OtherTransaction.AccountNumber, "", new { @class = "text-danger " })
                                                <label for="formValidationDob">Select member account</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.OtherTransaction.Description, new { @class = "form-control", @style = "height: 75px;", @id = "DepositerNote" })
                                                @Html.ValidationMessageFor(m => m.OtherTransaction.Description, "", new { @class = "text-danger" })
                                                <label>Description</label>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                                <div class="mt-4">
                                    @*@if (Model.OtherTransaction.id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    { <button type="submit" class="btn btn-primary me-2">Update</button>
                                        @Html.HiddenFor(m => m.OtherTransaction.id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }*@
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

