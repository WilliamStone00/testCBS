@{
    ViewBag.Title = "Suspicious Path Management";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-danger">
                    <i class="mdi mdi-shield-alert me-2"></i> Suspicious Path Monitoring
                </h1>
                <p class="card-text text-muted">
                    Manage URL patterns used for threat detection in incoming requests.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Use simple paths (e.g., /wp-login.php) or regex patterns (e.g., ^/admin.*).</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> Only enable regex if the pattern uses expressions.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Patterns are matched in lower case.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main View -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-shield-lock-outline me-2"></i> Suspicious Path Configuration
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-4">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button" onclick="LoadDataGen('SuspiciousPath','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                            <i class="mdi mdi-view-list mdi-18px"></i> View List
                                        </a>
                                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','SuspiciousPath')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Path">
                                            <i class="mdi mdi-plus mdi-18px"></i> Add Path
                                        </a>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_Create")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
