@{
    ViewBag.Title = "IPS Claims Management";
}
@using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>@GlobalIPSClaim.IPS_Claims_Management
                </h1>
                <p class="card-text">
                    @GlobalIPSClaim.Manage_Insurance_Premium_System_claims_for_loan_protection_and_life_savings
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @GlobalIPSClaim.Create_track_and_process_insurance_claims_for_members
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalIPSClaim.IPS_Claims_Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClaimTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseClaimTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>@GlobalShared.Member_Verification:</strong> @GlobalIPSClaim.Verify_member_details_and_eligibility_before_creating_a_claim
                </li>
                <li>
                    <i class="mdi mdi-file-document-outline text-warning me-2"></i>
                    <strong>@GlobalShared.Documentation:</strong> @GlobalIPSClaim.Ensure_all_required_documents_are_uploaded_before_processing_claims
                </li>
                <li>
                    <i class="mdi mdi-cash-multiple text-success me-2"></i>
                    <strong>@GlobalShared.Amount_Verification:</strong> @GlobalIPSClaim.Verify_claimed_amounts_against_member_balances_and_coverage_limits
                </li>
                <li>
                    <i class="mdi mdi-account-group text-primary me-2"></i>
                    <strong>@GlobalShared.Beneficiary Info:</strong> @GlobalIPSClaim.Collect_accurate_beneficiary_information_for_claim_settlement
                </li>
                <li>
                    <i class="mdi mdi-calendar-check text-danger me-2"></i>
                    <strong>@GlobalShared.Event_Date:</strong> @GlobalIPSClaim.Ensure_the_event_date_is_within_the_coverage_period
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <strong>@GlobalShared.Approval_Process:</strong> @GlobalIPSClaim.Follow_the_approval_workflow_Registered_Pending_Approved_Posted
                </li>
                <li>
                    <i class="mdi mdi-bank text-info me-2"></i>
                    <strong>@GlobalShared.Posting:</strong> @GlobalIPSClaim.After_approval_post_the_claim_to_accounting_for_settlement
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "IPSClaim")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','IPSClaim')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="AddNew">
            <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add_New_LC
        </a>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <div id="datalistingview">
        @Html.Partial("_Create")
    </div>
</div>

<!-- Action Modals -->
@Html.Partial("_ActionModal")

@section Scripts {
    <script>
        /* ============================
           GLOBAL VARIABLES
        ============================ */
        let memberData = null;
        let memberBalances = {
            totalAccountBalance: 0,
            totalLoanBalance: 0,
            netClaimableAmount: 0
        };

        function formatDateTime(value) {
            if (!value) return '-';

            // Handle the /Date(...)/ format from .NET
            if (typeof value === 'string' && value.startsWith('/Date(')) {
                const timestamp = parseInt(value.match(/\d+/)[0]);
                return moment(timestamp).format('DD/MM/YYYY HH:mm:ss');
            }

            // Handle ISO date strings or Date objects
            if (window.moment && moment(value).isValid()) {
                return moment(value).format('DD/MM/YYYY HH:mm:ss');
            }

            // Return original value if moment fails
            return value;
        }

        /* ============================
           MEMBER DETAILS LOADING - FIXED
        ============================ */
        function loadMemberDetails(memberId) {
            if (!memberId) {
                appalert('Please enter a member reference', 3, 1);
                return;
            }

            $('#memberDetails')
                .removeClass('d-none alert-success alert-warning alert-danger')
                .addClass('alert alert-info')
                .html('<i class="mdi mdi-loading mdi-spin me-2"></i> Loading member details...');

            $.get('@Url.Action("GetMemberDetails", "IPSClaim")', { memberId })
                .done(res => {
                    console.log('API Response:', res);

                    // 🔴 BACKEND RETURNED ERROR
                    if (!res.success) {
                        $('#memberDetails')
                            .removeClass('alert-info')
                            .addClass('alert-warning')
                            .html(`<i class="mdi mdi-alert-circle me-2"></i> ${res.message || 'Operation failed'}`);

                        $('#memberSections').slideUp();
                        memberData = null;
                        return;
                    }

                    // 🟢 SUCCESS
                    if (res.data?.customer) {
                        memberData = res.data;

                        displayMemberDetails(res.data);
                        populateFormFields(res.data);
                        displayBalances(res.data);

                        $('#memberDetails')
                            .removeClass('alert-info')
                            .addClass('alert-success')
                            .html(`
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">
                                            <i class="mdi mdi-account-check text-success me-2"></i>
                                            ${res.message || 'Member Found'}
                                        </h6>
                                        <p class="mb-0">
                                            ${res.data.customer.firstName}
                                            ${res.data.customer.lastName || ''}
                                            (${res.data.customer.customerId})
                                        </p>
                                        <small class="text-muted">
                                            ${res.data.summary?.AccountCount || 0} accounts,
                                            ${res.data.summary?.LoanCount || 0} loans
                                        </small>
                                    </div>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success"
                                            onclick="loadMemberDetails('${memberId}')">
                                        <i class="mdi mdi-refresh me-1"></i> Refresh
                                    </button>
                                </div>
                            `);

                        $('#memberSections').slideDown();
                        $([document.documentElement, document.body]).animate({
                            scrollTop: $("#memberSections").offset().top - 50
                        }, 500);
                    }
                })
                .fail((xhr, status, error) => {
                    console.error('AJAX Error:', error, xhr.responseText);

                    const backendMessage =
                        xhr.responseJSON?.message ||
                        xhr.responseText ||
                        'Unexpected server error';

                    $('#memberDetails')
                        .removeClass('alert-info')
                        .addClass('alert-danger')
                        .html(`<i class="mdi mdi-alert-circle me-2"></i> ${backendMessage}`);

                    $('#memberSections').slideUp();
                    memberData = null;
                });
        }


        /* ============================
           DISPLAY MEMBER DETAILS IN TABLES - FIXED
        ============================ */
        function displayMemberDetails(data) {
            console.log('Displaying data:', data);

            // Display accounts in table
            if (data.accounts && data.accounts.length > 0) {
                let accountsHtml = `
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped">
                            <thead class="table-primary">
                                <tr>
                                    <th>Account Number</th>
                                    <th>Account Name</th>
                                    <th>Type</th>
                                    <th class="text-end">Balance (FCFA)</th>
                                    <th class="text-end">Available (FCFA)</th>
                                    <th class="text-end">Blocked (FCFA)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                data.accounts.forEach(account => {
                    accountsHtml += `
                        <tr>
                            <td><span class="badge bg-primary">${account.accountNumber || 'N/A'}</span></td>
                            <td>${account.accountName || 'N/A'}</td>
                            <td>${account.accountType || 'N/A'}</td>
                            <td class="text-end fw-bold">${formatCurrency(account.balance)}</td>
                            <td class="text-end text-success">${formatCurrency(account.availableBalance)}</td>
                            <td class="text-end text-warning">${formatCurrency(account.blockedAmount)}</td>
                            <td>
                                ${(() => {
                                                        let badgeClass = 'bg-warning';

                                                        if (account.status === 'Active' || account.status === 'Open') {
                                                            badgeClass = 'bg-success';
                                                        } else if (account.status === 'Blocked') {
                                                            badgeClass = 'bg-danger';
                                                        }

                                                        return `
                                        <span class="badge ${badgeClass}">
                                            ${account.status || 'N/A'}
                                        </span>
                                    `;
                                                    })()}
                            </td>

                        </tr>
                    `;
                });

                accountsHtml += `
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold">${formatCurrency(data.totalAccountBalance)}</td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                `;
                $('#accountInfoContent').html(accountsHtml);
            } else {
                $('#accountInfoContent').html(`
                    <div class="alert alert-warning">
                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                        No accounts found for this member
                    </div>
                `);
            }

            // Display loans in table
            if (data.loans && data.loans.length > 0) {
                let loansHtml = `
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped">
                            <thead class="table-warning">
                                <tr>
                                    <th>Loan ID</th>
                                    <th>Application ID</th>
                                    <th class="text-end">Principal (FCFA)</th>
                                    <th class="text-end">Balance (FCFA)</th>
                                    <th class="text-end">Interest Rate</th>
                                    <th>Status</th>
                                    <th>Disbursement Date</th>
                                    <th>Maturity Date</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                data.loans.forEach(loan => {
                    loansHtml += `
                        <tr>
                            <td><span class="badge bg-info">${loan.id || 'N/A'}</span></td>
                            <td>${loan.loanApplicationId || 'N/A'}</td>
                            <td class="text-end fw-bold">${formatCurrency(loan.principal)}</td>
                            <td class="text-end text-warning fw-bold">${formatCurrency(loan.balance)}</td>
                            <td class="text-end">${loan.interestRate || '0.00'}%</td>
                            <td>
                                <span class="badge ${loan.loanStatus === 'Open' ? 'bg-success' : 'bg-danger'}">
                                    ${loan.loanStatus || 'N/A'}
                                </span>
                            </td>
                            <td>${formatDateTime(loan.disbursementDate)}</td>
                            <td>${formatDateTime(loan.maturityDate)}</td>
                        </tr>
                    `;
                });

                loansHtml += `
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold text-warning">${formatCurrency(data.totalLoanBalance)}</td>
                                    <td colspan="4"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                `;
                $('#loanInfoContent').html(loansHtml);
            } else {
                $('#loanInfoContent').html(`
                    <div class="alert alert-info">
                        <i class="mdi mdi-information-outline me-2"></i>
                        No active loans found for this member
                    </div>
                `);
            }
        }

        /* ============================
           DISPLAY BALANCES (USING BACKEND VALUES) - FIXED
        ============================ */
        function displayBalances(data) {
            try {
                console.log('Displaying balances from data:', data);

                // Store balances from backend directly (no calculations)
                memberBalances = {
                    totalAccountBalance: safeParseFloat(data.totalAccountBalance),
                    totalLoanBalance: safeParseFloat(data.totalLoanBalance),
                    netClaimableAmount: safeParseFloat(data.netClaimableAmount)
                };

                console.log('Parsed balances:', memberBalances);

                // Update top summary cards
                $('#totalAccountBalance').text(formatCurrency(memberBalances.totalAccountBalance));
                $('#totalLoanBalance').text(formatCurrency(memberBalances.totalLoanBalance));
                $('#netClaimableAmount').text(formatCurrency(memberBalances.netClaimableAmount));

                // Update form display
                $('#displayTotalBalance').text(formatCurrency(memberBalances.totalAccountBalance));
                $('#displayLoanBalance').text(formatCurrency(memberBalances.totalLoanBalance));
                $('#displayNetAvailable').text(formatCurrency(memberBalances.netClaimableAmount));

                // Set suggested amount
                $('#suggestedAmount').text(formatCurrency(memberBalances.netClaimableAmount));
                $('#suggestedAmountInfo').show();
            } catch (error) {
                console.error('Error displaying balances:', error);
                // Set defaults on error
                memberBalances = {
                    totalAccountBalance: 0,
                    totalLoanBalance: 0,
                    netClaimableAmount: 0
                };

                $('#totalAccountBalance').text('0.00 FCFA');
                $('#totalLoanBalance').text('0.00 FCFA');
                $('#netClaimableAmount').text('0.00 FCFA');
                $('#suggestedAmount').text('0.00 FCFA');
            }
        }

        /* ============================
           POPULATE EDITABLE FORM FIELDS - FIXED
        ============================ */
        function populateFormFields(data) {
            const customer = data.customer;
            console.log('Populating form with customer:', customer);

            // Populate ALL form fields
            $('#MemberId').val(customer.customerId);
            $('#FirstName').val(customer.firstName || '').prop('readonly', true).addClass('bg-light');
            $('#LastName').val(customer.lastName || '').prop('readonly', true).addClass('bg-light');

            // Handle date conversion safely
            if (customer.dateOfBirth) {
                if (typeof customer.dateOfBirth === 'string' && customer.dateOfBirth.startsWith('/Date(')) {
                    const timestamp = parseInt(customer.dateOfBirth.match(/\d+/)[0]);
                    $('#DateOfBirth').val(moment(timestamp).format('YYYY-MM-DD'));
                } else {
                    $('#DateOfBirth').val(customer.dateOfBirth.split('T')[0]);
                }
            }

            $('#PlaceOfBirth').val(customer.placeOfBirth || '');
            $('#LegalForm').val(customer.legalForm || '');
            $('#CustomerType').val(customer.customerType || '');
            $('#Gender').val(customer.gender || '');
            $('#Phone').val(customer.phone || '');
            $('#Address').val(customer.address || '');
            $('#EmployerName').val(customer.employerName || '');
            $('#EmployerTelephone').val(customer.employerTelephone || '');
            $('#EmployerAddress').val(customer.employerAddress || '');
            $('#Occupation').val(customer.occupation || '');
            $('#IdNumber').val(customer.idNumber || '');
            $('#Email').val(customer.email || '');

            // Auto-fill claim form fields
            $('#UsualDutiesOfLivelihood').val(customer.occupation || '');
            $('#BeneficiaryName').val(`${customer.firstName || ''} ${customer.lastName || ''}`.trim());
            $('#BeneficiaryContact').val(customer.phone || '');
            $('#BeneficiaryAddress').val(customer.address || '');

            // Set default branch if available
            if (customer.branchId) {
                $('#BranchId').val(customer.branchId).trigger('change');
            }
        }

        /* ============================
           SEARCH BY REFERENCE
        ============================ */
        function searchMemberByReference() {
            const ref = $('#MemberReference').val()?.trim();
            if (!ref) {
                appalert('Please enter a member reference', 3, 1);
                return;
            }
            loadMemberDetails(ref);
        }

        /* ============================
           TOGGLE SECTIONS
        ============================ */
        function toggleSections() {
            $('.payroll-section').toggle($('#IsAccountSubjectToPayrollDeduction').is(':checked'));
            $('.accident-section').toggle($('#IsAccidentRelated').is(':checked'));
            $('.loan-section').toggle($('#ClaimType').val() === 'LoanProtection');
        }

        /* ============================
           FORM VALIDATION - UPDATED
        ============================ */
        function validateForm(form) {
            if (!memberData) {
                appalert('Please search and load a member first', 3, 1);
                return false;
            }

            const ClaimedAmount = parseFloat($('#ClaimedAmount').val()) || 0;
            if (ClaimedAmount <= 0) {
                appalert('Claimed amount must be greater than 0', 3, 1);
                return false;
            }

            const claimData = {
                MemberName: $('#FirstName').val() + ' ' + $('#LastName').val(),
                MemberId: $('#MemberId').val(),
                Phone: $('#Phone').val(),
                ClaimType: $('#ClaimType option:selected').text(),
                ClaimAmount: ClaimedAmount,
                EventDate: $('#DateOfEvent').val(),
                TotalAccountBalance: memberBalances.totalAccountBalance,
                TotalLoanBalance: memberBalances.totalLoanBalance,
                NetClaimableAmount: memberBalances.netClaimableAmount,
                BeneficiaryName: $('#BeneficiaryName').val(),
                BeneficiaryContact: $('#BeneficiaryContact').val(),
                Cause: $('#Cause option:selected').text()
            };

            // ❗ NO BALANCE BLOCKING ❗
            showClaimVerificationAlert(claimData);
            return false;
        }


        /* ============================
           CUSTOM ALERT FOR CLAIM VERIFICATION - FIXED
        ============================ */
        function showClaimVerificationAlert(claimData) {
            const alertHtml = `
        <div class="claim-verification-alert p-3">
            <h5 class="alert-heading mb-3 text-primary">
                <i class="mdi mdi-shield-check me-2"></i>
                Claim Verification Summary
            </h5>

            <div class="row mb-3 g-3">
                <div class="col-md-6">
                    <div class="card border-primary h-100">
                        <div class="card-header bg-primary text-white py-2">
                            <i class="mdi mdi-account-outline me-2"></i> Member Information
                        </div>
                        <div class="card-body p-3">
                            <p class="mb-2"><strong>Name:</strong> ${claimData.MemberName}</p>
                            <p class="mb-2"><strong>ID:</strong> ${claimData.MemberId}</p>
                            <p class="mb-0"><strong>Phone:</strong> ${claimData.Phone}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-success h-100">
                        <div class="card-header bg-success text-white py-2">
                            <i class="mdi mdi-file-document-outline me-2"></i> Claim Details
                        </div>
                        <div class="card-body p-3">
                            <p class="mb-2"><strong>Type:</strong> ${claimData.ClaimType}</p>
                            <p class="mb-2"><strong>Cause:</strong> ${claimData.Cause}</p>
                            <p class="mb-2"><strong>Amount:</strong> ${formatCurrency(claimData.ClaimAmount)}</p>
                            <p class="mb-0"><strong>Event Date:</strong> ${claimData.EventDate}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FINANCIAL SUMMARY - FIXED -->
            <div class="card border-info mb-3 shadow-sm">
                <div class="card-header bg-light text-primary py-2">
                    <i class="mdi mdi-calculator-variant me-2"></i> Financial Summary
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- TOTAL ACCOUNT BALANCE -->
                        <div class="col-lg-4 col-md-4 col-sm-12">
                            <div class="border border-success rounded p-3 text-center h-100 bg-light">
                                <p class="mb-2 text-black small">
                                    <i class="mdi mdi-bank me-1 text-success"></i>
                                    Total Account Balance
                                </p>
                                <h5 class="fw-bold text-success mb-2">
                                    ${formatCurrency(claimData.TotalAccountBalance)}
                                </h5>
                                <small class="text-black">All active accounts</small>
                            </div>
                        </div>

                        <!-- TOTAL LOAN BALANCE -->
                        <div class="col-md-4">
                            <div class="border border-warning rounded p-3 text-center h-100 bg-light">
                                <p class="mb-2 text-black small">
                                    <i class="mdi mdi-cash me-1 text-warning"></i>
                                    Total Loan Balance
                                </p>
                                <h5 class="fw-bold text-warning mb-2">
                                    ${formatCurrency(claimData.TotalLoanBalance)}
                                </h5>
                                <small class="text-black">All outstanding loans</small>
                            </div>
                        </div>

                        <!-- NET CLAIMABLE -->
                        <div class="col-md-4">
                            <div class="border border-primary rounded p-3 text-center h-100 bg-light">
                                <p class="mb-2 text-black small">
                                    <i class="mdi mdi-currency-usd me-1 text-primary"></i>
                                    Net Claimable Amount
                                </p>
                                <h5 class="fw-bold text-primary mb-2">
                                    ${formatCurrency(claimData.NetClaimableAmount)}
                                </h5>
                                <small class="text-black">Available for claim</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-info mb-3">
                <div class="card-header bg-light text-primary py-2">
                    <i class="mdi mdi-account-heart-outline me-2"></i> Beneficiary Information
                </div>
                <div class="card-body p-3">
                    <p class="mb-2"><strong>Name:</strong> ${claimData.BeneficiaryName}</p>
                    <p class="mb-0"><strong>Contact:</strong> ${claimData.BeneficiaryContact}</p>
                </div>
            </div>

            <div class="alert alert-danger mt-4 mb-2 p-3">
                <i class="mdi mdi-alert-circle-outline me-2"></i>
                <strong>Important:</strong> Once submitted, this claim cannot be modified. Please verify all information before proceeding.
            </div>
        </div>
    `;

            alertify.confirm(
                'Confirm Claim Submission',
                alertHtml,
                function () {
                    submitFormWithConfirmation();
                },
                function () {
                    appalert('Claim submission cancelled. You can modify the details.', 2, 1);
                }
            ).set({
                labels: { ok: 'Confirm & Submit', cancel: 'Cancel' },
                padding: false,
                closable: false,
                transition: 'zoom',
                maximizable: true
            });

        }

        /* ============================
           FINAL FORM SUBMISSION - FIXED
        ============================ */
        function submitFormWithConfirmation() {
            const form = $('#claimForm')[0];
            const $btn = $('button[type="submit"]');
            const originalHtml = $btn.html();

            // Show loading state
            $btn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2"></span>Submitting...');

            // Submit form via AJAX
            $.ajax({
                url: $(form).attr('action'),
                type: 'POST',
                data: $(form).serialize(),
                success: function(res) {
                    if (res.success) {
                        // Show success alert with options
                        const successHtml = `
                            <div class="text-center">
                                <div class="mb-3">
                                    <i class="mdi mdi-check-circle-outline text-success" style="font-size: 4rem;"></i>
                                </div>
                                <h4 class="text-success mb-3">Claim Created Successfully!</h4>
                                <p class="mb-2">Claim ID: <strong>${res.claimId || 'N/A'}</strong></p>
                                <p class="text-muted">What would you like to do next?</p>
                            </div>
                        `;

                        alertify.confirm(
                            'Success',
                            successHtml,
                            function() {
                                // Option 1: Upload documents
                                if (res.redirectUrl) {
                                    window.location.href = res.redirectUrl;
                                } else {
                                    window.location.href = '@Url.Action("Create", "IPSClaim")';
                                }
                            },
                            function() {
                                // Option 2: View claims list
                                window.location.href = '@Url.Action("List", "IPSClaim")';
                            }
                        ).set({
                            'labels': {ok: 'Upload Documents', cancel: 'View Claims List'},
                            'defaultFocus': 'none'
                        });

                    } else {
                        appalert(res.message || 'Submission failed', 4, 1);
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Submission error:', error, xhr.responseText);
                    let errorMessage = 'An error occurred during submission. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    appalert(errorMessage, 4, 1);
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        }

        /* ============================
           HELPER FUNCTIONS
        ============================ */
        function formatCurrency(amount) {
            // Parse the amount safely
            const parsedAmount = safeParseFloat(amount);

            return new Intl.NumberFormat('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(parsedAmount) + ' FCFA';
        }

        function safeParseFloat(value) {
            if (value === null || value === undefined || value === '') {
                return 0;
            }

            // If it's already a number, return it
            if (typeof value === 'number') {
                return value;
            }

            // If it's a string, clean and parse it
            if (typeof value === 'string') {
                try {
                    // Remove any non-numeric characters except decimal point and minus sign
                    const cleaned = value.replace(/[^0-9.-]/g, '');
                    const parsed = parseFloat(cleaned);
                    return isNaN(parsed) ? 0 : parsed;
                } catch (e) {
                    return 0;
                }
            }

            return 0;
        }

        /* ============================
           DOCUMENT READY
        ============================ */
        $(document).ready(function () {
            // Initialize select2
            $('.select2').select2({ width: '100%' });

            // Setup event handlers
            $('#IsAccountSubjectToPayrollDeduction, #IsAccidentRelated, #ClaimType')
                .on('change', toggleSections);

            // Set max date for date fields
            const today = new Date().toISOString().split('T')[0];
            $('#DateOfEvent').attr('max', today);
            $('#DateLastFullyPerformedSuchDuties').attr('max', today);
            $('#PayrollLastPostingDate').attr('max', today);
            $('#AccidentDate').attr('max', today);
            $('#LoanGrantedDate').attr('max', today);
            $('#DateOfLastPrincipalOrInterestPayment').attr('max', today);

            // Auto-focus member reference field
            $('#MemberReference').focus();

            // Toggle sections initially
            toggleSections();

            // Enter key support for member reference
            $('#MemberReference').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    searchMemberByReference();
                }
            });
        });
    </script>

