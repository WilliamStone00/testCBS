@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSClaim
@using System.Linq
@using System.Text.RegularExpressions

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary mb-1">
                        <i class="mdi mdi-file-document-outline me-2"></i>
                        Claim Details
                    </h1>
                    <p class="card-text">
                        Below we have details of an insurance claim request
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        Claim ID: <strong>@Model.Id</strong> |
                        Status: <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("Index", "IPSClaim")" class="btn btn-outline-secondary">
                <i class="mdi mdi-arrow-left me-1"></i> Back to List
            </a>
            <button type="button" class="btn btn-outline-info" onclick="showPrintModal()">
                <i class="mdi mdi-printer-outline me-1"></i> Print Details
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-primary"><i class="mdi mdi-timeline-outline me-2"></i>Claim Status Timeline</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item @(Model.Status == "Registered" ? "active" : "completed")">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <h6>Registered</h6>
                                <small>@Model.CreatedDate.ToString()</small>
                                <p>Claim was registered by @Model.CreatedBy</p>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Status == "Pending" ? "active" : Model.Status == "Registered" ? "" : "completed")">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <h6>Pending Review</h6>
                                <small>@(Model.ModifiedDate > Model.CreatedDate ? Model.ModifiedDate.ToString() : "Pending")</small>
                                @if (Model.Status == "Approved" || Model.Status == "Posted")
                                {<p>Claim was Approved By @Model.CreatedBy</p> }
                            else
                            {
                                <p>Awaiting review and approval</p>}
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Status == "Approved" ? "active" : Model.Status == "Posted" ? "completed" : "")">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <h6>Approved</h6>
                                <small>@(Model.Status == "Approved" || Model.Status == "Posted" ? Model.ModifiedDate.ToString() : "Pending")</small>
                                @if (Model.Status == "Approved" || Model.Status == "Posted")
                                {<p>Claim Approved By @Model.CreatedBy awaiting payment</p> }
                            else
                            {
                                <p>Awaiting review and approval</p>}
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Status == "Posted" ? "active" : "")">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <h6>Posted to Accounting</h6>
                                <small>@(Model.Status == "Posted" ? Model.ModifiedDate.ToString() : "Pending")</small>
                                @if (Model.Status == "Posted")
                                {<p>Claim was posted and Processed for settlement By @Model.CreatedBy</p> }
                            else
                            {
                                <p>Awaiting posting and Processing for settlement</p>}

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light text-primary">
                    <h5 class="mb-0"><i class="mdi mdi-account-details me-2 text-primary"></i>Member & Claim Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <th width="40%">Member ID:</th>
                            <td>@Model.MemberId</td>
                        </tr>
                        <tr>
                            <th>Full Name:</th>
                            <td>@Model.MemberLastName @Model.MemberFirstName @Model.MemberMiddleName</td>
                        </tr>
                        <tr>
                            <th>Sex:</th>
                            <td>@Model.Sex</td>
                        </tr>
                        <tr>
                            <th>Date of Birth:</th>
                            <td>@Model.DateOfBirth.ToString()</td>
                        </tr>
                        <tr>
                            <th>Claim Type:</th>
                            <td>
                                <span class="badge bg-info">
                                    @(Model.ClaimType == "LoanProtection" ? "Loan Protection" : "Life Savings")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>Event Category:</th>
                            <td>@Model.EventCategory</td>
                        </tr>
                        <tr>
                            <th>Date of Event:</th>
                            <td>@Model.DateOfDeathOrDisability.ToString()</td>
                        </tr>
                        <tr>
                            <th>Cause:</th>
                            <td>@Model.Cause</td>
                        </tr>
                        <tr>
                            <th>Branch:</th>
                            <td>@Model.BranchName</td>
                        </tr>
                        <tr>
                            <th>Created Date:</th>
                            <td>@Model.CreatedDate.ToString()</td>
                        </tr>
                        <tr>
                            <th>Created By:</th>
                            <td>@Model.CreatedBy</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-primary"><i class="mdi mdi-cash-multiple me-2 text-primary"></i>Financial Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <th width="40%">Claimed Amount:</th>
                            <td class="fw-bold text-primary">
                                @Model.ClaimedAmount.ToString() XAF
                            </td>
                        </tr>

                        <tr>
                            <th>Approved Amount:</th>
                            <td class="fw-bold @(Model.ApprovedAmount.HasValue ? "text-success" : "text-muted")">
                                @(Model.ApprovedAmount.HasValue
                                ? Model.ApprovedAmount.Value.ToString("N0") + " XAF"
                                : "Not Approved")
                            </td>
                        </tr>

                        <tr>
                            <th>Savings Balance:</th>
                            <td>
                                @(Model.SavingsBalanceAtEvent.HasValue
                                ? Model.SavingsBalanceAtEvent.Value.ToString("N0") + " XAF"
                                : "N/A")
                            </td>
                        </tr>

                        <tr>
                            <th>Loan Balance:</th>
                            <td>
                                @(Model.LoanBalanceAtEvent.HasValue
                                ? Model.LoanBalanceAtEvent.Value.ToString("N0") + " XAF"
                                : "N/A")
                            </td>
                        </tr>

                        <tr>
                            <th>Beneficiary:</th>
                            <td>@Model.BeneficiaryName</td>
                        </tr>
                        <tr>
                            <th>Address:</th>
                            <td>@Model.BeneficiaryAddress</td>
                        </tr>
                        <tr>
                            <th>Contact:</th>
                            <td>@Model.BeneficiaryContact</td>
                        </tr>
                        <tr>
                            <th>Idempotency Key:</th>
                            <td><small>@Model.IdempotencyKey</small></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic Documents Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary">
                        <i class="mdi mdi-file-upload me-2 text-primary"></i>Uploaded Documents
                        <span class="badge bg-secondary ms-2">@(Model.Documents?.Count ?? 0)</span>
                    </h5>

                    @if (Model.Status == "Registered" || Model.Status == "Pending")
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#uploadModal">
                            <i class="mdi mdi-upload me-1"></i> Upload Document
                        </button>
                    }
                </div>

                <div class="card-body">
                    @{
                        // Fix: Check for null
                        var docList = Model.Documents;
                        var documentGroups = docList.GroupBy(d => d.DocumentType).OrderBy(g => g.Key);
                    }

                    @if (!docList.Any())
                    {
                        <div class="text-center py-4">
                            <i class="mdi mdi-file-remove-outline display-4 text-muted"></i>
                            <p class="mt-2 text-muted">No documents uploaded yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var group in documentGroups)
                            {
                                var documents = group.ToList();
                                var firstDocument = documents.First();
                                var isRequired = IsRequiredDocument(group.Key);
                                // Fix: Create a safe ID for the carousel by removing non-alphanumeric characters
                                var safeId = Regex.Replace(group.Key, "[^a-zA-Z0-9]", "");

                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card document-card h-100 @(documents.Any() ? "border-success" : isRequired ? "border-danger" : "border-warning")">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0 d-flex justify-content-between align-items-center">
                                                <span>@GetDocumentTypeDisplayName(group.Key)</span>
                                                <span class="badge @(documents.Any() ? "bg-success" : isRequired ? "bg-danger" : "bg-warning")">
                                                    @documents.Count @(documents.Count == 1 ? "file" : "files")
                                                </span>
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- Document Carousel -->
                                            <div id="carousel-@safeId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                                                @if (documents.Count > 1)
                                                {
                                                    <div class="carousel-indicators">
                                                        @for (int i = 0; i < documents.Count; i++)
                                                        {
                                                            <button type="button"
                                                                    data-bs-target="#carousel-@safeId"
                                                                    data-bs-slide-to="@i"
                                                                    class="@(i == 0 ? "active" : "")"
                                                                    aria-label="Slide @(i+1)"></button>
                                                        }
                                                    </div>
                                                }

                                                <div class="carousel-inner">
                                                    @for (int i = 0; i < documents.Count; i++)
                                                    {
                                                        var document = documents[i];
                                                        // Fix: Escape strings for JS
                                                        var safeDocName = document.DocumentName.Replace("'", "\\'");
                                                        var safeDocType = document.DocumentType.Replace("'", "\\'");

                                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                                            <div class="document-preview mb-3" style="height: 200px; overflow: hidden; border-radius: 4px; cursor: pointer;"
                                                                 onclick="viewDocument('@GetDocumentTypeDisplayName(group.Key)', '@document.UrlPath', '@safeDocType', '@document.Id', '@safeDocName')">
                                                                @if (IsImageFile(document.UrlPath))
                                                                {
                                                                    <!-- Fix: Removed newline in onerror string -->
                                                                    <img src="@document.UrlPath"
                                                                         alt="@document.DocumentName"
                                                                         style="width: 100%; height: 100%; object-fit: cover;"
                                                                         onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'h-100 d-flex align-items-center justify-content-center\'><i class=\'mdi mdi-file-image-outline display-4 text-muted\'></i></div>';" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="h-100 d-flex flex-column align-items-center justify-content-center bg-light">
                                                                        <i class="mdi @GetFileIcon(document.UrlPath) display-4 text-muted mb-2"></i>
                                                                        <span class="small text-muted text-center px-2">@document.DocumentName@document.Extension</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="text-center">
                                                                <small class="text-muted">@document.DocumentName@document.Extension</small>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                @if (documents.Count > 1)
                                                {
                                                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@safeId" data-bs-slide="prev">
                                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                        <span class="visually-hidden">Previous</span>
                                                    </button>
                                                    <button class="carousel-control-next" type="button" data-bs-target="#carousel-@safeId" data-bs-slide="next">
                                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                        <span class="visually-hidden">Next</span>
                                                    </button>
                                                }
                                            </div>

                                            <!-- Document Actions -->
                                            <div class="mt-3 d-flex justify-content-between">
                                                @if (documents.Count > 0)
                                                {
                                                    // Fix: Escape strings
                                                    var firstSafeName = documents.First().DocumentName.Replace("'", "\\'");
                                                    var firstSafeType = group.Key.Replace("'", "\\'");

                                                    <button class="btn btn-sm btn-outline-primary"
                                                            onclick="viewDocument('@GetDocumentTypeDisplayName(group.Key)', '@documents.First().UrlPath', '@firstSafeType', '@documents.First().Id', '@firstSafeName')">
                                                        <i class="mdi mdi-eye me-1"></i> View
                                                    </button>

                                                    if (documents.Count > 1)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success"
                                                                onclick="downloadAllDocumentsByType('@firstSafeType', '@GetDocumentTypeDisplayName(group.Key)')">
                                                            <i class="mdi mdi-download me-1"></i> Download All
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-success"
                                                                onclick="downloadSingleDocument('@GetDocumentTypeDisplayName(group.Key)', '@documents.First().UrlPath', '@firstSafeName', '@documents.First().Extension')">
                                                            <i class="mdi mdi-download me-1"></i> Download
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No files uploaded</span>
                                                    <span class="badge @(isRequired ? "bg-danger" : "bg-warning")">
                                                        @(isRequired ? "Required" : "Optional")
                                                    </span>
                                                }
                                            </div>

                                            <!-- Thumbnails for multiple documents -->
                                            @if (documents.Count > 1)
                                            {
                                                <div class="mt-3">
                                                    <small class="d-block mb-1">All files:</small>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var doc in documents)
                                                        {
                                                            var docSafeName = doc.DocumentName.Replace("'", "\\'");
                                                            var groupSafeType = group.Key.Replace("'", "\\'");

                                                            <div class="position-relative" style="width: 50px; height: 50px;">
                                                                <img src="@doc.UrlPath"
                                                                     alt="@doc.DocumentName"
                                                                     class="img-thumbnail"
                                                                     style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;"
                                                                     onclick="viewDocument('@GetDocumentTypeDisplayName(group.Key)', '@doc.UrlPath', '@groupSafeType', '@doc.Id', '@docSafeName')"
                                                                     onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<div class=\'h-100 d-flex align-items-center justify-content-center bg-light border\'><i class=\'mdi mdi-file-outline\'></i></div>';" />
                                                                <div class="position-absolute top-0 end-0 bg-dark text-white rounded-circle"
                                                                     style="width: 16px; height: 16px; font-size: 10px; line-height: 16px; text-align: center;">
                                                                    @(documents.IndexOf(doc) + 1)
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div> <!-- Fix: This closes the row containing the documents -->
    <!-- Enhanced Document Preview Modal -->
    <div class="modal fade" id="documentPreviewModal" tabindex="-1" aria-labelledby="documentPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="documentPreviewModalLabel"></h5>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="downloadCurrentDocument()" id="downloadBtn">
                            <i class="mdi mdi-download me-1"></i> Download
                        </button>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body" id="documentPreviewContent">
                    <div class="text-center">
                        <img id="documentPreviewImage" src="" alt="Document Preview" class="img-fluid rounded" style="max-height: 70vh;">
                        <div id="documentFallback" class="d-none">
                            <i class="mdi mdi-file-outline display-1 text-muted"></i>
                            <p class="mt-2" id="documentFallbackText">This document cannot be previewed as an image.</p>
                            <p class="text-muted small" id="documentFileName"></p>
                            <div id="documentMetadata"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="me-auto">
                        <div id="documentNavigation" class="d-none">
                            <button class="btn btn-sm btn-outline-secondary" onclick="navigateDocument('prev')">
                                <i class="mdi mdi-chevron-left"></i> Previous
                            </button>
                            <span class="mx-2" id="documentCounter"></span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="navigateDocument('next')">
                                Next <i class="mdi mdi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    <a id="documentFullViewLink" href="#" target="_blank" class="btn btn-outline-primary">
                        <i class="mdi mdi-open-in-new me-1"></i> Open in New Tab
                    </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Print Configuration Modal -->
    <div class="modal fade" id="printModal" tabindex="-1" aria-labelledby="printModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="printModalLabel">Print Claim Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Content Selection</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="printMemberDetails" checked>
                                        <label class="form-check-label" for="printMemberDetails">
                                            Member & Claim Details
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="printFinancialDetails" checked>
                                        <label class="form-check-label" for="printFinancialDetails">
                                            Financial Details
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="printTimeline" checked>
                                        <label class="form-check-label" for="printTimeline">
                                            Status Timeline
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="printDocuments" checked>
                                        <label class="form-check-label" for="printDocuments">
                                            Document Summary
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="printDocumentImages">
                                        <label class="form-check-label" for="printDocumentImages">
                                            Include Document Images
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Print Options</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="printOrientation" class="form-label">Orientation</label>
                                        <select class="form-select" id="printOrientation">
                                            <option value="portrait">Portrait</option>
                                            <option value="landscape">Landscape</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="printHeader" class="form-label">Header Text</label>
                                        <input type="text" class="form-control" id="printHeader" value="Insurance Claim Details">
                                    </div>
                                    <div class="mb-3">
                                        <label for="printFooter" class="form-label">Footer Text</label>
                                        <input type="text" class="form-control" id="printFooter" value="Confidential - Internal Use Only">
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="printTimestamp" checked>
                                        <label class="form-check-label" for="printTimestamp">
                                            Include timestamp
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Preview</h6>
                                </div>
                                <div class="card-body">
                                    <div id="printPreview" class="border p-3" style="min-height: 300px; max-height: 500px; overflow-y: auto; background: white;">
                                        <div class="text-center text-muted">
                                            <i class="mdi mdi-printer-outline display-4 mb-3"></i>
                                            <p>Print preview will appear here...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" onclick="updatePrintPreview()">
                        <i class="mdi mdi-eye me-1"></i> Update Preview
                    </button>
                    <button type="button" class="btn btn-primary" onclick="generatePrint()">
                        <i class="mdi mdi-printer me-1"></i> Print Now
                    </button>
                </div>
            </div>
        </div>
    </div>
</div> <!-- Fix: Closing tag for container-fluid -->

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }

            .timeline-item:last-child {
                padding-bottom: 0;
            }

        .timeline-marker {
            position: absolute;
            left: -30px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #ddd;
            border: 3px solid #fff;
        }

        .timeline-item.completed .timeline-marker {
            background: #198754;
        }

        .timeline-item.active .timeline-marker {
            background: #0d6efd;
            animation: pulse 2s infinite;
        }

        .timeline-content {
            padding-left: 10px;
        }

        .document-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .document-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .document-preview {
            transition: opacity 0.2s;
        }

            .document-preview:hover {
                opacity: 0.9;
            }

            .document-preview img {
                transition: transform 0.3s;
            }

        .document-card:hover .document-preview img {
            transform: scale(1.05);
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 5%;
        }

        .carousel-indicators {
