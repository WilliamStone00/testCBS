// View document with navigation support
function viewDocument(title, url, type, id, fileName) {
    if (!url || url.trim() === '') {
        appalert('No document available', 3, 1);
        return;
    }

    // Get all documents of this type for navigation
    currentDocumentSet = [];
    currentDocumentType = type;
    currentDocumentTitle = title;

    // Collect all documents of this type
    @if(Model.Documents != null)
    {
        foreach (var doc in Model.Documents)
        {
            <text>
            if ('@doc.DocumentType.Replace("'", "\\'")' === type) {
                currentDocumentSet.push({
                    id: '@doc.Id',
                    url: '@doc.UrlPath',
                    name: '@doc.DocumentName.Replace("'", "\\'")',
                    extension: '@doc.Extension',
                    type: '@doc.DocumentType.Replace("'", "\\'")'
                });
                if ('@doc.Id' === id) {
                    currentDocumentIndex = currentDocumentSet.length - 1;
                }
            }
            </text>
        }
    }

    if (currentDocumentSet.length === 0) {
        appalert('Document not found', 3, 1);
        return;
    }

    // Load the selected document
    loadDocument(currentDocumentIndex);

    // Show/hide navigation buttons
    const navDiv = document.getElementById('documentNavigation');
    if (currentDocumentSet.length > 1) {
        navDiv.classList.remove('d-none');
        updateDocumentCounter();
    } else {
        navDiv.classList.add('d-none');
    }

    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('documentPreviewModal'));
    modal.show();
}

// Load document into preview modal
function loadDocument(index) {
    if (index < 0 || index >= currentDocumentSet.length) return;

    const doc = currentDocumentSet[index];
    currentDocumentIndex = index;
    currentDocumentId = doc.id;

    // Update modal title
    document.getElementById('documentPreviewModalLabel').textContent =
        `${currentDocumentTitle} (${index + 1} of ${currentDocumentSet.length})`;

    // Update file info
    document.getElementById('documentFileName').textContent = `File: ${doc.name}${doc.extension}`;

    // Update full view link
    const fullViewLink = document.getElementById('documentFullViewLink');
    fullViewLink.href = doc.url;

    // Update metadata
    const metadataDiv = document.getElementById('documentMetadata');
    metadataDiv.innerHTML = `
        <small class="d-block">Type: ${doc.type}</small>
    `;

    // Update counter
    updateDocumentCounter();

    // Check file type
    const previewImage = document.getElementById('documentPreviewImage');
    const fallbackDiv = document.getElementById('documentFallback');
    const fallbackText = document.getElementById('documentFallbackText');

    const isImage = isImageFile(doc.url);
    const isPDF = doc.url.toLowerCase().endsWith('.pdf');

    if (isImage) {
        // Show image preview
        previewImage.src = doc.url;
        previewImage.classList.remove('d-none');
        fallbackDiv.classList.add('d-none');

        // Handle image load error
        previewImage.onerror = function() {
            previewImage.classList.add('d-none');
            fallbackDiv.classList.remove('d-none');
            fallbackText.textContent = 'Unable to load image preview';
        };
    } else if (isPDF) {
        // For PDFs, show fallback with PDF icon
        previewImage.classList.add('d-none');
        fallbackDiv.classList.remove('d-none');
        fallbackText.innerHTML = `
            <i class="mdi mdi-file-pdf-outline display-1 text-danger"></i>
            <p class="mt-2">PDF Document - ${doc.name}${doc.extension}</p>
            <p class="small text-muted">Click "Open in New Tab" to view</p>
        `;
    } else {
        // For other file types
        previewImage.classList.add('d-none');
        fallbackDiv.classList.remove('d-none');
        fallbackText.innerHTML = `
            <i class="mdi mdi-file-outline display-1 text-muted"></i>
            <p class="mt-2">${doc.name}${doc.extension}</p>
            <p class="small text-muted">Click "Open in New Tab" or "Download" to access this file</p>
        `;
    }
}

// Navigate between documents
function navigateDocument(direction) {
    if (direction === 'prev' && currentDocumentIndex > 0) {
        loadDocument(currentDocumentIndex - 1);
    } else if (direction === 'next' && currentDocumentIndex < currentDocumentSet.length - 1) {
        loadDocument(currentDocumentIndex + 1);
    }
}

// Update document counter
function updateDocumentCounter() {
    const counter = document.getElementById('documentCounter');
    counter.textContent = `${currentDocumentIndex + 1} of ${currentDocumentSet.length}`;
}

// Download current document
function downloadCurrentDocument() {
    if (currentDocumentIndex < 0 || currentDocumentIndex >= currentDocumentSet.length) return;

    const doc = currentDocumentSet[currentDocumentIndex];
    const fileName = `${currentDocumentTitle.replace(/[^a-z0-9]/gi, '_')}_${doc.name}_@Model.Id${doc.extension}`;

    downloadFile(doc.url, fileName);
}

// Download single document
function downloadSingleDocument(title, url, fileName, extension) {
    if (!url || url.trim() === '') {
        appalert('No document available for download', 3, 1);
        return;
    }

    const safeTitle = title.replace(/[^a-z0-9]/gi, '_');
    const safeFileName = fileName.replace(/[^a-z0-9.]/gi, '_');
    const downloadName = `${safeTitle}_${safeFileName}_@Model.Id${extension || ''}`;

    downloadFile(url, downloadName);
}

// Download all documents by type
function downloadAllDocumentsByType(type, title) {
    const documents = [];

    // Collect all documents of this type
    @if(Model.Documents != null)
    {
        foreach (var doc in Model.Documents)
        {
            <text>
            if ('@doc.DocumentType.Replace("'", "\\'")' === type) {
                documents.push({
                    url: '@doc.UrlPath',
                    name: '@doc.DocumentName.Replace("'", "\\'")',
                    extension: '@doc.Extension'
                });
            }
            </text>
        }
    }

    if (documents.length === 0) {
        appalert('No documents available for download', 3, 1);
        return;
    }

    appalert(`Starting download of ${documents.length} document(s)...`, 2, 1);

    // Download each document with a delay to avoid browser blocking
    documents.forEach((doc, index) => {
        setTimeout(() => {
            const fileName = `${title.replace(/[^a-z0-9]/gi, '_')}_${doc.name}_${index + 1}_@Model.Id${doc.extension}`;
            downloadFile(doc.url, fileName);

            if (index === documents.length - 1) {
                setTimeout(() => {
                    appalert(`Downloaded ${documents.length} document(s) successfully`, 1, 1);
                }, 1000);
            }
        }, index * 1000);
    });
}

// Helper function to download a file
function downloadFile(url, fileName) {
    const downloadLink = document.createElement('a');
    downloadLink.href = url;
    downloadLink.download = fileName;
    downloadLink.style.display = 'none';
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
}

// Check if file is an image
function isImageFile(url) {
    if (!url) return false;
    const imageExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg'];
    const lowerUrl = url.toLowerCase();
    return imageExtensions.some(ext => lowerUrl.endsWith(ext));
}

// Keep existing functions...
function showApproveModal(claimId) {
    $('#approveClaimId').val(claimId);
    $('#approveModal').modal('show');
}

// Event listeners for print options
document.addEventListener('DOMContentLoaded', function() {
    // Add event listeners to print options
    const printOptions = [
        'printMemberDetails',
        'printFinancialDetails',
        'printTimeline',
        'printDocuments',
        'printDocumentImages',
        'printHeader',
        'printFooter',
        'printTimestamp',
        'printOrientation'
    ];

    printOptions.forEach(function(optionId) {
        const element = document.getElementById(optionId);
        if (element) {
            if (element.type === 'checkbox' || element.type === 'text') {
                element.addEventListener('change', updatePrintPreview);
            }
        }
    });

    // Initialize print preview if modal is open
    if (document.getElementById('printModal').classList.contains('show')) {
        updatePrintPreview();
    }
});
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        switch (status?.ToLower())
        {
            case "registered":
                return "bg-info";
            case "pending":
                return "bg-warning";
            case "approved":
                return "bg-success";
            case "rejected":
                return "bg-danger";
            case "posted":
                return "bg-primary";
            default:
                return "bg-secondary";
        }
    }

    public bool IsRequiredDocument(string documentType)
    {
        // Define which document types are required
        var requiredTypes = new[] { "DeathCertificate", "Passbook", "IDCard" };
        return requiredTypes.Any(rt => documentType.Contains(rt));
    }

    public string GetDocumentTypeDisplayName(string documentType)
    {
        // Convert camelCase or PascalCase to readable name
        if (string.IsNullOrEmpty(documentType)) return "Unknown Document";

        var result = System.Text.RegularExpressions.Regex.Replace(
            documentType,
            "([a-z])([A-Z])",
            "$1 $2"
        );

        return result.Replace("Certificate", " Certificate").Replace("Card", " Card");
    }

    public bool IsImageFile(string url)
    {
        if (string.IsNullOrEmpty(url)) return false;

        var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var extension = System.IO.Path.GetExtension(url).ToLowerInvariant();
        return imageExtensions.Contains(extension);
    }

    public string GetFileIcon(string url)
    {
        if (string.IsNullOrEmpty(url)) return "mdi mdi-file-outline";

        var extension = System.IO.Path.GetExtension(url).ToLowerInvariant();

        switch (extension)
        {
            case ".pdf": return "mdi mdi-file-pdf-outline";
            case ".doc":
            case ".docx": return "mdi mdi-file-word-outline";
            case ".xls":
            case ".xlsx": return "mdi mdi-file-excel-outline";
            case ".jpg":
            case ".jpeg":
            case ".png":
            case ".gif":
            case ".bmp":
            case ".webp": return "mdi mdi-file-image-outline";
            default: return "mdi mdi-file-outline";
        }
    }

}