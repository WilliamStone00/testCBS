    // ============================
    // FILTER FUNCTIONS
    // ============================
    function collectFilters() {
        const filters = {
            memberId: valOrNull('#filterMemberId'),
            branchId: valOrNull('#filterBranch'),
            status: $('#toggleStatus').is(':checked') ? valOrNull('#filterStatus') : null,
            claimType: $('#toggleClaimType').is(':checked') ? valOrNull('#filterClaimType') : null,
            isPosted: $('#toggleIsPosted').is(':checked') ? valOrNull('#filterIsPosted') : null,
            minApprovedAmount: $('#toggleAmount').is(':checked') ? parseFloat($('#MinApprovedAmount').val()) || null : null,
            maxApprovedAmount: $('#toggleAmount').is(':checked') ? parseFloat($('#MaxApprovedAmount').val()) || null : null,
            eventFrom: $('#toggleDateRange').is(':checked') ? $('#EventFrom').val() || null : null,
            eventTo: $('#toggleDateRange').is(':checked') ? $('#EventTo').val() || null : null,
            createdFromUtc: $('#toggleDateRange').is(':checked') ? $('#CreatedFromUtc').val() || null : null,
            createdToUtc: $('#toggleDateRange').is(':checked') ? $('#CreatedToUtc').val() || null : null,
            includeDeleted: $('#toggleDeleted').is(':checked') ? $('#IncludeDeleted').is(':checked') : true
        };

        return filters;
    }

    function bindFilterToggles() {
        $('#toggleClaimType').change(function () {
            $('#claimTypeSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterClaimType').val(null).trigger('change');
        });

        $('#toggleStatus').change(function () {
            $('#statusSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterStatus').val(null).trigger('change');
        });

        $('#toggleIsPosted').change(function () {
            $('#isPostedSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterIsPosted').val(null).trigger('change');
        });

        $('#toggleAmount').change(function () {
            $('#amountSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) {
                $('#MinApprovedAmount').val('');
                $('#MaxApprovedAmount').val('');
            }
        });

        $('#toggleDateRange').change(function () {
            $('#dateRangeSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) {
                $('#EventFrom').val('');
                $('#EventTo').val('');
                $('#CreatedFromUtc').val('');
                $('#CreatedToUtc').val('');
            }
        });

        $('#toggleDeleted').change(function () {
            $('#deletedSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#IncludeDeleted').prop('checked', true);
        });
    }

    function resetFilters() {
        $('#claimFilterForm')[0].reset();
        $('.collapse').collapse('hide');
        $('input[type=checkbox]').prop('checked', false);

        if ($.fn.select2) {
            $('.select2').val(null).trigger('change');
        }

        // Don't auto-load after reset - just clear the table
        if (ClaimsTable) {
            ClaimsTable.destroy();
            $('#myDataTable tbody').empty();
        }
    }

    // ============================
    // ACTION MODAL FUNCTIONS
    // ============================
    function showActionModal(actionType, claimId, memberId, branchId, claimData) {
        resetActionForm();

        // Set hidden fields
        $('#actionType').val(actionType);
        $('#hiddenClaimId').val(claimId);
        $('#hiddenMemberId').val(memberId);
        $('#hiddenBranchId').val(branchId);

        // Update modal UI
        updateModalUI(actionType, claimData);

        // Load data for posting
        if (actionType === 'post') {
            loadPostingData(claimId, memberId, branchId);
        }

        $('#actionModal').modal('show');
    }

    function updateModalUI(actionType, claimData) {
        var title = '';
        var description = '';
        var noteLabel = '';
        var submitText = '';

        switch (actionType) {
            case 'approve':
                title = 'Approve Claim';
                description = 'Approve this insurance claim with the approved amount.';
                noteLabel = 'Approval Comments';
                submitText = 'Approve Claim';
                $('#approveAmountSection').show();
                $('#actionAmount').val(claimData?.claimedAmount || 0);
                $('#postDetailsSection').hide();
                break;

            case 'reject':
                title = 'Reject Claim';
                description = 'Reject this insurance claim with detailed reason.';
                noteLabel = 'Rejection Reason';
                submitText = 'Reject Claim';
                $('#approveAmountSection').hide();
                $('#postDetailsSection').hide();
                break;

            case 'post':
                title = 'Post to Accounting';
                description = 'Post this approved claim to the accounting system.';
                noteLabel = 'Posting Memo';
                submitText = 'Post to Accounting';
                $('#approveAmountSection').hide();
                $('#postDetailsSection').show();
                break;
        }

        // Update UI elements
        $('#actionModalTitle').text(title);
        $('#actionModalDescription').text(description);
        $('#actionNoteLabel').text(noteLabel);
        $('#submitButtonText').text(submitText);

        // Update claim information
        if (claimData) {
            $('#actionClaimId').text(claimData.claimId || '-');
            $('#actionMemberId').text(claimData.memberId || '-');
            $('#actionBranch').text(claimData.branchName || '-');
            $('#actionClaimType').text(claimData.claimType || '-');
            $('#actionApprovedAmount').text(formatCurrency(claimData.approvedAmount || claimData.claimedAmount || 0));

            var status = claimData.status || '-';
            $('#actionCurrentStatus').text(status)
                .removeClass()
                .addClass('badge ' + getStatusBadgeClass(status));
        }
    }

