    function loadPostingData(claimId, memberId, branchId) {
        $('#customerInfoSection').html(`
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Loading posting data...</p>
            </div>
        `);

        resetPostingTables();

        $.ajax({
            url: '@Url.Action("GetPostingData", "IPSClaim")',
            type: 'GET',
            data: { claimId: claimId, memberId: memberId, branchId: branchId },
            success: function (response) {
                if (!response.success) {
                    appalert(response.message, 3, 1);
                    return;
                }

                const data = response.data;

                // Update global variables with renamed property
                var rawSourceAffiliates = data.viewBagData.sourceBranchAffiliateAccounts || [];
                var rawBranches = data.viewBagData.branchAccounts || [];

                sourceBranchAffiliateAccounts = rawSourceAffiliates.map(x => ({
                    Value: x.Value || x.value,
                    Text: x.Text || x.text
                }));

                branchAccounts = rawBranches.map(x => ({
                    Value: x.Value || x.value,
                    Text: x.Text || x.text
                }));

                updatePostingUI(data);
                setupPostingTables(data);
                updateAllTotals();
            },
            error: function () {
                appalert('Error loading posting data', 4, 1);
            }
        });
    }

