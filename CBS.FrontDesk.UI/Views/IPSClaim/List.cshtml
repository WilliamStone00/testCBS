    // ============================
    // VALIDATION & TOTALS
    // ============================
    function updateAllTotals() {
        // Calculate source total
        var sourceTotal = 0;
        $('.source-amount').each(function() {
            var val = parseFloat($(this).val()) || 0;
            sourceTotal += val;
        });
        $('#sourceTotalAmount').text(formatCurrency(sourceTotal));
        $('#validationSourceTotal').text(formatCurrency(sourceTotal));

        // Calculate member total
        var memberTotal = 0;
        $('.member-amount').each(function() {
            var val = parseFloat($(this).val()) || 0;
            memberTotal += val;
        });
        $('#memberTotalAmount').text(formatCurrency(memberTotal));
        $('#validationMemberTotal').text(formatCurrency(memberTotal));

        // Calculate branch total
        var branchTotal = 0;
        $('.branch-amount').each(function() {
            var val = parseFloat($(this).val()) || 0;
            branchTotal += val;
        });
        $('#branchTotalAmount').text(formatCurrency(branchTotal));
        $('#validationBranchTotal').text(formatCurrency(branchTotal));

        // Calculate combined total
        var combinedTotal = sourceTotal + memberTotal + branchTotal;
        $('#validationCombinedTotal').text(formatCurrency(combinedTotal));
        $('#combinedTotalDisplay').text(formatCurrency(combinedTotal));

        // Update entered total
        var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
        $('#validationEnteredTotal').text(formatCurrency(enteredTotal));

        // Update validation status
        updateValidation();
    }

    function updateValidation() {
        var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
        var sourceTotal = parseFloat($('#validationSourceTotal').text().replace(/,/g, '')) || 0;
        var memberTotal = parseFloat($('#validationMemberTotal').text().replace(/,/g, '')) || 0;
        var branchTotal = parseFloat($('#validationBranchTotal').text().replace(/,/g, '')) || 0;
        var combinedTotal = sourceTotal + memberTotal + branchTotal;

        if (enteredTotal === 0) {
            $('#validationStatus').removeClass().addClass('badge bg-warning').text('Enter Amount');
            $('#validationMessage').text('Please enter total amount first');
            $('#amountValidation').removeClass().addClass('badge bg-warning').text('Enter Amount');
            return false;
        }

        if (combinedTotal > enteredTotal) {
            $('#validationStatus').removeClass().addClass('badge bg-danger').text('Exceeds Limit');
            $('#validationMessage').text(`Total entries (${formatCurrency(combinedTotal)}) exceeds entered amount`);
            $('#amountValidation').removeClass().addClass('badge bg-danger').text('Exceeds Limit');
            return false;
        }

        if (combinedTotal === enteredTotal) {
            $('#validationStatus').removeClass().addClass('badge bg-success').text('Valid');
            $('#validationMessage').text('All amounts match');
            $('#amountValidation').removeClass().addClass('badge bg-success').text('Valid');
            return true;
        }

        if (combinedTotal < enteredTotal) {
            $('#validationStatus').removeClass().addClass('badge bg-warning').text('Under Amount');
            $('#validationMessage').text(`Total entries (${formatCurrency(combinedTotal)}) is less than entered amount`);
            $('#amountValidation').removeClass().addClass('badge bg-warning').text('Under Amount');
            return true;
        }

        return false;
    }

    // ============================
    // DATA COLLECTION FOR POSTING
    // ============================
    function collectPostingData() {
        var data = {
            ClaimId: $('#hiddenClaimId').val(),
            CustomerId: $('#hiddenMemberId').val(),
            Note: $('#actionNote').val(),
            TotalAmount: parseFloat($('#totalAmount').val()) || 0,
            ExternalApplicationName: $('#externalApplicationName').val(),
            AccountingDate: $('#accountingDate').val(),
            ForceRepost: $('#forceRepost').is(':checked'),
            MemberBalanceDestinationEntries: [],
            SourceAccountEntryListing: [],
            DestinationBranchEntryListing: []
        };

        // Collect source account entries
        $('.source-account-row').each(function() {
            var $row = $(this);
            var entry = {
                SourceGLAccountId: $row.find('.source-gl-account').val(),
                Amount: parseFloat($row.find('.source-amount').val()) || 0,
                Description: $row.find('.source-description').val()
            };
            if (entry.SourceGLAccountId && entry.Amount > 0) {
                data.SourceAccountEntryListing.push(entry);
            }
        });

        // Collect member account entries
        $('.member-account-row').each(function() {
            var $row = $(this);
            var entry = {
                AccountId: $row.find('.account-id').val(),
                AccountType: $row.find('.account-type').val(),
                Amount: parseFloat($row.find('.member-amount').val()) || 0,
                Description: $row.find('.member-description').val()
            };
            if (entry.AccountId && entry.Amount > 0) {
                data.MemberBalanceDestinationEntries.push(entry);
            }
        });

        // Collect branch account entries
        $('.branch-account-row').each(function() {
            var $row = $(this);
            var entry = {
                DestinationBranchGLAccountId: $row.find('.branch-gl-account').val(),
                Amount: parseFloat($row.find('.branch-amount').val()) || 0,
                Description: $row.find('.branch-description').val()
            };
            if (entry.DestinationBranchGLAccountId && entry.Amount > 0) {
                data.DestinationBranchEntryListing.push(entry);
            }
        });

        return data;
    }

    function showConfirmationModal(postingData) {
        // Populate confirmation modal
        $('#confirmClaimId').text(postingData.ClaimId);
        $('#confirmMemberId').text(postingData.CustomerId);
        $('#confirmTotalAmount').text(formatCurrency(postingData.TotalAmount));
        $('#confirmAccountingDate').text(postingData.AccountingDate);
        $('#confirmExternalApp').text(postingData.ExternalApplicationName);
        $('#confirmForceRepost').text(postingData.ForceRepost ? 'Yes' : 'No');

        // Populate entries table
        var $tbody = $('#confirmSummaryTable tbody');
        $tbody.empty();

        var totalEntries = 0;

        // Add source entries
        postingData.SourceAccountEntryListing.forEach(function(entry, index) {
            var account = affiliateAccounts.find(a => a.Value === entry.SourceGLAccountId);
            $tbody.append(`
                <tr>
                    <td><span class="badge bg-info">Source</span></td>
                    <td>${account ? account.Text : entry.SourceGLAccountId}</td>
                    <td class="text-end">${formatCurrency(entry.Amount)}</td>
                    <td>${entry.Description}</td>
                </tr>
            `);
            totalEntries += entry.Amount;
        });

        // Add member entries
        postingData.MemberBalanceDestinationEntries.forEach(function(entry, index) {
            $tbody.append(`
                <tr>
                    <td><span class="badge bg-warning">Member</span></td>
                    <td>${entry.AccountType}</td>
                    <td class="text-end">${formatCurrency(entry.Amount)}</td>
                    <td>${entry.Description}</td>
                </tr>
            `);
            totalEntries += entry.Amount;
        });

        // Add branch entries
        postingData.DestinationBranchEntryListing.forEach(function(entry, index) {
            var account = branchAccounts.find(a => a.Value === entry.DestinationBranchGLAccountId);
            $tbody.append(`
                <tr>
                    <td><span class="badge bg-danger">Branch</span></td>
                    <td>${account ? account.Text : entry.DestinationBranchGLAccountId}</td>
                    <td class="text-end">${formatCurrency(entry.Amount)}</td>
                    <td>${entry.Description}</td>
                </tr>
            `);
            totalEntries += entry.Amount;
        });

        $('#confirmEntriesTotal').text(formatCurrency(totalEntries));

        // Show modal
        $('#confirmPostModal').modal('show');
    }

    // ============================
    // FORM SUBMISSION
    // ============================
    $(document).on('click', '#actionSubmitBtn', function(e) {
        e.preventDefault();

        var actionType = $('#actionType').val();

        // Validate form
        if (!validateActionForm(actionType)) {
            return;
        }

        if (actionType === 'post') {
            // For posting, show confirmation modal
            var postingData = collectPostingData();
            showConfirmationModal(postingData);
        } else {
            // For approve/reject, submit directly
            submitAction(actionType);
        }
    });

    $(document).on('click', '#confirmPostBtn', function() {
        $('#confirmPostModal').modal('hide');
        submitAction('post');
    });

    function validateActionForm(actionType) {
        var isValid = true;

        // Basic validation
        if (!$('#actionNote').val() || $('#actionNote').val().trim().length < 10) {
            appalert('Please enter comments/reason (minimum 10 characters)', 3, 1);
            isValid = false;
        }

        // Action-specific validation
        switch (actionType) {
            case 'approve':
                var amount = parseFloat($('#actionAmount').val());
                if (isNaN(amount) || amount <= 0) {
                    appalert('Please enter a valid approved amount (greater than 0)', 3, 1);
                    isValid = false;
                }
                break;

            case 'post':
                var totalAmount = parseFloat($('#totalAmount').val()) || 0;
                if (totalAmount <= 0) {
                    appalert('Please enter a valid total amount (greater than 0)', 3, 1);
                    isValid = false;
                }

                if (!updateValidation()) {
                    appalert('Please fix the validation errors before submitting', 3, 1);
                    isValid = false;
                }

                // Check if we have at least one entry
                var hasEntries = $('.source-account-row').length > 0 ||
                                $('.member-account-row').length > 0 ||
                                $('.branch-account-row').length > 0;

                if (!hasEntries) {
                    appalert('Please add at least one account entry', 3, 1);
                    isValid = false;
                }
                break;
        }

        return isValid;
    }

    function submitAction(actionType) {
        // Disable submit button
        var $btn = $('#actionSubmitBtn');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Processing...');

        var claimId = $('#hiddenClaimId').val();
        var token = $('input[name="__RequestVerificationToken"]').val();
        var requestData = {};

        switch (actionType) {
            case 'approve':
                requestData = {
                    ClaimId: claimId,
                    ApprovedAmount: parseFloat($('#actionAmount').val()),
                    ApprovalComment: $('#actionNote').val(),
                    ApprovedBy: '@User.Identity.Name'
                };
                break;

            case 'reject':
                requestData = {
                    ClaimId: claimId,
                    Reason: $('#actionNote').val(),
                    RejectedBy: '@User.Identity.Name'
                };
                break;

            case 'post':
                requestData = collectPostingData();
                break;
        }

        var url = '';
        switch (actionType) {
            case 'approve': url = '@Url.Action("Approve", "IPSClaim")'; break;
            case 'reject': url = '@Url.Action("Reject", "IPSClaim")'; break;
            case 'post': url = '@Url.Action("Post", "IPSClaim")'; break;
        }

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(requestData),
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function(response) {
                if (response.success) {
                    appalert(response.message || 'Action completed successfully', 1, 1);
                    $('#actionModal').modal('hide');
                    if (response.reload && ClaimsTable) {
                        ClaimsTable.ajax.reload(null, false);
                    }
                } else {
                    appalert(response.message || 'Action failed', 4, 1);
                    $btn.prop('disabled', false).html('<i class="mdi mdi-check-circle-outline me-1"></i><span id="submitButtonText">Submit</span>');
                }
            },
            error: function(xhr, status, error) {
                appalert('Error: ' + (xhr.responseJSON?.message || error), 4, 1);
                $btn.prop('disabled', false).html('<i class="mdi mdi-check-circle-outline me-1"></i><span id="submitButtonText">Submit</span>');
            }
        });
    }

