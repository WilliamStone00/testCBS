    // ============================
    // POSTING DATA FUNCTIONS
    // ============================
    function loadPostingData(claimId, memberId, branchId) {
        $('#customerInfoSection').html(`
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Loading posting data...</p>
            </div>
        `);

        resetPostingTables();

        $.ajax({
            url: '@Url.Action("GetPostingData", "IPSClaim")',
            type: 'GET',
            data: { claimId: claimId, memberId: memberId, branchId: branchId },
            success: function (response) {
                if (!response.success) {
                    appalert(response.message, 3, 1);
                    return;
                }

                const data = response.data;

                // 1. Capture Data Globally
                var rawAffiliates = data.viewBagData.affiliateAccounts || data.viewBagData.AffiliateAccounts || [];
                var rawBranches = data.viewBagData.branchAccounts || data.viewBagData.BranchAccounts || [];

                // Normalize data
                affiliateAccounts = rawAffiliates.map(x => ({ Value: x.Value || x.value, Text: x.Text || x.text }));
                branchAccounts = rawBranches.map(x => ({ Value: x.Value || x.value, Text: x.Text || x.text }));

                // 2. Update UI
                updatePostingUI(data);

                // 3. Setup Tables
                setupPostingTables(data);

                // 4. Update Totals
                updateAllTotals();
            },
            error: function () {
                appalert('Error loading posting data', 4, 1);
            }
        });
    }

