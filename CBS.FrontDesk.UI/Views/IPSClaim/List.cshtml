    // ============================
    // FORM SUBMISSION
    // ============================
    $(document).on('click', '#actionSubmitBtn', function(e) {
        e.preventDefault();

        var actionType = $('#actionType').val();

        // Validate form
        if (!validateActionForm(actionType)) {
            return;
        }

        if (actionType === 'post') {
            // For posting, show confirmation modal
            var postingData = collectPostingData();
            showConfirmationModal(postingData);
        } else {
            // For approve/reject, submit directly
            submitAction(actionType);
        }
    });

    $(document).on('click', '#confirmPostBtn', function() {
        $('#confirmPostModal').modal('hide');
        submitAction('post');
    });

    function validateActionForm(actionType) {
        var isValid = true;

        // Basic validation
        if (!$('#actionNote').val() || $('#actionNote').val().trim().length < 10) {
            appalert('Please enter comments/reason (minimum 10 characters)', 3, 1);
            isValid = false;
        }

        // Action-specific validation
        switch (actionType) {
            case 'approve':
                var amount = parseFloat($('#actionAmount').val());
                if (isNaN(amount) || amount <= 0) {
                    appalert('Please enter a valid approved amount (greater than 0)', 3, 1);
                    isValid = false;
                }
                break;

            case 'post':
                var totalAmount = parseFloat($('#totalAmount').val()) || 0;
                if (totalAmount <= 0) {
                    appalert('Please enter a valid total amount (greater than 0)', 3, 1);
                    isValid = false;
                }

                // Check if fully allocated
                var sourceTotal = getSourceTotal();
                var memberTotal = getMemberTotal();
                var branchTotal = getBranchTotal();
                var combinedTotal = sourceTotal + memberTotal + branchTotal;

                if (Math.abs(combinedTotal - totalAmount) > 0.01) { // Allow small floating point error
                    appalert('Total allocations must equal the total approved amount', 3, 1);
                    isValid = false;
                }

                // Check if we have at least one entry
                var hasEntries = $('.source-account-row').length > 0 ||
                                $('.member-account-row').length > 0 ||
                                $('.branch-account-row').length > 0;

                if (!hasEntries) {
                    appalert('Please add at least one account entry', 3, 1);
                    isValid = false;
                }
                break;
        }

        return isValid;
    }

    function submitAction(actionType) {
        // Disable submit button
        var $btn = $('#actionSubmitBtn');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Processing...');

        var claimId = $('#hiddenClaimId').val();
        var token = $('input[name="__RequestVerificationToken"]').val();
        var requestData = {};

        switch (actionType) {
            case 'approve':
                requestData = {
                    ClaimId: claimId,
                    ApprovedAmount: parseFloat($('#actionAmount').val()),
                    ApprovalComment: $('#actionNote').val(),
                    ApprovedBy: '@User.Identity.Name'
                };
                break;

            case 'reject':
                requestData = {
                    ClaimId: claimId,
                    Reason: $('#actionNote').val(),
                    RejectedBy: '@User.Identity.Name'
                };
                break;

            case 'post':
                requestData = collectPostingData();
                break;
        }

        var url = '';
        switch (actionType) {
            case 'approve': url = '@Url.Action("Approve", "IPSClaim")'; break;
            case 'reject': url = '@Url.Action("Reject", "IPSClaim")'; break;
            case 'post': url = '@Url.Action("Post", "IPSClaim")'; break;
        }

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(requestData),
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function(response) {
                if (response.success) {
                    appalert(response.message || 'Action completed successfully', 1, 1);
                    $('#actionModal').modal('hide');
                    if (response.reload && ClaimsTable) {
                        ClaimsTable.ajax.reload(null, false);
                    }
                } else {
                    appalert(response.message || 'Action failed', 4, 1);
                    $btn.prop('disabled', false).html('<i class="mdi mdi-check-circle-outline me-1"></i><span id="submitButtonText">Submit</span>');
                }
            },
            error: function(xhr, status, error) {
                appalert('Error: ' + (xhr.responseJSON?.message || error), 4, 1);
                $btn.prop('disabled', false).html('<i class="mdi mdi-check-circle-outline me-1"></i><span id="submitButtonText">Submit</span>');
            }
        });
    }

