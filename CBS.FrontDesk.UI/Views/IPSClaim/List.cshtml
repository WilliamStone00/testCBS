    function loadPostingData(claimId, memberId, branchId) {
        $('#customerInfoSection').html(`
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading posting data...</span>
                </div>
                <p class="mt-2 text-muted">Loading posting data...</p>
            </div>
        `);

        $.ajax({
            url: '@Url.Action("GetPostingData", "IPSClaim")',
            type: 'GET',
            data: { claimId: claimId, memberId: memberId, branchId: branchId },
            success: function(response) {
                if (response.success && response.data) {
                    postingDataCache = response.data;
                    displayCustomerInfo(postingDataCache);
                    setupPostingTables(postingDataCache);

                    // Store ViewBag data from controller
                    if (response.data.viewBagData) {
                        affiliateAccounts = response.data.viewBagData.affiliateAccounts || [];
                        branchAccounts = response.data.viewBagData.branchAccounts || [];

                        console.log('Loaded affiliate accounts:', affiliateAccounts.length);
                        console.log('Loaded branch accounts:', branchAccounts.length);
                    }
                } else {
                    $('#customerInfoSection').html(`
                        <div class="alert alert-danger">
                            <i class="mdi mdi-alert-circle me-1"></i>
                            ${response.message || 'Failed to load posting data'}
                        </div>
                    `);
                }
            },
            error: function(xhr, status, error) {
                $('#customerInfoSection').html(`
                    <div class="alert alert-danger">
                        <i class="mdi mdi-alert-circle me-1"></i>
                        Error loading posting data: ${error}
                    </div>
                `);
            }
        });
    }

