                                <input class="form-check-input" type="checkbox" id="includeAllColumns" name="includeAllColumns" checked>
                                <label class="form-check-label fw-semibold" for="includeAllColumns">
                                    <i class="mdi mdi-table-column me-1"></i> Include All Columns
                                </label>
                            </div>
