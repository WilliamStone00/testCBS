                </td>
                <td>${entry.Description}</td>
                <td class="text-end">
                    <span class="badge bg-light text-dark">${entry.AccountId}</span>
                </td>
            </tr>
        `);
            });

            postingData.DestinationBranchEntryListing.forEach(function (entry, index) {
                $tbody.append(`
            <tr>
                <td class="text-center">${rowCounter++}</td>
                <td><span class="badge bg-danger">Branch Account</span></td>
                <td>${entry.DestinationBranchGLAccountName || entry.DestinationBranchGLAccountId}</td>
                <td class="text-end">${formatCurrency(entry.Amount)}</td>
                <td>${entry.Description}</td>
                <td class="text-end">
                    <span class="badge bg-light text-dark">${entry.DestinationBranchGLAccountId}</span>
                </td>
            </tr>
        `);
            });

            $('#confirmEntriesTotal').text(formatCurrency(totalEntries));

            $('#confirmPostModal').modal('show');
        }

