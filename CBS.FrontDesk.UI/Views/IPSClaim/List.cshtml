/**
 * Refresh source branch affiliate accounts based on selected branch
 */
function refreshSourceBranchAffiliateAccounts(branchId) {
    var claimId = $('#hiddenClaimId').val();
    var memberId = $('#hiddenMemberId').val();

    if (!claimId || !memberId) {
        console.log('Missing claim or member ID');
        return;
    }

    // Store the current branch ID to check if it changed during loading
    var currentBranchId = branchId;

    // Show loading state on the source accounts section
    $('#sourceAccountsTableBody').html(`
        <tr id="loadingRow">
            <td colspan="4" class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                Loading accounts for selected branch...
            </td>
        </tr>
    `);

    $.ajax({
        url: '@Url.Action("GetPostingData", "IPSClaim")',
        type: 'GET',
        data: {
            claimId: claimId,
            memberId: memberId,
            branchId: branchId
        },
        success: function(response) {
            // Check if the branch hasn't changed during the AJAX call
            if ($('#SourceBranchId').val() !== currentBranchId) {
                // Branch changed during loading, ignore this response
                return;
            }

            if (response.success && response.data) {
                const data = response.data;

                // Update source branch affiliate accounts with the new branch's accounts
                if (data.viewBagData && data.viewBagData.sourceBranchAffiliateAccounts) {
                    sourceBranchAffiliateAccounts = data.viewBagData.sourceBranchAffiliateAccounts.map(x => ({
                        Value: x.Value,
                        Text: x.Text
                    }));

                    // Clear the loading row first
                    $('#loadingRow').remove();

                    // Refresh the source accounts table with new accounts
                    refreshSourceAccountsTable();

                    // Optional: Show success message
                    appalert('Source accounts updated for selected branch', 2, 1);
                }
            } else {
                appalert('Failed to load accounts for selected branch', 3, 1);
                // Restore previous state
                $('#loadingRow').remove();
                refreshSourceAccountsTable();
            }
        },
        error: function() {
            appalert('Error loading accounts for selected branch', 4, 1);
            // Restore previous state
            $('#loadingRow').remove();
            refreshSourceAccountsTable();
        }
    });
}
