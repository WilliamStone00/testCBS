    // ============================
    // EXPORT FUNCTIONALITY
    // ============================
    function showExportModal() {
        if (!ClaimsTable || currentTableData.length === 0) {
            appalert('Please load the table data first by applying filters', 3, 1);
            return;
        }

        $('#exportModal').modal('show');
    }

    function exportData() {
        var exportFormat = $('#exportFormat').val();
        var reportType = $('#reportType').val();
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        var fileName = $('#fileName').val() || 'IPS_Claims_Report';
        var includeSummary = $('#includeSummary').is(':checked');

        var exportRequest = {
            ExportFormat: exportFormat,
            ReportType: reportType,
            StartDate: startDate,
            EndDate: endDate,
            FileName: fileName,
            IncludeSummary: includeSummary,
            Data: currentTableData
        };

        // Show progress
        $('#exportProgress').removeClass('d-none');
        $('#progressText').text('Preparing export...');
        $('.progress-bar').css('width', '30%');

        $.ajax({
            url: '@Url.Action("ExportClaimsData", "IPSClaim")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(exportRequest),
            xhrFields: {
                responseType: 'blob'
            },
            beforeSend: function() {
                $('.progress-bar').css('width', '60%');
                $('#progressText').text('Generating export file...');
            },
            success: function(data, status, xhr) {
                $('.progress-bar').css('width', '100%');
                $('#progressText').text('Export complete! Downloading...');

                // Create download link
                var blob = new Blob([data], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);

                // Get filename from headers or use default
                var disposition = xhr.getResponseHeader('Content-Disposition');
                var filename = fileName + '.xlsx';
                if (disposition && disposition.indexOf('attachment') !== -1) {
                    var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    var matches = filenameRegex.exec(disposition);
                    if (matches != null && matches[1]) {
                        filename = matches[1].replace(/['"]/g, '');
                    }
                }

                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(function() {
                    $('#exportModal').modal('hide');
                    $('#exportProgress').addClass('d-none');
                    $('.progress-bar').css('width', '0%');
                }, 1000);
            },
            error: function(xhr, status, error) {
                console.error('Export error:', error);
                appalert('Error exporting data: ' + error, 4, 1);
                $('#exportProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
            }
        });
    }
    </script>
