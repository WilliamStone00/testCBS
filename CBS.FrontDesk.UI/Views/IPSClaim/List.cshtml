    function preventOverEntry() {
        $(document).on('input', '.source-amount', function () {
            var $input = $(this);
            var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
            if (enteredTotal === 0) {
                $input.val('');
                appalert('Please enter total amount first', 3, 1);
                return;
            }

            var currentValue = parseFloat($input.val()) || 0;

            if (currentValue > enteredTotal) {
                $input.val(enteredTotal > 0 ? enteredTotal : 0);
                appalert('Source amount cannot exceed total approved amount', 3, 1);
            }
            updateAllTotals();
        });

        $(document).on('input', '.member-amount', function () {
            var $input = $(this);
            var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
            if (enteredTotal === 0) {
                $input.val('');
                appalert('Please enter total amount first', 3, 1);
                return;
            }

            var currentValue = parseFloat($input.val()) || 0;
            var branchTotal = getBranchTotal();
            var maxMember = enteredTotal - branchTotal;

            if (currentValue > maxMember) {
                $input.val(maxMember > 0 ? maxMember : 0);
                appalert('Member amount cannot exceed total approved amount minus branch allocation', 3, 1);
            }
            updateAllTotals();
        });

        $(document).on('input', '.branch-amount', function () {
            var $input = $(this);
            var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
            if (enteredTotal === 0) {
                $input.val('');
                appalert('Please enter total amount first', 3, 1);
                return;
            }

            var currentValue = parseFloat($input.val()) || 0;
            var memberTotal = getMemberTotal();
            var maxBranch = enteredTotal - memberTotal;

            if (currentValue > maxBranch) {
                $input.val(maxBranch > 0 ? maxBranch : 0);
                appalert('Branch amount cannot exceed total approved amount minus member allocation', 3, 1);
            }
            updateAllTotals();
        });
    }

