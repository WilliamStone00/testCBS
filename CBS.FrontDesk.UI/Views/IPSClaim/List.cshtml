      * Refresh source accounts table with new affiliate accounts
      */
        function refreshSourceAccountsTable() {
            var currentRows = $('#sourceAccountsTableBody tr.source-account-row').length;

            if (currentRows === 0) {
                // If no rows exist, clear the table body first then add one default row
                $('#sourceAccountsTableBody').empty(); // ← ADD THIS LINE
                addSourceAccountRow();
            } else {
                // Clear any loading messages first
                $('#sourceAccountsTableBody tr').not('.source-account-row').remove(); // ← ADD THIS LINE

                // Update existing rows with new account options
                $('#sourceAccountsTableBody tr.source-account-row').each(function () {
                    var $row = $(this);
                    var $select = $row.find('.source-gl-account');
                    var currentValue = $select.val();

                    // Rebuild options
                    var optionsHtml = '<option value="">-- Select Account --</option>';
                    if (sourceBranchAffiliateAccounts && sourceBranchAffiliateAccounts.length > 0) {
                        sourceBranchAffiliateAccounts.forEach(function (acc) {
                            optionsHtml += `<option value="${acc.Value}" ${acc.Value === currentValue ? 'selected' : ''}>${acc.Text}</option>`;
                        });
                    }

                    // Replace select with new options and reinitialize Select2
                    var $newSelect = $('<select>', {
                        class: 'form-select form-select-sm source-gl-account',
                        required: true,
                        html: optionsHtml
                    });

                    $select.replaceWith($newSelect);

                    // Reinitialize Select2 for this row
                    setTimeout(function () {
                        initializeSelect2($newSelect);
                    }, 50);
                });
            }

            // Make sure to update totals after refresh
            setTimeout(updateAllTotals, 100);
        }

