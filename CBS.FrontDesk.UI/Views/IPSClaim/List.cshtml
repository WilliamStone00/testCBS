                appalert('Please load data first by applying filters', 3, 1);
                return;
            }
            showExportModal();
        });

        // Bind table row events globally
        bindTableRowEvents();

        // Bind total amount input - RESET ALLOCATIONS WHEN TOTAL CHANGES
        $(document).on('input', '#totalAmount', function() {
            var enteredTotal = parseFloat($(this).val()) || 0;
            if (enteredTotal === 0) {
                resetAllTotals();
                return;
            }

            // Reset all amounts if total changes
            $('.source-amount').val('');
            $('.member-amount').val('');
            $('.branch-amount').val('');

            $('#displayTotalAmount').text(formatCurrency(enteredTotal));
            updateAllTotals();
        });

        // Initialize amount validation
        preventOverEntry();

        // Bind the export confirm button click event
        $(document).on('click', '#btnConfirmExport', function (e) {
            e.preventDefault();
            exportData();
        });
        // REMOVED: Auto-load on page load
        // Data will only load when applyFilterBtn is clicked
    });

