
@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSClaimQuery
@using Resources

@{
    ViewBag.Title = "IPS Claims Management";
}


<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>IPS Claims Management
                </h1>
                <p class="card-text">
                    Browse and filter insurance claims by member, claim type, status, and other criteria.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Use the filters below to narrow down the list of IPS claims.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> IPS Claims Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClaimTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseClaimTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>Member Verification:</strong> Verify member details and eligibility before processing claims.
                </li>
                <li>
                    <i class="mdi mdi-file-document-outline text-warning me-2"></i>
                    <strong>Documentation:</strong> Ensure all required documents are uploaded before approval.
                </li>
                <li>
                    <i class="mdi mdi-cash-multiple text-success me-2"></i>
                    <strong>Amount Verification:</strong> Verify claimed amounts against coverage limits and balances.
                </li>
                <li>
                    <i class="mdi mdi-account-group text-primary me-2"></i>
                    <strong>Beneficiary Info:</strong> Accurate beneficiary information is crucial for claim settlement.
                </li>
                <li>
                    <i class="mdi mdi-calendar-check text-danger me-2"></i>
                    <strong>Event Date:</strong> Ensure event date is within coverage period and valid.
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <strong>Workflow:</strong> Claims follow: Registered → Pending → Approved/Rejected → Posted.
                </li>
                <li>
                    <i class="mdi mdi-bank text-info me-2"></i>
                    <strong>Posting:</strong> After approval, post to accounting for financial settlement.
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "IPSClaim")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview2','_Create','new','IPSClaim')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="AddNew">
            <i class="mdi mdi-plus mdi-18px"></i> Add New
        </a>
    </div>
</div>

<div id="datalistingview2">
    <div class="card shadow p-3 mb-1">
        <h5 class="text-primary mb-1">
            <i class="mdi mdi-filter-outline me-1"></i> IPS Claim Filters
        </h5>

        <form id="claimFilterForm" autocomplete="off">
            <div class="card p-3 mb-3 bg-light">

                <!-- Basic Filters (Always Visible) -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Branch</label>
                            @Html.DropDownListFor(
                                m => m.BranchId,
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-control select2", id = "filterBranch" }
                            )
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Member ID</label>
                            @Html.TextBoxFor(
                                m => m.MemberId,
                                new { @class = "form-control", placeholder = "Enter Member ID", id = "filterMemberId" }
                            )
                        </div>
                    </div>
                </div>

                <!-- Toggle Checkboxes -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleClaimType" />
                            <label class="form-check-label fw-semibold" for="toggleClaimType">
                                <i class="mdi mdi-account-card-details me-1"></i> Claim Type
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleStatus" />
                            <label class="form-check-label fw-semibold" for="toggleStatus">
                                <i class="mdi mdi-toggle-switch me-1"></i> Status
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleIsPosted" />
                            <label class="form-check-label fw-semibold" for="toggleIsPosted">
                                <i class="mdi mdi-bank-check me-1"></i> Posted Status
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleAmount" />
                            <label class="form-check-label fw-semibold" for="toggleAmount">
                                <i class="mdi mdi-cash-multiple me-1"></i> Approved Amount
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleDateRange" />
                            <label class="form-check-label fw-semibold" for="toggleDateRange">
                                <i class="mdi mdi-calendar-range me-1"></i> Date Range
                            </label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="toggleDeleted" />
                            <label class="form-check-label fw-semibold" for="toggleDeleted">
                                <i class="mdi mdi-delete me-1"></i> Include Deleted
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Claim Type Section -->
                <div id="claimTypeSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Claim Type</label>
                                <select class="form-control select2" id="filterClaimType">
                                    <option value="">--- Select Claim Type ---</option>
                                    <option value="LoanProtection">Loan Protection</option>
                                    <option value="LifeSavings">Life Savings</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Section -->
                <div id="statusSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Status</label>
                                <select class="form-control select2" id="filterStatus">
                                    <option value="">--- Select Status ---</option>
                                    <option value="Registered">Registered</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Posted">Posted</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- IsPosted Section -->
                <div id="isPostedSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Posted Status</label>
                                <select class="form-control select2" id="filterIsPosted">
                                    <option value="">--- Select Posted Status ---</option>
                                    <option value="true">Posted</option>
                                    <option value="false">Not Posted</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Approved Amount Section -->
                <div id="amountSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Min Approved Amount</label>
                                @Html.TextBoxFor(
                                    m => m.MinApprovedAmount,
                                    new { @class = "form-control", type = "number", step = "0.01", placeholder = "Minimum", id = "MinApprovedAmount", min = "0" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Max Approved Amount</label>
                                @Html.TextBoxFor(
                                    m => m.MaxApprovedAmount,
                                    new { @class = "form-control", type = "number", step = "0.01", placeholder = "Maximum", id = "MaxApprovedAmount", min = "0" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Date Range Section -->
                <div id="dateRangeSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Event Date From</label>
                                @Html.TextBoxFor(
                                    m => m.EventFrom,
                                    new { @class = "form-control", type = "date", id = "EventFrom" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Event Date To</label>
                                @Html.TextBoxFor(
                                    m => m.EventTo,
                                    new { @class = "form-control", type = "date", id = "EventTo" }
                                )
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Created Date From</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedFromUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedFromUtc" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Created Date To</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedToUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedToUtc" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Include Deleted Section -->
                <div id="deletedSection" class="collapse">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                                <label class="form-check-label fw-semibold" for="IncludeDeleted">
                                    Include Deleted Claims
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="row mt-2">
                <div class="col-md-12 d-flex">
                    <button type="button" id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                        <i class="mdi mdi-magnify"></i> Apply Filter
                    </button>

                    <button type="button" id="resetFilterBtn" class="btn btn-secondary me-2 w-100">
                        <i class="mdi mdi-refresh"></i> Reset
                    </button>

                    <button type="button" id="exportExcelBtn" class="btn btn-success w-100">
                        <i class="mdi mdi-file-excel me-1"></i> Export Data
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div id="datalistingview">
        @Html.Partial("_ClaimDataTable")
    </div>
</div>


<!-- inside your current view -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card bg-light mb-3">
                            <div class="card-body text-center">
                                <h4 class="card-title text-primary">
                                    <i class="mdi mdi-export me-2"></i>Export Options
