            $('#confirmExternalApp').text(postingData.ExternalApplicationName);
            $('#confirmForceRepost').text(postingData.ForceRepost ? 'Yes' : 'No');

            var sourceTotal = postingData.SourceAccountEntryListing.reduce((sum, entry) => sum + entry.Amount, 0);
            var memberTotal = postingData.MemberBalanceDestinationEntries.reduce((sum, entry) => sum + entry.Amount, 0);
            var branchTotal = postingData.DestinationBranchEntryListing.reduce((sum, entry) => sum + entry.Amount, 0);
            var totalEntries = sourceTotal + memberTotal + branchTotal;

            var $tbody = $('#confirmSummaryTable tbody');
            $tbody.empty();

