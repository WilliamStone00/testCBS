            z-index: 10000 !important;
        }

        .select2-results__option--highlighted {
            background-color: #0d6efd !important;
            color: white !important;
        }
   
            /* Ensure dropdown is above modal */
            .select2-container--open {
                z-index: 9999 !important;
            }

            /* Match Bootstrap styling */
            .select2-container--default .select2-selection--single {
                height: 38px !important;
                border: 1px solid #dee2e6 !important;
                border-radius: 0.25rem !important;
                display: flex;
                align-items: center;
            }

                .select2-container--default .select2-selection--single .select2-selection__rendered {
                    line-height: 36px !important;
                    padding-left: 12px !important;
                }

                .select2-container--default .select2-selection--single .select2-selection__arrow {
                    height: 36px !important;
                }

            .select2-container {
                width: 100% !important;
            }

            .select2-dropdown {
                border: 1px solid #ced4da !important;
                border-radius: 0.25rem !important;
                box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important;
                z-index: 10000 !important;
            }

            .select2-results__option--highlighted {
                background-color: #0d6efd !important;
                color: white !important;
            }
        </style>

    <script>
    var ClaimsTable = null;
    var currentTableData = [];
    var postingDataCache = {};
    var sourceBranchAffiliateAccounts = []; // Renamed from affiliateAccounts
    var branchAccounts = [];

    // ============================
    // HELPER FUNCTIONS
    // ============================
    function formatCurrency(amount) {
        return new Intl.NumberFormat('en-US', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
        }).format(amount);
    }

    function getStatusBadgeClass(status) {
        switch (status?.toLowerCase()) {
            case 'registered': return 'bg-info';
            case 'pending': return 'bg-warning';
            case 'approved': return 'bg-success';
            case 'rejected': return 'bg-danger';
            case 'posted': return 'bg-primary';
            default: return 'bg-secondary';
        }
    }

    function valOrNull(selector) {
        const v = $(selector).val();
        return (v && v.toString().trim() !== '') ? v : null;
    }

    // ============================================
    // SELECT2 INITIALIZATION WITH PROPER POSITIONING
    // ============================================

    /**
     * Initialize Select2 with modal as parent for proper positioning
     */
    function initializeSelect2(selector) {
        if (!$.fn.select2) return;

        // Destroy existing instance if any
        if ($(selector).data('select2')) {
            $(selector).select2('destroy');
        }

        // Initialize with modal as dropdown parent
        $(selector).select2({
            width: '100%',
            placeholder: '--- Select ---',
            allowClear: true,
            dropdownParent: $('#actionModal'), // CRITICAL: Attach to modal
            minimumResultsForSearch: 0, // Always show search
            language: {
                errorLoading: function () {
                    return 'Loading...';
                }
            }
        });

        // Force reposition on window resize
        var $select = $(selector);
        var selectId = $select.attr('id') || 'select-' + Math.random();

        $(window).off('resize.select2-' + selectId);
        $(window).on('resize.select2-' + selectId, function () {
            if ($select.data('select2') && $select.data('select2').isOpen()) {
                $select.select2('close');
                setTimeout(function () {
                    $select.select2('open');
                }, 100);
            }
        });
    }

    /**
     * Reposition all open dropdowns
     */
    function repositionOpenDropdowns() {
        $('.select2-container--open').each(function () {
            var $container = $(this);
            var $select = $container.prev('.select2-hidden-accessible');

            if ($select.length && $select.data('select2')) {
                var select2 = $select.data('select2');
                if (select2.isOpen()) {
                    $select.select2('close');
                    setTimeout(function () {
                        $select.select2('open');
                    }, 50);
                }
            }
        });
    }

    /**
     * Detect browser zoom level
     */
    function detectZoom() {
        var ratio = 1;
        if (window.devicePixelRatio !== undefined) {
            ratio = window.devicePixelRatio;
        }
        if (document.documentElement) {
            var zoom = (window.outerWidth - 8) / window.innerWidth;
            if (!isNaN(zoom) && zoom > 0 && zoom < 10) {
                ratio = zoom;
            }
        }
        return ratio;
    }

    // ============================
    // ENHANCED VALIDATION FUNCTIONS
    // ============================
    function updateAllTotals() {
        var enteredTotal = parseFloat($('#totalAmount').val()) || 0;
        if (enteredTotal === 0) {
            resetAllTotals();
            return;
        }

        var sourceTotal = getSourceTotal();
        var memberTotal = getMemberTotal();
        var branchTotal = getBranchTotal();

        var memberBranchTotal = memberTotal + branchTotal;
        var combinedTotal = sourceTotal + memberBranchTotal;
        var remainingTotal = enteredTotal - combinedTotal;
        var remainingForSource = enteredTotal - sourceTotal;
        var remainingForMemberBranch = enteredTotal - memberBranchTotal;

        $('#sourceTotalAmount').text(formatCurrency(sourceTotal));
        $('#memberTotalAmount').text(formatCurrency(memberTotal));
        $('#branchTotalAmount').text(formatCurrency(branchTotal));

        $('#sourceMaxAmount').text(formatCurrency(enteredTotal));
        $('#memberAvailableBalance').text(formatCurrency(enteredTotal - branchTotal));
        $('#branchAvailableBalance').text(formatCurrency(enteredTotal - memberTotal));

        $('#displayTotalAmount').text(formatCurrency(enteredTotal));
        $('#sourceBalance').text(formatCurrency(remainingForSource));
        $('#memberBranchBalance').text(formatCurrency(remainingForMemberBranch));

        $('#availableForMemberBranch').text(formatCurrency(enteredTotal));
        $('#remainingBalance').text(formatCurrency(remainingTotal));

        updateValidationDisplay(enteredTotal, sourceTotal, memberTotal, branchTotal);
        updateInputLimits(enteredTotal, sourceTotal, memberTotal, branchTotal);
    }

    function resetAllTotals() {
        $('[id$="TotalAmount"]').text('0.00');
        $('[id^="validation"]').text('0.00');
        $('[id$="Balance"]').text('0.00');
        $('[id$="AvailableBalance"]').text('0.00');
        $('#validationStatus').removeClass().addClass('badge bg-warning').text('Enter Amount');
        $('#validationMessage').text('Please enter total amount first');
        $('#amountValidation').removeClass().addClass('badge bg-warning').text('Enter Amount');
    }

    function updateInputLimits(enteredTotal, sourceTotal, memberTotal, branchTotal) {
        if (enteredTotal === 0) return;

        $('.source-amount').each(function () {
            var $input = $(this);
            var currentValue = parseFloat($input.val()) || 0;
            var maxSource = enteredTotal;

            $input.attr('max', maxSource > 0 ? maxSource : 0);

            if (currentValue > maxSource) {
                $input.addClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
                $input.after('<div class="invalid-feedback">Cannot exceed total approved amount</div>');
            } else {
                $input.removeClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
            }
        });

        $('.member-amount').each(function () {
            var $input = $(this);
            var currentValue = parseFloat($input.val()) || 0;
            var maxMember = enteredTotal - branchTotal;

            $input.attr('max', maxMember > 0 ? maxMember : 0);

            if (currentValue > maxMember) {
                $input.addClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
                $input.after('<div class="invalid-feedback">Cannot exceed total approved amount minus branch allocation</div>');
            } else {
                $input.removeClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
            }
        });

        $('.branch-amount').each(function () {
            var $input = $(this);
            var currentValue = parseFloat($input.val()) || 0;
            var maxBranch = enteredTotal - memberTotal;

            $input.attr('max', maxBranch > 0 ? maxBranch : 0);

            if (currentValue > maxBranch) {
                $input.addClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
                $input.after('<div class="invalid-feedback">Cannot exceed total approved amount minus member allocation</div>');
            } else {
                $input.removeClass('is-invalid');
                $input.siblings('.invalid-feedback').remove();
            }
        });
    }

    function updateValidationDisplay(enteredTotal, sourceTotal, memberTotal, branchTotal) {
        var memberBranchTotal = memberTotal + branchTotal;
        var combinedTotal = sourceTotal + memberBranchTotal;
        var remainingTotal = enteredTotal - combinedTotal;

        $('#validationSourceTotal').text(formatCurrency(sourceTotal));
        $('#validationMemberTotal').text(formatCurrency(memberTotal));
        $('#validationBranchTotal').text(formatCurrency(branchTotal));
        $('#validationBranchMemberTotal').text(formatCurrency(memberBranchTotal));
        $('#validationCombinedTotal').text(formatCurrency(combinedTotal));
        $('#validationEnteredTotal').text(formatCurrency(enteredTotal));

        var statusText = '';
        var statusClass = '';
        var message = '';

        if (enteredTotal === 0) {
            statusText = 'Enter Amount';
            statusClass = 'bg-warning';
            message = 'Please enter total amount first';
        } else if (sourceTotal > enteredTotal) {
            statusText = 'Source Exceeds';
            statusClass = 'bg-danger';
            message = `Source amount (${formatCurrency(sourceTotal)}) exceeds total approved amount`;
        } else if (memberBranchTotal > enteredTotal) {
            statusText = 'Member+Branch Exceeds';
            statusClass = 'bg-danger';
            message = `Member+Branch total (${formatCurrency(memberBranchTotal)}) exceeds total approved amount`;
        } else if (Math.abs(combinedTotal - enteredTotal) < 0.01) {
            statusText = 'Fully Allocated';
            statusClass = 'bg-success';
            message = 'All amount has been allocated';
        } else {
            statusText = 'Partially Allocated';
            statusClass = 'bg-warning';
            message = `${formatCurrency(remainingTotal)} remaining to allocate`;
        }

        $('#validationStatus').removeClass().addClass('badge ' + statusClass).text(statusText);
        $('#validationMessage').text(message);
        $('#amountValidation').removeClass().addClass('badge ' + statusClass).text(statusText);

        $('#remainingBalance').text(formatCurrency(remainingTotal));
        $('#availableForMemberBranch').text(formatCurrency(enteredTotal));

        return Math.abs(combinedTotal - enteredTotal) < 0.01;
    }

