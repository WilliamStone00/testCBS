    // ============================
    // DATA COLLECTION FOR POSTING
    // ============================
        function collectPostingData() {
            var data = {
                ClaimId: $('#hiddenClaimId').val(),
                CustomerId: $('#hiddenMemberId').val(),
                Note: $('#actionNote').val(),
                TotalAmount: parseFloat($('#totalAmount').val()) || 0,
                ExternalApplicationName: $('#externalApplicationName').val(),
                AccountingDate: $('#accountingDate').val(),
                ForceRepost: $('#forceRepost').is(':checked'),
                MemberBalanceDestinationEntries: [],
                SourceAccountEntryListing: [],
                DestinationBranchEntryListing: []
            };

            $('.source-account-row').each(function () {
                var $row = $(this);
                var accountSelect = $row.find('.source-gl-account');
                var accountText = accountSelect.find('option:selected').text();

                // Get the selected source branch ID
                var sourceBranchId = $('#SourceBranchId').val(); // Add this line

                var entry = {
                    SourceBranchId: sourceBranchId, // Add this field
                    SourceGLAccountId: accountSelect.val(),
                    SourceGLAccountName: accountText,
                    Amount: parseFloat($row.find('.source-amount').val()) || 0,
                    Description: $row.find('.source-description').val()
                };

                if (entry.SourceGLAccountId && entry.Amount > 0) {
                    data.SourceAccountEntryListing.push(entry);
                }
            });

            $('.member-account-row').each(function () {
                var $row = $(this);
                var entry = {
                    AccountId: $row.find('.account-id').val(),
                    DestinationGLAccountId: $row.find('.account-id').val(),
                    AccountNumber: $row.find('td:first-child small').text().trim(),
                    AccountName: $row.find('td:first-child .fw-bold').text().trim(),
                    AccountType: $row.find('.account-type').val(),
                    OriginalBalance: parseFloat($row.find('.account-balance').val()) || 0,
                    Amount: parseFloat($row.find('.member-amount').val()) || 0,
                    Description: $row.find('.member-description').val()
                };
                if (entry.AccountId && entry.Amount > 0) {
                    data.MemberBalanceDestinationEntries.push(entry);
                }
            });

            $('.branch-account-row').each(function () {
                var $row = $(this);
                var accountSelect = $row.find('.branch-gl-account');
                var accountText = accountSelect.find('option:selected').text();
                var entry = {
                    DestinationBranchGLAccountId: accountSelect.val(),
                    DestinationBranchGLAccountName: accountText,
                    Amount: parseFloat($row.find('.branch-amount').val()) || 0,
                    Description: $row.find('.branch-description').val()
                };
                if (entry.DestinationBranchGLAccountId && entry.Amount > 0) {
                    data.DestinationBranchEntryListing.push(entry);
                }
            });

            return data;
        }

