@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSClaimQuery
@using Resources

@{
    ViewBag.Title = "IPS Claims Management";
}

<div id="datalistingview2">
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-shield-account me-2"></i>IPS Claims Management
                    </h1>
                    <p class="card-text">
                        Browse and filter insurance claims by member, claim type, status, and other criteria.
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Use the filters below to narrow down the list of IPS claims.
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> IPS Claims Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClaimTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseClaimTips" class="collapse">
            <div class="card-body">
                <ul>
                    <li>
                        <i class="mdi mdi-account-clock text-info me-2"></i>
                        <strong>Member Verification:</strong> Verify member details and eligibility before processing claims.
                    </li>
                    <li>
                        <i class="mdi mdi-file-document-outline text-warning me-2"></i>
                        <strong>Documentation:</strong> Ensure all required documents are uploaded before approval.
                    </li>
                    <li>
                        <i class="mdi mdi-cash-multiple text-success me-2"></i>
                        <strong>Amount Verification:</strong> Verify claimed amounts against coverage limits and balances.
                    </li>
                    <li>
                        <i class="mdi mdi-account-group text-primary me-2"></i>
                        <strong>Beneficiary Info:</strong> Accurate beneficiary information is crucial for claim settlement.
                    </li>
                    <li>
                        <i class="mdi mdi-calendar-check text-danger me-2"></i>
                        <strong>Event Date:</strong> Ensure event date is within coverage period and valid.
                    </li>
                    <li>
                        <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                        <strong>Workflow:</strong> Claims follow: Registered → Pending → Approved/Rejected → Posted.
                    </li>
                    <li>
                        <i class="mdi mdi-bank text-info me-2"></i>
                        <strong>Posting:</strong> After approval, post to accounting for financial settlement.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("List", "IPSClaim")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="@GlobalShared.ViewList">
                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
            </a>
            <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','IPSConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="AddNew">
                <i class="mdi mdi-plus mdi-18px"></i> Add New
            </a>
        </div>
    </div>

    <div class="card shadow p-3 mb-1">
        <h5 class="text-primary mb-1">
            <i class="mdi mdi-filter-outline me-1"></i> IPS Claim Filters
        </h5>

        <form id="claimFilterForm" autocomplete="off">
            <div class="card p-3 mb-3 bg-light">

                <!-- Basic Filters (Always Visible) -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Branch</label>
                            @Html.DropDownListFor(
                                m => m.BranchId,
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-control select2", id = "filterBranch" }
                            )
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Member ID</label>
                            @Html.TextBoxFor(
                                m => m.MemberId,
                                new { @class = "form-control", placeholder = "Enter Member ID", id = "filterMemberId" }
                            )
                        </div>
                    </div>
                </div>

                <!-- Toggle Checkboxes -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleClaimType" />
                            <label class="form-check-label fw-semibold" for="toggleClaimType">
                                <i class="mdi mdi-account-card-details me-1"></i> Claim Type
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleStatus" />
                            <label class="form-check-label fw-semibold" for="toggleStatus">
                                <i class="mdi mdi-toggle-switch me-1"></i> Status
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleIsPosted" />
                            <label class="form-check-label fw-semibold" for="toggleIsPosted">
                                <i class="mdi mdi-bank-check me-1"></i> Posted Status
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleAmount" />
                            <label class="form-check-label fw-semibold" for="toggleAmount">
                                <i class="mdi mdi-cash-multiple me-1"></i> Approved Amount
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleDateRange" />
                            <label class="form-check-label fw-semibold" for="toggleDateRange">
                                <i class="mdi mdi-calendar-range me-1"></i> Date Range
                            </label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="toggleDeleted" />
                            <label class="form-check-label fw-semibold" for="toggleDeleted">
                                <i class="mdi mdi-delete me-1"></i> Include Deleted
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Claim Type Section -->
                <div id="claimTypeSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Claim Type</label>
                                <select class="form-control select2" id="filterClaimType">
                                    <option value="">--- Select Claim Type ---</option>
                                    <option value="LoanProtection">Loan Protection</option>
                                    <option value="LifeSavings">Life Savings</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Section -->
                <div id="statusSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Status</label>
                                <select class="form-control select2" id="filterStatus">
                                    <option value="">--- Select Status ---</option>
                                    <option value="Registered">Registered</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Posted">Posted</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- IsPosted Section -->
                <div id="isPostedSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Posted Status</label>
                                <select class="form-control select2" id="filterIsPosted">
                                    <option value="">--- Select Posted Status ---</option>
                                    <option value="true">Posted</option>
                                    <option value="false">Not Posted</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Approved Amount Section -->
                <div id="amountSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Min Approved Amount</label>
                                @Html.TextBoxFor(
                                    m => m.MinApprovedAmount,
                                    new { @class = "form-control", type = "number", step = "0.01", placeholder = "Minimum", id = "MinApprovedAmount", min = "0" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Max Approved Amount</label>
                                @Html.TextBoxFor(
                                    m => m.MaxApprovedAmount,
                                    new { @class = "form-control", type = "number", step = "0.01", placeholder = "Maximum", id = "MaxApprovedAmount", min = "0" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Date Range Section -->
                <div id="dateRangeSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Event Date From</label>
                                @Html.TextBoxFor(
                                    m => m.EventFrom,
                                    new { @class = "form-control", type = "date", id = "EventFrom" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Event Date To</label>
                                @Html.TextBoxFor(
                                    m => m.EventTo,
                                    new { @class = "form-control", type = "date", id = "EventTo" }
                                )
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Created Date From</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedFromUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedFromUtc" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Created Date To</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedToUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedToUtc" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Include Deleted Section -->
                <div id="deletedSection" class="collapse">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                                <label class="form-check-label fw-semibold" for="IncludeDeleted">
                                    Include Deleted Claims
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="row mt-2">
                <div class="col-md-12 d-flex">
                    <button type="button" id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                        <i class="mdi mdi-magnify"></i> Apply Filter
                    </button>

                    <button type="button" id="resetFilterBtn" class="btn btn-secondary me-2 w-100">
                        <i class="mdi mdi-refresh"></i> Reset
                    </button>

                    <button type="button" id="exportExcelBtn" class="btn btn-success w-100">
                        <i class="mdi mdi-file-excel me-1"></i> Export Data
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div id="datalistingview">
        @Html.Partial("_ClaimDataTable")
    </div>
</div>


<!-- inside your current view -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("~/Views/CollectorCommission/_ExportCommission.cshtml")
            @* or if in Shared folder: @Html.Partial("_ExportCommission", ModelForExport) *@
        </div>
    </div>
</div>

<!-- Load Action Modal Partial View -->
@Html.Partial("_ActionModal")

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    var ClaimsTable = null;
    var currentTableData = [];
    var postingDataCache = {};
    var affiliateAccounts = [];
    var branchAccounts = [];

    // ============================
    // HELPER FUNCTIONS
    // ============================
    function formatCurrency(amount) {
        return new Intl.NumberFormat('en-US', {
            minimumFractionDigits: 2
        }).format(amount);
    }

    function getStatusBadgeClass(status) {
        switch (status?.toLowerCase()) {
            case 'registered': return 'bg-info';
            case 'pending': return 'bg-warning';
            case 'approved': return 'bg-success';
            case 'rejected': return 'bg-danger';
            case 'posted': return 'bg-primary';
            default: return 'bg-secondary';
        }
    }

    function valOrNull(selector) {
        const v = $(selector).val();
        return (v && v.toString().trim() !== '') ? v : null;
    }

    // ============================
    // INITIALIZATION
    // ============================
    $(document).ready(function () {
        // Initialize Select2
        if ($.fn.select2) {
            $('.select2').select2({
                width: '100%',
                placeholder: '--- Select ---',
                allowClear: true
            });
        }

        // Bind filter toggles
        bindFilterToggles();

        // Bind event handlers
        $('#applyFilterBtn').click(function (e) {
            e.preventDefault();
            loadClaimsData();
        });

        $('#resetFilterBtn').click(function (e) {
            e.preventDefault();
            resetFilters();
        });

        $('#exportExcelBtn').click(function (e) {
            e.preventDefault();
            showExportModal();
        });

        // Bind table row events globally (like FeeConfig pattern)
        bindTableRowEvents();

        // Load data on page load
        setTimeout(function() {
            loadClaimsData();
        }, 100);

        // Note: Removed loadAffiliateAccounts() - will be loaded with posting data
    });

    // ============================
    // GLOBAL TABLE ROW EVENT BINDING (Based on FeeConfig pattern)
    // ============================
    function bindTableRowEvents() {
        // Add source row button
        $(document).on('click', '#addSourceRowBtn', function(e) {
            e.preventDefault();
            addSourceAccountRow();
            updateAllTotals();
        });

        // Add branch row button
        $(document).on('click', '#addBranchRowBtn', function(e) {
            e.preventDefault();
            addBranchAccountRow();
            updateAllTotals();
        });

        // Delete source row button
        $(document).on('click', '.delete-source-row-btn', function(e) {
            e.preventDefault();
            var $row = $(this).closest('tr');
            $row.remove();
            if ($('#sourceAccountsTableBody tr').length === 0) {
                $('#sourceAccountsTableBody').html(`
                    <tr id="noSourceRows">
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="mdi mdi-information-outline me-1"></i>
                            No source accounts added yet. Click "Add Row" to add entries.
                        </td>
                    </tr>
                `);
            }
            updateAllTotals();
        });

        // Delete member row button
        $(document).on('click', '.delete-member-row-btn', function(e) {
            e.preventDefault();
            $(this).closest('tr').remove();
            updateAllTotals();
        });

        // Delete branch row button
        $(document).on('click', '.delete-branch-row-btn', function(e) {
            e.preventDefault();
            var $row = $(this).closest('tr');
            $row.remove();
            if ($('#branchAccountsTableBody tr').length === 0) {
                $('#branchAccountsTableBody').html(`
                    <tr id="noBranchRows">
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="mdi mdi-information-outline me-1"></i>
                            No branch accounts added yet. Click "Add Row" to add entries.
                        </td>
                    </tr>
                `);
            }
            updateAllTotals();
        });

        // Amount input changes
        $(document).on('input', '.source-amount, .member-amount, .branch-amount', function() {
            updateAllTotals();
        });

        // Total amount input
        $(document).on('input', '#totalAmount', function() {
            updateAllTotals();
        });

        // Refresh customer data button
        $(document).on('click', '#refreshCustomerBtn', function(e) {
            e.preventDefault();
            var claimId = $('#hiddenClaimId').val();
            var memberId = $('#hiddenMemberId').val();
            var branchId = $('#hiddenBranchId').val();
            loadPostingData(claimId, memberId, branchId);
        });
    }

    // ============================
    // DATATABLE FUNCTIONS
    // ============================
    function initDataTable() {
        var tableId = '#myDataTable';

        if (!$(tableId).length) {
            console.error('Table element not found. Expected #myDataTable');
            return;
        }

        // Destroy existing DataTable if it exists
        if ($.fn.DataTable.isDataTable(tableId)) {
            if (ClaimsTable) {
                ClaimsTable.destroy();
            }
            $(tableId + ' tbody').empty();
        }

        ClaimsTable = $(tableId).DataTable({
            serverSide: true,
            searching: true,
            responsive: true,
            ordering: true,
            order: [[0, 'desc']],
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            destroy: true,

            ajax: {
                url: '@Url.Action("LoadClaimsData", "IPSClaim")',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    var filters = collectFilters();

                    filters.options = {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        skip: d.start,
                        pageSize: d.length,
                        searchValue: d.search.value || '',
                        sortColumnName: d.columns[d.order[0].column]?.data || 'CreatedDate',
                        sortColumnDirection: d.order[0].dir || 'desc'
                    };

                    return JSON.stringify(filters);
                },
                dataSrc: function (json) {
                    if (json && json.data) {
                        currentTableData = json.data;
                        return json.data;
                    }
                    return [];
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error('DataTable AJAX error:', textStatus, errorThrown);
                    appalert('Failed to load claims data', 0, 1);
                }
            },

            columns: [
                {
                    data: 'CreatedDate',
                    name: 'CreatedDate',
                    render: function (data) {
                        return data ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data) : '-';
                    }
                },
                {
                    data: 'ClaimType',
                    name: 'ClaimType',
                    render: function(data) {
                        if (!data) return '-';
                        var badgeClass = data === 'LoanProtection' ? 'bg-info' : 'bg-primary';
                        var displayText = data === 'LoanProtection' ? 'Loan Protection' : 'Life Savings';
                        return `<span class="badge ${badgeClass}">${displayText}</span>`;
                    }
                },
                {
                    data: 'BranchName',
                    name: 'BranchName',
                    render: function (data) {
                        return data ? `<span class="badge bg-secondary">${data}</span>` : '-';
                    }
                },
                {
                    data: 'ClaimedAmount',
                    name: 'ClaimedAmount',
                    render: function(data) {
                        if (!data && data !== 0) return '-';
                        return `<span class="fw-bold">${formatCurrency(data)}</span>`;
                    }
                },
                {
                    data: 'BeneficiaryName',
                    name: 'BeneficiaryName',
                    render: function(data, type, row) {
                        if (!data) return '-';
                        var contact = row.BeneficiaryContact ? `<br/><small class="text-muted">${row.BeneficiaryContact}</small>` : '';
                        return `<div>${data}${contact}</div>`;
                    }
                },
                {
                    data: 'Status',
                    name: 'Status',
                    render: function (data) {
                        if (!data) return '-';
                        var badgeClass = getStatusBadgeClass(data);
                        return `<span class="badge ${badgeClass}">${data}</span>`;
                    }
                },
                {
                    data: 'Id',
                    name: 'Actions',
                    orderable: false,
                    searchable: false,
                    width: '150px',
                    render: function (data, type, row) {
                        var claimId = row.Id;
                        var memberId = row.MemberId;
                        var branchId = row.BranchId;
                        var status = row.Status || '';
                        var isPosted = status === 'Posted';

                        // Action buttons
                        var buttons = `
                            <div class="dropdown">
                                <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" data-bs-toggle="dropdown">
                                    <i class="mdi mdi-cog-outline"></i> Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item btn-details" data-id="${claimId}">
                                            <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item btn-documents" data-id="${claimId}">
                                            <i class="mdi mdi-file-upload me-1 text-warning"></i> Upload Docs
                                        </button>
                                    </li>`;

                        // Approve button
                        if (status === 'Registered') {
                            buttons += `
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item btn-approve" data-id="${claimId}" data-member="${memberId}" data-branch="${branchId}">
                                        <i class="mdi mdi-check me-1 text-success"></i> Approve
                                    </button>
                                </li>`;
                        }

                        // Reject button
                        if (status === 'Registered') {
                            buttons += `
                                <li>
                                    <button class="dropdown-item btn-reject" data-id="${claimId}" data-member="${memberId}" data-branch="${branchId}">
                                        <i class="mdi mdi-close me-1 text-danger"></i> Reject
                                    </button>
                                </li>`;
                        }

                        // Post button
                        if (status === 'Approved' && !isPosted) {
                            buttons += `
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item btn-post" data-id="${claimId}" data-member="${memberId}" data-branch="${branchId}">
                                        <i class="mdi mdi-send me-1 text-info"></i> Post
                                    </button>
                                </li>`;
                        }

                        // Delete button
                        buttons += `
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button class="dropdown-item btn-delete text-danger" data-id="${claimId}">
                                    <i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete
                                </button>
                            </li>
                        </ul>
                    </div>`;

                        return buttons;
                    }
                }
            ],

            language: {
                emptyTable: 'No claims found matching your criteria',
                info: 'Showing _START_ to _END_ of _TOTAL_ claims',
                infoEmpty: 'Showing 0 to 0 of 0 claims',
                infoFiltered: '(filtered from _MAX_ total claims)',
                lengthMenu: 'Show _MENU_ claims',
                search: 'Search in all columns:',
                zeroRecords: 'No matching claims found',
                paginate: {
                    first: 'First',
                    last: 'Last',
                    next: 'Next',
                    previous: 'Previous'
                }
            }
        });
    }

    function loadClaimsData() {
        initDataTable();
    }

    // ============================
    // FILTER FUNCTIONS
    // ============================
    function collectFilters() {
        const filters = {
            memberId: valOrNull('#filterMemberId'),
            branchId: valOrNull('#filterBranch'),
            status: $('#toggleStatus').is(':checked') ? valOrNull('#filterStatus') : null,
            claimType: $('#toggleClaimType').is(':checked') ? valOrNull('#filterClaimType') : null,
            isPosted: $('#toggleIsPosted').is(':checked') ? valOrNull('#filterIsPosted') : null,
            minApprovedAmount: $('#toggleAmount').is(':checked') ? parseFloat($('#MinApprovedAmount').val()) || null : null,
            maxApprovedAmount: $('#toggleAmount').is(':checked') ? parseFloat($('#MaxApprovedAmount').val()) || null : null,
            eventFrom: $('#toggleDateRange').is(':checked') ? $('#EventFrom').val() || null : null,
            eventTo: $('#toggleDateRange').is(':checked') ? $('#EventTo').val() || null : null,
            createdFromUtc: $('#toggleDateRange').is(':checked') ? $('#CreatedFromUtc').val() || null : null,
            createdToUtc: $('#toggleDateRange').is(':checked') ? $('#CreatedToUtc').val() || null : null,
            includeDeleted: $('#toggleDeleted').is(':checked') ? $('#IncludeDeleted').is(':checked') : true
        };

        return filters;
    }

    function bindFilterToggles() {
        $('#toggleClaimType').change(function () {
            $('#claimTypeSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterClaimType').val(null).trigger('change');
        });

        $('#toggleStatus').change(function () {
            $('#statusSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterStatus').val(null).trigger('change');
        });

        $('#toggleIsPosted').change(function () {
            $('#isPostedSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#filterIsPosted').val(null).trigger('change');
        });

        $('#toggleAmount').change(function () {
            $('#amountSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) {
                $('#MinApprovedAmount').val('');
                $('#MaxApprovedAmount').val('');
            }
        });

        $('#toggleDateRange').change(function () {
            $('#dateRangeSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) {
                $('#EventFrom').val('');
                $('#EventTo').val('');
                $('#CreatedFromUtc').val('');
                $('#CreatedToUtc').val('');
            }
        });

        $('#toggleDeleted').change(function () {
            $('#deletedSection').collapse(this.checked ? 'show' : 'hide');
            if (!this.checked) $('#IncludeDeleted').prop('checked', true);
        });
    }

