                    type: 'POST',
                    data: { id: claimId },
                    success: function(response) {
                        if (response.success) {
                            appalert(response.message, 1, 1);
                            if (response.reload && ClaimsTable) {
                                ClaimsTable.ajax.reload();
                            }
                        } else {
                            appalert(response.message, 4, 1);
                        }
                    },
                    error: function() {
                        appalert('Error deleting claim', 4, 1);
                    }
                });
            },
            function() {
                // Cancel action
            }
        );
    });

    // ============================
    // INITIALIZATION
    // ============================
    $(document).ready(function () {
        // Initialize all static Select2 elements with modal as parent
        if ($.fn.select2) {
            $('.select2').each(function () {
                initializeSelect2(this);
            });
        }

        // Bind filter toggles
        bindFilterToggles();

        // Bind event handlers
        $('#applyFilterBtn').click(function (e) {
            e.preventDefault();
            loadClaimsData();
        });

        $('#resetFilterBtn').click(function (e) {
            e.preventDefault();
            resetFilters();
        });

        $('#exportExcelBtn').click(function (e) {
            e.preventDefault();
            if (!ClaimsTable || currentTableData.length === 0) {
                appalert('Please load data first by applying filters', 3, 1);
                return;
            }
            showExportModal();
        });

        // Bind table row events globally
        bindTableRowEvents();

        // Bind total amount input
        $(document).on('input', '#totalAmount', function () {
            var enteredTotal = parseFloat($(this).val()) || 0;
            if (enteredTotal === 0) {
                resetAllTotals();
                return;
            }

            $('.source-amount').val('');
            $('.member-amount').val('');
            $('.branch-amount').val('');

            $('#displayTotalAmount').text(formatCurrency(enteredTotal));
            updateAllTotals();
        });

        // Initialize amount validation
        preventOverEntry();

        // Bind the export confirm button click event
        $(document).on('click', '#btnConfirmExport', function (e) {
            e.preventDefault();
            exportData();
        });

        // ============================================
        // ZOOM MONITORING
        // ============================================
        var lastZoom = detectZoom();
        setInterval(function () {
            var currentZoom = detectZoom();
            if (Math.abs(currentZoom - lastZoom) > 0.05) {
                lastZoom = currentZoom;
                repositionOpenDropdowns();
            }
        }, 500);

        var resizeTimer;
        $(window).on('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                repositionOpenDropdowns();
            }, 250);
        });
    });

    // ============================
    // EXPORT FUNCTIONALITY
    // ============================
    function showExportModal() {
        if (!ClaimsTable || currentTableData.length === 0) {
            appalert('Please load the table data first by applying filters', 3, 1);
            return;
        }

        $('#exportModal').modal('show');
    }

    function exportData() {
        var exportFormat = $('#exportFormat').val();
        var reportType = $('#reportType').val();
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        var fileName = $('#fileName').val() || 'IPS_Claims_Report';
        var includeSummary = $('#includeSummary').is(':checked');

        var exportRequest = {
            ExportFormat: exportFormat,
            ReportType: reportType,
            StartDate: startDate,
            EndDate: endDate,
            FileName: fileName,
            IncludeSummary: includeSummary,
            Data: currentTableData
        };

        $('#exportProgress').removeClass('d-none');
        $('#progressText').text('Preparing export...');
        $('.progress-bar').css('width', '30%');

        $.ajax({
            url: '@Url.Action("ExportClaimsData", "IPSClaim")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(exportRequest),
            xhrFields: {
                responseType: 'blob'
            },
            beforeSend: function() {
                $('.progress-bar').css('width', '60%');
                $('#progressText').text('Generating export file...');
            },
            success: function(data, status, xhr) {
                $('.progress-bar').css('width', '100%');
                $('#progressText').text('Export complete! Downloading...');

                var blob = new Blob([data], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);

                var disposition = xhr.getResponseHeader('Content-Disposition');
                var filename = fileName + '.xlsx';
                if (disposition && disposition.indexOf('attachment') !== -1) {
                    var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    var matches = filenameRegex.exec(disposition);
                    if (matches != null && matches[1]) {
                        filename = matches[1].replace(/['"]/g, '');
                    }
                }

                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(function() {
                    $('#exportModal').modal('hide');
                    $('#exportProgress').addClass('d-none');
                    $('.progress-bar').css('width', '0%');
                }, 1000);
            },
            error: function(xhr, status, error) {
                console.error('Export error:', error);
                appalert('Error exporting data: ' + error, 4, 1);
                $('#exportProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
            }
        });
    }
    </script>
    }
}

