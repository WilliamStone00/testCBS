@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSClaim

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4">
                <!-- Modal Header -->
                <div class="card bg-light mb-4 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="modal-title">
                            <i class="mdi mdi-cog-outline me-2"></i>
                            <span id="actionModalTitle">Process Claim</span>
                        </h5>
                        <div class="alert alert-info mt-3 py-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            <span id="actionModalDescription">Approve, reject or post insurance claims using this form.</span>
                        </div>
                        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
                    </div>
                </div>

                <!-- Claim Info Section -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-body py-3">
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Claim ID</label>
                                <p class="fw-bold text-dark mb-0" id="actionClaimId">-</p>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Member ID</label>
                                <p class="fw-bold text-dark mb-0" id="actionMemberId">-</p>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Branch</label>
                                <p class="fw-bold text-dark mb-0" id="actionBranch">-</p>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Claim Type</label>
                                <p class="fw-bold text-dark mb-0" id="actionClaimType">-</p>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Approved Amount</label>
                                <p class="fw-bold text-dark mb-0" id="actionApprovedAmount">-</p>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Current Status</label>
                                <p class="fw-bold mb-0">
                                    <span id="actionCurrentStatus" class="badge bg-warning">-</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Form -->
                <form id="actionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="actionType" name="actionType" value="">
                    <input type="hidden" id="hiddenClaimId" name="claimId" value="">
                    <input type="hidden" id="hiddenMemberId" name="memberId" value="">
                    <input type="hidden" id="hiddenBranchId" name="branchId" value="">

                    <!-- Amount Section (for Approve only) -->
                    <div class="mb-3" id="approveAmountSection" style="display: none;">
                        <label for="actionAmount" class="form-label fw-bold text-dark">
                            <i class="mdi mdi-cash-multiple me-1"></i>
                            Approved Amount
                            <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="actionAmount" name="amount" class="form-control"
                               step="0.01" min="0.01" placeholder="0.00">
                        <div class="form-text text-muted">
                            <small>
                                <i class="mdi mdi-information-outline me-1"></i>
                                Enter the amount to approve for this claim.
                            </small>
                        </div>
                    </div>

                    <!-- Post Details Section (for Post only) -->
                    <div id="postDetailsSection" style="display: none;">
                        <!-- Customer Info Section -->
                        <div class="card mb-3 border-primary">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <span><i class="mdi mdi-account me-1"></i> Customer Information</span>
                                <button type="button" class="btn btn-light btn-sm" id="refreshCustomerBtn">
                                    <i class="mdi mdi-refresh"></i> Refresh
                                </button>
                            </div>
                            <div class="card-body" id="customerInfoSection">
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading customer data...</span>
                                    </div>
                                    <p class="mt-2 text-muted">Loading customer information...</p>
                                </div>
                            </div>
                        </div>

                        <!-- Total Amount Section -->
                        <div class="card mb-3 border-success">
                            <div class="card-header bg-success text-white">
                                <i class="mdi mdi-cash-multiple me-1"></i> Total Claim Amount
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="totalAmount" class="form-label fw-bold text-dark">
                                            Total Amount to Process
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" id="totalAmount" name="totalAmount" class="form-control"
                                               step="0.01" min="0.01" placeholder="0.00" required>
                                        <div class="form-text text-muted">
                                            <small>
                                                <i class="mdi mdi-information-outline me-1"></i>
                                                Enter the total amount for this claim posting. This must match the sum of all entries below.
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mt-4 pt-2">
                                            <div class="alert alert-light border">
                                                <div class="d-flex justify-content-between">
                                                    <span class="fw-bold">Combined Total:</span>
                                                    <span id="combinedTotalDisplay" class="fw-bold text-success">0.00</span>
                                                </div>
                                                <div class="d-flex justify-content-between mt-1">
                                                    <span>Validation:</span>
                                                    <span id="amountValidation" class="badge bg-warning">Not Calculated</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Source Accounts Section -->
                        <div class="card mb-3 border-info">
                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                <span><i class="mdi mdi-bank-transfer me-1"></i> Source Account Entries</span>
                                <button type="button" class="btn btn-light btn-sm" id="addSourceRowBtn">
                                    <i class="mdi mdi-plus"></i> Add Row
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered" id="SourceAccountEntryListing">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Source GL Account</th>
                                                <th>Amount</th>
                                                <th>Description</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <select class="form-select source-gl-account">
                                                        <option value="">-- Select Source GL --</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control source-amount" />
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control source-narration" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                
                                </div>
                            </div>
                        </div>

                        <!-- Member Balance Destination Section -->
                        <div class="card mb-3 border-warning">
                            <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center">
                                <span><i class="mdi mdi-account-cash me-1"></i> Member Balance Distribution</span>
                                <span class="badge bg-light text-dark" id="memberAccountsCount">0 accounts</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0" id="memberAccountsTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="30%">Account</th>
                                                <th width="15%">Type</th>
                                                <th width="20%">Amount</th>
                                                <th width="25%">Description</th>
                                                <th width="10%" class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="memberAccountsTableBody">
                                            <!-- Rows will be populated from customer data -->
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="2" class="text-end fw-bold">Member Total:</td>
                                                <td id="memberTotalAmount" class="fw-bold text-success">0.00</td>
                                                <td colspan="2"></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Branch Destination Section -->
                        <div class="card mb-3 border-danger">
                            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                                <span><i class="mdi mdi-bank me-1"></i> Branch Account Distribution</span>
                                <button type="button" class="btn btn-light btn-sm" id="addBranchRowBtn">
                                    <i class="mdi mdi-plus"></i> Add Row
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered" id="DestinationBranchEntryListing">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Destination Branch Account</th>
                                                <th>Amount</th>
                                                <th>Narration</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <select class="form-select destination-branch-account">
                                                        <option value="">-- Select Destination Branch --</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control destination-amount" />
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control destination-narration" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>

                        <!-- Validation Summary -->
                        <div class="card mb-3 border-secondary">
                            <div class="card-header bg-secondary text-white">
                                <i class="mdi mdi-check-all me-1"></i> Validation Summary
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fw-bold">Source Total:</span>
                                                <span id="validationSourceTotal" class="fw-bold">0.00</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fw-bold">Member Total:</span>
                                                <span id="validationMemberTotal" class="fw-bold">0.00</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fw-bold">Branch Total:</span>
                                                <span id="validationBranchTotal" class="fw-bold">0.00</span>
                                            </div>
                                            <hr>
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-bold">Combined Total:</span>
                                                <span id="validationCombinedTotal" class="fw-bold text-primary">0.00</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-3">
                                                <span class="fw-bold">Entered Total:</span>
                                                <span id="validationEnteredTotal" class="fw-bold">0.00</span>
                                            </div>
                                            <hr>
                                            <div class="text-center">
                                                <div class="mb-2">
                                                    <span id="validationStatus" class="badge bg-warning fs-6">Not Validated</span>
                                                </div>
                                                <div>
                                                    <span id="validationMessage" class="small text-muted">Enter total amount first</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Common Note Section -->
                    <div class="mb-3">
                        <label for="actionNote" class="form-label fw-bold text-dark">
                            <i class="mdi mdi-text-box-edit-outline me-1"></i>
                            <span id="actionNoteLabel">Comments / Reason</span>
                            <span class="text-danger">*</span>
                        </label>
                        <textarea id="actionNote" name="note" class="form-control" rows="3"
                                  placeholder="Please provide detailed comments or reason for this action..."
                                  required minlength="10"></textarea>
                        <div class="form-text text-muted">
                            <small>
                                <i class="mdi mdi-information-outline me-1"></i>
                                Required field. Minimum 10 characters.
                            </small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="actionSubmitBtn">
                    <i class="mdi mdi-check-circle-outline me-1"></i>
                    <span id="submitButtonText">Submit</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmPostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="mdi mdi-check-circle-outline me-2"></i>
                    Confirm Posting
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Please review the posting details before confirming.
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Transaction Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <span class="text-muted">Claim ID:</span>
                                    <span id="confirmClaimId" class="fw-bold ms-2">-</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted">Member ID:</span>
                                    <span id="confirmMemberId" class="fw-bold ms-2">-</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted">Total Amount:</span>
                                    <span id="confirmTotalAmount" class="fw-bold ms-2">0.00</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <span class="text-muted">Accounting Date:</span>
                                    <span id="confirmAccountingDate" class="fw-bold ms-2">-</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted">External App:</span>
                                    <span id="confirmExternalApp" class="fw-bold ms-2">-</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted">Force Repost:</span>
                                    <span id="confirmForceRepost" class="fw-bold ms-2">No</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Account Entries Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm" id="confirmSummaryTable">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Account</th>
                                        <th class="text-end">Amount</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Will be populated by JavaScript -->
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="2" class="text-end fw-bold">Total:</td>
                                        <td id="confirmEntriesTotal" class="text-end fw-bold text-success">0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="confirmPostBtn">
                    <i class="mdi mdi-check me-1"></i> Confirm & Post
                </button>
            </div>
        </div>
    </div>
</div>