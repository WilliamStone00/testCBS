@using Resources

<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-table"></i> @GlobalIPSClaim.IPS_Claims_Listing
    </h5>

    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Created_Date</th>
                    <th>@GlobalShared.Claim_Type</th>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.Claimed_Amount</th>
                    <th>@GlobalShared.Beneficiary</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>