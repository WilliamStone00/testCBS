@{
    ViewBag.Title = "Moral Person Account Creation";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i> Moral Person (Group) Account Creation
                </h1>
                <p class="card-text text-muted">
                    Create a new Group or Moral Person account. Ensure all required fields (group type, registration, identification, and address) are filled correctly.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Help Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Enter group basic information (Group type, Name, Registration No, etc.).</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Provide accurate address details (Country, Region, Division, Sub-Division, Town).</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure the Date of Establishment and Identification Document Details are valid.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Properly select the Economic Activity and Customer Category for the Group.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Attach valid contact details (Phone, Email, PO Box if available).</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> Click <strong>Save</strong> after completing all required sections to register the Group.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row mb-1">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <!-- Moral Person Profile Form -->
            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account-group me-2"></i> Group / Moral Person Identification Form
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div id="datalistingview">
                                    @Html.Partial("_Create") <!-- 🎯 Load the Group _Create Partial Form -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Log version check
            console.log("📦 Cascading Location Dropdowns Initialized");

            $('#CountryId').on('change', function () {
                const countryId = $(this).val();
                console.log("🌍 Country selected:", countryId);
                resetDropdowns(['#RegionId', '#DivisionId', '#SubDivisionId', '#TownId']);

                if (!countryId) return;

                $('#RegionId').append('<option>Loading...</option>');

                $.getJSON('/Individual/GetRegionsByCountry', { countryId: countryId })
                    .done(function (data) {
                        populateDropdown('#RegionId', data, '---Select Region---');
                    })
                    .fail(function (xhr, status, error) {
                        console.error("❌ Error loading regions:", error);
                        populateDropdown('#RegionId', [], 'Error loading regions');
                    });
            });

            $('#RegionId').on('change', function () {
                const regionId = $(this).val();
                console.log("📍 Region selected:", regionId);
                resetDropdowns(['#DivisionId', '#SubDivisionId', '#TownId']);

                if (!regionId) return;

                $('#DivisionId').append('<option>Loading...</option>');

                $.getJSON('/Individual/GetDivisionsByRegion', { regionId: regionId })
                    .done(function (data) {
                        populateDropdown('#DivisionId', data, '---Select Division---');
                    })
                    .fail(function (xhr, status, error) {
                        console.error("❌ Error loading divisions:", error);
                        populateDropdown('#DivisionId', [], 'Error loading divisions');
                    });
            });

            $('#DivisionId').on('change', function () {
                const divisionId = $(this).val();
                console.log("🏛 Division selected:", divisionId);
                resetDropdowns(['#SubDivisionId', '#TownId']);

                if (!divisionId) return;

                $('#SubDivisionId').append('<option>Loading...</option>');

                $.getJSON('/Individual/GetSubDivisionsByDivision', { divisionId: divisionId })
                    .done(function (data) {
                        populateDropdown('#SubDivisionId', data, '---Select Sub-Division---');
                    })
                    .fail(function (xhr, status, error) {
                        console.error("❌ Error loading sub-divisions:", error);
                        populateDropdown('#SubDivisionId', [], 'Error loading sub-divisions');
                    });
            });

            $('#SubDivisionId').on('change', function () {
                const subDivisionId = $(this).val();
                console.log("🏘 Sub-Division selected:", subDivisionId);
                resetDropdowns(['#TownId']);

                if (!subDivisionId) return;

                $('#TownId').append('<option>Loading...</option>');

                $.getJSON('/Individual/GetTownsBySubDivision', { subDivisionId: subDivisionId })
                    .done(function (data) {
                        populateDropdown('#TownId', data, '---Select Town---');
                    })
                    .fail(function (xhr, status, error) {
                        console.error("❌ Error loading towns:", error);
                        populateDropdown('#TownId', [], 'Error loading towns');
                    });
            });

            function populateDropdown(selector, data, placeholder) {
                const dropdown = $(selector);
                dropdown.empty().append($('<option>').val('').text(placeholder));

                $.each(data, function (i, item) {
                    dropdown.append($('<option>').val(item.Id).text(item.Name));
                });

                // If you're using select2
                if (dropdown.hasClass('select2')) {
                    dropdown.trigger('change.select2');
                }
            }

            function resetDropdowns(selectors) {
                selectors.forEach(id => {
                    $(id).empty().append('<option value="">---Select---</option>');
                    if ($(id).hasClass('select2')) {
                        $(id).trigger('change.select2');
                    }
                });
            }
        });

    </script>
    <script src="~/Scripts/Js/Crud/Groups/Groups.js"></script>
}
