@model CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.GroupManagement
<div id="loan_file_attached">
    @if (!Model.GroupCustomers.Any())
    {
        <div class="text-center my-3">
            <p>No member is added to @Model.Group.GroupName group</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <div class="col-12 col-lg-12 mb-4 mb-xl-0">
                <div class="demo-inline-spacing mt-3">
                    <div class="list-group">
                        @for (var i = 0; i < Model.GroupCustomers.Count; i++)
                        {
                            var file = Model.GroupCustomers[i];
                            <div class="list-group-item list-group-item-action d-flex align-items-center cursor-pointer">
                                <div class="w-100">
                                    <div class="d-flex justify-content-between">
                                        <div class="user-info">
                                            @if (Model.Customer.CustomerId == file.CustomerId)
                                            {
                                                <h6 class="mb-1">
                                                    @(i + 1). @file.Customer.FirstName @file.Customer.LastName
                                                    <span class="badge rounded-pill bg-primary">Group Leader</span>
                                                </h6>
                                            }
                                            else
                                            {
                                                <h6 class="mb-1">
                                                    @(i + 1). @file.Customer.FirstName @file.Customer.LastName
                                                    <span class="badge rounded-pill bg-secondary">Member</span>
                                                </h6>
                                            }
                                        </div>
                                        <div class="file-actions">
                                            <a href="#" target="_blank" class="btn btn-sm btn-primary">Details</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

</div>
