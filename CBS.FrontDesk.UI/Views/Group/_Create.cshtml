@model CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.Group
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "Group", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Profile
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <fieldset class="fieldset-custom">
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.GroupTypeId, new SelectList(ViewBag.GroupTypes, "GroupTypeId", "GroupTypeName"), "---Select Group type---", new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(m => m.GroupTypeId, "", new { @class = "text-danger" })
                                            <label>Select group type</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.CustomerId, new { @class = "form-control", @placeholder = "1234" })
                                            @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                                            <label>Group Reference Number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.GroupName, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.GroupName, "", new { @class = "text-danger" })
                                            <label>Group type name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.RegistrationNumber, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.RegistrationNumber, "", new { @class = "text-danger" })
                                            <label>Registration number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.TaxPayerNumber, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.TaxPayerNumber, "", new { @class = "text-danger" })
                                            <label>Tax payer number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.DateOfEstablishment, new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(m => m.DateOfEstablishment, "", new { @class = "text-danger" })
                                            <label>Date of establishment</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                            <label>Phone</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.IDNumber, "", new { @class = "text-danger" })
                                            <label>National id card</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumberIssueDate, new { @class = "form-control", @type = "date" })
                                            @Html.ValidationMessageFor(m => m.IDNumberIssueDate, "", new { @class = "text-danger" })
                                            <label>Date issued</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumberIssueAt, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.IDNumberIssueAt, "", new { @class = "text-danger" })
                                            <label>Place of issue</label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>


                        </div>
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        Address
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <fieldset class="fieldset-custom">
                                <div class="row mt-4">
                                    <div class="col-md-12 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.CountryId, new SelectList(ViewBag.Countries, "Id", "Name"), "---Select Country---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.CountryId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Country</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.RegionId, new SelectList(ViewBag.Regions, "Id", "Name"), "---Select Region---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.RegionId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Region</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.DivisionId, new SelectList(ViewBag.Divisions, "Id", "Name"), "---Select Division---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.DivisionId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Division</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SubDivisionId, new SelectList(ViewBag.SubDivisions, "Id", "Name"), "---Select Sub-Division---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SubDivisionId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Sub-Division</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.TownId, new SelectList(ViewBag.Towns, "Id", "Name"), "---Select Town---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.TownId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Town</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            <label>Email</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Fax, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.Fax, "", new { @class = "text-danger" })
                                            <label>Fax number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.POBox, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.POBox, "", new { @class = "text-danger" })
                                            <label>Post box number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control"})
                                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                            <label>Address</label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                        </div>
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod5">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod5"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod5">
                        Activities
                    </button>
                </h2>
                <div id="collapsePaymentMethod5"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod5"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <fieldset class="fieldset-custom">
                                <div class="row mt-4">
                                    <div class="col-md-6 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.EconomicActivitiesId, new SelectList(ViewBag.EconomicActivities, "Id", "Name"), "---Select Economic activity---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.EconomicActivitiesId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Econimic activity</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Occupation, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Occupation, "", new { @class = "text-danger" })
                                            <label>Occumation</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.CustomerCategoryId, new SelectList(ViewBag.Categories, "Value", "Text"), "---Select customer category---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.CustomerCategoryId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Select customer category</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.FormalOrInformalSector, new SelectList(ViewBag.formalOrInformalSectors, "Text", "Value"), "---Select sector---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.FormalOrInformalSector, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Sector</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mt-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Income, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Income, "", new { @class = "text-danger" })
                                            <label>Capital</label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                        </div>
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod6">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod6"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod6">
                        Data commit
                    </button>
                </h2>
                <div id="collapsePaymentMethod6"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod6"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div class="mt-4">
                                @if (Model.GroupId == null)
                                {
                                    <button type="submit" class="btn btn-primary me-2">Save</button>
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                }
                                else
                                { 
                                    @*<button type="submit" class="btn btn-primary me-2">Update</button>*@
                                    @Html.HiddenFor(m => m.GroupId)
                                    <input type="hidden" name="Action" value="update" id="Action" />
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>


       
    }
</div>

