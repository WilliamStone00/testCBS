@model CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.Group
@using Resources
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "Group", FormMethod.Post, new { enctype = "multipart/form-data", id = "memberForm", onsubmit = "return AjaxPostAndUpdateGroupRegistration(this);" }))
    {
        <div class="accordion" id="collapsibleSection">

            <!-- Profile Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingProfile">
                    <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseProfile" aria-expanded="true" aria-controls="collapseProfile">
                        @GlobalGroup.GroupMoralPersonProfile
                    </button>
                </h2>
                <div id="collapseProfile" class="accordion-collapse collapse show" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.GroupTypeId, new SelectList(ViewBag.GroupTypes, "GroupTypeId", "GroupTypeName"), "---"+ GlobalShared.Select_Group_Type +"---", new { @class = "form-control select2" })
                                        @Html.ValidationMessageFor(m => m.GroupTypeId, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.Select_Group_Type</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.CustomerId, new { @class = "form-control", placeholder = @GlobalGroup.GroupReference })
                                        @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.GroupReference No.</label>
                                    </div>
                                </div>

                                <div class="col-md-9">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.GroupName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.GroupName, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.GroupMoralPersonName</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.CustomerType, new List<SelectListItem>
                                        {
                                            new SelectListItem { Value = "MemberAccount", Text = "Normal Member Group Account", Selected = true }, // 🟰 Selected by default
                                            new SelectListItem { Value = "CivilServantsSalaryCollection", Text = "Civil Servant Salary Collective Group Account" },
                                            new SelectListItem { Value = "PrivateInstitutionSalaryCollection", Text = "Private Institution Salary Collective Group Account" }
                                        }, "---"+ @GlobalGroup.SelectMemberAccountType +"---", new { @class = "form-select shadow-input-boxes" })
                                        @Html.ValidationMessageFor(m => m.CustomerType, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.SelectMemberAccountType</label>
                                    </div>
                                </div>


                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.RegistrationNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.RegistrationNumber, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.RegistrationNumber</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.TaxPayerNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.TaxPayerNumber, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.TaxpayerNumber</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DateOfEstablishment, new { @class = "form-control", type = "date" })
                                        @Html.ValidationMessageFor(m => m.DateOfEstablishment, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.DateOfEstablishment</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.Phone_Number</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.IDNumber, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.National_ID_Number</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.IDNumberIssueDate, new { @class = "form-control", type = "date" })
                                        @Html.ValidationMessageFor(m => m.IDNumberIssueDate, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.IDIssueDate</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.IDNumberIssueAt, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.IDNumberIssueAt, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.PlaceOfIssue</label>
                                    </div>
                                </div>

                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <!-- Address Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingAddress">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapseAddress" aria-expanded="false" aria-controls="collapseAddress">
                        @GlobalGroup.GroupAddress
                    </button>
                </h2>
                <div id="collapseAddress" class="accordion-collapse collapse" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.CountryId,
                                            new SelectList(ViewBag.Countries, "Id", "Name"),
                                            "---"+ GlobalShared.Select_Country+"---",
                                            new { @class = "form-control select2", @id = "CountryId", @required = "required" })
                                        @Html.ValidationMessageFor(m => m.CountryId, "", new { @class = "text-danger" })
                                        <label for="CountryId">@GlobalShared.Country</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.RegionId,
                                            new SelectList(ViewBag.Regions, "Id", "Name"),
                                            "---"+ GlobalShared.Select_Region+"---",
                                            new { @class = "form-control select2", @id = "RegionId", @required = "required" })
                                        @Html.ValidationMessageFor(m => m.RegionId, "", new { @class = "text-danger" })
                                        <label for="RegionId">@GlobalShared.Region</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.DivisionId,
                                            new SelectList(ViewBag.Divisions, "Id", "Name"),
                                            "---"+ GlobalShared.Select_Division+"---",
                                            new { @class = "form-control select2", @id = "DivisionId", @required = "required" })
                                        @Html.ValidationMessageFor(m => m.DivisionId, "", new { @class = "text-danger" })
                                        <label for="DivisionId">@GlobalShared.Division</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.SubDivisionId,
                                            new SelectList(ViewBag.SubDivisions, "Id", "Name"),
                                            "---"+ GlobalShared.Select_Sub_Division+"---",
                                            new { @class = "form-control select2", @id = "SubDivisionId", @required = "required" })
                                        @Html.ValidationMessageFor(m => m.SubDivisionId, "", new { @class = "text-danger" })
                                        <label for="SubDivisionId">@GlobalShared.SubDivision</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.TownId,
                                            new SelectList(ViewBag.Towns, "Id", "Name"),
                                            "---"+ GlobalShared.Select_Town +"---",
                                            new { @class = "form-control select2", @id = "TownId", @required = "required" })
                                        @Html.ValidationMessageFor(m => m.TownId, "", new { @class = "text-danger" })
                                        <label for="TownId">@GlobalShared.Town</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.Email</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Fax, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Fax, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.FaxNumber</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.POBox, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.POBox, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.PostBox</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.DetailedAddress</label>
                                    </div>
                                </div>

                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <!-- Activities Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingActivities">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapseActivities" aria-expanded="false" aria-controls="collapseActivities">
                        @GlobalGroup.EconomicActivities
                    </button>
                </h2>
                <div id="collapseActivities" class="accordion-collapse collapse" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.EconomicActivitiesId, new SelectList(ViewBag.EconomicActivities, "Id", "Name"), "---"+ @GlobalGroup.SelectEconomicActivity +"---", new { @class = "form-control select2" })
                                        @Html.ValidationMessageFor(m => m.EconomicActivitiesId, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.EconomicActivity</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Occupation, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Occupation, "", new { @class = "text-danger" })
                                        <label>@GlobalShared.Occupation</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.CustomerCategoryId, new SelectList(ViewBag.Categories, "Value", "Text"), "---"+ @GlobalGroup.SelectCustomerCategory +"---", new { @class = "form-control select2" })
                                        @Html.ValidationMessageFor(m => m.CustomerCategoryId, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.CustomerCategory</label>
                                    </div>
                                </div>

                                <div class="col-md-9">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.FormalOrInformalSector, new SelectList(ViewBag.formalOrInformalSectors, "Text", "Value"), "---"+ GlobalShared.Select_Sector +"---", new { @class = "form-control select2" })
                                        @Html.ValidationMessageFor(m => m.FormalOrInformalSector, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.FormalInformalSector</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.Income, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Income, "", new { @class = "text-danger" })
                                        <label>@GlobalGroup.CapitalAmount</label>
                                    </div>
                                </div>

                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <!-- Save Button -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingCommit">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapseCommit" aria-expanded="false" aria-controls="collapseCommit">
                        @GlobalGroup.SaveGroupInformation
                    </button>
                </h2>
                <div id="collapseCommit" class="accordion-collapse collapse" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="text-center mt-4">
                            @if (Model.GroupId == null)
                            {
                                <button type="submit" class="btn btn-primary">@GlobalGroup.SaveNewGroup</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                            }
                            else
                            {
                                @Html.HiddenFor(m => m.GroupId)
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <button type="submit" class="btn btn-primary">@GlobalGroup.UpdateGroup</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>
