@model CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.GroupManagement
     @using Resources

@using (Html.BeginForm("Update", "Group", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <div class="row g-4">
        <fieldset class="fieldset-custom">
            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.Group.GroupTypeId, new SelectList(ViewBag.GroupTypes, "GroupTypeId", "GroupTypeName"), "--- @*@GlobalGroup.*@SelectGroupType + ---", new { @class = "form-control select2" })
                        @Html.ValidationMessageFor(m => m.Group.GroupTypeId, "", new { @class = "text-danger" })
                        <label>@*@GlobalGroup.*@ SelectGroupType</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Group.GroupName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Group.GroupName, "", new { @class = "text-danger" })
                        <label>@GlobalGroup.GroupTypeName</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Group.RegistrationNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Group.RegistrationNumber, "", new { @class = "text-danger" })
                        <label>@GlobalGroup.RegistrationNumber</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Group.TaxPayerNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Group.TaxPayerNumber, "", new { @class = "text-danger" })
                        <label>@GlobalGroup.TaxpayerNumber</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Group.Active, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@*@GlobalGroup.*@ ActiveStatus</label>
                    </div>
                </div>


                

                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.Group.CustomerStatus,
                            ViewBag.MemberStatuses as List<SelectListItem>,
                            "--- Select Member Status ---",
                            new { @class = "form-control select2", required = "required" })
                        @Html.ValidationMessageFor(m => m.Group.CustomerStatus, "", new { @class = "text-danger" })
                        <label>Select Member Status</label>
                    </div>
                </div>

                <!-- Politically Exposed Checkbox -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check mt-3">
                        @Html.CheckBoxFor(model => model.Group.IsPoliticaExposed,
                            new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.Group.IsPoliticaExposed,
                            "Select Exposed Status",
                            new { @class = "form-check-label ms-2" })
                    </div>
                </div>
                <div id="pepDetails" class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Group.PoliticaExposedQuestion,
                                ViewBag.politicalstatuses as List<SelectListItem>,
                                "--- Select  status ---",
                                new { @class = "form-control select2" })

                            @Html.ValidationMessageFor(m => m.Group.PoliticaExposedQuestion, "", new { @class = "text-danger" })
                            <label>Polictical question</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Group.PoliticaExposedAnswer, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Group.PoliticaExposedAnswer, "", new { @class = "text-danger" })
                            <label>Political Response</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                @Html.HiddenFor(m => m.Group.GroupId)
                <input type="hidden" name="Option" value="groupprofile" id="Option" />
            </div>
        </fieldset>
    </div>
}

