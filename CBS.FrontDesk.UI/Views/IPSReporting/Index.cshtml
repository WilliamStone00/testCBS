@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.IPSReporting.InsurancePremiumDto

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-chart-areaspline me-2"></i>IPS Insurance Premium Reporting
                </h1>
                <p class="card-text">
                    Generate and analyze insurance premium reports for Loan Protection (LP) and Life Savings (LS) across branches.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Select branch, date range, and report type to generate comprehensive insurance premium reports.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePremiumTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapsePremiumTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-range text-info me-2"></i>
                            <strong>Reporting Period:</strong> Default dates are set to Jan 1 (current year) to current date. Adjust as needed for historical reports.
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-bank text-success me-2"></i>
                            <strong>Branch Selection:</strong> Select a specific branch for branch-level reports or leave empty for consolidated institution-wide report.
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-file-pdf-box text-danger me-2"></i>
                            <strong>Print Options:</strong>
                            <span class="badge bg-danger ms-1">PDF</span> Recommended for Insurance Premium reports (only option available)
                            <span class="badge bg-success ms-2">Excel</span> Available for other report types
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-chart-pie text-warning me-2"></i>
                            <strong>Report Components:</strong> Includes Loan Protection (LP) and Life Savings (LS) calculations with detailed deduction breakdowns.
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="mdi mdi-calculator text-primary me-2"></i>
                            <strong>Premium Calculation:</strong>
                            <ul class="mt-1 ms-4">
                                <li>LP Premium = (Insurable Loans × LP Rate) - Deductions</li>
                                <li>LS Premium = (Insurable Savings × LS Rate) - Deductions</li>
                            </ul>
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-close-octagon text-danger me-2"></i>
                            <strong>Deductions Include:</strong> Excess balances, age threshold exceedances, organizational loans, and other specified deductions.
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-file-document-multiple text-secondary me-2"></i>
                            <strong>Report Sections:</strong> Front side (gross amounts) and reverse side (deductions) for both LP and LS.
                        </li>
                        <li class="mb-2">
                            <i class="mdi mdi-clock-outline text-muted me-2"></i>
                            <strong>Generation Time:</strong> Reports are generated in real-time; large datasets may take a few moments to process.
                        </li>
                    </ul>
                </div>
            </div>
            <div class="alert alert-warning mt-2 mb-0 py-2">
                <i class="mdi mdi-alert-circle-outline me-1"></i>
                <strong>Note:</strong> Ensure the IPS configuration (rates, maximum amounts, age limits) is properly set up before generating premium reports.
            </div>
        </div>
    </div>
</div>

<div class="card mb-1">
    <div class="modal-body">
        @using (Html.BeginForm("GenerateReport", "IPSReporting", FormMethod.Post, new { id = "reportForm", onsubmit = "return AjaxPostAndUpdate2(this);" }))
        {
            @Html.AntiForgeryToken()

            <div class="row gy-3">
                <!-- Header Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-file-chart-outline me-1"></i> Insurance Premium Report
                    </h6>
                </div>

                <!-- Branch Dropdown - Full Width -->
                <div class="col-md-12">
                    <label>Branch</label>
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches, "Id", "name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })

                    </div>
                </div>

                <!-- Report Type - col-6 -->

                <div class="col-md-6">
                    <label>Report Type</label>
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.ReportType,
                            new SelectList(ViewBag.ReportType, "Value", "Text"),
                            "--- Select Report Type ---",
                            new { @class = "form-control select2" })
                        @Html.ValidationMessageFor(m => m.ReportType, "", new { @class = "text-danger" })

                    </div>
                </div>

                <!-- Print Option - col-6 -->
                <div class="col-md-6">
                    <label>Print Option</label>
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.PrintOption,
                             new SelectList(ViewBag.PrintType, "Value", "Text"),
                               "--- Select Print Option ---",
                               new { @class = "form-control select2", id = "PrintOption" })
                        @Html.ValidationMessageFor(m => m.PrintOption, "", new { @class = "text-danger" })

                    </div>
                </div>

                <!-- Start Date - col-6 -->
                <div class="col-md-6">
                    <label>Start Date</label>
                    <div class="form-floating shadow-sm">
                        @Html.TextBox(
                            "StartDate",
                            new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"),
                            new
                            {
                                @class = "form-control",
                                type = "date",
                                id = "StartDate",
                                max = DateTime.Now.ToString("yyyy-MM-dd")
                            })
                    </div>
                </div>

                <!-- End Date -->
                <div class="col-md-6">
                    <label>End Date</label>
                    <div class="form-floating shadow-sm">
                        @Html.TextBox(
                            "EndDate",
                            DateTime.Now.ToString("yyyy-MM-dd"),
                            new
                            {
                                @class = "form-control",
                                type = "date",
                                id = "EndDate",
                                max = DateTime.Now.ToString("yyyy-MM-dd")
                            })
                    </div>
                </div>


                <!-- Submit Button -->
                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary shadow-sm px-4" id="btnGenerate">
                        <i class="fas fa-file-export me-1"></i> Generate Report
                    </button>
                    <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                        Reset
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {

           

            /* ==========================================
               SET MAX DATE (END DATE CANNOT BE FUTURE)
            ========================================== */
            var today = new Date().toISOString().split('T')[0];
            $('#EndDate').attr('max', today);

            /* ==========================================
               REPORT TYPE CHANGE LOGIC
            ========================================== */
            $('#ReportType').change(function () {

                var reportType = $(this).val();
                var printOption = $('#PrintOption');

                if (reportType === 'InsurancePremium') {
                    printOption.val('PDF').trigger('change');
                    printOption.prop('disabled', true);
                } else {
                    printOption.prop('disabled', false);
                }
            });

            // Trigger on load
            $('#ReportType').trigger('change');

        });


        /* ==========================================
           UNIVERSAL AJAX SUBMIT FUNCTION
        ========================================== */
        function AjaxPostAndUpdate2(form) {

            var $form = $(form);
            var $submitBtn = $form.find('button[type="submit"]');
            var originalBtnHtml = $submitBtn.html();

            console.log("Form Action:", form.action);
            console.log("Form Method:", form.method);

            $.validator.unobtrusive.parse(form);

            if (!$form.valid()) {
                return false;
            }

            alertify.confirm(
                "Confirmation",
                "Are you sure you want to generate this report?",
                function () {

                    // 🔒 Disable button immediately
                    $submitBtn.prop('disabled', true);
                    $submitBtn.html('<i class="mdi mdi-loading mdi-spin me-1"></i> Processing...');

                    var ajaxConfig = {
                        type: 'POST',
                        url: form.action,
                        data: new FormData(form),
                        contentType: false,
                        processData: false,

                        success: function (response) {

                            console.log("Response:", response);

                            if (response.success) {

                                // 🔹 If report returns redirect URL
                                if (response.redirectUrl) {
                                    window.location.href = response.redirectUrl;
                                    return;
                                }

                                appalert(response.message || "Operation successful", 1, 1);

                            } else {
                                appalert(response.message || "Operation failed", 2, 1);
                            }
                        },

                        error: function (err) {

                            console.log("Error:", err);

                            if (err.status === 401) {
                                window.location.href = '/Authentication/Login';
                            } else {
                                appalert("An error occurred: " + err.statusText, 0, 1);
                            }
                        },

                        complete: function () {
                            // ✅ ALWAYS re-enable button
                            $submitBtn.prop('disabled', false);
                            $submitBtn.html(originalBtnHtml);
                        }
                    };

                    $.ajax(ajaxConfig);
                },
                function () {
                    appalert('Transaction cancelled', 3, 1);
                }
            );

            return false;
        }


        /* ==========================================
           PAGE REFRESH FUNCTION
        ========================================== */
        function RefreshPage() {
            window.location.href = '@Url.Action("Index", "IPSReporting")';
        }

    </script>
}
