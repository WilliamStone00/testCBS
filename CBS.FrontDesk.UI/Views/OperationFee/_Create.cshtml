@model CBS.FrontDesk.Data.Entity.SavingProducts.OperationFee
     @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "OperationFee", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <legend>@GlobalOperationFee.operation_fee_details</legend>

            @Html.HiddenFor(model => model.Id)

            <!-- Basic Information -->
            <div class="row mt-2 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalShared.Basic_Information
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.provide_the_basic_details_of_the_operation_fee_such_as_its_name."></i>
                </h5>
                <div class="col-md-12 mb-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Name</label>
                    </div>
                </div>
            </div>

            <!-- Fee Type and Application -->
            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalOperationFee.fee_calculation_type
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.select_how_the_fee_will_be_calculated."></i>
                </h5>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.FeeType, "Rate", new { @class = "form-check-input shadow-input-boxes", id = "rateOption" })
                        <label class="form-check-label" for="rateOption">@GlobalOperationFee.fee_is_calculated_as_rate (%)</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.FeeType, "Range", new { @class = "form-check-input shadow-input-boxes", id = "rangeOption" })
                        <label class="form-check-label" for="rangeOption">@GlobalOperationFee.fee_is_calculated_on_ranges</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsAppliesOnHoliday, new { @class = "form-check-input", id = "IsAppliesOnHoliday" })
                        <label class="form-check-label" for="IsAppliesOnHoliday">@GlobalOperationFee.applied_on_holidays</label>
                    </div>
                </div>
                <div class="col-6 mb-3">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsMoralPerson, new { @class = "form-check-input", id = "IsMoralPerson" })
                        <label class="form-check-label" for="IsMoralPerson">@GlobalOperationFee.applicable_for_moral_persons</label>
                    </div>
                </div>
            </div>


            <!-- Operation Fee Type -->
            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalOperationFee.regular_operations_fee_type
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.select_the_type_of_operation_fee_applicable."></i>
                </h5>
                <!-- Operation Fee Type options -->
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "MemberShip", new { @class = "form-check-input shadow-input-boxes", id = "MemberShip" })
                        <label class="form-check-label" for="MemberShip">@GlobalOperationFee.membership</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "Operation", new { @class = "form-check-input shadow-input-boxes", id = "Operation" })
                        <label class="form-check-label" for="Operation">@GlobalOperationFee.normal_cash_operation</label>
                    </div>
                </div>

                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "CMoney", new { @class = "form-check-input shadow-input-boxes", id = "CMoney" })
                        <label class="form-check-label" for="CMoney">C-Money</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "Gav", new { @class = "form-check-input shadow-input-boxes", id = "Gav" })
                        <label class="form-check-label" for="Gav">Gav</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "MobileMoney", new { @class = "form-check-input shadow-input-boxes", id = "MobileMoney" })
                        <label class="form-check-label" for="MobileMoney">Mobile Money</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "OrangeMoney", new { @class = "form-check-input shadow-input-boxes", id = "OrangeMoney" })
                        <label class="form-check-label" for="OrangeMoney">Orange Money</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "DailyCollections", new { @class = "form-check-input shadow-input-boxes", id = "DailyCollections" })
                        <label class="form-check-label" for="DailyCollections">@GlobalOperationFee.daily_collections</label>
                    </div>
                </div>
                <!-- ✅ New Option: Daily Saver Registration Fee -->
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "DailySaverRegistrationFee", new { @class = "form-check-input shadow-input-boxes", id = "DailySaverRegistrationFee" })
                        <label class="form-check-label" for="DailySaverRegistrationFee">@GlobalOperationFee.daily_saver_registration_onboarding_fee</label>
                    </div>
                </div>
            </div>
           
            <!-- Operation Fee Type -->
            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalOperationFee.salary_fee_type
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.select_the_type_of_salary_fee_applicable"></i>
                </h5>
                <!-- Operation Fee Type options -->
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "CivilServants", new { @class = "form-check-input shadow-input-boxes", id = "CivilServants" })
                        <label class="form-check-label" for="CivilServants">@GlobalShared.civil_servants</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "PrivateInstitutions", new { @class = "form-check-input shadow-input-boxes", id = "PrivateInstitutions" })
                        <label class="form-check-label" for="PrivateInstitutions">@GlobalOperationFee.private_institutions</label>
                    </div>
                </div>
                @*<div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "Internal", new { @class = "form-check-input shadow-input-boxes", id = "Internal" })
                        <label class="form-check-label" for="Internal">Internal</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "DailyServers", new { @class = "form-check-input shadow-input-boxes", id = "DailyServers" })
                        <label class="form-check-label" for="DailyServers">Daily Servers</label>
                    </div>
                </div>*@
            </div>

            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalOperationFee.remittance_fee_type
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.select_the_applicable_fee_type_for_th_remittance_transaction."></i>
                </h5>
                <!-- Operation Fee Type options -->
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "WesternUnion", new { @class = "form-check-input shadow-input-boxes", id = "WesternUnion" })
                        <label class="form-check-label" for="WesternUnion">Western Union</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "MoneyGram", new { @class = "form-check-input shadow-input-boxes", id = "MoneyGram" })
                        <label class="form-check-label" for="MoneyGram">MoneyGram</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "Ria", new { @class = "form-check-input shadow-input-boxes", id = "Ria" })
                        <label class="form-check-label" for="Ria">Ria</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "OFX", new { @class = "form-check-input shadow-input-boxes", id = "OFX" })
                        <label class="form-check-label" for="OFX">OFX</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "MPesa", new { @class = "form-check-input shadow-input-boxes", id = "MPesa" })
                        <label class="form-check-label" for="MPesa">M-Pesa</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "Payoneer", new { @class = "form-check-input shadow-input-boxes", id = "Payoneer" })
                        <label class="form-check-label" for="Payoneer">Payoneer</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "WorldRemit", new { @class = "form-check-input shadow-input-boxes", id = "WorldRemit" })
                        <label class="form-check-label" for="WorldRemit">World Remit</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.OperationFeeType, "TrustSoftCredit", new { @class = "form-check-input shadow-input-boxes", id = "TrustSoftCredit" })
                        <label class="form-check-label" for="TrustSoftCredit">Trust Soft Credit</label>
                    </div>
                </div>
            </div>


            <!-- Additional Charges -->
            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalOperationFee.additional_charges
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.define_any_extra_charges_that_apply_when_the_limit_is_exceeded."></i>
                </h5>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.MaximumExtraCharge, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.MaximumExtraCharge, "", new { @class = "text-danger" })
                        <label>@GlobalOperationFee.flat_extra_charge_on_exceeding_limit</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.MaximumRateAboveMaximumRange, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.MaximumRateAboveMaximumRange, "", new { @class = "text-danger" })
                        <label>@GlobalOperationFee.percentage_extra_charge_on_exceeding_limit</label>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="row mt-3 gy-3">
                <h5 class="border-bottom pb-2 mb-3">
                    @GlobalShared.Description
                    <i class="fa fa-info-circle text-muted" title="@GlobalOperationFee.provide_adetailed_description_for_this_fee_type."></i>
                </h5>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 90px;" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label for="formValidationDob">@GlobalOperationFee.fee_description</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 text-end">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
            </div>
        </fieldset>
    }
</div>
