@model List<CBS.FrontDesk.Data.Entity.SavingProducts.OperationFee>
    @using Resources
<fieldset class="fieldset-custom">
    <legend>Charges listing</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalOperationFee.no_fee_type_is_created</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Type</th>
                        <th>@GlobalShared.applied</th>
                        <th>@GlobalShared.entity</th>
                        <th>@GlobalShared.Description</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:25%">@d.Name</td>
                            <td style="width:10%">@d.FeeType</td>
                            <td style="width:10%">
                                @if (d.IsAppliesOnHoliday)
                                {
                                    <span class="badge bg-info">@GlobalOperationFee.only_on_holidays</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalShared.normal_days</span>
                                }
                            </td>
                            <td style="width:10%">
                                @if (d.IsMoralPerson)
                                {
                                    <span class="badge bg-info">@GlobalShared.moral</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalShared.physical</span>
                                }
                            </td>
                            <td style="width:35%">@d.Description</td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','OperationFee')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('OperationFee','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }

</fieldset>

