@model  CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "Cash Replenishment requests";

}
<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                PROVISION BANK TO VAULT
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">
                        <h2>List of Cash Replenishments</h2>

                        <table class="table table-hover" id="ListOfCashReplenishmentData">
                            <thead class="table-light">
                                <tr>
                                    <th>ReferenceId</th>
                                    <th>Amount</th>
                                    <th>RequestMessage</th>
                                    <th>IssuedBy</th>
                                    <th>IssuedDate</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                     
                            

                                @foreach (var item in Model.DetailsDtos)
                                {


                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.id)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.requestedAmount)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.confirmedAmount)
                                        </td>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.requesterUserId)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.RequestDate)
                                        </td>


                                        @if (item.approvedStatus.ToUpper().Equals("PENDING"))
                                        {
                                            <td class="badge bg-label-primary rounded-pill text-uppercase">

                                                @Html.ActionLink("Click to approve", "GetCashReplenimentRequest", new { @Key = item.id }, new { @style = "color: inherit;" })

                                            </td>


                                        }
                                        else
                                        {
                                            if (item.approvedStatus.ToUpper().Equals("APPROVE"))
                                            {
                                                <td class="badge bg-label-success rounded-pill text-uppercase">
                                                    @Html.ActionLink("APPROVED", "GetCashReplenimentRequest", new { @Key = item.id }, new { @style = "color: inherit;" })
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="badge bg-label-danger rounded-pill text-uppercase">
                                                    @Html.ActionLink("REJECTED", "GetCashReplenimentRequest", new { @Key = item.id }, new { @style = "color: inherit;" })
                                                </td>
                                            }

                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/CashFlowManagement.js"></script>
}


