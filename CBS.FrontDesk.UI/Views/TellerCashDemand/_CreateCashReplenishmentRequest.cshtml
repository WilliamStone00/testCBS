@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity

@{
    ViewBag.Title = "Teller Cash Replenishment Request";

}



<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
 
           
       
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">

                        @using (Html.BeginForm("CreateCashReplenishmentRequest", "TellerCashDemand", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row mt-2 gy-4">

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        <label for="Account">Select CurrentOperation</label>
                                        @Html.DropDownListFor(m => m.CashInfusionModel.CurrentOpenOfDayHistoryId, new SelectList(ViewBag.OpeningOfDayId == null ? "" : ViewBag.OpeningOfDayId, "Text", "Value"), "---Select OpeningOfDay ---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(model => model.CashInfusionModel.CurrentOpenOfDayHistoryId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(model => model.CashInfusionModel.Amount, new { @class = "form-control", placeholder = "XFA 0.0" })
                                        @Html.ValidationMessageFor(model => model.CashInfusionModel.Amount, "", new { @class = "text-danger" })
                                        <label for="Amount">Amount</label>
                                    </div>
                                </div>


                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.CashInfusionModel.RequestMessage, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(model => model.CashInfusionModel.RequestMessage, "", new { @class = "text-danger" })

                                        <label for="Description"> RequestMessage</label>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Send Request</button>
                                <button type="reset" class="btn btn-outline-secondary">Reset</button>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>



</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")}


