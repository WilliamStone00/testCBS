@model CBS.FrontDesk.Data.Entity.Accounting.CashDemandDataEntity
@{
    ViewBag.Title = "Successfull_RequestApproval_View";

}

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Request ReferenceId : @Model.DetailsDtoModel.id
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Cash Replenishment Request Details</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            <tr>
                                <td>Invoice Number</td>
                                <td>@Model.DetailsDtoModel.id </td>
                            </tr>
                            <tr>
                                <td>Amount Requested</td>
                                <td>@Model.DetailsDtoModel.requestedAmount.ToString("N") </td>
                            </tr>
                            <tr>
                                <td>Request Message</td>
                                <td>@Model.DetailsDtoModel.requetcomment </td>
                            </tr>
                            <tr>
                                <td>Requested By </td>
                                <td> @Model.DetailsDtoModel.requesterUserId </td>
                            </tr>
                            <tr>
                                <td>Approved By </td>
                                <td> @Model.DetailsDtoModel.approvedBy </td>
                            </tr>
                            <tr>
                                <td>Amount Approved</td>
                                <td>@Model.DetailsDtoModel.confirmedAmount.ToString("N") </td>
                            </tr>


                            <tr>
                                <td>Approved Date</td>
                                <td>@Model.DetailsDtoModel.approvedDate </td>
                            </tr>
                            <tr>
                                <td>Approved Message</td>
                                <td>@Model.DetailsDtoModel.approvedComment </td>
                            </tr>
                            <tr>


                                <td> Status</td>
                                @if (@Model.DetailsDtoModel.approvedStatus.ToUpper().Equals("PENDING"))
                                {
                                    <td class="badge bg-label-primary rounded-pill text-uppercase">
                                        @Model.DetailsDtoModel.approvedStatus
                                    </td>


                                }
                                else
                                {
                                    if (@Model.DetailsDtoModel.approvedStatus.ToUpper().Equals("APPROVE"))
                                    {
                                        <td class="badge bg-label-success rounded-pill text-uppercase">
                                            @Model.DetailsDtoModel.approvedStatus
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="badge bg-label-danger rounded-pill text-uppercase">
                                            @Model.DetailsDtoModel.approvedStatus
                                        </td>
                                    }

                                }

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card card-action mb-5">

                    @if (@Model.DetailsDtoModel.approvedStatus.ToUpper().Equals("PENDING"))
                    {
                        <h5 class="card-header" >You have just rejected the cash replenishment request of XAF @Model.DetailsDtoModel.requestedAmount.ToString("N") Issued by @Model.DetailsDtoModel.requesterUserId successfully.</h5>
                    }
                    else
                    {
                        if (@Model.DetailsDtoModel.approvedStatus.ToUpper().Equals("APPROVE"))
                        {
                            <h5 class="card-header" style="color:forestgreen">You have just approved cash replenishment request of XAF @Model.DetailsDtoModel.confirmedAmount.ToString("N") Issued by @Model.DetailsDtoModel.requesterUserId for @Model.DetailsDtoModel.requestedAmount.ToString("N")  successfully.</h5>

                        }
                        else
                        {
                            <h5 class="card-header" style="color:firebrick">You have just rejected the cash replenishment request of XAF @Model.DetailsDtoModel.requestedAmount.ToString("N") Issued by @Model.DetailsDtoModel.requesterUserId successfully.</h5>
                        }

                    }
                    <div class="col-12 shift-right">

                        <a href="/TellerCashDemand/GetAllCashReplenimentRequestData" class="btn btn-primary click-to-go-back-to-menu" >Click to view pending cash replenishment request. </a>


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>


@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/CashFlowManagement.js"></script>
}