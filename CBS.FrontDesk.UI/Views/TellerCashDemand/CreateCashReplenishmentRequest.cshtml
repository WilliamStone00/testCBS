@model CBS.FrontDesk.Data.Entity.Accounting.CashInfusionRequest

@{
    ViewBag.Title = "Cash Replenishment Request";

}



<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                PROVISION BANK TO VAULT
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">

                        @using (Html.BeginForm("CreateCashReplenishmentRequest", "TellerCashDemand", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row mt-2 gy-4">

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        <label for="Account">Select CurrentOperation</label>
                                        @Html.DropDownListFor(m => m.CurrentOperation, new SelectList(ViewBag.OpeningOfDayId == null ? "" : ViewBag.OpeningOfDayId, "Text", "Value"), "---Select CurrentOperation ---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(model => model.CurrentOperation, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(model => model.RequestedAmount, new { @class = "form-control", placeholder = "XFA 0.0" })
                                        @Html.ValidationMessageFor(model => model.RequestedAmount, "", new { @class = "text-danger" })
                                        <label for="Amount">Amount</label>
                                    </div>
                                </div>




                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.Requetcomment, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(model => model.Requetcomment, "", new { @class = "text-danger" })

                                        <label for="Description"> RequestMessage</label>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Send Request</button>
                                <button type="reset" class="btn btn-outline-secondary">Reset</button>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>



</div>
@section Scripts {@Scripts.Render("~/bundles/jqueryval")


}