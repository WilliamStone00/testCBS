@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigManagement
@{
    var vm = Model.BranchCashConfigDetailsVm;
}

<style>
    .detail-card {
        border: 1px solid #e5e7eb;
        border-radius: .5rem;
    }

    .detail-header {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        padding: .75rem 1rem;
    }

    .pill {
        display: inline-block;
        padding: .15rem .5rem;
        border-radius: 999px;
        font-size: .75rem;
    }

    .pill-success {
        background: #ecfdf5;
        color: #065f46;
    }

    .pill-muted {
        background: #f3f4f6;
        color: #374151;
    }

    .pair-label {
        font-weight: 600;
        color: #374151;
    }

    .pair-name {
        display: block;
    }

    .pair-no {
        display: block;
        color: #6b7280;
        font-size: .85rem;
    }

    .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem 1rem;
    }

    @@media (max-width: 768px) {
        .grid-2col {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="detail-card">
    <div class="detail-header d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold">Configuration Details</div>
            <div class="text-muted small">Review the branch cash configuration</div>
        </div>
        <div>
            @if (vm.RealTimeCashPosting == true)
            {<span class="pill pill-success">Real-time: Yes</span> }
            else
            { <span class="pill pill-muted">Real-time: No</span>}
        </div>
    </div>

    <div class="p-3">
        <div class="mb-3">
            <span class="pair-label">Branch:</span>
            <span class="ms-1">@vm.Branch</span>
        </div>

        <div class="grid-2col">
            <!-- Till & Vault -->
            <div>
                <div class="pair-label">Till (Cash in Hand)</div>
                <span class="pair-name">@vm.CashInHand.Name</span>
                <span class="pair-no">@vm.CashInHand.Number</span>
            </div>

            <div>
                <div class="pair-label">Vault</div>
                <span class="pair-name">@vm.Vault.Name</span>
                <span class="pair-no">@vm.Vault.Number</span>
            </div>

            <!-- HO Liaison & Revenue -->
            <div>
                <div class="pair-label">HO Liaison</div>
                <span class="pair-name">@vm.HeadOfficeLiaison.Name</span>
                <span class="pair-no">@vm.HeadOfficeLiaison.Number</span>
            </div>

            <div>
                <div class="pair-label">Revenue</div>
                <span class="pair-name">@vm.Revenue.Name</span>
                <span class="pair-no">@vm.Revenue.Number</span>
            </div>

            <!-- Surplus & Shortage -->
            <div>
                <div class="pair-label">Surplus Income</div>
                <span class="pair-name">@vm.SurplusIncome.Name</span>
                <span class="pair-no">@vm.SurplusIncome.Number</span>
            </div>

            <div>
                <div class="pair-label">Shortage Expense</div>
                <span class="pair-name">@vm.ShortageExpense.Name</span>
                <span class="pair-no">@vm.ShortageExpense.Number</span>
            </div>

            <!-- Partner & CamCCUL -->
            <div>
                <div class="pair-label">Partner</div>
                <span class="pair-name">@vm.Partner.Name</span>
                <span class="pair-no">@vm.Partner.Number</span>
            </div>

            <div>
                <div class="pair-label">CamCCUL</div>
                <span class="pair-name">@vm.Camccul.Name</span>
                <span class="pair-no">@vm.Camccul.Number</span>
            </div>

            <!-- Form Fee Income -->
            <div>
                <div class="pair-label">Form Fee Income</div>
                <span class="pair-name">@vm.FormFeeIncome.Name</span>
                <span class="pair-no">@vm.FormFeeIncome.Number</span>
            </div>

            <!-- Loan Transit -->
            <div>
                <div class="pair-label">Loan Transit</div>
                <span class="pair-name">@vm.LoanTransit.Name</span>
                <span class="pair-no">@vm.LoanTransit.Number</span>
            </div>

            <!-- Interest Income (Backup) -->
            <div>
                <div class="pair-label">Interest Income (Backup)</div>
                <span class="pair-name">@vm.InterestGeneratedFrom.Name</span>
                <span class="pair-no">@vm.InterestGeneratedFrom.Number</span>
            </div>

            <!-- Cash-In Commission -->
            <div>
                <div class="pair-label">Cash-In Commission (Backup)</div>
                <span class="pair-name">@vm.CashInCommission.Name</span>
                <span class="pair-no">@vm.CashInCommission.Number</span>
            </div>

            <!-- Cash-Out Commission -->
            <div>
                <div class="pair-label">Cash-Out Commission (Backup)</div>
                <span class="pair-name">@vm.CashOutCommission.Name</span>
                <span class="pair-no">@vm.CashOutCommission.Number</span>
            </div>

            <!-- Transfer Commission -->
            <div>
                <div class="pair-label">Transfer Commission (Backup)</div>
                <span class="pair-name">@vm.TransferCommission.Name</span>
                <span class="pair-no">@vm.TransferCommission.Number</span>
            </div>

            <!-- VAT Backup -->
            <div>
                <div class="pair-label">VAT Account (Backup)</div>
                <span class="pair-name">@vm.VAT.Name</span>
                <span class="pair-no">@vm.VAT.Number</span>
            </div>

            <!-- MoMoCash Settlement -->
            <div>
                <div class="pair-label">MoMoCash Settlement</div>
                <span class="pair-name">@vm.Momocash.Name</span>
                <span class="pair-no">@vm.Momocash.Number</span>
            </div>

            <!-- MoMoCash Commission -->
            <div>
                <div class="pair-label">MoMoCash Commission</div>
                <span class="pair-name">@vm.MomocashCommission.Name</span>
                <span class="pair-no">@vm.MomocashCommission.Number</span>
            </div>

            <!-- NEW: Global Fallback Suspense GL -->
            <div>
                <div class="pair-label">Fallback Suspense GL</div>
                <span class="pair-name">@vm.FallbackSuspense.Name</span>
                <span class="pair-no">@vm.FallbackSuspense.Number</span>
            </div>
        </div>
    </div>
</div>
