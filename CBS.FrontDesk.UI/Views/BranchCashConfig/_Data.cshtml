@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigManagement
@{
    var rows = (IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigRowDto>)(ViewBag.Rows ?? Enumerable.Empty<CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigRowDto>());
}
<style>
    .cell-stack {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

        .cell-stack .title {
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cell-stack .sub {
            font-size: .825rem;
            color: #6c757d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
</style>




@functions{
    string Label(string code, string name)
        => string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(name)
           ? "—"
           : (string.IsNullOrWhiteSpace(code) ? name : $"[{code}] {name}");
}

<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th style="width:24%;">Branch</th>
                <th style="width:21%;">Till (Cash in Hand)</th>
                <th style="width:21%;">Vault</th>
                <th style="width:21%;">HO Liaison</th>
                <th style="width:8%;">Real-time</th>
                <th style="width:5%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@Label(null, r.BranchName)</td>

                    <td>
                        <div class="cell-stack" title="@($"{r?.CashInHandAccountNumber}".Trim())">
                            <span class="title">@Label(r?.CashInHandAccountNumber, r?.CashInHandAccountName)</span>
                        </div>
                    </td>

                    <td>
                        <div class="cell-stack" title="@($"{r?.VaultAccountName} {r?.VaultAccountNumber}".Trim())">
                            <span class="title">@Label(r?.VaultAccountNumber, r?.VaultAccountName)</span>
                        </div>
                    </td>

                    <td>
                        <div class="cell-stack" title="@($"{r?.HeadOfficeLiaisonAccountName} {r?.HeadOfficeLiaisonAccountNumber}".Trim())">
                            <span class="title">@Label(r?.HeadOfficeLiaisonAccountNumber, r?.HeadOfficeLiaisonAccountName)</span>
                        </div>
                    </td>

                    <td class="text-center">
                        @if (r?.RealTimeCashPosting == true)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>

                    <td class="actions text-end">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Row actions">
                            <button type="button"
                                    class="btn btn-outline-primary btn-details"
                                    data-id="@r.Id"
                                    title="Details">
                                <i class="mdi mdi-eye" aria-hidden="true"></i><span class="visually-hidden">Details</span>
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-edit"
                                    data-id="@r.Id"
                                    title="Edit">
                                <i class="mdi mdi-pencil" aria-hidden="true"></i><span class="visually-hidden">Edit</span>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Details → modal
  $(document).off('click', '.btn-details').on('click', '.btn-details', function () {
    const id = $(this).data('id');
    $('#cashConfigDetailsContent').html('<div class="p-3">Loading...</div>');
    const $modal = $('#cashConfigDetailsModal');
    if ($modal.length) $modal.modal('show');

    $.get('@Url.Action("Details", "BranchCashConfig")', { id })
      .done(html => $('#cashConfigDetailsContent').html(html))
      .fail(() => $('#cashConfigDetailsContent').html('<div class="text-danger p-3">Failed to load details.</div>'));
  });

  // Edit
  $(document).off('click', '.btn-edit').on('click', '.btn-edit', function () {
    const id = $(this).data('id');
    AddORUpdateGen(id, 'datalistingview', '_Create', 'edit', 'BranchCashConfig');
  });

    (function () {
        const id = '#myDataTable';
        if ($.fn.DataTable.isDataTable(id)) {
            $(id).DataTable().clear().destroy();
        }

        $(id).DataTable({
            responsive: true,
            autoWidth: false,
            deferRender: true,
            paging: true,
            searching: true,
            info: true,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
            order: [[0, 'asc']],
            columnDefs: [
                { targets: 4, className: 'text-center' },
                { targets: 5, className: 'actions text-end', orderable: false }
            ],
            language: {
                emptyTable: 'No data found.'
            }
        });
    })();
</script>



