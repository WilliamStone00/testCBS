@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigManagement
@{
    ViewBag.Title = "Branch Cash Configuration";
}

<!-- Page Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> Branch Cash Configuration
                </h1>

                <p class="card-text text-muted">
                    Configure all branch-level cash-control and financial-routing GL accounts.
                    <strong>
                        Every GL configured here directly determines how teller, vault,
                        loan, transfer, Mobile Money and fee posting workflows behave.
                    </strong>
                </p>

                <p class="card-text text-muted">
                    <strong>All Cash-Control, Commission, VAT, MoMoCash and Fee GLs are compulsory.</strong>
                    Missing mappings will cause posting failures or incorrect accounting routing.
                </p>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>


<!-- Tips -->
<!-- Tips -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips & Important Notes</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseCashCfgTips" aria-expanded="false"
                aria-controls="collapseCashCfgTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseCashCfgTips" class="collapse">
        <div class="card-body">

            <ul class="mb-0">

                <!-- Branch Selection -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    Always select the correct <b>Branch</b> before configuring.
                    Each branch has its own GL structure and balances.
                </li>

                <!-- Core Mandatory GLs -->
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                    <b>All core cash-control GLs are mandatory:</b><br />
                    Cash-In-Hand (Till), Vault, Surplus Income, Shortage Expense.
                    Operations such as Cash-In, Cash-Out, Teller Closure, and Vault Transfers
                    will <b>fail immediately</b> if these are missing.
                </li>

                <!-- MoMoCash + Commissions Mandatory -->
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                    <b>
                        All Commission, VAT, MoMoCash, Loan Transit and Interest GLs
                        are mandatory.
                    </b><br />
                    This includes:
                    Cash-In Commission, Cash-Out Commission, Transfer Commission,
                    VAT, Form Fee, Loan Transit, Interest Income Backup,
                    MoMoCash Settlement & MoMoCash Commission.
                    <br />
                    If any is missing, related operations cannot post.
                </li>

                <!-- Behaviour -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <b>Till (Cash In Hand)</b> is debited when receiving cash
                    and credited when paying out.
                    Incorrect configuration leads to teller-day mismatches.
                </li>

                <!-- Vault -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <b>Vault Account</b> represents the branch vault stock.
                    All teller–vault transfers depend on this mapping.
                </li>

                <!-- Surplus/Shortage -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <b>SurplusIncomeAccount</b> and <b>ShortageExpenseAccount</b>
                    are used during balancing (teller, vault, EOD).
                    They must be correctly set for accurate cash reconciliation.
                </li>

                <!-- Liaison -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <b>HeadOfficeLiaisonAccount</b> is essential for inter-branch posting.
                    If missing, all inter-branch operations will fail.
                </li>

                <!-- Loan Transit -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <b>LoanTransitAccount</b> stores pending loan disbursements.
                    Without this mapping, all loan disbursement postings will fail.
                </li>

                <!-- Revenue / Fallback -->
                <li>
                    <i class="mdi mdi-information-outline text-primary me-2"></i>
                    Most other GLs (Revenue, Partner, CamCCUL, Fees, VAT, Commissions)
                    act as <b>fallback accounts</b> when product-specific mappings are not given.
                    This ensures the accounting engine always finds a routing path.
                </li>

                <!-- Real-time posting -->
                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                    When <b>Real-time Cash Posting</b> is enabled, every teller,
                    vault, loan, MoMo or fee operation posts immediately.
                    Disable only if your institution uses deferred posting.
                </li>

                <!-- Security -->
                <li>
                    <i class="mdi mdi-lock-outline text-danger me-2"></i>
                    Only authorized officers should modify this configuration.
                    Wrong mapping may cause <b>
                        incorrect GL balances, unreconciled vault positions,
                        interbranch imbalances, or misposted commissions.
                    </b>
                </li>

            </ul>

        </div>
    </div>
</div>

<!-- Main -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionCashCfgHead">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionCashCfgBody" aria-expanded="true" aria-controls="accordionCashCfgBody">
                            <i class="mdi mdi-cash me-2"></i> Branch Cash Config Management
                        </button>
                    </h2>
                    <div id="accordionCashCfgBody" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-1">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button"
                                           onclick="LoadDataGen('BranchCashConfig','myDataTable','_Data',0,'datalistingview')"
                                           class="btn btn-label-primary btn-sm me-2"
                                           data-bs-toggle="tooltip" title="View list">
                                            <i class="mdi mdi-view-list mdi-18px"></i> View list
                                        </a>
                                        <a type="button"
                                           onclick="AddORUpdateGen(null,'datalistingview','_Create','new','BranchCashConfig')"
                                           class="btn btn-label-secondary btn-sm"
                                           data-bs-toggle="tooltip" title="Add Cash Config">
                                            <i class="mdi mdi-plus mdi-18px"></i> Add Cash Config
                                        </a>
                                    </div>
                                </div>

                                <!-- Workspace -->
                                <div id="datalistingview">
                                    @Html.Partial("_Create", Model)
                                </div>
                            </div> <!-- /mainviewChange -->
                        </div>
                    </div>
                </div> <!-- /accordion-item -->
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="cashConfigDetailsModal" tabindex="-1" aria-labelledby="cashConfigDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header p-2">
                <header class="w-100 text-center">
                    <h4 class="text-primary fw-bold mb-1">
                        <i class="mdi mdi-cash me-2"></i> Cash Config Details
                    </h4>
                    <p class="text-muted mb-0">
                        Review the branch’s mandatory cash GLs and the fallback revenue/fee accounts used
                        by the posting engine.
                    </p>
                    <hr style="border: 1px solid rgba(128, 128, 128, 0.5);" />
                </header>
            </div>
            <div class="modal-body p-2">
                <div id="cashConfigDetailsContent"><!-- dynamic content --></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
  // items can be [{ text, value }] or MVC's { Text, Value }
  function fillSelect($el, items, placeholder, selectedValue) {
    const getText  = (x) => x?.text  ?? x?.Text  ?? '';
    const getValue = (x) => x?.value ?? x?.Value ?? '';

    $el.empty();
    if (placeholder) {
      $el.append($('<option>').val('').text(placeholder));
    }

    (items || []).forEach(it => {
      $el.append($('<option>').val(getValue(it)).text(getText(it)));
    });

    if (selectedValue) {
      $el.val(selectedValue);
    } else {
      // ensure placeholder is selected visually
      $el.val('');
    }

    // If using Select2, refresh it
    if ($el.hasClass('select2')) {
      $el.trigger('change.select2');
    } else {
      $el.trigger('change');
    }
  }

  // Exposed globally in your snippet already
function fetchBranchDetails(branchId) {
    if (!branchId) return;

    $.ajax({
        url: '@Url.Action("GetByBranch", "BranchCashConfig")',
        type: 'POST',
        data: { branchId },
        // include anti-forgery if enabled:
        // headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function (res) {
            if (!res || res.success !== true) {
                if (window.toastr) toastr.error(res && res.message ? res.message : 'Failed to load branch configuration.');
                return;
            }

            const accounts = res.accounts || [];

            // Core mandatory cash accounts
            fillSelect($('#CashInHandAccountId'), accounts, '-- Select Cash in Hand Account (Till) --', res.data?.cashInHandAccountId);
            fillSelect($('#VaultAccountId'), accounts, '-- Select Vault Account --', res.data?.vaultAccountId);
            fillSelect($('#SurplusIncomeAccountId'), accounts, '-- Select Surplus Income Account --', res.data?.surplusIncomeAccountId);
            fillSelect($('#ShortageExpenseAccountId'), accounts, '-- Select Shortage Expense Account --', res.data?.shortageExpenseAccountId);

            // Revenue & partner mappings
            fillSelect($('#RevenueAccountId'), accounts, '-- Select Revenue Account (Optional) --', res.data?.revenueAccountId);
            fillSelect($('#PartnerAccountId'), accounts, '-- Select Partner Account (Optional) --', res.data?.partnerAccountId);
            fillSelect($('#CamcculAccountId'), accounts, '-- Select CamCCUL Account (Optional) --', res.data?.camcculAccountId);
            fillSelect($('#HeadOfficeLiaisonAccountId'), accounts, '-- Select Head Office Liaison Account --', res.data?.headOfficeLiaisonAccountId);
            fillSelect($('#FormFeeIncomeAccountId'), accounts, '-- Select Form Fee Income Account (Optional) --', res.data?.formFeeIncomeAccountId);

            // Loan & interest mappings
            fillSelect($('#LoanTransitAccountId'), accounts, '-- Select Loan Transit Account --', res.data?.loanTransitAccountId);
            fillSelect($('#InterestGeneratedFromAccountId'), accounts, '-- Select Interest Income Backup Account --', res.data?.interestGeneratedFromAccountId);

            // Commission / VAT mappings
            fillSelect($('#CashInCommisionAccountIDAccountId'), accounts, '-- Select Cash-In Commission Backup Account --', res.data?.cashInCommisionAccountIDAccountId);
            fillSelect($('#CashOutCommisionAccountIDAccountId'), accounts, '-- Select Cash-Out Commission Backup Account --', res.data?.cashOutCommisionAccountIDAccountId);
            fillSelect($('#TransfterCommisionAccountIDAccountId'), accounts, '-- Select Transfer Commission Backup Account --', res.data?.transfterCommisionAccountIDAccountId);
            fillSelect($('#VATAccountId'), accounts, '-- Select VAT Backup Account --', res.data?.vatAccountId);

            // MoMoCash mappings
            fillSelect($('#MomocashAccountId'), accounts, '-- Select MoMoCash Settlement Account --', res.data?.momocashAccountId);
            fillSelect($('#MomocashCommissionGlId'), accounts, '-- Select MoMoCash Commission Account --', res.data?.momocashCommissionGlId);

            // 🔹 NEW: Global Fallback Suspense GL
            fillSelect($('#FallbackSuspenseAccountId'), accounts, '-- Select Fallback Suspense GL --', res.data?.fallbackSuspenseAccountId);

            // Real-time posting
            $('#RealTimeCashPosting').prop(
                'checked',
                typeof res.data?.realTimeCashPosting === 'boolean' ? res.data.realTimeCashPosting : true
            );

            // $('#saveOrUpdateBtn').text(res.exists ? 'Update' : 'Save');
            // if (res.branchCode) { $('#BranchCode').val(res.branchCode); }
            // $('input[name="BranchCashConfig.Id"]').val(res.data?.id || '');
        },
        error: function () {
            if (window.toastr) toastr.error('Error loading branch configuration.');
        }
    });
}

  // If you’re in EDIT mode (BranchId readonly), auto-load accounts on page load:
  $(function () {
    const $branchSelect = $('#BranchId');
    if ($branchSelect.length === 0) {
      const fixedBranchId = $('input[name="BranchCashConfig.BranchId"]').val();
      if (fixedBranchId) fetchBranchDetails(fixedBranchId);
    }
  });
</script>


    <script>
  // GET /BranchCashConfig/_Data
  // signature kept: LoadDataGen(feature, tableId, partial, page, containerId)
  window.LoadDataGen = function (feature, tableId, partial, page, containerId) {
    var url = '@Url.Action("_Data", "BranchCashConfig")';
    $.get(url)
      .done(function (html) {
        $('#' + containerId).html(html);
      })
      .fail(function () {
        $('#' + containerId).html('<div class="text-danger p-3">Failed to load list.</div>');
      });
  };

  // GET /BranchCashConfig/_Create[?id=...] or /_Create?branchId=... when adding new
  // signature kept: AddORUpdateGen(id, containerId, partial, mode, controller)
  window.AddORUpdateGen = function (id, containerId, partial, mode, controller) {
    var baseUrl = '@Url.Action("_Create", "BranchCashConfig")';
    var url = id ? (baseUrl + '?id=' + encodeURIComponent(id)) : baseUrl;

    // If creating new (no id) and a Branch is already selected on the page, pass it along
    if (!id) {
      var bid = $('#BranchId').val();
      if (bid) {
        url += (url.indexOf('?') >= 0 ? '&' : '?') + 'branchId=' + encodeURIComponent(bid);
      }
    }

    $.get(url)
      .done(function (html) {
        var $c = $('#' + containerId);
        $c.html(html);

        // Re-init select2 if present
        if ($.fn.select2) $('.select2').select2();

        // If a branch is selected in the loaded form, auto-load its accounts
        var formBranchId = $('#BranchId').val();
        if (formBranchId && typeof window.fetchBranchDetails === 'function') {
          window.fetchBranchDetails(formBranchId);
        }
      })
      .fail(function () {
        $('#' + containerId).html('<div class="text-danger p-3">Failed to load form.</div>');
      });
  };

  // Optional: edit from details modal
  $(document).on('click', '.js-edit-config', function () {
    var id = $(this).data('id');
    AddORUpdateGen(id, 'datalistingview', '_Create', 'edit', 'BranchCashConfig');
    $('#cashConfigDetailsModal').modal('hide');
  });
    </script>
}

