@* _BranchCashConfigDataTable.cshtml *@
@using Resources
@model IEnumerable<CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfig.BranchCashConfigDto>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','BranchCashConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Configuration">
            <i class="mdi mdi-plus mdi-18px"></i> @BranchCashConfig.addbutton
        </a>
    </div>
</div>

<div class="card shadow-sm p-3" id="branchCashConfigTableContainer">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i>  @BranchCashConfig.BranchCashConfigData</h5>

    <!-- Quick Actions -->
  
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                
                <div>
                    <button type="button" onclick="refreshDataTable()" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="mdi mdi-refresh me-1"></i>  @BranchCashConfig.refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th> @BranchCashConfig.branch</th>
                    <th>@BranchCashConfig.CashinHand</th>
                    <th>@BranchCashConfig.VaultAccount</th>
                    <th>@BranchCashConfig.SurplusAccount</th>
                    <th>@BranchCashConfig.DeficitAccount</th>
                    <th>@BranchCashConfig.RealTimePosting</th>
                    <th>@BranchCashConfig.status</th>
                    <th>@BranchCashConfig.actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var config in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(ViewBag.BranchesDict != null && ViewBag.BranchesDict.ContainsKey(config.BranchId) ? ViewBag.BranchesDict[config.BranchId] : config.BranchId)</strong>
                            </td>
                            <td>
                                <small class="text-muted">@(ViewBag.GLAccountsDict != null && ViewBag.GLAccountsDict.ContainsKey(config.CashInHandAccountId) ? ViewBag.GLAccountsDict[config.CashInHandAccountId] : config.CashInHandAccountId)</small>
                            </td>
                            <td>
                                <small class="text-muted">@(ViewBag.GLAccountsDict != null && ViewBag.GLAccountsDict.ContainsKey(config.VaultAccountId) ? ViewBag.GLAccountsDict[config.VaultAccountId] : config.VaultAccountId)</small>
                            </td>
                            <td>
                                <small class="text-muted">@(ViewBag.GLAccountsDict != null && ViewBag.GLAccountsDict.ContainsKey(config.SurplusIncomeAccountId) ? ViewBag.GLAccountsDict[config.SurplusIncomeAccountId] : config.SurplusIncomeAccountId)</small>
                            </td>
                            <td>
                                <small class="text-muted">@(ViewBag.GLAccountsDict != null && ViewBag.GLAccountsDict.ContainsKey(config.ShortageExpenseAccountId) ? ViewBag.GLAccountsDict[config.ShortageExpenseAccountId] : config.ShortageExpenseAccountId)</small>
                            </td>
                            <td>
                                @if (config.RealTimeCashPosting)
                                {
                                    <span class="badge bg-success">@BranchCashConfig.yes</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary">@BranchCashConfig.no</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success">@BranchCashConfig.active</span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                        @BranchCashConfig.actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" href="javascript:void(0)"
                                               onclick="AddORUpdateGen('@config.Id','datalistingview','_Create','edit','BranchCashConfig')">
                                                <i class="mdi mdi-pencil-outline me-1"></i> @BranchCashConfig.edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="javascript:void(0)"
                                               onclick="deleteRecord('@config.Id', 'BranchCashConfig')">
                                                <i class="mdi mdi-delete-outline me-1"></i> @BranchCashConfig.delete
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="ViewBranchDetails('@config.Id')"
                                                    title="Branch Cash Config Details">
                                                <i class="mdi mdi-eye-outline me-1"></i> @BranchCashConfig.details
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="mdi mdi-information-outline mdi-24px mb-2"></i>
                            <br>
                            @BranchCashConfig.Nobranchcashconfigurationsfound
                            <br>
                            <small>@BranchCashConfig.click "Add New Configuration" to create one.</small>
                        </td>
                    </tr>
                }
            </tbody>

            <!-- 🔹 Branch Cash Config Modal -->
            <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header  text-white">
                              <button type="button" class="btn-close btn-close-black" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="detailsModalBody">
                            <div class="text-center py-4">
                                <i class="mdi mdi-loading mdi-spin" style="font-size:24px"></i> Loading details...
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </table>
    </div>
</div>

<script>
    function refreshDataTable() {
        LoadDataGen('BranchCashConfig', 'myDataTable', '_BranchCashConfigDataTable', 0, 'datalistingview', null, 'list');
    }

    function ViewBranchDetails(KEY) {
        if (!KEY) {
        toastr.error('Invalid ID');
        return;
    }

    // show modal immediately with spinner
    $('#detailsModalBody').html('<div class="text-center py-4"><i class="mdi mdi-loading mdi-spin" style="font-size:24px"></i> Loading details...</div>');
    var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
    modal.show();

    // load partial view
    $.ajax({
        url: '@Url.Action("Details", "BranchCashConfig")',
        type: 'GET',
        data: { id: KEY },
        dataType: 'html',
        success: function (html) {
            $('#detailsModalBody').html(html);
        },
        error: function () {
            toastr.error('Error loading details');
            $('#detailsModalBody').html('<p class="text-danger">Failed to load details.</p>');
        }
    });
}


    function deleteRecord(id, controller) {
        if (confirm('Are you sure you want to delete this configuration?')) {
            $.ajax({
                url: '/' + controller + '/Delete?KEY=' + id,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        showNotification('success', response.message);
                        refreshDataTable();
                    } else {
                        showNotification('error', response.message);
                    }
                },
                error: function () {
                    showNotification('error', 'An error occurred while deleting the configuration.');
                }
            });
        }
    }

    function showNotification(type, message) {
        // Implement your notification system here
        appalert(message);
    }
</script>