@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigManagement
@{
    var isEdit = !string.IsNullOrWhiteSpace(Model?.BranchCashConfig?.Id) || (ViewBag.Id != null);

    // Try resolve branch name from ViewBag.Branches (expects objects with Id/Name)
    string resolvedBranchName = "";
    if (Model?.BranchCashConfig?.BranchId != null && ViewBag.Branches != null)
    {
        foreach (var b in (IEnumerable<dynamic>)ViewBag.Branches)
        {
            if ((string)b.Id == Model.BranchCashConfig.BranchId)
            {
                resolvedBranchName = (string)b.Name;
                break;
            }
        }
    }
}

<fieldset class="fieldset-custom">
    <legend id="select_base">BRANCH CASH CONFIG</legend>
    <div class="card-body">
        @using (Html.BeginForm("CreateOrUpdate", "BranchCashConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(m => m.BranchCashConfig.Id)

            <!-- ===== Section 1: Branch ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="mdi mdi-office-building me-2"></i>Branch
                    </h6>
                </div>

                <div class="card-body">
                    <div class="row gy-3">

                        @if (!isEdit)
                        {
                            <!-- CREATE MODE: show dropdown, enable onchange -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(
                                        m => m.BranchCashConfig.BranchId,
                                        new SelectList(ViewBag.Branches, "Id", "Name"),
                                        "-- Select Branch --",
                                        new
                                        {
                                            @class = "form-select select2",
                                            id = "BranchId",
                                            @search = "true",
                                            data_mode = "create",
                                            onchange = "fetchBranchDetails(this.value)"
                                        }
                                    )
                                    @Html.ValidationMessageFor(m => m.BranchCashConfig.BranchId, "", new { @class = "text-danger" })
                                    <label for="BranchId">Branch</label>
                                </div>
                                <div class="form-text text-muted">
                                    Selecting a branch reloads the account dropdowns with <em>that branch’s</em> GL accounts.
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- EDIT MODE: show read-only branch name, keep BranchId hidden -->
                            @Html.HiddenFor(m => m.BranchCashConfig.BranchId)

                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    <input type="text"
                                           class="form-control"
                                           id="BranchNameReadonly"
                                           value="@resolvedBranchName"
                                           readonly />
                                    <label for="BranchNameReadonly">Branch</label>
                                </div>
                                <div class="form-text text-muted">
                                    Branch is fixed for this configuration.
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- ===== Section 2: Mapping ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light d-flex align-items-center justify-content-between">
                    <h6 class="mb-0">
                        <i class="mdi mdi-link-variant me-2"></i>Mapping (Fallback / Backup Accounts)
                    </h6>
                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#mappingTips" aria-expanded="false" aria-controls="mappingTips">
                        <i class="mdi mdi-information-outline me-1"></i> Tips
                    </button>
                </div>

                <!-- Mapping Tips -->
                <div id="mappingTips" class="collapse">
                    <div class="card-body pt-2">
                        <p class="small text-muted mb-2">
                            <strong>Important:</strong> Most of the GLs configured here act as
                            <strong>default / backup accounts</strong>. When a product, operation type
                            or fee configuration does not provide a more specific GL, the system
                            will fall back to the corresponding mapping below.
                        </p>
                        <ul class="mb-0 small text-muted">
                            <li><strong>Cash in Hand (Till):</strong> Teller till GL. Debited when cash is received, credited when cash is paid at the counter.</li>
                            <li><strong>Vault:</strong> Branch vault GL used for vault stock and vault↔till transfers.</li>
                            <li><strong>Cash Surplus (Overage):</strong> Used when physical cash &gt; book balance after teller/vault reconciliation.</li>
                            <li><strong>Cash Deficit (Shortage):</strong> Used when physical cash &lt; book balance after reconciliation.</li>
                            <li><strong>Revenue / Partner / CamCCUL:</strong> Generic backup income/settlement GLs when the transaction or product does not provide a more specific GL.</li>
                            <li><strong>Head Office Liaison:</strong> Inter-branch bridge GL to HO; used for daily liaison/clearing between branch and HO.</li>
                            <li><strong>Loan Transit:</strong> Temporary holding GL for loans in transit between approval and final disbursement / posting.</li>
                            <li><strong>Commission, VAT & Interest Backup:</strong> Default GLs to capture fees, commissions, VAT and interest when the operation mapping does not specify them explicitly.</li>
                            <li><strong>Form Fee Income:</strong> Backup GL to capture application / form charges when not defined by the product.</li>
                        </ul>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Group 1: Core Cash Control -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-cash me-1"></i>Core Cash Control (Till &amp; Vault)
                    </h6>
                    <div class="row gy-3">
                        <!-- Cash In Hand (Till) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashInHandAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash in Hand Account (Till) --",
                                    new { @class = "form-select select2", id = "CashInHandAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashInHandAccountId, "", new { @class = "text-danger" })
                                <label>Cash In Hand (Till)</label>
                            </div>
                            <div class="form-text text-muted">
                                Teller cash holding GL for counter operations and end-of-day teller balancing.
                            </div>
                        </div>

                        <!-- Vault Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.VaultAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Vault Account --",
                                    new { @class = "form-select select2", id = "VaultAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.VaultAccountId, "", new { @class = "text-danger" })
                                <label>Vault Account</label>
                            </div>
                            <div class="form-text text-muted">
                                Main branch cash stock GL. Used for vault receipts, issues, and till↔vault transfers.
                            </div>
                        </div>

                        <!-- Surplus Income (Overage) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.SurplusIncomeAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Surplus Income Account --",
                                    new { @class = "form-select select2", id = "SurplusIncomeAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.SurplusIncomeAccountId, "", new { @class = "text-danger" })
                                <label>Cash Surplus (Overage)</label>
                            </div>
                            <div class="form-text text-muted">
                                Used when actual cash exceeds book balance after teller/vault reconciliation (overage).
                            </div>
                        </div>

                        <!-- Shortage Expense -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.ShortageExpenseAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Shortage Expense Account --",
                                    new { @class = "form-select select2", id = "ShortageExpenseAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.ShortageExpenseAccountId, "", new { @class = "text-danger" })
                                <label>Cash Deficit (Shortage)</label>
                            </div>
                            <div class="form-text text-muted">
                                Used when actual cash is below book balance after reconciliation (shortage).
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 2: Income & Generic Backup Revenue -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-cash-multiple me-1"></i>Income &amp; Generic Backup Revenue
                    </h6>
                    <div class="row gy-3">
                        <!-- Revenue Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.RevenueAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Revenue Account (Optional) --",
                                    new { @class = "form-select select2", id = "RevenueAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.RevenueAccountId, "", new { @class = "text-danger" })
                                <label>Revenue Account (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Default income GL for fees/charges when a product-specific revenue GL is not supplied.
                            </div>
                        </div>

                        <!-- Form Fee Income (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.FormFeeIncomeAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Form Fee Income Account (Optional) --",
                                    new { @class = "form-select select2", id = "FormFeeIncomeAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.FormFeeIncomeAccountId, "", new { @class = "text-danger" })
                                <label>Form Fee Income (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Income GL to record application / form charges when not mapped at product/operation level.
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 3: Inter-branch, Network & Partners -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-city-variant-outline me-1"></i>Inter-branch, Network &amp; Partner Settlement
                    </h6>
                    <div class="row gy-3">
                        <!-- Partner Account (optional) -->
                        <!-- Partner Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.PartnerAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Partner Account (Optional) --",
                                    new { @class = "form-select select2", id = "PartnerAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.PartnerAccountId, "", new { @class = "text-danger" })
                                <label>Partner Account (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Clearing / settlement GL for partner transactions (agents, wallets, third-party processors) when a specific GL is not defined.
                            </div>
                        </div>

                        <!-- CamCCUL Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CamcculAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select CamCCUL Account (Optional) --",
                                    new { @class = "form-select select2", id = "CamcculAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CamcculAccountId, "", new { @class = "text-danger" })
                                <label>CamCCUL Account (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Settlement GL for CamCCUL network postings when a more specific mapping is not provided.
                            </div>
                        </div>

                        <!-- NEW: MoMoCash Settlement Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.MomocashAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select MoMoCash Settlement Account --",
                                    new { @class = "form-select select2", id = "MomocashAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.MomocashAccountId, "", new { @class = "text-danger" })
                                <label>MoMoCash Settlement Account</label>
                            </div>
                            <div class="form-text text-muted">
                                Settlement GL for Mobile Money (MoMoCash) principal amounts (cash-in / cash-out) when no more specific mapping is provided.
                            </div>
                        </div>

                        <!-- NEW: MoMoCash Commission Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.MomocashCommissionGlId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select MoMoCash Commission Account --",
                                    new { @class = "form-select select2", id = "MomocashCommissionGlId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.MomocashCommissionGlId, "", new { @class = "text-danger" })
                                <label>MoMoCash Commission Account</label>
                            </div>
                            <div class="form-text text-muted">
                                Commission income GL for Mobile Money operations; used when operation or product configuration does not define a more specific commission GL.
                            </div>
                        </div>

                        <!-- Head Office Liaison Account -->
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.HeadOfficeLiaisonAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Head Office Liaison Account --",
                                    new { @class = "form-select select2", id = "HeadOfficeLiaisonAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.HeadOfficeLiaisonAccountId, "", new { @class = "text-danger" })
                                <label>Head Office Liaison Account</label>
                            </div>
                            <div class="form-text text-muted">
                                Inter-branch / HO bridge GL for daily liaison and settlement between the branch and head office.
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Group 4: Loan & Transit -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-bank-transfer-out me-1"></i>Loan Transit &amp; Interest
                    </h6>
                    <div class="row gy-3">
                        <!-- Loan Transit Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.LoanTransitAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Loan Transit Account --",
                                    new { @class = "form-select select2", id = "LoanTransitAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.LoanTransitAccountId, "", new { @class = "text-danger" })
                                <label>Loan Transit Account</label>
                            </div>
                            <div class="form-text text-muted">
                                Temporary GL to hold loan amounts in transit during approval / disbursement workflows when no more specific transit GL exists.
                            </div>
                        </div>

                        <!-- Interest Generated From Account (backup) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.InterestGeneratedFromAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Interest Income Backup Account --",
                                    new { @class = "form-select select2", id = "InterestGeneratedFromAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.InterestGeneratedFromAccountId, "", new { @class = "text-danger" })
                                <label>Interest Income (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Default interest income GL when a product/loan mapping does not provide a specific interest GL.
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 5: Commission, VAT & Fee Backup -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-percent-outline me-1"></i>Commission, VAT &amp; Fee Backup Accounts
                    </h6>
                    <div class="row gy-3">
                        <!-- Cash-In Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashInCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash-In Commission Backup Account --",
                                    new { @class = "form-select select2", id = "CashInCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashInCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>Cash-In Commission (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Commission income GL used when cash-in operations do not provide a specific commission GL.
                            </div>
                        </div>

                        <!-- Cash-Out Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashOutCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash-Out Commission Backup Account --",
                                    new { @class = "form-select select2", id = "CashOutCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashOutCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>Cash-Out Commission (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Commission income GL used when cash-out operations do not provide a specific commission GL.
                            </div>
                        </div>

                        <!-- Transfer Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.TransfterCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Transfer Commission Backup Account --",
                                    new { @class = "form-select select2", id = "TransfterCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.TransfterCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>Transfer Commission (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Commission income GL used when account-to-account / external transfers do not provide a dedicated commission GL.
                            </div>
                        </div>

                        <!-- VAT Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.VATAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select VAT Backup Account --",
                                    new { @class = "form-select select2", id = "VATAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.VATAccountId, "", new { @class = "text-danger" })
                                <label>VAT Account (Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                Default VAT liability GL when a fee/commission operation does not specify a VAT GL explicitly.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== Section 3: Operation Status ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="mdi mdi-cog-outline me-2"></i>Operation Status
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row gy-3">
                        <!-- Real-time Cash Posting -->
                        <div class="col-md-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.BranchCashConfig.RealTimeCashPosting, new { @class = "form-check-input", id = "RealTimeCashPosting" })
                                <label class="form-check-label" for="RealTimeCashPosting">
                                    Enable Real-time Cash Posting
                                </label>
                            </div>
                            <div class="form-text text-muted">
                                When enabled, cash operations hit the mapped GLs immediately; otherwise, postings can be deferred/queued.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-3 d-flex gap-2">
                <button type="submit" id="saveOrUpdateBtn" class="btn btn-primary">
                    @((isEdit) ? "Update" : "Save")
                </button>
                <button type="reset" class="btn btn-outline-secondary">Reset</button>
            </div>
        }
    </div>
</fieldset>

@section Scripts {
    @* Only auto-load accounts when the dropdown exists (create mode). In edit, there is no dropdown so nothing fires. *@
    <script>
        $(function () {
            var $branch = $('#BranchId');
            if ($branch.length && $branch.data('mode') === 'create') {
                var bid = $branch.val();
                if (bid && typeof window.fetchBranchDetails === 'function') {
                    window.fetchBranchDetails(bid);
                }
            }
        });
    </script>
}
