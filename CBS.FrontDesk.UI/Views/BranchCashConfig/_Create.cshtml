@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfigV.BranchCashConfigManagement
@using Resources
@{
    var isEdit = !string.IsNullOrWhiteSpace(Model?.BranchCashConfig?.Id) || (ViewBag.Id != null);

    // Try resolve branch name from ViewBag.Branches (expects objects with Id/Name)
    string resolvedBranchName = "";
    if (Model?.BranchCashConfig?.BranchId != null && ViewBag.Branches != null)
    {
        foreach (var b in (IEnumerable<dynamic>)ViewBag.Branches)
        {
            if ((string)b.Id == Model.BranchCashConfig.BranchId)
            {
                resolvedBranchName = (string)b.Name;
                break;
            }
        }
    }
}

<fieldset class="fieldset-custom">
    <legend id="select_base">@BranchCashConfigRessource.BRANCH_CASH_CONFIG</legend>
    <div class="card-body">
        @using (Html.BeginForm("CreateOrUpdate", "BranchCashConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(m => m.BranchCashConfig.Id)

            <!-- ===== Section 1: Branch ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="mdi mdi-office-building me-2"></i>@GlobalShared.Branch
                    </h6>
                </div>

                <div class="card-body">
                    <div class="row gy-3">

                        @if (!isEdit)
                        {
                            <!-- CREATE MODE: show dropdown, enable onchange -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(
                                        m => m.BranchCashConfig.BranchId,
                                        new SelectList(ViewBag.Branches, "Id", "Name"),
                                        "-- Select Branch --",
                                        new
                                        {
                                            @class = "form-select select2",
                                            id = "BranchId",
                                            @search = "true",
                                            data_mode = "create",
                                            onchange = "fetchBranchDetails(this.value)"
                                        }
                                    )
                                    @Html.ValidationMessageFor(m => m.BranchCashConfig.BranchId, "", new { @class = "text-danger" })
                                    <label for="BranchId">@GlobalShared.Branch</label>
                                </div>
                                <div class="form-text text-muted">
                                    @Html.Raw(@BranchCashConfigRessource.Selecting_a_branch_reloads_the_account_dropdowns_with_that_branchs_GL_accounts)
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- EDIT MODE: show read-only branch name, keep BranchId hidden -->
                            @Html.HiddenFor(m => m.BranchCashConfig.BranchId)

                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    <input type="text"
                                           class="form-control"
                                           id="BranchNameReadonly"
                                           value="@resolvedBranchName"
                                           readonly />
                                    <label for="BranchNameReadonly">@GlobalShared.Branch</label>
                                </div>
                                <div class="form-text text-muted">
                                    @BranchCashConfigRessource.Branch_is_fixed_for_this_configuration.
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- ===== Section 2: Mapping ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light d-flex align-items-center justify-content-between">
                    <h6 class="mb-0">
                        <i class="mdi mdi-link-variant me-2"></i>@BranchCashConfigRessource.Mapping_Fallback_Backup_Accounts
                    </h6>
                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#mappingTips" aria-expanded="false" aria-controls="mappingTips">
                        <i class="mdi mdi-information-outline me-1"></i> @GlobalShared.Tips
                    </button>
                </div>

                <!-- Mapping Tips -->
                <div id="mappingTips" class="collapse">
                    <div class="card-body pt-2">
                        <p class="small text-muted mb-2">
                            <strong>@GlobalShared.Important:</strong> @BranchCashConfigRessource.Most_of_the_GLs_configured_here_act_as <strong>@BranchCashConfigRessource.default_backup_accounts</strong>.
                            @BranchCashConfigRessource.When_a_product_operation_type_or_fee_configuration_does_not_provide_a_more_specific_GL_the_system_will_fall_back_to_the_corresponding_mapping_below
                        </p>
                        <ul class="mb-0 small text-muted">
                            <li><strong>@BranchCashConfigRessource.Cash_In_Hand_Till:</strong> @BranchCashConfigRessource.Teller_till_GL_Debited_when_cash_is_received_credited_when_cash_is_paid_at_the_counter.</li>
                            <li><strong>@GlobalShared.Vault:</strong> @BranchCashConfigRessource.Branch_vault_GL_used_for_vault_stock_and_vault_till_transfers.</li>
                            <li><strong>@BranchCashConfigRessource.Cash_Surplus_Overage:</strong> @Html.Raw(@BranchCashConfigRessource.Used_when_physical_cash_book_balance_after_teller_vault_reconciliation)</li>
                            <li><strong>@BranchCashConfigRessource.Cash_Deficit_Shortage:</strong> @Html.Raw(@BranchCashConfigRessource.Used_when_physical_cash_book_balance_after_reconciliation)</li>
                            <li><strong>@GlobalShared.Revenue / @GlobalShared.Partner / CamCCUL:</strong> @BranchCashConfigRessource.Generic_backup_income_settlement_GLs_when_the_transaction_or_product_does_not_provide_a_more_specific_GL</li>
                            <li><strong>@BranchCashConfigRessource.Head_Office_Liaison_Account:</strong> @BranchCashConfigRessource.Inter_branch_bridge_GL_to_HO_used_for_daily_liaison_clearing_between_branch_and_HO</li>
                            <li><strong>@BranchCashConfigRessource.Loan_Transit:</strong> @BranchCashConfigRessource.Temporary_holding_GL_for_loans_in_transit_between_approval_and_final_disbursement_posting</li>
                            <li><strong>@BranchCashConfigRessource.Commission_VAT_Interest_Backup:</strong> @BranchCashConfigRessource.Default_GLs_to_capture_fees_commissions_VAT_and_interest_when_the_operation_mapping_does_not_specify_them_explicitly.</li>
                            <li><strong>@BranchCashConfigRessource.Form_Fee_Income:</strong> @BranchCashConfigRessource.Backup_GL_to_capture_application_form_charges_when_not_defined_by_the_product.</li>
                        </ul>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Group 1: Core Cash Control -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-cash me-1"></i>@BranchCashConfigRessource.Core_Cash_Control_Till_Vault
                    </h6>
                    <div class="row gy-3">
                        <!-- Cash In Hand (Till) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashInHandAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash in Hand Account (Till) --",
                                    new { @class = "form-select select2", id = "CashInHandAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashInHandAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Cash_In_Hand_Till</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Teller_cash_holding_GL_for_counter_operations_and_end_of_day_teller_balancing
                            </div>
                        </div>

                        <!-- Vault Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.VaultAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Vault Account --",
                                    new { @class = "form-select select2", id = "VaultAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.VaultAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Vault_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Main_branch_cash_stock_GL_Used_for_vault_receipts_issues_and_till_vault_transfers
                            </div>
                        </div>

                        <!-- Surplus Income (Overage) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.SurplusIncomeAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Surplus Income Account --",
                                    new { @class = "form-select select2", id = "SurplusIncomeAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.SurplusIncomeAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Cash_Surplus_Overage</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Used_when_actual_cash_exceeds_book_balance_after_teller_vault_reconciliation_overage
                            </div>
                        </div>

                        <!-- Shortage Expense -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.ShortageExpenseAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Shortage Expense Account --",
                                    new { @class = "form-select select2", id = "ShortageExpenseAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.ShortageExpenseAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Cash_Deficit_Shortage</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Used_when_actual_cash_is_below_book_balance_after_reconciliation_shortage.
                            </div>
                        </div>
                        <!-- Cash Reversal Account -->
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashReversalAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash Reversal Account --",
                                    new { @class = "form-select select2", id = "CashReversalAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashReversalAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Cash_Reversal_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @Html.Raw(@BranchCashConfigRessource.Dedicated_GL_used_to_post_delayed_cash_reversals_for_cash_operations_whose_original_accounting_day_has_already_passed_ensuring_that_reversing_historical_cash_movements_does_not_impact_the_current_cash_position_till_or_vault_of_the_branch)
                                <br />
                                <strong>@GlobalShared.Note:</strong> @Html.Raw(@BranchCashConfigRessource.This_GL_is_not_used_for_same_day_reversals).
                                @Html.Raw(@BranchCashConfigRessource.When_a_reversal_is_performed_within_the_same_accounting_day_as_the_original_transaction),
                                @BranchCashConfigRessource.postings_are_made_directly_against_the_original_cash_accounts.
                            </div>


                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 2: Income & Generic Backup Revenue -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-cash-multiple me-1"></i>@Html.Raw(@BranchCashConfigRessource.Income_and_Generi_Backup_Revenue)
                    </h6>
                    <div class="row gy-3">
                        <!-- Revenue Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.RevenueAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Revenue Account (Optional) --",
                                    new { @class = "form-select select2", id = "RevenueAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.RevenueAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Revenue_Account (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Default_income_GL_for_fees_charges_when_a_product_specific_revenue_GL_is_not_supplied
                            </div>
                        </div>

                        <!-- Form Fee Income (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.FormFeeIncomeAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Form Fee Income Account (Optional) --",
                                    new { @class = "form-select select2", id = "FormFeeIncomeAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.FormFeeIncomeAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Form_Fee_Income (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Income_GL_to_record_application_form_charges_when_not_mapped_at_product_operation_level4
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 3: Inter-branch, Network & Partners -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-city-variant-outline me-1"></i>@Html.Raw(@BranchCashConfigRessource.Inter_branch_Network_and_Partner_Settlement)
                    </h6>
                    <div class="row gy-3">
                        <!-- Partner Account (optional) -->
                        <!-- Partner Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.PartnerAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Partner Account (Optional) --",
                                    new { @class = "form-select select2", id = "PartnerAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.PartnerAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Partner_Account (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Clearing_settlement_GL_for_partner_transactions_agents_wallets_third_party_processors_when_a_specific_GL_is_not_defined
                            </div>
                        </div>

                        <!-- CamCCUL Account (optional) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CamcculAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select CamCCUL Account (Optional) --",
                                    new { @class = "form-select select2", id = "CamcculAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CamcculAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.CamCCUL_Account (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Settlement_GL_for_CamCCUL_network_postings_when_a_more_specific_mapping_is_not_provided
                            </div>
                        </div>

                        <!-- NEW: MoMoCash Settlement Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.MomocashAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select MoMoCash Settlement Account --",
                                    new { @class = "form-select select2", id = "MomocashAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.MomocashAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.MoMoCash_Settlement_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Settlement_GL_for_Mobile_Money_MoMoCash_principal_amounts_cash_in_cash_out_when_no_more_specific_mapping_is_provided
                            </div>
                        </div>

                        <!-- NEW: MoMoCash Commission Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.MomocashCommissionGlId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select MoMoCash Commission Account --",
                                    new { @class = "form-select select2", id = "MomocashCommissionGlId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.MomocashCommissionGlId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.MoMoCash_Commission_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Commission_income_GL_for_Mobile_Money_operations_used_when_operation_or_product_configuration_does_not_define_a_more_specific_commission_GL
                            </div>
                        </div>

                        <!-- Head Office Liaison Account -->
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.HeadOfficeLiaisonAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Head Office Liaison Account --",
                                    new { @class = "form-select select2", id = "HeadOfficeLiaisonAccountId", required = "required" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.HeadOfficeLiaisonAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Head_Office_Liaison_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Inter_branch_HO_bridge_GL_for_daily_liaison_and_settlement_between_the_branch_and_head_office
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Group 4: Loan & Transit -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-bank-transfer-out me-1"></i>@Html.Raw(@BranchCashConfigRessource.Loan_Transit_And_Interest)
                    </h6>
                    <div class="row gy-3">
                        <!-- Loan Transit Account -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.LoanTransitAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Loan Transit Account --",
                                    new { @class = "form-select select2", id = "LoanTransitAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.LoanTransitAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Loan_Transit_Account</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Temporary_GL_to_hold_loan_amounts_in_transit_during_approval_disbursement_workflows_when_no_more_specific_transit_GL_exists
                            </div>
                        </div>

                        <!-- Interest Generated From Account (backup) -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.InterestGeneratedFromAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Interest Income Backup Account --",
                                    new { @class = "form-select select2", id = "InterestGeneratedFromAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.InterestGeneratedFromAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Interest_Income (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Default_interest_income_GL_when_a_product_loan_mapping_does_not_provide_a_specific_interest_GL
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Group 5: Commission, VAT & Fee Backup -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-percent-outline me-1"></i>@Html.Raw(@BranchCashConfigRessource.Commission_VAT_amp_Fee_Backup_Accounts)
                    </h6>
                    <div class="row gy-3">
                        <!-- Cash-In Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashInCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash-In Commission Backup Account --",
                                    new { @class = "form-select select2", id = "CashInCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashInCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Cash_In_Commission (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Commission_income_GL_used_when_cash_in_operations_do_not_provide_a_specific_commission_GL
                            </div>
                        </div>

                        <!-- Cash-Out Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.CashOutCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Cash-Out Commission Backup Account --",
                                    new { @class = "form-select select2", id = "CashOutCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.CashOutCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Cash_Out_Commission (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Commission_income_GL_used_when_cash_out_operations_do_not_provide_a_specific_commission_GL
                            </div>
                        </div>

                        <!-- Transfer Commission Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.TransfterCommisionAccountIDAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Transfer Commission Backup Account --",
                                    new { @class = "form-select select2", id = "TransfterCommisionAccountIDAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.TransfterCommisionAccountIDAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Transfer_Commission (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Commission_income_GL_used_when_account_to_account_external_transfers_do_not_provide_a_dedicated_commission_GL
                            </div>
                        </div>

                        <!-- VAT Backup -->
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.VATAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select VAT Backup Account --",
                                    new { @class = "form-select select2", id = "VATAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.VATAccountId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.VAT_Account (@GlobalShared.Backup)</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.Default_VAT_liability_GL_when_a_fee_commission_operation_does_not_specify_a_VAT_GL_explicitly
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Group 6: Global Fallback Suspense GL -->
                    <h6 class="text-uppercase text-muted small mb-3">
                        <i class="mdi mdi-alert-outline me-1"></i>@BranchCashConfigRessource.Global_Fallback_Suspense_GL
                    </h6>
                    <div class="row gy-3">
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(
                                    m => m.BranchCashConfig.FallbackSuspenseAccountId,
                                    new SelectList(ViewBag.BranchAccounts ?? new List<object>(), "Value", "Text"),
                                    "-- Select Fallback Suspense GL --",
                                    new { @class = "form-select select2", id = "FallbackSuspenseAccountId" }
                                )
                                @Html.ValidationMessageFor(m => m.BranchCashConfig.FallbackSuspenseAccountId, "", new { @class = "text-danger" })
                                <label>@BranchCashConfigRessource.Fallback_Suspense_GL</label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.This_GL_is_used_as_a_last_resort_suspense_account_when_the_system_cannot_resolve_a_more_specific_Branch_GL_missing_Affiliate_Branch_mapping_invalid_config
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="small text-muted">
                                <strong>@GlobalShared.Implication:</strong> @BranchCashConfigRessource.when_resolution_fails_postings_are_directed_here_instead_of_failing
                                @Html.Raw(@BranchCashConfigRessource.Each_such_posting_is_logged_for_EOD_review_including_the_supposed_GL_the_actual_suspense_GL_and_the_amount_If_this_field_is_left_empty_the_system_will_attempt_to_auto_create_the_affiliated_GL_at_the_level_of_the_Branch_GL_accounts_and_use_it_but_this_is_not_recommended_because_it_scatters_suspense_balances_across_multiple_GLs)
                                <br />
                                <strong>@GlobalShared.Best_Practice:</strong> @BranchCashConfigRessource.configure_a_single_controlled_suspense_GL_per_branch_here_and_reclassify_its_balance_during_End_of_Day_using_the_fallback_mapping_console
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== Section 3: Operation Status ===== -->
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="mdi mdi-cog-outline me-2"></i>@GlobalShared.Operation_Status
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row gy-3">
                        <!-- Real-time Cash Posting -->
                        <div class="col-md-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.BranchCashConfig.RealTimeCashPosting, new { @class = "form-check-input", id = "RealTimeCashPosting" })
                                <label class="form-check-label" for="RealTimeCashPosting">
                                    @BranchCashConfigRessource.Enable_Real_time_Cash_Posting
                                </label>
                            </div>
                            <div class="form-text text-muted">
                                @BranchCashConfigRessource.When_enabled_cash_operations_hit_the_mapped_GLs_immediately_otherwise_postings_can_be_deferred_queued
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-3 d-flex gap-2">
                <button type="submit" id="saveOrUpdateBtn" class="btn btn-primary">
                    @((isEdit) ? "Update" : "Save")
                </button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            </div>
        }
    </div>
</fieldset>

@section Scripts {
    @* Only auto-load accounts when the dropdown exists (create mode). In edit, there is no dropdown so nothing fires. *@
    <script>
        $(function () {
            var $branch = $('#BranchId');
            if ($branch.length && $branch.data('mode') === 'create') {
                var bid = $branch.val();
                if (bid && typeof window.fetchBranchDetails === 'function') {
                    window.fetchBranchDetails(bid);
                }
            }
        });
    </script>
}
