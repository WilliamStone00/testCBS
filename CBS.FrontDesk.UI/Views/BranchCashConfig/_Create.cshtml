@model CBS.FrontDesk.Data.Entity.AccountingV2.BranchCashConfig.BranchCashConfigDto
@using Resources

@{
    // Determine the title based on the Model ID
    var isEditMode = !string.IsNullOrEmpty(Model?.Id);
    var formTitle = isEditMode
        ? $"Edit GL Configuration for {ViewBag.CurrentBranchName}"
        : $"Create GL Configuration for {ViewBag.CurrentBranchName}";
}

<div class="row mb-3">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOne">
                    <button type="button"
                            class="accordion-button text-primary"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-1"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-1">
                        <i class="mdi mdi-bank-outline me-2"></i> @formTitle
                    </button>
                </h2>

                <div id="accordionPopoutIcon-1" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">

                        <div class="alert alert-info mb-4">
                            <div class="d-flex align-items-center">
                                <i class="mdi mdi-office-building me-2 mdi-24px"></i>
                                <div>
                                    <h6 class="alert-heading mb-1">Configuring for: @ViewBag.CurrentBranchName</h6>
                                    <p class="mb-0">This configuration will apply to all cash operations for the selected branch.</p>
                                </div>
                            </div>
                        </div>

                        <form asp-action="CreateOrUpdate" method="post" id="branchCashConfigForm">
                            @Html.AntiForgeryToken()

                            @* Hidden Fields for necessary IDs *@
                            @Html.HiddenFor(m => m.Id)
                            @Html.HiddenFor(m => m.BranchId)
                            @* NOTE: RequestedBy removed as it was not in your DTO. *@

                            <h5 class="mb-3 text-primary">Core Cash Configuration</h5>
                            <div class="row mb-3">
                                @* Branch Name (Read-Only Context) *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.BranchName, "Branch Name", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.BranchName, new { @class = "form-control", @readonly = "readonly" })
                                </div>

                                @* Cash In Hand Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.CashInHandAccountId, "Cash in Hand Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.CashInHandAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Cash in Hand Account --", new { @class = "form-select select2", required = "required" })
                                    @Html.ValidationMessageFor(m => m.CashInHandAccountId, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="row mb-4">
                                @* Vault Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.VaultAccountId, "Vault Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.VaultAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Vault Account --", new { @class = "form-select select2", required = "required" })
                                    @Html.ValidationMessageFor(m => m.VaultAccountId, "", new { @class = "text-danger small" })
                                </div>

                                @* Real-Time Posting Switch *@
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark">Enable Real-Time Cash Posting?</label>
                                    <div class="form-check form-switch mt-2">
                                        @Html.CheckBoxFor(m => m.RealTimeCashPosting, new { @class = "form-check-input" })
                                        <label class="form-check-label">Activate automatic posting during transactions</label>
                                    </div>
                                    <small class="form-text text-muted">
                                        When enabled, cash transactions post automatically to GL upon execution.
                                    </small>
                                </div>
                            </div>

                            <h5 class="mb-3 text-primary mt-3 pt-3 border-top">Profit & Loss Configuration</h5>
                            <div class="row mb-3">
                                @* Surplus Income Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.SurplusIncomeAccountId, "Surplus Income Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.SurplusIncomeAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Surplus Income Account --", new { @class = "form-select select2", required = "required" })
                                    @Html.ValidationMessageFor(m => m.SurplusIncomeAccountId, "", new { @class = "text-danger small" })
                                </div>

                                @* Shortage Expense Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.ShortageExpenseAccountId, "Shortage Expense Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.ShortageExpenseAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Shortage Expense Account --", new { @class = "form-select select2", required = "required" })
                                    @Html.ValidationMessageFor(m => m.ShortageExpenseAccountId, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="row mb-4">
                                @* Revenue Account (Optional) *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.RevenueAccountId, "Revenue Account (Optional)", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.RevenueAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Revenue Account --", new { @class = "form-select select2" })
                                </div>

                                @* Form Fee Income Account (Optional) *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.FormFeeIncomeAccountId, "Form Fee Income Account (Optional)", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.FormFeeIncomeAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Form Fee Income Account --", new { @class = "form-select select2" })
                                </div>
                            </div>

                            <h5 class="mb-3 text-primary mt-3 pt-3 border-top">Commission & Inter-Branch Accounts</h5>
                            <div class="row mb-3">
                                @* Source Branch Commission Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.SourceBranchAccountId, "Source Branch Commission Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.SourceBranchAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Source Branch Account --", new { @class = "form-select select2" })
                                </div>

                                @* Destination Commission Branch Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.DestinationBranchAccountId, "Destination Commission Branch Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.DestinationBranchAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Destination Branch Account --", new { @class = "form-select select2" })
                                </div>
                            </div>

                            <div class="row mb-3">
                                @* Head Office Commission Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.HeadOfficeAccountId, "Head Office Commission Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.HeadOfficeAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Head Office Account --", new { @class = "form-select select2" })
                                </div>

                                @* Partner Commission Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.PartnerAccountId, "Partner Commission Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.PartnerAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Partner Account --", new { @class = "form-select select2" })
                                </div>
                            </div>

                            <div class="row mb-4">
                                @* Camccul Commission Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.CamcculAccountId, "Camccul Commission Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.CamcculAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Camccul Account --", new { @class = "form-select select2" })
                                </div>

                                @* Head Office Commission Liaison Account *@
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.HeadOfficeLiaisonAccountId, "Head Office Commission Liaison Account", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.HeadOfficeLiaisonAccountId, new SelectList(ViewBag.BranchAccounts, "Id", "Name"), "-- Select Head Office Liaison Account --", new { @class = "form-select select2" })
                                </div>
                            </div>

                            @* Submit/Reset Buttons *@
                            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="mdi mdi-content-save-outline me-1"></i>
                                    @(isEditMode ? "Update Configuration" : "Save Configuration")
                                </button>

                                <button type="reset" class="btn btn-outline-secondary">
                                    <i class="mdi mdi-refresh me-1"></i> Reset
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>