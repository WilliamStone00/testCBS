@model CBS.FrontDesk.Data.Entity.SavingProducts.CashReplenishmentPrimaryTeller
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalPrimaryTellerCashRequisition.RequestFilters</legend>
    <hr />
    <div class="row g-4">
        <div class="col-md-6">
            <label for="branchInput">@GlobalPrimaryTellerCashRequisition.Branch</label>
            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ @GlobalPrimaryTellerCashRequisition.SelectBranch+"---", new { @class = "form-control select2", @id = "branchInput" })
        </div>
        <div class="col-md-6">
            <div class="row g-4">
                <div class="col-md-6">
                    <label for="dateFromInput">@GlobalPrimaryTellerCashRequisition.DateFrom</label>
                    <div class="input-group">
                        <input type="date" id="dateFromInput" class="form-control shadow-box date-picker" placeholder="@GlobalPrimaryTellerCashRequisition.DateFrom">
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="dateToInput">@GlobalPrimaryTellerCashRequisition.DateTo</label>
                    <div class="input-group">
                        <input type="date" id="dateToInput" class="form-control shadow-box date-picker" placeholder="@GlobalPrimaryTellerCashRequisition.DateTo">
                        <button class="btn btn-primary btn-sm" onclick="SearchByDates('_PrimaryTellerCashRequisitionData','datalistingview','PrimaryTellerCashRequisition')">@GlobalShared.Search</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</fieldset>

