@model CBS.FrontDesk.Data.Entity.SavingProducts.CashReplenishmentPrimaryTeller
    @using Resources
@using (Html.BeginForm("Create", "PrimaryTellerCashRequisition", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RequestedAmount)

    <fieldset class="fieldset-custom">
        <legend id="select_base">@GlobalShared.request_validation</legend>
        <div class="row mt-2 gy-4">

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box float-start">@GlobalShared.Requested_Amount: @Model.RequestedAmount.ToString("#,##0.0")</span>
                </div>
            </div>
            <div class="col-md-6" hidden="hidden">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@GlobalShared.Total_amount: 0.0</span>
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalProvision" value="@Model.RequestedAmount">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    <span class="formatted-amount shadow-box" id="lblBalance">@GlobalShared.Balance: @Model.RequestedAmount.ToString("#,##0.0")</span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.Requetcomment, new { @class = "form-control", @style = "height: 70px;" })
                    @Html.ValidationMessageFor(m => m.Requetcomment, "", new { @class = "text-danger " })
                    <label for="formValidationDob">@GlobalShared.Request_note</label>
                </div>
            </div>
            <legend>Denomination</legend>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CurrencyNote.note10000, new { @class = "form-control", @id = "Notes_note10000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CurrencyNote.note10000, "", new { @class = "text-danger " })
                    <label>N10,000</label>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CurrencyNote.note5000, new { @class = "form-control", @id = "Notes_note5000", @oninput = "calculateBalance()" })
                    @Html.ValidationMessageFor(m => m.CurrencyNote.note5000, "", new { @class = "text-danger " })
                    <label>N5,000</label>
