            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.ApprovedComment, new { @class = "form-control", @style = "height: 70px;" })
                    @Html.ValidationMessageFor(m => m.ApprovedComment, "", new { @class = "text-danger " })
                    <label for="formValidationDob">@GlobalShared.Approval_note</label>
                </div>
            </div>

        </div>
        <div class="mt-4">
            <button type="submit" id="btnSave" class="btn btn-primary me-2">@GlobalShared.Approved</button>
        </div>
    </fieldset>
}
