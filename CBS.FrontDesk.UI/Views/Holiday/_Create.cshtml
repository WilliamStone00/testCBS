@model CBS.FrontDesk.Data.Entity.AccountingDayObject.HolyDay
<fieldset class="fieldset-custom">
    <legend id="select_base">Set Holidays</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Holiday", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(model => model.Id)
        <div class="row mt-3 gy-4">
            <!-- Event Name -->
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.EventName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EventName, "", new { @class = "text-danger" })
                    <label for="EventName">Event Name</label>
                </div>
            </div>

            <!-- Begin Date -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.DateFromStr, new { @class = "form-control date-picker" })
                    @Html.ValidationMessageFor(m => m.DateFromStr, "", new { @class = "text-danger" })
                    <label for="DateFrom">Begin Date</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.DateToStr, new { @class = "form-control date-picker" })
                    @Html.ValidationMessageFor(m => m.DateToStr, "", new { @class = "text-danger" })
                    <label for="DateTo">End Date</label>
                </div>
            </div>


            <!-- Centralisation Status -->
            <div class="col-md-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsCentralisedConfiguration, new { @class = "form-check-input", id = "isCentralisedCheck" })
                    <label class="form-check-label" for="isCentralisedCheck" id="isCentralisedLabel">Check to centralise</label>
                </div>
            </div>

            <!-- Branch Selection -->
            <div class="col-md-12" id="mfi" style="display:block;">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches, "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2", id = "BranchId", @search = "true" }
                    )
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label for="BranchId">Select Branch</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 200px;" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <label>Description</label>

                </div>
            </div>
            <!-- Active Status -->
            <div class="col-md-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActive" })
                    <label class="form-check-label" for="isActive">Active Status</label>
                </div>
            </div>
        </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>
                }
            </div>
        }
    </div>
</fieldset>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isCentralisedCheck = document.getElementById("isCentralisedCheck");
        const mfiSection = document.getElementById("mfi");

        // Function to toggle visibility of mfi div
        function toggleMfiSection() {
            if (isCentralisedCheck.checked) {
                mfiSection.style.display = "none"; // Hide the branch selection
            } else {
                mfiSection.style.display = "block"; // Show the branch selection
            }
        }

        // Call the function on page load to set the initial state
        toggleMfiSection();

        // Add an event listener to handle checkbox state changes
        isCentralisedCheck.addEventListener("change", toggleMfiSection);
    });

    (function () {
        const phoneMaskList = document.querySelectorAll('.phone-mask'),
            creditCardMask = document.querySelector('.credit-card-mask'),
            expiryDateMask = document.querySelector('.expiry-date-mask'),
            cvvMask = document.querySelector('.cvv-code-mask'),
            datepickerList = document.querySelectorAll('.date-picker'),
            formCheckInputPayment = document.querySelectorAll('.form-check-input-payment');

     
        // Expiry Date Mask
        if (expiryDateMask) {
            new Cleave(expiryDateMask, {
                date: true,
                delimiter: '/',
                datePattern: ['m', 'y']
            });
        }


        // Flat Picker Birth Date
        if (typeof datepickerList != undefined) {
            datepickerList.flatpickr({
                mode: 'range'
            });
        }
       
    })();

</script>


