@model List<CBS.FrontDesk.Data.Entity.AccountingDayObject.HolyDay>

<fieldset class="fieldset-custom">
    <legend id="select_base">Configured Holiday Data</legend>
    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>No holiday is configured yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%;">Event</th>
                        <th style="width: 12%;">Begin Date</th>
                        <th style="width: 12%;">End Date</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 15%;">Centralised</th>
                        <th style="width: 15%;">Branch</th>
                        <th style="width: 16%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var holiday in Model)
                    {
                        <tr>
                            <td>@holiday.EventName</td>
                            <td>@holiday.DateFrom.ToString("dd-MM-yyyy")</td>
                            <td>@holiday.DateTo.ToString("dd-MM-yyyy")</td>
                            <td>
                                @if (holiday.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success fs-6">
                                        <i class="fas fa-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger fs-6">
                                        <i class="fas fa-times-circle"></i> Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                @if (holiday.IsCentralisedConfiguration)
                                {
                                    <span class="badge rounded-pill bg-primary fs-6">
                                        <i class="fas fa-globe"></i> Centralised
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary fs-6">
                                        <i class="fas fa-building"></i> Branch-specific
                                    </span>
                                }
                            </td>

                            <td>@(holiday.Branch?.Name ?? "N/A")</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                            onclick="AddORUpdateGen('@holiday.Id', 'datalistingview', '_Create', 'update', 'Holiday', null, null)"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Edit @holiday.EventName">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                            onclick="DeleteRecordDataTable('Holiday', '@holiday.Id', 'myDataTable', '_Data', 0, 'datalistingview', null, 'list')"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Delete @holiday.EventName">
                                        <i class="fas fa-trash-alt me-1"></i> Delete
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
