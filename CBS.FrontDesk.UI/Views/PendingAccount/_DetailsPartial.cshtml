@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountDto

<fieldset class="fieldset-custom">

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-book-open-page-variant-outline me-2"></i> Account Request Details
            </h1>
            <p class="card-text text-muted mb-1">
                Detailed view of the selected account record.
            </p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Identity & Hierarchy -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> Identity & Hierarchy</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Id</td><td>@(Model?.Id ?? "-")</td></tr>
                <tr><td class="fw-bold">Scope</td><td>@(Model?.Scope ?? "-")</td></tr>
                <tr><td class="fw-bold">Code</td><td>@(Model?.Code ?? "-")</td></tr>
                <tr><td class="fw-bold">Name (EN)</td><td>@(Model?.NameEn ?? "-")</td></tr>
                <tr><td class="fw-bold">Name (FR)</td><td>@(Model?.NameFr ?? "-")</td></tr>
                <tr><td class="fw-bold">Class</td><td>@(Model?.Class ?? "-")</td></tr>
                <tr><td class="fw-bold">Name</td><td>@(Model?.Name ?? "-")</td></tr>
                <tr><td class="fw-bold">Parent Id</td><td>@(Model?.ParentId ?? "-")</td></tr>
                <tr><td class="fw-bold">Path Seed</td><td>@(Model?.PathSeed ?? "-")</td></tr>
                <tr><td class="fw-bold">Depth Seed</td><td>@(Model?.DepthSeed?.ToString() ?? "-")</td></tr>
            </table>
        </div>

        <!-- Right Column: Accounts & Posting -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> Account Mapping & Flags</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Affiliate Id</td><td>@(Model?.AffiliateId ?? "-")</td></tr>
                <tr><td class="fw-bold">Branch Id</td><td>@(Model?.BranchId ?? "-")</td></tr>
                <tr><td class="fw-bold">Affiliate Account Id</td><td>@(Model?.AffiliateAccountId ?? "-")</td></tr>
                <tr><td class="fw-bold">Ho PCMF Account Id</td><td>@(Model?.HoPcmfAccountId ?? "-")</td></tr>
                <tr><td class="fw-bold">Posting Allowed</td><td>@(Model?.PostingAllowed == true ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Requires Mapping</td><td>@(Model?.RequiresMapping == true ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">Reference</td><td>@(Model?.Reference ?? "-")</td></tr>
                <tr><td class="fw-bold">Correlation Id</td><td>@(Model?.CorrelationId ?? "-")</td></tr>
                <tr><td class="fw-bold">Status</td><td>@(Model?.Status ?? "-")</td></tr>
            </table>
        </div>
    </div>

    <!-- Request / Approval Section -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-account-check-outline me-2"></i> Request & Approval</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Requested By</td><td>@(Model?.RequestedBy ?? "-")</td></tr>
                <tr>
                    <td class="fw-bold">Requested At (UTC)</td>
                    <td>@(Model?.RequestedAtUtc != null ? ((DateTime)Model.RequestedAtUtc).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                </tr>

                <tr><td class="fw-bold">Approved By</td><td>@(Model?.ApprovedBy ?? "-")</td></tr>
                <tr>
                    <td class="fw-bold">Approved At (UTC)</td>
                    <td>@(Model?.ApprovedAtUtc != null ? ((DateTime)Model.ApprovedAtUtc).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                </tr>

                <tr><td class="fw-bold">Rejected By</td><td>@(Model?.RejectedBy ?? "-")</td></tr>
                <tr>
                    <td class="fw-bold">Rejected At (UTC)</td>
                    <td>@(Model?.RejectedAtUtc != null ? ((DateTime)Model.RejectedAtUtc).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                </tr>

                <tr><td class="fw-bold">Rejection Reason</td><td>@(string.IsNullOrWhiteSpace((string)Model?.RejectionReason) ? "-" : Model.RejectionReason)</td></tr>
                <tr><td class="fw-bold">Requested Notes</td><td>@(string.IsNullOrWhiteSpace((string)Model?.Notes) ? "-" : Model.Notes)</td></tr>
            </table>
        </div>
    </div>

    <!-- Audit & Lifecycle Section -->
    <div class="row mt-3">
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> Audit</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <td class="fw-bold">Created Date</td>
                    <td>@(Model?.CreatedDate != null ? ((DateTime)Model.CreatedDate).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">Modified Date</td>
                    <td>@(Model?.ModifiedDate != null ? ((DateTime)Model.ModifiedDate).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                </tr>
                <tr><td class="fw-bold">Is Deleted</td><td>@(Model?.IsDeleted == true ? "Yes" : "No")</td></tr>
            </table>
        </div>

        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-clipboard-text-outline me-2"></i> Other Metadata</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Requested / Approval Reference</td><td>@(Model?.Reference ?? "-")</td></tr>
                <tr><td class="fw-bold">Correlation Id</td><td>@(Model?.CorrelationId ?? "-")</td></tr>
                <tr><td class="fw-bold">Status</td><td>@(Model?.Status ?? "-")</td></tr>
            </table>
        </div>
    </div>

</fieldset>
