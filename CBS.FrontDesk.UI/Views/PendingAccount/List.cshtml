@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountQuery
@using Resources
@{
    ViewBag.Title = "Account Request - Filters";
    // ViewBag.Classes expected as: IEnumerable<SelectListItem>
    // e.g. in controller:
    // var classes = _chartOfAccountsV.GetAllClass2();
    // ViewBag.Classes = classes;
    var scopeItems = new List<SelectListItem> {
       new SelectListItem { Text = "All", Value = "" },
       new SelectListItem { Text = "Branch", Value = "Branch" },
       new SelectListItem { Text = "Affiliate", Value = "Affiliate" }
   };

    var statusItems = new List<SelectListItem> {
       new SelectListItem { Text = "All", Value = "" },
       new SelectListItem { Text = "Pending", Value = "Pending" },
       new SelectListItem { Text = "Validated", Value = "Validated" },
       new SelectListItem { Text = "Approved", Value = "Approved" },
       new SelectListItem { Text = "Rejected", Value = "Rejected" }
   };

    var changeTypeItems = new List<SelectListItem> {
       new SelectListItem { Text = "All", Value = "" },
       new SelectListItem { Text = "Create Request", Value = "CreateRequest" },
       new SelectListItem { Text = "Update Request", Value = "UpdateRequest" }
   };

    var languageItems = new List<SelectListItem> {
       new SelectListItem { Text = "Default", Value = "" },
       new SelectListItem { Text = "English", Value = "en" },
       new SelectListItem { Text = "Français", Value = "fr" }
   };

  

}

<!-- Header (unchanged) -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center py-3">
                <h1 class="card-title text-primary mb-1"><i class="mdi mdi-file-document-outline me-2"></i> Account Request Listing</h1>
                <p class="card-text mb-0">Use this form to filter account requests before validation, approval or rejection.</p>
                <hr class="mt-3 mb-0" style="border: 2px solid rgba(128,128,128,.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips (unchanged id fix) -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary py-2">
        <span class="fw-semibold"><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePendingAccountTips" aria-expanded="false" aria-controls="collapsePendingAccountTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapsePendingAccountTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>Scope:</strong> Select the request scope to limit results.</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>Affiliate / Branch:</strong> Filter by ownership.</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>Status & Change Type:</strong> Pending/Approved/Rejected & Create/Update request.</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>Created Dates (UTC):</strong> Filter by submission window.</li>
                <li><i class="mdi mdi-translate-variant text-info me-2"></i><strong>Language:</strong> Prefer EN/FR naming when searching by Name.</li>
            </ul>
        </div>
    </div>
</div>


<div class="card shadow p-3 mb-4">
    @using (Html.BeginForm("Index", "PendingAccount", FormMethod.Get, new { id = "affiliateFilterForm", autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()

        @* -------- CONTEXT -------- *@
        <div class="mb-1">
            <div class="row g-2">
               @* <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.AffiliateId, "Affiliate", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.AffiliateId,
                      new SelectList(ViewBag.Affiliates ?? new List<SelectListItem>(), "Id", "Name", Model?.AffiliateId),
                      "--- Select Affiliate ---",
                      new { @class = "form-select select2", id = "AffiliateId" })
                    @Html.ValidationMessageFor(m => m.AffiliateId, "", new { @class = "text-danger" })
                </div>*@

                <div class="col-lg-6 col-md-6 mb-2">
                    @Html.LabelFor(m => m.BranchId, "Branch", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.BranchId,
                      new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name", Model?.BranchId),
                      "--- Select Branch ---",
                      new { @class = "form-select select2", id = "BranchId" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-6 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Scope, "Request Scope", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Scope,
                      new List<SelectListItem> {
                        new SelectListItem { Text = "All", Value = "" },
                        new SelectListItem { Text = "Branch", Value = "Branch" },
                        new SelectListItem { Text = "Affiliate", Value = "Affiliate" }
                      },
                      new { @class = "form-select select2", id = "Scope" })
                    @Html.ValidationMessageFor(m => m.Scope, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        @* -------- ATTRIBUTES -------- *@
        <div class="mb-1">
            <div class="row g-2">

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Code, "Account Code (requested)", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "e.g. 5121000000", id = "Code" })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Class, "Account Class", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(
                            m => m.Class,
                            new SelectList(ViewBag.Classes, "Value", "Text"),
                            "--- Select Class ---",
                            new { @class = "form-select form-select-sm select2", id = "Class" })
                 
                    @Html.ValidationMessageFor(m => m.Class, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Status, "Request Status", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Status,
                      new List<SelectListItem> {
                        new SelectListItem { Text = "All", Value = "" },
                        new SelectListItem { Text = "Pending", Value = "Pending" },
                        new SelectListItem { Text = "Validated", Value = "Validated" },
                        new SelectListItem { Text = "Approved", Value = "Approved" },
                        new SelectListItem { Text = "Rejected", Value = "Rejected" }
                      },
                      new { @class = "form-select select2", id = "Status" })
                    @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.ChangeType, "Change Type", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.ChangeType,
                      new List<SelectListItem> {
                        new SelectListItem { Text = "All", Value = "" },
                        new SelectListItem { Text = "CreateRequest", Value = "CreateRequest" },
                        new SelectListItem { Text = "UpdateRequest", Value = "UpdateRequest" }
                      },
                      new { @class = "form-select select2", id = "ChangeType" })
                    @Html.ValidationMessageFor(m => m.ChangeType, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.UpdateReference, "Update Target (Id / Code)", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.UpdateReference, new { @class = "form-control", placeholder = "Only for UpdateRequest", id = "UpdateReference" })
                    @Html.ValidationMessageFor(m => m.UpdateReference, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Name, "Account Name (search)", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Matches EN/FR based on Language", id = "Name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.Language, "Preferred Name Language", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Language,
                      new List<SelectListItem> {
                        new SelectListItem { Text = "Default", Value = "" },
                        new SelectListItem { Text = "English", Value = "en" },
                        new SelectListItem { Text = "Français", Value = "fr" }
                      },
                      new { @class = "form-select select2", id = "Language" })
                    @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.RequestedBy, "Requested By (user)", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.RequestedBy, new { @class = "form-control", placeholder = "Username / Id", id = "RequestedBy" })
                    @Html.ValidationMessageFor(m => m.RequestedBy, "", new { @class = "text-danger" })
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    @Html.LabelFor(m => m.ApprovedBy, "Approved By (user)", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.ApprovedBy, new { @class = "form-control", placeholder = "Username / Id", id = "ApprovedBy" })
                    @Html.ValidationMessageFor(m => m.ApprovedBy, "", new { @class = "text-danger" })
                </div>

            </div>
        </div>

        @* -------- DATE RANGE -------- *@
        <div class="mb-1">
            <div class="d-flex align-items-center justify-content-between">
                <h6 class="text-muted fw-bold mb-2"><i class="mdi mdi-calendar-range me-1"></i> Date Range (UTC)</h6>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="toggleCreatedDates"
                           onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                    <label class="form-check-label fw-bold" for="toggleCreatedDates">Show</label>
                </div>
            </div>

            <div id="createdDateFilters" class="d-none">
                <div class="row g-2">
                    <div class="col-md-6 mb-2">
                        @Html.LabelFor(m => m.CreatedFromUtc, "Created From (UTC)", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.CreatedFromUtc, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", id = "CreatedFromUtc" })
                        @Html.ValidationMessageFor(m => m.CreatedFromUtc, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-2">
                        @Html.LabelFor(m => m.CreatedToUtc, "Created To (UTC)", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.CreatedToUtc, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", id = "CreatedToUtc" })
                        @Html.ValidationMessageFor(m => m.CreatedToUtc, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        @* -------- OPTIONS -------- *@
        <div>
            <div class="row g-2 align-items-center">
                <div class="col-md-6 mb-2">
                    <div class="form-check">
                        @{
                            // Fix for bool? — use Html.CheckBox(name, isChecked, attrs)
