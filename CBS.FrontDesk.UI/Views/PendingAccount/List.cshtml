@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountQuery
@using Resources
@{
    ViewBag.Title = "Account Request - Filters";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-document-outline me-2"></i> Account Request Listing
                </h1>
                <p class="card-text">
                    Use this form to filter account requests before validation, approval or rejection.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                    <strong>Scope:</strong> Select the request scope (e.g., 'local', 'global') to limit results.
                </li>
                <li>
                    <i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i>
                    <strong>Affiliate / Branch:</strong> Use Affiliate Id or Branch Id to find requests tied to an affiliate or specific branch.
                </li>
                <li>
                    <i class="mdi mdi-filter-outline text-secondary me-2"></i>
                    <strong>Status:</strong> Filter by request status (Pending, Validated, Rejected, Approved).
                </li>
                <li>
                    <i class="mdi mdi-calendar-range text-info me-2"></i>
                    <strong>Created Dates:</strong> Use Created From / To (UTC) to narrow by submission date.
                </li>
                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                    <strong>Validation & Rejection:</strong> Requests flagged as invalid will appear under <em>Rejected</em>. Use Status to identify and re-process those for correction.
                </li>
                <li>
                    <i class="mdi mdi-checkbox-marked-circle-outline text-success me-2"></i>
                    <strong>Include Deleted:</strong> Toggle to include soft-deleted requests in results.
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Account Request Filters (bound to AffiliateAccountQuery-like object) -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Account Request Filters</h5>

    <form id="affiliateFilterForm" autocomplete="off" method="get" action="@Url.Action("Index")">
        <!-- If your controller expects POST change here and include @Html.AntiForgeryToken() -->

        <div class="card p-3 mb-3 bg-light">
            <div class="row mb-3">              

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.DropDownListFor(m => m.AffiliateId, new SelectList(ViewBag.Affiliates, "Id", "name"), "--- " + "Select Affiliate" + " ---", new { @class = "form-select select2" })
                            @Html.ValidationMessageFor(m => m.AffiliateId, "", new { @class = "text-danger" })
                            <label>AffiliateId</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })

                        <label>@GlobalUserManagement.Branch</label>
                    </div>
                </div>
            </div>

            <!-- Code, Class, Status -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">@AccountingV2.Code</label>
                    <input type="text" id="code" name="Code" class="form-control" placeholder="Affiliate code" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Class</label>
                    <input type="text" id="class" name="Class" class="form-control" placeholder="Account class (e.g. Asset, Liability)" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Status</label>
                    <select id="status" name="Status" class="form-control">
                        <option value="">All</option>
                        <option value="Pending">Pending</option>
                       <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
            </div>

            <!-- Created Date Filters toggle -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates" onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleCreatedDates">Show Created Date Filters (UTC)</label>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">Filter by submission date to locate specific requests.</small>
                </div>
            </div>

            <div id="createdDateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Created From (UTC)</label>
                        <input type="date" id="createdFromUtc" name="CreatedFromUtc" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Created To (UTC)</label>
                        <input type="date" id="createdToUtc" name="CreatedToUtc" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Language and IncludeDeleted -->
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Language</label>
                    <select id="language" name="Language" class="form-control">
                        <option value="">All</option>
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Scope</label>
                    <select id="scope" name="Scope" class="form-control">
                        <option value="">All</option>
                        <option value="Branch">Branch</option>
                        <option value="Affiliate">Affiliate</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="includeDeleted" name="IncludeDeleted" />
                        <label class="form-check-label fw-bold" for="includeDeleted">Include Deleted</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- space for future controls -->
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="submit" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100" onclick="document.getElementById('affiliateFilterForm').reset();">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

@section Scripts {
    <script>
        (function ($) {
            // server endpoints
            const dataUrl = '@Url.Action("LoadData", "PendingAccount")';
            const detailUrl = '@Url.Action("InitializeData", "PendingAccount")';
            const initUrl = '@Url.Action("InitializeData", "PendingAccount")';
            const deleteUrl = '@Url.Action("Delete", "PendingAccount")';
            const approveUrl = '@Url.Action("Approve", "PendingAccount")';
            const rejectUrl = '@Url.Action("Reject", "PendingAccount")';
            // globals for other scripts
            window.tableInitialized = window.tableInitialized || false;
            window.table = window.table || null;
            window._ajaxSubmitState = window._ajaxSubmitState || { isSubmitting: false, lastRequestId: 0, lastXhr: null };

            /* -------------------------
               small helpers
            -------------------------*/
            function safeParseUnobtrusive($scope) {
                try {
                    if ($.validator && $.validator.unobtrusive && typeof $.validator.unobtrusive.parse === 'function') {
                        $.validator.unobtrusive.parse($scope);
                        return true;
                    }
                } catch (e) { console.warn('unobtrusive.parse failed', e); }
                return false;
            }

            function safeValidate($form) {
                try {
                    if ($.validator && typeof $form.valid === 'function') return $form.valid();
                } catch (e) { console.warn('client validation check failed', e); }
                return true;
            }

            function getFilters() {
                const createdFrom = $('#createdFromUtc').val();
                const createdTo = $('#createdToUtc').val();

                return {
                    Options: {},
                    AffiliateId: $.trim($('#affiliateId').val()) || null,
                    Code: $.trim($('#code').val()) || null,
                    Name: $.trim($('#name').val()) || null,
                    Class: $.trim($('#class').val()) || null,
                    Scope: $('#scope').val() || null,
                    BranchId: $.trim($('#branchId').val()) || null,
                    Status: $('#status').val() || null,
                    CreatedFromUtc: createdFrom || null,
                    CreatedToUtc: createdTo || null,
                    IncludeDeleted: $('#includeDeleted').is(':checked'),
                    Language: $('#language').val() || null
                };
            }

            // Build action buttons used by DataTable row render
            function actionButtons(row) {
                const id = row.Id || row.id || row.affiliateId || '';
                const safeName = (row.Name || row.NameEn || row.name || row.nameEn || '').replace(/'/g, "\\'");
                return `
            <div class="d-flex gap-1 justify-content-end">
                <button type="button" class="btn btn-sm btn-outline-primary btn-detail" data-id="${id}" title="Details ${safeName}">
                    <i class="mdi mdi-eye"></i>
                </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-success btn-action"
                                data-id="${id}"
                                data-action="validation"
                                title="Validate ${safeName}">
                            <i class="mdi mdi-checkbox-marked-circle-outline"></i>
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-warning btn-action"
                                data-id="${id}"
                                data-action="rejection"
                                title="Reject ${safeName}">
                            <i class="mdi mdi-close-circle-outline"></i>
                        </button>
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="${id}" title="Edit ${safeName}">
                    <i class="mdi mdi-pencil"></i>
                </button>
            </div>`;
            }

            /* -------------------------
               Modal helpers
            -------------------------*/
            function ensureModal() {
                let $modal = $('#actionModal');
                if ($modal.length === 0) {
                    const modalHtml = `
            <div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-body text-center p-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2">Loading...</div>
                  </div>
                </div>
              </div>
            </div>`;
                    $('body').append(modalHtml);
                    $modal = $('#actionModal');
                }
                return $modal;
            }

            function openPartialInModal(url, data, sizeClass) {
                const $modal = ensureModal();
                const bs = new bootstrap.Modal($modal[0]);
                $modal.find('.modal-dialog').removeClass('modal-sm modal-lg modal-xl').addClass(sizeClass || 'modal-lg');
                $modal.find('.modal-content').html('<div class="modal-body text-center p-4"><div class="spinner-border text-primary" role="status"></div><div class="mt-2">Loading...</div></div>');
                bs.show();

                $.get(url, data)
                    .done(function (html) {
                        $modal.find('.modal-content').html(html);
                        wireModalFormSubmit($modal);
                    })
                    .fail(function (xhr) {
                        console.error('Partial load failed', xhr);
                        $modal.find('.modal-content').html('<div class="p-4 text-danger">Unable to load content. Please try again.</div>');
                    });
            }

            function wireModalFormSubmit($modal) {
                $modal.off('submit', 'form').on('submit', 'form', function (e) {
                    e.preventDefault();
                    const $form = $(this);
                    if (!safeValidate($form)) return;

                    const hasFiles = $form.attr('enctype') && $form.attr('enctype').toLowerCase().indexOf('multipart') !== -1;
                    let ajaxOptions = {
                        url: $form.attr('action'),
                        type: ($form.attr('method') || 'POST').toUpperCase(),
                        success: function (res) {
                            if (res && typeof res === 'object' && ('success' in res)) {
                                if (res.success) {
                                    try { bootstrap.Modal.getInstance($modal[0]).hide(); } catch (e) { $modal.modal('hide'); }
                                    if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
                                } else {
                                    const errMsg = res.message || 'Save failed. Check validation.';
                                    $modal.find('.modal-content').html(`<div class="p-3"><div class="alert alert-danger">${errMsg}</div></div>`);
                                }
                            } else {
                                // server returned partial html -> replace content
                                $modal.find('.modal-content').html(res);
                                wireModalFormSubmit($modal);
                            }
                        },
                        error: function (xhr) {
                            console.error('Form submit failed', xhr);
                            const msg = xhr.responseText || xhr.statusText || 'Request failed';
                            $modal.find('.modal-content').html(`<div class="p-3"><div class="alert alert-danger">Submit failed: ${msg}</div></div>`);
                        }
                    };

                    if (hasFiles) {
                        const fd = new FormData(this);
                        ajaxOptions.data = fd;
                        ajaxOptions.processData = false;
                        ajaxOptions.contentType = false;
                    } else {
                        ajaxOptions.data = $form.serialize();
                        ajaxOptions.contentType = 'application/x-www-form-urlencoded; charset=UTF-8';
                    }

                    const token = $form.find('input[name="__RequestVerificationToken"]').val();
                    if (token) ajaxOptions.headers = { "RequestVerificationToken": token };

                    $.ajax(ajaxOptions);
                });
            }

            /* -------------------------
               DataTable init
            -------------------------*/
            function initDataTable() {
                const selector = '#myDataTable';

                if ($.fn.DataTable.isDataTable(selector)) {
                    try { $(selector).DataTable().destroy(); } catch (e) { console.warn('destroy failed', e); }
                    $(selector).empty();
                }

                window.table = $(selector).DataTable({
                    serverSide: true,
                    processing: false,
                    responsive: true,
                    autoWidth: false,
                    pageLength: 10,
                    order: [[0, 'desc']],
                    columnDefs: [
                        { targets: [0], width: '15%' },
                        { targets: [1], width: '12%' },
                        { targets: [2], width: '10%' },
                        { targets: [3], width: 'auto' },
                        { targets: [4], width: '12%', className: 'text-center' },
                        { targets: [5], width: '12%' },
                        { targets: [6], width: '16%', orderable: false, searchable: false, className: 'text-end' }
                    ],
                    ajax: {
                        url: dataUrl,
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: function (d) {
                            const filters = getFilters();
                            const pageSize = d.length || 10;
                            const page = (d.start / pageSize) + 1;
                            filters.Options = {
                                Page: page,
                                PageSize: pageSize,
                                Draw: d.draw || 0,
                                Sort: (function () {
                                    if (!d.order || !d.order.length || 1) return '';
                                    const ord = d.order[0];
                                    const col = d.columns[ord.column].data || d.columns[ord.column].name;
                                    const dir = ord.dir;
                                    return col ? `${col} ${dir}` : '';
                                })()
                            };
                            return JSON.stringify(filters);
                        },
                        dataSrc: function (json) {
                            if (!json) return [];
                            if (Array.isArray(json.data)) return json.data;
                            if (Array.isArray(json)) return json;
                            if (Array.isArray(json.result)) return json.result;
                            if (Array.isArray(json.items)) return json.items;
                            for (var k in json) {
                                if (json.hasOwnProperty(k) && Array.isArray(json[k])) return json[k];
                            }
                            return [];
                        },
                        error: function (xhr, status, err) {
                            console.error('Load error', xhr, status, err);
                            $(selector + ' tbody').html('<tr><td colspan="7" class="text-center text-danger">Failed to load data.</td></tr>');
                        }
                    },
                    columns: [
                        // CreatedDate
                        {
                            data: null,
                            render: function (data, type, row) {
                                const val = row.CreatedDate || row.createdDate || row.CreatedOn || row.createdOn;
                                if (!val) return '-';
                                return (window.moment ? moment(val).format('DD/MM/YYYY HH:mm:ss') : val);
                            },
                            name: 'CreatedDate'
                        },
                        // Scope
                        {
                            data: null,
                            render: function (data, type, row) {
                                return row.Scope || row.scope || '-';
                            },
                            name: 'Scope'
                        },
                        // Code
                        {
                            data: null,
                            render: function (data, type, row) {
                                return row.Code || row.code || '';
                            },
                            name: 'Code'
                        },
                        // Name
                        {
                            data: null,
                            render: function (data, type, row) {
                                return row.Name || row.name || row.NameEn || row.nameEn || '';
                            },
                            name: 'Name'
                        },
                        // Class
                        {
                            data: null,
                            render: function (data, type, row) {
                                return row.Class || row.class || '';
                            },
                            name: 'Class'
                        },
                        // Status
                        {
                            data: null,
                            render: function (data, type, row) {
                                var status = row.Status || row.status || '';
                                if (!status) return '';
                                var badgeClass = 'bg-secondary';
                                if (/pending/i.test(status)) badgeClass = 'bg-warning';
                                if (/validated|approved/i.test(status)) badgeClass = 'bg-success';
                                if (/rejected|invalid/i.test(status)) badgeClass = 'bg-danger';
                                return `<span class="badge ${badgeClass}">${status}</span>`;
                            },
                            name: 'Status'
                        },
                        // Actions
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            className: 'text-end',
                            render: function (data, type, row) {
                                return actionButtons(row);
                            }
                        }
                    ],
                    language: { emptyTable: 'No account requests found' }
                });

                window.tableInitialized = true;
            }

            /* -------------------------
               Reusable Ajax helpers for Approve / Reject
            -------------------------*/
            function postActionWithConfirm(url, data, successMsg) {
                if (!confirm('Are you sure you want to continue?')) return;
                $.ajax({
                    url: url,
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res && typeof res === 'object' && ('success' in res) && !res.success) {
                            alert(res.message || 'Operation failed');
                            return;
                        }
                        if (typeof res === 'object' && res.message) alert(res.message);
                        else if (successMsg) alert(successMsg);
                        if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
                    },
                    error: function (xhr) {
                        console.error('Action failed', xhr);
                        alert('Operation failed: ' + (xhr.responseText || xhr.statusText));
                    }
                });
            }

            /* -------------------------
               Delegated event wiring
            -------------------------*/
            $(document).ready(function () {
                // Apply filter -> initialize or reload DataTable
                $('#applyAffiliateFilterBtn').on('click', function (e) {
                    e.preventDefault();
                    if (!window.tableInitialized) {
                        if ($('#myDataTable').length === 0) {
                            console.error('myDataTable markup is missing. Ensure _Data partial is rendered on the page.');
                            return;
                        }
                        initDataTable();
                    } else {
                        if (window.table && typeof window.table.ajax === 'object') window.table.ajax.reload();
                    }
                });

                // Reset filters
                $('#resetAffiliateFilterBtn').on('click', function () {
                    $('#affiliateFilterForm')[0].reset();
                    $('#createdDateFilters').addClass('d-none');
                    $('#createdFromUtc, #createdToUtc').val('');
                    if (window.tableInitialized && window.table) window.table.ajax.reload();
                });

                // Add (re-uses initUrl with path new)
                $('#affiliateListingView').on('click', '#btnAddAffiliate, .btn-add', function () {
                    const id = $(this).data('parentid') || $(this).data('id') || null;
                    openPartialInModal(initUrl, { KEY: id, partialView: '_CreateAffiliate', path: 'new', serviceOption: 'AffiliateAccount' });
                });

                // Details -> partial view in modal
                $('#affiliateListingView').on('click', '.btn-detail', function () {
                    const id = $(this).data('id');
                    if (!id) return alert('Invalid id');
                    openPartialInModal(detailUrl, { id: id, partialView: '_AffiliateModals' }, 'modal-lg');
                });

                // Edit -> open initialize partial (get)
                $('#affiliateListingView').on('click', '.btn-edit', function () {
                    const id = $(this).data('id');
                    if (!id) return alert('Invalid id');
                    openPartialInModal(initUrl, { KEY: id, partialView: '_EditPartial', path: 'get', serviceOption: 'PendingAccount' }, 'modal-lg');
                });

                $(document).on('click', '.btn-action', function () {
                    var id = $(this).data('id');
                    var actionType = $(this).data('action');

                    $.ajax({
                        url: '/PendingAccount/HandleAction', // Controller action
                        type: 'GET', // or 'POST' if you want
                        data: { id: id, actionType: actionType },
                        success: function (partialViewResult) {
                            // Load returned partial view into a modal or div
                            $('#partialContainer').html(partialViewResult);
                            // Optionally show a modal
                            $('#actionModal').modal('show');
                        },
                        error: function () {
                            alert('An error occurred while processing your request.');
                        }
                    });
                });


                //// Approve -> can open a confirmation modal or hit the approve endpoint direct. We'll open a small confirm modal first:
                //$('#affiliateListingView').on('click', '.btn-approve', function () {
                //    const id = $(this).data('id');
                //    if (!id) return alert('Invalid id');
                //    // optional: if you have an approve partial to collect notes, open it. Otherwise call endpoint directly
                //    // Here we call approveUrl directly with POST { KEY: id }
                //    postActionWithConfirm(approveUrl, { KEY: id }, 'Approved successfully');
                //});

                //// Reject -> support optional reason via modal; for now do direct endpoint call (server may accept optional reason)
                //$('#affiliateListingView').on('click', '.btn-reject', function () {
                //    const id = $(this).data('id');
                //    if (!id) return alert('Invalid id');
                //    // If you have a partial to capture rejection reason: openPartialInModal(rejectUrl,...)
                //    postActionWithConfirm(rejectUrl, { KEY: id }, 'Rejected successfully');
                //});

                // Delete (if present)
                $('#affiliateListingView').on('click', '.btn-delete', function () {
                    const id = $(this).data('id');
                    if (!id) { alert('Invalid id'); return; }
                    if (!confirm('Are you sure you want to delete this record?')) return;

                    $.ajax({
                        url: deleteUrl,
                        method: 'GET',
                        data: { KEY: id },
                        success: function (res) {
                            if (res && typeof res === 'object' && ('success' in res) && !res.success) {
                                alert(res.message || 'Delete failed');
                                return;
                            }
                            if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
                        },
                        error: function (xhr) {
                            console.error('Delete failed', xhr);
                            alert('Delete failed: ' + (xhr.responseText || xhr.statusText));
                        }
                    });
                });

                // press Enter on inputs -> apply filter
                $('#affiliateFilterForm input').on('keypress', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        $('#applyAffiliateFilterBtn').trigger('click');
                    }
                });

                // If you want the table to load automatically when page loads uncomment below:
                // if ($('#myDataTable').length && !window.tableInitialized) initDataTable();
            });

            // expose reload helper used by other code
            window.reloadAffiliateTable = window.reloadAffiliateTable || function () {
                try {
                    if (window.table && typeof window.table.ajax === 'object') window.table.ajax.reload(null, false);
                    else $('#applyAffiliateFilterBtn').trigger('click');
                } catch (e) { console.warn('reloadAffiliateTable error', e); }
            };

            // Expose AjaxPost if other views expect it
            window.AjaxPost = window.AjaxPost || function (form) {
                // lightweight wrapper that delegates to the modal wiring above
                try {
                    var $form = $(form);
                    if (!$form || $form.length === 0) return false;
                    safeParseUnobtrusive($form);
                    if (!safeValidate($form)) return false;
                    $.post($form.attr('action'), $form.serialize())
                        .done(function (res) {
                            if (res && res.success) {
                                if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
                            } else {
                                alert(res && res.message ? res.message : 'Save failed');
                            }
                        })
                        .fail(function (xhr) {
                            alert('Request failed: ' + (xhr.responseText || xhr.statusText));
                        });
                } catch (ex) {
                    console.error('AjaxPost wrapper error', ex);
                }
                return false;
            };

        })(jQuery);
    </script>
}