@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.PendingAccountQuery
@using Resources
@{
    ViewBag.Title = "Account Request - Filters";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-document-outline me-2"></i> Account Request Listing
                </h1>
                <p class="card-text">
                    Use this form to filter account requests before validation, approval or rejection.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAffiliateTips" aria-expanded="false" aria-controls="collapseAffiliateTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseAffiliateTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i><strong>Scope:</strong> Select the request scope to limit results.</li>
                <li><i class="mdi mdi-account-box-multiple-outline text-primary me-2"></i><strong>Affiliate / Branch:</strong> Filter by ownership.</li>
                <li><i class="mdi mdi-filter-outline text-secondary me-2"></i><strong>Status:</strong> Pending, Approved, Rejected.</li>
                <li><i class="mdi mdi-calendar-range text-info me-2"></i><strong>Created Dates:</strong> Filter by submission window.</li>
                <li><i class="mdi mdi-checkbox-marked-circle-outline text-success me-2"></i><strong>Include Deleted:</strong> Include soft-deleted requests.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Account Request Filters (organized) -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Account Request Filters</h5>

    <form id="affiliateFilterForm" autocomplete="off" method="get" action="@Url.Action("Index")">
        <div class="card p-3 mb-3 bg-light">

            <!-- SECTION: Context -->
            <div class="mb-2">
                <h6 class="text-muted fw-bold mb-2"><i class="mdi mdi-domain me-1"></i> Context</h6>
                <div class="row g-2">
                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.DropDownListFor(
                              m => m.AffiliateId,
                              new SelectList(ViewBag.Affiliates ?? new List<SelectListItem>(), "Id", "Name"),
                              "--- Select Affiliate ---",
                              new { @class = "form-select select2", id = "AffiliateId" }
                            )
                            @Html.ValidationMessageFor(m => m.AffiliateId, "", new { @class = "text-danger" })
                            <label for="AffiliateId">Affiliate</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating shadow-sm">
                            @Html.DropDownListFor(
                              m => m.BranchId,
                              new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                              "--- " + @GlobalUserManagement.SelectBranch + " ---",
                              new { @class = "form-select select2", id = "BranchId" }
                            )
                            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                            <label for="BranchId">@GlobalUserManagement.Branch</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating shadow-sm">
                            <select id="Scope" name="Scope" class="form-select select2">
                                <option value="">All</option>
                                <option value="Branch">Branch</option>
                                <option value="Affiliate">Affiliate</option>
                            </select>
                            <label for="Scope">Scope</label>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <!-- SECTION: Attributes -->
            <div class="mb-2">
                <h6 class="text-muted fw-bold mb-2"><i class="mdi mdi-format-list-bulleted-type me-1"></i> Attributes</h6>
                <div class="row g-2">
                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating">
                            <input type="text" id="Code" name="Code" class="form-control" placeholder="Affiliate code" />
                            <label for="Code">@AccountingV2.Code</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating">
                            @Html.DropDownList(
                              "Class",
                              new List<SelectListItem> {
                                new SelectListItem { Text="--- Select Class ---", Value="" },
                                new SelectListItem { Text="EQUITY", Value="1" },
                                new SelectListItem { Text="FIXED ASSETS", Value="2" },
                                new SelectListItem { Text="MEMBERS", Value="3" },
                                new SelectListItem { Text="THIRD PARTIES", Value="4" },
                                new SelectListItem { Text="TREASURY", Value="5" },
                                new SelectListItem { Text="EXPENSES", Value="6" },
                                new SelectListItem { Text="REVENUE", Value="7" },
                                new SelectListItem { Text="OUTSIDE ORDINARY ACTIVITIES (OOA)", Value="8" },
                                new SelectListItem { Text="MANAGEMENT", Value="9" }
                              },
                              new { @class = "form-select select2", id = "Class" }
                            )
                            <label for="Class">Class</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="form-floating">
                            <select id="Status" name="Status" class="form-select select2">
                                <option value="">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                            <label for="Status">Status</label>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <!-- SECTION: Date Range -->
            <div class="mb-2">
                <div class="d-flex align-items-center justify-content-between">
                    <h6 class="text-muted fw-bold mb-2"><i class="mdi mdi-calendar-range me-1"></i> Date Range (UTC)</h6>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleCreatedDates"
                               onclick="document.getElementById('createdDateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleCreatedDates">Show</label>
                    </div>
                </div>

                <div id="createdDateFilters" class="d-none">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control" />
                                <label for="CreatedFromUtc">Created From (UTC)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control" />
                                <label for="CreatedToUtc">Created To (UTC)</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <!-- SECTION: Options -->
            <div>
                <h6 class="text-muted fw-bold mb-2"><i class="mdi mdi-cog-outline me-1"></i> Options</h6>
                <div class="row g-2">
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IncludeDeleted" name="IncludeDeleted" />
                            <label class="form-check-label fw-bold" for="IncludeDeleted">Include Deleted</label>
                        </div>
                    </div>
                    <div class="col-md-8"><!-- reserved space --></div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="submit" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary w-100"
                        onclick="document.getElementById('affiliateFilterForm').reset(); if (window.$ && $.fn.select2) { $('#AffiliateId,#BranchId,#Class,#Status,#Scope').val(null).trigger('change'); } document.getElementById('createdDateFilters').classList.add('d-none');">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="affiliateListingView">
    @Html.Partial("_Data")
</div>

@section Scripts {
    <script>
(function ($) {
  'use strict';

  // ---- Endpoints ----
  const dataUrl    = '@Url.Action("LoadData", "PendingAccount")';
  const detailUrl  = '@Url.Action("InitializeData", "PendingAccount")';
  const initUrl    = '@Url.Action("InitializeData", "PendingAccount")';
  const deleteUrl  = '@Url.Action("Delete", "PendingAccount")';

  // ---- Globals ----
  window.tableInitialized = window.tableInitialized || false;
  window.table = window.table || null;

  // ---- Helpers ----
  function initSelect2() {
    if (!$.fn.select2) return;
    try {
      $('#AffiliateId').select2({ width: '100%', placeholder: 'Select Affiliate', allowClear: true });
      $('#BranchId').select2({ width: '100%', placeholder: 'Select Branch', allowClear: true });
      $('#Scope').select2({ width: '100%', placeholder: 'Select Scope', allowClear: true });
      $('#Class').select2({ width: '100%', placeholder: 'Select Class', allowClear: true });
      $('#Status').select2({ width: '100%', placeholder: 'Select Status', allowClear: true });
    } catch (e) { console.warn('select2 init failed', e); }
  }

  function getFilters() {
    // Keep property names aligned with PendingAccountQuery
    const f = {
      Options: {},
      AffiliateId:  $('#AffiliateId').val() || null,
      BranchId:     $('#BranchId').val() || null,
      Scope:        $('#Scope').val() || null,
      Code:         $.trim($('#Code').val() || '') || null,
      Class:        $('#Class').val() || null,
      Status:       $('#Status').val() || null,
      CreatedFromUtc: $('#CreatedFromUtc').val() || null,
      CreatedToUtc:   $('#CreatedToUtc').val() || null,
      IncludeDeleted: $('#IncludeDeleted').is(':checked')
    };
    return f;
  }

  function actionButtons(row) {
    const id = row.Id || row.id || row.affiliateId || '';
    const safeName = String(row.Name || row.NameEn || row.name || row.nameEn || '').replace(/'/g, "\\'");
    return `
      <div class="d-flex gap-1 justify-content-end">
        <button type="button" class="btn btn-sm btn-outline-primary btn-detail" data-id="${id}" title="Details ${safeName}">
          <i class="mdi mdi-eye"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-success btn-action" data-id="${id}" data-action="validation" title="Validate ${safeName}">
          <i class="mdi mdi-checkbox-marked-circle-outline"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-warning btn-action" data-id="${id}" data-action="rejection" title="Reject ${safeName}">
          <i class="mdi mdi-close-circle-outline"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="${id}" title="Edit ${safeName}">
          <i class="mdi mdi-pencil"></i>
        </button>
      </div>`;
  }

  // ---- Modal helpers ----
  function ensureModal() {
    let $modal = $('#actionModal');
    if ($modal.length === 0) {
      $('body').append(
        `<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
           <div class="modal-dialog modal-lg modal-dialog-centered">
             <div class="modal-content">
               <div class="modal-body text-center p-4">
                 <div class="spinner-border text-primary" role="status"></div>
                 <div class="mt-2">Loading...</div>
               </div>
             </div>
           </div>
         </div>`);
      $modal = $('#actionModal');
    }
    return $modal;
  }

  function openPartialInModal(url, data, sizeClass) {
    const $modal = ensureModal();
    const bs = new bootstrap.Modal($modal[0]);
    $modal.find('.modal-dialog').removeClass('modal-sm modal-lg modal-xl').addClass(sizeClass || 'modal-lg');
    $modal.find('.modal-content').html('<div class="modal-body text-center p-4"><div class="spinner-border text-primary" role="status"></div><div class="mt-2">Loading...</div></div>');
    bs.show();

    $.get(url, data)
      .done(function (html) {
        $modal.find('.modal-content').html(html);
        wireModalFormSubmit($modal);
      })
      .fail(function (xhr) {
        console.error('Partial load failed', xhr);
        $modal.find('.modal-content').html('<div class="p-4 text-danger">Unable to load content. Please try again.</div>');
      });
  }

  function wireModalFormSubmit($modal) {
    $modal.off('submit', 'form').on('submit', 'form', function (e) {
      e.preventDefault();
      const $form = $(this);

      const hasFiles = ($form.attr('enctype') || '').toLowerCase().includes('multipart');
      const ajaxOptions = {
        url: $form.attr('action'),
        type: ($form.attr('method') || 'POST').toUpperCase(),
        success: function (res) {
          if (res && typeof res === 'object' && ('success' in res)) {
            if (res.success) {
              try { bootstrap.Modal.getInstance($modal[0]).hide(); } catch { $modal.modal('hide'); }
              if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
            } else {
              const errMsg = res.message || 'Save failed. Check validation.';
              $modal.find('.modal-content').html(`<div class="p-3"><div class="alert alert-danger">${errMsg}</div></div>`);
            }
          } else {
            $modal.find('.modal-content').html(res);
            wireModalFormSubmit($modal);
          }
        },
        error: function (xhr) {
          const msg = xhr.responseText || xhr.statusText || 'Request failed';
          $modal.find('.modal-content').html(`<div class="p-3"><div class="alert alert-danger">Submit failed: ${msg}</div></div>`);
        }
      };

      if (hasFiles) {
        const fd = new FormData(this);
        ajaxOptions.data = fd;
        ajaxOptions.processData = false;
        ajaxOptions.contentType = false;
      } else {
        ajaxOptions.data = $form.serialize();
        ajaxOptions.contentType = 'application/x-www-form-urlencoded; charset=UTF-8';
      }

      const token = $form.find('input[name="__RequestVerificationToken"]').val();
      if (token) ajaxOptions.headers = { "RequestVerificationToken": token };

      $.ajax(ajaxOptions);
    });
  }

  // ---- DataTable ----
  function initDataTable() {
    const selector = '#myDataTable';

    if ($.fn.DataTable.isDataTable(selector)) {
      try { $(selector).DataTable().destroy(); } catch (e) { console.warn('destroy failed', e); }
      $(selector).empty();
    }

    window.table = $(selector).DataTable({
      serverSide: true,
      processing: false,
      responsive: true,
      autoWidth: false,
      pageLength: 10,
      order: [[0, 'desc']],
      columnDefs: [
        { targets: [0], width: '15%' },
        { targets: [1], width: '12%' },
        { targets: [2], width: '10%' },
        { targets: [3], width: 'auto' },
        { targets: [4], width: '12%', className: 'text-center' },
        { targets: [5], width: '12%' },
        { targets: [6], width: '16%', orderable: false, searchable: false, className: 'text-end' }
      ],
      ajax: {
        url: dataUrl,
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: function (d) {
          const filters = getFilters();
          const pageSize = d.length || 10;
          const page = ((d.start || 0) / pageSize) + 1;

          // safe sort column resolution
          let sortExpr = '';
          if (d.order && d.order.length > 0) {
            const ord = d.order[0];
            const colIdx = ord.column;
            const col = (d.columns && d.columns[colIdx]) ? (d.columns[colIdx].name || d.columns[colIdx].data) : '';
            const dir = ord.dir || 'asc';
            if (col) sortExpr = `${col} ${dir}`;
          }

          filters.Options = {
            Page: page,
            PageSize: pageSize,
            Draw: d.draw || 0,
            Sort: sortExpr
          };
          return JSON.stringify(filters);
        },
        dataSrc: function (json) {
          if (!json) return [];
          if (Array.isArray(json.data)) return json.data;
          if (Array.isArray(json)) return json;
          if (Array.isArray(json.result)) return json.result;
          if (Array.isArray(json.items)) return json.items;
          for (var k in json) {
            if (json.hasOwnProperty(k) && Array.isArray(json[k])) return json[k];
          }
          return [];
        },
        error: function (xhr, status, err) {
          console.error('Load error', xhr, status, err);
          $(selector + ' tbody').html('<tr><td colspan="7" class="text-center text-danger">Failed to load data.</td></tr>');
        }
      },
      columns: [
        // CreatedDate
        {
          data: null,
          name: 'CreatedDate',
          render: function (_, __, row) {
            const val = row.CreatedDate || row.createdDate || row.CreatedOn || row.createdOn;
            if (!val) return '-';
            return (window.moment ? moment(val).format('DD/MM/YYYY HH:mm:ss') : val);
          }
        },
        // Scope
        { data: 'Scope', name: 'Scope', defaultContent: '-' },
        // Code
        { data: 'Code', name: 'Code', defaultContent: '' },
        // Name
        {
          data: null,
          name: 'Name',
          render: function (_, __, row) {
            return row.Name || row.name || row.NameEn || row.nameEn || '';
          }
        },
        // Class
        { data: 'Class', name: 'Class', defaultContent: '' },
        // Status
        {
          data: null,
          name: 'Status',
          render: function (_, __, row) {
            var status = row.Status || row.status || '';
            if (!status) return '';
            var badgeClass = 'bg-secondary';
            if (/pending/i.test(status)) badgeClass = 'bg-warning';
            if (/validated|approved/i.test(status)) badgeClass = 'bg-success';
            if (/rejected|invalid/i.test(status)) badgeClass = 'bg-danger';
            return `<span class="badge ${badgeClass}">${status}</span>`;
          }
        },
        // Actions
        {
          data: null,
          orderable: false,
          searchable: false,
          className: 'text-end',
          render: function (_, __, row) { return actionButtons(row); }
        }
      ],
      language: { emptyTable: 'No account requests found' }
    });

    window.tableInitialized = true;
  }

  // ---- Events ----
  $(function () {
    initSelect2();

    // Apply -> init or reload
    $('#applyAffiliateFilterBtn').on('click', function (e) {
      e.preventDefault();
      if (!window.tableInitialized) {
        if ($('#myDataTable').length === 0) {
          console.error('myDataTable markup is missing. Ensure _Data partial is rendered on the page.');
          return;
        }
        initDataTable();
      } else {
        window.table.ajax.reload();
      }
    });

    // Reset
    $('#resetAffiliateFilterBtn').on('click', function () {
      $('#affiliateFilterForm')[0].reset();
      $('#createdDateFilters').addClass('d-none');
      if ($.fn.select2) {
        $('#AffiliateId,#BranchId,#Class,#Status,#Scope').val(null).trigger('change');
      }
      if (window.tableInitialized && window.table) window.table.ajax.reload();
    });

    // Details
    $('#affiliateListingView').on('click', '.btn-detail', function () {
      const id = $(this).data('id');
      if (!id) return alert('Invalid id');
      openPartialInModal(detailUrl, { id: id, partialView: '_AffiliateModals' }, 'modal-lg');
    });

    // Edit
    $('#affiliateListingView').on('click', '.btn-edit', function () {
      const id = $(this).data('id');
      if (!id) return alert('Invalid id');
      openPartialInModal(initUrl, { KEY: id, partialView: '_EditPartial', path: 'get', serviceOption: 'PendingAccount' }, 'modal-lg');
    });

    // Validate / Reject flow via GET (loads partial)
    $(document).on('click', '.btn-action', function () {
      const id = $(this).data('id');
      const actionType = $(this).data('action'); // "validation" | "rejection"
      $.ajax({
        url: '/PendingAccount/HandleAction',
        type: 'GET',
        data: { id, actionType },
        success: function (html) {
          const $modal = ensureModal();
          $modal.find('.modal-content').html(html);
          new bootstrap.Modal($modal[0]).show();
        },
        error: function () { alert('An error occurred while processing your request.'); }
      });
    });

    // Delete
    $('#affiliateListingView').on('click', '.btn-delete', function () {
      const id = $(this).data('id');
      if (!id) { alert('Invalid id'); return; }
      if (!confirm('Are you sure you want to delete this record?')) return;
      $.ajax({
        url: deleteUrl,
        method: 'GET',
        data: { KEY: id },
        success: function (res) {
          if (res && typeof res === 'object' && ('success' in res) && !res.success) {
            alert(res.message || 'Delete failed'); return;
          }
          if (window.tableInitialized && window.table) window.table.ajax.reload(null, false);
        },
        error: function (xhr) {
          alert('Delete failed: ' + (xhr.responseText || xhr.statusText));
        }
      });
    });

    // Enter -> Apply
    $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
      if (e.which === 13) { e.preventDefault(); $('#applyAffiliateFilterBtn').trigger('click'); }
    });
  });

  // Optional expose
  window.reloadAffiliateTable = window.reloadAffiliateTable || function () {
    try {
      if (window.table && typeof window.table.ajax === 'object') window.table.ajax.reload(null, false);
      else $('#applyAffiliateFilterBtn').trigger('click');
    } catch (e) { console.warn('reloadAffiliateTable error', e); }
  };

})(jQuery);
    </script>
}
