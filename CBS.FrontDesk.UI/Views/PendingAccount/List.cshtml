@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
<script>
  (function ($) {
    'use strict';

    // ----- Endpoints -----
    const dataUrl = '@Url.Action("LoadData","PendingAccount")';
    const initUrl = '@Url.Action("InitializeData","PendingAccount")';

    // ----- Modal -----
    const MODAL_ID = '#accountRequestTModal';
    const MODAL_LOADER = '#accountRequestTLoader';
    let tableInitialized = false;
    let table = null;
    $.ajaxSetup({ cache: false });

    // ----- Helpers -----
    function antiForgeryToken() {
      return $('input[name="__RequestVerificationToken"]').val();
    }

    function initSelect2() {
      if (!$.fn.select2) return;
      const opts = { width: '100%', allowClear: true };
      try {
        $('#AffiliateId').select2({ ...opts, placeholder: 'Select Affiliate' });
        $('#BranchId').select2({ ...opts, placeholder: 'Select Branch' });
        $('#Scope').select2({ ...opts, placeholder: 'Select Scope' });
        $('#Class').select2({ ...opts, placeholder: 'Select Class' });
        $('#Status').select2({ ...opts, placeholder: 'Select Status' });
        $('#ChangeType').select2({ ...opts, placeholder: 'Select Change Type' });
        $('#Language').select2({ ...opts, placeholder: 'Language' });
      } catch(e){ console.warn('select2 init failed', e); }
    }

    // Collect ALL PendingAccountQuery fields
    function getFilters() {
      return {
        Options: {},
        Scope:          $('#Scope').val() || null,
        AffiliateId:    $('#AffiliateId').val() || null,
        BranchId:       $('#BranchId').val() || null,
        Status:         $('#Status').val() || null,
        Code:           $('#Code').val()  || null,
        ChangeType:     $('#ChangeType').val() || null,          // NEW
        UpdateReference:$('#UpdateReference').val() || null, // NEW
        Name:           $('#Name').val() || null,   // NEW
        RequestedBy:    $('#RequestedBy').val() || null, // NEW
        ApprovedBy:     $('#ApprovedBy').val() || null,  // NEW
        Class:          $('#Class').val() || null,                // from ViewBag.Classes
        CreatedFromUtc: $('#CreatedFromUtc').val() || null,
        CreatedToUtc:   $('#CreatedToUtc').val() || null,
        IncludeDeleted: $('#IncludeDeleted').is(':checked') === true,
        Language:       $('#Language').val() || null              // NEW
      };
    }

    function setModalBody(html, sizeClass) {
      const $modal = $(MODAL_ID);
      const $dlg = $modal.find('.modal-dialog');
      $dlg.removeClass('modal-sm modal-lg modal-xl');
      if (sizeClass) $dlg.addClass(sizeClass);
      $('#accountRequestTContent').html(html);
    }

    function setModalLoading(isLoading) { $(MODAL_LOADER).toggleClass('d-none', !isLoading); }
    function openModal(){ bootstrap.Modal.getOrCreateInstance($(MODAL_ID)[0], { backdrop: 'static' }).show(); }

    function openPartialInModalWithInit(params, sizeClass = 'modal-lg') {
      setModalBody(`<div class="text-center p-4"><div class="spinner-border" role="status"></div><div class="mt-2">Loading...</div></div>`, sizeClass);
      setModalLoading(true);
      openModal();
      $.get(initUrl, params)
        .done(function(html){
          setModalBody(html, sizeClass);
          setModalLoading(false);
          try { $.validator?.unobtrusive?.parse($(MODAL_ID)); } catch(_) {}
        })
        .fail(function(xhr){
          setModalBody(`<div class="alert alert-danger m-3">${xhr?.responseText || 'Unable to load content.'}</div>`, sizeClass);
          setModalLoading(false);
        });
    }
    window.openPartialInModalWithInit = openPartialInModalWithInit;

    function renderStatusBadge(sRaw){
      const s = (sRaw || '').toString();
      if(!s) return '';
      let cls = 'bg-secondary';
      if (/pending/i.test(s)) cls = 'bg-warning';
      if (/validated|approved/i.test(s)) cls = 'bg-success';
      if (/rejected|invalid/i.test(s)) cls = 'bg-danger';
      return `<span class="badge ${cls}">${s}</span>`;
    }

    function renderChangeTypeBadge(v){
      const key = (v || '').toString().trim().toLowerCase();
      if (key === 'createrequest') return `<span class="badge bg-primary">Create Request</span>`;
      if (key === 'updaterequest') return `<span class="badge bg-info">Update Request</span>`;
      return v ? `<span class="badge bg-secondary">${v}</span>` : '';
      }
    function renderScopeTypeBadge(v){
      const key = (v || '').toString().trim().toLowerCase();
      if (key === 'affiliate') return `<span class="badge bg-primary">Affiliate</span>`;
      if (key === 'branch') return `<span class="badge bg-info">Branch</span>`;
      return v ? `<span class="badge bg-secondary">${v}</span>` : '';
      }

      function renderUpdateTypeBadge(v) {
          const key = (v || '').toString().trim().toLowerCase();
          if (!key) return '';

          // Map known values to label + bootstrap class
          const map = {
              'code': { text: 'Code only', cls: 'bg-warning text-dark' },
              'nameen': { text: 'Name (English) only', cls: 'bg-success' },
              'namefr': { text: 'Name (French) only', cls: 'bg-success' },
              'names': { text: 'Names (English & French)', cls: 'bg-info' },
              'codeandnames': { text: 'Code + Names', cls: 'bg-danger' }
          };

          const m = map[key];
          return m
              ? `<span class="badge ${m.cls}">${m.text}</span>`
              : `<span class="badge bg-secondary">${v}</span>`;
      }


      // ----- DataTable -----
      function initDataTable() {
          const selector = '#myDataTable';

          // Guard: ensure table exists
          if (!$(selector).length) {
              if (typeof appalert === 'function') appalert('Table element #myDataTable not found on page', 0, 1);
              console.error('Table element #myDataTable not found.');
              return;
          }

          // If already initialized, just reload
          if ($.fn.DataTable.isDataTable(selector) && table) {
              table.ajax.reload(null, false);
              return;
          }

          // Safe destroy any zombie instance
          try { $(selector).DataTable().destroy(); } catch (_) { }
          $(selector + ' tbody').empty();

          table = $(selector).DataTable({
              serverSide: true,
              searching: false,
              responsive: true,
              autoWidth: false,
              pageLength: 10,
              order: [[0, 'desc']],
              columnDefs: [
                  { targets: [0], width: '15%' },  // CreatedDate
                  { targets: [1], width: '10%' },  // Scope
                  { targets: [2], width: '12%' },  // Code
                  { targets: [3], width: 'auto' }, // Name
                  { targets: [4], width: '10%' },  // Class
                  { targets: [5], width: '10%' },  // ChangeType
                  { targets: [6], width: '10%' },  // AccountUpdateType
                  { targets: [7], width: '10%' },  // Status
                  { targets: [8], width: '10%', orderable: false, searchable: false, className: 'text-end' } // Actions
              ],
              ajax: {
                  url: dataUrl,
                  type: 'POST',
                  contentType: 'application/json; charset=utf-8',
                  headers: {
                      // add anti-forgery when present
                      'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                  },
                  data: function (d) {
                      const filters = getFilters();

                      // Map sort to server: use the column "name" you set below
                      let sortExpr = '';
                      if (d.order && d.order.length && d.columns) {
                          const ord = d.order[0];
                          const colName = d.columns[ord.column]?.name || d.columns[ord.column]?.data || '';
                          const dir = (ord.dir || 'asc').toLowerCase();
                          if (colName) sortExpr = `${colName} ${dir}`;
                      }

                      // IMPORTANT: match your model casing => Options
                      filters.Options = {
                          Draw: d.draw,
                          Page: Math.floor((d.start || 0) / (d.length || 10)) + 1,
                          PageSize: d.length,
                          Sort: sortExpr,
                          // optional passthrough if your backend uses them
                          Start: d.start,
                          Length: d.length,
                          SearchValue: d.search?.value || ''
                      };

                      return JSON.stringify(filters);
                  },
                  // Be lenient with the shape coming back
                  dataSrc: function (json) {
                      // DataTables expects draw/recordsTotal/recordsFiltered at the root.
                      // If your server already returns exact shape, this is fine.
                      if (!json) return [];

                      // If your API nests the items, try common keys:
                      if (Array.isArray(json.data)) return json.data;
                      if (Array.isArray(json.result)) return json.result;
                      if (Array.isArray(json.items)) return json.items;

                      // Last resort: find the first array
                      for (const k in json) { if (Array.isArray(json[k])) return json[k]; }

                      return [];
                  },
                  error: function (xhr, status, err) {
                      console.error('DataTables load error', status, err, xhr?.responseText);
                      $(selector + ' tbody').html(
                          '<tr><td colspan="8" class="text-center text-danger">Failed to load data.</td></tr>'
                      );
                  }
              },
              columns: [
                  { // CreatedDate
                      data: null, name: 'CreatedDate',
                      render: function (_, __, row) {
                          const v = row.CreatedDate || row.createdDate || row.CreatedOn || row.createdOn;
                          return v ? (window.moment ? moment(v).format('DD/MM/YYYY HH:mm:ss') : v) : '-';
                      }
                  },
                  { data: null, name: 'Scope',
                          render: function (_, __, row) {
                              return renderScopeTypeBadge(row.Scope || row.Scope);
                          } 
                  },
                  { data: 'Code', name: 'Code', defaultContent: '' },
                  { // Name
                      data: null, name: 'Name',
                      render: function (_, __, row) {
                          return row.Name || row.name || row.NameEn || row.nameEn || '';
                      }
                  },
                  { data: 'Class', name: 'Class', defaultContent: '' },
                  { // ChangeType
                      data: null, name: 'ChangeType',
                      render: function (_, __, row) {
                          return renderChangeTypeBadge(row.ChangeType || row.changeType);
                      }
                  },
                  { // AccountUpdateKind
                      data: null, name: 'Update Kind',
                      render: function (_, __, row) {
                          return renderUpdateTypeBadge(row.AccountUpdateKind || row.AccountUpdateKind);
                      }
                  },
                  { // Status
                      data: null, name: 'Status',
                      render: function (_, __, row) {
                          return renderStatusBadge(row.Status || row.status);
                      }
                  },
                  { // Actions
                      data: null, orderable: false, searchable: false, className: 'text-end',
                      render: function (_, __, row) {
                          const id = row.Id || row.id;
                          const btnId = 'act_' + (id || Math.random().toString(36).slice(2));
                          return `
            <div class="dropdown text-end">
              <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="mdi mdi-cog-outline"></i> Actions
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="${btnId}">
                <li><button type="button" class="dropdown-item js-detail" data-id="${id}"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
                <li><button type="button" class="dropdown-item js-validate" data-id="${id}"><i class="mdi mdi-check-circle-outline me-1 text-success"></i> Validate</button></li>
                <li><button type="button" class="dropdown-item js-reject" data-id="${id}"><i class="mdi mdi-close-circle-outline me-1 text-warning"></i> Reject</button></li>
              </ul>
            </div>`;
                      }
                  }
              ],
              language: { emptyTable: 'No account requests found' }
          });

          tableInitialized = true;
      }

    // ----- Events -----
    $(function(){
      initSelect2();

      $('#applyAffiliateFilterBtn').on('click', function(e){
        e.preventDefault();
        if (!tableInitialized) initDataTable();
        else table.ajax.reload();
      });

      $('#resetAffiliateFilterBtn').on('click', function(){
        const $f = $('#affiliateFilterForm');
        if ($f.length) $f[0].reset();
        $('#createdDateFilters').addClass('d-none');
        if ($.fn.select2) $('#AffiliateId,#BranchId,#Class,#Status,#Scope,#ChangeType,#Language').val(null).trigger('change');
        if (tableInitialized && table) table.ajax.reload(null, false);
      });

      const $host = $('#datalistingview');
      $host.on('click','.js-detail',function(){
        const id = $(this).data('id'); if (!id) return;
        openPartialInModalWithInit({ KEY:id, partialView:'_Details', path:'get', serviceOption:'PendingAccount' }, 'modal-lg');
      });
      $host.on('click','.js-validate',function(){
        const id = $(this).data('id'); if (!id) return;
        openPartialInModalWithInit({ KEY:id, partialView:'_ActionModal', path:'validate', serviceOption:'validation' }, 'modal-lg');
      });
      $host.on('click','.js-reject',function(){
        const id = $(this).data('id'); if (!id) return;
        openPartialInModalWithInit({ KEY:id, partialView:'_ActionModal', path:'reject', serviceOption:'rejection' }, 'modal-lg');
      });

      // Enter -> Apply
      $('#affiliateFilterForm').on('keypress','input,select',function(e){
        if (e.which === 13) { e.preventDefault(); $('#applyAffiliateFilterBtn').trigger('click'); }
      });
    });

    // public reload
    window.reloadPendingAccountTable = window.reloadPendingAccountTable || function(){
      try {
        if (table?.ajax) table.ajax.reload(null,false);
        else $('#applyAffiliateFilterBtn').trigger('click');
      } catch(e){ console.warn('reloadPendingAccountTable error', e); }
    };

  })(jQuery);
</script>
}
