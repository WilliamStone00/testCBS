@model CBS.FrontDesk.Data.Entity.Accounting_V2.PendingAccount.RequestAction
@* Adjust namespace of requestAction if needed *@

<fieldset class="fieldset-custom">

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi @(Model?.ActionType?.Equals("validation", StringComparison.OrdinalIgnoreCase) == true
                         || Model?.ActionType?.Equals("validate", StringComparison.OrdinalIgnoreCase) == true
                         ? "mdi-check-decagram"
                         : "mdi-close-octagon-outline") me-2"></i>
                @(Model?.ActionType?.Equals("validation", StringComparison.OrdinalIgnoreCase) == true
           || Model?.ActionType?.Equals("validate", StringComparison.OrdinalIgnoreCase) == true
             ? "Validate Account Request"
             : "Reject Account Request")
            </h1>
            <p class="card-text text-muted mb-1">Provide the required information and confirm this action.</p>
        </div>
    </div>

    <div class="row">
        <!-- Left: Context -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> Context</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <td class="fw-bold">Request Id</td>
                    <td>@(Model?.Id ?? "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">Action</td>
                    <td>@(Model?.ActionType ?? "-")</td>
                </tr>
            </table>
        </div>

        <!-- Right: Inputs (strongly-typed helpers) -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-form-textbox me-2"></i> Provide Details</h6>

            @{
                var isValidation =
                    Model?.ActionType?.Equals("validation", StringComparison.OrdinalIgnoreCase) == true
                    || Model?.ActionType?.Equals("validate", StringComparison.OrdinalIgnoreCase) == true
                    || Model?.ActionType?.Equals("approved", StringComparison.OrdinalIgnoreCase) == true;

                var postAction = isValidation ? "ValidateRequest" : "RejectRequest";
            }

            @using (Html.BeginForm(postAction, "PendingAccount", FormMethod.Post, new { id = "requestActionForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.ActionType)

             

                if (isValidation)
                {
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ApprovalNotes, new { @class = "form-label text-primary fw-semibold" })
                        @Html.TextAreaFor(m => m.ApprovalNotes, new { @class = "form-control", rows = "3", placeholder = "Optional notes for the approval" })
                        @Html.ValidationMessageFor(m => m.ApprovalNotes, "", new { @class = "text-danger" })
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        @Html.LabelFor(m => m.RejectionReason, new { @class = "form-label text-primary fw-semibold" })
                        @Html.TextAreaFor(m => m.RejectionReason, new { @class = "form-control", rows = "3", placeholder = "Explain why this request is rejected" })
                        @Html.ValidationMessageFor(m => m.RejectionReason, "", new { @class = "text-danger" })
                    </div>
                }

                <div class="alert alert-warning">
                    <i class="mdi mdi-alert-outline me-2"></i>
                    <strong>Warning:</strong> Please review details carefully before confirming.
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="mdi mdi-check-circle-outline"></i> Confirm
                    </button>
                </div>
            }
        </div>
    </div>

</fieldset>
