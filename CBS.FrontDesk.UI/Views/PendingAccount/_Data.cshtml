@using Resources

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered nowrap" style="width:100%">
                <colgroup>
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:12%" />
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:10%" />
                    <col style="width:8%" />
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Created_Date</th>
                        <th>@GlobalShared.Scope</th>
                        <th>@GlobalShared.Branch_Name</th>
                        <th>@GlobalShared.Code</th>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Class</th>
                        <th>@GlobalShared.change_type</th>
                        <th>@GlobalShared.update_kind</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


