@model CBS.FrontDesk.Data.Entity.CustomerManagement.CustomerDocumentRequest
     @using Resources

@using (Html.BeginForm("UploadCustomerFiles", "AttachedLoanDocuments", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.CustomerID)

<label for="fileUpload">@GlobalShared.Select_Files:</label>
    <input type="file" id="fileUpload" name="AttachedFiles" multiple />
    <br />

    <input type="submit" value="@GlobalShared.Upload" />
}

