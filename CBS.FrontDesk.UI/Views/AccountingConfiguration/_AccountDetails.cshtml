@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-bank-plus me-2"></i>
                    Account Information
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th colspan="2"> Account Information Details</th>

                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            <tr>
                                <td>Account Owner</td>
                                <td>@Model.Account.AccountOwnerId </td>
                            </tr>

                            <tr>
                                <td>AccountNumber at level of the union</td>
                                <td>@Model.Account.AccountNumberCU </td>
                            </tr>
                            <tr>
                                <td>AccountNumber at level of the network </td>
                                <td> @Model.Account.AccountNumberNetwok </td>
                            </tr>
                            <tr>
                                <td>Account Description</td>
                                <td>@Model.Account.AccountName </td>
                            </tr>

                            <tr>
                                <td>Beginning Balance</td>
                                <td>@Model.Account.BeginningBalance </td>
                            </tr>
                            <tr>
                                <td>Current Balance </td>
                                <td> @Model.Account.CurrentBalance  </td>
                            </tr>
                            <tr>
                                <td>Credit Balance </td>
                                <td> @Model.Account.CreditBalance </td>
                            </tr>
                            <tr>
                                <td>Debit Balance</td>
                                <td> @Model.Account.DebitBalance </td>
                            </tr>
                            <tr>
                                <td>Last Balance</td>
                                <td> @Model.Account.LastBalance </td>
                            </tr>

                        </tbody>
                    </table>
                </div>


            </div>
        </div>


    </div>
</div>