@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources

    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>@AccountingConfig_ChartOfAccount.Name</th>
                <th>@AccountingConfig_ChartOfAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.BlacklistAccounts)
            {
                <tr>
                    <td style="width:80%">@d.AccountNumber</td>

                    <td style="width:20%">
                        @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_accountPolicy','_AccountDetails','details','AccountingConfiguration','accountPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountName to edit">Details</a>|*@
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_blacklistAccount','_CreateBlacklistAccountForJE','update','AccountingConfiguration','blacklistAccount')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountNumber to edit">@GlobalShared.Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.AccountNumber" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable','_BlacklistAccountData',0,'datalistingview_blacklistAccount','blacklistAccount')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>



