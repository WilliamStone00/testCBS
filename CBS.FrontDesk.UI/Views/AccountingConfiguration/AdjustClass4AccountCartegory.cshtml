@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
@{
    ViewBag.Title = @GlobalAdjustClass4AccountCartegory.SettingAccountCategory;
}

<div class="row">
    <div class="col-xl-12 col-lg-9 col-md-12 order-12 order-md-12">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-file-document-outline me-2"></i>
                        @GlobalAdjustClass4AccountCartegory.SettingAccountCategoryTitle
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div class="container">
                                    <div class="card-body">
                                        <fieldset class="fieldset-custom">
                                            <legend>@GlobalAdjustClass4AccountCartegory.CustomiseClass4Accounts</legend>

                                            <table id="myDataTable_accountCategory" class="display" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>@GlobalAdjustClass4AccountCartegory.AccountDescription</th>
                                                        <th>@GlobalAdjustClass4AccountCartegory.AccountCategory</th>
                                                        <th>@GlobalAdjustClass4AccountCartegory.Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <!-- Rows will be dynamically added here -->
                                                    @foreach (var d in Model.ListChartofAccountManagementPosition)
                                                    {
                                                        var element = d.New_AccountNumber + "-" + d.Description;
                                                        <tr>
                                                            <td style="width:40%">@element </td>
                                                            <td style="width:30%">@d.Level_Management</td>

                                                            <td style="width:30%">
                                                                @Html.DropDownListFor(m => d.Old_AccountNumber, new SelectList(ViewBag.LevelManagementList, "Value", "Text"), new { @id = d.Id + "-AccountCartegory", @class = "form-control select2" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/Account.js"></script>
}
