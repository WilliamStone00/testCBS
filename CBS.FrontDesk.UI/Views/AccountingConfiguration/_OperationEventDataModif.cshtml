@model  CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources
<table class="table table-hover" id="myDataTable_OperationEvent">
    <thead class="table-light">
        <tr>
            <th>@AccountingConfig_OperationEventData.OperationEventName</th>
            <th>@AccountingConfig_OperationEventData.OperationEventType</th>
            <th>@AccountingConfig_OperationEventData.Description</th>
            <th>@AccountingConfig_OperationEventData.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OperationEvents)
        {

            <tr>
                <td style="width:30%">@d.OperationEventName</td>
                <td style="width:30%">@d.OperationEventType</td>
                <td style="width:20%">@d.Description</td>
                
                <td style="width:20%">
                    <a href="#" class="btn btn-primary mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview_OperationEvent','_CreateOperationEvent','update','AccountingConfiguration','operationEvent')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.OperationEventName to edit">@GlobalShared.Edit</a>
                   | <a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete @d.OperationEventName" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_OperationEvent','_OperationEventData',0,'datalistingview_OperationEvent','operationEvent')">@GlobalShared.Delete</a>

                </td>


            </tr>


        }
    </tbody>
</table>
