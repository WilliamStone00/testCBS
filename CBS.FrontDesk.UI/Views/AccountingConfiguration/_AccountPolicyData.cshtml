@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources
@if (Convert.ToBoolean(Session["IsHeadOffice"]))
{
    <table class="table table-hover" id="myDataTable_AccountPolicyData">
        <thead class="table-light">
            <tr>
                <th>@GlobalAccount.PolicyName</th>
                <th>@GlobalAccount.MinAlert</th>
                <th>@GlobalAccount.MaxAlert</th>
                <th>@GlobalAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.AccountPolicies)
            {
                <tr>
                    <td style="width:20%">@d.Name</td>
                    <td style="width:35%">@d.MinimumAlert</td>
                    <td style="width:25%">@d.MaximumAlert</td>

                    <td style="width:20%">
                        @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_accountPolicy','_AccountDetails','details','AccountingConfiguration','accountPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountName to edit">Details</a>|*@
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_accountPolicy','_CreateAccountPolicy','update','AccountingConfiguration','accountPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_AccountPolicyData','_AccountPolicyData',0,'datalistingview_accountPolicy','accountPolicy')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <table class="table table-hover" id="myDataTable_AccountData">
        <thead class="table-light">
            <tr>
                <th>@GlobalAccount.AccountNumber</th>
                <th>@GlobalAccount.AccountLabel</th>

                <th>@GlobalAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Accounts)
            {
                <tr>
                    <td style="width:35%">@d.AccountName</td>
                    <td style="width:35%">@d.AccountNumber</td>
            

                    <td style="width:30%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview_Account','_CreateAccount','update','AccountingConfiguration','account')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.AccountName @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                        <a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.AccountName" onclick="DeleteRecordDataTable('AccountingConfiguration','@d.Id','myDataTable_Account','_AccountData',0,'datalistingview_Account')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

