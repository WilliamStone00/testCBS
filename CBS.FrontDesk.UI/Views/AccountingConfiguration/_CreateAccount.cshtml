@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {<input type="hidden" name="ServiceOption" value="account" id="ServiceOption" />
                 <div class="row mt-2 gy-4">
                     @Html.HiddenFor(m => m.Account.BranchCode, new { @id = "BranchCode" })
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.ChartOfAccountManagementPositionId, new SelectList(ViewBag.ChartOfAccountManagementPositions == null ? "" : ViewBag.ChartOfAccountManagementPositions, "Text", "Value"), "---Select ChartOfAccount---", new { @class = "form-control select2", @search = "true", @id = "Account_ChartOfAccountManagementPositionId" })
                             @Html.ValidationMessageFor(m => m.Account.ChartOfAccountManagementPositionId, "", new { @class = "text-danger" })
                             <label>Select MFI_ChartOfAccount</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.AccountCategoryId, new SelectList(ViewBag.AccountCategories == null ? "" : ViewBag.AccountCategories, "Text", "Value"), "---Select Account Category---", new { @class = "form-control select2", @search = "true", @id = "Account_AccountCategoryId" })
                             @Html.ValidationMessageFor(m => m.Account.AccountCategoryId, "", new { @class = "text-danger" })
                             <label>Account category</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.AccountOwnerId, new SelectList(ViewBag.BranchCode == null ? "" : ViewBag.BranchCode, "Text", "Value"), "---Select AccountOwner---", new { @class = "form-control select2", @search = "true", @id = "AccountOwnerId" })
                             @Html.ValidationMessageFor(m => m.Account.AccountOwnerId, "", new { @class = "text-danger" })
                             <label>Account Owner</label>
                         </div>
                     </div>
                
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountNumber, new { @class = "form-control", @id = "AccountNumber" })
                             @Html.ValidationMessageFor(m => m.Account.AccountNumber, "", new { @class = "text-danger" })
                             <label>Chart of account number</label>
                         </div>
                     </div>
                     <div id="LiaisonAccountOwnerToHide">
                         <div class="col-md-12">
                             <div class="form-floating form-floating-outline">
                                 @Html.DropDownListFor(m => m.Account.AccountCounterPartId, new SelectList(ViewBag.BranchCode == null ? "" : ViewBag.BranchCode, "Text", "Value"), "---Select AccountCounterPart---", new { @class = "form-control select2", @search = "true", @id = "AccountCounterPartId" })
                                 @Html.ValidationMessageFor(m => m.Account.AccountCounterPartId, "", new { @class = "text-danger" })
                                 <label>Select Liaison Branch</label>
                             </div>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountNumberCU, new { @class = "form-control", @id = "AccountNumberCU" })
                             @Html.ValidationMessageFor(m => m.Account.AccountNumberCU, "", new { @class = "text-danger" })
                             <label>Account number [(chart of account)(branchCode)(management position)] [(000000)(000)(000)]</label>

                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountName, new { @class = "form-control", @id = "AccountName" })
                             @Html.ValidationMessageFor(m => m.Account.AccountName, "", new { @class = "text-danger" })
                             <label>Account Label</label>
                         </div>
                     </div>



                 </div>
                    <div class="mt-4">
                        @if (Model.Account.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2">Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">Update</button>
                            @Html.HiddenFor(m => m.Account.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>
