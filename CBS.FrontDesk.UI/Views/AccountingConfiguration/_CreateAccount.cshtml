@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    <input type="hidden" name="ServiceOption" value="account" id="ServiceOption" />
                 <div class="row mt-2 gy-4">
                     @Html.HiddenFor(m => m.Account.BranchCode, new { @id = "BranchCode" })
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.ChartOfAccountManagementPositionId, new SelectList(ViewBag.ChartOfAccountManagementPositions == null ? "" : ViewBag.ChartOfAccountManagementPositions, "Text", "Value"), ""+ GlobalAccount.SelectMFIChartOfAccount, new { @class = "form-control select2", @search = "true", @id = "Account_ChartOfAccountManagementPositionId" })
                             @Html.ValidationMessageFor(m => m.Account.ChartOfAccountManagementPositionId, "", new { @class = "text-danger" })
                             <label> @GlobalAccount.SelectMFIChartOfAccount</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.AccountCategoryId, new SelectList(ViewBag.AccountCategories == null ? "" : ViewBag.AccountCategories, "Text", "Value"), ""+ @GlobalAccount.SelectAccountCategory, new { @class = "form-control select2", @search = "true", @id = "Account_AccountCategoryId" })
                             @Html.ValidationMessageFor(m => m.Account.AccountCategoryId, "", new { @class = "text-danger" })
                             <label>@GlobalAccount.AccountCategory</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.Account.AccountOwnerId, new SelectList(ViewBag.BranchCode == null ? "" : ViewBag.BranchCode, "Text", "Value"), ""+ @GlobalAccount.SelectAccountOwner , new { @class = "form-control select2", @search = "true", @id = "AccountOwnerId" })
                             @Html.ValidationMessageFor(m => m.Account.AccountOwnerId, "", new { @class = "text-danger" })
                             <label>@GlobalAccount.AccountOwner</label>
                         </div>
                     </div>
                
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountNumber, new { @class = "form-control", @id = "AccountNumber" })
                             @Html.ValidationMessageFor(m => m.Account.AccountNumber, "", new { @class = "text-danger" })
                             <label>@GlobalAccount.ChartOfAccountNumber</label>
                         </div>
                     </div>
                     <div id="LiaisonAccountOwnerToHide">
                         <div class="col-md-12">
                             <div class="form-floating form-floating-outline">
                                 @Html.DropDownListFor(m => m.Account.AccountCounterPartId, new SelectList(ViewBag.BranchCode == null ? "" : ViewBag.BranchCode, "Text", "Value"), ""+ GlobalAccount.SelectAccountCounterPart , new { @class = "form-control select2", @search = "true", @id = "AccountCounterPartId" })
                                 @Html.ValidationMessageFor(m => m.Account.AccountCounterPartId, "", new { @class = "text-danger" })
                                 <label>@GlobalAccount.SelectLiaisonBranch</label>
                             </div>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountNumberCU, new { @class = "form-control", @id = "AccountNumberCU" })
                             @Html.ValidationMessageFor(m => m.Account.AccountNumberCU, "", new { @class = "text-danger" })
                             <label>@GlobalAccount.AccountNumber [(chart of account)(branchCode)(management position)] [(000000)(000)(000)]</label>

                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.Account.AccountName, new { @class = "form-control", @id = "AccountName" })
                             @Html.ValidationMessageFor(m => m.Account.AccountName, "", new { @class = "text-danger" })
                             <label>@GlobalAccount.AccountLabel</label>
                         </div>
                     </div>



                 </div>
                    <div class="mt-4 bg-primary justify-content-end">
                        @if (Model.Account.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                            @Html.HiddenFor(m => m.Account.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>
