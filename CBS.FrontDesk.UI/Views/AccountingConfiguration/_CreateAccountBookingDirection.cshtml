@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="ServiceOption" value="accountBookingDirection" id="ServiceOption" />

        <div class="row mt-4 gy-4">
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownListFor(
                        m => m.AccountBookingDirection.Id,
                        new SelectList(ViewBag.ChartOfAccounts ?? "", "Text", "Value"),
                        new { @class = "form-control select2" })
                    <label for="AccountBookingDirection_Id">Select Account</label>
                    @Html.ValidationMessageFor(m => m.AccountBookingDirection.Id, "", new { @class = "text-danger mt-1 d-block" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownListFor(
                        m => m.AccountBookingDirection.IncreaseDirection,
                        new SelectList(ViewBag.BookingDirection ?? "", "Text", "Value"),
                        new { @class = "form-control select2" })
                    <label for="AccountBookingDirection_IncreaseDirection">Account Increases In (DEBIT / CREDIT)</label>
                    @Html.ValidationMessageFor(m => m.AccountBookingDirection.IncreaseDirection, "", new { @class = "text-danger mt-1 d-block" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownListFor(
                        m => m.AccountBookingDirection.DecreaseDirection,
                        new SelectList(ViewBag.BookingDirection ?? "", "Text", "Value"),
                        new { @class = "form-control select2" })
                    <label for="AccountBookingDirection_DecreaseDirection">Account Decreases In (DEBIT / CREDIT)</label>
                    @Html.ValidationMessageFor(m => m.AccountBookingDirection.DecreaseDirection, "", new { @class = "text-danger mt-1 d-block" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownListFor(
                        m => m.AccountBookingDirection.NormalBalance,
                        new SelectList(ViewBag.BookingDirection ?? "", "Text", "Value"),
                        new { @class = "form-control select2" })
                    <label for="AccountBookingDirection_NormalBalance">Normal Account Balance (DEBIT / CREDIT)</label>
                    @Html.ValidationMessageFor(m => m.AccountBookingDirection.NormalBalance, "", new { @class = "text-danger mt-1 d-block" })
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-end">
            @if (Model.AccountBookingDirection.Id == null)
            {
                <button type="submit" class="btn btn-success px-4">Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            {
                <button type="submit" class="btn btn-primary px-4">Update</button>
                @Html.HiddenFor(m => m.AccountBookingDirection.Id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }

</div>