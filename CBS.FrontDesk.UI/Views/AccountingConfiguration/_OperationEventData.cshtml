@model  CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources
<table class="table table-hover" id="myDataTable_OperationEvent">
    <thead class="table-light">
        <tr>
            <th>@AccountingConfig_OperationEventData.OperationEventName</th>
            <th>@AccountingConfig_OperationEventData.Description</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OperationEvents)
        {

            <tr>
                <td style="width:50%">@d.OperationEventName</td>
                <td style="width:50%">@d.Description</td>

             

            </tr>


        }
    </tbody>
</table>
