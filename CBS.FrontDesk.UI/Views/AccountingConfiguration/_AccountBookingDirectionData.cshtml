@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration


    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th> Name</th>
                <th> Increase</th>
                <th> Decrease</th>
                <th> NormalBalance</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.AccountBookingDirections)
            {
                <tr>
                    <td style="width:45%">@d.AccountNumber-@d.AccountName</td>
                    <td style="width:15%">@d.IncreaseDirection</td>
                    <td style="width:15%">@d.DecreaseDirection</td>
                    <td style="width:15%">@d.NormalBalance</td>
                    <td style="width:10%">
                        @*<a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_accountPolicy','_AccountDetails','details','AccountingConfiguration','accountPolicy')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountName to edit">Details</a>|*@
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_blacklistAccount','_CreateBlacklistAccountForJE','update','AccountingConfiguration','blacklistAccount')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountNumber to edit">Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.AccountNumber" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable','_BlacklistAccountData',0,'datalistingview_blacklistAccount','blacklistAccount')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>



