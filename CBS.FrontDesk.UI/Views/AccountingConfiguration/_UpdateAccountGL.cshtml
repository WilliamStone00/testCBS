@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources

<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    <input type="hidden" name="ServiceOption" value="account" id="ServiceOption" />
                    <div class="row mt-2 gy-4">
                        @Html.HiddenFor(m => m.Account.BranchCode, new { @id = "BranchCode" })


                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Account.AccountName, new { @class = "form-control", @id = "AccountName" })
                                @Html.ValidationMessageFor(m => m.Account.AccountName, "", new { @class = "text-danger" })
                                <label>@GlobalAccount.AccountLabel</label>
                            </div>
                        </div>
               
                        <!-- Update Scope Selection -->
                        <div class="col-md-12">
                            <span class="mdi mdi-help-circle-outline waves-effect waves-light mdi-24px" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-original-title="Select update scope: 1.) Original Branch Only - Changes will only affect the current branch's accounts and configurations. 2.) Entire Union - Changes will be applied across all branches in the union network. Use with caution as union-wide updates affect all member branches."></span>
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.Account.UpdateScope, new SelectList(new[] {
                                    new { Value = "branch", Text = "Original Branch Only" },
                                    new { Value = "union", Text = "Entire Union" }
                                }, "Value", "Text"), "Select Update Scope", new { @class = "form-control select2", @id = "UpdateScope" })
                                @Html.ValidationMessageFor(m => m.Account.UpdateScope, "", new { @class = "text-danger" })
                                <label>Update Scope</label>
                            </div>
                        </div>

                        <!-- Confirmation Alert (Hidden by default) -->
                        <div class="col-md-12 mt-2" id="updateScopeAlert" style="display: none;">
                            <div class="alert alert-warning" role="alert">
                                <i class="mdi mdi-alert-circle-outline me-2"></i>
                                <span id="alertMessage"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 justify-content-end">
                        @if (Model.Account.Id == null)
                        {
                            <button type="submit" class="btn btn-success me-2">@GlobalShared.Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success me-2">@GlobalShared.Update</button>
                            @Html.HiddenFor(m => m.Account.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
