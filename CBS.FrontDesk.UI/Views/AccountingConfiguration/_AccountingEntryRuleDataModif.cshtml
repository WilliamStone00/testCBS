@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
    @using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable_AccountingEntryRule">
        <thead class="table-light">
            <tr>
                <th>@AccountingConfig_AccountingEntryRule.EntryRule</th>
                <th>@AccountingConfig_AccountingEntryRule.Derterminant</th>
                <th>@AccountingConfig_AccountingEntryRule.BalancingAccount</th>
                <th>@AccountingConfig_AccountingEntryRule.Booking</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var d in Model.AccountingRuleEntriesDTOS)
                {
                    <tr>
                        <td style="width:20%">@d.AccountingRuleEntryName</td>
                        <td style="width:25%">@d.DebitAccountLabel</td>
                        <td style="width:25%">@d.CreditAccountLabel</td>
                        <td style="width:5%">@d.BookingDirection</td>
                        <td style="width:10%">
                            @*<a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="Entris simulation for @d.AccountingRuleEntryName" onclick="GenerateEntries('AccountingConfiguration','@d.Id','myDataTable_AccountingEntryRule','_AccountingEntryRuleData',0,'datalistingview_AccountingEntryRule','accountingRuleEntry')">Entris</a>|*@
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_AccountingEntryRule','_CreateAccountingEntryRule','update','AccountingConfiguration','accountingEntryRule')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.AccountingRuleEntryName @GlobalShared.ToEdit">@GlobalShared.Edit</a>|
                            <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.AccountingRuleEntryName" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_AccountingEntryRule','_AccountingEntryRuleData',0,'datalistingview_AccountingEntryRule','accountingRuleEntry')">@GlobalShared.Delete</a>

                        </td>
                    </tr>
                }

            }
        </tbody>
    </table>
</div>
