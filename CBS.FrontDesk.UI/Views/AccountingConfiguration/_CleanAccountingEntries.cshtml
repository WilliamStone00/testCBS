@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<!-- Basic  -->
<div class="col-12">
    <div class="card mb-4">
        <h5 class="card-title"></h5>
        <div class="card-body">
            <div class="card-body">
                <form action="">

                    @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                    {
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.ListBoxFor(model => model.BranchIds, new SelectList(ViewBag.Branches == null ? new List<SelectListItem>() : ViewBag.Branches, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "BrancheIds" })
                                @Html.ValidationMessageFor(model => model.BranchIds, "", new { @class = "text-danger" })
                   
                                <label>Select Branch</label>
                            </div>
                        </div>

                    }
  
                    <div class="fallback">
                      
                        <button onclick="CleanAccountingData()" Id="CleanAccountingData" class="btn btn-primary me-2">Clean Entries</button>

                    </div>
              
                </form>

            </div>
        </div>
    </div>
</div>
<!-- /Basic  -->
