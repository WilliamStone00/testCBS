
@using Resources
@{
    ViewBag.Title = GlobalAccountPolicySetting.AccountPolicySettings;

}

<div class="row">
    <div class="col-xl-12 col-lg-9 col-md-12 order-12 order-md-12">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-file-document-outline me-2"></i>
                        @GlobalAccountPolicySetting.AccountPolicySettings
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div class="row justify-content-end">
                                    <div class="demo-inline-spacing text-end">
                                        <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_accountPolicy','_accountPolicyData','desc','datalistingview_accountPolicy',0,'accountPolicy','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                            <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                        </a>
                                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview_accountPolicy','_CreateAccountPolicy','new','AccountingConfiguration','accountPolicy')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
                                            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                        </a>
                                    </div>
                                </div>

                                <br />
                                <div id="datalistingview_accountPolicy">
                                    @Html.Partial("_CreateAccountPolicy")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>


@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/AccountingStatements.js"></script>
}
