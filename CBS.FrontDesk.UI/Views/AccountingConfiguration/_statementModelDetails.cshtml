@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration


<table class="table table-hover">
    <thead>
        <tr>
            <th>Financial document </th>
            <th>@Model.IncomeStatement.Document_type</th>
        </tr>
    </thead>
    <tbody class="table-border-bottom-0">
        <tr>
            <td style="width: 30%;">Heading</td>
            <td style="width: 70%;">@Model.IncomeStatement.Heading</td>
        </tr>
        <tr>
            <td style="width: 30%;">Reference code</td>
            <td style="width: 70%;">@Model.IncomeStatement.Reference</td>
        </tr>
    </tbody>
</table>
<div class="row invoice-preview">
    <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

        <div class="accordion-item active">
            <h2 class="accordion-header text-body d-flex justify-content-between"
                id="accordionPopoutIconThree">
                <button type="button"
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionPopoutIcon-3"
                        aria-expanded="true"
                        aria-controls="accordionPopoutIcon-3">
                    <i class="mdi mdi-file-document-plus-outline me-2"></i>
                    Manage @Model.IncomeStatement.Document_type for reference @Model.IncomeStatement.Reference
                </button>
            </h2>
            <div class="card-body">

                <br />
                <div class="collapse show">
                    <table class="table table-hover" id="myDataTable_trialbalancereference">
                        <thead class="table-light">
                            <tr>
                                <th>AccountNumber</th>
                                <th>Booking Direction</th>
                              
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.TrialBalanceReferences)
                            {
                                <tr>
                                    <td style="width:60%">@d.AccountInfo</td>
                                    <td style="width:10%">@d.OperationSide</td>
                 
                                    <td style="width:30%">
                
                                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Statementmodel','_CreateTrialBalanceReference','update','AccountingConfiguration','trialbalancereference')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Id to edit">Edit</a>|

                                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Id" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_trialbalancereference','_stamentModelData',0,'datalistingview_Statementmodel','trialbalancereference')">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>


            </div>
        </div>


    </div>
</div>