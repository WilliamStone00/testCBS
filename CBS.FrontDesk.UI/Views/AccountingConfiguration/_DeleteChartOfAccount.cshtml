@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
@{
    ViewBag.Title = @AccountingConfig_DeleteChartOfAccount.ChartOfAccount;

}
<style>
    .red-text {
        color: red;
    }
</style>
<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">

        @if (Model.ChartOfAccount == null)
        {
            <div class="card col-12 alert alert-outline-danger">
                <h5> @AccountingConfig_DeleteChartOfAccount.PleaseReloadThePageAndRestartOperation. </h5>
            </div>
           
        }
        else
        {
    <div class="card col-12 alert alert-outline-danger">
        @AccountingConfig_DeleteChartOfAccount.YouHaveRequestedToDelete:
        <br>
        @AccountingConfig_DeleteChartOfAccount.Number: @Model.ChartOfAccount.AccountNumber <br>
        @AccountingConfig_DeleteChartOfAccount.Label: @Model.ChartOfAccount.LabelEn
        <br>
        @AccountingConfig_DeleteChartOfAccount.PleaseConfirmThatYouWouldLike.
        @AccountingConfig_DeleteChartOfAccount.ThisActionCannotBeUndone.
    <button onclick="DeleteData('AccountingConfiguration', @Model.ChartOfAccount.AccountNumber,'chartOfAccount')" class="btn btn-danger waves-effect waves-light mdi-bag-checked">@AccountingConfig_DeleteChartOfAccount.Yes</button>
    </div>
        }


    </div>
    </div>
