@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
    <table class="table table-hover" id="DataTablePosition">
        <thead class="table-light">
            <tr>
                <th>@AccountingConfig_ChartOfAccount.Position</th>
                <th>@AccountingConfig_ChartOfAccount.ChartOfAccount</th>
                <th>@AccountingConfig_ChartOfAccount.General Representation</th>
                <th>@AccountingConfig_ChartOfAccount.Description</th>
                <th>@AccountingConfig_ChartOfAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.ChartofAccountManagementPositionDtos)
            {
                <tr>
                    <td style="width:15%">@d.PositionNumber</td>
                    <td style="width:30%">@d.AccountNumber</td>
                    <td style="width:25%">@d.GeneralRepresentation</td>
                    <td style="width:20%">@d.Description</td>
                    <td style="width:20%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingviewChartOfaccountManagementPosition','_CreateChartOfaccountManagementPosition','update','AccountingConfiguration','chartOfAccountManagementPosition')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.PositionNumber to edit">@GlobalShared.Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.PositionNumber" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','DataTablePosition','_ChartofAccountManagementPositionData',0,'datalistingviewChartOfaccountManagementPosition','chartOfAccountManagementPosition')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


