
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">

            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {<input type="hidden" name="ServiceOption" value="chartOfAccountManagementPosition" id="ServiceOption" />
                 <div class="row mt-2 gy-4">
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.ChartofAccountManagementPosition.ChartOfAccountId, new SelectList(ViewBag.ChartOfAccounts == null ? "" : ViewBag.ChartOfAccounts, "Text", "Value"), "---Select ChartOfAccount---", new { @class = "form-control select2", @search = "true", @id = "Account_ChartOfAccountId" })
                             @Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.ChartOfAccountId, "", new { @class = "text-danger" })
                             <label>Chart of account management position</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">

                             @Html.TextBoxFor(m => m.ChartofAccountManagementPosition.Description, new { @class = "form-control" })
                             @Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.Description, "", new { @class = "text-danger" })
                             <label>Account Descrption</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.ChartofAccountManagementPosition.PositionNumber, new { @class = "form-control" })
                             @Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.PositionNumber, "", new { @class = "text-danger" })
                             <label>Management Number</label>
                         </div>
                     </div>

                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.TextBoxFor(m => m.ChartofAccountManagementPosition.Old_AccountNumber, new { @class = "form-control" })
                             @Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.Old_AccountNumber, "", new { @class = "text-danger" })
                             <label>Old Account Number</label>
                         </div>
                     </div>
                     <div class="col-md-12">
                           @Html.DropDownListFor(m => m.ChartofAccountManagementPosition.IsHeadOfficeAccount, new SelectList(ViewBag.HeadOfficeAccount == null ? "" : ViewBag.HeadOfficeAccount, "Text", "Value"), "---Select source branch---", new { @class = "form-control select2", @search = "true" })
                         @*@Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.BranchId, "", new { @class = "text-danger" })*@
                         <label>Select the branch initiator for this account</label>
                     </div>
                     <div class="col-md-12">
                         <div class="form-floating form-floating-outline">
                             @Html.DropDownListFor(m => m.ChartofAccountManagementPosition.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "---Select source branch---", new { @class = "form-control select2", @search = "true" })
                             @*@Html.ValidationMessageFor(m => m.ChartofAccountManagementPosition.BranchId, "", new { @class = "text-danger" })*@
                             <label>Select the branch initiator for this account</label>
                         </div>
                     </div>

                 </div>
                    <div class="mt-4">
                        @if (Model.ChartofAccountManagementPosition.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2" id="btnSave">Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">Update</button>
                            @Html.HiddenFor(m => m.ChartofAccountManagementPosition.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>