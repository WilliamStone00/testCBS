@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<table class="table table-hover" id="myDataTable_Statementmodel">
    <thead class="table-light">
        <tr>
            <th>Reference</th>
            <th>Heading</th>
            <th>Document type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.IncomeStatements)
        {
            <tr>
                <td style="width:10%">@d.Reference</td>
                <td style="width:40%">@d.Heading</td>
                <td style="width:20%">@d.Document_type</td>
                <td style="width:30%">
                   <a href="#" onclick="TrialBalanceReferenceDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_trialbalancereference','_statementmodelDetails','desc','datalistingview_Statementmodel','statementmodel')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Reference to edit">Manage TrialBalance Reference</a>|
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Statementmodel','_UpdateStatementModel','update','AccountingConfiguration','statementmodel')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Reference to edit">Edit</a>|
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Reference" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_Statementmodel','_statementmodelData',0,'datalistingview_Statementmodel','statementmodel')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>