@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

@if (true)
{
    <table class="table table-hover" id="myDataTable_AccountData">
        <thead class="table-light">
            <tr>
                <th>Account Number</th>
                <th>Account Label</th>
                <th>AccountType</th>
                <th>ChartofAccount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Accounts)
            {
                <tr>
                    <td style="width:15%">@d.AccountNumber</td>
                    <td style="width:25%">@d.AccountHolder</td>
                    <td style="width:25%">@d.AccountTypeId</td>
                    <td style="width:25%">@d.ChartOfAccountId</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Account','_CreateAccount','update','AccountingConfiguration','account')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountHolder to edit">Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.AccountHolder" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','myDataTable_Account','_AccountData',0,'datalistingview_Account','account')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <table class="table table-hover" id="myDataTable_AccountData">
        <thead class="table-light">
            <tr>
                <th>Account Number</th>
                <th>Account Label</th>

                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Accounts)
            {
                <tr>
                    <td style="width:35%">@d.AccountHolder</td>
                    <td style="width:35%">@d.AccountNumber</td>
            

                    <td style="width:30%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview_Account','_CreateAccount','update','AccountingConfiguration','account')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.AccountHolder to edit">Edit</a>
                        <a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete @d.AccountHolder" onclick="DeleteRecordDataTable('AccountingConfiguration','@d.Id','myDataTable_Account','_AccountData',0,'datalistingview_Account')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

