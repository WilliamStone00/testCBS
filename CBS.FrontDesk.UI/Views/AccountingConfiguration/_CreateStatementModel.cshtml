
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
    <input type="hidden" name="ServiceOption" value="statementModel" id="ServiceOption" />
    <div class="row mt-2 gy-4">
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.IncomeStatement.Document_type, new SelectList(ViewBag.Document_type == null ? "" : ViewBag.Document_type, "Text", "Value"), "---Select Document---", new { @class = "form-control select2", @search = "true", @id = "document_type" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.Document_type, "", new { @class = "text-danger" })
                <label for="Document_type">Document</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.IncomeStatement.Document_Sub_type, new SelectList(ViewBag.Document_Sub_type == null ? "" : ViewBag.Document_Sub_type, "Text", "Value"), "---Select DocumentType---", new { @class = "form-control select2", @search = "true", @id = "document_Sub_type" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.Document_Sub_type, "", new { @class = "text-danger" })
                <label for="Document_type">Document Type</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(model => model.IncomeStatement.Reference, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.Reference, "", new { @class = "text-danger" })
                <label for="Reference">Reference</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToShow1">
            <div class="form-floating form-floating-outline">
                @Html.ListBoxFor(m => m.IncomeStatement.AccountIds, new SelectList(ViewBag.ChartOfAccountReport == null ? new List<SelectListItem>() : ViewBag.ChartOfAccountReport, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple" ,@id= "incomeOrExpense" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.AccountIds, "", new { @class = "text-danger" })
                <label for="AccountIds">Select account numbers from chart of account to be used for income and expense statement</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToShow2">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.IncomeStatement.OperationSide, new SelectList(ViewBag.OperationSide == null ? "" : ViewBag.OperationSide, "Text", "Value"), "---Select BookingDirection---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.OperationSide, "", new { @class = "text-danger" })
                <label for="Document">Select booking direction to consider</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToHide1">
            <div class="form-floating form-floating-outline">
                @Html.ListBoxFor(m => m.IncomeStatement.GrossChartOfAccountId, new SelectList(ViewBag.ChartOfAccountReport == null ? new List<SelectListItem>() : ViewBag.ChartOfAccountReport, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "GrossChartOfAccountId" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.GrossChartOfAccountId, "", new { @class = "text-danger" })
                <label for="AccountIds">Select account numbers from chart of account to be used as Gross account</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToHide2">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.IncomeStatement.OperationSideGross, new SelectList(ViewBag.OperationSide == null ? "" : ViewBag.OperationSide, "Text", "Value"), "---Select BookingDirection---", new { @class = "form-control select2", @search = "true", @id = "OperationSideGross" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.OperationSideGross, "", new { @class = "text-danger" })
                <label for="Document">Select gross account booking direction</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToHide3">
            <div class="form-floating form-floating-outline">
                @Html.ListBoxFor(m => m.IncomeStatement.AmortizationChartOfAccountId, new SelectList(ViewBag.ChartOfAccountReport == null ? new List<SelectListItem>() : ViewBag.ChartOfAccountReport, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple", @id = "AmortizationChartOfAccountId" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.AmortizationChartOfAccountId, "", new { @class = "text-danger" })
                <label for="AccountIds">Select account numbers from chart of account to be used as amortization account</label>
            </div>
        </div>
        <div class="col-md-12" id="itemsToHide4">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.IncomeStatement.OperationSideAmortization, new SelectList(ViewBag.OperationSide == null ? "" : ViewBag.OperationSide, "Text", "Value"), "---Select BookingDirection---", new { @class = "form-control select2", @search = "true", @id = "OperationSideAmortization" })
                @Html.ValidationMessageFor(model => model.IncomeStatement.OperationSideAmortization, "", new { @class = "text-danger" })
                <label for="Document">Select amortizations booking direction</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextAreaFor(m => m.IncomeStatement.Heading, new { @class = "form-control", @style = "height: 150px;" })
                @Html.ValidationMessageFor(m => m.IncomeStatement.Heading, "", new { @class = "text-danger" })
                <label for="Documentxxx">Heading (Description)</label>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (Model.IncomeStatement.Id == null)
            {
        <button type="submit" class="btn btn-primary me-2">Save</button>
        <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">Update</button>
        @Html.HiddenFor(m => m.IncomeStatement.Id)
        <input type="hidden" name="Action" value="update" id="Action" />
            }
    </div>
    }
</div>
