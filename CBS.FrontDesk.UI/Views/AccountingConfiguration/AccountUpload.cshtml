
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<!-- Basic  -->
<div class="col-12">
    <div class="card mb-4">
        <h5 class="card-header">Basic</h5>
        <div class="card-body">
            <form action="" class="dropzone needsclick dz-clickable" id="dropzone-basic">
                <div class="dz-message needsclick">
                    Account Upload
                    <span class="note needsclick">
                        The format of this file should be .XLSX and should have the following column.
                        <span class="fw-medium">Respect</span>Column as mention below
                    </span>
                    (This view is only visible for migration)
                    <table class="table table-hover" id="myDataTable_AccountUploadData">
                        <thead class="table-light">
                            <tr>
                                <th>Account Number</th>
                                <th>Account Name</th>
                                <th>ChartOfAccount</th>
                                <th>CreatedDate</th>
                                <th>Current Balance</th>
                                <th>Beginning Balance</th>

                                <th>Branch Code</th>

                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="fallback">
                    <input name="file" type="file" class="btn btn-primary" id="uploadedFile" /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <button onclick="ReadExcelFile()" Id="ReadUploadedFile" class="btn btn-primary me-2">Read file</button>
                    @*<button onclick="ExecuteExcelFile(12320)" class="btn btn-primary me-2">Execute File</button>*@
                </div>

            </form>
        </div>
    </div>
</div>
<!-- /Basic  -->



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/Account.js"></script>

}

