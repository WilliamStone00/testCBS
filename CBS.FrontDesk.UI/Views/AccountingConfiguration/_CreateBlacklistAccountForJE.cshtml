@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="blacklistAccount" id="ServiceOption" />
     <div class="row mt-2 gy-4">
   
         <div class="col-md-12">
             <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.BlacklistedAccounts.Id, new SelectList(ViewBag.ChartOfAccountManagementPositions == null ? new List<SelectListItem>() : ViewBag.ChartOfAccountManagementPositions, "Text", "Value"), new { @class = "form-control select2", @multiple = "multiple" })
               
                 @Html.ValidationMessageFor(m => m.BlacklistedAccounts.Id, "", new { @class = "text-danger" })
                 <label>Select Account</label>
             </div>

         </div>
    
     </div>

        <div class="mt-4">
            @if (Model.BlacklistedAccounts.Id == null)
            {
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">Update</button>
                @Html.HiddenFor(m => m.BlacklistAccount.Id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }
</div>