
@{
    ViewBag.Title = "Accounting Configurations";

}

<div class="card mb-12">

    <h2> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Accounting Configuration Panel </h2>
    <div class="row">
        <div class="col-md-12">

            <div class="accordion mt-3" id="accordionExample">

                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingThree">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionThree"
                                aria-expanded="false"
                                aria-controls="accordionThree">
                            <i class="tf-icons mdi mdi-typewriter me-1"></i>       &nbsp; &nbsp;&nbsp;&nbsp;&nbsp;Account Type (Ordinary Account,Operations Account ...etc)
                        </button>
                    </h2>
                    <div id="accordionThree"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingThree"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_AccountType','_AccountTypeData','desc','datalistingview_AccountType',0,'accountType','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_AccountType','_CreateAccountType','new','AccountingConfiguration','accountType')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>

                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_AccountType">
                                @Html.Partial("_CreateAccountType")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingfive">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionfive"
                                aria-expanded="false"
                                aria-controls="accordionfive">
                            <i class="tf-icons mdi mdi-file-account-outline me-1"></i>    &nbsp; &nbsp; &nbsp; &nbsp;   Account Management
                        </button>
                    </h2>
                    <div id="accordionfive"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingThree"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_AccountData','_AccountData','desc','datalistingview_Account',0,'account','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_Account','_CreateAccount','new','AccountingConfiguration','account')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_Account','_AccountUpload','upload','AccountingConfiguration','account')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-upload mdi-18px"></span>
                                    </a>
                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_Account">
                                @Html.Partial("_CreateAccount")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingsix">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionsix"
                                aria-expanded="false"
                                aria-controls="accordionsix">
                            <i class="tf-icons mdi mdi-book-open-page-variant-outline me-1"></i>  &nbsp; &nbsp; &nbsp; &nbsp;   Operation Event Management
                        </button>
                    </h2>
                    <div id="accordionsix"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingsix"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_OperationEvent','_OperationEventData','desc','datalistingview_OperationEvent',0,'operationEvent','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_OperationEvent','_CreateOperationEvent','new','AccountingConfiguration','operationEvent')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_OperationEvent">
                                @Html.Partial("_CreateOperationEvent")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingseven">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionseven"
                                aria-expanded="false"
                                aria-controls="accordionseven">
                            <i class="tf-icons mdi mdi-book-lock-open-outline me-1"></i>   &nbsp; &nbsp; &nbsp; &nbsp;   Operation Event Attribute Management
                        </button>
                    </h2>
                    <div id="accordionseven"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingseven"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_OperationEventAttribute','_OperationEventAttributeData','desc','datalistingview_OperationEventAttribute',0,'operationEventAttribute','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_OperationEventAttribute','_CreateOperationEventAttribute','new','AccountingConfiguration','operationEventAttribute')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_OperationEventAttribute">
                                @Html.Partial("_CreateOperationEventAttribute")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingeight">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordioneight"
                                aria-expanded="false"
                                aria-controls="accordioneight">
                            <i class="tf-icons mdi mdi-book-account-outline me-1"></i>
                            &nbsp; &nbsp; &nbsp; &nbsp;   Accounting Event EntryRule Management
                        </button>
                    </h2>
                    <div id="accordioneight"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingeight"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGen('AccountingConfiguration','myDataTable_AccountingEntryRule','_AccountingEntryRuleData','desc','datalistingview_AccountingEntryRule',0,'accountingEntryRule','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>
                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_AccountingEntryRule','_CreateAccountingEntryRule','new','AccountingConfiguration','accountingEntryRule')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_AccountingEntryRule">
                                @Html.Partial("_CreateAccountingEntryRule")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingnine">
                        <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionnine" aria-expanded="false" aria-controls="accordionnine">
                            <i class="tf-icons mdi mdi-toolbox-outline me-1"></i>
                            &nbsp; &nbsp; &nbsp; &nbsp; Configure Financial Report (Profit and Lost , Balance Sheet)<br>
                        </button>
                    </h2>
                    <div id="accordionnine" class="accordion-collapse collapse" aria-labelledby="headingnine" data-bs-parent="#accordionExample">
                        <div class="accordion-body">

                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <button type="submit" onclick="LoadDataGen('AccountingConfiguration','myDataTable_Statementmodel','_statementModelData','desc','datalistingview_Statementmodel',0,'statementmodel','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </button>
                                    <button type="submit" onclick="AddORUpdateGen(null,'datalistingview_Statementmodel','_CreateStatementModel','new','AccountingConfiguration','statementmodel')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </button>
                                </div>
                            </div>
                            <br />
                            <div id="datalistingview_Statementmodel">
                                @Html.Partial("_CreateStatementModel")
                            </div>
                        </div>


                    </div>
                </div>
            </div>



        </div>
    </div>

</div>

<!--/ Accordion -->





@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/Account.js"></script>

}

