@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
<table class="table table-hover" id="DataTablePosition">
    <thead class="table-light">
        <tr>
            @*<th>ChartofAccount<</th>*@
            <th>@AccountingConfig_DownloadMFIChartOfAccount.OldAccountNumber</th>
            @*<th>Account Formular</th>*@
            <th>@AccountingConfig_DownloadMFIChartOfAccount.NewAccountNumber</th>
            <th>@AccountingConfig_DownloadMFIChartOfAccount.Description</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.ListChartofAccountManagementPosition)
        {
            <tr>

                @*<td style="width:15%">@d.AccountNumber</td>*@
                <td style="width:20%">@d.Old_AccountNumber</td>
                @*<td style="width:20%">@d.PositionNumber</td>*@
                <td style="width:20%">@d.New_AccountNumber</td>
                <td style="width:60%">@d.Description</td>

            </tr>
        }

    </tbody>
</table>
<button type="button" onclick="DownloadMFIChartOfAccount()" class="btn btn-primary me-2 mdi-download-circle-outline">@AccountingConfig_DownloadMFIChartOfAccount.DownloadMFIChartOfAccount</button>

