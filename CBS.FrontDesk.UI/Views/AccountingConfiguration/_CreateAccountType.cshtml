@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">
            <div class="card-header d-flex justify-content-between align-items-center">           
                <small class="text-body float-end">Create new accountType <br></small>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {<input type="hidden" name="ServiceOption" value="accountType" id="ServiceOption" />

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.AccountingRuleEntry.OperationEventId, new SelectList(ViewBag.OperationEvent == null ? "" : ViewBag.OperationEvent, "Id", "OperationEventName"), "---Select Operation Event---", new { @class = "form-control select2", @search = "true", id = "OperationEventId" })
                            @Html.ValidationMessageFor(model => model.AccountingRuleEntry.OperationEventId, "", new { @class = "text-danger" })
                            <label for="OperationEventId">Event</label>
                        </div>
                    </div>

              
                    <div class="mt-4">
                        @if (Model.AccountType.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2">Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">Update</button>
                            @Html.HiddenFor(m => m.AccountType.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }
 
            </div>
        </div>
    </div>
</div>
