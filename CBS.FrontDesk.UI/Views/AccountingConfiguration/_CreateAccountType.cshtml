@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-12">
            <div class="card-header d-flex justify-content-between align-items-center">           
                <small class="text-body float-end">Create new accountType <br></small>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {<input type="hidden" name="ServiceOption" value="accountType" id="ServiceOption" />
                  
                    <div class="row mt-2 gy-4">
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AccountType.name, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Account.AccountNumber, "", new { @class = "text-danger" })
                                <label>Type</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AccountType.operationAccountTypeId, new { @class = "form-control" })
                              @Html.ValidationMessageFor(m => m.AccountType.operationAccountTypeId, "", new { @class = "text-danger" })
                                <label>Code</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AccountType.operationAccountType, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AccountType.operationAccountType, "", new { @class = "text-danger" })
                                <label>DesCription</label>
                            </div>
                        </div>


                    </div>
                    <div class="mt-4">
                        @if (Model.AccountType.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2">Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">Update</button>
                            @Html.HiddenFor(m => m.AccountType.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>
