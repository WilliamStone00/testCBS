@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
@if (true)
{
    <table class="table table-hover" id="myDataTable_AccountData">
        <thead class="table-light">
            <tr>
                <th>@GlobalAccount.AccountNumber</th>
                <th>@GlobalAccount.AccountLabel</th>

                <th>@GlobalAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Accounts)
            {
                <tr>
                    <td style="width:20%">@d.AccountNumberCU</td>
                    <td style="width:60%">@d.AccountName</td>
                  
                    <td style="width:25%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Account','_AccountDetails','details','AccountingConfiguration','account')" class="mr-2" data-toggle="tooltip" data-placement="top" title=" @GlobalAccount.SelectToEdit @d.AccountName ">@GlobalAccount.Details</a>|
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Account','_CreateAccount','update','AccountingConfiguration','account')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalAccount.SelectToEdit @d.AccountName">@GlobalAccount.Edit</a>
                        @**@
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <table class="table table-hover" id="myDataTable_AccountData">
        <thead class="table-light">
            <tr>
                <th>@GlobalAccount.AccountNumber </th>
                <th>@GlobalAccount.AccountLabel</th>
                <th>@GlobalAccount.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Accounts)
            {
                <tr>
                    <td style="width:35%">@d.AccountName</td>
                    <td style="width:35%">@d.AccountNumber</td>
            

                    <td style="width:30%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview_Account','_CreateAccount','update','AccountingConfiguration','account')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalAccount.SelectToEdit @d.AccountName">@GlobalAccount.Edit</a>
                        <a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="@GlobalAccount.Delete @d.AccountName" onclick="DeleteRecordDataTable('AccountingConfiguration','@d.Id','myDataTable_Account','_AccountData',0,'datalistingview_Account')">@GlobalAccount.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

