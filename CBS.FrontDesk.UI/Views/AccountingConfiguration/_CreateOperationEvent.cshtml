@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEvent" id="ServiceOption" />
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.OperationEvent.OperationEventName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OperationEvent.OperationEventName, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.OperationEvent.EventCode, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OperationEvent.EventCode, "", new { @class = "text-danger" })
                    <label>EventCode</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    
                        @Html.TextAreaFor(m => m.OperationEvent.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.OperationEvent.Description, "", new { @class = "text-danger" })
                        <label>Description</label>
                  
                </div>
            </div>

       




        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Save</button>
            <button type="reset" class="btn btn-outline-secondary">Reset</button>
        </div>
    }
</div>