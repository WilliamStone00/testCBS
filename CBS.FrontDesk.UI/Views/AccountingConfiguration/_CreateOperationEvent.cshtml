@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
@using Resources
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEvent" id="ServiceOption" />
     <div class="row mt-2 gy-4">
         <div class="col-md-4">
             <div class="form-floating form-floating-outline">
                 @Html.TextBoxFor(m => m.OperationEvent.OperationEventName, new { @class = "form-control" })
                 @Html.ValidationMessageFor(m => m.OperationEvent.OperationEventName, "", new { @class = "text-danger" })
                 <label>@AccountingConfig_CreateOperationEventAttribute.Name</label>
             </div>
         </div>
         <div class="col-md-4">
             <div class="form-floating form-floating-outline">
                 @Html.DropDownListFor(m => m.OperationEvent.OperationEventType, new SelectList(ViewBag.OperationEventType == null ? "" : ViewBag.OperationEventType, "Text", "Value"), "---"+@AccountingConfig_CreateOperationEventAttribute.SelectOperationEvenType + "---", new { @class = "form-control select2", @search = "true" })

                 @Html.ValidationMessageFor(m => m.OperationEvent.OperationEventType, "", new { @class = "text-danger" })
                 <label>@AccountingConfig_CreateOperationEventAttribute.OperationEventType</label>
             </div>

         </div>
         <div class="col-md-4">
             <div class="form-floating form-floating-outline">
                 @Html.TextBoxFor(m => m.OperationEvent.EventCode, new { @class = "form-control" })
                 @Html.ValidationMessageFor(m => m.OperationEvent.EventCode, "", new { @class = "text-danger" })
                 <label>@AccountingConfig_CreateOperationEventAttribute.EventCode</label>
             </div>

         </div>

         <div class="col-md-12">
             <div class="form-floating form-floating-outline">

                 @Html.TextAreaFor(m => m.OperationEvent.Description, new { @class = "form-control", @style = "height: 200px;" })
                 @Html.ValidationMessageFor(m => m.OperationEvent.Description, "", new { @class = "text-danger" })
                 <label>@AccountingConfig_CreateOperationEventAttribute.Description</label>

             </div>
         </div>






     </div>

        <div class="mt-4">
            @if (Model.OperationEvent.Id == null)
            {
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                @Html.HiddenFor(m => m.OperationEvent.Id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }
</div>