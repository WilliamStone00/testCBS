@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

 
<div class="table-responsive mb-3">
    <table class="table table-hover" id="FileUploadDataTable">
        <thead class="table-light" >
            <tr>
                <th>Branch Name</th>
                <th>File size</th>
                <th>Created By</th>
                <th>Uploaded Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.TrialBalanceFiles)
            {
                <tr>
                    <td style="width:30%">@d.Owner</td>
                    <td style="width:15%">@d.Size</td>
                    <td style="width:25%">@d.CreatedBy</td>
                    <td style="width:20%">@d.CreatedDate</td>
                    <td style="width:10%">
                        <a href="#" onclick="DownloadFile('@d.FilePath')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Owner TrialBalance">  Download </a>
 
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>




