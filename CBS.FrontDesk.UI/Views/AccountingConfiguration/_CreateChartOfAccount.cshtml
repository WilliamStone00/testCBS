 
@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
 
<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card mb-4">

            @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { id = "chartOfAccountForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
            {

                if (@Model.ChartOfAccount.Id==null)
                {
                    <div class="misc-wrapper text-center">
                        <br /> <br />    <br /> <br />
                        <h1 class="mb-2 mx-2" style="font-size: 3rem">422</h1>
                        <h4 class="mb-2">Internal server error</h4>
                        <p class="mb-2 mx-2">Makesure the chart of account you are creating if found under an existing chart of account.</p>
                        <div class="d-flex justify-content-center mt-5">

                            <div>
                                <a href="/AccountingConfiguration" class="btn btn-primary text-center my-5">Click to Reload Page</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    if (@Model.ChartOfAccount == null)
                    {
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"></h5>
                            <small class="text-body float-end">
                                You are about to create a new item on your accounting chart kindly makesure you follow the strictly the chart Of Account
                                applied in COBAC Zone
                            </small>
                        </div>
                        <div class="card-body">
                            <input type="hidden" name="ServiceOption" value="chartOfAccount" id="ServiceOption" />
                            <!-- Hidden field for AccountNumber -->

                            @Html.HiddenFor(model => model.ChartOfAccount.ParentAccountId) <!-- Hidden field for AccountNumber -->

                            <div class="form-floating form-floating-outline mb-4">
                                @Html.TextBoxFor(model => model.ChartOfAccount.AccountNumber, new { @class = "form-control", placeholder = "Account Number" })
                                @Html.LabelFor(model => model.ChartOfAccount.AccountNumber, new { @for = "accountNumber" })
                                @Html.ValidationMessageFor(model => model.ChartOfAccount.AccountNumber, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-floating form-floating-outline mb-4">
                                @Html.TextBoxFor(model => model.ChartOfAccount.LabelEn, new { @class = "form-control", placeholder = "Account Label" })
                                <label>Account label(English)</label>
                                @Html.ValidationMessageFor(model => model.ChartOfAccount.LabelEn, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-floating form-floating-outline mb-4">
                                @Html.TextBoxFor(model => model.ChartOfAccount.LabelFr, new { @class = "form-control", placeholder = "Account Label" })
                                <label>Account label(French)</label>
                                @Html.ValidationMessageFor(model => model.ChartOfAccount.LabelFr, "", new { @class = "text-danger" })
                            </div>

                            @*<div class="form-floating form-floating-outline mb-4">
                                @Html.DropDownListFor(model => model.ChartOfAccount.OperationDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---Select BookingDirection---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(model => model.ChartOfAccount.OperationDirection, "", new { @class = "text-danger" })
                                <label>BookingDirection</label>
                            </div>*@

                            <div class="form-floating form-floating-outline mb-4">
                                @Html.DropDownListFor(model => model.ChartOfAccount.AccountCartegoryId, new SelectList(ViewBag.AccountCartegories == null ? "" : ViewBag.AccountCartegories, "Id", "Name"), "---Select Cartegory---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(model => model.ChartOfAccount.AccountCartegoryId, "", new { @class = "text-danger" })
                                <label>AccountCartegory</label>
                            </div>
                            <div class="form-check mb-4">
                                @Html.CheckBoxFor(model => model.ChartOfAccount.CanBeNegative, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.ChartOfAccount.CanBeNegative, new { @class = "form-check-label" })
                            </div>
                       
                        
                            @if (@Model.ChartOfAccount == null)
                            {
                                <button type="submit" id="Add" class="btn btn-primary waves-effect waves-light">Save</button>
                                @Html.HiddenFor(model => model.ChartOfAccount.ParentAccountId)
                                <input type="hidden" name="Action" value="insert" id="Action" />
                            }
                            else
                            { <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(model => model.ChartOfAccount.AccountNumber)
                                <input type="hidden" name="Action" value="update" id="Action" />
                            }

                        </div>
                    }
                    else
                    {
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <small class="text-body float-end"> @Model.ChartOfAccount.AccountNumber-@Model.ChartOfAccount.LabelEn</small><br>
                        </div>
                        <div class="card-body">
                            <input type="hidden" name="ServiceOption" value="chartOfAccount" id="ServiceOption" />
                            <!-- Hidden field for AccountNumber -->

                            <div class="card-body">
                                <input type="hidden" name="ServiceOption" value="chartOfAccount" id="ServiceOption" />
                                <!-- Hidden field for AccountNumber -->

                                @Html.HiddenFor(model => model.ChartOfAccount.ParentAccountId) <!-- Hidden field for AccountNumber -->

                                <div class="form-floating form-floating-outline mb-4">
                                    @Html.TextBoxFor(model => model.ChartOfAccount.AccountNumber, new { @class = "form-control", placeholder = "Account Number" })
                                    @Html.LabelFor(model => model.ChartOfAccount.AccountNumber, new { @for = "accountNumber" })
                                    @Html.ValidationMessageFor(model => model.ChartOfAccount.AccountNumber, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-floating form-floating-outline mb-4">
                                    @Html.TextBoxFor(model => model.ChartOfAccount.LabelEn, new { @class = "form-control", placeholder = "Account Label" })
                                    <label>Account label(English)</label>
                                    @Html.ValidationMessageFor(model => model.ChartOfAccount.LabelEn, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-floating form-floating-outline mb-4">
                                    @Html.TextBoxFor(model => model.ChartOfAccount.LabelFr, new { @class = "form-control", placeholder = "Account Label" })
                                    <label>Account label(French)</label>
                                    @Html.ValidationMessageFor(model => model.ChartOfAccount.LabelFr, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-floating form-floating-outline mb-4">
                                    @*@Html.DropDownListFor(model => model.ChartOfAccount.OperationDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---Select BookingDirection---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(model => model.ChartOfAccount.OperationDirection, "", new { @class = "text-danger" })*@
                                    @*<label>BookingDirection</label>*@
                                </div>

                                <div class="form-floating form-floating-outline mb-4">
                                    @Html.DropDownListFor(model => model.ChartOfAccount.AccountCartegoryId, new SelectList(ViewBag.AccountCartegories == null ? "" : ViewBag.AccountCartegories, "Id", "Name"), "---Select Cartegory---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(model => model.ChartOfAccount.AccountCartegoryId, "", new { @class = "text-danger" })
                                    <label>AccountCartegory</label>
                                </div>
                                <div class="form-check mb-4">
                                    @Html.CheckBoxFor(model => model.ChartOfAccount.CanBeNegative, new { @class = "form-check-input" })
                                    @Html.LabelFor(model => model.ChartOfAccount.CanBeNegative, new { @class = "form-check-label" })
                                </div>
                                <div class="form-check mb-4">
                                    @Html.CheckBoxFor(model => model.ChartOfAccount.IsBalanceSheetAccount, new { @class = "form-check-input" })
                                    @Html.LabelFor(model => model.ChartOfAccount.IsBalanceSheetAccount, new { @class = "form-check-label" })
                                </div>

                                
                            </div>
                            @if (@Model.ChartOfAccount == null)
                            {
                                <button type="submit" id="Add" class="btn btn-primary waves-effect waves-light">Save</button>
                                @Html.HiddenFor(model => model.ChartOfAccount.ParentAccountId)
                                <input type="hidden" name="Action" value="insert" id="Action" />
                            }
                            else
                            { <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(model => model.ChartOfAccount.AccountNumber)
                                <input type="hidden" name="Action" value="update" id="Action" />
                            }

                        </div>

                    }
                }



            }

        


        </div>
    </div>
</div>



