@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration


@{
    ViewBag.Title = "Accounting  Rule";
}

<div class="card mb-12">
    <div class="card-header">
        <h5 class="card-title mb-0">Setting Multiple Accounting Entry Rule </h5>
    </div>
    <div class="card-body">
        <div class="row">

            <!-- Navigation -->
            <div class="col-12 col-md-4  card-separator">

                <div id="datalistingview_AddEntry">

                    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <input type="hidden" name="ServiceOption" value="accountingRule" id="ServiceOptionn" />
                        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                            <div class="col-12">
                                <div class="card">

                                    <div class="card-header">

                                        <h5 class="card-title">
                                            Entry Rule EventCode: @Html.TextBoxFor(m => m.AccountingRule.RuleName, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.AccountingRule.RuleName, "", new { @class = "text-danger" })

                                        </h5>
                                    </div>
                                    <div class="row card-body">


                                        <div class="row mt-2 gy-4">

                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.AccountingRule.AccountingEntryRuleId, new SelectList(ViewBag.AccountingRuleEntries == null ? "" : ViewBag.AccountingRuleEntries, "Text", "Value"), "---Select Entry Rule---", new { @class = "form-control select2", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.AccountingRule.AccountingEntryRuleId, "", new { @class = "text-danger" })
                                                    <label>Accounting Entry Rule</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.AccountingRule.BookingDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---Select Direction---", new { @class = "form-control select2", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.AccountingRule.BookingDirection, "", new { @class = "text-danger" })
                                                    <label>Booking Direction</label>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="mt-4">
                                            <button type="button" onclick="AddEntryRule()" class="btn btn-primary" id="addEntryRule">
                                                Add Entry Rule&nbsp; &nbsp; <i class="mdi mdi-plus-box-multiple"></i>
                                            </button>
                                            <input type="hidden" name="Action" value="insert" id="Action" />

                                        </div>

                                    </div>
                                    <hr />

                                </div>
                            </div>
                        </div>

                    }

                </div>

            </div>
            <!-- Navigation Body -->
            <div class="col-12 col-md-8 ">
                <div class="col-12 col-md-8 ">



                </div>
                <div class="tab-content  card-separator">
                    <br />
                    <div id="datalistingview_RuleEntry">
                      
                    </div>
                    <br />


                </div>
            </div>

        </div>
    </div>
</div>

