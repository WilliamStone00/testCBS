@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "AccountingConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEventAttribute" id="ServiceOption" />
        @Html.HiddenFor(m => m.OperationEventAttribute.OperationEventId)
        <div class="row mt-2 gy-4">
            <div class="col-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.OperationEventAttribute.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OperationEventAttribute.Name, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.OperationEventAttribute.Description, new { @class = "form-control", @style = "height: 200px;" })
                    @Html.ValidationMessageFor(m => m.OperationEventAttribute.Description, "", new { @class = "text-danger" })
                    <label>Description</label>
                </div>
            </div>


        </div>

        <div class="mt-4">
            <button type="submit" onclick="" class="btn btn-primary me-2">Save</button>
            <button type="reset" onclick="" class="btn btn-outline-secondary" data-bs-dismiss="modal"> Close</button>
            <div class="text-center text-muted"><small>C B S 4 U user account (@Session["FullName"])</small></div>
        </div>
       
    }
</div>