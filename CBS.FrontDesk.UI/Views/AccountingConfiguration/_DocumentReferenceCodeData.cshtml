@model CBS.FrontDesk.Data.Entity.Accounting.AccountingConfiguration

<table class="table table-hover" id="DataTable_DocumentReference">
    <thead class="table-light">
        <tr>
            <th>Reference</th>
            <th>Heading</th>
            <th>Document</th>
            <th>Cartegory </th>
            <th>Action</th>
        </tr>
      
    </thead>
    <tbody>
        @foreach (var d in Model.DocumentReferenceCodeDataDtos)
        {
            <tr>
                <td style="width:10%">@d.ReferenceCode</td>
                <td style="width:30%">@d.Description</td>
                <td style="width:20%">@d.Document</td>
                <td style="width:20%">@d.DocumentType</td>
                <td style="width:20%">
                    <a href="#" onclick="GetData('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_CreateDocumentReferenceCode','desc','update','datalistingview_DocumentReferenceCode','documentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ReferenceCode account to edit">Edit</a>|
                    <a href="#" onclick="GetData('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_DocumentReferenceCodeDetails','desc','details','datalistingview_DocumentReferenceCode','documentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ReferenceCode account to edit">Details</a>|
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.ReferenceCode" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.Id','DataTable_DocumentReference','_DocumentReferenceCodeData',0,'datalistingview_DocumentReferenceCode','documentReferenceCode')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>