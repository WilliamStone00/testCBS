
@{
    ViewBag.Title = "Accounting Configurations";

}


<div class="card mb-12">


    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-account-check me-2"></i> MANUAL POSTING RULES
                    </h1>
                    <p class="card-text">
                        This menu allows the financial manager to configure which accounts should be visible during manual journal entry.
                        It provides flexibility for the accountant to control which accounts should not be used for manual journal entries.
                    </p>
                    <p class="card-text text-warning fw-bold">
                        <i class="mdi mdi-alert-circle-outline me-1"></i> All account already mapped to a product are excluded from the manual entry.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Tips Section -->
    <!-- Tips Section -->
    <div class="card mb-3 border-success">
        <h6 class="card-header d-flex justify-content-between align-items-center text-white bg-success">
            <span><i class="mdi mdi-bell-alert-outline me-2"></i>Tips for Using the “Hide from GL to GL Journals</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseTips" class="collapse show">
            <div class="card-body bg-light">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-light">
                        <i class="mdi mdi-help-circle-outline text-primary me-2"></i>
                        <strong class="text-primary">Purpose of This Menu</strong><br>
                        This configuration allows the System Administrator to hide specific General Ledger (GL) accounts from appearing in the GL to GL Journal interface. It helps control visibility of sensitive or system accounts.
                    </li>

                    <li class="list-group-item bg-light">
                        <i class="mdi mdi-clock-alert-outline text-warning me-2"></i>
                        <strong class="text-warning">When to Use This Feature</strong><br>
                        Use this menu if the GL account:
                        <ul class="mt-2">
                            <li><i class="mdi mdi-circle-small text-success me-1"></i> Is reserved for internal/system operations</li>
                            <li><i class="mdi mdi-circle-small text-success me-1"></i> Should not be manually posted to via GL to GL</li>
                            <li><i class="mdi mdi-circle-small text-success me-1"></i> Needs to be restricted for security or operational reasons</li>
                        </ul>
                    </li>

                    <li class="list-group-item bg-light">
                        <i class="mdi mdi-cog-outline text-info me-2"></i>
                        <strong class="text-info">How to Configure</strong><br>
                        <ul class="mt-2">
                            <li><i class="mdi mdi-checkbox-marked-circle-outline text-success me-1"></i> Select the account you want to hide from the provided list</li>
                            <li><i class="mdi mdi-checkbox-marked-circle-outline text-success me-1"></i> Click Post to apply the setting</li>
                            <li><i class="mdi mdi-checkbox-marked-circle-outline text-success me-1"></i> Once posted, the account will no longer appear in the GL to GL Journal screen</li>
                        </ul>
                    </li>

                    <li class="list-group-item bg-light">
                        <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>
                        <strong class="text-danger">Important Note</strong><br>
                        The account is not deleted or deactivated—it simply becomes invisible for GL to GL journal entries. You can make it visible again by removing it from the hidden list at any time.
                    </li>

                    <li class="list-group-item bg-light">
                        <i class="mdi mdi-lightbulb-on-outline text-success me-2"></i>
                        <strong class="text-success">Best Practice</strong><br>
                        <ul class="mt-2">
                            <li><i class="mdi mdi-star-circle-outline text-warning me-1"></i> Work closely with your finance or audit team before hiding any accounts</li>
                            <li><i class="mdi mdi-star-circle-outline text-warning me-1"></i> Ensure that hiding the account won't interfere with required reporting or reconciliation</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">

            <div class="accordion mt-3" id="accordionExample">


                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingsix">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionsix"
                                aria-expanded="false"
                                aria-controls="accordionsix">
                            <i class="tf-icons mdi mdi-book-open-page-variant-outline me-1"></i>  &nbsp; &nbsp; &nbsp; &nbsp; Setting account visiblity
                        </button>
                    </h2>
                    <div id="accordionsix"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingsix"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGeneration('AccountingConfiguration','myDataTable','_BlacklistAccountData','datalistingview_blacklistAccount',0,'blacklistAccount','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>

                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_blacklistAccount','_CreateBlacklistAccountForJE','new','AccountingConfiguration','blacklistAccount')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                </div>
                            </div>

                            <br />
                            <div id="datalistingview_blacklistAccount">
                                @Html.Partial("_CreateBlacklistAccountForJE")
                            </div>
                        </div>
                    </div>
                </div>



            </div>



        </div>

        <div class="col-md-12">

            <div class="accordion mt-3" id="accordionExample">


                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingOne">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionOne"
                                aria-expanded="false"
                                aria-controls="accordionOne">
                            <i class="tf-icons mdi mdi-book-open-page-variant-outline me-1"></i>  &nbsp; &nbsp; &nbsp; &nbsp; Setting account booking direction
                        </button>
                    </h2>
                    <div id="accordionOne"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingOne"
                         data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row justify-content-end">
                                <div class="demo-inline-spacing text-end">
                                    <a type="button" onclick="LoadDataGeneration('AccountingConfiguration','myDataTable','_AccountBookingDirectionData','datalistingview_accountBookingDirection',0,'accountBookingDirection','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                    </a>

                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview_accountBookingDirection','_CreateAccountBookingDirection','new','AccountingConfiguration','accountBookingDirection')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                    </a>
                                </div>
                            </div>

                            <br />
                            <div id="datalistingview_accountBookingDirection">
                                @Html.Partial("_CreateAccountBookingDirection")
                            </div>
                        </div>
                    </div>
                </div>



            </div>



        </div>
    </div>

</div>

<!--/ Accordion -->





@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/AccountEventConfigurtion/MFIChartOfAccount.js"></script>
<script src="~/Scripts/Js/main.js/Account.js"></script>

}



