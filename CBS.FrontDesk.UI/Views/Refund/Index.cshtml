
@model CBS.FrontDesk.Data.Entity.LoanRepayment.LoanRefundDto
@{
    ViewBag.Title = "Loan Repayment";
}





<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Loan Refundement
        </h1>

        @*<div class="alert alert-info mt-3 py-2">
                <i class="mdi mdi-information-outline me-1"></i>
                Use the filters below to search and review journal entries efficiently.
            </div>*@
    </div>
</div>

<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="loanRepaymentFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <div class="card p-3 mb-3 bg-light">

            <!-- ================= TOGGLES ================= -->
            <div class="row mb-1">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold">
                            Show Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- ================= BRANCH FILTER ================= -->
            <div id="branchFilter" class="d-none mb-1">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList("BranchId",
                    new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                    "--- Select Branch ---",
                    new { @class = "form-control select2", id = "BranchId" })
            </div>

            <!-- ================= DATE FILTERS ================= -->
            <div id="dateFilters" class="d-none mb-1">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="StartDate" name="StartDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="EndDate" name="EndDate" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- ================= CORE FILTERS ================= -->
            <div class="row mb-1">

                <div class="col-md-4">
                    <label class="form-label fw-bold">Loan ID</label>
                    <input type="text" id="LoanId" name="LoanId"
                           class="form-control"
                           placeholder="Enter Loan ID" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Member Reference</label>
                    <input type="text" id="CustomerId" name="CustomerId"
                           class="form-control"
                           placeholder="Enter Customer ID" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Transaction Code</label>
                    <input type="text" id="TransactionCode" name="TransactionCode"
                           class="form-control"
                           placeholder="Enter Transaction Code" />
                </div>

            </div>

            <!-- ================= PAYMENT INFO ================= -->
            <div class="row mb-1">

                <div class="col-md-6">
                    <label class="form-label fw-bold">Payment Method</label>
                    @Html.DropDownList("PaymentMethod",
                        new SelectList(ViewBag.PaymentMethods, "Value", "Text"),
                        "Select Payment Method",
                        new { @class = "form-control select2", id = "PaymentMethod" })
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Payment Channel</label>
                    @Html.DropDownList("PaymentChannel",
                        new SelectList(ViewBag.PaymentChannels, "Value", "Text"),
                        "Select Payment Channel",
                        new { @class = "form-control select2", id = "PaymentChannel" })
                </div>

            </div>

            <!-- ================= FLAGS ================= -->
            <div class="row">

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBox("IsCompleted", false,
                            new { @class = "form-check-input", id = "IsCompleted" })
                        <label class="form-check-label fw-bold" for="IsCompleted">
                            Completed
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBox("IsReversal", false,
                            new { @class = "form-check-input", id = "IsReversal" })
                        <label class="form-check-label fw-bold" for="IsReversal">
                            Reversal
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBox("CheckPartialFlowRepayment", false,
                            new { @class = "form-check-input", id = "CheckPartialFlowRepayment" })
                        <label class="form-check-label fw-bold" for="CheckPartialFlowRepayment">
                            Partial Flow Repayment
                        </label>
                    </div>
                </div>

            </div>

        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit"
                        class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="reset"
                        class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btnExport"
                        class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> Export
                </button>
            </div>
        </div>

    </form>
</div>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <button id="btnPushRefund" class="btn btn-primary mb-2">
            <i class="mdi mdi-cash-plus me-1"></i> Push Refund
        </button>
    </div>
</div>




    <div id="datalistingview">
        @Html.Partial("_DataTable")
    </div>

    <div class="modal fade" id="partialFlowModal" tabindex="-1">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title text-primary">
                        <i class="mdi mdi-calendar-range me-2"></i>
                        Partial Flow Date Filter
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Start Date</label>
                            <input type="date" id="ModalStartDate" name="ModalStartDate" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">End Date</label>
                            <input type="date" id="ModalEndDate" name="ModalEndDate" class="form-control" />
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" class="btn btn-primary btn-sm"
                            id="applyFilterlBtn">
                        Apply Filter
                    </button>
                </div>

            </div>
        </div>
    </div>


    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")

        <script>
            $(document).ready(function () {
                const $btnPushRefund = $('#btnPushRefund');
                const $checkbox = $('#CheckPartialFlowRepayment');

                // Initially disable the button
                $btnPushRefund.prop('disabled', true);

                // Toggle enable/disable based on checkbox
                $checkbox.on('change', function () {
                    if ($(this).is(':checked')) {
                        $btnPushRefund.prop('disabled', false); // enable

                        // Show modal for partial flow if checked
                        var modal = new bootstrap.Modal(document.getElementById('partialFlowModal'));
                        modal.show();
                    } else {
                        $btnPushRefund.prop('disabled', true);  // disable

                        // Clear dates if unchecked
                        $('#ModalStartDate').val('');
                        $('#ModalEndDate').val('');
                    }
                });
                // Toggle column visibility
                $('.column-toggle').off('change').on('change', function () {
                    const columnIndex = $(this).data('column');
                    const column = refundTable.column(columnIndex);

                    column.visible(!column.visible());
                });
                $(document).on('change', '.column-toggle', function () {

                    if (!refundTable) return;

                    const columnIndex = parseInt($(this).data('column'));
                    const isChecked = $(this).is(':checked');

                    refundTable.column(columnIndex).visible(isChecked);
                });
                // Handle Apply Filter buttons (both modal and main)
                $('#partialFlowModal #applyFilterlBtn, #applyFilterBtn').on('click', function (e) {
                    e.preventDefault();

                    // Close modal if clicked inside modal
                    if ($(this).closest('#partialFlowModal').length) {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('partialFlowModal'));
                        modal.hide();
                    }

                    // Load DataTable with filters
                    loadRefundData();

                   

                });
            });



            // Handle "Push Refund" button click
            $('#btnPushRefund').off('click').on('click', function () {
                // Get selected IDs
                const selectedIds = $('#myDataTable .row-checkbox:checked')
                    .map(function () { return $(this).val(); })
                    .get();

                if (selectedIds.length === 0) {
                    appalert('⚠️ Please select at least one refund entry to push.', 2, 1); // warning
                    return;
                }

                // Confirm before pushing refunds using appalert + browser confirm
                if (confirm(`You are about to push ${selectedIds.length} refund(s). Proceed?`)) {
                    // User clicked OK → send AJAX
                    $.ajax({
                        url: '/Refund/PushRefund',  // your server endpoint
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ Ids: selectedIds }), // match server-side
                        success: function (response) {
                            if (response.success) {
                                appalert('✅ Refund pushed successfully!', 1, 1); // success
                                // Reload DataTable without resetting pagination
                                $('#myDataTable').DataTable().ajax.reload(null, false);
                            } else {
                                appalert('❌ Failed to push refund: ' + response.message, 4, 1); // error
                            }
                        },
                        error: function (xhr, status, err) {
                            console.error('❌ Push refund failed:', status, err);
                            appalert('❌ Error pushing refund. Status: ' + xhr.status, 4, 1); // error
                        }
                    });
                } else {
                    // User clicked Cancel
                    appalert('❌ Refund push canceled.', 3, 1); // info/cancel
                }
            });




            function getDataTableFilters() {
                return {
                    BranchId: $('#BranchId').val(),
                    LoanId: $('#LoanId').val(),
                    CustomerId: $('#CustomerId').val(),
                    TransactionCode: $('#TransactionCode').val(),
                    PaymentChannel: $('#PaymentChannel').val(),
                    PaymentMethod: $('#PaymentMethod').val(),
                    IsCompleted: $('#IsCompleted').is(':checked'),
                    IsReversal: $('#IsReversal').is(':checked'),
                    CheckPartialFlowRepayment: $('#CheckPartialFlowRepayment').is(':checked'),
                    StartDate: $('#CheckPartialFlowRepayment').is(':checked') ? $('#ModalStartDate').val() : $('#StartDate').val(),
                    EndDate: $('#CheckPartialFlowRepayment').is(':checked') ? $('#ModalEndDate').val() : $('#EndDate').val(),
                    DataTableOptions: {}
                };
            }





            let refundTable = null;





            function loadRefundData() {
                refundTable = $('#myDataTable').DataTable({
                    serverSide: true,
                    destroy: true,
                    responsive: true,
                    searching: false,
                    order: [[0, 'desc']],

                    pageLength: 10, // default page size

                    lengthMenu: [
                        [10, 25, 50, 100, 250, 500, 1000, 2000],
                        [10, 25, 50, 100, 250, 500, 1000, 2000]
                    ],
                    columnDefs: [
                        { targets: [2,7, 8, 9], visible: false } // VAT, Penalty, Balance hidden initially
                    ],

                    ajax: {
                        url: '/Refund/LoadRefundmentData',
                        type: 'POST',
                        contentType: 'application/json',
                        data: function (d) {
                            const filters = getDataTableFilters();
                            filters.DataTableOptions = {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                skip: d.start,
                                pageSize: d.length,
                                searchValue: d.search?.value || '',
                                sortColumnName: d.columns[d.order[0].column].data,
                                sortColumnDirection: d.order[0].dir
                            };
                            return JSON.stringify(filters);
                        },
                        error: function (xhr, status, err) {
                            console.error('❌ Load reconciliation failed:', status, err);
                            appalert('❌ Failed to load Refund data. Status: ' + xhr.status, 4, 1);
                        }
                    },

                    columns: [
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row) {
                                return `<input type="checkbox" class="row-checkbox" value="${row.Id}" />`;
                            }
                        },
                        {
                            data: null,
                            name: 'Dates',
                            render: function (_, __, row) {

                                const createdMoment = row.CreatedDate ? moment(row.CreatedDate) : null;
                                const paymentMoment = row.DateOfPayment ? moment(row.DateOfPayment) : null;

                                const createdDate = createdMoment
                                    ? createdMoment.format('DD/MM/YYYY HH:mm:ss')
                                    : '-';

                                const paymentDate = paymentMoment
                                    ? paymentMoment.format('DD/MM/YYYY')
                                    : '-';

                                let paymentClass = 'text-danger'; // default = red

                                if (createdMoment && paymentMoment) {

                                    // ✅ Compare only date part (exclude time completely)
                                    const createdOnlyDate = createdMoment.format('YYYY-MM-DD');
                                    const paymentOnlyDate = paymentMoment.format('YYYY-MM-DD');

                                    if (createdOnlyDate === paymentOnlyDate) {
                                        paymentClass = 'text-success'; // green if same date
                                    }
                                }

                                return `
            <div>
                <div>
                    <small class="text-muted fw-bold">E.Date:</small>
                    <span class="text-info fw-semibold">${createdDate}</span>
                </div>
                <div>
                    <small class="text-muted fw-bold">Acc.Date:</small>
                    <span class="${paymentClass} fw-semibold">
                        ${paymentDate}
                    </span>
                </div>
            </div>
        `;
                            }
                        },

                        { data: 'TransactionCode', name: 'TransactionCode' },
                        {
                            data: 'MemberName',
                            name: 'MemberName',
                            render: function (data, type, row) {

                                if (!data) return '-';

                                let displayName = data.length > 14
                                    ? data.substring(0, 14) + '...'
                                    : data;

                                return `
            <div title="${data}">
                ${displayName}
            </div>
            <small class="text-muted">${row.CustomerId ?? ''}</small>
        `;
                            }
                        },

                        {
                            data: 'Amount',
                            name: 'Amount',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: 'Principal',
                            name: 'Principal',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: 'Interest',
                            name: 'Interest',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: 'Tax',
                            name: 'Tax',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: 'Penalty',
                            name: 'Penalty',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: 'Balance',
                            name: 'Balance',
                            className: 'text-end',
                            render: function (data) {
                                return data ? parseInt(data).toLocaleString() : '0';
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            render: function (_, __, row) {
                                return `
                <div class="text-center">
                    <button class="btn btn-sm btn-info view-details" data-id="${row.Id}">
                        <i class="mdi mdi-eye-outline me-1"></i> View
                    </button>
                </div>
            `;
                            }
                        }
                    ],

                   

                    initComplete: function () {
                        appalert('✅ Table loaded successfully!', 1, 1);
                    },
                    drawCallback: function () {
                        const api = this.api();
                        if (api.rows({ page: 'current' }).data().length === 0) {
                            appalert('⚠️ No Refund data found.', 2, 1);
                        }

                        // Rebind row-checkbox change to update selectAll checkbox
                        $('#myDataTable .row-checkbox').off('change').on('change', function () {
                            const allChecked = $('#myDataTable .row-checkbox').length === $('#myDataTable .row-checkbox:checked').length;
                            $('#selectAll').prop('checked', allChecked);
                        });
                    }
                });

                // Handle "Select All" checkbox
                $('#selectAll').off('change').on('change', function () {
                    const isChecked = $(this).is(':checked');
                    const rows = refundTable.rows({ page: 'current' }).nodes();
                    $('input.row-checkbox', rows).prop('checked', isChecked);
                });
            }



        </script>

    }
