@model CBS.FrontDesk.Data.Entity.LoanConf.Refund

@{
    Layout = null; // remove if using shared layout
}

<!DOCTYPE html>
<html>
@*<head>
    <meta charset="utf-8" />
    <title>Refund Detail</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Keep your CSS from previous design */
    </style>
</head>*@
<body>

    <div class="detail-panel">

        <div class="card bg-light mb-3">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-document-outline me-2"></i>Loan Repayment
                </h1>
                <p class="card-text">
                    Use this page to View details .
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>

        <!-- ================= REFUND HEADER ================= -->
        <div class="refund-card">

            <table class="table table-bordered table-sm">

                <!-- ================= REFUND INFORMATION ================= -->
                <tr class="table-light">
                    <td colspan="2" class="fw-bold text-uppercase">Refund Information</td>
                </tr>

                <tr>
                    <td class="fw-bold">Refund ID</td>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <td class="fw-bold">Payment Date</td>
                    <td>@Model.DateOfPayment.ToString("dd/MM/yyyy")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Completed</td>
                    <td>
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                </tr>

                <tr>
                    <td class="fw-bold">Reversal</td>
                    <td>
                        @if (Model.IsReversal)
                        {
                            <span class="badge bg-danger">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                </tr>



                <!-- ================= CUSTOMER & LOAN INFORMATION ================= -->
                <tr class="table-light">
                    <td colspan="2" class="fw-bold text-uppercase">Customer & Loan Information</td>
                </tr>

                <tr>
                    <td class="fw-bold">Loan ID</td>
                    <td>@Model.LoanId</td>
                </tr>

                <tr>
                    <td class="fw-bold">Customer ID</td>
                    <td>@Model.CustomerId</td>
                </tr>
                <tr>
                    <td class="fw-bold">Customer Name</td>
                    <td>@Model.CustomerName</td>
                </tr>
                <tr>
                    <td class="fw-bold">Branch</td>
                    <td>@Model.BranchName</td>
                </tr>

                <tr>
                    <td class="fw-bold">Bank</td>
                    <td>@Model.BankName</td>
                </tr>


                <!-- ================= PAYMENT INFORMATION ================= -->
                <tr class="table-light">
                    <td colspan="2" class="fw-bold text-uppercase">Payment Information</td>
                </tr>

                <tr>
                    <td class="fw-bold">Payment Method</td>
                    <td>@Model.PaymentMethod</td>
                </tr>

                <tr>
                    <td class="fw-bold">Channel</td>
                    <td>@Model.PaymentChannel</td>
                </tr>

                @*<tr>
            <td class="fw-bold">Repayment Type</td>
            <td>@Model.RepaymentType</td>
        </tr>*@
                <!-- ================= LOAN DETAILS ================= -->
                <tr class="table-light">
                    <td colspan="2" class="fw-bold text-uppercase">Loan Details</td>
                </tr>

                <!-- 🔥 MOST IMPORTANT FIRST -->
                <tr>
                    <td class="fw-bold">Loan Contract Code</td>
                    <td>@Model.Loan.LoanContractCode</td>
                </tr>

                <tr>
                    <td class="fw-bold">Loan Amount</td>
                    <td>@Model.Loan.LoanAmount.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Date Contracted</td>
                    <td>@Model.Loan.LoanDate.ToString("dd/MM/yyyy")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Total Amount Paid</td>
                    <td>@Model.Loan.Paid.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Current Balance</td>
                    <td>@Model.Loan.Balance.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Amount Left (Due)</td>
                    <td>@Model.Loan.DueAmount.ToString("N2")</td>
                </tr>


                <!-- ================= FINANCIAL BREAKDOWN ================= -->
                <tr class="table-light">
                    <td colspan="2" class="fw-bold text-uppercase">Financial Breakdown</td>
                </tr>

                <tr>
                    <td class="fw-bold">Total Amount</td>
                    <td>@Model.Amount.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Principal</td>
                    <td>@Model.Principal.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Interest</td>
                    <td>@Model.Interest.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Tax</td>
                    <td>@Model.Tax.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Penalty</td>
                    <td>@Model.Penalty.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Paid</td>
                    <td>@Model.Paid.ToString("N2")</td>
                </tr>

                <tr>
                    <td class="fw-bold">Balance</td>
                    <td>@Model.Balance.ToString("N2")</td>
                </tr>

                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <tr>
                        <td class="fw-bold">Comment</td>
                        <td>@Model.Comment</td>
                    </tr>
                }

            </table>


            <!-- Loan Product -->
            @*@if (Model.LoanProduct != null)
            {
                <div style="margin-top:6px;font-size:0.75rem;">
                    <i class="fas fa-briefcase"></i>
                    Product: @Model.LoanProduct.Name
                </div>
            }*@

        </div>

        <!-- ================= REFUND DETAILS ================= -->
        <div class="refund-card">

            <div class="section-sub">
                <i class="fas fa-list-ul"></i>
                Refund Allocations · @(Model.RefundDetails?.Count ?? 0)
            </div>

            <table class="mini-table">
                <thead>
                    <tr>
                        <th>Amortization ID</th>
                        <th class="numeric">Collected</th>
                        <th class="numeric">T.Code</th>
                        <th class="numeric">Principal</th>
                        <th class="numeric">Interest</th>
                        <th class="numeric">Penalty</th>
                        <th class="numeric">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RefundDetails != null)
                    {
                        foreach (var d in Model.RefundDetails)
                        {
                            <tr>
                                <td>@d.LoanAmortizationId</td>
                                <td>@d.TransactonCode</td>
                                <td class="numeric">@d.CollectedAmount.ToString("N2")</td>
                                <td class="numeric">@d.PrincipalAmount.ToString("N2")</td>
                                <td class="numeric">@d.Interest.ToString("N2")</td>
                                <td class="numeric">@d.PenaltyAmount.ToString("N2")</td>
                                <td class="numeric">@d.Balance.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ================= AMORTIZATION PREVIEW ================= -->
        <div class="refund-card">

            <div class="section-sub">
                <i class="fas fa-table"></i>
                Amortization Schedule
            </div>

            <table class="mini-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Due Date</th>
                        <th class="numeric">Total Due</th>
                        <th class="numeric">Paid</th>
                        <th class="numeric">Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LoanAmortizations != null)
                    {
                        foreach (var a in Model.LoanAmortizations.OrderBy(x => x.Sno))
                        {
                            <tr>
                                <td>@a.Sno</td>
                                <td>@a.DateOfPayment.ToString("dd-MM-yyyy")</td>
                                <td class="numeric">@a.TotalDue.ToString("N2")</td>
                                <td class="numeric">@a.Paid.ToString("N2")</td>
                                <td class="numeric">@a.Balance.ToString("N2")</td>
                                <td>@a.Status</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

    </div>

</body>
</html>
