@model CBS.FrontDesk.Data.Entity.LoanConf.Refund

@{
    Layout = null; // remove if using shared layout
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Refund Detail</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Keep your CSS from previous design */
    </style>
</head>
<body>

    <div class="detail-panel">

        <!-- ================= REFUND HEADER ================= -->
        <div class="refund-card">

            <div class="refund-header">
                <div class="title-group">
                    <span class="refund-id">
                        <i class="fas fa-rotate-left"></i>
                        @Model.Id
                    </span>

                    <span class="badge @(Model.IsCompleted ? "badge-success" : "badge-light")">
                        @(Model.IsCompleted ? "completed" : "pending")
                    </span>

                    <span class="badge badge-light">
                        reversal: @(Model.IsReversal ? "yes" : "no")
                    </span>
                </div>

                <span class="badge-light">
                    <i class="fas fa-calendar"></i>
                    @Model.DateOfPayment.ToString("yyyy-MM-dd")
                </span>
            </div>

            <!-- ================= CORE META ================= -->
            <div class="refund-meta">

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-landmark"></i> Loan ID</span>
                    <span class="meta-value">@Model.LoanId</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-user"></i> Customer ID</span>
                    <span class="meta-value">@Model.CustomerId</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-credit-card"></i> Payment Method</span>
                    <span class="meta-value">@Model.PaymentMethod</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-globe"></i> Channel</span>
                    <span class="meta-value">@Model.PaymentChannel</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-tag"></i> Repayment Type</span>
                    <span class="meta-value">@Model.RepaymentType</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-store"></i> Branch</span>
                    <span class="meta-value">@Model.BranchId</span>
                </div>

                <div class="meta-item">
                    <span class="meta-label"><i class="fas fa-university"></i> Bank</span>
                    <span class="meta-value">@Model.BankId</span>
                </div>

            </div>

            <!-- ================= FINANCIAL STRIP ================= -->
            <div class="amount-strip">
                <span class="stat"><i class="fas fa-coins"></i> total <strong>@Model.Amount.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-layer-group"></i> principal <strong>@Model.Principal.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-percent"></i> interest <strong>@Model.Interest.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-file-invoice"></i> tax <strong>@Model.Tax.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-exclamation-triangle"></i> penalty <strong>@Model.Penalty.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-check-double"></i> paid <strong>@Model.Paid.ToString("N2")</strong></span>
                <span class="stat"><i class="fas fa-balance-scale"></i> balance <strong>@Model.Balance.ToString("N2")</strong></span>

                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <span class="comment"><i class="fas fa-pen"></i> @Model.Comment</span>
                }
            </div>

            <!-- Loan Product -->
            @*@if (Model.LoanProduct != null)
            {
                <div style="margin-top:6px;font-size:0.75rem;">
                    <i class="fas fa-briefcase"></i>
                    Product: @Model.LoanProduct.Name
                </div>
            }*@

        </div>

        <!-- ================= REFUND DETAILS ================= -->
        <div class="refund-card">

            <div class="section-sub">
                <i class="fas fa-list-ul"></i>
                Refund Allocations · @(Model.RefundDetails?.Count ?? 0)
            </div>

            <table class="mini-table">
                <thead>
                    <tr>
                        <th>Amortization ID</th>
                        <th class="numeric">Collected</th>
                        <th class="numeric">Principal</th>
                        <th class="numeric">Interest</th>
                        <th class="numeric">Penalty</th>
                        <th class="numeric">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RefundDetails != null)
                    {
                        foreach (var d in Model.RefundDetails)
                        {
                            <tr>
                                <td>@d.LoanAmortizationId</td>
                                <td class="numeric">@d.CollectedAmount.ToString("N2")</td>
                                <td class="numeric">@d.PrincipalAmount.ToString("N2")</td>
                                <td class="numeric">@d.Interest.ToString("N2")</td>
                                <td class="numeric">@d.PenaltyAmount.ToString("N2")</td>
                                <td class="numeric">@d.Balance.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ================= AMORTIZATION PREVIEW ================= -->
        <div class="refund-card">

            <div class="section-sub">
                <i class="fas fa-table"></i>
                Amortization Schedule
            </div>

            <table class="mini-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Due Date</th>
                        <th class="numeric">Total Due</th>
                        <th class="numeric">Paid</th>
                        <th class="numeric">Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LoanAmortizations != null)
                    {
                        foreach (var a in Model.LoanAmortizations.OrderBy(x => x.Sno))
                        {
                            <tr>
                                <td>@a.Sno</td>
                                <td>@a.DateOfPayment.ToString("yyyy-MM-dd")</td>
                                <td class="numeric">@a.TotalDue.ToString("N2")</td>
                                <td class="numeric">@a.Paid.ToString("N2")</td>
                                <td class="numeric">@a.Balance.ToString("N2")</td>
                                <td>@a.Status</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

    </div>

</body>
</html>
