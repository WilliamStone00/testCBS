@model CBS.FrontDesk.Data.Entity.LoanConf.Refund
@using Resources
<style>
/* Hide print-only elements by default */
.print-only {
    display: none;
}

/* ================= PRINT STYLES ================= */
@@media print {

    /* Hide everything else */
    body * {
        visibility: hidden;
    }

    /* Show only the print area */
    #print-area, #print-area * {
        visibility: visible;
    }

    tr {
        page-break-inside: avoid !important;
    }

    /* Avoid splitting table sections */
    thead, tfoot {
        display: table-header-group !important;
    }

    /* Optional: force page breaks between sections */
    .section-break {
        page-break-before: always !important;
    }

    /* Treat the modal as normal page content */
    #print-area {
        position: static !important;   /* force normal layout */
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
        overflow: visible !important;  /* ensure all content shows */
        top: auto !important;
        left: auto !important;
    }

    /* Remove Bootstrap modal restrictions */
    .modal, .modal-dialog {
        position: static !important;
        max-width: 100% !important;
        height: auto !important;
        overflow: visible !important;
    }

    /* Hide all non-print UI */
    .modal-backdrop, .no-print, .modal-footer, .btn {
        display: none !important;
    }

    /* Print-only font adjustments */
    #print-area, #print-area table, #print-area td, #print-area th, #print-area h4, #print-area p {
        font-size: 14px !important;
        font-weight: 600 !important;
    }

    /* Table formatting */
    #print-area table {
        width: 100% !important;
        border-collapse: collapse !important;
    }

    #print-area tr {
        page-break-inside: avoid !important;
    }

    /* Page size */
    @@page {
        size: A4;
        margin: 12mm;
    }
}
</style>

<!-- ================= PRINT AREA ================= -->
<div id="print-area">

    <div class="container-fluid py-3">

        <!-- Header Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center bg-light border-bottom border-primary border-3">

                <h4 class="text-primary fw-bold mb-2">
                    <i class="mdi mdi-file-document-outline me-2"></i>
                    @GlobalShared.Loan_Repayment
                </h4>

                <p class="text-muted small mb-2">
                    @GlobalRefund.view_complete_repayment_transaction_details_below
                </p>

            </div>
        </div>

        <!-- Main Card -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">

                <table class="table table-bordered table-sm mb-0 align-middle">

                    <!-- Refund Information -->
                    <tr class="table-light section-break">
                        <td colspan="2" class="fw-bold text-uppercase">@GlobalRefund.refund_information</td>
                    </tr>
                    <tr>
                        <td class="fw-bold w-25">@GlobalRefund.refund_id</td>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.payment_date</td>
                        <td>@Model.DateOfPayment.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Created_Date</td>
                        <td>@Model.CreatedDate</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Completed</td>
                        <td>
                            @if (Model.IsCompleted)
                            {
                                <span class="badge bg-success">@GlobalShared.fully_paid</span>
                            }
                            else
                            {
                        <span class="badge bg-warning text-dark">@GlobalShared.partial</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.reversal</td>
                        <td>
                            @if (Model.IsReversal)
                            {
                                <span class="badge bg-danger">@GlobalShared.Yes</span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">@GlobalShared.No</span>
                            }
                        </td>
                    </tr>

                    <!-- Member Information -->
                    <tr class="table-light section-break">
                        <td colspan="2" class="fw-bold text-uppercase">@GlobalShared.Member_Information</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Member_reference</td>
                        <td>@Model.Loan.CustomerId</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Member_name</td>
                        <td>@Model.Loan.CustomerName</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Branch</td>
                        <td>@Model.BranchName</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.bank</td>
                        <td>@Model.BankName</td>
                    </tr>

                    <!-- Loan Details -->
                    <tr class="table-light section-break">
                        <td class="fw-bold text-uppercase">@GlobalShared.Loan_Details</td>
                        <td class="text-end no-print">
                            <a href="/MembersFSeries/LoanDetails?loanId=@Model.Loan.Id"
                               target="_blank"
                               class="btn btn-sm btn-primary">
                                <i class="mdi mdi-open-in-new me-1"></i>
                                @GlobalRefund.open_full_loan
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Loan_ID</td>
                        <td>@Model.Loan.Id</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Loan_Amount</td>
                        <td>@Model.Loan.LoanAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Interest_Rate</td>
                        <td>@Model.Loan.InterestRate.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.VAT</td>
                        <td>@Model.Loan.Tax.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Accrual_Interest</td>
                        <td>@Model.Loan.AccrualInterest.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.date_contracted</td>
                        <td>@Model.Loan.LoanDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Total_Amount_Paid</td>
                        <td>@Model.Loan.Paid.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Current_balance</td>
                        <td>@Model.Loan.Balance.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.amount_left (@GlobalShared.due)</td>
                        <td>@Model.Loan.DueAmount.ToString("N2")</td>
                    </tr>

                    <!-- Payment Information -->
                    <tr class="table-light section-break">
                        <td colspan="2" class="fw-bold text-uppercase">@GlobalShared.payment_information</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.payment_method</td>
                        <td>@Model.PaymentMethod</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.channel</td>
                        <td>@Model.PaymentChannel</td>
                    </tr>

                    <!-- Cash Breakdown -->
                    <tr class="table-light section-break">
                        <td colspan="2" class="fw-bold text-uppercase">@GlobalRefund.cash_breakdown</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalRefund.amount_collected</td>
                        <td>@Model.Amount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Principal</td>
                        <td>@Model.Principal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Interest</td>
                        <td>@Model.Interest.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.VAT</td>
                        <td>@Model.Tax.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Penalty</td>
                        <td>@Model.Penalty.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Balance</td>
                        <td>@Model.Balance.ToString("N2")</td>
                    </tr>

                    @if (!string.IsNullOrWhiteSpace(Model.Comment))
                    {
                        <tr>
                            <td class="fw-bold">@GlobalShared.Comment</td>
                            <td>@Model.Comment</td>
                        </tr>
                    }

                </table>

            </div>
        </div>

        <!-- Modal footer (hidden in print) -->
        <div class="modal-footer mt-3 no-print">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            <button type="button" class="btn btn-primary" onclick="window.print();">
                <i class="fa fa-print me-2"></i> @GlobalShared.Print
            </button>
        </div>

    </div>
</div>
