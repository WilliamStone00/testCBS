@using Resources
<div class="card p-3 shadow mb-2">
    <div class="table-responsive">

        <!-- Column toggles -->
        <div class="mb-2">
            <label class="fw-bold me-2">@GlobalShared.add_columns:</label>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="2" id="toggleTCode">
                <label class="form-check-label" for="toggleTCode">@GlobalShared.transaction_code</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="7" id="toggleVat">
                <label class="form-check-label" for="toggleVat">@GlobalShared.VAT</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="8" id="togglePenalty">
                <label class="form-check-label" for="togglePenalty">@GlobalShared.Penalty</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="9" id="toggleBalance">
                <label class="form-check-label" for="toggleBalance">@GlobalShared.Balance</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="10" id="toggleAcctype">
                <label class="form-check-label" for="toggleAcctype">@GlobalShared.Account_type</label>
            </div>
        </div>

        <table id="myDataTable" class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th width="40">
                        <input type="checkbox" id="selectAll" />
                    </th>
                    <th>@GlobalShared.Entry_Date</th>
                    <th>@GlobalRefund.tcode</th>
                    <th>@GlobalShared.Member_name</th>
                    <th class="text-end">@GlobalShared.Amount</th>
                    <th class="text-end">@GlobalShared.Principal</th>
                    <th class="text-end">@GlobalShared.Interest</th>
                    <th class="text-end">@GlobalShared.VAT</th>
                    <th class="text-end">@GlobalShared.Penalty</th>
                    <th class="text-end">@GlobalShared.Balance</th>
                    <th class="text-start">@GlobalShared.Account_type</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
