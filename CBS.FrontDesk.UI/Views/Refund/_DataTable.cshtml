







<div class="card p-3 shadow mb-2">
    <div class="table-responsive">



        <div class="mb-2">
            <label class="fw-bold me-2">Add Columns:</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="2" id="toggleTCode">
                <label class="form-check-label" for="toggleTCode">Transaction code</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="7" id="toggleVat">
                <label class="form-check-label" for="toggleVat">VAT</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="8" id="togglePenalty">
                <label class="form-check-label" for="togglePenalty">Penalty</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input column-toggle" type="checkbox" data-column="9" id="toggleBalance">
                <label class="form-check-label" for="toggleBalance">Balance</label>
            </div>

        </div>

        <table id="myDataTable" class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th width="40">
                        <input type="checkbox" id="selectAll" />
                    </th>
                    <th>Entry Date</th>
                    <th>T.Code</th>
                    <th>Member Name</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Principal</th>
                    <th class="text-end">Interest</th>
                    <th class="text-end">VAT</th>
                    <th class="text-end">Penalty</th>
                    <th class="text-end">Balance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


