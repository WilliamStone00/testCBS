
@model CBS.FrontDesk.Data.Entity.LoanRepayment.LoanRefundDto

<div class="modal-body">


    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-success">
                        <i class="mdi mdi-cash-refund me-2"></i>Refund Report Export
                    </h1>
                    <p class="card-text"></p>

                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Export refund transactions with optional date filtering and format selection.
                    </div>

                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Export Format</label>
            <select class="form-select" id="refundExportFormat">
                <option value="excel">Excel (.xlsx)</option>
                <option value="pdf">PDF (.pdf)</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Report Type</label>
            <select class="form-select" id="refundReportType">
                <option value="full">Full Refund Report</option>
                <option value="dateRange">Date Range Only</option>
                <option value="branch">By Branch</option>
                <option value="status">By Refund Status</option>
            </select>
        </div>
    </div>

    <!-- Date Range -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Refund Date Range (Optional)</label>
            <div class="input-group">
                <input type="date" class="form-control" id="refundStartDate">
                <span class="input-group-text">To</span>
                <input type="date" class="form-control" id="refundEndDate">
            </div>
            <small class="text-muted">Leave empty to include all refund dates.</small>
        </div>

        <!-- File Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">File Name</label>
            <input type="text" class="form-control" id="refundFileName"
                   value="Refund_Report"
                   placeholder="Enter file name">
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close me-1"></i>Cancel
    </button>

    <button type="button" class="btn btn-success" id="btnConfirmRefundExport">
        <i class="mdi mdi-cash-refund me-1"></i>Export
    </button>
</div>

