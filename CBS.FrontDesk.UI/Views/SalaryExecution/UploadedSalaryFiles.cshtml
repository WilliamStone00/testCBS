@using Resources
@{
    ViewBag.Title = "Salary files";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-upload-multiple me-2"></i> @GlobalSalaryExecution.uploaded_salary_files
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryExecution.upload_manage_and_review_salary_files_seamlessly.
                </p>
                <hr class="border border-secondary" />
            </div>

            <!-- Tips Section -->
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.tips_best_practices</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryUploadTips" aria-expanded="false">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryUploadTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.Download:</strong> @GlobalSalaryExecution.retrieve_uploaded_files_anytime_for_reference.</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.Details:</strong> @GlobalSalaryExecution.view_file_records_and_insights.</li>
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> <strong>@GlobalShared.Delete:</strong> @GlobalSalaryExecution.remove_outdated_or_incorrect_files_with_caution.</li>
                            <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.verify_regularly:</strong> @GlobalSalaryExecution.ensure_uploaded_files_match_payroll_records.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- File Uploads & Listing -->
            <div class="accordion mt-3">
                <div class="accordion-item">
                    <h2 class="accordion-header d-flex justify-content-between">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#fileListSection" aria-expanded="true">
                            <i class="mdi mdi-file-upload me-1"></i> @GlobalShared.uploaded_files
                        </button>
                    </h2>
                    <div id="fileListSection" class="accordion-collapse collapse show">
                        <div class="accordion-body">
                            <div class="d-flex justify-content-end mb-3">
                                <a onclick="LoadDataGen('SalaryExecution', 'myDataTable', '_FileUploadData', 0, 'datalistingview',null,null,'cs_salary')" class="btn btn-label-primary btn-sm me-2">
                                    <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.view_files
                                </a>
                                <a href="/SalaryExecution" class="btn btn-label-secondary btn-sm">
                                    <i class="mdi mdi-plus mdi-18px"></i> @GlobalSalaryExecution.upload_new_analyzed_file
                                </a>
                            </div>
                            <div id="datalistingview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            LoadDataGen('SalaryExecution', 'myDataTable', '_FileUploadData', 0, 'datalistingview',null,null,'cs_salary');
        });
    </script>
}
