


@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier
@using Resources


<style>
    .status-pip {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        vertical-align: middle
    }

        .status-pip.online {
            background: #28a745;
            box-shadow: 0 0 0 2px rgba(40,167,69,.15)
        }

        .status-pip.offline {
            background: #6c757d;
            box-shadow: 0 0 0 2px rgba(108,117,125,.15)
        }

    .truncate {
        max-width: 320px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .truncate-branch {
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .truncate-user {
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    #myDataTable thead th {
        white-space: nowrap
    }

    /* Optional: squeeze a bit more on smaller screens */
    @@media (max-width: 1400px) {
        .truncate-branch {
            max-width: 100px
        }

        .truncate-user {
            max-width: 100px
        }
    }
</style>

<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <div id="datalistingview_inner">
            <div class="table-responsive mb-3">
                @if (Model.FileUploads != null && Model.FileUploads.Any())
                {
                    <table class="table table-hover align-middle" id="myDataTable">
                        <thead class="table-light">
                            <tr>
                                <th>@GlobalSalaryUpload.FileName</th>
                                <th>File Type</th>
                                <th>Branch</th>
                                <th>Visibility</th>
                                <th>@GlobalSalaryUpload.UploadedBy</th>
                                <th>@GlobalSalaryUpload.UploadedOn</th>
                                <th style="width:1%;">@GlobalShared.Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in Model.FileUploads)
                            {
                                <tr>
                                    <!-- File name (truncated) -->
                                    <td class="truncate" title="@file.FileName">@file.FileName</td>

                                    <!-- File type -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(file.FileType))
                                        {<span class="badge bg-secondary">@file.FileType</span> }
                                    else
                                    { <span class="badge bg-light text-muted">Unknown</span>}
                                    </td>

                                    <!-- Branch -->
                                    <td class="truncate-branch" title="@file.BranchName">
                                        @if (!string.IsNullOrWhiteSpace(file.BranchName))
                                        {<span class="badge bg-label-primary">@file.BranchName</span> }
                                    else
                                    { <span class="badge bg-light text-muted">N/A</span>}
                                    </td>

                                    <!-- Visibility -->
                                    <td>
                                        @if (file.PrivateView)
                                        {
                                            <span class="status-pip offline" title="Private (visible to this branch only)"></span>
                                            <span class="ms-1">Private</span>
                                        }
                                        else
                                        {
                                            <span class="status-pip online" title="Public (visible to other branches)"></span>
                                            <span class="ms-1">Public</span>
                                        }
                                    </td>

                                    <td class="truncate-user" title="@file.UploadedBy">@file.UploadedBy</td>
                                    <td>@file.UploadedOn.ToString("dd/MM/yyyy HH:mm")</td>

                                    @*<td>
            @if (!string.IsNullOrEmpty(file.SalaryProcessingStatus))
            {<span class="badge bg-info">@file.SalaryProcessingStatus</span> }
        else
        { <span class="badge bg-secondary">N/A</span>}
        </td>*@

                                    <!-- Actions: condensed dropdown -->
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <!-- Download Button -->
                                            <a type="button"
                                               class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                               href="/SalaryUpload/DownloadFile?fileId=@file.Id"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="@GlobalShared.Download @file.FileName">
                                                <i class="fas fa-download me-1"></i> @GlobalShared.Download
                                            </a>
                                            <!-- Details Button -->
                                            <a type="button"
                                               class="btn btn-sm btn-outline-info d-flex align-items-center"
                                               href="/SalaryExecution/Detail?fileUploadid=@file.Id"
                                               data-bs-toggle="tooltip" target="_blank"
                                               data-bs-placement="top"
                                               title="@GlobalShared.ViewDetails">
                                                <i class="fas fa-info-circle me-1"></i> @GlobalShared.Details
                                            </a>
                                            <!-- Delete Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                                    onclick="DeleteFileRecord('SalaryUpload','@file.Id','myDataTable','_FileUploadData',0,'datalistingview')"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="@GlobalShared.Delete @file.FileName">
                                                <i class="fas fa-trash-alt me-1"></i> @GlobalShared.Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center my-3">
                        <p>@GlobalShared.NoFilesUploadedYet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
