@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier
    @using Resources
@{
    ViewBag.Title = "Salary Summary";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-cabinet me-2"></i> @GlobalSalaryExecution.salary_summary
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryExecution.view_analyze_and_manage_employee_salary.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card mb-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalShared.Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalarySummaryTips" aria-expanded="false" aria-controls="collapseSalarySummaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalarySummaryTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-file-document-outline text-primary me-2"></i> @GlobalShared.use_the <strong>"RunSalaryAnalysis"</strong> @GlobalSalaryExecution.button_to_analyze_uploaded_salary_data.</li>
                            <li><i class="mdi mdi-eye-outline text-primary me-2"></i> @GlobalShared.click_the <strong>"@GlobalSalaryExecution.view_result_of_analyzed_salary"</strong> @GlobalSalaryExecution.button_to_check_previously_analyzed_results.</li>
                            <li><i class="mdi mdi-alert-outline text-warning me-2"></i> @GlobalSalaryExecution.ensure_all_uploaded_salary_files_are_accurate (e.g., Excel, CSV).</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryExecution.regularly_verify_analyzed_results.</li>
                            <li><i class="mdi mdi-database-search-outline text-primary me-2"></i> @GlobalSalaryExecution.use_search_filters_to_quickly_locate_specific_employee_salary_records.</li>
                            <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i> @GlobalSalaryExecution.address_anomalies_like_overpayments.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalSalaryExecution.edit_analyzed_salary_records_for_corrections.</li>
                            <li><i class="mdi mdi-delete-outline text-danger me-2"></i> @GlobalSalaryExecution.delete_invalid_uploads_to_maintain_clean.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-chart-bar me-1"></i> @GlobalShared.salary_analysis
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <!-- Buttons to execute, download and go to salary execution page -->
                                            <a type="button" href="/SalaryUpload/UploadedSalaryFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>

                                            <!-- Execute Salary Button -->
                                            <button type="button" class="btn btn-label-success btn-sm me-2" data-bs-toggle="modal" data-bs-target="#executeSalaryModal" title="@GlobalShared.execute_salary">
                                                <i class="mdi mdi-check-circle mdi-18px"></i> @GlobalShared.execute_salary
                                            </button>

                                            <!-- Download Salary Details Button -->
                                            @*<a type="button" href="/SalaryExecution/DownloadSalaryDetails" class="btn btn-label-info btn-sm me-2" data-bs-toggle="tooltip" title="Download Salary Details">
                                                <i class="mdi mdi-download mdi-18px"></i> Download Details
                                            </a>*@

                                            <!-- Go to Salary Execution Page Button -->
                                            @*<a type="button" href="/SalaryExecution/ExecutionDetails" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="Go to Salary Execution Page">
                                                <i class="mdi mdi-file-search mdi-18px"></i> Execution Details
                                            </a>*@
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryDetailsData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Execute Salary Modal -->
<!-- Execute Salary Modal -->
<div class="modal fade" id="executeSalaryModal" tabindex="-1" aria-labelledby="executeSalaryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="row">
                    <div class="col-12">
                        <!-- Page Header -->
                        <div class="card bg-light mb-2">
                            <div class="card-body text-center">
                                <h1 class="card-title text-primary">
                                    <i class="mdi mdi-account-group-outline me-2"></i> @GlobalSalaryExecution.salary_execution [@Session["BranchName"].ToString()]
                                </h1>
                                <p class="card-text">
                                    @GlobalSalaryExecution.you_are_about_to_execute_salary_payments.
                                </p>
                                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Tips Section -->
                <div class="card mb-2">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.important_tips</span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseTips" class="collapse">
                        <div class="card-body">
                            <ul class="mb-0">
                                <li><i class="mdi mdi-account-cash text-primary me-2"></i><strong>@GlobalSalaryExecution.salary_processing:</strong> @GlobalSalaryExecution.debits_the_total_salary_amount_from_the_selected_source_account.</li>
                                <li><i class="mdi mdi-account-multiple text-primary me-2"></i><strong>@GlobalSalaryExecution.standing_orders:</strong> @GlobalSalaryExecution.processes_automatic_transfers_for_members_with_linked_standing_orders.</li>
                                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>@GlobalShared.Warning:</strong> @GlobalShared.This_action_cannot_be_undone.</li>
                                <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i><strong>@GlobalShared.risks:</strong> @GlobalSalaryExecution.ensure_sufficient_funds_are_available.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Form for Salary Execution -->
                <form id="executeSalaryForm">
                    <!-- File Upload Details -->
                    <div class="mb-3">
                        <label for="fileUploadId" class="form-label">@GlobalSalaryExecution.file_upload_reference</label>
                        <input type="text" id="fileUploadId" class="form-control" value="@Model.FileUpload.Id" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="fileUploadFileName" class="form-label">@GlobalShared.File_Name</label>
                        <input type="text" id="fileUploadFileName" class="form-control" value="@Model.FileUpload.FileName" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="fileUploadCategory" class="form-label">@GlobalShared.file_category</label>
                        <input type="text" id="fileUploadCategory" class="form-control" value="@Model.FileUpload.FileCategory" readonly />
                    </div>

                    <!-- Execution Reason -->
                    @*<div class="mb-3">
                        <label for="executeReason" class="form-label">@GlobalShared.execution_reason</label>
                        <textarea class="form-control" id="executeReason" rows="3" required></textarea>
                    </div>*@
                    <textarea id="executeReason" class="form-control" rows="3" required minlength="10"
                              placeholder="Briefly explain why you’re executing this salary run..."></textarea>
                    <div class="invalid-feedback" id="executeReasonFeedback">
                        Execution reason is required (min 10 characters).
                    </div>

                    <!-- Action Button -->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" id="executeSalaryBtn">@GlobalShared.Execute</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>

       
        $(document).ready(function () {


            
            LoadDT("myDataTable", 0);


            $("#executeSalaryBtn").off("click").on("click", function () {
                const $btn = $(this);
                const $modal = $("#executeSalaryModal");
                const fileUploadId = $("#fileUploadId").val();
                const executeReason = ($("#executeReason").val() || "").trim();
                const fileName = $("#fileUploadFileName").val();
                const fileCategory = $("#fileUploadCategory").val();

                if (executeReason.length < 10) {
                    $("#executeReason").addClass("is-invalid").focus();
                    $("#executeReasonFeedback").text("Execution reason is required (min 10 characters).");
                    return;
                }

                $modal.modal('hide'); // avoid Bootstrap focus trap

                const confirmHtml = `
                <div style="text-align:left;">
                  <div style="border-left:4px solid #d9534f; background:#fff3f3; padding:10px 12px; margin-bottom:10px;">
                    <strong style="color:#b52b27;">This action is IRREVERSIBLE.</strong><br/>
                    Executing salary will post payments and process standing orders. It <u>cannot</u> be rolled back automatically.
                  </div>
                  <p><strong>File Name:</strong> ${fileName}</p>
                  <p><strong>File Category:</strong> ${fileCategory}</p>
                  <p><strong>File Upload Reference:</strong> ${fileUploadId}</p>
                  <p><strong>Execution Reason:</strong> ${executeReason}</p>
                  <hr/>
                  <div id="ackIrrevocableWrapper" class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="ackIrrevocable">
                    <label class="form-check-label" for="ackIrrevocable">I understand this operation is irreversible.</label>
                    <div id="ackIrrevocableError" class="text-danger small d-none">Please acknowledge that this action is irreversible.</div>
                  </div>
                  <div id="ackFileWrapper" class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="ackFile">
                    <label class="form-check-label" for="ackFile">
                      I confirm this is the analysis file I just uploaded (<strong>${fileName}</strong>).
                    </label>
                    <div id="ackFileError" class="text-danger small d-none">Please confirm the uploaded file.</div>
                  </div>
                  <div class="mb-1">
                    <label for="confirmPhrase" class="form-label">Type <strong>EXECUTE</strong> to confirm:</label>
                    <input id="confirmPhrase" class="form-control form-control-sm" autocomplete="off" placeholder="EXECUTE" />
                    <small class="text-muted">All confirmations are required to proceed.</small>
                  </div>
                </div>`;

                const dlg = alertify
                    .confirm("Final Confirmation – Salary/Standing Order Execution", confirmHtml, null, null)
                    .set({ labels: { ok: 'Execute', cancel: 'Back' }, transition: 'zoom', closable: false });

                // OK handler (correct API)
                dlg.set('onok', function (ev) {
                    const ack1 = $('#ackIrrevocable').is(':checked');
                    const ack2 = $('#ackFile').is(':checked');
                    const phrase = ($('#confirmPhrase').val() || '').trim().toUpperCase();

                    // Keep dialog open until valid
                    if (!(ack1 && ack2 && phrase === 'EXECUTE')) {
                        ev.cancel = true;

                        $('#ackIrrevocableError').toggleClass('d-none', ack1);
                        $('#ackFileError').toggleClass('d-none', ack2);
                        $('#ackIrrevocableWrapper').toggleClass('border border-danger rounded-2 p-2', !ack1);
                        $('#ackFileWrapper').toggleClass('border border-danger rounded-2 p-2', !ack2);

                        if (!ack1) { $('#ackIrrevocable').trigger('focus'); return; }
                        if (!ack2) { $('#ackFile').trigger('focus'); return; }
                        $('#confirmPhrase').trigger('focus').select();
                        return;
                    }

                    // Keep dialog open while processing
                    ev.cancel = true;

                    // ---- SAFE button handling (works across Alertify builds) ----
                    const $root = $('.ajs-modal:visible').last();              // the top-most dialog
                    const $ok = $root.find('.ajs-footer .ajs-buttons .ajs-ok');
                    const $cancel = $root.find('.ajs-footer .ajs-buttons .ajs-cancel');

                    // prevent double submits
                    if ($root.data('processing')) return;
                    $root.data('processing', true);

                    const okHtml = $ok.html();
                    if ($ok.length) $ok.prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span> Processing...');
                    if ($cancel.length) $cancel.prop('disabled', true);

                    const payload = {
                        FileUploadId: $('#fileUploadId').val(),
                        ExecutionReason: ($('#executeReason').val() || '').trim(),
                        AckIrreversible: true,
                        AckFileConfirmed: true,
                        ConfirmPhrase: phrase
                    };

                    // Anti-forgery header if you use [ValidateAntiForgeryToken]
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const headers = token ? { 'RequestVerificationToken': token } : {};

                    $.ajax({
                        type: "POST",
                        url: "/SalaryExecution/ExecuteAnalysis",
                        contentType: "application/json; charset=utf-8",
                        data: JSON.stringify(payload),
                        dataType: "json",
                        headers: headers,
                        success: function (response) {
                            if (response && response.success) {
                                alertify.closeAll(); // close the confirm
                                appalert(response.message || "Salary execution queued.", 1, 1);
                                location.reload();
                            } else {
                                appalert("Failed to execute salary. " + ((response && response.message) || ""), 2, 1);
                                // re-enable buttons and keep dialog open, focus the phrase so user can retry
                                if ($ok.length) $ok.prop('disabled', false).html(okHtml);
                                if ($cancel.length) $cancel.prop('disabled', false);
                                $root.removeData('processing');
                                $('#confirmPhrase').trigger('focus').select();
                            }
                        },
                        error: function (xhr, status, error) {
                            appalert("Error: " + (error || "Request failed"), 2, 1);
                            if ($ok.length) $ok.prop('disabled', false).html(okHtml);
                            if ($cancel.length) $cancel.prop('disabled', false);
                            $root.removeData('processing');
                            $('#confirmPhrase').trigger('focus').select();
                        }
                    });
                });

                // Live validation + focus setup
                dlg.set('onshow', function () {
                    function liveGate() {
                        const ack1 = $('#ackIrrevocable').is(':checked');
                        const ack2 = $('#ackFile').is(':checked');
                        $('#ackIrrevocableError').toggleClass('d-none', ack1);
                        $('#ackFileError').toggleClass('d-none', ack2);
                        $('#ackIrrevocableWrapper').toggleClass('border border-danger rounded-2 p-2', !ack1);
                        $('#ackFileWrapper').toggleClass('border border-danger rounded-2 p-2', !ack2);
                    }
                    $(dlg.elements.content).on('change input', '#ackIrrevocable, #ackFile, #confirmPhrase', liveGate);
                    setTimeout(() => $('#confirmPhrase').prop('disabled', false).trigger('focus').select(), 0);
                    liveGate();
                });

                dlg.set('oncancel', function () {
                    setTimeout(() => $modal.modal('show'), 150);
                });
            });


            $(document).ready(function () {

                var table = $("#myDataTable").DataTable();

                // Hide columns by default (order preserved)
                var hiddenColumns = [5, 6, 7, 8, 10, 11, 12];

                hiddenColumns.forEach(function (colIndex) {
                    table.column(colIndex).visible(false);
                });

                // Toggle columns
                $(".toggle-col").on("change", function () {

                    var column = table.column($(this).data("col"));

                    column.visible(!column.visible());
                });

            });

            hiddenColumns.forEach(function (colIndex) {
                table.column(colIndex).visible(false);
                $('.toggle-col[data-col="' + colIndex + '"]').prop("checked", false);
            });
           


        });
        // Enable/disable the Execute button based on reason validity

    </script>
}
