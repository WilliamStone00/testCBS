@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier
    @using Resources
@{
    ViewBag.Title = "Salary Summary";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-cabinet me-2"></i> @GlobalSalaryExecution.SALARY_SUMMARY
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryExecution.ViewAnalyzeAndManageEmployeeSalary.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card mb-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalSalaryExecution.TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalarySummaryTips" aria-expanded="false" aria-controls="collapseSalarySummaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalarySummaryTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-file-document-outline text-primary me-2"></i> @GlobalSalaryExecution.UseThe <strong>"RunSalaryAnalysis"</strong> @GlobalSalaryExecution.buttonToAnalyzeUploadedSalaryData.</li>
                            <li><i class="mdi mdi-eye-outline text-primary me-2"></i> @GlobalSalaryExecution.ClickThe <strong>"@GlobalSalaryExecution.ViewResultOfAnalyzedSalary"</strong> @GlobalSalaryExecution.buttonToCheckPreviouslyAnalyzedResults.</li>
                            <li><i class="mdi mdi-alert-outline text-warning me-2"></i> @GlobalSalaryExecution.EnsureAllUploadedSalaryFilesAreAccurate (e.g., Excel, CSV).</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryExecution.RegularlyVerifyAnalyzedResults.</li>
                            <li><i class="mdi mdi-database-search-outline text-primary me-2"></i> @GlobalSalaryExecution.UseSearchFiltersToQuicklyLocateSpecificEmployeeSalaryRecords.</li>
                            <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i> @GlobalSalaryExecution.AddressAnomaliesLikeOverpayments.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalSalaryExecution.EditAnalyzedSalaryRecordsForCorrections.</li>
                            <li><i class="mdi mdi-delete-outline text-danger me-2"></i> @GlobalSalaryExecution.DeleteInvalidUploadsToMaintainClean.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-chart-bar me-1"></i> @GlobalSalaryExecution.SalaryAnalysis
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <!-- Buttons to execute, download and go to salary execution page -->
                                            <a type="button" href="/SalaryUpload/UploadedSalaryFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>

                                            <!-- Execute Salary Button -->
                                            <button type="button" class="btn btn-label-success btn-sm me-2" data-bs-toggle="modal" data-bs-target="#executeSalaryModal" title="@GlobalSalaryExecution.ExecuteSalary">
                                                <i class="mdi mdi-check-circle mdi-18px"></i> @GlobalSalaryExecution.ExecuteSalary
                                            </button>

                                            <!-- Download Salary Details Button -->
                                            @*<a type="button" href="/SalaryExecution/DownloadSalaryDetails" class="btn btn-label-info btn-sm me-2" data-bs-toggle="tooltip" title="Download Salary Details">
                                                <i class="mdi mdi-download mdi-18px"></i> Download Details
                                            </a>*@

                                            <!-- Go to Salary Execution Page Button -->
                                            @*<a type="button" href="/SalaryExecution/ExecutionDetails" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="Go to Salary Execution Page">
                                                <i class="mdi mdi-file-search mdi-18px"></i> Execution Details
                                            </a>*@
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryDetailsData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Execute Salary Modal -->
<!-- Execute Salary Modal -->
<div class="modal fade" id="executeSalaryModal" tabindex="-1" aria-labelledby="executeSalaryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="row">
                    <div class="col-12">
                        <!-- Page Header -->
                        <div class="card bg-light mb-2">
                            <div class="card-body text-center">
                                <h1 class="card-title text-primary">
                                    <i class="mdi mdi-account-group-outline me-2"></i> @GlobalSalaryExecution.SALARY_EXECUTION [@Session["BranchName"].ToString()]
                                </h1>
                                <p class="card-text">
                                    @GlobalSalaryExecution.YouAreAboutToExecuteSalaryPayments.
                                </p>
                                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Tips Section -->
                <div class="card mb-2">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalSalaryExecution.IMPORTANT_TIPS</span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseTips" class="collapse">
                        <div class="card-body">
                            <ul class="mb-0">
                                <li><i class="mdi mdi-account-cash text-primary me-2"></i><strong>@GlobalSalaryExecution.SalaryProcessing:</strong> @GlobalSalaryExecution.DebitsTheTotalSalaryAmountFromTheSelectedSourceAccount.</li>
                                <li><i class="mdi mdi-account-multiple text-primary me-2"></i><strong>@GlobalSalaryExecution.StandingOrders:</strong> @GlobalSalaryExecution.ProcessesAutomaticTransfersForMembersWithLinkedStandingOrders.</li>
                                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>@GlobalSalaryExecution.Warning:</strong> @GlobalSalaryExecution.ThisActionCannotBeUndone.</li>
                                <li><i class="mdi mdi-cash text-success me-2"></i><strong>@GlobalSalaryExecution.AccountImpact:</strong> @GlobalSalaryExecution.TheSelectedSourceAccountWillBeDebited.</li>
                                <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i><strong>@GlobalSalaryExecution.Risks:</strong> @GlobalSalaryExecution.EnsureSufficientFundsAreAvailable.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Form for Salary Execution -->
                <form id="executeSalaryForm">
                    <!-- Source Account Dropdown -->
                    <div class="mb-3">
                        <label for="memberReferenceNumber" class="form-label">@GlobalSalaryExecution.SelectSourceAccount</label>
                        <select class="form-select" id="memberReferenceNumber" name="MemberReferenceNumber" required>
                            <option value="">-- @GlobalSalaryExecution.SelectAnAccount --</option>
                       
                            @foreach (var account in Model.StringValues)
                            {
                                <option value="@account.Value">@account.Text</option>
                            }
                        </select>
                    </div>

                    <!-- File Upload Details -->
                    <div class="mb-3">
                        <label for="fileUploadId" class="form-label">@GlobalSalaryExecution.FileUploadReference</label>
                        <input type="text" id="fileUploadId" class="form-control" value="@Model.FileUpload.Id" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="fileUploadFileName" class="form-label">@GlobalSalaryExecution.FileName</label>
                        <input type="text" id="fileUploadFileName" class="form-control" value="@Model.FileUpload.FileName" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="fileUploadCategory" class="form-label">@GlobalSalaryExecution.FileCategory</label>
                        <input type="text" id="fileUploadCategory" class="form-control" value="@Model.FileUpload.FileCategory" readonly />
                    </div>

                    <!-- Execution Reason -->
                    <div class="mb-3">
                        <label for="executeReason" class="form-label">@GlobalSalaryExecution.ExecutionReason</label>
                        <textarea class="form-control" id="executeReason" rows="3" required></textarea>
                    </div>

                    <!-- Action Button -->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" id="executeSalaryBtn">@GlobalShared.Execute</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            LoadDT("myDataTable", 0);

            $("#executeSalaryBtn").on("click", function () {
                var $btn = $(this); // Reference to the button
                var memberReferenceNumber = $("#memberReferenceNumber").val();
                var fileUploadId = $("#fileUploadId").val();
                var executeReason = $("#executeReason").val();
                var fileName = $("#fileUploadFileName").val();
                var fileCategory = $("#fileUploadCategory").val();

                if (!memberReferenceNumber || !executeReason) {
                    appalert("Please select an account for execution and provide a reason.", 2, 1);
                    return;
                }

                var confirmMessage = `
            <div style="text-align: left;">
                <p><strong>File Name:</strong> ${fileName}</p>
                <p><strong>File Category:</strong> ${fileCategory}</p>
                <p><strong>Account:</strong> ${memberReferenceNumber}</p>
                <p><strong>Execution Reason:</strong> ${executeReason}</p>
                <p><strong>Are you sure you want to execute this operation?</strong></p>
            </div>`;

                alertify.confirm("Confirm Salary Execution", confirmMessage,
                    function () {
                        // Block the button and show loading
                        $btn.prop("disabled", true);
                        var originalText = $btn.html();
                        $btn.html(`<span class="spinner-border spinner-border-sm me-2"></span> Processing...`);

                        var data = {
                            MemberReferenceNumber: memberReferenceNumber,
                            FileUploadId: fileUploadId
                        };

                        $.ajax({
                            type: "POST",
                            url: "/SalaryExecution/ExecuteAnalysis",
                            contentType: "application/json; charset=utf-8",
                            data: JSON.stringify(data),
                            dataType: "json",
                            success: function (response) {
                                if (response.success) {
                                    appalert(response.message, 1, 1);
                                    $('#executeSalaryModal').modal('hide');
                                    location.reload();
                                } else {
                                    appalert("Failed to execute salary. " + response.message, 2, 1);
                                    $btn.prop("disabled", false).html(originalText); // Reset
                                }
                            },
                            error: function (xhr, status, error) {
                                appalert("Error: " + error, 2, 1);
                                $btn.prop("disabled", false).html(originalText); // Reset
                            }
                        });
                    },
                    function () {
                        appalert("Salary execution canceled.", 3, 1);
                    }
                ).set({ labels: { ok: 'Execute', cancel: 'Cancel' }, transition: 'zoom' });
            });
        });
    </script>
}
