@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier
@using Resources



<style>
    /* Dashboard Title */
    .dashboard-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.8rem;
        text-align: center;
        padding-top: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Section Header with Left Alignment */
    .section-header {
        margin-bottom: 0.8rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #444;
        text-align: left;
        text-transform: uppercase;
        padding-left: 1rem;
    }

    /* Card Border Styles - Matching your sample image */
    .card {
        border-radius: 10px !important;
        transition: all 0.2s ease;
    }

    /* Card Border Variations */
    .card-border-shadow-primary {
        border-left: 4px solid #696cff !important;
        box-shadow: 0 2px 6px 0 rgba(105, 108, 255, 0.2);
    }

    .card-border-shadow-secondary {
        border-left: 4px solid #8592a3 !important;
        box-shadow: 0 2px 6px 0 rgba(133, 146, 163, 0.2);
    }

    .card-border-shadow-success {
        border-left: 4px solid #71dd37 !important;
        box-shadow: 0 2px 6px 0 rgba(113, 221, 55, 0.2);
    }

    .card-border-shadow-danger {
        border-left: 4px solid #ff3e1d !important;
        box-shadow: 0 2px 6px 0 rgba(255, 62, 29, 0.2);
    }

    .card-border-shadow-warning {
        border-left: 4px solid #ffb400 !important;
        box-shadow: 0 2px 6px 0 rgba(255, 180, 0, 0.2);
    }

    .card-border-shadow-info {
        border-left: 4px solid #16b1ff !important;
        box-shadow: 0 2px 6px 0 rgba(22, 177, 255, 0.2);
    }

    .card-border-shadow-dark {
        border-left: 4px solid #233446 !important;
        box-shadow: 0 2px 6px 0 rgba(35, 52, 70, 0.2);
    }

        /* Hover effect */
        .card-border-shadow-primary:hover,
        .card-border-shadow-secondary:hover,
        .card-border-shadow-success:hover,
        .card-border-shadow-danger:hover,
        .card-border-shadow-warning:hover,
        .card-border-shadow-info:hover,
        .card-border-shadow-dark:hover {
            box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.15);
            transform: translateY(-2px);
        }

    /* Card body text styling */
    .card-title {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .card-texts {
        font-size: 1.5rem !important;
        font-weight: 700 !important;
        margin-bottom: 0;
    }

    /* Optional: Avatar style if you want to add icons */
    .avatar {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .avatar-initial {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .bg-label-secondary {
        background-color: rgba(133, 146, 163, 0.1);
        color: #8592a3;
    }

    .bg-label-success {
        background-color: rgba(113, 221, 55, 0.1);
        color: #71dd37;
    }

    .bg-label-primary {
        background-color: rgba(105, 108, 255, 0.1);
        color: #696cff;
    }

    /* Remove default borders */
    .border-0 {
        border: none !important;
    }




    /* Purple theme - Add to your existing CSS */
    .card-border-shadow-purple {
        border-left: 4px solid #6f42c1 !important; /* Bootstrap purple */
        box-shadow: 0 2px 6px 0 rgba(111, 66, 193, 0.2);
    }

        .card-border-shadow-purple:hover {
            box-shadow: 0 4px 12px 0 rgba(111, 66, 193, 0.3);
            transform: translateY(-2px);
        }

    .bg-label-purple {
        background-color: rgba(111, 66, 193, 0.1);
        color: #6f42c1;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    /* Alternative darker purple */
    .card-border-shadow-deep-purple {
        border-left: 4px solid #5e35b1 !important;
        box-shadow: 0 2px 6px 0 rgba(94, 53, 177, 0.2);
    }

    .bg-label-deep-purple {
        background-color: rgba(94, 53, 177, 0.1);
        color: #5e35b1;
    }
</style>

<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <!-- Dashboard Section -->
        <div id="dashboardSummary" class="mb-4">
            <div class="section-header">@*@GlobalSalaryExecution.*@Salary Execution Summary</div>
            <div class="row row-cols-1 row-cols-md-4 g-4">
                <!-- Changed from row-cols-md-3 to row-cols-md-4 -->
                <!-- Total Members -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-primary">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-primary">
                                        <i class="mdi mdi-account-group mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-primary mb-0">@GlobalSalaryExecution.TotalMembers</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalMembers.ToString("N0")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Gross Salary -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-primary">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-primary">
                                        <i class="mdi mdi-cash mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-primary mb-0">Gross Salary</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalSalary.ToString("N0")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Charges -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-warning">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-warning">
                                        <i class="mdi mdi-receipt mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-warning mb-0">@GlobalSalaryExecution.TotalCharges</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalCharges.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Net Salary -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-success">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-success">
                                        <i class="mdi mdi-cash-multiple mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-success mb-0">@GlobalSalaryExecution.TotalNetSalary</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalNetSalary.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Savings -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-info">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-info">
                                        <i class="mdi mdi-piggy-bank mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-info mb-0">@GlobalSalaryExecution.TotalSavings</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalSavings.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Deposit -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-warning">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-warning">
                                        <i class="mdi mdi-bank mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-warning mb-0">Total Deposit</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalDeposits.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Shares -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-info">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-info">
                                        <i class="mdi mdi-chart-line mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-info mb-0">@GlobalSalaryExecution.TotalShares</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Preference Shares -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-success">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-success">
                                        <i class="mdi mdi-star mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-success mb-0">@GlobalSalaryExecution.TotalPreferenceShares</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalPreferenceShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 card-border-shadow-purple" style="border-left: 4px solid #836af9 !important; box-shadow: 0 2px 6px 0 rgba(131, 106, 249, 0.2);">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded" style="background-color: rgba(131, 106, 249, 0.1); color: #836af9;">
                                        <i class="mdi mdi-chart-pie mdi-18px"></i> <!-- Changed icon for Capital -->
                                    </span>
                                </div>
                                <h5 class="card-title mb-0" style="color: #836af9;">Total Capital</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalCapital.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Interest - Light Purple -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-purple" style="border-left: 4px solid #836af9 !important; box-shadow: 0 2px 6px 0 rgba(131, 106, 249, 0.2);">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded" style="background-color: rgba(131, 106, 249, 0.1); color: #836af9;">
                                        <i class="mdi mdi-percent mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title mb-0" style="color: #836af9;">@GlobalSalaryExecution.TotalLoanInterest</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalLoanInterest.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>


                <!-- Total VAT -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-warning">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-warning">
                                        <i class="mdi mdi-percent mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-warning mb-0">Total VAT</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalVAT.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Repayment -->
                <div class="col">
                    <div class="card border-0 card-border-shadow-success">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-success">
                                        <i class="mdi mdi-bank mdi-18px"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-success mb-0">@GlobalSalaryExecution.TotalLoanRepayment</h5>
                            </div>
                            <p class="card-texts fw-bold text-dark ms-4 ps-1">
                                @Model.DashboardViewModel.TotalLoanRepayment.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>        
        <div class="table-responsive mb-3">

            <div class="mb-3">
                <label class="fw-bold">Show / Hide Columns</label><br />

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="5"> Savings
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="6"> Deposit
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="7"> Net Salary
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="8"> Shares
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="10"> Total Capital
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="11"> Total Interest
                </label>

                <label class="me-3">
                    <input type="checkbox" class="toggle-col" data-col="12"> VAT
                </label>
            </div>
            @if (Model.SalaryPaymentExtractes != null && Model.SalaryPaymentExtractes.Any())
            {
                <table class="table table-hover" id="myDataTable">




                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>@GlobalSalaryExecution.Matricule (Account Number)</th>
                            <th>@GlobalSalaryExecution.Name</th>
                            <th>G.Salary</th> <!-- Changed to Gross Amount -->
                            <th>S.Order</th> <!-- Standing Order Amount -->
                            <th>@GlobalSalaryExecution.Savings</th>
                            <th>@GlobalSalaryExecution.Deposit</th>
                            <th>@GlobalSalaryExecution.NSalary</th> <!-- Net Salary -->
                            <th>@GlobalSalaryExecution.Shares</th>
                            <th>T.Refunded</th> <!-- Total Loan Repayment -->
                            <th>T.Capital </th> <!-- Total Loan Capital (NEW) -->
                            <th>T.Interest</th> <!-- Total Loan Interest -->
                            <th>T.VAT</th> <!-- Total VAT -->
                            <th>@GlobalSalaryExecution.Charges</th>
                            <th>@GlobalShared.Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNumber = 0;
                        }
                        @foreach (var salary in Model.SalaryPaymentExtractes)
                        {
                            ++rowNumber;
                            <tr>
                                <td>@rowNumber</td>
                                <td>@salary.Matricule</td> <!-- Account Number -->
                                <td>@salary.MemberName</td> <!-- Name -->
                                <td>@salary.Salary.ToString("N1")</td> <!-- Gross Amount (Original Salary) -->
                                <td>@salary.StandingOrderAmount.ToString("N1")</td> <!-- Standing Amount -->
                                <td>@salary.Saving.ToString("N1")</td> <!-- Savings -->
                                <td>@salary.Deposit.ToString("N1")</td> <!-- Deposit -->
                                <td>@salary.NetSalary.ToString("N1")</td> <!-- Net Salary -->
                                <td>@salary.Shares.ToString("N1")</td> <!-- Shares -->
                                <td>@salary.TotalLoanRepayment.ToString("N1")</td> <!-- Total Repayment -->
                                <td>@salary.LoanCapital.ToString("N1")</td> <!-- Total Capital -->
                                <td>@salary.LoanInterest.ToString("N1")</td> <!-- Total Interest -->
                                <td>@salary.VAT.ToString("N1")</td> <!-- Total VAT -->
                                <td>@salary.Charges.ToString("N1")</td> <!-- Charges -->
                                <td>
                                    @if (salary.Status)
                                    {
                                        <span class="badge bg-success">@GlobalShared.Executed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center my-3">
                    <p>@GlobalSalaryExecution.NoSalaryUploadsFound.</p>
                </div>
            }
        </div>        </div>
    
</fieldset>


