@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier



<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <!-- Dashboard Section -->
        <div id="dashboardSummary" class="mb-4">
            <div class="row row-cols-1 row-cols-md-3 g-4">

                <!-- Total Members -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Members</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalMembers.ToString("N0") <!-- Display total number of members -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Net Salary -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Net Salary</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalNetSalary.ToString("N1") <!-- Display total net salary -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Standing Order Amount -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Standing Order Amount</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalStandingOrderAmount.ToString("N1") <!-- Display total standing order amount -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Savings -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Savings</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalSavings.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Repayment -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Loan Repayment</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalLoanRepayment.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Charges -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Charges</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalCharges.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Shares -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Shares</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Preference Shares -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Preference Shares</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalPreferenceShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Interest -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Loan Interest</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalLoanInterest.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div id="datalistingview_inner">
            <div class="table-responsive mb-3">
                @if (Model.SalaryExtractes != null && Model.SalaryExtractes.Any())
                {
                    <table class="table table-hover" id="myDataTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Matricule</th>
                                <th>Reference</th>
                                <th>Name</th>
                                <th>N.Salary</th> <!-- ✅ Net Salary -->
                                <th>S.Order</th> <!-- ✅ Standing Order -->
                                <th>Savings</th>
                                <th>Deposit</th>
                                <th>Shares</th>
                                <th>P.Shares</th> <!-- ✅ Preference Shares -->
                                <th>L.Rep</th> <!-- ✅ Loan Repayment -->
                                <th>Charges</th> <!-- ✅ NEW: Charges Added -->
                                <th>Salary</th> <!-- ✅ Salary remains after Charges -->
                                <th>D.Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 0;
                            }
                            @foreach (var salary in Model.SalaryExtractes)
                            {
                                ++rowNumber;
                                <tr>
                                    <td>@rowNumber</td>
                                    <td>@salary.Matricule</td>
                                    <td>@salary.MemberReference</td>
                                    <td>@salary.MemberName</td>
                                    <td>@salary.NetSalary.ToString("N1")</td> <!-- ✅ Net Salary -->
                                    <td>@salary.StandingOrderAmount.ToString("N1")</td> <!-- ✅ Standing Order -->
                                    <td>@salary.Saving.ToString("N1")</td>
                                    <td>@salary.Deposit.ToString("N1")</td>
                                    <td>@salary.Shares.ToString("N1")</td>
                                    <td>@salary.PreferenceShares.ToString("N1")</td> <!-- ✅ Preference Shares -->
                                    <td>@salary.TotalLoanRepayment.ToString("N1")</td> <!-- ✅ Loan Repayment -->
                                    <td>@salary.Charges.ToString("N1")</td> <!-- ✅ NEW: Charges Added -->
                                    <td>@salary.RemainingSalary.ToString("N1")</td> <!-- ✅ Salary remains after Charges -->
                                    <td>
                                        @if (salary.Status)
                                        {
                                            <span class="badge bg-success">Executed</span> <!-- ✅ Green for Executed -->
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span> <!-- ✅ Yellow for Pending -->
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center my-3">
                        <p>No salary uploads found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
