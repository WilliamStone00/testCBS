@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.NotificationConfig.NotificationConfigDto
    @using System.Globalization
@using Resources

    <div class="card bg-light mb-3 shadow-sm">
        <div class="card-body text-center">
            <h3 class="card-title text-primary fw-bold mb-1">
                <i class="mdi mdi-bell-outline me-2"></i> @GlobalNotificationConfig.notification_configuration_details
            </h3>
            <p class="card-text text-muted small mb-0">@GlobalNotificationConfig.readonly_view_of_the_notification_configuration.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Basic_Information</h6>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><td class="fw-bold">ID</td><td>@Html.Encode(Model?.Id)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.Name</td><td>@Html.Encode(Model?.Name)</td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.notification_type</td><td>@Html.Encode(Model?.NotificationType)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.channel</td><td>@Html.Encode(Model?.Channel)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.audience</td><td>@Html.Encode(Model?.Audience)</td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.target_role</td><td>@Html.Encode(Model?.TargetRole)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.priority</td><td>@(Model?.Priority.ToString() ?? "0")</td></tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.is_default</td>
                        <td>
                            @if (Model?.IsDefault == true)
                            {
                                <span class="badge bg-success">@GlobalShared.Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@GlobalShared.No</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Is_Active</td>
                        <td>
                            @if (Model?.IsActive == true)
                            {
                                <span class="badge bg-success">@GlobalShared.Active</span>
                            }
                            else
                            {
                        <span class="badge bg-danger">@GlobalShared.InActive</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-map-marker-radius-outline me-2"></i> @GlobalNotificationConfig.routing_branches</h6>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><td class="fw-bold">@GlobalShared.Is_Centralised</td><td>@(Model?.IsCentralised == true ? "Yes" : "No")</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.Branch_ID</td><td>@Html.Encode(Model?.BranchId)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.Branch_Name</td><td>@Html.Encode(Model?.BranchName)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.channel</td><td>@Html.Encode(Model?.Channel)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.schedule (Cron)</td><td>@Html.Encode(Model?.ScheduleCron)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.delay (mins)</td><td>@(Model?.DelayInMinutes.ToString() ?? "0")</td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.max_day</td><td>@(Model?.MaxNotificationsPerDay.ToString() ?? "0")</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-file-document-outline me-2"></i> @GlobalNotificationConfig.template_localization</h6>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.notification_template</td><td><pre class="mb-0">@Html.Encode(Model?.NotificationTemplate ?? "-")</pre></td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.email_subject</td><td>@Html.Encode(Model?.EmailSubject)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.Language</td><td>@Html.Encode(Model?.Language)</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.localized_templates</td><td><pre class="mb-0">@Html.Encode(Model?.LocalizedTemplates ?? "-")</pre></td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.available_placeholders</td><td><pre class="mb-0">@Html.Encode(Model?.AvailablePlaceholders ?? "-")</pre></td></tr>
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> @GlobalNotificationConfig.rules_monitoring</h6>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.trigger_event</td><td>@Html.Encode(Model?.TriggerEvent)</td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.condition_expression</td><td><pre class="mb-0">@Html.Encode(Model?.ConditionExpression ?? "-")</pre></td></tr>
                    <tr><td class="fw-bold">@GlobalShared.days_before_expiry</td><td>@(Model?.DaysBeforeExpiry.ToString() ?? "0")</td></tr>
                    <tr><td class="fw-bold">@GlobalNotificationConfig.cooldown (hrs)</td><td>@(Model?.CooldownPeriodInHours.ToString() ?? "0")</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.duplicate</td><td>@(Model?.AllowDuplicate )</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.requires_approval</td><td>@(Model?.RequiresApproval )</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.Approved_by</td><td>@Html.Encode(Model?.ApprovedBy)</td></tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.Approval_date</td>
                        <td>@(Model.ApprovalDate.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) )</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-chart-areaspline me-2"></i> @GlobalNotificationConfig.delivery_stats</h6>
            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><td class="fw-bold">@GlobalShared.total_sent</td><td>@(Model?.TotalSent.ToString()  )</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.success_count</td><td>@(Model?.SuccessCount.ToString()  )</td></tr>
                    <tr><td class="fw-bold">@GlobalShared.failure_count</td><td>@(Model?.FailureCount.ToString()  )</td></tr>
                    <tr>
                        <td class="fw-bold">@GlobalShared.last_sent_date</td>
                        <td>@(Model.LastSentDate.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) )</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
        </div>
    </div>
