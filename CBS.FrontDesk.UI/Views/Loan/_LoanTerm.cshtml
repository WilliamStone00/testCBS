@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>Terms</legend>
    <hr style="border: 2px solid green;" />
    <table class="table">
        <tr>
            <td><strong>@GlobalLoan.MembersCode:</strong></td>
            <td>@Model.LoanApplication.CustomerId</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanApplicationCode:</strong></td>
            <td>@Model.LoanApplication.Id</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanProductID:</strong></td>
            <td>@Model.LoanApplication.LoanProductId</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanProductName:</strong></td>
            <td>@Model.LoanApplication.LoanProduct.ProductName</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanType:</strong></td>
            <td>@Model.LoanApplication.LoanType</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.Amount:</strong></td>
            <td>@Model.LoanApplication.Amount.ToString("#,##0.00") FCFA</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.InterestRate:</strong></td>
            <td>@Model.LoanApplication.InterestRate.ToString("#,##0.00")%</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.Fees</strong></td>
            <td>
                @if (Model.LoanApplication.LoanApplicationFees.Any())
                {
                    <ul>
                        @foreach (var fee in Model.LoanApplication.LoanApplicationFees)
                        {
                            <li>
                                @fee.FeeLable: @(fee.FeeAmount.ToString("#,##0.00") + " FCFA")
                            </li>
                        }
                    </ul>

                    <strong>@GlobalLoan.TotalFeeAmount:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.00") + " FCFA")<br />
                    <strong>@GlobalLoan.TotalAmountPaid:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.00") + " FCFA")
                }
                else
                {
                    <label>@GlobalLoan.NoFeeAdded.</label>
                }
            </td>
        </tr>
        @*<tr>
                <td><strong>Repayment Circle:</strong></td>
                <td>@Model.LoanApplication.LoanProduct.LoanProductRepaymentCycles.FirstOrDefault(x => x.Id == @Model.LoanApplication.RepaymentCircle).RepaymentCycle</td>
            </tr>*@
        <tr>
            <td><strong>@GlobalLoan.LoanDuration:</strong></td>
            <td>@Model.LoanApplication.LoanDuration  -  @Model.LoanApplication.LoanProduct.LoanDurationPeriod</td>

        </tr>
        <tr>
            <td><strong>@GlobalLoan.FirstInstallmentDate:</strong></td>
            <td>@Model.LoanApplication.FirstInstallmentDate.ToString("MM/dd/yyyy")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.ApplicationDate:</strong></td>
            <td>@Model.LoanApplication.ApplicationDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.ApprovalState:</strong></td>
            <td>@Model.LoanApplication.ApprovalStatus</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.HasTheLoanBeenApproved?:</strong></td>
            <td>
                @if (@Model.LoanApplication.IsApproved)
                {
                    <span class="badge bg-info">@GlobalLoan.Approved</span>
                }
                else
                {
                    <span class="badge bg-dark">@GlobalLoan.Pending</span>
                }
            </td>
        </tr>
       
        <tr>
            <td><strong>@GlobalLoan.Vat rate:</strong></td>
            <td>@Model.LoanApplication.VatRate %</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.GracePeriodBeforeFirstInstallment:</strong></td>
            <td>@Model.LoanApplication.GracePeriodBeforeFirstPayment @GlobalLoan.MonthBeforeFirstInstallment.</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.GracePeriodAfterLoanDueDate:</strong></td>
            <td>@Model.LoanApplication.GracePeriodAfterMaturityDate @GlobalLoan.DaysAfterMaturityDate.</td>
        </tr>
    </table>


</fieldset>