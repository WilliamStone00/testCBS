@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
@{
    ViewBag.Title = @GlobalLoan.LoanApplicationDetails;
    var SavingCoverage = (Model.LoanApplication.SavingAccountCoverageRate / 100) * Model.RequestedAmount;
    var totalRefinancing = Model.RequestedAmount + Model.RestructuredBalance;
}

<div class="card-body">
    <table class="table table-bordered table-striped" id="myDataTable">
        <tbody>
            <!-- General Information -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.General_Information</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Members_Code:</td>
                <td>@Model.LoanApplication.CustomerId</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.LoanApplicationCode:</td>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.LoanApplicationType:</td>
                <td>
                    @if (@Model.LoanApplication.LoanApplicationType != "Normal")
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanApplication.LoanApplicationType</span>
                        <br /><a href="/Loan/Details?KEY=@Model.LoanId" target="_blank">@GlobalShared.Details >> @Model.LoanId</a>
                    }
                    else
                    {
                        <span class="badge bg-primary text-white">@GlobalShared.New_Loan</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Loan_Type:</td>
                <td>
                    @if (Model.LoanType=="Main_Loan")
                    {
                        <span class="badge bg-primary text-white">@Model.LoanType</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanType</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Loan_Category:</td>
                <td>@Model.LoanCategory</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.TargetedPopulation:</td>
                <td>@Model.LoanTarget</td>
            </tr>

            <!-- General Information -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Product_Information</td>
            </tr>

            <tr>
                <td class="font-weight-bold">@GlobalShared.Product_Code:</td>
                <td>@Model.LoanApplication.LoanProduct.ProductCode</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Product_Name:</td>
                <td>@Model.LoanApplication.LoanProduct.ProductName</td>
            </tr>
            @*<tr>
                    <td class="font-weight-bold">Product term:</td>
                    <td>@Model.LoanProduct.LoanTerm.Name</td>
                </tr>*@

            <!-- Application Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoan.ApplicationDetails</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.ApplicationDate:</td>
                <td>@Model.LoanApplication.ApplicationDate.Value.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Approval_date:</td>
                <td>@Model.LoanApplication.ApprovalDate.Value.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.DisbursementDate:</td>
                <td>@Model.DisbursementDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.ApplicationManage:</td>
                <td>@Model.LoanManager</td>
            </tr>

            <!-- Application Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoan.MigrationStatus</td>
            </tr>
            <tr>
                <td class="font-weight-bold">Migrated Loan:</td>
                <td>
                    @if (Model.LoanApplication?.IsUpload == true)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoan.TSCLoan</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalLoan.MigratedLoan</span>
                    }
                </td>
            </tr>
            <!-- Loan Status -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Loan_Status</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.ApprovalStatus:</td>
                <td>
                    <span class="badge bg-@(Model.LoanApplication.IsApproved ? "success" : "danger")">
                        @(Model.LoanApplication.IsApproved ? "Approved" : "Pending")
                    </span>
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Disbursement_Status:</td>
                <td>@(Model.LoanApplication.IsDisbursed ? "Yes" : "No")</td>
            </tr>
            <!-- Refinancing Details -->
            @if (Model.LoanApplication.LoanApplicationType == "Refinancing")
            {
                <tr class="table-primary">
                    <td colspan="2" class="font-weight-bold text-center">@GlobalLoan.RefinancingDetails</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalShared.Requested_Amount:</td>
                    <td>@Model.RequestedAmount.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.RestructuredBalance:</td>
                    <td>@Model.RestructuredBalance.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.RefinancedAmount:</td>
                    <td>@totalRefinancing.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr class="table-secondary">
                    <td colspan="2" class="font-weight-bold text-center">@GlobalLoan.OldLoanInformation</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.OldLoanAmount:</td>
                    <td>@Model.LoanApplication.OldLoanAmount.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.OldLoanCapital:</td>
                    <td>@Model.LoanApplication.OldLoanCapital.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.OldLoanInterest:</td>
                    <td>@Model.LoanApplication.OldLoanInterest.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.OldLoanVAT:</td>
                    <td>@Model.LoanApplication.OldLoanVat.ToString("#,##0.0") FCFA</td>
                </tr>
                <tr>
                    <td class="font-weight-bold">@GlobalLoan.OldLoanPenalty:</td>
                    <td>@Model.LoanApplication.OldLoanPenalty.ToString("#,##0.0") FCFA</td>
                </tr>
            }
            <!-- Interest Payment Details -->
            <!-- Loan Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Loan_Details</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.LoanProductID:</td>
                <td>@Model.LoanApplication.LoanProductId</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Total_Loan_Amount:</td>
                <td><strong>@Model.LoanApplication.Amount.ToString("#,##0.0") FCFA</strong></td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Interest_Rate:</td>
                <td>@Model.InterestRate.ToString("#,##0.0")%</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.LoanManager:</td>
                <td>@Model.LoanManager</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Fees:</td>
                <td>
                    @if (Model.LoanApplication.LoanApplicationFees.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var fee in Model.LoanApplication.LoanApplicationFees)
                            {
                                <li>
                                    @fee.FeeLable: @(fee.FeeAmount.ToString("#,##0.0") + " FCFA")
                                </li>
                            }
                        </ul>
                        <div>
                            <strong>Total Fee Amount:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.0") + " FCFA")<br />
                            <strong>Total Amount Paid:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.0") + " FCFA")
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">@GlobalShared.No_Fee_Added.</span>
                    }
                </td>
            </tr>

            <!-- Downpayments and Coverage Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalLoan.DownpaymentsAndCoverage</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.TotalDownPaymentProvided:</td>
                <td><strong>@Model.LoanApplication.DownPaymentCoverageAmountProvided.ToString("#,##0.0") FCFA</strong></td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.ShareCoveredAmount:</td>
                <td>@Model.LoanApplication.ShareAccountCoverageAmount.ToString("#,##0.0") FCFA</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.SavingCoverageProvided:</td>
                <td>@Model.LoanApplication.SavingAccountCoverageRate.ToString("#,##0.0")% of @Model.RequestedAmount.ToString("#,##0"): [@SavingCoverage.ToString("#,##0")] FCFA</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.WasPreferenceShareAccountUsedAsCoverage?</td>
                <td>
                    @if (Model.LoanApplication.IsPreferenceShareAccountCoverageAmount)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoan.YESCoverageAmount: @Model.LoanApplication.PreferenceShareAccountCoverageAmount.ToString("#,##0.0")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalShared.No</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.WasDepositAccountUsedAsCoverage?</td>
                <td>
                    @if (Model.LoanApplication.IsDepositAccountCoverageAmount)
                    {
                        <span class="badge bg-primary text-white">@GlobalLoan.YESCoverageAmount: @Model.LoanApplication.DepositAccountCoverageAmount.ToString("#,##0.0")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalShared.No</span>
                    }
                </td>
            </tr>



            <!-- Additional Details -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Additional_Details</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Vat_rate:</td>
                <td>@Model.VatRate.ToString("#,##0.0")%</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.GracePeriodBeforeFirstInstallment:</td>
                <td>@Model.LoanApplication.GracePeriodBeforeFirstPayment @GlobalLoan.monthsBeforeFirstInstallment</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.GracePeriodAfterLoanDueDate:</td>
                <td>@Model.LoanApplication.GracePeriodAfterMaturityDate @GlobalLoan.daysAfterMaturityDate</td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalShared.Approval_status:</td>
                <td>
                    @if (Model.LoanApplication.IsApproved)
                    {
                        <span class="badge bg-primary text-white">@Model.LoanApplication.ApprovalStatus</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.LoanApplication.ApprovalStatus</span>
                    }


                </td>
            </tr>
            <tr>
                <td class="font-weight-bold">@GlobalLoan.HasTheLoanBeenApproved?</td>
                <td>
                    @if (Model.LoanApplication.IsApproved)
                    {
                        <span class="badge bg-primary text-white">@GlobalShared.Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                    }
                </td>
            </tr>
            <!-- Guarantors Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Guarantors</td>
            </tr>
            @if (Model.LoanApplication.Guarantors?.Any() == true)
            {
                foreach (var guarantor in Model.LoanApplication.Guarantors)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalLoan.GuarantorName:</td>
                        <td>@guarantor.GuarantorName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalLoan.GuarantorRelationship:</td>
                        <td>@guarantor.Relationship</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalLoan.NoGuarantorsProvided.</td>
                </tr>
            }

            <!-- Collateral Section -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Collateral</td>
            </tr>
            @if (Model.LoanApplication.Collateras?.Any() == true)
            {
                foreach (var collateral in Model.LoanApplication.Collateras)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalLoan.CollateralType:</td>
                        <td>@collateral.Location</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalLoan.CollateralValue:</td>
                        <td>@collateral.Amount.ToString("#,##0.0") FCFA</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalLoan.NoCollateralProvided.</td>
                </tr>
            }


            <!-- Attached Documents -->
            <tr class="table-primary">
                <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Attached_Documents</td>
            </tr>
            @if (Model.LoanApplication.DocumentAttachedToLoans?.Any() == true)
            {
                foreach (var document in Model.LoanApplication.DocumentAttachedToLoans)
                {
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Document_Name:</td>
                        <td>@document.FileName @document.FileExtension</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Uploaded_Date:</td>
                        <td>@document.Date.ToString("dd/MM/yyyy hh:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Open:</td>
                        <td><a href="@($"{document.FilePath}")" target="_blank" class="btn btn-sm btn-primary">@GlobalShared.Read_Content</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">@GlobalShared.No_Documents_Attached.</td>
                </tr>
            }

        </tbody>
    </table>

</div>

