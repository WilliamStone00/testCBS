@using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th data-data="LoanDate">@GlobalShared.Loan_Date</th>
                <th data-data="CustomerName">@GlobalShared.Name</th>
                <th data-data="CustomerId">M.ACCNO</th>
                <th data-data="LoanAmount">@GlobalShared.Amount</th>
                <th data-data="InterestRate">I.R</th>
                <th data-data="AccrualInterest">@GlobalShared.Interest</th>
                <th data-data="Balance">@GlobalShared.Balance</th>
                <th data-data="LoanStatus">@GlobalShared.Status</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            <!-- Table rows populated dynamically -->
        </tbody>
    </table>
</div>
