@model CBS.FrontDesk.Data.Entity.LoanConf.Loan

<fieldset class="fieldset-custom">
    <legend id="select_base">Downloaded files</legend>
    @if (Model.FileDownloadInfoLoans.Count == 0)
    {
        <div class="text-center my-3">
            <p>No file found</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>FileName</th>
                        <th>Extension</th>
                        <th>Size</th>
                        <th>User</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.FileDownloadInfoLoans.OrderByDescending(d => d.DateInitiated))
                    {
                        <tr>
                            <td style="width:20%">@d.DateInitiated</td>
                            <td style="width:30%">@d.FileName</td>
                            <td style="width:5%">@d.Extension</td>
                            <td style="width:10%">@d.Size</td>
                            <td style="width:17%">@d.UserName</td>
                            <td style="width:18%">
                                <a href="/Loan/DownloadFile?fileId=@d.Id" onclick="" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.FileName to download">Download</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.FileName" onclick="DeleteRecordThenReloadPage('Loan','@d.Id')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
