<fieldset class="fieldset-custom">
    <legend>Loan Portfolio</legend>
    <form method="post" action="/Loan/DownloadFile/">
        <hr />
        <div class="col-12">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.InitiateLoanDownloadCommand.IsCompleteRepaid, new { @class = "form-check-input" })
                <label class="form-check-label" for="isActive">Check to download only repaid loans.</label>
            </div>
        </div>
        <hr />
        <div class="row g-4">
            <div class="col-md-4">
                <label for="branchInput">Branch</label>
                @Html.DropDownListFor(m => m.InitiateLoanDownloadCommand.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---Select Branch---", new { @class = "form-control shadow-box select2", @id = "branchInput" })
            </div>
            <div class="col-md-8">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="dateFromInput">Date From</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.InitiateLoanDownloadCommand.StrStartDate, new { @class = "form-control shadow-box date-picker", @placeholder = "Date From" })
                            @*<input type="date" id="dateFromInput" class="form-control shadow-box date-picker" placeholder="Date From">*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="dateToInput">Date To</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.InitiateLoanDownloadCommand.StrEndDate, new { @class = "form-control shadow-box date-picker", @placeholder = "Date To" })
                            @*<input type="date" id="dateToInput" class="form-control shadow-box date-picker" placeholder="Date To">*@
                            @*<button class="btn btn-primary btn-sm" onclick="SearchByDates('_Data','datalistingview')">Search</button>*@
                            <button type="submit" class="btn btn-default btn-sm">Initiate Download</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</fieldset>

