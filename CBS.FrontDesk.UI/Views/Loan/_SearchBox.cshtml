@model CBS.FrontDesk.Data.Entity.LoanConf.Loan

<fieldset class="fieldset-custom">
    <legend>Initialise Loan Download By Dates</legend>
    <hr />
    @using (Html.BeginForm("InitializeDownload", "Loan", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {

        @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.InitiateLoanDownloadCommand.StrStartDate, new { @class = "form-control date-picker" })
                    @Html.ValidationMessageFor(m => m.InitiateLoanDownloadCommand.StrStartDate, "", new { @class = "text-danger" })
                    <label>Start Data</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.InitiateLoanDownloadCommand.StrEndDate, new { @class = "form-control date-picker" })
                    @Html.ValidationMessageFor(m => m.InitiateLoanDownloadCommand.StrEndDate, "", new { @class = "text-danger" })
                    <label>End Date</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Initiate Download</button>
        </div>
    }
</fieldset>

