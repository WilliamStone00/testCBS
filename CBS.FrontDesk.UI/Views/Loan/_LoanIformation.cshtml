@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalLoan.Terms</legend>
    <hr style="border: 2px solid green;" />
    <table class="table">
        <tr>
            <td><strong>@GlobalLoan.LoanCode:</strong></td>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.BranchCode:</strong></td>
            <td>@Model.BranchCode</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanDate:</strong></td>
            <td>@Model.LoanDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanExpiryDate:</strong></td>
            <td>@Model.MaturityDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanType:</strong></td>
            <td>@Model.LoanType</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanAmount:</strong></td>
            <td>@Model.LoanAmount.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.InterestRate:</strong></td>
            <td>@Model.InterestRate.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.AccrualInterest:</strong></td>
            <td>@Model.AccrualInterest.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.AccrualPaid:</strong></td>
            <td>@Model.AccrualInterestPaid.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.InterestRate:</strong></td>
            <td>@Model.InterestRate.ToString("#,##0.00")%</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LastCalculatedInterestDate:</strong></td>
            <td>@Model.LastInterestCalculatedDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LastCalculatedInterest:</strong></td>
            <td>@Model.LastCalculatedInterest.ToString("#,##0.0")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.VatRate:</strong></td>
            <td>@Model.VatRate.ToString("#,##0.00")%</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.Vat:</strong></td>
            <td>@Model.Tax.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.VatPaid:</strong></td>
            <td>@Model.TaxPaid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.Fine:</strong></td>
            <td>@Model.Penalty.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.FinePaid:</strong></td>
            <td>@Model.PenaltyPaid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.TotalPaid:</strong></td>
            <td>@Model.Paid.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.Balance:</strong></td>
            <td>@Model.Balance.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LastRepaymentDate:</strong></td>
            <td>@Model.LastRefundDate</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LastRepayment:</strong></td>
            <td>@Model.LastPayment.ToString("#,##0.00")</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanStatus:</strong></td>
            <td>@Model.LoanStatus</td>
        </tr>

        <tr>
            <td><strong>@GlobalLoan.LoanDeliquecyJourney:</strong></td>
            <td>@Model.LoanJourneyStatus</td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanState</strong></td>
            <td>
                @if (@Model.IsCurrentLoan)
                {
                    <span class="badge bg-info">@GlobalLoan.Current</span>
                }
                else
                {
            <span class="badge bg-dark">@GlobalLoan.NotCurrent</span>
                }
            </td>
        </tr>
        <tr>
            <td><strong>@GlobalLoan.LoanManager:</strong></td>
            <td>@Model.LoanManager</td>
        </tr>
    </table>
</fieldset>
