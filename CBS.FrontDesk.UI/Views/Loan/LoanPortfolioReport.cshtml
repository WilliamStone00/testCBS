´@using Resources
@{
    ViewBag.Title = @GlobalLoan.LoanPortfolioReportOverview;
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-finance me-2"></i> @GlobalLoan.LOAN_PORTFOLIO_REPORT
                </h1>
                <p class="card-text">
                    @GlobalLoan.AnalyzeAndTrackLoanPortfolioStatisticsAcrossBranchesAndTimeframes.
                </p>
                <p class="card-text text-black fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalLoan.SelectAMainReportTypeOrGenerateAFullPortfolioReportWithOptionalSubreportDetails.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoan.TIPS_FOR_USING_LOAN_PORTFOLIO_REPORT_FILTERS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-bank-outline text-success me-2"></i> <strong>@GlobalLoan.FilterByBranch:</strong> @GlobalLoan.FocusOnAspecificCreditUnionBranch.</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i> <strong>@GlobalLoan.DateRange:</strong> @GlobalLoan.DefineTheLoanDisbursementOrReportPeriod.</li>
                <li><i class="mdi mdi-table-large text-info me-2"></i> <strong>@GlobalLoan.MainReportType:</strong> @GlobalLoan.ChooseBetweenAFullReportOrAFocusedView.</li>
                <li><i class="mdi mdi-layers-triple-outline text-info me-2"></i> <strong>@GlobalLoan.SubreportAnalysis:</strong> @GlobalLoan.AddDeeperBreakdownsSuchAsAgingGenderAndPurpose.</li>
                <li><i class="mdi mdi-file-export-outline text-success me-2"></i> <strong>@GlobalLoan.Export:</strong> @GlobalLoan.DownloadAsPDFExcelOrWordForSharingAndCompliance.</li>
            </ul>
        </div>
    </div>
</div>

@Html.Partial("_FIlterQuery")
<!-- Section to Show Status or Report Downloads -->
<div id="reportStatusArea" class="mt-3"></div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/Loan/Portfolio/loanPortfolioReport.js"></script>

    <script>
    $(function () {
        // Initialize Select2
        $('.select2').select2({ width: '100%' });

        /* ================= RESET FUNCTIONS ================= */
        function resetAllSections() {
            resetMainReport();
            resetQueryParam();
            resetLoanReports();
            resetSSFReports();
            resetDurationReports();
            resetPARReports();
            resetDateBranch();
        }

        function resetMainReport() {
            $('#MainReportType').val('DelinquentLoan');
            $('#SubReportType').val([]).trigger('change');
        }

        function resetQueryParam() {
            $('#QueryParam').val('');
            $('#QueryParamValue').html('<option value="">-- Select Value --</option>');
        }

        function resetLoanReports() {
            $('#ReportType').val('');
        }

        function resetSSFReports() {
            $('#SSFReportType').val('');
        }

        function resetDurationReports() {
            $('#DurationType').val('');
        }

        function resetPARReports() {
            $('#PARType').val('');
        }

        function resetDateBranch() {
            $('#BranchId').val('').trigger('change');
            $('#StartDate, #EndDate').val('');
        }

        /* ================= SECTION TOGGLING ================= */

        // Report type toggles - only one can be active
        $('.report-type-toggle').on('change', function() {
            if ($(this).is(':checked')) {
                // Uncheck all other report type toggles
                $('.report-type-toggle').not(this).prop('checked', false);
                toggleReportSections();
            } else {
                // If this was the only checked one and we uncheck it, check main by default
                if ($('.report-type-toggle:checked').length === 0) {
                    $('#toggleReportType').prop('checked', true);
                }
                toggleReportSections();
            }
        });

        function toggleReportSections() {
            const isMainReport = $('#toggleReportType').is(':checked');
            const isLoanReport = $('#toggleloanreports').is(':checked');
            const isSSFReport = $('#toggleSSF').is(':checked');
            const isDurationReport = $('#toggleDuration').is(':checked');
            const isPARReport = $('#togglePAR').is(':checked');

            // Show/hide sections based on active toggles
            $('#mainFilterSection').toggle(isMainReport);
            $('#LoanReportsSection').toggle(isLoanReport);
            $('#SSFLoanSection').toggle(isSSFReport);
            $('#DurationSection').toggle(isDurationReport);
            $('#PARSection').toggle(isPARReport);

            // Query filter section is only visible when Main Report is active AND 'All' is selected
            if (isMainReport) {
                $('#queryFilterSection').toggle($('#MainReportType').val() === 'All');
            } else {
                $('#queryFilterSection').hide();
            }

            // Subreport section logic
            if (isMainReport) {
                $('#subreportSection').toggle($('#MainReportType').val() === 'All');
            } else {
                $('#subreportSection').hide();
            }
        }

        // Filter toggles - independent and show/hide correctly
        $('.filter-toggle').on('change', function() {
            const filterId = $(this).attr('id');

            if (filterId === 'byBranch') {
                if ($(this).is(':checked')) {
                    $('#branchFilterSection').slideDown();
                } else {
                    $('#branchFilterSection').slideUp();
                }
            } else if (filterId === 'byDate') {
                if ($(this).is(':checked')) {
                    $('#dateRangeSection').slideDown();
                } else {
                    $('#dateRangeSection').slideUp();
                }
            }
        });

        // Main Report Type change handler
        $('#MainReportType').on('change', function() {
            const isAllSelected = $(this).val() === 'All';
            $('#subreportSection').toggle(isAllSelected);
            $('#queryFilterSection').toggle(isAllSelected);
        });

        // Query Param change handler
        $('#QueryParam').on('change', function () {
            const selectedParam = $(this).val();
            const $dropdown = $('#QueryParamValue');

            $dropdown.html('<option>Loading...</option>');

            if (!selectedParam) {
                $dropdown.html('<option value="">-- Select Value --</option>');
                return;
            }

            $.get('@Url.Action("GetLoanFilterValues", "Loan")',
                { queryParam: selectedParam },
                function (data) {
                    $dropdown.empty().append('<option value="">-- Select Value --</option>');
                    $.each(data, function (i, val) {
                        $dropdown.append(`<option value="${val}">${val}</option>`);
                    });
                }
            ).fail(function () {
                $dropdown.html('<option value="">-- Load Failed --</option>');
            });
        });

        /* ================= RESET BUTTON ================= */
        $('#resetReportBtn').on('click', function () {
            // Uncheck all toggles
            $('input[type=checkbox]').prop('checked', false);

            // Set default: Main Reports checked
            $('#toggleReportType').prop('checked', true);

            // Reset all selections
            resetAllSections();

            // Update UI
            toggleReportSections();

            // Hide filter sections (since they're unchecked)
            $('#branchFilterSection, #dateRangeSection').hide();
        });

        /* ================= INITIAL STATE ================= */
        $('#toggleReportType').prop('checked', true);
        toggleReportSections();

        // Ensure filter sections are hidden initially
        $('#branchFilterSection, #dateRangeSection').hide();
    });


    </script>

}
