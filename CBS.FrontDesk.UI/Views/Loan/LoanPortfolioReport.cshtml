´@using Resources
@{
    ViewBag.Title = @GlobalLoan.LoanPortfolioReportOverview;
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-finance me-2"></i> @GlobalLoan.LOAN_PORTFOLIO_REPORT
                </h1>
                <p class="card-text">
                    @GlobalLoan.AnalyzeAndTrackLoanPortfolioStatisticsAcrossBranchesAndTimeframes.
                </p>
                <p class="card-text text-black fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalLoan.SelectAMainReportTypeOrGenerateAFullPortfolioReportWithOptionalSubreportDetails.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoan.TIPS_FOR_USING_LOAN_PORTFOLIO_REPORT_FILTERS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-bank-outline text-success me-2"></i> <strong>@GlobalLoan.FilterByBranch:</strong> @GlobalLoan.FocusOnAspecificCreditUnionBranch.</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i> <strong>@GlobalLoan.DateRange:</strong> @GlobalLoan.DefineTheLoanDisbursementOrReportPeriod.</li>
                <li><i class="mdi mdi-table-large text-info me-2"></i> <strong>@GlobalLoan.MainReportType:</strong> @GlobalLoan.ChooseBetweenAFullReportOrAFocusedView.</li>
                <li><i class="mdi mdi-layers-triple-outline text-info me-2"></i> <strong>@GlobalLoan.SubreportAnalysis:</strong> @GlobalLoan.AddDeeperBreakdownsSuchAsAgingGenderAndPurpose.</li>
                <li><i class="mdi mdi-file-export-outline text-success me-2"></i> <strong>@GlobalLoan.Export:</strong> @GlobalLoan.DownloadAsPDFExcelOrWordForSharingAndCompliance.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalLoan.GenerateLoanPortfolioReport</h5>
    <div class="card p-3 mb-3 bg-light">

        <!-- Toggle Options -->
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" />
                <label class="form-check-label fw-bold" for="byBranch">@GlobalLoan.FilterByBranch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byMainReport" />
                <label class="form-check-label fw-bold" for="byMainReport">@GlobalLoan.FilterByMainReportType</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" />
                <label class="form-check-label fw-bold" for="byDate">@GlobalLoan.FilterByDateRange</label>
            </div>
        </div>

        <!-- Branch Section -->
        <div id="branchFilterSection" class="row mb-3" style="display: none;">
            <div class="col-md-12">
                <label for="BranchId" class="form-label fw-bold">@GlobalLoan.SelectBranch</label>
                @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "---" + @GlobalLoan.SelectBranch +"---", new { @class = "form-control select2" })
            </div>
        </div>

        <!-- Main Report Type + Subreport on same line -->
        <div class="row mb-3" id="mainReportTypeSection" style="display: none;">
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalLoan.MainReportType</label>
                <select id="MainReportType" class="form-select">
                    <option value="All">@GlobalLoan.FullLoanPortfolioReport</option>
                    <option value="CurrentLoan">@GlobalLoan.CurrentLoanSummary</option>
                    <option value="DelinquentLoan">@GlobalLoan.DelinquentLoanSummary</option>
                    <option value="LoanByPurpose">@GlobalLoan.LoanByPurpose</option>
                </select>
            </div>
            <div class="col-md-6" id="subreportSection" style="display: none;">
                <label class="form-label fw-bold">Subreport Type(s)</label>
                <select id="SubReportType" class="form-select select2" multiple>
                    <option value="Flat_AgeAndGender">@GlobalLoan.DelinquencyAccordingToAgesAndGender</option>
                    <option value="Flat_AgeAndLoanType">@GlobalLoan.DelinquencyAccordingToAgesAndLoanTypes</option>
                    <option value="Flat_ByZone">@GlobalLoan.DelinquencyAccordingToZones</option>
                    <option value="Flat_ByLoanTerm">@GlobalLoan.DelinquencyAccordingToLoanTerms</option>
                    <option value="Flat_ByTargetGroup">@GlobalLoan.DelinquencyAccordingToTargetGroups</option>
                    <option value="Flat_ByCategory">@GlobalLoan.DelinquencyAccordingToCategories</option>
                   
                </select>
                <small class="text">@GlobalLoan.HoldCtrlToSelectMultiple</small>
            </div>
        </div>

        <!-- Date Range Section -->
        <div id="dateRangeSection" class="row mb-3" style="display: none;">
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalLoan.StartDate</label>
                <input type="date" id="StartDate" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalLoan.EndDate</label>
                <input type="date" id="EndDate" class="form-control" />
            </div>
        </div>

        <!-- Export Format and Action -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label fw-bold">@GlobalLoan.ExportFormat</label>
                <select id="ReportDownloadType" class="form-select">
                    <option value="PDF">PDF</option>
                    <option value="Excel">Excel</option>
                    <option value="Word">Word</option>
                </select>
            </div>
        </div>


    </div>
    <div class="row mb-3">
        <div class="col-md-6 d-flex align-items-end">
            <button id="generateReportBtn" class="btn btn-primary w-100">
                <i class="mdi mdi-file-chart-outline me-1"></i> @GlobalLoan.GenerateReport
            </button>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <button id="resetReportBtn" class="btn btn-secondary w-100">
                <i class="mdi mdi-refresh me-1"></i> @GlobalLoan.ResetFilters
            </button>
        </div>
    </div>
</div>

<!-- Section to Show Status or Report Downloads -->
<div id="reportStatusArea" class="mt-3"></div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/Loan/Portfolio/loanPortfolioReport.js"></script>
    <script>
        $(function () {
            function resetBranch() {
                $('#BranchId').val('').trigger('change');
            }
            function resetMainReport() {
                $('#MainReportType').val('All');
                $('#SubReportType').val(null).trigger('change');
            }
            function resetDateRange() {
                $('#StartDate').val('');
                $('#EndDate').val('');
            }

            $('#byBranch').on('change', function () {
                $('#branchFilterSection').toggle(this.checked);
                if (!this.checked) resetBranch();
            });

            $('#byMainReport').on('change', function () {
                $('#mainReportTypeSection').toggle(this.checked);
                const showSubreports = $('#MainReportType').val() === "All";
                $('#subreportSection').toggle(showSubreports);
                if (!this.checked) resetMainReport();
            });

            $('#byDate').on('change', function () {
                $('#dateRangeSection').toggle(this.checked);
                if (!this.checked) resetDateRange();
            });

            $('#MainReportType').on('change', function () {
                const selected = $(this).val();
                $('#subreportSection').toggle(selected === "All");
            });

            $('#resetReportBtn').on('click', function () {
                $('#byBranch, #byMainReport, #byDate').prop('checked', false);
                resetBranch();
                resetMainReport();
                resetDateRange();
                $('#branchFilterSection, #mainReportTypeSection, #dateRangeSection, #subreportSection').hide();
                $('#ReportDownloadType').val('PDF');
            });

            $('.select2').select2({ width: '100%' });
            $('#subreportSection').hide();
        });
    </script>
}
