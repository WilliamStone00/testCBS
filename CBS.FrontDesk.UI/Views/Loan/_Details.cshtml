                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in d.RefundDetails)
                        {
                            <tr>
                                <td>@detail.CollectedAmount.ToString("#,##0.0")</td>
                                <td>@detail.PrincipalAmount.ToString("#,##0.0")</td>
                                <td>@detail.TaxAmount.ToString("#,##0.0")</td>
                                <td>@detail.Interest.ToString("#,##0.0")</td>
                                <td>@detail.PenaltyAmount.ToString("#,##0.0")</td>
                                <td>@detail.Balance.ToString("#,##0.0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <span>No details available</span>
            }
        </td>*@
</div>