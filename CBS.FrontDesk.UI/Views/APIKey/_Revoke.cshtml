@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.RevokeApiKeyRequest
@using Resources
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-key-chain me-2"></i>@ApiKeyRessource.Revoke_API_Key
        </h1>
        <p class="card-text">
            @ApiKeyRessource.Here_we_can_revoke_an_Api_key
        </p>
        <div class="alert alert-danger">
            <i class="mdi mdi-alert-circle-outline me-2"></i>
            <strong>@GlobalShared.Warning:</strong> @ApiKeyRessource.This_action_cannot_be_undone_The_API_key_will_be_immediately_invalidated.
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>


<form method="post" action="@Url.Action("Revoke", "ApiKey")"
      onsubmit="return handleFormSubmit(this, 'API Key revoked successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="card mb-2">
        <div class="card-header bg-light d-flex align-items-center">
            <i class="mdi mdi-key-chain me-2 text-primary" aria-hidden="true"></i>          <h5 class="mb-0">@ApiKeyRessource.Revoke_API_Key</h5>
                       
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <h4 class="form-label fw-bold">@ApiKeyRessource.Renew_API_Key_for <span class="fw-normal">@Model.UserName</span></h4>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold">@ApiKeyRessource.Revocation_Reason *</label>
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Enter reason for revoking this API key...",
                        required = "required",
                        aria_required = "true"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
            <button type="submit" class="btn btn-danger">
                <i class="mdi mdi-key-remove me-1" aria-hidden="true"></i> @GlobalShared.Revoke_Key
            </button>
        </div>
    </div>
</form>
