@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.RevokeApiKeyRequest

<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-key-chain me-2"></i>Revoke API Key
        </h1>
        <p class="card-text">
            Here we can revoke an Api key
        </p>
        <div class="alert alert-danger">
            <i class="mdi mdi-alert-circle-outline me-2"></i>
            <strong>Warning:</strong> This action cannot be undone. The API key will be immediately invalidated.
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>


<form method="post" action="@Url.Action("Revoke", "ApiKey")"
      onsubmit="return handleFormSubmit(this, 'API Key revoked successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="card mb-3">
        <div class="card-header bg-light d-flex align-items-center">
            <i class="mdi mdi-key-chain me-2 text-primary" aria-hidden="true"></i>          <h5 class="mb-0">Revoke API Key</h5>
                       
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <h4 class="form-label fw-bold">Revoke API Key for <span class="fw-normal">@Model.UserName</span></h4>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold">Revocation Reason *</label>
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Enter reason for revoking this API key...",
                        required = "required",
                        aria_required = "true"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">
                <i class="mdi mdi-key-remove me-1" aria-hidden="true"></i> Revoke Key
            </button>
        </div>
    </div>
</form>
