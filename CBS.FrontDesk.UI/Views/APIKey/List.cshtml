@model List<CBS.FrontDesk.Data.Entity.Accounting_V2.API.ApiKey>
<!-- _DataTable.cshtml -->

<div class="card">
    <div class="card-body">

        <!-- Filters (username + id) -->
        <div class="mb-3">
            <form id="apiKeyFilterForm" autocomplete="off" onsubmit="return false;">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">User Name</label>
                        <input type="text" id="filterUserName" name="UserName" class="form-control" placeholder="Search by user name" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Key Id</label>
                        <input type="text" id="filterId" name="Id" class="form-control" placeholder="Search by key id" />
                    </div>

                    <div class="col-md-4 d-flex gap-2">
                        <button id="applyApiKeyFilterBtn" type="button" class="btn btn-primary flex-grow-1" onclick="applyApiKeyFilter()">
                            <i class="mdi mdi-magnify"></i> Apply Filter
                        </button>
                        <button id="resetApiKeyFilterBtn" type="button" class="btn btn-outline-secondary flex-grow-1" onclick="resetApiKeyFilter()">
                            <i class="mdi mdi-refresh"></i> Reset
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table id="apiKeysTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:12%" />
                    <col style="width:15%" />
                    <col style="width:10%" />
                    <col style="width:15%" />
                    <col style="width:15%" />
                    <col style="width:8%" />
                    <col style="width:10%" />
                    <col style="width:15%" />
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Key Prefix</th>
                        <th>Created At</th>
                        <th>Expiration Date</th>
                        <th>Modified Date</th>
                        <th>Status</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="apiKeysTbody">
                    @* initial server render - keep server model (if provided) *@
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.Id">
                            <td>@item.UserName</td>
                            <td>
                                <code>@item.KeyPrefix</code>
                                <button class="btn btn-sm btn-outline-secondary ms-1 copy-prefix-btn"
                                        data-prefix="@item.KeyPrefix"
                                        data-bs-toggle="tooltip" title="Copy Prefix">
                                    <i class="mdi mdi-content-copy"></i>
                                </button>
                            </td>
                            <td>@item.CreatedAt.ToString()</td>
                            <td>
                                <span class="@(item.ExpirationDate < DateTime.UtcNow ? "text-danger" : "text-success")">
                                    @item.ExpirationDate.ToString()
                                </span>
                            </td>
                            <td>@item.ModifiedDate.ToString()</td>
                            <td>
                                @if (item.RevokedAt.HasValue)
                                {
                                    <span class="badge bg-danger">Revoked</span>
                                }
                                else if (!item.IsActive)
                                {
                                    <span class="badge bg-warning">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                            type="button" data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i> Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button class="dropdown-item" onclick="showDetails('@item.Id')">
                                                <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item" onclick="showRenew('@item.Id')">
                                                <i class="mdi mdi-calendar-refresh me-1 text-warning"></i> Renew
                                            </button>
                                        </li>
                                        <li>
                                            @if (item.IsActive)
                                            {
                                                <button class="dropdown-item" onclick="showChangeStatus('@item.Id')">
                                                    <i class="mdi mdi-toggle-switch-off me-1 text-secondary"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="dropdown-item" onclick="showChangeStatus('@item.Id')">
                                                    <i class="mdi mdi-toggle-switch me-1 text-success"></i> Activate
                                                </button>
                                            }
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger" onclick="showRevoke('@item.Id')">
                                                <i class="mdi mdi-key-remove me-1 text-danger"></i> Revoke
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-danger"
                                                    onclick="deleteApiKey('@item.Id', '@item.UserName')">
                                                <i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr id="noDataRow">
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="mdi mdi-key-remove mdi-48px mb-2"></i>
                                <br />
                                No API keys found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // ---------- Configuration: change these endpoints to your real API routes ----------
    const API_ENDPOINTS = {
        getByUserName: '/apikeys/getbyusername',   // expects ?username=...
        getById: '/api/apikeys/getbyid',               // expects ?id=...
        getAll: '/api/apikeys'                         // returns array of ApiKey
    };

    // Utility: render a single table row (returns DOM tr element)
    function populateRow(item) {
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', item.Id || '');

        const expirationClass = (new Date(item.ExpirationDate) < new Date()) ? 'text-danger' : 'text-success';
        const statusBadge = item.RevokedAt ? '<span class="badge bg-danger">Revoked</span>'
            : (!item.IsActive ? '<span class="badge bg-warning">Inactive</span>' : '<span class="badge bg-success">Active</span>');

        const activeBadge = item.IsActive ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';

        tr.innerHTML = `
            <td>${escapeHtml(item.UserName)}</td>
            <td>
                <code>${escapeHtml(item.KeyPrefix)}</code>
                <button class="btn btn-sm btn-outline-secondary ms-1 copy-prefix-btn" data-prefix="${escapeHtmlAttr(item.KeyPrefix)}" data-bs-toggle="tooltip" title="Copy Prefix">
                    <i class="mdi mdi-content-copy"></i>
                </button>
            </td>
            <td>${escapeHtml(item.CreatedAt)}</td>
            <td><span class="${expirationClass}">${escapeHtml(item.ExpirationDate)}</span></td>
            <td>${escapeHtml(item.ModifiedDate)}</td>
            <td>${statusBadge}</td>
            <td>${activeBadge}</td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="mdi mdi-cog-outline"></i> Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" onclick="showDetails('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item" onclick="showRenew('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-calendar-refresh me-1 text-warning"></i> Renew</button></li>
                        <li><button class="dropdown-item" onclick="showChangeStatus('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-toggle-switch me-1 text-success"></i> Toggle Active</button></li>
                        <li><button class="dropdown-item text-danger" onclick="showRevoke('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-key-remove me-1 text-danger"></i> Revoke</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item text-danger" onclick="deleteApiKey('${escapeHtmlAttr(item.Id)}','${escapeHtmlAttr(item.UserName)}')"><i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button></li>
                    </ul>
                </div>
            </td>
        `;
        return tr;
    }

    // Basic HTML-escape helpers
    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return String(text).replace(/[&<>"'`]/g, function (s) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;' })[s];
        });
    }
    function escapeHtmlAttr(text) {
        return escapeHtml(text).replace(/"/g, '&quot;');
    }

    // Render array into tbody
    function renderTable(items) {
        const tbody = document.getElementById('apiKeysTbody');
        tbody.innerHTML = ''; // clear

        if (!items || items.length === 0) {
            tbody.innerHTML = `
                <tr id="noDataRow">
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="mdi mdi-key-remove mdi-48px mb-2"></i><br/>No API keys found
                    </td>
                </tr>`;
            return;
        }

        const fragment = document.createDocumentFragment();
        items.forEach(i => fragment.appendChild(populateRow(i)));
        tbody.appendChild(fragment);

        // re-initialize tooltips & copy buttons for new elements
        initTooltipsAndCopy();
    }

    // Initialize tooltips and attach copy handlers
    function initTooltipsAndCopy() {
        // bootstrap tooltip init (if bootstrap 5)
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // copy buttons
        document.querySelectorAll('.copy-prefix-btn').forEach(btn => {
            btn.removeEventListener('click', copyToClipboardWrapped);
            btn.addEventListener('click', copyToClipboardWrapped);
        });
    }

    // wrapper to provide event to copyToClipboard
    function copyToClipboardWrapped(e) {
        const prefix = e.currentTarget.getAttribute('data-prefix') || '';
        copyToClipboard(prefix, e);
    }

    // copyToClipboard updated to accept event and text
    function copyToClipboard(text, evt) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(function () {
            // Show success feedback on the specific button
            const btn = evt.currentTarget;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="mdi mdi-check"></i>';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1000);
        }).catch(() => {
            // optionally show failure
        });
    }

    // ---------- Filter actions ----------
    async function applyApiKeyFilter() {
        const username = document.getElementById('filterUserName').value.trim();
        const id = document.getElementById('filterId').value.trim();

        showLoadingState(true);

        // We'll call three service actions and merge results.
        // Update the URLs in API_ENDPOINTS above to your actual endpoints.
        const calls = [];
        // 1) call by user name (only if provided)
        if (username) {
            calls.push(fetch(`${API_ENDPOINTS.getByUserName}?username=${encodeURIComponent(username)}`).then(r => r.ok ? r.json() : []));
        } else {
            // push an empty result to keep promise ordering optional
            calls.push(Promise.resolve([]));
        }

        // 2) call by id (only if provided)
        if (id) {
            calls.push(fetch(`${API_ENDPOINTS.getById}?id=${encodeURIComponent(id)}`).then(r => r.ok ? r.json() : null));
        } else {
            calls.push(Promise.resolve(null));
        }

        // 3) call a general filtered/all endpoint to get baseline results (could accept query params server-side)
        // If you want server-side filtered results, consider sending both username & id as query params to this endpoint.
        const qs = new URLSearchParams();
        if (username) qs.set('username', username);
        if (id) qs.set('id', id);
        calls.push(fetch(`${API_ENDPOINTS.getAll}?${qs.toString()}`).then(r => r.ok ? r.json() : []));

        try {
            const [byNameResult, byIdResult, listResult] = await Promise.all(calls);

            // Normalize results into an array
            let merged = [];

            // byNameResult can be array
            if (Array.isArray(byNameResult)) merged = merged.concat(byNameResult);

            // byIdResult may be a single object or null
            if (byIdResult) {
                if (Array.isArray(byIdResult)) merged = merged.concat(byIdResult);
                else merged.push(byIdResult);
            }

            // listResult expected to be array
            if (Array.isArray(listResult)) merged = merged.concat(listResult);

            // Deduplicate by Id
            const map = new Map();
            merged.forEach(it => {
                if (!it || !it.Id) return;
                if (!map.has(it.Id)) map.set(it.Id, it);
            });

            const deduped = Array.from(map.values());

            renderTable(deduped);
        } catch (err) {
            console.error('Error applying filter:', err);
            // As fallback reload full list
            await loadAllApiKeys();
        } finally {
            showLoadingState(false);
        }
    }

    // Reset inputs and reload full list
    function resetApiKeyFilter() {
        document.getElementById('filterUserName').value = '';
        document.getElementById('filterId').value = '';
        loadAllApiKeys();
    }

    // Load all keys (used on reset and initial load if needed)
    async function loadAllApiKeys() {
        showLoadingState(true);
        try {
            const resp = await fetch(API_ENDPOINTS.getAll);
            if (!resp.ok) throw new Error('Failed to load API keys');
            const data = await resp.json();
            renderTable(Array.isArray(data) ? data : []);
        } catch (err) {
            console.error('Error loading API keys:', err);
            renderTable([]);
        } finally {
            showLoadingState(false);
        }
    }

    // Show a simple loading state by disabling the buttons while waiting
    function showLoadingState(isLoading) {
        document.getElementById('applyApiKeyFilterBtn').disabled = !!isLoading;
        document.getElementById('resetApiKeyFilterBtn').disabled = !!isLoading;
        // Optionally you can add a spinner to buttons here
    }

    // on page load - ensure tooltips and copy buttons bind
    document.addEventListener('DOMContentLoaded', function () {
        initTooltipsAndCopy();
        // Optionally refresh data from server on load:
        // loadAllApiKeys();
    });
</script>
<script>
    // ---------- Configuration: change these endpoints to your real MVC routes ----------
    const API_ENDPOINTS = {
        getByUserName: '/ApiKeys/GetByUserName',     // returns { success: true, data: [...] }
        initializeData: '/ApiKeys/InitializeData'   // returns PartialView HTML when called with path=list or KEY=...
    };

    // ---------- Helpers copied from your existing script ----------
    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return String(text).replace(/[&<>"'`]/g, function (s) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;' })[s];
        });
    }
    function escapeHtmlAttr(text) {
        return escapeHtml(text).replace(/"/g, '&quot;');
    }

    function populateRow(item) {
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', item.Id || '');

        const expirationClass = (new Date(item.ExpirationDate) < new Date()) ? 'text-danger' : 'text-success';
        const statusBadge = item.RevokedAt ? '<span class="badge bg-danger">Revoked</span>'
            : (!item.IsActive ? '<span class="badge bg-warning">Inactive</span>' : '<span class="badge bg-success">Active</span>');
        const activeBadge = item.IsActive ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';

        tr.innerHTML = `
            <td>${escapeHtml(item.UserName)}</td>
            <td>
                <code>${escapeHtml(item.KeyPrefix)}</code>
                <button class="btn btn-sm btn-outline-secondary ms-1 copy-prefix-btn" data-prefix="${escapeHtmlAttr(item.KeyPrefix)}" data-bs-toggle="tooltip" title="Copy Prefix">
                    <i class="mdi mdi-content-copy"></i>
                </button>
            </td>
            <td>${escapeHtml(item.CreatedAt)}</td>
            <td><span class="${expirationClass}">${escapeHtml(item.ExpirationDate)}</span></td>
            <td>${escapeHtml(item.ModifiedDate)}</td>
            <td>${statusBadge}</td>
            <td>${activeBadge}</td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="mdi mdi-cog-outline"></i> Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" onclick="showDetails('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item" onclick="showRenew('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-calendar-refresh me-1 text-warning"></i> Renew</button></li>
                        <li><button class="dropdown-item" onclick="showChangeStatus('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-toggle-switch me-1 text-success"></i> Toggle Active</button></li>
                        <li><button class="dropdown-item text-danger" onclick="showRevoke('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-key-remove me-1 text-danger"></i> Revoke</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item text-danger" onclick="deleteApiKey('${escapeHtmlAttr(item.Id)}','${escapeHtmlAttr(item.UserName)}')"><i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button></li>
                    </ul>
                </div>
            </td>
        `;
        return tr;
    }

    function renderTable(items) {
        const tbody = document.getElementById('apiKeysTbody');
        tbody.innerHTML = '';

        if (!items || items.length === 0) {
            tbody.innerHTML = `
                <tr id="noDataRow">
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="mdi mdi-key-remove mdi-48px mb-2"></i><br/>No API keys found
                    </td>
                </tr>`;
            return;
        }

        const fragment = document.createDocumentFragment();
        items.forEach(i => fragment.appendChild(populateRow(i)));
        tbody.appendChild(fragment);

        initTooltipsAndCopy();
    }

    function initTooltipsAndCopy() {
        // bootstrap tooltip init (if bootstrap 5)
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            try { return new bootstrap.Tooltip(tooltipTriggerEl); } catch (e) { /* ignore */ }
        });

        // copy buttons
        document.querySelectorAll('.copy-prefix-btn').forEach(btn => {
            btn.removeEventListener('click', copyToClipboardWrapped);
            btn.addEventListener('click', copyToClipboardWrapped);
        });
    }
    function copyToClipboardWrapped(e) {
        const prefix = e.currentTarget.getAttribute('data-prefix') || '';
        copyToClipboard(prefix, e);
    }
    function copyToClipboard(text, evt) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(function () {
            const btn = evt.currentTarget;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="mdi mdi-check"></i>';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1000);
        }).catch(() => { /* ignore */ });
    }

    // Parse returned partial-html and extract <tr> elements (returns array of <tr> elements)
    function extractTrElementsFromHtml(html) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // try to find direct tr elements or inside a tbody
        let trNodes = Array.from(doc.querySelectorAll('tr'));
        // Filter out header rows by checking for th inside row
        trNodes = trNodes.filter(tr => !tr.querySelector('th'));
        return trNodes;
    }

    // Replace tbody with the supplied TR elements (array of <tr> nodes)
    function replaceTbodyWithTrNodes(trNodes) {
        const tbody = document.getElementById('apiKeysTbody');
        tbody.innerHTML = '';
        const frag = document.createDocumentFragment();
        trNodes.forEach(tr => frag.appendChild(tr));
        tbody.appendChild(frag);
        initTooltipsAndCopy();
    }

    // Merge TR nodes into existing JSON-rendered rows, dedupe by data-id
    function mergeJsonAndTrNodes(jsonItems, trNodes) {
        // First convert jsonItems to a map by Id
        const map = new Map();
        (jsonItems || []).forEach(it => {
            if (!it || !it.Id) return;
            map.set(it.Id, it);
        });

        // For TR nodes, try to read data-id attribute; if present and not in map, append as-is.
        const newTrs = [];
        trNodes.forEach(tr => {
            const id = tr.getAttribute('data-id');
            if (!id) {
                // no id: append raw
                newTrs.push(tr);
            } else if (!map.has(id)) {
                newTrs.push(tr);
            }
        });

        // Render map items as rows then append the additional TRs
        const items = Array.from(map.values());
        const tbody = document.getElementById('apiKeysTbody');
        tbody.innerHTML = '';
        const frag = document.createDocumentFragment();
        items.forEach(i => frag.appendChild(populateRow(i)));
        newTrs.forEach(tr => frag.appendChild(tr));
        tbody.appendChild(frag);
        initTooltipsAndCopy();
    }

    // ---------- Filter actions (uses InitializeData + GetByUserName) ----------
    async function applyApiKeyFilter() {
        const username = document.getElementById('filterUserName').value.trim();
        const id = document.getElementById('filterId').value.trim();
        // partialView name that InitializeData expects — change to the partial that renders TR rows
        const partialViewName = '_ApiKeyRowsPartial'; // <-- set this to your real partial name (server must return <tr> rows)

        showLoadingState(true);

        try {
            // Case 1: no filters => load list partial via InitializeData
            if (!username && !id) {
                const url = `${API_ENDPOINTS.initializeData}?path=list&partialView=${encodeURIComponent(partialViewName)}`;
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) throw new Error('Failed to load list partial');
                const html = await resp.text();
                const trs = extractTrElementsFromHtml(html);
                replaceTbodyWithTrNodes(trs);
                return;
            }

            // Case 2: username only => call GetByUserName (JSON) and render table from JSON
            if (username && !id) {
                const resp = await fetch(`${API_ENDPOINTS.getByUserName}?userName=${encodeURIComponent(username)}`);
                const json = await resp.json();
                if (json && json.success && Array.isArray(json.data)) {
                    renderTable(json.data);
                } else {
                    renderTable([]);
                }
                return;
            }

            // Case 3: id only => call InitializeData for that KEY (expects partial rendering that contains TR(s))
            if (id && !username) {
                const url = `${API_ENDPOINTS.initializeData}?KEY=${encodeURIComponent(id)}&partialView=${encodeURIComponent(partialViewName)}`;
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) throw new Error('Failed to load key partial');
                const html = await resp.text();
                const trs = extractTrElementsFromHtml(html);
                replaceTbodyWithTrNodes(trs);
                return;
            }

            // Case 4: both username & id => call GetByUserName (JSON) AND InitializeData(KEY ...)
            const calls = [
                fetch(`${API_ENDPOINTS.getByUserName}?userName=${encodeURIComponent(username)}`).then(r => r.ok ? r.json() : { success: false }),
                fetch(`${API_ENDPOINTS.initializeData}?KEY=${encodeURIComponent(id)}&partialView=${encodeURIComponent(partialViewName)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.ok ? r.text() : '')
            ];

            const [userJson, idHtml] = await Promise.all(calls);
            const userItems = (userJson && userJson.success && Array.isArray(userJson.data)) ? userJson.data : [];
            const idTrs = idHtml ? extractTrElementsFromHtml(idHtml) : [];

            mergeJsonAndTrNodes(userItems, idTrs);
        } catch (err) {
            console.error('Error applying filter:', err);
            // fallback: attempt to load list partial
            try {
                const url = `${API_ENDPOINTS.initializeData}?path=list&partialView=${encodeURIComponent(partialViewName)}`;
                const resp = await fetch(url);
                const html = await resp.text();
                const trs = extractTrElementsFromHtml(html);
                replaceTbodyWithTrNodes(trs);
            } catch (err2) {
                console.error('Fallback failed:', err2);
                renderTable([]);
            }
        } finally {
            showLoadingState(false);
        }
    }

    // Reset inputs and reload full list via InitializeData
    function resetApiKeyFilter() {
        document.getElementById('filterUserName').value = '';
        document.getElementById('filterId').value = '';
        // load list partial
        const partialViewName = '_ApiKeyRowsPartial'; // ensure this matches your server partial
        const url = `${API_ENDPOINTS.initializeData}?path=list&partialView=${encodeURIComponent(partialViewName)}`;
        showLoadingState(true);
        fetch(url).then(r => r.text()).then(html => {
            const trs = extractTrElementsFromHtml(html);
            replaceTbodyWithTrNodes(trs);
        }).catch(err => {
            console.error('Reset failed', err);
            renderTable([]);
        }).finally(() => showLoadingState(false));
    }

    function showLoadingState(isLoading) {
        const applyBtn = document.getElementById('applyApiKeyFilterBtn');
        const resetBtn = document.getElementById('resetApiKeyFilterBtn');
        if (applyBtn) applyBtn.disabled = !!isLoading;
        if (resetBtn) resetBtn.disabled = !!isLoading;
    }

    // on page load - ensure tooltips and copy buttons bind
    document.addEventListener('DOMContentLoaded', function () {
        initTooltipsAndCopy();
        // Optionally load full list at first load:
        // resetApiKeyFilter();
    });
</script>

