@model List<CBS.FrontDesk.Data.Entity.Accounting_V2.API.ApiKey>
<!-- _DataTable.cshtml -->

<div class="row">
    <div class="col-12">
        <!-- Header Card -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-key-chain me-2"></i>API Key Management
                </h1>
                <p class="card-text">
                    Manage and monitor all API keys for secure access to your application services.
                    Create, renew, revoke, and track API key usage and expiration.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>

        <!-- Tips Card -->
        <div class="card mb-3">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> API Key Management Tips</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseApiKeyTips" aria-expanded="false" aria-controls="collapseApiKeyTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>

            <div id="collapseApiKeyTips" class="collapse">
                <div class="card-body">
                    <ul>
                        <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>User Name:</strong> Search for API keys by the associated username to quickly find all keys for a specific user.</li>
                        <li><i class="mdi mdi-identifier text-info me-2"></i> <strong>Key ID:</strong> Use the unique Key ID to locate a specific API key when you need to manage individual keys.</li>
                        <li><i class="mdi mdi-shield-check-outline text-success me-2"></i> <strong>Status Monitoring:</strong> Regularly check the status column to ensure all active keys are valid and not revoked.</li>
                        <li><i class="mdi mdi-calendar-clock text-warning me-2"></i> <strong>Expiration Dates:</strong> Monitor expiration dates closely and renew keys before they expire to avoid service interruptions.</li>
                        <li><i class="mdi mdi-content-copy text-secondary me-2"></i> <strong>Key Prefix:</strong> Use the copy button next to each key prefix for easy reference when identifying keys in logs.</li>
                        <li><i class="mdi mdi-toggle-switch-off text-danger me-2"></i> <strong>Security Best Practices:</strong> Regularly rotate API keys and immediately revoke any keys that may be compromised.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Filter Api Key</h5>
                <!-- Filters (username + id) -->
                <div class="mb-3">
                    <form id="apiKeyFilterForm" autocomplete="off" onsubmit="return false;">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label">User Name</label>
                                <input type="text" id="filterUserName" name="UserName" class="form-control" placeholder="Search by user name" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Key Id</label>
                                <input type="text" id="filterId" name="Id" class="form-control" placeholder="Search by key id" />
                            </div>
                        </div>

                        <!-- Full width buttons -->
                        <div class="row mt-2">
                            <div class="col-md-12 d-flex">
                                <button id="applyApiKeyFilterBtn" type="button" class="btn btn-primary me-2 w-100" onclick="applyApiKeyFilter()">
                                    <i class="mdi mdi-magnify"></i> Apply Filter
                                </button>
                                <button id="resetApiKeyFilterBtn" type="button" class="btn btn-secondary me-2 w-100" onclick="resetApiKeyFilter()">
                                    <i class="mdi mdi-refresh"></i> Reset
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Data Table Card -->
        <div class="card">
            <div class="card-body">
               
                <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> API Keys List</h5>
                <div class="table-responsive">
                    <table id="apiKeysTable" class="table table-striped table-hover table-bordered" style="width:100%">
                        <colgroup>
                            <col style="width:16%" />
                            <col style="width:16%" />
                            <col style="width:13%" />
                            <col style="width:15%" />
                            <col style="width:15%" />
                               <col style="width:10%" />
                            <col style="width:15%" />
                        </colgroup>

                        <thead class="table-light">
                            <tr>
                                <th>User Name</th>
                                <th>Key Prefix</th>
                                <th>Created At</th>
                                <th>Expiration Date</th>
                                <th>Modified Date</th>
                                <th>Status</th>
                               <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="apiKeysTbody">
                            <!-- Server-rendered initial content -->
                            @Html.Partial("_ApiKeyRows", Model)
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-1">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><!-- AJAX injects here --></div>
            @*<div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>*@
        </div>
    </div>
</div>

<script>
    // ---------- Configuration: use your existing endpoints ----------
    const API_ENDPOINTS = {
        getByUserName: '/APIKey/GetByUserName',     
        initializeData: '/APIKey/InitializeData'  
    };

    // Basic HTML-escape helpers
    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return String(text).replace(/[&<>"'`]/g, function (s) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;' })[s];
        });
    }

    function escapeHtmlAttr(text) {
        return escapeHtml(text).replace(/"/g, '&quot;');
    }

    // Utility: render a single table row (returns DOM tr element)
    function populateRow(item) {
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', item.Id || '');

        const expirationClass = (new Date(item.ExpirationDate) < new Date()) ? 'text-danger' : 'text-success';
        const statusBadge = item.RevokedAt ? '<span class="badge bg-danger">Revoked</span>'
            : (!item.IsActive ? '<span class="badge bg-warning">Inactive</span>' : '<span class="badge bg-success">Active</span>');

        const activeBadge = item.IsActive ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';

        tr.innerHTML = `
        <td>${escapeHtml(item.UserName)}</td>
        <td>
            <code>${escapeHtml(item.KeyPrefix)}</code>
            <button class="btn btn-sm btn-outline-secondary ms-1 copy-prefix-btn" data-prefix="${escapeHtmlAttr(item.KeyPrefix)}" data-bs-toggle="tooltip" title="Copy Prefix">
                <i class="mdi mdi-content-copy"></i>
            </button>
        </td>
        <td>${escapeHtml(formatDate(item.CreatedAt))}</td>
        <td><span class="${expirationClass}">${escapeHtml(formatDate(item.ExpirationDate))}</span></td>
        <td>${escapeHtml(formatDate(item.ModifiedDate))}</td>
        <td>${statusBadge}</td>
        <td>${activeBadge}</td>
        <td>
            <div class="dropdown">
                <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="mdi mdi-cog-outline"></i> Actions
                </button>
                <ul class="dropdown-menu">
                    <li><button class="dropdown-item" onclick="showDetails('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><button class="dropdown-item" onclick="showRenew('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-calendar-refresh me-1 text-warning"></i> Renew</button></li>
                    <li>
                        ${item.IsActive
                ? '<button class="dropdown-item" onclick="showChangeStatus(\'' + escapeHtmlAttr(item.Id) + '\')"><i class="mdi mdi-toggle-switch-off me-1 text-secondary"></i> Deactivate</button>'
                : '<button class="dropdown-item" onclick="showChangeStatus(\'' + escapeHtmlAttr(item.Id) + '\')"><i class="mdi mdi-toggle-switch me-1 text-success"></i> Activate</button>'
            }
                    </li>
                    <li><button class="dropdown-item text-danger" onclick="showRevoke('${escapeHtmlAttr(item.Id)}')"><i class="mdi mdi-key-remove me-1 text-danger"></i> Revoke</button></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><button class="dropdown-item text-danger" onclick="deleteApiKey('${escapeHtmlAttr(item.Id)}','${escapeHtmlAttr(item.UserName)}')"><i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button></li>
                </ul>
            </div>
        </td>
    `;
        return tr;
    }

    // Format date for display
    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleString();
    }

    // Render array into tbody
    function renderTable(items) {
        const tbody = document.getElementById('apiKeysTbody');
        tbody.innerHTML = ''; // clear

        if (!items || items.length === 0) {
            tbody.innerHTML = `
            <tr id="noDataRow">
                <td colspan="8" class="text-center text-muted py-4">
                    <i class="mdi mdi-key-remove mdi-48px mb-2"></i><br/>No API keys found
                </td>
            </tr>`;
            return;
        }

        const fragment = document.createDocumentFragment();
        items.forEach(i => fragment.appendChild(populateRow(i)));
        tbody.appendChild(fragment);

        // re-initialize tooltips & copy buttons for new elements
        initTooltipsAndCopy();
    }

    // Initialize tooltips and attach copy handlers
    function initTooltipsAndCopy() {
        // bootstrap tooltip init (if bootstrap 5)
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // copy buttons
        document.querySelectorAll('.copy-prefix-btn').forEach(btn => {
            btn.removeEventListener('click', copyToClipboardWrapped);
            btn.addEventListener('click', copyToClipboardWrapped);
        });
    }

    // wrapper to provide event to copyToClipboard
    function copyToClipboardWrapped(e) {
        const prefix = e.currentTarget.getAttribute('data-prefix') || '';
        copyToClipboard(prefix, e);
    }

    // copyToClipboard updated to accept event and text
    function copyToClipboard(text, evt) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(function () {
            // Show success feedback on the specific button
            const btn = evt.currentTarget;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="mdi mdi-check"></i>';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1000);
        }).catch(() => {
            // optionally show failure
        });
    }

    // ---------- Generic Loader Integration ----------
    // Based on your existing system, these functions should work with your generic loader

    function showLoader(message = 'Loading...') {
        // Use your existing loader system
        if (typeof showLoading === 'function') {
            showLoading(message);
        } else if (typeof appalert === 'function') {
            // Show a loading alert or use your system's loader
            console.log('Loading: ' + message);
        } else {
            // Fallback - show browser native loading
            console.log('Loading: ' + message);
        }
    }

    function hideLoader() {
        // Use your existing loader system
        if (typeof hideLoading === 'function') {
            hideLoading();
        } else if (typeof appalert === 'function') {
            // Hide loading if your system supports it
        } else {
            // Fallback
            console.log('Loading complete');
        }
    }

    // Enhanced loading state for buttons
    function setButtonLoading(button, isLoading) {
        if (!button) return;

        if (isLoading) {
            button.disabled = true;
            const originalText = button.innerHTML;
            button.setAttribute('data-original-text', originalText);
            button.innerHTML = '<i class="mdi mdi-loading mdi-spin"></i> Loading...';
        } else {
            button.disabled = false;
            const originalText = button.getAttribute('data-original-text');
            if (originalText) {
                button.innerHTML = originalText;
            }
        }
    }

    // ---------- Filter actions ----------
    async function applyApiKeyFilter() {
        const username = document.getElementById('filterUserName').value.trim();
        const id = document.getElementById('filterId').value.trim();
        const applyBtn = document.getElementById('applyApiKeyFilterBtn');
        const resetBtn = document.getElementById('resetApiKeyFilterBtn');

        setButtonLoading(applyBtn, true);
        setButtonLoading(resetBtn, true);
        showLoader('Applying filters...');

        try {
            // Case 1: no filters => load all data via InitializeData
            if (!username && !id) {
                await loadAllApiKeys();
                return;
            }

            // Case 2: username only => call GetByUserName
            if (username && !id) {
                const resp = await fetch(`${API_ENDPOINTS.getByUserName}?userName=${encodeURIComponent(username)}`);
                const json = await resp.json();
                if (json && json.success && Array.isArray(json.data)) {
                    renderTable(json.data);
                } else {
                    renderTable([]);
                }
                return;
            }

            // Case 3: id only => get single item and render as array
            if (id && !username) {
                // Use InitializeData to get single item
                const url = `${API_ENDPOINTS.initializeData}?KEY=${encodeURIComponent(id)}&partialView=_ApiKeyRows`;
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) throw new Error('Failed to load key data');
                const html = await resp.text();

                // Replace the tbody content with the HTML response
                document.getElementById('apiKeysTbody').innerHTML = html;
                initTooltipsAndCopy();
                return;
            }

            // Case 4: both username & id => get both and merge
            const [userResp, idResp] = await Promise.all([
                fetch(`${API_ENDPOINTS.getByUserName}?userName=${encodeURIComponent(username)}`),
                fetch(`${API_ENDPOINTS.initializeData}?KEY=${encodeURIComponent(id)}&partialView=_ApiKeyRows`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
            ]);

            const userJson = await userResp.json();
            const idHtml = await idResp.text();

            const userItems = (userJson && userJson.success && Array.isArray(userJson.data)) ? userJson.data : [];

            // Parse the HTML response to extract the single item
            const parser = new DOMParser();
            const doc = parser.parseFromString(idHtml, 'text/html');
            const idTr = doc.querySelector('tr[data-id]');

            let mergedItems = [...userItems];

            // If we found a TR element in the HTML response, extract data and add to merged items
            if (idTr) {
                const idFromTr = idTr.getAttribute('data-id');
                // Check if this item is already in userItems
                const exists = userItems.some(item => item.Id === idFromTr);
                if (!exists) {
                    // You would need to extract the data from the TR or make another API call
                    // For now, we'll just use the userItems
                }
            }

            renderTable(mergedItems);

        } catch (err) {
            console.error('Error applying filter:', err);
            if (typeof appalert === 'function') {
                appalert('Error applying filters: ' + err.message, 0, 1);
            } else {
                alert('Error applying filters: ' + err.message);
            }
            // Fallback to loading all data
            await loadAllApiKeys();
        } finally {
            setButtonLoading(applyBtn, false);
            setButtonLoading(resetBtn, false);
            hideLoader();
        }
    }

    // Load all API keys
    async function loadAllApiKeys() {
        showLoader('Loading API keys...');
        try {
            const url = `${API_ENDPOINTS.initializeData}?path=list&partialView=_ApiKeyRows`;
            const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!resp.ok) throw new Error('Failed to load API keys');
            const html = await resp.text();
            document.getElementById('apiKeysTbody').innerHTML = html;
            initTooltipsAndCopy();
        } catch (err) {
            console.error('Error loading API keys:', err);
            renderTable([]);
            if (typeof appalert === 'function') {
                appalert('Error loading API keys: ' + err.message, 0, 1);
            }
        } finally {
            hideLoader();
        }
    }

    // Reset inputs and reload full list
    function resetApiKeyFilter() {
        document.getElementById('filterUserName').value = '';
        document.getElementById('filterId').value = '';
        loadAllApiKeys();
    }

    // Action functions - Updated to load partial views with loader
    async function showDetails(id) {
        showLoader('Loading details...');
        try {
            const url = `/APIKey/InitializeData?KEY=${encodeURIComponent(id)}&path=details&partialView=_Details`;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) throw new Error('Failed to load details');
            const html = await response.text();

            // Inject into modal and show
            const modalBody = document.querySelector('#affiliateDetailsModal .modal-body');
            modalBody.innerHTML = html;

            const modal = new bootstrap.Modal(document.getElementById('affiliateDetailsModal'));
            modal.show();

        } catch (error) {
            console.error('Error loading details:', error);
            if (typeof appalert === 'function') {
                appalert('Failed to load API key details: ' + error.message, 0, 1);
            } else {
                alert('Failed to load API key details: ' + error.message);
            }
        } finally {
            hideLoader();
        }
    }

    async function showRenew(id) {
        showLoader('Loading renew form...');
        try {
            const url = `/APIKey/InitializeData?KEY=${encodeURIComponent(id)}&path=renew&partialView=_Renew`;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) throw new Error('Failed to load renew form');
            const html = await response.text();

            // Inject into modal and show
            const modalBody = document.querySelector('#affiliateDetailsModal .modal-body');
            modalBody.innerHTML = html;

            const modal = new bootstrap.Modal(document.getElementById('affiliateDetailsModal'));
            modal.show();

        } catch (error) {
            console.error('Error loading renew form:', error);
            if (typeof appalert === 'function') {
                appalert('Failed to load renew form: ' + error.message, 0, 1);
            } else {
                alert('Failed to load renew form: ' + error.message);
            }
        } finally {
            hideLoader();
        }
    }

    async function showChangeStatus(id) {
        showLoader('Loading status form...');
        try {
            const url = `/APIKey/InitializeData?KEY=${encodeURIComponent(id)}&path=change-status&partialView=_ChangeStatus`;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) throw new Error('Failed to load status change form');
            const html = await response.text();

            // Inject into modal and show
            const modalBody = document.querySelector('#affiliateDetailsModal .modal-body');
            modalBody.innerHTML = html;

            const modal = new bootstrap.Modal(document.getElementById('affiliateDetailsModal'));
            modal.show();

        } catch (error) {
            console.error('Error loading status change form:', error);
            if (typeof appalert === 'function') {
                appalert('Failed to load status change form: ' + error.message, 0, 1);
            } else {
                alert('Failed to load status change form: ' + error.message);
            }
        } finally {
            hideLoader();
        }
    }

    async function showRevoke(id) {
        showLoader('Loading revoke form...');
        try {
            const url = `/APIKey/InitializeData?KEY=${encodeURIComponent(id)}&path=revoke&partialView=_Revoke`;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) throw new Error('Failed to load revoke form');
            const html = await response.text();

            // Inject into modal and show
            const modalBody = document.querySelector('#affiliateDetailsModal .modal-body');
            modalBody.innerHTML = html;

            const modal = new bootstrap.Modal(document.getElementById('affiliateDetailsModal'));
            modal.show();

        } catch (error) {
            console.error('Error loading revoke form:', error);
            if (typeof appalert === 'function') {
                appalert('Failed to load revoke form: ' + error.message, 0, 1);
            } else {
                alert('Failed to load revoke form: ' + error.message);
            }
        } finally {
            hideLoader();
        }
    }

    async function deleteApiKey(id, userName) {
        if (confirm(`Are you sure you want to delete API key for user "${userName}"? This action cannot be undone.`)) {
            showLoader('Deleting API key...');
            try {
                const response = await fetch(`/APIKey/Delete?KEY=${encodeURIComponent(id)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const result = await response.json();

                if (result.success) {
                    if (typeof appalert === 'function') {
                        appalert('API key deleted successfully!', 3, 1);
                    } else {
                        alert('API key deleted successfully!');
                    }
                    // Reload the table
                    await loadAllApiKeys();
                } else {
                    if (typeof appalert === 'function') {
                        appalert('Failed to delete API key: ' + result.message, 0, 1);
                    } else {
                        alert('Failed to delete API key: ' + result.message);
                    }
                }
            } catch (error) {
                console.error('Error deleting API key:', error);
                if (typeof appalert === 'function') {
                    appalert('Error deleting API key: ' + error.message, 0, 1);
                } else {
                    alert('Error deleting API key: ' + error.message);
                }
            } finally {
                hideLoader();
            }
        }
    }

    // Global form submit handler
    function handleFormSubmit(form, successMessage) {
        event.preventDefault();

        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');

        // Show loader for form submission
        showLoader('Processing request...');
        setButtonLoading(submitBtn, true);

        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    if (typeof appalert === 'function') {
                        appalert(successMessage, 1, 1);
                    } else {
                        alert(successMessage);
                    }
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('affiliateDetailsModal'));
                    if (modal) modal.hide();
                    // Reload table
                    loadAllApiKeys();
                } else {
                    if (typeof appalert === 'function') {
                        appalert('Operation failed: ' + result.message, 0, 1);
                    } else {
                        alert('Operation failed: ' + result.message);
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                if (typeof appalert === 'function') {
                    appalert('An error occurred while processing your request: ' + error.message, 0, 1);
                } else {
                    alert('An error occurred while processing your request: ' + error.message);
                }
            })
            .finally(() => {
                // Restore button state and hide loader
                setButtonLoading(submitBtn, false);
                hideLoader();
            });

        return false;
    }

    // on page load - ensure tooltips and copy buttons bind
    document.addEventListener('DOMContentLoaded', function () {
        initTooltipsAndCopy();
    });
</script>