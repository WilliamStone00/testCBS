@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.CreateApiKeyRequest
@{
    ViewBag.Title = "API Key Management - Create";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-key-chain me-2"></i>API Key Management
                </h1>
                <p class="card-text">
                    Manage and secure your API keys for system integration and external access.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Create, renew, revoke, and monitor your API keys with comprehensive security controls.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> API Key Creation Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseApiKeyTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseApiKeyTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-account-outline text-success me-2"></i>
                    <strong>User Name:</strong> Associate API keys with specific users for better tracking and management.
                </li>
                <li>
                    <i class="mdi mdi-key-star text-info me-2"></i>
                    <strong>Key Security:</strong> Store API keys securely and never expose them in client-side code.
                </li>
                <li>
                    <i class="mdi mdi-calendar-clock text-warning me-2"></i>
                    <strong>Expiration:</strong> API keys are created with 5-year expiration by default.
                </li>
                <li>
                    <i class="mdi mdi-shield-account text-primary me-2"></i>
                    <strong>Key Length:</strong> Choose appropriate key length (32-256 characters) based on security requirements.
                </li>
                <li>
                    <i class="mdi mdi-alert-octagon text-danger me-2"></i>
                    <strong>Save Securely:</strong> Copy and store the raw key immediately after creation - it won't be shown again.
                </li>
                <li>
                    <i class="mdi mdi-content-save text-secondary me-2"></i>
                    <strong>Management:</strong> Use the list view to manage existing keys, renew, revoke, or change status.
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Create Form -->
<div class="card shadow p-3 mb-4">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("List", "ApiKey")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="View API Keys List">
                <i class="mdi mdi-view-list mdi-18px"></i> View List
            </a>
        </div>
    </div>

    <div class="card-body">
        <h5 class="text-primary mb-3"><i class="mdi mdi-key-plus me-2"></i>Create New API Key</h5>

        <form id="createApiKeyForm" method="post" action="@Url.Action("Create", "ApiKey")"
              onsubmit="return handleFormSubmit(this, 'API Key created successfully!')">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="UserName" class="form-label fw-semibold">Select User</label>
                        @Html.DropDownListFor(m => m.UserName,
                            new SelectList(ViewBag.thirdparty ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select User ---",
                            new { @class = "form-select select2", id = "UserName" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="Length" class="form-label fw-semibold">Key Length (32-256)</label>
                        @Html.TextBoxFor(m => m.Length, new { @class = "form-control", type = "number", min = "32", max = "256", value = "64", placeholder = "Key Length", id = "Length" })
                        @Html.ValidationMessageFor(m => m.Length, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <!-- Generated Key Display Area (Initially Hidden) - Placed below the input fields -->
            <div id="generatedKeySection" class="alert alert-success d-none mb-4 mt-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <h6 class="alert-heading mb-2">
                            <i class="mdi mdi-key-success me-1"></i>API Key Generated Successfully!
                        </h6>
                        <p class="mb-2 text-muted small">Copy this key now - it won't be shown again:</p>
                        <div class="input-group">
                            <input type="text" id="generatedApiKey" class="form-control font-monospace" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="copyApiKeyBtn" data-bs-toggle="tooltip" title="Copy to clipboard">
                                <i class="mdi mdi-content-copy"></i>
                            </button>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="mdi mdi-alert-circle-outline me-1"></i>
                                Store this key securely. You won't be able to retrieve it again.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="mdi mdi-key-plus me-1"></i> Create API Key
                </button>
                <button type="reset" class="btn btn-light" onclick="resetForm()">Reset</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // handleFormSubmit: posts the form and uses appalert(...) for user messages.
        // Usage: <form onsubmit="return handleFormSubmit(this, 'Created successfully')">
        async function handleFormSubmit(form, successMessage) {
            event.preventDefault();
            if (!form) return false;

            const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            const origBtnHtml = submitBtn ? (submitBtn.innerHTML || '') : null;

            try {
                // disable submit button & show spinner text
                if (submitBtn) {
                    submitBtn.disabled = true;
                    try { submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...'; } catch (e) { }
                }

                // Convert FormData to object for jQuery
                const formData = new FormData(form);
                const data = {};
                for (let [key, value] of formData.entries()) {
                    data[key] = value;
                }

                // Use jQuery AJAX instead of fetch
                const response = await $.ajax({
                    url: form.action,
                    type: form.method || 'POST',
                    data: data,
                    dataType: 'json',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response && response.success) {
                    // If rawKey exists, display it in the key section
                    if (response.data && response.data.rawKey) {
                        const rawKey = response.data.rawKey;

                        // Display the generated key section
                        displayGeneratedKey(rawKey, response.message || successMessage);

                        // Don't reset the form - keep the user and length values visible
                        // The form stays as-is so user can create another key if needed
                    } else {
                        // Fallback if no raw key
                        appalert(successMessage || response.message || 'Operation successful', 1, 1);
                    }
                } else {
                    // server-side validation / error - show error via appalert state "danger" (use 0 or other)
                    const msg = (response && response.message) ? response.message : 'Unknown error';
                    appalert('Error: ' + msg, 0, 1);
                }
            } catch (error) {
                console.error('handleFormSubmit error', error);
                let errMsg = 'An error occurred';

                // Handle jQuery AJAX error format
                if (error.responseJSON && error.responseJSON.message) {
                    errMsg = error.responseJSON.message;
                } else if (error.statusText) {
                    errMsg = error.statusText;
                } else if (error.message) {
                    errMsg = error.message;
                }

                appalert('Error: ' + errMsg, 0, 1);
            } finally {
                // restore submit button
                if (submitBtn) {
                    submitBtn.disabled = false;
                    try { submitBtn.innerHTML = origBtnHtml; } catch (e) { }
                }
            }

            return false;
        }

        // Function to display the generated key
        function displayGeneratedKey(rawKey, message) {
            const keySection = document.getElementById('generatedKeySection');
            const keyInput = document.getElementById('generatedApiKey');
            const copyBtn = document.getElementById('copyApiKeyBtn');

            // Update the key value
            keyInput.value = rawKey;

            // Show the section
            keySection.classList.remove('d-none');
            keySection.classList.add('d-block');

            // Update the message in the alert header
            const alertHeading = keySection.querySelector('.alert-heading');
            if (alertHeading && message) {
                alertHeading.innerHTML = `<i class="mdi mdi-key-success me-1"></i>${message}`;
            }

            // Scroll to the key section
            keySection.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Auto-select the key text for easy copying
            keyInput.select();

            // Show success message
            appalert('API Key created successfully! Copy and store the key securely.', 1, 1);
        }

        // Copy key functionality
        document.getElementById('copyApiKeyBtn').addEventListener('click', function () {
            const keyInput = document.getElementById('generatedApiKey');
            keyInput.select();

            try {
                navigator.clipboard.writeText(keyInput.value).then(function () {
                    // Show success feedback
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="mdi mdi-check"></i>';
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-success');

                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                        this.classList.remove('btn-success');
                        this.classList.add('btn-outline-secondary');
                    }, 2000);

                    appalert('API key copied to clipboard!', 1, 1);
                }.bind(this));
            } catch (err) {
                appalert('Failed to copy to clipboard. Please copy manually.', 0, 1);
            }
        });

        // Reset form function
        function resetForm() {
            const form = document.getElementById('createApiKeyForm');
            const keySection = document.getElementById('generatedKeySection');

            // Hide the key section but keep the form visible
            keySection.classList.add('d-none');
            keySection.classList.remove('d-block');

            // Reset the form values
            form.reset();
        }

        // Tooltip initialization (Bootstrap)
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });

                // Initialize copy button event listener
                document.getElementById('copyApiKeyBtn').addEventListener('click', function () {
                    const keyInput = document.getElementById('generatedApiKey');
                    keyInput.select();

                    try {
                        navigator.clipboard.writeText(keyInput.value).then(function () {
                            // Show success feedback
                            const originalHtml = this.innerHTML;
                            this.innerHTML = '<i class="mdi mdi-check"></i>';
                            this.classList.remove('btn-outline-secondary');
                            this.classList.add('btn-success');

                            setTimeout(() => {
                                this.innerHTML = originalHtml;
                                this.classList.remove('btn-success');
                                this.classList.add('btn-outline-secondary');
                            }, 2000);

                            appalert('API key copied to clipboard!', 1, 1);
                        }.bind(this));
                    } catch (err) {
                        appalert('Failed to copy to clipboard. Please copy manually.', 0, 1);
                    }
                });
            } catch (err) {
                console.warn('Tooltip init failed', err);
            }
        });
    </script>
}