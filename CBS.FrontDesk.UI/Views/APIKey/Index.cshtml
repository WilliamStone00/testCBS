@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.CreateApiKeyRequest
    @using Resources
@{
    ViewBag.Title = "API Key Management - Create";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-key-chain me-2"></i>@ApiKeyRessource.API_Key_Management
                </h1>
                <p class="card-text">
                    @ApiKeyRessource.Manage_and_secure_your_API_keys_for_system_integration_and_external_access.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @ApiKeyRessource.Create_renew_revoke_and_monitor_your_API_keys_with_comprehensive_security_controls.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @ApiKeyRessource.API_Key_Creation_Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseApiKeyTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseApiKeyTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-account-outline text-success me-2"></i>
                    <strong>@GlobalShared.User_Name:</strong> @ApiKeyRessource.Associate_API_keys_with_specific_users_for_better_tracking_and_management.
                </li>
                <li>
                    <i class="mdi mdi-key-star text-info me-2"></i>
                    <strong>@GlobalShared.Key_Security:</strong> @ApiKeyRessource.Store_API_keys_securely_and_never_expose_them_in_client_side_code.
                </li>
                <li>
                    <i class="mdi mdi-calendar-clock text-warning me-2"></i>
                    <strong>@GlobalShared.Expiration:</strong> @ApiKeyRessource.API_keys_are_created_with_5_year_expiration_by_default.
                </li>
                <li>
                    <i class="mdi mdi-shield-account text-primary me-2"></i>
                    <strong>@ApiKeyRessource.Key_Length:</strong> @ApiKeyRessource.Choose_appropriate_key_length_32_256_characters_based_on_security_requirements.
                </li>
                <li>
                    <i class="mdi mdi-alert-octagon text-danger me-2"></i>
                    <strong>@GlobalShared.Save_Securely:</strong> @ApiKeyRessource.Copy_and_store_the_raw_key_immediately_after_creation_it_wont_be_shown_again.
                </li>
                <li>
                    <i class="mdi mdi-content-save text-secondary me-2"></i>
                    <strong>@GlobalShared.Management:</strong> @ApiKeyRessource.Use_the_list_view_to_manage_existing_keys_renew_revoke_or_change_status.
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Create Form -->
<div class="card shadow p-3 mb-4">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <!-- New Developer Guide Button -->
            <button type="button"
                    class="btn btn-info btn-sm me-2"
                    id="btnDeveloperGuide"
                    data-bs-toggle="tooltip"
                    title="@ApiKeyRessource.View_API_Integration_Guide">
                <i class="mdi mdi-book-open-page-variant mdi-18px"></i> @ApiKeyRessource.Developer_Guide
            </button>

            <a href="@Url.Action("List", "ApiKey")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="View API Keys List">
                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
            </a>
        </div>
    </div>

    <div class="card-body">
        <h5 class="text-primary mb-3"><i class="mdi mdi-key-plus me-2"></i>@ApiKeyRessource.Create_New_API_Key</h5>

        <form id="createApiKeyForm" method="post" action="@Url.Action("Create", "ApiKey")"
              onsubmit="return handleFormSubmit(this, 'API Key created successfully!')">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="UserName" class="form-label fw-semibold">@GlobalShared.Select_User</label>
                        @Html.DropDownListFor(m => m.UserName,
                            new SelectList(ViewBag.thirdparty ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- Select User ---",
                            new { @class = "form-select select2", id = "UserName" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="Length" class="form-label fw-semibold">@ApiKeyRessource.Key_Length (32-256)</label>
                        @Html.TextBoxFor(m => m.Length, new { @class = "form-control", type = "number", min = "32", max = "256", value = "64", placeholder = "Key Length", id = "Length" })
                        @Html.ValidationMessageFor(m => m.Length, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <!-- Generated Key Display Area (Initially Hidden) - Placed below the input fields -->
            <div id="generatedKeySection" class="alert alert-success d-none mb-4 mt-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <h6 class="alert-heading mb-2">
                            <i class="mdi mdi-key-success me-1"></i>@ApiKeyRessource.API_Key_Generated_Successfully!
                        </h6>
                        <p class="mb-2 text-muted small">@ApiKeyRessource.Copy_this_key_now_it_wont_be_shown_again:</p>
                        <div class="input-group">
                            <input type="text" id="generatedApiKey" class="form-control font-monospace" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="copyApiKeyBtn" data-bs-toggle="tooltip" title="Copy to clipboard">
                                <i class="mdi mdi-content-copy"></i>
                            </button>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="mdi mdi-alert-circle-outline me-1"></i>
                                @ApiKeyRessource.Store_this_key_securely_You_wont_be_able_to_retrieve_it_again.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="mdi mdi-key-plus me-1"></i> @ApiKeyRessource.Create_API_Key
                </button>
                <button type="reset" class="btn btn-light" onclick="resetForm()">@GlobalShared.Reset</button>
            </div>
        </form>
    </div>
</div>

<!-- Developer Guide Modal -->
<div class="modal fade" id="developerGuideModal" tabindex="-1" aria-labelledby="developerGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-white text-black">

                <button type="button" class="btn-close btn-close-Black" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div id="developerGuideContent">
                    <!-- Partial view content will be loaded here -->
                    @Html.Partial("_ApiIntegrationGuide")
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
                <button type="button" class="btn btn-primary" onclick="printDeveloperGuide()">
                    <i class="mdi mdi-printer me-1"></i> @GlobalShared.Print_Guide
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Store the generated API key globally
        let currentApiKey = '';

        // Initialize Developer Guide Button
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize tooltips
            try {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            } catch (err) {
                console.warn('Tooltip init failed', err);
            }

            // Developer Guide Button Event Listener
            document.getElementById('btnDeveloperGuide').addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('developerGuideModal'));

                // Load partial view via AJAX with the current API key
                const guideContent = document.getElementById('developerGuideContent');
                const apiKey = currentApiKey || 'your-generated-api-key-here';

                $.get('@Url.Action("GetApiGuide", "ApiKey")', { apiKey: apiKey }, function(data) {
                    guideContent.innerHTML = data;
                }).fail(function() {
                    guideContent.innerHTML = '<div class="alert alert-danger">Failed to load guide content.</div>';
                });

                modal.show();
            });

            // Copy key functionality
            document.getElementById('copyApiKeyBtn').addEventListener('click', function () {
                const keyInput = document.getElementById('generatedApiKey');
                keyInput.select();

                try {
                    navigator.clipboard.writeText(keyInput.value).then(function () {
                        const originalHtml = this.innerHTML;
                        this.innerHTML = '<i class="mdi mdi-check"></i>';
                        this.classList.remove('btn-outline-secondary');
                        this.classList.add('btn-success');

                        setTimeout(() => {
                            this.innerHTML = originalHtml;
                            this.classList.remove('btn-success');
                            this.classList.add('btn-outline-secondary');
                        }, 2000);

                        appalert('API key copied to clipboard!', 1, 1);
                    }.bind(this));
                } catch (err) {
                    appalert('Failed to copy to clipboard. Please copy manually.', 0, 1);
                }
            });
        });

        // Function to display the generated key
        function displayGeneratedKey(rawKey, message) {
            const keySection = document.getElementById('generatedKeySection');
            const keyInput = document.getElementById('generatedApiKey');
            const copyBtn = document.getElementById('copyApiKeyBtn');

            keyInput.value = rawKey;
            keySection.classList.remove('d-none');
            keySection.classList.add('d-block');

            // Store the API key globally
            currentApiKey = rawKey;

            const alertHeading = keySection.querySelector('.alert-heading');
            if (alertHeading && message) {
                alertHeading.innerHTML = `<i class="mdi mdi-key-success me-1"></i>${message}`;
            }

            keySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            keyInput.select();
            appalert('API Key created successfully! Copy and store the key securely.', 1, 1);
        }

        // Print Developer Guide
        function printDeveloperGuide() {
            const printContent = document.getElementById('developerGuideContent').innerHTML;
            const originalContent = document.body.innerHTML;

            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;

            // Re-initialize the modal
            const modal = new bootstrap.Modal(document.getElementById('developerGuideModal'));
        }

        // handleFormSubmit function (existing functionality)
        async function handleFormSubmit(form, successMessage) {
            event.preventDefault();
            if (!form) return false;

            const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            const origBtnHtml = submitBtn ? (submitBtn.innerHTML || '') : null;

            try {
                if (submitBtn) {
                    submitBtn.disabled = true;
                    try { submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...'; } catch (e) { }
                }

                const formData = new FormData(form);
                const data = {};
                for (let [key, value] of formData.entries()) {
                    data[key] = value;
                }

                const response = await $.ajax({
                    url: form.action,
                    type: form.method || 'POST',
                    data: data,
                    dataType: 'json',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response && response.success) {
                    if (response.data && response.data.rawKey) {
                        const rawKey = response.data.rawKey;
                        displayGeneratedKey(rawKey, response.message || successMessage);
                    } else {
                        appalert(successMessage || response.message || 'Operation successful', 1, 1);
                    }
                } else {
                    const msg = (response && response.message) ? response.message : 'Unknown error';
                    appalert('Error: ' + msg, 0, 1);
                }
            } catch (error) {
                console.error('handleFormSubmit error', error);
                let errMsg = 'An error occurred';

                if (error.responseJSON && error.responseJSON.message) {
                    errMsg = error.responseJSON.message;
                } else if (error.statusText) {
                    errMsg = error.statusText;
                } else if (error.message) {
                    errMsg = error.message;
                }

                appalert('Error: ' + errMsg, 0, 1);
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    try { submitBtn.innerHTML = origBtnHtml; } catch (e) { }
                }
            }

            return false;
        }

        // Reset form function
        function resetForm() {
            const form = document.getElementById('createApiKeyForm');
            const keySection = document.getElementById('generatedKeySection');

            keySection.classList.add('d-none');
            keySection.classList.remove('d-block');
            form.reset();
            currentApiKey = '';
        }
    </script>
}