@{
    Layout = null;
    string apiKey = ViewBag.ApiKey ?? "your-generated-api-key-here";
}
@using Resources
<div class="api-key-usage-guide">
    <style>
        .api-key-usage-guide h2 {
            color: #34495e;
            margin-top: 25px;
            padding-bottom: 5px;
            border-bottom: 1px solid #bdc3c7;
        }

        .api-key-usage-guide h3 {
            color: #2c3e50;
            margin-top: 20px;
        }

        .api-key-usage-guide .code-block {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 5px;
            padding: 15px;
            margin: 10px 0;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            white-space: pre-wrap;
        }

        .api-key-usage-guide .info-box {
            background: #d1ecf1;
            border: 1px solid #bee5eb;
            border-radius: 5px;
            padding: 15px;
            margin: 15px 0;
        }

        .api-key-usage-guide .warning-box {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 5px;
            padding: 15px;
            margin: 15px 0;
        }

        .api-key-usage-guide table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }

        .api-key-usage-guide th {
            background: #3498db;
            color: white;
            padding: 10px;
            text-align: left;
        }

        .api-key-usage-guide td {
            padding: 10px;
            border: 1px solid #ddd;
        }

        .api-key-usage-guide tr:nth-child(even) {
            background: #f8f9fa;
        }

        .api-key-usage-guide .step {
            background: #e8f4fd;
            border-left: 4px solid #3498db;
            padding: 10px 15px;
            margin: 10px 0;
        }

        .api-key-usage-guide ul {
            padding-left: 20px;
        }

        .api-key-usage-guide li {
            margin-bottom: 8px;
        }

        .api-key-display {
            background: #e8f5e8;
            border: 2px solid #4caf50;
            border-radius: 5px;
            padding: 10px;
            margin: 10px 0;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            color: #2e7d32;
        }
    </style>

    <div class="card bg-light mb-2">
        <div class="card-body text-center">
            <h1 class="card-title text-primary">
                📚 @ApiKeyRessource.API_Key_Usage_Guide
            </h1>
            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
        </div>
    </div>

    <!-- Display current API key if available -->
    @if (apiKey != "your-generated-api-key-here")
    {
        <div class="alert alert-success">
            <h5><i class="mdi mdi-key me-2"></i>@ApiKeyRessource.Your_Current_API_Key</h5>
            <div class="api-key-display">
                @apiKey
            </div>
            <small class="text-muted">
                <i class="mdi mdi-information-outline me-1"></i>
                @ApiKeyRessource.This_key_will_be_used_in_the_examples_below_Store_it_securely!
            </small>
        </div>
    }

    <div class="info-box">
        <strong>🚀 @GlobalShared.Quick_Start:</strong> @ApiKeyRessource.This_guide_explains_how_to_properly_use_your_API_key_for_authentication_and_integration_with_our_services.
    </div>

    <h2>1. Getting Your API Key</h2>
    <div class="step">
        <strong>@GlobalShared.Step 1:</strong>@ApiKeyRessource.Create_an_API_key_using_the_form_above_by_selecting_a_user_and_specifying_key_length
    </div>
    <div class="step">
        <strong>@GlobalShared.Step 2:</strong> @ApiKeyRessource.Copy_and_securely_store_your_API_key_immediately_after_generation_it_wont_be_shown_again
    </div>
    <div class="step">
        <strong>@GlobalShared.Step 3:</strong> @ApiKeyRessource.Use_the_API_key_in_your_authentication_headers_as_shown_below
    </div>

    <h2>2. @ApiKeyRessource.Authentication_Header</h2>
    <div class="warning-box">
        <strong>🔐 @ApiKeyRessource.Security_Notice:</strong> @ApiKeyRessource.Your_API_key_provides_full_access_to_your_account_Keep_it_secure_and_never_expose_it_in_client_side_code.
    </div>

    <p>@ApiKeyRessource.Include_this_header_in_every_API_request:</p>
    <div class="code-block">H-TSC-API-KEY: @apiKey</div>

    <h2>3. @ApiKeyRessource.API_Endpoint</h2>
    <table>
        <tr><th>Method</th><th>URL</th><th>Purpose</th></tr>
        <tr><td>POST</td><td><code>/api/external-auth/authorize</code></td><td>@ApiKeyRessource.Authenticate_and_receive_session_token</td></tr>
    </table>

    <h2>4. Making API Requests</h2>

    <h3>Request Headers</h3>
    <div class="code-block">
        H-TSC-API-KEY: @apiKey
        Content-Type: application/json
    </div>

    <h3>Request Body (JSON)</h3>
    <div class="code-block">
        {
        "userName": "your-username@example.com",
        "password": "your-password",
        "geoLocationResponse": {
        "ip": "197.210.46.1",
        "city": "Douala",
        "region": "Littoral",
        "country": "Cameroon",
        "loc": "4.0511,9.7679",
        "org": "Your Organization",
        "timezone": "Africa/Douala"
        }
        }
    </div>

    <h3>Success Response (200 OK)</h3>
    <div class="code-block">
        {
        "data": {
        "name": "your-username@example.com",
        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "statusCode": 200,
        "message": "Login successful.",
        "status": "SUCCESS"
        }
    </div>

    <h3>Error Response (401 Unauthorized)</h3>
    <div class="code-block">
        {
        "data": null,
        "errors": [],
        "statusCode": 401,
        "statusDescription": "Unauthorized.",
        "message": "Invalid or unauthorized API key.",
        "status": "FAILED"
        }
    </div>

    <h2>5. @ApiKeyRessource.API_Key_Management</h2>
    <table>
        <tr><th>@GlobalShared.Feature</th><th>@GlobalShared.Description</th></tr>
        <tr><td>@ApiKeyRessource.Key_Expiration</td><td>@ApiKeyRessource.API_keys_expire_after_5_years_configurable</td></tr>
        <tr><td>@ApiKeyRessource.Key_Rotation</td><td>@ApiKeyRessource.You_can_request_key_renewal_before_expiration</td></tr>
        <tr><td>@ApiKeyRessource.Expiration_Warning</td><td>@ApiKeyRessource.Notifications_start_30_days_before_expiry</td></tr>
        <tr><td>@ApiKeyRessource.Key_Binding</td><td>@ApiKeyRessource.Each_key_is_tied_to_a_specific_username</td></tr>
        <tr><td>@ApiKeyRessource.Key_Revocation</td><td>@ApiKeyRessource.Keys_can_be_revoked_for_security_reasons</td></tr>
        <tr><td>@ApiKeyRessource.Security_Monitoring</td><td>@ApiKeyRessource.Suspicious_activity_is_monitored_and_alerted</td></tr>
    </table>

    <h2>6. @ApiKeyRessource.Testing_Your_API_Key</h2>
    <div class="step">
        <strong>@ApiKeyRessource.Using_Postman:</strong>
    </div>
    <div class="code-block">
        1. Method: POST
        2. URL: https://yourdomain.com/api/external-auth/authorize
        3. Headers:
        - H-TSC-API-KEY: @apiKey
        - Content-Type: application/json
        4. Body (raw JSON):
        {
        "userName": "your-username",
        "password": "your-password",
        "geoLocationResponse": {
        "ip": "41.7.84.90",
        "city": "Your City",
        "region": "Your Region",
        "country": "Your Country",
        "loc": "latitude,longitude",
        "org": "Your Organization",
        "timezone": "Your/Timezone"
        }
        }
    </div>

    <h2>7. @ApiKeyRessource.Security_Best_Practices</h2>
    <div class="info-box">
        <strong>✅ @GlobalShared.DO:</strong>
        <ul>
            <li>@ApiKeyRessource.Store_API_keys_in_secure_locations</li>
            <li>@ApiKeyRessource.Use_HTTPS_for_all_API_communications</li>
            <li>@ApiKeyRessource.Monitor_your_API_usage_regularly</li>
            <li>@ApiKeyRessource.Rotate_keys_periodically_for_security</li>
            <li>@ApiKeyRessource.Use_different_keys_for_different_applications</li>
        </ul>
    </div>

    <div class="warning-box">
        <strong>❌ @GlobalShared.DON_T:</strong>
        <ul>
            <li>@ApiKeyRessource.Expose_API_keys_in_frontend_code_or_mobile_apps</li>
            <li>@ApiKeyRessource.Commit_API_keys_to_version_control (Git)</li>
            <li>@ApiKeyRessource.Share_keys_via_unsecured_channels_email_chat</li>
            <li>@ApiKeyRessource.Use_the_same_key_across_multiple_environments</li>
            <li>@ApiKeyRessource.Ignore_expiration_warnings</li>
        </ul>
    </div>

    <h2>8. @ApiKeyRessource.Troubleshooting</h2>
    <table>
        <tr><th>@GlobalShared.Issue</th><th>@GlobalShared.Solution</th></tr>
        <tr><td>401 Unauthorized</td><td>@ApiKeyRessource.Check_your_API_key_is_correct_and_active</td></tr>
        <tr><td>403 Forbidden</td><td>@ApiKeyRessource.Verify_user_permissions_and_key_binding</td></tr>
        <tr><td>Key not working</td><td>@ApiKeyRessource.Check_if_key_has_expired_or_been_revoked</td></tr>
        <tr><td>Missing header</td><td>@ApiKeyRessource.Ensure_H_TSC_API_KEY_header_is_included</td></tr>
    </table>

    <h2>9. @GlobalShared.Getting_Help</h2>
    <p>@ApiKeyRessource.If_you_encounter_issues_with_your_API_key_or_need_assistance:</p>
    <table>
        <tr><th>@GlobalShared.Support_Channel</th><th>@GlobalShared.Contact_Details</th><th>@GlobalShared.Availability</th></tr>
        <tr><td>@GlobalShared.Phone</td><td>+237 650 76 84 67</td><td>Mon-Fri, 8:00 AM – 5:00 PM</td></tr>
        <tr><td>WhatsApp</td><td>+237 650 76 84 67</td><td>Mon-Fri, 8:00 AM – 5:00 PM</td></tr>
        <tr><td>@GlobalShared.Email</td><td>info@fluxcm.com</td><td>24/7 (Response within 24h)</td></tr>
    </table>

    <div class="info-box mt-4">
        <strong>📝 @GlobalShared.Important:</strong> @ApiKeyRessource.This_API_key_provides_access_to_your_account_Keep_it_secure_and_report_any_suspected_compromise_immediately.
    </div>
</div>