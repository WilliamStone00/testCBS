@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.ApiKey

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label fw-bold">ID</label>
        <div class="form-control bg-light">@Model.Id</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-bold">User Name</label>
        <div class="form-control bg-light">@Model.UserName</div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Key Prefix</label>
        <div class="input-group">
            <div class="form-control bg-light font-monospace">@Model.KeyPrefix</div>
            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@Model.KeyPrefix')">
                <i class="mdi mdi-content-copy"></i>
            </button>
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Created At</label>
        <div class="form-control bg-light">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Expiration Date</label>
        <div class="form-control bg-light @(Model.ExpirationDate < DateTime.UtcNow ? "text-danger" : "text-success")">
            @Model.ExpirationDate.ToString("yyyy-MM-dd HH:mm:ss")
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Modified Date</label>
        <div class="form-control bg-light">@Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss")</div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Status</label>
        <div class="form-control bg-light">
            @if (Model.RevokedAt.HasValue)
            {
                <span class="badge bg-danger">Revoked</span>
                <small class="text-muted ms-2">on @Model.RevokedAt.Value.ToString("yyyy-MM-dd HH:mm")</small>
            }
            else if (!Model.IsActive)
            {
                <span class="badge bg-warning">Inactive</span>
            }
            else
            {
                <span class="badge bg-success">Active</span>
            }
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">Is Active</label>
        <div class="form-control bg-light">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Yes</span>
            }
            else
            {
                <span class="badge bg-secondary">No</span>
            }
        </div>
    </div>

    @if (Model.RevokedAt.HasValue)
    {
        <div class="col-12">
            <label class="form-label fw-bold">Revocation Reason</label>
            <div class="form-control bg-light">@Model.RevocationReason</div>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Revoked By</label>
            <div class="form-control bg-light">@Model.RevokedBy</div>
        </div>
    }
</div>

<div class="modal-footer mt-3">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
</div>
