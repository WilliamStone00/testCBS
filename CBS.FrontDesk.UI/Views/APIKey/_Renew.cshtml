@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.RenewApiKeyRequest
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-key-chain me-2"></i>Renew API Key
        </h1>
        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            Extend the validity period of this API key.
        </div>

        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<form method="post" action="@Url.Action("Renew", "ApiKey")" onsubmit="return handleFormSubmit(this, 'API Key renewed successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="card mb-3">
        <div class="card-header bg-light d-flex align-items-center">
            <i class="mdi mdi-key-chain me-2 text-primary" aria-hidden="true"></i>
            <h5 class="mb-0">Renew API Key</h5>            
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <h4 class="form-label fw-bold">Renew API Key for <span class="fw-normal">@Model.UserName</span></h4>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">New Validity Period</label>

                    @* Use Html.DropDownListFor for reliable model binding *@
                    @Html.DropDownListFor(
                        m => m.newValidityPeriod,
                        new List<SelectListItem>
                        {
                            new SelectListItem { Value = "", Text = "Select Period" },
                            new SelectListItem { Value = "30.00:00:00", Text = "30 Days" },
                            new SelectListItem { Value = "90.00:00:00", Text = "90 Days" },
                            new SelectListItem { Value = "180.00:00:00", Text = "6 Months" },
                            new SelectListItem { Value = "365.00:00:00", Text = "1 Year" },
                            new SelectListItem { Value = "730.00:00:00", Text = "2 Years" },
                            new SelectListItem { Value = "1825.00:00:00", Text = "5 Years" }
                        },
                        new { @class = "form-select", required = "required" }
                    )
                    @Html.ValidationMessageFor(m => m.newValidityPeriod, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Reason for Renewal</label>
                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "3", placeholder = "Enter reason for renewing this API key...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning">
                <i class="mdi mdi-calendar-refresh me-1"></i> Renew Key
            </button>
        </div>
    </div>
</form>

