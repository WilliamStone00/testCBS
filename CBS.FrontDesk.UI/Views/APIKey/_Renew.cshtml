@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.RenewApiKeyRequest

<form method="post" action="@Url.Action("Renew", "ApiKey")"
      onsubmit="return handleFormSubmit(this, 'API Key renewed successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="alert alert-info">
        <i class="mdi mdi-information-outline me-2"></i>
        Extend the validity period of this API key.
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">New Validity Period</label>
        <select class="form-select" name="NewValidityPeriod" required>
            <option value="">Select Period</option>
            <option value="30.00:00:00">30 Days</option>
            <option value="90.00:00:00">90 Days</option>
            <option value="180.00:00:00">6 Months</option>
            <option value="365.00:00:00">1 Year</option>
            <option value="730.00:00:00">2 Years</option>
            <option value="1825.00:00:00">5 Years</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Reason for Renewal</label>
        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "3", placeholder = "Enter reason for renewing this API key...", required = "required" })
        @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">
            <i class="mdi mdi-calendar-refresh me-1"></i> Renew Key
        </button>
    </div>
</form>
