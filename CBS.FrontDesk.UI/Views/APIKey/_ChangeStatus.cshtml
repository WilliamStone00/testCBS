@model CBS.FrontDesk.Data.Entity.Accounting_V2.API.ChangeStatusRequest
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-key-chain me-2"></i>API Key Ativation/DisActivate
        </h1>
        <p class="card-text">
            Activate Or DisActivate an Api key using Api Key reference
        </p>

        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            @if (Model.IsActive)
            {
                <text>Activate this API key to allow its usage.</text>
            }
            else
            {
                <text>Deactivate this API key to temporarily prevent its usage.</text>
            }
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<form method="post" action="@Url.Action("ChangeStatus", "ApiKey")"
      onsubmit="return handleFormSubmit(this, 'API Key status updated successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.IsActive)

    <div class="card mb-3">
        <div class="card-header bg-light d-flex align-items-center">
            <i class="mdi mdi-key-chain me-2 text-primary" aria-hidden="true"></i>
            <h5 class="mb-0">Change API Key Status</h5>
            <h4 class="ms-auto text-muted">User: @Model.UserName</h4>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h4 class="form-label fw-bold">Change API Key status for: <span class="fw-normal">@Model.UserName</span></h4>
                </div>
            </div>

            @Html.HiddenFor(m => m.Id)

            <div class="mb-2">
                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.IsActive, true, new { @class = "form-check-input", id = "IsActiveTrue" })
                    <label class="form-check-label" for="IsActiveTrue">Activate</label>
                </div>

                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.IsActive, false, new { @class = "form-check-input", id = "IsActiveFalse" })
                    <label class="form-check-label" for="IsActiveFalse">Deactivate</label>
                </div>

                @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Status Change Reason *</label>
                @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "3", placeholder = "Enter reason for changing the status...", required = "required" })
                @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>

            @* Button reflects current state: if currently active -> show Deactivate (warning),
            if currently inactive -> show Activate (success) *@
            <button type="submit" class="btn @(Model.IsActive ? "btn-warning" : "btn-success")">
                <i class="mdi @(Model.IsActive ? "mdi-toggle-switch-off" : "mdi-toggle-switch") me-1"></i>
                @(Model.IsActive ? "Deactivate Key" : "Activate Key")
            </button>
        </div>
    </div>
          
</form>
