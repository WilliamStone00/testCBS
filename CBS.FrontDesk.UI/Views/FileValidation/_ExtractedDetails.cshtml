@model IEnumerable<CBS.FrontDesk.Data.Entity.ManualDailycollection.TransactionDetailDto>
@using System.Globalization
@using Resources
<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="text-primary"><i class="mdi mdi-file-document-outline me-1"></i> @GlobalFileValidation.Manual_Entry_File_Details</h3>
            <p class="text-muted mb-0">@GlobalFileValidation.Review_filter_and_inspect_the_extracted_manual_daily_collection_rows_below</p>
        </div>
    </div>

    <!-- Tips -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info small mb-0">
                <strong>@GlobalShared.Tips:</strong>
                <ul class="mb-0 ms-3">
                    <li>@GlobalFileValidation.Use_the_filters_below_to_narrow_results_Submit_will_call_the_server_and_re_render_this_partial</li>
                    <li>@Html.Raw(@GlobalFileValidation.Click_Details_to_open_row_level_information_controller_action_returns_a_partial_view)</li>
                    <li>@GlobalFileValidation.Amounts_display_with_two_decimals_dates_are_shown_in_yyyy_MM_dd_format</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filters (one input per property = 16 filters) -->
    <form method="get" class="card card-body mb-3" novalidate>
        <div class="row gx-2 gy-2">
            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.member_Branch_Code</label>
                <input type="text" name="memberBranchCode" id="memberBranchCode" class="form-control"
                       value="@(Request.QueryString["memberBranchCode"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.member_Branch_Id</label>
                <input type="text" name="memberBranchId" id="memberBranchId" class="form-control"
                       value="@(Request.QueryString["memberBranchId"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.member_Branch_Name</label>
                <input type="text" name="memberBranchName" id="memberBranchName" class="form-control"
                       value="@(Request.QueryString["memberBranchName"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Amount</label>
                <input type="number" step="0.01" name="amount" id="amount" class="form-control"
                       value="@(Request.QueryString["amount"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Member_name</label>
                <input type="text" name="memberName" id="memberName" class="form-control"
                       value="@(Request.QueryString["memberName"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Member_reference</label>
                <input type="text" name="memberReference" id="memberReference" class="form-control"
                       value="@(Request.QueryString["memberReference"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Account_Number</label>
                <input type="text" name="accountNumber" id="accountNumber" class="form-control"
                       value="@(Request.QueryString["accountNumber"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.daily_Collector_Name</label>
                <input type="text" name="dailyCollectorName" id="dailyCollectorName" class="form-control"
                       value="@(Request.QueryString["dailyCollectorName"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Upload_by</label>
                <input type="text" name="uploadBy" id="uploadBy" class="form-control"
                       value="@(Request.QueryString["uploadBy"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalFileValidation.manual_Entry_Daily_Collector_Id</label>
                <input type="text" name="manualEntryDailyCollectorId" id="manualEntryDailyCollectorId" class="form-control"
                       value="@(Request.QueryString["manualEntryDailyCollectorId"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Processing_Status</label>
                <input type="text" name="processingStatus" id="processingStatus" class="form-control"
                       value="@(Request.QueryString["processingStatus"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Treatement_Status</label>
                <input type="text" name="treatementStatus" id="treatementStatus" class="form-control"
                       value="@(Request.QueryString["treatementStatus"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Treatement_Date</label>
                <input type="date" name="treatementDate" id="treatementDate" class="form-control"
                       value="@(Request.QueryString["treatementDate"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Accounting_Date</label>
                <input type="date" name="accountingDate" id="accountingDate" class="form-control"
                       value="@(Request.QueryString["accountingDate"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.Start_Date</label>
                <input type="date" name="startDate" id="startDate" class="form-control"
                       value="@(Request.QueryString["startDate"] ?? String.Empty)" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">@GlobalShared.End_Date</label>
                <input type="date" name="endDate" id="endDate" class="form-control"
                       value="@(Request.QueryString["endDate"] ?? String.Empty)" />
            </div>

            <div class="col-12 mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@GlobalShared.Apply_filters</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                <a class="btn btn-light border" href="@Url.Action(null)">@GlobalShared.Clear & @GlobalShared.Reload</a>
                <div class="ms-auto text-muted align-self-center small">Showing @(Model?.Count() ?? 0) rows</div>
            </div>
        </div>
    </form>


    <!-- Results table -->
    <div class="card">
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>@GlobalShared.Member_ref</th>
                            <th>@GlobalShared.Member_name</th>
                            <th>@GlobalShared.Account_Number</th>
                            <th>@GlobalShared.Branch_Name</th>
                            <th class="text-end">@GlobalShared.Amount</th>
                            <th>@GlobalShared.Collector</th>
                            <th>@GlobalShared.Uploaded_By</th>
                            <th>@GlobalShared.Processing_Status</th>
                            <th>@GlobalShared.Treatement_Status</th>
                            <th>@GlobalShared.Treatement_Date</th>
                            <th>@GlobalShared.Accounting_Date</th>
                            <th>@GlobalShared.Start_Date</th>
                            <th>@GlobalShared.End_Date</th>
                            <th>@GlobalShared.Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(item.memberReference ?? "-")</td>
                                    <td>@(item.memberName ?? "-")</td>
                                    <td>@(item.accountNumber ?? "-")</td>
                                    <td>@(item.memberBranchName ?? "-")</td>
                                    <td class="text-end">@String.Format(CultureInfo.InvariantCulture, "{0:N2}", item.amount)</td>
                                    <td>@(item.dailyCollectorName ?? "-")</td>
                                    <td>@(item.uploadBy ?? "-")</td>
                                    <td>
                                        @* Simple status badge (no JS) *@
                                        @if (!string.IsNullOrWhiteSpace(item.processingStatus))
                                        {
                                            <span class="badge bg-secondary">@item.processingStatus</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.treatementStatus))
                                        {
                                            <span class="badge bg-secondary">@item.treatementStatus</span>
                                        }
                                        else
                                        { <span class="text-muted small">-</span>}
                                    </td>
                                    <td>
                                        @(item.treatementDate == default(DateTime) ? "-" : item.treatementDate.ToString("yyyy-MM-dd"))
                                    </td>
                                    <td>
                                        @(item.accountingDate == default(DateTime) ? "-" : item.accountingDate.ToString("yyyy-MM-dd"))
                                    </td>
                                    <td>
                                        @(item.startDate == default(DateTime) ? "-" : item.startDate.ToString("yyyy-MM-dd"))
                                    </td>

                                    <td>@(item.endDate == default(DateTime) ? "-" : item.endDate.ToString("yyyy-MM-dd"))</td>
                                    <td>
                                        @* Details link - controller should handle and return a partial view for that entry *@
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="@Url.Action("GetFileDetailsById", "ManualDailyCollection", new { KEY = item.manualEntryDailyCollectorId })">
                                            @GlobalShared.Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="14" class="text-center small text-muted">@GlobalShared.No_records_found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

