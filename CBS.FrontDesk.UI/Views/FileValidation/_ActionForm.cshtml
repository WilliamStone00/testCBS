@* Location: ~/Views/FileValidation/_ActionForm.cshtml *@
@model CBS.FrontDesk.Data.Entity.ManualDailycollection.ValidationDto

@using (Html.BeginForm("SubmitAction", "FileValidation", FormMethod.Post, new { id = "actionForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.FileUploadId)
    @Html.HiddenFor(m => m.ApprovedBy)
    @Html.HiddenFor(m => m.Mode)

    <div class="mb-3">
        <strong>File ID:</strong> @Model.FileUploadId
    </div>

    <div class="form-floating mb-3">
        @Html.TextAreaFor(m => m.Statement, new { @class = "form-control", placeholder = "Statement", required = "required", style = "height: 120px" })
        <label>@(Model.Mode.ToUpper()) Statement</label>
        @Html.ValidationMessageFor(m => m.Statement, "", new { @class = "text-danger" })
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit @Model.Mode</button>
    </div>
}