@model CBS.FrontDesk.Data.Entity.ManualDailycollection.ValidationDto
@using Resources
@using (Html.BeginForm("SubmitAction", "FileValidation", FormMethod.Post, new { id = "actionForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ManualEntryDailyCollectorId)
    @Html.HiddenFor(m => m.ApprovedBy)
    @Html.HiddenFor(m => m.Mode)

    <div class="mb-3">
        <strong>@GlobalShared.File_ID:</strong> @Model.ManualEntryDailyCollectorId
    </div>

    <div class="form-floating mb-3">
        @* CORRECTED: Bind to the 'Statement' property *@
        @Html.TextAreaFor(m => m.Statement, new { @class = "form-control", placeholder = "Statement", required = "required", style = "height: 120px" })
        <label>@(Model.Mode.ToUpper()) @GlobalShared.Statement</label>
        @Html.ValidationMessageFor(m => m.Statement, "", new { @class = "text-danger" })
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
        <button type="submit" class="btn btn-primary">@GlobalShared.Submit @Model.Mode</button>
    </div>
}