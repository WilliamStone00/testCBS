@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse

@{
    ViewBag.Title = "File Processing System";
}
@using Resources
@Html.AntiForgeryToken()

<!-- ================================================= HEADER & TIPS SECTIONS ================================================== -->
<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-file-check-outline me-2"></i> File Processing System</h1>
        <p class="card-text">Review, approve, or reject uploaded manual collection files that are awaiting processing.</p>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR FILE VALIDATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse show">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-filter-variant text-primary me-2"></i><strong>Default View:</strong> The table automatically shows all files with a 'Pending' status.</li>
                <li><i class="mdi mdi-magnify text-info me-2"></i><strong>Advanced Search:</strong> Use filters for File Name or Branch.</li>
                <li><i class="mdi mdi-cogs text-success me-2"></i><strong>Taking Action:</strong> Use the dropdown on each row for Approve / Review / Reject.</li>
            </ul>
        </div>
    </div>
</div>

<!-- ================================================= FILTERING SECTION ================================================== -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Advanced File Filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="statusFilter" class="form-label fw-bold">Filter by Status</label>
                @Html.DropDownList("StatusFilter", (SelectList)ViewBag.Statuses, "Pending", new { @class = "form-control select2", id = "statusFilter" })
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Upload Date From</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Upload Date To</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byFileNameToggle">
                    <label class="form-check-label" for="byFileNameToggle">Filter by File Name</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byBranchNameToggle">
                    <label class="form-check-label" for="byBranchNameToggle">Filter by Branch</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4" id="fileNameFilterSection" style="display:none;">
                <input type="text" id="fileName" class="form-control" placeholder="Enter file name..." />
            </div>
            <div class="col-md-4" id="branchNameFilterSection" style="display:none;">
                <label for="BranchIdFilter" class="form-label">Branch</label>
                @Html.DropDownList("BranchIdFilter", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", id = "BranchIdFilter" })
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> Apply Filters</button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100"><i class="mdi mdi-refresh"></i> Reset</button>
        </div>
    </div>
</div>

<!-- ================================================= DATATABLE CONTAINER ================================================== -->
<div class="card shadow p-3">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-hover" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>Collector Name</th>
                    <th>Branch</th>
                    <th>Uploaded By</th>
                    <th>Uploaded On</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- ================================================= DETAILS PANEL & MODAL ================================================== -->
<div id="detailsContainer" class="card shadow p-3 mt-4" style="display:none;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 id="detailsHeader" class="mb-0">File Details For </h5>
        <button id="closeDetailsBtn" type="button" class="btn-close"></button>
    </div>
    <div class="card-body" id="detailsBody"></div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">File Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="actionModalBody">
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-primary">Loading form...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
        (function ($) {
            function getStatusBadge(status) {
                if (!status) return "<span class='badge bg-secondary'>Unknown</span>";
                let badgeClass = "bg-secondary";
                switch (status.toLowerCase()) {
                    case "pending": badgeClass = "bg-warning text-dark"; break;
                    case "approved":
                    case "extracted":
                    case "completed":
                    case "treated": badgeClass = "bg-success"; break;
                    case "rejected":
                    case "failed": badgeClass = "bg-danger"; break;
                    case "review": badgeClass = "bg-info text-dark"; break;
                }
                return `<span class='badge ${badgeClass}'>${status}</span>`;
            }

            function generateActionButtons(id, status) {
                return `
                    <div class="btn-group btn-group-sm">
                        <!-- Always show Details -->
                        <a href="#" class="btn btn-outline-primary action-btn" data-action="details" data-id="${id}" title="View Details">
                            <i class="mdi mdi-eye-outline"></i>
                        </a>

                        <!-- Dropdown toggle -->
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" 
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            ${status === 'Pending' ? `
                                <li><a class="dropdown-item action-btn" href="#" data-action="review" data-id="${id}">
                                    <i class="mdi mdi-magnify me-1"></i> Review
                                </a></li>
                                <li><a class="dropdown-item action-btn" href="#" data-action="reject" data-id="${id}">
                                    <i class="mdi mdi-close me-1"></i> Reject
                                </a></li>
                            ` : ''}

                            ${status === 'Reviewed' ? `
                                <li><a class="dropdown-item action-btn" href="#" data-action="approve" data-id="${id}">
                                    <i class="mdi mdi-check me-1"></i> Approve
                                </a></li>
                                <li><a class="dropdown-item action-btn" href="#" data-action="reject" data-id="${id}">
                                    <i class="mdi mdi-close me-1"></i> Reject
                                </a></li>
                            ` : ''}

                            <!-- No extra buttons for Approved, only Details stays -->
                        </ul>
                    </div>
                `;

            }

           function viewDetails(fileId) {
            const detailsContainer = $('#detailsContainer');
            const detailsBody = $('#detailsBody');
            const detailsHeader = $('#detailsHeader');

            detailsHeader.text(`File Details: ${fileId}`);
            detailsBody.html('<div class="text-center p-4"><div class="spinner-border text-primary"></div><p>Loading details...</p></div>');
            detailsContainer.slideDown();

            $.get(`@Url.Action("GetextractedFileDetails", "FileValidation")?id=${fileId}`)
                .done(function (response) {
                    detailsBody.html(response);
                })
                .fail(function () {
                    detailsBody.html('<div class="alert alert-danger">Error loading details.</div>');
                });

            document.getElementById('detailsContainer').scrollIntoView({ behavior: 'smooth' });
}


            function loadActionForm(id, mode) {
                const url = `@Url.Action("GetActionForm", "FileValidation")?fileUploadId=${id}&mode=${mode}`;
                const $body = $('#actionModalBody');
                $('#actionModalLabel').text(`${mode.charAt(0).toUpperCase() + mode.slice(1)} File`);
                $body.html(`<div class="text-center p-4"><div class="spinner-border text-primary"></div><p>Loading form...</p></div>`);
                $('#actionModal').modal('show');
                $.get(url).done(r => $body.html(r)).fail(() => $body.html(`<div class="alert alert-danger">Could not load form.</div>`));
            }

            let dataTable = $('#myDataTable').DataTable({
                serverSide: true,
                processing: false,
                ajax: {
                    url: '@Url.Action("LoadFiles", "FileValidation")',
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    data: function (d) {
                        const filters = {
                            status: $('#statusFilter').val(),
                            dateFrom: $('#startDate').val(),
                            dateTo: $('#endDate').val(),
                            fileName: $('#byFileNameToggle').is(':checked') ? $('#fileName').val() : '',
                            branchId: $('#byBranchNameToggle').is(':checked') ? $('#BranchIdFilter').val() : ''
                        };
                        const order = d.order[0] || {};
                        return JSON.stringify({
                            options: {
                                draw: d.draw,
                                start: d.start,
                                pageSize: d.length,
                                sortColumn: d.columns[order.column]?.data,
                                sortDirection: order.dir,
                                searchValue: d.search.value
                            },
                            filters: filters
                        });
                    }
                },
                columns: [
                    { data: "collectorName" },
                    { data: "branchName" },
                    { data: "uploadedBy" },
                    {
                        data: "uploadedOn",
                        render: function (data, type, row) {
                            // Accept whatever the server sends: a Date string, a formatted string, or null
                            const raw = data ?? row.uploadedOn ?? row.uploadedOnFormatted ?? '';
                            if (!raw) return '';
                            const d = new Date(raw);
                            if (!isNaN(d.getTime())) return d.toLocaleString();
                            // If it's not a parseable date, return the raw string (already formatted)
                            return String(raw);
                        }
                    },
                    {
                        // Show status badge. Uses row to tolerate both `status` and `Status`
                        data: "status",
                        render: function (data, type, row) {
                            const rawStatus = (data ?? row.status ?? row.Status ?? '') + '';
                            const statusTrim = rawStatus.trim();
                            return getStatusBadge(statusTrim);
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            // Resolve status robustly (accept `status` or `Status`) and normalize for button logic
                            const rawStatus = (row.status ?? row.Status ?? '') + '';
                            const statusTrim = rawStatus.trim();
                            // Normalize to "Capitalized" form for existing button logic (e.g. 'Approved', 'Pending', 'Reviewed')
                            const statusForButtons = statusTrim
                                ? statusTrim.charAt(0).toUpperCase() + statusTrim.slice(1).toLowerCase()
                                : '';

                            return generateActionButtons(data, statusForButtons);
                        }
                    }
                ]

            });

            // Filters
            $('#applyFilterBtn').on('click', () => dataTable.ajax.reload());
            $('#resetFilterBtn').on('click', () => {
                $('#statusFilter').val('Pending').trigger('change');
                $('#startDate, #endDate, #fileName').val('');
                $('#byFileNameToggle, #byBranchNameToggle').prop('checked', false).trigger('change');
                $('#BranchIdFilter').val('').trigger('change');
                dataTable.ajax.reload();
            });

            $('#closeDetailsBtn').on('click', () => $('#detailsContainer').slideUp());

            $('#myDataTable tbody').on('click', '.action-btn', function (e) {
                e.preventDefault();
                const $btn = $(this);
                if ($btn.hasClass('disabled')) return;
                const action = $btn.data('action');
                const id = $btn.data('id');
                if (action === 'details') viewDetails(id);
                else loadActionForm(id, action);
            });

            $('.select2').select2();
        }(jQuery));
</script>
}
