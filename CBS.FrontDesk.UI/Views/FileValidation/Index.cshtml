@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse
@using Resources
@{
    ViewBag.Title = "File Processing System";
}
@using Resources
@Html.AntiForgeryToken()

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-file-check-outline me-2"></i> File Processing System/h1>
        <p class="card-text">@GlobalFileValidation.Review_approve_or_reject_uploaded_manual_collection_files_that_are_awaiting_processing</p>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalFileValidation.TIPS_FOR_FILE_VALIDATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-filter-variant text-primary me-2"></i><strong>@GlobalShared.Default_View:</strong> @GlobalFileValidation.The_table_automatically_shows_all_files_with_a_Pending_status</li>
                <li><i class="mdi mdi-magnify text-info me-2"></i><strong>@GlobalShared.Advanced_Search:</strong> @GlobalFileValidation.Use_filters_for_File_Name_or_Branch</li>
                <li><i class="mdi mdi-cogs text-success me-2"></i><strong>@GlobalShared.Taking_Action:</strong> @GlobalFileValidation.Use_the_dropdown_on_each_row_for_Approve_Review_Reject</li>
                <li><i class="mdi mdi-cogs text-success me-2"></i><strong>@GlobalShared.Taking_Action:</strong> @GlobalFileValidation.We_must_review_a_file_before_Approve_it_so_if_you_see_file_review_but_nor_approve_review_it_firt</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.Advanced_File_Filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-2">
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byBranchNameToggle">
                    <label class="form-check-label" for="byBranchNameToggle">@GlobalShared.Filter_by_Branch</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byFileNameToggle">
                    <label class="form-check-label" for="byFileNameToggle">@GlobalShared.Filter_by_File_Name</label>
                </div>
            </div>
        </div>
        <div class="row mb-1">
            <div class="col-md-4">
                <label for="statusFilter" class="form-label fw-bold">@GlobalShared.Filter_by_status</label>
                @Html.DropDownList("StatusFilter", (SelectList)ViewBag.Statuses, "---- All Status ----", new { @class = "form-control select2", id = "statusFilter" })
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">@GlobalShared.Upload_Date_From</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">@GlobalShared.Upload_Date_To</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12" id="branchNameFilterSection" style="display:none;">
                <label for="BranchIdFilter" class="form-label">@GlobalShared.Branch</label>
                @Html.DropDownList("BranchIdFilter", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", id = "BranchIdFilter" })
            </div>
            <div class="col-md-12" id="fileNameFilterSection" style="display:none;">
                <label for="fileName" class="form-label">@GlobalShared.File_Name</label>
                <input type="text" id="fileName" class="form-control" placeholder="@GlobalShared.Enter_file_name..." />
            </div>

        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> @GlobalShared.Apply_filters</button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100"><i class="mdi mdi-refresh"></i> @GlobalShared.Reset</button>
        </div>
    </div>
</div>

<div class="card shadow p-3">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-hover table-bordered" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Collector_Name</th>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.Uploaded_By</th>
                    <th>@GlobalShared.Uploaded_On</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div id="detailsContainer" style="display:none;">

    <div class="card">
        <div class="card-header" id="detailsHeader"></div>
        <div class="card-body" id="detailsBody"></div>
    </div>
</div>
<div id="detailsError" class="alert alert-danger d-none"></div>


<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">@GlobalShared.File_Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="actionModalBody">
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@GlobalShared.Loading...</span>
                    </div>
                    <p class="mt-2 text-primary">@GlobalShared.Loading_form...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Only if DataTables is used
        // const dt = $('#fileDetailsTable').DataTable({ autoWidth: false, responsive: true });

        document.getElementById('fileDetailsCollapse')
            ?.addEventListener('shown.bs.collapse', function () {
                if ($.fn.dataTable) {
                    const t = $('#fileDetailsTable').DataTable();
                    t.columns.adjust().responsive?.recalc();
                }
            });
    </script>

    <script>
        function printD3C() {
            const src = document.getElementById('dashboardPrint');
            if (!src) { window.print(); return; }
            

            // --- Build a temporary print canvas and move content into it ---
            const parent = src.parentNode;
            const next = src.nextSibling;
            const container = document.createElement('div');
            container.id = '__printContainer';
            document.body.appendChild(container);
            container.appendChild(src);

            // Enable print CSS
            document.body.classList.add('print-mode');

            // --- Fit to a single A4 page (within margins) ---
            // Keep these in sync with @@page margin values above.
            const margin = { top: 8, bottom: 8, left: 10, right: 10 }; // mm
            const pxPerMm = 96 / 25.4;
            const printableWidthPx = (210 - margin.left - margin.right) * pxPerMm;
            const printableHeightPx = (297 - margin.top - margin.bottom) * pxPerMm;

            // Save & normalize styles before measuring
            const original = {
                width: src.style.width,
                height: src.style.height,
                transform: src.style.transform
            };

            // Constrain width so wrapping is stable; measure full natural height
            src.style.width = printableWidthPx + 'px';
            src.style.height = '';         // let it grow
            src.style.transform = '';      // reset any previous scale

            // Force layout and measure
            const measuredWidth = src.offsetWidth;
            const measuredHeight = src.scrollHeight;

            // Uniform scale so both width and height fit within the canvas
            const scaleW = printableWidthPx / measuredWidth;
            const scaleH = printableHeightPx / measuredHeight;
            const scale = Math.min(scaleW, scaleH, 1); // never upscale

            // Apply scale
            src.style.transform = 'scale(' + scale + ')';

            // Clean up after printing (restore DOM + styles)
            const cleanup = () => {
                if (next) parent.insertBefore(src, next); else parent.appendChild(src);
                container.remove();
                src.style.width = original.width;
                src.style.height = original.height;
                src.style.transform = original.transform;
                document.body.classList.remove('print-mode');
                window.removeEventListener('afterprint', cleanup);
            };
            window.addEventListener('afterprint', cleanup);

            // Go!
            window.print();
        }
    </script>
    <script>

    (function ($) {
        // ---------------------------
        // Helper UI & rendering fns
        // ---------------------------
        function getStatusBadge(status) {
            if (!status) return "<span class='badge bg-secondary'>Unknown</span>";
            let badgeClass = "bg-secondary";
            switch ((status + "").toLowerCase()) {
                case "pending": badgeClass = "bg-warning text-dark"; break;
                case "approved":
                case "extracted":
                case "completed":
                case "treated": badgeClass = "bg-success"; break;
                case "rejected":
                case "failed": badgeClass = "bg-danger"; break;
                case "review": badgeClass = "bg-info text-dark"; break;
            }
            return `<span class='badge ${badgeClass}'>${status}</span>`;
        }

        function generateActionButtons(id, status) {
            return `
                <div class="btn-group btn-group-sm">
                    <a href="#" class="btn btn-outline-primary action-btn" data-action="details" data-id="${id}" title="View Details">
                        <i class="mdi mdi-eye-outline"></i>
                    </a>

                    <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        ${status === 'Pending' ? `
                            <li><a class="dropdown-item action-btn" href="#" data-action="review" data-id="${id}"><i class="mdi mdi-magnify me-1"></i> Review</a></li>
                            <li><a class="dropdown-item action-btn" href="#" data-action="reject" data-id="${id}"><i class="mdi mdi-close me-1"></i> Reject</a></li>
                        ` : ''}

                        ${status === 'Reviewed' ? `
                            <li><a class="dropdown-item action-btn" href="#" data-action="approve" data-id="${id}"><i class="mdi mdi-check me-1"></i> Approve</a></li>
                            <li><a class="dropdown-item action-btn" href="#" data-action="reject" data-id="${id}"><i class="mdi mdi-close me-1"></i> Reject</a></li>
                        ` : ''}

                        ${status === 'Approved' ? `
                            <li><a class="dropdown-item action-btn" href="#" data-action="reexecute" data-id="${id}"><i class="mdi mdi-check me-1"></i>Reexecute Treatment</a></li>
                           ` : ''}
                    </ul>
                </div>
            `;
        }

        // Robust confirm wrapper that uses alertify if present, otherwise window.confirm
        function confirmDialog(title, message, onOk, onCancel) {
            if (window.alertify && typeof alertify.confirm === 'function') {
                try {
                    alertify.confirm(title, message, function () { if (typeof onOk === 'function') onOk(); }, function () { if (typeof onCancel === 'function') onCancel(); }).set('labels', { ok: 'Yes', cancel: 'No' });
                    return;
                } catch (e) { /* fallback to native */ }
            }
            if (window.confirm(message)) { if (typeof onOk === 'function') onOk(); } else { if (typeof onCancel === 'function') onCancel(); }
        }

                // ---------------------------
        // Modal loader + submit handler
        // ---------------------------
       function ReExcuteDailyCollection(fileId) {

            if (!fileId) {
                appalert("❌ Missing file ID.", 2, 1);
                return false;
            }

            // Confirmation dialog
            const confirmationMessage = "Are you sure you want to re-execute the daily collection for this file?<br/>" +
                "<b class='text-warning'>⚠ Attention</b><br/>" +
                "This operation will reprocess the collection and may take a few moments.";

            alertify.confirm("Confirmation", confirmationMessage,
                function () {

                    // Show loading indicator
                    appalert("⏳ Re-executing daily collection... Please wait.", 1, 1);

                    const ajaxConfig = {
                        type: 'GET',
                        url: '/FileValidation/ReExcuteDailyCollection',
                        data: { id: fileId },
                        success: function (response) {
                            if (response.success) {
                                appalert(response.message || "✅ Daily collection re-executed successfully.", 1, 1);
                            } else {
                                                   
                                appalert(response.message || "❌ Failed to re-execute daily collection.", 2, 1);
                            }
                        },
                        error: function (err) {
                            console.log(err)
                            if (err.status === 401 || err.status === 400) appalert("❌ Bad request: " + (err.responseJSON?.message || "Invalid file ID."), 2, 1);
                            else if (err.status === 404) appalert("❌ File not found.", 2, 1);
                            else if (err.status === 500) appalert("❌ Server error occurred. Please try again later.", 2, 1);
                            else appalert("❌ An error occurred while re-executing daily collection.", 2, 1);
                        }
                    };

                    $.ajax(ajaxConfig);
                },
                function () {
                    appalert('Operation cancelled.', 3, 1);
                }
            );

            return false;
        }
        // ---------------------------
        // Modal loader + submit handler
        // ---------------------------
        function loadActionForm(id, mode) {
            const url = `@Url.Action("GetActionForm", "FileValidation")?fileUploadId=${id}&mode=${mode}`;
            const $body = $('#actionModalBody');

            $('#actionModalLabel').text(`${mode.charAt(0).toUpperCase() + mode.slice(1)} File`);
            $body.html(`<div class="text-center p-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-primary">Loading form...</p></div>`);
            $('#actionModal').modal('show');

            $.get(url)
                .done(function (html) {
                    $body.html(html);

                    // Find form inside partial
                    const $form = $body.find('form').first();
                    if (!$form || $form.length === 0) {
                        $body.prepend('<div class="alert alert-danger">Form not found in the response.</div>');
                        return;
                    }

                    // show validation errors helper
                    function showValidationErrors(errors) {
                        let $summary = $form.find('.validation-summary.custom');
                        if ($summary.length === 0) {
                            $summary = $('<div class="validation-summary custom mb-3"></div>');
                            $form.prepend($summary);
                        }
                        $summary.empty();
                        if (!errors || Object.keys(errors).length === 0) return;
                        const $alert = $('<div class="alert alert-warning mb-2">Please fix the errors below:</div>');
                        const $list = $('<ul class="mb-0"></ul>');
                        Object.keys(errors).forEach(function (k) {
                            (errors[k] || []).forEach(function (msg) {
                                $list.append(`<li>${msg}</li>`);
                            });
                        });
                        $summary.append($alert).append($list);
                    }

                    // attach submit handler
                    $form.off('submit.actionForm').on('submit.actionForm', function (e) {
                        e.preventDefault();
                        const $submit = $form.find('[type="submit"]').first();
                        const origHtml = $submit.data('orig-html') || $submit.html();
                        $submit.data('orig-html', origHtml);
                        $submit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...');

                        showValidationErrors({});

                        $.ajax({
                            url: $form.attr('action'),
                            type: 'POST',
                            data: $form.serialize(),
                            dataType: 'json',
                            success: function (res) {
                                try {
                                    if (!res || typeof res !== 'object') {
                                        appalert('Unexpected server response. Please refresh and try again.', 4, 1);
                                        return;
                                    }
                                    if (res.success) {
                                        appalert(res.message || `${mode} successful`, 1, 1);
                                        $('#actionModal').modal('hide');
                                        if ($.fn.DataTable.isDataTable('#myDataTable')) $('#myDataTable').DataTable().ajax.reload(null, false);
                                    } else {
                                        if (res.errors) showValidationErrors(res.errors);
                                        appalert(res.message || `Failed to ${mode}`, 4, 1);
                                    }
                                } catch (err) {
                                    console.error('Action form success handler error', err);
                                    appalert('An unexpected client error occurred. Check console.', 4, 1);
                                }
                            },
                            error: function (xhr, status, err) {
                                console.error('Action form submit error:', status, err, xhr);
                                if (status === 'timeout') appalert('Request timed out. Please try again.', 4, 1);
                                else if (xhr && xhr.responseJSON && xhr.responseJSON.message) appalert(xhr.responseJSON.message, 4, 1);
                                else appalert('An error occurred while processing the request.', 4, 1);
                            },
                            complete: function () {
                                $submit.prop('disabled', false).html($submit.data('orig-html'));
                            }
                        });
                    });
                })
                .fail(function () {
                    $body.html(`<div class="alert alert-danger">Could not load form.</div>`);
                });
        }

        // ---------------------------
        // DataTable & filter logic
        // ---------------------------
        let dataTable = null;

        // Build the payload expected by your LoadFiles action
        function buildPayload(d) {
            const order = (d.order && d.order[3]) || {};
            // The logic here is already correct and sends all filter values at once.
            // No changes are needed to the payload structure.
            return {
                options: {
                    draw: d.draw,
                    start: d.start,
                    length: d.length,
                    pageSize: d.length,
                    // Send both common names used in controller to make binding easier
                    sortColumn: d.columns[order.column]?.data || '',
                    sortColumnName: d.columns[order.column]?.data || '',
                    sortDirection: order.dir || '',
                    searchValue: d.search?.value || ''
                },
                filters: {
                    status: $('#statusFilter').val(),
                    dateFrom: $('#startDate').val(),
                    dateTo: $('#endDate').val(),
                    fileName: $('#byFileNameToggle').is(':checked') ? $('#fileName').val() : '',
                    branchId: $('#byBranchNameToggle').is(':checked') ? $('#BranchIdFilter').val() : ''
                }
            };
        }

        // Create DataTable (called on first Apply)
        function createDataTable() {
            dataTable = $('#myDataTable').DataTable({
                serverSide: true,
                processing: false,
                ajax: {
                    url: '@Url.Action("LoadFiles", "FileValidation")',
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    data: function (d) { return JSON.stringify(buildPayload(d)); },
                    error: function (xhr, status, err) {
                        console.error('DataTable ajax error', status, err, xhr);
                    }
                },
                order: [[0, 'asc']], // default sort by Collector Name
                columns: [
                    { data: "collectorName", name: "collectorName" },
                    { data: "branchName", name: "branchName" },
                    { data: "uploadedBy", name: "uploadedBy" },
                    {
                        data: "uploadedOn",
                        name: "uploadedOn",
                        render: function (data, type, row) {
                            const raw = data ?? row.uploadedOn ?? row.uploadDateTime ?? '';
                            if (!raw) return '';
                            const d = new Date(raw);
                            if (!isNaN(d.getTime())) return d.toLocaleString();
                            return String(raw);
                        }
                    },
                    {
                         data: function (row) {
                            return row.status ?? row.Status ?? row.fileStatus ?? '';
                        },
                        render: function (data) {
                            return getStatusBadge((data ?? '').toString().trim());
                        },
                        name: 'status'
                    },
                    {
                        data: "id",
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            const rawStatus = (row.status ?? row.Status ?? '') + '';
                            const statusTrim = rawStatus.trim();
                            const statusForButtons = statusTrim ? statusTrim.charAt(0).toUpperCase() + statusTrim.slice(1).toLowerCase() : '';
                            return generateActionButtons(data, statusForButtons);
                        }
                    }
                ],
                responsive: true,
                autoWidth: false,
                lengthMenu: [10, 25, 50, 100],
                pageLength: 10,
                language: {
                    emptyTable: "No files. Choose filters and click 'Apply Filters' to load files."
                }
            });
        }

        // Toggle UI for optional filter sections
        $('#byFileNameToggle').on('change', function () {
            if ($(this).is(':checked')) $('#fileNameFilterSection').slideDown();
            else { $('#fileNameFilterSection').slideUp().find('input').val(''); }
        });
        $('#byBranchNameToggle').on('change', function () {
            if ($(this).is(':checked')) $('#branchNameFilterSection').slideDown();
            else { $('#branchNameFilterSection').slideUp().find('select').val('').trigger('change'); }
        });

        // Apply Filters button: create or reload the DataTable
        $('#applyFilterBtn').on('click', function () {
            if (!dataTable) createDataTable();
            else dataTable.ajax.reload();
        });

        // Reset filters
        $('#resetFilterBtn').on('click', function () {
            // MODIFICATION HERE: Set status filter to the empty string value of the placeholder.
            $('#statusFilter').val('').trigger('change');
            $('#startDate, #endDate').val('');
            $('#fileName').val('');
            $('#byFileNameToggle, #byBranchNameToggle').prop('checked', false);
            // Trigger change events to hide the sections
            $('#byFileNameToggle, #byBranchNameToggle').trigger('change');
            $('#BranchIdFilter').val('').trigger('change');
            if (dataTable) dataTable.ajax.reload();
        });

// ---------------------------
// Details loader: fetch first, then reveal on success
        // ---------------------------
        function viewDetails(fileId) {
            const $detailsContainer = $('#detailsContainer');   // panel to reveal on success
            const $detailsBody = $('#detailsBody');             // content target
            const $detailsHeader = $('#detailsHeader');         // header text
            const $errorBox = $('#detailsError');               // error placeholder (separate from details)

            // Always start hidden and clear previous content/errors
            $detailsContainer.hide();
            $detailsBody.empty();
            $detailsHeader.text('');
            if ($errorBox.length) $errorBox.addClass('d-none').empty();

            const url = `@Url.Action("GetextractedFileDetails", "FileValidation")?id=${fileId}`;

            $.get(url)
                .done(function (response) {
                    // Guard: empty/whitespace response -> treat as error
                    if (!response || (typeof response === 'string' && response.trim().length === 0)) {
                        if ($errorBox.length) {
                            $errorBox
                                .removeClass('d-none')
                                .html('No details were returned for this file.');
                        }
                        return; // do NOT show details container
                    }

                    // Success: inject and reveal
                    $detailsHeader.text(`File Details: ${fileId}`);
                    $detailsBody.html(response);
                    $detailsContainer.slideDown();

                    // Scroll into view
                    document.getElementById('detailsContainer')
                        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                })
                .fail(function (xhr) {
                    // Show error only (do not open details panel)
                    if ($errorBox.length) {
                        const msg = xhr?.responseText
                            ? xhr.responseText
                            : `Error loading details. Status: ${xhr.status} ${xhr.statusText}`;
                        $errorBox.removeClass('d-none').html(msg);
                    }
                });
        }

        // Delegate action button clicks
        // Note: bind to document if table not present at ready or created later
        $(document).on('click', '#myDataTable tbody .action-btn', function (e) {
            e.preventDefault();
            const $btn = $(this);
            if ($btn.hasClass('disabled')) return;
            const action = $btn.data('action');
            const id = $btn.data('id');
            if (action === 'details') viewDetails(id);
            if (action === 'reexecute') ReExcuteDailyCollection(id);
            else loadActionForm(id, action);
        });

        // Close details
        $('#closeDetailsBtn').on('click', function () {
            $('#detailsContainer').slideUp();
        });

        // Initialize select2 if available
        $(document).ready(function () {
            if ($.fn.select2 && $('#BranchIdFilter').length) {
                $('#BranchIdFilter').select2({ width: '100%' });
            }
            if ($.fn.select2 && $('#statusFilter').length) {
                $('#statusFilter').select2({ width: '100%' });
            }

            // Respect toggles initial state
            if ($('#byFileNameToggle').is(':checked')) $('#fileNameFilterSection').show();
            if ($('#byBranchNameToggle').is(':checked')) $('#branchNameFilterSection').show();

            // REMOVED: This line is no longer needed as the default is now the empty placeholder
            // $('#statusFilter').val(initialStatus).trigger('change');
        });

    }(jQuery));
    </script>
}