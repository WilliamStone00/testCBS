@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileUploadResponse

@{
    ViewBag.Title = "File Processing System";
}
@using Resources
@Html.AntiForgeryToken()

<!-- ================================================= HEADER & TIPS SECTIONS ================================================== -->
<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-file-check-outline me-2"></i> File Processing System</h1>
        <p class="card-text">Review, approve, or reject uploaded manual collection files that are awaiting processing.</p>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR FILE VALIDATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse show">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-filter-variant text-primary me-2"></i><strong>Default View:</strong> The table automatically shows all files with a 'Pending' status. Use the filters to find files by a different status or date range.</li>
                <li><i class="mdi mdi-magnify text-info me-2"></i><strong>Advanced Search:</strong> For a more specific search, check the 'Filter by File Name' or 'Filter by Branch' boxes to activate the text search fields.</li>
                <li><i class="mdi mdi-cogs text-success me-2"></i><strong>Taking Action:</strong> Use the 'Select Action' dropdown on each row. You can 'View Details', 'Approve', 'Review', or 'Reject' the file.</li>
                <li><i class="mdi mdi-check-circle-outline text-purple me-2"></i><strong>Approve:</strong> Approving a file confirms its contents are correct and makes it ready for final processing (extraction).</li>
                <li><i class="mdi mdi-comment-question-outline text-warning me-2"></i><strong>Review:</strong> Marking a file for 'Review' flags it for further investigation without rejecting it. A statement is required.</li>
                <li><i class="mdi mdi-close-circle-outline text-danger me-2"></i><strong>Reject:</strong> Rejecting a file permanently marks it as invalid. It cannot be processed further. A reason for the rejection is required.</li>
            </ul>
        </div>
    </div>
</div>

<!-- ================================================= FILTERING SECTION ================================================== -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Advanced File Filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="statusFilter" class="form-label fw-bold">Filter by Status</label>
                @Html.DropDownList("StatusFilter", (SelectList)ViewBag.Statuses, "Pending", new { @class = "form-control select2", id = "statusFilter" })
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Upload Date From</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Upload Date To</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byFileNameToggle">
                    <label class="form-check-label" for="byFileNameToggle">Filter by File Name</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="byBranchNameToggle">
                    <label class="form-check-label" for="byBranchNameToggle">Filter by Branch</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4" id="fileNameFilterSection" style="display:none;">
                <input type="text" id="fileName" class="form-control" placeholder="Enter file name..." />
            </div>
            <div class="col-md-4" id="branchNameFilterSection" style="display:none;">
                @* Make sure the ID here matches what you use in JS, e.g., 'BranchIdFilter' *@
                <label for="BranchIdFilter" class="form-label">Branch</label>
                @Html.DropDownList("BranchIdFilter", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", id = "BranchIdFilter" })
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> Apply Filters</button>
            <button id="resetFilterBtn" class="btn btn-secondary w-100"><i class="mdi mdi-refresh"></i> Reset</button>
        </div>
    </div>
</div>

<!-- ================================================= DATATABLE CONTAINER ================================================== -->
<div class="card shadow p-3">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-hover" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>Collector Name</th>
                    <th>Branch</th>
                    <th>Uploaded By</th>
                    <th>Uploaded On</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- ================================================= DETAILS PANEL & MODAL PLACEHOLDERS ================================================== -->
<div id="detailsContainer" class="card shadow p-3 mt-4" style="display:none;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 id="detailsHeader" class="mb-0">File Details</h5>
        <button id="closeDetailsBtn" type="button" class="btn-close"></button>
    </div>
    <div class="card-body" id="detailsBody"></div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        @* Made modal-lg for potentially larger forms *@
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">File Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="actionModalBody">
                <!-- Dynamic content and loading spinner here -->
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-primary">Loading form...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            // --- CLIENT-SIDE HELPER FUNCTIONS ---
            function getStatusBadge(status) {
                if (!status) return "<span class='badge bg-secondary'>Unknown</span>";
                let badgeClass = "bg-secondary";
                switch (status.toLowerCase()) {
                    case "pending": badgeClass = "bg-warning text-dark"; break;
                    case "approved":
                    case "extracted":
                    case "completed":
                    case "treated": badgeClass = "bg-success"; break;
                    case "rejected":
                    case "failed": badgeClass = "bg-danger"; break;
                    case "review": badgeClass = "bg-info text-dark"; break; // Added review status
                    default: badgeClass = "bg-secondary"; break;
                }
                return `<span class='badge ${badgeClass}'>${status}</span>`;
            }

            function generateActionButtons(id, status) {
                // Adjust buttons based on status if needed.
                // For simplicity, keeping all buttons active, but you might disable some.
                return `
                <div class="btn-group btn-group-sm" role="group">
                    <a href="#" class="btn btn-outline-primary action-btn" data-action="details" data-id="${id}" title="View Details"><i class="mdi mdi-eye-outline"></i></a>
                    <a href="#" class="btn btn-outline-success action-btn ${status === 'Approved' || status === 'Extracted' ? 'disabled' : ''}" data-action="approve" data-id="${id}" title="Approve"><i class="mdi mdi-check"></i></a>
                    <a href="#" class="btn btn-outline-warning action-btn ${status === 'Rejected' || status === 'Extracted' ? 'disabled' : ''}" data-action="review" data-id="${id}" title="Review"><i class="mdi mdi-magnify"></i></a>
                    <a href="#" class="btn btn-outline-danger action-btn ${status === 'Rejected' || status === 'Extracted' ? 'disabled' : ''}" data-action="reject" data-id="${id}" title="Reject"><i class="mdi mdi-close"></i></a>
                </div>`;
            }


            // --- WORKFLOW FUNCTIONS ---
            function viewDetails(fileId) {
                const detailsContainer = $('#detailsContainer');
                const detailsBody = $('#detailsBody');
                const detailsHeader = $('#detailsHeader');

                detailsHeader.text(`File Details: ${fileId}`);
                detailsBody.html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><p class="mt-2 text-primary">Loading details...</p></div>');
                detailsContainer.slideDown();

                const url = `@Url.Action("GetextractedFileDetails", "FileValidation")?id=${fileId}`;
                $.get(url)
                    .done(function (response) {
                        detailsBody.html(response);
                        appalert('File details loaded.', 1, 1);
                    })
                    .fail(function (xhr) {
                        detailsBody.html(`<div class="alert alert-danger">Error loading details. Status: ${xhr.statusText || 'Unknown'}</div>`);
                        appalert('Error loading file details.', 4, 1);
                    });

                document.getElementById('detailsContainer').scrollIntoView({ behavior: 'smooth' });
            }

            function confirmAndReject(fileId) {
                if (typeof alertify === 'undefined' || !alertify.confirm) {
                    console.error("Alertify.js not loaded or configured correctly.");
                    appalert("Confirmation dialog not available. Cannot proceed with rejection.", 4, 1);
                    return;
                }

                alertify.confirm("Confirmation", "Are you sure you want to reject this file? This action cannot be undone.",
                    function () { // OK Button
                        const token = $('input[name="__RequestVerificationToken"]').val();
                        $.ajax({
                            url: '@Url.Action("RejectFile", "FileValidation")',
                            type: 'POST',
                            data: { id: fileId },
                            headers: token ? { 'RequestVerificationToken': token } : {},
                            dataType: 'json', // Expect a JSON response from the server
                            beforeSend: function() {
                                appalert('Rejecting file...', 3, 0); // Info message, no auto-dismiss
                            },
                            success: function (response) {
                                if (response && response.success) { // Assuming server returns { success: true, message: "..." }
                                    appalert(response.message || 'File rejected successfully.', 1, 1);
                                    $('#myDataTable').DataTable().ajax.reload(null, false); // Reload without resetting pagination
                                } else {
                                    appalert(response.message || 'Failed to reject the file.', 4, 1);
                                }
                            },
                            error: function (xhr) {
                                appalert('An error occurred while rejecting the file: ' + (xhr.responseJSON?.message || xhr.statusText), 4, 1);
                            },
                            complete: function() {
                                // Potentially dismiss the "Rejecting file..." appalert if it wasn't auto-dismissed
                            }
                        });
                    },
                    function () { // Cancel Button
                        appalert("File rejection cancelled.", 3, 1);
                    }
                );
            }

            // --- Load the form into modal ---
            function loadActionForm(id, mode) {
                const url = `@Url.Action("GetActionForm", "FileValidation")?fileUploadId=${id}&mode=${mode}`;
                const $actionModalBody = $('#actionModalBody');
                const $actionModalLabel = $('#actionModalLabel');

                $actionModalLabel.text(`${mode.charAt(0).toUpperCase() + mode.slice(1)} File`); // e.g., "Approve File"

                // Display loading spinner immediately
                $actionModalBody.html(`
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-primary">Loading form...</p>
                    </div>
                `);
                $('#actionModal').modal('show');

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (response) {
                        $actionModalBody.html(response);
                        // Initialize any JS for the loaded form, e.g., select2 or validation
                        $('.select2').select2({
                            dropdownParent: $('#actionModal') // Important for select2 in modals
                        });
                        // You might need to re-attach validation if using client-side validation libraries
                        // $.validator.unobtrusive.parse(form); // Example for jQuery Unobtrusive Validation
                    },
                    error: function (xhr) {
                        $actionModalBody.html(`
                            <div class="alert alert-danger">
                                Could not load form. Please try again. [${xhr.status}] ${xhr.statusText || 'Error'}
                            </div>
                        `);
                        appalert(`Error loading ${mode} form.`, 4, 1);
                    }
                });
            }


            // --- DATATABLE INITIALIZATION ---
            let dataTable; // Declare dataTable globally within the IIFE
            function initializeFilesDataTable() {
                dataTable = $('#myDataTable').DataTable({ // Assign to the global dataTable variable
                    processing: false, // Show processing indicator
                    serverSide: true,
                    searching: false, // Custom search handling below
                    autoWidth: false,
                    ajax: {
                        url: '@Url.Action("LoadFiles", "FileValidation")',
                        type: 'POST',
                        contentType: "application/json; charset=utf-8", // Indicate JSON payload
                        dataType: "json",
                        data: function (d) {
                            // Collect filter values
                            const filters = {
                                status: $('#statusFilter').val(),
                                dateFrom: $('#startDate').val(),
                                dateTo: $('#endDate').val(),
                                fileName: $('#byFileNameToggle').is(':checked') ? $('#fileName').val() : '',
                                branchId: $('#byBranchNameToggle').is(':checked') ? $('#BranchIdFilter').val() : ''
                            };

                            const order = d.order[0] || {};
                            const requestBody = {
                                options: { // Match this to your server-side model's property name
                                    draw: d.draw,
                                    start: d.start,
                                    pageSize: d.length,
                                    sortColumn: d.columns[order.column]?.data,
                                    sortDirection: order.dir,
                                    searchValue: d.search.value // Global search value if you enable it
                                },
                                filters: filters // Pass filters object
                            };
                            return JSON.stringify(requestBody);
                        },
                        error: function (xhr, error, thrown) {
                            console.error("DataTables AJAX Error:", error, thrown, xhr);
                            appalert("Error loading files data: " + (xhr.responseJSON?.message || thrown), 4, 1);
                        }
                    },
                    columns: [
                        { data: "collectorName", name: "CollectorName" },
                        { data: "branchName", name: "BranchName" },
                        { data: "uploadedBy", name: "UploadedBy" },
                        {
                            data: "uploadedOn", name: "UploadedOn",
                            render: function (data) {
                                if (data) {
                                    const date = new Date(data); // Assuming ISO 8601 format from server
                                    return date.toLocaleString();
                                }
                                return '';
                            }
                        },
                        {
                            data: "status", name: "Status", orderable: false,
                            render: function (data) { return getStatusBadge(data); }
                        },
                        {
                            data: "id", name: "Actions", orderable: false, searchable: false,
                            render: function (data, type, row) { // Pass row data to get status
                                return generateActionButtons(data, row.status);
                            }
                        }
                    ],
                    columnDefs: [
                        { width: "20%", targets: 0 }, // Adjusted widths for better fit
                        { width: "20%", targets: 1 },
                        { width: "15%", targets: 2 },
                        { width: "15%", targets: 3 },
                        { width: "15%", targets: 4, className: "text-center" },
                        { width: "15%", targets: 5, className: "text-center" }
                    ],
                    responsive: true, // Enable responsive features
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 75, 100],
                    language: {
                        emptyTable: "No files found matching your criteria.",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                        infoEmpty: "Showing 0 to 0 of 0 entries",
                        infoFiltered: "(filtered from _MAX_ total entries)",
                        lengthMenu: "Show _MENU_ entries",
                        loadingRecords: "Loading...",
                        processing: "Processing...",
                        search: "Search:",
                        zeroRecords: "No matching records found"
                    },
                    drawCallback: function () {
                        // Re-initialize select2 for branch filter in case it's dynamic
                        $('#BranchIdFilter').select2({
                             dropdownParent: $('#branchNameFilterSection') // Or wherever the select2 is
                        });
                        // Adjust columns on each draw to prevent layout issues
                        dataTable.columns.adjust();
                    }
                });
                return dataTable;
            }

            // --- MAIN SCRIPT EXECUTION ---
            $(document).ready(function () {
                dataTable = initializeFilesDataTable(); // Initialize and store the DataTable instance

                // Toggle filter sections
                $('#byFileNameToggle').on('change', function () {
                    $('#fileNameFilterSection').toggle(this.checked);
                    if (!this.checked) $('#fileName').val(''); // Clear if hidden
                });
                $('#byBranchNameToggle').on('change', function () {
                    $('#branchNameFilterSection').toggle(this.checked);
                    if (!this.checked) $('#BranchIdFilter').val('').trigger('change'); // Clear and update select2 if hidden
                });


                // Filter reload
                $('#applyFilterBtn').on('click', () => {
                    // This reloads the DataTable with new filter parameters
                    dataTable.ajax.reload();
                    appalert('Filters applied.', 3, 1);
                });

                // Reset Filters
                $('#resetFilterBtn').on('click', () => {
                    $('#statusFilter').val('Pending').trigger('change');
                    $('#startDate').val('');
                    $('#endDate').val('');
                    $('#byFileNameToggle').prop('checked', false).trigger('change');
                    $('#byBranchNameToggle').prop('checked', false).trigger('change');
                    $('#fileName').val('');
                    $('#BranchIdFilter').val('').trigger('change');

                    dataTable.ajax.reload(); // Reload with reset filters
                    appalert('Filters have been reset.', 3, 1);
                });

                // Close details panel
                $('#closeDetailsBtn').on('click', function () {
                    $('#detailsContainer').slideUp();
                });

                // Delegated event handler for action buttons in DataTable
                $('#myDataTable tbody').on('click', '.action-btn', function (e) {
                    e.preventDefault();
                    if ($(this).hasClass('disabled')) { // Check if button is disabled
                         appalert('This action is not available for the current file status.', 3, 1);
                         return;
                    }

                    const action = $(this).data('action');
                    const id = $(this).data('id');
                    if (!action || !id) {
                        appalert('Action or File ID missing.', 4, 1);
                        return;
                    }
                    switch (action) {
                        case 'details': viewDetails(id); break;
                        case 'reject': confirmAndReject(id); break;
                        case 'approve':
                        case 'review': loadActionForm(id, action); break;
                        default:
                            appalert('Unknown action requested.', 4, 1);
                            break;
                    }
                });


                // Submit handler for action forms loaded into modal
                $(document).on('submit', '#actionForm', function (e) {
                    e.preventDefault();
                    const form = $(this);
                    const actionUrl = form.attr('action');
                    const formData = form.serialize();
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    // Optional: Client-side validation check before AJAX submit
                    // If you have jQuery Unobtrusive Validation, you can do:
                    // if (!form.valid()) {
                    //     appalert('Please correct the validation errors in the form.', 3, 1);
                    //     return;
                    // }

                    $.ajax({
                        url: actionUrl,
                        type: 'POST',
                        data: formData, // Send as form data, not JSON, if this is a standard form submission
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        dataType: 'json', // Expect JSON response
                        beforeSend: function() {
                            // Show a loading state inside the modal body or a temporary appalert
                            appalert('Submitting action...', 3, 0); // Non-dismissing info
                            // Disable form elements to prevent double submission
                            form.find(':input').prop('disabled', true);
                            form.find('button[type="submit"]').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');
                        },
                        success: function (response) {
                            if (response && response.success) { // Assuming server returns { success: true, message: "..." }
                                appalert(response.message || 'Action completed successfully.', 1, 1);
                                $('#actionModal').modal('hide');
                                dataTable.ajax.reload(null, false); // Reload without resetting pagination
                            } else {
                                // If server returns success: false, it might also return validation errors
                                if (response && response.errors) {
                                    // You might want to display these errors on the form itself
                                    displayFormErrors(form, response.errors); // Custom function to display errors
                                    appalert(response.message || 'Validation errors found.', 3, 1);
                                } else {
                                    appalert(response.message || 'Action failed.', 4, 1);
                                }
                            }
                        },
                        error: function (xhr) {
                            appalert('An error occurred while submitting the form: ' + (xhr.responseJSON?.message || xhr.statusText), 4, 1);
                        },
                        complete: function() {
                            // Re-enable form elements
                            form.find(':input').prop('disabled', false);
                            form.find('button[type="submit"]').html('Submit'); // Restore button text
                            // Dismiss the appalert if it was temporary
                        }
                    });
                });

                // Custom function to display server-side validation errors on the form
                function displayFormErrors(form, errors) {
                    // Clear previous errors
                    form.find('.text-danger').remove();
                    form.find('.is-invalid').removeClass('is-invalid');

                    for (const key in errors) {
                        if (errors.hasOwnProperty(key)) {
                            const errorMessages = errors[key];
                            const inputField = form.find(`[name="${key}"]`);
                            if (inputField.length > 0) {
                                inputField.addClass('is-invalid');
                                inputField.after(`<div class="text-danger small">${errorMessages.join(', ')}</div>`);
                            } else {
                                // Fallback for model-level errors not tied to a specific field
                                form.prepend(`<div class="alert alert-danger mt-2">${errorMessages.join(', ')}</div>`);
                            }
                        }
                    }
                }

                // Initial setup for select2 elements
                $('.select2').select2({
                    // General options
                });
                $('#BranchIdFilter').select2({
                    dropdownParent: $('#branchNameFilterSection') // Ensure correct parent for filter select2
                });
            }); // end of document ready
        }(jQuery));
    </script>
}