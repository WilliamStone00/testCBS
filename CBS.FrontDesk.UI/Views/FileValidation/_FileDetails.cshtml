@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileDetailsResponse
@{
    Func<decimal, string> formatCurrency = amount => amount.ToString("N2");
}

<div class="card bg-light border-primary mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Extracted File ID:</strong> @Model.FileUploadId</p>
                <p><strong>Collector:</strong> @Model.CollectorName</p>
                <p><strong>Branch:</strong> @Model.BranchName</p>
            </div>
            <div class="col-md-6">
                <p><strong>Total Members:</strong> @Model.TotalMember</p>
                <p><strong>Total Amount:</strong> <span class="fw-bold text-success">@formatCurrency(Model.TotalAmount)</span></p>
                @*<p><strong>Status:</strong> <span class="badge bg-info">@Model.status</span></p>*@
            </div>
        </div>
    </div>
</div>

<h5 class="text-primary mb-3">Transaction Details</h5>
<div class="table-responsive" style="max-height:300px; overflow-y:auto;">
    <table id="transactionDetailsTable" class="table table-striped table-bordered table-sm mb-0">
        <thead class="table-light">
            <tr>
                <th>Member Name</th>
                <th>Account Number</th>
                <th>Branch</th>
                <th class="text-end">Amount</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
$(function () {
    $('#transactionDetailsTable').DataTable({
        ajax: {
            url: '@Url.Action("GetTransactionDetails", "FileValidation")',
            data: { id: '@Model.FileUploadId' },
            dataSrc: ''
        },
        columns: [
            { data: 'memberName' },
            { data: 'accountNumber' },
            { data: 'memberBranchName' },
            { data: 'amount', className: 'text-end', render: $.fn.dataTable.render.number(',', '.', 2) }
        ],
        paging: true,
        searching: true,
        info: true,
        responsive: true,
        autoWidth: true
    });
});
</script>
