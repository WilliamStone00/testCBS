@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileDetailsResponse
@{
    Func<decimal, string> formatCurrency = amount => amount.ToString("N2");
    Func<DateTime?, string> formatDate = dt => dt.HasValue ? dt.Value.ToString("yyyy-MM-dd HH:mm") : "N/A";
}

<!-- FILE SUMMARY SECTION -->
<div class="card bg-light border-primary mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-2"><strong>File ID:</strong> @Model.FileUploadId</p>
                <p class="mb-2"><strong>Collector:</strong> @Model.CollectorName</p>
                <p class="mb-0"><strong>Branch:</strong> @Model.BranchName</p>
            </div>
            <div class="col-md-6">
                <p class="mb-2"><strong>Total Members:</strong> @Model.TotalMember</p>
                <p class="mb-2"><strong>Total Amount:</strong> <span class="fw-bold text-success">@formatCurrency(Model.TotalAmount)</span></p>
                <p class="mb-0"><strong>Status:</strong> <span class="badge bg-info">@Model.Status</span></p>
            </div>
        </div>
    </div>
</div>

<!-- TRANSACTION DETAILS SECTION -->
<h5 class="text-primary mb-3"><i class="mdi mdi-format-list-numbered me-2"></i>Transaction Details</h5>
<div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-sm mb-0">
        <!-- ... (thead remains the same) ... -->
        <tbody>
            @if (Model.Details != null && Model.Details.Any())
            {
                foreach (var detail in Model.Details)
                {
                    <tr>
                        <td>@detail.MemberName</td>
                        <td>@detail.AccountNumber</td>
                        <td>@detail.MemberBranchName</td>
                        <td class="text-end">@formatCurrency(detail.Amount)</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center p-4">No transaction details found.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- ========================== SECTION 3: PROCESSING HISTORY / AUDIT TRAIL ========================== -->
<h5 class="text-primary mt-4 mb-3"><i class="mdi mdi-history me-2"></i>Processing History</h5>
<div class="card border-secondary">
    <div class="card-body p-0">
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><i class="mdi mdi-upload text-muted me-2"></i>Uploaded</span>
                <span class="text-end"><strong>@Model.UploadedBy</strong><br /><small>@formatDate(Model.UploadDateTime)</small></span>
            </li>

            @if (!string.IsNullOrEmpty(Model.ReviewedBy))
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="mdi mdi-comment-question-outline text-warning me-2"></i>Reviewed</span>
                        <span class="text-end"><strong>@Model.ReviewedBy</strong><br /><small>@formatDate(Model.ReviewedDateTime)</small></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ReviewerStatement))
                    {
                        <p class="text-muted mt-2 mb-0 fst-italic bg-light p-2 rounded">Statement: "@Model.ReviewerStatement"</p>
                    }
                </li>
            }

            @if (!string.IsNullOrEmpty(Model.ApprovedBy))
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="mdi mdi-check-circle-outline text-success me-2"></i>Approved</span>
                        <span class="text-end"><strong>@Model.ApprovedBy</strong><br /><small>@formatDate(Model.ApprovalDateTime)</small></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ApprovalStatement))
                    {
                        <p class="text-muted mt-2 mb-0 fst-italic bg-light p-2 rounded">Statement: "@Model.ApprovalStatement"</p>
                    }
                </li>
            }

            @if (!string.IsNullOrEmpty(Model.CashierName))
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="mdi mdi-cash-receive text-info me-2"></i>Cash Received</span>
                        <span class="text-end"><strong>@Model.CashierName</strong><br /><small>@formatDate(Model.CashReceptionDate)</small></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CashierComment))
                    {
                        <p class="text-muted mt-2 mb-0 fst-italic bg-light p-2 rounded">Comment: "@Model.CashierComment"</p>
                    }
                </li>
            }
        </ul>
    </div>
</div>