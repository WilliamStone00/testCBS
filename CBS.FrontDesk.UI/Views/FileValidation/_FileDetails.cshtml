@model CBS.FrontDesk.Data.Entity.ManualDailycollection.FileDetailsResponse
    @using Resources
@{
    Func<decimal, string> formatCurrency = amount => amount.ToString("N2");
}

@{
    var totalAmount = Model?.Details?.Sum(d => d.Amount) ?? 0m;
    var totalMembers = Model?.Details?.Count ?? 0;
    string Safe(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    string DateOrDash(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy, HH:mm:ss") : "—";
    string DateShort(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
    string Money(decimal v) => string.Format("{0:N0}", v);
    string YesNo(bool v) => v ? "Yes" : "No";
    var totalTreated = Model?.Details?
        .Count(d => !string.IsNullOrWhiteSpace(d.TreatementStatus) &&
                    d.TreatementStatus.Trim().Equals("Treated", StringComparison.OrdinalIgnoreCase))
        ?? 0;

    string StatusBadge(string status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "bg-secondary";
        status = status.Trim().ToLowerInvariant();
        if (status.Contains("approved")) return "bg-success";
        if (status.Contains("completed")) return "bg-success";
        if (status.Contains("review")) return "bg-secondary";
        if (status.Contains("pending")) return "bg-warning";
        if (status.Contains("rejected") || status.Contains("failed")) return "bg-danger";
        return "bg-primary";
    }
}


<style>
    /* Optional screen look */
    .a4-statement.pro-doc {
        max-width: 210mm;
        margin: 0 auto;
        background: #fff;
    }

    @@media print {
        @@page {
            size: A4 portrait;
            /* ↓ Tight but safe margins (change if you like).
         IMPORTANT: keep these in sync with the JS margin values below. */
            margin: 8mm 10mm;
        }
        /* Hide everything by default */
        body * {
            visibility: hidden !important;
        }
        /* Show only our print canvas */
        body.print-mode #__printContainer,
        body.print-mode #__printContainer * {
            visibility: visible !important;
        }
        /* Printable canvas = A4 content box (A4 - @@page margins) */
        body.print-mode #__printContainer {
            width: calc(210mm - 10mm - 10mm);
            height: calc(297mm - 8mm - 8mm);
            margin: 0 auto; /* center horizontally */
            background: #fff;
            display: flex;
            align-items: center; /* center vertically */
            justify-content: center; /* center horizontally */
            overflow: hidden; /* never spill to page 2 */
        }
            /* Our content will be scaled to fit this canvas */
            body.print-mode #__printContainer > #dashboardPrint {
                transform-origin: top left !important;
                margin: 0 !important;
                padding: 0 !important;
            }
        /* If you keep a footer page span .pg, this will show "1" */
        .pg::after {
            content: counter(page);
        }
    }
</style>

<!-- Wrap both cards in this container (add the table card later inside too) -->
<div id="mainAccordion">

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white border-0 d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div>
                    <h5 class="mb-0">
                        <!-- Title toggles the dashboard body -->
                        <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#dashCollapse"
                                aria-expanded="true"
                                aria-controls="dashCollapse">
                            <i class="mdi mdi-view-dashboard-outline me-1"></i>
                            @GlobalFileValidation.Daily_Collector_Cash_Clearance_Dashboard
                        </button>
                    </h5>
                    <small class="text-muted">@GlobalShared.File_ID: @Safe(Model?.Id)</small>
                </div>

                <span class="badge @StatusBadge(Model?.status) ms-2">@Safe(Model?.status)</span>
                @if (Model?.BatchExecutionStatus != null)
                {
                    <span class="badge @StatusBadge(Model.BatchExecutionStatus) ms-1">Batch: @Model.BatchExecutionStatus</span>
                }
            </div>

            
        </div>

        <!-- Collapsible body + footer (OPEN by default) -->
        <div id="dashCollapse" class="collapse show" data-bs-parent="#mainAccordion">
            <div class="card-body pt-0">
                <div id="__printContainer">
                    <div id="dashboardPrint" class="a4-statement pro-doc">
                        <!-- Header -->
                        <table class="hdr">
                            <colgroup>
                                <col style="width:58%">
                                <col style="width:42%">
                            </colgroup>
                            <tr>
                                <td class="hdr-left">
                                    <div class="brand">
                                        <div class="logo">@* replace with <img src="@ViewBag.LogoUrl" class="logo-img" alt="Logo" /> if you have a URL *@</div>
                                        <div class="brand-text">
                                            <div class="org-name">@Session["BankName"]</div>
                                            <div class="org-sub">&gt; @Session["BranchName"]</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="hdr-right">
                                    <div class="doc-code">@GlobalFileValidation.DAILY_COLLECTOR_CASH_CLEARANCE <span class="muted">(D3C)</span></div>
                                    <table class="kv mini">
                                        <colgroup>
                                            <col style="width:46%">
                                            <col style="width:54%">
                                        </colgroup>
                                        <tr><th>@GlobalShared.Report_Date</th><td>@DateTime.Now.ToString("dd/MM/yyyy")</td></tr>
                                        <tr><th>@GlobalShared.Branch</th><td>@Safe(Model?.BranchName)</td></tr>
                                        <tr><th>@GlobalShared.Prepared_by</th><td>____________________</td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- File meta -->
                        <table class="kv two-col mt8">
                            <colgroup>
                                <col style="width:18%">
                                <col style="width:32%">
                                <col style="width:18%">
                                <col style="width:32%">
                            </colgroup>
                            <tr><th>@GlobalShared.File_ID</th><td>@Safe(Model?.Id)</td><th>@GlobalShared.Transit_Ref</th><td>@Safe(Model?.DailyCollectorTransitMemberReference)</td></tr>
                            <tr><th>@GlobalShared.Collector</th><td>@Safe(Model?.CollectorName)</td><th>@GlobalShared.Collector_ID</th><td>@Safe(Model?.CollectorId)</td></tr>
                            <tr><th>@GlobalShared.Branch_Code</th><td>@Safe(Model?.BranchCode)</td><th>@GlobalShared.Branch_ID</th><td>@Safe(Model?.BranchId)</td></tr>
                        </table>

                        <!-- Summary KPIs -->
                        <table class="kv three-col mt8">
                            <colgroup>
                                <col style="width:34%">
                                <col style="width:33%">
                                <col style="width:33%">
                            </colgroup>
                            <tr><th>@GlobalShared.Total_amount</th><th>@GlobalShared.Members</th><th>@GlobalShared.Branches_Collected</th></tr>
                            <tr>
                                <td class="num">@Money(Model.TotalAmount > 0 ? Model.TotalAmount : (Model.Details?.Sum(d => d.Amount) ?? 0m))</td>
                                <td class="num">@((Model.TotalMember > 0 ? Model.TotalMember : (Model.Details?.Count ?? 0)))</td>
                                <td class="num">@Model.TotalBranchesCollected</td>
                            </tr>
                        </table>

                        <!-- Processing -->
                        <table class="kv three-col mt8">
                            <colgroup>
                                <col style="width:34%">
                                <col style="width:33%">
                                <col style="width:33%">
                            </colgroup>
                            <tr><th>@GlobalShared.Uploaded_By</th><th>@GlobalShared.Reviewed_By</th><th>@GlobalShared.Approved_by</th></tr>
                            <tr>
                                <td>
                                    <div class="strong">@Safe(Model?.UploadedBy)</div>
                                    <div class="muted">@DateOrDash(Model?.UploadDateTime)</div>
                                </td>
                                <td>
                                    <div class="strong">@Safe(Model?.ReviewedBy)</div>
                                    <div class="muted">@DateOrDash(Model?.ReviewedDateTime)</div>
                                    <div class="muted">Note: @Safe(Model?.ReviewerStatement)</div>
                                </td>
                                <td>
                                    <div class="strong">@Safe(Model?.ApprovedBy)</div>
                                    <div class="muted">@DateOrDash(Model?.ApprovalDateTime)</div>
                                    <div class="muted">Note: @Safe(Model?.ApprovalStatement)</div>
                                </td>
                            </tr>
                        </table>

                        <!-- Treated -->
                        <table class="kv single mt8">
                            <colgroup>
                                <col style="width:42%">
                                <col style="width:8%">
                                <col style="width:20%">
                                <col style="width:30%">
                            </colgroup>
                            <tr>
                                <th>@GlobalFileValidation.Total_Treated_Daily_Savers_Cash_in</th>
                                <td class="num">@totalTreated</td>
                                <th>@GlobalShared.Status</th>
                                <td>@GlobalShared.Treated</td>
                            </tr>
                        </table>

                        <!-- Cash reception -->
                        <table class="kv two-col mt8">
                            <colgroup>
                                <col style="width:18%">
                                <col style="width:32%">
                                <col style="width:18%">
                                <col style="width:32%">
                            </colgroup>
                            <tr><th colspan="4" class="section">@GlobalFileValidation.CASH_RECEPTION</th></tr>
                            <tr><th>@GlobalShared.Cashier</th><td>@Safe(Model?.CashierName)</td><th>@GlobalShared.Date</th><td>@DateShort(Model?.CashReceptionDate)</td></tr>
                            <tr><th>@GlobalShared.Cashier_Branch</th><td>@Safe(Model?.CashierBranchName) (@Safe(Model?.CashierBranchCode))</td><th>@GlobalFileValidation.Cash_in_Amount</th><td class="num">@Money(Model?.TotalCashInAmount ?? 0m)</td></tr>
                            <tr><th>@GlobalShared.Cash_in_Status</th><td>@(Model?.CashInStatus==true ? "Yes" : "No")</td><th>@GlobalShared.Note</th><td class="wrap">@Safe(Model?.CashierComment)</td></tr>
                        </table>

                        <!-- Note -->
                        <div class="note-block mt10">
                            <div class="note-title">@GlobalFileValidation.Payment_Engagement_Note</div>
                            <div class="note-body">
                                @GlobalFileValidation.The_above_cash_in_figures_represent_amounts_collected_by_the_assigned_Daily_Collector_and_verified_by_the_Cashier
                                @GlobalFileValidation.By_signing_below_the_parties_acknowledge_the_correctness_of_the_amounts_and_agree_that_any_discrepancy_or_pending_adjustments_will_be_reported_and_regularized_at_end_of_day_EOD_reconciliation
                            </div>
                        </div>

                        <!-- Signatories -->
                        <table class="sigs mt12">
                            <colgroup><col style="width:33%"><col style="width:34%"><col style="width:33%"></colgroup>
                            <tr>
                                <td>
                                    <div class="sig-title">@GlobalShared.Accountant</div>
                                    <div class="sig-line"></div>
                                    <div class="sig-meta">@GlobalShared.Name: ____________________</div>
                                    <div class="sig-meta">@GlobalShared.Date: ____ / ____ / ______</div>
                                </td>
                                <td>
                                    <div class="sig-title">@GlobalShared.Daily_collector</div>
                                    <div class="sig-line"></div>
                                    <div class="sig-meta">@GlobalShared.Name: ____________________</div>
                                    <div class="sig-meta">@GlobalShared.Date: ____ / ____ / ______</div>
                                </td>
                                <td>
                                    <div class="sig-title">@GlobalShared.Cashier</div>
                                    <div class="sig-line"></div>
                                    <div class="sig-meta">@GlobalShared.Name: ____________________</div>
                                    <div class="sig-meta">@GlobalShared.Date: ____ / ____ / ______</div>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer -->
                        <div class="foot">
                            <div class="foot-left">[Footer line 1]  |  [Footer line 2]</div>
                            <div class="foot-right">@GlobalShared.Page <span class="pg"></span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="small text-muted">
                    @GlobalShared.Created: @DateOrDash(Model?.CreatedDate) &nbsp;|&nbsp; @GlobalShared.Modified: @DateOrDash(Model?.ModifiedDate) &nbsp;|&nbsp; @GlobalShared.Teller: @Safe(Model?.TellerName)
                </div>
            </div>
        </div>
    </div>

</div>


<!-- =========================
     Card 2: TABLE (accordion item)
     ========================= -->
<div class="card shadow-sm">
    <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
        <h6 class="mb-0">
            <!-- Title toggler -->
            <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#fileDetailsCollapse"
                    aria-expanded="false"
                    aria-controls="fileDetailsCollapse">
                <i class="mdi mdi-format-list-bulleted me-2"></i>
                @GlobalShared.Collections (@totalMembers)
            </button>
        </h6>
    </div>

    <!-- Collapsible body; part of the same accordion -->
    <div id="fileDetailsCollapse" class="collapse" data-bs-parent="#mainAccordion">
        <div class="card-body">
            <div class="table-responsive">
                <table id="myDataTable2" class="table table-hover align-middle w-100">

                    <thead class="table-light">
                        <tr>
                            <th style="width:9%">@GlobalShared.ACC_NUM</th>
                            <th style="width:26%">@GlobalShared.Name</th>
                            <th style="width:8%" class="text-end">@GlobalShared.Amount</th>
                            <th style="width:30%">@GlobalShared.Members_Branch</th>
                            <th style="width:17%">T. Date</th>
                            <th style="width:10%">@GlobalShared.Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Details != null)
                        {
                            foreach (var d in Model.Details)
                            {
                                <tr>
                                    <td class="td-clip">@Safe(d.MemberReference)</td>
                                    <td class="td-clip">@Safe(d.MemberName)</td>
                                    <td class="text-end fw-semibold td-clip">@Money(d.Amount)</td>
                                    <td class="branch-wrap">
                                        @Safe(d.MemberBranchCode) @Safe(d.MemberBranchName)
                                    </td>
                                    <td class="td-clip">@DateOrDash(@d.TreatementDate)</td>
                                    <td class="td-clip">
                                        <span class="badge @StatusBadge(d.TreatementStatus)">@Safe(d.TreatementStatus)</span>
                                        @*<div class="small text-muted">@DateShort(d.TreatementDate)</div>*@
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                    <!-- Footer must have the SAME number of columns (6) -->
                    <tfoot>
                        <tr class="table-light">
                            <!-- 1st + 2nd columns -->
                            <th colspan="2" class="text-end">@GlobalShared.Totals (@GlobalShared.filtered):</th>

                            <!-- 3rd column = Amount (TOTAL GOES HERE) -->
                            <th class="text-end" id="ftAmountTotal">@totalAmount</th>

                            <!-- 4th–5th columns for a note -->
                            <th colspan="2" class="text-start">
                                <span class="fw-semibold">@GlobalShared.Total_Treated:</span>
                                <span id="ftTreatedTotal" class="ms-1">@totalMembers</span>
                            </th>

                            <!-- 6th column blank -->
                            <th>@totalTreated</th>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <div class="mt-2 small text-muted">
                @GlobalShared.Created: @DateOrDash(Model?.CreatedDate) &nbsp;|&nbsp; @GlobalShared.Modified: @DateOrDash(Model?.ModifiedDate) &nbsp;|&nbsp; @GlobalShared.Teller: @Safe(Model?.TellerName)
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById('fileDetailsCollapse')
        ?.addEventListener('shown.bs.collapse', function () {
            if ($.fn.dataTable) {
                const t = $('#myDataTable2').DataTable();
                t.columns.adjust().responsive?.recalc();
            }
        });
</script>
