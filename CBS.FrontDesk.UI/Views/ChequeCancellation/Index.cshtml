@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationRequest
@{
    ViewBag.Title = "Cheque Cancellation Requests";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">Cheque Cancellation Requests</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Cheque Management</a></li>
                        <li class="breadcrumb-item active">Cancellation Requests</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h4 class="card-title">Cancellation Requests Management</h4>
                            <p class="card-title-desc">Manage cheque book and leaf cancellation requests</p>
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-primary" onclick="loadPartialView('new', '_CreateCancellationRequestForm', 'datalistingview')">
                                <i class="fas fa-plus me-1"></i> New Cancellation Request
                            </button>
                        </div>
                    </div>

                    <!-- Filters Section -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select id="statusFilter" class="form-control">
                                <option value="">All Status</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Rejected">Rejected</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Branch</label>
                            @Html.DropDownList("branchFilter", new SelectList(ViewBag.Branches, "Id", "Name"),
                                "All Branches", new { @class = "form-control", id = "branchFilter" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" id="fromDateFilter" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" id="toDateFilter" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <button id="applyFilterBtn" class="btn btn-primary me-2">
                                <i class="fas fa-filter me-1"></i> Apply Filters
                            </button>
                            <button id="resetFilterBtn" class="btn btn-secondary">
                                <i class="fas fa-redo me-1"></i> Reset
                            </button>
                        </div>
                    </div>

                    <!-- Data Table Container -->
                    <div id="datalistingview">
                        <!-- Partial view will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load initial data table
            loadPartialView('list', '_CancellationDataTable', 'datalistingview');

            // Apply filters
            $('#applyFilterBtn').click(function () {
                if (typeof cancellationTable !== 'undefined') {
                    cancellationTable.ajax.reload();
                }
            });

            // Reset filters
            $('#resetFilterBtn').click(function () {
                $('#statusFilter').val('');
                $('#branchFilter').val('');
                $('#fromDateFilter').val('');
                $('#toDateFilter').val('');
                if (typeof cancellationTable !== 'undefined') {
                    cancellationTable.ajax.reload();
                }
            });
        });

        function loadPartialView(path, partialView, targetDiv) {
            showLoader(targetDiv);
            $.ajax({
                url: '@Url.Action("InitializeData", "ChequeCancellation")',
                type: 'GET',
                data: {
                    path: path,
                    partialView: partialView,
                    KEY: '',
                    serviceOption: ''
                },
                success: function (data) {
                    $('#' + targetDiv).html(data);
                    if (partialView === '_CancellationDataTable') {
                        initializeDataTable();
                    }
                },
                error: function () {
                    $('#' + targetDiv).html('<div class="alert alert-danger">Error loading content</div>');
                }
            });
        }

        function showLoader(targetDiv) {
            $('#' + targetDiv).html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Loading...</div>
                </div>
            `);
        }

        function initializeDataTable() {
            cancellationTable = $('#cancellationDataTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetCancellationRequestsDataTable", "ChequeCancellation")',
                    type: 'POST',
                    data: function (d) {
                        return {
                            Status: $('#statusFilter').val(),
                            BranchId: $('#branchFilter').val(),
                            FromDate: $('#fromDateFilter').val(),
                            ToDate: $('#toDateFilter').val(),
                            DataTableOptions: {
                                draw: d.draw,
                                start: d.start,
                                pageSize: d.length,
                                sortColumnName: d.columns[d.order[0]?.column || 0].data,
                                sortDirection: d.order[0]?.dir || 'asc'
                            }
                        };
                    }
                },
                columns: [
                    {
                        data: 'id',
                        name: 'Id',
                        render: function(data, type, row) {
                            return `<strong>${data}</strong>`;
                        }
                    },
                    { data: 'customerName', name: 'CustomerName' },
                    { data: 'accountNumber', name: 'AccountNumber' },
                    { data: 'requestType', name: 'RequestType' },
                    {
                        data: null,
                        name: 'Reference',
                        render: function(data) {
                            return data.chequeBookId || data.chequeLeafId || data.chequeNumber || data.pageNumber || 'N/A';
                        }
                    },
                    {
                        data: 'status',
                        name: 'Status',
                        render: function(data) {
                            const badgeClass = {
                                'Pending': 'badge bg-warning',
                                'Approved': 'badge bg-success',
                                'Rejected': 'badge bg-danger',
                                'Cancelled': 'badge bg-secondary',
                                'Completed': 'badge bg-info'
                            }[data] || 'badge bg-secondary';

                            return `<span class="${badgeClass}">${data}</span>`;
                        }
                    },
                    {
                        data: 'requestedDate',
                        name: 'RequestedDate',
                        render: function(data) {
                            return data ? new Date(data).toLocaleDateString() : 'N/A';
                        }
                    },
                    {
                        data: 'id',
                        name: 'Actions',
                        orderable: false,
                        render: function(data, type, row) {
                            let buttons = `
                                <button class="btn btn-info btn-sm" onclick="loadDetails('${data}')" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </button>`;

                            if (row.status === 'Pending') {
                                buttons += `
                                    <button class="btn btn-success btn-sm" onclick="loadReviewForm('${data}', true)" title="Approve">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" onclick="loadReviewForm('${data}', false)" title="Reject">
                                        <i class="fas fa-times"></i>
                                    </button>`;
                            }

                            buttons += `
                                <button class="btn btn-warning btn-sm" onclick="loadEditForm('${data}')" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" onclick="deleteRequest('${data}')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>`;

                            return `<div class="btn-group btn-group-sm">${buttons}</div>`;
                        }
                    }
                ],
                language: {
                    emptyTable: "No cancellation requests found.",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of 0 entries",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    lengthMenu: "Show _MENU_ entries",
                    loadingRecords: "Loading...",
                    processing: "Processing...",
                    search: "Search:",
                    zeroRecords: "No matching records found"
                }
            });
        }

        function loadDetails(requestId) {
            loadPartialView('details', '_CancellationRequestDetails', 'datalistingview', requestId);
        }

        function loadReviewForm(requestId, isApprove) {
            loadPartialView('review', '_ReviewCancellationRequestForm', 'datalistingview', requestId);
        }

        function loadEditForm(requestId) {
            loadPartialView('edit', '_CreateCancellationRequestForm', 'datalistingview', requestId);
        }

        function deleteRequest(requestId) {
            if (confirm('Are you sure you want to delete this cancellation request?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "ChequeCancellation")',
                    type: 'GET',
                    data: { KEY: requestId },
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message, 1, 1);
                            if (typeof cancellationTable !== 'undefined') {
                                cancellationTable.ajax.reload();
                            }
                        } else {
                            appalert(response.message, 2, 1);
                        }
                    },
                    error: function () {
                        appalert('Error deleting request', 4, 1);
                    }
                });
            }
        }

        // Function to load partial view with KEY parameter
        function loadPartialView(path, partialView, targetDiv, key) {
            showLoader(targetDiv);
            $.ajax({
                url: '@Url.Action("InitializeData", "ChequeCancellation")',
                type: 'GET',
                data: {
                    path: path,
                    partialView: partialView,
                    KEY: key || '',
                    serviceOption: ''
                },
                success: function (data) {
                    $('#' + targetDiv).html(data);
                },
                error: function () {
                    $('#' + targetDiv).html('<div class="alert alert-danger">Error loading content</div>');
                }
            });
        }

        // Back to list function
        function backToList() {
            loadPartialView('list', '_CancellationDataTable', 'datalistingview');
        }
    </script>
}