@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationRequest
@using Resources

@* ----------------- Cancellation Form ----------------- *@
@using (Html.BeginForm("CreateOrUpdate", "ChequeCancellation", FormMethod.Post,
    new { enctype = "multipart/form-data", onsubmit = "return cancellationSubmitAjax(this);" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div id="cancellationDetailsForm" class="card shadow p-3 mb-4 mt-3">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-file-cancel me-1"></i> Cheque Cancellation Request
        </h5>

        <div class="row">
            <!-- Branch -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "Select Branch",
                        new { @class = "form-control", id = "BranchId" }
                    )
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label for="BranchId">Branch</label>
                </div>
            </div>

            <!-- Cheque Book ID -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeBookId, new { @class = "form-control", placeholder = "Enter cheque book ID" })
                    @Html.ValidationMessageFor(m => m.ChequeBookId, "", new { @class = "text-danger" })
                    <label for="ChequeBookId">Cheque Book ID</label>
                </div>
            </div>

            <!-- Cheque Leaf ID -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ChequeLeafId, new { @class = "form-control", placeholder = "Enter cheque leaf ID" })
                    @Html.ValidationMessageFor(m => m.ChequeLeafId, "", new { @class = "text-danger" })
                    <label for="ChequeLeafId">Cheque Leaf ID</label>
                </div>
            </div>



            <!-- Customer Name -->
            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Enter customer name" })
                    @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
                    <label for="CustomerName">Customer Name</label>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.CreatedDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.CreatedDate, "", new { @class = "text-danger" })
                    <label>Cheque Expiration Date</label>
                </div>
            </div>
        </div>

        <!-- Reason -->
        <div class="mb-3">
            <div class="form-floating shadow-sm">
                @Html.TextAreaFor(m => m.Reason, 3, 50, new { @class = "form-control", placeholder = "Enter reason for cancellation", style = "height:100px" })
                @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
                <label for="Reason">Reason for Cancellation</label>
            </div>
        </div>

        <!-- Additional Notes -->
        <div class="mb-3">
            <div class="form-floating shadow-sm">
                @Html.TextAreaFor(m => m.AdditionalNotes, 2, 50, new { @class = "form-control", placeholder = "Optional additional information", style = "height:80px" })
                @Html.ValidationMessageFor(m => m.AdditionalNotes, "", new { @class = "text-danger" })
                <label for="AdditionalNotes">Additional Notes</label>
            </div>
        </div>

        <!-- Save & Reset -->
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success shadow-sm px-4 me-2">
                <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Save
            </button>
            <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                @GlobalShared.Reset
            </button>
        </div>
    </div>
}


<script>


window.cancellationSubmitAjax = function (form) {
    var $form = $(form);
    if (!$form.length) return false;

    // Basic client-side validation
    try { $.validator.unobtrusive.parse($form); } catch (e) { }
    if (!$form.valid()) return false;

    // Check if the form is multipart (for file uploads)
    var isMultipart = ($form.attr('enctype') || '').toLowerCase() === 'multipart/form-data';

    // Get anti-forgery token
    var token = $('input[name="__RequestVerificationToken"]').val();

    // Disable submit button and show spinner
    var $submit = $form.find('[type="submit"]').first();
    var origHtml = $submit.html();
    $submit.prop('disabled', true)
        .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Saving...');

    // Prepare AJAX options
    var ajaxOptions = {
        url: $form.attr('action'),
        type: $form.attr('method') || 'POST',
        data: isMultipart ? new FormData(form) : $form.serialize(),
        contentType: isMultipart ? false : 'application/x-www-form-urlencoded; charset=UTF-8',
        processData: !isMultipart,
        headers: token ? { 'RequestVerificationToken': token } : {},
        success: function (res) {
            if (res && res.success) {
                appalert(res.message || 'Saved successfully', 1, 1);
                if (typeof cancellationTable !== 'undefined') cancellationTable.ajax.reload();
            } else {
                appalert((res && res.message) ? res.message : 'Save failed', 2, 1);
            }
        },
        error: function () {
            appalert('An error occurred while processing your request.', 4, 1);
        },
        complete: function () {
            $submit.prop('disabled', false).html(origHtml);
        }
    };

    // Send AJAX request
    $.ajax(ajaxOptions);

    return false; // prevent normal form submission
    };

 </script>