@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationRequest
@using Resources

@{
    ViewBag.Title = "Cheque Cancellation Request";
}

<div class="card mb-4">
    <div class="modal-body">

        @using (Html.BeginForm("CreateOrUpdate", "ChequeCancellation", FormMethod.Post,
            new { id = "cancellationForm", enctype = "multipart/form-data", onsubmit = "return cancellationSubmitAjax(this);" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="row gy-3">

                <!-- ================= HEADER ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="mdi mdi-file-cancel me-1"></i>
                        @(Model != null && Model.Id != null ? "UPDATE CHEQUE CANCELLATION" : "ADD CHEQUE CANCELLATION")
                    </h6>
                    <p class="text-muted small mb-0">
                        @(Model != null && Model.Id != null
                        ? "Modify the details below and update this cheque cancellation request."
                        : "Capture cheque cancellation details for processing and approval.")
                    </p>
                </div>

                <!-- ================= BASIC DETAILS ================= -->
                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.RequestedBy,
                            new { @class = "form-control", placeholder = "Requested By" })
                        <label>Requested By</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.RequestToken,
                            new { @class = "form-control", placeholder = "Request Token" })
                        <label>Request Token</label>
                    </div>
                </div>

                <!-- ================= BRANCH & CUSTOMER ================= -->
                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BranchId,
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-select select2", required = "required" })
                        <label>Branch</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CustomerId,
                            new { @class = "form-control", placeholder = "Customer ID" })
                        <label>Customer ID</label>
                    </div>
                </div>

                <!-- ================= CHEQUE BOOK DETAILS ================= -->
                <div class="col-12">
                    <h6 class="text-success border-bottom pt-2 pb-1">
                        <i class="fas fa-book-open me-1"></i>
                        Cheque Book Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookId,
                            new { @class = "form-control", placeholder = "Cheque Book ID", @readonly = "readonly" })
                        <label>Cheque Book ID</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.CheckBookLeaveId,
                            new { @class = "form-control", placeholder = "Cheque Leaf ID", @readonly = "readonly" })
                        <label>Cheque Leaf ID</label>
                    </div>
                </div>

                <!-- ================= NOTES ================= -->
                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.Reason, 3, 100,
                            new { @class = "form-control", placeholder = "Reason for Cancellation", style = "height:100px" })
                        <label>Reason for Cancellation</label>
                    </div>
                </div>

                <!-- ================= ACTION BUTTONS ================= -->
                <div class="col-12 text-end mt-3">
                    <button type="reset" class="btn btn-outline-secondary shadow-sm px-4 me-2">
                        Reset
                    </button>

                    <button type="submit" class="btn btn-success shadow-sm px-4">
                        <i class="mdi mdi-content-save me-1"></i>
                        @(Model != null && Model.Id != null ? "Update" : "Save")
                    </button>
                </div>

            </div>
        }

    </div>
</div>
