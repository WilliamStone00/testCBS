@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationRequest
@using Resources
<style>
    .section-header {
        font-weight: bold;
        color: #4CAF50;
        margin-top: 1rem;
        margin-bottom: .5rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .header-viewer {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.95rem;
        color: #555;
        border-left: 4px solid #4CAF50;
    }

        .header-viewer h6 {
            font-weight: 700;
            color: #2e7d32;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 220px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }
</style>

<!-- ✅ New Header Viewer -->
<div class="header-viewer">
    <h6><i class="mdi mdi-file-eye-outline"></i> @ChequeCancellationResource.CANCELLATION_REQUEST_VIEWER</h6>
    <p>
        @ChequeCancellationResource.You_are_viewing_a_detailed_summary_of_the_selected_cheque_cancellation_request
        @ChequeCancellationResource.Use_the_details_below_to_guide_your_validation_process
    </p>
    
</div>

<!-- ✅ Existing Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 text-primary">
            <i class="mdi mdi-file-cancel me-1"></i> @GlobalShared.Cancellation_Request (@Model.Id)
        </h5>
    </div>
    <div class="card-body px-3 py-2">

        <!-- 🔷 Request Info -->
        <h6 class="fw-bold border-bottom text-primary section-header">
            <i class="mdi mdi-information-outline"></i> @GlobalShared.Request_Information
        </h6>
        <table class="table table-sm table-bordered mb-3">
            <tbody>
                <tr><th class="bg-label">@GlobalShared.Request_Type</th><td>@Model.RequestType</td></tr>
                <tr><th class="bg-label">@GlobalShared.Reference</th><td>@(Model.ChequeBookId ?? Model.ChequeLeafId ?? Model.ChequeNumber ?? Model.PageNumber ?? "N/A")</td></tr>
                <tr>
                    <th class="bg-label">@GlobalShared.Status</th>
                    <td>
                        @{
                            var badgeClass = "bg-secondary";
                            switch (Model.Status)
                            {
                                case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Pending:
                                    badgeClass = "bg-warning"; break;
                                case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Approved:
                                    badgeClass = "bg-success"; break;
                                case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Rejected:
                                    badgeClass = "bg-danger"; break;
                                case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Completed:
                                    badgeClass = "bg-info"; break;
                            }
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </td>
                </tr>
                <tr><th class="bg-label">@GlobalShared.Requested_Date</th><td>@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
            </tbody>
        </table>

        <!-- 🔷 Customer Info -->
        <h6 class="fw-bold border-bottom text-primary section-header">
            <i class="mdi mdi-account"></i> @GlobalShared.Customer_Information
        </h6>
        <table class="table table-sm table-bordered mb-3">
            <tbody>
                <tr><th class="bg-label">@GlobalShared.Customer_Name</th><td>@Model.CustomerName</td></tr>
                <tr><th class="bg-label">@GlobalShared.Account_Number</th><td>@Model.AccountNumber</td></tr>
                <tr><th class="bg-label">@GlobalShared.Branch</th><td>@Model.BranchName</td></tr>
            </tbody>
        </table>

        <!-- 🔷 Reason -->
        <h6 class="fw-bold border-bottom text-primary section-header">
            <i class="mdi mdi-comment-alert-outline"></i> @GlobalShared.Reason_for_Cancellation
        </h6>
        <div class="border p-3 bg-light mb-3">
            @Model.Reason
        </div>

        <!-- 🔷 Additional Notes -->
        @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
        {
            <h6 class="fw-bold border-bottom text-primary section-header">
                <i class="mdi mdi-note-text-outline"></i> @GlobalShared.Additional_Notes
            </h6>
            <div class="border p-3 bg-light mb-3">
                @Model.AdditionalNotes
            </div>
        }

        <!-- 🔷 Review -->
        @if (Model.ReviewedDate.HasValue)
        {
            <h6 class="fw-bold border-bottom text-primary section-header">
                <i class="mdi mdi-account-check-outline"></i> @GlobalShared.Review_Information
            </h6>
            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="bg-label">@GlobalShared.Reviewed_By</th><td>@Model.ReviewedByUserName</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Reviewed_Date</th><td>@Model.ReviewedDate.Value.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><th class="bg-label">@GlobalShared.Comments</th><td>@(Model.ReviewComments ?? "N/A")</td></tr>
                </tbody>
            </table>
        }

        <!-- 🔷 Actions -->
        <div class="text-end mt-3">
            <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
            </button>
        </div>
    </div>
</div>