@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationRequest

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Cancellation Request Details</h5>
        <button class="btn btn-sm btn-outline-secondary" onclick="backToList()">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table table-bordered">
                    <tr>
                        <th width="40%">Request ID:</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Request Type:</th>
                        <td>@Model.RequestType</td>
                    </tr>
                    <tr>
                        <th>Reference:</th>
                        <td>@(Model.ChequeBookId ?? Model.ChequeLeafId ?? Model.ChequeNumber ?? Model.PageNumber ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status:</th>
                        <td>
                            @{
                                var badgeClass = "badge bg-secondary";
                                switch (Model.Status)
                                {
                                    case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Pending:
                                        badgeClass = "badge bg-warning"; break;
                                    case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Approved:
                                        badgeClass = "badge bg-success"; break;
                                    case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Rejected:
                                        badgeClass = "badge bg-danger"; break;
                                    case CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Completed:
                                        badgeClass = "badge bg-info"; break;
                                }
                            }
                            <span class="@badgeClass">@Model.Status</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-bordered">
                    <tr>
                        <th width="40%">Customer Name:</th>
                        <td>@Model.CustomerName</td>
                    </tr>
                    <tr>
                        <th>Account Number:</th>
                        <td>@Model.AccountNumber</td>
                    </tr>
                    <tr>
                        <th>Branch:</th>
                        <td>@Model.BranchName</td>
                    </tr>
                    <tr>
                        <th>Requested Date:</th>
                        <td>@Model.RequestedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <h6 class="text-muted">Reason for Cancellation</h6>
                <div class="border p-3 bg-light">
                    @Model.Reason
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
        {
            <div class="row mt-3">
                <div class="col-12">
                    <h6 class="text-muted">Additional Notes</h6>
                    <div class="border p-3 bg-light">
                        @Model.AdditionalNotes
                    </div>
                </div>
            </div>
        }

        @if (Model.ReviewedDate.HasValue)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <h6 class="text-muted">Review Information</h6>
                    <table class="table table-bordered">
                        <tr>
                            <th width="30%">Reviewed By:</th>
                            <td>@Model.ReviewedByUserName</td>
                        </tr>
                        <tr>
                            <th>Reviewed Date:</th>
                            <td>@Model.ReviewedDate.Value.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Comments:</th>
                            <td>@(Model.ReviewComments ?? "N/A")</td>
                        </tr>
                    </table>
                </div>
            </div>
        }

        <div class="text-end mt-3">
            <button class="btn btn-primary" onclick="loadEditForm('@Model.Id')">
                <i class="fas fa-edit me-1"></i> Edit Request
            </button>
            @if (Model.Status == CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationStatus.Pending)
            {
                <button class="btn btn-success" onclick="loadReviewForm('@Model.Id', true)">
                    <i class="fas fa-check me-1"></i> Approve
                </button>
                <button class="btn btn-danger" onclick="loadReviewForm('@Model.Id', false)">
                    <i class="fas fa-times me-1"></i> Reject
                </button>
            }
        </div>
    </div>
</div>

