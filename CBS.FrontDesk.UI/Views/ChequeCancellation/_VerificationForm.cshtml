@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeCancelation.CancellationValidatiion

<fieldset class="fieldset-custom">
    <!-- Page Header -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-book-check-outline me-2"></i> Cheque Cancellation Actions
            </h1>
            <p class="card-text text-muted mb-1">
                Approve, Reject or Validate a customer’s cheque Cancellation request and manage the lifecycle of a clearance using this form.
            </p>
            <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
        </div>
    </div>

    <!-- Modal Content -->
    <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">
                <i class="mdi mdi-file-document-edit-outline me-2"></i>
                Clearance Request @Model.Mode
            </h5>

        </div>

        <!-- Modal Body -->
        <div class="modal-body p-4">
            <!-- Request Information -->
            <div class="card mb-4 border-0 bg-light">
                <div class="card-body py-3">
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">File ID</label>
                            <p class="fw-bold text-dark mb-0">@Model.Id</p>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Action Mode</label>
                            <p class="fw-bold text-dark mb-0">@Model.Mode</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Form -->
            @using (Html.BeginForm("SubmitAction", "ChequeCancellation", FormMethod.Post, new { id = "actionForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.ApprovedBy)
                @Html.HiddenFor(m => m.Mode)

                <div class="mb-3">
                    <label for="Statement" class="form-label fw-bold text-dark">
                        <i class="mdi mdi-text-box-edit-outline me-1"></i>
                        @Model.Mode Statement
                        <span class="text-danger">*</span>
                    </label>
                    @Html.TextAreaFor(m => m.Statement, new
                    {
                        @class = "form-control",
                        placeholder = "Provide a statement or reason for this action...",
                        required = "required",
                        minlength = "10",
                        style = "height: 120px"
                    })
                    <div class="form-text text-muted">
                        <small>
                            <i class="mdi mdi-information-outline me-1"></i>
                            Required field. Minimum 10 characters.
                        </small>
                    </div>
                    @Html.ValidationMessageFor(m => m.Statement, "", new { @class = "text-danger" })
                </div>
            }
        </div>

        <!-- Modal Footer -->
        <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close-circle-outline me-1"></i> Cancel
            </button>
            <button type="submit" class="btn btn-primary" id="actionSubmitBtn">
                <i class="mdi mdi-check-circle-outline me-1"></i>
                Submit @Model.Mode
            </button>
        </div>
    </div>
</fieldset>

