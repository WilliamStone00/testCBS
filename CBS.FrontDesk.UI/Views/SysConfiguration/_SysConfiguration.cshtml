@model CBS.FrontDesk.Data.Entity.Config.System.SysConfiguration
@using Resources





<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalSysConfiguration.RuningYearProfile
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>System Profile</legend>
                                <div class="row g-4">
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.Name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Value, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.Value</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 75px;" })
                                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                                            <label>@GlobalSysConfiguration.Description</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                    @Html.HiddenFor(m => m.Id)
                                    <input type="hidden" name="ServiceOption" value="profile" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        @GlobalSysConfiguration.OpenOrCloseOfSystemYear
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>@GlobalSysConfiguration.SystemYearStatus</legend>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.IsYearOpen, new { @class = "form-check-input" })
                                            @*@if (Model.IsYearOpen)
                                                {
                                                    <label class="form-check-label" for="isActive">
                                                        Year is currently opened. Uncheck to stop the running of the year
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="form-check-label" for="isActive">
                                                        Year is not opened. Check to keep the year open and running.
                                                    </label>
                                                }*@
                                            @if (Model.IsYearOpen)
                                            {
                                                <span class="status-label running">@GlobalSysConfiguration.Running</span>
                                            }
                                            else
                                            {
                                                <span class="status-label closed">@GlobalShared.Closed</span>
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    @Html.HiddenFor(m => m.Id)
                                    <input type="hidden" name="ServiceOption" value="close_open_year" id="ServiceOption" />
                                    @if (Model.IsYearOpen)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.UncheckToCloseTheYear.</button>

                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.CheckToOpenTheYear.</button>

                                    }
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod55">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod55"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod55">
                        @GlobalSysConfiguration.SetAutomaticChargingSystem

                    </button>
                </h2>
                <div id="collapsePaymentMethod55"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod55"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>@GlobalSysConfiguration.SystemDailyStatus</legend>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UseAutomaticChargingSystem, new { @class = "form-check-input" })

                                            @if (Model.UseAutomaticChargingSystem)
                                            {
                                                <span class="status-label running">@GlobalSysConfiguration.ON</span>
                                            }
                                            else
                                            {
                                                <span class="status-label closed">@GlobalSysConfiguration.OFF</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    @if (Model.UseAutomaticChargingSystem)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.UncheckToSetItOFF</button>

                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.CheckToSetItON.</button>

                                    }                                   @Html.HiddenFor(m => m.Id)

                                    <input type="hidden" name="ServiceOption" value="automatic_charging_system" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>

            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod5">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod5"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod5">
                        @GlobalSysConfiguration.OpenOrCloseOfSystemDailyOperations

                    </button>
                </h2>
                <div id="collapsePaymentMethod5"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod5"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>@GlobalSysConfiguration.SystemDailyStatus</legend>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.IsDayOpen, new { @class = "form-check-input" })
                                            @*@if (Model.IsDayOpen)
                                                {
                                                    <label class="form-check-label" for="isActive">
                                                        Day is currently opened. Uncheck to stop the running of the day
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="form-check-label" for="isActive">
                                                        Day is not opened. Check to keep the day open and running.set_off_days
                                                    </label>
                                                }*@

                                            @if (Model.IsDayOpen)
                                            {
                                                <span class="status-label running">@GlobalSysConfiguration.Running</span>
                                            }
                                            else
                                            {
                                                <span class="status-label closed">@GlobalShared.Closed</span>
                                            }


                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    @if (Model.IsDayOpen)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.UncheckToCloseTheDay.</button>

                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalSysConfiguration.CheckToOpenTheDay.</button>

                                    }                                   @Html.HiddenFor(m => m.Id)

                                    <input type="hidden" name="ServiceOption" value="close_open_day" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryOptions">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryOptions"
                            aria-expanded="false"
                            aria-controls="collapseDeliveryOptions">
                        @GlobalSysConfiguration.SetSystemDaysOff

                    </button>
                </h2>
                <div id="collapseDeliveryOptions"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDeliveryOptions"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "SysConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Set Off Days</legend>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.MondayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Monday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.TuesDayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Tuesday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.MWednessdayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Wednesday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.ThursdayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Thursday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.FridayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Friday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.SaturdayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Saturday
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.SundayIsHoliday, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">
                                                @GlobalSysConfiguration.Sunday
                                            </label>
                                        </div>
                                    </div>

                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                    @Html.HiddenFor(m => m.Id)
                                    <input type="hidden" name="ServiceOption" value="set_off_days" id="ServiceOption" />
                                </div>
                            </fieldset>}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
