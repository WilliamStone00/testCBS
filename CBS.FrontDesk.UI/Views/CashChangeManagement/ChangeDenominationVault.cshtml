@model CBS.FrontDesk.Data.Entity.CashChangeManagement.CashChangeHistory
@{
    ViewBag.Title = "Denomination Change Management";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-register me-2"></i>@ViewBag.Context Denomination Change Management
                </h1>
                <p class="card-text text-muted">
                    Manage denominations efficiently for @ViewBag.Context operations in your branch. Use the options below to update or review denominations.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDenominationTips" aria-expanded="false" aria-controls="collapseDenominationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseDenominationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure all denomination inputs are accurate before submission.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Use numeric values only for denominations and quantities.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> Denominations can only be updated by authorized personnel.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Double-check totals to match the required amounts.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconDenominations">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-Denominations" aria-expanded="true" aria-controls="accordionPopoutIcon-Denominations">
                            <i class="mdi mdi-cash-multiple me-2"></i> @ViewBag.Context.ToUpper() MANAGEMENT OF DENOMINATIONS
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-Denominations" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div id="datalistingview">
                                    @Html.Partial("_ChangeDenomination")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
   
}
