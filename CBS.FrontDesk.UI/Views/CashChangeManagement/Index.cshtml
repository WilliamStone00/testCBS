@model CBS.FrontDesk.Data.Entity.CashChangeManagement.CashChangeHistory
    @using Resources
@{
    ViewBag.Title = @GlobalCashChangeManagement.VaultDenominationChangeManagement;
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-register me-2"></i> @GlobalCashChangeManagement.VaultDenominationChangeManagement
                </h1>
                <p class="card-text text-muted">
                    @GlobalCashChangeManagement.ManageDenominationsEfficiently.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalCashChangeManagement.TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDenominationTips" aria-expanded="false" aria-controls="collapseDenominationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseDenominationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalCashChangeManagement.EnsureAllDenominationInputsAreAccurate.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalCashChangeManagement.UseNumericValuesOnlyForDenominations.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalCashChangeManagement.DenominationsCanOnlyBeUpdated.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalCashChangeManagement.DoubleCheckTotalsToMatchTheRequiredAmounts.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconDenominations">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-Denominations" aria-expanded="true" aria-controls="accordionPopoutIcon-Denominations">
                            <i class="mdi mdi-cash-multiple me-2"></i> @GlobalCashChangeManagement.ChangeDenominations
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-Denominations" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-1">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button" onclick="LoadDataGen('CashChangeManagement','myDataTable','_ChangeDenominationVaultData',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                        </a>
                                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_ChangeDenominationVault','new','CashChangeManagement')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalCashChangeManagement.AddNewVault">
                                            <i class="mdi mdi-plus mdi-18px"></i>  @GlobalCashChangeManagement.AddCashChange
                                        </a>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_ChangeDenominationVault")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
