@model CBS.FrontDesk.Data.Entity.Overdraft.SubmitOverdraftActivationRequestCommand
@using Resources
<div class="card-body">
    @using (Html.BeginForm("SubmitOverdraftRequest", "Overdraft", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate", id = "overdraftForm" }))
    {
        <div class="row gy-4">

            <!-- 🔍 Section: Member & Account Info -->
            <!-- 📍 Section: Member & Account Information -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pt-2 pb-1">
                    <i class="mdi mdi-account-circle-outline me-1"></i> @GlobalOverdraftActivation.member_account_information
                </h6>
            </div>

            <!-- 🔍 Member account reference number & Name -->
            <div class="col-md-12">
                <label class="form-label">@GlobalOverdraftActivation.member_account_reference_number</label>
                <div class="input-group shadow-sm">
                    @Html.TextBoxFor(m => m.CustomerId, new { @class = "form-control", placeholder = "Enter Member account reference number", id = "CustomerId" })
                    <button type="button" class="btn btn-outline-secondary" onclick="searchCustomer()">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Search
                    </button>
                </div>
                <small class="text-muted d-block mt-1">💡 @GlobalOverdraftActivation.enter_or_search_the_member_account_reference_number_to_fetch_related_details.</small>
            </div>

            <div class="col-md-5">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", id = "CustomerName", @readonly = "readonly" })
                    <label>@GlobalShared.Member_name</label>
                </div>
            </div>

            <!-- 🏦 Branch Info -->
            <div class="col-md-2">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.BranchId, new { @class = "form-control", id = "BranchId", @readonly = "readonly" })
                    <label>@GlobalShared.Branch_ID</label>
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.BranchCode, new { @class = "form-control", id = "BranchCode", @readonly = "readonly" })
                    <label>@GlobalShared.Branch_Code</label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.BranchName, new { @class = "form-control", id = "BranchName", @readonly = "readonly" })
                    <label>@GlobalShared.Branch_Name</label>
                </div>
            </div>

            <!-- 🔽 Account & Config -->
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.AccountId, Enumerable.Empty<SelectListItem>(), "Select account...", new { @class = "form-select select2", id = "AccountId" })
                    <label>@GlobalOverdraftActivation.main_overdraft_account</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.OverdraftFacilityConfigId, new SelectList(ViewBag.OverdraftConfigs, "Id", "Name"), "Select config...", new { @class = "form-select select2", required = "required" })
                    <label>@GlobalOverdraftActivation.overdraft_facility_config</label>
                </div>
            </div>


            <!-- 💼 Section: Overdraft Parameters -->
            <!-- 💼 Section: Overdraft Parameters -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pt-2 pb-1">
                    <i class="mdi mdi-cash me-1"></i> @GlobalOverdraftActivation.overdraft_parameters
                </h6>
            </div>

            <!-- Pay-as-you-go Checkbox -->
            <!-- Pay-as-you-go Checkbox -->
            <div class="col-md-4">
                <div class="form-check mb-1">
                    @Html.CheckBoxFor(m => m.PayAsYouGoInterest, new { @class = "form-check-input", id = "PayAsYouGoInterest" })
                    <label class="form-check-label" for="PayAsYouGoInterest">@GlobalOverdraftActivation.pay_as_you_go</label>
                    <small class="text-muted d-block">
                        💡 @GlobalOverdraftActivation.charges_are_incurred_only_when_a_portion_of_the_overdraft_is_consumed_based_on_a_usage_percentage_as_configured.<br />
                        👉 <em>@GlobalShared.Example:</em> @GlobalOverdraftActivation.if_you_use_20000_from_a_100000_overdraft_limit_interest_applies_only_on_the_20000_used.
                    </small>
                </div>
            </div>


            <!-- Flat Interest + Interest Rate -->
            <div class="col-md-4">
                <div class="form-check mb-1">
                    @Html.CheckBoxFor(m => m.FlatInterestRate, new { @class = "form-check-input", id = "FlatInterestRate" })
                    <label class="form-check-label" for="FlatInterestRate">@GlobalShared.flat_interest</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.charges_fixed_interest_periodically_regardless_of_usage.</small>
                </div>
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.InterestRate, new { @class = "form-control", type = "number", step = "0.01", id = "InterestRate" })
                    <label>@GlobalShared.Interest_Rate (%)</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.enter_the_interest_rate_applicable_to_the_overdraft (e.g. 10%).</small>
                </div>
            </div>

            <!-- Auto Recover + Penalty Rate -->
            <div class="col-md-4">
                <div class="form-check mb-1">
                    @Html.CheckBoxFor(m => m.AutoRecoverOnDeposit, new { @class = "form-check-input", id = "AutoRecoverOnDeposit" })
                    <label class="form-check-label" for="AutoRecoverOnDeposit">@GlobalShared.auto_recover</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.automatically_settles_overdraft_when_deposits_are_received.</small>
                </div>
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.PenaltyRate, new { @class = "form-control", type = "number", step = "0.01" })
                    <label>@GlobalShared.penalty_rate (%)</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.late_repayment_penalties_applied_when_repayment_terms_are_violated.</small>
                </div>
            </div>


            <!-- 💳 Section: Salary & Recovery -->
            <!-- 💳 Section: Salary & Recovery Settings -->
            <div class="col-12 mt-4">
                <h6 class="text-primary border-bottom pt-2 pb-1">
                    <i class="mdi mdi-cash-refund me-1"></i> @GlobalOverdraftActivation.salary_recovery_settings
                </h6>
            </div>

            <!-- ✅ IsSalaryOverdraftAccount Checkbox -->
            <div class="col-md-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsSalaryOverdraftAccount, new { @class = "form-check-input", id = "IsSalaryOD", onchange = "handleSalaryODToggle()" })
                    <label class="form-check-label" for="IsSalaryOD">@GlobalOverdraftActivation.link_salary_account_to_overdraft</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.required_if_the_overdraft_depends_on_salarybased_crediting.</small>
                </div>
            </div>

            <!-- 🔗 Linked Salary Account -->
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.LinkedSalaryAccountId, new { @class = "form-control", placeholder = "Optional", id = "LinkedSalaryAccountId" })
                    <label>@GlobalOverdraftActivation.linked_salary_account_id</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.provide_the_account_to_which_salary_is_credited.</small>
                </div>
            </div>

            <!-- 💼 Recovery Source Accounts -->
            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.ListBoxFor(m => m.RecoverySourceAccountIds,
                        new MultiSelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                        new { @class = "form-select select2", id = "RecoverySourceAccountIds", multiple = "multiple" })
                    <label>@GlobalOverdraftActivation.recovery_source_accounts</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.od_will_be_autorecovered_from_these_accounts_when_funds_are_available.</small>
                </div>
            </div>


            <!-- 🔁 Section: Provisioning & Expiry -->
            <!-- 🔁 Section: Provisioning & Expiry -->
            <div class="col-12 mt-4">
                <h6 class="text-primary border-bottom pt-2 pb-1">
                    <i class="mdi mdi-timer-cog-outline me-1"></i> @GlobalOverdraftActivation.provisioning_expiry
                </h6>
            </div>

            <!-- ✅ Auto Provision Toggle -->
            <div class="col-md-4">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.AutoProvisionEnabled, new { @class = "form-check-input", id = "AutoProvisionEnabled" })
                    <label class="form-check-label" for="AutoProvisionEnabled">@GlobalOverdraftActivation.enable_auto_provision</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.automatically_replenishes_od_limit_based_on_defined_frequency.</small>
                </div>
            </div>

            <!-- 🔁 Provision Frequency - Only visible when AutoProvisionEnabled is checked -->
            <div class="col-md-4" id="ProvisionFrequencyContainer">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.AutoProvisionFrequencyInDays, new { @class = "form-control", type = "number", min = "1" })
                    <label>@GlobalOverdraftActivation.provision_frequency_days</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.how_often_in_days_the_od_limit_is_refreshed_automatically.</small>
                </div>
            </div>


            <!-- 📅 Expiry Date -->
            <div class="col-md-4">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.ProposedExpiryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    <label>@GlobalShared.Expiry_Date</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.the_proposed_date_when_this_overdraft_facility_expires.</small>
                </div>
            </div>

            <!-- 💷 Salary & Segment Info -->
            <div class="col-md-4">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.AverageSalaryAmount, new { @class = "form-control", type = "number", placeholder = "e.g. 250000" })
                    <label>@GlobalOverdraftActivation.average_monthly_salary</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.enter_the_members_average_salary_amount_this_value_helps_compute_the_eligible_overdraft_limit.</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.RequestedLimit, new { @class = "form-control", type = "number", placeholder = "e.g. 500000" })
                    <label>@GlobalShared.requested_limit</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.set_the_eligible_overdraft_limit_as_determined_by_credit_score_analysis.</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.CustomerSegment, new { @class = "form-control", placeholder = "e.g. Platinum" })
                    <label>@GlobalShared.member_segment</label>
                    <small class="text-muted d-block">💡 @GlobalOverdraftActivation.helps_apply_segmentbased_overdraft_rules_optional.</small>
                </div>
            </div>



            <!-- ✅ Submit -->
            <div class="col-12 text-end mt-4">
                <button type="submit" class="btn btn-primary px-4" title="@GlobalOverdraftActivation.submit_and_send_overdraft_activation_request_for_processing">
                    <i class="mdi mdi-send-check-outline me-2"></i> @GlobalOverdraftActivation.submit_overdraft_request
                </button>
            </div>

        </div>
    }
</div>



