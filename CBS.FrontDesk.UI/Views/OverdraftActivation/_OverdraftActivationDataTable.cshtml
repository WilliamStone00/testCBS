@using Resources
<div class="card border-light shadow-sm mb-4">
    <div class="card-header bg-primary text-white fw-semibold">
        <i class="mdi mdi-filter-outline me-2"></i> @GlobalOverdraftActivation.filter_overdraft_activation_requests
    </div>
    <div class="card-body">
        <form id="filterForm" class="row g-3 align-items-end">

            <!-- Status Filter -->
            <div class="col-md-3">
                <label class="form-label">@GlobalShared.Status</label>
                <select name="Status" class="form-select">
                    <option value="">-- @GlobalShared.All --</option>
                    <option value="Pending">@GlobalShared.Pending</option>
                    <option value="Approved">@GlobalShared.Approved</option>
                    <option value="Rejected">@GlobalShared.Rejected</option>
                    <option value="Activated">@GlobalShared.Activated</option>
                </select>
            </div>


            <!-- Branch Filter -->
            <div class="col-md-3">
                <label class="form-label">@GlobalShared.Branch</label>
                <select name="BranchId" class="form-select">
                    <option value="">-- @GlobalShared.All_Branches --</option>
                    @foreach (var branch in ViewBag.Branches as List<SelectListItem>)
                    {
                        <option value="@branch.Value">@branch.Text</option>
                    }
                </select>
            </div>

            <!-- Customer ID -->
            <div class="col-md-3">
                <label class="form-label">@GlobalShared.Customer_ID</label>
                <input type="text" name="CustomerId" class="form-control" placeholder="e.g. CUST12345" />
            </div>

            <!-- Date Range -->
            <div class="col-md-3">
                <label class="form-label">@GlobalShared.From_Date</label>
                <input type="date" name="FromDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@GlobalShared.To_Date</label>
                <input type="date" name="ToDate" class="form-control" />
            </div>

            <!-- Action Buttons -->
            <div class="col-md-12 text-end">
                <button type="button" onclick="loadOverdraftData()" class="btn btn-primary">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
                </button>
                <button type="button" onclick="resetOverdraftFilters()" class="btn btn-outline-secondary">
                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Reset
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 📋 Table Section -->
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle" id="overdraftRequestsTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Customer</th>
                        <th>@GlobalShared.Account</th>
                        <th>@GlobalShared.Branch</th>
                        <th>@GlobalShared.limit</th>
                        <th>@GlobalShared.Interest</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.requested</th>
                        <th>@GlobalShared.Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
