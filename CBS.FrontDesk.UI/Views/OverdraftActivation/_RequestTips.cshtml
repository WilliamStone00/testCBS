@using Resources
<div class="row mb-2">
    <div class="col-12">
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-light text-primary fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i> @GlobalOverdraftActivation.overdraft_activation_guidelines
                </span>
                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#overdraftGuidelinesBody">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>

            <div id="overdraftGuidelinesBody" class="collapse">
                <div class="card-body">
                    <ul class="mb-3 list-unstyled">

                        <!-- 📄 Config Reference -->
                        <li class="mb-2">
                            <i class="mdi mdi-cog-outline text-secondary me-2"></i>
                            <strong>@GlobalShared.facility_config:</strong> @Html.Raw(@GlobalOverdraftActivation.select_a_valid_overdraftfacilityconfigid_to_apply_applicable_limits_interest_rules_and_eligibility_policies).
                        </li>

                        <!-- 👤 Customer & Branch -->
                        <li class="mb-2">
                            <i class="mdi mdi-account-outline text-info me-2"></i>
                            <strong>@GlobalShared.customer_details:</strong> @Html.Raw(@GlobalOverdraftActivation.provide_valid_customerid_the_system_will_autofill_customername_and_associated_branch_details_upon_lookup).
                        </li>

                        <!-- 🏦 Primary Account -->
                        <li class="mb-2">
                            <i class="mdi mdi-bank text-success me-2"></i>
                            <strong>@GlobalShared.Primary_Account:</strong> @GlobalOverdraftActivation.choose_the_account_to_enable_overdraft_it_must_be_active_valid_and_compatible_with_the_selected_facility_config.
                        </li>

                        <!-- 💰 Limit & Interest -->
                        <li class="mb-2">
                            <i class="mdi mdi-cash-multiple text-warning me-2"></i>
                            <strong>@GlobalShared.requested_limit:</strong> @GlobalOverdraftActivation.should_not_exceed_the_configured_maximum_always_align_with_salary_or_credit_score_where_applicable.
                        </li>

                        <li class="mb-2">
                            <i class="mdi mdi-percent-outline text-danger me-2"></i>
                            <strong>@GlobalShared.interest_settings:</strong> @Html.Raw(@GlobalOverdraftActivation.specify_either_flatinterestrate_or_payasyougointerest_system_will_calculate_charges_accordingly).
                        </li>

                        <!-- 🔁 Recovery -->
                        <li class="mb-2">
                            <i class="mdi mdi-refresh-circle text-primary me-2"></i>
                            <strong>@GlobalShared.auto_recovery:</strong> @Html.Raw(@GlobalOverdraftActivation.enabling_autorecoverondeposit_allows_the_system_to_recover_overdrawn_balances_automatically_upon_deposit).
                        </li>

                        <!-- 🔗 Recovery Accounts -->
                        <li class="mb-2">
                            <i class="mdi mdi-link-variant text-muted me-2"></i>
                            <strong>@GlobalOverdraftActivation.recovery_source_accounts:</strong> @GlobalOverdraftActivation.multiselect_list_of_accounts_to_recover_from_usually_includes_main_savings_salary_or_designated_income_channels.
                        </li>

                        <!-- 🧾 Salary Based OD -->
                        <li class="mb-2">
                            <i class="mdi mdi-briefcase-account text-info me-2"></i>
                            <strong>@GlobalOverdraftActivation.salary_based_od:</strong> @Html.Raw(@GlobalOverdraftActivation.if_issalaryoverdraftaccount_is_enabled_a_linkedsalaryaccountid_must_be_provided_for_reference).
                        </li>

                        <!-- 🔁 Auto Provisioning -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-sync text-success me-2"></i>
                            <strong>@GlobalShared.auto_provision:</strong> @Html.Raw(@GlobalOverdraftActivation.optional_feature_if_enabled_overdraft_is_reprovisioned_every_autoprovisionfrequencyindays_useful_for_recurring_credit_lines).
                        </li>

                        <!-- 📅 Expiry Logic -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-alert text-warning me-2"></i>
                            <strong>@GlobalShared.Expiry_Date:</strong> @GlobalOverdraftActivation.required_field_that_defines_the_duration_the_overdraft_is_active_extensions_may_require_reapproval.
                        </li>

                        <!-- 🧮 Salary Guidance -->
                        <li class="mb-2">
                            <i class="mdi mdi-cash-100 text-success me-2"></i>
                            <strong>@GlobalShared.average_salary:</strong> @GlobalOverdraftActivation.mandatory_for_salarybased_overdrafts_used_in_calculating_max_allowed_limit_and_eligibility.
                        </li>

                        <!-- ⚠️ Compliance Reminder -->
                        <li class="mb-2">
                            <i class="mdi mdi-alert-octagon-outline text-danger me-2"></i>
                            <strong>@GlobalShared.Important:</strong> @GlobalOverdraftActivation.ensure_all_submitted_requests_follow_internal_credit_risk_regulatory_and_approval_workflow_protocols.
                        </li>
                    </ul>

                    <hr class="my-3" />

                    <p class="text-muted mb-0">
                        <i class="mdi mdi-shield-check-outline me-2"></i>
                        @GlobalOverdraftActivation.validate_overdraft_parameters_with_internal_policy_product_definition_and_risk_assessment_teams_before_approval.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
