<div class="row mb-2">
    <div class="col-12">
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-light text-primary fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i> Overdraft Activation Guidelines
                </span>
                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#overdraftGuidelinesBody">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>

            <div id="overdraftGuidelinesBody" class="collapse">
                <div class="card-body">
                    <ul class="mb-3 list-unstyled">

                        <!-- 📄 Config Reference -->
                        <li class="mb-2">
                            <i class="mdi mdi-cog-outline text-secondary me-2"></i>
                            <strong>Facility Config:</strong> Select a valid <code>OverdraftFacilityConfigId</code> to apply applicable limits, interest rules, and eligibility policies.
                        </li>

                        <!-- 👤 Customer & Branch -->
                        <li class="mb-2">
                            <i class="mdi mdi-account-outline text-info me-2"></i>
                            <strong>Customer Details:</strong> Provide valid <code>CustomerId</code>. The system will auto-fill <code>CustomerName</code> and associated branch details upon lookup.
                        </li>

                        <!-- 🏦 Primary Account -->
                        <li class="mb-2">
                            <i class="mdi mdi-bank text-success me-2"></i>
                            <strong>Primary Account:</strong> Choose the account to enable overdraft. It must be active, valid, and compatible with the selected facility config.
                        </li>

                        <!-- 💰 Limit & Interest -->
                        <li class="mb-2">
                            <i class="mdi mdi-cash-multiple text-warning me-2"></i>
                            <strong>Requested Limit:</strong> Should not exceed the configured maximum. Always align with salary or credit score where applicable.
                        </li>

                        <li class="mb-2">
                            <i class="mdi mdi-percent-outline text-danger me-2"></i>
                            <strong>Interest Settings:</strong> Specify either <code>FlatInterestRate</code> or <code>PayAsYouGoInterest</code>. System will calculate charges accordingly.
                        </li>

                        <!-- 🔁 Recovery -->
                        <li class="mb-2">
                            <i class="mdi mdi-refresh-circle text-primary me-2"></i>
                            <strong>Auto Recovery:</strong> Enabling <code>AutoRecoverOnDeposit</code> allows the system to recover overdrawn balances automatically upon deposit.
                        </li>

                        <!-- 🔗 Recovery Accounts -->
                        <li class="mb-2">
                            <i class="mdi mdi-link-variant text-muted me-2"></i>
                            <strong>Recovery Source Accounts:</strong> Multi-select list of accounts to recover from. Usually includes main savings, salary, or designated income channels.
                        </li>

                        <!-- 🧾 Salary Based OD -->
                        <li class="mb-2">
                            <i class="mdi mdi-briefcase-account text-info me-2"></i>
                            <strong>Salary-Based OD:</strong> If <code>IsSalaryOverdraftAccount</code> is enabled, a <code>LinkedSalaryAccountId</code> must be provided for reference.
                        </li>

                        <!-- 🔁 Auto Provisioning -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-sync text-success me-2"></i>
                            <strong>Auto-Provision:</strong> Optional feature. If enabled, overdraft is re-provisioned every <code>AutoProvisionFrequencyInDays</code>. Useful for recurring credit lines.
                        </li>

                        <!-- 📅 Expiry Logic -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-alert text-warning me-2"></i>
                            <strong>Expiry Date:</strong> Required field that defines the duration the overdraft is active. Extensions may require re-approval.
                        </li>

                        <!-- 🧮 Salary Guidance -->
                        <li class="mb-2">
                            <i class="mdi mdi-cash-100 text-success me-2"></i>
                            <strong>Average Salary:</strong> Mandatory for salary-based overdrafts. Used in calculating max allowed limit and eligibility.
                        </li>

                        <!-- ⚠️ Compliance Reminder -->
                        <li class="mb-2">
                            <i class="mdi mdi-alert-octagon-outline text-danger me-2"></i>
                            <strong>Important:</strong> Ensure all submitted requests follow internal credit risk, regulatory, and approval workflow protocols.
                        </li>
                    </ul>

                    <hr class="my-3" />

                    <p class="text-muted mb-0">
                        <i class="mdi mdi-shield-check-outline me-2"></i>
                        Validate overdraft parameters with internal policy, product definition, and risk assessment teams before approval.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
