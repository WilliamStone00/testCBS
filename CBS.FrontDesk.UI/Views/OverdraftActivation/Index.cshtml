    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light shadow-sm">
                <div class="card-body text-center">
                    <h3 class="card-title text-primary">
                        <i class="mdi mdi-bank-check me-2"></i> @GlobalOverdraftActivation.overdraft_activation_service
                    </h3>
                    <p class="card-text text-secondary fs-6">
                        @GlobalOverdraftActivation.submit_and_manage_overdraft_activation_requests_linked_to_customer_accounts_these_activations_are_governed_by_preconfigured_facility_rules.
                    </p>
                    <p class="card-text text-muted small">
                        @GlobalOverdraftActivation.ensure_customer_eligibility_configuration_alignment_and_correct_data_inputs_before_approval.
                    </p>
                    <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
                </div>
            </div>
        </div>
    </div>
    <!-- 💡 Guidance Tip (Collapsible Section) -->
    @Html.Partial("_RequestTips")

    <!-- 🔧 Action Buttons -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap">

                    <div class="mb-2 mb-md-0">
                        <span class="fw-semibold text-primary">
                            <i class="mdi mdi-cog-outline me-1"></i> @GlobalOverdraftActivation.manage_overdraft_requests
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <a type="button"
                           onclick="LoadOverdraftRequests()"
                           class="btn btn-outline-primary btn-sm"
                           data-bs-toggle="tooltip"
                           title="@GlobalOverdraftActivation.reload_and_display_all_overdraft_activation_requests">
                            <i class="mdi mdi-refresh me-1"></i> @GlobalShared.reload_list
                        </a>

                        <button onclick="AddORUpdateGen(null,'overdraftRequestDataTableContainer','_OverdraftActivationRequestForm','new','Overdraft')"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="tooltip"
                                title="Submit a new overdraft request">
                            <i class="mdi mdi-plus-circle-outline me-1"></i> @GlobalShared.new_request
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- 📋 Overdraft Requests Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div id="overdraftRequestDataTableContainer">
                        @Html.Partial("_OverdraftActivationRequestForm")
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function toggleProvisionFrequency() {
            const enabled = $('#AutoProvisionEnabled').is(':checked');
            $('#ProvisionFrequencyContainer').toggle(enabled);
        }

   
        function toggleInterestMode() {
            const isFlat = $('#FlatInterestRate').is(':checked');
            const isPayAsYouGo = $('#PayAsYouGoInterest').is(':checked');

            if (isFlat) {
                // Hide Pay-as-you-go
                $('#PayAsYouGoInterest').prop('checked', false).closest('.form-check').hide();

                // Show InterestRate field and its parent column
                $('#InterestRate').closest('.col-md-4').show();

                // Show FlatInterest again just in case (could be hidden previously)
                $('#FlatInterestRate').closest('.form-check').show();
            }
            else if (isPayAsYouGo) {
                // Hide Flat Interest checkbox
                $('#FlatInterestRate').prop('checked', false).closest('.form-check').hide();

                // Clear and hide Interest Rate field
                $('#InterestRate').val('');
                $('#InterestRate').closest('.col-md-4').hide();

                // Show Pay-as-you-go checkbox just in case
                $('#PayAsYouGoInterest').closest('.form-check').show();
            }
            else {
                // If neither is selected, show both checkboxes and interest rate field
                $('#FlatInterestRate').closest('.form-check').show();
                $('#PayAsYouGoInterest').closest('.form-check').show();
                $('#InterestRate').closest('.col-md-4').show();
            }
        }

        function handleSalaryODToggle() {
            const isChecked = $('#IsSalaryOD').is(':checked');
            if (!isChecked) {
                $('#LinkedSalaryAccountId').val('');
            }
            $('#AutoProvisionEnabled').on('change', toggleProvisionFrequency);
            toggleProvisionFrequency(); // initialize on page load
        }

        $(document).ready(function () {
            $('#FlatInterestRate, #PayAsYouGoInterest').on('change', toggleInterestMode);
            toggleInterestMode(); // Initial state on load
        });


        function searchCustomer() {
            const customerId = $('#CustomerId').val();
            if (!customerId) return alert("Enter a Customer ID first.");

            $.get('/OverdraftActivation/GetCustomerAccountsAndDetails', { customerId }, function (data) {
                if (data.success) {
                    $('#CustomerName').val(data.customerName);
                    $('#BranchId').val(data.branchId);
                    $('#BranchCode').val(data.branchCode);
                    $('#BranchName').val(data.branchName);

                    let options = '<option value="">Select account...</option>';
                    data.accounts.forEach(acc => {
                        options += `<option value="${acc.id}" data-accountnumber="${acc.accountNumber}">${acc.accountNumber} - ${acc.productName}</option>`;
                    });

                    $('#AccountId').html(options);
                    $('#RecoverySourceAccountIds').html(options);

                    // Automatically set Linked Salary Account if Salary OD is checked
                    handleSalaryODToggle();
                } else {
                    alert(data.message || "Customer not found.");
                }
            });
        }

        function handleSalaryODToggle() {
            const isSalaryOD = $('#IsSalaryOD').is(':checked');
            const selectedAccount = $('#AccountId').find(':selected');
            const accountNumber = selectedAccount.data('accountnumber');

            if (isSalaryOD && accountNumber) {
                $('#LinkedSalaryAccountId').val(accountNumber);
            } else {
                $('#LinkedSalaryAccountId').val('');
            }
        }

        // Update on primary account change
        $('#AccountId').on('change', function () {
            handleSalaryODToggle();
        });
    </script>

