@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
@{
    ViewBag.Title = "Pending Accounting Entries";
}

<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-bank-plus me-2"></i>
                Pending Journal Entries
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="table-responsive mb-3">
                        <div class="change-group">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover table-bordered table-sm" id="myDataTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Code</th>
                                            <th>Reference</th>
                                            <th>IssuedBy</th>
                                            <th>IssuedDate</th>
                                            <th>Purpose</th>
                                            <th>Amount(XFA)</th>
                                            <th>Status</th>

                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>



                                        @foreach (var item in Model.PostedEntries)
                                        {
                                            <tr>
                                                <td style="width:5%" id="@item.Id-BranchCode">@item.BranchCode</td>
                                                <td style="width:20%" id="@item.Id-Reference">@item.EntryDetail[0].Reference</td>
                                   
                                                <td style="width:20%" id="@item.Id-CreatedBy">@(item.CreatedBy + "*" + (item.CreatedDate ?? "None") + "*" + (item.PostingSource ?? ""))</td>

                                                <td style="width:19%" id="@item.Id-CreatedDate">@item.CreatedDate</td>
                                                <td style="width:1%" id="@item.Id-Description">@(item.Description + "*" + (item.ApprovedBy ?? "None") + "*" + (item.ApprovedDate ?? ""))</td>
                                                <td style="width:15%" id="@item.Id-Amount">@item.Amount.ToString("N") </td>

                                                @if (@item.Status.ToLower() == "pending")
                                                {

                                                    <td style="width:10%" id="@item.Id-Status">

                                                        <span class="badge rounded-pill bg-dark fs-6">
                                                            <i class="fas fa-pencil-alt"></i> @item.Status.ToUpper()
                                                        </span>
                                                    </td>
                                                }
                                                else
                                                {
                                                    if (@item.Status.ToLower() == "rejected")
                                                    {
                                                        <td style="width: 10%" id="@item.Id-Status">

                                                            <span class="badge rounded-pill bg-danger fs-6">
                                                                <i class="fas fa-times-circle"></i>@item.Status.ToUpper()
                                                            </span>
                                                        </td>

                                                    }
                                                    else
                                                    {
                                                        <td style="width: 10%" id="@item.Id-Status">

                                                            <span class="badge rounded-pill bg-success fs-6">
                                                                <i class="fas fa-check-circle"></i> @item.Status.ToUpper()
                                                            </span>
                                                        </td>
                                                    }

                                                }

                                                @if (@item.Status.ToLower() == "pending")
                                                {
                                                    <td style="width:10%">
                                                        <a href="#" type="button" onclick="loadPostedEntriesByReference('@item.Id')" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#largeModal">
                                                            Approve/Reject
                                                        </a>

                                                    </td>
                                                }
                                                else
                                                {

                                                    <td style="width:10%">
                                                        <a href="#" type="button" onclick="loadPostedEntriesByReference('@item.Id');" class="btn btn-default" data-bs-toggle="modal" data-bs-target="#largeModal">
                                                            View
                                                        </a>
                                                    </td>
                                                }


                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @Html.Partial("_ReferenceDataEntries")
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>



@section Scripts { @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/AutoJournalEntry.js"></script>
<!-- Confirmation Modal -->

}