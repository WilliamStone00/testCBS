<div class="modal fade" id="largeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="exampleModalLabel3"> Loading ...</h4>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>
            <div class="modal-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th colspan="2">  <h5 class="card-title" style="text-justify:auto">Issuer Information</h5></th>

                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <tr>
                            <td>Issuer</td>
                            <td id="issuer"> loading ... </td>
                        </tr>
                        <tr>
                            <td>Posting Source</td>
                            
                            <td id="branchCode">loading ...</td>
                        </tr>
                        <tr>
                            <td>Date Issued</td>
                            <td id="dateIssued">loading ...</td>
                        </tr>
                        <tr>
                            <td>Journal Entry Status</td>
                            <td id="status">loading ...</td>
                        </tr>
                        <tr>
                            <td>Approved By</td>
                            <td id="approvedBy">loading ...</td>
                        </tr>
                        <tr>
                            <td>Approved Date</td>
                            <td id="approvedDate">loading ...</td>
                        </tr>
                        <tr>
                            <td>Purpose</td>
                            <td id="description">loading ...</td>
                        </tr>
                        <tr>

                            <td colspan="2">  <h5 class="card-title" style="text-justify:auto" id="referenceID">Journal Entries Reference:loading</h5></td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-hover" id="ReferenceEntriesDataTable">
                    <thead class="table-light">
                        <tr>
                            <th>Account Number</th>
                            <th>Debit(XFA)</th>
                            <th>Credit(XFA)</th>

                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <input type="hidden" id="selectedId" value="" />
                <input type="hidden" id="status_button" value="" />
               
            </div>
            <div id="under_review">
                <div class="card-header">

                    <form id="myCommentForm">
                        <h5 class="card-title">
                            DECISION STATEMENT : <textarea class="form-control textbox" cols="20" data-val="true" data-val-required="The comment field is required." id="comment_description" name="EntryDescription.Description" rows="2"></textarea>
                            <span class="field-validation-valid text-danger" data-valmsg-for="EntryDescription.Description" data-valmsg-replace="true"></span>
                        </h5>
               
                        <div class="modal-footer">
                        
                            <button type="button" id="Reject" onclick="ApprovePostedEntries(false)" class="btn btn-danger" data-bs-dismiss="modal">
                                Reject
                            </button>
                            <button type="button" id="Approve" onclick="ApprovePostedEntries(true)" class="btn btn-primary" data-bs-dismiss="modal">
                                Approve
                            </button>
                        </div>

                    </form>
                </div>
                   
            </div>
            <div id="rejected">
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                        Close
                    </button>
                </div> 
            </div>
            <div id="approved">
                <div class="modal-footer">

                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" id="print" onclick="PrintDataEntries(false)" class="btn btn-primary">
                        <i class="mdi mdi-printer"></i>  Print
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

