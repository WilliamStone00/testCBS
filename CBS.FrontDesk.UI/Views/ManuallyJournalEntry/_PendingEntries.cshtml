@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
<div class="table-responsive mb-3">
    <hr />
    <div class="change-group">
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered table-sm" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Reference</th>
                        <th>IssuedBy</th>
                        <th>IssuedDate</th>
                        <th>Purpose</th>
                        <th>Amount(XFA)</th>
                        <th>Status</th>

                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>



                    @foreach (var item in Model.PostedEntriesX)
                    {
                        <tr>
                            <td style="width:5%" id="@item.Id-BranchCode">@item.BranchCode</td>
                            <td style="width:20%" id="@item.Id-Reference">@item.EntryDetail[0].Reference</td>

                            <td style="width:20%" id="@item.Id-CreatedBy">@(item.CreatedBy + "*" + (item.CreatedDate.ToString("dd-MM-yy HH:mm") ?? "None") + "*" + (item.PostingSource ?? ""))</td>

                            <td style="width:19%" id="@item.Id-CreatedDate">@item.CreatedDate</td>
                            <td style="width:1%" id="@item.Id-Description">@(item.Description + "*" + (item.ApprovedBy ?? "None") + "*" + (item.ApprovedDate.ToLongDateString()))</td>
                            <td style="width:15%" id="@item.Id-Amount">@item.Amount.ToString("N") </td>

                            @if (@item.Status.ToLower() == "pending")
                            {

                                <td style="width:10%" id="@item.Id-Status">

                                    <span class="badge rounded-pill bg-dark fs-6">
                                        <i class="fas fa-pencil-alt"></i> @item.Status.ToUpper()
                                    </span>
                                </td>
                            }
                            else
                            {
                                if (@item.Status.ToLower() == "rejected")
                                {
                                    <td style="width: 10%" id="@item.Id-Status">

                                        <span class="badge rounded-pill bg-danger fs-6">
                                            <i class="fas fa-times-circle"></i>@item.Status.ToUpper()
                                        </span>
                                    </td>

                                }
                                else
                                {
                                    <td style="width: 10%" id="@item.Id-Status">

                                        <span class="badge rounded-pill bg-success fs-6">
                                            <i class="fas fa-check-circle"></i> @item.Status.ToUpper()
                                        </span>
                                    </td>
                                }

                            }

                            @if (@item.Status.ToLower() == "pending")
                            {
                                <td style="width:10%">
                                    <a href="#" type="button" onclick="loadPostedEntriesByReference('@item.Id')" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#largeModal">
                                        Approve/Reject
                                    </a>

                                </td>
                            }
                            else
                            {

                                <td style="width:10%">
                                    <a href="#" type="button" onclick="loadPostedEntriesByReference('@item.Id');" class="btn btn-default" data-bs-toggle="modal" data-bs-target="#largeModal">
                                        View
                                    </a>
                                </td>
                            }


                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.Partial("_ReferenceDataEntries")
    </div>
</div>
