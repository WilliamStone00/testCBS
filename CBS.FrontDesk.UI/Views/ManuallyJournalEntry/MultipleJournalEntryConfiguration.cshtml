@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet

@{
    ViewBag.Title = "Accounting Rule";
}

<div class="card mb-12 shadow-lg rounded">
    <div class="accordion mt-3" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingThree">
                <button type="button"
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#accordionThree"
                        aria-expanded="false"
                        aria-controls="accordionThree">
                    <i class="tf-icons mdi mdi-typewriter me-7"></i>  Setting Accounting Event Entry Rule
                </button>
            </h2>
            <div id="accordionThree"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingThree"
                 data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="row justify-content-end">
                        @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                        {
                            <div class="demo-inline-spacing text-end">
                                <a type="button" onclick="LoadDataTableGeneration('ManuallyJournalEntry','AccountingEventxxDataTable','_MultipleJournalEntryClientData','datalistingview_accountingEventRule',0,'accountingEventRule','list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                </a>
                                <a type="button" onclick="AddORUpdateGen(null,'datalistingview_accountingEventRule','_CreateAccountingEventRule','new','ManuallyJournalEntry','accountingEventRule')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
                                    <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                </a>

                            </div>
                        }
  
                    </div>
                    <br />
                    <div id="datalistingview_accountingEventRule">
                        @Html.Partial("_CreateAccountingEventRule")
                    </div>
                </div>
            </div>
        </div>
     
    </div>

</div>
    @section Scripts { @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/main.js/AutoJournalEntry.js"></script>
    }

 