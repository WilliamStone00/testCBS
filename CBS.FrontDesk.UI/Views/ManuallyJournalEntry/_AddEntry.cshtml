@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
@using Resources
@if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
{
    {
        ViewBag.Error = @GlobalManuallyJournalEntry.Journal_Entry_at_this_level_can_only _be_passed_from_branch_office_terminal;
    }

    @Html.Partial("_GeneralErrorDiv");
}
else
{
    using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <input type="hidden" name="ServiceOption" value="EntryTempData" id="ServiceOption" />
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <div class="col-12">
                <div class="card">

                    <div class="card-header">

                        <h5 class="card-title">
                            @GlobalManuallyJournalEntry.ReferenceId: @Html.TextBoxFor(m => m.EntryTempData.Reference, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.EntryTempData.Reference, "", new { @class = "text-danger" })

                        </h5>
                    </div>
                    <div class="row card-body">


                        <div class="row mt-2 gy-4">

                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.EntryTempData.AccountId, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "---"+ @GlobalManuallyJournalEntry.SelectAccount+"---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.EntryTempData.AccountId, "", new { @class = "text-danger" })
                                    <label>@GlobalManuallyJournalEntry.AccountName</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.EntryTempData.AccountBalance, new { @class = "form-control account_balance" })SelectBookingDirection
                                    @Html.HiddenFor(m => m.EntryTempData.AccountName, new { @class = "form-control account_name" })
                                    @Html.HiddenFor(m => m.EntryTempData.AccountNumber, new { @class = "form-control account_number" })
                                    <label>@GlobalManuallyJournalEntry.AccountBalance</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">

                                    @Html.DropDownListFor(m => m.EntryTempData.BookingDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---"+ @GlobalManuallyJournalEntry.SelectBookingDirection + "---", new { @class = "form-control select2",@id= "EntryBookingDirection", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.EntryTempData.BookingDirection, "", new { @class = "text-danger" })
                                    <label>@GlobalManuallyJournalEntry.BookingDirection</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.HiddenFor(m => m.EntryTempData.Description, new { @class = "form-control booking_direction" })
                                    @Html.TextBoxFor(m => m.EntryTempData.Amount, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.EntryTempData.Amount, "", new { @class = "text-danger" })
                                    <label>@GlobalManuallyJournalEntry.Amount</label>
                                </div>
                            </div>

                        </div>
                        <div class="mt-4">
                            <button type="button" onclick="collectEntryData()" class="btn btn-primary">
                                @GlobalManuallyJournalEntry.AddEntry&nbsp; &nbsp; <i class="mdi mdi-plus-box-multiple"></i>
                            </button>
                            <input type="hidden" name="Action" value="insert" id="Action" />

                        </div>

                    </div>
                    <hr />

                </div>
            </div>
        </div>

    }
}







