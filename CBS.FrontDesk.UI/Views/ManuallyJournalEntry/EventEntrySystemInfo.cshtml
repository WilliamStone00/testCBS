
@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
@{
    ViewBag.Title = "Accounting Event -Update";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0"><i class="fas fa-cogs"></i> Accounting Event Entry Rule Settings</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <div id="datalistingview_AddEntry">
                    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.HiddenFor(model => model.AccountingEventRule.Id)
                        <input type="hidden" name="ServiceOption" value="accountingRule" id="ServiceOptionn" />

                        <div class="row">
                            <div class="col-md-4">
                                <fieldset class="border p-3 rounded">
                                    <legend class="w-auto text-primary fw-bold">
                                        <i class="fas fa-database"></i> Event Entry Metadata
                                    </legend>

                                    <div class="mb-3">
                                        <label class="form-label">Event Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-clipboard"></i></span>
                                            @Html.TextBoxFor(m => m.AccountingEventRule.EventName, new { @class = "form-control", @placeholder = "Enter Event Name" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.AccountingEventRule.EventName, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        @Html.TextAreaFor(m => m.AccountingEventRule.Description, new { @class = "form-control", @style = "height: 100px;", @placeholder = "Enter description" })
                                        @Html.ValidationMessageFor(m => m.AccountingEventRule.Description, "", new { @class = "text-danger" })
                                    </div>
                                </fieldset>
                            </div>

                            <div class="col-md-8">
                                <fieldset class="border p-3 rounded">
                                    <legend class="w-auto text-primary fw-bold">
                                        <i class="fas fa-file-invoice-dollar"></i> Accounting Entry Rules
                                    </legend>

                                    <div class="table-responsive">
                                        <table id="AccountingRulebasketTable" class="table table-hover table-bordered">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Chart of Account</th>
                                                    <th>Booking Direction</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                        <button type="button" id="addEntry" class="btn btn-primary btn-sm">
                                            <i class="fas fa-plus-circle"></i> Add Entry
                                        </button>
                                    </div>
                                </fieldset>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn btn-success" onclick="saveForm()">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts { @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/UpdateAccountingRules.js"></script>

}
