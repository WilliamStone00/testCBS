@using Resources
<div class="modal fade" id="largeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="exampleModalLabel3"> @GlobalShared.Loading ...</h4>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>
            <div class="modal-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th colspan="2">  <h5 class="card-title" style="text-justify:auto">@GlobalShared.issuer_information</h5></th>

                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <tr>
                            <td>@GlobalShared.issuer</td>
                            <td id="issuer"> @GlobalShared.Loading ... </td>
                        </tr>
                        <tr>
                            <td>@GlobalShared.posting_source</td>

                            <td id="branchCode">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>
                            <td>@GlobalShared.Date_issued</td>
                            <td id="dateIssued">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>
                            <td>@GlobalManuallyJournalEntry.journal_entry_status</td>
                            <td id="status">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>
                            <td>@GlobalShared.Approved_by</td>
                            <td id="approvedBy">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>
                            <td>@GlobalShared.Approved_Date</td>
                            <td id="approvedDate">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>
                            <td>@GlobalShared.Purpose</td>
                            <td id="description">@GlobalShared.Loading ...</td>
                        </tr>
                        <tr>

                            <td colspan="2">  <h5 class="card-title" style="text-justify:auto" id="referenceID">@GlobalManuallyJournalEntry.journal_entries_reference_loading</h5></td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-hover" id="ReferenceEntriesDataTable">
                    <thead class="table-light">
                        <tr>
                            <th>@GlobalShared.Account_Number</th>
                            <th>@GlobalShared.Debit (XFA)</th>
                            <th>@GlobalShared.Credit (XFA)</th>

                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <input type="hidden" id="selectedId" value="" />
                <input type="hidden" id="status_button" value="" />

            </div>
            <div id="under_review">
                <div class="card-header">

                    <form id="myCommentForm">
                        <h5 class="card-title">
                            @GlobalManuallyJournalEntry.decision_statement : <textarea class="form-control textbox" cols="20" data-val="true" data-val-required="@GlobalManuallyJournalEntry.the_comment_field_is_required." id="comment_description" name="EntryDescription.Description" rows="2"></textarea>
                            <span class="field-validation-valid text-danger" data-valmsg-for="EntryDescription.Description" data-valmsg-replace="true"></span>
                        </h5>

                        <div class="modal-footer">
                            <button type="button" id="Reject" onclick="ApprovePostedEntries(false)" class="btn btn-danger" data-bs-dismiss="modal">
                                @GlobalShared.Reject
                            </button>
                            <button type="button" id="Approve" onclick="ApprovePostedEntries(true)" class="btn btn-primary" data-bs-dismiss="modal">
                                @GlobalShared.Approve
                            </button>
                        </div>

                    </form>
                </div>

            </div>
            <div id="rejected">
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @GlobalShared.Close
                    </button>
                </div>
            </div>
            <div id="approved">
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @GlobalShared.Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

