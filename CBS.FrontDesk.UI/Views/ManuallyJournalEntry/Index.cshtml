@model CBS.FrontDesk.Data.Entity.Accounting.ManuallyJournalEntryDataSet
    @using Resources
@{
    ViewBag.Title = "ManuallyJournalEntry";
}


<div class="card mb-12">
    <div class="card-header">
        <h5 class="card-title mb-0">@GlobalManuallyJournalEntry.initiate_journal_entry</h5>
    </div>
    <div class="card-body">
        <div class="row">

            <!-- Navigation -->
            <div class="col-12 col-md-3  card-separator">

                <div id="datalistingview_AddEntry">

                    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <input type="hidden" name="ServiceOption" value="EntryTempData" id="ServiceOption" />
                        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title">
                                            Reference: @Html.TextBoxFor(m => m.EntryTempData.Reference, new { @class = "form-control shadow-input-boxes" })
                                            @Html.ValidationMessageFor(m => m.EntryTempData.Reference, "", new { @class = "text-danger" })
                                        </h5>
                                    </div>
                                    <div class="row card-body">
                                        <div class="row mt-2 gy-4">
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.EntryTempData.BranchId, new SelectList(ViewBag.ListOfEligibleBranch == null ? "" : ViewBag.ListOfEligibleBranch, "Text", "Value"), "---" + @GlobalManuallyJournalEntry.select_eligible_branches + "---", new { @class = "form-control select2 shadow-input-boxes", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.EntryTempData.BranchId, "", new { @class = "text-danger" })
                                                    <label>@GlobalShared.Branch_ID</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.EntryTempData.AccountId, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "---" + @GlobalShared.Select_account + "---", new { @class = "form-control select2 shadow-input-boxes", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.EntryTempData.AccountId, "", new { @class = "text-danger" })
                                                    <label>@GlobalShared.Account_Name</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.EntryTempData.AccountBalance, new { @class = "form-control shadow-input-boxes", @value = "", @readonly = true })

                                                    @Html.ValidationMessageFor(m => m.EntryTempData.AccountBalance, "", new { @class = "text-danger" })
                                                    <label>@GlobalShared.Current_balance</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(model => model.EntryTempData.ValueDate, new { @class = "form-control date-picker", placeholder = @GlobalShared.From_Date })
                                                    @Html.ValidationMessageFor(model => model.EntryTempData.ValueDate, "", new { @class = "text-danger" })
                                                    <label>@GlobalManuallyJournalEntry.value_date</label>
                                                </div>
                                            </div>
                                            <input type="hidden" name="EntryTempData.AccountCategoryId" id="EntryTempData_AccountCategoryId" value="" />
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.EntryTempData.BookingDirection, new SelectList(ViewBag.BookingDirections == null ? "" : ViewBag.BookingDirections, "Text", "Value"), "---" + @GlobalShared.select_direction + "---", new { @class = "form-control select2 shadow-input-boxes", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.EntryTempData.BookingDirection, "", new { @class = "text-danger" })
                                                    <label>@GlobalManuallyJournalEntry.booking_direction</label>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">

                                                    @Html.TextBoxFor(m => m.EntryTempData.Amount, new { @class = "form-control shadow-input-boxes" })
                                                    @Html.ValidationMessageFor(m => m.EntryTempData.Amount, "", new { @class = "text-danger" })
                                                    <label>@GlobalShared.Amount</label>
                                                </div>
                                            </div>

                                            <div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextAreaFor(m => m.EntryTempData.Description, new { @class = "form-control shadow-input-boxes", @style = "height: 100px;" })
                                                    @Html.ValidationMessageFor(m => m.EntryTempData.Description, "", new { @class = "text-danger" })
                                                    <label>@GlobalShared.Reason</label>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.HiddenFor(m => m.EntryTempData.AccountName, new { @class = "form-control" })
                                        @Html.HiddenFor(m => m.EntryTempData.AccountNumber, new { @class = "form-control" })
                                        <div class="mt-4">
                                            <button type="button" onclick="addToBasket()" class="btn btn-primary addToBasket">
                                                @GlobalShared.add_entry &nbsp; &nbsp; <i class="mdi mdi-plus-box-multiple"></i>
                                            </button>
                                            <input type="hidden" name="Action" value="insert" id="Action" />
                                        </div>
                                    </div>
                                    <hr />
                                </div>
                            </div>
                        </div>
                    }


                </div>

            </div>
            <!-- Navigation Body -->
            <div class="col-12 col-md-9 ">
                <div class="col-12 col-md-8 ">



                </div>
                <div class="tab-content  card-separator">
                    <br />
                    <h2 id="basket_Label"></h2>
                    <table id="DataEntrybasketTable" class="display" style="width:100%">
                        <thead>
                            <tr>
                                <th>@GlobalShared.AccountNumber</th>
                                <th>@GlobalShared.Account_Name</th>
                                <th>@GlobalShared.Description</th>
                                <th>@GlobalShared.Debit</th>
                                <th>@GlobalShared.Credit</th>
                                <th>@GlobalShared.Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <thead>
                            <tr>
                     
                                <th colspan="2">@GlobalShared.Total_Debit:<p id="totalDebit"></p></th>
                                <th colspan="2">@GlobalShared.Total_Credit:<p id="totalCredit"></p></th>
                                <th colspan="2">@GlobalShared.Difference:<p id="balance"></p></th>
                            </tr>
                        </thead>
                    </table>
                    <div class="shift-right">
                        <button type="button" onclick="submitBasket()" class="btn btn-primary" id="saveToDB">
                            @GlobalShared.post_entries&nbsp; &nbsp; <i class="mdi mdi-database"></i>
                        </button>

                        <br />
                    </div>

                </div>


            </div>
        </div>
    </div>
</div>
    @section Scripts { @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/main.js/ManualJournalEntries.js"></script>
    <!-- Confirmation Modal -->

    }


 
