@model CBS.FrontDesk.Data.Entity.LoanConf.LoanTerm
<div class="card-body">
    @using (Html.BeginForm("Create", "LoanTerm", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(model => model.Id)
        <div class="row mt-3 gy-4">
            <fieldset class="fieldset-custom">
                <!-- Name Field -->
                <div class="col-md-12 mb-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        <label>Name</label>
                    </div>
                </div>
                <!-- Min and Max Fields in the Same Row -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.MinInMonth, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.MinInMonth, "", new { @class = "text-danger" })
                            <label>Minimum value in months</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.MaxInMonth, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.MaxInMonth, "", new { @class = "text-danger" })
                            <label>Maximum value in months</label>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <!-- Buttons -->
        <div class="mt-4 text-end">
            @if (ViewBag.Key != null)
            {
                <button type="submit" class="btn btn-primary me-2">Update</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <button type="reset" class="btn btn-outline-secondary">Reset</button>
            }
        </div>
    }
</div>
