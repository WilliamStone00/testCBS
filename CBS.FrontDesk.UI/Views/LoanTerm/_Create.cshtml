@model CBS.FrontDesk.Data.Entity.LoanConf.LoanTerm
@using Resources

@{
    var isEdit = !string.IsNullOrWhiteSpace(Model.Id);
    var action = isEdit ? "Update" : "Create";
    var controller = "LoanTerm";
    var formId = isEdit ? "loanTermEditForm" : "loanTermCreateForm";
}

<div class="modal-header">
  
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="col-12">
    <div class="card bg-light mb-2 shadow-sm">
        <div class="card-body text-center">
            <h5 class="modal-title text-primary">
                <i class="mdi mdi-bank-transfer me-2"></i>
                @(isEdit ? GlobalShared.Edit : GlobalShared.AddNew) @GlobalShared.Loan_Term
            </h5>
               <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
        </div>
    </div>
</div>

<div class="modal-body">
        @using (Html.BeginForm("Create", "LoanTerm", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {

            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)

            <div class="row gy-3">
                <div class="col-md-12">
                    <div class="form-floating">
                        @Html.DropDownListFor(m => m.TermKind,
                            (IEnumerable<SelectListItem>)ViewBag.TermKind,
                            "Select Term Kind",
                            new { @class = "form-control select2", required = "required" })
                        <label class="form-label">@GlobalLoanTerm.term_kind</label>
                        @Html.ValidationMessageFor(m => m.TermKind, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.NameEn,
                            new { @class = "form-control", placeholder = "English Name", required = "required", maxlength = "200" })
                        <label >@GlobalShared.Name En</label>
                        @Html.ValidationMessageFor(m => m.NameEn, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.NameFr,
                            new { @class = "form-control", placeholder = "French Name", required = "required", maxlength = "200" })
                        <label >@GlobalShared.Name Fr</label>
                        @Html.ValidationMessageFor(m => m.NameFr, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.MinInMonth,
                            new { @class = "form-control", type = "number", min = "0", placeholder = "Minimum", required = "required" })
                        <label >@GlobalLoanTerm.minimum_value_in_months </label>
                        @Html.ValidationMessageFor(m => m.MinInMonth, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(m => m.MaxInMonth,
                            new { @class = "form-control", type = "number", min = "0", placeholder = "Maximum", required = "required" })
                        <label >@GlobalLoanTerm.maximum_value_in_months </label>
                        @Html.ValidationMessageFor(m => m.MaxInMonth, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="modal-footer mt-4">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i> @GlobalShared.Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    @if (isEdit)
                    {
                        <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Update
                    }
                    else
                    {
                        <i class="mdi mdi-check me-1"></i> @GlobalShared.Save
                    }
                </button>
            </div>
        }
    </div>

<script>
    $(document).ready(function () {
        // Initialize Select2 if available
        if ($.fn.select2) {
            $('.select2').select2({
                width: '100%',
                dropdownParent: $('#loanTermModal')
            });
        }
    });
</script>