@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanTerm>
<fieldset class="fieldset-custom">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Min : Max</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:70%">@d.Name</td>
                    <td style="width:20%">@d.MinInMonth : @d.MaxInMonth Month(s)</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','LoanTerm')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('LoanTerm','@d.Id','myDataTable','_Data',0,'datalistingview',null,'list')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</fieldset>
