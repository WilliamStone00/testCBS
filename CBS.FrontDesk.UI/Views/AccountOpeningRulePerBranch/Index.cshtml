
@{
    ViewBag.Title = "Account Opening Rules";
}
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<!-- 🔖 Page Title & Intro -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-1">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-clipboard-text-outline me-2"></i> Account Opening Rule Configuration
                </h1>
                <p class="card-text">
                    Manage branch-specific rules for opening saving products in TRUST SOFT CREDIT (TSC). Set legal form requirements, opening balances, and installment settings.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 🧠 Tips -->
<div class="row">
    <div class="col-12">
        <div class="accordion" id="helpTipsAccordion">
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> ACCOUNT OPENING RULE TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="true">
                        <i class="mdi mdi-chevron-up"></i>
                    </button>
                </h6>
                <div id="collapseHelpTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-2">
                            <li><strong>Branch Specific:</strong> Set different rules per branch and legal form.</li>
                            <li><strong>Balance Limits:</strong> Define minimum and maximum allowable opening balances.</li>
                            <li><strong>Installment Permission:</strong> Allow or restrict opening payments in parts.</li>
                            <li><strong>Legal Forms:</strong> Choose whether a rule applies to Physical, Moral, or both entities.</li>
                        </ul>
                        <p class="text-muted mb-0"><strong>Note:</strong> These rules ensure consistency and help automate member onboarding validations.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 📋 Main Section - Rule Listing -->
<div class="row">
    <div class="col">
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="branchIdFilter" class="form-label fw-semibold">Filter by Branch</label>
                <select id="branchIdFilter" class="form-select select2">
                    <option value="">-- All Branches --</option>
                    @foreach (var branch in ViewBag.Branches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="savingProductIdFilter" class="form-label fw-semibold">Filter by Product</label>
                <select id="savingProductIdFilter" class="form-select select2">
                    <option value="">-- All Products --</option>
                    @foreach (var product in ViewBag.SavingProducts)
                    {
                        <option value="@product.Value">@product.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="filterRulesBtn" class="btn btn-primary w-100">
                    <i class="mdi mdi-filter-variant"></i> Filter
                </button>
            </div>
        </div>



        <div class="row my-3">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingRules">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionRules" aria-expanded="true">
                            <i class="mdi mdi-table me-2"></i>
                            <span id="cashDeskOperations">ACCOUNT OPENING RULES TABLE</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="accordionRules" class="accordion-collapse collapse show" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="mb-3">
                                <button class="btn btn-primary" onclick="openCreateRuleModal()">
                                    <i class="mdi mdi-plus-circle-outline"></i> Add New Rule
                                </button>
                            </div>
                            <div id="datalistingview">
                                <table id="myDataTable" class="table table-bordered table-hover w-100"></table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔲 Modal for Create/Edit -->
@Html.Partial("_AccountOpeningRuleModal")

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/Crud/AccountOpeningRulePerBranch/AccountOpeningRulePerBranch.js"></script>

}
