@model CBS.FrontDesk.Data.Entity.Accounting_V2.AccountTypeDefinition.AccountTypeDefinitionDto

<div class="row">
    <div class="col-md-6">
        <h6 class="text-primary mb-3">Basic Information</h6>
        <table class="table table-sm table-bordered">
            <tr><td class="fw-bold">Code:</td><td>@Model.Code</td></tr>
            <tr><td class="fw-bold">Name:</td><td>@Model.Name</td></tr>
            <tr><td class="fw-bold">Short Name:</td><td>@Model.ShortName</td></tr>
            <tr><td class="fw-bold">Description:</td><td>@Model.Description</td></tr>
        </table>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary mb-3">Classification</h6>
        <table class="table table-sm table-bordered">
            <tr><td class="fw-bold">Group:</td><td>@(Model.AccountTypeGroup?.Name ?? "N/A")</td></tr>
            <tr><td class="fw-bold">Parent:</td><td>@(Model.Parent?.Name ?? "None")</td></tr>
            <tr><td class="fw-bold">Display Order:</td><td>@Model.DisplayOrder</td></tr>
        </table>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <h6 class="text-primary mb-3">Status</h6>
        <table class="table table-sm table-bordered">
            <tr>
                <td class="fw-bold">Active:</td>
                <td>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="fw-bold">System Standard:</td>
                <td>
                    @if (Model.IsSystemStandard)
                    {
                        <span class="badge bg-info">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="fw-bold">User Standard:</td>
                <td>
                    @if (Model.IsUserStandard)
                    {
                        <span class="badge bg-warning">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
            </tr>
        </table>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary mb-3">Hierarchy</h6>
        <table class="table table-sm table-bordered">
            <tr>
                <td class="fw-bold">Children Count:</td>
                <td>@(Model.Children?.Count ?? 0)</td>
            </tr>
            <tr>
                <td class="fw-bold">Is Deleted:</td>
                <td>
                    @if (Model.IsDeleted)
                    {
                        <span class="badge bg-danger">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-success">No</span>
                    }
                </td>
            </tr>
        </table>
    </div>
</div>

@if (Model.Children?.Any() == true)
{
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary mb-3">Child Account Types</h6>
            <div class="list-group">
                @foreach (var child in Model.Children)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@child.Name</strong> (@child.Code)
                            @if (!string.IsNullOrEmpty(child.ShortName))
                            {
                                <span class="text-muted ms-2">@child.ShortName</span>
                            }
                        </div>
                        <div>
                            <span class="badge bg-@(child.IsActive ? "success" : "danger") me-2">
                                @(child.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="badge bg-secondary">Order: @child.DisplayOrder</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="modal-footer mt-4">
    <button type="button" class="btn btn-primary" onclick="accountTypeManager.editAccountType('@Model.Id')">
        <i class="mdi mdi-pencil me-1"></i> Edit
    </button>
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
        <i class="mdi mdi-close me-1"></i> Close
    </button>
</div>
