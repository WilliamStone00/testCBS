@model CBS.FrontDesk.Data.Entity.Accounting_V2.AccountTypeDefinition.AccountTypeDefinitionCommand

@using (Html.BeginForm("CreateOrUpdate", "AccountTypeDefinition", FormMethod.Post,
       new { id = "accountTypeForm", @class = "needs-validation", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="Name" class="form-label">Name *</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required", maxlength = "100" })
            <div class="invalid-feedback">Please provide a name.</div>
        </div>

        <div class="col-md-6 mb-3">
            <label for="Code" class="form-label">Code *</label>
            @Html.TextBoxFor(m => m.Code, new
            {
                @class = "form-control",
                required = "required",
                maxlength = "50",
                   pattern = "^[a-zA-Z0-9_]+$",
                title = "Only letters, numbers, and underscores allowed"
            })
            <div class="invalid-feedback">Please provide a valid code.</div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="ShortName" class="form-label">Short Name</label>
            @Html.TextBoxFor(m => m.ShortName, new { @class = "form-control", maxlength = "20" })
        </div>

        <div class="col-md-6 mb-3">
            <label for="DisplayOrder" class="form-label">Display Order</label>
            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label for="Description" class="form-label">Description</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", maxlength = "500" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <label for="BranchId" class="form-label fw-bold">Branch</label>
            @Html.DropDownListFor(m => m.AccountTypeGroupId, new SelectList(ViewBag.AccountTypeGroups, "Id", "Name"), "--- Select Account Type Group ---", new { @class = "form-control select2", required = "required", id = "AccountTypeGroupId" })
            @Html.ValidationMessageFor(m => m.AccountTypeGroupId, "", new { @class = "text-danger" })
            <div class="invalid-feedback">Please select an account type group.</div>
        </div>
        <div class="col-md-12">
            <label for="BranchId" class="form-label fw-bold">Branch</label>
            @Html.DropDownListFor(m => m.ParentId, new SelectList(ViewBag.ParentAccountTypes, "Id", "Name"), "--- Select Parent Account Types ---", new { @class = "form-control select2", required = "required", id = "ParentId" })
            @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "text-danger" })           
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="form-check form-switch">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-check form-switch">
                @Html.CheckBoxFor(m => m.IsUserStandard, new { @class = "form-check-input", id = "IsUserStandard" })
                <label class="form-check-label" for="IsUserStandard">User Standard</label>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
}
