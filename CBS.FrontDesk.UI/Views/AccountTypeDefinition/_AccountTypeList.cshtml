@model IEnumerable<CBS.FrontDesk.Data.Entity.Accounting_V2.AccountTypeDefinition.AccountTypeDefinitionDto>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="accountTypesTable" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Short Name</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    #accountTypesTable {
        font-size: 0.9rem;
    }

        #accountTypesTable th {
            font-weight: 600;
            background-color: #f8f9fa;
        }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
</style>
