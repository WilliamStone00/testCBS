@model List<CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.GroupType>
@if (Model != null)
{<div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>

                        <td style="width:20%">@d.GroupTypeName</td>
                        <td style="width:70%">@d.Description</td>
                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen('@d.GroupTypeId','datalistingview','_Create','update','GroupType')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.GroupTypeName to edit">Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.GroupTypeName" onclick="DeleteRecordDataTable('GroupType','@d.GroupTypeId','myDataTable','_Data',0,'datalistingview')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No member group type was found at the moment.
    </div>
}
