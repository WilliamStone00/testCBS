@model CBS.FrontDesk.Data.Entity.CustomerManagement.Grouping.GroupType
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "GroupType", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<fieldset class="fieldset-custom">
            <legend>@GlobalGroupType.GroupType</legend>
            <br />

            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.GroupTypeName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.GroupTypeName, "", new { @class = "text-danger" })
                        <label>@GlobalGroupType.GroupTypeName</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label>@GlobalGroupType.Description</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                @if (Model.GroupTypeId == null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <input type="hidden" name="Action" value="insert" id="Action" />
                }
                else
                { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                    @Html.HiddenFor(m => m.GroupTypeId)
                    <input type="hidden" name="Action" value="update" id="Action" />
                }
            </div>
        </fieldset>
    }
</div>