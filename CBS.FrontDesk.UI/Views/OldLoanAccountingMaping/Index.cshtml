
@using Resources
@{
    ViewBag.Title = "OldLoanAccountingMaping";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>@GlobalOldLoanAccountingMaping.OldLoanAccountingMaping
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body d-sm-flex d-block">
                                            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0 ms-auto">
                                                <div class="ms-3">
                                                    <a type="button" onclick="LoadDataGen('OldLoanAccountingMaping','myDataTable','_Data',0,'datalistingview')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                                    </a>
                                                </div>
                                                <div class="ms-3">
                                                    <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','OldLoanAccountingMaping')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
                                                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_Create")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script>
    function onBranchChange(branchId) {
        if (!branchId) return;

        loadLoanTypes(branchId);
        loadBranchAccounts(branchId);
    }

    function loadLoanTypes(branchId) {
        $.ajax({
            url: '@Url.Action("GetLoanAccountTypesByBranch", "OldLoanAccountingMaping")',
            type: 'GET',
            data: { branchId: branchId },
            success: function (res) {
                if (res.success) {
                    let loanTypeDropdown = $('#LoanTypeName');
                    loanTypeDropdown.empty();
                    loanTypeDropdown.append('<option value="">--- Select Loan Type ---</option>');

                    $.each(res.data, function (i, item) {
                        loanTypeDropdown.append(
                            $('<option>', {
                                value: item.Value || item.Id,
                                text: item.Text || item.Name
                            })
                        );
                    });

                    loanTypeDropdown.trigger('change');
                }
            }
        });
    }

    function loadBranchAccounts(branchId) {
        $.ajax({
            url: '@Url.Action("GetBranchAccountsByBranch", "OldLoanAccountingMaping")',
            type: 'GET',
            data: { branchId: branchId },
            success: function (res) {
                $('.branch-account').each(function () {
                    let ddl = $(this);
                    ddl.empty();
                    ddl.append('<option value="">--- Select Account Ledger ---</option>');

                    $.each(res, function (i, item) {
                        ddl.append(
                            $('<option>', {
                                value: item.Id,
                                text: item.Name
                            })
                        );
                    });

                    ddl.trigger('change');
                });
            }
        });
    }
</script>

}


