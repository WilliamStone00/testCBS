@model CBS.FrontDesk.Data.Entity.SavingProducts.OldLoanAccountingMaping
@using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "OldLoanAccountingMaping", FormMethod.Post,
        new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <legend>@GlobalOldLoanAccountingMaping.old_loan_accounting_maping</legend>
            @Html.HiddenFor(model => model.Id)

            <div class="row mt-2 gy-4">

                <!-- ✅ Branch added back -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Source Branch ---",
                            new
                            {
                                @class = "form-control select2",
                                required = "required",
                                id = "BranchId",
                                onchange = "onBranchChange(this.value)"
                            })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
                        <label>Select Branch</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.LoanTypeName,
                            Enumerable.Empty<SelectListItem>(),
                            "--- Select Loan Type ---",
                            new { @class = "form-control select2", id = "LoanTypeName" }
                        )
                        @Html.ValidationMessageFor(m => m.LoanTypeName, "", new { @class = "text-danger " })
                        <label>@GlobalShared.Select_Loan_Type</label>
                    </div>
                </div>

                <!-- ✅ Account Ledgers from ViewBag.AccountLedgers (Value/Text) -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForCapital,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForCapital, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_capital_amount</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForInterest,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForInterest, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_interest_amount</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForVAT,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForVAT, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_vat_amount</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForProvisionMoreThanOneYear,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanOneYear, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_provision_more_than_one_year</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForProvisionMoreThanTwoYear,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanTwoYear, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_provision_more_than_two_years</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForProvisionMoreThanThreeYear,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanThreeYear, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_provision_more_than_three_years</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.ChartOfAccountIdForProvisionMoreThanFourYear,
                            new SelectList(ViewBag.AccountLedgers, "Value", "Text"),
                            "--- Select Account Ledger ---",
                            new { @class = "form-control select2 branch-account" }
                        )
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanFourYear, "", new { @class = "text-danger " })
                        <label>@GlobalOldLoanAccountingMaping.select_account_ledger_for_provision_more_than_four_years</label>
                    </div>
                </div>

            </div>

            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
            </div>
        </fieldset>
    }
</div>
