@model CBS.FrontDesk.Data.Entity.SavingProducts.OldLoanAccountingMaping
<div class="card-body">
    @using (Html.BeginForm("Create", "OldLoanAccountingMaping", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <legend>Old Loans Accounting Maping</legend>
            @Html.HiddenFor(model => model.Id)
            <div class="row mt-2 gy-4">

                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.LoanTypeName, new SelectList(ViewBag.LoanTypes, "Value", "Text"), "---Select loan type---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.LoanTypeName, "", new { @class = "text-danger " })
                        <label>Select loan type</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForCapital, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForCapital, "", new { @class = "text-danger " })
                        <label>Select account ledger for capital amount</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForInterest, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForInterest, "", new { @class = "text-danger " })
                        <label>Select account ledger for interest amount</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForVAT, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForVAT, "", new { @class = "text-danger " })
                        <label>Select account ledger for vat amount</label>
                    </div>
                </div>

                <!-- Added Missing Fields -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForProvisionMoreThanOneYear, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanOneYear, "", new { @class = "text-danger " })
                        <label>Select account ledger for provision more than one year</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForProvisionMoreThanTwoYear, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanTwoYear, "", new { @class = "text-danger " })
                        <label>Select account ledger for provision more than two years</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForProvisionMoreThanThreeYear, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanThreeYear, "", new { @class = "text-danger " })
                        <label>Select account ledger for provision more than three years</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.ChartOfAccountIdForProvisionMoreThanFourYear, new SelectList(ViewBag.AccountLedgers, "Value", "Text"), "---Select account ledger---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.ChartOfAccountIdForProvisionMoreThanFourYear, "", new { @class = "text-danger " })
                        <label>Select account ledger for provision more than four years</label>
                    </div>
                </div>

            </div>
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>
                }
            </div>
        </fieldset>
    }
</div>
