@{
    ViewBag.Title = "Connected Users Overview";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-lan-connect me-2"></i> @GlobalUserManagement.CONNECTED_USERS
                </h1>
                <p class="card-text">
                    @GlobalUserManagement.MonitorAllActiveUserSessionsAcrossTheSystem.
                </p>
                <p class="card-text text-black fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>@GlobalUserManagement.UseFiltersSuchAsSessionCodeUsernameRoleAndBranch.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalUserManagement.TIPS_FOR_SESSION_MONITORING</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-account-search-outline text-success me-2"></i><strong>@GlobalUserManagement.SessionCode:</strong> @GlobalUserManagement.IdentifyUsersByUniqueSessionIdentifiers.</li>
                <li><i class="mdi mdi-account-multiple-outline text-primary me-2"></i><strong>@GlobalUserManagement.UserInfo:</strong> @GlobalUserManagement.FilterByUsernameOrFullName.</li>
                <li><i class="mdi mdi-office-building text-warning me-2"></i><strong>@GlobalUserManagement.Branch:</strong> @GlobalUserManagement.TrackLoginsBasedOnOrganizationalLocation.</li>
                <li><i class="mdi mdi-calendar-clock text-info me-2"></i><strong>@GlobalUserManagement.LoginDate:</strong> @GlobalUserManagement.FindUsersWhoLoggedInDuringASpecificTimeframe.</li>
                <li><i class="mdi mdi-account-alert text-danger me-2"></i><strong>@GlobalUserManagement.SessionStatus:</strong> @GlobalUserManagement.ViewExpiredOrSuspiciousSessionsEasily.</li>
            </ul>
        </div>
    </div>
</div>

<!-- 📊 Statistics Panel -->
<div class="card shadow-sm mb-4">
    <div class="card-header text-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-chart-box-outline me-2"></i> @GlobalUserManagement.SessionOverviewStatistics</h6>
        <small class="text-white-50">@GlobalUserManagement.UpdatedEvery30Seconds</small>
    </div>
    <div class="card-body p-3" id="connectedUserStats">
        @Html.Partial("_ConnectedUserStatistics")
    </div>
</div>


<div class="card shadow p-3 mb-4" style="display:none">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalUserManagement.AdvancedSessionFilters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" checked />
                <label class="form-check-label fw-bold" for="byBranch">@GlobalUserManagement.FilterByBranch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byUser" checked />
                <label class="form-check-label fw-bold" for="byUser">@GlobalUserManagement.FilterByUserDetails</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" checked />
                <label class="form-check-label fw-bold" for="byDate">@GlobalUserManagement.FilterByLoginDate</label>
            </div>
        </div>

        <div id="branchFilterSection" class="row mb-3">
            <div class="col-md-12">
                <label class="form-label fw-bold">@GlobalUserManagement.SelectBranch</label>
                @Html.DropDownList("branchInput", new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalUserManagement.SelectBranch +"---", new { @class = "form-control select2", id = "branchInput" })
            </div>
        </div>

        <div id="userFilterSection" class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">@GlobalUserManagement.Username</label>
                <input type="text" id="userName" class="form-control" placeholder="@GlobalUserManagement.Username" value="" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">@GlobalUserManagement.FirstName</label>
                <input type="text" id="firstName" class="form-control" placeholder="@GlobalUserManagement.FirstName" value="" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">@GlobalUserManagement.LastName</label>
                <input type="text" id="lastName" class="form-control" placeholder="@GlobalUserManagement.LastName" value="" />
            </div>
        </div>

        <div id="dateRangeSection" class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalUserManagement.LoginFrom</label>
                <input type="date" id="createdFrom" class="form-control" value="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalUserManagement.LoginTo</label>
                <input type="date" id="createdTo" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">@GlobalUserManagement.SessionStatus</label>
                <select id="isExpired" class="form-select">
                    <option value="">-- @GlobalUserManagement.All --</option>
                    <option value="false" selected>@GlobalShared.Active</option>
                    <option value="true">@GlobalUserManagement.Expired</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">@GlobalUserManagement.Role</label>
                <input type="text" id="role" class="form-control" placeholder="Role (optional)" value="" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">@GlobalUserManagement.SessionCode</label>
                <input type="text" id="sessionCode" class="form-control" placeholder="@GlobalUserManagement.SessionCode" value="" />
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> @GlobalUserManagement.ApplyFilter
            </button>
            <button id="resetFilterBtn" class="btn btn-secondary me-2 w-100">
                <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
            </button>
        </div>
    </div>
</div>


<!-- 📋 Connected Users Table -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="mdi mdi-table me-2"></i> @GlobalUserManagement.ConnectedUsers</h6>
    </div>
    <div class="card-body p-3" id="userTableView">
        @Html.Partial("_ConnectedUsersData")
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Js/Crud/User/UserConnected.js"></script>
}
