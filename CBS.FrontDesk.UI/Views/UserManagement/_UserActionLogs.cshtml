@model CBS.FrontDesk.Data.UserManagement.User

<div class="accordion" id="userActionLogAccordion">

    <!-- 📜 Section: User Action Logs -->
    <div class="accordion-item mb-3">
        <h2 class="accordion-header" id="headingActionLogs">
            <button class="accordion-button bg-info text-white collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseActionLogs" aria-expanded="false" aria-controls="collapseActionLogs">
                <i class="fas fa-history me-2"></i> System Action Logs for @Model.userName
            </button>
        </h2>
        <div id="collapseActionLogs" class="accordion-collapse collapse show" aria-labelledby="headingActionLogs" data-bs-parent="#userActionLogAccordion">
            <div class="accordion-body bg-light">
                @if (Model.AccountSystemActionLogs != null && Model.AccountSystemActionLogs.Any())
                {
                    <div class="table-responsive shadow-sm">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th>Description</th>
                                    <th>Performed By</th>
                                    <th>From Branch</th>
                                    <th>Date</th>
                                    <th>Comments</th>
                                    <th>Details</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.AccountSystemActionLogs.OrderByDescending(x => x.ActionDate).Take(20))
                                {
                                    <tr>
                                        <td class="text-primary fw-bold">@log.ActionType</td>
                                        <td>@log.Description</td>
                                        <td>@log.PerformedBy</td>
                                        <td>
                                            @log.PerformedByBranchName
                                            <span class="text-muted small">(@log.PerformedByBranchCode)</span>
                                        </td>
                                        <td>@log.ActionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@log.Comments</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-url="#"
                                                    onclick="openModalFromUrl(this)">
                                                <i class="fas fa-eye"></i> View
                                            </button>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (Model.AccountSystemActionLogs.Count > 20)
                        {
                            <div class="text-muted small fst-italic mt-2">
                                Showing latest 20 of @Model.AccountSystemActionLogs.Count log(s).
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-1"></i> No system actions have been logged for this user.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
