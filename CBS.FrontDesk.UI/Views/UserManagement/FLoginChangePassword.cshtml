@model CBS.API.Helper.FLoginChangePassword
@{
    Layout = "~/Views/Shared/_LoginMainCover.cshtml";
    ViewBag.Title = "Change password";
}

<style>
    /*.authentication-inner {
        display: flex;
        flex-wrap: wrap;
    }

    .authentication-image {
        width: 100%;
        max-width: 100%;
        height: auto;
    }

    .authentication-bg {
        background-color: #f8f9fa;*/ /* Choose your desired background color */
    /*border-radius: 10px;
    }*/

    .authentication-text {
        color: #007bff; /* Choose your desired text color */
    }

    .trustbank-text {
        font-size: 24px;
    }

    .form-container {
        padding: 20px;
    }

    .form-floating {
        position: relative;
    }

        .form-floating input,
        .form-floating label {
            width: 100%;
        }

    .form-password-toggle {
        position: relative;
    }

        .form-password-toggle input {
            padding-right: 40px;
        }

    .input-group-text {
        cursor: pointer;
    }

    .form-check-input {
        margin-right: 5px;
    }

    .forgot-password-link {
        text-decoration: none;
        color: #6c757d; /* Choose your desired link color */
    }

    .login-policy {
        margin-top: 20px;
    }

        .login-policy hr {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .login-policy label {
            display: block;
        }

    .alert {
        margin-top: 20px;
    }
</style>

<div class="authentication-inner row m-0">
    <!-- Left Section -->
    <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center">
        <img src="~/AppFiles/Images/Logog2X.JPEG" class="authentication-image" alt="mask" />
    </div>
    <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg position-relative">
        <div class="w-px-400 mx-auto pt-5 pt-lg-0 form-container">
            <div class="image-container">
                <img src="~/AppFiles/Images/Logog2XI.png" />
            </div>
            <hr />
            <h5 class="mb-2 trustbank-text" style="display: inline-block; font-size: 1rem;">CHANGE PAWWORD <span class="authentication-text" style="display: inline-block;">, @Model.FullName</span></h5>
            <hr />
            @using (Html.BeginForm("FLoginChangePassword", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateChangePassword(this);" }))
            {<fieldset class="fieldset-custom">
                    @Html.HiddenFor(m => m.UserName)
                    <!-- Username Input -->
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "New password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        <label for="email">New password</label>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-3 form-password-toggle">
                        <div class="input-group input-group-merge">
                            <div class="form-floating form-floating-outline">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm password" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                <label for="password">Confirm password</label>
                            </div>
                            <span class="input-group-text cursor-pointer"><i class="mdi mdi-eye-off-outline"></i></span>
                        </div>
                    </div>
                    <button class="btn btn-primary d-grid w-100">Change password</button>
                </fieldset>
            }
            @Html.Partial("_Alert")
            <!-- Login Policy -->
            <div class="login-policy">
                <div class="col-sm-12">
                    <p class="text-muted mb-0"><b>CHANGE PASSWORD POLICY</b></p>
                    <hr />
                    <label>1. Password must contain at least 8 characters.</label>
                    <label>2. Password must contain at least one uppercase letter.</label>
                    <label>3. Password must contain at least one lowercase letter.</label>
                    <label>4. Password must contain at least one digit.</label>
                    <label>5. Password must contain at least one special character.</label>
                    <label>6. Password must not contain serial numbers.</label>
                    <label>7. Password must not contain your user name.</label>
                </div>
            </div>


            <!-- Error Message -->
            @if (ViewBag.Success == false)
            {
                <div class="alert alert-outline-danger" role="alert">
                    @ViewBag.Message;
                </div>
            }
        </div>
    </div>
    <!-- /Login Section -->
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function AjaxPostAndUpdateChangePassword(form) {

            $.validator.unobtrusive.parse(form);
            if ($(form).valid()) {
                var ajaxConfig = {
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    success: function (response) {

                        if (response.success) {
                            appalert(response.message, 1, 1);
                            window.location.href = "/";
                        }
                        else {
                            if (response.state === "Exist") {
                                appalert(response.message, 3, 1);
                            }
                            else if (response.state === "Expired") {
                                appalert(response.message, 2, 1);
                                window.location.href = response.urldirect;
                            }
                            else {
                                appalert(response.message, 2, 1);
                            }

                        }

                    }
                    , error: function (err) {
                        appalert(err.statusText, 0, 1);
                    }
                };

                if ($(form).attr('enctype') === "multipart/form-data") {
                    ajaxConfig["contentType"] = false;
                    ajaxConfig["processData"] = false;
                }
                $.ajax(ajaxConfig);

            }
            return false;

        }

    </script>
}