@model CBS.API.Helper.FLoginChangePassword
    @using Resources
@{
    ViewBag.Title = "Change password";
    Layout = "~/Views/Shared/_LayoutChangePassword.cshtml";
}

<div class="main-content">
    <div class="right-panel bg-light p-4">
        <div class="form-box">
            <img src="~/AppFiles/Images/Logog2XI.png" class="logo" alt="Logo" />
            <h5 class="text-center mb-2 fw-bold text-primary">@GlobalUserManagement.ChangePassword</h5>
            <p class="text-center text-muted mb-3">@GlobalUserManagement.Welcome, <strong>@Model.FullName</strong></p>

            @using (Html.BeginForm("FLoginChangePassword", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateChangePassword(this);" }))
            {
                @Html.HiddenFor(m => m.UserName)
                @Html.HiddenFor(m => m.UserName, new { id = "currentUsername" })

                <div class="form-floating mb-2">
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "form-control",
                        placeholder = "New password",
                        pattern = @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,128}$",
                        title = "8–128 chars, 1 uppercase, 1 lowercase, 1 digit, 1 special character"
                    })
                    <label>@GlobalUserManagement.NewPassword</label>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <div class="form-floating mb-2">
                    @Html.PasswordFor(m => m.ConfirmPassword, new
                    {
                        @class = "form-control",
                        placeholder = "Confirm password",
                        pattern = @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,128}$",
                        title = "Must match password and meet security requirements"
                    })
                    <label>@GlobalUserManagement.ConfirmPassword</label>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button class="btn btn-primary w-100 py-2">@GlobalUserManagement.ChangePassword</button>
                <div class="mb-3">
                    <label for="generatedPassword" class="form-label fw-bold">@GlobalUserManagement.GeneratedPassword</label>
                    <div class="input-group">
                        <input type="text" id="generatedPassword" class="form-control" readonly />
                        <button class="btn btn-outline-primary" type="button" onclick="generateStrongPassword()">Gen</button>
                        <button class="btn btn-outline-success" type="button" onclick="copyGeneratedPassword()" title="@GlobalUserManagement.CopyToClipboard">
                            <i class="bi bi-clipboard"></i> @GlobalUserManagement.Copy
                        </button>
                        <button class="btn btn-outline-dark" type="button" onclick="downloadPassword()" title="@GlobalUserManagement.DownloadAsText">
                            <i class="bi bi-download"></i> @GlobalShared.Save
                        </button>
                    </div>
                    <small id="copyFeedback" class="text-success d-none">✔️ @GlobalUserManagement.PasswordCopiedToClipboard!</small>
                </div>
            }

            @if (ViewBag.Success == false)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Message</div>
            }
        </div>
    </div>

    <div class="left-panel">
        @Html.Partial("_PasswordPolicyPanel")
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/main.js/PasswordGenerator.js"></script>
    <script src="~/Scripts/Js/Crud/User/FChangePassword.js"></script>
}




