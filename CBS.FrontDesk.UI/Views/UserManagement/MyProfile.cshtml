@model CBS.FrontDesk.Data.UserManagement.User

@{
    ViewBag.Title = "User Profile";
}

<style>
    .nav-flat .nav-link {
        border: none;
        border-radius: 0;
        background: #f8f9fa;
        color: #333;
        padding: 12px 16px;
        text-align: left;
        transition: all 0.2s ease-in-out;
        font-weight: 500;
        border-left: 4px solid transparent;
    }

        .nav-flat .nav-link:hover {
            background-color: #e9ecef;
            color: #007bff;
            border-left: 4px solid #007bff;
        }

        .nav-flat .nav-link.active {
            background-color: #e3f2fd;
            color: #0d6efd;
            font-weight: 600;
            border-left: 4px solid #0d6efd;
        }
</style>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group-outline me-2"></i> [@Model.name.ToUpper()] ACCOUNT SETTINGS
                </h1>
                <p class="card-text">
                    View and manage your personal account, update your information, set up security features such as MFA, manage your sessions, change your password, and review your assigned permissions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUserTips" aria-expanded="false" aria-controls="collapseUserTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseUserTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>📇 Update Profile:</strong> Always keep your contact info up to date.</li>
                <li><strong>📸 Profile Picture:</strong> Upload a clear picture to personalize your account.</li>
                <li><strong>🔒 Change Password:</strong> Periodically update your password for better security.</li>
                <li><strong>🛡️ MFA Settings:</strong> Enable Multi-Factor Authentication for advanced protection.</li>
                <li><strong>⏱️ User Sessions:</strong> View and terminate active login sessions to stay safe.</li>
                <li><strong>🔁 Recovery Code:</strong> Regenerate your session recovery code after password reset or compromise.</li>
                <li><strong>👁️ Permissions:</strong> Review the list of menus and permissions assigned to you.</li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <!-- Sidebar Tabs -->
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body p-2">
                <div class="nav flex-column nav-pills nav-flat" id="userAccountTabs" role="tablist" aria-orientation="vertical">
                    <a class="nav-link active" id="vtab-awareness" data-bs-toggle="pill" href="#tab-awareness" role="tab" aria-selected="true">Security Awareness</a>
                    <a class="nav-link" id="vtab-profile" data-bs-toggle="pill" href="#tab-profile" role="tab" aria-selected="false">Update Profile</a>
                    <a class="nav-link" id="vtab-picture" data-bs-toggle="pill" href="#tab-picture" role="tab" aria-selected="false">Change Picture</a>
                    <a class="nav-link" id="vtab-password" data-bs-toggle="pill" href="#tab-password" role="tab" aria-selected="false">Change Password</a>
                    <a class="nav-link" id="vtab-mfa" data-bs-toggle="pill" href="#tab-mfa" role="tab" aria-selected="false">MFA Settings</a>
                    <a class="nav-link" id="vtab-session" data-bs-toggle="pill" href="#tab-session" role="tab" aria-selected="false">User Sessions</a>
                    <a class="nav-link" id="vtab-recovery" data-bs-toggle="pill" href="#tab-recovery" role="tab" aria-selected="false">Recovery Code</a>
                    <a class="nav-link" id="vtab-permission" data-bs-toggle="pill" href="#tab-permission" role="tab" aria-selected="false">User Permissions</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="col-md-9">
        <div class="card h-100 shadow-sm border">
            <div class="card-body">
                <div class="tab-content" id="userAccountTabsContent">
                    <div class="tab-pane fade show active" id="tab-awareness" role="tabpanel">@Html.Partial("_UserSecurityAwareness")</div>
                    <div class="tab-pane fade" id="tab-profile" role="tabpanel">@Html.Partial("_UserUpdateProfile")</div>
                    <div class="tab-pane fade" id="tab-picture" role="tabpanel">@Html.Partial("_UpdateImage")</div>
                    <div class="tab-pane fade" id="tab-password" role="tabpanel">@Html.Partial("_UserChangePassword")</div>
                    <div class="tab-pane fade" id="tab-mfa" role="tabpanel">@Html.Partial("_UserEnableMFA")</div>
                    <div class="tab-pane fade" id="tab-session" role="tabpanel">@Html.Partial("_UserSessions")</div>
                    <div class="tab-pane fade" id="tab-recovery" role="tabpanel">@Html.Partial("_UserGenerateNewRecoveryCode")</div>
                    <div class="tab-pane fade" id="tab-permission" role="tabpanel">@Html.Partial("_UserProfileManagePermissions")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {
        // Initialize DataTables
        $('#myDataTable').DataTable();
    });
    </script>
}
