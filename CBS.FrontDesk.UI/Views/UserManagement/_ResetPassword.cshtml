

@model CBS.FrontDesk.Data.UserManagement.User
<div class="card-body pt-2 mt-1">
    @using (Html.BeginForm("UpdateUser", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
     <input type="hidden" name="Option" value="ResetPassword" id="Option" />

    <div class="row mt-2 gy-4">
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.ChangePassword.userName, new { @class = "form-control", @placeholder = "B.Awath" })
                @Html.ValidationMessageFor(m => m.ChangePassword.userName, "", new { @class = "text-danger" })
                <label>User Name</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.PasswordFor(m => m.ChangePassword.password, new { @class = "form-control", @placeholder = "Password" })
                @Html.ValidationMessageFor(m => m.ChangePassword.password, "", new { @class = "text-danger" })
                <label>New password</label>
            </div>
        </div>

    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">Reset password</button>
    </div>
}
</div>
