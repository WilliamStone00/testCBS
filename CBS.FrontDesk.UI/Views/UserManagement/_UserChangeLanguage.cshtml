@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="mdi mdi-translate me-2"></i> @GlobalUserManagement.ChangePreferredLanguage
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "ChangeLanguage")
        @Html.HiddenFor(m => m.id)

        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.UserPreferedLanguage, new SelectList(ViewBag.Languages, "Key", "Value", Model.UserPreferedLanguage), "---"+ @GlobalUserManagement.SelectLanguage +"---", new { @class = "form-control select2", id = "languageDropdown" })
                    <label for="languageDropdown">@GlobalUserManagement.PreferredLanguage</label>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="mdi mdi-content-save-check me-1"></i> @GlobalShared.Save
                </button>
            </div>
        </div>
    }
</div>
