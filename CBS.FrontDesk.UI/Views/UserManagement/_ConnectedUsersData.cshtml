
<div class="card p-3 shadow mb-4">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Session Code</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Branch</th>
                    <th>Login Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>
</div>





