<div class="row g-3 mb-4" id="connectedUserStats">
    <div class="col-sm-6 col-md-3">
        <div class="card border-start border-4 border-primary shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Total Sessions</p>
                        <h4 id="totalSessions" class="fw-bold text-primary mb-0">0</h4>
                    </div>
                    <i class="mdi mdi-lan text-primary fs-3"></i>
                </div>
                <small class="text-muted">Across all users</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-start border-4 border-success shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Active Sessions</p>
                        <h4 id="activeSessions" class="fw-bold text-success mb-0">0</h4>
                    </div>
                    <i class="mdi mdi-account-check-outline text-success fs-3"></i>
                </div>
                <small class="text-muted">Currently online</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-start border-4 border-danger shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Expired Sessions</p>
                        <h4 id="expiredSessions" class="fw-bold text-danger mb-0">0</h4>
                    </div>
                    <i class="mdi mdi-timer-off text-danger fs-3"></i>
                </div>
                <small class="text-muted">No longer active</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-start border-4 border-info shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Unique Users</p>
                        <h4 id="uniqueUsers" class="fw-bold text-info mb-0">0</h4>
                    </div>
                    <i class="mdi mdi-account-group-outline text-info fs-3"></i>
                </div>
                <small id="uniqueBranches" class="text-muted">From 0 branch(es)</small>
            </div>
        </div>
    </div>
</div>

<div id="dashboardError" class="alert alert-warning d-none mt-2" role="alert">
    ⚠️ Could not load live session dashboard. Please check your connection or try again later.
</div>
