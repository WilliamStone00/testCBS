@model CBS.FrontDesk.Data.UserManagement.User
    @using Resources
@{
    var created = Model.UserSession.CreatedDate;
    var expires = Model.UserSession.ExpiryDate;
    var now = DateTime.Now;

    var expireTime = expires - created;
    var timeLeft = expires - now;

    string expireHoursText = $"{expireTime.TotalHours:F2} hours";
    string timeLeftText = timeLeft.TotalSeconds > 0
        ? $"{(int)timeLeft.TotalHours}h {timeLeft.Minutes}m {timeLeft.Seconds}s"
        : "Expired";
}

<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-info-circle me-2"></i> @GlobalUserManagement.SessionRecoveryMetadata
    </h5>
</div>

<div class="modal-body bg-light">
    @Html.HiddenFor(m => m.id)

    <!-- 🔐 SESSION RECOVERY CODE SECTION -->

    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "TerminateActiveSessions")
        @Html.HiddenFor(m => m.id)
        @Html.HiddenFor(m => m.SessionRecoveryCode)

        <div class="row mb-4">
            <div class="col-12">
                <label class="form-label fw-bold text-secondary">@GlobalUserManagement.RecoveryCode</label>
                <div class="form-control bg-white shadow-sm d-flex justify-content-between align-items-center">
                    <span class="text-primary fw-bold">@Model.SessionRecoveryCode</span>
                    @if (Model.UserSession?.IsDefaultSessionRecoveryCode == true)
                    {
                        <span class="badge bg-danger"><i class="fas fa-gears me-2"></i>@GlobalUserManagement.DefaultSettings</span>
                    }
                    else
                    {
                <span class="badge bg-primary"><i class="fas fa-gears me-2"></i>@GlobalUserManagement.CustomSettings</span>
                    }
                </div>
                <small class="text">@GlobalUserManagement.ThisIsUsedToTerminateAllActiveSessionsIfYourAccountIsCompromised.</small>
            </div>

            <div class="col-12 mt-3 text-end">
                <button type="submit" class="btn btn-outline-danger shadow-sm">
                    <i class="fas fa-sync-alt me-1"></i> @GlobalUserManagement.TerminateAllActiveSessions
                </button>
            </div>
        </div>
    }
    <!-- 🔐 SECURITY TIPS -->
    <div class="alert alert-warning mt-4 shadow-sm mb-3">
        <strong>@GlobalUserManagement.SecurityTips:</strong>
        <ul class="mb-0 mt-2 ps-3">
            <li>@GlobalUserManagement.DoNotShareYourRecoveryCode.</li>
            <li>@GlobalUserManagement.GenerateANewCodeRegularlyForSecurityHygiene.</li>
            <li>@GlobalUserManagement.UseRecoveryCodeOnlyIfYouDetectUnauthorizedAccess.</li>
            <li>@GlobalUserManagement.ConsiderChangingYourPasswordAfterRecovery.</li>
        </ul>
    </div>
    <!-- 📋 SESSION DETAILS TABLE -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped shadow-sm">
            <tbody>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.SessionCode</th>
                    <td>@Model.UserSession.SessionCode</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.Username</th>
                    <td>@Model.UserSession.UserName</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.FullName</th>
                    <td>@Model.UserSession.FullName</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.Role</th>
                    <td>@Model.UserSession.Role</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.Branch</th>
                    <td>@($"{Model.UserSession.BranchName} ({Model.UserSession.BranchCode})")</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.IPAddress</th>
                    <td>@Model.UserSession.IpAddress</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.CreatedDate</th>
                    <td>@Model.UserSession.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.ExpiresAt</th>
                    <td>@Model.UserSession.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.ExpireTime</th>
                    <td>@expireHoursText</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.TimeLeft</th>
                    <td class="fw-bold text-@(timeLeft.TotalSeconds > 0 ? "primary" : "danger")">@timeLeftText</td>
                </tr>

                <tr>
                    <th class="bg-light">@GlobalUserManagement.TotalActiveSessions</th>
                    <td>@Model.UserSession.NumberOfSessionsOpen</td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.SessionStatus</th>
                    <td>
                        @if (Model.UserSession.SessionStatus == "Multiple_Sessions")
                        {
                            <span class="badge bg-warning text-dark">@GlobalUserManagement.MultipleActive</span>
                        }
                        else if (Model.UserSession.SessionStatus == "OK")
                        {
                            <span class="badge bg-primary">@GlobalUserManagement.Healthy</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@GlobalUserManagement.InvalidExpired</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th class="bg-light">@GlobalUserManagement.LastErrorMessage</th>
                    <td class="text-danger">@Model.UserSession.ErrorMessage</td>
                </tr>
            </tbody>
        </table>
    </div>


</div>

