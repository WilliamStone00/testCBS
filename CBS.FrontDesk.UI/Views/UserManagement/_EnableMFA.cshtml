


@model CBS.FrontDesk.Data.UserManagement.User
<div class="card-body pt-2 mt-1">
    @using (Html.BeginForm("UpdateUser", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="Option" value="EnableMFA" id="Option" />

        if (Model.IsGoogleAuthenticatorEnabled)
        {
            <div class="alert alert-info" role="alert">
                Multi-Factor Authentication (MFA) is currently enabled for your account. You can disable it using the button below.
                <br />
                Another layer of security has been added to your account.
            </div>

            <div class="alert alert-secondary" role="alert">
                <strong>Steps to Log In After Activating MFA:</strong>
                <ol>
                    <li>Go to the login page and enter your username and password as usual.</li>
                    <li>Open the Google Authenticator app on your phone.</li>
                    <li>Enter the verification code generated by the Google Authenticator app into the MFA input box on the login page.</li>
                    <li>Click the "Submit" button to complete the login process.</li>
                </ol>
            </div>

            <div class="mt-4">
                @Html.HiddenFor(m => m.MFAActivation.Email)
                <button type="submit" class="btn btn-danger me-2">Disable MFA</button>
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                Multi-Factor Authentication (MFA) is currently disabled for your account. Follow the instructions below to enable it.
            </div>

            <div class="alert alert-secondary" role="alert">
                <strong>Awareness:</strong>
                Google Authenticator adds an extra layer of security to your online accounts by adding a second step of verification when you sign in.
                This means that in addition to your password, you'll also need to enter a code that is generated by the Google Authenticator app on your phone.
                The verification code can be generated by the Google Authenticator app on your phone, even if you don't have a network or cellular connection.
            </div>

            <div class="alert alert-secondary" role="alert">
                <strong>Activation Steps:</strong>
                <ol>
                    <li>Download an authenticator app for your Android device. You can use <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en" target="_blank">Google Authenticator</a>.</li>
                    <li>From your authenticator app, scan the barcode displayed on your screen OR manually enter the setup code provided.</li>
                    <li>Enter the randomly generated code from your authenticator app in the input box below.</li>
                </ol>
            </div>

            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <img src="@Model.BarcodeImageUrl" alt="Remote Image" id="previewimage" class="img-fluid" width="100px" /><br />
                    <label>Setup Code: @Model.GoogleAuthenticatorSecretKey</label>
                </div>
                <div class="form-floating form-floating-outline col-12 mb-3">
                    @Html.TextBoxFor(m => m.MFAActivation.Code, new { @class = "form-control", @placeholder = "884514", @autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.MFAActivation.Code, "", new { @class = "text-danger" })
                    <label for="Code">MFA Code</label>
                </div>
                @*<div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.MFAActivation.Code, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.MFAActivation.Code, "", new { @class = "text-danger" })
                        <label>Input security Code</label>
                    </div>
                </div>*@
                <div class="col-12">
                    @Html.HiddenFor(m => m.MFAActivation.Status, new { @value = true })
                </div>
            </div>
            <div class="mt-4">
                @Html.HiddenFor(m => m.MFAActivation.Email)
                <button type="submit" class="btn btn-primary me-2">Enable MFA</button>
            </div>
        }
    }
</div>
