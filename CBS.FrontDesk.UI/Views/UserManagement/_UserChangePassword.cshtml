@model CBS.FrontDesk.Data.UserManagement.User
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-key me-2"></i> Change Password
    </h5>
</div>

<div class="modal-body bg-light mb-2">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "ChangePassword")
        @Html.HiddenFor(m => m.id)
        @Html.HiddenFor(m => m.userName)
        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.oldPassword, new { @class = "form-control", placeholder = "Old Password" })
                    <label>Old Password</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.oldPassword, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.password, new { @class = "form-control", placeholder = "New Password" })
                    <label>New Password</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.password, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.PasswordFor(m => m.ChangePassword.confirmPassword, new { @class = "form-control", placeholder = "Confirm Password" })
                    <label>Confirm Password</label>
                    @Html.ValidationMessageFor(m => m.ChangePassword.confirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary shadow-sm">
                <i class="fas fa-save me-1"></i> Change
            </button>
        </div>
    }



</div>
<div class="modal-body bg-light">
    <div class="alert alert-info shadow-sm mb-4">
        <h6 class="fw-bold text-primary mb-2"><i class="fas fa-shield-alt me-2"></i> Password & Security Policy Guidelines</h6>

        <ul class="mb-3">
            <li><strong>Password Length:</strong> Must be between <strong>8 and 128 characters</strong>.</li>
            <li>
                <strong>Complexity Requirements:</strong> Password must contain:
                <ul>
                    <li>✅ At least <strong>one uppercase letter</strong> (A–Z)</li>
                    <li>✅ At least <strong>one lowercase letter</strong> (a–z)</li>
                    <li>✅ At least <strong>one digit</strong> (0–9)</li>
                    <li>✅ At least <strong>one special character</strong> (e.g. <code>!@@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?</code>)</li>
                </ul>
            </li>
            <li>❌ <strong>Do not include your username</strong> in the password.</li>
            <li>🔁 <strong>Do not reuse your last 5 passwords</strong>.</li>
            <li>🚫 Avoid weak/common patterns like <code>password</code>, <code>1234</code>, <code>admin</code>, <code>welcome</code>, etc.</li>
        </ul>

        <h6 class="fw-bold text-primary mt-4"><i class="fas fa-lock me-2"></i> Mandatory MFA (Multi-Factor Authentication)</h6>
        <p class="mb-2">
            For enhanced security, <strong>MFA is required</strong> by your organization's account policy. You must activate at least one method:
            <code>SMS</code>, <code>Email</code>, or <code>Authenticator App (TOTP)</code>.
        </p>
        <p class="mb-0">
            ⚠️ Failure to activate MFA within <strong>3 days</strong> of account creation will result in automatic account suspension per policy.
        </p>

        <h6 class="fw-bold text-primary mt-4"><i class="fas fa-user-shield me-2"></i> Account Compliance Notices</h6>
        <ul>
            <li>⏰ Your account may be automatically <strong>suspended</strong> if you remain inactive for a prolonged period.</li>
            <li>📅 Newly created accounts must be used (logged in) within the first <strong>3 days</strong>, or they will be blocked.</li>
            <li>🔒 Passwords must be updated regularly as required by the system policy.</li>
        </ul>

        <h6 class="fw-bold text-warning mt-4"><i class="fas fa-exclamation-triangle me-2"></i> Security Reminders</h6>
        <ul>
            <li>🔑 Never share your password or MFA code—even with IT support.</li>
            <li>📲 Use strong, unique passwords for each platform you access.</li>
            <li>🛑 Do not store passwords in browsers or unsecured apps.</li>
            <li>🔁 Change your password frequently and immediately after any suspicion of compromise.</li>
        </ul>

        <h6 class="fw-bold mt-4">🧪 Examples</h6>
        <p class="mb-1"><span class="text-primary">✅ Strong Password:</span> <code>~Tr@ckM3SaFe1501!</code></p>
        <p class="mb-1"><span class="text-danger">❌ Weak Passwords:</span> <code>password123</code>, <code>admin2021</code>, <code>welcome</code></p>
    </div>
</div>
