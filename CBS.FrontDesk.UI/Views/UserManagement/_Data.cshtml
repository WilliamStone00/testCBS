
@model List<CBS.FrontDesk.Data.UserManagement.User>
@if (Model.Count == 0)
{
    <div class="text-center my-3">
        <p>No user have been created.</p>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>userName</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Branch</th>
                    <th>Last login</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="width:10%">@d.userName</td>
                        <td style="width:20%">@d.name</td>
                        <td style="width:10%">@d.email</td>
                        <td style="width:5%">
                            @if (d.status == "Active")
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@d.status</span></label>
                            }
                            else
                            {
                                <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">Blocked</span></label>
                            }
                        </td>
                        <td style="width:20%">@(d.Brancch != null ? d.Brancch.Name : "N/A")</td>
                        <td style="width:20%">@d.strlastLoginDate</td>
                        <td style="width:15%">
                            <a href="/UserManagement/UserProfile?KEY=@d.id" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('UserManagement','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}



