
@model List<CBS.FrontDesk.Data.UserManagement.UserList>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
    <tr>
        <th>userName</th>
        <th>Name</th>
        <th>Email</th>
        <th>phoneNumber</th>
        <th>Status</th>
        <th>Branch</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td style="width:10%">@d.userName</td>
            <td style="width:15%">@d.name</td>
            <td style="width:15%">@d.email</td>
            <td style="width:10%">@d.phoneNumber</td>
            <td style="width:8%">@d.status</td>
            <td style="width:20%">@d.Branch.Name</td>
            @*<td style="width:22px; height:60px; text-align:center; border-radius: 50%; overflow: hidden;">
                <img src="@d.profilePhoto" alt="No image" style="max-width:100%; height:auto; border-radius: 50%;">
            </td>*@
            <td style="width:20%">
                <a href="/UserManagement/UserProfile?KEY=@d.id" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('UserManagement','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>




