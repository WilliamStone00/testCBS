@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-image me-2"></i>  @GlobalUserManagement.UploadProfilePicture
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("UpdateUser", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="Option" value="PhotoUpload" id="Option" />

        <div class="row mt-2 gy-4">
            <div class="col-md-12 text-center">
                <div class="shadow-sm p-3 bg-white rounded">
                    <img src="@(string.IsNullOrEmpty(Model.profilePhoto) ? Url.Content(Model.ImageVirtualPath ?? "~/Appfiles/Images/p.jpg") : Model.profilePhoto)"
                         alt="Profile Image" id="previewimage" class="img-fluid rounded-circle shadow-sm mb-2"
                         style="width: 140px; height: 140px; object-fit: cover; border: 3px solid #ddd;" />

                    <input type="file" name="FileUpload" accept="image/jpeg,image/png,image/jpg"
                           id="imageupload" class="form-control mt-2"
                           onchange="ShowImagePreview(this, document.getElementById('previewimage'))" />
                </div>
            </div>

            <div class="col-12 text-end mt-3">
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="fas fa-upload me-1"></i>  @GlobalShared.Upload
                </button>
            </div>
        </div>
    }
</div>