

@model CBS.FrontDesk.Data.UserManagement.UserList
<div class="card-body pt-2 mt-1">
    @using (Html.BeginForm("Update", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <input type="hidden" name="Option" value="ChangePassword" id="Option" />

        <div class="row mt-2 gy-4">
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.ChangePassword.userName, new { @class = "form-control", @placeholder = "B.Awath",@readonly=true })
                    @Html.ValidationMessageFor(m => m.ChangePassword.userName, "", new { @class = "text-danger" })
                    <label>User Name</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.PasswordFor(m => m.ChangePassword.oldPassword, new { @class = "form-control", @placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.ChangePassword.oldPassword, "", new { @class = "text-danger" })
                    <label>Old password</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.PasswordFor(m => m.ChangePassword.password, new { @class = "form-control", @placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.ChangePassword.password, "", new { @class = "text-danger" })
                    <label>New password</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.PasswordFor(m => m.ChangePassword.confirmPassword, new { @class = "form-control", @placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.ChangePassword.confirmPassword, "", new { @class = "text-danger" })
                    <label>Confirm password</label>
                </div>
            </div>

        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Change password</button>
        </div>
    }
</div>
