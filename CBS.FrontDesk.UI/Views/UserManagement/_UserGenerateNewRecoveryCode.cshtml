@model CBS.FrontDesk.Data.UserManagement.User

<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-shield-alt me-2"></i> Generate New Session Recovery Code
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "GenerateNewRecoveryCode")
        @Html.HiddenFor(m => m.id)

        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    <input type="text" class="form-control" id="oldCode" value="@Model.SessionRecoveryCode" readonly />
                    <label>Current Recovery Code</label>
                </div>
                <small class="text">This is the currently assigned session recovery code.</small>
            </div>
        </div>

        <div class="alert alert-info mt-4">
            <h6><i class="fas fa-info-circle me-1"></i> Why regenerate a recovery code?</h6>
            <ul class="mb-0 ps-3">
                <li>To revoke an existing code that may have been exposed.</li>
                <li>When users suspect unauthorized access to their account.</li>
                <li>As a regular security hygiene best practice.</li>
                <li>Recovery codes are used to invalidate all open sessions and regain exclusive access.</li>
            </ul>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary shadow-sm">
                <i class="fas fa-sync-alt me-1"></i> Generate New Code
            </button>
        </div>
    }
</div>
