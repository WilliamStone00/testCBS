@model CBS.FrontDesk.Data.UserManagement.User
@using Resources
<div class="modal-header text-white mb-2">
    <h5 class="modal-title">
        <i class="fas fa-code-branch me-2"></i> @GlobalUserManagement.ChangeUserBranch
    </h5>
</div>

<div class="modal-body bg-light">
    @using (Html.BeginForm("AddOrEdit", "UserManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.Hidden("Option", "ChangeBranch")
        @Html.HiddenFor(m => m.id)

        <div class="row gy-3">
            <div class="col-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.BranchID, new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalUserManagement.SelectBranch +"---", new { @class = "form-control select2", id = "branchDropdown" })
                    <label for="branchDropdown">@GlobalUserManagement.SelectBranch</label>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="fas fa-check-circle me-1"></i> @GlobalUserManagement.Change
                </button>
            </div>
        </div>
    }
</div>
