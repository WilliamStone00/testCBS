@model List<CBS.FrontDesk.Data.Entity.AccountingV2.ConfigurationManualEntries>
    @using Resources

<fieldset class="fieldset-custom">
    <h6 class="d-flex justify-content-between align-items-center text-primary mb-3">
        <span><i class="mdi mdi-cog-outline me-2"></i> @GlobalConfigurationManualEntry.InterbranchLocalConfiguration</span>
    </h6>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>@GlobalConfigurationManualEntry.Noconfigurationshavebeendefinedyet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle border" id="myDataTable">
                <thead class="bg-light text-center fw-semibold text-uppercase small">
                    <tr>
                        <th style="display:none;">Id</th> <!-- Hidden Id column -->
                        <th class="py-2">Type</th>
                        <th class="py-2">@GlobalConfigurationManualEntry.Command</th>
                        <th class="py-2">@GlobalConfigurationManualEntry.Description</th>
                        <th class="py-2">@GlobalConfigurationManualEntry.UserReqiredApproval</th>
                        <th class="py-2">@GlobalConfigurationManualEntry.Status</th>
                        <th class="py-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model) 
                    {
                        <tr data-id="@d.Id">
                            <td style="display:none;">@d.Id</td>
                            <td class="text-nowrap">@d.Type</td>
                            <td class="text-nowrap">@d.Command</td>
                            <td class="text-nowrap">@d.Description</td>

                            <td class="text-center">
                                @if (d.UserRequiredApproval)
                                {
                                   
                                    <span class="badge bg-success bg-opacity-75 px-3">@GlobalConfigurationManualEntry.Yes</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary bg-opacity-75 px-3">@GlobalConfigurationManualEntry.No</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (d.Status == "Active")
                                {
                                    <span class="badge bg-success bg-opacity-75 px-3">@GlobalConfigurationManualEntry.Active</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary bg-opacity-75 px-3">@GlobalConfigurationManualEntry.Inactive</span>
                                }
                            </td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm px-3 btn-edit-config"
                                        data-id="@d.Id">
                                    @GlobalConfigurationManualEntry.Edit
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>





<script>
    $(document).ready(function () {

        // Handle Edit button click
        $(document).on('click', '.btn-edit-config', function () {
            var id = $(this).data('id');
            if (!id) return;

            // Fetch partial view first
            $.ajax({
                url: '@Url.Action("GetDetails", "ConfigurationManualEntry")',
                type: 'GET',
                data: { id: id },
                success: function (html) {

                    // Remove any previous modal to avoid duplication
                    $('#configModal').remove();

                    // Create and inject new modal dynamically
                    $('body').append(`
                        <div class="modal fade" id="configModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content shadow-lg border-0">


                                    <div class="modal-body" id="configModalBody">
                                        ${html}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                    // Show the modal now
                    var modal = new bootstrap.Modal(document.getElementById('configModal'));
                    modal.show();
                },
                error: function (xhr) {
                    alert('Error loading configuration: ' + xhr.statusText);
                }
            });
        });

    });



</script>













