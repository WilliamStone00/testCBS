@model CBS.FrontDesk.Data.Entity.AccountingV2.ConfigurationManualEntries

@using (Html.BeginForm(
    "UpdateConfigurationManualEntry",
    "ConfigurationManualEntry",
    FormMethod.Post,
    new { id = "configForm", enctype = "multipart/form-data", onsubmit = "return configurationSaveAjax(this);" }
))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "id" })
    @Html.HiddenFor(m => m.Type, new { id = "type" })

    <style>
        .header-viewer {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 1rem;
            text-align: center;
            font-size: 0.95rem;
            color: #555;
            border-left: 4px solid #198754;
        }

            .header-viewer h6 {
                font-weight: 700;
                color: #198754;
                margin-bottom: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

        .description-box {
            background-color: #f8f9fa !important;
            color: #212529 !important;
            font-weight: 500;
            font-size: 0.95rem;
            line-height: 1.6;
            border: 1px solid #dee2e6;
            resize: none;
            height: 95px;
            overflow-y: auto;
            cursor: default;
            padding: 10px 12px;
        }
    </style>

    <div class="container mt-2">
        <div class="header-viewer">
            <h6><i class="mdi mdi-cog-outline me-1"></i> CONFIGURATION DETAILS</h6>
            <p class="mb-0">Configuration set by Head Office. Review or update the workflow setup.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Type))
        {
            <div class="card rounded-0 shadow-sm mb-4">
                <div class="card-header bg-light bg-gradient py-3 rounded-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-success">
                        <i class="mdi mdi-sitemap-outline me-2"></i> @Model.Type Workflow
                    </h5>
                    <span class="badge bg-light text-success fw-semibold px-3 py-2">Configuration Panel</span>
                </div>

                <div class="card-body bg-white px-4 py-4">
                    <div class="row gy-4">

                        <!-- 🔹 Command (From Backend) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Command</label>
                            <input type="text"
                                   class="form-control border border-1 rounded-0 bg-light"
                                   id="command"
                                   name="Command"
                                   value="@Model.Command"
                                   readonly />
                        </div>

                        <!-- 🔹 Description (From Backend) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Description</label>
                            <textarea class="form-control rounded-0 bg-light description-box" readonly>@Model.Description</textarea>
                        </div>

                        <!-- 🔹 Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Type</label>
                            <input type="text"
                                   class="form-control border border-1 rounded-0 bg-light"
                                   value="@Model.Type"
                                   readonly />
                        </div>

                        <!-- 🔹 Status -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-dark d-block mb-1">Status</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Status" value="Active"
                                       @(Model.Status?.Trim() == "Active" ? "checked" : "") />
                                <label class="form-check-label">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Status" value="Inactive"
                                       @(Model.Status?.Trim() == "Inactive" ? "checked" : "") />
                                <label class="form-check-label">Inactive</label>
                            </div>
                        </div>



                        <!-- 🔹 Initiator Permission -->
                        <div class="col-md-12">
                            <div class="border border-1 rounded-0 p-3 bg-light">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="userrequiredApproval"
                                           @(Model.UserRequiredApproval ? "checked" : "") />
                                    <label class="form-check-label fw-semibold" for="userrequiredApproval">
                                        Can the initiator validate or approve?
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- 🔹 Save -->
                        <div class="col-md-12 text-end">
                            <button type="button" id="saveConfig" class="btn btn-primary px-4 rounded-0 shadow-sm">
                                <i class="mdi mdi-content-save-outline me-1"></i> Update
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Unknown configuration type.</div>
        }
    </div>
}


<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to perform this action?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmUpdate">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- =================== SCRIPT =================== -->
<script>
    $(document).ready(function () {

        // ================= Show modal on Update click =================
        $("#saveConfig").on("click", function (e) {
            e.preventDefault();
            $("#confirmationModal").modal('show');
        });

        // ================= Handle update on modal OK =================
        $("#confirmUpdate").on("click", function () {
            const payload = {
                id: $("#id").val(),
                type: $("#type").val(),
                command: $("#command").val(),
                userrequiredApproval: $("#userrequiredApproval").is(":checked"),
                status: $("input[name='Status']:checked").val() || ""
            };

            const $submitBtn = $("#saveConfig");
            const origHtml = $submitBtn.data('orig-html') || $submitBtn.html();
            $submitBtn.data('orig-html', origHtml);

            $.ajax({
                url: '/ConfigurationManualEntry/UpdateConfigurationManualEntry',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                beforeSend: function () {
                    $submitBtn.prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span> Saving...');
                },
                success: function (res) {
                    $("#confirmationModal").modal('hide');
                    if (res.success) {
                        appalert(res.message || 'Configuration updated successfully.', 1, 3);
                    } else {
                        appalert(res.message || 'Failed to update configuration.', 2, 1);
                    }
                },
                error: function (xhr) {
                    $("#confirmationModal").modal('hide');
                    console.error("AJAX error:", xhr);
                    appalert("⚠️ Error updating configuration: " + xhr.statusText, 0, 1);
                },
                complete: function () {
                    $submitBtn.prop('disabled', false).html(origHtml);
                }
            });
        });
    });
</script>
