@model CBS.FrontDesk.Data.Entity.AccountongV2.ConfigurationManualEntries

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "configForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "id" })
    @Html.HiddenFor(m => m.Type, new { id = "type" })

    <style>
        .header-viewer {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 1rem;
            text-align: center;
            font-size: 0.95rem;
            color: #555;
            border-left: 4px solid #198754;
        }

            .header-viewer h6 {
                font-weight: 700;
                color: #198754;
                margin-bottom: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

        /* 🔹 Improved description: bg-light + visible text + fixed box */
        .description-box {
            background-color: #f8f9fa !important; /* Bootstrap bg-light */
            color: #212529 !important; /* Visible readable text */
            font-weight: 500;
            font-size: 0.95rem;
            line-height: 1.6;
            border: 1px solid #dee2e6;
            resize: none; /* Prevent resizing */
            height: 95px; /* Fixed height */
            overflow-y: auto; /* Scroll if content exceeds height */
            cursor: default;
            padding: 10px 12px;
        }
    </style>

    <div class="container mt-2">

        <div class="header-viewer">
            <h6>
                <i class="mdi mdi-cog-outline me-1"></i> CONFIGURATION DETAILS
            </h6>
            <p class="mb-0">
                Configuration done by Head Office. Use this panel to review or update the workflow setup.
            </p>
        </div>

        @* ==========================
            🔹 INTERBRANCH CONFIGURATION
            ========================== *@
        @if (Model.Type != null && Model.Type.Trim().Equals("Interbranch", System.StringComparison.OrdinalIgnoreCase))
        {
            <div class="card rounded-0 shadow-sm mb-4">
                <div class="card-header bg-light bg-gradient py-3 rounded-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-success">
                        <i class="mdi mdi-sitemap-outline me-2"></i> Interbranch Workflow
                    </h5>
                    <span class="badge bg-light text-success fw-semibold px-3 py-2">Configuration Panel</span>
                </div>

                <div class="card-body bg-white px-4 py-4">
                    <div class="row gy-4">
                        <!-- Command Section -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Command</label>
                            <div class="p-2 border border-1 rounded-0 bg-light">
                                <div class="form-check mb-2">
                                    <input class="form-check-input inter-command" type="checkbox" name="Command" value="AAS" id="interAAS"
                                           @(Model.Command == "AAS" ? "checked" : "") />
                                    <label class="form-check-label" for="interAAS">A.A.S</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input inter-command" type="checkbox" name="Command" value="AADS" id="interAADS"
                                           @(Model.Command == "AADS" ? "checked" : "") />
                                    <label class="form-check-label" for="interAADS">A.A.D.S</label>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold  text-dark">Description</label>
                            <textarea class="form-control rounded-0 bg-light description-box" readonly>
A.A.S : Automatic Approval Source
A.A.D.S : Automatic Approval Destination Source
                            </textarea>
                        </div>

                        <!-- Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Type</label>
                            <input type="text" class="form-control border border-1 rounded-0 bg-light" value="Interbranch" readonly />
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Status</label><br />
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="IsActive" value="true" id="statusActive"
                                       @(Model.StatusIsActive ? "checked" : "") />
                                <label class="form-check-label" for="statusActive">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="IsActive" value="false" id="statusInactive"
                                       @(!Model.StatusIsActive ? "checked" : "") />
                                <label class="form-check-label" for="statusInactive">Inactive</label>
                            </div>
                        </div>

                        <!-- Initiator Permission -->
                        <div class="col-md-12">
                            <div class="border border-1 rounded-0 p-3 bg-light">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="userrequiredApproval"
                                           @(Model.UserRequiredApproval ? "checked" : "") />
                                    <label class="form-check-label fw-semibold" for="userrequiredApproval">
                                        Can the initiator validate or approve?
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Save -->
                        <div class="col-md-12 text-end">
                            <button type="button" id="saveConfig" class="btn btn-primary px-4 rounded-0 shadow-sm">
                                <i class="mdi mdi-content-save-outline me-1"></i> Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        @* ======================
            🔹 LOCAL CONFIGURATION
            ====================== *@
        else if (Model.Type != null && Model.Type.Trim().Equals("Local", System.StringComparison.OrdinalIgnoreCase))
        {
            <div class="card rounded-0 shadow-sm mb-4">
                <div class="card-header bg-light bg-gradient py-3 rounded-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-success">
                        <i class="mdi mdi-sitemap-outline me-2"></i> Local Workflow
                    </h5>
                    <span class="badge bg-light text-success fw-semibold px-3 py-2">Configuration Panel</span>
                </div>

                <div class="card-body bg-white px-4 py-4">
                    <div class="row gy-4">
                        <!-- Command Section -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Command</label>
                            <div class="p-2 border border-1 rounded-0 bg-light">
                                <div class="form-check mb-2">
                                    <input class="form-check-input inter-command" type="checkbox" name="Command" value="Auto" id="localAuto"
                                           @(Model.Command == "Auto" ? "checked" : "") />
                                    <label class="form-check-label" for="localAuto">Auto</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input inter-command" type="checkbox" name="Command" value="RA" id="localRA"
                                           @(Model.Command == "RA" ? "checked" : "") />
                                    <label class="form-check-label" for="localRA">R.A</label>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-md-6 ">
                            <label class="form-label fw-semibold text-dark">Description</label>
                            <textarea class="form-control rounded-0 bg-light description-box" readonly>
Auto : Automatic Approval
R.A : Require Approval
                            </textarea>
                        </div>

                        <!-- Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Type</label>
                            <input type="text" class="form-control border border-1 rounded-0 bg-light" value="Local" readonly />
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Status</label><br />
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="IsActive" value="true" id="statusActiveLocal"
                                       @(Model.StatusIsActive ? "checked" : "") />
                                <label class="form-check-label" for="statusActiveLocal">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="IsActive" value="false" id="statusInactiveLocal"
                                       @(!Model.StatusIsActive ? "checked" : "") />
                                <label class="form-check-label" for="statusInactiveLocal">Inactive</label>
                            </div>
                        </div>

                        <!-- Initiator Permission -->
                        <div class="col-md-12">
                            <div class="border border-1 rounded-0 p-3 bg-light">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="userrequiredApprovalLocal"
                                           @(Model.UserRequiredApproval ? "checked" : "") />
                                    <label class="form-check-label fw-semibold" for="userrequiredApprovalLocal">
                                        Can the initiator validate or approve?
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Save -->
                        <div class="col-md-12 text-end">
                            <button type="button" id="saveConfig" class="btn btn-primary px-4 rounded-0 shadow-sm">
                                <i class="mdi mdi-content-save-outline me-1"></i> Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Unknown configuration type</div>
        }
    </div>
}



<!-- =============== SCRIPT SECTION =============== -->
<script>
    $(document).ready(function () {

        // ✅ Allow only one command checked
        $('.inter-command, .local-command').on('change', function () {
            const group = $(this).hasClass('inter-command') ? '.inter-command' : '.local-command';
            $(group).not(this).prop('checked', false);
        });

        // ✅ Handle Save click
        $("#saveConfig").on("click", function (e) {
            e.preventDefault();

            const id = $("#id").val();
            const type = $("#type").val();
            const command = $(".inter-command:checked, .local-command:checked").val() || "";
            const userrequiredApproval = $("#userrequiredApproval").is(":checked");
            const status = $("input[name='IsActive']:checked").val() === "true";

            $.ajax({
                url: '/ConfigurationManualEntry/UpdateConfigurationManualEntry',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    id: id,
                    type: type,
                    command: command,
                    userrequiredApproval: userrequiredApproval,
                    status: status
                }),
                success: function (res) {
                    if (res.success)
                        appalert(res.message, 1, 3);
                    else
                        appalert(res.message, 2, 1);
                },
                error: function () {
                    appalert('⚠️ Failed to update configuration. Please try again.', 2, 1);
                }
            });
        });
    });
</script>
