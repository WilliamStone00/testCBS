
@using Resources
@{
    ViewBag.Title = "Interbranch / Local Configuration";
}
@Html.AntiForgeryToken()

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> @GlobalConfigurationManualEntry.InterbranchLocalConfiguration
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1 "></i>
            Configure posting rules for <strong>Local</strong> and <strong>Interbranch</strong> transactions.
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalConfigurationManualEntry.TIPSFORCONFIGURATIONSETUP</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConfigTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseConfigTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><strong>@GlobalConfigurationManualEntry.TypeSelection:</strong>@GlobalConfigurationManualEntry.ChoosewhethertheconfigurationappliestoLocalorInterbranchoperations.</li>
                <li><strong>@GlobalConfigurationManualEntry.Command:</strong> @GlobalConfigurationManualEntry.DefinehowtheprocessrunsoptionsincludeAutoAutoApprovalandotherautomationmodes.</li>
                <li><strong>@GlobalConfigurationManualEntry.Description:</strong> @GlobalConfigurationManualEntry.Provideashortsummaryexplainingtheconfigurationpurposeorbehavior.</li>
                <li><strong>@GlobalConfigurationManualEntry.UserApproval:</strong> @GlobalConfigurationManualEntry.Enablethisiftheinitiatingusermustalsoapprovethetransaction.</li>
                <li><strong>@GlobalConfigurationManualEntry.Status:</strong> @GlobalConfigurationManualEntry.Usethistoggletoactivateordeactivateaconfigurationwithoutdeletingit.</li>
                <li><strong>@GlobalConfigurationManualEntry.ReviewRegularly:</strong>@GlobalConfigurationManualEntry.Keepconfigurationdataalignedwithcurrentbranchrulesandapprovalworkflows.</li>
                <li><strong>@GlobalConfigurationManualEntry.SaveChanges:</strong>@GlobalConfigurationManualEntry.Alwaysvalidateentriesbeforesavingorupdatingtoensureintegrityacrossbranches.</li>
            </ul>
        </div>
    </div>
</div>



<div id="datalistingview">


</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">@GlobalConfigurationManualEntry.EditConfiguration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- Partial content loads here -->
            </div>
        </div>
    </div>
</div>











@section Scripts {
    <script>
        $(document).ready(function () {
            try {
                LoadDataGen('ConfigurationManualEntry', 'myDataTable', '_Data', 0, 'datalistingview', null, 'list');
                appalert('✅ Data loaded successfully.', 1, 1); // success
            } catch (error) {
                console.error("❌ Initialization error:", error);
                appalert('❌ Failed to initialize data table. Please refresh the page.', 0, 1);
            }
        });

        function EditResetModal(id, modalId, contentId, controller, action, partialView, typeAction, title, labelId, callback) {
            const url = `/${controller}/${action}?KEY=${id}&partialView=${partialView}`;
            console.log("🟢 Loading partial view from:", url);

            $.get(url)
                .done(function (data) {
                    // ✅ Inject the loaded partial into modal content
                    $(`#${contentId}`).html(data);

                    // Set the modal label title if provided
                    if (labelId)
                        document.getElementById(labelId).innerText = title;

                    // Initialize and show modal
                    var modal = new bootstrap.Modal(document.getElementById(modalId), {
                        backdrop: 'static',
                        keyboard: false
                    });
                    modal.show();

                    // Optional callback
                    if (typeof callback === "function") callback();

                    appalert('✅ Edit form loaded successfully.', 1, 1);
                })
                .fail(function (xhr) {
                    console.error("❌ Error loading modal:", xhr);
                    if (xhr.status === 404) {
                        appalert('⚠️ The requested record could not be found.', 2, 1);
                    } else if (xhr.status === 401) {
                        appalert('⚠️ Unauthorized access. Please log in again.', 2, 1);
                        window.location.href = '/Authentication/Login';
                    } else {
                        appalert('❌ Failed to load edit form. Please try again later.', 0, 1);
                    }
                })
                .always(function () {
                    console.log("ℹ️ EditResetModal request completed for:", controller);
                });
        }


        window.configurationSaveAjax = function (form) {
            event.preventDefault();

            // ✅ Prepare payload from form fields
            const payload = {
                id: $("#id").val(),
                type: $("#type").val(),
                command: $(".inter-command:checked, .local-command:checked").val() || "",
                userrequiredApproval: $("#userrequiredApproval").is(":checked") ||
                    $("#userrequiredApprovalLocal").is(":checked"),
                status: $("input[name='Status']:checked").val() || ""
            };

            const $submitBtn = $("#saveConfig");
            const origHtml = $submitBtn.data('orig-html') || $submitBtn.html();
            $submitBtn.data('orig-html', origHtml);

            $.ajax({
                url: '/ConfigurationManualEntry/UpdateConfigurationManualEntry',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify(payload),
                beforeSend: function () {
                    $submitBtn.prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span> Saving...');
                },
                success: function (res) {
                    if (res.success) {
                        appalert(res.message || 'Configuration updated successfully.', 1, 3);
                    } else {
                        appalert(res.message || 'Failed to update configuration.', 2, 1);
                    }
                },
                error: function (xhr) {
                    console.error("AJAX error:", xhr);
                    appalert("⚠️ Error updating configuration: " + xhr.statusText, 0, 1);
                },
                complete: function () {
                    $submitBtn.prop('disabled', false).html(origHtml);
                }
            });

            return false;
        };

        // Auto-bind form submit
        $(document).on('submit', '#configForm', function (e) {
            e.preventDefault();
            return window.configurationSaveAjax(this);
        });

        // Bind save button click
        $(document).on('click', '#saveConfig', function (e) {
            e.preventDefault();
            return window.configurationSaveAjax($("#configForm")[0]);
        });
    </script>
}

