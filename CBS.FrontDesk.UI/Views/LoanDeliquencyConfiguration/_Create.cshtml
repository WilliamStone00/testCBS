@model CBS.FrontDesk.Data.Entity.LoanConf.LoanDeliquencyConfiguration
<div class="card-body">
    @using (Html.BeginForm("Create", "LoanDeliquencyConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<fieldset class="fieldset-custom">
            <legend>Deliquencies Configurations</legend>
            @Html.HiddenFor(model => model.Id)
            <div class="row mt-2 gy-4">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        <label>Name</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.DaysFrom, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.DaysFrom, "", new { @class = "text-danger" })
                        <label>Loans from day</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.DaysTo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.DaysTo, "", new { @class = "text-danger" })
                        <label>Loans to day</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.Status, new SelectList(ViewBag.LoanStatuses, "Text", "Value"), "---Select loan status---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger " })
                        <label>Status</label>
                    </div>
                </div>
                <hr />
                <div class="col-12">
                    <h5>Member Actions</h5>
                    <div class="row">
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.SendSMStoClient, new { @class = "form-check-input" })
                                <label class="form-check-label" for="SendSMStoClient">Send SMS to members</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AffectScoring, new { @class = "form-check-input" })
                                <label class="form-check-label" for="AffectScoring">Affect member's scoring</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.ApplyFine, new { @class = "form-check-input" })
                                <label class="form-check-label" for="ApplyFine">Apply fines</label>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="col-12">
                    <h5>Team Actions</h5>
                    <div class="row">
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.SendSMS, new { @class = "form-check-input" })
                                <label class="form-check-label" for="SendSMS">Send SMS to follow-up team</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.SendMail, new { @class = "form-check-input" })
                                <label class="form-check-label" for="SendMail">Send email to follow-up team</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.ReportToCreditOffice, new { @class = "form-check-input" })
                                <label class="form-check-label" for="ReportToCreditOffice">Report to credit office</label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>

                }
            </div>
        </fieldset>
    }
</div>