@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanDeliquencyConfiguration>
<fieldset class="fieldset-custom">
    <legend>Data</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>No loan LoanDeliquencyConfiguration type is created</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Status</th>
                        <th>SMS-Members</th>
                        <th>A-M.Score</th>
                        <th>Fine</th>
                        <th>SMS-Team</th>
                        <th>Email-Team</th>
                        <th>Credit-O</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:14%">@d.Name</td>
                            <td style="width:8%">@d.DaysFrom Ds</td>
                            <td style="width:8%">@d.DaysTo Ds</td>
                            <td style="width:15%">@d.Status</td>
                            <td style="width:8%">
                                @if (d.SendSMStoClient)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.AffectScoring)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.ApplyFine)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.SendSMS)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.SendMail)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:8%">
                                @if (d.ReportToCreditOffice)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Create','update','LoanDeliquencyConfiguration')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('LoanDeliquencyConfiguration','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
    </fieldset>


