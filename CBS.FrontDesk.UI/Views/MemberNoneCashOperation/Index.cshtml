@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier
    @using Resources
@{
    ViewBag.Title = "Member's None Cash Operations";
}
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<!-- Page Header -->
<div class="row mb-0">
    <div class="col">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-wallet-outline me-2"></i></i> @GlobalMemberNoneCashOperation.manage_members_none_cash_operations
                </h1>
                <p class="card-text">
                    @GlobalMemberNoneCashOperation.perform_other_nonecash_transactions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-0">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOperationTips" aria-expanded="false" aria-controls="collapseOperationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseOperationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.use_the_search_bar_to_find_amembers_account.</li>
                <li><i class="mdi mdi-account-box-outline text-primary me-2"></i> @GlobalMemberNoneCashOperation.verify_the_members_name_and_account_details.</li>
                <li><i class="mdi mdi-wallet-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.select_whether_to <strong>@GlobalShared.Debit</strong> @GlobalShared.or <strong>@GlobalShared.Credit</strong> @GlobalMemberNoneCashOperation.the_members_account_by_choosing_the_appropriate_option.</li>
                <li><i class="mdi mdi-chart-areaspline text-primary me-2"></i> @GlobalMemberNoneCashOperation.choose_the_corresponding_general_ledger.</li>
                <li><i class="mdi mdi-note-edit-outline text-info me-2"></i> @GlobalMemberNoneCashOperation.provide_adetailed_note_describing_the_reason_for_the_operation.</li>
                <li><i class="mdi mdi-cash-multiple text-warning me-2"></i> @GlobalMemberNoneCashOperation.double_check_all_amounts_entered.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalMemberNoneCashOperation.only_one_operation_can_be_processed_at_atime.</li>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalMemberNoneCashOperation.ensure_the_selected_ledger_and_member_account_are_correct.</li>
                <li><i class="mdi mdi-shield-check-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.once_a_transaction_is_submitted.</li>
                <li><i class="mdi mdi-clock-outline text-warning me-2"></i> @GlobalMemberNoneCashOperation.the_members_account_will_only_be_impacted_once.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col">
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-wallet-outline me-2"></i>
                            <span id="cashDeskOperations">@GlobalMemberNoneCashOperation.members_other_none_cash_operation</span>
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <hr style="border: 2px solid blue;" />
                            @Html.Partial("_SearchBox")
                            <hr style="border: 2px solid blue;" />
                            <div id="datalistingview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/MemberNoneCashOperation/MembersNoneCashOperations.js"></script>
}
