




@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier

<!-- Header Section -->
<div class="row mb-3">
    <div class="col">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-check-circle-outline me-2"></i> Validate Member None-Cash Operation
                </h1>
                <p class="card-text">
                    Approve or reject the member's operation based on the provided details. Please ensure the decision is final before submission.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Operation Details Section -->
<div class="card mb-4">
    <div class="card-header bg-light text-primary fw-bold">
        <i class="mdi mdi-information-outline me-2"></i> Operation Details
    </div>
    <div class="card-body">
        <div class="row gy-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Transaction Reference:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.TransactionReference" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Member Reference:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.MemberReference" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Member Name:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.MemberName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Account Number:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.AccountNUmber" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Chart of Account:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.ChartOfAccountName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Booking Direction:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.BookingDirection" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Amount:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.Amount.ToString("N1")" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Initiated By:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.InitiatedUserName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Request Date:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.RequestDate.ToString("dd/MM/yyyy HH:mm")" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Approval Status:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.ApprovalStatus ?? " Pending"" readonly />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="false" aria-controls="collapseValidationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> **Verify all operation details** before approving or rejecting. Review the corresponding member account and ledger details.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> **Use the comment field** to provide any remarks or justifications related to the validation decision.</li>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> **Approval is final:** Ensure the correct decision is made as modifications post-approval require administrative permissions.</li>
                <li><i class="mdi mdi-timer-sand text-warning me-2"></i> **Review pending operations regularly** to prevent delays in member transactions.</li>
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i> **Approved transactions** will proceed to the next step, impacting the member’s account after validation.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Validation Form -->
<form id="validateOperationForm">
    <div class="mb-3">
        <label for="IsApproved" class="form-label fw-bold">Approval Decision</label>
        <div class="form-check">
            <input type="radio" id="Approve" name="IsApproved" value="true" class="form-check-input" checked />
            <label for="Approve" class="form-check-label">Approve</label>
        </div>
        <div class="form-check">
            <input type="radio" id="Reject" name="IsApproved" value="false" class="form-check-input" />
            <label for="Reject" class="form-check-label">Reject</label>
        </div>
    </div>
    <input type="hidden" id="OperationId" name="OperationId" class="form-control" value="@Model.MemberNoneCashOperation.Id" readonly />
    <div class="mb-3">
        <label for="ValidationComment" class="form-label fw-bold">Validation Comment</label>
        <textarea id="ValidationComment" name="ValidationComment" class="form-control" rows="4" placeholder="Provide a comment for the validation"></textarea>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-check-circle me-1"></i> Submit Validation
        </button>
        <button type="button" class="btn btn-secondary ms-2" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Cancel
        </button>
    </div>
</form>
