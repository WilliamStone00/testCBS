



@using Resources
@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier

<!-- Header Section -->
<div class="row mb-3">
    <div class="col">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-check-circle-outline me-2"></i> @GlobalMemberNoneCashOperation.ValidateMemberNoneCashOperation
                </h1>
                <p class="card-text">
                    @GlobalMemberNoneCashOperation.ApproveOrRejectTheMembersOperationBasedOnTheProvidedDetails.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Operation Details Section -->
<div class="card mb-4">
    <div class="card-header bg-light text-primary fw-bold">
        <i class="mdi mdi-information-outline me-2"></i> @GlobalMemberNoneCashOperation.OperationDetails
    </div>
    <div class="card-body">
        <div class="row gy-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.TransactionReference:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.TransactionReference" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.MemberReference:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.MemberReference" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.MemberName:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.MemberName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.AccountNumber:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.AccountNUmber" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.ChartOfAccount:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.ChartOfAccountName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.BookingDirection:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.BookingDirection" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.Amount:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.Amount.ToString("N1")" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.InitiatedBy:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.InitiatedUserName" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.RequestDate:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.RequestDate.ToString("dd/MM/yyyy HH:mm")" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">@GlobalMemberNoneCashOperation.ApprovalStatus:</label>
                <input type="text" class="form-control" value="@Model.MemberNoneCashOperation.ApprovalStatus ?? " Pending"" readonly />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalMemberNoneCashOperation.TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="false" aria-controls="collapseValidationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.VerifyAllOperationDetailsBeforeApprovingOrRejecting.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalMemberNoneCashOperation.UseTheCommentFieldToProvideAnyRemarks.</li>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalMemberNoneCashOperation.ApprovalIsFinalEnsureTheCorrectDecisionIsMade.</li>
                <li><i class="mdi mdi-timer-sand text-warning me-2"></i> @GlobalMemberNoneCashOperation.ReviewPendingOperationsRegularly.</li>
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i> @GlobalMemberNoneCashOperation.ApprovedTransactionsWillProceedToTheNextStep.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Validation Form -->
<form id="validateOperationForm">
    <div class="mb-3">
        <label for="IsApproved" class="form-label fw-bold">@GlobalMemberNoneCashOperation.ApprovalDecision</label>
        <div class="form-check">
            <input type="radio" id="Approve" name="IsApproved" value="true" class="form-check-input" checked />
            <label for="Approve" class="form-check-label">@GlobalShared.Approve</label>
        </div>
        <div class="form-check">
            <input type="radio" id="Reject" name="IsApproved" value="false" class="form-check-input" />
            <label for="Reject" class="form-check-label">@GlobalShared.Reject</label>
        </div>
    </div>
    <input type="hidden" id="OperationId" name="OperationId" class="form-control" value="@Model.MemberNoneCashOperation.Id" readonly />
    <div class="mb-3">
        <label for="ValidationComment" class="form-label fw-bold">@GlobalMemberNoneCashOperation.ValidationComment</label>
        <textarea id="ValidationComment" name="ValidationComment" class="form-control" rows="4" placeholder="@GlobalMemberNoneCashOperation.ProvideACommentForTheValidation"></textarea>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-check-circle me-1"></i> @GlobalMemberNoneCashOperation.SubmitValidation
        </button>
        <button type="button" class="btn btn-secondary ms-2" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> @GlobalShared.Cancel
        </button>
    </div>
</form>
