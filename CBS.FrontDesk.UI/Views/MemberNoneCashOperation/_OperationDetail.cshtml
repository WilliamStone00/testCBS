@model CBS.FrontDesk.Data.Entity.MemberNoneCashOperationsP.MemberNoneCashOperationCarrier
@using Resources
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped" id="operationDetailsTable">
                <tbody>
                    <!-- General Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalMemberNoneCashOperation.GeneralInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.MemberName:</td>
                        <td>@Model.MemberNoneCashOperation.MemberName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.MemberReference:</td>
                        <td>@Model.MemberNoneCashOperation.MemberReference</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountNumber:</td>
                        <td>@Model.MemberNoneCashOperation.AccountNUmber</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.ChartOfAccount:</td>
                        <td>@Model.MemberNoneCashOperation.ChartOfAccountName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.Amount:</td>
                        <td>@Model.MemberNoneCashOperation.Amount.ToString("#,##0.0") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.BookingDirection:</td>
                        <td>
                            @if (Model.MemberNoneCashOperation.BookingDirection == "Debit")
                            {
                                <span class="badge bg-danger">@GlobalMemberNoneCashOperation.Debit</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@GlobalMemberNoneCashOperation.Credit</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Note:</td>
                        <td>@Model.MemberNoneCashOperation.Note</td>
                    </tr>

                    <!-- Approval Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalMemberNoneCashOperation.ApprovalInformation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.ApprovalStatus:</td>
                        <td>
                            @if (Model.MemberNoneCashOperation.ApprovalStatus == "Approved")
                            {
                                <span class="badge bg-success">@GlobalShared.Approved</span>
                            }
                            else if (Model.MemberNoneCashOperation.ApprovalStatus == "Rejected")
                            {
                                <span class="badge bg-danger">@GlobalShared.Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.ApprovedBy:</td>
                        <td>@Model.MemberNoneCashOperation.ApprovedBy</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.ApprovalDate:</td>
                        <td>@Model.MemberNoneCashOperation.ApprovalDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.ApprovalComment:</td>
                        <td>@Model.MemberNoneCashOperation.ApprovalComment</td>
                    </tr>

                    <!-- Source and Branch Details -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalMemberNoneCashOperation.SourceAndBranchDetails</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.Source:</td>
                        <td>@Model.MemberNoneCashOperation.Source</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.BranchName:</td>
                        <td>@Model.MemberNoneCashOperation.BranchName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.BranchCode:</td>
                        <td>@Model.MemberNoneCashOperation.BranchCode</td>
                    </tr>

                    <!-- Operation Metadata -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalMemberNoneCashOperation.OperationMetadata</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.InitiatedBy:</td>
                        <td>@Model.MemberNoneCashOperation.InitiatedUserName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.RequestDate:</td>
                        <td>@Model.MemberNoneCashOperation.RequestDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountingDate:</td>
                        <td>@Model.MemberNoneCashOperation.AccountingDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalMemberNoneCashOperation.TransactionReference:</td>
                        <td>@Model.MemberNoneCashOperation.TransactionReference</td>
                    </tr>

                    <!-- Account Details -->
                    @if (Model.MemberNoneCashOperation.Account != null)
                    {
                        <tr class="table-primary">
                            <td colspan="2" class="font-weight-bold text-center">@GlobalMemberNoneCashOperation.AccountInformation</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountHolderName:</td>
                            <td>@Model.MemberNoneCashOperation.Account.CustomerName</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountType:</td>
                            <td>@Model.MemberNoneCashOperation.Account.AccountType</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountNumber:</td>
                            <td>@Model.MemberNoneCashOperation.Account.AccountNumber</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">@GlobalMemberNoneCashOperation.AccountBalance:</td>
                            <td>@Model.MemberNoneCashOperation.Account.Balance.ToString("#,##0.0") FCFA</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
