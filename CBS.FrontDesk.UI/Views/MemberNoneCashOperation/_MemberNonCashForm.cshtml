@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<style>
    /* General fieldset spacing */
    .fieldset-custom {
        padding: 0.5rem 0.75rem;
    }

        .fieldset-custom .section {
            border: 1px solid var(--bs-secondary, #dee2e6);
            border-radius: .5rem;
            padding: .5rem .75rem; /* was bigger */
            margin-bottom: .5rem; /* was larger */
            background-color: #fff;
        }

            .fieldset-custom .section:last-of-type {
                margin-bottom: 0.25rem;
            }

            .fieldset-custom .section h6 {
                margin: 0 0 .35rem 0;
                font-weight: 600;
                font-size: .9rem; /* slightly smaller heading */
            }

            /* Rows inside sections: reduce vertical rhythm */
            .fieldset-custom .section .row {
                margin-bottom: .25rem;
            }

            /* Kill extra bottom margin on Bootstrap utilities inside */
            .fieldset-custom .section .mb-3,
            .fieldset-custom .section .mb-2 {
                margin-bottom: .5rem !important;
            }

        .fieldset-custom .form-floating {
            padding: 0.35rem 0.5rem;
        }

        .fieldset-custom .form-control,
        .fieldset-custom .select2-selection--single {
            min-height: 34px;
            padding-top: .25rem;
            padding-bottom: .25rem;
        }

        .fieldset-custom .table {
            margin-bottom: 0.25rem;
        }

            .fieldset-custom .table tfoot td {
                padding-top: .15rem;
                padding-bottom: .15rem;
            }

        /* Buttons row */
        .fieldset-custom .d-flex.justify-content-end.mt-3 {
            margin-top: .75rem !important;
        }
</style>


<fieldset class="fieldset-custom">

    <!-- Member summary -->
    <div class="section">
        <div class="row g-1 align-items-center">
            <div class="col-12">
                <span class="formatted-amount shadow-sm d-block py-2 px-3 bg-light rounded border border-secondary">
                    <strong>@GlobalShared.Members_name:</strong> @Model.Customer.name &nbsp; | &nbsp;
                    <strong>@GlobalShared.Branch_Name:</strong> @Model.Branch.Name &nbsp; | &nbsp;
                    <strong>@GlobalShared.Branch_Code:</strong> @Model.Branch.BranchCode
                </span>
            </div>
        </div>
    </div>


    <!-- Branch (standalone section) -->
    <div class="section">
        <h6 class="text-dark">@GlobalShared.Branch_Name</h6>
        <div class="row g-2 mb-1">
            <div class="col-md-12">
                <div class="form-floating border rounded">
                    @Html.DropDownListFor(
                        m => m.AddMembersNoneCashOperationCommand.BranchId,
                        new SelectList(ViewBag.Branches, "Id", "Name"),
                        "---" + GlobalShared.Select_All + "---",
                        new { @class = "form-control shadow-sm select2", id = "branchInput" })
                    @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.BranchId, "", new { @class = "text-danger" })
                    <label for="branchInput">@GlobalShared.Branch_Name</label>
                </div>
            </div>
        </div>

        <h6 class="fw-bold text-dark mb-2" style="display:none">Mobile Money</h6>

        <div class="row g-3" style="display:none">
            <!-- Left side: Checkbox + categories under it -->
            <div class="col-md-12">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(
                        m => m.AddMembersNoneCashOperationCommand.IsMobileMoneyOperation,
                        new { @class = "form-check-input", id = "isMobileMoneyOperationChk" })
                    <label class="form-check-label fw-semibold ms-1" for="isMobileMoneyOperationChk">
                        @GlobalMemberNoneCashOperation.is_mobile_money_operation
                    </label>
                </div>

                <!-- ✅ Categories directly under checkbox -->
                <div id="momoCategoryContainer" class="d-none mt-2 border rounded p-2">
                    <label class="fw-semibold d-block mb-2">@GlobalShared.service_type/@GlobalShared.Category</label>

                    <div class="form-check">
                        <input type="radio" id="orangeMoneyRadio"
                               name="momoCategory"
                               value="Orange Money Cameroon"
                               data-category="MobileMoneyOrange"
                               class="form-check-input" />
                        <label class="form-check-label" for="orangeMoneyRadio">
                            Orange Money Cameroon
                        </label>
                    </div>

                    <div class="form-check mt-2">
                        <input type="radio" id="mtnMoneyRadio"
                               name="momoCategory"
                               value="MTN Cameroon"
                               data-category="MobileMoneyMTN"
                               class="form-check-input" />
                        <label class="form-check-label" for="mtnMoneyRadio">
                            MTN Cameroon
                        </label>
                    </div>
                </div>
                <!-- ✅ Mobile Money Path (shown only when checkbox is checked) -->
                <div id="momoPathContainer" class="d-none mt-2 border rounded p-3">
                    <label class="fw-bold text-dark d-block mb-2">MoMo / @GlobalMemberNoneCashOperation.orange_money_how_should_the_funds_move?</label>
                    <small class="text-muted d-block mb-3">
                        @GlobalMemberNoneCashOperation.choose_the_flow_well_autoset_the_booking_direction_debitcredit_and_youll_see_which_side_increases_or_decreases.
                    </small>

                    <!-- Option 1 -->
                    <div class="form-check mb-3">
                        <input type="radio"
                               id="path_member_to_float"
                               name="momoPath"
                               value="FloatFromMembersAccountToMomoAccount"
                               class="form-check-input"
                               disabled />
                        <label class="form-check-label" for="path_member_to_float">
                            <strong>@GlobalMemberNoneCashOperation.member_account_momo_float</strong>
                            <div class="text-muted small mt-1">
                                <span class="d-block">@GlobalShared.effect: <b>@GlobalMemberNoneCashOperation.member_account_debited (↓)</b>, <b>@GlobalMemberNoneCashOperation.momo_float_credited (↑)</b></span>
                                <span class="d-block">@GlobalMemberNoneCashOperation.use_when_the_branch_transfers_money_from_the_members_account_to_the_momoom_float.</span>
                            </div>
                        </label>
                    </div>


                    <!-- Option 2 -->
                    <div class="form-check mb-3">
                        <input type="radio"
                               id="path_member_to_float_to_phone"
                               name="momoPath"
                               value="FromMembersAccountToMobilemoneyAndToMembersPhone"
                               class="form-check-input" />
                        <label class="form-check-label" for="path_member_to_float_to_phone">
                            <strong>@GlobalMemberNoneCashOperation.member_account_momo_float_members_phone_wallet_payout</strong>
                            <div class="text-muted small mt-1">
                                <span class="d-block">@GlobalShared.effect: <b>@GlobalMemberNoneCashOperation.member_account_debited (↓)</b>, <b>@GlobalMemberNoneCashOperation.momo_float_credited (↓)</b> (@GlobalMemberNoneCashOperation.float_decreases_when_cash_leaves_to_wallet)</span>
                                <span class="d-block">@GlobalMemberNoneCashOperation.use_when_the_member_requests_a_payout_to_their_mtnorange_wallet.</span>
                            </div>
                        </label>
                    </div>

                    <!-- Option 3 -->
                    <div class="form-check">
                        <input type="radio"
                               id="path_phone_to_member"
                               name="momoPath"
                               value="FloatFromMobileMoneyToMembersAccount"
                               class="form-check-input" />
                        <label class="form-check-label" for="path_phone_to_member">
                            <strong>@GlobalMemberNoneCashOperation.members_phone_wallet_momo_float → @GlobalShared.Member_account</strong>
                            <div class="text-muted small mt-1">
                                <span class="d-block">@GlobalShared.effect: <b>@GlobalShared.Member_account = @GlobalShared.credited (↑)</b>, <b>@GlobalMemberNoneCashOperation.momo_float = @GlobalShared.debited (↑)</b></span>
                                <span class="d-block">@GlobalMemberNoneCashOperation.the_member_sends_funds_from_their_momo_wallet_branch_float_increases_in_debit_and_the_members_local_account_is_credited.</span>
                            </div>
                        </label>
                    </div>

                </div>

            </div>

            <!-- Right side: Reference -->
            <div class="col-md-12 d-none" id="momoReferenceContainer">
                <div class="form-floating border rounded">
                    @Html.DropDownListFor(
                        m => m.AddMembersNoneCashOperationCommand.NoneMemberMobileReference,
                        new SelectList(ViewBag.MobileMoneyRefs ?? new List<SelectListItem>(), "Value", "Text"),
                        "--- MoMo reference ---",
                        new { @class = "form-control shadow-sm select2", id = "noneMemberMobileReference" })
                    @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.NoneMemberMobileReference, "", new { @class = "text-danger" })
                    <label for="noneMemberMobileReference">@GlobalMemberNoneCashOperation.select_mmom_operation_collection_account</label>
                </div>
            </div>
        </div>
    </div>



    <!-- Booking dir + Accounting date on one line -->
    <div class="section">
        <div class="row g-2 align-items-center">
            <div class="col-md-8">
                <label class="fw-semibold text-dark mb-1">@GlobalShared.booking_direction:</label>
                <div class="d-flex flex-wrap gap-3">
                    <label class="booking-option">
                        @Html.RadioButtonFor(m => m.AddMembersNoneCashOperationCommand.BookingDirection, "Debit", new { id = "Debit" })
                        @GlobalMemberNoneCashOperation.debit_members_account
                    </label>
                    <label class="booking-option">
                        @Html.RadioButtonFor(m => m.AddMembersNoneCashOperationCommand.BookingDirection, "Credit", new { id = "Credit" })
                        @GlobalMemberNoneCashOperation.credit_members_account
                    </label>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <label class="form-label fw-semibold me-2 mb-0">@GlobalShared.Accounting_Date</label>
                @Html.TextBoxFor(
                    m => m.BulkDeposit.AccountingDate,
                    Model.BulkDeposit.AccountingDate.HasValue
                        ? Model.BulkDeposit.AccountingDate.Value.ToString("yyyy-MM-dd")
                        : DateTime.Today.ToString("yyyy-MM-dd"),
                    new
                         {
                        @class = "form-control form-control-sm d-inline-block accounting-date",
                        style = "width: 180px",
                        type = "date",
                        data_date_default = "today",
                        data_date_max = "today"
                    })
                @Html.ValidationMessageFor(m => m.BulkDeposit.AccountingDate, "", new { @class = "text-danger" })
            </div>
        </div>
        <input type="hidden" id="memberName" value="@Model.AddMembersNoneCashOperationCommand.MemberName" />
    </div>    <!-- Members Accounts (compact table) -->
    <div class="section">
        <h6 class="text-dark mb-1">@GlobalShared.MEMBERS_ACCOUNTS</h6>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" id="myDataTableT">
                <thead class="table-light">
                    <tr>
                        <th style="display:none;">@GlobalShared.Product_ID</th>
                        <th>@GlobalShared.Accounts</th>
                        <th>@GlobalShared.Balance</th>
                        <th>@GlobalShared.Amount</th>
                        <th style="display:none">@GlobalShared.Fee</th>
                        <th>@GlobalShared.Total</th>
                        <th>@GlobalShared.Confirm</th>
                        <th style="display:none">@GlobalShared.Inc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                    {
                        <tr>
                            <td style="display:none;">@d.AccountNumber</td>
                            <td>@d.AccountType</td>
                            <td>@d.Balance.ToString("#,##0.0")</td>
                            <td><input type="number" class="form-control form-control-sm amount-input shadow-input-boxes" value="@d.Amount"></td>
                            <td style="display:none"><input type="number" class="form-control form-control-sm fee-input shadow-input-boxes" value="@d.Fee" readonly></td>
                            <td><span class="total-span">@d.Total</span></td>
                            <td><input type="checkbox" class="form-check-input row-select"></td>
                            <td style="display:none"><input type="checkbox" class="form-check-input check-inclussive" disabled></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><strong>@GlobalShared.Total:</strong></td>
                        <td id="tableTotal">0</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>


    <!-- Corresponding accounts + Note on one line on md+ -->
    <div class="section">
        <h6 class="text-dark mb-1">@GlobalMemberNoneCashOperation.corresponding_accounts</h6>
        <div class="row g-2">
            <div class="col-md-12" id="glContainer">
                <div class="form-floating border rounded">
                    @Html.DropDownListFor(
                        m => m.AddMembersNoneCashOperationCommand.ChartOfAccountId,
                        new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                        "---GL Account---",
                        new { @class = "form-control select2", id = "account_number", @search = "true" })
                    @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.ChartOfAccountId, "", new { @class = "text-danger" })
                    <label id="accountNumberLabel" for="account_number">@GlobalMemberNoneCashOperation.select_correspondent_account</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating border rounded">
                    @Html.TextAreaFor(m => m.AddMembersNoneCashOperationCommand.Note, new { @class = "form-control", id = "Note", style = "height: 60px;" })
                    @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.Note, "", new { @class = "text-danger" })
                    <label for="Note">@GlobalMemberNoneCashOperation.enter_reasons_for_the_operation</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end mt-2">
        <input type="hidden" name="OperationType" value="MemberNoneCash" id="OperationType" />
        <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />

        <button type="submit" class="btn btn-primary btn-sm px-3" onclick="PostOperation()">
            <i class="fas fa-money-bill-wave me-2"></i>@GlobalShared.create_request
        </button>
    </div>

    <hr class="mt-1" style="border: 2px solid green;" />
</fieldset>
<script>
    $(document).ready(function () {
        var $branch = $('#branchInput');
        var $account = $('#account_number');

        function resetGlDropdown(placeholderText) {
            $account.empty();
            $account.append($('<option/>', {
                value: '',
                text: placeholderText || '---GL Account---'
            }));
            $account.trigger('change.select2');
        }

        function setGlDisabled(isDisabled) {
            $account.prop('disabled', isDisabled);
            if ($.fn.select2) {
                $account.trigger('change.select2');
            }
        }

        // Initialize select2 if not already done elsewhere
        if ($.fn.select2) {
            $branch.select2();
            $account.select2();
        }

        // Initial state: if no branch selected, disable GL dropdown
        if (!$branch.val()) {
            resetGlDropdown('Select a branch first');
            setGlDisabled(true);
        }

        $branch.on('change', function () {
            var branchId = $(this).val();
            var branchName = $branch.find('option:selected').text().trim();

            if (!branchId) {
                // No branch selected
                resetGlDropdown('Select a branch first');
                setGlDisabled(true);
                return;
            }

            // While we fetch GLs, disable dropdown & show loading text
            setGlDisabled(true);
            resetGlDropdown('Loading ' + branchName + ' GL accounts...');

            $.ajax({
                url: '@Url.Action("LoadGLbyBranchId", "MemberNoneCashOperation")', // adjust controller if needed
                type: 'GET',
                dataType: 'json',
                data: { branchid: branchId },
                success: function (data) {
                    $account.empty();
                    $account.append($('<option/>', {
                        value: '',
                        text: '---GL Account---'
                    }));

                    $.each(data, function (i, item) {
                        $account.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });

                    // Re-enable GL dropdown after loading
                    setGlDisabled(false);
                },
                error: function () {
                    resetGlDropdown('Error loading ' + branchName + ' GL accounts');
                    setGlDisabled(false);
                }
            });
        });
    });
</script>

<script>
    $(document).ready(function () {
        // Function to update the label text dynamically
        function updateLabelText() {
            var bookingDirection = $("input[name='AddMembersNoneCashOperationCommand.BookingDirection']:checked").val();
            if (bookingDirection === "Debit") {
                $('#accountNumberLabel').text('CREDIT Selected GL');
            } else {
                $('#accountNumberLabel').text('DEBIT Selected GL');
            }
        }

        // Initial check on page load
        updateLabelText();

        // Event listener for changes in booking direction
        $("input[name='AddMembersNoneCashOperationCommand.BookingDirection']").on('change', function () {
            updateLabelText();
        });





    });

// ===== MoMo UI + data loader (robust to label text changes) ==================

(function ($) {
  // ---- elements ------------------------------------------------------------
  const $chk     = $('#isMobileMoneyOperationChk');      // SINGLE source of truth
  const $branch  = $('#branchInput');
  const $catBox  = $('#momoCategoryContainer');
  const $pathBox = $('#momoPathContainer');
  const $refBox  = $('#momoReferenceContainer');
  const $refSel  = $('#noneMemberMobileReference');

  const $glBox   = $('#glContainer');
  const $glSel   = $('#account_number');

  const $rbDebit  = $('#Debit');
  const $rbCredit = $('#Credit');

  const momoUrl = ($('#momoConfig').data('url')) || '@Url.Action("LoadMomoAccountsProfiles","MemberNoneCashOperation")';

  // ---- helpers -------------------------------------------------------------
  function clearRefOptions() {
    $refSel.empty().append($('<option/>', { value: '', text: '--- MoMo reference ---' }));
    if ($refSel.hasClass('select2')) $refSel.val('').trigger('change');
  }
  function resetPath() { $("input[name='momoPath']").prop('checked', false); }
  function resetGL() {
    if ($glSel.hasClass('select2')) $glSel.val(null).trigger('change');
    else $glSel.prop('selectedIndex', 0);
  }
  function setGLVisibility() {
    const momoOn = $chk.is(':checked');
    $glBox.toggleClass('d-none', momoOn);
    if (momoOn) resetGL();
  }
  function setMomoUI(on) {
    $catBox.toggleClass('d-none', !on);
    $pathBox.toggleClass('d-none', !on);
    $refBox.toggleClass('d-none', !on);
    $refSel.prop('disabled', !on);
    if (!on) {
      $("input[name='momoCategory']").prop('checked', false);
      resetPath();
      clearRefOptions();
    }
    setGLVisibility();
  }
  function getCanonicalCategory() {
    const $r = $("input[name='momoCategory']:checked");
    const cat = $r.data('category') || ($r.val() || '');
    if (!cat) return '';
    const s = String(cat).toLowerCase();
    if (s.includes('mtn'))    return 'MobileMoneyMTN';
    if (s.includes('orange')) return 'MobileMoneyOrange';
    return cat;
  }
  async function loadMomoRefs() {
    clearRefOptions();
    const branchId = ($branch.val() || '').trim();
    const category = getCanonicalCategory();
    if (!branchId || !category) return;
    try {
      const res = await $.getJSON(momoUrl, { branchid: branchId, category: category });
      (res || []).forEach(item => {
        const val = item.Value ?? item.value ?? '';
        const txt = item.Text  ?? item.text  ?? item.name ?? String(val);
        $refSel.append(new Option(txt, val));
      });
      if ($refSel.hasClass('select2')) $refSel.trigger('change');
    } catch (e) {
      console.error('Failed to load MoMo references:', e);
      if (window.appalert) appalert('Failed to load MoMo references. Please try again.', 0, 1);
    }
  }

  // ---- debit/credit locking -----------------------------------------------
  function setDirection(debitOn, creditOn, lock) {
    if (debitOn === true)  $rbDebit.prop('checked', true);
    if (creditOn === true) $rbCredit.prop('checked', true);
    $rbDebit.prop('disabled', false);
    $rbCredit.prop('disabled', false);
    if (lock === 'debit')  $rbDebit.prop('disabled', true);
    if (lock === 'credit') $rbCredit.prop('disabled', true);
  }
  function applyDirectionForMomoPath() {
    if (!$chk.is(':checked')) { setDirection(null, null, null); return; }
    const path = $("input[name='momoPath']:checked").val() || '';
    switch (path) {
      case 'FloatFromMembersAccountToMomoAccount':                 // Option 1
      case 'FromMembersAccountToMobilemoneyAndToMembersPhone':      // Option 2
        setDirection(true, false, 'credit');  // force Debit, lock Credit
        break;
      case 'FloatFromMobileMoneyToMembersAccount':                  // Option 3
        setDirection(false, true, 'debit');  // force Credit, lock Debit
        break;
      default:
        setDirection(null, null, null);
        break;
    }
  }

  // ---- events --------------------------------------------------------------
  $(function () {
    // initial state
    setMomoUI($chk.is(':checked'));
    applyDirectionForMomoPath();

    // MoMo checkbox
    $chk.on('change', function () {
      setMomoUI(this.checked);
      if (!this.checked) {
        // full reset when turning OFF
        $("input[name='momoCategory']").prop('checked', false);
        resetPath();
        clearRefOptions();
        setDirection(null, null, null); // unlock
      } else {
        if ($("input[name='momoCategory']:checked").length) loadMomoRefs();
        applyDirectionForMomoPath();
      }
    });

    // Category change
    $(document).on('change', "input[name='momoCategory']", function () {
      if (!$chk.is(':checked')) { $chk.prop('checked', true).trigger('change'); }
      loadMomoRefs();
    });

    // Path change
    $(document).on('change', "input[name='momoPath']", function () {
      if (!$chk.is(':checked')) $chk.prop('checked', true).trigger('change');
      applyDirectionForMomoPath();
    });

    // Branch change
    $branch.on('change', function () {
      if ($chk.is(':checked') && $("input[name='momoCategory']:checked").length) loadMomoRefs();
      else clearRefOptions();
    });
  });

  // optional getter
  window.getSelectedMomoPath = function () {
    return $("input[name='momoPath']:checked").val() || '';
  };
})(jQuery);


// ===== Minimal changes in your existing functions ===========================
// In collectDeposits():
