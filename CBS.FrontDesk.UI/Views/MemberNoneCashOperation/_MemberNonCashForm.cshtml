@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<style>
    .booking-direction-box {
        background-color: #e9e9ee;
        border: 1px solid #6c63ff; /* Optional blue border */
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    .booking-option {
        padding: 0.4rem 0.8rem;
        font-size: 0.95rem;
        font-weight: 500;
        background-color: white;
        border: 1px solid #ccc;
        border-radius: 0.35rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

        .booking-option input[type="radio"] {
            margin: 0;
        }
</style>
<fieldset class="fieldset-custom">
    <!--<div class="change-group">-->
    <!-- Member's Name Section -->
    <!--<div class="row mb-4">
            <div class="col-md-12">
                <div class="form-floating">
                    <span class="formatted-amount shadow-sm d-block py-3 px-4 bg-light rounded border border-secondary.@GlobalMemberNoneCashOperation.MembersName: <strong>@Model.Customer.name</strong></span>
                </div>
            </div>
        </div>
    </div>-->
    <div class="change-group">
        <div class="row mb-3 align-items-center">
            <!-- Member's Name, Branch Name, and Branch Code Section -->
            <div class="col-md-12">
                <div class="form-floating">
                    <span class="formatted-amount shadow-sm d-block py-3 px-4 bg-light rounded border border-secondary">
                        <strong>@GlobalLoanRepaymentBackOffice.MembersName:</strong> @Model.Customer.name &nbsp; | &nbsp;
                        <strong>@GlobalLoanRepaymentBackOffice.BranchName:</strong> @Model.Branch.Name &nbsp; | &nbsp;
                        <strong>@GlobalLoanRepaymentBackOffice.BranchCode:</strong> @Model.Branch.BranchCode
                    </span>
                </div>
            </div>
        </div>
    </div>


    <div class="change-group">
        <div class="row mb-3 align-items-center">
            <div class="col-md-12">
                <div class="booking-direction-box">
                    <label class="fw-semibold text-dark mb-2">@GlobalMemberNoneCashOperation.BookingDirection:</label>
                    <div class="d-flex flex-wrap gap-3">
                        <label class="booking-option">
                            @Html.RadioButtonFor(m => m.AddMembersNoneCashOperationCommand.BookingDirection, "Debit", new { @id = "Debit" })
                            @GlobalMemberNoneCashOperation.DebitMembersAccount
                        </label>

                        <label class="booking-option">
                            @Html.RadioButtonFor(m => m.AddMembersNoneCashOperationCommand.BookingDirection, "Credit", new { @id = "Credit" })
                            @GlobalMemberNoneCashOperation.CreditMembersAccount
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <input type="hidden" id="memberName" value="@Model.AddMembersNoneCashOperationCommand.MemberName" />
    </div>


    <div class="rounded p-2 border-primary border mb-3">
        <h6 class="mb-0 fw-bold text-dark">@GlobalMemberNoneCashOperation.MembersAccounts</h6>
        <!-- Table Section -->
        <div class="table-responsive mt-4 mb-2">
            <table class="table table-hover" id="myDataTableT">
                <thead class="table-light">
                    <tr>
                        <th style="display:none;">@GlobalMemberNoneCashOperation.ProductID</th>
                        <th>@GlobalMemberNoneCashOperation.Accounts</th>
                        <th>@GlobalMemberNoneCashOperation.Balance</th>
                        <th>@GlobalMemberNoneCashOperation.Amount</th>
                        <th style="display:none">@GlobalMemberNoneCashOperation.Fee</th>
                        <th>@GlobalMemberNoneCashOperation.Total</th>
                        <th>@GlobalMemberNoneCashOperation.confirm</th>
                        <th style="display:none">@GlobalMemberNoneCashOperation.Inc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                    {
                        <tr>
                            <td style="display:none;">@d.AccountNumber</td>
                            <td>@d.AccountType</td>
                            <td>@d.Balance.ToString("#,##0.0")</td>
                            <td>
                                <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.Amount">
                            </td>
                            <td style="display:none">
                                <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee" readonly>
                            </td>
                            <td>
                                <span class="total-span">@d.Total</span>
                            </td>
                            <td>
                                <input type="checkbox" class="form-check-input">
                            </td>
                            <td style="display:none">
                                <input type="checkbox" class="form-check-input check-inclussive" disabled>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align: right;"><strong>@GlobalMemberNoneCashOperation.Total:</strong></td>
                        <td id="tableTotal">0</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="rounded p-2 border-primary border mb-3">
        <h6 class="mb-0 fw-bold text-dark">@GlobalMemberNoneCashOperation.CorrespondingAccounts</h6>
        <!-- Correspondent Account Selection -->
        <div class="col-md-12 mb-2">
            <div class="form-floating border rounded p-3">
                @Html.DropDownListFor(m => m.AddMembersNoneCashOperationCommand.ChartOfAccountId, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---"+@GlobalMemberNoneCashOperation.SelectGL+"---", new { @class = "form-control select2", id = "account_number", @search = "true" })
                @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.ChartOfAccountId, "", new { @class = "text-danger" })
                <label id="accountNumberLabel" for="account_number" style="font-size: 1.1rem;">@GlobalMemberNoneCashOperation.SelectCorrespondentAccount</label>
            </div>
        </div>

        <!-- Reasons for Operation -->
        <div class="col-md-12 mb-2">
            <div class="form-floating border rounded p-3">
                @Html.TextAreaFor(m => m.AddMembersNoneCashOperationCommand.Note, new { @class = "form-control", id = "Note", style = "height: 90px;" })
                @Html.ValidationMessageFor(m => m.AddMembersNoneCashOperationCommand.Note, "", new { @class = "text-danger" })
                <label for="Note" style="font-size: 1.1rem;">@GlobalMemberNoneCashOperation.EnterReasonsForTheOperation</label>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end mt-4">
        <input type="hidden" name="OperationType" value="MemberNoneCash" id="OperationType" />
        <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />

        <button type="submit" class="btn btn-primary btn-lg me-3" onclick="PostOperation()">
            <i class="fas fa-money-bill-wave me-2"></i> @GlobalMemberNoneCashOperation.CreateRequest
        </button>
    </div>


    <hr style="border: 2px solid green;" />
</fieldset>

<script>
    $(document).ready(function () {
        // Function to update the label text dynamically
        function updateLabelText() {
            var bookingDirection = $("input[name='AddMembersNoneCashOperationCommand.BookingDirection']:checked").val();
            if (bookingDirection === "Debit") {
                $('#accountNumberLabel').text('CREDIT Selected GL');
            } else {
                $('#accountNumberLabel').text('DEBIT Selected GL');
            }
        }

        // Initial check on page load
        updateLabelText();

        // Event listener for changes in booking direction
        $("input[name='AddMembersNoneCashOperationCommand.BookingDirection']").on('change', function () {
            updateLabelText();
        });
    });

</script>




