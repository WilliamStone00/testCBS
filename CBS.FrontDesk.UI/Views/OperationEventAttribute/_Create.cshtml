@model CBS.FrontDesk.Data.Entity.Accounting.OperationEventAttribute
<div class="card-body">
    @using (Html.BeginForm("Create", "OperationEventAttribute", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-12">
                <div class="form-floating form-floating-outline">
               
                            @Html.DropDownListFor(m => m.OperationEventId, new SelectList(ViewBag.OperationEvents==null?"": ViewBag.OperationEvents,  "id","operationEventName"), "---Select OperationEvent---", new { @class = "form-control select2", @search = "true" })
                           
                    @Html.ValidationMessageFor(m => m.OperationEventId, "", new { @class = "text-danger " })
                         <label>Operation Event</label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
       
        </div>
   
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Save</button>
            <button type="reset" class="btn btn-outline-secondary">Reset</button>
        </div>
    }
</div>