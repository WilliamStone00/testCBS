@model CBS.FrontDesk.Data.Entity.SavingProducts.FeePolicy
    @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalFeePolicy.FeePolicySet</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "FeePolicy", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {

            @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">

            <div class="col-md-12" id="selectFeild">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.FeeId, new SelectList(ViewBag.Fees, "Id", "name"), "---"+ @GlobalFeePolicy.SelectFee+"---", new { @class = "form-control select2", @onchange = "GetFee(this.value);", @search = "true" })
                    @Html.ValidationMessageFor(m => m.FeeId, "", new { @class = "text-danger" })
                    <label>@GlobalFeePolicy.SelectFee</label>
                </div>
            </div>

            @if (ViewBag.Base == "Range")
            {
                if (ViewBag.MemberShip == "MemberShip")
                {
                    <div id="range" style="display:block">
                        <div class="row">
                            <div class="col-md-2 mb-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                                    <label>@GlobalFeePolicy.Charge</label>
                                </div>
                            </div>
                            <div class="col-md-10" id="eventDiv" style="display:block;">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.EventCode, new SelectList(ViewBag.EventCodes, "Value", "Text"), "---"+ @GlobalFeePolicy.SelectEvent +"---", new { @class = "form-control select2", @search = "true" })
                                    @Html.ValidationMessageFor(m => m.EventCode, "", new { @class = "text-danger" })
                                    <label>@GlobalFeePolicy.SelectEventCode</label>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                else
                {
                    <div id="range" style="display:block">
                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.AmountFrom, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.AmountFrom, "", new { @class = "text-danger" })
                                    <label>@GlobalFeePolicy.AmountFrom</label>
                                </div>
                            </div>
                            <div class="col-md-5 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.AmountTo, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.AmountTo, "", new { @class = "text-danger" })
                                    <label>@GlobalFeePolicy.AmountTo</label>
                                </div>
                            </div>
                            <div class="col-md-2 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                                    <label>@GlobalFeePolicy.Charge</label>
                                </div>
                            </div>
                        </div>
                    </div>

                }

            }
            else if (ViewBag.Base == "Rate")
            {
                <div id="percentage">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Value, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
                            <label id="lblevalue">@GlobalFeePolicy.EnterValue</label>
                        </div>
                    </div>
                </div>
            }

            else
            {
                <div id="range" style="display:block">
                    <div class="row">
                        <div id="amountfrom" style="display:block" class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountFrom, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountFrom, "", new { @class = "text-danger" })
                                <label>@GlobalFeePolicy.AmountFrom</label>
                            </div>
                        </div>
                        <div id="amountto" style="display:block" class="col-md-5 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AmountTo, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AmountTo, "", new { @class = "text-danger" })
                                <label>@GlobalFeePolicy.AmountTo</label>
                            </div>
                        </div>
                        <div id="memberShip" style="display:block" class="col-md-2 mb-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                                <label>@GlobalFeePolicy.Charge</label>
                            </div>
                        </div>
                        <div class="col-md-10" id="eventDiv" style="display:block;">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.EventCode, new SelectList(ViewBag.EventCodes, "Value", "Text"), "---"+ @GlobalFeePolicy.SelectEvent+"---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.EventCode, "", new { @class = "text-danger" })
                                <label>@GlobalFeePolicy.SelectEventCode</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="percentage" style="display:none">
                    <div class="col-md-12 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Value, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
                            <label id="lblevalue">@GlobalFeePolicy.EnterValue</label>
                        </div>
                    </div>
                </div>
            }
            <div class="col-12 mb-3" id="isCentralised">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsCentralised, new { @class = "form-check-input", @id = "isCentralisedCheck" })
                    <label class="form-check-label" for="isCentralisedCheck" id="isCentralisedLabel">@GlobalFeePolicy.CheckToDecentraliseThisPolicy</label>
                </div>
            </div>
            <div class="col-md-12 mb-3">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.BankId, new SelectList(ViewBag.Banks, "Id", "name"), "---"+ @GlobalFeePolicy.SelectBank+"---", new { @class = "form-control select2", @onchange = "GetBranchesByBank(this.value,'BranchId');", @search = "true" })
                    @Html.ValidationMessageFor(m => m.BankId, "", new { @class = "text-danger" })
                    <label>@GlobalFeePolicy.SelectMFI</label>
                </div>
            </div>
            <div class="row" id="mfi" style="display:none;">
                <div class="col-md-12 mb-3">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ @GlobalFeePolicy.SelectBranch+"---", new { @class = "form-control select2", id = "BranchId", @search = "true" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label>@GlobalFeePolicy.SelectBranch</label>
                    </div>
                </div>
            </div>

        </div>
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>

                }
            </div>

        }
    </div>
</fieldset>
<script>
    $(document).ready(function () {
        // Function to toggle MFI and Event sections and update the label
        function toggleSectionsPartial() {
            if ($('#isCentralisedCheck').is(':checked')) {
                $('#mfi').show();  // Show MFI if IsCentralised is checked
                $('#isCentralisedLabel').text("Uncheck to centralise this policy");  // Update label text
            } else {
                $('#mfi').hide();  // Hide MFI if IsCentralised is not checked
                $('#isCentralisedLabel').text("Check to de-centralise this policy");  // Revert label text
            }
        }
        // Ensure the fee select dropdown is disabled on load
        $('#feeSelect').prop('disabled', true);  // Disable the fee select dropdown
        // Initial load: hide/show based on checkbox state and disable select field
        toggleSectionsPartial();

        // Attach event listener to checkbox
        $('#isCentralisedCheck').change(function () {
            toggleSectionsPartial();
        });
    });
</script>