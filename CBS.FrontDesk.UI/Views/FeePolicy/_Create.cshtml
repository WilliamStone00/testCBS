@model CBS.FrontDesk.Data.Entity.SavingProducts.FeePolicy
<fieldset class="fieldset-custom">
    <legend id="select_base">Fee policy set</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "FeePolicy", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {

            @Html.HiddenFor(model => model.Id)
        <div class="row mt-2 gy-4">

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.FeeId, new SelectList(ViewBag.Fees, "Id", "name"), "---Select fee---", new { @class = "form-control select2", @onchange = "GetFee(this.value);", @search = "true" })
                    @Html.ValidationMessageFor(m => m.FeeId, "", new { @class = "text-danger" })
                    <label>Select fee</label>
                </div>
            </div>
            <div id="range" style="display:block">
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.AmountFrom, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.AmountFrom, "", new { @class = "text-danger" })
                            <label>Amount From</label>
                        </div>
                    </div>
                    <div class="col-md-5 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.AmountTo, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.AmountTo, "", new { @class = "text-danger" })
                            <label>Amount To</label>
                        </div>
                    </div>
                    <div class="col-md-2 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Charge, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Charge, "", new { @class = "text-danger" })
                            <label>Charge</label>
                        </div>
                    </div>
                </div>
            </div>
            <div id="percentage" style="display:none">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Value, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
                        <label id="lblevalue">Enter value (in %)</label>
                    </div>
                </div>
            </div>
        </div>
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>

                }
            </div>

        }
    </div>
</fieldset>