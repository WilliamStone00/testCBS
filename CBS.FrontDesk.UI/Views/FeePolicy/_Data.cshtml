@model List<CBS.FrontDesk.Data.Entity.SavingProducts.FeePolicy>

<fieldset class="fieldset-custom">
    <legend id="select_base">Fee policy data set</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>No fee type is set</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>from</th>
                        <th>to</th>
                        <th>charges</th>
                        <th>Value</th>
                        <th>type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:38%">@d.Fee.Name</td>
                            <td style="width:10%">@d.AmountFrom.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.AmountTo.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Charge.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Value.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Fee.FeeType</td>
                            <td style="width:13%">
                                <a href="#" onclick="AddORUpdateGenCustom(@d.Id,'datalistingview','_Create','update','FeePolicy',null,'@d.FeeId')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Fee.Name to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Fee.Name" onclick="DeleteRecordDataTable('FeePolicy','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
