@model List<CBS.FrontDesk.Data.Entity.SavingProducts.FeePolicy>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalFeePolicy.FeePolicyDataSet</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalFeePolicy.NoFeeTypeIsSet</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.From</th>
                        <th>@GlobalFeePolicy.To</th>
                        <th>@GlobalShared.Charges</th>
                        <th>@GlobalShared.Value</th>
                        <th>@GlobalShared.Type</th>
                        <th>@GlobalShared.Branch</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:23%">@d.Fee.Name</td>
                            <td style="width:10%">@d.AmountFrom.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.AmountTo.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Charge.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Value.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Fee.FeeType</td>
                            <td style="width:15%">@d.BranchName</td>
                            <td style="width:13%">
                                <a href="#" onclick="AddORUpdateGenCustom('@d.Id','datalistingview','_Create','update','FeePolicy',null,'@d.FeeId')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Fee.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Fee.Name" onclick="DeleteRecordDataTable('FeePolicy','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
