@{
    ViewBag.Title = "Daily Collection Salary Payment";
}
@using Resources
@model CBS.FrontDesk.Data.Entity.DailyCollectionConfiguration

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i>💰 DAILY COLLECTOR SALARY PAYMENT</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalDailyAgentManagement.This_interface_enable_back_office_operator_to_pay_each_daily_collector
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.TIPS_for_daily_collection_payment</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.DateRange:</strong> @GlobalShared.Select_Payment_period .</li>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong>  @GlobalDailyAgentManagement.Select_branch_if_you_are_connected_as_head_office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalShared.Daily_collector:</strong>@GlobalDailyAgentManagement.Select_the_daily_collector_head_office</li>
                <li><i class="mdi mdi-star-circle-outline text-primary me-2"></i> <strong>@GlobalShared.Opertion_Type:</strong> @GlobalDailyAgentManagement.Select_operation_for_payment</li>

            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="card shadow p-3 mb-1">
        <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.Advance_Filter</h5>
        <div class="card p-3 mb-3 bg-light">
            <div class="filters">

                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                {
                    <div class="filter-row">
                        <div class="filter-group">
                            <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                            @Html.TextBoxFor(m => m.CollectorSalarySummary.Month, new
                            {
                                @class = "form-control date",
                                type = "month",
                                id = "month",
                                name = "month"
                            })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.Month, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="branch">🏢 @GlobalShared.Select_Branch</label>
                            @Html.DropDownListFor(m => m.CollectorSalarySummary.BranchId, new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Value", "Text"), "--- Select Branch", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.BranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="filter-row">
                        <div class="filter-group">
                            <label for="collector">📚 @GlobalShared.Operation_type</label>
                            @Html.DropDownListFor(m => m.CollectorSalarySummary.OperationType, new SelectList(ViewBag.OperationTypes ?? new List<SelectListItem>(), "Value", "Text"), "--- Select Operation Types", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.OperationType, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="collector">👤 @GlobalDailyAgentManagement.Select_Daily_Collector</label>
                            @Html.DropDownListFor(m => m.CollectorSalarySummary.CollectorId, new SelectList(ViewBag.DailyCollectors ?? new List<SelectListItem>(), "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.CollectorId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
                else
                {
                    <div class="filter-row">
                        <div class="filter-group">
                            <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                            @Html.TextBoxFor(m => m.CollectorSalarySummary.Month, new
                            {
                                @class = "form-control date",
                                type = "month",
                                id = "month",
                                name = "month"
                            })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.Month, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="collector">📚 @GlobalShared.Operation_type</label>
                            @Html.DropDownListFor(m => m.CollectorSalarySummary.OperationType, new SelectList(ViewBag.OperationTypes ?? new List<SelectListItem>(), "Value", "Text"), "--- Select Operation Types", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.OperationType, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="collector">👤 @GlobalDailyAgentManagement.Select_Daily_Collector</label>
                            @Html.DropDownListFor(m => m.CollectorSalarySummary.CollectorId, new SelectList(ViewBag.DailyCollectors ?? new List<SelectListItem>(), "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorSalarySummary.CollectorId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

            </div> <!-- End filters -->
            <!-- Load Button clearly placed at the bottom of the card -->
            <div class="text-end mt-3">
                <button id="submitBtn" class="load-btn  btn btn-primary" onclick="loadData()">🔍 @GlobalShared.Load_Data</button>
            </div>
        </div>

    </div>
</div>
<div class="row">
    <div class="card shadow p-3 mb-4">
        <div class="content">
            <div id="results" class="hidden">
                <div class="card shadow p-3 mb-4">
                    <h2>👤 Collector Information</h2>
                    <div class="info-grid">
                        <div class="info-item">
                            <strong>@GlobalShared.Collector_Name</strong>
                            <span id="collectorName"></span>
                        </div>
                        <div class="info-item">
                            <strong>@GlobalShared.Collector_ID</strong>
                            <span id="collectorId"></span>
                        </div>
                        <div class="info-item">
                            <strong>@GlobalShared.Branch</strong>
                            <span id="branchInfo"></span>
                        </div>
                        <div class="info-item">
                            <strong>@GlobalShared.Period</strong>
                            <span id="periodInfo"></span>
                        </div>
                        <div class="info-item">
                            <strong>@GlobalShared.Operation_type</strong>
                            <span id="operationType"></span>
                        </div>
                    </div>
                </div>

                <div class="summary-stats">
                    <div class="stat-card">
                        <h3>👥 @GlobalShared.Active_Members</h3>
                        <div class="value" id="totalMembers"></div>
                    </div>
                    <div class="stat-card">
                        <h3>💵 @GlobalShared.Total_Collected</h3>
                        <div class="value" id="totalCollected"></div>
                    </div>
                    <div class="stat-card">
                        <h3>💰 @GlobalShared.Total_Fees</h3>
                        <div class="value" id="totalFees"></div>
                    </div>
                    <div class="stat-card">
                        <h3>📊 @GlobalShared.To_Distribute</h3>
                        <div class="value" id="totalDistribute"></div>
                    </div>
                </div>

                <div class="members-section">
                    <h2 class="section-title">👥 @GlobalDailyAgentManagement.Member_Activity_Statistics</h2>
                    <button id="toggleBtn" class="btn-primary">@GlobalDailyAgentManagement.Hide_Member_Activities</button>
                    <table class="members-table">
                        <thead>
                            <tr>
                                <th>@GlobalShared.Member_ID</th>
                                <th>@GlobalShared.Member_name</th>
                                <th>@GlobalShared.Total_Activity</th>
                                <th>@GlobalShared.Fee_Charged</th>
                                <th>@GlobalShared.Last_Transaction</th>
                            </tr>
                        </thead>
                        <tbody id="membersTableBody">
                        </tbody>
                    </table>
                </div>

                <div class="stakeholder-section">
                    <h2 class="section-title">💼 @GlobalDailyAgentManagement.Revenue_Distribution_by_Stakeholder</h2>
                    <div class="stakeholder-grid">
                        @foreach (var item in Model.CollectorData.SharedAmounts)
                        {
                            <div class="stakeholder-card">
                                @if (item.Stakeholder.ToLower().Contains("cam"))
                                {
                                    <h4>🏦 @item.Stakeholder</h4>
                                    <div class="amount">@item.Amount FCFA</div>
                                    <div class="percentage">(@item.Percentage%)</div>
                                }
                                else if (item.Stakeholder.ToLower().Contains("daily"))
                                {
                                    <h4>👤@item.Stakeholder</h4>
                                    <div class="amount">@item.Amount FCFA</div>
                                    <div class="percentage">(@item.Percentage%)</div>
                                }
                                else if (item.Stakeholder.ToLower().Contains("branch"))
                                {
                                    <h4>🏢 @GlobalShared.Branch_Commission</h4>
                                    <div class="amount">@item.Amount FCFA</div>
                                    <div class="percentage">(@item.Percentage%)</div>
                                }
                                else if (item.Stakeholder.ToLower().Contains("incentive"))
                                {
                                    <h4>🎯 @item.Stakeholder</h4>
                                    <div class="amount">@item.Amount FCFA</div>
                                    <div class="percentage">(@item.Percentage%)</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="payment-section card bg-light">
                    <h3>💳 @GlobalShared.Ready_to_Process_Payment</h3>
                    <button class="payment-btn" onclick="processPayment()">
                        💰 Pay Agent Now
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

    @section Styles {
        <link href="~/CBSTemp/ui/assets/css/CommissionPayment.css" rel="stylesheet" />
    }

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        <script src="~/Scripts/Js/CommissionManagement/CommissionPayment.js"></script>
    }
