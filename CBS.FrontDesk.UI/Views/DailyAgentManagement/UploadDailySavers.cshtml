@model CBS.FrontDesk.Data.Entity.DailyCollectionEntities.UploadDailyCollectorData
    @using Resources
@{
    ViewBag.Title = "Upload  DailyCollectors";
    Layout = "~/Views/Shared/_MainLayout.cshtml";

}
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="bi bi-upload"></i> 📤 Upload Daily Savers
                </h1>
                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalDailyAgentManagement.This_interface_enables_back_office_operators_to_register_all_the_daily_savers_field_operation_activities
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.TIPS_for_daily_savers_upload</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong> @GlobalDailyAgentManagement.Select_branch_if_you_are_connected_as_head_office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalDailyAgentManagement.Select_Daily_Collector:</strong> @GlobalDailyAgentManagement.Select_Daily_Collector</li>
                <li><i class="mdi mdi-cash-check me-2"></i> <strong>@GlobalShared.File_Upload:</strong> @GlobalDailyAgentManagement.Upload_the_field_collection_file (XLSX)</li>
            </ul>
        </div>
    </div>
</div>

<!-- Upload Form -->
<div class="card border border-primary">
    <div class="card-body">

        <div class="modal-body bg-light card-border-shadow-dark">
            <!-- Critical: Form must have proper enctype for IFormFile -->
            <form id="excelUploadForm" enctype="multipart/form-data" method="post" action="/DailyAgentManagement/UploadDailyCollectorModel/">
                @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

                <!-- Anti-forgery token for ASP.NET Core -->
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            <label for="AgentBranchId">🏢 @GlobalShared.Select_Branch</label>
                            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "--- Select Branch", new { @class = "form-control select2", @search = "true", @id = "AgentBranchId" })
                            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating shadow-sm">
                            <label for="DailyCollectorxCollectorId">👤 @GlobalShared.Select_Daily_Collector</label>
                            @Html.DropDownListFor(m => m.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Text", "Value"), "--- Select Daily Collectors", new { @class = "form-control select2", @id = "DailyCollectorxCollectorId", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CollectorId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">

                        <label for="DailyCollectorAccountId"> @GlobalShared.Select_GL_Account</label>
                        @Html.DropDownListFor(m => m.AccountId, new SelectList(ViewBag.Accounts == null ? "" : ViewBag.Accounts, "Text", "Value"), "--- Select GL account", new { @class = "form-control select2", @id = "DailyCollectorAccountId", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AccountId, "", new { @class = "text-danger" })

                        @*   <button type="button" class="btn btn-secondary ms-2" id="downloadExcelButton">Download sample file structure to be uploaded</button>*@
                    </div>
                    <!-- CRITICAL: File input name MUST match C# property name exactly -->
                    <div class="col-md-6">
                        <label for="ExcelFile" class="form-label text-dark fw-bold">
                            <i class="mdi mdi-file-excel me-1 text-success"></i> @GlobalDailyAgentManagement.Upload_Collectors_Member_Excel_File
                        </label>
                        <!-- Name attribute MUST be "ExcelFile" to match your C# model -->
                        <input type="file" class="form-control" id="ExcelFile" name="ExcelFile" accept=".xlsx,.xls" required />
                        <small class="text-muted">@GlobalShared.Max_file_size: 10MB. Formats: .xlsx, .xls</small>
                    </div>
                    <!-- Submit Button
    <div class="col-6 text-end">
        <button type="button" onclick="ReadData(); return false;" class="btn btn-primary">
            <i class="mdi mdi-cloud-upload me-1"></i> Retrieve Data
        </button>

    </div>-->
                    <div class="col-12 text-end">
                        <button type="button" onclick="ReadForExcelFile(); return false;" class="btn btn-primary">
                            <i class="mdi mdi-cloud-upload me-1"></i> @GlobalShared.Upload & @GlobalShared.Process
                        </button>

                    </div>
                </div>
            </form>

            <!-- Progress bar container -->
            <div id="progressBarContainer" style="display: none; margin-top: 20px;">
                <div class="progress">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        0%
                    </div>

                </div>

            </div>
            <div class="container mt-4">
                <div id="resultContainer" style="display: none; background-color: white; max-width: 800px; margin: 20px auto;" >
                    <h3 class="text-bg-primary p-3 text-center mb-0">@GlobalShared.Upload_Results</h3>

                    <table class="table table-bordered table-striped mb-0">
                        <thead >
                            <tr>
                                <th scope="col" style="width: 40%; background-color: var(--bs-primary); color: white; font-weight: 600;">Field</th>
                                <th scope="col" style="width: 60%; background-color: var(--bs-primary); color: white; font-weight: 600;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="vertical-align: middle;"><strong>@GlobalDailyAgentManagement.Daily_Collector_GL</strong></td>
                                <td style="vertical-align: middle;"><span id="dailyCollectorGL" class="text-primary fw-semibold"></span></td>
                            </tr>
                            <tr>
                                <td style="vertical-align: middle;"><strong>@GlobalShared.Total_members</strong></td>
                                <td style="vertical-align: middle;"><span id="totalMembers" class="text-primary fw-semibold"></span></td>
                            </tr>
                            <tr>
                                <td style="vertical-align: middle;"><strong>@GlobalDailyAgentManagement.Sum_of_Member_Balances</strong></td>
                                <td style="vertical-align: middle;"><span id="totalVolume" class="text-primary fw-semibold"></span></td>
                            </tr>
                            <tr>
                                <td style="vertical-align: middle;"><strong>@GlobalDailyAgentManagement.GL_Account_Balance</strong></td>
                                <td style="vertical-align: middle;"><span id="actualVolume" class="text-primary fw-semibold"></span></td>
                            </tr>
                            <tr>
                                <td style="vertical-align: middle;"><strong>@GlobalShared.Cash_Difference</strong></td>
                                <td style="vertical-align: middle;"><span id="cashDifference" class="text-danger fw-semibold"></span></td>
                            </tr>
                            <tr style="background-color: #f8f9fa;">
                                <td><strong>@GlobalShared.Action </strong></td>
                                <td>
                                    <a class="btn btn-primary btn-sm" id="postEntries" style=" min-width: 150px;">
                                        <i class="bi bi-download me-1"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            @*<div id="resultContainer" style="display: none; background-color:white">
                    <h3 class="text-bg-primary">UploadResults:</h3>
                    <p>Daily Collector GL: <span id="dailyCollectorGL"></span></p>
                    <p>Total Members: <span id="totalMembers"></span></p>
                    <p>Sum of Member Balances: <span id="totalVolume"></span></p>
                    <p>Actual Balance: <span id="actualVolume"></span></p>
                    <p>Cash Difference: <span id="cashDifference"></span></p>
                    <a class="btn btn-primary" id="downloadLink" href="#" target="_blank"></a>
                </div>*@
        </div>
    </div>
</div>


@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/DailySaverUploud.js"></script>

}



