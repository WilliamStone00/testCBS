@{
    ViewBag.Title = "Ordinary Account Initialization Overview";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="bi bi-upload"></i> 📤 @GlobalDailyAgentManagement.Upload_Daily_Collector_Operations</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalDailyAgentManagement.This_interface_enable_back_office_operator_to_register_all_the_daily_collector_field_operation_activity
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.TIPS_for_daily_collection_END_OF_DAY_OPERATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>

                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong>  @GlobalDailyAgentManagement.Select_branch_if_you_are_connected_as_head_office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalDailyAgentManagement.Select_Daily_Collector:</strong>@GlobalDailyAgentManagement.Select_Daily_Collector.</li>
                <li><i class="mdi mdi-cash-check me-2"></i> <strong> @GlobalShared.File_Upload:</strong>@GlobalShared.File_uploaded </li>

            </ul>
        </div>
    </div>
</div>

<!-- Upload Form -->
<div class="card border border-primary">
    <div class="card-body">


        <div class="modal-body bg-light card-border-shadow-dark">
            @Html.Partial("_UploadDailyCollectorOperations")
        </div>
        <div id="progressBarContainer" style="display: none;" class="mt-3">
            <div class="progress">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%">
                    0%
                </div>
            </div>
        </div>
        <div id="datalistingview_UploadDailyCollectorOperations">

            @Html.Partial("_UploadedDailyOperationData")
        </div>

    </div>
</div>
@section Styles {
    <link href="~/CBSTemp/ui/assets/css/DailySavingOperations.css" rel="stylesheet" />
 
}

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/main.js/DailySaverOperations.js"></script>
}

