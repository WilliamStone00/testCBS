
@model CBS.FrontDesk.Data.Entity.DailyCollectionEntities.UploadDailyCollectorData
    @using Resources

@{
    // Make the partial view flexible to work with different models
    //var modelType = ViewData.TemplateInfo ?? "Upload";
    var formTitle = ViewBag.FormTitle ?? "📊 Daily Collection Data Upload";
    var actionName = ViewBag.ActionName ?? "Upload";
    var controllerName = ViewBag.ControllerName ?? "DailyCollection";
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">@formTitle</h4>
    </div>
    <div class="card-body">
        <!-- Validation Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <!-- Success Message -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@ViewBag.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form id="uploadForm" method="post" action="@Url.Action(actionName, controllerName)" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- Branch Selection -->
                <div class="col-md-6">
                    <label for="BranchId" class="form-label fw-bold">
                        <i class="fas fa-building text-primary me-2"></i>@GlobalShared.Select_Branch
                    </label>
                    <select name="BranchId" id="branchSelect" class="form-control select2" required>
                        <option value="">--- @GlobalShared.Select_Branch ---</option>
                        @if (ViewBag.Branches != null)
                        {
                            foreach (var branch in (IEnumerable<SelectListItem>)ViewBag.Branches)
                            {
                                <option value="@branch.Value" @(branch.Selected ? "selected" : "")>@branch.Text</option>
                            }
                        }
                    </select>
                    <div class="invalid-feedback">@GlobalShared.Please_select_a_branch</div>
                </div>

                <!-- Daily Collector Selection -->
                <div class="col-md-6">
                    <label for="CollectorId" class="form-label fw-bold">
                        <i class="fas fa-user text-info me-2"></i>@GlobalDailyAgentManagement.Select_Daily_Collector
                    </label>
                    <select name="CollectorId" id="collectorSelect" class="form-control select2" required>
                        <option value="">--- @GlobalDailyAgentManagement.Select_Daily_Collector ---</option>
                        @if (ViewBag.DailyCollectors != null)
                        {
                            foreach (var collector in (IEnumerable<SelectListItem>)ViewBag.DailyCollectors)
                            {
                                <option value="@collector.Value" @(collector.Selected ? "selected" : "")>@collector.Text</option>
                            }
                        }
                    </select>
                    <div class="invalid-feedback">@GlobalDailyAgentManagement.Please_select_a_collector</div>
                </div>

                <!-- Download Sample Button -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="fas fa-download text-warning me-2"></i>@GlobalShared.Sample_File
                    </label>
                    <div>
                        <button type="button" class="btn btn-outline-warning" id="downloadSampleBtn">
                            <i class="fas fa-download me-2"></i>@GlobalShared.Download_Excel_Template
                        </button>
                        <small class="text-muted d-block mt-1">@GlobalShared.Download_the_required_file_format</small>
                    </div>
                </div>

                <!-- Excel File Upload -->
                <div class="col-md-6">
                    <label for="ExcelFile" class="form-label fw-bold">
                        <i class="fas fa-file-excel text-success me-2"></i>@GlobalShared.Upload_XLSX_File
                    </label>
                    <input type="file" name="ExcelFile" id="ExcelFile" class="form-control" accept=".xlsx,.xls" required />
                    <div class="invalid-feedback">@GlobalShared.Please_select_a_valid_Excel_file</div>
                    <small class="text-muted">@GlobalShared.Maximum_file_size: 10MB</small>
                </div>

                <!-- Additional Fields (if needed) -->
                @if (ViewBag.ShowAdditionalFields == true)
                {
                    <div class="col-md-6">
                        <label for="CollectionDate" class="form-label fw-bold">
                            <i class="fas fa-calendar text-primary me-2"></i>@GlobalDailyAgentManagement.Collection_Date
                        </label>
                        <input type="date" name="CollectionDate" id="CollectionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-6">
                        <label for="Notes" class="form-label fw-bold">
                            <i class="fas fa-sticky-note text-secondary me-2"></i>@GlobalShared.Notes (@GlobalShared.Optional)
                        </label>
                        <textarea name="Notes" id="Notes" class="form-control" rows="2" placeholder="@GlobalDailyAgentManagement.Enter_any_additional_notes..."></textarea>
                    </div>
                }

                <!-- Progress Bar -->
                <div class="col-12">
                    <div class="progress" id="uploadProgress" style="display: none;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" onclick="resetForm()">
                            <i class="fas fa-undo me-2"></i>@GlobalShared.Reset
                        </button>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-cloud-upload me-2"></i>@GlobalShared.Upload & @GlobalShared.Process
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
$(document).ready(function() {
    // Initialize Select2
    if ($.fn.select2) {
        $('.select2').select2({
            width: '100%',
            placeholder: function() {
                return $(this).find('option:first').text();
            }
        });
    }

    // Load collectors when branch changes
    $('#branchSelect').change(function() {
        var branchId = $(this).val();
        loadCollectors(branchId);
    });

    // Download sample file
    $('#downloadSampleBtn').click(function() {
        var downloadUrl = '@Url.Action("DownloadSampleTemplate", ViewBag.ControllerName ?? "DailyCollection")';
        window.location.href = downloadUrl;
    });

    // Form submission with validation
    $('#uploadForm').submit(function(e) {
        if (!validateForm()) {
            e.preventDefault();
            return false;
        }

        showProgress();
    });

    // File input change handler
    $('#ExcelFile').change(function() {
        var file = this.files[0];
        if (file) {
            validateFileType(file);
        }
    });
});

// Load collectors via AJAX
function loadCollectors(branchId) {
    var $collectorSelect = $('#collectorSelect');
    var controllerName = '@(ViewBag.ControllerName ?? "DailyCollection")';

    if (!branchId) {
        $collectorSelect.empty().append('<option value="">--- Select Daily Collector ---</option>');
        return;
    }

    $collectorSelect.empty().append('<option value="">Loading...</option>');

    $.ajax({
        url: '/' + controllerName + '/GetCollectorsByBranch',
        type: 'GET',
        data: { branchId: branchId },
        success: function(data) {
            $collectorSelect.empty().append('<option value="">--- Select Daily Collector ---</option>');
            if (data && data.length > 0) {
                $.each(data, function(index, collector) {
                    var value = collector.Value || collector.value || collector.Id || collector.id;
                    var text = collector.Text || collector.text || collector.Name || collector.name;
                    $collectorSelect.append('<option value="' + value + '">' + text + '</option>');
                });
            }
        },
        error: function() {
            $collectorSelect.empty().append('<option value="">Error loading collectors</option>');
            showAlert('Error loading collectors. Please refresh and try again.', 'danger');
        }
    });
}

// Form validation
function validateForm() {
    var isValid = true;

    // Clear previous validation states
    $('.is-invalid').removeClass('is-invalid');
    $('.was-validated').removeClass('was-validated');

    // Validate branch selection
    var branchSelect = $('#branchSelect');
    if (!branchSelect.val()) {
        branchSelect.addClass('is-invalid');
        isValid = false;
    }

    // Validate collector selection
    var collectorSelect = $('#collectorSelect');
    if (!collectorSelect.val()) {
        collectorSelect.addClass('is-invalid');
        isValid = false;
    }

    // Validate file selection
    var fileInput = $('#ExcelFile')[0];
    if (!fileInput.files.length) {
        $('#ExcelFile').addClass('is-invalid');
        isValid = false;
    }

    if (!isValid) {
        showAlert('Please fill in all required fields.', 'warning');
        $('#uploadForm').addClass('was-validated');
    }

    return isValid;
}

// Validate file type and size
function validateFileType(file) {
    var allowedTypes = [
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.ms-excel'
    ];
    var maxSize = 10 * 1024 * 1024; // 10MB

    if (!allowedTypes.includes(file.type)) {
        showAlert('Please select a valid Excel file (.xlsx or .xls)', 'danger');
        $('#ExcelFile').val('').addClass('is-invalid');
        return false;
    }

    if (file.size > maxSize) {
        showAlert('File size must be less than 10MB', 'danger');
        $('#ExcelFile').val('').addClass('is-invalid');
        return false;
    }

    $('#ExcelFile').removeClass('is-invalid');
    showAlert('File selected: ' + file.name + ' (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB)', 'info');
    return true;
}

// Show progress during upload
function showProgress() {
    var $progress = $('#uploadProgress');
    var $progressBar = $progress.find('.progress-bar');
    var $submitBtn = $('#submitBtn');

    $progress.show();
    $submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Processing...');

    // Simulate progress
    var progress = 0;
    var interval = setInterval(function() {
        progress += Math.random() * 15;
        if (progress > 90) progress = 90;

        $progressBar.css('width', progress + '%').text(Math.round(progress) + '%');
    }, 300);

    // Clear interval after 10 seconds
    setTimeout(function() {
        clearInterval(interval);
        $progressBar.css('width', '100%').text('100%');
    }, 10000);
}

// Reset form
function resetForm() {
    $('#uploadForm')[0].reset();
    if ($.fn.select2) {
        $('.select2').val(null).trigger('change');
    }
    $('.is-invalid').removeClass('is-invalid');
    $('.was-validated').removeClass('was-validated');
    $('#uploadProgress').hide();
    $('#submitBtn').prop('disabled', false).html('<i class="fas fa-cloud-upload me-2"></i>Upload & Process');
    $('.alert').fadeOut();
}

// Show alert messages
function showAlert(message, type) {
    // Remove existing alerts
    $('.alert:not(.alert-danger):not(.alert-success)').remove();

    var iconClass = {
        'success': 'fa-check-circle',
        'danger': 'fa-exclamation-circle',
        'warning': 'fa-exclamation-triangle',
        'info': 'fa-info-circle'
    };

    var alertHtml = '<div class="alert alert-' + type + ' alert-dismissible fade show">' +
        '<i class="fas ' + iconClass[type] + ' me-2"></i>' +
        message +
        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
        '</div>';

    $('.card-body').prepend(alertHtml);

    // Auto dismiss info and warning alerts after 5 seconds
    if (type === 'info' || type === 'warning') {
        setTimeout(function() {
            $('.alert-' + type).fadeOut();
        }, 5000);
    }
}
</script>

