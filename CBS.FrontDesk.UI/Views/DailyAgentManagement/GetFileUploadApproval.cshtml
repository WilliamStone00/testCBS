@model IEnumerable<CBS.FrontDesk.Data.Entity.DailyCollectionEntities.ManualEntryDailyCollectorUploadSummaryDto>
@using Resources
@{
    ViewBag.Title = "Manual Entry Daily Collector Upload Summary";
}
 

<div class="table-wrapper">
    <table class="table-bordered">
        <thead>
            <tr>
                <th>
                    <div class="sortable" data-column="fileUploadId">
                        <span>@GlobalShared.File Upload ID</span>
                        <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m7 15 5 5 5-5"></path>
                            <path d="m7 9 5-5 5 5"></path>
                        </svg>
                    </div>
                </th>
                <th>
                    <div class="sortable" data-column="branchName">
                        <span>@GlobalShared.Branch</span>
                        <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m7 15 5 5 5-5"></path>
                            <path d="m7 9 5-5 5 5"></path>
                        </svg>
                    </div>
                </th>
                <th>
                    <div class="sortable" data-column="uploadedBy">
                        <span>@GlobalShared.Uploaded_By</span>
                        <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m7 15 5 5 5-5"></path>
                            <path d="m7 9 5-5 5 5"></path>
                        </svg>
                    </div>
                </th>
                <th>
                    <div class="sortable" data-column="totalMembers">
                        <span>@GlobalShared.Total Members</span>
                        <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m7 15 5 5 5-5"></path>
                            <path d="m7 9 5-5 5 5"></path>
                        </svg>
                    </div>
                </th>
                <th>
                    <div class="sortable" data-column="totalAmount">
                        <span>@GlobalShared.Total Amount</span>
                        <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m7 15 5 5 5-5"></path>
                            <path d="m7 9 5-5 5 5"></path>
                        </svg>
                    </div>
                </th>
                <th>@GlobalShared.Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FileUploadId)</td>
                    <td>@Html.DisplayFor(modelItem => item.BranchName)</td>
                    <td>@Html.DisplayFor(modelItem => item.UploadedBy)</td>
                    <td>@Html.DisplayFor(modelItem => item.TotalMembers)</td>
                    <td>@Html.DisplayFor(modelItem => item.TotalAmount, "{0:C}")</td>
                    <td>
                        <button class="btn btn-primary" onclick="viewUploadSummary('@item.FileUploadId')">👁️ @GlobalShared.View</button>
                        <button class="btn btn-info" onclick="viewUploadDetails('@item.FileUploadId')">📋 @GlobalShared.Details</button>
                        @if (item.manualEntryDailyCollectorUploadListDtos != null && item.manualEntryDailyCollectorUploadListDtos.Any())
                        {
                            <button class="btn btn-success" onclick="toggleDetails('@item.FileUploadId')">📊 @GlobalShared.Expand</button>
                        }
                    </td>
                </tr>
                if (item.manualEntryDailyCollectorUploadListDtos != null && item.manualEntryDailyCollectorUploadListDtos.Any())
                {
                    <tr id="details-@item.FileUploadId" class="details-row" style="display: none;">
                        <td colspan="6">
                            <div class="nested-table-container">
                                <h5>Upload Details for @item.FileUploadId</h5>
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>@GlobalShared.Reference</th>
                                            <th>@GlobalShared.Member Name</th>
                                            <th>@GlobalShared.Amount</th>
                                            <th>@GlobalShared.Daily_collector</th>
                                            <th>@GlobalShared.Branch Code</th>
                                            <th>@GlobalShared.Branch Name</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detail in item.manualEntryDailyCollectorUploadListDtos)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => detail.MemberReference)</td>
                                                <td>@Html.DisplayFor(modelItem => detail.MemberName)</td>
                                                <td>@Html.DisplayFor(modelItem => detail.Amount, "{0:C}")</td>
                                                <td>@Html.DisplayFor(modelItem => detail.DailyCollectorName)</td>
                                                <td>@Html.DisplayFor(modelItem => detail.MemberBranchCode)</td>
                                                <td>@Html.DisplayFor(modelItem => detail.MemberBranchName)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    function viewUploadSummary(fileUploadId) {
        // Implement view summary functionality
        console.log('View summary for:', fileUploadId);
        // Example: window.location.href = '@Url.Action("ViewSummary", "Controller")/' + fileUploadId;
    }

    function viewUploadDetails(fileUploadId) {
        // Implement view details functionality
        console.log('View details for:', fileUploadId);
        // Example: window.location.href = '@Url.Action("ViewDetails", "Controller")/' + fileUploadId;
    }

    function toggleDetails(fileUploadId) {
        const detailsRow = document.getElementById('details-' + fileUploadId);
        if (detailsRow.style.display === 'none') {
            detailsRow.style.display = 'table-row';
        } else {
            detailsRow.style.display = 'none';
        }
    }
</script>

<style>
    .details-row {
        background-color: #f8f9fa;
    }

    .nested-table-container {
        padding: 15px;
        border-left: 3px solid #007bff;
        margin: 10px 0;
    }

        .nested-table-container h5 {
            color: #007bff;
            margin-bottom: 15px;
        }

    .btn {
        margin-right: 5px;
        padding: 5px 10px;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 12px;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-info {
        background-color: #17a2b8;
        color: white;
    }

    .btn-success {
        background-color: #28a745;
        color: white;
    }

    .btn:hover {
        opacity: 0.8;
    }
</style>