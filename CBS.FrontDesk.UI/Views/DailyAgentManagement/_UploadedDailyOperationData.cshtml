<div class="container">
    <div class="header">
        <h1>Manual Entry Daily Collector Upload Summary</h1>
        <p>Daily Collection Report</p>
    </div>

    <div class="summary-section">
        <h2>Summary Information</h2>
        <div class="summary-grid">
            <div>
                <div class="summary-item">
                    <span class="summary-label">Total Amount:</span>
                    <span class="summary-value total-amount" id="totalAmount"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Total Members:</span>
                    <span class="summary-value" id="totalMembers" ></span>
                </div>
            </div>
            <div>
                <div class="summary-item">
                    <span class="summary-label">Branch Name:</span>
                    <span class="summary-value" id="branchName"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Uploaded By:</span>
                    <span class="summary-value" id="uploadedBy"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="details-section">
        <h3>Member Collection Details</h3>
        <table id="myDataTable">
            <thead>
                <tr>
                    <th>Member Ref</th>
                    <th>Member Name</th>
                    <th>Amount</th>
                    <th>Collector Name</th>
                    <th>Branch Code</th>
                    <th>Branch Name</th>
                </tr>
            </thead>
            <tbody> </tbody>
        </table>
    </div>

    <div class="footer">
        <p>Generated on: <span id="currentDate"></span></p>
        <p>Manual Entry Daily Collector Upload System</p>
    </div>
</div>
