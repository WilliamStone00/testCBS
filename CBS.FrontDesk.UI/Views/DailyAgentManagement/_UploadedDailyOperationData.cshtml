@using Resources
<div class="container" id="HideDataResult">
    <div class="header">
        <h4>@GlobalDailyAgentManagement.Daily_Collection_Report</h4>
    </div>

    <div class="summary-section">
        <h2>@GlobalShared.Summary_Information</h2>
        <div class="summary-grid">
            <div>
                <div class="summary-item">
                    <span class="summary-label">@GlobalShared.Total_amount:</span>
                    <span class="summary-value total-amount" id="totalAmount"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">@GlobalShared.Total_members:</span>
                    <span class="summary-value" id="totalMembers"></span>
                </div>
            </div>
            <div>
                <div class="summary-item">
                    <span class="summary-label">@GlobalShared.Branch_Name:</span>
                    <span class="summary-value" id="branchName"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">@GlobalShared.Uploaded_By:</span>
                    <span class="summary-value" id="uploadedBy"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="details-section">
        <h3>@GlobalDailyAgentManagement.Member_Collection_Details</h3>
        <table id="myDataTable">
            <thead>
                <tr>
                    <th>@GlobalShared.Member_ref</th>
                    <th>@GlobalShared.Member_name</th>
                    <th>@GlobalShared.Amount</th>
                    <th>@GlobalShared.Collector_Name</th>
                    <th>@GlobalShared.Branch_Code</th>
                    <th>@GlobalShared.Branch_Name</th>
                </tr>
            </thead>
            <tbody> </tbody>
        </table>
    </div>
    <div class="col-12 text-end">
        <br />
        <button type="submit" class="btn btn-primary" onclick="">
            <i class="mdi mdi-cloud-upload me-1"></i> @GlobalShared.Review_Data
        </button>
    </div>
    <div class="footer">
        <p>@GlobalShared.Generated_on: <span id="currentDate"></span></p>
        <p>@GlobalDailyAgentManagement.Manual_Entry_Daily_Collector_Upload_System</p>
    </div>


</div>
