

@model CBS.FrontDesk.Data.Entity.DailyCollectionEntities.UploadDailyCollectorData


 
      
            @Html.ValidationSummary(true, "Please correct the errors and try again.", new { @class = "alert alert-danger" })

            <div class="row bg-light">
                <div class="col-md-6">
        
                        <label for="branch">🏢 Select Branch</label>
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Text", "Value"), "--- Select Branch", new { @class = "form-control select2", @search = "true", @id = "AgentBranchId" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
              
                </div>
                <div class="col-md-6">
                  
                        <label for="collector">👤 Select Daily Collector</label>
                        @Html.DropDownListFor(m => m.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Text", "Value"), "--- Select Daily Collectors", new { @class = "form-control select2", @id = "CollectorxCollectorId", @search = "true" })
                        @Html.ValidationMessageFor(m => m.CollectorId, "", new { @class = "text-danger" })
                  
                </div>
                <div class="col-md-6">
                    <br />

                    <button class="btn btn-warning" id="downloadExcelOPButton">Download sample file structure to be uploaded</button>
                </div>

                <!-- Excel File Upload -->
                <div class="col-md-6">

                    <label for="ExcelFile" class="form-label text-dark fw-bold">
                        <i class="mdi mdi-file-excel me-1 text-success"></i> Upload Collectors Member Excel File
                    </label>
                    <input type="file" class="form-control" id="ExcelFile" name="ExcelFile" accept=".xlsx" required />

                </div>
                <!-- Submit Button -->
                <div class="col-12 text-end">
                    <br />
                    <button type="submit" class="btn btn-primary" onclick="ReadExcelFile()">
                        <i class="mdi mdi-cloud-upload me-1"></i> Upload & Process
                    </button>
                </div>

            </div>
        
 

