@{
    ViewBag.Title = "Uploaded DailyCollection Files";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="bi bi-upload"></i> 📤 @GlobalDailyAgentManagement.Uploaded_Daily_Collector_Operations_files</span>
                </h1>

                <p class="card-text text-dark fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>@GlobalDailyAgentManagement.This_interface_enables_daily_collectors_to_upload_daily_operations_to_the_back_office_operator_to_register_all_daily_collector_field_operations
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.TIPS_for_daily_collection_file_uploads</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalShared.Select_uploaded_files:</strong>@GlobalDailyAgentManagement.Select_Daily_Collector.</li>
                <li><i class="mdi mdi-cash-check me-2"></i> <strong> @GlobalShared.File_Upload:</strong>@GlobalShared.File_uploaded </li>

            </ul>
        </div>
    </div>
</div>

<!-- Upload Form -->
<div class="row">


    <div class="controls">
        <div class="search-container">

            <input type="text" id="searchInput" class="search-input" placeholder="@GlobalShared.Search_files_branches_or_users...">
            <span class="filter-container justify-content-end">
                
                <select id="categoryFilter" class="filter-select">
                    <svg class="filter-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="22,3 2,3 10,12.46 10,19 14,21 14,12.46"></polygon>
                    </svg>
                    <option value="">@GlobalShared.All_Categories</option>
                </select>
            </span>


        </div>
        
    </div>

       


    <div id="resultsInfo" class="results-info"></div>


    <div class="table-wrapper card mb-2">
        <table class="table-bordered">
            <thead>
                <tr>
                    <th>
                        <div class="sortable" data-column="fileName">
                            <span>@GlobalShared.File Name</span>
                            <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m7 15 5 5 5-5"></path>
                                <path d="m7 9 5-5 5 5"></path>
                            </svg>
                        </div>
                    </th>
                    <th>
                        <div class="sortable" data-column="branchName">
                            <span>@GlobalShared.Branch</span>
                            <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m7 15 5 5 5-5"></path>
                                <path d="m7 9 5-5 5 5"></path>
                            </svg>
                        </div>
                    </th>
                    <th>
                        <div class="sortable" data-column="uploadedBy">
                            <span>@GlobalShared.Uploaded_By</span>
                            <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m7 15 5 5 5-5"></path>
                                <path d="m7 9 5-5 5 5"></path>
                            </svg>
                        </div>
                    </th>
                    <th>
                        <div class="sortable" data-column="uploadedOn">
                            <span>@GlobalShared.Upload Date</span>
                            <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m7 15 5 5 5-5"></path>
                                <path d="m7 9 5-5 5 5"></path>
                            </svg>
                        </div>
                    </th>
                    <th>
                        <div class="sortable" data-column="fileCategory">
                            <span>@GlobalShared.Category</span>
                            <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m7 15 5 5 5-5"></path>
                                <path d="m7 9 5-5 5 5"></path>
                            </svg>
                        </div>
                    </th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody">
            </tbody>
        </table>
    </div>
    <div id="emptyState" class="empty-state" style="display: none;">
        <h3>@GlobalShared.No_files_found</h3>
        <p>@GlobalShared.Try_adjusting_your_search_or_filter_criteria</p>
    </div>


</div>

@section Styles {

    <link href="~/CBSTemp/ui/assets/css/`.css" rel="stylesheet" />
}

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/CommissionManagement/DSFileUploaded.js"></script>

}

