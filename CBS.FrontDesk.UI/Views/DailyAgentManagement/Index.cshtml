                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-container">
                <div class="table-title"> Daily Summary</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th> Date</th>
                            <th> Cash In</th>
                            <th> Cash out</th>
                            <th>Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>16 Jul</td>
                            <td class="amount">0</td>
                            <td class="amount negative">0</td>
