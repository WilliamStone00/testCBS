
@{
    ViewBag.Title = "DAILY COLLECTION DASHBOARD";
    Layout = "~/Views/Shared/ MainLayout.cshtml";
}
@model CBS.FrontDesk.Data.Entity.DailyAgentManagement
    @using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> DAILY COLLECTION DASHBOARD</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>This interface enable back office operator to pay each daily collector
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS for daily collection payment</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong> DateRange:</strong>  Select Payment period .</li>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong> FilterByBranch:</strong>  Select branch if you are connected as head office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong> Daily collector:</strong> Select the daily collector head office</li>


            </ul>
        </div>
    </div>
</div>
<div class="row card">
    <div class="col-12">
        @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
        {
            <div class="row">
                <div class="col-md-4">
                    <label for="month">📅  Select Month &  Year</label>
                    @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                    {
                        @class = "form-control date",
                        type = "month",
                        id = "month",
                        name = "month"
                    })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label for="branch">🏢  Select Branch</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Value", "Text"), "--- Select Branch", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.BranchId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label for="collector">👤 Select Daily Collector</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @id = "DailyCollectorCollectorId", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.CollectorId, "", new { @class = "text-danger" })
                </div>
              
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <label for="month">📅  Select Month &  Year</label>
                    @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                    {
                        @class = "form-control date",
                        type = "month",
                        id = "month",
                        name = "month"
                    })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="collector">👤 Select Daily Collector</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.CollectorId, "", new { @class = "text-danger" })

                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col-12 d-flex justify-content-end">
                <button class="btn btn-primary px-4" onclick="loadDashBoardData()">🔍  Load Data</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="card col-12">
        <!-- Key Metrics -->
        <div class="metrics-grid">
            <div class="metric-card">
                <h3> Total Collections</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3> Total Fees</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3> Cash In Transactions</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">Transactions</div>
            </div>
            <div class="metric-card">
                <h3> Members Served</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle"> Active Members</div>
            </div>
            <div class="metric-card">
                <h3> Net balance</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3> Average per Saver</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <div class="chart-container">
                <div class="chart-title"> Daily Collection Trend</div>
                <canvas id="dailyTrendChart"></canvas>
            </div>
            <div class="chart-container">
