
@{
    ViewBag.Title = "DAILY COLLECTION DASHBOARD";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@model CBS.FrontDesk.Data.Entity.DailyAgentManagement
    @using Resources

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.DAILY_COLLECTION_DASHBOARD</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalDailyAgentManagement.This_interface_enable_back_office_operator_to_pay_each_daily_collector
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyAgentManagement.TIPS_for_daily_collection_payment</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.DateRange:</strong> @GlobalShared.Select_Payment_period .</li>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong>  @GlobalDailyAgentManagement.Select_branch_if_you_are_connected_as_head_office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalShared.Daily_collector:</strong>@GlobalDailyAgentManagement.Select_the_daily_collector_head_office</li>


            </ul>
        </div>
    </div>
</div>
<div class="row card">
    <div class="col-12">
        @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
        {
            <div class="row">
                <div class="col-md-4">
                    <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                    @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                    {
                        @class = "form-control date",
                        type = "month",
                        id = "month",
                        name = "month"
                    })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label for="branch">🏢 @GlobalShared.Select_Branch</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Value", "Text"), "--- Select Branch", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.BranchId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label for="collector">👤 @GlobalDailyAgentManagement.Select_Daily_Collector</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @id = "DailyCollectorCollectorId", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.CollectorId, "", new { @class = "text-danger" })
                </div>
              
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                    @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                    {
                        @class = "form-control date",
                        type = "month",
                        id = "month",
                        name = "month"
                    })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label for="collector">👤 Select Daily Collector</label>
                    @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DashboardActivities.CollectorId, "", new { @class = "text-danger" })

                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col-12 d-flex justify-content-end">
                <button class="btn btn-primary px-4" onclick="loadDashBoardData()">🔍 @GlobalShared.Load_Data</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="card col-12">
        <!-- Key Metrics -->
        <div class="metrics-grid">
            <div class="metric-card">
                <h3>@GlobalShared.Total_Collections</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3>@GlobalShared.Total_Fees</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3>@GlobalShared.Cash_In_Transactions</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">Transactions</div>
            </div>
            <div class="metric-card">
                <h3>@GlobalShared.Members_Served</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">@GlobalShared.Active_Members</div>
            </div>
            <div class="metric-card">
                <h3>@GlobalShared.Net_balance</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
            <div class="metric-card">
                <h3>@GlobalShared.Average_per_Saver</h3>
                <div class="metric-value">0</div>
                <div class="metric-subtitle">XAF</div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <div class="chart-container">
                <div class="chart-title">@GlobalDailyAgentManagement.Daily_Collection_Trend</div>
                <canvas id="dailyTrendChart"></canvas>
            </div>
            <div class="chart-container">
                <div class="chart-title">@GlobalShared.Branch_Performance</div>
                <canvas id="branchChart"></canvas>
            </div>
        </div>

        <!-- Tables Section -->
        <div class="tables-section">
            <div class="table-container">
                <div class="table-title">@GlobalShared.Top_Savers</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@GlobalShared.Name</th>
                            <th>@GlobalShared.Code</th>
                            <th>@GlobalShared.Amount (XAF)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>...</td>
                            <td>0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>...</td>
                            <td>0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>...</td>
                            <td>0</td>
                            <td class="amount">0</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-container">
                <div class="table-title">@GlobalShared.Daily_Summary</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@GlobalShared.Date</th>
                            <th>@GlobalShared.Cash_In</th>
                            <th>@GlobalShared.Cash_out</th>
                            <th>Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>16 Jul</td>
                            <td class="amount">0</td>
                            <td class="amount negative">0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>15 Jul</td>
                            <td class="amount">0</td>
                            <td class="amount negative">0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>14 Jul</td>
                            <td class="amount">0</td>
                            <td class="amount negative">0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>13 Jul</td>
                            <td class="amount">0</td>
                            <td class="amount negative">0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>08 Jul</td>
                            <td class="amount">800,000</td>
                            <td class="amount negative">315,500</td>
                            <td class="amount">484,500</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Branch Performance -->
        <div class="daily-summary">
            <div class="table-title">@GlobalDailyAgentManagement.Branch_Performance_Overview</div>
            <div class="branch-performance">
                <div class="branch-card">
                    <div class="branch-name">BAPCCUL Yaounde Biyem-Assi (003)</div>
                    <div class="branch-metrics">
                        <div class="branch-metric">
                            <span>@GlobalShared.Total_Collections:</span>
                            <span class="amount">1,875,260 XAF</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Transactions:</span>
                            <span>24</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Members_Served:</span>
                            <span>4</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Fees_Collected:</span>
                            <span class="amount">52,000 XAF</span>
                        </div>
                    </div>
                </div>

                <div class="branch-card">
                    <div class="branch-name">Yaounde Emana (017)</div>
                    <div class="branch-metrics">
                        <div class="branch-metric">
                            <span>@GlobalShared.Total_Collections:</span>
                            <span class="amount">160,120 XAF</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Transactions:</span>
                            <span>2</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Members_Served:</span>
                            <span>1</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Fees_Collected:</span>
                            <span class="amount">4,000 XAF</span>
                        </div>
                    </div>
                </div>

                <div class="branch-card">
                    <div class="branch-name">BAPCCUL Upstation Bamenda (015)</div>
                    <div class="branch-metrics">
                        <div class="branch-metric">
                            <span>@GlobalShared.Total Collections:</span>
                            <span class="amount">149,500 XAF</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Transactions:</span>
                            <span>13</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Members_Served:</span>
                            <span>4</span>
                        </div>
                        <div class="branch-metric">
                            <span>@GlobalShared.Fees_Collected:</span>
                            <span class="amount">6,500 XAF</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="table-container full-width">
            <div class="table-title">@GlobalShared.Recent_Transactions</div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@GlobalShared.Date</th>
                        <th>@GlobalShared.Member</th>
                        <th>@GlobalShared.Type</th>
                        <th>@GlobalShared.Amount</th>
                        <th>@GlobalShared.Fee</th>
                        <th>@GlobalShared.Branch</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>16 Jul 07:55</td>
                        <td>Tim Beckly</td>
                        <td><span class="status-badge status-cashin">@GlobalShared.Cash_In</span></td>
                        <td class="amount">100,000</td>
                        <td>2,000</td>
                        <td>Biyem-Assi</td>
                    </tr>
                    <tr>
                        <td>15 Jul 07:58</td>
                        <td>lemnga crispus</td>
                        <td><span class="status-badge status-cashin">@GlobalShared.Cash_In</span></td>
                        <td class="amount">10,000</td>
                        <td>1,000</td>
                        <td>Bamenda</td>
                    </tr>
                    <tr>
                        <td>15 Jul 07:43</td>
                        <td>lemnga crispus</td>
                        <td><span class="status-badge status-cashin">@GlobalShared.Cash_In</span></td>
                        <td class="amount">5,000</td>
                        <td>1,000</td>
                        <td>Bamenda</td>
                    </tr>
                    <tr>
                        <td>14 Jul 21:53</td>
                        <td>lemnga crispus</td>
                        <td><span class="status-badge status-cashout">@GlobalShared.Cash_out</span></td>
                        <td class="amount negative">5,000</td>
                        <td>0</td>
                        <td>Bamenda</td>
                    </tr>
                    <tr>
                        <td>14 Jul 21:02</td>
                        <td>Ngongwoh Enow</td>
                        <td><span class="status-badge status-cashin">@GlobalShared.Cash_In</span></td>
                        <td class="amount">150,000</td>
                        <td>2,000</td>
                        <td>Emana</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Styles {
    <link href="~/CBSTemp/ui/assets/css/DailyCollectionDashBoard.css" rel="stylesheet" />

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Dashboard/DailyCollection/DailyCollectionDashboard.js"></script>

}