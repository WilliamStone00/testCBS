                        <tr>
                            <th> Name</th>
                            <th> Code</th>
                            <th> Amount (XAF)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>...</td>
                            <td>0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>...</td>
                            <td>0</td>
                            <td class="amount">0</td>
                        </tr>
                        <tr>
                            <td>...</td>
                            <td>0</td>
