@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    var AmountPayable = Model.Remittance.Amount + Model.Remittance.Fee;
    var AmountReceivable = Model.Remittance.Amount;
}
@if (ViewBag.Operation == "cashin")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: green">@GlobalRemittanceCashDesk.remittance_cash_in</legend>
            <hr style="border: 2px solid green;" />

            <!-- Member's Name and Amount Section -->
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <input type="hidden" id="remittanceID" value="@Model.Remittance.Id" />
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">@GlobalShared.Service: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount"><b>@GlobalShared.payable_amount: @AmountPayable.ToString("#,##0.0")</b></span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="@AmountReceivable">
                        </div>
                    </div>

                    <hr style="border: 2px solid green;" />
                    <!-- Remittance Details Section -->
                    <div class="mb-0">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>@GlobalShared.Date:</strong> @Model.Remittance.InitiationDate</p>
                                <p><strong>@GlobalShared.sender:</strong> @Model.Remittance.SenderName, [Tel: @Model.Remittance.SenderPhoneNumber]</p>
                                <p><strong>@GlobalShared.receiver:</strong> @Model.Remittance.ReceiverName, [Tel: @Model.Remittance.ReceiverPhoneNumber]</p>
                                <p><strong>@GlobalShared.Source_branch:</strong> @Model.Remittance.SourceBranchName</p>
                                <p><strong>@GlobalShared.Reference:</strong> @Model.Remittance.TransactionReference</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>@GlobalShared.Initiated_Amount:</strong> @Model.Remittance.InitailAmount.ToString("#,##0.0")</p>
                                <p><strong>@GlobalShared.Fee:</strong> @Model.Remittance.Fee.ToString("#,##0.0"), [Sender CNI: @Model.Remittance.SenderCNI]</p>
                                <p>
                                    <strong>@GlobalRemittanceCashDesk.total_amount_payable:</strong>
                                    @AmountPayable.ToString("#,##0.0")
                                </p>
                                <p>
                                    <strong>@GlobalRemittanceCashDesk.total_amount_receivable:</strong>
                                    @AmountReceivable.ToString("#,##0.0")
                                </p>
                                <p>
                                    <strong>@GlobalShared.Status:</strong>
                                    @if (Model.Remittance.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">@GlobalShared.Rejected</span>
                                    }
                                    else if (Model.Remittance.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                                    }
                                    else if (Model.Remittance.Status == "Paid")
                                    {
                                        <span class="badge bg-warning text-dark">@GlobalRemittanceCashDesk.cash_collected_by @Model.Remittance.SourceTellerName</span>
                                    }
                                    else if (Model.Remittance.Status == "Withdrawn")
                                    {
                                        <span class="badge bg-warning text-dark">@GlobalRemittanceCashDesk.cash_withdrawned_by @Model.Remittance.ReceiverName</span>
                                    }
                                    else if (Model.Remittance.TransferType == "Incoming_International")
                                    {
                                        <span class="badge bg-danger">@GlobalRemittanceCashDesk.cant_cashin_for @Model.Remittance.TransferType</span>
                                    }
                                    else if (Model.Remittance.ChargeType == "Inclussive")
                                    {
                                        <span class="badge bg-success">@GlobalShared.charge_included</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@GlobalShared.charge_excluded</span>
                                    }
                                </p>

                            </div>
                        </div>
                    </div>

                    <!-- Accounts Table -->
                    <div class="table-responsive" style="width: 100%;">
                        <table class="table table-hover" id="myDataTableT">
                            <thead class="table-light">
                                <tr>
                                    <th style="display:none;">@GlobalShared.Product_ID</th>
                                    <th>@GlobalRemittanceCashDesk.remittance_account_type</th>
                                    <th>@GlobalShared.Balance</th>
                                    <th>@GlobalShared.Amount</th>
                                    <th>@GlobalShared.Fee</th>
                                    <th>@GlobalShared.Total</th>
                                    <th>Conf</th>
                                    <th>@GlobalShared.Inc</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                                {
                                    <tr>
                                        <td style="display:none;">@d.AccountNumber</td>
                                        <td>@d.AccountType</td>
                                        <td>@d.Balance.ToString("#,##0.0")</td>
                                        <td>
                                            <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.Amount">
                                        </td>
                                        <td>
                                            @if (@d.AccountType.ToLower().Contains("subscription"))
                                            {
                                                <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee" disabled>
                                            }
                                            else
                                            {
                                                <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee">
                                            }
                                        </td>
                                        <td>
                                            <span class="total-span">@d.Total</span>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input">
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input check-inclussive" disabled>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" style="text-align: right;"><strong>@GlobalShared.Total:</strong></td>
                                    <td id="tableTotal">0</td>
                                </tr>
                                <tr>
                                    <td colspan="4" style="text-align: right;"><strong>@GlobalShared.Balance:</strong></td>
                                    <td id="tableBalance">0</td>
                                </tr>
                            </tfoot>
                        </table>

                        @*<p class="mt-3 text-center shadow-box">
                                Important Notification
                            </p>
                            <p class="mt-2 text-center shadow-box">
                                This remittance of @AmountReceivable.ToString("#,##0.0") is eligible for withdrawal from <u>any branch within the network</u>. <br />Please provide your transaction reference and valid identification at the branch for processing.
                            </p>*@


                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="header-buttons mt-4 float-end">
                    <input type="hidden" name="OperationType" value="RemittanceIN" id="OperationType" />
                    <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                    @*@if (Model.Remittance.Status == "Approved" && Model.Remittance.TransferType != "Incoming_International")
                        {
                            <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostCashIn()">
                                <i class="fas fa-money-bill-wave me-1"></i> Cash-In
                            </button>
                            <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                                <i class="fas fa-print me-1"></i> Re-print
                            </button>
                            <button type="reset" class="btn btn-outline-secondary">
                                <i class="fas fa-sync-alt me-1"></i> Reset
                            </button>
                        }*@

                    <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostCashIn()">
                        <i class="fas fa-money-bill-wave me-1"></i> @GlobalShared.Cash_In
                    </button>
                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                        <i class="fas fa-print me-1"></i> @GlobalShared.Re_print
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                    </button>

                </div>
            </div>
            <hr style="border: 2px solid green;" />

            <p class="mt-3 text-center shadow-box">
                @GlobalShared.important_notification
            </p>
            <p class="mt-2 text-center shadow-box">
                @GlobalRemittanceCashDesk.this_remittance_of @AmountReceivable.ToString("#,##0.0") @GlobalRemittanceCashDesk.is_eligible_for_withdrawal_from <u>@GlobalRemittanceCashDesk.any_branch_within_the_network</u>. <br />@GlobalRemittanceCashDesk.please_provide_your_transaction_reference.
            </p>
        </fieldset>


    </div>

}


else if (ViewBag.Operation == "cashout")
{



    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: red">@GlobalRemittanceCashDesk.remittance_cash_out</legend>
            <hr style="border: 2px solid red;" />
            <input type="hidden" id="remittanceID" value="@Model.Remittance.Id" />

            <div class="accordion" id="remittanceAccordion">
                <!-- OTP Verification Section -->
                <div class="accordion-item mt-4">
                    <h2 class="accordion-header" id="otpHeader">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#otpVerification" aria-expanded="true" aria-controls="otpVerification">
                            @GlobalRemittanceCashDesk.otp_verification
                        </button>
                    </h2>
                    <div id="otpVerification" class="accordion-collapse collapse show" aria-labelledby="otpHeader" data-bs-parent="#remittanceAccordion">
                        <div class="accordion-body">
                            <div class="otp-container text-center mt-4">
                                <p>@GlobalRemittanceCashDesk.an_otp_has_been_sent_to_your_registered_phone_number.</p>
                                @if (Model.SavingProduct.OTPControl)
                                {
                                    <button type="button" class="btn btn-primary" onclick="generateOtp()">
                                        <i class="fas fa-sync-alt me-1"></i> @GlobalShared.generate_otp
                                    </button>
                                }
                                else
                                {
                                    <p class="mt-2 text-danger">@GlobalRemittanceCashDesk.otp_is_not_enabled_for_this_type_of_remittance @Model.SavingProduct.AccountType. @GlobalRemittanceCashDesk.please_proceed_without_otpor_contact_support.</p>
                                }
                                <p class="mt-2 text-muted">@GlobalRemittanceCashDesk.if_you_encounter_issues_please_contact_support.</p>
                            </div>
                            <input type="hidden" id="transactionReferenceID" value="@Model.Remittance.TransactionReference" />
                            <input type="hidden" id="receiverPhoneNumberID" value="@Model.Remittance.ReceiverPhoneNumber" />
                        </div>
                    </div>
                </div>


                <div class="accordion-item mt-4">
                    <h2 class="accordion-header" id="receiverInfoHeader">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#receiverInfo" aria-expanded="true" aria-controls="receiverInfo">
                            @GlobalRemittanceCashDesk.receiver_information_verification
                        </button>
                    </h2>
                    <div id="receiverInfo" class="accordion-collapse collapse show" aria-labelledby="receiverInfoHeader" data-bs-parent="#remittanceAccordion">
                        <div class="accordion-body">
                            <div class="row mt-2 gy-4">
                                <div class="col-md-6">
                                    <label for="ReceiverCNI">@GlobalShared.receiver_cni:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="ReceiverCNI" value="@Model.Remittance.ReceiverCNI">
                                </div>
                                <div class="col-md-6">
                                    <label for="ReceiverName">@GlobalShared.Receiver_Name:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="ReceiverName" readonly="readonly" value="@Model.Remittance.ReceiverName">
                                </div>
                                <div class="col-md-6">
                                    <label for="ReceiverCNIDateOfIssue">@GlobalShared.cni_date_of_issue:</label>
                                    <input type="date" class="form-control shadow-input-boxes" id="ReceiverCNIDateOfIssue" value="@Model.Remittance.CapturedReceiverCNIDateOfIssue">
                                </div>
                                <div class="col-md-6">
                                    <label for="ReceiverCNIDateOfExpiration">@GlobalShared.cni_date_of_expiration:</label>
                                    <input type="date" class="form-control shadow-input-boxes" id="ReceiverCNIDateOfExpiration" value="@Model.Remittance.CapturedReceiverCNIDateOfExpiration">
                                </div>
                                <div class="col-md-4">
                                    <label for="ReceiverCNIPlcaceOfIssue">@GlobalShared.cni_place_of_issue:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="ReceiverCNIPlcaceOfIssue" value="@Model.Remittance.CapturedReceiverCNIPlcaceOfIssue">
                                </div>
                                <div class="col-md-2">
                                    <label for="ReceiverCNIPlcaceOfIssue">@GlobalShared.secret_code:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="SenderSecreteCode" readonly="readonly" value="@Model.Remittance.SenderSecreteCode">
                                </div>
                                <div class="col-md-4">
                                    <label for="ReceiverPhoneNumber">@GlobalShared.receiver_phone_number:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="ReceiverPhoneNumber" readonly="readonly" value="@Model.Remittance.ReceiverPhoneNumber">
                                </div>
                                <div class="col-md-2">
                                    <label for="ReceiverPhoneNumber">OTP:</label>
                                    <input type="text" class="form-control shadow-input-boxes" id="Otp" value="0000">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



                <div class="accordion-item mt-4">
                    <h2 class="accordion-header" id="cashoutHeader">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cashoutInfo" aria-expanded="false" aria-controls="cashoutInfo">
                            @GlobalRemittanceCashDesk.cashout_dashboard
                        </button>
                    </h2>
                    <div id="cashoutInfo" class="accordion-collapse collapse" aria-labelledby="cashoutInfoHeader" data-bs-parent="#remittanceAccordion">
                        <div class="accordion-body">
                            <hr style="border: 2px solid red;" />

                            <!-- Original Remittance Details Section -->
                            <div class="change-group">
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-8">
                                        <div class="form-floating form-floating-outline">
                                            <span class="formatted-amount shadow-box float-start">@GlobalShared.Service: @Model.Customer.name</span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount"><b>Total Payable: @Model.Remittance.Amount.ToString("#,##0.0")</b></span>
                                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="@Model.Remittance.Amount">
                                        </div>
                                    </div>
                                    <hr style="border: 2px solid red;" />
                                    <!-- Remittance Details Section -->
                                    <div class="mb-0">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>@GlobalShared.Date:</strong> @Model.Remittance.InitiationDate</p>
                                                <p><strong>@GlobalShared.sender:</strong> @Model.Remittance.SenderName, [Tel: @Model.Remittance.SenderPhoneNumber]</p>
                                                <p><strong>@GlobalShared.receiver:</strong> @Model.Remittance.ReceiverName, [Tel: @Model.Remittance.ReceiverPhoneNumber]</p>
                                                <p><strong>@GlobalShared.Branch:</strong> @Model.Remittance.SourceBranchName</p>
                                                <p><strong>@GlobalShared.Reference:</strong> @Model.Remittance.TransactionReference</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>@GlobalShared.Initiated_Amount:</strong> @Model.Remittance.InitailAmount.ToString("#,##0.0")</p>
                                                <p><strong>@GlobalShared.Fee:</strong> @Model.Remittance.Fee.ToString("#,##0.0"), [Sender CNI: @Model.Remittance.SenderCNI]</p>
                                                <p>
                                                    <strong>@GlobalRemittanceCashDesk.total_amount_payable:</strong>
                                                    @Model.Remittance.Amount.ToString("#,##0.0")
                                                </p>
                                                <p>
                                                    <strong>@GlobalRemittanceCashDesk.total_amount_receivable:</strong>
                                                    @AmountReceivable.ToString("#,##0.0")
                                                </p>
                                                <p>
                                                <p>
                                                    <strong>@GlobalShared.Status:</strong>
                                                    @if (Model.Remittance.Status == "Rejected")
                                                    {
                                                        <span class="badge bg-danger">@GlobalShared.Rejected</span>
                                                    }
                                                    else if (Model.Remittance.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                                                    }
                                                    else if (Model.Remittance.Status == "Paid")
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalRemittanceCashDesk.cash_collected_by @Model.Remittance.SourceTellerName</span>
                                                    }
                                                    else if (Model.Remittance.Status == "Withdrawn")
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalRemittanceCashDesk.cash_withdrawned_by @Model.Remittance.ReceiverName</span>
                                                    }
                                                    else if (Model.Remittance.ChargeType == "Inclussive")
                                                    {
                                                        <span class="badge bg-success">@GlobalShared.charge_included</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@GlobalShared.charge_excluded</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-responsive" style="width: 100%;">
                                        <table class="table table-hover" id="myDataTableT">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="display:none;">@GlobalShared.Product_ID</th>
                                                    <th>@GlobalRemittanceCashDesk.remittance_account_type</th>
                                                    <th>@GlobalShared.Balance</th>
                                                    <th>@GlobalShared.Amount</th>
                                                    <th>@GlobalShared.Fee/Charges</th>
                                                    <th>@GlobalShared.Total</th>
                                                    <th>Conf</th>
                                                    <th>@GlobalShared.Inc</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                                                {
                                                    <tr>
                                                        <td style="display:none;">@d.AccountNumber</td>
                                                        <td>@d.AccountType</td>
                                                        <td>@d.Balance.ToString("#,##0.0")</td>
                                                        <td>
                                                            <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.Amount">
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee">
                                                        </td>
                                                        <td>
                                                            <span class="total-span">@d.Total</span>
                                                        </td>
                                                        <td>
                                                            <input type="checkbox" class="form-check-input">
                                                        </td>
                                                        <td>
                                                            <input type="checkbox" class="form-check-input check-inclussive" disabled>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="4" style="text-align: right;"><strong>@GlobalShared.Total:</strong></td>
                                                    <td id="tableTotal">0</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="4" style="text-align: right;"><strong>@GlobalShared.Balance:</strong></td>
                                                    <td id="tableBalance">0</td>
                                                </tr>
                                            </tfoot>
                                        </table>

                                    </div>
                                   
                                </div>
                                <div class="header-buttons mt-4 float-end">
                                    <input type="hidden" name="OperationType" value="RemittanceOUT" id="OperationType" />
                                    <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                                    <button type="submit" id="submit" class="btn btn-danger me-2" onclick="PostCashOut()">
                                        <i class="fas fa-money-bill-wave me-1"></i> @GlobalShared.cashout
                                    </button>
                                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                                        <i class="fas fa-print me-1"></i> @GlobalShared.Re_print
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary">
                                        <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                                    </button>
                                </div>
                            </div>
                            <hr style="border: 2px solid red;" />

                        </div>
                    </div>
                </div>

            </div>



            <p class="mt-3 text-center shadow-box">
                @GlobalShared.important_notification
            </p>
            <p class="mt-2 text-center shadow-box">
                @GlobalRemittanceCashDesk.this_remittance_of @AmountReceivable.ToString("#,##0.0") @GlobalRemittanceCashDesk.is_eligible_for_withdrawal_from <u>@GlobalRemittanceCashDesk.any_branch_within_the_network</u>. <br />@GlobalRemittanceCashDesk.please_provide_your_transaction_reference.
            </p>
        </fieldset>
    </div>
}



