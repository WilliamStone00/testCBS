@model CBS.FrontDesk.Data.Entity.LoanConf.FundingLine
    @using Resources
<div class="card-body">

    @using (Html.BeginForm("Update", "FundingLine", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.id)
    <div class="row mt-2 gy-4">
        <div class="col-md-8">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.name, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.name, "", new { @class = "text-danger" })
                <label>@GlobalFundingLine.CreditLineName</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.amount, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.amount, "", new { @class = "text-danger" })
                <label>@GlobalShared.Amount</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.beginDate, new { @class = "form-control flatpickr-validation", @placeholder = GlobalShared.Date_of_birth })
                @Html.ValidationMessageFor(m => m.beginDate, "", new { @class = "text-danger" })
                <label>@GlobalShared.Begin_Date</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.endDate, new { @class = "form-control flatpickr-validation", @placeholder = GlobalShared.Date_of_birth })
                @Html.ValidationMessageFor(m => m.endDate, "", new { @class = "text-danger" })
                <label>@GlobalShared.End_Date</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                <label>@GlobalShared.Description</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.AccountingRuleId, new SelectList(ViewBag.Roles, "id", "ruleName"), "---"+ @GlobalFundingLine.SelectAccountingRoles+"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.AccountingRuleId, "", new { @class = "text-danger " })
                <label>@GlobalFundingLine.AccountingRole</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.currencyId, new SelectList(ViewBag.Currencies, "Id", "Code"), "---"+ @GlobalFundingLine.SelectCurrency+"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.currencyId, "", new { @class = "text-danger " })
                <label>@GlobalShared.Currency</label>
            </div>
        </div>
    </div>
    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>

    </div>
}
</div>