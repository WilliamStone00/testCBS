@model List<CBS.FrontDesk.Data.Entity.Accounting_V2.CollectorDevice.CollectorDeviceresponse>

<style>
    /* Force widths to be respected and keep cells neat */
    #myDataTable {
        table-layout: fixed;
        width: 100%;
    }
    #myDataTable th, #myDataTable td {
        vertical-align: middle;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Column-specific max widths (for truncation only) */
    .col-created { width: 15%; min-width: 140px; }
    .col-name { width: 20%; min-width: 160px; }
    .col-serial { width: 16%; min-width: 140px; }
    .col-version { width: 8%; min-width: 80px; }
    .col-status { width: 9%; min-width: 90px; }
    .col-assigned { width: 20%; min-width: 160px; }
    .col-actions { width: 12%; min-width: 110px; }

   </style>


    <div class="card-body">
        <fieldset class="fieldset-custom">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title mb-0 text-primary">
                    <i class="mdi mdi-view-list me-2"></i> Collector Devices List
                </h4>
            </div>

            <div class="table-responsive">
                <table class="table table-hover" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center col-created">Created On</th>
                            <th class="text-center col-name">Device Name</th>
                            <th class="text-center col-serial">Serial Number</th>
                            <th class="text-center col-version">Version</th>
                            <th class="text-center col-status">Status</th>
                            <th class="text-center col-assigned">Assigned Collector</th>
                            <th class="text-center col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var device in Model)
                            {
                                <tr>
                                    <td class="text-center col-created" title="@device.CreatedOn.ToString()">
                                        @device.CreatedOn.ToString()
                                    </td>

                                    <td class="text-center col-name" title="@device.DeviceName">
                                        <small class="d-block text-truncate" style="max-width:220px;">@device.DeviceName</small>
                                    </td>

                                    <td class="text-center col-serial" title="@device.DeviceSerialNumber">
                                        <small class="d-block text-truncate" style="max-width:180px;">@device.DeviceSerialNumber</small>
                                    </td>

                                    <td class="text-center col-version" title="@device.DeviceVersion">
                                        <small>@device.DeviceVersion</small>
                                    </td>

                                    <td class="text-center col-status">
                                        @if (device.Status == 1)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (device.Status == 0)
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Maintenance</span>
                                        }
                                    </td>

                                    <td class="text-center col-assigned" title="@device.AssignedCollectorUserId">
                                        @if (!string.IsNullOrEmpty(device.AssignedCollectorUserId))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width:220px;">@device.AssignedCollectorUserId</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>

                                    <td class="text-center col-actions">
                                        <div class="btn-group" role="group">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="AddORUpdateGen('@device.Id', 'datalistingview', '_CollectorDeviceDetails', 'get', 'CollectorDevice')"
                                                    data-bs-toggle="tooltip"
                                                    title="View Details">
                                                <i class="mdi mdi-eye"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    onclick="AddORUpdateGen('@device.Id', 'datalistingview', '_CollectorDeviceForm', 'get', 'CollectorDevice')"
                                                    data-bs-toggle="tooltip"
                                                    title="Edit Device">
                                                <i class="mdi mdi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="DeleteRecordDataTable('CollectorDevice', '@device.Id', 'myDataTable', '_CollectorDeviceTable', 0, 'datalistingview', null, 'list')"
                                                    data-bs-toggle="tooltip"
                                                    title="Delete Device">
                                                <i class="mdi mdi-delete"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="mdi mdi-information-outline me-2"></i>No collector devices found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>
    </div>


@section Scripts {
    <script>
        // enable bootstrap tooltips for truncated values
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Optionally enable title tooltips for truncated cells (hover)
        document.querySelectorAll('#myDataTable td[title]').forEach(function (td) {
            td.setAttribute('data-bs-toggle', 'tooltip');
            td.setAttribute('data-bs-placement', 'top');
        });
        // Re-init tooltips after adding attributes
        var ttList = [].slice.call(document.querySelectorAll('#myDataTable [data-bs-toggle="tooltip"]'));
        ttList.forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>
}



<script>
    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    function DeleteRecordDataTable(controller, key, tableId, partialView, confirm, containerId, callback, path) {
        if (confirm === 0 || window.confirm('Are you sure you want to delete this device?')) {
            $.ajax({
                url: `/${controller}/Delete`,
                type: 'GET',
                data: { KEY: key },
                success: function (response) {
                    if (response.success) {
                        appalert(response.message, 1, 1);
                        LoadPartialView(containerId, partialView, controller, path);
                    } else {
                        appalert(response.message, 0, 1);
                    }
                },
                error: function (xhr, status, error) {
                    appalert('Error deleting record: ' + error, 0, 1);
                }
            });
        }
    }
</script>