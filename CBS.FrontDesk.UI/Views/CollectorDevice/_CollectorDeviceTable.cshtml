@model List<CBS.FrontDesk.Data.Entity.Accounting_V2.CollectorDevice.CollectorDeviceresponse>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="card-title mb-0 text-primary">
            <i class="mdi mdi-view-list me-2"></i> Collector Devices List
        </h5>
    </div>
    <div class="card-body">
        <fieldset class="fieldset-custom">
            <div class="table-responsive">
                <table class="table table-hover" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 12%">Device ID</th>
                            <th class="text-center" style="width: 15%">Device Name</th>
                            <th class="text-center" style="width: 15%">Serial Number</th>
                            <th class="text-center" style="width: 10%">Version</th>
                            <th class="text-center" style="width: 10%">Status</th>
                            <th class="text-center" style="width: 13%">Assigned Collector</th>
                            <th class="text-center" style="width: 10%">Assigned On</th>
                            <th class="text-center" style="width: 10%">Created On</th>
                            <th class="text-center" style="width: 5%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var device in Model)
                            {
                                <tr>
                                    <td class="text-center">@device.DeviceId</td>
                                    <td class="text-center">@device.DeviceName</td>
                                    <td class="text-center">@device.DeviceSerialNumber</td>
                                    <td class="text-center">@device.DeviceVersion</td>
                                    <td class="text-center">
                                        @if (device.Status == 1)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (device.Status == 0)
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Maintenance</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(device.AssignedCollectorUserId))
                                        {
                                            <small class="text-muted">@device.AssignedCollectorUserId</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @device.AssignedOn.ToString()
                                    </td>
                                    <td class="text-center">
                                        @device.CreatedOn.ToString()
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="AddORUpdateGen('@device.Id', 'datalistingview', '_CollectorDeviceDetails', 'get', 'CollectorDevice')"
                                                    data-bs-toggle="tooltip"
                                                    title="View Details">
                                                <i class="mdi mdi-eye"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    onclick="AddORUpdateGen('@device.Id', 'datalistingview', '_CollectorDeviceForm', 'get', 'CollectorDevice')"
                                                    data-bs-toggle="tooltip"
                                                    title="Edit Device">
                                                <i class="mdi mdi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="DeleteRecordDataTable('CollectorDevice', '@device.Id', 'myDataTable', '_CollectorDeviceTable', 0, 'datalistingview', null, 'list')"
                                                    data-bs-toggle="tooltip"
                                                    title="Delete Device">
                                                <i class="mdi mdi-delete"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="mdi mdi-information-outline me-2"></i>No collector devices found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>
    </div>
</div>

<script>
    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    function DeleteRecordDataTable(controller, key, tableId, partialView, confirm, containerId, callback, path) {
        if (confirm === 0 || window.confirm('Are you sure you want to delete this device?')) {
            $.ajax({
                url: `/${controller}/Delete`,
                type: 'GET',
                data: { KEY: key },
                success: function (response) {
                    if (response.success) {
                        appalert(response.message, 1, 1);
                        LoadPartialView(containerId, partialView, controller, path);
                    } else {
                        appalert(response.message, 0, 1);
                    }
                },
                error: function (xhr, status, error) {
                    appalert('Error deleting record: ' + error, 0, 1);
                }
            });
        }
    }
</script>