@model CBS.FrontDesk.Data.Entity.Accounting_V2.CollectorDevice.CollectorDeviceresponse

<fieldset class="fieldset-custom">

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-devices me-2"></i> Collector Device Details
            </h1>
            <p class="card-text text-muted mb-1">
                Complete information about the collector device
            </p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Basic Information -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> Basic Information</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Device ID:</td><td>@Model.DeviceId</td></tr>
                <tr><td class="fw-bold">Device Name:</td><td>@Model.DeviceName</td></tr>
                <tr><td class="fw-bold">Serial Number:</td><td>@Model.DeviceSerialNumber</td></tr>
                <tr><td class="fw-bold">Version:</td><td>@Model.DeviceVersion</td></tr>
                <tr>
                    <td class="fw-bold">Status:</td>
                    <td>
                        @if (Model.Status == 1)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (Model.Status == 0)
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Maintenance</span>
                        }
                    </td>
                </tr>
            </table>
        </div>

        <!-- Right Column - Assignment Information -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-account-check me-2"></i> Assignment Information</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <td class="fw-bold">Assigned Collector:</td>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.AssignedCollectorUserId))
                        {
                            @Model.AssignedCollectorUserId
                        }
                        else
                        {
                            <span class="text-muted">Not Assigned</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">Assigned On:</td>
                    <td>@Model.AssignedOn.ToString()</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Timeline Section -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> Timeline</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">Created On:</td><td>@Model.CreatedOn.ToString()</td></tr>
                <tr><td class="fw-bold">Last Modified:</td><td>@Model.ModifiedOn.ToString()</td></tr>
            </table>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12 text-end">
            <button type="button"
                    class="btn btn-secondary me-2"
                    onclick="AddORUpdateGen('@Model.Id', 'datalistingview', '_CollectorDeviceForm', 'get', 'CollectorDevice')">
                <i class="mdi mdi-pencil me-1"></i> Edit Device
            </button>
            <button type="button"
                    class="btn btn-outline-primary"
                    onclick="LoadPartialView('datalistingview', '_CollectorDeviceTable', 'CollectorDevice', 'list')">
                <i class="mdi mdi-arrow-left me-1"></i> Back to List
            </button>
        </div>
    </div>

</fieldset>
