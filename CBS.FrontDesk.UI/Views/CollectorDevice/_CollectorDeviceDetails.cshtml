@model CBS.FrontDesk.Data.Entity.Accounting_V2.CollectorDevice.CollectorDeviceresponse
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-devices me-2"></i>@GlobalCollectorDevice.Collector_Device_Details
                </h1>
                <p class="card-text">
                    @*CollectorCommissionText*@
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<fieldset class="fieldset-custom">    <div class="row">
        <!-- Left Column - Basic Information -->
        <div class="col-md-6">
            <label class="text-primary"><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Basic_Information</label>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@GlobalShared.Device_ID:</td><td>@Model.DeviceId</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Device_Name:</td><td>@Model.DeviceName</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Serial_Number:</td><td>@Model.DeviceSerialNumber</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Version:</td><td>@Model.DeviceVersion</td></tr>
                <tr>
                    <td class="fw-bold">Status:</td>
                    <td>
                        @if (Model.Status == 1)
                        {
                            <span class="badge bg-success">@GlobalShared.Active</span>
                        }
                        else if (Model.Status == 0)
                        {
                            <span class="badge bg-danger">@GlobalShared.InActive</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">@GlobalShared.Maintenance</span>
                        }
                    </td>
                </tr>
            </table>
        </div>

        <!-- Right Column - Assignment Information -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-account-check me-2"></i> @GlobalShared.Assignment_Information</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <td class="fw-bold">@GlobalShared.Assigned_Collector:</td>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.AssignedCollectorUserId))
                        {
                            @Model.AssignedCollectorUserId
                        }
                        else
                        {
                            <span class="text-muted">@GlobalShared.Not_Assigned</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Assigned_On:</td>
                    <td>@Model.AssignedOn.ToString()</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Timeline Section -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> @GlobalShared.Timeline</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@GlobalShared.Created_On:</td><td>@Model.CreatedOn.ToString()</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Last_Modified:</td><td>@Model.ModifiedOn.ToString()</td></tr>
            </table>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12 text-end">
            <button type="button"
                    class="btn btn-secondary me-2"
                    onclick="deviceManager.editDevice('@Model.Id')"
                    data-bs-toggle="tooltip"
                    title="Edit this device">
                <i class="mdi mdi-pencil me-1"></i> @GlobalShared.Edit_Device
            </button>
            <button type="button"
                    class="btn btn-outline-primary"
                    data-bs-dismiss="modal">
                <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
            </button>
        </div>
    </div>
</fieldset>