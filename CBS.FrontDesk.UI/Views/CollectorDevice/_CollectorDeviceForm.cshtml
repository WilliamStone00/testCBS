@model CBS.FrontDesk.Data.Entity.Accounting_V2.CollectorDevice.CollectorDeviceresponse

<div class="card">
    <div class="modal-body">

        @using (Html.BeginForm("CreateOrUpdate", "CollectorDevice", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return collectorDeviceSubmitAjax(this);" }))
        {
            @Html.HiddenFor(m => m.Id)
            @Html.AntiForgeryToken()

            <div class="row gy-3">
                <!-- Device Information Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-devices me-1"></i> Device Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.DeviceId, new { @class = "form-control", placeholder = "Device ID" })
                        @Html.ValidationMessageFor(m => m.DeviceId, "", new { @class = "text-danger" })
                        <label>Device ID *</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.DeviceName, new { @class = "form-control", placeholder = "Device Name" })
                        @Html.ValidationMessageFor(m => m.DeviceName, "", new { @class = "text-danger" })
                        <label>Device Name *</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.DeviceVersion, new { @class = "form-control", placeholder = "Device Version" })
                        @Html.ValidationMessageFor(m => m.DeviceVersion, "", new { @class = "text-danger" })
                        <label>Device Version</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.DeviceSerialNumber, new { @class = "form-control", placeholder = "Serial Number" })
                        @Html.ValidationMessageFor(m => m.DeviceSerialNumber, "", new { @class = "text-danger" })
                        <label>Serial Number *</label>
                    </div>
                </div>

                <div class="col-12 text-end mt-4">
                    @if (string.IsNullOrEmpty(Model?.Id))
                    {
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="mdi mdi-content-save me-1"></i> Create Device
                        </button>
                        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                            Reset
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="mdi mdi-content-save me-1"></i> Update Device
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="LoadPartialView('datalistingview', '_CollectorDeviceTable', 'CollectorDevice', 'list')">
                            Back to List
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    function collectorDeviceSubmitAjax(form) {
        event.preventDefault();

        $.ajax({
            url: $(form).attr('action'),
            type: 'POST',
            data: $(form).serialize(),
            success: function (response) {
                if (response.success) {
                    appalert(response.message, 1, 1);
                    // Reload the list view
                    LoadPartialView('datalistingview', '_CollectorDeviceTable', 'CollectorDevice', 'list');
                } else {
                    appalert(response.message, 0, 1);
                }
            },
            error: function (xhr, status, error) {
                appalert('Error submitting form: ' + error, 0, 1);
            }
        });

        return false;
    }
</script>
