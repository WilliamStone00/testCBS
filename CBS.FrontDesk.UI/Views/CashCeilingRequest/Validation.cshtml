@model List<CBS.FrontDesk.Data.Entity.CashCeilingManagement.CashCeilingRequest>
    @using Resources
@{
    ViewBag.Title = @CashCeilingRequestRessource.CashCeilingRequestValidation;
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash-multiple me-2"></i> @CashCeilingRequestRessource.CashCeilingRequestValidation
                </h1>
                <p class="card-text text-muted">
                    @CashCeilingRequestRessource.ReviewAndValidateCashCeilingRequests.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<!-- Tips Section -->
<div class="card mb-4">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.TIPS_UC</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="false" aria-controls="collapseValidationTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseValidationTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @CashCeilingRequestRessource.EnsureTheRequestDetailsAreAccurateBeforeValidation.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @CashCeilingRequestRessource.IfTheRequestTypeIs <strong>@CashCeilingRequestRessource.CashToVault</strong>, @CashCeilingRequestRessource.EnsureTheCashTransferAlignsWithBranchVaultPolicies.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @CashCeilingRequestRessource.IfTheRequestTypeIs <strong>@CashCeilingRequestRessource.Subteller_Cash_To_PrimaryTeller</strong>, @CashCeilingRequestRessource.EnsureTheBalancesAreAdjustedCorrectly.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @CashCeilingRequestRessource.ApprovalRejectionOrPendingStatus.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Table Section -->
@if (!Model.Any())
{
    <div class="text-center my-3">
        <p class="text-muted">@CashCeilingRequestRessource.NoCashCeilingRequestsToValidateAtTheMoment.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.Request_Type</th>
                    <th>@GlobalShared.Amount</th>
                    <th>@GlobalShared.Requested_by</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.BranchName</td>
                        <td>
                            @if (request.RequestType == "Cash_To_Vault")
                            {
                                <span class="badge bg-primary">@CashCeilingRequestRessource.CashToVault</span>
                            }
                            else if (request.RequestType == "Subteller_Cash_To_PrimaryTeller")
                            {
                        <span class="badge bg-warning">@CashCeilingRequestRessource.SubTellerToPrimaryTeller</span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">@GlobalShared.Unknown</span>
                            }
                        </td>
                        <td>@request.CashoutRequestAmount.ToString("#,##0.0") FCFA</td>
                        <td>@request.RequestedBy</td>
                        <td>
                            @if (request.ApprovedStatus == "Pending")
                            {
                                <span class="badge bg-warning">@GlobalShared.Pending</span>
                            }
                            else if (request.ApprovedStatus == "Approved")
                            {
                        <span class="badge bg-success">@GlobalShared.Approved</span>
                            }
                            else if (request.ApprovedStatus == "Rejected")
                            {
                        <span class="badge bg-danger">@GlobalShared.Rejected</span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">@GlobalShared.Unknown</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                @if (request.ApprovedStatus == "Pending")
                                {
                                    <!-- Validate Button -->
                                <a type="button"
                                   class="btn btn-sm btn-outline-primary"
                                   href="/CashCeilingRequest/RequestValidation?Key=@request.Id&RequestType=@request.RequestType"
                                   data-bs-toggle="tooltip"
                                   title="Validate Request">
                                    <i class="fas fa-check-circle"></i> @GlobalShared.Validate
                                </a>
                                }
                                <!-- View Details Button -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-info"
                                    onclick="viewRequestDetails('@request.Id')"
                                    data-bs-toggle="tooltip"
                                    title="View Details">
                                <i class="fas fa-info-circle"></i> @GlobalShared.Details
                            </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>


        function viewRequestDetails(requestId) {
            // Load request details in modal
            $('#vaultDetailsModal').modal('show');
            $('#vaultDetailsContent').html('<p>Loading...</p>');

            $.ajax({
                url: '/CashCeiling/ViewRequestDetails',
                type: 'GET',
                data: { id: requestId },
                success: function (data) {
                    $('#vaultDetailsContent').html(data);
                },
                error: function () {
                    $('#vaultDetailsContent').html('<p class="text-danger">Error loading request details.</p>');
                }
            });
        }
    </script>
}
