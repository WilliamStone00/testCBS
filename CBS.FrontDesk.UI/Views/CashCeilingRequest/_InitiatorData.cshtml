
@model List<CBS.FrontDesk.Data.Entity.CashCeilingManagement.CashCeilingRequest>
    @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@CashCeilingRequest_InitiatorData.MyCashCeilingRequests</legend>
    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p class="text-muted">@CashCeilingRequest_InitiatorData.YouHaventCreatedAnyCashCeilingRequestsYet.</p>
        </div>

    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered text-center" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 47%;">@CashCeilingRequest_InitiatorData.Branch</th>
                        <th style="width: 10%;">@CashCeilingRequest_InitiatorData.RequestType</th>
                        <th style="width: 20%;">@CashCeilingRequest_InitiatorData.Amount</th>
                        <th style="width: 8%;">@CashCeilingRequest_InitiatorData.Status</th>
                        <th style="width: 15%;">@CashCeilingRequest_InitiatorData.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.BranchName</td>
                            <td>
                                @if (request.RequestType == "Cash_To_Vault")
                                {
                                    <span class="badge bg-primary">@CashCeilingRequest_InitiatorData.CASHTOVAULT</span>
                                }
                                else if (request.RequestType == "Subteller_Cash_To_PrimaryTeller")
                                {
                            <span class="badge bg-warning">@CashCeilingRequest_InitiatorData.SToPTILL</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary">@CashCeilingRequest_InitiatorData.Unknown</span>
                                }
                            </td>
                            <td>@request.CashoutRequestAmount.ToString("#,##0.0") FCFA</td>
                            <td>
                                @if (request.ApprovedStatus == "Pending")
                                {
                                    <span class="badge bg-warning">@CashCeilingRequest_RequestValidation.Pending</span>
                                }
                                else if (request.ApprovedStatus == "Approved")
                                {
                            <span class="badge bg-success">@CashCeilingRequest_RequestValidation.Approved</span>
                                }
                                else if (request.ApprovedStatus == "Rejected")
                                {
                            <span class="badge bg-danger">@CashCeilingRequest_RequestValidation.Rejected</span>
                                }
                                else
                                {
                            <span class="badge bg-secondary">@CashCeilingRequest_InitiatorData.Unknown</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Edit Button -->
                                    @if (request.ApprovedStatus == "Pending")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                onclick="AddORUpdateGen('@request.Id', 'datalistingview', '_Create', 'update', 'CashCeilingRequest', null, null)"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Edit Request">
                                            <i class="fas fa-edit"></i> @GlobalShared.Edit
                                        </button>
                                    }

                                    <!-- Delete Button -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="DeleteRecordDataTable('CashCeilingRequest', '@request.Id', 'myDataTable', '_InitiatorData', 0, 'datalistingview',null,'initiator_data')"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="Delete Request">
                                    <i class="fas fa-trash-alt"></i> @GlobalShared.Delete
                                </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
