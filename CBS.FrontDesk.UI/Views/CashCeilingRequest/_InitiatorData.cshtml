
@model List<CBS.FrontDesk.Data.Entity.CashCeilingManagement.CashCeilingRequest>
<fieldset class="fieldset-custom">
    <legend id="select_base">My Cash Ceiling Requests</legend>
    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p class="text-muted">You haven't created any cash ceiling requests yet.</p>
        </div>

    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered text-center" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 47%;">Branch</th>
                        <th style="width: 10%;">Request Type</th>
                        <th style="width: 20%;">Amount</th>
                        <th style="width: 8%;">Status</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.BranchName</td>
                            <td>
                                @if (request.RequestType == "Cash_To_Vault")
                                {
                                    <span class="badge bg-primary">CASH TO VAULT</span>
                                }
                                else if (request.RequestType == "Subteller_Cash_To_PrimaryTeller")
                                {
                                    <span class="badge bg-warning">S To P TILL</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            </td>
                            <td>@request.CashoutRequestAmount.ToString("#,##0.0") FCFA</td>
                            <td>
                                @if (request.ApprovedStatus == "Pending")
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else if (request.ApprovedStatus == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (request.ApprovedStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Edit Button -->
                                    @if (request.ApprovedStatus == "Pending")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                onclick="AddORUpdateGen('@request.Id', 'datalistingview', '_Create', 'update', 'CashCeilingRequest', null, null)"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Edit Request">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                    }

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="DeleteRecordDataTable('CashCeilingRequest', '@request.Id', 'myDataTable', '_InitiatorData', 0, 'datalistingview',null,'initiator_data')"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Delete Request">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
