                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin50, "", new { @class = "text-danger " })
                        <label>C50</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin25, new { @class = "form-control", @id = "Notes_coin25", @oninput = "calculateBalance()" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin25, "", new { @class = "text-danger " })
                        <label>C25</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin10, new { @class = "form-control", @id = "Notes_coin10", @oninput = "calculateBalance()" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin10, "", new { @class = "text-danger " })
                        <label>C10</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin5, new { @class = "form-control", @id = "Notes_coin5", @oninput = "calculateBalance()" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin5, "", new { @class = "text-danger " })
