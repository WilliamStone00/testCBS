                </div>

                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin100, new { @class = "form-control", @id = "Notes_coin100", @oninput = "calculateBalance()" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin100, "", new { @class = "text-danger " })
                        <label>C100</label>
