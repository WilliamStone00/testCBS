                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin1, new { @class = "form-control", @id = "Notes_coin1", @oninput = "calculateBalance()" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.CurrencyNote.coin1, "", new { @class = "text-danger " })
                        <label>C1</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.ValidationCashCeilingRequestCommand.ApprovedComment, new { @class = "form-control", @style = "height: 120px;" })
                        @Html.ValidationMessageFor(m => m.ValidationCashCeilingRequestCommand.ApprovedComment, "", new { @class = "text-danger " })
                        <label for="formValidationDob">Approval note</label>
                    </div>
                </div>

            </div>
            <div class="mt-4">
                <button type="submit" id="btnSave" class="btn btn-primary me-2">Submit</button>
            </div>
        }
    </div>
</fieldset>





