    <style>
        /* Reusable accounting date field tweaks */
        .accounting-date {
            padding-right: 2.25rem; /* space for native calendar icon */
        }
            /* Optional: tighter look */
            .accounting-date::-webkit-datetime-edit,
            .accounting-date::-webkit-date-and-time-value {
                line-height: 1.25rem;
            }
        /* Trial Balance Styles */
        #trialBalance .used-cell {
            text-decoration: line-through !important;
            color: #ff0000 !important;
        }

        /* Balance Sheet Styles */
        #balanceSheet .highlighted-cell {
            background-color: #fffacd !important;
        }

        #balanceSheet .highlighted-row {
            background-color: #f0fff0 !important;
        }

        #balanceSheet .treated-row {
            background-color: #e6ffe6 !important;
        }

        /* Account Management Dropdown */
        .account-management-dropdown {
            position: absolute;
            background: white;
            border: 1px solid #ddd;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            max-height: 300px;
            overflow-y: auto;
        }

            .account-management-dropdown .dropdown-header {
                padding: 5px 10px;
                background: #f5f5f5;
                font-weight: bold;
                border-bottom: 1px solid #ddd;
            }

            .account-management-dropdown .dropdown-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .account-management-dropdown .dropdown-list li {
                    padding: 5px 10px;
                    cursor: pointer;
                    border-bottom: 1px solid #eee;
                }

                    .account-management-dropdown .dropdown-list li:hover {
                        background-color: #f5f5f5;
                    }
        /* Ensure the image inside .text-center is responsive */
        .text-center {
            width: 100%; /* Ensure the parent div fills its container */
            overflow: hidden; /* Hide any overflow to prevent unwanted scrollbars */
        }

        .faq-image {
            max-width: 100%; /* Ensure the image does not exceed the width of its container */
            height: auto; /* Maintain aspect ratio */
        }

        #action_indented {
            color: #007bff; /* A nicer blue color */
            text-decoration: none; /* Remove underline */
            cursor: pointer; /* Change cursor to pointer to indicate it's clickable */
            font-weight: bold; /* Make the font bold */
            font-family: 'Arial', sans-serif; /* Set a nice font */
            display: flex;
            align-items: center;
        }

            #action_indented::before {
                content: "🔔"; /* Add a bell emoji before the text */
                margin-right: 1px; /* Add some space between the emoji and the text */
                font-size: 0.9em; /* Adjust the emoji size */
            }

            #action_indented:hover {
                color: #0056b3; /* Darker blue on hover */
                text-decoration: underline; /* Underline on hover */
            }

        .error-container {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 5px;
            color: #721c24;
            box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.75);
        }

        .system-error-text {
            font-family: "Courier New", Courier, monospace;
            color: black;
        }

        .system-error-container {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            background-color: #f3ef0a79;
            border: 1px solid #efce4d;
            border-radius: 5px;
            color: #f6bd1ea4;
            font-size: inherit;
            box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.75);
        }

        .error-container p {
            margin: 0;
        }
    </style>
    <style>



        #superposedModal {
            z-index: 1200; /* Make sure it has a higher z-index than other modals */
            pointer-events: auto;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 135%; /* Increase width by 35% */
            height: auto; /* Let the height adjust automatically */
        }

            #superposedModal .modal-dialog {
            }

        .withdrawal-notification i {
            margin-right: 8px;
            color: #28a745;
        }

        .form-greyed-out {
            opacity: 0.5; /* Reduce opacity to grey out */
            pointer-events: none; /* Disable pointer events */
        }

        .card-header {
            color: black;
        }

        .shadow-input-boxes {
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Adjust the values as needed */
        }

        .table-title {
            font-weight: bold;
            font-size: 1.2em;
            text-align: center; /* Center align the text */
            background-color: #f0f0f0; /* Light gray background */
            padding: 10px; /* Add padding for better readability */
        }

        .shadow-box {
            display: inline-block;
            padding: 6px 12px;
            font-size: 1rem;
            line-height: 1.5;
            color: #000; /* Adjust color as needed */
            background-color: #fff; /* Background color */
            border: 1px solid rgba(0, 0, 0, 0.125); /* Border color */
            border-radius: 0.25rem;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1); /* Shadow effect */
            float: right; /* Align to the left */
        }

        .shadow-404 {
            display: inline-block;
            padding: 6px 12px;
            font-size: 1rem;
            line-height: 1.5;
            color: #000; /* Adjust color as needed */
            background-color: #fff; /* Background color */
            border: 1px solid rgba(0, 0, 0, 0.125); /* Border color */
            border-radius: 0.25rem;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1); /* Shadow effect */
            float: left;
        }


        input[readonly] {
            background-color: #f4f4f4; /* Set background color to gray */
            color: #666666; /* Set text color to a darker shade of gray */
            cursor: not-allowed; /* Set cursor to not-allowed */
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #dddddd;
            text-align: left;
            padding: 8px;
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
    <style>
        .btn-space {
            margin-right: 10px; /* Adjust the value to increase or decrease the space */
        }
        /* Apply bold font, font size 16px, and blue color to the textbox */
        .textbox {
            font-weight: bold;
            font-size: 16px;
            color: blue;
            /* Apply inner shadow effect */
            box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.5);
        }

            /* Style for the border to make it visually appealing */
            .textbox:focus {
                outline: none; /* Remove default focus outline */
