    <script>
        (function () {
            function isoToday() {
                const t = new Date();
                return [
                    t.getFullYear(),
                    String(t.getMonth() + 1).padStart(2, '0'),
                    String(t.getDate()).padStart(2, '0')
                ].join('-');
            }

            function normalizeAccountingDate(input) {
                if (!input) return;
                const raw = (input.value || '').trim();

                // Detect MinValue / empty
                const looksMin =
                    !raw || raw.startsWith('0001-01-01') ||
                    raw === '01/01/0001' || raw === '0001/01/01';

                // Behavior flags
                const wantsDefaultToday = (input.dataset.dateDefault || '').toLowerCase() === 'today';
                const wantsMaxToday = (input.dataset.dateMax || '').toLowerCase() === 'today';
                const wantsMinToday = (input.dataset.dateMin || '').toLowerCase() === 'today';

                if (looksMin && wantsDefaultToday) input.value = isoToday();
                if (wantsMaxToday && !input.max) input.max = isoToday();
                if (wantsMinToday && !input.min) input.min = isoToday();

                // Adjust if value outside allowed range
                if (input.max && input.value && input.value > input.max) input.value = input.max;
                if (input.min && input.value && input.value < input.min) input.value = input.min;
            }

            function initAccountingDates(root) {
                const scope = root || document;
                scope.querySelectorAll('input[type="date"].accounting-date').forEach(normalizeAccountingDate);
            }

            document.addEventListener('DOMContentLoaded', () => initAccountingDates());

            // For partial views loaded later
            const mo = new MutationObserver(muts => {
                for (const m of muts) {
                    for (const n of m.addedNodes) {
                        if (n.nodeType === 1) initAccountingDates(n);
                    }
                }
            });
            mo.observe(document.body, { childList: true, subtree: true });

            // Optional: expose for manual calls
            window.initAccountingDates = initAccountingDates;
        })();
    </script>



