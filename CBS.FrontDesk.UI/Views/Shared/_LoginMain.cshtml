        <script src="~/CBSTemp/ui/assets/vendor/libs/@form-validation/umd/plugin-bootstrap5/index.min.js"></script>
        <script src="~/CBSTemp/ui/assets/vendor/libs/@form-validation/umd/plugin-auto-focus/index.min.js"></script>*@

    <!-- Main JS -->
    <script src="~/CBSTemp/ui/assets/js/main.js"></script>

    <!-- Page JS -->
    <script src="~/CBSTemp/ui/assets/js/pages-auth.js"></script>
    <script src="~/Scripts/Js/main.js/App.js"></script>
    @RenderSection("scripts", required: false)
