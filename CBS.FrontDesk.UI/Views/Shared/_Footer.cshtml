@{
    string bankName = Session["BankName"]?.ToString(); // Check if Session["BankName"] is null
}
<footer class="content-footer footer bg-white">
    <div class="container-xxl">
        <div class="footer-container d-flex align-items-center justify-content-between py-3 flex-md-row flex-column">
            <div class="mb-2 mb-md-0">
                Copy right ©
                <script>
                    document.write(new Date().getFullYear() - 1);
                </script>
                 <span class="text-danger"></span> by
                <a href="https://pixinvent.com" target="_blank" class="footer-link fw-medium">
                    F L U X Cameroon, <b>@(string.IsNullOrEmpty(bankName) ? "Default Bank Name" : bankName)</b>
                </a>
            </div>
            <div class="d-none d-lg-inline-block">
                <!-- Additional links if needed -->
            </div>
        </div>
    </div>
</footer>


