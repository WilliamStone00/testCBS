<style>
    .text-center label {
        font-size: 16px;
    }

    .dropdown-language img {
        border-radius: 3px;
        object-fit: cover;
    }

    .navbar-nav .text-muted {
        margin-left: 5px;
        margin-right: 5px;
    }

    .info-banner {
        font-size: 14px;
        border: 1px solid #e0e0e0;
        background-color: #fdfdfd;
        border-radius: 10px;
        padding: 10px 16px;
        min-height: 45px;
        display: flex;
        justify-content: flex-start; /* Align content to the left */
        align-items: center;
        flex-wrap: wrap;
    }
    body {
        top: 0 !important;
    }

    .goog-te-banner-frame.skiptranslate {
        display: none !important;
    }

    .goog-te-combo {
        margin: 0;
    }

    #google_translate_element {
        display: none !important;
    }

    .goog-logo-link,
    .goog-te-gadget {
        display: none !important;
    }


