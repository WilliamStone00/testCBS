<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        /* Reset CSS */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .container{
            max-width: 800px;
            margin: 0 auto;
            padding: 50px;
            text-align: center;
        }

        .header, .footer {
            background-color: #3a6989;
            color: #fff;
            padding: 20px 0;
            margin-bottom: 20px;
            text-align: center; /* Center horizontally */
        }

        .footer {
            margin-top: 20px;
        }

        .content {
            background-color: #f8f9fa;
            border: 2px solid #dc3545;
            border-radius: 15px;
            padding: 20px;
            box-shadow: #98cb44;
        }

        h2 {
            color: #dc3545;
            margin-bottom: 20px;
        }

        p {
            font-size: 1.2rem;
            color: #6c757d;
            margin-bottom: 20px;
        }
        .p {
            font-size: 1.2rem;
            color: #f8f9fa;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            background-color: #3a6989;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

            .btn:hover {
                background-color: #4f7bf6;
            }
    </style>
</head>
<body>
    @{
        string bankName = Session["BankName"]?.ToString(); // Check if Session["BankName"] is null
    }
    <div class="header">
        <!-- Header Content Goes Here -->
        <h1>T R U S T S O F T C R E D I T - ERROR PAGE</h1>
    </div>

    <div class="container">
        <div class="content">
            @RenderBody()
        </div>
    </div>
    <footer class="content-footer footer bg-white">
        <div class="container-xxl">
            <div class="footer-container d-flex align-items-center justify-content-between py-3 flex-md-row flex-column">
                <div class="mb-2 mb-md-0">
                    Copy right ©
                    <script>
                        document.write(new Date().getFullYear() - 1)
                    </script>
                    <span class="text-danger"></span> by
                    F L U X SARL Cameroon, <b>@(string.IsNullOrEmpty(bankName) ? "Default Bank Name" : bankName)</b>
                </div>
            </div>
        </div>
    </footer>
    <!--<div class="footer">-->
    <!-- Footer Content Goes Here -->
    <!--<p class="p">&copy; 2024 Your Website. All rights reserved.</p>
    </div>-->
</body>
</html>
