@{
    ViewBag.Title = "An Error Occurred";
    var title = ViewBag.TitleText ?? "Oops! Something went wrong.";
    var message = ViewBag.Message ?? "We're sorry, but an unexpected error has occurred.";
    var errorCode = ViewBag.StatusCode ?? 500;
    var stackTrace = ViewBag.StackTrace ?? "";
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    var showDiagnostics = HttpContext.Current.IsDebuggingEnabled;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-start border-4 border-danger">
                <div class="card-body">
                    <h3 class="text-danger mb-3">
                        <i class="mdi mdi-alert-circle-outline me-2"></i> @title
                    </h3>
                    <br />
                    <p class="mb-2 fs-6 mb-3">
                        <strong>Status Code:</strong> <span class="badge bg-dark">@errorCode</span>
                    </p>
                    <br />
                    <p class="text-muted mb-3">
                        <strong>Message:</strong> @message
                    </p>

                    @if (showDiagnostics && !string.IsNullOrEmpty(stackTrace))
                    {
                        <div class="alert alert-warning bg-light-subtle p-3 rounded mt-4">
                            <h6 class="text-warning fw-bold mb-2">
                                <i class="mdi mdi-bug-outline me-1"></i> Diagnostic Information
                            </h6>
                            <pre class="small text-dark mb-0" style="white-space: pre-wrap;">@stackTrace</pre>
                        </div>
                    }

                    <hr class="mb-4" />
                    <br />
                    <div class="text-center mb-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                            <i class="mdi mdi-home-outline me-1"></i> Return to Home
                        </a>
                        <br />
                        <br />
                        <p class="text-muted small mt-3 mb-0">
                            If the issue continues, please contact technical support.
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
