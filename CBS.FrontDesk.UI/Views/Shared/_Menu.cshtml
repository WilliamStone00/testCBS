@{
    // Retrieve the menu tree from the session via ViewBag.
    var menuItems = ViewBag.MenuItems as List<CBS.FrontDesk.Data.Entity.PermissionNode>;
}

@if (menuItems != null && menuItems.Any())
{
    <aside id="layout-menu" class="layout-menu menu-vertical menu bg-white">

        <!-- Logo and Menu Toggle -->
        <div class="app-brand demo d-flex align-items-center justify-content-between px-3 py-2">
            <a href="/" class="app-brand-link">
                <span class="app-brand-logo demo">
                    <img src="~/AppFiles/Images/SideImageHeader_login.png"
                         alt="TrustBank Logo"
                         style="max-width: 100px; height: auto;" />
                </span>
            </a>
            <button class="layout-menu-toggle btn btn-outline-primary btn-sm">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Optional Shadow Divider -->
        <div class="menu-inner-shadow"></div>

        <!-- User Profile Section -->
        <div class="d-flex align-items-center px-3 py-3 border-bottom">
            <div class="user-image me-3 d-flex align-items-center justify-content-center">
                <img src="@Session["Photo"].ToString()"
                     alt="User Profile Image"
                     class="img-fluid rounded-circle"
                     style="width: 40px; height: 40px;" />
            </div>
            <div class="user-info">
                <span class="user-name fw-semibold">@Session["FullName"].ToString()</span>
            </div>
        </div>

        <!-- Menu Tree -->
        @Html.Partial("_MenuTree", menuItems, new ViewDataDictionary { { "IsRoot", true }, { "Level", 0 } })
    </aside>
}
