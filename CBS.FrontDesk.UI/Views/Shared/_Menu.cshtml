@{
    var menuItems = ViewBag.MenuItems as List<CBS.FrontDesk.Data.Entity.PermissionNode>;
    string fullName = Session["FullName"]?.ToString() ?? "";
    string trimmedName = string.Join(" ", fullName.Split(' ').Take(10));
    var userPhoto = Session["Photo"]?.ToString();

    var encodedName = System.Net.WebUtility.UrlEncode(fullName);
    var profileImage = string.IsNullOrWhiteSpace(userPhoto)
        ? Url.Content("~/AppFiles/Images/Avatar/avatarimg.jpg")
        : userPhoto;
}





@if (menuItems != null && menuItems.Any())
{
    <aside id="layout-menu" class="layout-menu menu-vertical menu bg-white shadow-sm rounded-end">

        <!-- Logo and Menu Toggle -->
        <div class="app-brand demo d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
            <a href="/" class="app-brand-link">
                <span class="app-brand-logo demo">
                    <img src="~/AppFiles/Images/SideImageHeader_login.png"
                         alt="TrustBank Logo"
                         style="max-width: 100px; height: auto;" />
                </span>
            </a>
            <button class="layout-menu-toggle btn btn-outline-primary btn-sm">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- User Profile -->
        <div class="d-flex align-items-center px-3 py-3 border-bottom bg-light-subtle">
            <div class="user-image me-3 d-flex align-items-center justify-content-center">
               <img src="@profileImage"
     alt="User Profile Image"
     class="img-fluid rounded-circle shadow-sm"
     style="width: 40px; height: 40px;" />
            </div>
            <div class="user-info">
                <span class="user-name fw-semibold">@trimmedName</span>
            </div>
        </div>

        <!-- 🔍 Material Design Search -->
        <!-- 🔍 Centered Search Box in Gray Background -->
        <div class="search-wrapper bg-light border-bottom d-flex justify-content-center align-items-center">
            <div class="md-search position-relative" style="max-width: 280px; width: 100%;">
                <button type="button" class="md-search-btn" tabindex="-1">
                    <i class="mdi mdi-magnify"></i>
                </button>
                <input type="text"
                       id="menuSearchInput"
                       class="md-search-input form-control"
                       placeholder="Search Menu."
                       autocomplete="off" />
                <label for="menuSearchInput" class="md-search-label">Search menu</label>
                <button type="button" id="clearSearchBtn" class="md-clear-btn">
                    <i class="mdi mdi-close-circle"></i>
                </button>
            </div>
        </div>



        <!-- Spacer -->
        <div style="height: 8px;"></div>

        <!-- 🌲 Menu Tree -->
        <div id="menuTreeWrapper" class="px-2">
            @Html.Partial("_MenuTree", menuItems, new ViewDataDictionary { { "IsRoot", true }, { "Level", 0 } })
        </div>
    </aside>

    <!-- 💡 JavaScript -->

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("menuSearchInput");
            const clearBtn = document.getElementById("clearSearchBtn");

            const allItems = document.querySelectorAll("#layout-menu .menu-item");
            const allSubMenus = document.querySelectorAll("#layout-menu .menu-sub");

            function resetSearch() {
                searchInput.value = "";
                allItems.forEach(item => {
                    item.classList.remove("d-none");
                    item.classList.remove("search-match");
                });
                allSubMenus.forEach(sub => sub.style.display = "");
            }

            function showChildren(item) {
                const children = item.querySelectorAll(":scope > .menu-sub > .menu-item");
                children.forEach(child => {
                    child.classList.remove("d-none");
                    child.classList.add("search-match");
                    showChildren(child); // recursively reveal deeper children
                });
            }

            searchInput.addEventListener("input", function () {
                const filter = this.value.toLowerCase().trim();

                // Reset all visibility
                allItems.forEach(item => {
                    item.classList.remove("d-none", "search-match");
                });
                allSubMenus.forEach(sub => {
                    sub.style.display = "";
                });

                // Exit if filter is empty
                if (!filter) return;

                // Step 1: Hide all items
                allItems.forEach(item => item.classList.add("d-none"));

                // Step 2: Reveal matches and full hierarchy around them
                allItems.forEach(item => {
                    const textElement = item.querySelector(".menu-text");
                    const text = textElement?.textContent.toLowerCase() ?? "";

                    const isDirectMatch = text.includes(filter);
                    const hasMatchingDescendants = Array.from(item.querySelectorAll(".menu-item .menu-text"))
                        .some(child => child.textContent.toLowerCase().includes(filter));

                    if (isDirectMatch || hasMatchingDescendants) {
                        // Show this item
                        item.classList.remove("d-none");
                        item.classList.add("search-match");

                        // Show all children (force all if parent matched)
                        if (isDirectMatch) {
                            showChildren(item);
                        }

                        // Show ancestors
                        let parent = item.parentElement;
                        while (parent && parent.id !== "layout-menu") {
                            if (parent.classList.contains("menu-sub")) {
                                parent.style.display = "block";
                            }
                            if (parent.classList.contains("menu-item")) {
                                parent.classList.remove("d-none");
                                parent.classList.add("search-match");
                            }
                            parent = parent.parentElement;
                        }
                    }
                });
            });

            // Clear search
            clearBtn.addEventListener("click", resetSearch);

            // Ctrl+K to focus
            document.addEventListener("keydown", function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                }
            });
        });
    </script>


