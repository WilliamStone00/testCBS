@{
    // Retrieve the menu tree from the session via ViewBag.
    var menuItems = ViewBag.MenuItems as List<CBS.FrontDesk.Data.Entity.PermissionNode>;
}

@if (menuItems != null && menuItems.Any())
{
    <aside id="layout-menu" class="layout-menu menu-vertical menu bg-white">
        <div class="app-brand demo d-flex align-items-center">
            <a href="/" class="app-brand-link me-auto">
                <span class="app-brand-logo demo">
                    <span style="color: var(--bs-primary)">
                        <img src="~/AppFiles/Images/SideImageHeader_login.png" alt="TrustBank Logo" style="max-width: 100px; height: auto;" />
                    </span>
                </span>
            </a>

            <button class="layout-menu-toggle btn btn-outline-primary btn-sm">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <hr />

        <div class="menu-inner-shadow"></div>

        <div class="d-flex align-items-center px-3 py-2">
            <div class="user-image me-3 ml-1 d-flex align-items-center justify-content-center">
                <img src="@Session["Photo"].ToString()" alt="User Profile Image" class="img-fluid rounded-circle" style="width: 40px; height: 40px;" />
            </div>
            <div class="user-info">
                <span class="user-name">@Session["FullName"].ToString()</span>
            </div>
        </div>

        <hr />

        @Html.Partial("_MenuTree", menuItems, new ViewDataDictionary { { "IsRoot", true }, { "Level", 0 } })
    </aside>
}
