@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.RevokeLicenseRequest

<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cancel me-2"></i>Revoke License
        </h1>
        <div class="alert alert-danger">
            <i class="mdi mdi-alert-circle-outline me-2"></i>
            <strong>Warning:</strong> This action cannot be undone. The license will be immediately invalidated.
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<form method="post" action="@Url.Action("Revoke", "DailyCollectorLicense")"
      onsubmit="return handleFormSubmit(this, 'License revoked successfully!')">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.LicenseId)

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="mdi mdi-cancel me-2 text-primary"></i>Revoke License</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-bold">Revocation Reason *</label>
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Enter reason for revoking this license...",
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">
                <i class="mdi mdi-cancel me-1"></i> Revoke License
            </button>
        </div>
    </div>
</form>
