@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.ActivateLicenseRequest
@using Resources
<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-check-circle me-2"></i>@GlobalShared.Activate_License
        </h1>
        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            <strong>@GlobalShared.Info:</strong> @GlobalDailyCollectorLicense.Activate_a_license_using_the_license_code
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

@using (Html.BeginForm("Activate", "DailyCollectorLicense", FormMethod.Post, new { enctype = "multipart/form-data",onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="mdi mdi-check-circle me-2 text-primary"></i>@GlobalShared.Activate_License</h5>
        </div>

        <div class="card-body">
            @* optional hidden id if your Activate action expects an Id *@
            @* @Html.HiddenFor(m => m.Id) *@

            <div class="mb-3">
                <label class="form-label fw-bold">@GlobalDailyCollectorLicense.Collector_User_Name</label>
                @Html.TextBoxFor(m => m.CollectorUserName, new
                {
                    @class = "form-control",
                    required = "required",
                    @readonly = "readonly",
                    style = "background-color:#f8f9fa;"
                })
                @Html.ValidationMessageFor(m => m.CollectorUserName, "", new { @class = "text-danger small" })
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalDailyCollectorLicense.Collector_User_ID </label>
                    @Html.TextBoxFor(m => m.CollectorUserId, new
                    {
                        @class = "form-control",
                        required = "required",
                        @readonly = "readonly",
                        style = "background-color:#f8f9fa;"
                    })
                    @Html.ValidationMessageFor(m => m.CollectorUserId, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalShared.License_Code </label>
                    @Html.TextBoxFor(m => m.LicenseCode, new
                    {
                        @class = "form-control",
                        required = "required",
                        @readonly = "readonly",
                        style = "background-color:#f8f9fa;"
                    })
                    @Html.ValidationMessageFor(m => m.LicenseCode, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
            <button type="submit" class="btn btn-success">
                <i class="mdi mdi-check-circle me-1"></i> @GlobalShared.Activate_License
            </button>
        </div>
    </div>
}
