@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.ActivateLicenseRequest

<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-check-circle me-2"></i>Activate License
        </h1>
        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            <strong>Info:</strong> Activate a license using the license code.
        </div>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<form method="post" action="@Url.Action("Activate", "DailyCollectorLicense")"
      onsubmit="return handleFormSubmit(this, 'License activated successfully!')">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="mdi mdi-check-circle me-2 text-primary"></i>Activate License</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Collector User ID *</label>
                    @Html.TextBoxFor(m => m.CollectorUserId, new
                    {
                        @class = "form-control",
                        placeholder = "Enter collector user ID...",
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.CollectorUserId, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">License Code *</label>
                    @Html.TextBoxFor(m => m.LicenseCode, new
                    {
                        @class = "form-control",
                        placeholder = "Enter license code...",
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.LicenseCode, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success">
                <i class="mdi mdi-check-circle me-1"></i> Activate License
            </button>
        </div>
    </div>
</form>