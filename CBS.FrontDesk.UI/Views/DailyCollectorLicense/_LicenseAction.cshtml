@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.LicenseActionRequest

@{
    var actionType = Model.ActionType?.ToLower() ?? "";
    var title = actionType switch
    {
        "revoke" => "Revoke License",
        "deactivate" => "Deactivate License",
        "reactivate" => "Reactivate License",
        "extend" => "Extend License",
        _ => "License Action"
    };

    var icon = actionType switch
    {
        "revoke" => "mdi-cancel",
        "deactivate" => "mdi-pause",
        "reactivate" => "mdi-play",
        "extend" => "mdi-calendar-range",
        _ => "mdi-cog"
    };

    var buttonClass = actionType switch
    {
        "revoke" => "btn-danger",
        "deactivate" => "btn-warning",
        "reactivate" => "btn-success",
        "extend" => "btn-info",
        _ => "btn-primary"
    };

    var buttonText = actionType switch
    {
        "revoke" => "Revoke License",
        "deactivate" => "Deactivate License",
        "reactivate" => "Reactivate License",
        "extend" => "Extend License",
        _ => "Perform Action"
    };
}

<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi @icon me-2"></i>@title
        </h1>

        @if (actionType == "revoke")
        {
            <div class="alert alert-danger">
                <i class="mdi mdi-alert-circle-outline me-2"></i>
                <strong>Warning:</strong> This action cannot be undone. The license will be immediately invalidated.
            </div>
        }
        else if (actionType == "deactivate")
        {
            <div class="alert alert-warning">
                <i class="mdi mdi-alert-outline me-2"></i>
                <strong>Note:</strong> This will temporarily deactivate the license. It can be reactivated later.
            </div>
        }
        else if (actionType == "extend")
        {
            <div class="alert alert-info">
                <i class="mdi mdi-information-outline me-2"></i>
                <strong>Info:</strong> Extend the license validity period.
            </div>
        }

        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<form method="post" action="@Url.Action("PerformAction", "DailyCollectorLicense")"
      id="licenseActionForm" onsubmit="return handleLicenseActionSubmit(this)">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.LicenseId)
    @Html.HiddenFor(m => m.ActionType)

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="mdi @icon me-2 text-primary"></i>@title</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                @if (actionType == "extend")
                {
                    <div class="col-12">
                        <label class="form-label fw-bold">New Expiry Date *</label>
                        <input type="datetime-local" asp-for="NewExpiryDate" class="form-control" required
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        @Html.ValidationMessageFor(m => m.NewExpiryDate, "", new { @class = "text-danger small" })
                    </div>
                }

                <div class="col-12">
                    <label class="form-label fw-bold">
                        @(actionType == "extend" ? "Extension Reason *" : "Reason *")
                    </label>
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = actionType switch
                        {
                            "revoke" => "Enter reason for revoking this license...",
                            "deactivate" => "Enter reason for deactivating this license...",
                            "reactivate" => "Enter reason for reactivating this license...",
                            "extend" => "Enter reason for extending this license...",
                            _ => "Enter reason for this action..."
                        },
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>

                @if (actionType != "extend")
                {
                    <div class="col-12">
                        <div class="alert alert-light border">
                            <small class="text-muted">
                                <i class="mdi mdi-information-outline me-1"></i>
                                @GetActionDescription(actionType)
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn @buttonClass">
                <i class="mdi @icon me-1"></i> @buttonText
            </button>
        </div>
    </div>
</form>

@functions {
    public string GetActionDescription(string actionType)
    {
        return actionType?.ToLower() switch
        {
            "revoke" => "Revoking a license permanently invalidates it and cannot be undone. The collector will no longer be able to use this license.",
            "deactivate" => "Deactivating a license temporarily disables it. The license can be reactivated later without generating a new one.",
            "reactivate" => "Reactivating a license restores a previously deactivated license to active status.",
            "extend" => "Extending a license increases its validity period. The new expiry date must be in the future.",
            _ => "Perform action on the selected license."
        };
    }
}

<script>
    function handleLicenseActionSubmit(form) {
        var $form = $(form);
        var $submitBtn = $form.find('button[type="submit"]');
        var originalText = $submitBtn.html();

        $submitBtn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i> Processing...');

        $.ajax({
            url: $form.attr('action'),
            type: 'POST',
            data: $form.serialize(),
            success: function (response) {
                if (response.success) {
                    var successMessage = getSuccessMessage('@actionType');
                    appalert(successMessage, 1, 1);

                    // Close modal
                    var modal = bootstrap.Modal.getInstance($form.closest('.modal')[0]);
                    if (modal) modal.hide();

                    // Reload datatable
                    if (typeof licenseTable !== 'undefined' && licenseTable) {
                        licenseTable.ajax.reload();
                    }
                } else {
                    appalert(response.message, 0, 1);
                }
            },
            error: function () {
                appalert('An error occurred while processing your request', 0, 1);
            },
            complete: function () {
                $submitBtn.prop('disabled', false).html(originalText);
            }
        });

        return false;
    }

    function getSuccessMessage(actionType) {
        switch (actionType) {
            case 'revoke': return 'License revoked successfully!';
            case 'deactivate': return 'License deactivated successfully!';
            case 'reactivate': return 'License reactivated successfully!';
            case 'extend': return 'License extended successfully!';
            default: return 'Action completed successfully!';
        }
    }
</script>
