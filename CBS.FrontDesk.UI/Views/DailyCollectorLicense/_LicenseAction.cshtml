@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.LicenseActionRequest
@using Resources
@{
    var actionType = (Model.ActionType ?? "").ToLowerInvariant();

    // classic switch for title
    string title;
    switch (actionType)
    {
        case "revoke": title = "Revoke License"; break;
        case "deactivate": title = "Deactivate License"; break;
        case "reactivate": title = "Reactivate License"; break;
        case "extend": title = "Extend License"; break;
        default: title = "License Action"; break;
    }

    // classic switch for icon
    string icon;
    switch (actionType)
    {
        case "revoke": icon = "mdi-cancel"; break;
        case "deactivate": icon = "mdi-pause"; break;
        case "reactivate": icon = "mdi-play"; break;
        case "extend": icon = "mdi-calendar-range"; break;
        default: icon = "mdi-cog"; break;
    }

    // classic switch for buttonClass
    string buttonClass;
    switch (actionType)
    {
        case "revoke": buttonClass = "btn-danger"; break;
        case "deactivate": buttonClass = "btn-warning"; break;
        case "reactivate": buttonClass = "btn-success"; break;
        case "extend": buttonClass = "btn-info"; break;
        default: buttonClass = "btn-primary"; break;
    }

    // classic switch for buttonText
    string buttonText;
    switch (actionType)
    {
        case "revoke": buttonText = "Revoke License"; break;
        case "deactivate": buttonText = "Deactivate License"; break;
        case "reactivate": buttonText = "Reactivate License"; break;
        case "extend": buttonText = "Extend License"; break;
        default: buttonText = "Perform Action"; break;
    }
}

<div class="card bg-light mb-2">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi @icon me-2"></i>@title
        </h1>

        @if (actionType == "revoke")
        {
            <div class="alert alert-danger">
                <i class="mdi mdi-alert-circle-outline me-2"></i>
                <strong>@GlobalShared.Warning:</strong> @GlobalDailyCollectorLicense.This_action_cannot_be_undone_The_license_will_be_immediately_invalidated
            </div>
        }
        else if (actionType == "deactivate")
        {
            <div class="alert alert-warning">
                <i class="mdi mdi-alert-outline me-2"></i>
                <strong>@GlobalShared.Note:</strong> @GlobalDailyCollectorLicense.This_will_temporarily_deactivate_the_license_It_can_be_reactivated_later
            </div>
        }
        else if (actionType == "extend")
        {
            <div class="alert alert-info">
                <i class="mdi mdi-information-outline me-2"></i>
                <strong>@GlobalShared.Info:</strong> @GlobalDailyCollectorLicense.Extend_the_license_validity_period
            </div>
        }

        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

@using (Html.BeginForm("PerformAction", "DailyCollectorLicense", FormMethod.Post, new { id = "licenseActionForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{

    @Html.HiddenFor(m => m.LicenseId)
    @Html.HiddenFor(m => m.ActionType)

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="mdi @icon me-2 text-primary"></i>@title</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">@GlobalDailyCollectorLicense.Collector_User_Name</label>
                @Html.TextBoxFor(m => m.CollectorUserName, new
                {
                    @class = "form-control",
                    required = "required",
                    @readonly = "readonly",
                    style = "background-color:#f8f9fa;"
                })
                @Html.ValidationMessageFor(m => m.CollectorUserName, "", new { @class = "text-danger small" })
            </div>
            <div class="row g-3">
                @if (actionType == "extend")
                {
                    <div class="col-12">
                        <label class="form-label fw-bold">@GlobalShared.New_Expiry_Date *</label>
                        <input type="datetime-local" name="NewExpiryDate" class="form-control" required
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        @Html.ValidationMessageFor(m => m.NewExpiryDate, "", new { @class = "text-danger small" })
                    </div>
                }

                <div class="col-12">
                    <label class="form-label fw-bold">
                        @(actionType == "extend" ? "Extension Reason *" : "Reason *")
                    </label>
                    @Html.TextAreaFor(m => m.Reason, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = (actionType == "revoke" ? "Enter reason for revoking this license..." :
                                       actionType == "deactivate" ? "Enter reason for deactivating this license..." :
                                       actionType == "reactivate" ? "Enter reason for reactivating this license..." :
                                       actionType == "extend" ? "Enter reason for extending this license..." :
                                       "Enter reason for this action..."),
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                </div>

                @if (actionType != "extend")
                {
                    <div class="col-12">
                        <div class="alert alert-light border">
                            <small class="text-muted">
                                <i class="mdi mdi-information-outline me-1"></i>
                                @GetActionDescription(actionType)
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer bg-transparent d-flex justify-content-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
            <button type="submit" class="btn @buttonClass">
                <i class="mdi @icon me-1"></i> @buttonText
            </button>
        </div>
    </div>
}

@functions {
    public string GetActionDescription(string actionType)
    {
        if (string.IsNullOrEmpty(actionType)) return "Perform action on the selected license.";

        switch (actionType.ToLowerInvariant())
        {
            case "revoke":
                return "Revoking a license permanently invalidates it and cannot be undone. The collector will no longer be able to use this license.";
            case "deactivate":
                return "Deactivating a license temporarily disables it. The license can be reactivated later without generating a new one.";
            case "reactivate":
                return "Reactivating a license restores a previously deactivated license to active status.";
            case "extend":
                return "Extending a license increases its validity period. The new expiry date must be in the future.";
            default:
                return "Perform action on the selected license.";
        }
    }
}


