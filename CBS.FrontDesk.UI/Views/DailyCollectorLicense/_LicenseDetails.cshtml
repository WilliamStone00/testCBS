@model CBS.FrontDesk.Data.Entity.Accounting_V2.DaillyCollectorLicense.DailyCollectorLicense
@using Resources

<fieldset class="fieldset-custom">
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-certificate-outline me-2"></i> License Details
            </h1>
            <p class="card-text text-muted mb-1">
                here we have the details for a collector's license being mapped to a device
            </p>
        </div>
    </div>

    <!-- Details Card (tables) -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <!-- Left Column: Basic Information -->
                <div class="col-md-6">
                    <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> Basic Information</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr><td class="fw-bold">License ID</td><td>@Model.Id</td></tr>
                        <tr>
                            <td class="fw-bold">License Code</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="font-monospace me-2 mb-0">@Model.LicenseCode</div>
                                    <button class="btn btn-outline-secondary btn-sm" type="button"
                                            onclick="copyToClipboard('@Model.LicenseCode')">
                                        <i class="mdi mdi-content-copy"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr><td class="fw-bold">Collector User</td><td>@Model.CollectorUserName</td></tr>
                        <tr><td class="fw-bold">Collector Code</td><td>@Model.CollectorCode</td></tr>
                        <tr><td class="fw-bold">Branch</td><td>@(Model.BranchId ?? "-")</td></tr>
                        <tr>
                            <td class="fw-bold">Status</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Right Column: License Settings -->
                <div class="col-md-6">
                    <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> License Settings</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr>
                            <td class="fw-bold">Start Date</td>
                            <td>@Model.StartDate.ToString()</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Expiry Date</td>
                            <td>
                                <span class="@(Model.ExpiryDate < DateTime.Now ? "text-danger" : "text-success")">
                                    @Model.ExpiryDate.ToString()
                                </span>
                            </td>
                        </tr>
                        <tr><td class="fw-bold">Bound Device</td><td>@(string.IsNullOrEmpty(Model.BoundDeviceId) ? "Not Bound" : Model.BoundDeviceId)</td></tr>
                        <tr><td class="fw-bold">Devices Activated</td><td>@Model.DevicesActivatedCount / @Model.MaxDevicesAllowed</td></tr>
                        <tr>
                            <td class="fw-bold">Licensed</td>
                            <td>
                                @(Model.IsLicensed
                                    ? (Html.Raw("<span class=\"badge bg-success\">Yes</span>"))
                                    : (Html.Raw("<span class=\"badge bg-secondary\">No</span>")))
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Revoked</td>
                            <td>
                                @(Model.IsRevoked
                                    ? (Html.Raw("<span class=\"badge bg-danger\">Yes</span>"))
                                    : (Html.Raw("<span class=\"badge bg-success\">No</span>")))
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Message / Notes Section -->
            <div class="row mt-3">
                <div class="col-12">
                    <h6 class="text-primary"><i class="mdi mdi-note-outline me-2"></i> Message</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr>
                            <td class="fw-bold">Message</td>
                            <td>@(Model.Message ?? "No Message")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Timeline Section -->
            <div class="row mt-3">
                <div class="col-12">
                    <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> Timeline</h6>
                    <table class="table table-sm table-bordered mb-0">
                        <tr><td class="fw-bold">Created Date</td><td>@Model.StartDate.ToString()</td></tr>
                        <tr><td class="fw-bold">Created By</td><td>@Model.CollectorUserName</td></tr>
                        <tr><td class="fw-bold">Modified Date</td><td>@Model.ExpiryDate.ToString()</td></tr>
                        <tr><td class="fw-bold">Modified By</td><td>@Model.CollectorUserName</td></tr>
                    </table>
                </div>
            </div>
        </div> <!-- card-body -->
    </div> <!-- card -->

    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">
            <i class="mdi mdi-close me-1"></i> Cancel
        </button>
    </div>

</fieldset>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            if (!text) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    console.log('Copied: ' + text);
                }).catch(function () {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }

            function fallbackCopy(t) {
                var el = document.createElement('textarea');
                el.value = t;
                el.style.position = 'fixed';
                el.style.left = '-9999px';
                document.body.appendChild(el);
                el.select();
                try { document.execCommand('copy'); } catch (e) { console.warn(e); }
                document.body.removeChild(el);
            }
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status))
        {
            return "bg-info";
        }

        switch (status.ToLower())
        {
            case "active":
                return "bg-success";
            case "inactive":
                return "bg-warning";
            case "revoked":
                return "bg-danger";
            case "expired":
                return "bg-secondary";
            default:
                return "bg-info";
        }
    }
}
