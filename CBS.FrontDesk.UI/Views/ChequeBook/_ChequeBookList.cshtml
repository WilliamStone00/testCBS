@model IEnumerable<CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeBookListing.ChequeBook>

<table id="chequeBookTable" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Account Number</th>
            <th>Branch</th>
            <th>Leaves</th>
            <th>Status</th>
            <th>Issue Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerName</td>
                <td>@item.AccountNumber</td>
                <td>@item.BranchName</td>
                <td>@item.NumberOfLeaves</td>
                <td>
                    @{
                        var badgeClass = "bg-secondary";
                        switch (item.Status)
                        {
                            case "Active": badgeClass = "bg-success"; break;
                            case "Used": badgeClass = "bg-primary"; break;
                            case "Cancelled": badgeClass = "bg-danger"; break;
                            case "Blocked": badgeClass = "bg-warning"; break;
                        }
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>@item.IssueDate</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-info" onclick="showChequeBookDetails('@item.Id')" title="View Details">
                            <i class="mdi mdi-eye"></i>
                        </button>
                        <button class="btn btn-danger" onclick="showCancelForm('@item.Id')" title="Cancel Cheque Book">
                            <i class="mdi mdi-cancel"></i>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
