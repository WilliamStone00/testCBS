
@using Resources
@{
    ViewBag.Title = "Cheque Book Overview";
    var actionType = ViewBag.ActionType ?? "admin";
}

<!-- =================================================
     PAGE HEADER
================================================== -->
<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-book-open-page-variant-outline me-2"></i> CheckBook Overview
        </h1>
        <p class="card-text text-muted mb-1">
            Manage all checkbooks and requests here.
        </p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            <strong>Process:</strong> Start by searching for a customer account. The CheckBook request form will appear automatically after a successful search.
        </div>
        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
    </div>
</div>

<!-- =================================================
     TIPS SECTION (Expanded by default)
================================================== -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalUserManagement.TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-primary rounded-circle p-2 me-3">1</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="text-primary mb-1">Customer Search & Selection</h6>
                            <p class="text-muted mb-0 small">
                                Use the search box to find customers by account number or ID. The system will automatically display the CheckBook request form with customer details.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-success rounded-circle p-2 me-3">2</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="text-success mb-1">CheckBook Request Creation</h6>
                            <p class="text-muted mb-0 small">
                                Once a customer is selected, fill in the CheckBook request form. Choose the correct category, number of leaves, and account for fee payment.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-warning rounded-circle p-2 me-3">3</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="text-warning mb-1">Status & Actions</h6>
                            <p class="text-muted mb-0 small">
                                View all CheckBook requests in the "All Requests" tab. Actions like Approve, Reject, Review, Mark as Delivered, Block/Unblock, or Mark as Lost are available depending on the current status.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <span class="badge bg-info rounded-circle p-2 me-3">4</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="text-info mb-1">Notifications & Renewal</h6>
                            <p class="text-muted mb-0 small">
                                Configure notification preferences for customers and enable automatic renewal for recurring CheckBook requests.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Guide -->
            <div class="mt-4 pt-3 border-top">
                <h6 class="text-primary mb-3">
                    <i class="mdi mdi-progress-clock me-2"></i> Understanding CheckBook Statuses
                </h6>
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-warning text-dark me-2">Pending</span>
                        <small class="text-muted">New request awaiting review</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-secondary me-2">Review</span>
                        <small class="text-muted">Under additional verification</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-success me-2">Approved</span>
                        <small class="text-muted">Ready for printing/delivery</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-danger me-2">Rejected</span>
                        <small class="text-muted">Request declined</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-info me-2">Delivered</span>
                        <small class="text-muted">CheckBook handed over to customer</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-dark text-white me-2">Blocked</span>
                        <small class="text-muted">CheckBook blocked for security reasons</small>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="badge bg-danger me-2">Lost</span>
                        <small class="text-muted">CheckBook reported lost</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Cheque Book Filters</h5>

    <form id="chequeFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            @* Toggle switches for optional filter groups *@
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch" onclick="document.getElementById('branchFilter').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleBranch">Show Branch Filter</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDates" onclick="document.getElementById('dateFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleDates">Show Date Filters</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleFlags" onclick="document.getElementById('flagFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleFlags">Show Status Flags</label>
                    </div>
                </div>
            </div>

            @*Default Filters (always visible)*@
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Customer Account / ID</label>
                    <input type="text" id="customerId" name="CustomerId" class="form-control" placeholder="Customer account or ID" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Customer Name</label>
                    <input type="text" id="customerName" name="CustomerName" class="form-control" placeholder="Customer name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Category</label>
                    <select id="category" name="Category" class="form-select">
                        <option value="">All</option>
                        <option value="Personal">Personal</option>
                        <option value="Corporate">Corporate</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            @*Branch Filter (togglable)*@
            <div id="branchFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", @id = "branchId", @name = "BranchId" })
                    </div>
                </div>
            </div>

            @*Flags (togglable)*@
            <div id="flagFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Status</label>
                        <select id="status" name="Status" class="form-select">
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Closed">Closed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Used">Used</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Number Of Leaves</label>
                        <input type="number" id="numberOfLeaves" name="NumberOfLeaves" class="form-control" min="0" placeholder="e.g. 25" />
                    </div>

                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check me-3">
                            <input class="form-check-input" type="checkbox" value="true" id="isLost" name="IsLost" />
                            <label class="form-check-label fw-bold" for="isLost">Is Lost</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="true" id="isBlocked" name="IsBlocked" />
                            <label class="form-check-label fw-bold" for="isBlocked">Is Blocked</label>
                        </div>
                    </div>
                </div>
            </div>

            @*Date Filters (togglable)*@
            <div id="dateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date (Created/Lost From)</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date (Created/Lost To)</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>

                <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>

                <button id="exportBtn" type="button" class="btn btn-success me-2 w-100">
                    <i class="mdi mdi-file-export"></i> Export
                </button>

                <button id="printbtn" type="button" class="btn btn-info w-100">
                    <i class="mdi mdi-printer"></i> Print
                </button>
            </div>
        </div>
    </form>
</div>

@*DataTable Partial*@
<div id="datalistingview">
    @Html.Partial("_CheckBookData")
</div>

@*Details Modal*@
<div class="modal fade" id="chequeDetailsModal" tabindex="-1" aria-labelledby="chequeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="chequeDetailsModalLabel">
                    <i class="mdi mdi-file-document-outline me-2"></i>Cheque Book Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading details...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i>Close
                </button>
                <button type="button" class="btn btn-primary btn-print-details">
                    <i class="mdi mdi-printer me-1"></i>Print
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
        (function ($) {
        // single config object (use server value)
        var chequeViewConfig = {
            actionType: '@actionType' || 'admin' // admin, teller, view-only, edit, minimal
        };

        // Global variables
        var chequeTable = null;
        var currentChequeId = null;
        var currentChequeName = null;

        // =============== UTILITY FUNCTIONS ===============
        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        function escapeHtml(str) {
            if (!str && str !== 0) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // =============== FILTER FUNCTIONS ===============
        function collectChequeExportParams() {
            var isLostEl = $('#isLost')[0];
            var isBlockedEl = $('#isBlocked')[0];

            var val = $('#numberOfLeaves').val();
            var numberOfLeaves = val ? Number(val) : 0;

            var ret = {
                CustomerId: emptyToNull($('#customerId').val()),
                CustomerName: emptyToNull($('#customerName').val()),
                BranchId: emptyToNull($('#branchId').val()),
                Category: emptyToNull($('#category').val()),
                Status: emptyToNull($('#status').val()),
                NumberOfLeaves: numberOfLeaves,
                IsLost: isLostEl ? isLostEl.checked : false,
                IsBlocked: isBlockedEl ? isBlockedEl.checked : false,
                StartDate: emptyToNull($('#startDate').val()),
                EndDate: emptyToNull($('#endDate').val()),
                options: {}
            };
            return ret;
        }

        function formatIsPrintedBadge(value, type) {
            var raw = value;
            var label = (raw === null || raw === undefined) ? '' : String(raw);

            var badgeClass = 'bg-secondary';
            var low = label.toLowerCase();
            if (low === 'true' || low === 'yes' || low === '1') {
                badgeClass = 'bg-success';
            } else if (low === 'false' || low === 'no' || low === '0') {
                badgeClass = 'bg-danger';
            } else if (low === 'blocked') {
                badgeClass = 'bg-dark';
            }

            var esc = label
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');

            if (type === 'display' || type === 'filter') {
                return '<span class="badge ' + badgeClass + '">' + esc + '</span>';
            }

            return label;
        }

        // =============== ACTION HANDLER FUNCTIONS ===============
        function handleChequeView(id, name) {
            currentChequeId = id;
            currentChequeName = name;

            // open new window (shared view handled server-side)
            var url = '/ChequeBook/GetChequeBookDetails?id=' + encodeURIComponent(id);
            window.open(url, '_blank');
        }

        function handleChequeEdit(id, name) {
            enterEditMode();
            // load edit partial with your existing helper
            AddORUpdateGen(id, 'datalistingview', '_EditChequeBook', 'get', 'Cheque');
        }

        function handleChequeDelete(id, name) {
            if (confirm('Are you sure you want to delete cheque book "' + name + '"?')) {
                DeleteRecordDataTable('Cheque', id, 'myDataTable', '_CheckBookData', 0, 'datalistingview', null, 'list');
            }
        }

        function handleChequePrint(id, name) {
            window.open('/ChequeBook/Print?key=' + encodeURIComponent(id), '_blank');
        }

        function handleChequeBlock(id, name) {
            if (!confirm('Are you sure you want to block cheque book "' + name + '"?')) return;
            $.ajax({
                url: '/ChequeBook/Block/' + encodeURIComponent(id),
                type: 'POST'
            }).done(function(response) {
                appalert('Cheque book blocked successfully', 1, 1);
                if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                    chequeTable.ajax.reload();
                }
            }).fail(function() {
                appalert('Failed to block cheque book', 0, 1);
            });
        }

        function handleChequeUnblock(id, name) {
            if (!confirm('Are you sure you want to unblock cheque book "' + name + '"?')) return;
            $.ajax({
                url: '/ChequeBook/Unblock/' + encodeURIComponent(id),
                type: 'POST'
            }).done(function(response) {
                appalert('Cheque book unblocked successfully', 1, 1);
                if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                    chequeTable.ajax.reload();
                }
            }).fail(function() {
                appalert('Failed to unblock cheque book', 0, 1);
            });
        }

        function handleChequeMarkLost(id, name) {
            if (!confirm('Are you sure you want to mark cheque book "' + name + '" as lost?')) return;
            $.ajax({
                url: '/ChequeBook/MarkAsLost/' + encodeURIComponent(id),
                type: 'POST'
            }).done(function(response) {
                appalert('Cheque book marked as lost successfully', 1, 1);
                if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                    chequeTable.ajax.reload();
                }
            }).fail(function() {
                appalert('Failed to mark cheque book as lost', 0, 1);
            });
        }

        // =============== ACTION BUTTON GENERATOR ===============
        function getActionsHtml(id, rowData) {
            var viewFor = (chequeViewConfig.actionType || 'admin').toLowerCase();
            var safeId = encodeURIComponent(id);
            var name = escapeHtml(rowData.customerName || rowData.CustomerName || '');
            var isLost = (rowData.isLost === true || rowData.isLost === 'true' || rowData.IsLost === true);
            var isBlocked = (rowData.isBlocked === true || rowData.isBlocked === 'true' || rowData.IsBlocked === true);
            var status = rowData.status || rowData.Status || '';
            var isPrinted = (rowData.isPrinted === true || rowData.isPrinted === 'true' || rowData.IsPrinted === true);

            var safeDomId = String(id).replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
            var btnId = 'chequeDropdown_' + safeDomId;

            var detailsBtn = '<button type="button" class="dropdown-item btn-cheque-view" data-id="' + safeId + '" data-name="' + name + '">' +
                '<i class="mdi mdi-eye me-1 text-primary"></i> View Details</button>';

            var editBtn = '';
            if ((status === 'Active' || status === 'Pending') && !isLost) {
                editBtn = '<button type="button" class="dropdown-item btn-cheque-edit" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-pencil-outline me-1 text-success"></i> Edit</button>';
            }

            var printBtn = '';
            if (!isLost && !isBlocked && (status === 'Active' || status === 'Pending') && !isPrinted) {
                printBtn = '<button type="button" class="dropdown-item btn-cheque-print" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-printer me-1 text-info"></i> Print Report</button>';
            }

            var blockBtn = '';
            if (!isBlocked && !isLost && (status === 'Active' || status === 'Pending')) {
                blockBtn = '<button type="button" class="dropdown-item btn-cheque-block" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-block-helper me-1 text-warning"></i> Block</button>';
            }

            var unblockBtn = '';
            if (isBlocked && !isLost) {
                unblockBtn = '<button type="button" class="dropdown-item btn-cheque-unblock" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-lock-open me-1 text-success"></i> Unblock</button>';
            }

            var markLostBtn = '';
            if (!isLost && (status === 'Active' || status === 'Pending')) {
                markLostBtn = '<button type="button" class="dropdown-item btn-cheque-mark-lost" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-alert-circle me-1 text-danger"></i> Mark as Lost</button>';
            }

            var deleteBtn = '';
            if (status === 'Closed' || status === 'Cancelled' || isLost) {
                deleteBtn = '<button type="button" class="dropdown-item btn-cheque-delete text-danger" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-delete-outline me-1 text-danger"></i> Delete</button>';
            }

            var buttons = [];
            switch(viewFor) {
                case 'admin':
                    buttons.push(detailsBtn);
                    if (editBtn) buttons.push(editBtn);
                    if (printBtn) buttons.push(printBtn);
                    if (blockBtn) buttons.push(blockBtn);
                    if (unblockBtn) buttons.push(unblockBtn);
                    if (markLostBtn) buttons.push(markLostBtn);
                    if (deleteBtn) buttons.push(deleteBtn);
                    break;
                case 'teller':
                    buttons.push(detailsBtn);
                    if (printBtn) buttons.push(printBtn);
                    if (blockBtn) buttons.push(blockBtn);
                    if (unblockBtn) buttons.push(unblockBtn);
                    if (markLostBtn) buttons.push(markLostBtn);
                    break;
                case 'view-only':
                    buttons.push(detailsBtn);
                    if (printBtn) buttons.push(printBtn);
                    break;
                case 'minimal':
                    return '<button type="button" class="btn btn-sm btn-outline-primary btn-cheque-view" data-id="' + safeId + '" data-name="' + name + '">' +
                        '<i class="mdi mdi-file-document-outline"></i> View</button>';
                default:
                    buttons.push(detailsBtn);
                    if (editBtn) buttons.push(editBtn);
                    if (deleteBtn) buttons.push(deleteBtn);
                    break;
            }

            var filteredButtons = $.grep(buttons, function(b) { return $.trim(b) !== ''; });

            if (filteredButtons.length <= 1) {
                return '<button type="button" class="btn btn-sm btn-outline-primary btn-cheque-view" data-id="' + safeId + '" data-name="' + name + '">' +
                    '<i class="mdi mdi-file-document-outline"></i> View</button>';
            }

            return '<div class="dropdown">' +
                '<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="' + btnId + '" data-bs-toggle="dropdown" aria-expanded="false">' +
                '<i class="mdi mdi-cog-outline"></i> Actions</button>' +
                '<ul class="dropdown-menu" aria-labelledby="' + btnId + '">' +
                $.map(filteredButtons, function(btn) { return '<li>' + btn + '</li>'; }).join('') +
                '</ul></div>';
        }

        // =============== EDIT MODE FUNCTIONS ===============
        function enterEditMode() {
            $('#chequeFilterForm').closest('.card').addClass('d-none');

            if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                chequeTable.destroy(true);
                chequeTable = null;
            }

            $('body').addClass('edit-mode');
        }

        function exitEditMode() {
            $('#chequeFilterForm').closest('.card').removeClass('d-none');
            $('body').removeClass('edit-mode');

            AddORUpdateGen(null, 'datalistingview', '_CheckBookData', 'get', 'ChequeBook');

            setTimeout(function() {
                try {
                    if (typeof loadChequeData === 'function') {
                        loadChequeData();
                    }
                } catch (e) {
                    console.error('Failed to init datatable after exiting edit mode', e);
                }
            }, 300);
        }

        // =============== DATATABLE FUNCTIONS ===============
        function loadChequeData() {
            if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                chequeTable.ajax.reload();
                return;
            }

            chequeTable = $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                searching: false,
                responsive: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/ChequeBook/GetChequeBooks',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        var filters = collectChequeExportParams();
                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (xhr, error, thrown) {
                        console.error('AJAX Error:', error, thrown);
                        appalert('Failed to load data. Please try again.', 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        name: 'CreatedDate',
                        render: function (data) {
                            return data && window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : (data || '');
                        }
                    },
                    {
                        data: 'CustomerName',
                        name: 'MemberName',
                        render: function(data) {
                            return escapeHtml(data || '');
                        }
                    },
                    {
                        data: 'CategoryName',
                        name: 'Category',
                        render: function(data) {
                            var label = data || '';
                            var badgeClass = 'bg-secondary';
                            if (label === 'Personal') badgeClass = 'bg-info';
                            else if (label === 'Corporate') badgeClass = 'bg-primary';
                            else if (label === 'Other') badgeClass = 'bg-dark';
                            return '<span class="badge ' + badgeClass + '">' + escapeHtml(label) + '</span>';
                        }
                    },
                    {
                        data: 'Status',
                        name: 'Status',
                        render: function (data) {
                            var label = data || '';
                            var badgeClass = 'bg-secondary';
                            if (label === 'Active') badgeClass = 'bg-success';
                            else if (label === 'Pending') badgeClass = 'bg-warning text-dark';
                            else if (label === 'Used') badgeClass = 'bg-info';
                            else if (label === 'Cancelled') badgeClass = 'bg-danger';
                            else if (label === 'Blocked') badgeClass = 'bg-dark';
                            else if (label === 'Lost') badgeClass = 'bg-danger';
                            return '<span class="badge ' + badgeClass + '">' + escapeHtml(label) + '</span>';
                        }
                    },
                    {
                        data: 'NumberOfLeaves',
                        name: 'Num. Of Leaves',
                        render: function (data) { return data || '0'; }
                    },
                    {
                        data: 'CustomerId',
                        name: 'Member Ref.',
                        render: function(data) { return escapeHtml(data || ''); }
                    },
                    {
                        data: 'IsPrinted',
                        name: 'IsPrinted',
                        render: function (data, type, row, meta) { return formatIsPrintedBadge(data, type); }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) { return getActionsHtml(data, row); }
                    }
                ],
                language: {
                    emptyTable: 'No cheque books found',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    lengthMenu: 'Show _MENU_ entries',
                    loadingRecords: 'Loading...',
                    processing: 'Processing...',
                    search: 'Search:',
                    zeroRecords: 'No matching records found'
                },
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                initComplete: function() {
                    try {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                            $('[data-bs-toggle=\"tooltip\"]').each(function() {
                                new bootstrap.Tooltip(this);
                            });
                        }
                    } catch (e) { /* ignore */ }
                }
            });
        }

        // =============== EXPORT FUNCTION ===============
        function exportChequeData() {
            var filters = collectChequeExportParams();
            var params = $.param($.extend({}, filters, {}), true);
            // Build query manually to avoid serializing options object
            var queryParts = [];
            for (var k in filters) {
                if (!filters.hasOwnProperty(k) || k === 'options') continue;
                if (filters[k] !== null && filters[k] !== undefined) {
                    queryParts.push(encodeURIComponent(k) + '=' + encodeURIComponent(filters[k]));
                }
            }
            var query = queryParts.join('&');
            window.location.href = '/Cheque/DownloadChequeBooks?' + query;
        }

        // =============== RESET FILTERS ===============
        function resetChequeFilters() {
            $('#chequeFilterForm')[0].reset();

            if ($.fn.select2 && $('#branchId').hasClass('select2-hidden-accessible')) {
                $('#branchId').val(null).trigger('change');
            }

            $('#branchFilter, #dateFilters, #flagFilters').addClass('d-none');
            $('#toggleBranch, #toggleDates, #toggleFlags').prop('checked', false);
            $('#isLost').prop('checked', false);
            $('#isBlocked').prop('checked', false);

            if (chequeTable && $.fn.dataTable.isDataTable('#myDataTable')) {
                chequeTable.ajax.reload();
            }

            appalert('Filters reset successfully', 1, 1);
            }

