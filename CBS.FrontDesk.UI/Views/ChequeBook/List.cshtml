@* Cheque Book Filters - minimal fields to match ChequeBookQuery *@
@using Resources
@{
    ViewBag.Title = "Cheque Book Overview"; // or @GlobalCheque.Whatever
}

<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Cheque Book Filters</h5>

    <form id="chequeFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">
            <!-- Toggle switches for optional filter groups -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch" onclick="document.getElementById('branchFilter').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleBranch">Show Branch Filter</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDates" onclick="document.getElementById('dateFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleDates">Show Date Filters</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleFlags" onclick="document.getElementById('flagFilters').classList.toggle('d-none')">
                        <label class="form-check-label fw-bold" for="toggleFlags">Show Status Flags</label>
                    </div>
                </div>
            </div>

            <!-- Default Filters (always visible) -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Customer Account / ID</label>
                    <input type="text" id="customerId" name="CustomerId" class="form-control" placeholder="Customer account or ID" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Customer Name</label>
                    <input type="text" id="customerName" name="CustomerName" class="form-control" placeholder="Customer name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Category</label>
                    <select id="category" name="Category" class="form-select">
                        <option value="">All</option>
                        <option value="Personal">Personal</option>
                        <option value="Corporate">Corporate</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <!-- Branch Filter (togglable) -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @* Replace ViewBag.Branches with your actual branches collection *@
                        @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", @id = "branchId", @name = "BranchId" })
                    </div>
                </div>
            </div>

            <!-- Flags (togglable) -->
            <div id="flagFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Status</label>
                        <select id="status" name="Status" class="form-select">
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Closed">Closed</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Number Of Leaves</label>
                        <input type="number" id="numberOfLeaves" name="NumberOfLeaves" class="form-control" min="0" placeholder="e.g. 25" />
                    </div>

                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check me-3">
                            <input class="form-check-input" type="checkbox" value="true" id="isLost" name="IsLost" />
                            <label class="form-check-label fw-bold" for="isLost">Is Lost</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="true" id="isBlocked" name="IsBlocked" />
                            <label class="form-check-label fw-bold" for="isBlocked">Is Blocked</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date Filters (togglable) -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date (Created/Lost From)</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date (Created/Lost To)</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filter
                </button>

                <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_CheckBookData")
</div>



@section Scripts {
    <script>
        var chequeTable = null;

        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        function collectChequeExportParams() {
            const isLostEl = document.getElementById('isLost');
            const isBlockedEl = document.getElementById('isBlocked');

            const ret= {
                CustomerId: emptyToNull($('#customerId').val()),
                CustomerName: emptyToNull($('#customerName').val()),
                BranchId: emptyToNull($('#branchId').val()),
                Category: emptyToNull($('#category').val()),
                Status: emptyToNull($('#status').val()),
                NumberOfLeaves: (function () {
                    const val = $('#numberOfLeaves').val();
                    return val ? Number(val) : 0;
                })(),
                IsLost: isLostEl ? isLostEl.checked : false,
                IsBlocked: isBlockedEl ? isBlockedEl.checked : false,
                StartDate: emptyToNull($('#startDate').val()),
                EndDate: emptyToNull($('#endDate').val()),
                options: {}
            };
            console.log("Request : "+ret);
            return ret;
        }

        function loadChequeData() {
            chequeTable = $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                searching: false,
                responsive: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/ChequeBook/LoadChequeBooksData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectChequeExportParams();

                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    },
                    error: function () {
                        alert('Failed to load data. Please try again.');
                    }
                },
                columns: [
                    {
                        data: 'createdDate',
                        name: 'CreatedDate',
                        render: function (data) {
                            return data && window.moment
                                ? moment(data).format('DD/MM/YYYY HH:mm:ss')
                                : (data || '');
                        }
                    },
                    { data: 'customerName', name: 'MemberName' },
                    {
                        data: 'CategoryName',  // Changed from 'Category' to 'CategoryName'
                        name: 'Category'   // Changed from 'Category' to 'CategoryName'
                    },
                    { data: 'numberOfLeaves', name: 'Num. Of Leaves' },
                    {
                        data: 'status',
                        name: 'Status',
                        render: function (data) {
                            const label = data || '';
                            let badgeClass = 'bg-secondary';

                            if (label === 'Active') {
                                badgeClass = 'bg-success';
                            } else if (label === 'Pending') {
                                badgeClass = 'bg-warning text-dark';
                            } else if (label === 'Used') {
                                badgeClass = 'bg-info';
                            } else if (label === 'Cancelled') {
                                badgeClass = 'bg-danger';
                            } else if (label === 'Blocked') {
                                badgeClass = 'bg-dark';
                            }

                            return `<span class="badge ${badgeClass}">${label}</span>`;
                        }
                    },
                    
                    { data: 'customerId', name: 'Member Ref.' },
                    {

                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (id) {
                            return `<a href="/Cheque/Details?key=${id}" class="btn btn-sm btn-outline-primary">
                                        <i class="mdi mdi-file-document-outline"></i> View
                                    </a>`;
                        }
                    }
                ],
                language: {
                    emptyTable: 'No cheque books found'
                }
            });
        }

        function exportChequeData() {
            const filters = collectChequeExportParams();
            const params = new URLSearchParams(filters).toString();
            window.location.href = `/Cheque/DownloadChequeBooks?${params}`;
        }

        function resetChequeFilters() {
            $('#chequeFilterForm').trigger('reset');

            if ($.fn.select2 && $('#branchId').hasClass('select2-hidden-accessible')) {
                $('#branchId').val(null).trigger('change');
            }

            $('#branchFilter, #dateFilters, #flagFilters').addClass('d-none');
            $('#isLost').prop('checked', false);
            $('#isBlocked').prop('checked', false);

          //  loadChequeData();
        }

        $(document).ready(function () {
            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                loadChequeData();
            });

            $('#resetFilterBtn').on('click', function (e) {
                e.preventDefault();
                resetChequeFilters();
            });

            $('#exportBtn').on('click', function (e) {
                e.preventDefault();
                exportChequeData();
            });

            if ($.fn.select2) {
                try {
                    $('#branchId').select2({
                        width: '100%',
                        placeholder: 'Select Branch'
                    });
                } catch (err) {
                    console.warn('select2 init failed', err);
                }
            }

           // loadChequeData();

            $('#chequeFilterForm input').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadChequeData();
                }
            });
        });
    </script>
}

