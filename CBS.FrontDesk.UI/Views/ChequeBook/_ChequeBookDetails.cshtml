<!-- Leaves Table -->
<div class="leaves-table-container">
    <div class="info-card">
        <h5 class="text-primary d-flex justify-content-between align-items-center">
            <span>
                <i class="mdi mdi-file-tree me-2"></i>Cheque Leaves (@(Model?.Leaves?.Count ?? 0) leaves)              
            </span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#table" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>

        </h5>
        <div id="table">
        <div class="mb-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="mdi mdi-magnify"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by serial number, status...">
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <button type="button" class="btn print-btn" onclick="printChequeDetails()">
                        <i class="mdi mdi-printer me-1"></i> Print
                    </button>
                    <button type="button" class="btn btn-bg-success me-2" id="exportBtn">
                        <i class="mdi mdi-file-export me-1"></i> Export
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="refreshBtn">
                        <i class="mdi mdi-refresh me-1"></i> Refresh
                    </button>
                </div>
            </div>
        </div>

        <table id="myDataTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Serial Number</th>
                    <th>Leaf ID</th>
                    <th>Status</th>
                    <th>Issued To</th>
                    <th>Cleared Date</th>
                    @*<th>Created Date</th>*@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="leavesTableBody">
                @if (Model?.Leaves != null)
                {
                    foreach (var leaf in Model.Leaves)
                    {
                        <tr>
                            <td>@leaf.SerialNumber</td>
                            <td>@leaf.Id</td>
                            <td>
                                <span class="leaf-status @GetLeafStatusClass(leaf.Status)">
                                    @leaf.Status
                                </span>
                            </td>
                            <td>@FormatDate(leaf.IssuedDate)</td>
                            <td>@(string.IsNullOrEmpty(leaf.IssuedTo) ? "N/A" : leaf.IssuedTo)</td>
                            <td>@FormatDate(leaf.ClearedDate)</td>
                            <td>@(string.IsNullOrEmpty(leaf.TransactionId) ? "N/A" : leaf.TransactionId)</td>
                            <td>@FormatDate(leaf.CreatedDate)</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary btn-leaf-details"
                                        data-id="@leaf.Id">
                                    <i class="mdi mdi-eye me-1"></i> Details
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="dataTables_info" id="myDataTable_info" role="status" aria-live="polite">
                    @if (Model?.Leaves != null)
                    {
                        <span>Showing 1 to @Model.Leaves.Count of @Model.Leaves.Count entries</span>
                    }
                    else
                    {
                        <span>Showing 0 to 0 of 0 entries</span>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="dataTables_paginate paging_simple_numbers" id="myDataTable_paginate">
                    <ul class="pagination justify-content-end" id="paginationContainer">
                        @if (Model?.Leaves?.Count > 10)
                        {
                            <!-- Pagination will be generated by JavaScript for better UX -->
                        }
                    </ul>
                </div>
            </div>
        </div>
            </div>
           
    </div>
</div>


<!-- Leaf Details Modal -->
<div class="modal fade" id="leafDetailsModal" tabindex="-1" aria-labelledby="leafDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="leafDetailsModalLabel">
                    <i class="mdi mdi-file-document-outline me-2"></i>Cheque Leaf Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="leafDetailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading details...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i>Close
                </button>
                <button type="button" class="btn btn-primary btn-print-leaf">
                    <i class="mdi mdi-printer me-1"></i>Print
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global variables
        let allLeaves = [];
        let currentPage = 1;
        const itemsPerPage = 10;
        const chequeBookId = '@Model?.Id';

        // Initialize leaves from rendered HTML
        $(document).ready(function () {
            // Extract leaves data from the table
            initializeLeavesFromTable();

            // Initialize client-side pagination if needed
            if (allLeaves.length > itemsPerPage) {
                initializeClientSidePagination();
            }

            // Event listeners
            $('#searchInput').on('keyup', function () {
                filterLeaves();
            });

            $('#refreshBtn').on('click', function () {
                loadLeavesData(true);
            });

            $('#exportBtn').on('click', exportLeavesData);

            // Leaf details modal
            $(document).on('click', '.btn-leaf-details', function () {
                const leafId = $(this).data('id');
                showLeafDetails(leafId);
            });

            $(document).on('click', '.btn-print-leaf', function () {
                const leafId = $('#leafDetailsModal').data('current-leaf-id');
                if (leafId) {
                    printLeafDetails(leafId);
                }
            });
        });

        function initializeLeavesFromTable() {
            allLeaves = [];
            $('#leavesTableBody tr').each(function() {
                const $row = $(this);
                const leaf = {
                    id: $row.find('td:nth-child(2)').text().trim(),
                    SerialNumber: parseInt($row.find('td:nth-child(1)').text().trim()),
                    Status: $row.find('td:nth-child(3) .leaf-status').text().trim(),
                    IssuedTo: $row.find('td:nth-child(5)').text().trim(),
                    CreatedDate: parseDate($row.find('td:nth-child(8)').text().trim())
                };
                allLeaves.push(leaf);
            });
        }

        function parseDate(dateStr) {
            if (!dateStr || dateStr === 'N/A') return null;
            try {
                // Parse date from "dd/MM/yyyy HH:mm:ss" format
                const parts = dateStr.split(' ');
                const dateParts = parts[0].split('/');
                if (dateParts.length === 3) {
                    return new Date(dateParts[2], dateParts[1] - 1, dateParts[0]);
                }
                return null;
            } catch {
                return null;
            }
        }

        function initializeClientSidePagination() {
            // Hide all rows initially
            $('#leavesTableBody tr').addClass('d-none');

            // Show first page
            renderLeavesTable(1);

            // Update pagination
            renderPagination();
        }

        function loadLeavesData(forceRefresh = false) {
            if (!chequeBookId) return;

            showLoading(true);

            $.ajax({
                url: '/ChequeBook/GetLeavesData',
                type: 'GET',
                data: {
                    chequeBookId: chequeBookId
                },
                success: function (response) {
                    if (response && response.data && Array.isArray(response.data)) {
                        allLeaves = response.data;
                        updateStatistics();

                        // Re-render table
                        if (allLeaves.length > itemsPerPage) {
                            clearTable();
                            renderLeavesTable(1);
                            renderPagination();
                        }

                        if (forceRefresh) {
                            showToast('Leaves data refreshed successfully', 'success');
                        }
                    } else {
                        showToast('Failed to load leaves data', 'error');
                        allLeaves = [];
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading leaves data:', error);
                    showToast('Error loading leaves data: ' + error, 'error');
                    allLeaves = [];
                },
                complete: function () {
                    showLoading(false);
                }
            });
        }

        function updateStatistics() {
            const total = allLeaves.length;
            const unused = allLeaves.filter(l => l.Status === 'UNUSED').length;
            const used = allLeaves.filter(l => l.Status === 'USED').length;
            const cancelled = allLeaves.filter(l => l.Status === 'CANCELLED').length;
            const cleared = allLeaves.filter(l => l.Status === 'CLEARED').length;

            $('#totalLeaves').text(total);
            $('#unusedCount').text(unused);
            $('#usedCount').text(used);
            $('#cancelledCount').text(cancelled);
            $('#clearedCount').text(cleared);
        }

        function renderLeavesTable(page = 1) {
            currentPage = page;
            const startIndex = (page - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const currentLeaves = allLeaves.slice(startIndex, endIndex);

            const tbody = $('#leavesTableBody');

            // Clear existing rows if we're doing client-side pagination
            if (allLeaves.length > itemsPerPage) {
                tbody.empty();

                currentLeaves.forEach(leaf => {
                    const statusClass = getStatusClass(leaf.Status);
                    const row = `
                        <tr>
                            <td>${leaf.SerialNumber}</td>
                            <td>${escapeHtml(leaf.id)}</td>
                            <td>
                                <span class="leaf-status ${statusClass}">
                                    ${escapeHtml(leaf.Status)}
                                </span>
                            </td>
                                               <td>${escapeHtml(leaf.IssuedTo) || 'N/A'}</td>
                             <td>${formatDate(leaf.CreatedDate)}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary btn-leaf-details"
                                        data-id="${leaf.id}">
                                    <i class="mdi mdi-eye me-1"></i> Details
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }

            updateTableInfo();
        }

        function clearTable() {
            $('#leavesTableBody').empty();
        }

        function getStatusClass(status) {
            if (!status) return 'leaf-unused';

            const statusLower = status.toLowerCase();
            switch(statusLower) {
                case 'unused':
                    return 'leaf-unused';
                case 'used':
                    return 'leaf-used';
                case 'cancelled':
                    return 'leaf-cancelled';
                case 'cleared':
                    return 'leaf-cleared';
                default:
                    return 'leaf-unused';
            }
        }

        function formatDate(dateValue) {
            if (!dateValue) return 'N/A';

            try {
                const date = new Date(dateValue);
                if (isNaN(date.getTime())) return 'N/A';

                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                });
            } catch {
                return 'N/A';
            }
        }

        function escapeHtml(str) {
            if (!str && str !== 0) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function updateTableInfo() {
            const total = allLeaves.length;
            const startIndex = (currentPage - 1) * itemsPerPage + 1;
            const endIndex = Math.min(currentPage * itemsPerPage, total);

            const infoText = total > 0
                ? `Showing ${startIndex} to ${endIndex} of ${total} entries`
                : 'Showing 0 to 0 of 0 entries';

            $('#myDataTable_info').text(infoText);
        }

        function renderPagination() {
            const totalPages = Math.ceil(allLeaves.length / itemsPerPage);
            const pagination = $('#paginationContainer');
            pagination.empty();

            if (totalPages <= 1) return;

            // Previous button
            const prevLi = `
                <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            `;
            pagination.append(prevLi);

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    const li = `
                        <li class="page-item ${currentPage === i ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                        </li>
                    `;
                    pagination.append(li);
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    pagination.append('<li class="page-item disabled"><span class="page-link">...</span></li>');
                }
            }

            // Next button
            const nextLi = `
                <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            `;
            pagination.append(nextLi);
        }

        function changePage(page) {
            if (page >= 1 && page <= Math.ceil(allLeaves.length / itemsPerPage)) {
                renderLeavesTable(page);
            }
        }

        function filterLeaves() {
            const searchTerm = $('#searchInput').val().toLowerCase();

            // Reset to all leaves if search is empty
            if (!searchTerm.trim()) {
                initializeLeavesFromTable();
                if (allLeaves.length > itemsPerPage) {
                    clearTable();
                    renderLeavesTable(1);
                    renderPagination();
                }
                return;
            }

            // Filter locally
            const filteredLeaves = allLeaves.filter(leaf => {
                const serialNumber = String(leaf.SerialNumber || '').toLowerCase();
                const leafId = String(leaf.id || '').toLowerCase();
                const status = String(leaf.Status || '').toLowerCase();
                const issuedTo = String(leaf.IssuedTo || '').toLowerCase();
                const transactionId = String(leaf.TransactionId || '').toLowerCase();

                return serialNumber.includes(searchTerm) ||
                       leafId.includes(searchTerm) ||
                       status.includes(searchTerm) ||
                       issuedTo.includes(searchTerm) ||
                       transactionId.includes(searchTerm);
            });

            allLeaves = filteredLeaves;
            currentPage = 1;

            if (filteredLeaves.length > 0) {
                clearTable();
                renderLeavesTable(1);
                renderPagination();
            } else {
                clearTable();
                updateTableInfo();
                $('#paginationContainer').empty();
            }

            updateStatistics();
        }

        function showLeafDetails(leafId) {
            const leaf = allLeaves.find(l => l.id === leafId);
            if (!leaf) {
                showToast('Leaf not found', 'warning');
                return;
            }

            const modalContent = `
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-label">Leaf ID</div>
                        <div class="info-value">${escapeHtml(leaf.id)}</div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Serial Number</div>
                        <div class="info-value">${leaf.SerialNumber}</div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="info-label">Status</div>
                        <div class="info-value">
                            <span class="leaf-status ${getStatusClass(leaf.Status)}">
                                ${escapeHtml(leaf.Status)}
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Created Date</div>
                        <div class="info-value">${formatDate(leaf.CreatedDate)}</div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="info-label">Issued Date</div>
                        <div class="info-value">${formatDate(leaf.IssuedDate)}</div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Issued To</div>
                        <div class="info-value">${escapeHtml(leaf.IssuedTo) || 'N/A'}</div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="info-label">Cleared Date</div>
                        <div class="info-value">${formatDate(leaf.ClearedDate)}</div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Transaction ID</div>
                        <div class="info-value">${escapeHtml(leaf.TransactionId) || 'N/A'}</div>
                    </div>
                </div>
            `;

            $('#leafDetailsContent').html(modalContent);
            $('#leafDetailsModal').data('current-leaf-id', leafId);
            new bootstrap.Modal(document.getElementById('leafDetailsModal')).show();
        }

        function printLeafDetails(leafId) {
            const leaf = allLeaves.find(l => l.id === leafId);
            if (!leaf) {
                showToast('Leaf not found', 'warning');
                return;
            }

            // Open print window for leaf details
            const printWindow = window.open('', '_blank');

            printWindow.document.write(`
                <html>
                    <head>
                        <title>Cheque Leaf Details - ${leaf.id}</title>
                        <style>
                            body { font-family: Arial, sans-serif; margin: 20px; }
                            h2 { color: #333; }
                            .info-section { margin-bottom: 20px; }
                            .info-label { font-weight: bold; color: #555; }
                            .info-value { margin-left: 10px; }
                            @*@media print {
                                .no-print { display: none; }
                            }*@
                        </style>
                    </head>
                    <body>
                        <h2>Cheque Leaf Details</h2>
                        <div class="info-section">
                            <p><span class="info-label">Leaf ID:</span> <span class="info-value">${leaf.id}</span></p>
                            <p><span class="info-label">Serial Number:</span> <span class="info-value">${leaf.SerialNumber}</span></p>
                            <p><span class="info-label">Status:</span> <span class="info-value">${leaf.Status}</span></p>
                            <p><span class="info-label">Created Date:</span> <span class="info-value">${formatDate(leaf.CreatedDate)}</span></p>
                        </div>
                        <div class="info-section">
                            <p><span class="info-label">Issued Date:</span> <span class="info-value">${formatDate(leaf.IssuedDate)}</span></p>
                            <p><span class="info-label">Issued To:</span> <span class="info-value">${leaf.IssuedTo || 'N/A'}</span></p>
                            <p><span class="info-label">Transaction ID:</span> <span class="info-value">${leaf.TransactionId || 'N/A'}</span></p>
                        </div>
                        <button class="no-print" onclick="window.print()">Print</button>
                        <button class="no-print" onclick="window.close()">Close</button>
                    </body>
                </html>
            `);
            printWindow.document.close();
        }

        function exportLeavesData() {
            if (allLeaves.length === 0) {
                showToast('No leaves data to export', 'warning');
                return;
            }

            // Convert leaves to CSV
            const headers = ['Serial Number', 'Leaf ID', 'Status', 'Issued Date', 'Issued To', 'Cleared Date', 'Transaction ID', 'Created Date'];
            const csvRows = [headers.join(',')];

            allLeaves.forEach(leaf => {
                const row = [
                    leaf.SerialNumber,
                    leaf.id,
                    leaf.Status,
                    formatDate(leaf.IssuedDate),
                    leaf.IssuedTo || '',
                    formatDate(leaf.ClearedDate),
                    leaf.TransactionId || '',
                    formatDate(leaf.CreatedDate)
                ];
                csvRows.push(row.map(cell => `"${cell}"`).join(','));
            });

            const csvContent = csvRows.join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');

            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute('href', url);
                link.setAttribute('download', `cheque_leaves_${chequeBookId}_${new Date().toISOString().slice(0,10)}.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                showToast('Export completed successfully', 'success');
            }
        }

        function printChequeDetails() {
            window.print();
        }

        function showLoading(show) {
            if (show) {
                $('#loadingOverlay').removeClass('d-none');
            } else {
                $('#loadingOverlay').addClass('d-none');
            }
        }

        function showToast(message, type = 'info') {
            // Create a simple toast notification
            const toastId = 'toast-' + Date.now();
            const toastHtml = `
                <div id="${toastId}" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
                    <div class="toast align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            `;

            $('body').append(toastHtml);
            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement.querySelector('.toast'));
            toast.show();

            // Remove after 3 seconds
            setTimeout(() => {
                $(toastElement).remove();
            }, 3000);
        }

        // Keyboard shortcuts
        $(document).keydown(function(e) {
            // Ctrl+F for search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                $('#searchInput').focus();
            }

            // Escape to close
            if (e.key === 'Escape') {
                window.close();
            }

            // F5 to refresh
            if (e.key === 'F5') {
                e.preventDefault();
                loadLeavesData(true);
            }
        });
    </script>
}