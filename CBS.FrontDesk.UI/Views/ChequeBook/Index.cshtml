@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.ChequeBookListing.ChequeBook
@{
    ViewBag.Title = "Cheque Book Management";
}
@using Resources;

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-book-open-page-variant-outline me-2"></i> Cheque Book Management
        </h1>
        <p class="card-text text-muted mb-1">
            Manage cheque books, view details, and handle leaf operations.
        </p>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <button id="applyFilterBtn" class="btn btn-primary me-2">Apply Filters</button>
            <button id="resetFilterBtn" class="btn btn-secondary">Reset</button>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="card p-3 mb-3 bg-light border">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Customer Name</label>
                <input type="text" id="customerNameFilter" class="form-control" placeholder="Search customer..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList("branchFilter", new SelectList(ViewBag.Branches, "Id", "Name"), "All Branches", new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">From Date</label>
                <input type="date" id="fromDateFilter" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">To Date</label>
                <input type="date" id="toDateFilter" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select id="statusFilter" class="form-control">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Used">Used</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Blocked">Blocked</option>
                </select>
            </div>
        </div>
    </div>

    <!-- DataTable -->
    <div id="chequeBookTableContainer">
        <!-- This will be populated by AJAX -->
        <table id="chequeBookTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Account Number</th>
                    <th>Branch</th>
                    <th>Leaves</th>
                    <th>Status</th>
                    <th>Issue Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded via AJAX -->
            </tbody>
        </table>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cheque Book Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- Details content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Action Modals -->
<div class="modal fade" id="cancelChequeBookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Cheque Book</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="cancelChequeBookModalBody">
                <!-- Cancel form will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let chequeBookTable;

        $(document).ready(function () {
            // Initialize DataTable
            initializeDataTable();

            // Apply Filters button click
            $('#applyFilterBtn').click(function () {
                applyFilters();
            });

            // Reset Filters button click
            $('#resetFilterBtn').click(function () {
                resetFilters();
            });
        });

        function initializeDataTable() {
            chequeBookTable = $('#chequeBookTable').DataTable({
                processing: false,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetChequeBooks", "ChequeBook")',
                    type: 'POST',
                    data: function (d) {
                        // Add our custom filters to the DataTables request
                        d.customerName = $('#customerNameFilter').val();
                        d.branchId = $('#branchFilter').val();
                        d.status = $('#statusFilter').val();
                        d.fromDate = $('#fromDateFilter').val();
                        d.toDate = $('#toDateFilter').val();
                    }
                },
                columns: [
                    { data: 'customerName', name: 'CustomerName' },
                    { data: 'accountNumber', name: 'AccountNumber' },
                    { data: 'branchName', name: 'BranchName' },
                    { data: 'numberOfLeaves', name: 'NumberOfLeaves' },
                    {
                        data: 'status',
                        name: 'Status',
                        render: function(data, type, row) {
                            let badgeClass = 'bg-secondary';
                            switch(data) {
                                case 'Active': badgeClass = 'bg-success'; break;
                                case 'Used': badgeClass = 'bg-primary'; break;
                                case 'Cancelled': badgeClass = 'bg-danger'; break;
                                case 'Blocked': badgeClass = 'bg-warning'; break;
                            }
                            return `<span class="badge ${badgeClass}">${data}</span>`;
                        }
                    },
                    {
                        data: 'issueDate',
                        name: 'IssueDate',
                        render: function(data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: 'id',
                        name: 'Actions',
                        orderable: false,
                        render: function(data, type, row) {
                            return `
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-info" onclick="showChequeBookDetails('${data}')" title="View Details">
                                        <i class="mdi mdi-eye"></i>
                                    </button>
                                    <button class="btn btn-danger" onclick="showCancelForm('${data}')" title="Cancel Cheque Book">
                                        <i class="mdi mdi-cancel"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                language: {
                    emptyTable: "No cheque books found. Apply filters to load data.",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of 0 entries",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    lengthMenu: "Show _MENU_ entries",
                    loadingRecords: "Loading...",
                    processing: "Processing...",
                    search: "Search:",
                    zeroRecords: "No matching records found"
                }
            });
        }

        function applyFilters() {
            chequeBookTable.ajax.reload();
        }

        function resetFilters() {
            $('#customerNameFilter').val('');
            $('#branchFilter').val('');
            $('#statusFilter').val('');
            $('#fromDateFilter').val('');
            $('#toDateFilter').val('');
            chequeBookTable.ajax.reload();
        }

        function showChequeBookDetails(chequeBookId) {
            $('#detailsModalBody').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Loading cheque book details...</div>
                </div>
            `);

            $('#detailsModal').modal('show');

            $.get('@Url.Action("GetChequeBookDetails", "ChequeBook")', { id: chequeBookId })
                .done(function (data) {
                    $('#detailsModalBody').html(data);
                })
                .fail(function () {
                    $('#detailsModalBody').html(`
                        <div class="alert alert-danger">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            Failed to load cheque book details.
                        </div>
                    `);
                });
        }

        function showCancelForm(chequeBookId) {
            $('#cancelChequeBookModalBody').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Loading cancellation form...</div>
                </div>
            `);

            $('#cancelChequeBookModal').modal('show');

            $.get('@Url.Action("CancelChequeBookForm", "ChequeBook")', { chequeBookId: chequeBookId })
                .done(function (data) {
                    $('#cancelChequeBookModalBody').html(data);
                })
                .fail(function () {
                    $('#cancelChequeBookModalBody').html(`
                        <div class="alert alert-danger">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            Failed to load cancellation form.
                        </div>
                    `);
                });
        }

        // Handle form submissions via event delegation
        $(document).on('submit', '#cancelChequeBookForm', function (e) {
            e.preventDefault();
            const formData = $(this).serialize();

            $.post('@Url.Action("CancelChequeBook", "ChequeBook")', formData)
                .done(function (response) {
                    if (response.success) {
                        $('#cancelChequeBookModal').modal('hide');
                        appalert(response.message, 1, 1);
                        chequeBookTable.ajax.reload();
                    } else {
                        appalert(response.message, 2, 1);
                    }
                })
                .fail(function () {
                    appalert('An error occurred while cancelling the cheque book.', 4, 1);
                });
        });
    </script>
}