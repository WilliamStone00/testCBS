@using Resources

<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-cash-multiple"></i> @GlobalCounterCheque.Counter_Cheques_List
    </h5>

    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Issued_On</th>
                    <th>@GlobalShared.Customer</th>
                    <th>@GlobalShared.Account_No</th>
                    <th>@GlobalShared.Cheque_No</th>
                    <th>@GlobalShared.Amount</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Issued_By</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<script>
    $(document).ready(function () {
        initCounterChequeTable();
    });
</script>
