@model List<CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CheckBookLeaf>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="mdi mdi-alert-outline me-1"></i>
        No cheque leaves found.
    </div>
}
else
{
    <div id="chequeLeavesGrid" class="row g-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            var leaf = Model[i];
            var isAvailable = leaf.Status == "Available";
            var isIssued = leaf.Status == "Issued";

            <div class="col-xl-3 col-lg-4 col-md-6 cheque-leaf-item @(i >= 16 ? "d-none" : "")">
                <div class="card cheque-leaf-card h-100
                            @(isAvailable ? "border-success" : isIssued ? "border-warning" : "border-secondary")"
                     data-leaf-id="@leaf.Id"
                     data-serial="@leaf.SerialNumber"
                     data-status="@leaf.Status">

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                Leaf #
                                <span class="fw-bold text-primary">
                                    @leaf.SerialNumber.ToString("D3")
                                </span>
                            </h6>
                            <span class="badge @(isAvailable ? "bg-success" : isIssued ? "bg-warning" : "bg-secondary")">
                                @leaf.Status
                            </span>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Cheque Book ID:</small>
                            <span class="fw-semibold">@leaf.CheckBookId</span>
                        </div>


                        @if (leaf.IssuedDate.HasValue)
                        {
                            <div class="mb-1">
                                <small class="text-muted">Issued:</small>
                                <span>@leaf.IssuedDate.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(leaf.IssuedTo))
                        {
                            <div class="mb-1">
                                <small class="text-muted">Issued To:</small>
                                <span>@leaf.IssuedTo</span>
                            </div>
                        }

                        <div class="mt-auto d-grid gap-2">
                            @if (isAvailable)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-success select-leaf-btn"
                                        data-leaf-id="@leaf.Id"
                                        data-serial="@leaf.SerialNumber">
                                    <i class="mdi mdi-check"></i> Select Leaf
                                </button>
                            }

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary view-leaf-btn"
                                    data-leaf-id="@leaf.Id">
                                <i class="mdi mdi-eye"></i> View Details
                            </button>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent pt-0 text-end">
                        <small class="text-muted">Created: @leaf.CreatedDate.ToString("dd/MM/yy")</small>
                    </div>
                </div>
            </div>
        }
    </div>

    if (Model.Count > 16)
    {
        <div class="text-center mt-3">
            <button type="button"
                    id="toggleLeavesBtn"
                    class="btn btn-outline-primary btn-sm"
                    data-expanded="false">
                View More
            </button>
        </div>
    }

}

<style>
    .cheque-leaf-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .cheque-leaf-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .cheque-leaf-card.selected {
            border: 2px solid #0d6efd !important;
            background-color: rgba(13,110,253,0.05);
        }
</style>
