@model IEnumerable<CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CheckBookLeaf>
@using Resources

<div class="card mt-3 shadow-sm">
    <div class="card-header bg-light text-primary fw-bold">
        <i class="mdi mdi-table me-1"></i> @GlobalShared.Cheque_Leaves
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle text-nowrap"
                   id="myDataTable_chequeLeaves">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.Leaf</th>
                        <th>@GlobalShared.CheckBook_ID</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalShared.Issued_Date</th>
                        <th>@GlobalShared.Issued_To</th>
                        <th style="width:15%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leaf in Model)
                    {
                        var isAvailable = leaf.Status == "UNUSED";
                        var isIssued = leaf.Status == "Issued";

                        <tr class="@(isIssued ? "table-warning" : "")">
                            <td class="fw-bold text-primary">
                                @leaf.SerialNumber.ToString("D3")
                            </td>
                            <td>@leaf.CheckBookId</td>
                            <td>
                                <span class="badge @(isAvailable ? "bg-success" : isIssued ? "bg-warning" : "bg-secondary")">
                                    @leaf.Status
                                </span>
                            </td>

                            <td>
                                @(leaf.IssuedDate.HasValue
                                    ? leaf.IssuedDate.Value.ToString("dd/MM/yyyy")
                                    : "-")
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(leaf.IssuedTo) ? "-" : leaf.IssuedTo)
                            </td>

                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-soft-primary dropdown-toggle d-flex align-items-center gap-1"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i>
                                        @GlobalShared.Actions
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm animate__animated animate__fadeIn">

                                        <!-- Counter Request -->
                                        <li>
                                            <button class="dropdown-item btn-create"
                                                    data-id="@leaf.Id">
                                                <i class="mdi mdi-file-document-outline text-primary me-2"></i>
                                                @GlobalCounterCheque.Counter_Request
                                            </button>
                                        </li>

                                        <!-- Details -->
                                        <li>
                                            <button class="dropdown-item view-leaf-btn"
                                                    data-leaf-id="@leaf.Id">
                                                <i class="mdi mdi-eye-outline text-info me-2"></i>
                                                @GlobalShared.View_Details
                                            </button>
                                        </li>

                                        <!-- Clearance -->
                                        <li>
                                            <button class="dropdown-item btn-clearance"
                                                    data-id="@leaf.Id">
                                                <i class="mdi mdi-broom text-danger me-2"></i>
                                                @GlobalShared.Clearance
                                            </button>
                                        </li>

                                        <li>
                                            <button class="dropdown-item btn-clearance"
                                                    data-id="@leaf.Id">
                                                <i class="mdi mdi-broom text-danger me-2"></i>
                                                @GlobalShared.Clearance
                                            </button>
                                        </li>

                                    </ul>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
        $(document).ready(function () {
        $('#myDataTable_chequeLeaves').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true,
            responsive: true,
            destroy: true,
            language: {
                emptyTable: "No cheque leaves available"
            }
        });
    });
</script>
