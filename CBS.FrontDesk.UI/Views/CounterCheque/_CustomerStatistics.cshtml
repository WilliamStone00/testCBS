@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CustomerCheckBookStatisticsDto
@using CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque
@using Resources


<div class="card shadow-sm border-0 mb-4">

    <!-- HEADER -->
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="mdi mdi-chart-bar me-2"></i> @GlobalCounterCheque.Checkbook_Statistics
        </h5>
        <span class="badge fs-6
            @(Model.RiskLevel == "High" ? "bg-danger" : Model.RiskLevel == "Medium" ? "bg-warning text-dark" : "bg-success")">
            @GlobalShared.Risk: @Model.RiskLevel
        </span>
    </div>

    <div class="card-body p-0">

        <!-- CUSTOMER INFO -->
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h6 class="text-primary mb-1"><i class="mdi mdi-account me-1"></i>@Model.CustomerName</h6>
                <small class="opacity-75">@GlobalShared.Generated_on @Model.GeneratedAt.ToString("dd MMM yyyy HH:mm")</small>
            </div>
        </div>

        <div class="border-bottom p-3">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <small class="text-muted d-block">@GlobalShared.Member_reference</small>
                    <strong>@Model.CustomerId</strong>
                </div>
                <div class="col-md-4 mb-2">
                    <small class="text-muted d-block">@GlobalShared.Primary_Account</small>
                    <strong>
                        @( (Model.ChequeAccounts != null && Model.ChequeAccounts.Any())
                            ? Model.ChequeAccounts.First().AccountNumber
                            : "N/A" )
                    </strong>

                </div>
                <div class="col-md-4 mb-2">
                    <small class="text-muted d-block">@GlobalShared.Total_balance</small>
                    <strong class="@(Model.TotalBalance < 0 ? "text-danger" : "text-success")">
                        @Model.TotalBalance.ToString("N2")
                    </strong>
                </div>
            </div>
        </div>

        <!-- QUICK STATS -->
        <div class="row g-0 text-center border-bottom">

            <div class="col-2 p-2 border-end">
                <small class="text-muted d-block">@GlobalShared.Checkbooks</small>
                <h5 class="mb-0">@Model.TotalCheckBooks</h5>
                <small class="text-success">@Model.ActiveCheckBooks @GlobalShared.Active</small>
            </div>

            <div class="col-2 p-2 border-end">
                <small class="text-muted d-block">@GlobalShared.Total_Leaves</small>
                <h5 class="mb-0">@Model.TotalLeaves</h5>
                <small class="@(Model.TotalRemainingLeaves > 0 ? "text-success" : "text-danger")">
                    @Model.TotalRemainingLeaves @GlobalShared.Remaining
                </small>
            </div>

            <div class="col-2 p-2 border-end">
                <small class="text-muted d-block">@GlobalShared.Usage_Rate</small>
                <h5 class="mb-0">@Model.GlobalUsageRate.ToString("0")%</h5>
                <div class="progress mt-1" style="height:4px;">
                    <div class="progress-bar bg-success" style="width:@Model.GlobalUsageRate%"></div>
                </div>
            </div>

            <div class="col-6 p-2">
                <div class="border rounded h-100">

                    <div class="row g-0 text-center border-bottom">
                        <div class="col p-2 border-end">
                            <small class="text-muted d-block">@GlobalShared.Counter</small>
                            <h6 class="mb-0">@Model.CounterChecks</h6>
                            <small class="text-muted">@Model.CounterChecksWithin24h @GlobalShared.within_24h</small>
                        </div>
                        <div class="col p-2 border-end">
                            <small class="text-muted d-block">@GlobalShared.On_Behalf</small>
                            <h6 class="mb-0">@Model.OnBehalfOf</h6>
                            <small class="text-muted">@Model.OnBehalfOfWithin24h @GlobalShared.within_24h</small>
                        </div>
                        <div class="col p-2">
                            <small class="text-muted d-block">@GlobalShared.Owner</small>
                            <h6 class="mb-0">@Model.ByOwner</h6>
                            <small class="text-muted">@Model.ByOwnerWithin24h @GlobalShared.within_24h</small>
                        </div>
                    </div>

                    <div class="text-center p-2 bg-light">
                        <small class="text-muted d-block">@GlobalShared.Avg_Clearance</small>
                        <h6 class="mb-0">@Model.TotalAverageClearanceHours</h6>
                        <small class="text-muted">@Model.TotalClearedWithin24h @GlobalShared.within_24h</small>
                    </div>

                </div>
            </div>

        </div>

        <!-- ACCOUNTS TABLE -->
        <div class="accordion accordion-flush" id="statsAccordion">

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accountsCollapse">
                        <i class="mdi mdi-bank me-2 text-primary"></i>
                        @GlobalShared.Attached_Accounts
                        <span class="badge bg-secondary ms-2">
                            @(Model.ChequeAccounts != null ? Model.ChequeAccounts.Count : 0)
                        </span>
                    </button>
                </h2>
                <div id="accountsCollapse" class="accordion-collapse collapse" data-bs-parent="#statsAccordion">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@GlobalShared.Account_type</th>
                                        <th>@GlobalShared.Account_Number</th>
                                        <th>@GlobalShared.Cheque_book</th>
                                        <th>@GlobalShared.Status</th>
                                        <th class="text-end">@GlobalShared.Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var acc in Model.ChequeAccounts ?? Enumerable.Empty<ChequeAccountDto>())
                                    {
                                        <tr>
                                            <td>@acc.AccountType</td>
                                            <td class="text-monospace">@acc.AccountNumber</td>
                                            <td><span class="badge bg-info">@acc.Chequebook</span></td>
                                            <td>
                                                <span class="badge @(acc.IsActive ? "bg-success" : "bg-danger")">
                                                    @(acc.IsActive ? "Active" : "Deactivated")
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold">@acc.BalanceAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FINANCIAL SUMMARY -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#financialCollapse">
                        <i class="mdi mdi-cash me-2 text-success"></i> @GlobalCounterCheque.Financial_Summary
                    </button>
                </h2>
                <div id="financialCollapse" class="accordion-collapse collapse" data-bs-parent="#statsAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <small class="text-muted">@GlobalShared.Total_Issued</small>
                                <strong>@Model.TotalAmountIssued.ToString("N2")</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">@GlobalShared.Cleared</small>
                                <strong class="text-success">@Model.TotalAmountCleared.ToString("N2")</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">@GlobalShared.Pending</small>
                                <strong class="text-warning">@Model.TotalAmountPending.ToString("N2")</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">@GlobalShared.Rejected</small>
                                <strong class="text-danger">@Model.TotalAmountRejected.ToString("N2")</strong>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-6">
                                <small class="text-muted">@GlobalCounterCheque.Highest_Cheque</small>
                                <strong>@Model.HighestChequeAmount.ToString("N2")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">@GlobalCounterCheque.Average_Cheque</small>
                                <strong>@Model.AverageChequeAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECURITY & RISK -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#securityCollapse">
                        <i class="mdi mdi-shield-alert me-2 text-danger"></i> @GlobalShared.Security_And_Risk
                    </button>
                </h2>
                <div id="securityCollapse" class="accordion-collapse collapse" data-bs-parent="#statsAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <small class="text-muted">@GlobalCounterCheque.Bounced_Cheques</small>
                                <strong class="@(Model.BouncedChequesCount > 0 ? "text-danger" : "text-success")">
                                    @Model.BouncedChequesCount
                                </strong>
                            </div>
                            <div class="col-md-4 mb-3">
                                <small class="text-muted">@GlobalCounterCheque.Stop_Payments</small>
                                <strong>@Model.StopPaymentRequests</strong>
                            </div>
                            <div class="col-md-4 mb-3">
                                <small class="text-muted">@GlobalCounterCheque.Fraud_Flags</small>
                                <strong class="@(Model.FraudFlaggedCheques > 0 ? "text-danger" : "text-success")">
                                    @Model.FraudFlaggedCheques
                                </strong>
                            </div>
                        </div>

                        <div class="alert @(Model.HasBlockedCheckBooks ? "alert-warning" : "alert-success")">
                            <i class="mdi mdi-@(Model.HasBlockedCheckBooks ? "alert-circle" : "check-circle") me-2"></i>
                            @(Model.HasBlockedCheckBooks ? "Has blocked checkbooks" : "No blocked checkbooks")
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- FOOTER DATES -->
    <div class="card-footer text-muted small">
        <div class="row">
            <div class="col-md-6">
                @GlobalShared.First_issued: @(Model.FirstIssuedDate?.ToString("dd MMM yyyy") ?? "N/A")
            </div>
            <div class="col-md-6 text-end">
                @GlobalShared.Last_cheque_issued: @(Model.LastChequeIssuedDate?.ToString("dd MMM yyyy") ?? "N/A")
            </div>
        </div>
    </div>
</div>

<style>
    .accordion-button:not(.collapsed) {
        background-color: rgba(13, 110, 253, 0.05);
        color: #0d6efd;
    }

    .progress-bar {
        transition: width 0.6s ease;
    }

    .card {
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 5px 20px rgba(0,0,0,0.1) !important;
        }
</style>
