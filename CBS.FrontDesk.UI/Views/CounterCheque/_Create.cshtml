@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CounterChecks
@using Resources

<fieldset class="fieldset-custom">
    <div class="row g-3">
        <!-- CUSTOMER SEARCH -->
        <h6 class="text-primary">
            <i class="mdi mdi-account-search-outline me-2"></i> Member Search
        </h6>

        <div class="col-md-12">
            <label class="form-label fw-bold">Member Reference</label>
            <div class="input-group">
                <input type="text" name="CustomerId" id="customerIdInput"
                       class="form-control" placeholder="Enter Member Reference">
                <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                    <i class="mdi mdi-magnify"></i> Search
                </button>
            </div>
        </div>

        <!-- DETAILS BLOCK -->
        <div id="chequeLeavesContainer" class="mt-3"></div>

    </div>
</fieldset>