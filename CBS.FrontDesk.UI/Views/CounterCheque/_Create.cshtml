@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CounterCheques
@using Resources

@using (Html.BeginForm("Create", "CounterCheque", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

    <fieldset class="fieldset-custom">
        <div class="row g-3">

            <!-- CUSTOMER SEARCH -->
            <h6 class="text-primary">
                <i class="mdi mdi-account-search-outline me-2"></i> Customer Search
            </h6>

            <div class="row mb-2 align-items-end">
                <div class="col-md-12 mb-2">
                    @Html.Label("BranchId", "Branch", new { @class = "form-label fw-bold", @for = "BranchId" })
                    @Html.DropDownList(
                        "BranchId",
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2 mb-2", id = "BranchId", required = "required" }
                    )
                </div>
            </div>

            <div class="col-md-12">
                <label class="form-label fw-bold">Customer ID</label>
                <div class="input-group">
                    <input type="text" name="CustomerId" id="customerIdInput"
                           class="form-control" placeholder="Enter Member Reference">
                    <button type="button" class="btn btn-primary" id="searchCustomerBtn">
                        <i class="mdi mdi-magnify"></i> Search
                    </button>
                </div>
            </div>

            <!-- CHEQUE BOOK TYPE DROPDOWN -->
            <div class="row mb-2 align-items-end" id="chequeTypeDiv" style="display:none;">
                <div class="col-md-12 mb-2">
                    @Html.Label("Name", "Cheque Book Type", new { @class = "form-label fw-semibold" })
                    @Html.DropDownList(
                        "ChequeBookId",
                        new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                        "--- Select Cheque Book Type ---",
                        new { @class = "form-control select2 mb-2", id = "ChequeBookId", required = "required" }
                    )
                </div>
            </div>

            <!-- DETAILS BLOCK -->
            <div id="detailsBlock" style="display:none;">
                <div id="datalistingview">
                    @Html.Partial("_Detailscountercheque", new CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CustomerCheckBookDisplayDto())
                    <!-- Partial view will be loaded here -->
                </div>
            </div>

        </div>
    </fieldset>
}
