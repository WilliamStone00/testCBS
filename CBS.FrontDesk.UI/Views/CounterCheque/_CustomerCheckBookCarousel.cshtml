@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CustomerData

@if (Model == null || Model.CheckBooks == null || !Model.CheckBooks.Any())
{
    <div class="alert alert-warning text-center">
        <i class="mdi mdi-alert-outline me-1"></i>
        No cheque books found for this customer.
    </div>
}
else
{
    <!-- CHECKBOOK CAROUSEL - MODIFIÉ POUR 2 BLOCS PAR PAGE -->
    <div id="customerCheckBookCarousel" class="carousel slide" data-bs-ride="false" data-bs-interval="false">
        <div class="carousel-inner">
            @{
                int itemsPerPage = 2;
                int totalPages = (int)Math.Ceiling((double)Model.CheckBooks.Count / itemsPerPage);

                for (int page = 0; page < totalPages; page++)
                {
                    <div class="carousel-item @(page == 0 ? "active" : "")">
                        <div class="row g-3">
                            @for (int i = page * itemsPerPage; i < (page * itemsPerPage) + itemsPerPage && i < Model.CheckBooks.Count; i++)
                            {
                                var entry = Model.CheckBooks[i];
                                var disabled = entry.CheckBook.RemainingLeaves <= 0;

                                <div class="col-md-6">
                                    <div class="card shadow-sm h-100"
                                         data-checkbook-id="@entry.CheckBook.Id">
                                        <div class="card-body d-flex flex-column">

                                            <!-- HEADER -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="text-primary mb-0">
                                                    <i class="mdi mdi-book-open-page-variant-outline me-1"></i>
                                                    @entry.CheckBook.CheckBookCategory.Name
                                                </h6>

                                                @if (disabled)
                                                {
                                                    <span class="badge bg-danger">Exhausted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                            </div>

                                            <!-- ACCOUNT INFO -->
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Cheque Book Identifier:</small>
                                                    <strong>@entry.CheckBook.Id</strong>
                                                </div>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Account:</small>
                                                    <strong>@entry.CheckBook.AccountNumber</strong>
                                                </div>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Balance:</small>
                                                    <strong class="@(entry.Account.Balance < 0 ? "text-danger" : "text-success")">
                                                        @entry.Account.Balance.ToString("N2")
                                                    </strong>
                                                </div>
                                            </div>

                                            @{
                                                var total = entry.CheckBook.NumberOfLeaves;
                                                var used = entry.CheckBook.UsedLeaves;
                                                var remaining = total - used;
                                            }

                                            <!-- CHECKBOOK STATS -->
                                            <div class="bg-light p-2 rounded mb-3 flex-grow-1">
                                                <div class="row text-center">
                                                    <div class="col-4">
                                                        <div class="small text-muted">Total</div>
                                                        <div class="fw-bold">@entry.CheckBook.NumberOfLeaves</div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="small text-muted">Used</div>
                                                        <div class="fw-bold">@entry.CheckBook.UsedLeaves</div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="small text-muted">Remaining</div>
                                                        <div class="fw-bold @(disabled ? "text-danger" : "text-success")">
                                                            @remaining
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ACTION BUTTONS - MODIFIED -->
                                            <div class="mt-auto pt-2">
                                                <div class="d-grid gap-2">
                                                    <!-- Main Actions Button -->
                                                    <div class="dropdown">
                                                        <button class="btn btn-info w-100 d-flex justify-content-center align-items-center gap-2 dropdown-toggle"
                                                                type="button"
                                                                id="chequeActions_@entry.CheckBook.Id"
                                                                data-bs-toggle="dropdown"
                                                                data-bs-boundary="viewport"
                                                                aria-expanded="false"
                                                                data-bs-offset="0,10">
                                                            <i class="mdi mdi-cog-outline"></i>
                                                            <span class="fw-semibold">Actions</span>
                                                        </button>

                                                        <!-- Dropdown Menu -->
                                                        <ul class="dropdown-menu w-100 shadow dropdown-menu-end"
                                                            aria-labelledby="chequeActions_@entry.CheckBook.Id"
                                                            style="min-width: 100%; box-sizing: border-box;">

                                                            <!-- Details Button -->
                                                            <li>
                                                                <button class="dropdown-item d-flex align-items-center btn-cheque-view"
                                                                        data-id="@entry.CheckBook.Id"
                                                                        data-name="@entry.CheckBook.CheckBookCategory.Name">
                                                                    <i class="mdi mdi-eye-outline me-2 text-primary fs-5"></i>
                                                                    <div class="d-flex flex-column">
                                                                        <span class="fw-semibold">Details</span>
                                                                        <small class="text-muted">View cheque book details</small>
                                                                    </div>
                                                                </button>
                                                            </li>


                                                            <!-- View Grid -->
                                                            <li>
                                                                <button class="dropdown-item view-cheque-btn"
                                                                        data-view="grid"
                                                                        data-checkbook-id="@entry.CheckBook.Id">
                                                                    <i class="mdi mdi-view-grid-outline me-1"></i>
                                                                    View Grid
                                                                </button>
                                                            </li>

                                                            <!-- View List -->
                                                            <li>
                                                                <button class="dropdown-item view-cheque-btn"
                                                                        data-view="list"
                                                                        data-checkbook-id="@entry.CheckBook.Id">
                                                                    <i class="mdi mdi-format-list-bulleted me-1"></i>
                                                                    View List
                                                                </button>
                                                            </li>

                                                            <li><hr class="dropdown-divider my-2"></li>

                                                            <!-- Resubscription Button -->
                                                            <li>
                                                                <button class="dropdown-item d-flex align-items-center btn-cheque-resubscribe">
                                                                    <i class="mdi mdi-refresh me-2 text-info fs-5"></i>
                                                                    <div class="d-flex flex-column">
                                                                        <span class="fw-semibold">Resubscription</span>
                                                                        <small class="text-muted">Renew cheque book</small>
                                                                    </div>
                                                                </button>
                                                            </li>

                                                             @*Toggle Status Button*@ 
                                                            <li>
                                                                <button class="dropdown-item d-flex align-items-center btn-cheque-toggle-status">
                                                                    <i class="mdi mdi-lock-outline me-2 text-warning fs-5"></i>
                                                                    <div class="d-flex flex-column">
                                                                        <span class="fw-semibold">Activate/Deactivate</span>
                                                                        <small class="text-muted">Change cheque book status</small>
                                                                    </div>
                                                                </button>
                                                            </li>

                                                            <li><hr class="dropdown-divider my-2"></li>

                                                            <!-- ================= CLEARANCE ================= -->
                                                            <!--<li>
                                                                <button class="dropdown-item d-flex align-items-center btn-cheque-clearance"
                                                                        data-checkbook-id="@entry.CheckBook.Id">
                                                                    <i class="mdi mdi-bank-transfer me-2 text-success fs-5"></i>
                                                                    <div class="d-flex flex-column">
                                                                        <span class="fw-semibold">Clearance</span>
                                                                        <small class="text-muted">Manage cheque clearances</small>
                                                                    </div>
                                                                </button>
                                                            </li>-->

                                                            <!-- Cancellation Button -->
                                                            <li>
                                                                <button class="dropdown-item d-flex align-items-center btn-cheque-cancel"
                                                                    data-checkbook-id="@entry.CheckBook.Id">
                                                                    <i class="mdi mdi-close-circle-outline me-2 text-danger fs-5"></i>
                                                                    <div class="d-flex flex-column">
                                                                        <span class="fw-semibold">Cancellation</span>
                                                                        <small class="text-muted">Cancel this cheque book</small>
                                                                    </div>
                                                                </button>
                                                            </li>

                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- CONTROLS -->
        @if (totalPages > 1)
        {
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#customerCheckBookCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button"
                    data-bs-target="#customerCheckBookCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>

            <!-- INDICATORS -->
            <div class="carousel-indicators position-static mt-3">
                @for (int i = 0; i < totalPages; i++)
                {
                    <button type="button"
                            data-bs-target="#customerCheckBookCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Slide @(i + 1)">
                    </button>
                }
            </div>
        }
    </div>

    <!-- PAGE COUNTER -->
    if (totalPages > 1)
    {
        <div class="text-center mt-2 text-muted small">
            Page <span id="currentPage">1</span> of @totalPages
        </div>
    }

    <!-- Conteneur où la partial view _ChequeLeavesGrid sera injectée -->
    <div id="chequeLeavesContainer" class="mt-4">
        <!-- Les feuilles de chèque apparaitront ici -->
    </div>
}

<style>
    /* SPECIFIC TO CUSTOMER CHECKBOOK CAROUSEL - use more specific selectors */
    #customerCheckBookCarousel .dropdown-menu {
        min-width: 100% !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        position: absolute !important;
        z-index: 1060 !important;
        left: 0 !important;
        right: 0 !important;
        margin-top: 10px !important;
    }

    /* Target only dropdowns within the checkbook carousel */
    #customerCheckBookCarousel .card {
        position: relative;
        overflow: visible !important;
    }

    #customerCheckBookCarousel .dropdown {
        position: static !important;
    }

    /* Only affect dropdown items within the carousel */
    #customerCheckBookCarousel .dropdown-item {
        padding: 0.75rem 1rem !important;
        border-radius: 0.375rem;
        margin: 0.125rem 0.5rem;
        width: calc(100% - 1rem) !important;
        transition: all 0.2s ease;
        border: none;
        text-align: left;
        background: transparent;
    }

        #customerCheckBookCarousel .dropdown-item:hover {
            background-color: #f8f9fa !important;
            transform: translateX(2px);
        }

        #customerCheckBookCarousel .dropdown-item:active {
            background-color: #e9ecef !important;
        }

        /* Icon styling specific to carousel */
        #customerCheckBookCarousel .dropdown-item i {
            width: 24px;
            text-align: center;
        }

        /* Dropdown text styling */
        #customerCheckBookCarousel .dropdown-item .d-flex.flex-column small {
            font-size: 0.75rem;
            line-height: 1.2;
        }

    /* Ensure dropdown doesn't get clipped by carousel */
    #customerCheckBookCarousel .carousel-inner {
        overflow: visible !important;
    }

    #customerCheckBookCarousel .carousel-item {
        overflow: visible !important;
    }

    /* Card hover effects only in carousel */
    #customerCheckBookCarousel .card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #dee2e6;
        overflow: visible !important;
    }

        #customerCheckBookCarousel .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
        }

    /* Carousel controls */
    #customerCheckBookCarousel .carousel-indicators {
        margin-bottom: 0;
    }

        #customerCheckBookCarousel .carousel-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin: 0 3px;
            background-color: #ccc;
            border: none;
        }

            #customerCheckBookCarousel .carousel-indicators button.active {
                background-color: #0d6efd;
            }

    #customerCheckBookCarousel .carousel-control-prev,
    #customerCheckBookCarousel .carousel-control-next {
        width: 5%;
        opacity: 0.7;
    }

        #customerCheckBookCarousel .carousel-control-prev:hover,
        #customerCheckBookCarousel .carousel-control-next:hover {
            opacity: 1;
        }

    /* Custom arrow colors */
    #customerCheckBookCarousel .carousel-control-prev-icon,
    #customerCheckBookCarousel .carousel-control-next-icon {
        background-color: transparent;
        background-image: none;
    }

        #customerCheckBookCarousel .carousel-control-prev-icon::after {
            content: '\276E';
            font-size: 2rem;
            color: #0d6efdc7;
        }

        #customerCheckBookCarousel .carousel-control-next-icon::after {
            content: '\276F';
            font-size: 2rem;
            color: #0d6efdc7;
        }

    #customerCheckBookCarousel .carousel-control-prev:hover::after,
    #customerCheckBookCarousel .carousel-control-next:hover::after {
        opacity: 0.8;
    }

    /* Main action button styling */
    #customerCheckBookCarousel .btn-primary.dropdown-toggle {
        background-color: #0d6efd;
        border-color: #0d6efd;
        font-weight: 600;
        padding: 0.5rem 1rem;
    }

        #customerCheckBookCarousel .btn-primary.dropdown-toggle:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

    /* Dropdown divider */
    #customerCheckBookCarousel .dropdown-divider {
        margin: 0.5rem 0.75rem;
    }

    /* Ensure dropdown items are properly aligned */
    #customerCheckBookCarousel .dropdown-item .d-flex {
        align-items: flex-start;
    }

    /* Fix for modal z-index conflicts */
    .modal {
        z-index: 1080 !important;
    }

    .modal-backdrop {
        z-index: 1079 !important;
    }

    /* Ensure dropdowns in modals work correctly */
    .modal .dropdown-menu {
        z-index: 1081 !important;
    }
</style>

<script>

    function handleChequeView(id, name) {
        currentChequeId = id;
        currentChequeName = name;

        // open new window (shared view handled server-side)
        var url = '/ChequeBook/GetChequeBookDetails?id=' + encodeURIComponent(id);
        window.open(url, '_blank');
    }

    $(document).off('click', '.btn-cheque-view').on('click', '.btn-cheque-view', function (e) {
        e.preventDefault();
        var id = decodeURIComponent($(this).data('id'));
        var name = $(this).data('name') || '';
        handleChequeView(id, name);
    });

    // Mettre à jour le compteur de page
    document.addEventListener('DOMContentLoaded', function () {
        var carousel = document.getElementById('customerCheckBookCarousel');
        if (carousel) {
            carousel.addEventListener('slid.bs.carousel', function (event) {
                var activeIndex = event.to;
                document.getElementById('currentPage').textContent = (activeIndex + 1);
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.dropdown')) {
                var openDropdowns = document.querySelectorAll('.dropdown-menu.show');
                openDropdowns.forEach(function (dropdown) {
                    var bsDropdown = bootstrap.Dropdown.getInstance(dropdown.previousElementSibling);
                    if (bsDropdown) {
                        bsDropdown.hide();
                    }
                });
            }
        });
    });
</script>