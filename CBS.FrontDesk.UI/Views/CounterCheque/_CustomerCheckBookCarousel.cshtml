@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CustomerData

@if (Model == null || Model.CheckBooks == null || !Model.CheckBooks.Any())
{
    <div class="alert alert-warning text-center">
        <i class="mdi mdi-alert-outline me-1"></i>
        No cheque books found for this customer.
    </div>
}
else
{
    <!-- TOUT LE CAROUSEL -->
    <!-- CUSTOMER INFO -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <h6 class="text-primary mb-1">
                <i class="mdi mdi-account me-1"></i>
                @Model.CustomerDto.FirstName @Model.CustomerDto.LastName
            </h6>
            <small class="text-muted">
                Customer ID : <strong>@Model.CustomerDto.CustomerId</strong>
            </small>
        </div>
    </div>

    <!-- CHECKBOOK CAROUSEL - MODIFIÉ POUR 2 BLOCS PAR PAGE -->
    <div id="customerCheckBookCarousel" class="carousel slide" data-bs-ride="false" data-bs-interval="false">
        <div class="carousel-inner">
            @{
                int itemsPerPage = 2;
                int totalPages = (int)Math.Ceiling((double)Model.CheckBooks.Count / itemsPerPage);

                for (int page = 0; page < totalPages; page++)
                {
                    <div class="carousel-item @(page == 0 ? "active" : "")">
                        <div class="row g-3">
                            @for (int i = page * itemsPerPage; i < (page * itemsPerPage) + itemsPerPage && i < Model.CheckBooks.Count; i++)
                            {
                                var entry = Model.CheckBooks[i];
                                var disabled = entry.CheckBook.RemainingLeaves <= 0;

                                <div class="col-md-6">
                                    <div class="card shadow-sm h-100"
                                         data-checkbook-id="@entry.CheckBook.Id">
                                        <div class="card-body d-flex flex-column">

                                            <!-- HEADER -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="text-primary mb-0">
                                                    <i class="mdi mdi-book-open-page-variant-outline me-1"></i>
                                                    @entry.CheckBook.CheckBookCategory.Name
                                                </h6>

                                                @if (disabled)
                                                {
                                                    <span class="badge bg-danger">Exhausted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                            </div>

                                            <!-- ACCOUNT INFO -->
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Cheque Book Identifier:</small>
                                                    <strong>@entry.CheckBook.Id</strong>
                                                </div>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Account:</small>
                                                    <strong>@entry.CheckBook.AccountNumber</strong>
                                                </div>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Balance:</small>
                                                    <strong class="@(entry.Account.Balance < 0 ? "text-danger" : "text-success")">
                                                        @entry.Account.Balance.ToString("N2")
                                                    </strong>
                                                </div>
                                            </div>

                                            @{
                                                var total = entry.CheckBook.NumberOfLeaves;
                                                var used = entry.CheckBook.UsedLeaves;
                                                var remaining = total - used;
                                            }

                                            <!-- CHECKBOOK STATS -->
                                            <div class="bg-light p-2 rounded mb-3 flex-grow-1">
                                                <div class="row text-center">
                                                    <div class="col-4">
                                                        <div class="small text-muted">Total</div>
                                                        <div class="fw-bold">@entry.CheckBook.NumberOfLeaves</div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="small text-muted">Used</div>
                                                        <div class="fw-bold">@entry.CheckBook.UsedLeaves</div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="small text-muted">Remaining</div>
                                                        <div class="fw-bold @(disabled ? "text-danger" : "text-success")">
                                                            @remaining
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ACTION BUTTON -->
                                            <div class="mt-auto pt-2 d-grid gap-2">
                                                <button type="button"
                                                        class="btn btn-outline-primary view-cheque-btn"
                                                        data-view="grid"
                                                        data-checkbook-id="@entry.CheckBook.Id">
                                                    <i class="mdi mdi-view-grid-outline me-1"></i>
                                                    View Grid
                                                </button>

                                                <button type="button"
                                                        class="btn btn-outline-secondary view-cheque-btn"
                                                        data-view="list"
                                                        data-checkbook-id="@entry.CheckBook.Id">
                                                    <i class="mdi mdi-format-list-bulleted me-1"></i>
                                                    View List
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- CONTROLS -->
        @if (totalPages > 1)
        {
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#customerCheckBookCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button"
                    data-bs-target="#customerCheckBookCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>

            <!-- INDICATORS -->
            <div class="carousel-indicators position-static mt-3">
                @for (int i = 0; i < totalPages; i++)
                {
                    <button type="button"
                            data-bs-target="#customerCheckBookCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Slide @(i + 1)">
                    </button>
                }
            </div>
        }

    </div>

    <!-- PAGE COUNTER -->
    if (totalPages > 1)
    {
        <div class="text-center mt-2 text-muted small">
            Page <span id="currentPage">1</span> of @totalPages
        </div>
    }

    <!-- Conteneur où la partial view _ChequeLeavesGrid sera injectée -->
    <div id="chequeLeavesContainer" class="mt-4">
        <!-- Les feuilles de chèque apparaitront ici -->
    </div>
}

<style>
    .carousel-indicators {
        margin-bottom: 0;
    }

        .carousel-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin: 0 3px;
            background-color: #ccc;
            border: none;
        }

            .carousel-indicators button.active {
                background-color: #0d6efd;
            }

    .card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #dee2e6;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
        }

    .carousel-control-prev,
    .carousel-control-next {
        width: 5%;
        opacity: 0.7;
    }

        .carousel-control-prev:hover,
        .carousel-control-next:hover {
            opacity: 1;
        }


    /* Couleur des flèches */
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: transparent; /* Supprime le fond par défaut */
        background-image: none; /* Supprime l'icône par défaut */
    }

    /* Flèche gauche */
        .carousel-control-prev-icon::after {
            content: '\276E'; /* Unicode flèche gauche ❮ */
            font-size: 2rem;
            color: #0d6efdc7; /* Couleur personnalisée */
        }

    /* Flèche droite */
        .carousel-control-next-icon::after {
            content: '\276F'; /* Unicode flèche droite ❯ */
            font-size: 2rem;
            color: #0d6efdc7; /* Couleur personnalisée */
        }

    /* Facultatif : ajuste l’opacité au hover */
    .carousel-control-prev:hover::after,
    .carousel-control-next:hover::after {
        opacity: 0.8;
    }

</style>

<script>
    // Mettre à jour le compteur de page
    document.addEventListener('DOMContentLoaded', function () {
        var carousel = document.getElementById('customerCheckBookCarousel');
        if (carousel) {
            carousel.addEventListener('slid.bs.carousel', function (event) {
                var activeIndex = event.to;
                document.getElementById('currentPage').textContent = (activeIndex + 1);
            });
        }
    });
</script>