<table id="chequeRequestTable" class="table table-bordered table-striped w-100">
    <thead class="table-light">
        <tr>
            <th>Customer Name</th>
            <th>Category</th>
            <th>Branch</th>
            <th class="text-center">Status</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
</table>


<script>
(function ($) {
    'use strict';

    let chequeTable;

    /* =========================
       Collect Filters
    ========================= */
    function collectChequeFilters() {
        return {
            CustomerId: $('#CustomerId').val() || null,
            CategoryId: $('#CategoryId').val() || null,
            Status: $('#Status').val() || null,
            BranchId: $('#BranchId').val() || null,
            ApprovalDate: $('#ApprovalDate').val() || null,
            StartDate: $('#StartDate').val() || null,
            EndDate: $('#EndDate').val() || null,

            NotifyOnApproval: $('#NotifyOnApproval').is(':checked'),
            NotifyOnClearance: $('#NotifyOnClearance').is(':checked'),
            NotifyOnRejection: $('#NotifyOnRejection').is(':checked'),
            NotifyOnPayment: $('#NotifyOnPayment').is(':checked'),
            NotifyOnAnyTransaction: $('#NotifyOnAnyTransaction').is(':checked'),
            AutomaticRenewal: $('#AutomaticRenewal').is(':checked'),

            DataTableOptions: {}
        };
    }

    /* =========================
       Init DataTable
    ========================= */
    function initChequeRequestTable() {

        chequeTable = $('#chequeRequestTable').DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            destroy: true,
            order: [[0, 'desc']],

            ajax: {
                url: '@Url.Action("LoadChequeBooksData", "ChequeRequest")',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    let filters = collectChequeFilters();
                    filters.DataTableOptions = {
                        draw: d.draw,
                        start: d.start,
                        length: d.length,
                        searchValue: d.search?.value || '',
                        sortColumnName: d.columns[d.order[0].column].data,
                        sortColumnDirection: d.order[0].dir
                    };
                    return JSON.stringify(filters);
                }
            },

            columns: [
                { data: 'CustomerName', name: 'CustomerName' },
                { data: 'CheckBookCategoryName', name: 'CategoryName' },
                {
                    data: 'BranchName',
                    name: 'BranchName',
                    render: d => d || '—'
                },
                {
                    data: 'Status',
                    orderable: false,
                    className: 'text-center',
                    render: s => renderStatusBadge(s)
                },
                {
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    render: (_, __, row) => renderActionMenu(row)
                }
            ]
        });
    }

    /* =========================
       Helpers
    ========================= */
    function renderStatusBadge(status) {
        const map = {
            pending: 'bg-warning text-dark',
            approved: 'bg-success',
            rejected: 'bg-danger',
            delivered: 'bg-info',
            reviewed: 'bg-primary'
        };
        let cls = map[(status || '').toLowerCase()] || 'bg-secondary';
        return `<span class="badge ${cls}">${status || '—'}</span>`;
    }

    function renderActionMenu(row) {
        const id = row.Id;
        const status = (row.Status || '').toLowerCase();
        const name = (row.CustomerName || '').replace(/'/g, "\\'");
        const customerId = row.CustomerId || '';

        let actions = `
            <li>
                <button class="dropdown-item"
                        onclick="viewDetails('${id}')">
                    <i class="mdi mdi-eye-outline me-2 text-primary"></i> Details
                </button>
            </li>`;

        if (status === 'pending') {
            actions += `
            <li><button class="dropdown-item" onclick="showActionModal('review','${id}','${name}','${customerId}','${status}')">Review</button></li>
            <li><button class="dropdown-item" onclick="showActionModal('approve','${id}','${name}','${customerId}','${status}')">Approve</button></li>
            <li><button class="dropdown-item" onclick="showActionModal('reject','${id}','${name}','${customerId}','${status}')">Reject</button></li>`;
        }

        if (status === 'reviewed') {
            actions += `
            <li><button class="dropdown-item" onclick="showActionModal('approve','${id}','${name}','${customerId}','${status}')">Approve</button></li>
            <li><button class="dropdown-item" onclick="showActionModal('reject','${id}','${name}','${customerId}','${status}')">Reject</button></li>`;
        }

        return `
        <div class="dropdown">
            <button class="btn btn-sm btn-info dropdown-toggle" data-bs-toggle="dropdown">
                <i class="mdi mdi-cog"></i> Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                ${actions}
            </ul>
        </div>`;
    }

    /* =========================
       Events
    ========================= */
    $('#applyFilterBtn').on('click', function (e) {
        e.preventDefault();
        if (!chequeTable) initChequeRequestTable();
        else chequeTable.ajax.reload();
    });

    $('#resetFilterBtn').on('click', function (e) {
        e.preventDefault();
        $('#chequeRequestFilterForm')[0].reset();
        $('.form-check-input').prop('checked', false);
        $('[id$="FilterSection"]').hide();

        if (chequeTable) chequeTable.clear().draw();
    });

})(jQuery);
</script>
