@using Resources

<fieldset class="fieldset-custom">
    <legend class="legend-custom">
        <i class="mdi mdi-clipboard-list-outline me-2"></i>
        Issued Counter Cheques
    </legend>

    <!-- =================================================
         FILTERING SECTION
    ================================================== -->
    <div class="card p-3 mb-3 bg-light border">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Client Name/ID</label>
                <input type="text" id="clientFilter" class="form-control" placeholder="Search client...">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList("branchFilter", new SelectList(ViewBag.Branches, "Id", "Name"), "--- All Branches ---", new { @class = "form-control select2" })
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select id="statusFilter" class="form-control select2">
                    <option value="">--- All Statuses ---</option>
                    <option value="Pending">Pending</option>
                    <option value="Reviewed">Reviewed</option>
                    <option value="Validated">Validated</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button id="applyCounterChequeFilterBtn" class="btn btn-primary w-100"><i class="mdi mdi-magnify me-1"></i>Filter</button>
            </div>
        </div>
    </div>

    <!-- =================================================
         DATATABLE
    ================================================== -->
    <div class="table-responsive">
        <table id="counterChequeTable" class="table table-hover" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>Cheque Number</th>
                    <th>Client Name</th>
                    <th>Branch</th>
                    <th class="text-end">Amount</th>
                    <th>Issued On</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data is loaded by server-side AJAX -->
            </tbody>
        </table>
    </div>
</fieldset>

<script>
    // Self-contained script for this partial view
    $(document).ready(function() {

        // --- Initialize Plugins ---
        $('#branchFilter, #statusFilter').select2({ width: '100%' });

        // --- Helper Functions for Rendering ---
        function getStatusBadge(status) {
            if (!status) return "";
            let badgeClass = "bg-secondary";
            switch (status.toLowerCase()) {
                case "pending": badgeClass = "bg-warning text-dark"; break;
                case "reviewed": badgeClass = "bg-info"; break;
                case "validated": badgeClass = "bg-success"; break;
                case "rejected": badgeClass = "bg-danger"; break;
            }
            return `<span class='badge ${badgeClass}'>${status}</span>`;
        }

        function generateActionButtons(row) {
            // Re-use your global showActionModal function for consistency
            const status = (row.Status || '').toLowerCase();
            let buttons = `<a href="#" class="btn btn-sm btn-outline-secondary" onclick="AddORUpdateGen('${row.Id}', 'datalistingview', '_Details', 'get', 'CounterCheque')">Details</a>`;

            if (status === 'pending') {
                buttons += `<a href='#' class="btn btn-sm btn-outline-primary ms-1" onclick="showActionModal('Review', '${row.Id}', '${row.ClientName}')">Review</a>`;
            }
            if (status === 'reviewed') {
                buttons += `<a href='#' class="btn btn-sm btn-outline-success ms-1" onclick="showActionModal('Validate', '${row.Id}', '${row.ClientName}')">Validate</a>`;
                buttons += `<a href='#' class="btn btn-sm btn-outline-danger ms-1" onclick="showActionModal('Reject', '${row.Id}', '${row.ClientName}')">Reject</a>`;
            }
            return `<div class="btn-group btn-group-sm">${buttons}</div>`;
        }

        // --- DataTable Initialization ---
        const dataTable = $('#counterChequeTable').DataTable({
            "processing": true,
            "serverSide": true,
            "searching": false,
            "ajax": {
                "url": "@Url.Action("LoadCounterCheques", "CounterCheque")",
                "type": "POST",
                "data": function (d) {
                    const order = d.order[0] || {};
                    const query = {
                        Options: {
                            draw: d.draw,
                            start: d.start,
                            pageSize: d.length,
                            sortColumnName: d.columns[order.column]?.name,
                            sortDirection: order.dir
                        },
                        // Pass our filter values to the controller
                        ClientFilter: $('#clientFilter').val(),
                        BranchFilter: $('#branchFilter').val(),
                        StatusFilter: $('#statusFilter').val()
                    };
                    return { query: query };
                }
            },
            "columns": [
                { "data": "CheckNumber", "name": "CheckNumber" },
                { "data": "ClientName", "name": "ClientName" },
                { "data": "BranchName", "name": "BranchName" },
                {
                    "data": "Amount", "name": "Amount", "className": "text-end",
                    "render": $.fn.dataTable.render.number(',', '.', 2, '')
                },
                {
                    "data": "IssuedOn", "name": "IssuedOn",
                    "render": function(data) { return data ? new Date(data).toLocaleString() : ''; }
                },
                {
                    "data": "Status", "name": "Status", "orderable": false,
                    "className": "text-center", "render": getStatusBadge
                },
                {
                    "data": null, "orderable": false, "className": "text-center",
                    "render": function(data, type, row) {
                        return generateActionButtons(row);
                    }
                }
            ]
        });

        // --- Event Handlers ---
        $('#applyCounterChequeFilterBtn').on('click', function() {
            dataTable.ajax.reload();
        });
    });
</script>