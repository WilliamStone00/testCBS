@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CustomerCheckBookDisplayDto

<div class="container mt-4">

    <!-- CUSTOMER DETAILS -->
    <h5 class="mt-3 mb-2 fw-bold text-primary">Customer Details</h5>
    <div class="row">
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.CustomerId" readonly />
            <label>Customer ID</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.CustomerName" readonly />
            <label>Customer Name</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.BranchName" readonly />
            <label>Branch Name</label>
        </div>
    </div>

    <!-- CHECKBOOK DETAILS -->
    <h5 class="mt-4 mb-2 fw-bold text-primary">CheckBook Details</h5>
    <div class="row">
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.Id" readonly />
            <label>CheckBook ID</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.AccountId" readonly />
            <label>Account ID</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.AccountNumber" readonly />
            <label>Account Number</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.CheckBookCategoryId" readonly />
            <label>Category ID</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.CheckBookCategory?.Name" readonly />
            <label>Category Name</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.CheckBookCategory?.NumberOfPages" readonly />
            <label>Total Pages</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.UsedLeaves" readonly />
            <label>Pages Used</label>
        </div>
        <div class="col-md-4 mb-3">
            <input class="form-control" value="@Model.RemainingLeaves" readonly />
            <label>Pages Unused</label>
        </div>
    </div>

    <!-- LEAVES TABLE -->
    <h5 class="mt-4 mb-2 fw-bold text-primary">Check Leaves</h5>
    <table id="myDatatable" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Leaf ID</th>
                <th>CheckBook ID</th>
                <th>Counter Check ID</th>
                <th>Serial Number</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const leavesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Leaves));

            // Destroy existing table if it exists
            if ($.fn.DataTable.isDataTable('#myDatatable')) {
                $('#myDatatable').DataTable().clear().destroy();
            }

            // Initialize DataTable
            $('#myDatatable').DataTable({
                data: leavesData,
                responsive: true,
                pageLength: 10,
                order: [[3, 'asc']],
                columns: [
                    { data: 'Id' },
                    { data: 'CheckBookId' },
                    { data: 'CounterCheckId' },
                    { data: 'SerialNumber' },
                    { data: 'Status' }
                ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search leaves...",
                    lengthMenu: "_MENU_ records per page"
                }
            });
        });
    </script>
}
