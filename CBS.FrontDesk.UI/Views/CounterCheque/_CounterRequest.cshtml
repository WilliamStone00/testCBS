@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CounterCheques
@using Resources; 
<div class="modal-body">
    @using (Html.BeginForm(
        "Create",
        "CounterCheque",
        FormMethod.Post,
        new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <!-- HEADER -->
        <div class="row mb-2">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-checkbook me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model?.Id)
                                ? "Create Counter Cheque"
                                : "Update Counter Cheque")
                        </h1>
                        <hr />
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <!-- FORM BODY -->
        <div class="row g-2">
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label>@GlobalUserManagement.Branch</label>
                </div>
            </div>

            <!-- Customer -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.CustomerId, new
                    {
                        @class = "form-control",
                        placeholder = "Customer ID",
                        required = "required"
                    })
                    <label>Customer ID</label>
                    @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Account Number -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.AccountNumber, new
                    {
                        @class = "form-control",
                        placeholder = "Account Number",
                        required = "required"
                    })
                    <label>Account Number</label>
                    @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Amount -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.Amount, new
                    {
                        @class = "form-control",
                        type = "number",
                        step = "0.01",
                        min = "0",
                        required = "required"
                    })
                    <label>Amount</label>
                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                </div>
            </div>

        
            <!-- Check Leaf -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.CheckLeafId, new
                    {
                        @class = "form-control",
                        placeholder = "Cheque Leaf ID",
                        required = "required"
                    })
                    <label>Cheque Leaf ID</label>
                    @Html.ValidationMessageFor(m => m.CheckLeafId, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Check Number -->
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.CheckNumber, new
                    {
                        @class = "form-control",
                        placeholder = "Cheque Number",
                        required = "required"
                    })
                    <label>Cheque Number</label>
                    @Html.ValidationMessageFor(m => m.CheckNumber, "", new { @class = "text-danger" })
                </div>
            </div>




        </div>
        <hr />
        <!-- ACTIONS -->
        <div class="text-end mt-3">
            @if (string.IsNullOrWhiteSpace(Model?.Id))
            {
                <button type="submit" class="btn btn-primary me-2">
                    <i class="mdi mdi-content-save me-1"></i> Save
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    Reset
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary me-2">
                    <i class="mdi mdi-refresh me-1"></i> Update
                </button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    Close
                </button>
            }
        </div>
    }
</div>
