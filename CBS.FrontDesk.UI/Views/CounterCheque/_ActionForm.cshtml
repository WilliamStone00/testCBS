@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CounterChequeActionDto
@using Resources


@using (Html.BeginForm("TakeAction", "CounterCheque", FormMethod.Post, new { id = "counterChequeActionForm", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

    @* These hidden fields carry the necessary data to the controller *@
    @Html.HiddenFor(m => m.CounterChequeId)

    @* The 'showActionModal' script will populate the value of this hidden input *@

<div class="mb-3">
    <p>You are about to take an action on Counter Cheque ID: <strong class="text-primary">@Model.CounterChequeId</strong></p>
    <hr />    <input type="hidden" name="Action" />

    <label for="Motive" class="form-label fw-bold">Please provide a motive, reason, or note for this action:</label>
    @Html.TextAreaFor(m => m.Motive, new
    {
        @class = "form-control",
        rows = "4",
        required = "required",
        placeholder = "e.g., 'Customer verified in person.' or 'Signature mismatch.'"
    })
    @Html.ValidationMessageFor(m => m.Motive, "", new { @class = "text-danger" })
</div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="mdi mdi-close me-1"></i> Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="mdi mdi-check-circle-outline me-1"></i> Submit Action
        </button>
    </div>
}