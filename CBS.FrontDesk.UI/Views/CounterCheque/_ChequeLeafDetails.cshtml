@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CheckBookLeaf
@using Resources
<div class="modal-header">
    <h5 class="modal-title text-primary">
        <i class="mdi mdi-file-document-outline me-1"></i>
        @GlobalCounterCheque.Cheque_Leaf #@Model.SerialNumber.ToString("D3")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <table class="table table-sm table-bordered align-middle">
        <tbody>
            <tr>
                <th>@GlobalShared.Status</th>
                <td>
                    <span class="badge @(Model.Status == "Available" ? "bg-success" : "bg-warning")">
                        @Model.Status
                    </span>
                </td>
            </tr>

            <tr>
                <th>@GlobalShared.CheckBook_ID</th>
                <td>@Model.CheckBookId</td>
            </tr>

            <tr>
                <th>@GlobalShared.Serial_Number</th>
                <td>@Model.SerialNumber.ToString("D3")</td>
            </tr>

            <tr>
                <th>@GlobalShared.Issued_Date</th>
                <td>
                    @(Model.IssuedDate.HasValue
                        ? Model.IssuedDate.Value.ToString("dd/MM/yyyy HH:mm")
                        : "-")
                </td>
            </tr>

            <tr>
                <th>Issued To</th>
                <td>@(string.IsNullOrEmpty(Model.IssuedTo) ? "-" : Model.IssuedTo)</td>
            </tr>

            <tr>
                <th>@GlobalShared.Created Date</th>
                <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
        <i class="mdi mdi-close"></i> @GlobalShared.Close
    </button>
</div>
