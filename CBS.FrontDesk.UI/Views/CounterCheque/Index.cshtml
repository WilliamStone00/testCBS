@{ ViewBag.Title = "Counter Cheque Issuance"; }
@using Resources

<!-- =================================================
     PAGE HEADER
================================================== -->
<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-cash-fast me-2"></i> Member Cheque  Management Console
        </h1>
        <p class="card-text text-muted mb-1">
            Issue on-the-spot counter cheques for immediate customer withdrawals and manage the validation workflow.
        </p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            <strong>Default View:</strong> The form to issue a new counter cheque is loaded by default.
        </div>
        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
    </div>
</div>


<!-- =================================================
     TIPS SECTION
================================================== -->
<div class="card mb-4">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> Tips for Issuing Counter Cheques</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ol class="list-group list-group-numbered">
                <li class="list-group-item"><strong>Issue New Cheque:</strong> Use the default form to issue a new counter cheque. You must provide a valid Client ID, their Account Number, and the withdrawal Amount.</li>
                <li class="list-group-item"><strong>View History:</strong> Click "View All Counter Cheques" to see a complete, filterable history of all issued cheques.</li>
                <li class="list-group-item"><strong>Action Workflow:</strong> Cheques require approval. From the list view, use the 'Actions' column to `Review`, `Validate` (approve), or `Reject` a pending cheque. Each action requires a motive or note.</li>
            </ol>
        </div>
    </div>
</div>


<!-- =================================================
     MAIN CONTENT AREA
================================================== -->
<div class="card shadow p-3 mb-4">
    <!--<div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">-->
    <!-- These buttons correctly call your site's generic JavaScript functions -->
    <!--<a type="button" onclick="LoadDataGen('CounterCheque', 'myDataTable', '_DataTable', 0, 'datalistingview', null, 'list')" class="btn btn-label-primary btn-sm me-2">View All</a>
            <a type="button" onclick="AddORUpdateGen(null, 'datalistingview', '_Create', 'new', 'CounterCheque')" class="btn btn-label-secondary btn-sm">New Counter Cheque</a>
        </div>
    </div>-->
    <!-- The container where all partial views will be dynamically loaded -->
    <div id="datalistingview2">
        @Html.Partial("_Create", new CBS.FrontDesk.Data.Entity.CheckManagementSystem.Operations.CounterCheque.CounterCheques())
    </div>

    <div id="statisticsContainer" class="mt-3"></div>

    <div id="datalistingview1" class="mt-3"></div>


</div>

<!-- =================================================
     MODAL PLACEHOLDER FOR ACTIONS
================================================== -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="actionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Take Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="actionModalBody">
                <!-- The _ActionForm.cshtml partial is loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- GLOBAL DETAILS MODAL (single placeholder for all detail partials) -->
<div id="viewReceiptModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="receiptModalContainer">
            <!-- Partial HTML will be injected here -->
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    (function ($) {
        'use strict';
        $(document).ready(function () {
            // Variable pour stocker le customerId actuel
            let currentCustomerId = '';

            // Stocker le HTML initial du formulaire
            let initialFormHtml = $("#datalistingview").html();

            // Search Customer
            $(document).on("click", "#searchCustomerBtn", function () {
                searchCustomer();
            });

            $(document).on("keypress", "#customerIdInput", function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    searchCustomer();
                }
            });

            //function searchCustomer() {
            //    let customerId = $("#customerIdInput").val().trim();

            //    if (!customerId) {
            //        appalert("Please enter a Customer ID", 3, 1);
            //        return;
            //    }

            //    // Stocker le customerId actuel
            //    currentCustomerId = customerId;

            //    $.ajax({
            //        url: '/CounterCheque/Search',
            //        type: 'GET',
            //        data: { CustomerId: customerId },
            //        success: function (partialView) {
            //            // Remplacer le contenu de datalistingview par le carrousel
            //            $("#datalistingview").html(partialView);
            //            appalert("Customer cheque books loaded successfully", 1, 1);
            //        },
            //        error: function (err) {
            //            // Réinitialiser l'affichage
            //            $("#datalistingview").html(initialFormHtml);

            //            if (err.status === 404) {
            //                appalert("No cheque books found for this customer", 3, 1);
            //            } else if (err.status === 400) {
            //                appalert("Invalid customer ID format", 3, 1);
            //            } else if (err.status === 500) {
            //                appalert("Server error occurred", 0, 1);
            //            } else if (err.status === 401) {
            //                window.location.href = '/Authentication/Login';
            //            } else {
            //                appalert("Unexpected error occurred", 0, 1);
            //            }
            //        },
            //        complete: function () {
            //            $("#searchCustomerBtn").prop("disabled", false);
            //            $("#searchCustomerBtn").html('<i class="mdi mdi-magnify"></i> Search');
            //        }
            //    });
            //}

            function searchCustomer() {
                let customerId = $("#customerIdInput").val().trim();

                if (!customerId) {
                    appalert("Please enter a Customer ID", 3, 1);
                    return;
                }

                // Store current customerId
                currentCustomerId = customerId;

                // Disable button and show loading
                $("#searchCustomerBtn").prop("disabled", true);
                $("#searchCustomerBtn").html('<i class="mdi mdi-loading mdi-spin"></i> Loading...');

                // Clear previous content
                $("#statisticsContainer").empty();
                $("#chequeLeavesContainer").empty();

                // Create a counter to track both requests
                let completedRequests = 0;
                const totalRequests = 2;
                let hasError = false;

                // Function to check if all requests are done
                function checkAllRequestsComplete() {
                    completedRequests++;
                    if (completedRequests === totalRequests) {
                        $("#searchCustomerBtn").prop("disabled", false);
                        $("#searchCustomerBtn").html('<i class="mdi mdi-magnify"></i> Search');

                        if (!hasError) {
                            appalert("Customer data loaded successfully", 1, 1);
                        }
                    }
                }

                // Load Statistics
                $.ajax({
                    url: '/CounterCheque/GetCustomerStatistics',
                    type: 'GET',
                    data: { customerId: customerId },
                    success: function (statsHtml) {
                        $("#datalistingview2").html(statsHtml);
                        // Initialize collapse functionality
                        $('.collapse').collapse();
                    },
                    error: function (err) {
                        hasError = true;
                        let errorMsg = "Error loading statistics: ";
                        if (err.status === 404) {
                            errorMsg += "No statistics found";
                        } else if (err.status === 400) {
                            errorMsg += "Invalid customer ID";
                        } else {
                            errorMsg += "Server error occurred";
                        }
                        $("#datalistingview2").html(`
                <div class="alert alert-warning">
                    <i class="mdi mdi-alert-outline me-1"></i>
                    ${errorMsg}
                </div>
            `);
                    },
                    complete: function () {
                        checkAllRequestsComplete();
                    }
                });

                // Load Cheque Books (existing functionality)
                $.ajax({
                    url: '/CounterCheque/Search',
                    type: 'GET',
                    data: { CustomerId: customerId },
                    success: function (partialView) {
                        $("#datalistingview1").html(partialView);
                    },
                    error: function (err) {
                        hasError = true;
                        // Reset display
                        $("#datalistingview1").html(initialFormHtml);

                        let errorMsg = "Error loading cheque books: ";
                        if (err.status === 404) {
                            errorMsg += "No cheque books found";
                        } else if (err.status === 400) {
                            errorMsg += "Invalid customer ID format";
                        } else if (err.status === 500) {
                            errorMsg += "Server error occurred";
                        } else if (err.status === 401) {
                            window.location.href = '/Authentication/Login';
                            return;
                        } else {
                            errorMsg += "Unexpected error occurred";
                        }

                        appalert(errorMsg, 3, 1);
                    },
                    complete: function () {
                        checkAllRequestsComplete();
                    }
                });
            }

            // BOUTON POUR REVENIR AU CAROUSEL
            $(document).on("click", "#backToSearchBtn", function () {
                // Recharger les chéquiers du client
                loadCustomerChequeBooks(currentCustomerId);
            });

            // Fonction pour charger les chéquiers d'un client
            function loadCustomerChequeBooks(customerId) {
                if (!customerId) return;

                $.ajax({
                    url: '/CounterCheque/Search',
                    type: 'GET',
                    data: { CustomerId: customerId },
                    success: function (partialView) {
                        $("#datalistingview").html(partialView);
                    },
                    error: function (err) {
                        $("#datalistingview").html(initialFormHtml);
                        appalert("Error loading cheque books", 0, 1);
                    }
                });
            }

            // BOUTON POUR REVENIR AU FORMULAIRE INITIAL
            $(document).on("click", "#backToInitialBtn", function () {
                $("#datalistingview").html(initialFormHtml);
                currentCustomerId = '';
            });
        });

        // Fonction pour recharger le formulaire initial (utilisée depuis d'autres parties de l'app)
        window.reloadInitialForm = function() {
            $("#datalistingview").html(initialFormHtml);
            currentCustomerId = '';
        };

        window.showActionModal = function(action, id) {
            const url = `@Url.Action("InitializeData", "CounterCheque")`;
            const $modalBody = $('#actionModalBody');

            $('#actionModalLabel').text(`${action} Counter Cheque`);

            // Show a loader while we fetch the form
            $modalBody.html('<div class="text-center p-4"><div class="spinner-border text-primary"></div></div>');
            $('#actionModal').modal('show');

            // Load the _ActionForm partial into the modal body
            $modalBody.load(`${url}?partialView=_ActionForm&path=action&KEY=${id}`, function() {
                // After loading, find the hidden 'action' input inside the form and set its value
                $(this).find('input[name="Action"]').val(action);
            });
        };

        // QUAND ON CLIQUE SUR "USE THIS CHECKBOOK"
        $(document).on("click", ".view-cheque-btn", function () {
            const chequeBookId = $(this).data("checkbook-id");
            const viewType = $(this).data("view"); // grid | list

            if (!chequeBookId || !viewType) return;

            $.ajax({
                url: '/CounterCheque/GetChequeLeaves',
                type: 'GET',
                data: {
                    chequeBookId: chequeBookId,
                    viewType: viewType
                },
                success: function (partialView) {
                    $("#chequeLeavesContainer")
                        .html(partialView)
                        .fadeIn();

                    $('html, body').animate({
                        scrollTop: $("#chequeLeavesContainer").offset().top - 20
                    }, 500);
                },
                error: function () {
                    appalert("Error loading cheque leaves", 0, 1);
                }
            });
        });

        // ===== VIEW MORE / VIEW LESS =====
        $(document).on("click", "#toggleLeavesBtn", function () {

            const $btn = $(this);
            const isExpanded = $btn.data("expanded") === true;

            if (!isExpanded) {
                // VIEW MORE
                $(".cheque-leaf-item.d-none").each(function (index) {
                    $(this).delay(40 * index).fadeIn(200).removeClass("d-none");
                });

                $btn.text("View Less").data("expanded", true);

            } else {
                // VIEW LESS
                $(".cheque-leaf-item").each(function (index) {
                    if (index >= 16) {
                        $(this).fadeOut(150, function () {
                            $(this).addClass("d-none").show();
                        });
                    }
                });

                $btn.text("View More").data("expanded", false);

                $('html, body').animate({
                    scrollTop: $("#chequeLeavesGrid").offset().top - 100
                }, 300);
            }
        });

        $(document).on("click", ".view-leaf-btn", function () {
            const leafId = $(this).data("leaf-id");

            if (!leafId) return;

            const $modal = $("#viewReceiptModal");
            const $container = $("#receiptModalContainer");

            $modal.modal("show");

            $.ajax({
                url: '/CounterCheque/GetChequeLeafDetails',
                type: 'GET',
                data: { leafId: leafId },
                success: function (html) {
                    $container.html(html);
                },
                error: function () {
                    $container.html(`
                <div class="modal-body">
                    <div class="alert alert-danger">
                        Failed to load cheque leaf details.
                    </div>
                </div>
            `);
                }
            });
        });

         /* ================================
           ACTION MODAL (GLOBAL)
        ================================= */

        window.showActionModal = function (action, id) {
            const url = '@Url.Action("InitializeData", "CounterCheque")';
            const modalEl = document.getElementById('actionModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            $('#actionModalLabel').text(`${action} Counter Cheque`);
            $('#actionModalBody').html('<div class="text-center p-4"><div class="spinner-border text-primary"></div></div>');

            modal.show();

            $('#actionModalBody').load(`${url}?partialView=_ActionForm&path=action&KEY=${id}`, function () {
                $(this).find('input[name="Action"]').val(action);
            });
        };


        /* ================================
            DATA TABLE
        ================================= */

        var counterChequeTable = null;

        window.initCounterChequeTable = function () {

            if ($.fn.DataTable.isDataTable('#counterChequeTable')) return;

            counterChequeTable = $('#counterChequeTable').DataTable({
                serverSide: true,
                responsive: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/CounterCheque/LoadCounterCheques',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        // transformer l'objet DataTables en ce que le backend attend
                        return JSON.stringify({
                            DataTableOptions: {
                                draw: d.draw,
                                start: d.start,
                                length: d.length,
                                searchValue: d.search.value,
                                sortColumnName: d.columns[d.order[0].column].data,
                                sortColumnDirection: d.order[0].dir
                            }
                        });
                    },
                    dataSrc: 'data' // 🔑 DataTables va chercher les lignes ici
                },
                columns: [
                    {
                        data: 'IssuedOn',
                        render: d => d ? moment(d).format('DD/MM/YYYY HH:mm') : '-'
                    },
                    { data: 'CustomerName', defaultContent: '-' },
                    { data: 'AccountNumber', defaultContent: '-' },
                    { data: 'CheckNumber', defaultContent: '-' },
                    { data: 'Amount', render: v => v ? v.toFixed(2) : '0.00' },
                    {
                        data: 'Status',
                        render: s => {
                            if (!s) return '-';
                            const map = { pending: 'warning', approved: 'success', rejected: 'danger' };
                            return `<span class="badge bg-${map[s.toLowerCase()] || 'secondary'}">${s}</span>`;
                        }
                    },
                    { data: 'IssuedBy', defaultContent: '-' },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: id => `
                <div class="dropdown text-center">
                    <button class="btn btn-sm btn-info dropdown-toggle text-white" data-bs-toggle="dropdown">
                        Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" onclick="showActionModal('Details','${id}')"><i class="mdi mdi-eye"></i> View Details</button></li>
                    </ul>
                </div>`
                    }
                ],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                language: {
                    emptyTable: "No counter cheques found"
                }
            });

        }

})(jQuery);
</script>
}