@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
@using Resources
<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <div id="dashboardSummary" class="mb-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalSalaryAnalyzer.TotalMembers</h5>
                            <p class="card-text fs-4 fw-bold text-info">
                                @Model.SalaryUploadModelSummaryDto.TotalMembers.ToString("N0")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalSalaryAnalyzer.TotalNetSalary</h5>
                            <p class="card-text fs-4 fw-bold text-success">
                                @Model.SalaryUploadModelSummaryDto.TotalNetSalary.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div id="datalistingview_inner">
            <div class="table-responsive mb-3">
                @if (Model.SalaryUploadModels != null && Model.SalaryUploadModels.Any())
                {
                    <table class="table table-hover" id="myDataTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@GlobalSalaryAnalyzer.Matricule</th>
                                <th>@GlobalSalaryAnalyzer.Surname</th>
                                <th>@GlobalSalaryAnalyzer.Name</th>
                                <th>@GlobalSalaryAnalyzer.NetSalary</th>
                                <th>@GlobalSalaryAnalyzer.UploadDate</th>
                                <th>@GlobalSalaryAnalyzer.UploadedBy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 0;
                            }
                            @foreach (var salary in Model.SalaryUploadModels)
                            {
                                ++@rowNumber;
                            <tr>
                                <td>@rowNumber</td>
                                <td>@salary.Matricule</td>
                                <td>@salary.Surname</td>
                                <td>@salary.Name</td>
                                <td>@salary.NetSalary.ToString("N1")</td>
                                <td>@salary.Date.ToString("dd/MM/yyyy")</td>
                                <td>@salary.UploadedBy</td>
                            </tr>

                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center my-3">
                        <p>@GlobalSalaryAnalyzer.NoSalaryUploadsFound.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
