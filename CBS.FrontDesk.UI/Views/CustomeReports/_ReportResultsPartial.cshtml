<div class="card shadow-sm mt-3 border-0">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
        <h6 class="text-primary fw-semibold mb-0">
            <i class="mdi mdi-file-table-box-multiple-outline me-2"></i>Generated Reports
        </h6>

        <span class="badge bg-light text-muted px-3 py-2">
            1 report
        </span>
    </div>

    <div class="card-body">

        <style>
            /* ===============================
               PROFESSIONAL QUICKBOOKS TABLE UI
               =============================== */

            .qb-table {
                border: 1px solid #e2e5e9;
                border-radius: 6px;
                font-size: 0.92rem;
                overflow: hidden;
                background-color: #ffffff;
            }

                /* SILVER HEADER */
                .qb-table thead {
                    background: #d9d9d9; /* clean silver */
                    border-bottom: 1px solid #c5c5c5;
                }

                .qb-table th {
                    padding: 12px 16px;
                    color: #2f2f2f;
                    font-weight: 600;
                    white-space: nowrap;
                }

                .qb-table td {
                    padding: 12px 16px;
                    color: #4b5563;
                    border-bottom: 1px solid #f1f1f1;
                    vertical-align: middle;
                }

                .qb-table tbody tr:hover {
                    background: #eef2f7;
                    transition: 0.18s ease-in-out;
                }

            /* SKY BLUE DOWNLOAD BUTTON */
            .qb-download-btn {
                padding: 8px 18px;
                border-radius: 6px;
                background: #4da6ff; /* sky blue */
                color: #ffffff;
                font-size: 0.85rem;
                text-decoration: none;
                font-weight: 600;
                display: inline-block;
                border: none;
            }

                .qb-download-btn:hover {
                    background: #1d8bff;
                    transition: 0.18s;
                }
        </style>

        <div class="table-responsive">
            <table class="w-100">
                @*<thead>
                    <tr>
                        <th style="width: 50px">#</th>
                        <th>Report Type</th>
                        <th>Date Range</th>
                        <th>Generated On</th>
                        <th class="text-center" style="width: 140px">Download</th>
                    </tr>
                </thead>*@

                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Account Statement</td>
                        <td>Jan 01 – Jan 31</td>
                        <td>Mar 04, 2025</td>
                        <td class="text-center">
                            <a href="#" class="qb-download-btn">Download</a>
                        </td>
                    </tr>
                </tbody>

            </table>
        </div>

    </div>
</div>
