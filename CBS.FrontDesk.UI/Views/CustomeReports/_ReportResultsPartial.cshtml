@{
    var hasReport = Session["rptSource"] != null || Session["rptType"] != null;
}

@if (hasReport)
{
    <div class="card shadow-sm mt-3 border-0">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h6 class="text-primary fw-semibold mb-0">
                <i class="mdi mdi-file-table-box-multiple-outline me-2"></i>Generated Reports
            </h6>

            <span class="badge bg-light text-muted px-3 py-2">
                @Model?.Count() ?? 0 reports
            </span>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-warning text-center mb-0 py-4">
                    <i class="mdi mdi-alert-outline me-2"></i>
                    No reports generated yet.
                </div>
            }
            else
            {
                <style>
                    /* ===============================
                       PROFESSIONAL QUICKBOOKS TABLE UI
                       =============================== */
                    .qb-table {
                        border: 1px solid #e2e5e9;
                        border-radius: 6px;
                        font-size: 0.92rem;
                        overflow: hidden;
                        background-color: #ffffff;
                    }

                    .qb-table thead {
                        background: #f3f4f6;
                        border-bottom: 1px solid #e1e4e8;
                    }

                    .qb-table th {
                        padding: 12px 16px;
                        color: #374151;
                        font-weight: 600;
                        white-space: nowrap;
                    }

                    .qb-table td {
                        padding: 12px 16px;
                        color: #4b5563;
                        border-bottom: 1px solid #f1f1f1;
                        vertical-align: middle;
                    }

                    .qb-table tbody tr:nth-child(even) {
                        background-color: #fafafa;
                    }

                    .qb-table tbody tr:hover {
                        background: #eef2f7;
                        transition: 0.18s ease-in-out;
                    }

                    .qb-download-btn {
                        padding: 6px 14px;
                        border-radius: 4px;
                        border: 1px solid #cfd4d9;
                        background: #ffffff;
                        color: #1f4e79;
                        font-size: 0.85rem;
                        text-decoration: none;
                        display: inline-block;
                    }

                    .qb-download-btn:hover {
                        background: #1f4e79;
                        color: #ffffff;
                        border-color: #1f4e79;
                        transition: 0.18s;
                    }
                </style>

                <div class="table-responsive">
                    <table class="qb-table w-100">
                        <thead>
                            <tr>
                                <th style="width: 50px">#</th>
                                <th>Report Type</th>
                                <th>Date Range</th>
                                <th>Size</th>
                                <th>Generated On</th>
                                <th class="text-center" style="width: 120px">Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* your foreach loop here *@
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center mt-3 py-4">
        <i class="mdi mdi-information-outline me-2"></i>
        No report data in session. Generate a report to view results.
    </div>
}
