

<div class="card shadow-sm mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="text-primary mb-0">
            <i class="mdi mdi-file-table-box-multiple-outline me-2"></i> Generated Reports
        </h6>
        <span class="badge bg-light text-muted">@Model?.Count() ?? 0 reports</span>
    </div>

    <div class="card-body">

        <!-- Loading Spinner -->
        <div id="reportLoading" class="text-center py-5 d-none">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Generating report, please wait...</p>
        </div>

        <!-- Empty State -->
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning text-center mb-0">
                <i class="mdi mdi-alert-outline me-2"></i>No reports generated yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Report Type</th>
                            <th>Date Range</th>
                            <th>Size</th>
                            <th>Generated On</th>
                            <th class="text-center">Download</th>
                        </tr>
                    </thead>
                    <tbody>
                        @*@foreach (var item in Model.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr>
                                <td>@item.Index</td>
                                <td class="fw-semibold text-primary">@item.Data.ReportType</td>
                                <td>@item.Data.DateFrom:dd MMM yyyy - @item.Data.DateTo:dd MMM yyyy</td>
                                <td>@item.Data.FileSize</td>
                                <td>@item.Data.GeneratedDate:dd MMM yyyy HH:mm</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href="@item.Data.PdfUrl" class="btn btn-outline-danger btn-sm" target="_blank" title="Download PDF">
                                            <i class="mdi mdi-file-pdf-outline"></i>
                                        </a>
                                        <a href="@item.Data.ExcelUrl" class="btn btn-outline-success btn-sm" target="_blank" title="Download Excel">
                                            <i class="mdi mdi-file-excel-outline"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }*@
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Example: show spinner while loading reports dynamically
        function showLoading(isLoading) {
            const spinner = document.getElementById("reportLoading");
            spinner.classList.toggle("d-none", !isLoading);
        }

        // Example AJAX usage
        $("#reportFilterForm").on("submit", function (e) {
            e.preventDefault();
            showLoading(true);

            $.ajax({
                url: '/Reports/Generate',
                type: 'GET',
                data: $(this).serialize(),
                success: function (data) {
                    $("#reportResults").html(data);
                },
                complete: function () {
                    showLoading(false);
                }
            });
        });
    </script>
}
