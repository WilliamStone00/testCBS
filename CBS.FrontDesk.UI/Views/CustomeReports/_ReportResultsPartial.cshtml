

@{
    var hasReport = Session["rptSource"] != null || Session["rptType"] != null;
}

@if (hasReport)
{
    <div class="card shadow-sm mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0">
                <i class="mdi mdi-file-table-box-multiple-outline me-2"></i> Generated Reports
            </h6>
            <span class="badge bg-light text-muted">@Model?.Count() ?? 0 reports</span>
        </div>

        <div class="card-body">

            <!-- Loading Spinner -->
            <div id="reportLoading" class="text-center py-5 d-none">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted">Generating report, please wait...</p>
            </div>

            <!-- Empty State -->
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-warning text-center mb-0">
                    <i class="mdi mdi-alert-outline me-2"></i>No reports generated yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Report Type</th>
                                <th>Date Range</th>
                                <th>Size</th>
                                <th>Generated On</th>
                                <th class="text-center">Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* your foreach loop here *@
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center mt-3">
        <i class="mdi mdi-information-outline me-2"></i>No report data in session. Generate a report to view results.
    </div>
}


