            const selectedBranches = $('#BranchId').val() || [];
            const selectedAccounts = $('#AccountId').val() || [];

            return {
                from: $('#StartDate').val(),
                to: $('#EndDate').val(),
                dateFrom: $('#StartDate').val(),
                dateTo: $('#EndDate').val(),
                branchId: selectedBranches.length === 1 ? selectedBranches[0] : null,
                selectedBranchIds: selectedBranches,
                consolidated: $('#IsConsolidated').is(':checked'),
                IncludeAllAccountsInTB: $('#IncludeAllAccountsInTB').is(':checked'),
                accountingYear: $('#ToggleAccountingYear').is(':checked') ? $('#AccountingYear').val() : null,
                excludeLiaisonInternal: $('#IsLiaison').is(':checked'),
                sourceMode: $('#SourceMode').val(),
                language: "en",
                downloadExcel: true,
                includeZeroGlAccount: $('#IncludingZero').is(':checked'),
                accountNumber: selectedAccounts.length === 1 ? selectedAccounts[0] : null,
                accountNumbers: selectedAccounts,
                paging: { page: 0, pageSize: 0 },
                sorting: { sortBy: null, sortDir: null }
            };
        }

