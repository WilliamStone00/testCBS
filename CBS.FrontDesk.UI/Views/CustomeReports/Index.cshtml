        // 🔹 UPDATED: Supports MULTIPLE rows + buttons changed to LINKS
        function loadReportToTable(response, reportTypeValue) {

            $('#clearButtonWrapper').removeClass('d-none');

            const selectedReport = $('#ReportType').val();

            const reportMap = {
                "Trial Balance 6 Columns": "TB_6",
                "Trial Balance 4 Columns": "TB_4"
               
            };

            const reportName = reportMap[selectedReport] || selectedReport; // gets the value, not text
            const sourceMode = $('#SourceMode').val(); // gets "Temp" or "Reconciled"
            /*const files = response?.files || [];*/

            let files = response?.files || [];

            // ✅ Sort by date (newest first)
            files.sort((a, b) => {

                function extractDate(fileName) {
                    const nameWithoutExt = fileName.replace('.xlsx', '');
                    const parts = nameWithoutExt.split('_');

                    if (parts.length >= 3) {
                        const len = parts.length;
                        const year = parts[len - 3];
                        const month = parts[len - 2];
                        const day = parts[len - 1];

                        return new Date(`${year}-${month}-${day}`);
                    }

                    return new Date(0); // fallback if no date
                }

                const dateA = extractDate(a.FileName || '');
                const dateB = extractDate(b.FileName || '');

                return dateB - dateA; // 🔥 newest first
            });

            if (!files.length) {

                $('#reportTableBody').html(`
        <tr>
            <td colspan="7" class="text-center">
                No files available
            </td>
        </tr>
    `);

                $('#clearButtonWrapper').removeClass('d-none');
                $('#reportTableContainer').removeClass('d-none'); // show container to display message
                return;
            }
            let rowsHtml = '';
            let controllerName = '';

            switch (reportTypeValue.toLowerCase()) {
                case 'trial balance 6 columns':
                    controllerName = 'TrialBalance6Columns';
                    break;
                case 'trial balance 4 columns':
                    controllerName = 'TrialBalance4Columns';
                    break;
                case 'account statement':
                    controllerName = 'AccntStatement';
                    break;
                case 'bs':
                    controllerName = 'BalanceSheet';
                    break;
                case 'je':
                    controllerName = 'JournalEntries';
                    break;
                default:
                    controllerName = 'TrialBalance6Columns';
            }

            files.forEach(fileObj => {
                const file = fileObj.FileName || '';
                const branchName = fileObj.Name || '';
                const fileSize = fileObj.fileSize || '';

                // Remove extension safely
                const nameWithoutExt = file.replace('.xlsx', '');
                const parts = nameWithoutExt.split('_');

                let formattedDate = '';

                // ✅ Extract last 3 parts as date: yyyy_MM_dd
                if (parts.length >= 3) {
                    const len = parts.length;
                    const year = parts[len - 3];
                    const month = parts[len - 2];
                    const day = parts[len - 1];

                    formattedDate = `${day}/${month}/${year}`;
                }

                rowsHtml += `
        <tr>
            <td>${formattedDate}</td>
            <td>${branchName}</td>
            <td>${file}</td>
            <td>${fileSize}</td>
            <td>${reportName}</td>
            <td>${sourceMode}</td>
            <td class="actions-cell text-center">
                <div class="actions-container">
                    <a href="javascript:void(0)"
                       class="btnExcel"
                       data-controller="${controllerName}"
                       data-file="${file}">
                        <i class="mdi mdi-file-excel-outline"></i> Excel
                    </a>

                    <span class="action-separator"></span>

                    <a href="javascript:void(0)"
                       class="report-action-link btnPdf"
                       data-controller="${controllerName}">
                        <i class="mdi mdi-file-pdf-box"></i> PDF
                    </a>
                </div>
            </td>
        </tr>
    `;
            });
            $('#reportTableBody').html(rowsHtml);

            // Excel Download
            $('.btnExcel').off().on('click', function () {
                const controller = $(this).data('controller');
                const file = $(this).data('file');
                window.location = `/${controller}/Download?file=${encodeURIComponent(file)}`;
            });

            // PDF Reprint
            $('.btnPdf').off().on('click', function () {
                const controller = $(this).data('controller');
                Reprint(controller);
            });
        }
        $(document).ready(function () {

            $(document).ajaxError(function (event, xhr, settings, thrownError) {

                let message = "⚠️ An unexpected error occurred.";

                // If backend returns Json({ success:false, message:"..." })
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }
                // If server returns text error (500 page, etc.)
                else if (xhr.responseText) {
                    message = xhr.responseText;
                }

                appalert(message, 2, 1);
            });


            const $branch = $('#BranchId');
            const $reportType = $('#ReportType');
            const $accountDropdown = $('#AccountId');
            const $account_group = $('.account_group');
            const $btn = $('#btnGetCommission');
            const $requiresBranch = $('.requires-branch');

            // Toggle Accounting Year visibility
            $('#ToggleAccountingYear').on('change', function () {
                const show = this.checked;
                $('.accounting-year-group').toggleClass('d-none', !show);
            });

            // Validate Filter button state
                    function validateFilters() {
                        const branchSelected = $branch.val() && $branch.val().length > 0;
                        const hasReportType = $reportType.val();
                        const hasSource = $('#SourceMode').val();
                        const startDateVal = $('#StartDate').val();
                        const endDateVal = $('#EndDate').val();

                        let dateValid = true;

                        if (startDateVal && endDateVal) {

                            const fromDate = new Date(startDateVal);
                            const toDate = new Date(endDateVal);
                            const today = new Date();

                            // 🔹 Remove time from ALL dates
                            fromDate.setHours(0, 0, 0, 0);
                            toDate.setHours(0, 0, 0, 0);
                            today.setHours(0, 0, 0, 0);

                            // ❌ FromDate > ToDate
                            if (fromDate > toDate) {
                                appalert('⚠️ From Date cannot be greater than To Date.', 2, 1);
                                dateValid = false;
                            }

                            // ❌ ToDate in the future (BUT today is allowed)
                            else if (toDate > today) {
                                appalert('⚠️ To Date cannot be greater than today.', 2, 1);
                                dateValid = false;
                            }

                            // ❌ Dates must NOT be before 2025
                            else if (fromDate.getFullYear() < 2025 || toDate.getFullYear() < 2025) {
                                appalert('⚠️ Dates cannot be earlier than year 2025.', 2, 1);
                                dateValid = false;
                            }
                        }

                        const ok = branchSelected && hasReportType && hasSource && startDateVal && endDateVal && dateValid;

                        $btn.prop('disabled', !ok).toggleClass('disabled', !ok);

                        return ok;
                    }            // Show/hide rows that depend on branch selection
            function toggleBranchDependentFields() {
                const hasBranch = $branch.val() && $branch.val().length > 0;

                $requiresBranch.toggleClass('d-none', !hasBranch);
                $('.date_range_group').toggleClass('d-none', !hasBranch);

                if (!hasBranch) {
                    // Clear dependent selections when branch is removed
                    $reportType.val(null).trigger('change');
                    $('#SourceMode').val(null).trigger('change');
                    $accountDropdown.empty();
                    $account_group.addClass('d-none');
                    $('#IsConsolidated').prop('checked', false);
                    $('#IsLiaison').prop('checked', false);
                    $('#IsInterbranch').prop('checked', false);

                    // Reset accounting year toggle + dropdown visibility
                    $('#ToggleAccountingYear').prop('checked', false);
                    $('.accounting-year-group').addClass('d-none');
                }

                validateFilters();
            }

            // Load accounts when needed
            function loadAccountsIfNeeded() {
                const branches = $branch.val();
                let reportTypeVal = ($reportType.val() || "").trim().toLowerCase();

                const hasBranch = branches && branches.length > 0;
                const loadsAccounts = reportTypeVal === "account statement" || reportTypeVal === "general ledger";

                if (!(hasBranch && loadsAccounts)) {
                    $account_group.addClass('d-none');
                    $accountDropdown.empty();
                    return;
                }

                $.ajax({
                    url: '/CustomeReports/loadAccountById/',
                    type: 'POST',
                    data: { branchId: branches },
                    success: function (response) {
                        const data = response.results || [];
                        $accountDropdown.empty().append('<option value="">--- Select Account ---</option>');

                        $.each(data, function (i, item) {
                            $accountDropdown.append(
                                `<option value="${item.Code}">${item.Name}</option>`
                            );
                        });

                        $account_group.removeClass('d-none');
                    }
                });
            }

            // Event bindings
            $branch.on('change', function () {
                toggleBranchDependentFields();
                loadAccountsIfNeeded();

                if ($branch.val() && $branch.val().length > 1) {
                    $('#IsConsolidated').prop('checked', true);
                } else {
                    $('#IsConsolidated').prop('checked', false);
                }
            });

            $reportType.on('change', function (ev) {
                loadAccountsIfNeeded();
                validateFilters();
                const val = (ev.target.value || "").trim().toLowerCase();
                showIncludeZero(val);

                if (!val.includes('trial balance')) {
                    $('#clearButtonWrapper').addClass('d-none');
                }
            });

            function showIncludeZero(val) {
                if (val.includes('trial')) {
                    $('.include_zero_group').removeClass('d-none');
                } else {
                    $('.include_zero_group').addClass('d-none');
                }
            }

            $('#SourceMode, #StartDate, #EndDate').on('change', validateFilters);
            $('.required-field').on('change', validateFilters);

            // Generic change hook
            $('input, select').on('change', validateFilters);

            // Initial state
            toggleBranchDependentFields();
            validateFilters();

            // Generate Report
            $btn.on('click', function (e) {
                e.preventDefault();

                if ($btn.prop('disabled')) {
                    return;
                }

                // Clear previous row each time filter is applied
                $('#reportTableBody').empty();

                const payload = buildReportPayload();
                let reportType = ($reportType.val() || "").trim().toLowerCase();

                switch (reportType) {
                    case "account statement":
                        $.post({
                            url: '/AccntStatement/GenerateReport/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('AccntStatement')
                        });
                        break;

                    case "in":
                        $.post({
                            url: '/IncomeStatement/GenerateReport/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('IncomeStatement')
                        });
                        break;

                    case "trial balance 6 columns":
                        $.post({
                            url: '/TrialBalance6Columns/GenerateTrialBalance/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: (response) => {
                                if (response && response.success === true) {
                                    // ✅ Show single row with Excel + PDF actions
                                    loadReportToTable(response, reportType);
                                } else {
                                    $('#reportTableBody').html(
                                        `<tr><td colspan="4" class="text-center text-danger">No data found.</td></tr>`
                                    );
                                }
                            }
                        });
                        break;

                    case "trial balance 4 columns":
                        $.post({
                            url: '/TrialBalance4Columns/GenerateTrialBalance/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: (response) => {
                                if (response && response.success === true) {
                                    // ✅ Show single row with Excel + PDF actions
                                    loadReportToTable(response, reportType);
                                } else {
                                    $('#reportTableBody').html(
                                        `<tr><td colspan="4" class="text-center text-danger">No data found.</td></tr>`
                                    );
                                }
                            }
                        });
                        break;

                    case "bs":
                        $.post({
                            url: '/BalanceSheet/GenerateBalanceSheet/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('BalanceSheet')
                        });
                        break;

                    case "je":
                        $.post({
                            url: '/JournalEntries/GenerateJournalEntries/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('JournalEntries')
                        });
                        break;
                }
            });

            //========================== clearing generated reports =====================
            $('#clearGeneratedReports').on('click', function () {
                const btn = $(this);
                btn.prop('disabled', true);

                $.ajax({
                    url: '/CustomeReports/clearGeneratedReports',
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            appalert('✅ Reports Cleared Successfully.', 1, 1);

                            loadReportToTable({ files: [] });
                        } else {
                            appalert(response.message || '⚠️ Failed to clear reports.', 2, 1);
                        }
                    },
                    error: function (xhr) {
                        let message = '⚠️ An error occurred while clearing reports.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }
                        appalert(message, 2, 1);
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });

            //========================== clearing generated reports end =====================

            // Reset button
            $('#btnReset').on('click', function () {
                $('#StartDate').val('');
                $('#EndDate').val('');

                $branch.val(null).trigger('change');
                $reportType.val(null).trigger('change');
                $('#SourceMode').val(null).trigger('change');

                $('#IsConsolidated').prop('checked', false);
                $('#IsLiaison').prop('checked', false);
                $('#IsInterbranch').prop('checked', false);

                $('#ToggleAccountingYear').prop('checked', false);
                $('.accounting-year-group').addClass('d-none');
                $accountDropdown.empty();
                $account_group.addClass('d-none');
                $('#clearButtonWrapper').addClass('d-none');

                $('#reportTableBody').empty();

                toggleBranchDependentFields();
                validateFilters();
            });


            $(document).on("change", "#ReportType", function () {
                var selected = $(this).val();

                if (selected === "JE" || selected === "Account Statement") {
                    $(".export_group").removeClass("d-none");
                } else {
                    $(".export_group").addClass("d-none");
                    $("#ExportType").val("").trigger("change");
                }
            });


            $(document).on("change", "#ExportType", function () {
                var exportType = $(this).val();
                console.log(exportType); // Excel or PDF
                var reportType = $("#ReportType").val();

                if (!exportType || !reportType) return;

                // Only allow if filters are valid
                if (!validateFilters()) return;

                const payload = buildReportPayload();
                console.log("Payload Object:", payload);

                let url = '';

                // Decide the endpoint based on report type
                switch (reportType) {
                    case "JE":
                        url = '/JournalEntries/DownloadExcel';
                        break;
                    case "Account Statement":
                        url = '/JournalEntries/DownloadGeneralLedger';
                        break;
                    default:
                        return; // do nothing for other types
                }

                if (exportType === "Excel") {
                    try {
                        const queryString = $.param(payload, true); // 🔥 FIX
                        window.location = `${url}?${queryString}`;
                    } catch (err) {
                        appalert('⚠️ Error exporting Excel: ' + err.message, 2, 1);
                    }
                }

                if (exportType === "PDF") {

                    switch (reportType) {

                        case "JE":
                            Reprint('JournalEntries');
                            break;

                        case "Account Statement":
                            $.ajax({
                                url: '/AccntStatement/GenerateReport/',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(payload),
                                success: function () {
                                    Reprint('AccntStatement');
                                },
                                error: function (xhr) {
                                    let message = "⚠️ Failed to generate Account Statement.";
                                    if (xhr.responseJSON && xhr.responseJSON.message) {
                                        message = xhr.responseJSON.message;
                                    }
                                    appalert(message, 2, 1);
                                }
                            });
                            break;
                    }
                }
                // Optional: reset ExportType after trigger
                $(this).val("").trigger("change");
            });


        });
    </script>
}