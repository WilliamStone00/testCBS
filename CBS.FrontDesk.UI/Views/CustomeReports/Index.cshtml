</div>

<!-- ▬▬▬ REPORT RESULT LIST ▬▬▬ -->
<div class="card shadow-sm mt-4" id="reportTableContainer">

    <div class="card-body p-3">

        <!-- 🔴 Clear Generated Reports Button (Hidden by default) -->
