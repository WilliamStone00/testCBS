        // 🔹 UPDATED: Supports MULTIPLE rows + buttons changed to LINKS
        function loadReportToTable(response, reportTypeValue) {
            const reportName = $('#ReportType option:selected').text();
            const sourceMode = $('#SourceMode option:selected').text();

            // Normalize backend response to a list
            const reports = Array.isArray(response?.data)
                ? response.data
                : response?.data
                    ? [response.data]
                    : [response];

            let rowsHtml = '';

            reports.forEach((item) => {

                // Determine the controller based on report type
                let controllerName = '';
                switch (reportTypeValue.toLowerCase()) {
                    case 'trial balance 6 columns':
                        controllerName = 'TrialBalance6Columns';
                        break;
                    case 'trial balance 4 columns':
                        controllerName = 'TrialBalance4Columns';
                        break;
                    case 'account statement':
                        controllerName = 'AccntStatement';
                        break;
                    case 'bs':
                        controllerName = 'BalanceSheet';
                        break;
                    case 'je':
                        controllerName = 'JournalEntries';
                        break;
                    default:
                        controllerName = 'TrialBalance6Columns';
                }

                rowsHtml += `
            <tr>
                <td class="report-name-column">${reportName}</td>
                <td >${reportName}</td>
                <td >${sourceMode}</td>
                <td class="actions-cell text-center">
                   <div class="actions-container">
                    <a href="javascript:void(0)"
                       class="report-action-link btnExcel"
                       data-controller="${controllerName}"
                       data-file="${item?.downloadFile || ''}">
                        <i class="mdi mdi-file-excel-outline"></i> Excel
                    </a>

                    <span class="action-separator"></span>

                    <a href="javascript:void(0)"
                       class="report-action-link btnPdf"
                       data-controller="${controllerName}">
                        <i class="mdi mdi-file-pdf-box"></i> PDF
                    </a>
                </div>
                </td>
            </tr>
        `;
            });

            $('#reportTableBody').html(rowsHtml);

            // Excel download
            $('.btnExcel').off().on('click', function () {
                const controller = $(this).data('controller');
                const file = $(this).data('file');

                if (!file) {
                    alert("Download file not found in response.");
                    return;
                }

                window.location = `/${controller}/Download?file=${file}`;
            });

            // PDF print
            $('.btnPdf').off().on('click', function () {
                const controller = $(this).data('controller');
                Reprint(controller);
            });
        }

        $(document).ready(function () {

            const $branch = $('#BranchId');
            const $reportType = $('#ReportType');
            const $accountDropdown = $('#AccountId');
            const $account_group = $('.account_group');
            const $btn = $('#btnGetCommission');
            const $requiresBranch = $('.requires-branch');

            // Toggle Accounting Year visibility
            $('#ToggleAccountingYear').on('change', function () {
                const show = this.checked;
                $('.accounting-year-group').toggleClass('d-none', !show);
            });

            // Validate Filter button state
            function validateFilters() {
                const branchSelected = $branch.val() && $branch.val().length > 0;
                const hasReportType = $reportType.val();
                const hasSource = $('#SourceMode').val();
                const hasStartDate = $('#StartDate').val();
                const hasEndDate = $('#EndDate').val();

                const ok = branchSelected && hasReportType && hasSource && hasStartDate && hasEndDate;

                $btn.prop('disabled', !ok).toggleClass('disabled', !ok);
            }

            // Show/hide rows that depend on branch selection
            function toggleBranchDependentFields() {
                const hasBranch = $branch.val() && $branch.val().length > 0;

                $requiresBranch.toggleClass('d-none', !hasBranch);
                $('.date_range_group').toggleClass('d-none', !hasBranch);

                if (!hasBranch) {
                    // Clear dependent selections when branch is removed
                    $reportType.val(null).trigger('change');
                    $('#SourceMode').val(null).trigger('change');
                    $accountDropdown.empty();
                    $account_group.addClass('d-none');
                    $('#IsConsolidated').prop('checked', false);
                    $('#IsLiaison').prop('checked', false);
                    $('#IsInterbranch').prop('checked', false);

                    // Reset accounting year toggle + dropdown visibility
                    $('#ToggleAccountingYear').prop('checked', false);
                    $('.accounting-year-group').addClass('d-none');
                }

                validateFilters();
            }

            // Load accounts when needed
            function loadAccountsIfNeeded() {
                const branches = $branch.val();
                let reportTypeVal = ($reportType.val() || "").trim().toLowerCase();

                const hasBranch = branches && branches.length > 0;
                const loadsAccounts = reportTypeVal === "account statement" || reportTypeVal === "general ledger";

                if (!(hasBranch && loadsAccounts)) {
                    $account_group.addClass('d-none');
                    $accountDropdown.empty();
                    return;
                }

                $.ajax({
                    url: '/CustomeReports/loadAccountById/',
                    type: 'POST',
                    data: { branchId: branches },
                    success: function (response) {
                        const data = response.results || [];
                        $accountDropdown.empty().append('<option value="">--- Select Account ---</option>');

                        $.each(data, function (i, item) {
                            $accountDropdown.append(
                                `<option value="${item.Code}">${item.Name}</option>`
                            );
                        });

                        $account_group.removeClass('d-none');
                    }
                });
            }

            // Event bindings
            $branch.on('change', function () {
                toggleBranchDependentFields();
                loadAccountsIfNeeded();

                if ($branch.val() && $branch.val().length > 1) {
                    $('#IsConsolidated').prop('checked', true);
                } else {
                    $('#IsConsolidated').prop('checked', false);
                }
            });

            $reportType.on('change', function (ev) {
                loadAccountsIfNeeded();
                validateFilters();
                const val = (ev.target.value || "").trim().toLowerCase();
                showIncludeZero(val);
            });

            function showIncludeZero(val) {
                if (val.includes('trial')) {
                    $('.include_zero_group').removeClass('d-none');
                } else {
                    $('.include_zero_group').addClass('d-none');
                }
            }

            $('#SourceMode, #StartDate, #EndDate').on('change', validateFilters);
            $('.required-field').on('change', validateFilters);

            // Generic change hook
            $('input, select').on('change', validateFilters);

            // Initial state
            toggleBranchDependentFields();
            validateFilters();

            // Generate Report
            $btn.on('click', function (e) {
                e.preventDefault();

                if ($btn.prop('disabled')) {
                    return;
                }

                // Clear previous row each time filter is applied
                $('#reportTableBody').empty();

                const payload = buildReportPayload();
                let reportType = ($reportType.val() || "").trim().toLowerCase();

                switch (reportType) {
                    case "account statement":
                        $.post({
                            url: '/AccntStatement/GenerateReport/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('AccntStatement')
                        });
                        break;

                    case "in":
                        $.post({
                            url: '/IncomeStatement/GenerateReport/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('IncomeStatement')
                        });
                        break;

                    case "trial balance 6 columns":
                        $.post({
                            url: '/TrialBalance6Columns/GenerateTrialBalance/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: (response) => {
                                if (response && response.success === true) {
                                    // ✅ Show single row with Excel + PDF actions
                                    loadReportToTable(response, reportType);
                                } else {
                                    $('#reportTableBody').html(
                                        `<tr><td colspan="4" class="text-center text-danger">No data found.</td></tr>`
                                    );
                                }
                            }
                        });
                        break;

                    case "trial balance 4 columns":
                        $.post({
                            url: '/TrialBalance4Columns/GenerateTrialBalance/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: (response) => {
                                if (response && response.success === true) {
                                    // ✅ Show single row with Excel + PDF actions
                                    loadReportToTable(response, reportType);
                                } else {
                                    $('#reportTableBody').html(
                                        `<tr><td colspan="4" class="text-center text-danger">No data found.</td></tr>`
                                    );
                                }
                            }
                        });
                        break;

                    case "bs":
                        $.post({
                            url: '/BalanceSheet/GenerateBalanceSheet/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('BalanceSheet')
                        });
                        break;

                    case "je":
                        $.post({
                            url: '/JournalEntries/GenerateJournalEntries/',
                            contentType: 'application/json',
                            data: JSON.stringify(payload),
                            success: () => Reprint('JournalEntries')
                        });
                        break;
                }
            });

            // Reset button
            $('#btnReset').on('click', function () {
                $('#StartDate').val('');
                $('#EndDate').val('');

                $branch.val(null).trigger('change');
                $reportType.val(null).trigger('change');
                $('#SourceMode').val(null).trigger('change');

                $('#IsConsolidated').prop('checked', false);
                $('#IsLiaison').prop('checked', false);
                $('#IsInterbranch').prop('checked', false);

                $('#ToggleAccountingYear').prop('checked', false);
                $('.accounting-year-group').addClass('d-none');
                $accountDropdown.empty();
                $account_group.addClass('d-none');

                $('#reportTableBody').empty();

                toggleBranchDependentFields();
                validateFilters();
            });
        });
    </script>
}