

@{
    ViewBag.Title = "Report Generator";
}


<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-chart-outline me-2"></i> Report Generator
                </h1>
                <p style="color: black" class=" text-black ">
                    The accounting reports in the system are
                    generated within the period of 1 year from 1st of January to 31st december of the past.
                </p>
                <p style="color: chocolate" class=" alert"> In case you wish to have data above the period of year please kindly contact system administrator.</p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card p-4 mb-3">

    <label for="BranchId" class="form-label fw-bold">Branch</label>
    <!-- Difference GL -->
    @Html.Label("ReconciliationType", "", new { @class = "form-label fw-semibold", @for = "ReconciliationType" })
    @Html.DropDownList(
        "ReconciliationType",
        (IEnumerable<SelectListItem>)ViewBag.reportTypes,
        "--- Select Account Type ---",
         new
         {
             @class = "form-control select2 mb-4",
             id = "ReconciliationType",
             required = "required",
             style = "height: 50px;"  // 👈 set height in pixels
         }
    )
</div>

<!-- Filter Form -->


<!-- Report Result -->
<div class="row">
    <div class="col-12">
        <div id="reportResult" class="card shadow-sm p-2 mt-2">
            <!-- AJAX-loaded report results will appear here -->
        </div>
    </div>
</div>


