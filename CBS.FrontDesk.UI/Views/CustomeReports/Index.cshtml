@model CBS.FrontDesk.Data.Entity.Accounting_V2.TrialBalance.CustomeResportItemS
@using Resources
<style>

    /* ================= TABLE ================= */

    .custom-report-table {
        border-radius: 8px;
        overflow: hidden;
        font-size: 0.92rem;
    }

        .custom-report-table tbody tr:hover {
            background: #f3f9ff !important;
            cursor: pointer;
        }

        .custom-report-table th,
        .custom-report-table td {
            vertical-align: middle !important;
            padding: 10px 12px !important;
        }

        .custom-report-table th {
            white-space: nowrap;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.3px;
        }

            /* ===== 7 COLUMN WIDTH DISTRIBUTION ===== */

            .custom-report-table th:nth-child(1),
            .custom-report-table td:nth-child(1) {
                width: 12%; /* DATE */
            }

            .custom-report-table th:nth-child(2),
            .custom-report-table td:nth-child(2) {
                width: 18%; /* BRANCH */
            }

            .custom-report-table th:nth-child(3),
            .custom-report-table td:nth-child(3) {
                width: 22%; /* NAME */
                white-space: normal;
                word-break: break-word;
            }

            .custom-report-table th:nth-child(4),
            .custom-report-table td:nth-child(4) {
                width: 10%; /* FILE SIZE */
            }

            .custom-report-table th:nth-child(5),
            .custom-report-table td:nth-child(5) {
                width: 15%; /* REPORT TYPE */
            }

            .custom-report-table th:nth-child(6),
            .custom-report-table td:nth-child(6) {
                width: 10%; /* SOURCE */
            }

            .custom-report-table th:nth-child(7),
            .custom-report-table td:nth-child(7) {
                width: 13%; /* ACTIONS */
                text-align: center;
            }

    /* ================= ACTION BUTTONS ================= */

    .btnExcel,
    .btnPdf {
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
        text-decoration: none;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        transition: all 0.15s ease-in-out;
    }

    .btnExcel {
        color: #1e8e28 !important;
    }

        .btnExcel:hover {
            background-color: rgba(30, 142, 40, 0.08);
        }

    .btnPdf {
        color: #c01a1a !important;
    }

        .btnPdf:hover {
            background-color: rgba(192, 26, 26, 0.08);
        }

    .actions-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .action-separator {
        width: 1px;
        height: 18px;
        background-color: #e0e0e0;
    }
</style>

<!-- ▬▬▬ HEADER ▬▬▬ -->
<div class="row mb-2">
    <div class="col-12">
        <div class="card bg-light shadow-sm">
            <div class="card-body text-center py-3">
                <h2 class="card-title text-primary mb-1">
                    <i class="mdi mdi-file-chart-outline me-2"></i> @GlobalCustomeReports.Custom_Trial_Balance_Report
                </h2>
                <p class="card-text small mb-2">
                    @GlobalCustomeReports.Generate_a_custom_trial_balance_based_on_branch_report_type_source_mode_and_date_range
                    @GlobalCustomeReports.Use_this_tool_to_extract_targeted_data_for_reconciliation_analysis_and_auditing
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.4);" />
            </div>
        </div>
    </div>
</div>

<!-- ▬▬▬ TIPS ▬▬▬ -->
<div class="card shadow-sm mb-3 border-0">
    <div class="card-header d-flex justify-content-between align-items-center text-primary py-2 bg-light">
        <span class="fw-semibold">
            <i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips &amp; @GlobalShared.Usage_Guide
        </span>
        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </div>

    <div id="collapseTips" class="collapse">
        <div class="card-body small text-muted">
            <ul class="list-unstyled mb-2">
                <li>
                    <i class="mdi mdi-checkbox-marked-outline text-success me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.Select_a_branch_first_other_filters_will_appear_after_a_branch_is_chosen)
                </li>
                <li>
                    <i class="mdi mdi-calendar-range text-primary me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.Choose_a_clear_start_date_and_end_date_for_precise_results)
                </li>
                <li>
                    <i class="mdi mdi-format-list-bulleted-square text-primary me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.Select_a_Report_Type_Accounts_are_only_used_for_JE_and_Account_Statement)
                </li>
                <li>
                    <i class="mdi mdi-database-search text-warning me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.Choose_a_Source_Mode_Temporary_Reconciled_Auto_or_RealTime)
                </li>
                <li>
                    <i class="mdi mdi-calendar-clock text-info me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.Enable_Accounting_Year_only_if_you_want_to_filter_by_a_specific_year)
                </li>
                <li>
                    <i class="mdi mdi-shield-check-outline text-success me-1"></i>
                    @Html.Raw(@GlobalCustomeReports.The_filter_becomes_active_when_dates_branch_report_type_and_source_mode_are_selected)
                    @GlobalCustomeReports.Accounts_and_accounting_year_are_optional
                </li>
            </ul>
        </div>
    </div>
</div>

