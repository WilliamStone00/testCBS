

@{
    ViewBag.Title = "Report Generator";
}
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-chart-outline me-2"></i> Report Generator
                </h1>
                <p class="card-text text-muted">
                    Generate reports based on selected criteria efficiently.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReportTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseReportTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Always select a report type.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Date range is required.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Enable accounts filter if you want to filter by specific accounts.</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Branch selection is optional but recommended for consolidated reports.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Filter Form -->
<div class="row">
    <div class="col-xl-12 col-lg-8 col-md-12">
        <div class="card shadow-sm mb-2">
            <div class="card-body">
                <form id="reportFilterForm">
                    <div class="mb-3">
                        <label for="reportType" class="form-label">Report Type</label>
                        <select id="reportType" class="form-select">
                            <option value="">-- Select Report Type --</option>
                            <option value="TrialBalance">Trial Balance</option>
                            <option value="CashFlow">Cash Flow</option>
                            <option value="IncomeStatement">Income Statement</option>
                        </select>
                    </div>

                    <div class="mb-3 row">

                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="filterByAccount" />
                        <label class="form-check-label" for="filterByAccount">Filter by Accounts</label>
                    </div>

                    @*<div class="mb-3">
                            <label for="accountsSelect" class="form-label">Select Accounts</label>
                            <select id="accountsSelect" class="form-select" multiple disabled>
                                <option value="1001">1001 - Cash</option>
                                <option value="1002">1002 - Bank</option>
                                <option value="2001">2001 - Accounts Payable</option>
                                <option value="3001">3001 - Revenue</option>
                            </select>
                        </div>*@

                    @*<div class="mb-3">
                            <label for="branchSelect" class="form-label">Branch</label>
                            <select id="branchSelect" class="form-select">
                                <option value="">-- Select Branch --</option>
                                <option value="BR001">BR001 - Headquarters</option>
                                <option value="BR002">BR002 - Regional</option>
                            </select>
                        </div>*@

                    <button id="downloadReport" type="button" class="btn btn-primary">Generate Report</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Report Result -->
<div class="row">
    <div class="col-12">
        <div id="reportResult" class="card shadow-sm p-2 mt-2">
            <!-- AJAX-loaded report results will appear here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enable/disable accounts multi-select based on checkbox
        $('#filterByAccount').change(function () {
            $('#accountsSelect').prop('disabled', !this.checked);
        });

        function Reprint() {
            //window.open(redirectUrl, '_blank');\

            ReportView("TrialBalance", null, "GetReport", null, null, "receipts", "ReportParameterLess");
        }


        const btn = document.querySelector('#downloadReport');
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            axios.post('/TrialBalance/GenerateTrialBalance').then(() => {
                Reprint();
            })
        });

    </script>
}
