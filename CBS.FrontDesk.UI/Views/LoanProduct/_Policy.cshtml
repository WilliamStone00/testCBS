<script>
    // This must be declared first before DOMContentLoaded calls it
    function togglePenaltySection() {
        const isChecked = $('#UpdateLoanProductCommand_IsChargesApplied').is(':checked');
        $('#penaltySection').toggle(isChecked);

        if (!isChecked) {
            // Reset the penalty list
            $('#UpdateLoanProductCommand_PenaltyId').val(null).trigger('change'); // for select2
        }
    }

    // Wrapper function that adds button state handling
function AjaxPostAndUpdateWithButtonState(form) {
    // Save reference to original function
    const originalAjaxPostAndUpdate = window.originalAjaxPostAndUpdate || AjaxPostAndUpdate;
    
    // Find the submit button
    const submitButton = $(form).find('button[type="submit"]');
    const originalText = submitButton.html();
    
    // Disable button and show updating
    submitButton.prop('disabled', true);
    submitButton.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Updating...');
    
    // Call original function
    const result = originalAjaxPostAndUpdate(form);
    
    // Re-enable button after a timeout (in case the AJAX call doesn't handle it)
    setTimeout(function() {
        submitButton.prop('disabled', false);
        submitButton.html(originalText);
    }, 5000); // 5 second timeout as fallback
    
    return result;
}

// Update your forms to use the new function
document.addEventListener("DOMContentLoaded", function() {
    // Change all form onsubmit handlers
    $('form').each(function() {
        const currentOnSubmit = $(this).attr('onsubmit');
        if (currentOnSubmit && currentOnSubmit.includes('AjaxPostAndUpdate')) {
            $(this).attr('onsubmit', currentOnSubmit.replace('AjaxPostAndUpdate', 'AjaxPostAndUpdateWithButtonState'));
        }
    });
});

    document.addEventListener("DOMContentLoaded", function () {
        // ✅ Setup Shortee Fund checkbox logic (your other use-case)
        const checkbox = document.getElementById("shorteeFundCheckbox");
        const percentageCoverageContainer = document.getElementById("percentageCoverageContainer");
        if (checkbox && percentageCoverageContainer) {
            checkbox.addEventListener("change", function () {
                percentageCoverageContainer.style.display = checkbox.checked ? "block" : "none";
            });

            // Default state
            percentageCoverageContainer.style.display = checkbox.checked ? "block" : "none";
        }

        // ✅ Initial Penalty toggle
        togglePenaltySection();

        // ✅ Hook change event for penalty logic
        $('#UpdateLoanProductCommand_IsChargesApplied').on('change', togglePenaltySection);
    });
</script>


