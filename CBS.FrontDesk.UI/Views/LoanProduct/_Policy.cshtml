@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects
@using Resources
<div class="col">
  
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank me-2"></i>Loan Product Configuration Management
                    </h1>
                    <p class="card-text">
                        Configure and manage comprehensive loan product settings including interest rates, repayment terms, collateral requirements, and eligibility criteria.
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        Define product policies, interest structures, collateral requirements, and repayment options for different loan types.
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Tips Section -->
    <div class="card mb-3">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> Loan Product Configuration Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanProductTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseLoanProductTips" class="collapse">
            <div class="card-body">
                <ul>
                    <li>
                        <i class="mdi mdi-currency-usd text-success me-2"></i>
                        <strong>Loan Amount Range:</strong> Set minimum and maximum loan amounts to control risk exposure and ensure reasonable lending limits.
                    </li>
                    <li>
                        <i class="mdi mdi-percent text-info me-2"></i>
                        <strong>Interest Rate Range:</strong> Define flexible interest rate boundaries that can be adjusted based on borrower risk profile.
                    </li>
                    <li>
                        <i class="mdi mdi-calendar-clock text-warning me-2"></i>
                        <strong>Loan Duration:</strong> Configure minimum and maximum loan terms in months to align with borrower repayment capacity.
                    </li>
                    <li>
                        <i class="mdi mdi-shield-account text-primary me-2"></i>
                        <strong>Collateral Requirements:</strong> Specify if collateral is required and set minimum collateral percentage relative to loan amount.
                    </li>
                    <li>
                        <i class="mdi mdi-account-group text-danger me-2"></i>
                        <strong>Guarantor Settings:</strong> Determine if guarantors are required and define their fund coverage obligations.
                    </li>
                    <li>
                        <i class="mdi mdi-bank-transfer text-secondary me-2"></i>
                        <strong>Account Requirements:</strong> Configure required account types (share, savings, salary) and minimum balance percentages.
                    </li>
                    <li>
                        <i class="mdi mdi-calendar-sync text-success me-2"></i>
                        <strong>Repayment Cycles:</strong> Select available repayment frequencies (daily, weekly, monthly) to match borrower cash flow.
                    </li>
                    <li>
                        <i class="mdi mdi-home-analytics text-info me-2"></i>
                        <strong>Mortgage Features:</strong> Enable specialized mortgage settings like LTV ratios, grace periods, and title requirements.
                    </li>
                    <li>
                        <i class="mdi mdi-cash-refresh text-primary me-2"></i>
                        <strong>Top-up Options:</strong> Configure refinancing capabilities and minimum repayment percentages required for top-ups.
                    </li>
                    <li>
                        <i class="mdi mdi-alert-circle text-warning me-2"></i>
                        <strong>Penalty Settings:</strong> Define late payment penalties, interest waiver options, and delinquency management rules.
                    </li>
                    <li>
                        <i class="mdi mdi-account-check text-success me-2"></i>
                        <strong>Eligibility Criteria:</strong> Set target populations (individual, employee, corporate) and purpose classifications.
                    </li>
                    <li>
                        <i class="mdi mdi-calculator-variant text-info me-2"></i>
                        <strong>Down Payment:</strong> Configure minimum down payment percentage to reduce initial risk exposure.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                @if (Model.Policy.LoanMinimumAmount <= 0 ||
                    Model.Policy.LoanMaximumAmount <= 0 ||
                    Model.Policy.LoanMinimumAmount > Model.Policy.LoanMaximumAmount)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@GlobalLoanProduct.ValidationError:</strong>
                        <ul>
                            @if (Model.Policy.LoanMinimumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.MinimumLoanAmountMustBeGreaterThan0.</li>
                            }
                            @if (Model.Policy.LoanMaximumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.MaximumLoanAmountMustBeGreaterThan0.</li>
                            }
                            @if (Model.Policy.LoanMinimumAmount > Model.Policy.LoanMaximumAmount)
                            {
                                <li>@GlobalLoanProduct.MinimumLoanAmountCannotExceedMaximumLoanAmount.</li>
                            }
                        </ul>
                    </div>
                }

                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalLoanProduct.MinimumAndDownPaymentSettings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.LoanRangeSetTheMinimumDefaultAndMaximumLoanAmounts.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.MinimumLoanAmountDetermineAReasonableMinimumLoanAmount.
                            2. @GlobalLoanProduct.DefaultLoanAmountSetBasedOnMarketDemandAndHistoricalData.
                            3. @GlobalLoanProduct.MaximumLoanAmountDefineToLimitRiskExposure."></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Minimum-Payment Settings</legend>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                                m => m.CreateOrUpdate.LoanTargetId,
                                                new SelectList(Model.LoanTargets, "Id", "NameEn"),
                                                "---" + @GlobalLoanProduct.Select + "---",
                                                new { @class = "form-control select2", @search = "true", disabled = "disabled" }
                                            )
                                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTargetId, "", new { @class = "text-danger " })
                                            <label>@GlobalLoanProduct.Target</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Product.ProductCode, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.ProductCode, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Code</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Product.ProductName, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.ProductName, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Name</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Product.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.Description, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Description</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.LoanMinimumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.LoanMinimumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MinimumLoanAmount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.LoanMaximumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.LoanMaximumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MaximumLoanAmount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.MinimumDownPaymentPercentage, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.MinimumDownPaymentPercentage, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MinimumDownPaymentRate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.Policy.IsPaidFeeBeforeProcessing, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalLoanProduct.MustApartialFeeBePaidBeforeTheLoanApplicationIsProcessed?</label>
                                        </div>
                                    </div>

                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                    @Html.HiddenFor(m => m.Policy.LoanProductId)
                                    @Html.HiddenFor(m => m.Policy.TermId)
                                    <input type="hidden" name="ServiceOption" value="loan_range" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            @if (Model.Product.LoanTypeCategory == "Overdraft")
            {
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryOptions">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryOptions"
                                aria-expanded="false"
                                aria-controls="collapseDeliveryOptions">
                            @GlobalLoanProduct.InterestSettings
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.InterestSetTheInterestTypePeriodAndRatesForTheLoanProduct.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.LoanInterestTypeDetermineTheTypeOfInterest.
                            2. @GlobalLoanProduct.LoanInterestPeriodSpecifyThePeriodForInterest.
                            3. @GlobalLoanProduct.MinimumInterestRateDefineTheMinimumInterestRateApplicableToTheLoan.
                            4. @GlobalLoanProduct.DefaultInterestRateSetTheDefaultInterestRateForTheLoanProduct.
                            5. @GlobalLoanProduct.MaximumInterestRateDefineTheMaximumInterestRate.
                            6. @GlobalLoanProduct.StartGeneratingInterestAfterDisbursementDecideIfInterestAccrualStarts.
                            7. @GlobalLoanProduct.InterestWaiverAllowForTheWaiverOfInterestCharges.
                            8. @GlobalLoanProduct.MinimumInterestWaiverRateSpecifyTheMinimumRate.
                            9. @GlobalLoanProduct.MaximumInterestWaiverRateDefineTheMaximumRate."></i>


                        </button>
                    </h2>
                    <div id="collapseDeliveryOptions"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingDeliveryOptions"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.InterestSettings</legend>
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.Policy.LoanInterestPeriod, new SelectList(ViewBag.LoanInterestPeriods, "Value", "Text"), "---Select interest periods---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.Policy.LoanInterestPeriod, "", new { @class = "text-danger " })
                                                <label>Interest period</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MinimumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MinimumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MinimumInterestValue</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MaximumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MaximumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumInterestValue</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.StartGeneratingInterestAfterDisbustment, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.CheckToStartAccrualInterestAfterDisbustment.</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.IsInterestWaiverApplied, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.CheckToAllowInterestWaiverForThisProduct</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MinimumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MinimumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MinimumInterestWaiverRate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MaximumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MaximumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumInterestWaiverRate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.StopInterestCalculationAtLoanMaturityDate, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.StopInterestCalculationAtLoaMaturityDate.</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.NumberOfDaysToStopInterestCalculation, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.NumberOfDaysToStopInterestCalculation, "", new { @class = "text-danger" })
                                                <label>Number Of Days T oStop Interest Calculation</label>
                                                @*<label>@GlobalLoanProduct.NumberOfDaysToStopInterestCalculation</label>*@
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.InterestMustBePaidUpFront, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.InterestMustBePaidUpfront.</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                        @Html.HiddenFor(m => m.Policy.LoanProductId)
                                        @Html.HiddenFor(m => m.Policy.TermId)
                                        <input type="hidden" name="ServiceOption" value="interest" id="ServiceOption" />
                                    </div>
                                </fieldset>
                            }
                        </div>
                    </div>
                </div>

                <div class="card accordion-item mb-3">
                    <!-- Check if LoanTerm is not set -->
                    @if (Model.Product.Term == null ||
                        Model.Product.Term.Name == "N/A" ||
                        string.IsNullOrEmpty(Model.Product.Term.Name) ||
                        Model.Product.Term.MinInMonth == 0 ||
                        Model.Product.Term.MaxInMonth == 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>@GlobalLoanProduct.ConfigurationMissing:</strong>
                            <ul>
                                @if (Model.Product.Term == null || Model.Product.Term.Name == "N/A" || string.IsNullOrEmpty(Model.Product.Term.Name))
                                {
                                    <li>@GlobalLoanProduct.LoanTermIsNotConfiguredForThisLoanProduct.</li>
                                }
                                @if (Model.Product.Term == null || Model.Product.Term.MinInMonth == 0 || Model.Product.Term.MaxInMonth == 0)
                                {
                                    <li>@GlobalLoanProduct.LoanTermDurationParametersAreNotProperlySet.</li>
                                }
                            </ul>
                        </div>
                    }

                    <h2 class="accordion-header" id="headingPaymentMethod">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod">
                            @GlobalLoanProduct.DurationInMonths
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.DurationSetTheLoanDurationParameters.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.MinimumLoanDurationSpecifyTheShortestDurationAllowedForTheLoan.
                            2. @GlobalLoanProduct.DefaultLoanDurationSetTheDefaultDurationForTheLoanProduct.
                            3. @GlobalLoanProduct.MaximumLoanDurationDefineTheLongestDuration.
                            4. @GlobalLoanProduct.FlexibilityOfferCustomizableLoanDurations.
                            5. @GlobalLoanProduct.RiskMitigationBalanceRiskAndBorrower.
                            6. @GlobalLoanProduct.MarketAnalysisConsiderMarketTrends."></i>
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.LoanDuration</legend>
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Product.Term.Name, new { @class = "form-control", @readonly = true })
                                                <label>@GlobalLoanProduct.LoanDurationPeriod</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Product.Term.MinInMonth, new { @class = "form-control", @readonly = true })
                                                <label>@GlobalLoanProduct.MinimumMonth</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Product.Term.MaxInMonth, new { @class = "form-control", @readonly = true })
                                                <label>@GlobalLoanProduct.MaximumMonth</label>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                        </div>
                    </div>
                </div>


                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod7">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod7"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod7">
                            @GlobalLoanProduct.Repayment
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.RepaymentDefineTheRepaymentTermsAndOptionsForTheLoanProduct.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.RepaymentFrequencySpecifyHowOftenBorrowers.
                            2. @GlobalLoanProduct.RepaymentMethodDetermineTheMethods.
                            3. @GlobalLoanProduct.GracePeriodSetAGracePeriodDuringWhichBorrowers.
                            4. @GlobalLoanProduct.PenaltyChargesDefinePenaltiesForLateRepayments.
                            5. @GlobalLoanProduct.FlexibleOptionsOfferFlexibleRepaymentOptions.
                            6. @GlobalLoanProduct.CustomerEducationProvideClearInformation."></i>

                        </button>
                    </h2>
                    <div id="collapsePaymentMethod7"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod7"
                         data-bs-parent="#collapsibleSection">

                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.RepaymentPeriods</legend>

                                    <div class="row g-4">
                                        <div class="col-md-12 mb-2">
                                            <div class="form-floating form-floating-outline">
                                                @Html.ListBoxFor(m => m.Product.RepaymentCycles, new MultiSelectList(ViewBag.RepaymentCycles, "Value", "Text"), new { @class = "select2 form-select" })
                                                <label>@GlobalLoanProduct.RepaymentCycles</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <label>Selected repayment cycles</label>
                                            <div class="form-floating form-floating-outline">
                                                @if (Model.Product.RepaymentCycles != null && Model.Product.RepaymentCycles.Any())
                                                {
                                                    <ul>
                                                        @foreach (var cycle in Model.Product.RepaymentCycles)
                                                        {
                                                            <li>@cycle</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p>@GlobalLoanProduct.NoRepaymentCyclesSelected</p>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.InterestOrder, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.InterestOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.CapitalOrder, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.CapitalOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.FineOrder, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.FineOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.InterestRate, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.InterestPercentToRefund</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.CapitalRate, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.CapitalPercentToRefund</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.FineRate, new { @class = "form-control", disabled = "disabled" })
                                                <label>@GlobalLoanProduct.FinePercentToRefund</label>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                        @Html.HiddenFor(m => m.Policy.LoanProductId)
                                        @Html.HiddenFor(m => m.Policy.TermId)
                                        <input type="hidden" name="ServiceOption" value="repayment" id="ServiceOption" />
                                    </div>
                                </fieldset>
                            }
                        </div>

                    </div>
                </div>
