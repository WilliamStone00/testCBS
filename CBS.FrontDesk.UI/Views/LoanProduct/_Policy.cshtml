@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects
@using Resources
@{
    var product = Model.Product;
}

<div class="col">

    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank me-2"></i>@GlobalLoanProduct.loan_product_configuration_management
                    </h1>
                    <p class="card-text">
                        @GlobalLoanProduct.configure_and_manage_comprehensive_loan_product_settings_including_interest_rates_repayment_terms_collateral_requirements_and_eligibility_criteria.
                    </p>
                    <div class="alert alert-info mt-3 py-2">
                        <i class="mdi mdi-information-outline me-1"></i>
                        @GlobalLoanProduct.define_product_policies_interest_structures_collateral_requirements_and_repayment_options_for_different_loan_types.
                    </div>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <!-- Tips Section -->
    <div class="card mb-3">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoanProduct.loan_product_configuration_tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanProductTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseLoanProductTips" class="collapse">
            <div class="card-body">
                <ul>
                    <li>
                        <i class="mdi mdi-currency-usd text-success me-2"></i>
                        <strong>@GlobalLoanProduct.loan_amount_range:</strong> @GlobalLoanProduct.set_minimum_and_maximum_loan_amounts_to_control_risk_exposure_and_ensure_reasonable_lending_limits.
                    </li>
                    <li>
                        <i class="mdi mdi-percent text-info me-2"></i>
                        <strong>@GlobalLoanProduct.interest_rate_range:</strong> @GlobalLoanProduct.define_flexible_interest_rate_boundaries_that_can_be_adjusted_based_on_borrower_risk_profile.
                    </li>
                    <li>
                        <i class="mdi mdi-calendar-clock text-warning me-2"></i>
                        <strong>@GlobalShared.Loan_Duration:</strong> @GlobalLoanProduct.configure_minimum_and_maximum_loan_terms_in_months_to_align_with_borrower_repayment_capacity.
                    </li>
                    <li>
                        <i class="mdi mdi-shield-account text-primary me-2"></i>
                        <strong>@GlobalLoanProduct.collateral_requirements:</strong> @GlobalLoanProduct.specify_if_collateral_is_required_and_set_minimum_collateral_percentage_relative_to_loan_amount.
                    </li>
                    <li>
                        <i class="mdi mdi-account-group text-danger me-2"></i>
                        <strong>@GlobalLoanProduct.guarantor_settings:</strong> @GlobalLoanProduct.determine_if_guarantors_are_required_and_define_their_fund_coverage_obligations.
                    </li>
                    <li>
                        <i class="mdi mdi-bank-transfer text-secondary me-2"></i>
                        <strong>@GlobalShared.account_requirements:</strong> @GlobalLoanProduct.configure_required_account_types_share_savings_salary_and_minimum_balance_percentages.
                    </li>
                    <li>
                        <i class="mdi mdi-calendar-sync text-success me-2"></i>
                        <strong>@GlobalShared.repayment_cycles:</strong> @GlobalLoanProduct.select_available_repayment_frequencies_daily_weekly_monthly_to_match_borrower_cash_flow.
                    </li>
                    <li>
                        <i class="mdi mdi-home-analytics text-info me-2"></i>
                        <strong>Mortgage Features:</strong> @GlobalLoanProduct.enable_specialized_mortgage_settings_like_ltv_ratios_grace_periods_and_title_requirements.
                    </li>
                    <li>
                        <i class="mdi mdi-cash-refresh text-primary me-2"></i>
                        <strong>@GlobalShared.topup_options:</strong> @GlobalLoanProduct.configure_refinancing_capabilities_and_minimum_repayment_percentages_required_for_topups.
                    </li>
                    <li>
                        <i class="mdi mdi-alert-circle text-warning me-2"></i>
                        <strong>@GlobalShared.penalty_settings:</strong> @GlobalLoanProduct.define_late_payment_penalties_interest_waiver_options_and_delinquency_management_rules.
                    </li>
                    <li>
                        <i class="mdi mdi-account-check text-success me-2"></i>
                        <strong>@GlobalLoanProduct.eligibility_criteria:</strong> @GlobalLoanProduct.set_target_populations_individual_employee_corporate_and_purpose_classifications.
                    </li>
                    <li>
                        <i class="mdi mdi-calculator-variant text-info me-2"></i>
                        <strong>@GlobalLoanProduct.down_payment:</strong> @GlobalLoanProduct.configure_minimum_down_payment_percentage_to_reduce_initial_risk_exposure.
                    </li>
                </ul>
            </div>
        </div>
    </div>


    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="text-primary fw-semibold">
                <i class="mdi mdi-eye-outline me-1"></i> @GlobalLoanProduct.live_pcmf_preview
            </span>
            <small class="text-muted">@GlobalShared.live</small>
        </div>

        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-2 align-items-center">

                <span class="badge bg-label-secondary px-3 py-2" id="pcmfPreviewSection">
                    @GlobalShared.section: @product.PcmfSection
                </span>

                <span class="badge bg-label-dark px-3 py-2" id="pcmfPreviewGroup">
                    @GlobalShared.Group: @product.PcmfGroupCode
                </span>

                <span class="badge bg-label-primary px-3 py-2" id="pcmfPreviewBase">
                    @GlobalShared._base: @product.PcmfPopulation
                </span>

                <span class="badge bg-label-info px-3 py-2" id="pcmfPreviewPop">
                    @GlobalShared.population: @product.PcmfBaseCode
                </span>

                <!-- TAXATION CONTROL (INLINE) -->
                <div class="d-flex align-items-center px-3 py-2 border rounded bg-light">
                    <div class="form-check form-switch m-0">

                        <input class="form-check-input"
                               type="checkbox"
                               id="ApplyTaxIfLoanAmountMeetControl"
                               name="ApplyTaxIfLoanAmountMeetControl"
                               value="true"
                               @(Model.ApplyTaxIfLoanAmountMeetControl ? "checked" : "") />

                        <label class="form-check-label fw-semibold ms-2"
                               for="ApplyTaxIfLoanAmountMeetControl">
                            @GlobalLoanProduct.apply_tax_if_loan_amount_meet_control
                        </label>

                        <!-- Important for false value -->
                        <input type="hidden"
                               name="ApplyTaxIfLoanAmountMeetControl"
                               value="false" />
                    </div>
                </div>


            </div>

            <div class="small text-muted mt-2">
                @GlobalLoanProduct.updates_automatically_as_you_pick_facility_term_purpose_target.
            </div>
        </div>

    </div>


    <div class="accordion-item mb-1">
        <h2 class="accordion-header" id="hdPcmf">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#cpPcmf" aria-expanded="true" aria-controls="cpPcmf">
                <i class="mdi mdi-tag-outline me-2 text-primary"></i>
                <span class="fw-semibold text-primary">@GlobalLoanProduct.pcmf_classification</span>
            </button>
        </h2>

        <div id="cpPcmf" class="accordion-collapse collapse show"
             aria-labelledby="hdPcmf" data-bs-parent="#loanProductAccordion">
            <div class="accordion-body py-3">
                <div class="row g-3">

                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.LoanTermId,
                                new SelectList(ViewBag.LoanTerms, "Id", "NameEn"),
                                "--- Select Loan Term ---",
                                new { @class = "form-control select2", id = "LoanTermId", disabled = "disabled" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTermId, "", new { @class = "text-danger" })
                            <label>Loan Term</label>
                        </div>
                        <div class="small text-muted">
                            @Html.Raw(@GlobalLoanProduct.required_for_classic_ssf_loc_only_overdraft_can_be_empty).
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.PcmfLoanPurposeId,
                                new SelectList(ViewBag.PcmfLoanPurposes, "Id", "NameEn"),
                                "--- Select PCMF Purpose ---",
                                new { @class = "form-control select2", required = "required", disabled = "disabled", id = "PcmfLoanPurposeId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.PcmfLoanPurposeId, "", new { @class = "text-danger" })
                            <label>@GlobalLoanProduct.pcmf_loan_purpose</label>
                        </div>
                        <div class="small text-muted">@GlobalLoanProduct.filtered_by_termsection.</div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.LoanTargetId,
                                new SelectList(ViewBag.LoanTargets, "Id", "NameEn"),
                                "--- Select Target ---",
                                new { @class = "form-control select2", required = "required", disabled = "disabled", id = "LoanTargetId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTargetId, "", new { @class = "text-danger" })
                            <label>@GlobalShared.Loan_Target</label>
                        </div>
                        <div class="small text-muted">@GlobalLoanProduct.enabled_after_purpose.</div>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                @if (Model.Policy.LoanMinimumAmount <= 0 ||
                    Model.Policy.LoanMaximumAmount <= 0 ||
                    Model.Policy.LoanMinimumAmount > Model.Policy.LoanMaximumAmount)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@GlobalShared.Validation_Error:</strong>
                        <ul>
                            @if (Model.Policy.LoanMinimumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.minimum_loan_amount_must_be_greater_than0.</li>
                            }
                            @if (Model.Policy.LoanMaximumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.maximum_loan_amount_must_be_greater_than0.</li>
                            }
                            @if (Model.Policy.LoanMinimumAmount > Model.Policy.LoanMaximumAmount)
                            {
                                <li>@GlobalLoanProduct.minimum_loan_amount_cannot_exceed_maximum_loan_amount.</li>
                            }
                        </ul>
                    </div>
                }

                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalLoanProduct.minimum_and_down_payment_settings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.loan_range_set_the_minimum_default_and_maximum_loan_amounts.
                            @GlobalShared.key_points:
                            1. @GlobalLoanProduct.minimum_loan_amount_determine_areasonable_minimum_loan_amount.
                            2. @GlobalLoanProduct.default_loan_amount_set_based_on_market_demand_and_historical_data.
                            3. @GlobalLoanProduct.maximum_loan_amount_define_to_limit_risk_exposure."></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Minimum-Payment Settings</legend>
                                <div class="row g-4">
                                         <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Product.ProductCode, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.ProductCode, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Code</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Product.ProductName, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.ProductName, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Name</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Product.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.Product.Description, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Description</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.LoanMinimumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.LoanMinimumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.minimum_loan_amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.LoanMaximumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.LoanMaximumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.maximum_loan_amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Policy.MinimumDownPaymentPercentage, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.Policy.MinimumDownPaymentPercentage, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.minimum_down_payment_rate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.Policy.IsPaidFeeBeforeProcessing, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalLoanProduct.must_apartial_fee_be_paid_before_the_loan_application_is_processed?</label>
                                        </div>
                                    </div>

                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                    @Html.HiddenFor(m => m.Policy.LoanProductId)
                                    @Html.HiddenFor(m => m.Policy.TermId)
                                    <input type="hidden" name="ServiceOption" value="loan_range" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            @if (Model.Product.LoanTypeCategory == "Overdraft")
            {
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryOptions">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryOptions"
                                aria-expanded="false"
                                aria-controls="collapseDeliveryOptions">
                            @GlobalShared.interest_settings
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.interest_set_the_interest_type_period_and_rates_for_the_loan_product.
                            @GlobalShared.key_points:
                            1. @GlobalLoanProduct.loan_interest_type_determine_the_type_of_interest.
                            2. @GlobalLoanProduct.loan_interest_period_specify_the_period_for_interest.
                            3. @GlobalLoanProduct.minimum_interest_rate_define_the_minimum_interest_rate_applicable_to_the_loan.
                            4. @GlobalLoanProduct.default_interest_rate_set_the_default_interest_rate_for_the_loan_product.
                            5. @GlobalLoanProduct.maximum_interest_rate_define_the_maximum_interest_rate.
                            6. @GlobalLoanProduct.start_generating_interest_after_disbursement_decide_if_interest_accrual_starts.
                            7. @GlobalLoanProduct.interest_waiver_allow_for_the_waiver_of_interest_charges.
                            8. @GlobalLoanProduct.minimum_interest_waiver_rate_specify_the_minimum_rate.
                            9. @GlobalLoanProduct.maximum_interest_waiver_rate_define_the_maximum_rate."></i>


                        </button>
                    </h2>
                    <div id="collapseDeliveryOptions"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingDeliveryOptions"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalShared.interest_settings</legend>
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.Policy.LoanInterestPeriod, new SelectList(ViewBag.LoanInterestPeriods, "Value", "Text"), "---Select interest periods---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.Policy.LoanInterestPeriod, "", new { @class = "text-danger " })
                                                <label>Interest period</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MinimumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MinimumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.minimum_interest_value</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MaximumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MaximumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.maximum_interest_value</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.StartGeneratingInterestAfterDisbustment, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.check_to_start_accrual_interest_after_disbustment.</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.IsInterestWaiverApplied, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.check_to_allow_interest_waiver_for_this_product</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MinimumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MinimumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.minimum_interest_waiver_rate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.MaximumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.MaximumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.maximum_interest_waiver_rate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.StopInterestCalculationAtLoanMaturityDate, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.stop_interest_calculation_at_loa_maturity_date.</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.Policy.NumberOfDaysToStopInterestCalculation, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Policy.NumberOfDaysToStopInterestCalculation, "", new { @class = "text-danger" })
                                                <label>Number Of Days T oStop Interest Calculation</label>
                                                @*<label>@GlobalLoanProduct.NumberOfDaysToStopInterestCalculation</label>*@
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.Policy.InterestMustBePaidUpFront, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.interest_must_be_paid_upfront.</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                        @Html.HiddenFor(m => m.Policy.LoanProductId)
                                        @Html.HiddenFor(m => m.Policy.TermId)
                                        <input type="hidden" name="ServiceOption" value="interest" id="ServiceOption" />
                                    </div>
                                </fieldset>
                            }
                        </div>
                    </div>
                </div>

                <div class="card accordion-item mb-3">
                    <!-- Check if LoanTerm is not set -->
                    @if (Model.Product.Term == null ||
                        Model.Product.Term.Name == "N/A" ||
                        string.IsNullOrEmpty(Model.Product.Term.Name) ||
                        Model.Product.Term.MinInMonth == 0 ||
                        Model.Product.Term.MaxInMonth == 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>@GlobalLoanProduct.configuration_missing:</strong>
                            <ul>
                                @if (Model.Product.Term == null || Model.Product.Term.Name == "N/A" || string.IsNullOrEmpty(Model.Product.Term.Name))
                                {
                                    <li>@GlobalLoanProduct.loan_term_is_not_configured_for_this_loan_product.</li>
                                }
                                @if (Model.Product.Term == null || Model.Product.Term.MinInMonth == 0 || Model.Product.Term.MaxInMonth == 0)
                                {
                                    <li>@GlobalLoanProduct.loan_term_duration_parameters_are_not_properly_set.</li>
                                }
                            </ul>
                        </div>
                    }

                    <h2 class="accordion-header" id="headingPaymentMethod">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod">
                            @GlobalLoanProduct.duration_in_months
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.duration_set_the_loan_duration_parameters.
                            @GlobalShared.key_points:
                            1. @GlobalLoanProduct.minimum_loan_duration_specify_the_shortest_duration_allowed_for_the_loan.
                            2. @GlobalLoanProduct.default_loan_duration_set_the_default_duration_for_the_loan_product.
                            3. @GlobalLoanProduct.maximum_loan_duration_define_the_longest_duration.
                            4. @GlobalLoanProduct.flexibility_offer_customizable_loan_durations.
                            5. @GlobalLoanProduct.risk_mitigation_balance_risk_and_borrower.
                            6. @GlobalLoanProduct.market_analysis_consider_market_trends."></i>
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithButtonState(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalShared.Loan_Duration</legend>
