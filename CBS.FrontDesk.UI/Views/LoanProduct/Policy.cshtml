@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject

@{
    ViewBag.Title = "Loan Policies Setting";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <!-- Alert Section -->
        @if (@Model.UpdateLoanProductCommand.LoanProductCategory.Name == "N/A" || @Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A" || string.IsNullOrEmpty(@Model.UpdateLoanProductCommand.TargetType))
        {
            <div class="alert alert-danger" role="alert">
                <strong>Configuration Missing:</strong>
                <ul>
                    @if (@Model.UpdateLoanProductCommand.LoanProductCategory.Name == "N/A")
                    {
                        <li>Loan Product Category is not configured.</li>
                    }
                    @if (@Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A")
                    {
                        <li>Loan Term is not configured.</li>
                    }
                    @if (string.IsNullOrEmpty(@Model.UpdateLoanProductCommand.TargetType))
                    {
                        <li>Target Type is not specified.</li>
                    }
                </ul>
                Please ensure all fields are properly configured before proceeding.
            </div>
        }

        <!-- Accordion Section -->
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button @((@Model.UpdateLoanProductCommand.LoanProductCategory.Name == "N/A"
                                    || @Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A"
                                    || string.IsNullOrEmpty(@Model.UpdateLoanProductCommand.TargetType)) ? "text-danger" : "")"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-police-badge me-2"></i>
                            <b>
                                Setting Loan Policy For @Model.UpdateLoanProductCommand.LoanProductCategory.Name
                                [@Model.UpdateLoanProductCommand.ProductName] -
                                [For @Model.UpdateLoanProductCommand.LoanTerm.Name, Between @Model.UpdateLoanProductCommand.LoanTerm.MinInMonth : @Model.UpdateLoanProductCommand.LoanTerm.MaxInMonth Months]
                            </b>
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div id="datalistingview">
                                        @Html.Partial("_Update")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>












@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script>
    function preserveSelectionOrder(selectElement) {
        // Get the selected values and their order
        var selectedValues = Array.from(selectElement.selectedOptions).map(option => option.value);

        // Remove all options from the select element
        while (selectElement.options.length > 0) {
            selectElement.remove(0);
        }

        // Add the options back in the original order
        var refundOrders = @Html.Raw(Json.Encode(ViewBag.RefundOrders));
        refundOrders.forEach(function (order) {
            var option = document.createElement("option");
            option.value = order.Value;
            option.text = order.Text;
            if (selectedValues.includes(order.Value)) {
                option.selected = true;
            }
            selectElement.add(option);
        });
    }
</script>
}


