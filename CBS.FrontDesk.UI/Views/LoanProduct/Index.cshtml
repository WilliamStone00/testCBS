@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects

@{
    ViewBag.Title = "Loan Product Management";
}

<!-- 🔷 Page Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-briefcase-check-outline me-2"></i> Loan Product Management
                </h1>
                <p class="card-text">
                    Manage the creation, classification, and lifecycle of loan products using a structure that aligns with COBAC and PCMF standards.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Adhering to the correct structure is essential for risk controls, audit consistency, and SESAME reporting compliance.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<div id="lpAntiForgery" class="d-none">
    @Html.AntiForgeryToken()
</div>

<!-- 🧠 Why the Structure Matters -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-shield-check-outline me-2"></i> Why This Structure Is Important</span>
        <button class="btn btn-light btn-sm" type="button"
                data-bs-toggle="collapse" data-bs-target="#collapseWhyStructure"
                aria-expanded="false" aria-controls="collapseWhyStructure">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseWhyStructure" class="collapse">
        <div class="card-body">
            <p class="mb-3">
                This loan product configuration follows the standards defined by <strong>COBAC</strong> and <strong>PCMF</strong>.
                Respecting this structure ensures compliance, consistency, and SESAME reporting readiness.
            </p>

            <ul class="mb-3">
                <li><i class="mdi mdi-clock-outline text-primary me-2"></i><strong>Loan Term:</strong> Aligns with COBAC duration-based risk analysis.</li>
                <li><i class="mdi mdi-target text-info me-2"></i><strong>Loan Target:</strong> Classifies borrowers by segment for inclusive finance.</li>
                <li><i class="mdi mdi-format-list-bulleted-type text-success me-2"></i><strong>PCMF Loan Purpose:</strong> Maps the loan to PCMF reporting lines.</li>
                <li><i class="mdi mdi-repeat-variant text-warning me-2"></i><strong>Loan Type Category:</strong> Describes operational model for reporting and accounting.</li>
            </ul>

            <p class="mb-2">A well-structured loan product:</p>
            <ul>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Appears correctly in SESAME / COBAC reports</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Supports accurate provisioning and risk scoring</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Simplifies audit trails and monitoring</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Prevents network reporting inconsistencies</li>
            </ul>

            <p class="text-muted mb-0">
                This structure is not optional — it’s critical for regulatory compliance and system scalability.
            </p>
        </div>
    </div>
</div>

<!-- 💡 Tips Accordion -->
@Html.Partial("_LoanProductTip")

<!-- ✅ Listing Container -->
<div class="row">
    <div class="col-12">
        <div id="loanProductListContainer"></div>
    </div>
</div>

<!-- ✅ Modal (Create / Update / Manage) -->
<div class="modal fade" id="loanProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                @*<h6 class="modal-title" id="loanProductModalTitle">
                    <i class="mdi mdi-briefcase-check-outline me-1"></i> Loan Product
                </h6>*@
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="loanProductModalBody">
                <div class="text-muted">Loading...</div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    // ✅ Load list on first page open
    document.addEventListener("DOMContentLoaded", function () {
        loanProductReloadList();
    });

    // ==========================
    // LISTING
    // ==========================
    function loanProductReloadList() {
        $("#loanProductListContainer").load(
            "@Url.Action("InitializeData", "LoanProduct")?path=list&partialView=_LoanProductData",
            function () {
                initLoanProductDataTable();
            }
        );
    }

    // ==========================
    // CREATE
    // ==========================
    function openLoanProductCreateModal() {
        $("#loanProductModalTitle").html();

        $("#loanProductModalBody").load(
            "@Url.Action("InitializeData","LoanProduct")?path=new&partialView=_LoanProductSimpleForm",
            function () {
                $("#loanProductModal").modal("show");

                // ✅ init UI plugins after partial loads
                initLoanProductFormPlugins();

                // ✅ safe call if exists
                if (typeof window.loanProductInitPcmfGuidedFlow === "function") {
                    window.loanProductInitPcmfGuidedFlow();
                }
            }
        );
    }

    // ==========================
    // EDIT
    // ==========================
    function openLoanProductEditModal(id) {
        $("#loanProductModalTitle").html('<i class="mdi mdi-pencil-outline me-1"></i> Update Loan Product');

        $("#loanProductModalBody").load(
            "@Url.Action("InitializeData","LoanProduct")?path=simple_edit&partialView=_LoanProductSimpleForm&KEY=" + encodeURIComponent(id),
            function () {
                $("#loanProductModal").modal("show");

                // ✅ init UI plugins after partial loads
                initLoanProductFormPlugins();

                // ✅ safe call if exists
                if (typeof window.loanProductInitPcmfGuidedFlow === "function") {
                    window.loanProductInitPcmfGuidedFlow();
                }
            }
        );
    }

    // ==========================
    // MANAGE ACTIONS (Policy, Accounting, OD Config, etc.)
    // ==========================
    function openLoanProductManageModal(id, path, partialView) {
        $("#loanProductModalTitle").html('<i class="mdi mdi-cog-outline me-1"></i> Manage Loan Product');

        $("#loanProductModalBody").load(
            "@Url.Action("InitializeData","LoanProduct")"
            + "?KEY=" + encodeURIComponent(id)
            + "&path=" + encodeURIComponent(path)
            + "&partialView=" + encodeURIComponent(partialView),
            function () {
                $("#loanProductModal").modal("show");

                // ✅ init UI plugins after partial loads
                initLoanProductFormPlugins();

                // ✅ safe call if exists (some partials may not implement it)
                if (typeof window.loanProductInitPcmfGuidedFlow === "function") {
                    window.loanProductInitPcmfGuidedFlow();
                }
            }
        );
    }

    // ==========================
    // UTIL
    // ==========================
    function loanProductCopyText(text) {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text);
                return;
            }
        } catch { /* ignore */ }

        // fallback
        var temp = document.createElement("input");
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        document.body.removeChild(temp);
    }

    // ==========================
    // STATUS / ACTIVE TOGGLE
    // ==========================
    function loanProductToggleActive(id, makeActive) {
        var msg = makeActive ? "Activate this loan product?" : "Deactivate this loan product?";
        if (!confirm(msg)) return;

        $.post("@Url.Action("ToggleActive","LoanProduct")", { id: id, active: makeActive })
            .done(function (res) {
                alert(res.message || "Done");
                if (res.success) loanProductReloadList();
            })
            .fail(function () { alert("Operation failed."); });
    }

    // If you use AntiForgery for status change:
    function lpToken() {
        return $("#lpAntiForgery input[name='__RequestVerificationToken']").val();
    }

    function toggleLoanProductStatus(id, active) {
        var msg = active ? "Activate this product?" : "Deactivate this product?";
        if (!confirm(msg)) return;

        $.post("@Url.Action("SetStatus","LoanProduct")", {
            id: id,
            active: active,
            __RequestVerificationToken: lpToken()
        })
        .done(function (res) {
            alert(res.message || "Done");
            if (res.success) loanProductReloadList();
        })
        .fail(function () {
            alert("Status update failed.");
        });
    }

    // ==========================
    // PLUGINS (ONE VERSION ONLY ✅)
    // ==========================
    function initLoanProductFormPlugins() {
        // Select2
        if (window.$ && $.fn.select2) {
            $(".select2").each(function () {
                // avoid double-init
                if (!$(this).data("select2")) {
                    $(this).select2({ width: "100%" });
                }
            });
        }

        // Bootstrap tooltips
        if (window.bootstrap) {
            [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
                .forEach(function (el) {
                    // avoid double-init
                    if (!el._bsTooltip) el._bsTooltip = new bootstrap.Tooltip(el);
                });
        }

        // Optional: if your partials expose their own init hooks
        if (typeof window.initLoanProductSimpleForm === "function") window.initLoanProductSimpleForm();
        if (typeof window.initLoanProductAccountingMappingForm === "function") window.initLoanProductAccountingMappingForm();
        if (typeof window.initLoanProductPolicyForm === "function") window.initLoanProductPolicyForm();
    }

    // ==========================
    // DATATABLE
    // ==========================
    function initLoanProductDataTable() {
        if (!window.$ || !$.fn.DataTable) return;

        var tableId = "#loanProductsTable";

        if ($.fn.DataTable.isDataTable(tableId)) {
            $(tableId).DataTable().destroy();
        }

        $(tableId).DataTable({
            pageLength: 25,
            responsive: true,
            order: [[0, "asc"]]
        });
    }

    // ✅ Call this from your AjaxPostAndUpdate success handler
    function onLoanProductSaved(res) {
        if (res && res.success) {
            $("#loanProductModal").modal("hide");
            loanProductReloadList();
        }
    }

    function deleteLoanProduct(id) {
        if (!confirm("Delete this loan product?")) return;

        $.get("@Url.Action("Delete","LoanProduct")?KEY=" + encodeURIComponent(id))
            .done(function (res) {
                alert(res.message || "Done");
                if (res.success) loanProductReloadList();
            })
            .fail(function () { alert("Delete failed."); });
    }
    </script>
}
