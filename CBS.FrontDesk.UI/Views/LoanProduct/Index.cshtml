
@{
    ViewBag.Title = "Loan Product Management";
}

<!-- 🔷 Page Header -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-briefcase-check-outline me-2"></i> Loan Product Management
                </h1>
                <p class="card-text">
                    Manage the creation, classification, and lifecycle of loan products using a structure that aligns with COBAC and PCMF standards.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Adhering to the correct structure is essential for risk controls, audit consistency, and SESAME reporting compliance.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 🧠 Why the Structure Matters -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-shield-check-outline me-2"></i> Why This Structure Is Important</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWhyStructure" aria-expanded="false" aria-controls="collapseWhyStructure">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseWhyStructure" class="collapse">
        <div class="card-body">
            <p class="mb-3">
                This loan product configuration follows the standards defined by <strong>COBAC</strong> (Commission Bancaire de l’Afrique Centrale) and the
                <strong>PCMF</strong> (Plan Comptable des Microfinances). Respecting this structure ensures that your institution remains compliant, consistent,
                and ready for automated SESAME reporting.
            </p>
            <ul class="mb-3">
                <li>
                    <i class="mdi mdi-clock-outline text-primary me-2"></i>
                    <strong>Loan Term:</strong> Determines provisioning requirements and aligns with COBAC duration-based risk analysis.
                </li>
                <li>
                    <i class="mdi mdi-target text-info me-2"></i>
                    <strong>Loan Target:</strong> Helps classify borrowers by socioeconomic segment (e.g., SME, Individual, Group) for inclusive finance tracking.
                </li>
                <li>
                    <i class="mdi mdi-format-list-bulleted-type text-success me-2"></i>
                    <strong>Product Category:</strong> Identifies the loan’s purpose — consumption, investment, or working capital — mapped directly to PCMF account types.
                </li>
                <li>
                    <i class="mdi mdi-repeat-variant text-warning me-2"></i>
                    <strong>Loan Type Category:</strong> Describes the operational model (Overdraft, SSF-based, Line of Credit, or Main Loan) to support liquidity, reporting, and accounting structure.
                </li>
            </ul>
            <p class="mb-2">
                A well-structured loan product:
            </p>
            <ul>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Appears correctly in SESAME and COBAC Form 2 reports</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Supports accurate provisioning, interest recognition, and risk scoring</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Simplifies audit trails and branch-level monitoring</li>
                <li><i class="mdi mdi-check-bold text-success me-2"></i> Prevents reporting inconsistencies across your network</li>
            </ul>
            <p class="text-muted mb-0">
                This structure is not optional — it’s critical for regulatory compliance and long-term system scalability.
            </p>
        </div>
    </div>
</div>
<!-- 🔘 Action Buttons -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card bg-light border">
            <div class="card-body d-flex justify-content-end align-items-center">
                <div class="me-2">
                    <a type="button"
                       onclick="LoadDataGen('LoanProduct','myDataTable','_Data',0,'datalistingview')"
                       class="btn btn-outline-primary btn-sm"
                       data-bs-toggle="tooltip"
                       title="Reload and View Loan Product List">
                        <i class="mdi mdi-view-list me-1"></i> View List
                    </a>
                </div>
                <div>
                    <a href="/LoanProduct"
                       class="btn btn-primary btn-sm"
                       data-bs-toggle="tooltip"
                       title="Register a New Loan Product">
                        <i class="mdi mdi-plus me-1"></i> New Loan Product
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 💡 Tips Accordion -->
@Html.Partial("_LoanProductTip")

