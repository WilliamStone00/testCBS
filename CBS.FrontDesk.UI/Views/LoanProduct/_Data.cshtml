@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources

<div class="card border shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-light">
        <h6 class="mb-0 text-primary">
            <i class="mdi mdi-format-list-bulleted-type me-1"></i> Registered Loan Products
        </h6>
        <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
    </div>

    <div class="card-body p-3">
        @if (Model != null && Model.LoanProducts.Any())
        {
            <div class="table-responsive mb-3">
                <table class="table table-hover table-bordered table-sm" id="myDataTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">@GlobalLoanProduct.Target</th>
                            <th style="width: 16%;">@GlobalLoanProduct.Category</th>
                            <th style="width: 4%;">@GlobalLoanProduct.Code</th>
                            <th style="width: 27%;">@GlobalLoanProduct.Name</th>
                            <th style="width: 16%;">@GlobalLoanProduct.MinMax</th>
                            <th style="width: 5%;">@GlobalLoanProduct.Status</th>
                            <th style="width: 5%;">@GlobalLoanProduct.SSF</th>
                            <th style="width: 22%;">@GlobalShared.Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.LoanProducts)
                        {
                            bool hasError = d.LoanMinimumAmount <= 0 ||
                                            d.LoanMaximumAmount <= 0 ||
                                            d.LoanMinimumAmount > d.LoanMaximumAmount ||
                                            d.LoanProductCategory.Name == "N/A" ||
                                            d.TargetType == "N/A" ||
                                            d.LoanTypeCategory == "N/A" ||
                                            d.LoanTypeCategory == string.Empty ||
                                            d.LoanTypeCategory == "" ||
                                            d.LoanTerm.Name == "N/A";

                            string rowClass = hasError ? "table-danger" : "";

                            <tr class="@rowClass">
                                <td>@d.TargetType</td>
                                <td>@d.LoanProductCategory.Name</td>
                                <td>@d.ProductCode</td>
                                <td>
                                    @d.ProductName
                                    @if (hasError)
                                    {
                                        <div class="text-danger small mt-1">
                                            <ul class="mb-0">
                                                @if (d.LoanMinimumAmount <= 0)
                                                {
                                                    <li>@GlobalLoanProduct.MinAmountMustBeGreaterThan0.</li>
                                                }
                                                @if (d.LoanMaximumAmount <= 0)
                                                {
                                                    <li>@GlobalLoanProduct.MaxAmountMustBeGreaterThan0.</li>
                                                }
                                                @if (d.LoanMinimumAmount > d.LoanMaximumAmount)
                                                {
                                                    <li>@GlobalLoanProduct.MinAmountCannotExceedMaxAmount.</li>
                                                }
                                                @if (d.LoanProductCategory.Name == "N/A")
                                                {
                                                    <li>@GlobalLoanProduct.CategoryIsNotConfigured.</li>
                                                }
                                                @if (d.LoanTypeCategory == "")
                                                {
                                                    <li>@GlobalLoanProduct.CategoryIsNotConfigured.</li>
                                                }
                                                @if (d.LoanTypeCategory == string.Empty)
                                                {
                                                    <li>@GlobalLoanProduct.CategoryIsNotConfigured.</li>
                                                }
                                                @if (d.TargetType == "N/A")
                                                {
                                                    <li>@GlobalLoanProduct.TargetTypIsNotConfigured.</li>
                                                }
                                                @if (d.LoanTerm.Name == "N/A")
                                                {
                                                    <li>@GlobalLoanProduct.LoanTermIsNotConfigured.</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </td>
                                <td>@d.LoanMinimumAmount.ToString("#,##0") : @d.LoanMaximumAmount.ToString("#,##0")</td>
                                <td>
                                    @if (d.ActiveStatus)
                                    {
                                        <span class="badge bg-info">@GlobalLoanProduct.Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@GlobalLoanProduct.Inactive</span>
                                    }
                                </td>
                                <td>
                                    @switch (d.LoanTypeCategory)
                                    {
                                        case "LineOfCredit":
                                            <span class="badge bg-dark">LOC</span>
                                            break;
                                        case "Overdraft":
                                            <span class="badge bg-secondary">ODT</span>
                                            break;
                                        case "SSF":
                                            <span class="badge bg-info">SSF</span>
                                            break;
                                        case "Main_Loan":
                                            <span class="badge bg-primary">ML</span>
                                            break;
                                        default:
                                            <span class="badge bg-danger">N/A</span>
                                            break;
                                    }
                                </td>

                                <td>
                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanProduct','update_product','LoanProduct')" class="text-decoration-none me-2" data-bs-toggle="tooltip" title="@GlobalShared.Select @d.ProductName @GlobalShared.ToEdit">
                                        <i class="mdi mdi-pencil-outline me-1"></i>@GlobalShared.Edit
                                    </a>
                                    |
                                    <a href="#" class="text-danger text-decoration-none ms-2" data-bs-toggle="tooltip" title="@GlobalShared.Delete @d.ProductName" onclick="DeleteRecordDataTable('LoanProduct','@d.Id','myDataTable','_Data',0,'datalistingview')">
                                        <i class="mdi mdi-delete-outline me-1"></i>@GlobalShared.Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-3 text-muted">
                <i class="mdi mdi-information-outline me-1"></i> @GlobalLoanProduct.NoLoanProductHasBeenCreated.
            </div>
        }
    </div>
</div>
