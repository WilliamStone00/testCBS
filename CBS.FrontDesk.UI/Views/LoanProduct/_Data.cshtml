@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanProduct>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Schedule type</th>
            <th>Interest Rate</th>
            <th>Amount Range</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:10%">@d.productName</td>
                <td style="width:60%">@d.scheduleTypeId</td>
                <td style="width:60%">@d.interestRateMin-@d.interestRateMax</td>
                <td style="width:60%">@d.loanAmountMin-@d.loanAmountMax</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.loanProductId,'datalistingview','_Update','update','LoanProduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.productName to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.productName" onclick="DeleteRecordDataTable('LoanProduct','@d.loanProductId','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

