<!-- Add this modal at the bottom of the page -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editProductModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading product details...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function loadEditProductModal(productId) {
        // Show loading state
        $('#editProductModalBody').html(`
            <div class="text-center py-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading product details...</p>
            </div>
        `);

        // Show the modal
        var modal = new bootstrap.Modal(document.getElementById('editProductModal'));
        modal.show();

        // Load the partial view via AJAX
        $.ajax({
            url: '@Url.Action("InitializeData", "LoanProduct")', // Update with your controller name
            type: 'GET',
            data: {
                KEY: productId,
                partialView: '_LoanProduct',
                path: 'update_product'
            },
            success: function(response) {
                $('#editProductModalBody').html(response);
            },
            error: function(xhr, status, error) {
                $('#editProductModalBody').html(`
                    <div class="alert alert-danger">
                        <h6>Error Loading Product</h6>
                        <p>Failed to load product details. Please try again.</p>
                        <p class="small text-muted mb-0">Error: ${error}</p>
                    </div>
                `);
            }
        });
    }
</script>