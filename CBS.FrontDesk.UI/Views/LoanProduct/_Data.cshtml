@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanProduct>
@if (Model != null && Model.Any())
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Range</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="width:8%">@d.ProductCode</td>
                        <td style="width:42%">@d.ProductName</td>
                        <td style="width:20%">@d.LoanMinimumAmount.ToString("#,##0.0")-@d.LoanMaximumAmount.ToString("#,##0.0")</td>
                        <td style="width:10%">
                            @if (d.ActiveStatus)
                            {
                                <span class="badge bg-info">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </td>
                        <td style="width:20%">
                            <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_LoanProduct','update_product','LoanProduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ProductName to edit">Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.ProductName" onclick="DeleteRecordDataTable('LoanProduct','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>|
                            <a href="#" class="mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview','_SetPenalty','add_penalty','LoanProduct')" data-toggle="tooltip" data-placement="top" title="Set penalty for @d.ProductName">Penalty</a> |
                            <a href="#" class="mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','LoanProduct')" data-toggle="tooltip" data-placement="top" title="Set penalty for @d.ProductName">Policies</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center my-3">
        <p>No loan product have been created.</p>
    </div>
}
