@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources



<div class="col">

    @using (Html.BeginForm("Create", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <div class="row g-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanTermId, new SelectList(ViewBag.LoanTerms, "Id", "Name"), "---"+ @GlobalLoanProduct.Select +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanTermId, "", new { @class = "text-danger " })
                        <label>@GlobalLoanProduct.LoanTerm</label>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanProductCategoryId, new SelectList(ViewBag.ProductCategories, "Id", "Name"), "---"+ @GlobalLoanProduct.Select +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanProductCategoryId, "", new { @class = "text-danger " })
                        <label>@GlobalLoanProduct.LoanProductCategory</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.TargetType, new SelectList(ViewBag.LoanTargets, "Value", "Text"), "---"+ @GlobalLoanProduct.Select +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.TargetType, "", new { @class = "text-danger " })
                        <label>@GlobalLoanProduct.Target</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductCode, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductCode, "", new { @class = "text-danger" })
                        <label>@GlobalLoanProduct.Code</label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductName, "", new { @class = "text-danger" })
                        <label>@GlobalLoanProduct.Name</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.AddLoanProductCommand.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.Description, "", new { @class = "text-danger" })
                        <label>@GlobalLoanProduct.Description</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AddLoanProductCommand.ActiveStatus, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@GlobalLoanProduct.ActiveStatus</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AddLoanProductCommand.IsProductWithSavingFacilities, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@GlobalLoanProduct.CheckToReserveThisProductAsSSF</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                @if (ViewBag.Key == null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                    @Html.HiddenFor(m => m.AddLoanProductCommand.Id)
                    <input type="hidden" name="ServiceOption" value="insert" id="ServiceOption" />

                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                    @Html.HiddenFor(m => m.AddLoanProductCommand.Id)
                    <input type="hidden" name="ServiceOption" value="product" id="ServiceOption" />

                }
            </div>
        </fieldset>
    }

</div>



