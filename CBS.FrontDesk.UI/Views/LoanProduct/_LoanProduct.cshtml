@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources


@if (ViewBag.Key != null)
{
    <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-2">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        Edit Loan Product
                    </h1>

                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> Tips for Configuring Loan Products Effectively</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips2" aria-expanded="false" aria-controls="collapseTips2">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseTips2" class="collapse">
            <div class="card-body">
                <ul class="mb-0">
                    <li>
                        <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                        <strong>Loan Term:</strong> Use Short, Medium, or Long Term to comply with COBAC risk and provisioning rules.
                    </li>
                    <li>
                        <i class="mdi mdi-target-variant text-primary me-2"></i>
                        <strong>Target:</strong> Select the intended customer group like Individual, SME, or Group to support segmentation and reporting.
                    </li>
                    <li>
                        <i class="mdi mdi-tag-multiple-outline text-info me-2"></i>
                        <strong>Product Category:</strong> Choose based on loan use (e.g. Consumption, Investment, Working Capital) for proper PCMF classification.
                    </li>
                    <li>
                        <i class="mdi mdi-sitemap-outline text-success me-2"></i>
                        <strong>Loan Type Category:</strong> Identify if the product is an Overdraft, Line of Credit, SSF-based, or Main Loan. This affects accounting and liquidity reports.
                    </li>
                    <li>
                        <i class="mdi mdi-alert-octagon-outline text-danger me-2"></i>
                        <strong>Exceptional Loan:</strong> This loan type is reserved for special, non-standard credit arrangements that fall outside the structure of classic or revolving loan products. It is typically used in rare or sensitive scenarios where standard loan policies do not apply. Examples include:
                        <ul class="mt-1">
                            <li>⚖️ <em>Court-mandated loans</em> issued based on legal judgments or settlements</li>
                            <li>🔁 <em>Rescheduled or restructured delinquent loans</em> under exceptional board approval</li>
                            <li>🎗️ <em>Humanitarian or donor-funded relief credit</em> granted after disasters or crises</li>
                            <li>🤝 <em>One-time internal loans</em> to staff or community members under special authorization</li>
                        </ul>
                        These products must be handled with extra care and require <strong>written justification</strong> and <strong>prior validation</strong> from Internal Control, Compliance, or the Board of Directors. They are not intended for public offer or routine lending, and must be clearly documented for audit and regulatory reporting purposes.
                    </li>
                    <li>
                        <i class="mdi mdi-format-list-bulleted-type text-warning me-2"></i>
                        <strong>Chart of Account Mapping:</strong> Every loan product must be linked to the correct PCMF Chart of Account. For example, loans of short term must map to short-term loan accounts.
                    </li>
                    <li>
                        <i class="mdi mdi-timer-sand text-info me-2"></i>
                        <strong>Respect PCMF Loan Terms:</strong> When mapping to COA, ensure that the selected term (Short, Medium, Long) matches the PCMF account level structure.
                    </li>
                    <li>
                        <i class="mdi mdi-file-chart-outline text-secondary me-2"></i>
                        <strong>Reporting Alignment:</strong> Proper setup ensures automatic generation of SESAME and COBAC reports across branches.
                    </li>
                    <li>
                        <i class="mdi mdi-lock-alert-outline text-danger me-2"></i>
                        <strong>Don’t Edit Active Products:</strong> Instead, deactivate and clone to avoid inconsistencies in audit trails or regulatory forms.
                    </li>
                    <li>
                        <i class="mdi mdi-refresh-auto text-info me-2"></i>
                        <strong>Review Quarterly:</strong> Validate product configurations regularly to align with evolving COBAC standards or business strategy.
                    </li>
                    <li>
                        <i class="mdi mdi-account-check-outline text-primary me-2"></i>
                        <strong>Assign Only Authorized Editors:</strong> Product configuration rights should be restricted to approved officers or compliance managers.
                    </li>
                </ul>
            </div>

            <div class="card mb-2 border">
                <div class="card-header fw-bold text-primary">
                    <i class="mdi mdi-timetable me-1"></i> Standard Loan Term Classification (COBAC / PCMF)
                </div>
                <div class="card-body p-3">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 20%;">Loan Term</th>
                                    <th style="width: 25%;">Duration (Max)</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Short Term</strong></td>
                                    <td>Up to 12 months</td>
                                    <td>
                                        Typically used for working capital, treasury needs, or revolving credits. Must be recorded under <strong>short-term loan accounts</strong> in PCMF.
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Medium Term</strong></td>
                                    <td>Greater than 12 months and up to 36 months</td>
                                    <td>
                                        Applied to equipment financing, business expansion, or personal projects. Mapped to <strong>medium-term loan accounts</strong> in PCMF.
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Long Term</strong></td>
                                    <td>Above 36 months</td>
                                    <td>
                                        Used for long-duration projects like housing, agriculture investments, or asset acquisition. Must be posted to <strong>long-term loan accounts</strong>.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted mt-3 mb-0">
                        These classifications are essential for provisioning rules, PCMF account mapping, and generating valid SESAME reports. Always ensure your loan products respect this term structure.
                    </p>
                </div>
            </div>

        </div>



    </div>
}

    <div class="col">
        @using (Html.BeginForm("Create", "LoanProduct", FormMethod.Post, new
        {
            enctype = "multipart/form-data",
            onsubmit = "return AjaxPostAndUpdate(this);"
        }))
        {
            <fieldset class="fieldset-custom">

                <!-- 📘 Section: Loan Classification -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header fw-bold text-primary">
                        <i class="mdi mdi-bank-outline me-1"></i> Loan Classification
                    </div>
                    <div class="card-body row g-4">
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanTermId,
                                    new SelectList(ViewBag.LoanTerms, "Id", "Name"),
                                    "--- Select Term ---",
                                    new { @class = "form-control select2" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanTermId, "", new { @class = "text-danger" })
                                <label>Loan Term</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 📘 Section: Product & Target Binding -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header fw-bold text-primary">
                        <i class="mdi mdi-target-variant me-1"></i> Product & Target Binding
                    </div>
                    <div class="card-body row g-4">
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanProductCategoryId,
                                    new SelectList(ViewBag.ProductCategories, "Id", "Name"),
                                    "--- Select Category ---",
                                    new { @class = "form-control select2" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanProductCategoryId, "", new { @class = "text-danger" })
                                <label>Loan Product Category</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.AddLoanProductCommand.TargetType,
                                    new SelectList(ViewBag.LoanTargets, "Value", "Text"),
                                    "--- Select Target ---",
                                    new { @class = "form-control select2" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.TargetType, "", new { @class = "text-danger" })
                                <label>Target Type</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanTypeCategory,
                                    new SelectList(new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "[Revolving Facility] Line of Credit", Value = "LineOfCredit" },
                                        new SelectListItem { Text = "[Revolving Facility] Over-draft", Value = "Overdraft" },
                                        new SelectListItem { Text = "[Classic Loan] Loan Within Standard Saving Facilities (SSF)", Value = "SSF" },
                                        new SelectListItem { Text = "[Classic Loan] Loan Out Of Standard Saving Facilities (Main_Loan)", Value = "Main_Loan" },
                                        new SelectListItem { Text = "[Special Loan] Exceptional Loan", Value = "ExceptionalLoan" }

                                    }, "Value", "Text"),
                                    "--- Select Category ---",
                                    new { @class = "form-control select2", onchange = "handleLoanTypeChange(this.value);" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanTypeCategory, "", new { @class = "text-danger" })
                                <label>Loan Type Category</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 📘 Section: Product Details -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header fw-bold text-primary">
                        <i class="mdi mdi-format-title me-1"></i> Product Information
                    </div>
                    <div class="card-body row g-4">
                        <div class="col-md-3">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductCode, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductCode, "", new { @class = "text-danger" })
                                <label>Product Code</label>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductName, "", new { @class = "text-danger" })
                                <label>Product Name</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextAreaFor(m => m.AddLoanProductCommand.Description, new { @class = "form-control", @style = "height: 180px;" })
                                @Html.ValidationMessageFor(m => m.AddLoanProductCommand.Description, "", new { @class = "text-danger" })
                                <label>Product Description</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 📘 Section: Status & Tags -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header fw-bold text-primary">
                        <i class="mdi mdi-check-decagram-outline me-1"></i> Product Activation, Facility Link & Mortgage Tag
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AddLoanProductCommand.ActiveStatus, new { @class = "form-check-input", id = "isActive" })
                                <label class="form-check-label" for="isActive">Mark Product as Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AddLoanProductCommand.IsProductWithSavingFacilities,
                                    new { @class = "form-check-input", id = "isSSF", @checked = "checked", disabled = "disabled" })
                                <label class="form-check-label" for="isSSF">Reserve this product for Saving Facility Integration (SSF)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AddLoanProductCommand.IsMortgage,
                                    new { @class = "form-check-input", id = "isMortgage" })
                                <label class="form-check-label" for="isMortgage">Tag this product as a Mortgage Loan product</label>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 🟦 Submit -->
                <div class="mt-4">
                    @Html.HiddenFor(m => m.AddLoanProductCommand.Id)

                    @if (ViewBag.Key == null)
                    {
                        <input type="hidden" name="ServiceOption" value="insert" id="ServiceOption" />
                        <button type="submit" class="btn btn-primary">@GlobalShared.Save</button>
                    }
                    else
                    {
                        <input type="hidden" name="ServiceOption" value="product" id="ServiceOption" />
                        <button type="submit" class="btn btn-primary">@GlobalShared.Update</button>
                    }
                </div>
            </fieldset>
        }
    </div>

    <script>
        function handleLoanTypeChange(selectedValue) {
            const ssfCheckbox = document.getElementById("isSSF");

            if (selectedValue === "SSF") {
                ssfCheckbox.checked = true;
            } else {
                ssfCheckbox.checked = false;
            }
        }

        // Optional: initialize on page load (if editing existing)
        document.addEventListener("DOMContentLoaded", function () {
            const loanType = document.querySelector('[name="AddLoanProductCommand.LoanTypeCategory"]').value;
            handleLoanTypeChange(loanType);
        });
    </script>
