@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject




<div class="col">

    @using (Html.BeginForm("Create", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <fieldset class="fieldset-custom">
            <div class="row g-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanTermId, new SelectList(ViewBag.LoanTerms, "Id", "Name"), "---Select---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanTermId, "", new { @class = "text-danger " })
                        <label>Loan Term</label>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.LoanProductCategoryId, new SelectList(ViewBag.ProductCategories, "Id", "Name"), "---Select---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.LoanProductCategoryId, "", new { @class = "text-danger " })
                        <label>Loan product category</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.AddLoanProductCommand.TargetType, new SelectList(ViewBag.LoanTargets, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.TargetType, "", new { @class = "text-danger " })
                        <label>Target</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductCode, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductCode, "", new { @class = "text-danger" })
                        <label>Code</label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddLoanProductCommand.ProductName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.ProductName, "", new { @class = "text-danger" })
                        <label>Name</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.AddLoanProductCommand.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.AddLoanProductCommand.Description, "", new { @class = "text-danger" })
                        <label>Description</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AddLoanProductCommand.ActiveStatus, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">Active status</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.AddLoanProductCommand.IsProductWithSavingFacilities, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">Check to reserve this product as SSF (Special Saving Facility)</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                @if (ViewBag.Key == null)
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    @Html.HiddenFor(m => m.AddLoanProductCommand.Id)
                    <input type="hidden" name="ServiceOption" value="insert" id="ServiceOption" />

                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                    @Html.HiddenFor(m => m.AddLoanProductCommand.Id)
                    <input type="hidden" name="ServiceOption" value="product" id="ServiceOption" />

                }
            </div>
        </fieldset>
    }

</div>



