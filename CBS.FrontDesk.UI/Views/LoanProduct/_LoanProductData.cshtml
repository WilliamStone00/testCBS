@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects
@using CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure
@using Resources
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0 text-primary">
                <i class="mdi mdi-format-list-bulleted me-1"></i> @GlobalShared.loan_products
            </h6>
            <small class="text-muted">@GlobalLoanProduct.click_manage_to_preview_or_configure_policies_accounting.</small>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="loanProductReloadList()">
                <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Refresh
            </button>
            <button type="button" class="btn btn-primary btn-sm" onclick="openLoanProductCreateModal()">
                <i class="mdi mdi-plus me-1"></i> @GlobalShared.ADD_NEW
            </button>
        </div>
    </div>

    <div class="card-body">
        @if (Model?.Products == null || !Model.Products.Any())
        {
            <div class="alert alert-info mb-0">
                <i class="mdi mdi-information-outline me-1"></i>
                @Html.Raw(@GlobalLoanProduct.no_loan_products_found_click_add_new_to_create_your_first_product).
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle w-100" id="loanProductsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:120px;">@GlobalShared.Code</th>
                            <th style="min-width:240px;">@GlobalShared.Product_Name</th>
                            <th style="min-width:160px;">@GlobalShared.facility</th>
                            <th style="min-width:140px;">@GlobalLoanProduct.pcmf_codes</th>
                            <th style="min-width:110px;">@GlobalShared.Status</th>
                            <th style="min-width:120px;" class="text-end">@GlobalShared.Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@p.ProductCode</span>
                                </td>

                                <td>
                                    <div class="fw-semibold">@p.ProductName</div>
                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                    {
                                        <small class="text-muted">@p.Description</small>
                                    }
                                </td>

                                <!-- Loan Facility -->
                                <td>
                                    @switch (p.LoanFacility)
                                    {
                                        case LoanFacilityType.Classic:
                                            <span class="badge bg-label-primary">@GlobalShared.classic</span>
                                            break;
                                        case LoanFacilityType.SSF:
                                            <span class="badge bg-label-info">SSF</span>
                                            break;
                                        case LoanFacilityType.Overdraft:
                                <span class="badge bg-label-warning">@GlobalShared.Overdraft</span>
                                            break;
                                        case LoanFacilityType.LineOfCredit:
                                <span class="badge bg-label-dark">@GlobalLoanProduct.line_of_credit</span>
                                            break;
                                        default:
                                <span class="badge bg-secondary">@GlobalLoanProduct.not_mapped</span>
                                            break;
                                    }
                                </td>

                                <!-- PCMF Codes -->
                                <td>
                                    <span class="badge bg-label-secondary" title="@GlobalLoanProduct.pcmf_base_code">
                                        @p.PcmfBaseCode
                                    </span>
                                    <span class="badge bg-label-dark" title="@GlobalLoanProduct.pcmf_group_code">
                                        @p.PcmfGroupCode
                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (p.ActiveStatus)
                                    {
                                        <span class="badge bg-success">@GlobalShared.Active</span>
                                    }
                                    else
                                    {
                                <span class="badge bg-secondary">@GlobalShared.InActive</span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-end">
                                    <div class="btn-group">
                                        <!-- Main Trigger Button -->
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm dropdown-toggle"
                                                data-bs-toggle="dropdown">
                                            <i class="mdi mdi-cog-outline me-1"></i> @GlobalShared.manage
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width: 230px;">

                                            <!-- Edit -->
                                            <li class="mb-1">
                                                <a class="btn btn-outline-primary btn-sm w-100 text-primary"
                                                   onclick="openLoanProductEditModal('@p.Id')">
                                                    <i class="mdi mdi-pencil-outline me-2"></i> @GlobalShared.Edit (@GlobalShared.simple)
                                                </a>
                                            </li>

                                            <!-- Preview / Details -->
                                            <li class="mb-1">
                                                <a class="btn btn-outline-info btn-sm w-100 text-info"
                                                   onclick="openLoanProductManageModal('@p.Id','preview','_LoanProductPreview')">
                                                    <i class="mdi mdi-eye-outline me-2"></i> @GlobalShared.Details
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>

                                            <!-- Policy -->
                                            <li class="mb-1">
                                                <a class="btn btn-outline-warning btn-sm w-100 text-warning"
                                                   onclick="openLoanProductManageModal('@p.Id','policy','_Policy')">
                                                    <i class="mdi mdi-shield-check-outline me-2"></i> @GlobalShared.policy
                                                </a>
                                            </li>

                                            <!-- Accounting Mapping -->
                                            <li class="mb-1">
                                                <a class="btn btn-outline-success btn-sm w-100 text-success"
                                                   onclick="openLoanProductManageModal('@p.Id','account_mapping','_LoanProductAccountingMapping')">
                                                    <i class="mdi mdi-bank-outline me-2"></i> @GlobalShared.accounting_mapping
                                                </a>
                                            </li>

                                            <!-- Penalties -->
                                            @*<li class="mb-1">
                                                <a class="btn btn-outline-warning btn-sm w-100 text-warning"
                                                   onclick="openLoanProductManageModal('@p.Id','penalties','_LoanProductPenalties')">
                                                    <i class="mdi mdi-alert-outline me-2"></i> Penalties
                                                </a>
                                            </li>*@

                                            @if (p.LoanFacility == LoanFacilityType.Overdraft ||
                                                 p.LoanFacility == LoanFacilityType.LineOfCredit)
                                            {
                                                <li class="mb-1">
                                                    <a class="btn btn-outline-secondary btn-sm w-100 text-warning"
                                                       onclick="openLoanProductManageModal('@p.Id','overdraft','_OverdraftFacilityConfig')">
                                                        <i class="mdi mdi-credit-card-outline me-2"></i> @GlobalLoanProduct.facility_config
                                                    </a>
                                                </li>
                                            }

                                            <li><hr class="dropdown-divider"></li>

                                            <!-- Delete -->
                                            <li>
                                                <a class="btn btn-outline-danger btn-sm w-100 text-danger"
                                                   onclick="deleteLoanProduct('@p.Id')">
                                                    <i class="mdi mdi-delete-outline me-2"></i> @GlobalShared.Delete
                                                </a>
                                            </li>

                                        </ul>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
