@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProduct
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Loan Range
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.ProductCode, new { @class = "form-control", @readonly = true })
                                        @Html.ValidationMessageFor(m => m.ProductCode, "", new { @class = "text-danger" })
                                        <label>Code</label>
                                    </div>
                                </div>
                                <div class="col-md-9">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", @readonly = true })
                                        @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
                                        <label>Name</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.LoanMinimumAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.LoanMinimumAmount, "", new { @class = "text-danger" })
                                        <label>Minimum loan amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DefaultLoanAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DefaultLoanAmount, "", new { @class = "text-danger" })
                                        <label>Default loan amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.LoanMaximumAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.LoanMaximumAmount, "", new { @class = "text-danger" })
                                        <label>Maximum loan amount</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Id)
                                <input type="hidden" name="ServiceOption" value="loan_range" id="ServiceOption" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        Collateral
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.RequiresGuarantor, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Does this product reqires guarantor?</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequiredCollateral, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires collateral such as lands, building, cars, etc...</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequiredSalaryccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires salary account</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequiredShareAccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires members share account</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequiredSavingAccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires members saving account</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequredIrrivocableSalaryTransfer, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires irrivocable fund transfer</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.IsRequresRegisteredPublicAuthority, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Requires registered public authority</label>
                                    </div>
                                </div>
                                <h6>Collateral</h6>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumCollateralPercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumCollateralPercentage, "", new { @class = "text-danger" })
                                        <label>Minimum collateral rate</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DefaultCollateralPercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DefaultCollateralPercentage, "", new { @class = "text-danger" })
                                        <label>Default collateral rate</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumCollateralPercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumCollateralPercentage, "", new { @class = "text-danger" })
                                        <label>Maximum collateral rate</label>
                                    </div>
                                </div>
                                <h6>Members account</h6>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumShareAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumShareAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Minimum share account rate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumShareAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumShareAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Maximum share account rate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumSavingAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumSavingAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Minimum saving account rate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumSavingAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumSavingAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Maximum saving account rate</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.BlockedSavingAccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Blocked saving account for operations above placed amount </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumSalaryAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumSalaryAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Minimum salary account rate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumMaximumSalaryAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumMaximumSalaryAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                        <label>Maximum salary account rate</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.BlockedSalaryAccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Blocked salary account for operations above placed amount </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.BlockedGuarantorAccount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Blocked co-guarantors account for operations above placed amount </label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Id)
                                <input type="hidden" name="ServiceOption" value="gurantee" id="ServiceOption" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingPaymentMethod5">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod5"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod5">
                        Loan topup
                    </button>
                </h2>
                <div id="collapsePaymentMethod5"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod5"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {

                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.HasTopUp, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Does this product reqires top-up?</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinTopUpLoanAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinTopUpLoanAmount, "", new { @class = "text-danger" })
                                        <label>Minimum topup amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.TopUpAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.TopUpAmount, "", new { @class = "text-danger" })
                                        <label>Default topup amount</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaxTopUpLoanAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaxTopUpLoanAmount, "", new { @class = "text-danger" })
                                        <label>Maximum topup amount</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Id)
                                <input type="hidden" name="ServiceOption" value="topup" id="ServiceOption" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingDeliveryOptions">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryOptions"
                            aria-expanded="false"
                            aria-controls="collapseDeliveryOptions">
                        Interest
                    </button>
                </h2>
                <div id="collapseDeliveryOptions"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDeliveryOptions"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanInterestType, new SelectList(ViewBag.LoanInterestTypes, "Value", "Text"), "---Select interest type---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanInterestType, "", new { @class = "text-danger " })
                                        <label>Interest type</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanInterestPeriod, new SelectList(ViewBag.LoanInterestPeriods, "Value", "Text"), "---Select interest periods---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanInterestPeriod, "", new { @class = "text-danger " })
                                        <label>Interest period</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumInterestRate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumInterestRate, "", new { @class = "text-danger" })
                                        <label>Minimum interest value</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DefaultInterestRate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DefaultInterestRate, "", new { @class = "text-danger" })
                                        <label>Default interest value</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumInterestRate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumInterestRate, "", new { @class = "text-danger" })
                                        <label>Maximum interest value</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.StartGeneratingInterestAfterDisbustment, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="isActive">Check to start accrual interest after disbustment.</label>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Id)
                                <input type="hidden" name="ServiceOption" value="interest" id="ServiceOption" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingPaymentMethod">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod">
                        Duration
                    </button>
                </h2>
                <div id="collapsePaymentMethod"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod"
