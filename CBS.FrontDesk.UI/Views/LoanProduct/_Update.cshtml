                                            @Html.ValidationMessageFor(m => m.MinimumChargesStartDayAfterLoanDueDate, "", new { @class = "text-danger" })
                                            <label>Minimum days to apply charges after due date</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
