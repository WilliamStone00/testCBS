@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                @if (Model.UpdateLoanProductCommand.LoanMinimumAmount <= 0 ||
Model.UpdateLoanProductCommand.LoanMaximumAmount <= 0 ||
Model.UpdateLoanProductCommand.LoanMinimumAmount > Model.UpdateLoanProductCommand.LoanMaximumAmount)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Validation Error:</strong>
                        <ul>
                            @if (Model.UpdateLoanProductCommand.LoanMinimumAmount <= 0)
                            {
                                <li>Minimum Loan Amount must be greater than 0.</li>
                            }
                            @if (Model.UpdateLoanProductCommand.LoanMaximumAmount <= 0)
                            {
                                <li>Maximum Loan Amount must be greater than 0.</li>
                            }
                            @if (Model.UpdateLoanProductCommand.LoanMinimumAmount > Model.UpdateLoanProductCommand.LoanMaximumAmount)
                            {
                                <li>Minimum Loan Amount cannot exceed Maximum Loan Amount.</li>
                            }
                        </ul>
                    </div>
                }

                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Minimum and Down Payment Settings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Loan Range: Set the minimum, default, and maximum loan amounts to define the range within which loan amounts can vary, providing flexibility while ensuring responsible lending practices.
Key Points:
1. Minimum Loan Amount: Determine a reasonable minimum loan amount.
2. Default Loan Amount: Set based on market demand and historical data.
3. Maximum Loan Amount: Define to limit risk exposure."></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Minimum-Payment Settings</legend>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                                m => m.UpdateLoanProductCommand.TargetType,
                                                new SelectList(ViewBag.LoanTargets, "Value", "Text"),
                                                "---Select---",
                                                new { @class = "form-control select2", @search = "true", disabled = "disabled" }
                                            )
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.TargetType, "", new { @class = "text-danger " })
                                            <label>Target</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.ProductCode, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.ProductCode, "", new { @class = "text-danger" })
                                            <label>Code</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.ProductName, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.ProductName, "", new { @class = "text-danger" })
                                            <label>Name</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.UpdateLoanProductCommand.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.Description, "", new { @class = "text-danger" })
                                            <label>Description</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanMinimumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanMinimumAmount, "", new { @class = "text-danger" })
                                            <label>Minimum loan amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanMaximumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanMaximumAmount, "", new { @class = "text-danger" })
                                            <label>Maximum loan amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumDownPaymentPercentage, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumDownPaymentPercentage, "", new { @class = "text-danger" })
                                            <label>Minimum down payment rate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsPaidFeeBeforeProcessing, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Must a partial fee be paid before the loan application is processed?</label>
                                        </div>
                                    </div>

                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    <input type="hidden" name="ServiceOption" value="loan_range" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        Collateral check-list settings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Collateral Values Evaluation Settings: Define the requirements and evaluation criteria for collateral values to mitigate risk and ensure loan security.
Key Points:
1. Requires Guarantor: Determine if the product requires a guarantor for collateral.
2. Requires Collateral: Specify if collateral such as land, buildings, or cars is necessary.
3. Requires Salary Account: Decide if a salary account is needed for the loan.
4. Requires Share Account: Determine if a member's share account is required.
5. Requires Saving Account: Specify if a member's saving account is required.
6. Requires Irrevocable Salary Transfer: Decide if an irrevocable fund transfer is needed.
7. Requires Registered Public Authority: Determine if a registered public authority is required for collateral evaluation."></i>

                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Collateral check-list</legend>
                                <div class="row g-4">
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.RequiresGuarantor, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Does this product reqires guarantor?</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequiredCollateral, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Requires collateral such as lands, building, cars, etc...</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequiredSalaryccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Requires salary account</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequiredShareAccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Requires members share account</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequiredSavingAccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Requires members saving account</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequredIrrivocableSalaryTransfer, new { @class = "form-check-input", disabled = "disabled" })
                                            <label class="form-check-label" for="isActive">Requires irrivocable fund transfer</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsRequresRegisteredPublicAuthority, new { @class = "form-check-input", disabled = "disabled" })
                                            <label class="form-check-label" for="isActive">Requires registered public authority</label>
                                        </div>
                                    </div>

                                    <h6>Collateral</h6>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumCollateralPercentage, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumCollateralPercentage, "", new { @class = "text-danger" })
                                            <label>Minimum collateral rate</label>
                                        </div>
                                    </div>
                                    <h6>Members account</h6>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumShareAccountBalanceForTheRequestAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumShareAccountBalanceForTheRequestAmount, "", new { @class = "text-danger" })
                                            <label>Minimum share account balance reqired</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumSavingAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumSavingAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                            <label>Minimum saving account rate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.BlockedSavingAccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Blocked down payments for saving account. </label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumSalaryAccountBalanceRateForTheRequestAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumSalaryAccountBalanceRateForTheRequestAmount, "", new { @class = "text-danger" })
                                            <label>Minimum salary account rate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.BlockedSalaryAccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Blocked salary account for standing orders. </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.BlockedGuarantorAccount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Blocked co-guarantors account. </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                    <input type="hidden" name="ServiceOption" value="gurantee" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod5">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod5"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod5">
                        Top-up option
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Loan Top-up Limits: Define the limits and criteria for refinancing existing loans or providing top-up loans to borrowers.
Key Points:
1. Has Top-up: Determine if the product offers refinancing or top-up loan options.
2. Minimum Top-up Amount: Specify the minimum amount allowed for refinancing or top-up loans.
3. Default Top-up Amount: Set the default amount for refinancing or top-up loans.
4. Maximum Top-up Amount: Define the maximum amount allowed for refinancing or top-up loans."></i>

                    </button>
                </h2>
                <div id="collapsePaymentMethod5"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod5"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Loan top-up settings</legend>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.HasTopUp, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Does this product reqires refinancing?</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                    <input type="hidden" name="ServiceOption" value="topup" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryOptions">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryOptions"
                            aria-expanded="false"
                            aria-controls="collapseDeliveryOptions">
                        Interest settings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Interest: Set the interest type, period, and rates for the loan product.
Key Points:
1. Loan Interest Type: Determine the type of interest, such as flat or reducing balance.
2. Loan Interest Period: Specify the period for interest calculation, such as monthly or annually.
3. Minimum Interest Rate: Define the minimum interest rate applicable to the loan.
4. Default Interest Rate: Set the default interest rate for the loan product.
5. Maximum Interest Rate: Define the maximum interest rate applicable to the loan.
6. Start Generating Interest After Disbursement: Decide if interest accrual starts immediately after loan disbursement.
7. Interest Waiver: Allow for the waiver of interest charges under specific conditions for the loan product.
8. Minimum Interest Waiver Rate: Specify the minimum rate at which interest charges can be waived, expressed as a percentage.
9. Maximum Interest Waiver Rate: Define the maximum rate at which interest charges can be waived, expressed as a percentage."></i>


                    </button>
                </h2>
                <div id="collapseDeliveryOptions"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDeliveryOptions"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Interest settings</legend>
                                <div class="row g-4">
                                    @*<div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.UpdateLoanProductCommand.LoanInterestPeriod, new SelectList(ViewBag.LoanInterestPeriods, "Value", "Text"), "---Select interest periods---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanInterestPeriod, "", new { @class = "text-danger " })
                                                <label>Interest period</label>
                                            </div>
                                        </div>*@
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumInterestRate, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumInterestRate, "", new { @class = "text-danger" })
                                            <label>Minimum interest value</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MaximumInterestRate, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MaximumInterestRate, "", new { @class = "text-danger" })
                                            <label>Maximum interest value</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.StartGeneratingInterestAfterDisbustment, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Check to start accrual interest after disbustment.</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsInterestWaiverApplied, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Check to allow interest waiver for this product</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumInterestWaiver, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumInterestWaiver, "", new { @class = "text-danger" })
                                            <label>Minimum interest waiver rate (%)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MaximumInterestWaiver, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MaximumInterestWaiver, "", new { @class = "text-danger" })
                                            <label>Maximum interest waiver rate (%)</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                    <input type="hidden" name="ServiceOption" value="interest" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>


            <div class="card accordion-item mb-3">
                <!-- Check if LoanTerm is not set -->
                @if (Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A" ||
                    string.IsNullOrEmpty(Model.UpdateLoanProductCommand.LoanTerm.Name) ||
                    Model.UpdateLoanProductCommand.LoanTerm.MinInMonth == 0 ||
                    Model.UpdateLoanProductCommand.LoanTerm.MaxInMonth == 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Configuration Missing:</strong>
                        <ul>
                            @if (Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A" || string.IsNullOrEmpty(Model.UpdateLoanProductCommand.LoanTerm.Name))
                            {
                                <li>Loan Term is not configured for this loan product. Please set the loan term before updating duration parameters.</li>
                            }
                            @if (Model.UpdateLoanProductCommand.LoanTerm.MinInMonth == 0 || Model.UpdateLoanProductCommand.LoanTerm.MaxInMonth == 0)
                            {
                                <li>Loan Term duration parameters (Minimum or Maximum) are not properly set. Ensure both values are greater than 0 before updating duration parameters.</li>
                            }
                        </ul>
                    </div>
                }

                <h2 class="accordion-header" id="headingPaymentMethod">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod">
                        Duration in Months
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Duration: Set the loan duration parameters including the minimum, default, and maximum duration for the loan product.
Key Points:
1. Minimum Loan Duration: Specify the shortest duration allowed for the loan.
2. Default Loan Duration: Set the default duration for the loan product.
3. Maximum Loan Duration: Define the longest duration allowed for the loan.
4. Flexibility: Offer customizable loan durations to meet borrower needs.
5. Risk Mitigation: Balance risk and borrower preferences in setting loan duration parameters.
6. Market Analysis: Consider market trends and demand when determining loan duration limits."></i>
                    </button>
                </h2>
                <div id="collapsePaymentMethod"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Loan Duration (In Months)</legend>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.Name, new { @class = "form-control", @readonly = true })
                                            <label>Loan Duration Period</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.MinInMonth, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanTerm.MinInMonth, "", new { @class = "text-danger" })
                                            <label>Minimum month(s)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.MaxInMonth, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanTerm.MaxInMonth, "", new { @class = "text-danger" })
                                            <label>Maximum month(s)</label>
                                        </div>
                                    </div>
                                </div>

                                @*<div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanTermId)
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                    <input type="hidden" name="ServiceOption" value="duration" id="ServiceOption" />
                                </div>*@
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod7">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod7"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod7">
                        Repayment
