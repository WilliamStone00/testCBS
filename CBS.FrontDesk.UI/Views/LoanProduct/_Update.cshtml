                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.DefaultNumberOfRepayment, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.DefaultNumberOfRepayment, "", new { @class = "text-danger" })
                                            <label>Default number of repayments</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.MaximumNumberOfRepayment, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.MaximumNumberOfRepayment, "", new { @class = "text-danger" })
                                            <label>Maximum number of repayments</label>
                                        </div>
                                    </div>*@
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.ListBoxFor(m => m.RefundOrders, new MultiSelectList(ViewBag.RefundOrders, "Value", "Text"), new { @class = "select2 form-select" })
                                        @Html.ValidationMessageFor(m => m.RefundOrders, "", new { @class = "text-danger " })
                                        <label>Select repayment order. What should be repaid first?</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label>Selected refund orders</label>
                                    <div class="form-floating form-floating-outline">
                                        @if (Model.RefundOrders != null && Model.RefundOrders.Any())
                                        {
                                            <ul>
                                                @foreach (var order in Model.RefundOrders)
                                                {
                                                    <li>@order</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p>No refund orders selected</p>
                                        }

                                    </div>
                                </div>

                            </div>


                            <div class="mt-4">
