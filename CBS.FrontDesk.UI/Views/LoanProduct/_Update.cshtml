                                            @Html.ValidationMessageFor(m => m.DefaulChargesStartDayAfterLoanDueDate, "", new { @class = "text-danger" })
                                            <label>Default days to apply charges after due date</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.MaximumChargesStartDayAfterLoanDueDate, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.MaximumChargesStartDayAfterLoanDueDate, "", new { @class = "text-danger" })
                                            <label>Maximum days to apply charges after due date</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.ChargesStopAfterHowManyDaysFromStart, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.ChargesStopAfterHowManyDaysFromStart, "", new { @class = "text-danger" })
                                            <label>Specify in days when charges should stop applying to this product. (In Days)</label>
