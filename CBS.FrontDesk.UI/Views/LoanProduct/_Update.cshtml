@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                @if (Model.UpdateLoanProductCommand.LoanMinimumAmount <= 0 ||
Model.UpdateLoanProductCommand.LoanMaximumAmount <= 0 ||
Model.UpdateLoanProductCommand.LoanMinimumAmount > Model.UpdateLoanProductCommand.LoanMaximumAmount)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@GlobalLoanProduct.ValidationError:</strong>
                        <ul>
                            @if (Model.UpdateLoanProductCommand.LoanMinimumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.MinimumLoanAmountMustBeGreaterThan0.</li>
                            }
                            @if (Model.UpdateLoanProductCommand.LoanMaximumAmount <= 0)
                            {
                                <li>@GlobalLoanProduct.MaximumLoanAmountMustBeGreaterThan0.</li>
                            }
                            @if (Model.UpdateLoanProductCommand.LoanMinimumAmount > Model.UpdateLoanProductCommand.LoanMaximumAmount)
                            {
                                <li>@GlobalLoanProduct.MinimumLoanAmountCannotExceedMaximumLoanAmount.</li>
                            }
                        </ul>
                    </div>
                }

                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalLoanProduct.MinimumAndDownPaymentSettings
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.LoanRangeSetTheMinimumDefaultAndMaximumLoanAmounts.
@GlobalLoanProduct.KeyPoints:
1. @GlobalLoanProduct.MinimumLoanAmountDetermineAReasonableMinimumLoanAmount.
2. @GlobalLoanProduct.DefaultLoanAmountSetBasedOnMarketDemandAndHistoricalData.
3. @GlobalLoanProduct.MaximumLoanAmountDefineToLimitRiskExposure."></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Minimum-Payment Settings</legend>
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                                m => m.UpdateLoanProductCommand.TargetType,
                                                new SelectList(ViewBag.LoanTargets, "Value", "Text"),
                                                "---"+ @GlobalLoanProduct.Select+"---",
                                                new { @class = "form-control select2", @search = "true", disabled = "disabled" }
                                            )
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.TargetType, "", new { @class = "text-danger " })
                                            <label>@GlobalLoanProduct.Target</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.ProductCode, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.ProductCode, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Code</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.ProductName, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.ProductName, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Name</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.UpdateLoanProductCommand.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.Description, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.Description</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanMinimumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanMinimumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MinimumLoanAmount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanMaximumAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanMaximumAmount, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MaximumLoanAmount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumDownPaymentPercentage, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumDownPaymentPercentage, "", new { @class = "text-danger" })
                                            <label>@GlobalLoanProduct.MinimumDownPaymentRate</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsPaidFeeBeforeProcessing, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">@GlobalLoanProduct.MustApartialFeeBePaidBeforeTheLoanApplicationIsProcessed?</label>
                                        </div>
                                    </div>

                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                    @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                    <input type="hidden" name="ServiceOption" value="loan_range" id="ServiceOption" />
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
            @if (Model.UpdateLoanProductCommand.LoanTypeCategory=="Overdraft")
            {
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryOptions">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryOptions"
                                aria-expanded="false"
                                aria-controls="collapseDeliveryOptions">
                            @GlobalLoanProduct.InterestSettings
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.InterestSetTheInterestTypePeriodAndRatesForTheLoanProduct.
@GlobalLoanProduct.KeyPoints:
1. @GlobalLoanProduct.LoanInterestTypeDetermineTheTypeOfInterest.
2. @GlobalLoanProduct.LoanInterestPeriodSpecifyThePeriodForInterest.
3. @GlobalLoanProduct.MinimumInterestRateDefineTheMinimumInterestRateApplicableToTheLoan.
4. @GlobalLoanProduct.DefaultInterestRateSetTheDefaultInterestRateForTheLoanProduct.
5. @GlobalLoanProduct.MaximumInterestRateDefineTheMaximumInterestRate.
6. @GlobalLoanProduct.StartGeneratingInterestAfterDisbursementDecideIfInterestAccrualStarts.
7. @GlobalLoanProduct.InterestWaiverAllowForTheWaiverOfInterestCharges.
8. @GlobalLoanProduct.MinimumInterestWaiverRateSpecifyTheMinimumRate.
9. @GlobalLoanProduct.MaximumInterestWaiverRateDefineTheMaximumRate."></i>


                        </button>
                    </h2>
                    <div id="collapseDeliveryOptions"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingDeliveryOptions"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.InterestSettings</legend>
                                    <div class="row g-4">
                                        @*<div class="col-md-12">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.DropDownListFor(m => m.UpdateLoanProductCommand.LoanInterestPeriod, new SelectList(ViewBag.LoanInterestPeriods, "Value", "Text"), "---Select interest periods---", new { @class = "form-control select2", @search = "true" })
                                                    @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanInterestPeriod, "", new { @class = "text-danger " })
                                                    <label>Interest period</label>
                                                </div>
                                            </div>*@
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MinimumInterestValue</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MaximumInterestRate, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MaximumInterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumInterestValue</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.StartGeneratingInterestAfterDisbustment, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.CheckToStartAccrualInterestAfterDisbustment.</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.IsInterestWaiverApplied, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.CheckToAllowInterestWaiverForThisProduct</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MinimumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MinimumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MinimumInterestWaiverRate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.MaximumInterestWaiver, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.MaximumInterestWaiver, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumInterestWaiverRate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.StopInterestCalculationAtLoanMaturityDate, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.StopInterestCalculationAtLoaMaturityDate.</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.NumberOfDaysToStopInterestCalculation, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.NumberOfDaysToStopInterestCalculation, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumInterestWaiverRate (%)</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.UpdateLoanProductCommand.InterestMustBePaidUpFront, new { @class = "form-check-input" })
                                                <label class="form-check-label" for="isActive">@GlobalLoanProduct.InterestMustBePaidUpfront.</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                        @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                        @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                        <input type="hidden" name="ServiceOption" value="interest" id="ServiceOption" />
                                    </div>
                                </fieldset>
                            }
                        </div>
                    </div>
                </div>

                <div class="card accordion-item mb-3">
                    <!-- Check if LoanTerm is not set -->
                    @if (Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A" ||
                        string.IsNullOrEmpty(Model.UpdateLoanProductCommand.LoanTerm.Name) ||
                        Model.UpdateLoanProductCommand.LoanTerm.MinInMonth == 0 ||
                        Model.UpdateLoanProductCommand.LoanTerm.MaxInMonth == 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>@GlobalLoanProduct.ConfigurationMissing:</strong>
                            <ul>
                                @if (Model.UpdateLoanProductCommand.LoanTerm.Name == "N/A" || string.IsNullOrEmpty(Model.UpdateLoanProductCommand.LoanTerm.Name))
                                {
                                    <li>@GlobalLoanProduct.LoanTermIsNotConfiguredForThisLoanProduct.</li>
                                }
                                @if (Model.UpdateLoanProductCommand.LoanTerm.MinInMonth == 0 || Model.UpdateLoanProductCommand.LoanTerm.MaxInMonth == 0)
                                {
                                    <li>@GlobalLoanProduct.LoanTermDurationParametersAreNotProperlySet.</li>
                                }
                            </ul>
                        </div>
                    }

                    <h2 class="accordion-header" id="headingPaymentMethod">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod">
                            @GlobalLoanProduct.DurationInMonths
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.DurationSetTheLoanDurationParameters.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.MinimumLoanDurationSpecifyTheShortestDurationAllowedForTheLoan.
                            2. @GlobalLoanProduct.DefaultLoanDurationSetTheDefaultDurationForTheLoanProduct.
                            3. @GlobalLoanProduct.MaximumLoanDurationDefineTheLongestDuration.
                            4. @GlobalLoanProduct.FlexibilityOfferCustomizableLoanDurations.
                            5. @GlobalLoanProduct.RiskMitigationBalanceRiskAndBorrower.
                            6. @GlobalLoanProduct.MarketAnalysisConsiderMarketTrends."></i>
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.LoanDuration</legend>
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.Name, new { @class = "form-control", @readonly = true })
                                                <label>@GlobalLoanProduct.LoanDurationPeriod</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.MinInMonth, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanTerm.MinInMonth, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MinimumMonth</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.LoanTerm.MaxInMonth, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.LoanTerm.MaxInMonth, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.MaximumMonth</label>
                                            </div>
                                        </div>
                                    </div>

                                    @*<div class="mt-4">
                                            <button type="submit" class="btn btn-primary me-2">Update</button>
                                            @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                            @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanTermId)
                                            @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                            <input type="hidden" name="ServiceOption" value="duration" id="ServiceOption" />
                                        </div>*@
                                </fieldset>
                            }
                        </div>
                    </div>
                </div>


                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod7">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod7"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod7">
                            @GlobalLoanProduct.Repayment
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.RepaymentDefineTheRepaymentTermsAndOptionsForTheLoanProduct.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.RepaymentFrequencySpecifyHowOftenBorrowers.
                            2. @GlobalLoanProduct.RepaymentMethodDetermineTheMethods.
                            3. @GlobalLoanProduct.GracePeriodSetAGracePeriodDuringWhichBorrowers.
                            4. @GlobalLoanProduct.PenaltyChargesDefinePenaltiesForLateRepayments.
                            5. @GlobalLoanProduct.FlexibleOptionsOfferFlexibleRepaymentOptions.
                            6. @GlobalLoanProduct.CustomerEducationProvideClearInformation."></i>

                        </button>
                    </h2>
                    <div id="collapsePaymentMethod7"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod7"
                         data-bs-parent="#collapsibleSection">

                        <div class="accordion-body">
                            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalLoanProduct.RepaymentPeriods</legend>


                                    <div class="row g-4">
                                        <div class="col-md-12 mb-2">
                                            <div class="form-floating form-floating-outline">
                                                @Html.ListBoxFor(m => m.UpdateLoanProductCommand.RepaymentCycles, new MultiSelectList(ViewBag.RepaymentCycles, "Value", "Text"), new { @class = "select2 form-select" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.RepaymentCycles, "", new { @class = "text-danger " })
                                                <label>@GlobalLoanProduct.RepaymentCycles</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <label>Selected repayment cycles</label>
                                            <div class="form-floating form-floating-outline">
                                                @if (Model.UpdateLoanProductCommand.RepaymentCycles != null && Model.UpdateLoanProductCommand.RepaymentCycles.Any())
                                                {
                                                    <ul>
                                                        @foreach (var cycle in Model.UpdateLoanProductCommand.RepaymentCycles)
                                                        {
                                                            <li>@cycle</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p>@GlobalLoanProduct.NoRepaymentCyclesSelected</p>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.InterestOrder, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.InterestOrder, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.InterestOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.CapitalOrder, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.CapitalOrder, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.CapitalOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.FineOrder, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.FineOrder, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.FineOrder</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.InterestRate, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.InterestRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.InterestPercentToRefund</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.CapitalRate, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.CapitalRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.CapitalPercentToRefund</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.UpdateLoanProductCommand.FineRate, new { @class = "form-control", disabled = "disabled" })
                                                @Html.ValidationMessageFor(m => m.UpdateLoanProductCommand.FineRate, "", new { @class = "text-danger" })
                                                <label>@GlobalLoanProduct.FinePercentToRefund</label>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                        @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                        @Html.HiddenFor(m => m.UpdateLoanProductCommand.LoanProductCategoryId)
                                        <input type="hidden" name="ServiceOption" value="repayment" id="ServiceOption" />
                                    </div>
                                </fieldset>
                            }
                        </div>

                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod1">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod1"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod1">
                            @GlobalLoanProduct.DefaultedLoanSettings
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@GlobalLoanProduct.ChargesDefineTheChargePoliciesForTheLoanProduct.
                            @GlobalLoanProduct.KeyPoints:
                            1. @GlobalLoanProduct.ApplyChargesCheckThisBoxToApplyChargesToThisLoanProduct.
                            2. @GlobalLoanProduct.MinimumChargeRateSetTheMinimumChargeRateApplicableToTheLoanProduct.
                            3. @GlobalLoanProduct.DefaultChargeRateDefineTheDefaultChargeRateApplicableToTheLoanProduct.
                            4. @GlobalLoanProduct.MinimumDaysToApplyChargesAfterDueDateSpecifyTheMinimumNumberOfDays.
                            5. @GlobalLoanProduct.MaximumDaysToApplyChargesAfterDueDateSpecifyTheMaximumNumberOfDaysToApply.
                            6. @GlobalLoanProduct.DefaultDaysToApplyChargesAfterDueDateSetTheDefaultNumberOfDaysToApply.
                            7. @GlobalLoanProduct.MaximumChargeRateDefineTheMaximumChargeRateApplicableToTheLoanProduct.
                            8. @GlobalLoanProduct.ChargesCessationSpecifyTheNumberOfDaysAfterWhichChargesShouldStopApplying.
                            9. @GlobalLoanProduct.ChargesAppliedOnSelectWhetherChargesAreAppliedToInterestOrBalance.
                            "></i>
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod1"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod1"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
