                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanDurationPeriod, new SelectList(ViewBag.LoanDurationPeriods, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanDurationPeriod, "", new { @class = "text-danger " })
                                        <label>Loan duration period</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumDurationPeriod, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumDurationPeriod, "", new { @class = "text-danger" })
                                        <label>Minimum loan duration period</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DefaultDurationsPeriod, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DefaultDurationsPeriod, "", new { @class = "text-danger" })
                                        <label>Default loan duration period</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumDurationPeriod, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumDurationPeriod, "", new { @class = "text-danger" })
                                        <label>Maximum loan duration period</label>
                                    </div>
                                </div>
                            </div>


                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Update</button>
                                @Html.HiddenFor(m => m.Id)
                                <input type="hidden" name="ServiceOption" value="duration" id="ServiceOption" />
                            </div>
                        }

                    </div>

                </div>
            </div>
            <div class="card accordion-item">
                <h2 class="accordion-header" id="headingPaymentMethod7">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod7"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod7">
                        Repayment
                    </button>
                </h2>
                <div id="collapsePaymentMethod7"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod7"
                     data-bs-parent="#collapsibleSection">

                    <div class="accordion-body">
                        @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.ListBoxFor(m => m.RepaymentCycles, new MultiSelectList(ViewBag.RepaymentCycles, "Value", "Text"), new { @class = "select2 form-select" })
                                        @Html.ValidationMessageFor(m => m.RepaymentCycles, "", new { @class = "text-danger " })
                                        <label>Select repayment cycles</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <label>Selected repayment cycles</label>
                                    <div class="form-floating form-floating-outline">
                                        @if (Model.RepaymentCycles != null && Model.RepaymentCycles.Any())
                                        {
                                            <ul>
                                                @foreach (var cycle in Model.RepaymentCycles)
                                                {
                                                    <li>@cycle</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p>No repayment cycles selected</p>
                                        }
                                    </div>
