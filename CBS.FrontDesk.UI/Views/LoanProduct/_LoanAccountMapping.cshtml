@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources

<div class="col">
    <div class="row my-4">
        <div class="accordion" id="accountMappingAccordion">
            <!-- PRODUCT INFO CARD (Always visible) -->
            <div class="card mb-3 border-primary">
                <div class="card-header bg-light  d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-info-circle me-2"></i>
                        @GlobalLoanProduct.TERM: [@Model.UpdateLoanProductCommand.LoanTerm.Name],
                        @GlobalLoanProduct.PRODUCT_NAME: [@Model.UpdateLoanProductCommand.ProductName]
                    </h5>
                    <span class="badge bg-light text-primary">@GlobalLoanProduct.ProductCode: @Model.UpdateLoanProductCommand.ProductCode</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label text-muted small">@GlobalLoanProduct.ProductName</label>
                                <p class="mb-0 fw-bold">@Model.UpdateLoanProductCommand.ProductName</p>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label text-muted small">@GlobalLoanProduct.ProductDescription</label>
                                <p class="mb-0">@Model.UpdateLoanProductCommand.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm("Update", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);", @class = "select2-dropdown-form" }))
            {
                <!-- 1. TAXIBLE LOAN GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingTaxible">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseTaxible" aria-expanded="false" aria-controls="collapseTaxible">
                            <strong class="text-primary">Taxible Loan GLs</strong>
                        </button>
                    </div>
                    <div id="collapseTaxible" class="accordion-collapse collapse"
                         aria-labelledby="headingTaxible" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts used when this loan product is taxible.
                            </p>

                            <!-- Taxible Principal -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTaxiblePrincipalAmount,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---Select---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTaxiblePrincipalAmount,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>Taxible Principal Disbursement Account</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account where the principal of taxible loans is disbursed.
                                    </small>
                                </div>
                            </div>

                            <!-- Taxible Interest -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTaxibleInterestReceived,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---Select---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTaxibleInterestReceived,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>Taxible Interest Received Account</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account where interest income from taxible loans is recorded.
                                    </small>
                                </div>
                            </div>

                            <!-- Tax (Taxible) -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTax,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForTax,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.TaxAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account used to record tax on taxible loan products.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. NONE TAXIBLE LOAN GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingNonTaxible">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseNonTaxible" aria-expanded="false" aria-controls="collapseNonTaxible">
                            <strong class="text-primary">None Taxible Loan GLs</strong>
                        </button>
                    </div>
                    <div id="collapseNonTaxible" class="accordion-collapse collapse"
                         aria-labelledby="headingNonTaxible" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts for loans that are not taxible.
                            </p>

                            <!-- Principal (None Taxible) -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForPrincipalAmount,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForPrincipalAmount,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.PrincipalDisbursementAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account where principal is disbursed for none taxible loans.
                                    </small>
                                </div>
                            </div>

                            <!-- Interest Received (None Taxible) -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForInterestReceived,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForInterestReceived,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.InterestReceivedAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account where interest income from none taxible loans is recorded.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. FEES MANAGEMENT GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingFees">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseFees" aria-expanded="false" aria-controls="collapseFees">
                            <strong class="text-primary">Fees Management GLs</strong>

                        </button>
                    </div>
                    <div id="collapseFees" class="accordion-collapse collapse"
                         aria-labelledby="headingFees" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts used to manage fees and penalties on loans.
                            </p>

                            <!-- Penalty (Fees Management) -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForPenalty,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForPenalty,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.PenaltyAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account used to record penalties charged on loans.
                                    </small>
                                </div>
                            </div>

                            <!-- Fee (Fees Management) -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForFee,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---Select---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForFee,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>Fee Account</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account used to record fees related to this loan product.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. WRITTEN OFF GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingWriteOff">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseWriteOff" aria-expanded="false" aria-controls="collapseWriteOff">
                            <strong class="text-primary">Written Off GLs</strong>
                        </button>
                    </div>
                    <div id="collapseWriteOff" class="accordion-collapse collapse"
                         aria-labelledby="headingWriteOff" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts used when loan balances are written off.
                            </p>

                            <!-- Write-off Principal -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForWriteOffPrincipal,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForWriteOffPrincipal,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.WriteOffAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account used when loan principal is written off.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. PROVISIONING GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingProvision">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseProvision" aria-expanded="false" aria-controls="collapseProvision">
                            <strong class="text-primary">Provisioning GLs</strong>
                        </button>
                    </div>
                    <div id="collapseProvision" class="accordion-collapse collapse"
                         aria-labelledby="headingProvision" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts used for loan loss provisioning by aging buckets.
                            </p>

                            <!-- Provision > 1 Year -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanOneYear,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanOneYear,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.ProvisionAccountForLoansExceeding1Year</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account to hold provisions for loans exceeding 1 year.
                                    </small>
                                </div>
                            </div>

                            <!-- Provision > 2 Years -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanTwoYear,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---Select---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanTwoYear,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.ProvisionAccountForLoansExceeding2Year</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account to hold provisions for loans exceeding 2 years.
                                    </small>
                                </div>
                            </div>

                            <!-- Provision > 3 Years -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanThreeYear,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanThreeYear,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.ProvisionAccountForLoansExceeding3Year</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account to hold provisions for loans exceeding 3 years.
                                    </small>
                                </div>
                            </div>

                            <!-- Provision > 4 Years -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanFourYear,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForProvisionMoreThanFourYear,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.ProvisionAccountForLoansExceeding4Year</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        GL account to hold provisions for loans exceeding 4 years.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. LOAN TRANSIT GLs -->
                <div class="card accordion-item mb-3">
                    <div class="accordion-header" id="headingTransit">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapseTransit" aria-expanded="false" aria-controls="collapseTransit">
                            <strong class="text-primary">Loan Transit GLs</strong>

                        </button>
                    </div>
                    <div id="collapseTransit" class="accordion-collapse collapse"
                         aria-labelledby="headingTransit" data-bs-parent="#accountMappingAccordion">
                        <div class="accordion-body">
                            <p class="text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Configure GL accounts used as transit during loan movements.
                            </p>

                            <!-- Loan Transit -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForLoanTransition,
                                            new SelectList(ViewBag.ChartOfAccounts, "Value", "Text"),
                                            "---" + @GlobalLoanProduct.Select + "---",
                                            new { @class = "form-control select2-dropdown", @search = "true", data_dropdown_position = "below" })
                                        @Html.ValidationMessageFor(
                                            m => m.UpdateLoanProductCommand.ChartOfAccountIdForLoanTransition,
                                            "",
                                            new { @class = "text-danger" })
                                        <label>@GlobalLoanProduct.LoanTransitAccount</label>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-circle me-1" style="font-size: 6px;"></i>
                                        Transit GL account used during loan disbursement, refinancing or internal movements.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FORM SUBMIT SECTION -->
                <div class="card mt-4 border-primary">
                    <div class="card-body bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 text-primary">
                                    <i class="fas fa-save me-2"></i>Save Account Mapping
                                </h6>
                                <small class="text-muted">
                                    Save all account mapping configurations for this product
                                </small>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-check-circle me-2"></i>@GlobalLoanProduct.MapAccounts
                                </button>
                                @Html.HiddenFor(m => m.UpdateLoanProductCommand.Id)
                                <input type="hidden" name="ServiceOption" value="accounting" id="ServiceOption" />
                                <input type="hidden" name="UpdateOption" value="assign_account_chart" id="UpdateOption" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .accordion-button {
        font-weight: 600;
        padding: 1rem 1.5rem;
    }

        .accordion-button:not(.collapsed) {
            background-color: rgba(0, 123, 255, 0.05);
            color: #495057;
        }

        .accordion-button:focus {
            box-shadow: none;
            border-color: rgba(0, 123, 255, 0.25);
        }

    .accordion-body {
        padding: 1.5rem;
        background-color: #fafafa;
    }

    .accordion-item {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        overflow: hidden;
    }

        .accordion-item:not(:last-child) {
            margin-bottom: 0.75rem;
        }

    .card-header {
        border-bottom: 1px solid rgba(0,0,0,.125);
    }

    .form-floating {
        margin-bottom: 0.5rem;
    }

    .text-muted small {
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }

    /* Select2 dropdown positioning styles */
    .select2-container--open .select2-dropdown {
        position: fixed !important;
        z-index: 9999 !important;
        max-height: 300px;
        overflow-y: auto;
    }

    /* Modal-specific styles to ensure dropdowns appear correctly */
    #accountMappingModal .select2-container--open .select2-dropdown {
        z-index: 99999 !important;
    }

    /* Ensure the select2 dropdown appears above modal content */
    .modal-open .select2-container--open .select2-dropdown {
        z-index: 99999 !important;
    }

    /* Adjust dropdown position for modal */
    .select2-dropdown {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    /* Ensure the select2 container doesn't overflow */
    .select2-container {
        width: 100% !important;
    }
</style>

<script>
    // Initialize Bootstrap 5 tooltips if needed
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Initialize select2 with custom positioning
        if ($.fn.select2) {
            $('.select2-dropdown').each(function () {
                var $this = $(this);
                var position = $this.data('dropdown-position') || 'below';

                $this.select2({
                    dropdownParent: $this.closest('.accordion-body'),
                    width: '100%',
                    dropdownAutoWidth: true,
                    dropdownCssClass: 'select2-dropdown-position-' + position,
                    // Force dropdown to open in specific position
                    dropdownAdapter: function ($select2) {
                        var DropdownAdapter = $.fn.select2.amd.require('select2/dropdown');
                        var dropdown = new DropdownAdapter($select2);

                        // Override the position method to control dropdown position
                        var originalPosition = dropdown.position;
                        dropdown.position = function (dropdownContainer, container) {
                            var $container = $(container.$container);
                            var $dropdown = $(dropdownContainer);

                            // Get position of select2 container
                            var containerRect = $container[0].getBoundingClientRect();
                            var viewportHeight = window.innerHeight;

                            if (position === 'above') {
                                // Position above the input
                                $dropdown.css({
                                    position: 'fixed',
                                    top: (containerRect.top - $dropdown.outerHeight() - 5) + 'px',
                                    left: containerRect.left + 'px',
                                    width: containerRect.width + 'px'
                                });
                            } else {
                                // Position below the input (default)
                                var bottomSpace = viewportHeight - containerRect.bottom;

                                // If there's not enough space below, position above
                                if (bottomSpace < 200 && containerRect.top > 300) {
                                    $dropdown.css({
                                        position: 'fixed',
                                        top: (containerRect.top - $dropdown.outerHeight() - 5) + 'px',
                                        left: containerRect.left + 'px',
                                        width: containerRect.width + 'px'
                                    });
                                } else {
                                    $dropdown.css({
                                        position: 'fixed',
                                        top: (containerRect.bottom + 5) + 'px',
                                        left: containerRect.left + 'px',
                                        width: containerRect.width + 'px'
                                    });
                                }
                            }

                            // Ensure dropdown stays within viewport
                            var dropdownRect = $dropdown[0].getBoundingClientRect();

                            if (dropdownRect.right > window.innerWidth) {
                                $dropdown.css('left', (window.innerWidth - dropdownRect.width - 10) + 'px');
                            }

                            if (dropdownRect.left < 0) {
                                $dropdown.css('left', '10px');
                            }
                        };

                        return dropdown;
                    }
                });

                // Handle dropdown opening event to adjust position
                $this.on('select2:open', function (e) {
                    setTimeout(function () {
                        var $select2 = $this;
                        var $dropdown = $select2.data('select2').$dropdown;
                        var position = $select2.data('dropdown-position') || 'below';

                        if ($dropdown.length) {
                            var containerRect = $select2.closest('.select2-container')[0].getBoundingClientRect();
                            var viewportHeight = window.innerHeight;
                            var dropdownHeight = $dropdown.outerHeight();

                            // Determine best position
                            var spaceBelow = viewportHeight - containerRect.bottom - 10;
                            var spaceAbove = containerRect.top - 10;

                            // Choose position based on available space
                            if (position === 'above' || (spaceBelow < dropdownHeight && spaceAbove > dropdownHeight)) {
                                // Position above
                                $dropdown.css({
                                    position: 'fixed',
                                    top: (containerRect.top - dropdownHeight - 5) + 'px',
                                    left: containerRect.left + 'px',
                                    width: containerRect.width + 'px',
                                    maxHeight: '300px',
                                    overflowY: 'auto'
                                });
                            } else {
                                // Position below
                                $dropdown.css({
                                    position: 'fixed',
                                    top: (containerRect.bottom + 5) + 'px',
                                    left: containerRect.left + 'px',
                                    width: containerRect.width + 'px',
                                    maxHeight: '300px',
                                    overflowY: 'auto'
                                });
                            }

                            // Ensure dropdown is visible
                            $dropdown.css('z-index', '99999');
                        }
                    }, 10);
                });
            });
        }

        // Auto-expand first accordion item if it has validation errors
        setTimeout(function () {
            var firstError = $('.text-danger:visible').first();
            if (firstError.length) {
                var accordionItem = firstError.closest('.accordion-item');
                var collapseId = accordionItem.find('.accordion-collapse').attr('id');
                if (collapseId) {
                    var bsCollapse = new bootstrap.Collapse(document.getElementById(collapseId), {
                        toggle: true
                    });
                }
            }
        }, 500);

        // Handle modal scrolling to keep dropdowns positioned correctly
        $('#accountMappingModal').on('shown.bs.modal', function () {
            // Recalculate dropdown positions when modal is fully shown
            setTimeout(function () {
                $('.select2-dropdown').each(function () {
                    var $select2 = $(this);
                    var select2Instance = $select2.data('select2');
                    if (select2Instance && select2Instance.isOpen()) {
                        $select2.trigger('select2:open');
                    }
                });
            }, 300);
        });

        // Handle window resize
        $(window).on('resize', function () {
            $('.select2-dropdown').each(function () {
                var $select2 = $(this);
                var select2Instance = $select2.data('select2');
                if (select2Instance && select2Instance.isOpen()) {
                    $select2.trigger('select2:open');
                }
            });
        });

        // Handle accordion collapse to reposition dropdowns
        $('.accordion-button').on('click', function () {
            setTimeout(function () {
                $('.select2-dropdown').each(function () {
                    var $select2 = $(this);
                    var select2Instance = $select2.data('select2');
                    if (select2Instance && select2Instance.isOpen()) {
                        $select2.trigger('select2:open');
                    }
                });
            }, 350); // Wait for collapse animation
        });
    });
</script>