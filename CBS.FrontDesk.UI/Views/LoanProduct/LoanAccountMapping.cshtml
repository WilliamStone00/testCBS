<!-- Make sure Bootstrap 5 CSS & JS are loaded on the page -->

<div class="container-fluid">
    <div class="row">
        <div class="col-12">

            <!-- Header card -->
            <div class="card bg-light mb-3">
                <div class="card-body text-center py-4">
                    <h1 class="card-title text-primary mb-2">
                        <i class="mdi mdi-file-cog me-2"></i>
                        @GlobalLoanProduct.LoanProductListingForAccountingMapping
                    </h1>
                    <p class="card-text mb-3">
                        @ChequeManagements.headtextconf
                    </p>
                    <hr class="mx-auto" style="width:95%; border-color: rgba(128,128,128,0.35);" />
                </div>
            </div>
          
            <div class="card mb-3">          
                <div class="card-body">
                    <div>
                        <h5 class="text-primary">
                            <i class="mdi mdi-file-cog me-2"></i>
                            @GlobalLoanProduct.LoanProductListingForAccountingMapping
                        </h5>
                    </div>
                    <div id="mainviewChange">
                        <div class="change-group">
                            <div id="datalistingview">
                                <!-- Injected content goes here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div> 
    </div> 
</div> 


@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/Loan/Product/AccountMapping.js"></script>
}


