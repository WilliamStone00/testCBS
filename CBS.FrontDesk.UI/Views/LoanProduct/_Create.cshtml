@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProduct
<div class="card-body">
    @using (Html.BeginForm("Create", "LoanProduct", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.productCode, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.productCode, "", new { @class = "text-danger" })
                    <label>Code</label>
                </div>
            </div>
            <div class="col-md-8">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.productName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.productName, "", new { @class = "text-danger" })
                    <label>Name</label>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.customerProfiles, new MultiSelectList(ViewBag.CustomerProfiles, "Text", "Value"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.customerProfiles, "", new { @class = "text-danger " })
                    <label>Availability</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.scheduleTypeId, new SelectList(ViewBag.SheduleTypes, "Value", "Text"), "---Select type of schedule---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.scheduleTypeId, "", new { @class = "text-danger " })
                    <label>Schedule type</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.installmentTypeId, new SelectList(ViewBag.InstallmentTypes, "id", "name"), "---Select type of schedule---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.installmentTypeId, "", new { @class = "text-danger " })
                    <label>Installment type</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.currencyId, new SelectList(ViewBag.Currencies, "Id", "Code"), "---Select currency---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.currencyId, "", new { @class = "text-danger " })
                    <label>Currency</label>
                </div>
            </div>
            @*<div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.fundingLineId, new SelectList(ViewBag.FundingLines, "id", "name"), "---Select Funding line---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.fundingLineId, "", new { @class = "text-danger " })
                <label>Funding line</label>
            </div>
        </div>*@

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.interestRateMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.interestRateMin, "", new { @class = "text-danger" })
                    <label>Minimum interest rate</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.interestRateMax, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.interestRateMax, "", new { @class = "text-danger" })
                    <label>Maximum interest rate</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.loanAmountMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.loanAmountMin, "", new { @class = "text-danger" })
                    <label>Minimum loan amount</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.loanAmountMax, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.loanAmountMax, "", new { @class = "text-danger" })
                    <label>Maximum loan amount</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.numberOfInstallmentMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.numberOfInstallmentMin, "", new { @class = "text-danger" })
                    <label>Minimum number of installment</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.numberOfInstallmentMax, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.numberOfInstallmentMax, "", new { @class = "text-danger" })
                    <label>Maximum number of installment</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.numberOfGracePeriodMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.numberOfGracePeriodMin, "", new { @class = "text-danger" })
                    <label>Minimum number of grace period</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.numberOfGracePeriodMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.numberOfGracePeriodMin, "", new { @class = "text-danger" })
                    <label>Maximum number of grace period</label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.hasTopUp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActive">Allow top up</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.topUpAmountMin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.topUpAmountMin, "", new { @class = "text-danger" })
                    <label>Mimimum topup amount</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.topUpAmountMax, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.topUpAmountMax, "", new { @class = "text-danger" })
                    <label>Maximum topup amount</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.topUpAmountAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.topUpAmountAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Accounting roles associated to topup</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.fees, new MultiSelectList(ViewBag.Fees, "id", "nameOfFee"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.fees, "", new { @class = "text-danger " })
                    <label>Early entry fees</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.penaltyIds, new MultiSelectList(ViewBag.Penalties, "id", "penaltyName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.penaltyIds, "", new { @class = "text-danger " })
                    <label>Penalties</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.earlyPartialRepaymentFeeRate, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.earlyPartialRepaymentFeeRate, "", new { @class = "text-danger" })
                    <label>Early partial repayment fee in percentage</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.earlyPartialRepaymentFeeAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.earlyPartialRepaymentFeeAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Select the associated accounting roles</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.earlyTotalRepaymentFeeRate, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.earlyTotalRepaymentFeeRate, "", new { @class = "text-danger" })
                    <label>Early total repayment fee in percentage</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.earlyTotalRepaymentFeeRateAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.earlyTotalRepaymentFeeRateAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Select the associated accounting roles</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.fundingLineId, new SelectList(ViewBag.FundingLines, "Id", "name"), "---Select funding line---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.fundingLineId, "", new { @class = "text-danger " })
                    <label>Funding  line for this product</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.taxId, new SelectList(ViewBag.Taxes, "Id", "name"), "---Select Tax---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.taxId, "", new { @class = "text-danger " })
                    <label>Tax</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.guaranteePackId, new SelectList(ViewBag.GuranteePackes, "Id", "name"), "---Select guarantee pack---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.guaranteePackId, "", new { @class = "text-danger " })
                    <label>Guarantee packes</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.documentPackId, new SelectList(ViewBag.DocumentPackes, "Id", "name"), "---Select documents pack---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.documentPackId, "", new { @class = "text-danger " })
                    <label>Document packes</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.feeOverdueInterestAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.feeOverdueInterestAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Accounting roles related to overdue interest</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.feeOverduePrincipalAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.feeOverduePrincipalAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Accounting roles related to overdue capital</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.feeOlbAccountingRuleId, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.feeOlbAccountingRuleId, "", new { @class = "text-danger " })
                    <label>Accounting roles related to OLB (Outstanding Loan Balance)</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.ListBoxFor(m => m.accountingRuleIds, new MultiSelectList(ViewBag.AccountingRules, "id", "ruleName"), new { @class = "select2 form-select" })
                    @Html.ValidationMessageFor(m => m.accountingRuleIds, "", new { @class = "text-danger " })
                    <label>Accounting roles</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Save</button>
            <button type="reset" class="btn btn-outline-secondary">Reset</button>
        </div>
    }
</div>