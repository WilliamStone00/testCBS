                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumDurationPeriod, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumDurationPeriod, "", new { @class = "text-danger" })
                                        <label>Maximum loan duration period</label>
