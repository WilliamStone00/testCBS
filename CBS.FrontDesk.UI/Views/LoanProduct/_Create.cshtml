                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.LoanMaximumAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.LoanMaximumAmount, "", new { @class = "text-danger" })
                                        <label>Maximum loan amount</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.ActiveStatus, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Active status</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item">
