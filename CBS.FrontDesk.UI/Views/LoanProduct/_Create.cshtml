                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MinimumCreditInsurancePercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MinimumCreditInsurancePercentage, "", new { @class = "text-danger" })
                                        <label>Minimum credit insurance rate</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.DefaultCreditInsurancePercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.DefaultCreditInsurancePercentage, "", new { @class = "text-danger" })
                                        <label>Default credit insurance rate</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.MaximumCreditInsurancePercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.MaximumCreditInsurancePercentage, "", new { @class = "text-danger" })
                                        <label>Maximum credit insurance rate</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item">
