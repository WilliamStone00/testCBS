                                            {
                                                <li>@GlobalLoanProduct.CategoryIsNotConfigured.</li>
                                            }
                                            @if (d.TargetType == "N/A")
                                            {
                                                <li>@GlobalLoanProduct.TargetTypIsNotConfigured.</li>
                                            }
                                            @if (d.LoanTerm.Name == "N/A")
                                            {
                                                <li>@GlobalLoanProduct.LoanTermIsNotConfigured.</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </td>
                            <td>@d.LoanMinimumAmount.ToString("#,##0") : @d.LoanMaximumAmount.ToString("#,##0")</td>
                            <td>
                                @if (d.ActiveStatus)
                                {
                                    <span class="badge bg-info">@GlobalLoanProduct.Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@GlobalLoanProduct.Inactive</span>
                                }
                            </td>
                            <td>
                                @switch (d.LoanTypeCategory)
                                {
                                    case "LineOfCredit":
                                        <span class="badge bg-dark">LOC</span>
                                        break;
                                    case "Overdraft":
                                        <span class="badge bg-secondary">ODT</span>
                                        break;
                                    case "SSF":
                                        <span class="badge bg-info">SSF</span>
                                        break;
                                    case "Main_Loan":
                                        <span class="badge bg-primary">ML</span>
                                        break;
                                    default:
                                        <span class="badge bg-danger">N/A</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a href="#" class="mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanAccountMapping','account_mapping','LoanProduct')" data-toggle="tooltip" data-placement="top" title="Set account mapping for @d.ProductName">@GlobalLoanProduct.AccMap</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center my-3">
            <p>@GlobalLoanProduct.NoLoanProductHasBeenCreated.</p>
        </div>
    }*@


@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources

<!-- Account Mapping Modal -->
<div class="modal fade" id="accountMappingModal" tabindex="-1" role="dialog" aria-labelledby="accountMappingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">          
            <div class="modal-body p-0">
                <div class="container-fluid p-0">
                    <div class="row m-0">
                        <div class="col-12 p-4">                       

                            <div class="card bg-light mb-2">
                                <div class="d-flex">
                                    <div class="card-body text-center">
                                        <h5 class="modal-title text-primary" id="accountMappingModalLabel" >
                                            <i class="fas fa-exchange-alt me-2"></i>Account Mapping
                                            <button type="button" class="close text-black opacity-100" data-dismiss="modal" aria-label="Close" style="font-size: 1.8rem; margin-left: auto;">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </h5>
                                        <p class="card-text">

                                        </p>
                                        <div class="alert alert-info mt-3 py-2">
                                            <i class="mdi mdi-information-outline me-1"></i>
                                            Map your loan product to the appropriate GL accounts. This ensures proper accounting and financial reporting.
                                        </div>
                                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                                    </div>
                                </div>
                            </div>

                            <!-- Content will be loaded here -->
                            <div id="accountMappingModalBody">
                                <div class="text-center p-5">
                                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                    <p class="mt-3 text-muted">Loading account mapping configuration...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light" style="border-top: 1px solid #dee2e6;">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>                
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom border colors */
    .border-start-info-3 {
        border-left-width: 4px !important;
        border-left-color: #17a2b8 !important;
    }

    .border-light-gray {
        border-color: #e0e0e0 !important;
    }

    /* Smooth transitions */
    #accountMappingModal .modal-content {
        border: none;
        border-radius: 0.5rem;
        overflow: hidden;
    }

    #accountMappingModal .modal-header {
        padding: 1rem 1.5rem;
    }

    #accountMappingModal .modal-body {
        min-height: 300px;
    }

    /* Better close button */
    #accountMappingModal .close {
        opacity: 0.8;
        transition: opacity 0.2s;
        line-height: 1;
        padding: 0.5rem;
        margin: -0.5rem -0.5rem -0.5rem auto;
    }

    #accountMappingModal .close:hover {
        opacity: 1;
        background-color: rgba(255,255,255,0.1);
        border-radius: 0.25rem;
    }

    /* Tip box enhancements */
    .alert-light {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    /* Loading spinner container */
    #accountMappingModalBody {
        transition: opacity 0.3s ease;
    }

</style>

