@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@if (Model != null && Model.LoanProducts.Any())
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Range</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanProducts)
                {
                    <tr>
                        <td style="width:8%">@d.ProductCode</td>
                        <td style="width:47%">@d.ProductName</td>
                        <td style="width:20%">@d.LoanMinimumAmount.ToString("#,##0.0")</td>
                        <td style="width:10%">
                            @if (d.ActiveStatus)
                            {
                                <span class="badge bg-info">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </td>
                        <td style="width:15%">
                            <a href="#" class="mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanAccountMapping','account_mapping','LoanProduct')" data-toggle="tooltip" data-placement="top" title="Set account mapping for @d.ProductName">Acc Mapping</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center my-3">
        <p>No loan product have been created.</p>
    </div>
}
