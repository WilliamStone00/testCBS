<script>
    // Store current product ID for save operation
    var currentProductId = null;

    function showAccountMappingModal(key, productName) {
        currentProductId = key;

        // Show loading state
        $('#accountMappingModalBody').html(`
            <div class="text-center p-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Loading account mapping for <strong>${productName}</strong>...</p>
            </div>
        `);

        // Hide save button initially
        $('#saveAccountMappingBtn').hide();

        // Set modal title
        $('#accountMappingModalLabel').html(`<i class="fas fa-exchange-alt me-2"></i>Account Mapping - ${productName}`);

        // Make AJAX call to the controller
        $.ajax({
            url: '@Url.Action("InitializeData", "LoanProduct")',
            type: 'GET',
            data: {
                KEY: key,
                partialView: '_LoanAccountMapping',
                path: 'account_mapping'
            },
            success: function(response) {
                $('#accountMappingModalBody').html(response);

                // Show save button if there's a form
                if ($('#accountMappingModalBody form').length > 0) {
                    $('#saveAccountMappingBtn').show();
                }

                // Reinitialize tooltips if needed
                $('[data-toggle="tooltip"]').tooltip();

                // Initialize any select2 dropdowns if present
                if ($.fn.select2) {
                    $('#accountMappingModalBody select').select2({
                        dropdownParent: $('#accountMappingModal')
                    });
                }
            },
            error: function(xhr, status, error) {
                $('#accountMappingModalBody').html(`
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> Error</h4>
                        <p>Failed to load account mapping configuration.</p>
                        <hr>
                        <p class="mb-0 small">Error details: ${error}</p>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                `);
            }
        });

        // Show the modal
        $('#accountMappingModal').modal('show');
    }

    // Save account mapping
    $(document).ready(function() {
        $('#saveAccountMappingBtn').click(function() {
            saveAccountMapping();
        });

        // Handle form submission via AJAX
        $(document).on('submit', '#accountMappingModal form', function(e) {
            e.preventDefault();
            saveAccountMapping();
        });
    });

    function showNotification(message, type) {
        // Using toastr if available
        if (typeof toastr !== 'undefined') {
            toastr[type](message);
        } else {
            // Fallback to alert
            alert(message);
        }
    }



    // Initialize when page loads
    $(document).ready(function() {
              // Reinitialize tooltips
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>

<style>
    #accountMappingModal .modal-xl {
        max-width: 95%;
    }

    .table-danger {
        background-color: #fff5f5;
    }

        .table-danger:hover {
            background-color: #ffe6e6;
        }

    #saveAccountMappingBtn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .modal-header .close {
        opacity: 0.8;
    }

        .modal-header .close:hover {
            opacity: 1;
        }
</style>