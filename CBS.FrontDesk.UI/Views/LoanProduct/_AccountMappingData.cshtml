@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject
@using Resources

@if (Model != null && Model.LoanProducts.Any())
{
    <div class="table-responsive mb-3">
        <table class="table table-hover table-bordered table-sm" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 10%;">@GlobalLoanProduct.Target</th>
                    <th style="width: 30%;">@GlobalLoanProduct.Type</th>
                    <th style="width: 25%;">@GlobalLoanProduct.Name</th>
                    <th style="width: 16%;">@GlobalLoanProduct.MinMax</th>
                    <th style="width: 7%;">@GlobalLoanProduct.Status</th>
                    <th style="width: 5%;">@GlobalLoanProduct.SSF</th>
                    <th style="width: 8%;">@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanProducts)
                {
                    // Determine if the row contains errors
                    bool hasError = d.LoanMinimumAmount <= 0 ||
                                    d.LoanMaximumAmount <= 0 ||
                                    d.LoanMinimumAmount > d.LoanMaximumAmount ||
                                    d.LoanProductCategory.Name == "N/A" ||
                                    d.TargetType == "N/A" ||
                                    d.LoanTerm.Name == "N/A";

                    // Apply a red background if errors exist
                    string rowClass = hasError ? "table-danger" : "";

                    <tr class="@rowClass">
                        <td>@d.TargetType</td>
                        <td>@d.LoanTerm.Name</td>
                        <td>
                            @d.ProductName
                            @if (hasError)
                            {
                                <div class="text-danger small mt-1">
                                    <ul class="mb-0">
                                        @if (d.LoanMinimumAmount <= 0)
                                        {
                                            <li>@GlobalLoanProduct.MinAmountMustBeGreaterThan0.</li>
                                        }
                                        @if (d.LoanMaximumAmount <= 0)
                                        {
                                            <li>@GlobalLoanProduct.MaxAmountMustBeGreaterThan0.</li>
                                        }
                                        @if (d.LoanMinimumAmount > d.LoanMaximumAmount)
                                        {
                                            <li>@GlobalLoanProduct.MinAmountCannotExceedMaxAmount.</li>
                                        }
                                        @if (d.LoanProductCategory.Name == "N/A")
                                        {
                                            <li>@GlobalLoanProduct.CategoryIsNotConfigured.</li>
                                        }
                                        @if (d.TargetType == "N/A")
                                        {
                                            <li>@GlobalLoanProduct.TargetTypIsNotConfigured.</li>
                                        }
                                        @if (d.LoanTerm.Name == "N/A")
                                        {
                                            <li>@GlobalLoanProduct.LoanTermIsNotConfigured.</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </td>
                        <td>@d.LoanMinimumAmount.ToString("#,##0") : @d.LoanMaximumAmount.ToString("#,##0")</td>
                        <td>
                            @if (d.ActiveStatus)
                            {
                                <span class="badge bg-info">@GlobalLoanProduct.Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@GlobalLoanProduct.Inactive</span>
                            }
                        </td>
                        <td>
                            @if (d.IsProductWithSavingFacilities)
                            {
                                <span class="badge bg-info">@GlobalLoanProduct.SSF</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@GlobalLoanProduct.MAIN</span>
                            }
                        </td>
                        <td>
                            <a href="#" class="mr-2" onclick="AddORUpdateGen('@d.Id','datalistingview','_LoanAccountMapping','account_mapping','LoanProduct')" data-toggle="tooltip" data-placement="top" title="Set account mapping for @d.ProductName">@GlobalLoanProduct.AccMap</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center my-3">
        <p>@GlobalLoanProduct.NoLoanProductHasBeenCreated.</p>
    </div>
}
