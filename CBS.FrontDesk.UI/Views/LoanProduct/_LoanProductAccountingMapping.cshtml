@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects
@using CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure

<style>
    /* Keep dropdown above modal/backdrop */
    .select2-container--open {
        z-index: 1060 !important;
    }
    /* bootstrap modal is 1055 */
    .select2-dropdown {
        z-index: 1060 !important;
    }

    /* Prevent "full page width" dropdown */
    .select2-container {
        width: 100% !important;
    }

    .select2-dropdown {
        width: auto !important;
    }

    /* If any parent has overflow hidden, allow dropdown to show */
    .modal, .modal-dialog, .modal-content {
        overflow: visible !important;
    }
</style>

@{
    var p = Model?.Product;
    var map = Model?.AccountingProfile ?? new LoanProductAccountingProfile();

    if (p != null)
    {
        map.LoanProductId = p.Id;
        map.PcmfBaseCode = p.PcmfBaseCode.Value;
        map.PcmfSection = p.PcmfSection;
        map.PcmfGroupCode = p.PcmfGroupCode.Value;
        map.PcmfPopulation = p.PcmfPopulation;
    }
}

@if (p == null)
{
    <div class="alert alert-warning mb-0">
        <i class="mdi mdi-alert-circle-outline me-1"></i>
        Product not found.
    </div>
    return;
}

<style>
    /* ✅ Select2 inside Bootstrap modal: keep dropdown above modal/backdrop */
    .select2-container--open {
        z-index: 99999 !important;
    }

    .select2-dropdown {
        z-index: 99999 !important;
    }
</style>

<div id="loanProductAccountingMappingRoot" class="lp-mapping-root">

     <div class="row">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-cog-outline me-2"></i>
                        Accounting Mapping
                    </h1>
                    <p class="card-text">
                        Configure only the GL accounts required for automated posting. Keep it minimal and consistent with PCMF/COBAC.
                    </p>
                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                </div>
            </div>
        </div>
    </div>

    <div class="card border-primary mb-2">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <div>
                <small class="text-primary d-block mt-1">
                    <span class="fw-semibold">@p.ProductName</span>
                </small>
                <small class="text-info">
                    Code: <span class="fw-semibold">@p.ProductCode</span> •
                    PCMF: <span class="fw-semibold">@p.PcmfBaseCode</span> / <span class="fw-semibold">@p.PcmfGroupCode</span> •
                    Section: <span class="fw-semibold">@p.PcmfSection</span> •
                    Population: <span class="fw-semibold">@p.PcmfPopulation</span>
                </small>
            </div>

            <span class="badge @(p.ActiveStatus ? "bg-success" : "bg-secondary")">
                @(p.ActiveStatus ? "Active" : "Inactive")
            </span>
        </div>        
    </div>
    <!-- ✅ PCMF Classification Preview Header (Guides GL selection) -->
    <div class="card mb-1 border-info">
        <h2 class="accordion-header" id="hdPcmf">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#cpPcmf" aria-expanded="true" aria-controls="cpPcmf">
                <span class="fw-semibold text-primary">PCMF Preview</span>
            </button>
        </h2>

        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-label-secondary">Section: @Model.Product.PcmfSection</span>
                <span class="badge bg-label-dark">Group: @Model.Product.PcmfGroupCode</span>
                <span class="badge bg-label-primary">Base: @Model.Product.PcmfBaseCode</span>
                <span class="badge bg-label-info">
                    Population: @Model.Product.PcmfPopulation
                </span>

                <small class="text-muted ms-auto">
                    Use these codes to choose the correct GL accounts for reporting & SESAME/PCMF mapping.
                </small>
            </div>
        </div>
    </div>

    <div class="accordion-item mb-1">
        <h2 class="accordion-header" id="hdPcmf">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#cpPcmf" aria-expanded="true" aria-controls="cpPcmf">
                <i class="mdi mdi-tag-outline me-2 text-primary"></i>
                <span class="fw-semibold text-primary">PCMF Classification</span>
            </button>
        </h2>

        <div id="cpPcmf" class="accordion-collapse collapse show"
             aria-labelledby="hdPcmf" data-bs-parent="#loanProductAccordion">
            <div class="accordion-body py-3">
                <div class="row g-3">

                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.LoanTermId,
                                new SelectList(ViewBag.LoanTerms, "Id", "NameEn"),
                                "--- Select Loan Term ---",
                                new { @class = "form-control select2", id = "LoanTermId", disabled = "disabled" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTermId, "", new { @class = "text-danger" })
                            <label>Loan Term</label>
                        </div>
                        <div class="small text-muted">
                            Required for <b>Classic / SSF / LOC</b>. Only <b>Overdraft</b> can be empty.
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.PcmfLoanPurposeId,
                                new SelectList(ViewBag.PcmfLoanPurposes, "Id", "NameEn"),
                                "--- Select PCMF Purpose ---",
                                new { @class = "form-control select2", required = "required", disabled = "disabled", id = "PcmfLoanPurposeId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.PcmfLoanPurposeId, "", new { @class = "text-danger" })
                            <label>PCMF Loan Purpose</label>
                        </div>
                        <div class="small text-muted">Filtered by term/section.</div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.Product.LoanTargetId,
                                new SelectList(ViewBag.LoanTargets, "Id", "NameEn"),
                                "--- Select Target ---",
                                new { @class = "form-control select2", required = "required", disabled = "disabled", id = "LoanTargetId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTargetId, "", new { @class = "text-danger" })
                            <label>Loan Target</label>
                        </div>
                        <div class="small text-muted">Enabled after purpose.</div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    @using (Html.BeginForm("SaveAccountingMapping", "LoanProduct", FormMethod.Post,
        new { enctype = "multipart/form-data", onsubmit = "return SaveLoanProductAccountingMapping(this);" }))

    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.AccountingProfile.Id)
        @Html.Hidden("LoanProductId", p.Id)

        <div class="accordion" id="lpAccountingAccordion">

            <!-- A) Core Posting GLs -->
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="hdCore">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cpCore" aria-expanded="true" aria-controls="cpCore">
                        <i class="mdi mdi-bank-outline me-2 text-primary"></i>
                        <span class="fw-semibold">Core Posting GLs</span>
                        <span class="ms-2 text-muted">(principal, interest, transit)</span>
                    </button>
                </h2>

                <div id="cpCore" class="accordion-collapse collapse show" aria-labelledby="hdCore" data-bs-parent="#lpAccountingAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForPrincipalAmount,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForPrincipalAmount),
                                        "--- Select Principal Disbursement GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForPrincipalAmount" })
                                    <label for="ChartOfAccountIdForPrincipalAmount">Principal Disbursement Account (Non-Taxable)</label>
                                </div>
                                <small class="text-muted">Used for standard loan disbursement principal posting.</small>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForInterestReceived,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForInterestReceived),
                                        "--- Select Interest Received GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForInterestReceived" })
                                    <label for="ChartOfAccountIdForInterestReceived">Interest Received Account (Non-Taxable)</label>
                                </div>
                                <small class="text-muted">Interest income account for non-taxable loans.</small>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForLoanTransition,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForLoanTransition),
                                        "--- Select Loan Transit GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForLoanTransition" })
                                    <label for="ChartOfAccountIdForLoanTransition">Loan Transit Account</label>
                                </div>
                                <small class="text-muted">Used for refinancing/internal movements and transition flows.</small>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- B) Taxable Loan GLs -->
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="hdTax">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cpTax" aria-expanded="false" aria-controls="cpTax">
                        <i class="mdi mdi-percent-outline me-2 text-primary"></i>
                        <span class="fw-semibold">Taxable Loan GLs</span>
                        <span class="ms-2 text-muted">(principal, interest, tax)</span>
                    </button>
                </h2>

                <div id="cpTax" class="accordion-collapse collapse" aria-labelledby="hdTax" data-bs-parent="#lpAccountingAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForTaxiblePrincipalAmount,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForTaxiblePrincipalAmount),
                                        "--- Select Taxable Principal GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForTaxiblePrincipalAmount" })
                                    <label for="ChartOfAccountIdForTaxiblePrincipalAmount">Taxable Principal Disbursement Account</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForTaxibleInterestReceived,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForTaxibleInterestReceived),
                                        "--- Select Taxable Interest GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForTaxibleInterestReceived" })
                                    <label for="ChartOfAccountIdForTaxibleInterestReceived">Taxable Interest Received Account</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForTax,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForTax),
                                        "--- Select Tax Account ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForTax" })
                                    <label for="ChartOfAccountIdForTax">Tax Account</label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- C) Fees / Penalties -->
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="hdFees">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cpFees" aria-expanded="false" aria-controls="cpFees">
                        <i class="mdi mdi-cash-multiple me-2 text-primary"></i>
                        <span class="fw-semibold">Fees & Penalties</span>
                    </button>
                </h2>

                <div id="cpFees" class="accordion-collapse collapse" aria-labelledby="hdFees" data-bs-parent="#lpAccountingAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForFee,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForFee),
                                        "--- Select Fee GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForFee" })
                                    <label for="ChartOfAccountIdForFee">Fee Account</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForPenalty,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForPenalty),
                                        "--- Select Penalty GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForPenalty" })
                                    <label for="ChartOfAccountIdForPenalty">Penalty Account</label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- D) Risk: Write-Off + Provisions -->
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="hdRisk">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cpRisk" aria-expanded="false" aria-controls="cpRisk">
                        <i class="mdi mdi-shield-alert-outline me-2 text-primary"></i>
                        <span class="fw-semibold">Write-Off & Provisioning</span>
                    </button>
                </h2>

                <div id="cpRisk" class="accordion-collapse collapse" aria-labelledby="hdRisk" data-bs-parent="#lpAccountingAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForWriteOffPrincipal,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForWriteOffPrincipal),
                                        "--- Select Write-Off Principal GL ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForWriteOffPrincipal" })
                                    <label for="ChartOfAccountIdForWriteOffPrincipal">Write-Off Principal Account</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForProvisionMoreThanOneYear,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForProvisionMoreThanOneYear),
                                        "--- Provision > 1 Year ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForProvisionMoreThanOneYear" })
                                    <label for="ChartOfAccountIdForProvisionMoreThanOneYear">Provision &gt; 1 Year</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForProvisionMoreThanTwoYear,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForProvisionMoreThanTwoYear),
                                        "--- Provision > 2 Years ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForProvisionMoreThanTwoYear" })
                                    <label for="ChartOfAccountIdForProvisionMoreThanTwoYear">Provision &gt; 2 Years</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForProvisionMoreThanThreeYear,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForProvisionMoreThanThreeYear),
                                        "--- Provision > 3 Years ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForProvisionMoreThanThreeYear" })
                                    <label for="ChartOfAccountIdForProvisionMoreThanThreeYear">Provision &gt; 3 Years</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(m => m.AccountingProfile.ChartOfAccountIdForProvisionMoreThanFourYear,
                                        new SelectList(ViewBag.ChartOfAccounts, "Value", "Text", map.ChartOfAccountIdForProvisionMoreThanFourYear),
                                        "--- Provision > 4 Years ---",
                                        new { @class = "form-control select2", id = "ChartOfAccountIdForProvisionMoreThanFourYear" })
                                    <label for="ChartOfAccountIdForProvisionMoreThanFourYear">Provision &gt; 4 Years</label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Save -->
        <div class="card mt-3 border-primary">
            <div class="card-body bg-light d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1 text-primary">
                        <i class="mdi mdi-content-save-outline me-2"></i> Save Mapping
                    </h6>
                    <small class="text-muted">Save all account mapping configurations for this product.</small>
                </div>
                <button type="submit"
                        id="btnSaveLoanProductMapping"
                        class="btn btn-primary px-4">
                    <i class="mdi mdi-check-circle-outline me-2"></i> Save
                </button>


            </div>
        </div>


    }
</div>
<script>
    function setSaveBusy($btn, busy) {
        if (!$btn || !$btn.length) return;

        if (busy) {
            $btn.data("old-html", $btn.html());
            $btn.prop("disabled", true).addClass("disabled");
            $btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Saving...');
        } else {
            $btn.prop("disabled", false).removeClass("disabled");
            var old = $btn.data("old-html");
            if (old) $btn.html(old);
        }
    }

    function notifyFromServer(res) {
        // res = { success: bool, status: ..., message: ... }
        var message = (res && res.message) ? res.message : "No message returned.";

        if (res && res.success === true) {
            if (window.alertify) alertify.success(message);
            else alert(message);
        } else {
            if (window.alertify) alertify.error(message);
            else alert(message);
        }
    }

    function parseJsonSafe(text) {
        try { return JSON.parse(text); } catch { return null; }
    }

    function SaveLoanProductAccountingMapping(form) {
        var $form = $(form);
        var $btn = $form.find("#btnSaveLoanProductMapping");

        if ($form.data("busy") === true) return false;

        // ✅ confirm with alertify first
        if (window.alertify) {
            alertify.confirm(
                "Confirm Mapping Save",
                "Do you want to save this accounting mapping for the selected loan product?",
                function onOk() {
                    doSubmit();
                },
                function onCancel() {
                    // user cancelled
                }
            );
        } else {
            // fallback
            if (confirm("Do you want to save this accounting mapping?")) {
                doSubmit();
            }
        }

        function doSubmit() {
            $form.data("busy", true);
            setSaveBusy($btn, true);

            var payload = $form.serialize();

            $.ajax({
                url: $form.attr("action"),
                type: $form.attr("method") || "POST",
                data: payload,
                dataType: "json", // ✅ force json handling

                success: function (res) {
                    // ✅ show server message
                    notifyFromServer(res);

                    // optional callback
                    if (window.onLoanProductMappingSaved)
                        window.onLoanProductMappingSaved(res);
                },

                error: function (xhr) {
                    // Try read JSON from server, else fallback text
                    var json = xhr && xhr.responseText ? parseJsonSafe(xhr.responseText) : null;

                    if (json) {
                        notifyFromServer(json);
                    } else {
                        var msg = "Failed to save mapping.";
                        if (xhr && xhr.responseText) msg = xhr.responseText;

                        if (window.alertify) alertify.error(msg);
                        else alert(msg);
                    }
                },

                complete: function () {
                    $form.data("busy", false);
                    setSaveBusy($btn, false);
                }
            });
        }

        return false; // prevent normal submit
    }
</script>
<script>
    window.initLoanProductAccountingMappingForm = function () {
        if (!(window.$ && $.fn.select2)) return;

        var $root = $("#loanProductAccountingMappingRoot");
        if (!$root.length) return;

        $root.find("select.select2").each(function () {
            var $select = $(this);

            // ✅ best parent for select2 inside modal
            var $modalContent = $select.closest(".modal").find(".modal-content").first();
            var $parent = $modalContent.length ? $modalContent : $(document.body);

            // Destroy safely
            if ($select.data("select2")) {
                try { $select.select2("destroy"); } catch (e) { /* ignore */ }
            }

            $select.select2({
                width: "100%",
                dropdownParent: $parent,
                dropdownAutoWidth: false
            });
        });
    };

    // ✅ Ensure init happens after modal is fully visible
    $(document)
        .off("shown.bs.modal.lpAccMap", "#loanProductModal")
        .on("shown.bs.modal.lpAccMap", "#loanProductModal", function () {
            if (window.initLoanProductAccountingMappingForm)
                window.initLoanProductAccountingMappingForm();
        });

    // ✅ Optional: when opening accordion panels, close any open select2 (prevents mis-position)
    $(document)
        .off("shown.bs.collapse.lpAccMap", "#lpAccountingAccordion .accordion-collapse")
        .on("shown.bs.collapse.lpAccMap", "#lpAccountingAccordion .accordion-collapse", function () {
            $("#loanProductAccountingMappingRoot select.select2").each(function () {
                var $s = $(this);
                if ($s.data("select2")) $s.select2("close");
            });
        });
</script>
