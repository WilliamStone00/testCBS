@model CBS.FrontDesk.Data.Entity.LoanConf.LoanProductObject

@if (Model != null && Model.LoanProducts.Any())
{
    <div class="table-responsive mb-3">
        <table class="table table-hover table-bordered table-sm" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 10%;">Target</th>
                    <th style="width: 16%;">Category</th>
                    <th style="width: 10%;">Type</th>
                    <th style="width: 6%;">Code</th>
                    <th style="width: 28%;">Name</th>
                    <th style="width: 16%;">Min : Max</th>
                    <th style="width: 5%;">Status</th>
                    <th style="width: 5%;">SSF</th>
                    <th style="width: 8%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanProducts)
                {
                    // Determine if the row contains errors
                    bool hasError = d.LoanMinimumAmount <= 0 ||
                                    d.LoanMaximumAmount <= 0 ||
                                    d.LoanMinimumAmount > d.LoanMaximumAmount ||
                                    d.LoanProductCategory.Name == "N/A" ||
                                    d.TargetType == "N/A" ||
                                    d.LoanTerm.Name == "N/A";

                    // Apply a red background if errors exist
                    string rowClass = hasError ? "table-danger" : "";

                    <tr class="@rowClass">
                        <td>@d.TargetType</td>
                        <td>@d.LoanProductCategory.Name</td>
                        <td>@d.LoanTerm.Name</td>
                        <td>@d.ProductCode</td>
                        <td>
                            @d.ProductName
                            @if (hasError)
                            {
                                <div class="text-danger small mt-1">
                                    <ul class="mb-0">
                                        @if (d.LoanMinimumAmount <= 0)
                                        {
                                            <li>Min Amount must be greater than 0.</li>
                                        }
                                        @if (d.LoanMaximumAmount <= 0)
                                        {
                                            <li>Max Amount must be greater than 0.</li>
                                        }
                                        @if (d.LoanMinimumAmount > d.LoanMaximumAmount)
                                        {
                                            <li>Min Amount cannot exceed Max Amount.</li>
                                        }
                                        @if (d.LoanProductCategory.Name == "N/A")
                                        {
                                            <li>Category is not configured.</li>
                                        }
                                        @if (d.TargetType == "N/A")
                                        {
                                            <li>Target Type is not configured.</li>
                                        }
                                        @if (d.LoanTerm.Name == "N/A")
                                        {
                                            <li>Loan Term is not configured.</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </td>
                        <td>@d.LoanMinimumAmount.ToString("#,##0") : @d.LoanMaximumAmount.ToString("#,##0")</td>
                        <td>
                            @if (d.ActiveStatus)
                            {
                                <span class="badge bg-info">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (d.IsProductWithSavingFacilities)
                            {
                                <span class="badge bg-info">SSF</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">MAIN</span>
                            }
                        </td>
                        <td>
                            <a href="/LoanProduct/Policy?Key=@d.Id" target="_blank" class="text-decoration-none mr-2" data-toggle="tooltip" data-placement="top" title="Set penalty for @d.ProductName">Policies</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center my-3">
        <p>No loan product has been created.</p>
    </div>
}

