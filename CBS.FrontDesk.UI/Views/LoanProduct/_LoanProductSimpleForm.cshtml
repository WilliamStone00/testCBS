@model CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.PCMFLoanProductManagementObjects
@{
    var cmd = Model.CreateOrUpdate ?? new CBS.FrontDesk.Data.Entity.LoanConf.PCMFStructure.CreateLoanProductCommand();
    var isEdit = !string.IsNullOrWhiteSpace(cmd.Id);

    var formTitle = isEdit ? "Update Loan Product" : "Create Loan Product";
    var saveText = isEdit ? "Update" : "Save";
}

<style>
    /* ✅ force section headers to black */
    #loanProductModal .card-header span,
    #loanProductModal .card-header strong {
        color: #212529 !important;
    }

    #loanProductModal .card-header small.text-muted {
        opacity: .85;
    }

    /* ✅ keep select2 within modal clean */
    #loanProductModal .select2-container {
        width: 100% !important;
    }
</style>

<div class="card-body">

    @using (Html.BeginForm("CreateOrUpdateSimple", "LoanProduct", FormMethod.Post,
        new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CreateOrUpdate.Id)       

        <div class="row">
            <div class="col-12">
                <div class="card bg-light mb-2">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-bank me-2"></i>@formTitle
                        </h1>                       
                        <div class="alert alert-info mt-3 py-2">
                            <i class="mdi mdi-information-outline me-1"></i>
                            Fill the minimum fields for PCMF/COBAC classification. Configure advanced policy/accounting later via Manage actions.                           
                        </div>
                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- 1) LOAN FACILITY (FIRST) -->
        <!-- ===================================================== -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark fw-semibold">
                    <i class="mdi mdi-shape-outline me-1"></i> Loan Facility
                </span>
                <small class="text-muted">Required</small>
            </div>

            <div class="card-body">
                @Html.HiddenFor(m => m.CreateOrUpdate.LoanFacility, new { id = "LoanFacility" })

                <div class="border rounded-3 p-3 bg-light">
                    <div class="d-flex flex-wrap gap-4">

                        <div class="form-check">
                            <input class="form-check-input lpFacility"
                                   type="radio"
                                   name="LoanFacilityRadio"
                                   id="LoanFacilityClassic"
                                   value="Classic"
                                   @(string.IsNullOrWhiteSpace(cmd.LoanFacility) || cmd.LoanFacility == "Classic" ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="LoanFacilityClassic">
                                Classic
                            </label>
                            <div><small class="text-muted">Term required</small></div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input lpFacility"
                                   type="radio"
                                   name="LoanFacilityRadio"
                                   id="LoanFacilitySSF"
                                   value="SSF"
                                   @(cmd.LoanFacility == "SSF" ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="LoanFacilitySSF">
                                SSF
                            </label>
                            <div><small class="text-muted">Term required</small></div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input lpFacility"
                                   type="radio"
                                   name="LoanFacilityRadio"
                                   id="LoanFacilityOverdraft"
                                   value="Overdraft"
                                   @(cmd.LoanFacility == "Overdraft" ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="LoanFacilityOverdraft">
                                Overdraft
                            </label>
                            <div><small class="text-muted">No term</small></div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input lpFacility"
                                   type="radio"
                                   name="LoanFacilityRadio"
                                   id="LoanFacilityLOC"
                                   value="LineOfCredit"
                                   @(cmd.LoanFacility == "LineOfCredit" ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="LoanFacilityLOC">
                                Line of Credit
                            </label>
                            <div><small class="text-muted">Term required</small></div>
                        </div>

                    </div>

                    <hr class="my-3" />

                    <small class="text-muted d-block">
                        Facility selection controls whether <b>Loan Term</b> is required and how PCMF choices are filtered.
                    </small>
                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- 2) PCMF PREVIEW (SECOND) -->
        <!-- ===================================================== -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark fw-semibold">
                    <i class="mdi mdi-eye-outline me-1"></i> LIVE PCMF PREVIEW
                </span>
                <small class="text-muted">Guides correct accounting mapping</small>
            </div>

            <div class="card-body">
                <div class="border rounded-3 p-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge bg-label-secondary px-3 py-2" id="pcmfPreviewSection">Section: -</span>
                        <span class="badge bg-label-dark px-3 py-2" id="pcmfPreviewGroup">Group: -</span>
                        <span class="badge bg-label-primary px-3 py-2" id="pcmfPreviewBase">Base: -</span>
                        <span class="badge bg-label-info px-3 py-2" id="pcmfPreviewPop">Population: -</span>
                    </div>

                    <hr class="my-3" />

                    <small class="text-muted d-block">
                        Select <b>Loan Facility</b> → <b>Loan Term</b> → <b>Purpose</b> → <b>Target</b> to update this preview.
                    </small>
                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- 3) PCMF CLASSIFICATION (THIRD) -->
        <!-- ===================================================== -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark fw-semibold">
                    <i class="mdi mdi-tag-outline me-1"></i> PCMF Classification
                </span>
                <small class="text-muted">Required</small>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CreateOrUpdate.LoanTermId,
                                new SelectList(ViewBag.LoanTerms, "Id", "NameEn", cmd.LoanTermId),
                                "--- Select Loan Term ---",
                                new { @class = "form-control select2", id = "LoanTermId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTermId, "", new { @class = "text-danger" })
                            <label>Loan Term</label>
                        </div>
                        <small class="text-muted">
                            Required for <b>Classic / SSF / Line of Credit</b>. Only <b>Overdraft</b> can be empty.
                        </small>
                    </div>

                    <div class="col-md-7">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CreateOrUpdate.PcmfLoanPurposeId,
                                new SelectList(ViewBag.PcmfLoanPurposes, "Id", "NameEn", cmd.PcmfLoanPurposeId),
                                "--- Select PCMF Purpose ---",
                                new { @class = "form-control select2", required = "required", id = "PcmfLoanPurposeId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.PcmfLoanPurposeId, "", new { @class = "text-danger" })
                            <label>PCMF Loan Purpose</label>
                        </div>
                        <small class="text-muted">Filtered by term/section. Shows group code for guidance.</small>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CreateOrUpdate.LoanTargetId,
                                new SelectList(ViewBag.LoanTargets, "Id", "NameEn", cmd.LoanTargetId),
                                "--- Select Target ---",
                                new { @class = "form-control select2", required = "required", id = "LoanTargetId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTargetId, "", new { @class = "text-danger" })
                            <label>Loan Target</label>
                        </div>
                        <small class="text-muted">Enabled after purpose selection. Shows population hint.</small>
                    </div>

                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- 4) BASIC INFORMATION (FOURTH) -->
        <!-- ===================================================== -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark fw-semibold">
                    <i class="mdi mdi-file-document-outline me-1"></i> Basic Information
                </span>
                <small class="text-muted">Required</small>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CreateOrUpdate.ProductCode, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.ProductCode, "", new { @class = "text-danger" })
                            <label>Product Code</label>
                        </div>
                        <small class="text-muted">Unique code used in reporting/integrations.</small>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CreateOrUpdate.ProductName, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.ProductName, "", new { @class = "text-danger" })
                            <label>Product Name</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CreateOrUpdate.LoanProductCategoryId, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanProductCategoryId, "", new { @class = "text-danger" })
                            <label>Loan Product Category Reference</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CreateOrUpdate.TargetType, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.TargetType, "", new { @class = "text-danger" })
                            <label>Target Type</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CreateOrUpdate.LoanTypeCategory, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.LoanTypeCategory, "", new { @class = "text-danger" })
                            <label>Loan Type Category</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextAreaFor(m => m.CreateOrUpdate.Description, 3, 10, new { @class = "form-control", placeholder = "Short description..." })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.Description, "", new { @class = "text-danger" })
                            <label>Description</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check mt-2">
                            @Html.CheckBoxFor(m => m.CreateOrUpdate.ActiveStatus, new { @class = "form-check-input", id = "ActiveStatus" })
                            <label class="form-check-label" for="ActiveStatus">Active</label>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- 5) ACCOUNTING (FIFTH) -->
        <!-- ===================================================== -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark fw-semibold">
                    <i class="mdi mdi-bank-outline me-1"></i> Accounting
                </span>
                <small class="text-muted">Optional</small>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CreateOrUpdate.AccountingProfileId,
                                new SelectList(ViewBag.AccountingProfiles, "Value", "Text", cmd.AccountingProfileId),
                                "--- Select Accounting Profile ---",
                                new { @class = "form-control select2", id = "AccountingProfileId" })
                            @Html.ValidationMessageFor(m => m.CreateOrUpdate.AccountingProfileId, "", new { @class = "text-danger" })
                            <label>Accounting Profile</label>
                        </div>
                        <small class="text-muted">
                            You can configure detailed GL mapping later from Manage → Accounting Mapping.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="mt-4 d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">
                <i class="mdi mdi-content-save-outline me-1"></i> @saveText
            </button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                Close
            </button>
        </div>
    }
</div>

<script>
(function () {

    // ==========================
    // Helpers
    // ==========================
    function gp(o, camel, pascal) {
        if (!o) return null;
        var v = o[camel];
        if (v !== undefined && v !== null) return v;
        v = o[pascal];
        if (v !== undefined && v !== null) return v;
        return null;
    }

    function initSelect2InModal(modalSelector) {
        if (!window.$ || !$.fn.select2) return;

        var $modal = $(modalSelector);

        $modal.find(".select2").each(function () {
            var $el = $(this);
            if ($el.data("select2")) $el.select2("destroy");

            $el.select2({
                width: "100%",
                dropdownParent: $modal
            });
        });
    }

    function getLoanFacility() {
        // hidden field holds real value
        var v = $("#LoanFacility").val();
        return v || "Classic";
    }

    function setLoanFacility(v) {
        $("#LoanFacility").val(v || "Classic");
    }

    // ✅ ONLY Overdraft does NOT require term
    function isTermRequiredByFacility(facility) {
        return (facility || getLoanFacility()) !== "Overdraft";
    }

    function getVal(id) {
        var el = document.getElementById(id);
        return el ? el.value : "";
    }

    function setPreview(p) {
        $("#pcmfPreviewSection").text("Section: " + (gp(p, "section", "Section") || "-"));
        $("#pcmfPreviewGroup").text("Group: " + (gp(p, "groupCode", "GroupCode") ?? "-"));
        $("#pcmfPreviewBase").text("Base: " + (gp(p, "baseCode", "BaseCode") ?? "-"));
        $("#pcmfPreviewPop").text("Population: " + (gp(p, "population", "Population") || "-"));
    }

    function clearPreview() {
        setPreview({ Section: null, GroupCode: null, BaseCode: null, Population: null });
    }

    function resetSelect(id, placeholder) {
        var $s = $("#" + id);
        $s.prop("disabled", false);
        $s.empty().append('<option value="">' + placeholder + '</option>');
        $s.val("").trigger("change");
    }

    function setSelectLoading(id, loadingText) {
        var $s = $("#" + id);
        $s.prop("disabled", true);
        $s.empty().append('<option value="">' + (loadingText || "Loading...") + '</option>');
        $s.val("").trigger("change");
    }

    function setFormBusy($form, busy, message) {
        if (!$form || !$form.length) return;

        $form.data("busy", busy === true);

        // disable everything
        $form.find("input,select,textarea,button").prop("disabled", busy === true);

        // keep Close button working (optional)
        $form.closest(".modal-content").find("[data-bs-dismiss='modal']").prop("disabled", false);

        var $btn = $form.find("button[type='submit'], input[type='submit']").first();
        if (!$btn.length) return;

        if (busy) {
            if (!$btn.data("origHtml")) $btn.data("origHtml", $btn.html());
            var txt = message || "Saving...";
            $btn.html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' + txt);
        } else {
            var orig = $btn.data("origHtml");
            if (orig) $btn.html(orig);
        }
    }

    // ==========================
    // Facility -> Term rule
    // ==========================
    function applyFacilityRules() {
        var facility = getLoanFacility();
        var term = document.getElementById("LoanTermId");
        if (!term) return;

        if (isTermRequiredByFacility(facility)) {
            term.removeAttribute("disabled");
        } else {
            term.value = "";
            term.setAttribute("disabled", "disabled");
        }
    }

    // ==========================
    // Data loaders
    // ==========================
    function loadPurposes() {
        var facility = getLoanFacility();
        var termId = getVal("LoanTermId");

        // ✅ Term-required facilities must provide term before loading purposes
        if (isTermRequiredByFacility(facility) && !termId) {
            resetSelect("PcmfLoanPurposeId", "--- Select PCMF Purpose ---");
            resetSelect("LoanTargetId", "--- Select Target ---");
            clearPreview();
            return;
        }

        setSelectLoading("PcmfLoanPurposeId", "Loading purposes...");
        setSelectLoading("LoanTargetId", "Select purpose first...");
        clearPreview();

        $.get("@Url.Action("GetPurposesByTerm","LoanProduct")", {
            termId: termId,
            loanFacility: facility
        })
        .done(function (list) {
            var $purpose = $("#PcmfLoanPurposeId");
            $purpose.prop("disabled", false);
            $purpose.empty().append('<option value="">--- Select PCMF Purpose ---</option>');

            (list || []).forEach(function (x) {
                var id = gp(x, "id", "Id");
                var text = gp(x, "text", "Text");
                var groupCode = gp(x, "groupCode", "GroupCode");
                var hint = gp(x, "hint", "Hint");

                var label = "";
                if (groupCode !== null && groupCode !== "") label = "[" + groupCode + "] " + (text || "");
                else if (hint) label = "[" + hint + "] " + (text || "");
                else label = (text || "");

                $purpose.append('<option value="' + (id || "") + '">' + label + '</option>');
            });

            $purpose.val("").trigger("change");
            resetSelect("LoanTargetId", "--- Select Target ---");
        })
        .fail(function () {
            resetSelect("PcmfLoanPurposeId", "--- Select PCMF Purpose ---");
            resetSelect("LoanTargetId", "--- Select Target ---");
            clearPreview();
        });
    }

    function loadTargets() {
        var facility = getLoanFacility();
        var termId = getVal("LoanTermId");
        var purposeId = getVal("PcmfLoanPurposeId");

        if (!purposeId) {
            resetSelect("LoanTargetId", "--- Select Target ---");
            clearPreview();
            return;
        }

        setSelectLoading("LoanTargetId", "Loading targets...");
        clearPreview();

        $.get("@Url.Action("GetTargetsForSelection","LoanProduct")", {
            purposeId: purposeId,
            termId: termId,
            loanFacility: facility
        })
        .done(function (list) {
            var $target = $("#LoanTargetId");
            $target.prop("disabled", false);
            $target.empty().append('<option value="">--- Select Target ---</option>');

            (list || []).forEach(function (x) {
                var id = gp(x, "id", "Id");
                var text = gp(x, "text", "Text");
                var population = gp(x, "population", "Population");
                var hint = gp(x, "hint", "Hint");

                var tail = population ? (" (" + population + ")") : (hint ? (" (" + hint + ")") : "");
                $target.append('<option value="' + (id || "") + '">' + (text || "") + tail + '</option>');
            });

            $target.val("").trigger("change");
        })
        .fail(function () {
            resetSelect("LoanTargetId", "--- Select Target ---");
            clearPreview();
        });
    }

    function loadPreview() {
        var facility = getLoanFacility();
        var termId = getVal("LoanTermId");
        var purposeId = getVal("PcmfLoanPurposeId");
        var targetId = getVal("LoanTargetId");

        if (!purposeId || !targetId || (isTermRequiredByFacility(facility) && !termId)) {
            clearPreview();
            return;
        }

        setPreview({ section: "Loading...", groupCode: "-", baseCode: "-", population: "-" });

        $.get("@Url.Action("GetPcmfPreview","LoanProduct")", {
            termId: termId,
            purposeId: purposeId,
            targetId: targetId,
            loanFacility: facility
        })
        .done(function (p) { setPreview(p || {}); })
        .fail(function () { clearPreview(); });
    }

    // ==========================
    // Exposed init
    // ==========================
    window.loanProductInitPcmfGuidedFlow = function () {

        initSelect2InModal("#loanProductModal");

        $("#loanProductModal")
            .off("change.lp", "#LoanTermId")
            .off("change.lp", "#PcmfLoanPurposeId")
            .off("change.lp", "#LoanTargetId")
            .off("change.lp", ".lpFacility");

        $("#loanProductModal").on("change.lp", "#LoanTermId", function () {
            loadPurposes();
        });

        $("#loanProductModal").on("change.lp", "#PcmfLoanPurposeId", function () {
            loadTargets();
        });

        $("#loanProductModal").on("change.lp", "#LoanTargetId", function () {
            loadPreview();
        });

        // ✅ facility radio change
        $("#loanProductModal").on("change.lp", ".lpFacility", function () {
            setLoanFacility($(this).val());
            applyFacilityRules();

            resetSelect("PcmfLoanPurposeId", "--- Select PCMF Purpose ---");
            resetSelect("LoanTargetId", "--- Select Target ---");
            clearPreview();

            loadPurposes();
        });

        // ✅ ensure hidden matches selected radio (Classic default)
        var selected = $("#loanProductModal input.lpFacility:checked").val() || "Classic";
        setLoanFacility(selected);

        applyFacilityRules();

        // load initial purposes depending on mode (for edit can have term already)
        loadPurposes();

        // edit restore sequence
        var existingPurpose = "@(cmd.PcmfLoanPurposeId ?? "")";
        var existingTarget  = "@(cmd.LoanTargetId ?? "")";

        if (existingPurpose) {
            setTimeout(function () {
                $("#PcmfLoanPurposeId").val(existingPurpose).trigger("change");

                setTimeout(function () {
                    if (existingTarget) $("#LoanTargetId").val(existingTarget).trigger("change");
                    setTimeout(loadPreview, 200);
                }, 250);

            }, 250);
        } else {
            clearPreview();
        }
    };

     //==========================
     //Submit blocking
     //==========================
    //window.loanProductOnSubmit = function (form) {
    //    var $form = $(form);

    //    if ($form.data("busy")) return false;

    //    // ensure hidden is synced
    //    var selected = $("#loanProductModal input.lpFacility:checked").val() || "Classic";
    //    setLoanFacility(selected);

    //    // ✅ if term is required, do not submit without it
    //    var facility = getLoanFacility();
    //    var term = document.getElementById("LoanTermId");
    //    var termId = term ? term.value : "";

    //    if (isTermRequiredByFacility(facility) && !termId) {
    //        // keep UI simple: just focus term and stop
    //        if (term) term.focus();
    //        return false;
