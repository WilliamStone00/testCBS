@using Resources
@{
    ViewBag.Title = "Analyzed PI Salary Upload";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-upload-multiple me-2"></i> @GlobalSalaryExecution.AnalyzedSalaryUploadManagement
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryExecution.UploadAndManageSystemAnalyzedSalaryFiles.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalSalaryExecution.TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryUploadTips" aria-expanded="false" aria-controls="collapseSalaryUploadTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryUploadTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryExecution.SelectTheCorrectSystemAnalyzedFile.</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryExecution.EnsureModificationsMatchTheOriginalFormat.</li>
                            <li><i class="mdi mdi-view-list-outline text-primary me-2"></i> @GlobalSalaryExecution.ClickOn <strong>@GlobalSalaryExecution.ViewUploadedFiles</strong> @GlobalSalaryExecution.toCheckExistingAnalyzedSalaryFiles.</li>
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalSalaryExecution.AvoidIncorrectMatriculeSalaryCodesOrMissingDetails.</li>
                            <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> @GlobalSalaryExecution.MonitorTheStatusOfUploadedFiles.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-upload me-1"></i> @GlobalSalaryExecution.UploadAnalyzedSalaryFile
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a href="/PISalaryExecution/UploadedSalaryFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalSalaryExecution.ViewUploadedFiles">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalSalaryExecution.ViewUploadedFiles
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryUploadForm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
