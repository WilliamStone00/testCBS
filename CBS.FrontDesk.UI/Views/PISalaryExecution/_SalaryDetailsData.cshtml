@model CBS.FrontDesk.Data.Entity.SalaryManagement.ExecuteSalaryCarrier
@using Resources


<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <!-- Dashboard Section -->
        <div id="dashboardSummary" class="mb-4">
            <div class="row row-cols-1 row-cols-md-3 g-4">

                <!-- Total Members -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalShared.Total_members</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalMembers.ToString("N0") <!-- Display total number of members -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Net Salary -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalPISalaryExecution.total_net_salary</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalNetSalary.ToString("N1") <!-- Display total net salary -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Standing Order Amount -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalPISalaryExecution.total_standing_order_amount</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalStandingOrderAmount.ToString("N1") <!-- Display total standing order amount -->
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Savings -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalShared.total_savings</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalSavings.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Repayment -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalPISalaryExecution.total_loan_repayment</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalLoanRepayment.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Charges -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalShared.total_charges</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalCharges.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Shares -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalShared.total_shares</h5>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.DashboardViewModel.TotalShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Preference Shares -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalPISalaryExecution.total_preference_shares</h5>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.DashboardViewModel.TotalPreferenceShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Total Loan Interest -->
                <div class="col">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@GlobalPISalaryExecution.total_loan_interest</h5>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.DashboardViewModel.TotalLoanInterest.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div id="datalistingview_inner">
            <div class="table-responsive mb-3">
                @if (Model.SalaryExtractes != null && Model.SalaryExtractes.Any())
                {
                    <table class="table table-hover" id="myDataTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@GlobalShared.matricule</th>
                                <th>@GlobalShared.Reference</th>
                                <th>@GlobalShared.Name</th>
                                <th>@GlobalPISalaryExecution.nsalary</th> <!-- ✅ Net Salary -->
                                <th>@GlobalPISalaryExecution.sorder</th> <!-- ✅ Standing Order -->
                                <th>@GlobalShared.Savings</th>
                                <th>@GlobalShared.Deposit</th>
                                <th>@GlobalShared.Shares</th>
                                <th>@GlobalPISalaryExecution.p_shares</th> <!-- ✅ Preference Shares -->
                                <th>@GlobalPISalaryExecution.l_rep</th> <!-- ✅ Loan Repayment -->
                                <th>L.C</th> <!-- ✅ Loan Repayment -->
                                <th>@GlobalPISalaryExecution.l_int</th> <!-- ✅ Loan Repayment -->
                                <th>@GlobalPISalaryExecution.l_vat</th> <!-- ✅ Loan Repayment -->
                                <th>@GlobalShared.Charges</th> <!-- ✅ NEW: Charges Added -->
                                <th>@GlobalShared.salary</th> <!-- ✅ Salary remains after Charges -->
                                <th>@GlobalShared.Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 0;
                            }
                            @foreach (var salary in Model.SalaryExtractes)
                            {
                                ++rowNumber;
                                <tr>
                                    <td>@rowNumber</td>
                                    <td>@salary.Matricule</td>
                                    <td>@salary.MemberReference</td>
                                    <td>@salary.MemberName</td>
                                    <td>@salary.NetSalary.ToString("N1")</td> <!-- ✅ Net Salary -->
                                    <td>@salary.StandingOrderAmount.ToString("N1")</td> <!-- ✅ Standing Order -->
                                    <td>@salary.Saving.ToString("N1")</td>
                                    <td>@salary.Deposit.ToString("N1")</td>
                                    <td>@salary.Shares.ToString("N1")</td>
                                    <td>@salary.PreferenceShares.ToString("N1")</td> <!-- ✅ Preference Shares -->
                                    <td>@salary.TotalLoanRepayment.ToString("N1")</td> <!-- ✅ Loan Repayment -->
                                    <td>@salary.LoanCapital.ToString("N1")</td> <!-- ✅ Loan Repayment -->
                                    <td>@salary.LoanInterest.ToString("N1")</td> <!-- ✅ Loan Repayment -->
                                    <td>@salary.VAT.ToString("N1")</td> <!-- ✅ Loan Repayment -->
                                    <td>@salary.Charges.ToString("N1")</td> <!-- ✅ NEW: Charges Added -->
                                    <td>@salary.RemainingSalary.ToString("N1")</td> <!-- ✅ Salary remains after Charges -->
                                    <td>
                                        @if (salary.Status)
                                        {
                                            <span class="badge bg-success">@GlobalShared.Executed</span> <!-- ✅ Green for Executed -->
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@GlobalShared.Pending</span> <!-- ✅ Yellow for Pending -->
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center my-3">
                        <p>@GlobalPISalaryExecution.no_salary_uploads_found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
