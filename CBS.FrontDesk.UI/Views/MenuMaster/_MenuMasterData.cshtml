@model List<CBS.FrontDesk.Data.Entity.MenuMaster>
    @using Resources
<fieldset class="fieldset-custom">
    <div class="table-responsive">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalMenuMaster.MenuOrder</th> <!-- 👈 New column -->
                    <th>@GlobalMenuMaster.Name</th>
                    <th>@GlobalMenuMaster.Controller</th>
                    <th>@GlobalShared.Action</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalMenuMaster.Description</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="width:5%">@d.MenuOrder</td> <!-- 👈 Display Menu Order -->
                        <td style="width:20%">@d.MenuText</td>
                        <td style="width:10%">@d.ControllerName</td>
                        <td style="width:10%">@d.ActionName</td>
                        <td style="width:5%">
                            @if (d.IsVisible)
                            {
                                <label class="ql-color-purple">
                                    <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalMenuMaster.Visible</span>
                                </label>
                            }
                            else
                            {
                                <label class="ql-color-purple">
                                    <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalMenuMaster.None</span>
                                </label>
                            }
                        </td>
                        <td style="width:40%">@d.Description</td>
                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_MenuMaster','get','MenuMaster','')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.MenuText @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.MenuText" onclick="DeleteRecordDataTable('MenuMaster','@d.Id','myDataTable','_MenuMasterData',0,'datalistingview')">@GlobalShared.Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>
