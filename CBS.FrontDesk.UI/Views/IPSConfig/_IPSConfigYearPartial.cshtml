@model IEnumerable<CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSConfig>
@using Resources

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-calendar-multiple me-2"></i> @GlobalIPSConfig.IPS_Configurations_by_Year
        </h1>
        <p class="card-text text-muted mb-1">
            @GlobalIPSConfig.Multiple_configurations_found_for_the_selected_year
        </p>
    </div>
</div>

<fieldset class="fieldset-custom">

    @if (Model != null && Model.Any())
    {
        var index = 0;

        foreach (var config in Model)
        {
            var collapseId = $"ipsCollapse_{index}";
            var headingId = $"ipsHeading_{index}";
            var isExpanded = index == 0; // expand first by default (optional)

            <div class="card mb-3 shadow-sm">

                <!-- Header (Clickable) -->
                <div class="card-header bg-light"
                     id="@headingId"
                     role="button"
                     data-bs-toggle="collapse"
                     data-bs-target="#@collapseId"
                     aria-expanded="@(isExpanded.ToString().ToLower())"
                     aria-controls="@collapseId"
                     style="cursor:pointer;">

                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="mdi mdi-shield-check me-2"></i>
                            @GlobalShared.Configuration @config.BranchName (@config.BranchCode)
                            -
                            <span class="@(config.IsActive ? "text-success" : "text-secondary")">
                                @(config.IsActive ? "Active" : "Inactive")
                            </span>
                        </h6>

                        <i class="mdi mdi-chevron-down transition"></i>
                    </div>
                </div>

                <!-- Collapsible Body -->
                <div id="@collapseId"
                     class="collapse @(isExpanded ? "show" : "")"
                     aria-labelledby="@headingId">

                    <div class="card-body">
                        <div class="row">

                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">@GlobalShared.Age_Limit</td>
                                        <td>@config.AgeLimit</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">@GlobalShared.Loan_Coverage</td>
                                        <td>@String.Format("{0:N2}", config.LoanCoverageLimit)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">@GlobalShared.Savings_Coverage</td>
                                        <td>@String.Format("{0:N2}", config.SavingsCoverageLimit)</td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">@GlobalShared.Premium_Loan</td>
                                        <td>@String.Format("{0:N4}", config.PremiumRateLoan)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Premium Savings</td>
                                        <td>@String.Format("{0:N4}", config.PremiumRateSavings)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">@GlobalShared.Max_Delinquency</td>
                                        <td>@config.MaxDelinquencyDays @GlobalShared.Days</td>
                                    </tr>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            index++;
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="mdi mdi-information-outline me-2"></i>
            @GlobalIPSConfig.No_IPS_configurations_found_for_the_selected_year
        </div>
    }

    <div class="row mt-3">
        <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
            </button>
        </div>
    </div>

</fieldset>


<script>
    function showIPSConfigDetails(id) {
        $.get('/IPSConfig/InitializeData', { KEY: id, partialView: '_IPSConfigDetailsPartial' })
            .done(function (html) {
                $('#detailsModal .modal-body').html(html);
                $('#detailsModal').modal('show');
            })
            .fail(function () {
                appalert('Failed to load details', 0, 1);
            });
    }
</script>
