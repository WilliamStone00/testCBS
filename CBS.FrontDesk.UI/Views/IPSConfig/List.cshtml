@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSConfigQuery
@using Resources

@{
    ViewBag.Title = "IPS Configurations List";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>@GlobalIPSConfig.IPS_Configurations_Management
                </h1>
                <p class="card-text">
                    @GlobalIPSConfig.Browse_and_filter_IPS_configurations_by_year_branch_and_other_criteria
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @GlobalIPSConfig.Use_the_filters_below_to_narrow_down_the_list_of_IPS_configurations
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalIPSConfig.IPS_Configuration_Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIPSTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseIPSTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-check text-success me-2"></i>
                    <strong>@GlobalShared.Year_Selection:</strong> @GlobalIPSConfig.Each_configuration_is_specific_to_a_calendar_year_Create_separate_configurations_for_different_years
                </li>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>@GlobalShared.Age_Limit:</strong> @GlobalIPSConfig.Set_maximum_customer_age_for_insurance_eligibility_Customers_beyond_this_age_wont_be_covered
                </li>
                <li>
                    <i class="mdi mdi-currency-usd text-warning me-2"></i>
                    <strong>@GlobalShared.Coverage_Limits:</strong> @GlobalIPSConfig.Define_maximum_insurance_coverage_amounts_for_both_loan_and_savings_products
                </li>
                <li>
                    <i class="mdi mdi-percent-box text-primary me-2"></i>
                    <strong>@GlobalShared.Premium_Rates:</strong> @GlobalIPSConfig.Configure_different_premium_rates_for_loans_and_savings_Rates_are_applied_as_percentages
                </li>
                <li>
                    <i class="mdi mdi-calendar-alert text-danger me-2"></i>
                    <strong>@GlobalShared.Delinquency_Period:</strong> @GlobalIPSConfig.Set_maximum_delinquency_days_allowed_before_insurance_coverage_is_suspended
                </li>
                <li>
                    <i class="mdi mdi-account-group text-secondary me-2"></i>
                    <strong>@GlobalShared.Group_Exclusion:</strong> @GlobalIPSConfig.Enable_this_option_to_exclude_group_accounts_from_insurance_coverage
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-success me-2"></i>
                    <strong>@GlobalShared.Active_Status:</strong> @GlobalIPSConfig.Only_active_configurations_are_applied_to_new_insurance_policies
                </li>
                <li>
                    <i class="mdi mdi-home-city text-info me-2"></i>
                    <strong>@GlobalShared.Branch_Specific:</strong> @GlobalIPSConfig.Create_branch_specific_configurations_or_apply_the_same_settings_across_all_branches
                </li>
                <li>
                    <i class="mdi mdi-bank text-primary me-2"></i>
                    <strong>@GlobalShared.Account_Mapping:</strong> @GlobalIPSConfig.Select_appropriate_debit_and_credit_accounts_for_life_savings_claims_and_loan_protection_transactions
                </li>
            </ul>
        </div>
    </div>
</div>
<div id="datalistingview2">
    <div class="card mb-1">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a href="@Url.Action("List", "IPSConfig")"
               class="btn btn-label-primary btn-sm me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="@GlobalShared.ViewList">
                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
            </a>
            <a href="@Url.Action("Index", "IPSConfig")"
               class="btn btn-light text-primary me-2"
               id="btnViewList"
               data-bs-toggle="tooltip"
               title="Add New">
                <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add_New_LC
            </a>
        </div>
    </div>


    <div class="card shadow p-3 mb-1">
        <h5 class="text-primary mb-1">
            <i class="mdi mdi-filter-outline me-1"></i> @GlobalIPSConfig.IPS_Configuration_Filters
        </h5>

        <form id="ipsFilterForm" autocomplete="off">
            <div class="card p-3 mb-3 bg-light">

                <!-- Basic Filters (Always Visible) -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GlobalShared.Branch</label>
                            @Html.DropDownListFor(
                                m => m.BranchId,
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-control select2", id = "filterBranch" }
                            )
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GlobalShared.Year</label>
                            @Html.TextBoxFor(
                                m => m.Year,
                                new
                                     {
                                    @class = "form-control",
                                    type = "number",
                                    placeholder = "Enter Year",
                                    id = "filterYear",
                                    min = "2000",
                                    max = "2100"
                                }
                            )
                        </div>
                    </div>
                </div>

                <!-- Toggleable Filter Sections -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleAgeLimit" />
                            <label class="form-check-label fw-semibold" for="toggleAgeLimit">
                                <i class="mdi mdi-account-clock me-1"></i> @GlobalShared.Age_Limit
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleDelinquency" />
                            <label class="form-check-label fw-semibold" for="toggleDelinquency">
                                <i class="mdi mdi-calendar-alert me-1"></i> @GlobalShared.Delinquency_Days
                            </label>
                        </div>

                        <div class="form-check form-check-inline me-3">
                            <input class="form-check-input" type="checkbox" id="toggleDateRange" />
                            <label class="form-check-label fw-semibold" for="toggleDateRange">
                                <i class="mdi mdi-calendar-range me-1"></i> @GlobalShared.Created Date
                            </label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="toggleStatus" />
                            <label class="form-check-label fw-semibold" for="toggleStatus">
                                <i class="mdi mdi-toggle-switch me-1"></i> @GlobalShared.Status_Filters
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Age Limit Section (Hidden by default) -->
                <div id="ageLimitSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalShared.Age_Limit_From</label>
                                @Html.TextBoxFor(
                                    m => m.AgeLimitFrom,
                                    new { @class = "form-control", type = "number", placeholder = "From", id = "AgeLimitFrom", min = "0" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalShared.Age_Limit_To</label>
                                @Html.TextBoxFor(
                                    m => m.AgeLimitTo,
                                    new { @class = "form-control", type = "number", placeholder = "To", id = "AgeLimitTo", min = "0" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delinquency Days Section (Hidden by default) -->
                <div id="delinquencySection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalIPSConfig.Max_Delinquency_Days_From</label>
                                @Html.TextBoxFor(
                                    m => m.MaxDelinquencyDaysFrom,
                                    new { @class = "form-control", type = "number", placeholder = "From", id = "MaxDelinquencyDaysFrom", min = "0" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalIPSConfig.Max_Delinquency_Days_To</label>
                                @Html.TextBoxFor(
                                    m => m.MaxDelinquencyDaysTo,
                                    new { @class = "form-control", type = "number", placeholder = "To", id = "MaxDelinquencyDaysTo", min = "0" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Created Date Range Section (Hidden by default) -->
                <div id="dateRangeSection" class="collapse">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalShared.Created_From</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedFromUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedFromUtc" }
                                )
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@GlobalShared.Created_To</label>
                                @Html.TextBoxFor(
                                    m => m.CreatedToUtc,
                                    new { @class = "form-control", type = "date", id = "CreatedToUtc" }
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Filters Section (Hidden by default) -->
                <div id="statusSection" class="collapse">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-check mb-3">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       name="IsActive"
                                       value="true" />
                                <label class="form-check-label fw-semibold" for="IsActive">
                                    @GlobalShared.Is_Active
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.IncludeDeleted, new { @class = "form-check-input", id = "IncludeDeleted" })
                                <label class="form-check-label fw-semibold" for="IncludeDeleted">
                                    @GlobalShared.Include_Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Actions -->
            <div class="row mt-2">
                <div class="col-md-12 d-flex">
                    <button type="button" id="applyFilterBtn" class="btn btn-primary me-2 w-100">
                        <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                    </button>

                    <button type="button" id="resetFilterBtn" class="btn btn-secondary me-2 w-100">
                        <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div id="datalistingview">
        @Html.Partial("_IPSConfigDataTable")
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        var IPSTable = null;

        /* ============================
           COLLECT FILTER VALUES
        ============================ */
        function collectFilters() {
            return {
                BranchId: $('#filterBranch').val() || null,
                Year: $('#filterYear').val() || null,

                AgeLimitFrom: $('#AgeLimitFrom').val() || null,
                AgeLimitTo: $('#AgeLimitTo').val() || null,

                MaxDelinquencyDaysFrom: $('#MaxDelinquencyDaysFrom').val() || null,
                MaxDelinquencyDaysTo: $('#MaxDelinquencyDaysTo').val() || null,

                CreatedFromUtc: $('#CreatedFromUtc').val() || null,
                CreatedToUtc: $('#CreatedToUtc').val() || null,

                IsActive: $('#IsActive').is(':checked') || null,
                IncludeDeleted: $('#IncludeDeleted').is(':checked') ? true : null,

                options: {}
            };
        }

        /* ============================
           INIT / REINIT DATATABLE
           IMPORTANT: Check what table ID is actually in _IPSConfigDataTable
        ============================ */
        function initDataTable() {
            // FIRST: Check what table ID actually exists on the page
            var tableId = '#IPSDataTable'; // Most likely this is the correct ID
            if (!$(tableId).length) {
                tableId = '#myDataTable'; // Fallback to your ID
                if (!$(tableId).length) {
                    appalert('Table element not found. Expected #IPSDataTable or #myDataTable', 0, 1);
                    console.error('No table found with IDs: #IPSDataTable or #myDataTable');
                    return;
                }
            }

            // Destroy existing DataTable if it exists
            if ($.fn.DataTable.isDataTable(tableId)) {
                if (IPSTable) {
                    IPSTable.destroy();
                }
                // Clear the table but preserve the thead
                $(tableId + ' tbody').empty();
            }

            IPSTable = $(tableId).DataTable({
                serverSide: true,
                searching: true,
                responsive: true,
                ordering: true,
                order: [[0, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                destroy: true, // Add this to ensure clean state
                ajax: {
                    url: '/IPSConfig/LoadIPSConfigData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        var filters = collectFilters();

                        filters.options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search.value || '',
                            sortColumnName: 'CreatedDate',
                            sortColumnDirection: 'desc'
                        };

                        return JSON.stringify(filters);
                    },
                    dataSrc: function (json) {
                        if (json && json.data) {
                            return json.data;
                        }
                        return [];
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('DataTable AJAX error:', textStatus, errorThrown);
                        appalert('Failed to load IPS configurations', 0, 1);
                    }
                },

                columns: [
                    {
                        data: 'CreatedDate',
                        name: 'CreatedDate',
                        render: function (data) {
                            return data
                                ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data)
                                : '-';
                        }
                    },
                    {
                        data: 'BranchName',
                        name: 'BranchName',
                        render: function(d) {
                            return d ? `<span class="badge bg-primary">${d}</span>` : '-';
                        }
                    },
                    {
                        data: 'Year',
                        name: 'Year',
                        render: function(d) {
                            return d || '-';
                        }
                    },
                    {
                        data: 'AgeLimit',
                        name: 'AgeLimit',
                        render: function(d) {
                            return d || '-';
                        }
                    },
                    {
                        data: 'MaxDelinquencyDays',
                        name: 'MaxDelinquencyDays',
                        render: function(d) {
                            return d || '-';
                        }
                    },
                    {
                        data: 'IsActive',
                        name: 'IsActive',
                        render: function(d) {
                            return (d === true || d === 'true')
                                ? '<span class="badge bg-success">Active</span>'
                                : '<span class="badge bg-secondary">Inactive</span>';
                        }
                    },
                    {
                        data: 'IsDeleted',
                        name: 'IsDeleted',
                        render: function(d) {
                            return (d === true || d === 'true')
                                ? '<span class="badge bg-danger">Deleted</span>'
                                : '<span class="badge bg-success">No</span>';
                        }
                    },
                    {
                        data: 'Id',
                        name: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (id, type, row) {

                            var safeId = (id || '').replace(/[^a-zA-Z0-9_-]/g, '');
                            var btnId = 'ips_' + safeId;
                            var branchId = row.BranchId; // ✅ CORRECT SOURCE

                            return `
<div class="dropdown text-center">
    <button class="btn btn-sm btn-info dropdown-toggle shadow-sm"
            id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="mdi mdi-cog-outline me-1"></i> Actions
    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="${btnId}">

        <li>
            <button class="dropdown-item btn-details text-primary fw-semibold"
                    data-id="${id}">
                <i class="mdi mdi-eye-outline me-2"></i> View Details
            </button>
        </li>

        <li>
            <button class="dropdown-item btn-active-year text-info fw-semibold"
                    data-year="${row.Year}"
                    data-branch-id="${branchId}">
                <i class="mdi mdi-calendar-check-outline me-2"></i> Active by Year
            </button>
        </li>

        <li>
            <button class="dropdown-item btn-year-configs text-warning fw-semibold"
                    data-year="${row.Year}">
                <i class="mdi mdi-calendar-multiple-outline me-2"></i> All by Year
            </button>
        </li>

        <li><hr class="dropdown-divider"></li>

        <li>
            <button class="dropdown-item btn-edit text-success fw-semibold"
                    data-id="${id}"
                    data-branch-id="${branchId}">
                <i class="mdi mdi-pencil-outline me-2"></i> Edit
            </button>
        </li>

        <li>
            <button class="dropdown-item btn-delete text-danger fw-semibold"
                    data-id="${id}"
                    data-year="${row.Year}">
                <i class="mdi mdi-delete-outline me-2"></i> Delete
            </button>
        </li>

    </ul>
</div>`;
                        }
                    }

                ],

                language: {
                    emptyTable: 'No IPS configurations found',
                    processing: '<div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading...</span></div> Loading...',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    lengthMenu: 'Show _MENU_ entries',
                    search: 'Search:',
                    zeroRecords: 'No matching records found'
                },

                initComplete: function() {
                    console.log('DataTable initialized with ID:', tableId);
                }
            });
        }

        /* ============================
           LOAD DATA
        ============================ */
        function loadIPSData() {
            initDataTable();
        }

        /* ============================
           RESET FILTERS
        ============================ */
        function resetFilters() {
            $('#ipsFilterForm')[0].reset();
            $('.collapse').collapse('hide');
            $('input[type=checkbox]').prop('checked', false);

            if ($.fn.select2) {
                $('#filterBranch').val(null).trigger('change');
            }

            loadIPSData();
        }

        /* ============================
           CHECKBOX → COLLAPSE TOGGLES
        ============================ */
        function bindFilterToggles() {

            $('#toggleAgeLimit').change(function () {
                $('#ageLimitSection').collapse(this.checked ? 'show' : 'hide');
                if (!this.checked) $('#AgeLimitFrom,#AgeLimitTo').val('');
            });

            $('#toggleDelinquency').change(function () {
                $('#delinquencySection').collapse(this.checked ? 'show' : 'hide');
                if (!this.checked) $('#MaxDelinquencyDaysFrom,#MaxDelinquencyDaysTo').val('');
            });

            $('#toggleDateRange').change(function () {
                $('#dateRangeSection').collapse(this.checked ? 'show' : 'hide');
                if (!this.checked) $('#CreatedFromUtc,#CreatedToUtc').val('');
            });

            $('#toggleStatus').change(function () {
                $('#statusSection').collapse(this.checked ? 'show' : 'hide');
            });
        }

        /* ============================
           DOCUMENT READY
        ============================ */
        $(document).ready(function () {
            console.log('Document ready - checking for table...');

            if ($.fn.select2) {
                $('#filterBranch').select2({
                    width: '100%',
                    placeholder: '--- Select Branch ---',
                    allowClear: true
                });
            }

            bindFilterToggles();

            $('#applyFilterBtn').click(function (e) {
                e.preventDefault();
                console.log('Apply filter clicked');
                loadIPSData();
            });

            $('#resetFilterBtn').click(function (e) {
                e.preventDefault();
                console.log('Reset filter clicked');
                resetFilters();
            });

            $('#ipsFilterForm input').keypress(function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadIPSData();
                }
            });

            // Uncomment to load data on page load
            // setTimeout(function() {
            //     loadIPSData();
            // }, 100);
        });

        /* ============================
           ACTION HANDLERS
        ============================ */
        $(document).on('click', '.btn-details', function () {
            var id = $(this).data('id');
            console.log('Details for ID:', id);

            $.get('/IPSConfig/InitializeData', { KEY: id })
                .done(function(html) {
                    $('#IPSDetailsModal .modal-body').html(html);
                    var modal = new bootstrap.Modal(document.getElementById('IPSDetailsModal'));
                    modal.show();
                })
                .fail(function() {
                    appalert('Failed to load details', 0, 1);
                });
        });

        $(document).on('click', '.btn-active-year', function () {
            var year = $(this).data('year');
            var branchId = $(this).data('branch-id');
            console.log('Active by year:', year);

            $.get('/IPSConfig/InitializeData', { KEY: year, path: 'activeyear', serviceOption: branchId })
                .done(function(html) {
                    $('#IPSDetailsModal .modal-body').html(html);
                    var modal = new bootstrap.Modal(document.getElementById('IPSDetailsModal'));
                    modal.show();
                })
                .fail(function() {
                    appalert('Failed to load active configuration', 0, 1);
                });
        });

        $(document).on('click', '.btn-year-configs', function () {
            var year = $(this).data('year');

            console.log('All by year:', year);

            $.get('/IPSConfig/InitializeData', { KEY: year, path: 'year' })
                .done(function(html) {
                    $('#IPSYearModal .modal-body').html(html);
                    var modal = new bootstrap.Modal(document.getElementById('IPSYearModal'));
                    modal.show();
                })
                .fail(function() {
                    appalert('Failed to load year configurations', 0, 1);
                });
        });

        $(document).on('click', '.btn-edit', function () {
            var id = $(this).data('id');
            console.log('Edit ID:', id);
            AddORUpdateGen(id, 'datalistingview2', '_IPSConfigForm', 'get', 'IPSConfig');
        });

        $(document).on('click', '.btn-delete', function () {
            var id = $(this).data('id');
            var year = $(this).data('year');
            console.log('Delete ID:', id, 'Year:', year);
            confirmAndDeleteIPSConfig(id, year);
        });

        function confirmAndDeleteIPSConfig(id, year) {
            alertify.confirm('Confirm Deletion', `Delete IPS configuration for year ${year}?`,
                function () {
                    $.post('@Url.Action("Delete", "IPSConfig")', {
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                        KEY: id
                    }).done(function(r) {
                        appalert(r.message, r.success ? 1 : 4, 1);
                        if (r.success) loadIPSData();
                    }).fail(function() {
                        appalert('An error occurred during deletion', 4, 1);
                    });
                },
                function() {
                    appalert('Delete cancelled', 3, 1);
                }
            );
        }
    </script>
}