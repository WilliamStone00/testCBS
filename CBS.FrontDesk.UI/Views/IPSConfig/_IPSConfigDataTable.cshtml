@using Resources

@using Resources

<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-table"></i> @GlobalShared.IPS_Config_Listing
    </h5>

    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Created_Date</th>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.Year</th>
                    <th>@GlobalShared.Age_Limit</th>
                    <th>Max D. Days</th>
                    <th>@GlobalShared.Active</th>
                    <th>@GlobalShared.Deleted</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="IPSDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @*<h5 class="modal-title text-primary">
                    <i class="mdi mdi-shield-account-outline me-2"></i> IPS Configuration Details
                </h5>*@
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Details will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Year Configs Modal -->
<div class="modal fade" id="IPSYearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">                
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Multiple configs will be loaded here -->
            </div>
        </div>
    </div>
</div>


