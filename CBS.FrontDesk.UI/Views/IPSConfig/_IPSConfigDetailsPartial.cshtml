@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSConfig
@using Resources

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-shield-account-outline me-2"></i>@GlobalIPSConfig.IPS_Config_Details
        </h1>
        <p class="card-text text-muted mb-1">
            @GlobalIPSConfig.bellow_we_have_the_Detail_Description_of_an_IPS_Configuration
        </p>
    </div>
</div>

<fieldset class="fieldset-custom">


    <div class="row">
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Basic_Information</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">ID:</td><td>@Model.Id</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Year:</td><td>@Model.Year</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Age_Limit:</td><td>@Model.AgeLimit</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Branch:</td><td>@Model.BranchName (@Model.BranchCode)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Is_Active:</td><td>@(Model.IsActive ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Exclude_Groups:</td><td>@(Model.ExcludeGroups ? "Yes" : "No")</td></tr>
            </table>
        </div>

        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-finance me-2"></i> @GlobalShared.Coverage_Limits</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@GlobalShared.Loan_Coverage_Limit:</td><td>@String.Format("{0:N2}", Model.LoanCoverageLimit)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Savings_Coverage_Limit:</td><td>@String.Format("{0:N2}", Model.SavingsCoverageLimit)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Premium_Rate_Loan:</td><td>@String.Format("{0:N4}", Model.PremiumRateLoan)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Premium_Rate_Savings:</td><td>@String.Format("{0:N4}", Model.PremiumRateSavings)</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Max_Delinquency_Days:</td><td>@Model.MaxDelinquencyDays</td></tr>
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> @GlobalShared.Timeline</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@GlobalShared.Created_Date:</td><td>@Model.CreatedDate.ToString()</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Created_by:</td><td>@Model.CreatedBy</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Modified_Date:</td><td>@Model.ModifiedDate.ToString()</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Modified_By:</td><td>@Model.ModifiedBy</td></tr>
                <tr><td class="fw-bold">@GlobalShared.Is_Deleted:</td><td>@(Model.IsDeleted ? "Yes" : "No")</td></tr>
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="mdi mdi-close me-1"></i> @GlobalShared.Close
            </button>
        </div>
    </div>
</fieldset>
