@model CBS.FrontDesk.Data.Entity.Accounting_V2.IPS.IPSConfig
@using Resources

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "IPSConfig")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_IPSConfigForm','new','IPSConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="AddNew">
            <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add_New_LC
        </a>
    </div>
</div>

<div class="card mb-1">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "IPSConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(m => m.Id)

            <div class="row gy-3">
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-cog-outline me-1"></i> @GlobalIPSConfig.IPS_Configuration_Details</h6>
                </div>

                <div class="col-md-3">
                    <div class="form-group ps-2 pt-3">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="IsCentralized"
                                   name="IsCentralized"
                                   value="true" />
                            <label class="form-check-label" for="IsCentralized">
                                @GlobalShared.Is_Centralized
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row gy-3">
                    <div class="col-md-12" id="branchSection">
                        <label>@GlobalUserManagement.Branch</label>
                        <div class="form-floating shadow-sm">
                            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---"+ GlobalShared.Select_Branch+"---", new { @class = "form-control select2", id = "BranchId", onchange = "loadBranchAccounts()" })
                            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Year, new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "2015",
                            max = DateTime.Now.Year,
                            value = DateTime.Now.Year,
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.Year, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Year</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.AgeLimit, new { @class = "form-control", type = "number", min = "40", required = "required", placeholder = ""+ GlobalShared.Age_Limit + "" })
                        @Html.ValidationMessageFor(m => m.AgeLimit, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Age_Limit</label>
                    </div>
                </div>

                <!-- Account Configuration Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1 mt-4"><i class="mdi mdi-bank me-1"></i> @GlobalShared.Account_Configuration</h6>
                </div>


                <div id="branchAccountsSection">
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <label>@GlobalIPSConfig.Life_Savings_Claim_Debit_Account</label>
                            <div class="form-floating shadow-sm">
                                @Html.DropDownListFor(m => m.LifeSavingsClaimDebitAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "---"+ GlobalShared.Select_Debit_Account +"---", new { @class = "form-control select2", id = "LifeSavingsClaimDebitAccountId" })
                                @Html.ValidationMessageFor(m => m.LifeSavingsClaimDebitAccountId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label>@GlobalIPSConfig.Life_Savings_Claim_Credit_Account</label>
                            <div class="form-floating shadow-sm">
                                @Html.DropDownListFor(m => m.LifeSavingsClaimCreditAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "---"+ GlobalShared.Select_Credit_Account + "---", new { @class = "form-control select2", id = "LifeSavingsClaimCreditAccountId" })
                                @Html.ValidationMessageFor(m => m.LifeSavingsClaimCreditAccountId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label>@GlobalIPSConfig.Loan_Protection_Debit_Account</label>
                            <div class="form-floating shadow-sm">
                                @Html.DropDownListFor(m => m.LoanProtectionDebitAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "---"+ GlobalShared.Select_Debit_Account + "---", new { @class = "form-control select2", id = "LoanProtectionDebitAccountId" })
                                @Html.ValidationMessageFor(m => m.LoanProtectionDebitAccountId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label>@GlobalIPSConfig.Loan_Protection_Credit_Account</label>
                            <div class="form-floating shadow-sm">
                                @Html.DropDownListFor(m => m.LoanProtectionCreditAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "---" +@GlobalShared.Select_Credit_Account +"---", new { @class = "form-control select2", id = "LoanProtectionCreditAccountId" })
                                @Html.ValidationMessageFor(m => m.LoanProtectionCreditAccountId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>


                <div id="affiliateAccountsSection">
                    @if (Model.IsCentralized == false)
                    {
                        <div class="row gy-3">

                            <div class="col-md-6">
                                <label>@GlobalIPSConfig.Life_Savings_Claim_Debit_Account</label>
                                <div class="form-floating shadow-sm">
                                    @Html.DropDownListFor(m => m.LifeSavingsClaimDebitAccountId, new SelectList(ViewBag.AffiliateAccounts, "Value", "Text"), "---" + GlobalShared.Select_Affiliate_Account + "---", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(m => m.LifeSavingsClaimDebitAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label>@GlobalIPSConfig.Life_Savings_Claim_Credit_Account</label>
                                <div class="form-floating shadow-sm">
                                    @Html.DropDownListFor(m => m.LifeSavingsClaimCreditAccountId, new SelectList(ViewBag.AffiliateAccounts, "Value", "Text"), "---"+ GlobalShared.Select_Affiliate_Account +"---", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(m => m.LifeSavingsClaimCreditAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label>@GlobalIPSConfig.Loan_Protection_Debit_Account</label>
                                <div class="form-floating shadow-sm">
                                    @Html.DropDownListFor(m => m.LoanProtectionDebitAccountId, new SelectList(ViewBag.AffiliateAccounts, "Value", "Text"), "---" + GlobalShared.Select_Affiliate_Account +"---", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(m => m.LoanProtectionDebitAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label>@GlobalIPSConfig.Loan_Protection_Credit_Account</label>
                                <div class="form-floating shadow-sm">
                                    @Html.DropDownListFor(m => m.LoanProtectionCreditAccountId, new SelectList(ViewBag.AffiliateAccounts, "Value", "Text"), "---"+ GlobalShared.Select_Affiliate_Account +"---", new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(m => m.LoanProtectionCreditAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Coverage Limits Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1 mt-4"><i class="mdi mdi-currency-usd me-1"></i> @GlobalShared.Coverage_Limits</h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.LoanCoverageLimit, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = ""+ GlobalShared.Loan_Coverage_Limit + "" })
                        @Html.ValidationMessageFor(m => m.LoanCoverageLimit, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Loan_Coverage_Limit</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.SavingsCoverageLimit, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = ""+ GlobalShared.Savings_Coverage_Limit + "" })
                        @Html.ValidationMessageFor(m => m.SavingsCoverageLimit, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Savings_Coverage_Limit</label>
                    </div>
                </div>

                <!-- Premium Rates Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1 mt-4"><i class="mdi mdi-percent me-1"></i> @GlobalShared.Premium_Rates</h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.PremiumRateLoan, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = ""+ GlobalShared.Premium_Rate_Loan + "" })
                        @Html.ValidationMessageFor(m => m.PremiumRateLoan, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Premium_Rate_Loan</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.PremiumRateSavings, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = ""+GlobalShared.Premium_Rate_Savings + "" })
                        @Html.ValidationMessageFor(m => m.PremiumRateSavings, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Premium_Rate_Savings</label>
                    </div>
                </div>

                <!-- Additional Settings -->
                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.MaxDelinquencyDays, new { @class = "form-control", type = "number", min = "0", required = "required", placeholder = ""+GlobalShared.Max_Delinquency_Days +"" })
                        @Html.ValidationMessageFor(m => m.MaxDelinquencyDays, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Max_Delinquency_Days</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group ps-2 pt-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.ExcludeGroups, new { @class = "form-check-input", id = "ExcludeGroups" })
                            <label class="form-check-label" for="ExcludeGroups">@GlobalShared.Exclude_Groups</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group ps-2 pt-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                            <label class="form-check-label" for="IsActive">@GlobalShared.Is_Active</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 text-end mt-3">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="fas fa-save me-1"></i>@GlobalShared.Create_Configuration
                        </button>
                        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                            @GlobalShared.Reset
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                        <button type="button" onclick="AddORUpdateGen(null,'datalistingview','_IPSConfigList','list','IPSConfig')" class="btn btn-outline-secondary">
                            @GlobalShared.Cancel
                        </button>
                    }
                </div>
            </div>

        }
    </div>
</div>


<script>
    $(document).ready(function () {
        // Initialize Select2 on all dropdowns
        $('.select2').select2();

        // If editing an existing config with a branch selected, load accounts
        if ($('#BranchId').val()) {
            loadBranchAccounts();
        }
    });

    // Function to load branch accounts
    function loadBranchAccounts() {
        var branchId = $('#BranchId').val();

        if (!branchId) {
            clearAccountDropdowns();
            return;
        }

        showLoadingAccounts();

        $.ajax({
            url: '@Url.Action("GetBranchAccountsByBranch", "IPSConfig")',
            type: 'GET',
            data: { branchId: branchId },
            success: function (accounts) {
                if (accounts && accounts.length > 0) {
                    updateAccountDropdowns(accounts);

                    // ✅ Re-select values from model (edit mode)
                    $('#LifeSavingsClaimDebitAccountId')
                        .val('@Model.LifeSavingsClaimDebitAccountId').trigger('change');
                    $('#LifeSavingsClaimCreditAccountId')
                        .val('@Model.LifeSavingsClaimCreditAccountId').trigger('change');
                    $('#LoanProtectionDebitAccountId')
                        .val('@Model.LoanProtectionDebitAccountId').trigger('change');
                    $('#LoanProtectionCreditAccountId')
                        .val('@Model.LoanProtectionCreditAccountId').trigger('change');
                } else {
                    clearAccountDropdowns();
                    appalert('No accounts found for the selected branch', 3, 1);
                }
            },
            error: function (xhr) {
                clearAccountDropdowns();
                console.error('Error loading branch accounts:', xhr);
                appalert('Failed to load branch accounts', 0, 1);
            }
        });
    }

    // Function to update all account dropdowns
    function updateAccountDropdowns(accounts) {
        var accountOptions = '<option value="">--- Select Account ---</option>';

        $.each(accounts, function (index, account) {
            accountOptions += '<option value="' + account.Id + '">' + account.Name + '</option>';
        });

        // Update all account dropdowns
        $('#LifeSavingsClaimDebitAccountId').html(accountOptions);
        $('#LifeSavingsClaimCreditAccountId').html(accountOptions);
        $('#LoanProtectionDebitAccountId').html(accountOptions);
        $('#LoanProtectionCreditAccountId').html(accountOptions);

        // 🔑 Re-initialize Select2 after updating options
        $('#LifeSavingsClaimDebitAccountId, #LifeSavingsClaimCreditAccountId, #LoanProtectionDebitAccountId, #LoanProtectionCreditAccountId').select2();
    }

    // Function to clear all account dropdowns
    function clearAccountDropdowns() {
        var emptyOption = '<option value="">--- Select Account ---</option>';

        $('#LifeSavingsClaimDebitAccountId').html(emptyOption);
        $('#LifeSavingsClaimCreditAccountId').html(emptyOption);
        $('#LoanProtectionDebitAccountId').html(emptyOption);
        $('#LoanProtectionCreditAccountId').html(emptyOption);

        // Re-init Select2 on cleared dropdowns
        $('#LifeSavingsClaimDebitAccountId, #LifeSavingsClaimCreditAccountId, #LoanProtectionDebitAccountId, #LoanProtectionCreditAccountId').select2();
    }

    // Function to show loading state in account dropdowns
    function showLoadingAccounts() {
        var loadingOption = '<option value="" disabled>Loading accounts...</option>';

        $('#LifeSavingsClaimDebitAccountId').html(loadingOption);
        $('#LifeSavingsClaimCreditAccountId').html(loadingOption);
        $('#LoanProtectionDebitAccountId').html(loadingOption);
        $('#LoanProtectionCreditAccountId').html(loadingOption);

        // Re-init Select2 on loading state
        $('#LifeSavingsClaimDebitAccountId, #LifeSavingsClaimCreditAccountId, #LoanProtectionDebitAccountId, #LoanProtectionCreditAccountId').select2();
    }
</script>
