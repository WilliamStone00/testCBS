@{
    ViewBag.Title = "IPS Configuration Management";
}
@using Resources

<script>
    window.IPSConfigSubmitAjax = function (form) {
        if (window.__IPSConfigSubmitAjaxFull) {
            return window.__IPSConfigSubmitAjaxFull(form);
        }
        console.warn('Form handler not fully loaded yet, using fallback');
        return true;
    };
</script>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>@GlobalIPSConfig.IPS_Configuration_Management
                </h1>
                <p class="card-text">
                    @GlobalIPSConfig.Configure_and_manage_Insurance_Premium_System_settings_for_different_years_and_branches
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @GlobalIPSConfig.Set_coverage_limits_premium_rates_and_eligibility_criteria_for_loan_and_savings_insurance_products
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalIPSConfig.IPS_Configuration_Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIPSTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseIPSTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-check text-success me-2"></i>
                    <strong>@GlobalShared.Year_Selection:</strong> @GlobalIPSConfig.Each_configuration_is_specific_to_a_calendar_year_Create_separate_configurations_for_different_years
                </li>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>@GlobalShared.Age_Limit:</strong> @GlobalIPSConfig.Set_maximum_customer_age_for_insurance_eligibility_Customers_beyond_this_age_wont_be_covered
                </li>
                <li>
                    <i class="mdi mdi-currency-usd text-warning me-2"></i>
                    <strong>@GlobalShared.Coverage_Limits:</strong> @GlobalIPSConfig.Define_maximum_insurance_coverage_amounts_for_both_loan_and_savings_products
                </li>
                <li>
                    <i class="mdi mdi-percent-box text-primary me-2"></i>
                    <strong>@GlobalShared.Premium_Rates:</strong> @GlobalIPSConfig.Configure_different_premium_rates_for_loans_and_savings_Rates_are_applied_as_percentages
                </li>
                <li>
                    <i class="mdi mdi-calendar-alert text-danger me-2"></i>
                    <strong>@GlobalShared.Delinquency_Period:</strong> @GlobalIPSConfig.Set_maximum_delinquency_days_allowed_before_insurance_coverage_is_suspended
                </li>
                <li>
                    <i class="mdi mdi-account-group text-secondary me-2"></i>
                    <strong>@GlobalShared.Group_Exclusion:</strong> @GlobalIPSConfig.Enable_this_option_to_exclude_group_accounts_from_insurance_coverage
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-success me-2"></i>
                    <strong>@GlobalShared.Active_Status:</strong> @GlobalIPSConfig.Only_active_configurations_are_applied_to_new_insurance_policies
                </li>
                <li>
                    <i class="mdi mdi-home-city text-info me-2"></i>
                    <strong>@GlobalShared.Branch_Specific:</strong> @GlobalIPSConfig.Create_branch_specific_configurations_or_apply_the_same_settings_across_all_branches
                </li>
                <li>
                    <i class="mdi mdi-bank text-primary me-2"></i>
                    <strong>@GlobalShared.Account_Mapping:</strong> @GlobalIPSConfig.Select_appropriate_debit_and_credit_accounts_for_life_savings_claims_and_loan_protection_transactions
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    @Html.Partial("_IPSConfigForm")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
(function ($) {
    'use strict';

    /* =========================
       UTILITIES
    ========================= */
    function normalizeResponse(raw) {
        if (!raw) return { success: false, message: 'Empty response' };
        if (typeof raw === 'object') return raw;
        try { return JSON.parse(raw); } catch { }
        return { success: false, message: 'Unexpected response' };
    }

    function getAntiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').first().val() || null;
    }

    /* =========================
       SELECT2 INITIALIZATION
    ========================= */
    function initializeSelect2(selector) {
        $(selector).select2({
            placeholder: "--- Select ---",
            allowClear: true,
            width: '100%'
        });
    }

    function reinitializeAllSelect2() {
        // Destroy existing instances
        $('.select2').select2('destroy');

        // Reinitialize only visible select2 elements
        $('.select2:visible').each(function() {
            $(this).select2({
                placeholder: $(this).attr('placeholder') || "--- Select ---",
                allowClear: true,
                width: '100%'
            });
        });
    }

    /* =========================
       ACCOUNT SECTION TOGGLER
    ========================= */
    function toggleSection(sectionId, enable) {
        const section = $(sectionId);
        section.toggle(enable);
        section.find('select').prop('disabled', !enable);

        // Reinitialize Select2 for the section
        if (enable) {
            setTimeout(function() {
                section.find('.select2').select2({
                    placeholder: "--- Select ---",
                    allowClear: true,
                    width: '100%'
                });
            }, 100);
        }
    }

    function toggleCentralizedMode() {
        const isCentralized = $('#IsCentralized').is(':checked');

        if (isCentralized) {
            // Centralized → Affiliate accounts
            toggleSection('#affiliateAccountsSection', true);
            toggleSection('#branchAccountsSection', false);

            // Hide branch
            $('#branchSection').hide();
            $('#BranchId').val('').trigger('change').prop('required', false);

            // Clear branch accounts
            $('#branchAccountsSection select').val('').trigger('change');

        } else {
            // Branch-based mode
            toggleSection('#branchAccountsSection', true);
            toggleSection('#affiliateAccountsSection', false);

            $('#branchSection').show();
            $('#BranchId').prop('required', true);

            // Clear affiliate accounts
            $('#affiliateAccountsSection select').val('').trigger('change');
        }

        // Reinitialize Select2 after mode change
        setTimeout(reinitializeAllSelect2, 200);
    }

    /* =========================
       BRANCH ACCOUNT LOADING
    ========================= */
    function loadBranchAccounts() {
        if ($('#IsCentralized').is(':checked')) return;

        const branchId = $('#BranchId').val();
        if (!branchId) {
            clearBranchAccounts();
            return;
        }

        showLoading();

        $.ajax({
            url: '@Url.Action("GetBranchAccountsByBranch", "IPSConfig")',
            type: 'GET',
            data: { branchId },
            success: function (accounts) {
                if (!accounts || accounts.length === 0) {
                    clearBranchAccounts();
                    appalert('No accounts found for selected branch', 3, 1);
                    return;
                }

                let options = '<option value="">--- Select Account ---</option>';
                $.each(accounts, function (_, a) {
                    options += `<option value="${a.Id}">${a.Name}</option>`;
                });

                $('#branchAccountsSection select').html(options);

                // Reinitialize Select2 after loading options
                setTimeout(function() {
                    $('#branchAccountsSection .select2').select2({
                        placeholder: "--- Select Account ---",
                        allowClear: true,
                        width: '100%'
                    });

                    // Set values from model if in edit mode
                    setAccountValuesFromModel();
                }, 100);
            },
            error: function () {
                clearBranchAccounts();
                appalert('Failed to load branch accounts', 0, 1);
            }
        });
    }

    function clearBranchAccounts() {
        $('#branchAccountsSection select')
            .html('<option value="">--- Select Account ---</option>')
            .trigger('change');
    }

    function showLoading() {
        $('#branchAccountsSection select')
            .html('<option disabled>Loading accounts...</option>')
            .trigger('change');
    }

    /* =========================
       SET ACCOUNT VALUES FROM MODEL (Edit Mode)
    ========================= */
    function setAccountValuesFromModel() {
        // Set values for branch accounts
        $('#LifeSavingsClaimDebitAccountId')
            .val('@Model.LifeSavingsClaimDebitAccountId')
            .trigger('change');
        $('#LifeSavingsClaimCreditAccountId')
            .val('@Model.LifeSavingsClaimCreditAccountId')
            .trigger('change');
        $('#LoanProtectionDebitAccountId')
            .val('@Model.LoanProtectionDebitAccountId')
            .trigger('change');
        $('#LoanProtectionCreditAccountId')
            .val('@Model.LoanProtectionCreditAccountId')
            .trigger('change');
    }

    /* =========================
       EVENTS
    ========================= */
    $(document).on('change', '#IsCentralized', toggleCentralizedMode);
    $(document).on('change', '#BranchId', loadBranchAccounts);

    /* =========================
       INITIALIZATION
    ========================= */
    $(document).ready(function () {
        // Initialize all Select2 dropdowns with delay
        setTimeout(function() {
            // Initialize main dropdowns
            initializeSelect2('#BranchId');
            initializeSelect2('.select2');

            // Set initial values if in edit mode
            if ('@Model.Id' !== '') {
                setAccountValuesFromModel();
            }
        }, 300);

        // Initialize mode
        toggleCentralizedMode();

        // Edit mode - load branch accounts if needed
        if ($('#BranchId').val() && !$('#IsCentralized').is(':checked')) {
            setTimeout(loadBranchAccounts, 500);
        }
    });

    /* =========================
       DELETE HANDLER
    ========================= */
    window.confirmAndDeleteIPSConfig = function (id, year) {
        alertify.confirm(
            'Confirm Delete',
            `Delete IPS Configuration for year ${year}?`,
            function () {
                $.post('@Url.Action("Delete", "IPSConfig")', {
                    __RequestVerificationToken: getAntiForgeryToken(),
                    KEY: id
                })
                .done(function (res) {
                    if (res.success) {
                        appalert(res.message, 1, 1);
                        LoadDataGen('IPSConfig', 'IPSDataTable', '_IPSConfigDataTable', 0, 'datalistingview');
                    } else {
                        appalert(res.message, 4, 1);
                    }
                })
                .fail(function (xhr) {
                    const r = normalizeResponse(xhr.responseText);
                    appalert(r.message || 'Delete failed', 4, 1);
                });
            },
            function () {
                appalert('Delete cancelled', 3, 1);
            }
        );
    };

})(jQuery);
    </script>
}