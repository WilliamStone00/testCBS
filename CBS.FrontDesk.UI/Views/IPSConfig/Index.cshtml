@{
    ViewBag.Title = "IPS Configuration Management";
}
@using Resources

<script>
    window.IPSConfigSubmitAjax = function (form) {
        if (window.__IPSConfigSubmitAjaxFull) {
            return window.__IPSConfigSubmitAjaxFull(form);
        }
        console.warn('Form handler not fully loaded yet, using fallback');
        return true;
    };
</script>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>IPS Configuration Management
                </h1>
                <p class="card-text">
                    Configure and manage Insurance Premium System settings for different years and branches.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Set coverage limits, premium rates, and eligibility criteria for loan and savings insurance products.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> IPS Configuration Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIPSTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseIPSTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-check text-success me-2"></i>
                    <strong>Year Selection:</strong> Each configuration is specific to a calendar year. Create separate configurations for different years.
                </li>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>Age Limit:</strong> Set maximum customer age for insurance eligibility. Customers beyond this age won't be covered.
                </li>
                <li>
                    <i class="mdi mdi-currency-usd text-warning me-2"></i>
                    <strong>Coverage Limits:</strong> Define maximum insurance coverage amounts for both loan and savings products.
                </li>
                <li>
                    <i class="mdi mdi-percent-box text-primary me-2"></i>
                    <strong>Premium Rates:</strong> Configure different premium rates for loans and savings. Rates are applied as percentages.
                </li>
                <li>
                    <i class="mdi mdi-calendar-alert text-danger me-2"></i>
                    <strong>Delinquency Period:</strong> Set maximum delinquency days allowed before insurance coverage is suspended.
                </li>
                <li>
                    <i class="mdi mdi-account-group text-secondary me-2"></i>
                    <strong>Group Exclusion:</strong> Enable this option to exclude group accounts from insurance coverage.
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-success me-2"></i>
                    <strong>Active Status:</strong> Only active configurations are applied to new insurance policies.
                </li>
                <li>
                    <i class="mdi mdi-home-city text-info me-2"></i>
                    <strong>Branch Specific:</strong> Create branch-specific configurations or apply the same settings across all branches.
                </li>
                <li>
                    <i class="mdi mdi-bank text-primary me-2"></i>
                    <strong>Account Mapping:</strong> Select appropriate debit and credit accounts for life savings claims and loan protection transactions.
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    @Html.Partial("_IPSConfigForm")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
(function ($) {
    'use strict';

    /* =========================
       UTILITIES
    ========================= */
    function normalizeResponse(raw) {
        if (!raw) return { success: false, message: 'Empty response' };
        if (typeof raw === 'object') return raw;
        try { return JSON.parse(raw); } catch { }
        return { success: false, message: 'Unexpected response' };
    }

    function getAntiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').first().val() || null;
    }

    /* =========================
       ACCOUNT SECTION TOGGLER
    ========================= */
    function toggleSection(sectionId, enable) {
        const section = $(sectionId);
        section.toggle(enable);
        section.find('select').prop('disabled', !enable);
    }

    function toggleCentralizedMode() {
        const isCentralized = $('#IsCentralized').is(':checked');

        if (isCentralized) {
            // Centralized → Affiliate accounts
            toggleSection('#affiliateAccountsSection', true);
            toggleSection('#branchAccountsSection', false);

            // Hide branch
            $('#branchSection').hide();
            $('#BranchId').val('').trigger('change').prop('required', false);

            // Clear branch accounts
            $('#branchAccountsSection select').val('').trigger('change');

        } else {
            // Branch-based mode
            toggleSection('#branchAccountsSection', true);
            toggleSection('#affiliateAccountsSection', false);

            $('#branchSection').show();
            $('#BranchId').prop('required', true);

            // Clear affiliate accounts
            $('#affiliateAccountsSection select').val('').trigger('change');
        }
    }

    /* =========================
       BRANCH ACCOUNT LOADING
    ========================= */
    function loadBranchAccounts() {
        if ($('#IsCentralized').is(':checked')) return;

        const branchId = $('#BranchId').val();
        if (!branchId) {
            clearBranchAccounts();
            return;
        }

        showLoading();

        $.ajax({
            url: '@Url.Action("GetBranchAccountsByBranch", "IPSConfig")',
            type: 'GET',
            data: { branchId },
            success: function (accounts) {
                if (!accounts || accounts.length === 0) {
                    clearBranchAccounts();
                    appalert('No accounts found for selected branch', 3, 1);
                    return;
                }

                let options = '<option value="">--- Select Account ---</option>';
                $.each(accounts, function (_, a) {
                    options += `<option value="${a.Id}">${a.Name}</option>`;
                });

                $('#branchAccountsSection select').html(options).trigger('change');
            },
            error: function () {
                clearBranchAccounts();
                appalert('Failed to load branch accounts', 0, 1);
            }
        });
    }

    function clearBranchAccounts() {
        $('#branchAccountsSection select')
            .html('<option value="">--- Select Account ---</option>')
            .trigger('change');
    }

    function showLoading() {
        $('#branchAccountsSection select')
            .html('<option disabled selected>Loading accounts...</option>')
            .trigger('change');
    }

    /* =========================
       EVENTS
    ========================= */
    $(document).on('change', '#IsCentralized', toggleCentralizedMode);
    $(document).on('change', '#BranchId', loadBranchAccounts);

    /* =========================
       INITIALIZATION
    ========================= */
    $(document).ready(function () {

        if ($.fn.select2) {
            $('#BranchId').select2({ width: '100%' });
            $('.select2-account').select2({ width: '100%' });
        }

        toggleCentralizedMode();

        // Edit mode
        if ($('#BranchId').val() && !$('#IsCentralized').is(':checked')) {
            loadBranchAccounts();
        }
    });

    /* =========================
       DELETE HANDLER
    ========================= */
    window.confirmAndDeleteIPSConfig = function (id, year) {
        alertify.confirm(
            'Confirm Delete',
            `Delete IPS Configuration for year ${year}?`,
            function () {
                $.post('@Url.Action("Delete", "IPSConfig")', {
                    __RequestVerificationToken: getAntiForgeryToken(),
                    KEY: id
                })
                .done(function (res) {
                    if (res.success) {
                        appalert(res.message, 1, 1);
                        LoadDataGen('IPSConfig', 'IPSDataTable', '_IPSConfigDataTable', 0, 'datalistingview');
                    } else {
                        appalert(res.message, 4, 1);
                    }
                })
                .fail(function (xhr) {
                    const r = normalizeResponse(xhr.responseText);
                    appalert(r.message || 'Delete failed', 4, 1);
                });
            },
            function () {
                appalert('Delete cancelled', 3, 1);
            }
        );
    };

})(jQuery);
    </script>
}
