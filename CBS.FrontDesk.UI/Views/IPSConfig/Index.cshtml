@{
    ViewBag.Title = "IPS Configuration Management";
}
@using Resources

<script>
    window.IPSConfigSubmitAjax = function (form) {
        if (window.__IPSConfigSubmitAjaxFull) {
            return window.__IPSConfigSubmitAjaxFull(form);
        }
        console.warn('Form handler not fully loaded yet, using fallback');
        return true;
    };
</script>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-account me-2"></i>IPS Configuration Management
                </h1>
                <p class="card-text">
                    Configure and manage Insurance Premium System settings for different years and branches.
                </p>
                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    Set coverage limits, premium rates, and eligibility criteria for loan and savings insurance products.
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> IPS Configuration Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIPSTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseIPSTips" class="collapse">
        <div class="card-body">
            <ul>
                <li>
                    <i class="mdi mdi-calendar-check text-success me-2"></i>
                    <strong>Year Selection:</strong> Each configuration is specific to a calendar year. Create separate configurations for different years.
                </li>
                <li>
                    <i class="mdi mdi-account-clock text-info me-2"></i>
                    <strong>Age Limit:</strong> Set maximum customer age for insurance eligibility. Customers beyond this age won't be covered.
                </li>
                <li>
                    <i class="mdi mdi-currency-usd text-warning me-2"></i>
                    <strong>Coverage Limits:</strong> Define maximum insurance coverage amounts for both loan and savings products.
                </li>
                <li>
                    <i class="mdi mdi-percent-box text-primary me-2"></i>
                    <strong>Premium Rates:</strong> Configure different premium rates for loans and savings. Rates are applied as percentages.
                </li>
                <li>
                    <i class="mdi mdi-calendar-alert text-danger me-2"></i>
                    <strong>Delinquency Period:</strong> Set maximum delinquency days allowed before insurance coverage is suspended.
                </li>
                <li>
                    <i class="mdi mdi-account-group text-secondary me-2"></i>
                    <strong>Group Exclusion:</strong> Enable this option to exclude group accounts from insurance coverage.
                </li>
                <li>
                    <i class="mdi mdi-toggle-switch text-success me-2"></i>
                    <strong>Active Status:</strong> Only active configurations are applied to new insurance policies.
                </li>
                <li>
                    <i class="mdi mdi-home-city text-info me-2"></i>
                    <strong>Branch Specific:</strong> Create branch-specific configurations or apply the same settings across all branches.
                </li>
                <li>
                    <i class="mdi mdi-bank text-primary me-2"></i>
                    <strong>Account Mapping:</strong> Select appropriate debit and credit accounts for life savings claims and loan protection transactions.
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    @Html.Partial("_IPSConfigForm")   
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    (function ($) {
        'use strict';

        // ---------- Utilities ----------
        function normalizeResponse(raw) {
            if (!raw) return { success: false, message: 'Empty response' };
            if (typeof raw === 'object') return raw;
            if (typeof raw === 'string') {
                var t = raw.trim();
                try {
                    return JSON.parse(t);
                } catch (e) {
                    var start = t.indexOf('{'), end = t.lastIndexOf('}');
                    if (start >= 0 && end > start) {
                        try { return JSON.parse(t.substring(start, end + 1)); } catch (e2) { /* fallthrough */ }
                    }
                }
            }
            return { success: false, message: 'Unexpected server response' };
        }

        function showMsg(msg, level) {
            if (typeof appalert === 'function') appalert(msg || 'No message', level || 1, 1);
            else if (level && level <= 2) console.log((level === 1 ? 'OK: ' : 'WARN: ') + (msg || ''));
            else alert(msg || 'No message');
        }

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').first().val() || null;
        }

        // ---------- Branch Accounts Loading ----------
        function loadBranchAccounts() {
            var branchId = $('#BranchId').val();

            if (!branchId) {
                clearAccountDropdowns();
                return;
            }

            showLoadingAccounts();

            $.ajax({
                url: '@Url.Action("GetBranchAccountsByBranch", "IPSConfig")',
                type: 'GET',
                data: { branchId: branchId },
                success: function (accounts) {
                    if (accounts && accounts.length > 0) {
                        updateAccountDropdowns(accounts);
                    } else {
                        clearAccountDropdowns();
                        appalert('No accounts found for the selected branch', 3, 1);
                    }
                },
                error: function (xhr) {
                    clearAccountDropdowns();
                    console.error('Error loading branch accounts:', xhr);
                    var msg = 'Failed to load branch accounts';
                    try {
                        var parsed = JSON.parse(xhr.responseText);
                        if (parsed && parsed.message) msg = parsed.message;
                    } catch (e) {}
                    appalert(msg, 0, 1);
                }
            });
        }

        function updateAccountDropdowns(accounts) {
            var accountOptions = '<option value="">--- Select Account ---</option>';

            $.each(accounts, function (index, account) {
                accountOptions += '<option value="' + account.Id + '">' + account.Name + '</option>';
            });

            $('#LifeSavingsClaimDebitAccountId').html(accountOptions);
            $('#LifeSavingsClaimCreditAccountId').html(accountOptions);
            $('#LoanProtectionDebitAccountId').html(accountOptions);
            $('#LoanProtectionCreditAccountId').html(accountOptions);

            if ($.fn.select2) {
                $('.select2-account').trigger('change.select2');
            }
        }

        function clearAccountDropdowns() {
            var emptyOption = '<option value="">--- Select Account ---</option>';

            $('#LifeSavingsClaimDebitAccountId').html(emptyOption);
            $('#LifeSavingsClaimCreditAccountId').html(emptyOption);
            $('#LoanProtectionDebitAccountId').html(emptyOption);
            $('#LoanProtectionCreditAccountId').html(emptyOption);

            if ($.fn.select2) {
                $('.select2-account').trigger('change.select2');
            }
        }

        function showLoadingAccounts() {
            var loadingOption = '<option value="" disabled>Loading accounts...</option>';

            $('#LifeSavingsClaimDebitAccountId').html(loadingOption);
            $('#LifeSavingsClaimCreditAccountId').html(loadingOption);
            $('#LoanProtectionDebitAccountId').html(loadingOption);
            $('#LoanProtectionCreditAccountId').html(loadingOption);

            if ($.fn.select2) {
                $('.select2-account').trigger('change.select2');
            }
        }

        // ---------- Form Submission ----------
        window.__IPSConfigSubmitAjaxFull = function (form) {
            try { $.validator.unobtrusive.parse(form); } catch (e) {}
            var $form = $(form);
            if ($form.length && !$form.valid()) return false;

            var token = getAntiForgeryToken();
            var $submit = $form.find('[type="submit"]').first();
            var origHtml = $submit.data('orig-html') || $submit.html();
            $submit.data('orig-html', origHtml);
            $submit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');

            var doAjax = function () {
                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    dataType: 'text',
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    success: function (raw) {
                        var res = normalizeResponse(raw);
                        if (res && res.success) {
                            var lvl = 1;
                            if (res.status === 'Exist') lvl = 3;
                            if (res.status === 'Failed') lvl = 2;
                            showMsg(res.message || 'Operation successful', lvl);

                            if (res.reloadDataView === "Yes" || res.reload === true) {
                                LoadDataGen('IPSConfig', 'IPSDataTable', '_IPSConfigDataTable', 0, 'datalistingview', null, 'list');
                            }
                        } else {
                            var lvl = (res && res.status === 'Exist') ? 3 : 2;
                            showMsg((res && res.message) ? res.message : 'Operation failed', lvl);
                        }
                    },
                    error: function (xhr) {
                        var parsed = normalizeResponse(xhr.responseText);
                        if (parsed && parsed.message) showMsg(parsed.message, parsed.success ? 1 : 2);
                        else if (xhr.status === 401) window.location.href = '/Authentication/Login';
                        else {
                            showMsg(xhr.statusText || 'Network error', 4);
                            console.error('IPSConfigSubmitAjax error', xhr.status, xhr.responseText);
                        }
                    },
                    complete: function () {
                        $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                    }
                });
            };

            if (window.alertify && typeof alertify.confirm === 'function') {
                try {
                    alertify.confirm("Confirmation", "Are you sure you want to save this IPS Configuration?", function () { doAjax(); }, function () { showMsg('Transaction cancelled', 3); }).set('labels', { ok: 'Yes', cancel: 'No' });
                } catch (e) { if (confirm('Are you sure?')) doAjax(); else showMsg('Cancelled', 3); }
            } else {
                if (confirm('Are you sure you want to save this IPS Configuration?')) doAjax(); else showMsg('Transaction cancelled', 3);
            }

            return false;
        };

        window.IPSConfigSubmitAjax = window.__IPSConfigSubmitAjaxFull;

        // ---------- Event Handlers ----------
        $(document).on('submit', 'form[action*="CreateOrUpdate"][action*="IPSConfig"]', function (e) {
            e.preventDefault();
            return window.IPSConfigSubmitAjax(this);
        });

        // Branch change handler for account loading
        $(document).on('change', '#BranchId', function () {
            loadBranchAccounts();
        });

        // Initialize Select2 on page load
        $(document).ready(function () {
            if ($.fn.select2) {
                // Initialize branch dropdown
                $('#BranchId').select2({
                    width: '100%',
                    placeholder: '--- Select Branch ---'
                });

                // Initialize account dropdowns
                $('.select2-account').select2({
                    width: '100%',
                    placeholder: '--- Select Account ---'
                });
            }

            // Load accounts if branch is already selected (edit mode)
            if ($('#BranchId').val()) {
                loadBranchAccounts();
            }

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        function confirmAndDeleteIPSConfig(configId, year) {
            alertify.confirm('Confirm Deletion', `Are you sure you want to delete the IPS Configuration for year ${year}?`,
                function() {
                    const token = getAntiForgeryToken();
                    $.ajax({
                        url: '@Url.Action("Delete", "IPSConfig")',
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token,
                            KEY: configId
                        },
                        success: function (response) {
                            if (response.success) {
                                appalert(response.message, 1, 1);
                                LoadDataGen('IPSConfig', 'IPSDataTable', '_IPSConfigDataTable', 0, 'datalistingview', null, 'list');
                            } else {
                                appalert(response.message, 4, 1);
                            }
                        },
                        error: function(xhr) {
                            var parsed = normalizeResponse(xhr.responseText);
                            if (parsed && parsed.message) appalert(parsed.message, 4, 1);
                            else appalert("An error occurred during deletion.", 4, 1);
                        }
                    });
                },
                function() {
                    appalert("Delete operation cancelled.", 3, 1);
                }
            );
        }

        // ---------- Global Helper Functions ----------
        function reloadListing(response) {
            try {
                if (typeof LoadDataGen === 'function') {
                    LoadDataGen(response.controller || response.controllerName || 'IPSConfig',
                                response.datatable || response.tableName || 'IPSDataTable',
                                response.PartialView || response.dataLoaderActionName || '_IPSConfigDataTable',
                                0,
                                response.div || response.divLoaderList || 'datalistingview',
                                null,
                                response.path || 'list');
                    return;
                }
            } catch (e) {
                console.warn('LoadDataGen call failed', e);
            }

            location.reload();
        }

    })(jQuery);
    </script>
}