@model CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller
    @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalDailyTellerAssignation.SetTellersForTheDay</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "DailyTellerAssignation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {

            @Html.HiddenFor(model => model.Id)
           
        <div class="row mt-2 gy-4">
            @if (ViewBag.Key != null)
            {
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ GlobalShared.SelectBranch+ "---", new { @class = "form-control select2", @disabled = "disabled" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Branch</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.TellerId, new SelectList(ViewBag.Tellers, "Value", "Text"), "---"+ @GlobalDailyTellerAssignation.SelectTeller+ "---", new { @class = "form-control select2", @search = "true", @disabled = "disabled" })
                        @Html.ValidationMessageFor(m => m.TellerId, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Teller</label>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ GlobalShared.SelectBranch+ "---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Branch</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.TellerId, new SelectList(ViewBag.Tellers, "Value", "Text"), "---"+ @GlobalDailyTellerAssignation.SelectTeller +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.TellerId, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Teller</label>
                    </div>
                </div>

            }
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.UserId, new SelectList(ViewBag.Users, "Value", "Text"), "---" + GlobalShared.Select_User + "---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.UserId, "", new { @class = "text-danger" })
                    <label>@GlobalShared.User</label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.Status, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActive">@GlobalDailyTellerAssignation.CheckToKeepActive</label>
                </div>
            </div>
            @*<div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.MaximumWithdrawalAmount, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaximumWithdrawalAmount, "", new { @class = "text-danger" })
                <label>Maximum daily withdrawal</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.MaximumCeilin, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaximumCeilin, "", new { @class = "text-danger" })
                <label>Maximum daily cash to hold</label>
            </div>
        </div>*@


        </div>
        <div class="mt-4">
            @if (ViewBag.Key != null)
            {
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>

            }
            else
            {
        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
        <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>

            }
            <a type="button" href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" onclick="LoadTellerrsAssigned()" data-bs-toggle="tooltip" title="@GlobalDailyTellerAssignation.ViewAssignedTellers">
                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
            </a>
        </div>

        }
    </div>
</fieldset>