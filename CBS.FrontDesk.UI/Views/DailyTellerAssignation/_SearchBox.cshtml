@model CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller

<fieldset class="fieldset-custom">
    <legend>Filter Tellers in Operation</legend>
    <hr />
    <div class="row g-4">
        <div class="col-md-12">
            <label for="branchInput" class="form-label">Select Branch to view assigned tellers</label>
            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---Select Branch to load tellers assigned---",
 new { @class = "form-control select2", @id = "branchInput", onchange = "LoadTellerrsAssigned()" })
        </div>
    </div>
</fieldset>


