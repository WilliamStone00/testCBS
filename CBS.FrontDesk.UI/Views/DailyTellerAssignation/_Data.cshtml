@model List<CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller>

<fieldset class="fieldset-custom">
    <legend id="select_base">Daily teller data set</legend>
    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>No daily teller is set</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Branch</th>
                        <th>Teller</th>
                        <th>Status</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:20%">@d.UserName</td>
                            <td style="width:25%">@d.Branch.Name</td>
                            <td style="width:25%">@d.Teller.name</td>
                            <td style="width:10%">
                                @if (d.Status)
                                {
                                    <span class="badge bg-info">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">In-Active</span>
                                }
                            </td>
                            <td style="width:10%">
                                @if (d.IsPrimary)
                                {
                                    <span class="badge bg-info">Primary-T</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Sub-T</span>
                                }
                            </td>
                            <td style="width:10%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','DailyTellerAssignation',null,'@d.Id')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Teller.name to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Teller.name" onclick="DeleteRecordDataTable('DailyTellerAssignation','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
