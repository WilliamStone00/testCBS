@model List<CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller>

<fieldset class="fieldset-custom">
    <legend id="select_base">Daily Teller Data Set</legend>

    <!-- Button aligned to the right -->
    <div class="d-flex justify-content-end mb-2">
        <a type="button" href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" onclick="LoadTellerrsAssigned()" data-bs-toggle="tooltip" title="View Assigned Tellers">
            <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center my-3">
            <p>No daily teller is set</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Users</th>
                        <th>Branch</th>
                        <th>Tills</th>
                        <th>Status</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:28%">@d.UserName</td>
                            <td style="width:25%">@d.Branch.Name</td>
                            <td style="width:25%">@d.Teller.name</td>
                            <td style="width:5%">
                                @if (d.Status)
                                {
                                    <span class="badge bg-info">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td style="width:10%">
                                @if (d.IsPrimary)
                                {
                                    <span class="badge bg-info">Primary-T</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Sub-T</span>
                                }
                            </td>
                            <td style="width:7%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','DailyTellerAssignation',null,'@d.Id')" class="mr-2" data-bs-toggle="tooltip" title="Reassign @d.Teller.name">Reassign</a>
                                <!-- Uncomment if needed -->
                                <!-- <a href="#" class="mr-2" data-bs-toggle="tooltip" title="Delete @d.Teller.name" onclick="DeleteAssignedTeller('DailyTellerAssignation','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a> -->
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
