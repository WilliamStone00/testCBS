@model CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller
@using Resources

<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalDailyTellerAssignation.TillsF5Operations</legend>
    <div class="card-body">
        @using (Html.BeginForm("DownloadTellerOperationsToExcel", "DailyTellerAssignation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdatePrintTillOperations(this);" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <!-- PDF Option -->
            <div class="col-12 mb-2">
                <legend id="select_base">@GlobalDailyTellerAssignation.EXPORTOPTIONS</legend>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsPDF, new { @class = "form-check-input", @id = "isPDF", @checked = "checked" })
                    <label class="form-check-label" for="isPDF">@GlobalDailyTellerAssignation.CheckToPrintInPDF</label>
                </div>
            </div>
            <hr />

            <!-- Operation Type Section -->
            <div class="col-12 mb-2">
                <legend id="select_base">@GlobalDailyTellerAssignation.OPERATIONTYPES</legend>
                <div class="d-flex mb-3">
                    <div class="form-check me-3">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "CashOperations", new { @class = "form-check-input", @id = "cashOperations", @checked = "checked" })
                        <label class="form-check-label" for="cashOperations">@GlobalDailyTellerAssignation.CashOperations</label>
                    </div>
                    <div class="form-check me-3">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "NoneCashOperations", new { @class = "form-check-input", @id = "noneCashOperation" })
                        <label class="form-check-label" for="noneCashOperation">@GlobalDailyTellerAssignation.NoneCashOperation</label>
                    </div>
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "All", new { @class = "form-check-input", @id = "all" })
                        <label class="form-check-label" for="all">@GlobalDailyTellerAssignation.Both</label>
                    </div>
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.BranchId, "", new { @class = "text-danger" })

                </div>
            </div>
            <hr />
            <legend id="select_base">@GlobalDailyTellerAssignation.EXPORTFILTER</legend>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByBranch, new { @class = "form-check-input", @id = "byBranchCheckbox", @disabled = "disabled", @checked = "checked" })
                        <label class="form-check-label" for="byBranchCheckbox">@GlobalShared.FilterByBranch</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByTeller, new { @class = "form-check-input", @id = "byTellerCheckbox", @checked = "checked", @disabled = "disabled" })
                        <label class="form-check-label" for="byTellerCheckbox">@GlobalDailyTellerAssignation.FilterByTill</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByDate, new { @class = "form-check-input", @id = "byDateCheckbox", @disabled = "disabled", @checked = "checked" })
                        <label class="form-check-label" for="byDateCheckbox">@GlobalShared.FilteredByDate</label>
                    </div>
                </div>

            </div>
            <hr />

            <div class="row g-4">
                <div class="col-md-12" id="branchDiv">
                    <label for="branchInput">@GlobalShared.Branch</label>
                    @Html.DropDownListFor(m => m.GetAllTellerOperationsQuery.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ GlobalShared.SelectBranch+"---", new { @class = "form-control shadow-box select2", @id = "branchInput", @onchange = "LoadTilles(this.value)" })
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.BranchId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-12" id="tellerDiv">
                    <label for="tellerInput">Select a till</label>
                    @Html.DropDownListFor(m => m.GetAllTellerOperationsQuery.TellerId, new SelectList(ViewBag.Tellers, "Value", "Text"), "---"+ @GlobalDailyTellerAssignation.SelectTeller+"---", new { @class = "form-control shadow-box select2", @id = "tellerInput" })
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.TellerId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-12">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="dateFromInput">@GlobalShared.DateFrom</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.GetAllTellerOperationsQuery.DateFrom, new { @class = "form-control shadow-box date-picker", @id = "dateFromInput", @placeholder = GlobalShared.DateFrom })
                            </div>
                            @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.DateFrom, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="dateToInput">@GlobalShared.DateTo</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.GetAllTellerOperationsQuery.DateTo, new { @class = "form-control shadow-box date-picker", @id = "dateToInput", @placeholder = GlobalShared.DateTo })
                            </div>
                            @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.DateTo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-print me-2"></i> @GlobalShared.Print
                </button>
            </div>
        }
    </div>
</fieldset>

