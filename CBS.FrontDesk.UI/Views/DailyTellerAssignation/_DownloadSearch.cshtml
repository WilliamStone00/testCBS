@model CBS.FrontDesk.Data.Entity.SavingProducts.DailyTeller


<fieldset class="fieldset-custom">
    <legend id="select_base">Tills F5 Operations</legend>
    <div class="card-body">
        @using (Html.BeginForm("DownloadTellerOperationsToExcel", "DailyTellerAssignation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdatePrintTillOperations(this);" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <!-- PDF Option -->
            <div class="col-12 mb-2">
                <legend id="select_base">EXPORT OPTIONS</legend>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsPDF, new { @class = "form-check-input", @id = "isPDF", @checked = "checked" })
                    <label class="form-check-label" for="isPDF">Check to print in PDF</label>
                </div>
            </div>
            <hr />

            <!-- Operation Type Section -->
            <div class="col-12 mb-2">
                <legend id="select_base">OPERATION TYPES</legend>
                <div class="d-flex mb-3">
                    <div class="form-check me-3">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "CashOperations", new { @class = "form-check-input", @id = "cashOperations", @checked = "checked" })
                        <label class="form-check-label" for="cashOperations">Cash Operations</label>
                    </div>
                    <div class="form-check me-3">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "NoneCashOperations", new { @class = "form-check-input", @id = "noneCashOperation" })
                        <label class="form-check-label" for="noneCashOperation">None Cash Operation</label>
                    </div>
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.GetAllTellerOperationsQuery.QueryString, "All", new { @class = "form-check-input", @id = "all" })
                        <label class="form-check-label" for="all">Both</label>
                    </div>
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.BranchId, "", new { @class = "text-danger" })

                </div>
            </div>
            <hr />
            <legend id="select_base">EXPORT FILTER</legend>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByBranch, new { @class = "form-check-input", @id = "byBranchCheckbox", @disabled = "disabled", @checked = "checked" })
                        <label class="form-check-label" for="byBranchCheckbox">Filter by branch</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByTeller, new { @class = "form-check-input", @id = "byTellerCheckbox", @checked = "checked", @disabled = "disabled" })
                        <label class="form-check-label" for="byTellerCheckbox">Filter by Till</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GetAllTellerOperationsQuery.IsByDate, new { @class = "form-check-input", @id = "byDateCheckbox", @disabled = "disabled", @checked = "checked" })
                        <label class="form-check-label" for="byDateCheckbox">Filtered by date</label>
                    </div>
                </div>

            </div>
            <hr />

            <div class="row g-4">
                <div class="col-md-12" id="branchDiv">
                    <label for="branchInput">Branch</label>
                    @Html.DropDownListFor(m => m.GetAllTellerOperationsQuery.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---Select Branch---", new { @class = "form-control shadow-box select2", @id = "branchInput", @onchange = "LoadTilles(this.value)" })
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.BranchId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-12" id="tellerDiv">
                    <label for="tellerInput">Select a till</label>
                    @Html.DropDownListFor(m => m.GetAllTellerOperationsQuery.TellerId, new SelectList(ViewBag.Tellers, "Value", "Text"), "---Select till---", new { @class = "form-control shadow-box select2", @id = "tellerInput" })
                    @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.TellerId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-12">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="dateFromInput">Date From</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.GetAllTellerOperationsQuery.DateFrom, new { @class = "form-control shadow-box date-picker", @id = "dateFromInput", @placeholder = "Date From" })
                            </div>
                            @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.DateFrom, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="dateToInput">Date To</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.GetAllTellerOperationsQuery.DateTo, new { @class = "form-control shadow-box date-picker", @id = "dateToInput", @placeholder = "Date To" })
                            </div>
                            @Html.ValidationMessageFor(m => m.GetAllTellerOperationsQuery.DateTo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-print me-2"></i> Print
                </button>
            </div>
        }
    </div>
</fieldset>

