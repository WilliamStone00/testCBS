@model CBS.FrontDesk.Data.Entity.Accounting.AccountingRuleEntry
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Update", "AccountingRuleEntry", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.AccountingRuleId, new SelectList((ViewBag.AccountingRules == null) ? "" : ViewBag.AccountingRules, "Id", "Value"), "---" + @GlobalAccountingEntryRule.SelectAccountingRule + "---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.AccountingRuleId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountingEntryRule.AccountingRule</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountingRuleEntryName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountingRuleEntryName, "", new { @class = "text-danger" })
                    <label>@GlobalAccountingEntryRule.RuleEntryName</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.BookingDirection, new SelectList(ViewBag.BookingDirections, "Text", "Value"), "---"+ @GlobalAccountingEntryRule.SelectBookingDirection + "---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.BookingDirection, "", new { @class = "text-danger " })
                    <label>@GlobalAccountingEntryRule.BookingDirection</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.OperationEventAttributeId, new SelectList((ViewBag.OperationEventAttributes == null) ? "" : ViewBag.OperationEventAttributes, "Id", "Name"), "---"+ @GlobalAccountingEntryRule.SelectOperationEventAttribute + "---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.OperationEventAttributeId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountingEntryRule.OperationEventAttribute</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.CreditAccountId, new SelectList((ViewBag.CreditAccounts == null) ? "" : ViewBag.CreditAccounts, "Text", "Value"), "---"+@GlobalAccountingEntryRule.SelectAccount+"---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.CreditAccountId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountingEntryRule.CreditAccount</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.DebitAccountId, new SelectList((ViewBag.DebitAccounts == null) ? "" : ViewBag.DebitAccounts, "Text", "Value"), "---"+ @GlobalAccountingEntryRule.SelectAccount + "---", new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.DebitAccountId, "", new { @class = "text-danger " })
                    <label>@GlobalAccountingEntryRule.DebitAccount</label>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
            
        </div>

    }
</div>