@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanProductCategory>
<fieldset class="fieldset-custom">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:15%">@d.Name</td>
                    <td style="width:75%">@d.Description</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Update','update','LoanProductCategory')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('LoanProductCategory','@d.Id','myDataTable','_Data',0,'datalistingview',null,'list')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</fieldset>
