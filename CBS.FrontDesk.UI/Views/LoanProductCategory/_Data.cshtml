@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanProductCategory>
    @using Resources
<fieldset class="fieldset-custom">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.Name</th>
                <th>@GlobalShared.Description</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:15%">@d.Name</td>
                    <td style="width:75%">@d.Description</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_Update','update','LoanProductCategory')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('LoanProductCategory','@d.Id','myDataTable','_Data',0,'datalistingview',null,'list')">@GlobalShared.Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</fieldset>
