@model CBS.FrontDesk.Data.UserManagement.MFAActivation
    @using Resources
@{
    ViewBag.Title = "TOTP Account Verification";
    Layout = "~/Views/Shared/_MfaLayout.cshtml";
}

<div class="mfa-form-box">
    <div class="text-center mb-4">
        <img src="~/AppFiles/Images/Logog2XI.png" alt="Logo" class="logo mb-3" style="max-height: 60px;" />
        <h5 class="text-primary fw-bold">@GlobalMFAVerification.totp_timebased_onetime_password</h5>
        <p class="text-muted">@GlobalShared.hello <strong>@Model.FullName</strong>, @GlobalMFAVerification.please_enter_your_current_code_to_continue.</p>
    </div>

    @using (Html.BeginForm("MFACodeVerification", "MFAVerification", FormMethod.Post, new
    {
        enctype = "multipart/form-data",
        onsubmit = "return AjaxPostAndUpdateChangePassword(this);"
    }))
    {
        <fieldset class="border-0">
            @Html.HiddenFor(m => m.Email)
            @Html.HiddenFor(m => m.ReturnUrl)

            <div class="form-floating mb-3">
                @Html.TextBoxFor(m => m.Code, new
                {
                    @class = "form-control",
                    @placeholder = "Enter TOTP Code",
                    @autocomplete = "off"
                })
                <label for="Code">@GlobalMFAVerification.enter_totp_code</label>
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary w-100">@GlobalMFAVerification.verify_code</button>

            <a href="~/Authentication/Logout" class="btn btn-outline-secondary w-100 mt-2">@GlobalMFAVerification.cancel_return_to_login</a>
        </fieldset>
    }

    @Html.Partial("_Alert")

    <div class="alert alert-info mt-4">
        <strong>@GlobalMFAVerification.how_to_use_totp:</strong>
        <ul class="mb-0">
            <li>@Html.Raw(@GlobalMFAVerification.open_the_google_authenticator_or_microsoft_authenticator_app_on_your_phone).</li>
            <li>@GlobalMFAVerification.find_the_6digit_code_associated_with_your_tsc_account_it_refreshes_every_30_seconds.</li>
            <li>@Html.Raw(@GlobalMFAVerification.type_the_current_code_above_and_click_verify_code).</li>
        </ul>
    </div>

    @if (ViewBag.Success == false)
    {
        <div class="alert alert-outline-danger mt-3">
            @ViewBag.Message
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function AjaxPostAndUpdateChangePassword(form) {
            $.validator.unobtrusive.parse(form);
            if ($(form).valid()) {
                var ajaxConfig = {
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message, 1, 1);
                            window.location.href = response.url || '/';
                        } else {
                            if (response.state === "Exist") {
                                appalert(response.message, 3, 1);
                            } else if (response.state === "Expired") {
                                appalert(response.message, 2, 1);
                                window.location.href = response.url || '/Authentication/Logout';
                            } else {
                                appalert(response.message, 2, 1);
                            }
                        }
                    },
                    error: function (err) {
                        appalert(err.statusText, 0, 1);
                    },
                    contentType: false,
                    processData: false
                };
                $.ajax(ajaxConfig);
            }
            return false;
        }
    </script>
}
