@model CBS.FrontDesk.Data.UserManagement.MFAActivation
@{
    Layout = "~/Views/Shared/_LoginMainCover.cshtml";
    ViewBag.Title = "Two Step Account Verification";
}

<style>
    /*.authentication-inner {
        display: flex;
        flex-wrap: wrap;
    }

    .authentication-image {
        width: 100%;
        max-width: 100%;
        height: auto;
    }

    .authentication-bg {
        background-color: #f8f9fa;*/ /* Choose your desired background color */
    /*border-radius: 10px;
    }*/

    .authentication-text {
        color: #007bff; /* Choose your desired text color */
    }

    .trustbank-text {
        font-size: 24px;
    }

    .form-container {
        padding: 20px;
    }

    .form-floating {
        position: relative;
    }

        .form-floating input,
        .form-floating label {
            width: 100%;
        }

    .form-password-toggle {
        position: relative;
    }

        .form-password-toggle input {
            padding-right: 40px;
        }

    .input-group-text {
        cursor: pointer;
    }

    .form-check-input {
        margin-right: 5px;
    }

    .forgot-password-link {
        text-decoration: none;
        color: #6c757d; /* Choose your desired link color */
    }

    .login-policy {
        margin-top: 20px;
    }

        .login-policy hr {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .login-policy label {
            display: block;
        }

    .alert {
        margin-top: 20px;
    }
</style>

<div class="authentication-inner row m-0">
    <!-- Left Section -->
    <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center">
        <img src="~/AppFiles/Images/Logog2X.JPEG" class="authentication-image" alt="mask" />
    </div>
    <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg position-relative">
        <div class="w-px-400 mx-auto pt-5 pt-lg-0 form-container">
            <div class="image-container">
                <img src="~/AppFiles/Images/Logog2XI.png" />
            </div>
            <hr />
            <h5 class="mb-2 trustbank-text" style="display: inline-block; font-size: 1rem;">
                MFA Verification
                <span class="authentication-text" style="display: inline-block;">, @Model.FullName</span>
            </h5>
            <hr />

            @using (Html.BeginForm("MFACodeVerification", "MFAVerification", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateChangePassword(this);" }))
            {
                @Html.HiddenFor(m => m.Email)
                @Html.HiddenFor(m => m.ReturnUrl)
                <!-- MFA Code Input -->
                <!-- MFA Code Input -->
                <div class="form-floating form-floating-outline mb-3">
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control", @placeholder = "Enter MFA Code", @autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    <label for="Code">MFA Code</label>
                </div>

                <button class="btn btn-primary d-grid w-100">Submit</button>
            }

            @Html.Partial("_Alert")

            <!-- Validation Notice -->
            <div class="alert alert-info mt-3" role="alert">
                <strong>How to Validate the MFA Code:</strong>
                <ol>
                    <li>Open the Google Authenticator app on your phone.</li>
                    <li>Locate the code associated with your account. This code refreshes every 30 seconds.</li>
                    <li>Enter the current code displayed in the app into the "MFA Code" input box above.</li>
                    <li>If the code is correct, you will be redirected or receive confirmation. If not, check the code on your app and try again.</li>
                </ol>
            </div>

            <!-- Error Message -->
            @if (ViewBag.Success == false)
            {
                <div class="alert alert-outline-danger mt-3" role="alert">
                    @ViewBag.Message
                </div>
            }
        </div>
    </div>
    <!-- /Login Section -->
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function AjaxPostAndUpdateChangePassword(form) {
            $.validator.unobtrusive.parse(form);
            if ($(form).valid()) {
                var ajaxConfig = {
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    success: function (response) {
                        if (response.success) {
                            appalert(response.message, 1, 1);
                            // Redirect based on the URL provided by the server
                            window.location.href = response.url || '/'; // Default to home if no URL provided
                        } else {
                            if (response.state === "Exist") {
                                appalert(response.message, 3, 1);
                            } else if (response.state === "Expired") {
                                appalert(response.message, 2, 1);
                                window.location.href = response.url || '/Authentication/Logout'; // Default to logout if no URL provided
                            } else {
                                appalert(response.message, 2, 1);
                            }
                        }
                    },
                    error: function (err) {
                        appalert(err.statusText, 0, 1);
                    }
                };

                if ($(form).attr('enctype') === "multipart/form-data") {
                    ajaxConfig["contentType"] = false;
                    ajaxConfig["processData"] = false;
                }
                $.ajax(ajaxConfig);
            }
            return false;
        }
    </script>
}