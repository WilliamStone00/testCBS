@model CBS.API.Helper.SessionAuth

@{
    Layout = "~/Views/Shared/_LoginMainCover.cshtml";
    ViewBag.Title = "T R U S T S O F T C R E D I T - Session Recovery";
}

<style>
    body {
        background-image: url('@Url.Content("~/AppFiles/Images/NBG_.jpeg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        margin: 0;
        padding: 0;
        height: 100vh;
        width: 100vw;
        font-family: Arial, sans-serif;
    }

    .authentication-inner {
        display: flex;
        align-items: center;
        width: 100%;
        height: 100%;
        padding-top: 50px;
    }

    .authentication-bg {
        background-color: rgba(255, 255, 255, 0.9);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 500px;
    }

    .styled-hr {
        border: 0;
        height: 4px;
        background: linear-gradient(to right, deepskyblue, limegreen);
        margin: 20px 0;
    }

    .trust-soft { color: deepskyblue; font-weight: bold; }
    .credit { color: limegreen; font-weight: bold; }
</style>

<div class="authentication-inner row">
    <div class="col-lg-8 d-none d-lg-block"></div>

    <div class="col-12 col-lg-4 col-xl-4 authentication-bg position-relative">
        <div class="w-100 mx-auto p-3 pt-5 pt-lg-0 form-container">
            <div class="image-container text-center mb-4">
                <img src="~/AppFiles/Images/Logog2XI.png" class="img-fluid" alt="Logo" />
            </div>

            <hr class="styled-hr" />
            <h5 class="trustbank-text mb-1">
                <span class="trust-soft">T R U S T S O F T</span>
                <span class="credit">C R E D I T</span>
            </h5>
            <small class="d-block mt-0"><i>Session Lock: Enter Recovery Code</i></small>
            <hr class="styled-hr" />

            <div class="alert alert-danger shadow-sm">
                <i class="mdi mdi-lock-outline me-2"></i>
                <strong>Your session was locked due to inactivity.</strong>
                <p class="mt-2 mb-0">Please enter your session recovery code to continue.</p>
            </div>

            <form id="recoveryForm" method="post">
                @Html.HiddenFor(m => m.UserName)

                <div class="form-floating form-floating-outline mb-3">
                    @Html.TextBoxFor(m => m.SessionRecoveryCode, new
                    {
                        @class = "form-control",
                        @id = "recoveryCodeInput",
                        placeholder = "Enter Your Session Recovery Code",
                        required = "required"
                    })
                    <label for="SessionRecoveryCode">Recovery Code</label>
                    <div id="recoveryFeedback" class="mt-1 text-danger small"></div>
                </div>

                <button type="submit" class="btn btn-success d-grid w-100 mb-3">
                    Recover My Session
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="@Url.Action("Login", "Authentication")" class="btn btn-outline-danger w-100">
                    <i class="fas fa-arrow-left me-1"></i> Return to Login Page
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("recoveryForm");
            const input = document.getElementById("recoveryCodeInput");
            const feedback = document.getElementById("recoveryFeedback");

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const code = input.value.trim();
                if (!code) {
                    feedback.textContent = "Recovery code is required.";
                    return;
                }

                fetch('/Session/ValidateRecoveryCode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ recoveryCode: code })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = '/Home/Index';
                        } else {
                            feedback.textContent = data.message || "Invalid recovery code.";

                            // ✅ If the server said redirect, go to logout
                            if (data.redirect) {
                                setTimeout(() => {
                                    window.location.href = '/Authentication/Logout';
                                }, 2000);
                            }
                        }
                    })
                    .catch(() => {
                        feedback.textContent = "Error validating session.";
                    });
            });

            // 🔒 Lock back/forward browser navigation
            history.pushState(null, null, location.href);
            window.onpopstate = function () {
                history.pushState(null, null, location.href);
            };
        });
    </script>
}
