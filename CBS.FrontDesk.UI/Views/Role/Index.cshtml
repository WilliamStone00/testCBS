
@using Resources
@{
    ViewBag.Title = "Role";
}
<div class="row justify-content-end">
    <div class="demo-inline-spacing text-end">
        <a type="button" onclick="LoadDataGen('Role','myDataTable','_Data',0,'datalistingview',null,null,'list')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
            <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','Role')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.AddNew">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
</div>
<br />
<div class="card">
    <div class="card-body">
        <div id="datalistingview">
            @Html.Partial("_Create")
        </div>
    </div>
</div>






@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


