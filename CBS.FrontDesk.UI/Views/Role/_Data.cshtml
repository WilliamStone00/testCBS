@model CBS.FrontDesk.Data.Entity.RolePermissionManagement
    @using Resources
<fieldset class="fieldset-custom">

    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>@GlobalShared.Name</th>
                <th>@GlobalShared.Description</th>
                <th>@GlobalShared.Teller?</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Roles)
            {
                <tr>
                    <td style="width:15%">@d.Name</td>
                    <td style="width:50%">@d.Description</td>
                    <td style="width:10%">
                        @if (@d.IsTeller)
                        {
                            <label>@GlobalShared.Yes</label>
                        }
                        else
                        {
                            <label>@GlobalShared.No</label>
                        }
                    </td>
                    <td style="width:25%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','Role')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a>|
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('Role','@d.Id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>|
                        <a href="#" onclick="LoadDataGen('Role','myDataTable','_RolePermissionData',0,'datalistingview','@d.Id','view_role_permission')" target="_parent" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalRole.view_permissions</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    </fieldset>