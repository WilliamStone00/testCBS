@model CBS.FrontDesk.Data.Entity.RolePermissionManagement
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "Role", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<fieldset class="fieldset-custom">

            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Role.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Role.Name, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Name</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.Role.Description, new { @class = "form-control", @style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.Role.Description, "", new { @class = "text-danger" })
                        <label>@GlobalShared.Description</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Role.IsTeller, new { @class = "form-check-input" })
                        <label class="form-check-label">Is this role teller?</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            </div>
        </fieldset>
    }
</div>