@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMapping.LiaisonMappingModel

@using Resources

@using (Html.BeginForm("CreateOrUpdate", "LiaisonMapping", FormMethod.Post, new { id = "liaisonMappingForm", onsubmit = "return submitLiaisonMappingForm(this);" }))
{
    @Html.HiddenFor(m => m.Id)

    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.BranchId, "Source Branch", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Source Branch ---", new { @class = "form-select", required = "required" })
            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.CounterpartyBranchId, "Counterparty Branch", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.CounterpartyBranchId, new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Counterparty Branch ---", new { @class = "form-select", required = "required" })
            @Html.ValidationMessageFor(m => m.CounterpartyBranchId, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.DueFromAssetAccountId, "Due From Account (Asset)", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.DueFromAssetAccountId, new SelectList(ViewBag.DueFromAssetAccount, "Id", "Name"),
                "--- Select Due From Account ---", new { @class = "form-select", required = "required" })
            @Html.ValidationMessageFor(m => m.DueFromAssetAccountId, "", new { @class = "text-danger small" })
            <small class="form-text text-muted">Asset account for tracking amounts due from counterparty branch</small>
        </div>

        
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.DueToLiabilityAccountId, "Due To Account (Liability)", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.DueToLiabilityAccountId, new SelectList(ViewBag.DueToLiability, "Id", "Name"),
                "--- Select Due To Account ---", new { @class = "form-select", required = "required" })
            @Html.ValidationMessageFor(m => m.DueToLiabilityAccountId, "", new { @class = "text-danger small" })
            <small class="form-text text-muted">Liability account for tracking amounts due to counterparty branch</small>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i>Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="mdi mdi-content-save-check me-1"></i>
                    @(string.IsNullOrEmpty(Model.Id) ? "Create Mapping" : "Update Mapping")
                </button>
            </div>
        </div>
    </div>
}