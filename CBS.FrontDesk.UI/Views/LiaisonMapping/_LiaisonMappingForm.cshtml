@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMappingV2.LiaisonMapping
@using Resources

@using (Html.BeginForm("CreateOrUpdate", "LiaisonMapping", FormMethod.Post, new { id = "liaisonMappingForm", onsubmit = "return submitLiaisonMappingForm(this);" }))
{
    @Html.HiddenFor(m => m.Id)

    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.BranchId, ""+ GlobalShared.Source_branch +"", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(
                m => m.BranchId, 
                new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Source Branch ---", 
                new { @class = "form-select select2", required = "required", id = "BranchId", @onchange = "LoadBranchAccounts(this.value, 'BranchAccountId')" })
            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.CounterpartyBranchId, ""+ GlobalShared.Counterparty_Branch + "", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.CounterpartyBranchId, new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Counterparty Branch ---", new { @class = "form-select select2", required = "required" })
            @Html.ValidationMessageFor(m => m.CounterpartyBranchId, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.DueFromAssetAccountId, ""+ GlobalShared.Due_From_Account +" "+(GlobalShared.Asset)+"", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.DueFromAssetAccountId, new SelectList(ViewBag.Accounts, "Id", "Name"),
                "--- Select Due From Account ---", new { @class = "form-select select2", required = "required" })
            @Html.ValidationMessageFor(m => m.DueFromAssetAccountId, "", new { @class = "text-danger small" })
            <small class="form-text text-muted">@GlobalLiaisonMapping.Asset_account_for_tracking_amounts_due_from_counterparty_branch</small>
        </div>

        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.DueToLiabilityAccountId, ""+ GlobalShared.Due_To_Account + " "+(GlobalShared.Liability)+"", new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.DueToLiabilityAccountId, new SelectList(ViewBag.Accounts, "Id", "Name"),
                "--- Select Due To Account ---", new { @class = "form-select select2", required = "required" })
            @Html.ValidationMessageFor(m => m.DueToLiabilityAccountId, "", new { @class = "text-danger small" })
            <small class="form-text text-muted">@GlobalLiaisonMapping.Liability_account_for_tracking_amounts_due_to_counterparty_branch</small>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close me-1"></i>@GlobalShared.Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="mdi mdi-content-save-check me-1"></i>
                    @(string.IsNullOrEmpty(Model.Id) ? "Create Mapping" : "Update Mapping")
                </button>
            </div>
        </div>
    </div>
}
