@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMappingV2.LiaisonMapping

@using Resources

<div class="card shadow-sm p-3">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalShared.Liaison_Mappings</h5>
    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width : 20%">@GlobalShared.Source_branch</th>
                    <th style="width : 20%">@GlobalShared.Counterparty_Branch</th>
                    <th style="width : 20%">@GlobalShared.Due_From_Account</th>
                    <th style="width : 20%">@GlobalShared.Due_To_Account</th>
                    <th style="width : 20%">@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded dynamically -->
            </tbody>
        </table>
    </div>
</div>