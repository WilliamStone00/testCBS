                $.get(url)
                    .done(function (html) {
                        $('#liaisonMappingFormContainer').html(html);
                        initializeLiaisonForm(); // wire modal events + select2
                        $('#liaisonMappingModal').modal('show');
                    })
                    .fail(function () {
                        appAlertError("Failed to load form. Please try again.");
                    })
                    .always(function () {
                        $('#liaisonMappingLoader').addClass('d-none');
                    });
            };

            function initializeLiaisonForm() {
                // initialize select2 inside modal
                $('.select2').select2({
                    dropdownParent: $('#liaisonMappingModal'),
                    width: '100%',
                    allowClear: true,
                    placeholder: '--- Select ---'
                });

                // wire modal branch change to load its counterparty and accounts
                $(modal.source).off('change.modal').on('change.modal', function () {
                    const branchId = $(this).val();
                    loadCounterpartyBranches(branchId, modal.counterparty);
                    loadAccountsForBranch(branchId, modal.dueFrom, modal.dueTo);
                });

                // If modal loaded with an initial branch value (edit mode), load dependents
                const initialBranchId = $(modal.source).val();
                if (initialBranchId) {
                    // If server supplied a selected counterparty via the partial, the partial should set its value
                    // We'll refresh the lists and keep any selected values the server placed.
                    loadCounterpartyBranches(initialBranchId, modal.counterparty, $(modal.counterparty).val());
                    loadAccountsForBranch(initialBranchId, modal.dueFrom, modal.dueTo);
                }
            }

            // -------- Load counterparty branches (reusable) --------
            // targetSelector is a CSS selector for the <select> to populate
            // selectedValue optional to pre-select (e.g. edit mode)
            function loadCounterpartyBranches(branchId, targetSelector, selectedValue) {
                const $target = $(targetSelector);
                $target.prop('disabled', true).empty().append('<option value="">Loading...</option>');

                if (!branchId) {
                    $target.prop('disabled', false).empty().append('<option value="">--- Select Counterparty Branch ---</option>');
                    return;
                }

                // Use the GET endpoint that returns branches excluding the current branch
                $.get('/LiaisonMapping/GetCounterpartyBranches', { branchId: branchId })
                    .done(function (data) {
                        $target.empty().append('<option value="">--- Select Counterparty Branch ---</option>');

                        if (!Array.isArray(data) || data.length === 0) {
                            $target.append('<option value="">No branches available</option>');
                        } else {
                            data.forEach(function (b) {
                                const disabled = (b.Id === branchId) ? 'disabled' : '';
                                $target.append(`<option value="${b.Id}" ${disabled}>${escapeHtml(b.Name)}</option>`);
                            });

                            if (selectedValue) $target.val(selectedValue).trigger('change');
                        }

                        $target.prop('disabled', false);
                        if ($target.hasClass('select2-hidden-accessible')) {
                            $target.trigger('change.select2');
                        }
                    })
                    .fail(function () {
                        $target.empty().append('<option value="">Error loading branches</option>').prop('disabled', false);
                    });
            }

            // -------- Load asset/liability accounts (reusable) --------
            // dueFromSelector/dueToSelector are CSS selectors for the selects to populate
            function loadAccountsForBranch(branchId, dueFromSelector, dueToSelector) {
                // Ensure selectors exist
                const $dueFrom = $(dueFromSelector);
                const $dueTo = $(dueToSelector);

                // Reset to placeholders if no branch
                if (!branchId) {
                    $dueFrom.empty().append('<option value="">--- Select Due From Account ---</option>').trigger('change');
                    $dueTo.empty().append('<option value="">--- Select Due To Account ---</option>').trigger('change');
                    return;
                }

                // Asset Accounts
                $.get('/LiaisonMapping/GetAssetAccounts', { branchId: branchId })
                    .done(function (accounts) {
                        $dueFrom.empty().append('<option value="">--- Select Due From Account ---</option>');
                        (accounts || []).forEach(account => {
                            $dueFrom.append(`<option value="${account.Id}">${escapeHtml(account.Name)}</option>`);
                        });
                        if ($dueFrom.hasClass('select2-hidden-accessible')) $dueFrom.trigger('change.select2');
                    })
                    .fail(function () {
                        $dueFrom.empty().append('<option value="">Error loading accounts</option>');
                    });

                // Liability Accounts
                $.get('/LiaisonMapping/GetLiabilityAccounts', { branchId: branchId })
                    .done(function (accounts) {
                        $dueTo.empty().append('<option value="">--- Select Due To Account ---</option>');
                        (accounts || []).forEach(account => {
                            $dueTo.append(`<option value="${account.Id}">${escapeHtml(account.Name)}</option>`);
                        });
                        if ($dueTo.hasClass('select2-hidden-accessible')) $dueTo.trigger('change.select2');
                    })
                    .fail(function () {
                        $dueTo.empty().append('<option value="">Error loading accounts</option>');
                    });
            }

            // -------- helpers --------
            function escapeHtml(text) {
                if (!text && text !== 0) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            // Expose delete/edit functions that were previously global (keeps compatibility)
            window.editLiaisonMapping = function (id) {
                // open modal with id
                window.openLiaisonMappingForm(id);
            };

            window.deleteLiaisonMapping = function (id, mappingName) {
                alertify.confirm(
                    'Confirm Deletion',
                    `Are you sure you want to delete the liaison mapping:<br><strong>${mappingName}</strong>?`,
                    function () {
                        $.post('/LiaisonMapping/Delete', { id: id })
