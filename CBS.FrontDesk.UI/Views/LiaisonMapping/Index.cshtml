@{
    ViewBag.Title = "Liaison Mapping Management";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-vector-link me-2"></i> @GlobalLiaisonMapping.Liaison_Mapping_Management
                </h1>
                <p class="card-text text-muted mb-1">
                    @GlobalLiaisonMapping.Configure_and_manage_inter_branch_financial_relationships_and_account_mappings
                </p>
                <p class="card-text text-warning fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                    @GlobalLiaisonMapping.Ensure_proper_mapping_between_branches_for_automated_transaction_processing
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-info">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> @GlobalLiaisonMapping.Understanding_Liaison_Mapping</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-bank-transfer text-primary me-2"></i> <strong>@GlobalLiaisonMapping.Inter_branch_Transactions:</strong> @GlobalLiaisonMapping.Automates_fund_transfers_between_branches</li>
                <li><i class="mdi mdi-account-switch text-success me-2"></i> <strong>@GlobalShared.Due_From_Due_To:</strong> @GlobalLiaisonMapping.Maps_asset_and_liability_accounts_for_proper_accounting</li>
                <li><i class="mdi mdi-shuffle-variant text-warning me-2"></i> <strong>@GlobalShared.Bidirectional_Mapping:</strong> @GlobalLiaisonMapping.Each_branch_pair_requires_mappings_in_both_directions</li>
                <li><i class="mdi mdi-file-check-outline text-info me-2"></i> <strong>@GlobalShared.Reconciliation:</strong> @GlobalLiaisonMapping.Ensures_proper_tracking_and_reconciliation_of_inter_branch_transactions</li>
            </ul>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="card shadow p-3 mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h5 class="text-primary mb-0"><i class="mdi mdi-filter-outline me-1"></i> @GlobalLiaisonMapping.Liaison_Mapping_Configuration</h5>
        <div>
            <button type="button" class="btn btn-primary" onclick="openLiaisonMappingForm()">
                <i class="mdi mdi-plus-circle-outline me-1"></i> @GlobalShared.Add_New_Mapping
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="loadLiaisonMappings()">
                <i class="mdi mdi-refresh me-1"></i> @GlobalShared.Refresh
            </button>
        </div>
    </div>
</div>

<!-- FILTERS: use distinct IDs prefixed with "filter" -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-filter-outline me-1"></i> @GlobalLiaisonMapping.Liaison_Mapping_Filters
    </h5>

    <form id="liaisonFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-3 bg-light">

            <!-- 🔹 Branch & Account Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranchFilters"
                               onclick="document.getElementById('branchFilters').classList.toggle('d-none')" checked />
                        <label class="form-check-label fw-bold" for="toggleBranchFilters">
                            @GlobalShared.Show_Branch_Filters
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleAccountFilters"
                               onclick="document.getElementById('accountFilters').classList.toggle('d-none')" checked />
                        <label class="form-check-label fw-bold" for="toggleAccountFilters">
                            @GlobalShared.Show_Account_Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- 🔹 Branch Filters Section -->
            <div id="branchFilters">
                <div class="row mb-1">
                    <div class="col-md-4 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Source_branch</label>
                        @Html.DropDownList("sourceBranchId", new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Source Branch ---",
                            new { @class = "form-control select2", id = "sourceBranchId" })
                    </div>

                    @*<div class="col-md-4 mb-1">
                        <label class="form-label fw-bold">Counterparty Branch</label>
                        <select id="counterpartyBranchId" class="form-control select2">
                            <option value="">--- Select Counterparty Branch ---</option>
                        </select>
                    </div>*@

                    <div class="col-md-4 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Target_Branch</label>
                        @Html.DropDownList("targetBranchId", new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Target ---", new { @class = "form-control select2", id = "targetBranchId" })
                    </div>
                </div>
            </div>

            <!-- 🔹 Account Filters Section -->
            <div id="accountFilters">
                <div class="row mb-1">
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Due_From_Asset_Account</label>
                        <select id="dueFromAssetAccountId" class="form-control select2">
                            <option value="">--- Select ---</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">@GlobalShared.Due_To_Liability_Account</label>
                        <select id="dueToLiabilityAccountId" class="form-control select2">
                            <option value="">--- Select ---</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 🔹 Additional Filters (always visible) -->
            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">@GlobalShared.Include_Deleted</label>
                    <select id="includeDeleted" class="form-select">
                        <option value="false" selected>@GlobalShared.No</option>
                        <option value="true">@GlobalShared.Yes</option>
                    </select>
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">@GlobalShared.Created_From</label>
                    <input type="date" id="createdFromUtc" class="form-control" />
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">@GlobalShared.Created To</label>
                    <input type="date" id="createdToUtc" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" class="btn btn-primary me-2 w-100" type="button">
                    <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                </button>
                <button id="resetFilterBtn" type="reset" class="btn btn-secondary w-100">
                    <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
    </form>
</div>
<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_LiaisonMappingData")
</div>

<!-- Liaison Mapping Modal -->
<div class="modal fade" id="liaisonMappingModal" tabindex="-1" aria-labelledby="liaisonMappingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="liaisonMappingLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@GlobalShared.Loading_please_wait...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title text-primary" id="liaisonMappingModalLabel">
                    <i class="mdi mdi-vector-link me-2"></i> @GlobalShared.Liaison_Mapping
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body" id="liaisonMappingFormContainer">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @*<script>
        (function ($) {
