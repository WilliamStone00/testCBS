@using Resources
@{
    ViewBag.Title = @GlobalChangeNumber.PhoneNumberApproval;
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-phone me-2"></i> @GlobalChangeNumber.ChangeMemberPhoneNumberApproval
                </h1>
                <p class="card-text">
                    @GlobalChangeNumber.ManageAndApproveMemberPhoneNumberChangeRequests.
                    @GlobalChangeNumber.ReviewPendingRequestsAndTakeNecessaryActions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalChangeNumber.TIPSFORREQUESTAPPROVAL</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePhoneTips" aria-expanded="false" aria-controls="collapsePhoneTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapsePhoneTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalChangeNumber.EnsureThatTheNewPhoneNumberBelongsToTheMember.</li>
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i> @GlobalChangeNumber.VerifyTheIdentityOfTheRequesterBeforeApproval.</li>
                <li><i class="mdi mdi-gavel text-warning me-2"></i> @GlobalChangeNumber.ApprovedChangesCannotBeRevertedAutomatically.</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalChangeNumber.IfThereAreAnyInconsistencies.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <!-- Pending Phone Number Change Requests -->
        <div id="pendingRequestsContainer">
            @Html.Partial("_Data")
        </div>
    </div>
</div>

<div class="modal fade" id="phoneChangeModal" tabindex="-1" aria-labelledby="phoneChangeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="row">
                    <div class="col-12">
                        <!-- Page Header -->
                        <div class="card bg-light mb-1">
                            <div class="card-body text-center">
                                <h1 class="card-title text-primary">
                                    <i class="mdi mdi-account-details-outline me-2"></i> @GlobalChangeNumber.PHONENUMBERCHANGEREQUEST [@Session["BranchName"].ToString()]
                                </h1>
                                <p class="card-text">
                                    @GlobalChangeNumber.YouAreAboutToReviewAndApproveAPhoneNumberChangeRequest.
                                </p>
                                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Tips Section -->
                <div class="card">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalChangeNumber.IMPORTANTINFORMATION</span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseTips" class="collapse">
                        <div class="card-body">
                            <ul class="mb-0">
                                <li><i class="mdi mdi-account-check-outline text-primary me-2"></i><strong>@GlobalChangeNumber.Verification:</strong> @GlobalChangeNumber.EnsureThatTheMemberRequestingThePhoneNumberChangeIsAuthorized.</li>
                                <li><i class="mdi mdi-phone-classic text-primary me-2"></i><strong>@GlobalChangeNumber.PhoneNumberUpdate:</strong> @GlobalChangeNumber.TheOldPhoneNumberWillBeReplacedWithTheNewOneInTheSystemUponApproval.</li>
                                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>@GlobalChangeNumber.IrreversibleAction:</strong> @GlobalChangeNumber.OnceApprovedTheChangeWillTakeEffectImmediatelyAndCannotBeUndone.</li>
                                <li><i class="mdi mdi-comment-check-outline text-success me-2"></i><strong>@GlobalChangeNumber.ApprovalComment:</strong> @GlobalChangeNumber.ProvideAclearAndConciseReasonForApproval.</li>
                                <li><i class="mdi mdi-security text-danger me-2"></i><strong>@GlobalChangeNumber.SecurityConsideration:</strong> @GlobalChangeNumber.BeCautiousOfFraudulentRequests.</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="phoneChangeContent">
                    <!-- Partial view or dynamic content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    
        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
            LoadDT("myDataTable", 0);
            // Load Approve Phone Change Modal
            $(document).on("click", ".approve-phone-change", function () {
                let requestId = $(this).data("id");

                $.ajax({
                    url: "/ChangeNumber/LoadApproveView",
                    type: "GET",
                    data: { id: requestId },
                    beforeSend: function () {
                        $("#phoneChangeContent").html('<div class="text-center p-3"><i class="mdi mdi-loading mdi-spin text-primary"></i> Loading...</div>');
                    },
                    success: function (data) {
                        $("#phoneChangeContent").html(data);
                    },
                    error: function () {
                        $("#phoneChangeContent").html('<div class="alert alert-danger text-center">Error loading approval form. Please try again.</div>');
                    }
                });
            });

            // Load Phone Number Change Details
            $(document).on("click", ".view-phone-change-details", function () {
                let requestId = $(this).data("id");

                $.ajax({
                    url: "/ChangeNumber/Details",
                    type: "GET",
                    data: { id: requestId },
                    beforeSend: function () {
                        $("#phoneChangeContent").html('<div class="text-center p-3"><i class="mdi mdi-loading mdi-spin text-primary"></i> Loading...</div>');
                    },
                    success: function (data) {
                        $("#phoneChangeContent").html(data);
                    },
                    error: function () {
                        $("#phoneChangeContent").html('<div class="alert alert-danger text-center">Error loading details. Please try again.</div>');
                    }
                });
            });
        });

    </script>
}
