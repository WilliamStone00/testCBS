@{
    ViewBag.Title = "Phone number approval";
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-phone me-2"></i> Change Member Phone Number Approval
                </h1>
                <p class="card-text">
                    Manage and approve member phone number change requests.
                    Review pending requests and take necessary actions to **approve or reject** changes.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR REQUEST APPROVAL</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePhoneTips" aria-expanded="false" aria-controls="collapsePhoneTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapsePhoneTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure that the new phone number **belongs to the member** and is active.</li>
                <li><i class="mdi mdi-account-check-outline text-success me-2"></i> Verify the identity of the requester before approval.</li>
                <li><i class="mdi mdi-gavel text-warning me-2"></i> **Approved changes cannot be reverted automatically.** Ensure the request is legitimate before proceeding.</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> If there are any inconsistencies, **reject** the request and provide a reason in the approval comment.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <!-- Pending Phone Number Change Requests -->
        <div id="pendingRequestsContainer">
            @Html.Partial("_Data")
        </div>
    </div>
</div>

<div class="modal fade" id="phoneChangeModal" tabindex="-1" aria-labelledby="phoneChangeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="row">
                    <div class="col-12">
                        <!-- Page Header -->
                        <div class="card bg-light mb-1">
                            <div class="card-body text-center">
                                <h1 class="card-title text-primary">
                                    <i class="mdi mdi-account-details-outline me-2"></i> PHONE NUMBER CHANGE REQUEST [@Session["BranchName"].ToString()]
                                </h1>
                                <p class="card-text">
                                    You are about to review and approve a phone number change request. Please ensure the details are accurate before proceeding with approval.
                                </p>
                                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Tips Section -->
                <div class="card">
                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                        <span><i class="mdi mdi-information-outline me-2"></i> IMPORTANT INFORMATION</span>
                        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                            <i class="mdi mdi-chevron-down"></i>
                        </button>
                    </h6>
                    <div id="collapseTips" class="collapse">
                        <div class="card-body">
                            <ul class="mb-0">
                                <li><i class="mdi mdi-account-check-outline text-primary me-2"></i><strong>Verification:</strong> Ensure that the member requesting the phone number change is authorized and that supporting documents (if required) are available.</li>
                                <li><i class="mdi mdi-phone-classic text-primary me-2"></i><strong>Phone Number Update:</strong> The old phone number will be replaced with the new one in the system upon approval.</li>
                                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i><strong>Irreversible Action:</strong> Once approved, the change will take effect immediately and cannot be undone.</li>
                                <li><i class="mdi mdi-comment-check-outline text-success me-2"></i><strong>Approval Comment:</strong> Provide a clear and concise reason for approval or rejection in the comment section.</li>
                                <li><i class="mdi mdi-security text-danger me-2"></i><strong>Security Consideration:</strong> Be cautious of fraudulent requests and ensure all approvals align with company policies.</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="phoneChangeContent">
                    <!-- Partial view or dynamic content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    
        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
            LoadDT("myDataTable", 0);
            // Load Approve Phone Change Modal
            $(document).on("click", ".approve-phone-change", function () {
                let requestId = $(this).data("id");

                $.ajax({
                    url: "/ChangeNumber/LoadApproveView",
                    type: "GET",
                    data: { id: requestId },
                    beforeSend: function () {
                        $("#phoneChangeContent").html('<div class="text-center p-3"><i class="mdi mdi-loading mdi-spin text-primary"></i> Loading...</div>');
                    },
                    success: function (data) {
                        $("#phoneChangeContent").html(data);
                    },
                    error: function () {
                        $("#phoneChangeContent").html('<div class="alert alert-danger text-center">Error loading approval form. Please try again.</div>');
                    }
                });
            });

            // Load Phone Number Change Details
            $(document).on("click", ".view-phone-change-details", function () {
                let requestId = $(this).data("id");

                $.ajax({
                    url: "/ChangeNumber/Details",
                    type: "GET",
                    data: { id: requestId },
                    beforeSend: function () {
                        $("#phoneChangeContent").html('<div class="text-center p-3"><i class="mdi mdi-loading mdi-spin text-primary"></i> Loading...</div>');
                    },
                    success: function (data) {
                        $("#phoneChangeContent").html(data);
                    },
                    error: function () {
                        $("#phoneChangeContent").html('<div class="alert alert-danger text-center">Error loading details. Please try again.</div>');
                    }
                });
            });
        });

    </script>
}
