<fieldset class="fieldset-custom p-3 rounded shadow-sm">
    <legend class="fw-bold text-primary"><i class="mdi mdi-account-search me-2"></i> SEARCH MEMBER</legend>
    <div class="card-body">
        <div class="row">
            <div class="col-md-9">
                <div class="form-floating form-floating-outline">
                    <input type="text" class="form-control" id="MemberReference" placeholder="Enter Member Reference">
                    <label for="MemberReference"><i class="mdi mdi-card-account-details me-1"></i> Member Reference</label>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <button type="button" class="btn btn-primary w-100" onclick="searchMember()">
                    <i class="mdi mdi-magnify"></i> Search
                </button>
            </div>
        </div>
    </div>
</fieldset>
