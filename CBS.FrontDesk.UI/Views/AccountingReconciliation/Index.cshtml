

@model CBS.FrontDesk.Data.Entity.Accounting.TransactionTracker

@{
    ViewBag.Title = "RECONCILIATION";
    Layout = "~/Views/Shared/_MainLayout.cshtml";

}


<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR ACCOUNTING-OPERATION RECONCILIATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-4">
                <li><i class="mdi mdi-briefcase-search-outline me-1 text-primary"></i> <strong> Select Branch:  </strong> Select the branch that issue the request.</li>
                <li><i class="mdi mdi-checkbox-multiple-marked-outline me-1 text-primary"></i><strong>Request Status:</strong>  Select the expected request status:<em>Pending, Awaiting Branch Transfer, Cash Clearing, Approved, Rejected, Cancel, Completed</em>.</li>
                <li><i class="mdi mdi-calendar-range-outline me-1 text-primary"></i>  <strong>Date Range:</strong> Select the period in which the request was initiated.</li>
                <li><i class="mdi mdi-account-search-outline me-1 text-primary"></i> <strong> Issuer:  </strong> Select the user that Issue the request in the branch.</li>
                <li><i class="mdi mdi-account-search-outline me-1 text-primary"></i><strong>Approver:</strong> Select the user that approved the request in the branch.</li>
                <li><i class="mdi mdi-alert-circle-outline me-1 text-warning"></i><strong>Approval Restrictions:</strong> You cannot approve a request you initiated.</li>
                <li><i class="mdi mdi-office-building-marker-outline me-1 text-warning"></i><strong>Branch Restrictions:</strong> You cannot approve requests from another branch except you are working at the level of head office.</li>
            </ul>

            <div class="alert alert-info">
                <h6 class="alert-heading"><i class="mdi mdi-information-variant me-2"></i>Summary</h6>
                <p class="mb-0">When a bank deposit request is issued, it is left to the discretion of the financial manager to choose the bank account where the money is to be deposited or if the money should be redirected to another branch as an inter-branch operation.</p>
            </div>
        </div>
    </div>
</div>


<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-server-plus me-2"></i>
                ACCOUNTING-OPERATION RECONCILIATION
            </button>
        </h2>
        <div class="demo-inline-spacing text-end" style="padding-right:2em">

            <a type="button" onclick="LoadDataGen('AccountingReconciliation','myDataTable','_ReconciliationData',0,'datalistingview_reconciliation')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="ViewList">
                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
            </a>
           
        </div>

        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                @Html.Partial("_SearchOption")
                <div id="datalistingview_reconciliation">

                </div>
            </div>
        </div>
    </div>



</div>


@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/main.js/TransactionTracker.js"></script>
}
