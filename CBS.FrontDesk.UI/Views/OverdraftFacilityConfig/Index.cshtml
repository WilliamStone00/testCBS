@{
    ViewBag.Title = "Overdraft Facility Configurations";
}


<div class="container">
    <!-- Page Header -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light shadow-sm">
                <div class="card-body text-center">
                    <h2 class="card-title text-primary">
                        <i class="mdi mdi-bank-check me-2"></i> Overdraft Facility Configurations
                    </h2>
                    <p class="card-text text-secondary fs-6">
                        This page allows you to manage rules and limitations for overdraft-enabled account products. Each configuration controls eligibility, limits, interest, and behavior during overdraft usage.
                    </p>
                    <p class="card-text text-muted small">
                        Use the button below to add a new configuration or update an existing one for a product.
                    </p>
                    <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("_TipOverdraftConfigs")
    <!-- 🔍 Filter & Action Section -->
    
<div class="row mb-1">
    <div class="col-12">
        <div class="card bg-light border">
            <div class="card-body d-flex justify-content-end align-items-center">
                <div class="me-2">
                    <a type="button"
                       onclick="LoadDataGen('OverdraftFacilityConfig','overdraftConfigDataTableContainer','_Data',0,'datalistingview')"
                       class="btn btn-outline-primary btn-sm"
                       data-bs-toggle="tooltip"
                       title="Reload and View Overdraft Config List">
                        <i class="mdi mdi-view-list me-1"></i> View List
                    </a>
                </div>
                <div>
                    <button onclick="AddORUpdateGen(null,'overdraftConfigDataTableContainer','_OverdraftFacilityConfigForm','new','OverdraftFacilityConfig')"
                             class="btn btn-outline-primary btn-sm"
                            data-bs-toggle="tooltip"
                            title="Register a New Overdraft Configuration">
                        <i class="mdi mdi-plus me-1"></i> New Overdraft Config
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
    <!-- 📋 Table Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div id="overdraftConfigDataTableContainer">
                        <!-- Table will be loaded via JS/DataTable -->
                        @Html.Partial("_OverdraftConfigDataTable")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- 🔽 Overdraft Config Modal -->
<div class="modal fade" id="overdraftConfigModal" tabindex="-1" aria-labelledby="overdraftConfigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="overdraftConfigLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-tsc mb-3" role="status"></div>
                    <p class="fw-semibold text-tsc">Loading form... Please wait.</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-tsc" id="overdraftConfigModalLabel">
                                <i class="mdi mdi-bank-settings-outline me-2"></i> Configure Overdraft Facility
                            </h1>
                            <p class="card-text">Use this form to create or update overdraft rules linked to an account product.</p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scrollable Form Section -->
            <div class="modal-body overflow-auto px-3 pb-3" style="max-height: calc(90vh - 180px);">
                @Html.Partial("_TipOverdraftConfigs")
                <div id="overdraftConfigFormContainer">
                    <!-- _OverdraftFacilityConfigForm will be loaded here -->
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer justify-content-between">
                <span class="text-muted fw-semibold">
                    Config ID: <span class="text-dark" id="configSelectedId">[new]</span>
                </span>
                <!-- Modal Footer -->
                <div class="modal-footer bg-white sticky-bottom" style="z-index: 1050;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

}
