@{
    ViewBag.Title = "Overdraft Facility Configurations";
}


<div class="container">
    <!-- Page Header -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light shadow-sm">
                <div class="card-body text-center">
                    <h2 class="card-title text-primary">
                        <i class="mdi mdi-bank-check me-2"></i> Overdraft Facility Configurations
                    </h2>
                    <p class="card-text text-secondary fs-6">
                        This page allows you to manage rules and limitations for overdraft-enabled account products. Each configuration controls eligibility, limits, interest, and behavior during overdraft usage.
                    </p>
                    <p class="card-text text-muted small">
                        Use the button below to add a new configuration or update an existing one for a product.
                    </p>
                    <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("_TipOverdraftConfigs")
    <!-- 🔍 Filter & Action Section -->
    
<div class="row mb-1">
    <div class="col-12">
        <div class="card bg-light border">
            <div class="card-body d-flex justify-content-end align-items-center">
                <div class="me-2">
                    <a type="button"
                       onclick="LoadDataGen('OverdraftFacilityConfig','overdraftConfigDataTableContainer','_Data',0,'datalistingview')"
                       class="btn btn-outline-primary btn-sm"
                       data-bs-toggle="tooltip"
                       title="Reload and View Overdraft Config List">
                        <i class="mdi mdi-view-list me-1"></i> View List
                    </a>
                </div>
                <div>
                    <button onclick="AddORUpdateGen(null,'overdraftConfigDataTableContainer','_OverdraftFacilityConfigForm','new','OverdraftFacilityConfig')"
                             class="btn btn-outline-primary btn-sm"
                            data-bs-toggle="tooltip"
                            title="Register a New Overdraft Configuration">
                        <i class="mdi mdi-plus me-1"></i> New Overdraft Config
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
    <!-- 📋 Table Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div id="overdraftConfigDataTableContainer">
                        <!-- Table will be loaded via JS/DataTable -->
                        @Html.Partial("_OverdraftFacilityConfigForm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

}
