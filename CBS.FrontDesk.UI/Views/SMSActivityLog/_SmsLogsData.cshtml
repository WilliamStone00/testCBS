@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalSMSActivityLog.SMSActivitiesLogListing</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@GlobalSMSActivityLog.Operation</th>
                    <th>@GlobalSMSActivityLog.Sender</th>
                    <th>@GlobalSMSActivityLog.MName</th>
                    <th>M.Tel</th>
                    <th>@GlobalSMSActivityLog.Status</th>
                    <th>@GlobalSMSActivityLog.Cost</th>
                    <th>@GlobalSMSActivityLog.Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
