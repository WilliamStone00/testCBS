@model CBS.FrontDesk.Data.Entity.LoanConf.Tax
<div class="card-body">

    @using (Html.BeginForm("Update", "Tax", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {@Html.HiddenFor(model => model.id)
    <div class="row mt-2 gy-4">
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.name, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.name, "", new { @class = "text-danger" })
                <label>Name</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.value, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.value, "", new { @class = "text-danger" })
                <label>Percentage value</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.description, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.description, "", new { @class = "text-danger" })
                <label>Description</label>
            </div>
        </div>
       
       
    </div>
    <div class="mt-4">

        <button type="submit" class="btn btn-primary me-2">Update</button>

    </div>
}
</div>