@using CBS.FrontDesk.Data.Entity.CheckManagementSystem.Reporting
@model Reporting
@using System.Web.Mvc
@using Resources; 

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <!-- Header Card -->
            <div class="card bg-gradient-dark border-0 shadow-lg mb-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h1 class="h2 text-white mb-2">
                                <i class="mdi mdi-book-open-variant mdi-36px me-3"></i>
                                Cheque Management Reports
                            </h1>
                            <p class="text-white-75 mb-0">Generate comprehensive reports for all cheque-related operations and transactions</p>
                        </div>
                        <div class="col-md-3 text-end">
                            <div class="bg-white-10 rounded-circle d-inline-flex p-3">
                                <i class="mdi mdi-bank-check mdi-48px text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Report Type Selection -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-gradient-light py-3">
                    <h3 class="h5 mb-0 text-dark">
                        <i class="mdi mdi-file-document-multiple me-2"></i>
                        Select Report Category
                    </h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("GenerateChequeReport", "ChequeManagement", FormMethod.Post,
                        new { id = "chequeReportForm", @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ReportCategory)

                        <!-- Report Category Selection -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-2">
                                <div class="cheque-category-card active" data-category="Category">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="categoryReport" value="Category" checked>
                                    <label class="card cheque-category-label h-100" for="categoryReport">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-folder-outline mdi-36px text-primary"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Category Report</h6>
                                            <p class="card-text text-muted small">Cheque category analysis</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="cheque-category-card" data-category="ChequeBook">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="chequeBookReport" value="ChequeBook">
                                    <label class="card cheque-category-label h-100" for="chequeBookReport">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-book-open-page-variant mdi-36px text-success"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Cheque Book</h6>
                                            <p class="card-text text-muted small">Cheque book issuance & status</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="cheque-category-card" data-category="ChequeBookRequest">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="chequeRequestReport" value="ChequeBookRequest">
                                    <label class="card cheque-category-label h-100" for="chequeRequestReport">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-file-document-edit mdi-36px text-warning"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Cheque Request</h6>
                                            <p class="card-text text-muted small">Cheque book requests tracking</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="cheque-category-card" data-category="CounterCheque">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="counterChequeReport" value="CounterCheque">
                                    <label class="card cheque-category-label h-100" for="counterChequeReport">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-counter mdi-36px text-info"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Counter Cheque</h6>
                                            <p class="card-text text-muted small">Counter cheque transactions</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="cheque-category-card" data-category="Transaction">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="transactionReport" value="Transaction">
                                    <label class="card cheque-category-label h-100" for="transactionReport">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-swap-horizontal mdi-36px text-danger"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Transaction</h6>
                                            <p class="card-text text-muted small">Cheque transaction history</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="cheque-category-card" data-category="All">
                                    <input type="radio" class="btn-check" name="CategoryRadio" id="allReports" value="All">
                                    <label class="card cheque-category-label h-100" for="allReports">
                                        <div class="card-body text-center p-3">
                                            <div class="icon-wrapper mb-2">
                                                <i class="mdi mdi-view-dashboard mdi-36px text-purple"></i>
                                            </div>
                                            <h6 class="card-title mb-1">Comprehensive</h6>
                                            <p class="card-text text-muted small">All cheque reports summary</p>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Form Section -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light py-3">
                                <h4 class="h6 mb-0 text-dark">
                                    <i class="mdi mdi-filter-outline me-2"></i>
                                    Report Parameters
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <!-- Category Report Form (Default) -->
                                <div id="CategoryForm" class="cheque-form-section">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-floating shadow-sm">
                                                @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                                <label>@GlobalUserManagement.Branch</label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-start me-1"></i>
                                                    From Date
                                                </label>
                                                @Html.ValidationMessageFor(m => m.DateFrom, "", new { @class = "text-danger small" })
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                                @Html.ValidationMessageFor(m => m.DateTo, "", new { @class = "text-danger small" })
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.CategoryType,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Categories", Value = "All" },
                                                        new SelectListItem { Text = "Personal Cheques", Value = "Personal" },
                                                        new SelectListItem { Text = "Business Cheques", Value = "Business" },
                                                        new SelectListItem { Text = "Cashier's Cheques", Value = "Cashiers" },
                                                        new SelectListItem { Text = "Traveler's Cheques", Value = "Travelers" }
                                                    }, "Value", "Text"),
                                                    "Select Category Type",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-tag-outline me-1"></i>
                                                    Category Type (Optional)
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Cheque Book Report Form -->
                                <div id="ChequeBookForm" class="cheque-form-section d-none">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="form-floating shadow-sm">
                                                @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                                <label>@GlobalUserManagement.Branch</label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.MemberReference, new
                                                    {
                                                        @class = "form-control",
                                                        placeholder = "Member ID/Reference",
                                                        maxlength = "50"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-account-search me-1"></i>
                                                    Member Reference (Optional)
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.ChequeBookStatus,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Status", Value = "All" },
                                                        new SelectListItem { Text = "Active", Value = "Active" },
                                                        new SelectListItem { Text = "Issued", Value = "Issued" },
                                                        new SelectListItem { Text = "Exhausted", Value = "Exhausted" },
                                                        new SelectListItem { Text = "Cancelled", Value = "Cancelled" }
                                                    }, "Value", "Text"),
                                                    "Select Status",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-check-circle-outline me-1"></i>
                                                    Cheque Book Status
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-start me-1"></i>
                                                    From Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Cheque Book Request Form -->
                                <div id="ChequeBookRequestForm" class="cheque-form-section d-none">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="form-floating shadow-sm">
                                                @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                                <label>@GlobalUserManagement.Branch</label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.MemberReference, new
                                                    {
                                                        @class = "form-control",
                                                        placeholder = "Member ID/Reference",
                                                        required = "required",
                                                        maxlength = "50"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-card-account-details me-1"></i>
                                                    Member Reference
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.RequestStatus,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Requests", Value = "All" },
                                                        new SelectListItem { Text = "Pending", Value = "Pending" },
                                                        new SelectListItem { Text = "Approved", Value = "Approved" },
                                                        new SelectListItem { Text = "Rejected", Value = "Rejected" },
                                                        new SelectListItem { Text = "Processed", Value = "Processed" }
                                                    }, "Value", "Text"),
                                                    "Select Request Status",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-clock-outline me-1"></i>
                                                    Request Status
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-start me-1"></i>
                                                    From Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Counter Cheque Form -->
                                <div id="CounterChequeForm" class="cheque-form-section d-none">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="form-floating shadow-sm">
                                                @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                                <label>@GlobalUserManagement.Branch</label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.MemberReference, new
                                                    {
                                                        @class = "form-control",
                                                        placeholder = "Member ID/Reference",
                                                        maxlength = "50"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-account me-1"></i>
                                                    Member Reference (Optional)
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.ChequeType,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Types", Value = "All" },
                                                        new SelectListItem { Text = "Cash Cheque", Value = "Cash" },
                                                        new SelectListItem { Text = "Transfer Cheque", Value = "Transfer" },
                                                        new SelectListItem { Text = "Demand Draft", Value = "Draft" }
                                                    }, "Value", "Text"),
                                                    "Select Cheque Type",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-format-list-bulleted-type me-1"></i>
                                                    Cheque Type
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-start me-1"></i>
                                                    From Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Transaction Form -->
                                <div id="TransactionForm" class="cheque-form-section d-none">
                                    <div class="row g-3">
                                        <div class="form-floating shadow-sm">
                                            @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                            <label>@GlobalUserManagement.Branch</label>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.MemberReference, new
                                                    {
                                                        @class = "form-control",
                                                        placeholder = "Member ID/Account No",
                                                        maxlength = "50"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-account-box me-1"></i>
                                                    Member/Account Reference (Optional)
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.TransactionType,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Transactions", Value = "All" },
                                                        new SelectListItem { Text = "Cleared", Value = "Cleared" },
                                                        new SelectListItem { Text = "Bounced", Value = "Bounced" },
                                                        new SelectListItem { Text = "Pending", Value = "Pending" },
                                                        new SelectListItem { Text = "Stopped", Value = "Stopped" }
                                                    }, "Value", "Text"),
                                                    "Select Transaction Status",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-swap-horizontal me-1"></i>
                                                    Transaction Status
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-start me-1"></i>
                                                    From Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.ChequeNumber, new
                                                    {
                                                        @class = "form-control",
                                                        placeholder = "Cheque Number",
                                                        maxlength = "20"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-numeric me-1"></i>
                                                    Cheque Number (Optional)
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.AmountRange,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "All Amounts", Value = "All" },
                                                        new SelectListItem { Text = "Below 1,000", Value = "Below1000" },
                                                        new SelectListItem { Text = "1,000 - 10,000", Value = "1000-10000" },
                                                        new SelectListItem { Text = "10,000 - 50,000", Value = "10000-50000" },
                                                        new SelectListItem { Text = "Above 50,000", Value = "Above50000" }
                                                    }, "Value", "Text"),
                                                    "Select Amount Range",
                                                    new { @class = "form-control select2" })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-currency-usd me-1"></i>
                                                    Amount Range (Optional)
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- All Reports Form -->
                                <div id="AllForm" class="cheque-form-section d-none">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-floating shadow-sm">
                                                @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                                                <label>@GlobalUserManagement.Branch</label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateFrom, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "From Date"
