                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.TextBoxFor(m => m.DateTo, new
                                                    {
                                                        @class = "form-control datepicker",
                                                        type = "date",
                                                        required = "required",
                                                        placeholder = "To Date"
                                                    })
                                                <label class="fw-bold">
                                                    <i class="mdi mdi-calendar-end me-1"></i>
                                                    To Date
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                @Html.DropDownListFor(m => m.ReportFormat,
                                                    new SelectList(new[]
                                                    {
                                                        new SelectListItem { Text = "Summary Report", Value = "Summary" },
                                                        new SelectListItem { Text = "Detailed Report", Value = "Detailed" },
                                                        new SelectListItem { Text = "Executive Summary", Value = "Executive" },
                                                        new SelectListItem { Text = "Audit Report", Value = "Audit" }
                                                    }, "Value", "Text"),
