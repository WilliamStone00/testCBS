@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize Select2
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Select an option'
            });

            // Initialize datepickers
            flatpickr(".datepicker", {
                dateFormat: "Y-m-d",
                allowInput: true,
                maxDate: "today"
            });

            // Report category selection handler
            $('.cheque-category-card').on('click', function () {
                const category = $(this).data('category');

                // Update active state
                $('.cheque-category-card').removeClass('active');
                $(this).addClass('active');

                // Update hidden field
                $('#ReportCategory').val(category);

                // Show corresponding form
                $('.cheque-form-section').addClass('d-none');
                $(`#${category}Form`).removeClass('d-none');

                // Update validation
                updateChequeFormValidation(category);
            });

            // Preview button handler
            $('#previewChequeReport').on('click', function (e) {
                e.preventDefault();
                if (validateChequeForm()) {
                    generateChequeReport('preview');
                }
            });

            // Print button handler
            $('#printChequeReport').on('click', function (e) {
                e.preventDefault();
                if (validateChequeForm()) {
                    generateChequeReport('print');
                }
            });

            // Form submission handler
            $('#chequeReportForm').on('submit', function (e) {
                e.preventDefault();
                if (validateChequeForm()) {
                    generateChequeReport('print');
                }
            });

            function validateChequeForm() {
                const form = $('#chequeReportForm')[0];
                const category = $('#ReportCategory').val();

                // Clear previous validation
                form.classList.remove('was-validated');

                // Basic validation
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    showNotification('Please fill all required fields', 'warning');
                    return false;
                }

                // Date validation
                const dateFrom = new Date($('#DateFrom').val());
                const dateTo = new Date($('#DateTo').val());

                if (dateFrom > dateTo) {
                    showNotification('From date cannot be after To date', 'warning');
                    $('#DateFrom').focus();
                    return false;
                }

                // Category-specific validations
                if (category === 'ChequeBookRequest' && !$('#MemberReference').val().trim()) {
                    showNotification('Member reference is required for Cheque Book Requests', 'warning');
                    $('#MemberReference').focus();
                    return false;
                }

                return true;
            }

            function generateChequeReport(action) {
                const category = $('#ReportCategory').val();
                const formData = $('#chequeReportForm').serialize();

                // Show loading modal
                const loadingModal = new bootstrap.Modal(document.getElementById('chequeLoadingModal'));
                loadingModal.show();

                // Simulate API call
                setTimeout(() => {
                    loadingModal.hide();

                    if (action === 'print') {
                        // Print functionality
                        window.print();
                        showNotification('Cheque report generated and sent to printer!', 'success');
                    } else {
                        // Preview functionality
                        showNotification('Report preview generated successfully!', 'success');
                        // Open preview in new window
                        window.open('/ChequeManagement/PreviewReport?' + formData, '_blank');
                    }
                }, 2000);
            }

            function updateChequeFormValidation(category) {
                const forms = {
                    'Category': ['BranchId', 'DateFrom', 'DateTo'],
                    'ChequeBook': ['BranchId', 'DateFrom', 'DateTo'],
                    'ChequeBookRequest': ['BranchId', 'MemberReference', 'DateFrom', 'DateTo'],
                    'CounterCheque': ['BranchId', 'DateFrom', 'DateTo'],
                    'Transaction': ['BranchId', 'DateFrom', 'DateTo'],
                    'All': ['BranchId', 'DateFrom', 'DateTo']
                };

                // Reset all fields to not required first
                $('[required]').removeAttr('required');

                // Set required for current form
                forms[category].forEach(field => {
                    $(`#${field}`).attr('required', 'required');
                });
            }

            function resetChequeForm() {
                $('#chequeReportForm')[0].reset();
                $('.cheque-form-section').addClass('d-none');
                $('#CategoryForm').removeClass('d-none');
                $('.cheque-category-card').removeClass('active');
                $('.cheque-category-card[data-category="Category"]').addClass('active');
                $('#ReportCategory').val('Category');
                $('#chequeReportForm').removeClass('was-validated');

                // Reset Select2
                $('.select2').val(null).trigger('change');

                // Reset date fields to today
                const today = new Date().toISOString().split('T')[0];
                $('#DateFrom').val(today);
                $('#DateTo').val(today);

                showNotification('Form has been reset', 'info');
            }

            function exportToExcel() {
                if (validateChequeForm()) {
                    const formData = $('#chequeReportForm').serialize();
                    window.open('/ChequeManagement/ExportToExcel?' + formData, '_blank');
                    showNotification('Exporting to Excel...', 'info');
                }
            }

            function showNotification(message, type) {
                // Use Toastr or Bootstrap toast
                const toast = `<div class="toast align-items-center text-bg-${type === 'success' ? 'success' : type === 'warning' ? 'warning' : 'info'} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">${message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>`;

                $('.toast-container').remove();
                $('body').append(`<div class="toast-container position-fixed top-0 end-0 p-3">${toast}</div>`);
                $('.toast').toast('show');
            }

            // Set default dates
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

            $('#DateFrom').val(firstDay.toISOString().split('T')[0]);
            $('#DateTo').val(today.toISOString().split('T')[0]);
        });
    </script>
}