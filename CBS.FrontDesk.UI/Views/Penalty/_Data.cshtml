@model List<CBS.FrontDesk.Data.Entity.LoanConf.Penalty>
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Product</th>
                <th>Value</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:25%">@d.PenaltyName</td>
                    <td style="width:20%">@d.PenaltyType</td>
                    <td style="width:25%">@d.LoanProduct.ProductName</td>
                    <td style="width:10%">
                        @if (d.IsRate)
                        {
                            <span>@d.PenaltyValue %</span>
                        }
                        else
                        {
                            <span>@d.PenaltyValue.ToString("0#,00.0") Fixed Amount</span>
                        }
                    </td>
                    <td style="width:10%">
                        @if (d.IsEnabled)
                        {
                            <span class="badge bg-info">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Inactive</span>
                        }
                    </td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','Penalty')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Description to edit">Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Description" onclick="DeleteRecordDataTable('Penalty','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>