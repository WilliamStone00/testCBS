@model List<CBS.FrontDesk.Data.Entity.LoanConf.Penalty>
   @using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalShared.Name</th>
            <th>@GlobalShared.Type</th>
            <th>@GlobalShared.flat_amount</th>
            <th>@GlobalShared.Percentage</th>
            <th>@GlobalShared.rate</th>
            <th>@GlobalShared.Status</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:15%">@d.penaltyName</td>
                <td style="width:10%">@d.penaltyType</td>
                <td style="width:10%">@d.flateAmount</td>
                <td style="width:10%">@d.percentage</td>
                <td style="width:10%">
                    @if (@d.isRate)
                    {
                    <label>@GlobalShared.Percentage</label>
                    }
                    else
                    {
                    <label>@GlobalShared.flat_rate</label>
                    }
                </td>
                <td style="width:10%">
                    @if (@d.isEnabled)
                    {
                    <label>@GlobalShared.Active</label>
                    }
                    else
                    {
                    <label>@GlobalShared.InActive</label>
                    }
                </td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','Penalty')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.penaltyName to edit">@GlobalShared.Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.penaltyName" onclick="DeleteRecordDataTable('Penalty','@d.id','myDataTable','_Data',0,'datalistingview')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

