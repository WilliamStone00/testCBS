@using Resources
<div class="row mb-2">
    <div class="col-12">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-light text-danger fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i> @GlobalPenalty.penalty_configuration_guidelines
                </span>
                <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="collapse" data-bs-target="#penaltyGuidelinesBody">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </div>

            <div id="penaltyGuidelinesBody" class="collapse">
                <div class="card-body">
                    <ul class="mb-3 list-unstyled">

                        <!-- 🏷️ Penalty Type -->
                        <li class="mb-2">
                            <i class="mdi mdi-format-list-bulleted-type text-primary me-2"></i>
                            <strong>@GlobalShared.penalty_type:</strong> @Html.Raw(@GlobalPenalty.defines_the_logic_to_apply_use_laterepaymentpenalty_for_installment_defaults_or_penaltyaftermaturitydate_for_postloan_expiry).
                        </li>

                        <!-- 💵 Penalty Value -->
                        <li class="mb-2">
                            <i class="mdi mdi-cash text-success me-2"></i>
                            <strong>@GlobalPenalty.penalty_value:</strong> @Html.Raw(@GlobalPenalty.enter_a_numeric_amount_if_israte_is_checked_this_value_is_treated_as_a_percentage_of_the_base_otherwise_it_is_a_flat_fee).
                        </li>

                        <!-- 🧮 Base Amount -->
                        <li class="mb-2">
                            <i class="mdi mdi-calculator-variant-outline text-info me-2"></i>
                            <strong>@GlobalPenalty.penalty_base:</strong> @Html.Raw(@GlobalPenalty.choose_from_overdueprincipalamount_overdueinterestamount_overduedailyinterestamount_or_overdueprincipalplusinterest_use_applyfixedpenaltyamount_to_apply_fixed_value_directly).
                        </li>

                        <!-- ⏱️ Grace Period -->
                        <li class="mb-2">
                            <i class="mdi mdi-timer-sand-empty text-warning me-2"></i>
                            <strong>@GlobalShared.grace_period:</strong> @GlobalPenalty.defines_the_number_of_days_after_a_due_date_before_any_penalty_is_considered_helps_protect_compliant_borrowers_from_accidental_penalties.
                        </li>

                        <!-- ⏲️ Apply After -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-clock text-info me-2"></i>
                            <strong>@GlobalShared.apply_after_days:</strong> @GlobalPenalty.specifies_how_long_after_overdue_the_penalty_should_actually_be_enforced_works_in_combination_with_grace_period.
                        </li>

                        <!-- 🔁 Recurrence -->
                        <li class="mb-2">
                            <i class="mdi mdi-repeat text-primary me-2"></i>
                            <strong>@GlobalPenalty.recurrence_settings:</strong> @Html.Raw(@GlobalPenalty.set_recurringperiod_days_weeks_months_years_and_recuringinterval_eg_30_to_determine_how_often_the_penalty_should_be_reapplied_applies_only_if_iscumulative_is_true).
                        </li>

                        <!-- 📌 Cumulative Logic -->
                        <li class="mb-2">
                            <i class="mdi mdi-autorenew text-dark me-2"></i>
                            <strong>@GlobalShared.cumulative_application:</strong> @Html.Raw(@GlobalPenalty.if_iscumulative_is_enabled_penalties_will_apply_repeatedly_as_per_recurrence_settings_disable_to_restrict_application_to_once_per_cycle).
                        </li>

                        <!-- 🔓 One-time Enforcement -->
                        <li class="mb-2">
                            <i class="mdi mdi-lock-open-outline text-secondary me-2"></i>
                            <strong>@GlobalPenalty.onetime_only:</strong> @Html.Raw(@GlobalPenalty.set_isonetimeonly_to_true_if_this_penalty_must_only_apply_once_across_the_life_of_the_loan_often_used_for_maturity_or_closurerelated_fees).
                        </li>

                        <!-- 🚫 Max Cap -->
                        <li class="mb-2">
                            <i class="mdi mdi-currency-usd-off text-danger me-2"></i>
                            <strong>@GlobalPenalty.cap_amount:</strong> @Html.Raw(@GlobalPenalty.use_penaltymaxcapamount_to_limit_total_charges_from_this_rule_prevents_overcharging_in_longterm_arrears).
                        </li>

                        <!-- ⛔ Expiry -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-remove text-muted me-2"></i>
                            <strong>@GlobalShared.auto_expire_after:</strong> @Html.Raw(@GlobalPenalty.use_hasexpiryafterdays_and_expireafterdays_to_disable_the_rule_automatically_after_a_number_of_active_days_useful_for_promotional_or_transitional_penalties).
                        </li>

                        <!-- 📆 Weekend Behavior -->
                        <li class="mb-2">
                            <i class="mdi mdi-calendar-weekend-outline text-warning me-2"></i>
                            <strong>@GlobalPenalty.weekend_enforcement:</strong> @Html.Raw(@GlobalPenalty.if_applyonweekends_is_false_penalties_will_be_skipped_on_saturdays_and_sundays_enable_for_daily_calculations).
                        </li>

                        <!-- 🏦 Posting Account -->
                        <li class="mb-2">
                            <i class="mdi mdi-bank-outline text-dark me-2"></i>
                            <strong>@GlobalShared.fee_posting:</strong> @Html.Raw(@GlobalPenalty.use_feepostingaccountid_to_direct_penalty_revenue_into_a_specific_ledger_or_gl_account).
                        </li>

                        <!-- ⚠️ Risk Warning -->
                        <li class="mb-2">
                            <i class="mdi mdi-alert-outline text-danger me-2"></i>
                            <strong>@GlobalShared.Important:</strong> @GlobalPenalty.poorly_configured_penalties_may_result_in_excessive_client_burden_reputational_damage_or_compliance_issues.
                        </li>
                    </ul>

                    <hr class="my-3" />

                    <p class="text-muted mb-0">
                        <i class="mdi mdi-help-circle-outline me-2"></i>
                        @GlobalPenalty.always_validate_penalty_logic_with_compliance_credit_risk_and_finance_teams_before_activating_on_live_loan_products.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
