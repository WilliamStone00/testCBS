@model CBS.FrontDesk.Data.Entity.LoanConf.Penalty
@using Resources
@using (Html.BeginForm("AddOrEdit", "Penalty", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))

{
    @Html.ValidationSummary(true, $"{@GlobalPenalty.please_correct_the_errors_and_try_again}.", new { @class = "alert alert-danger" })

<div class="row gy-3">
    @Html.HiddenFor(model => model.Id)

    <!-- 📌 Basic Info -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-file-document-outline me-1"></i> @GlobalPenalty.penalty_details
        </h6>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyName, new { @class = "form-control", required = "required" })
            <label>@GlobalPenalty.penalty_name</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.example_late_fee_personal_loans_must_be_unique.</small>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.PenaltyType, new SelectList(ViewBag.PenaltyTypes, "Value", "Text"), "--- Select Penalty Type ---", new { @class = "form-control select2", required = "required" })
            <label>@GlobalShared.penalty_type</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.determines_when_to_trigger_penalty_eg_after_due_date_or_on_maturity.</small>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-floating shadow-sm">
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", style = "height: 150px;" })
            <label>@GlobalShared.Description (@GlobalShared.Optional)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.internal_notes_or_detailed_explanation_for_admins.</small>
        </div>
    </div>



    <!-- 💵 Value & Rate -->
    <!-- 💵 Value & Application Mode -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-currency-usd me-1"></i> @GlobalPenalty.value_application_mode
        </h6>
    </div>

    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyValue, new
            {
                @class = "form-control",
                type = "number",
                id = "PenaltyValue",
                step = "0.01",
                min = "0",
                required = "required"
            })
            <label>@GlobalPenalty.penalty_value</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.enter_either_a_fixed_amount_eg_2000_fcfa_or_a_rate.</small>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsRate, new { @class = "form-check-input", id = "IsRate" })
            <label class="form-check-label" for="IsRate">@GlobalShared.value_is_a_rate (%)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.when_checked_the_system_treats_penaltyvalue_as_a_percentage_eg_2_recommended_max_10.</small>
        </div>
    </div>




    <!-- ⚙️ Calculation Logic -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-calculator-variant me-1"></i> @GlobalPenalty.calculation_logic
        </h6>
    </div>

    <!-- Base Amount Selection -->
    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.CalculatePenaltyOn,
                new List<SelectListItem>
                {
                    new SelectListItem { Text = $"{@GlobalPenalty.overdue_principal_amount}", Value = "Overdue_Principal_Amount" },
                    new SelectListItem { Text = $"{@GlobalPenalty.overdue_interest_amount}", Value = "Overdue_Interest_Amount" },
                    new SelectListItem { Text = $"{@GlobalPenalty.overdue_daily_interest_amount}", Value = "Overdue_Daily_Interest_Amount" },
                    new SelectListItem { Text = $"{@GlobalPenalty.apply_fixed_penalty_amount}", Value = "Apply_Fixed_Penalty_Amount" },
                    new SelectListItem { Text = $"{@GlobalPenalty.overdue_principal_interest}", Value = "Overdue_Principal_Plus_Interest" }
                },
                "--- Select Base ---",
                new { @class = "form-control select2" })
            <label>@GlobalShared.apply_on</label>
            <small class="text-muted d-block">
                💡 @GlobalPenalty.defines_the_part_of_the_loan_used_as_the_penalty_base_for_fixed_fees_choose_apply_fixed_penalty_amount".
            </small>
        </div>
    </div>

    <!-- Max Cap -->
    <div class="col-md-6">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.PenaltyMaxCapAmount, new { @class = "form-control", type = "number", min = "0" })
            <label>@GlobalPenalty.penalty_cap (@GlobalShared.Optional)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.maximum_amount_this_penalty_can_reach (e.g., 50,000 FCFA).</small>
        </div>
    </div>

    <!-- Cumulative -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsCumulative, new { @class = "form-check-input", id = "IsCumulative" })
            <label class="form-check-label fw-bold" for="IsCumulative">@GlobalShared.cumulative</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.apply_the_penalty_at_each_eligible_recurrence_interval_recommended_for_dailyweekly_logic.</small>
        </div>
    </div>

    <!-- One-Time -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.IsOneTimeOnly, new { @class = "form-check-input", id = "IsOneTimeOnly" })
            <label class="form-check-label fw-bold" for="IsOneTimeOnly">@GlobalShared.apply_once</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.use_for_special_onetime_charges_like_late_start_fees.</small>
        </div>
    </div>


    <!-- 📅 Timing & Recurrence -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-clock-outline me-1"></i> @GlobalPenalty.timing_recurrence
        </h6>
    </div>

    <!-- Grace Period -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.GracePeriodInDaysBeforeApplyingPenalty, new { @class = "form-control", type = "number", min = "0" })
            <label>@GlobalShared.grace_period (@GlobalShared.Days)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.days_after_due_date_before_penalty_eligibility_begins.</small>
        </div>
    </div>

    <!-- Apply After Days -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.DaysToApplyPenalty, new { @class = "form-control", type = "number", min = "0" })
            <label>@GlobalShared.apply_after (@GlobalShared.Days)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.minimum_number_of_days_overdue_before_enforcing_penalty.</small>
        </div>
    </div>

    <!-- Apply on Weekends -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBoxFor(m => m.ApplyOnWeekends, new { @class = "form-check-input", id = "ApplyOnWeekends" })
            <label class="form-check-label fw-bold" for="ApplyOnWeekends">@GlobalShared.apply_on_weekends</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.check_to_allow_penalties_even_on_weekends.</small>
        </div>
    </div>

    <!-- Recurrence Frequency -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.DropDownListFor(m => m.RecurringPeriod,
                new List<SelectListItem> {
                    new SelectListItem { Text = "Days", Value = "Days" },
                    new SelectListItem { Text = "Weeks", Value = "Weeks" },
                    new SelectListItem { Text = "Months", Value = "Months" },
                    new SelectListItem { Text = "Years", Value = "Years" }
                },
                $"--- {@GlobalShared.select_period} ---",
                new { @class = "form-control select2" })
            <label>@GlobalShared.recurring_period</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.how_often_to_apply_daily_weekly_monthly_etc.</small>
        </div>
    </div>

    <!-- Recurrence Interval -->
    <div class="col-md-4">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.RecuringInterval, new { @class = "form-control", type = "number", min = "1" })
            <label>@GlobalShared.interval</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.multiplier_of_the_period (e.g., every 2 weeks = 2).</small>
        </div>
    </div>

    <!-- Expiry Toggle -->
    <div class="col-md-4">
        <div class="form-check mt-4 pt-2">
            @Html.CheckBox("HasExpiryAfterDays", false, new { @class = "form-check-input", id = "HasExpiryAfterDays" })
            <label class="form-check-label fw-bold" for="HasExpiryAfterDays">@GlobalPenalty.enable_expiry_by_days</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.ends_penalty_enforcement_after_a_specific_number_of_days.</small>
        </div>
    </div>

    <!-- Expiry Days -->
    <div class="col-md-4" id="expiryDaysContainer" style="display:none;">
        <div class="form-floating shadow-sm">
            @Html.TextBox("ExpireAfterDays", null, new { @class = "form-control", type = "number", min = "1" })
            <label>@GlobalShared.expire_after (@GlobalShared.Days)</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.time_in_days_from_activation_until_penalty_stops_applying.</small>
        </div>
    </div>




    <!-- 🧾 Accounting -->
    <div class="col-12">
        <h6 class="text-danger border-bottom pt-2 pb-1">
            <i class="mdi mdi-bank-transfer me-1"></i> @GlobalPenalty.accounting_posting
        </h6>
    </div>

    <!-- Fee Posting Account -->
    <div class="col-md-12">
        <div class="form-floating shadow-sm">
            @Html.TextBoxFor(m => m.FeePostingAccountId, new { @class = "form-control" })
            <label>@GlobalPenalty.fee_posting_account_id</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.used_for_tracking_penalty_revenue_in_the_general_ledger_gl.</small>
        </div>
    </div>

    <!-- Enable/Disable Rule -->
    <div class="col-md-12">
        <div class="form-check mt-3">
            @Html.CheckBoxFor(m => m.IsEnabled, new { @class = "form-check-input", id = "IsEnabled" })
            <label class="form-check-label fw-bold" for="IsEnabled">@GlobalShared.enable_penalty</label>
            <small class="text-muted d-block">💡 @GlobalPenalty.toggle_to_activate_or_deactivate_this_penalty_rule.</small>
        </div>
    </div>

    <!-- 🔘 Actions -->
    <div class="col-12 text-end mt-3">
        <button type="submit" class="btn btn-danger shadow-sm px-4">
            <i class="mdi mdi-content-save-outline me-1"></i>
            @(Model.Id == null ? "Save Configuration" : "Update Configuration")
        </button>
        <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">@GlobalShared.Reset</button>
    </div>


</div>
}



<script>
    $(function () {
        function validatePenaltyValue() {
            const isRate = $('#IsRate').is(':checked');
            const value = parseFloat($('#PenaltyValue').val());

            if (isRate && value > 100) {
                alert('❌ Penalty Value cannot exceed 100% when it is a rate.');
                $('#PenaltyValue').val(100);
            }
        }

        // Attach on change
        $('#PenaltyValue').on('input', validatePenaltyValue);
        $('#IsRate').on('change', validatePenaltyValue);
    });
</script>


<script>
    $(function () {
        function toggleValidityMode() {
            const byDays = $('#HasExpiryAfterDays').is(':checked');
            $('#expiryDaysContainer').toggle(byDays);
            //$('#validityDateContainer, #validityDateContainer2').toggle(!byDays);
        }
        toggleValidityMode();
        $('#HasExpiryAfterDays').on('change', toggleValidityMode);
    });
</script>
