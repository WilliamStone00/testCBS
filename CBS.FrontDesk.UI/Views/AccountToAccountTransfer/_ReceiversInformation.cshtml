<div class="col-12">
    <!-- Receiver Summary Section -->
    <div id="receiverSummarySection" style="display: none;">
        <div class="card border-success shadow-sm">
            <div class="card-header bg-tsc text-white fw-bold">
                <i class="mdi mdi-account-arrow-left"></i> Receiver Summary
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <tbody>
                            <tr>
                                <th class="bg-light text-end" style="width: 25%;">Name:</th>
                                <td class="text-dark" id="summaryReceiverName"></td>
                            </tr>
                            <tr>
                                <th class="bg-light text-end">Branch:</th>
                                <td class="text-dark" id="summaryReceiverBranch"></td>
                            </tr>
                            <tr>
                                <th class="bg-light text-end">Account:</th>
                                <td class="text-dark" id="summaryReceiverAccount"></td>
                            </tr>
                            <tr>
                                <th class="bg-light text-end">Phone Number:</th>
                                <td class="text-dark" id="summaryReceiverPhone"></td>
                            </tr>
                            <tr>
                                <th class="bg-light text-end">CNI Number:</th>
                                <td class="text-dark" id="summaryReceiverCNI"></td>
                            </tr>
                            <tr>
                                <th class="bg-light text-end">Account Balance:</th>
                                <td class="text-dark" id="summaryReceiverBalance"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Hidden fields for form submission -->
                <input type="hidden" id="ReceiverAccountNumber" name="Transfer.ReceiverAccountNumber" />
                <input type="hidden" id="ReceiverAccountType" name="Transfer.ReceiverAccountType" />
                <input type="hidden" id="ReceiverAccountBalance" name="Transfer.ReceiverBalance" />
                <input type="hidden" id="ReceiverPhone" name="Transfer.ReceiverPhone" />
                <input type="hidden" id="ReceiverCNI" name="Transfer.ReceiverCNI" />
                <input type="hidden" id="summaryReceiverBranchCode" name="ReceiverBranchCode" />

                <!-- Change Button -->
                <div class="text-end mt-3">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            onclick="changeReceiver()">
                        <i class="mdi mdi-account-sync"></i> Change Receiver
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
