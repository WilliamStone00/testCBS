@{
    ViewBag.Title = "Account to Account Transfer";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="container">
    <!-- Page Header -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light shadow-sm">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank-transfer me-2"></i> Account to Account Transfers
                    </h1>
                    <p class="card-text text-secondary fs-6">
                        This interface allows you to initiate a secure fund transfer between two valid member accounts.
                        All transfers submitted here are treated as <strong>transfer requests</strong> and must be validated by the system or an authorized officer
                        before affecting any account balances.
                    </p>
                    <p class="card-text text-muted small">
                        Ensure both sender and receiver details are accurate. Once validated, the transfer becomes final and irreversible.
                    </p>
                    <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
                </div>
            </div>
        </div>
    </div>
    <!-- Help Tips Section -->
    @Html.Partial("_Tips")
    <input type="hidden" id="selectedReceiverAccountNumber" name="Transfer.ReceiverAccountNumber" />

    <!-- Transfer Operation Section -->
    <!-- Transfer Operation Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border rounded mb-1">
                <!-- Card Header -->
                <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-bank-transfer me-2 fs-5 text-primary"></i>
                        <span>Account Transfer Operations</span>
                    </div>

                    <!-- 🔙 Back Button -->
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2"
                            onclick="location.href='/AccountToAccountTransfer/Transfters'">
                        <i class="mdi mdi-arrow-left-bold-outline"></i>
                        <span>Transfer List</span>
                    </button>
                </div>

                <!-- 🔍 Search Section -->
                <div class="card-body border-bottom">
                    @Html.Partial("_SearchBoxSender")
                </div>

                <!-- 📋 Table Section -->
                <div class="card-body pt-1">
                    <div id="senderAccountsTableContainer">
                        <!-- Sender table will be rendered here dynamically -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_ReceiversForm")
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/AccountToAccountTransfer/AccountToAccountTransfer.js"></script>
}
