@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.AccountToAccountTransferDto

@{
    ViewBag.Title = "Account to Account Transfers";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet" />

<input type="hidden" id="accountantName" value="@Session["FullName"].ToString()" />
<input type="hidden" id="branchName" value="@Session["BranchName"].ToString()" />
<input type="hidden" id="branchName" value="@Session["BankName"].ToString()" />
<div class="container mt-3">

    <!-- ✅ Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light shadow-sm">
                <div class="card-body text-center">
                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank-transfer me-2"></i> Account to Account Transfers
                    </h1>
                    <p class="card-text text-secondary fs-6">
                        This interface provides a clear overview of all <strong>account-to-account transfer requests</strong> submitted by operators.
                        Each request must be validated before impacting member balances. Only validated requests become final.
                    </p>
                    <p class="text-muted small">
                        You can review pending transfers below. For each item, you may view, edit, approve, or delete if required.
                    </p>
                    <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Transfer Guidelines -->
    <div class="row mb-2">
        <div class="col-12">
            <div class="card border-info shadow-sm">
                <h6 class="card-header bg-light d-flex justify-content-between align-items-center text-tsc">
                    <span><i class="mdi mdi-information-outline me-2"></i> Transfer Validation Guidelines</span>
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#transferGuidelines">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="transferGuidelines" class="collapse">
                    <div class="card-body">
                        <ul class="mb-3 list-unstyled">
                            <li class="mb-2"><i class="mdi mdi-timer-sand text-warning me-1"></i> All listed transfers are <strong>pending validation</strong>.</li>
                            <li class="mb-2"><i class="mdi mdi-bank-transfer-in text-primary me-1"></i> Only an authorized user can <strong>approve</strong> a request.</li>
                            <li class="mb-2"><i class="mdi mdi-pencil-outline text-success me-1"></i> You may <strong>edit transfer details</strong> before approval if incorrect.</li>
                            <li class="mb-2"><i class="mdi mdi-delete-outline text-danger me-1"></i> Use <strong>Delete</strong> to discard transfers initiated by mistake.</li>
                            <li class="mb-2"><i class="mdi mdi-account-eye text-secondary me-1"></i> Approved transfers are final and can no longer be modified or removed.</li>
                        </ul>
                        <p class="text-muted mb-0"><i class="mdi mdi-alert-circle-outline me-1"></i> Contact system control team if inconsistencies are noticed before validation.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-2">
        <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
            <div><i class="mdi mdi-swap-horizontal me-2"></i> TRANSFER REQUESTS</div>
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"
                        onclick="LoadDataGen('AccountToAccountTransfer','myDataTable','_TransferTable',0,'datalistingview',null,null,'all_transfer_request')">
                    <span class="spinner-border spinner-border-sm d-none" role="status" id="transferLoadSpinner"></span>
                    <i class="mdi mdi-view-list mdi-18px"></i>
                    <span>Reload List</span>
                </button>

                <a href="/AccountToAccountTransfer"
                   class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2">
                    <i class="mdi mdi-plus-circle-outline"></i>
                    <span>New Transfer</span>
                </a>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> Re-Print
                </button>
            </div>
        </div>

        <div id="datalistingview" class="p-2">
            <!-- Partial will be loaded here -->
        </div>
    </div>



</div>
<div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="transferLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-tsc mb-3" role="status"></div>
                    <p class="fw-semibold text-tsc">Processing transfer request... Please wait.</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-tsc" id="transferModalTitle">
                                <i class="mdi mdi-clipboard-check-outline me-2"></i> Action Panel
                            </h1>
                            <p class="card-text" id="transferModalDescription">
                                This section allows you to approve, reject, or edit transfer requests securely.
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scrollable Content -->
            <div id="transferModalBody" class="px-3 pb-2 overflow-auto" style="max-height: 65vh;">
                <!-- Partial view will be loaded here -->
            </div>

            <!-- Always-visible Footer with Cancel button -->
            <div class="modal-footer justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Cancel
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/AccountToAccountTransfer/TransferApproval.js"></script>
}
