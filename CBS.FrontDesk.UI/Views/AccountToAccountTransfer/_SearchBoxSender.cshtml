<fieldset class="fieldset-custom mb-0 pb-0 border-0">
    <div class="row g-2">
        <div class="col-md-8 mx-auto">

            <!-- Sender Search Bar -->
            <label for="senderSearchInput" class="form-label text-primary fw-bold mb-1">
                <i class="mdi mdi-account-arrow-right me-1"></i> Sender - Member Reference Number
            </label>

            <div class="input-group input-group-sm shadow-sm">
                <input type="text" id="senderSearchInput" class="form-control" placeholder="Enter 10-digit sender ref: 0120050001" maxlength="10">
                <button class="btn btn-outline-primary" onclick="SearchSender()">
                    <i class="mdi mdi-magnify"></i> Search Sender
                </button>
            </div>

            <small class="form-text text-muted mt-1">
                Type the sender's 10-digit member reference number and click search to fetch their account details.
            </small>

        </div>
    </div>
</fieldset>
