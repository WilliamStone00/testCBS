@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.AccountToAccountTransferDto
<div class="px-3 py-2">
    <form id="editTransferForm">
        <input type="hidden" name="Id" value="@Model.TransfterRequest.Id" />

        <div class="mb-3">
            <label>Sender Account</label>
            <select class="form-select" name="SourceAccountNumber">
                @foreach (var acc in ViewBag.SenderAccounts as List<SelectListItem>)
                {
                    <option value="@acc.Value" @(Model.TransfterRequest.SourceAccountNumber == acc.Value ? "selected" : "")>@acc.Text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Receiver Account</label>
            <select class="form-select" name="DestinationAccountNumber">
                @foreach (var acc in ViewBag.ReceiverAccounts as List<SelectListItem>)
                {
                    <option value="@acc.Value" @(Model.TransfterRequest.DestinationAccountNumber == acc.Value ? "selected" : "")>@acc.Text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Amount</label>
            <input type="number" name="Amount" value="@Model.TransfterRequest.Amount" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Fee</label>
            <input type="number" name="Charges" value="@Model.TransfterRequest.Charges" class="form-control" />
        </div>
    </form>
</div>
