@model List<CBS.FrontDesk.Data.Entity.Accounting.AccountCategory>
@using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@Globals_Data.Name</th>
            <th>@Globals_Data.Description</th>
            <th>@Globals_Data.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:35%">@d.Name</td>
                <td style="width:35%">@d.Description</td>
                <td style="width:30%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Update','update','AccountCategory')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(@Globals_Data.SelectToEdit, d.Name)">@Globals_Data.Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(@Globals_Data.Delete, d.Name)" onclick="DeleteRecordDataTable('AccountCategory','@d.Id','myDataTable','_Data',0,'datalistingview')">@Globals_Data.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>