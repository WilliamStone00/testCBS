@model CBS.FrontDesk.Data.Entity.SavingProducts.TransactionReversal
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalTransactionReversal.PendingApprovalsRequest</legend>
    @if (Model.ReversalRequests.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalTransactionReversal.NoDataFound</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalTransactionReversal.Date</th>
                        <th>@GlobalTransactionReversal.Amount</th>
                        <th>@GlobalTransactionReversal.Branch</th>
                        <th>@GlobalTransactionReversal.ValidatedBy</th>
                        <th>@GlobalTransactionReversal.ValidationComment</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.ReversalRequests)
                    {
                    <tr>
                        <td style="width:20%">@d.RequestDate</td>
                        <td style="width:10%">@d.Amount.ToString("#,##0.0")</td>
                        <td style="width:20%">@d.Reason</td>
                        <td style="width:20%">@d.ValidatedBy</td>
                        <td style="width:20%">@d.ValidationComment</td>
                        <td style="width:10%">
                            <a href="/TransactionReversal/RequestApprovalForm?key=@d.Id" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Approve @d.Amount @GlobalTransactionReversal.reverslaRequest">@GlobalShared.Approve</a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
