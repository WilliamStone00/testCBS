@model CBS.FrontDesk.Data.Entity.SavingProducts.TransactionReversal

<fieldset class="fieldset-custom">
    <legend id="select_base">Pending approvals request</legend>
    @if (Model.ReversalRequests.Count() == 0)
    {
        <div class="text-center my-3">
            <p>No Data Found</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Branch</th>
                        <th>Validated by</th>
                        <th>Validation comment</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.ReversalRequests)
                    {
                    <tr>
                        <td style="width:20%">@d.RequestDate</td>
                        <td style="width:10%">@d.Amount.ToString("#,##0.0")</td>
                        <td style="width:20%">@d.Reason</td>
                        <td style="width:20%">@d.ValidatedBy</td>
                        <td style="width:20%">@d.ValidationComment</td>
                        <td style="width:10%">
                            <a href="/TransactionReversal/RequestApprovalForm?key=@d.Id" class="mr-2" data-toggle="tooltip" data-placement="top" title="Approve @d.Amount reversla request">Approve</a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
