@model CBS.FrontDesk.Data.Entity.SavingProducts.TransactionReversal



@using (Html.BeginForm("Create", "TransactionReversal", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <fieldset class="fieldset-custom">
        <legend id="select_base">Validation Form</legend>
        <input type="hidden" name="Option" value="validate" id="Option" />
        @Html.HiddenFor(model => model.ValidationReversalRequestCommand.Id)
        <div class="row mt-2 gy-4">

            <div class="col-12">
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.ValidationReversalRequestCommand.Status, "Validated", new { @class = "form-check-input", id = "Validated" })
                    <label class="form-check-label" for="Validated">Validated</label>
                </div>
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.ValidationReversalRequestCommand.Status, "Rejected", new { @class = "form-check-input", id = "Rejected" })
                    <label class="form-check-label" for="Rejected">Rejected</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.ValidationReversalRequestCommand.ValidationComment, new { @class = "form-control", @style = "height: 150px;" })
                    @Html.ValidationMessageFor(m => m.ValidationReversalRequestCommand.ValidationComment, "", new { @class = "text-danger " })
                    <label>Comment</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" id="btnSave" class="btn btn-primary me-2">Validate Request</button>
        </div>
    </fieldset>
}
