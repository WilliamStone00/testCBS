                    '<div class="tsc-divider my-2"></div>' +

                    '<div class="d-flex justify-content-between"><span class="text-muted">Facility</span><span class="fw-bold">' + esc(facility) + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Mode</span><span class="fw-bold">' + esc(payload.Mode) + '</span></div>' +
                    (payload.OldLoanId ? ('<div class="d-flex justify-content-between"><span class="text-muted">Old Loan</span><span class="fw-bold">' + esc(payload.OldLoanId) + '</span></div>') : '') +

                    '<div class="tsc-divider my-2"></div>' +

                    '<div class="d-flex justify-content-between"><span class="text-muted">Institution Loan Type</span><span class="fw-bold">' + esc(loanTypeText) + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Loan Product</span><span class="fw-bold">' + esc(productText) + '</span></div>' +

                    '<div class="tsc-divider my-2"></div>' +

                    '<div class="d-flex justify-content-between"><span class="text-muted">Amount</span><span class="fw-bold text-primary">' + money(payload.Amount) + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Interest</span><span class="fw-bold">' + esc(payload.InterestRate) + '%</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Repayment Period</span><span class="fw-bold">' + esc(payload.RepaymentPeriod || "") + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Repayment Type</span><span class="fw-bold">' + esc(payload.RepaymentType || "") + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Grace Days</span><span class="fw-bold">' + esc(payload.GracePeriodDays) + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Disbursement</span><span class="fw-bold">' + esc(payload.DisbursementType || "") + '</span></div>'
                );

                var chargeItems = selectedObjects($("#ddlCharges"));
                var scoreItems = selectedObjects($("#ddlScoreAssessments"));
