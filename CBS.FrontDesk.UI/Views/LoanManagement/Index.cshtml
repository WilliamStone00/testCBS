            function refreshChargesEditorAndSummary() {
                var amount = parseMoneyInput($("#txtAmount").val());
                var $wrap = $("#chargesEditorWrap");
                var $list = $("#chargesEditorList");

                if (!selectedChargeIds.length) {
                    $wrap.hide();
                    $list.empty();
                    updateChargeSummary([]);
                    $("#hidSelectedChargesJson").val("[]");
                    return;
                }

                var selectedRules = chargeRulesCache.filter(c => selectedChargeIds.indexOf(String(c.Id || c.id)) >= 0);

                // ✅ 3-per-row grid
                var cards = selectedRules.map(function (c) {
                    var id = String(c.Id || c.id);
                    var name = String(c.Name || c.name);
                    var mode = normMode(c.Mode || c.mode);
                    var calcTypeRaw = (c.CalcType || c.calcType || "");
                    var calcTypeStr = String(calcTypeRaw || "").toUpperCase(); // FIXED/RATE/RANGE or number

                    var systemCharge = computeChargeValue(c, amount);
                    var userCharge = (chargeUserOverrides[id] != null) ? toNum(chargeUserOverrides[id]) : systemCharge;

                    // ✅ enforce user >= system
                    if (userCharge < systemCharge) userCharge = systemCharge;
                    chargeUserOverrides[id] = userCharge;

                    // ✅ Details line
                    var details = "";
                    if (calcTypeStr === "FIXED" || calcTypeStr === "1") {
                        details = `${toNum(c.FixedAmount || c.fixedAmount).toLocaleString()} FCFA`;
                    } else if (calcTypeStr === "RATE" || calcTypeStr === "2") {
                        var rate = toNum(c.RatePercent || c.ratePercent);
                        var minF = toNum(c.MinFee || c.minFee);
                        var maxF = toNum(c.MaxFee || c.maxFee);
                        details = `${rate}%` + (minF ? ` • Min ${minF.toLocaleString()}` : "") + (maxF ? ` • Max ${maxF.toLocaleString()}` : "");
                    } else if (calcTypeStr === "RANGE" || calcTypeStr === "3") {
                        var ranges = (c.Ranges || c.ranges || []);
                        // show min/max tier bounds
                        var minA = ranges.length ? Math.min.apply(null, ranges.map(r => toNum(r.FromAmount || r.fromAmount))) : 0;
                        var maxA = ranges.length ? Math.max.apply(null, ranges.map(r => toNum(r.ToAmount || r.toAmount))) : 0;
                        details = `Tiers (${minA.toLocaleString()} → ${maxA.toLocaleString()})`;
                    }

                    return `
              <div class="col-12 col-md-6">
                  <div class="card shadow-sm h-100 border-0">
