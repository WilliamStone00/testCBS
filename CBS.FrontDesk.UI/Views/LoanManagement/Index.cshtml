                  <div class="col-6 col-md-3">Accrual Interest: <strong>${fmtMoney(loan.accrualInterest, currency)}</strong></div>
                  <div class="col-6 col-md-3">VAT: <strong>${fmtMoney(loan.vat, currency)}</strong></div>

                  <div class="col-6 col-md-3">Penalty: <strong>${fmtMoney(loan.penalty, currency)}</strong></div>
                  <div class="col-6 col-md-3">Total Due: <strong>${fmtMoney(loan.totalDueAmount, currency)}</strong></div>

                  <div class="col-12 mt-1 text-muted">
