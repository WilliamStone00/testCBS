            // =========================
            // POST (AJAX) ✅ EXACT appalert usage as requested
            // =========================
            function postNewLoan(payload) {
                if (!postNewLoanUrl) {
                    appalert("postNewLoanUrl not configured in #loanUiRoutes.", 2, 1);
                    return;
                }

                // payload already = { AddLoanApplicationCommand: cmd }
                var dto = payload;

                $("#btnSaveLoan").prop("disabled", true).text("Saving...");

                $.ajax({
                    url: postNewLoanUrl,
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(dto)
                })
                    .done(function (response) {
                        // Controller returns: { success, status, message }
                        var ok = response && (response.success === true || response.Success === true);

                        if (ok) appalert((response && (response.message || response.Message)) || "Loan application submitted successfully.", 1, 1);
                        else appalert((response && (response.message || response.Message)) || "Save failed.", 2, 1);
                    })
                    .fail(function (xhr) {
                        console.error("Save failed:", xhr.status, xhr.responseText);

                        var msg = "Save failed.";
                        try {
                            var json = xhr.responseJSON || JSON.parse(xhr.responseText || "{}");
                            msg = (json && (json.message || json.Message)) || msg;
                        } catch (e) {
                            if (xhr.responseText) msg = xhr.responseText.substring(0, 300);
                        }

                        appalert(msg, 2, 1);
                    })
                    .always(function () {
                        $("#btnSaveLoan").prop("disabled", false).text("Save Application");
                    });
            }
            // -----------------------------
            // choose correct posting function (kept safe)
            // -----------------------------
            function postByMode(dto) {
                // REFINANCE
                if (dto && dto.AddLoanApplicationCommand && dto.OldLoanId !== undefined) {
                    return postLoan(postRefinanceUrl, dto);
                }

                // RESCHEDULE
                if (dto && dto.RescheduleCommand) {
                    return postLoan(postRescheduleUrl, dto);
                }

                // OVERDRAFT
                if (dto && dto.AddOverdraftCommand) {
                    return postLoan(postOverdraftUrl, dto);
                }

                // LOC
                if (dto && dto.AddLineOfCreditCommand) {
                    return postLoan(postLocUrl, dto);
                }

                // NEW LOAN (NewLoanApplicationRequest)
                return postLoan(postNewLoanUrl, dto);
            }
            // =========================
            // SAVE BUTTON (CONFIRM THEN POST) ✅ cancel uses appalert too
            // =========================
            // =========================
            // SAVE BUTTON (CONFIRM THEN POST) ✅ mode-aware + wraps payload for controller
            // =========================
            $("#btnSaveLoan").off("click.newLoanPost").on("click.newLoanPost", function () {

                if (!$("#reviewPreviewWrap").is(":visible")) { appalert("Generate preview before saving.", 2, 1); return; }
                if (!$("#chkConfirmReview").is(":checked")) { appalert("Please confirm the preview before saving.", 2, 1); return; }

                // decide mode/facility from wizardState FIRST
                var mode = ((window.wizardState && window.wizardState.restructureMode) ? window.wizardState.restructureMode : "NEW").toString().toUpperCase();
                var facility = ((window.wizardState && window.wizardState.facility) ? window.wizardState.facility : "CLASSIC").toString().toUpperCase();

                // ✅ For RESCHEDULE: do NOT validate "NEW loan" form fields
                // (reschedule UI uses different fields; validation is handled in its own builder/endpoint)
                if (mode !== "RESCHEDULE") {
                    // keep your existing validation for NEW / other panels
                    if (!validateNewLoan()) {
                        $("#panelReview").hide();
                        $("#panelApplication").show();
                        $("#stepReview").removeClass("active");
                        $("#stepApplication").removeClass("done").addClass("active");
                        return;
                    }
                }

                var dto = null;

                if (mode === "REFINANCE") dto = window.tscLoan.buildRefinancePayload();
                else if (mode === "RESCHEDULE") dto = window.tscLoan.buildReschedulePayload();
                else if (facility === "OVERDRAFT") dto = window.tscLoan.buildOverdraftPayload();
                else if (facility === "LOC" || facility === "LINEOFCREDIT" || facility === "LINE_OF_CREDIT") dto = window.tscLoan.buildLineOfCreditPayload();
                else dto = window.tscLoan.buildNewLoanPayload();

                console.log("POST DTO:", dto);

                var dlg = alertify.confirm(
                    "Confirm Submission",
                    buildConfirmHtml(dto),
                    function () { postByMode(dto); },
                    function () { appalert("Application cancelled. Nothing was submitted.", 2, 1); }
                )
                    .set("labels", { ok: "Yes, Submit", cancel: "Cancel" })
                    .set("movable", false)
                    .set("closable", false)
                    .set("resizable", false)
                    .set("modal", true);

                if (typeof widenConfirmDialog === "function") widenConfirmDialog(dlg);
            });





            // =========================
            // Wider confirm without custom CSS files (normal alertify styling)
            // =========================
            function widenConfirmDialog(dlg) {
                try {
                    dlg.set("resizable", false);
                    dlg.set("pinnable", false);

                    // width: allow content, but cap to viewport
                    dlg.set("maximizable", false);
                    dlg.set("movable", false);

                    setTimeout(function () {
                        // alertify adds .ajs-dialog / .ajs-content
                        var $dialog = $(".ajs-dialog:visible").last();
                        var $content = $dialog.find(".ajs-content");

                        // Remove internal scrolling unless truly needed
                        $content.css({
                            "overflow": "visible",
                            "max-height": "none"
                        });

                        // Set dialog width to fit content but not exceed viewport
                        $dialog.css({
                            "width": "min(980px, 96vw)"
                        });
                    }, 0);
                } catch (e) { /* no-op */ }
            }


            function postTo(url, dto) {
                if (!url) {
                    alertify.error("Post URL not configured for this mode.");
                    return;
                }

                $("#btnSaveLoan").prop("disabled", true).text("Saving...");

                $.ajax({
                    url: url,
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(dto)
                    // headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() } // if needed
                })
                    .done(function (res) {
                        var ok = res && res.success === true;
                        if (ok) alertify.success(res.message || "Request submitted successfully.");
                        else alertify.error((res && res.message) || "Save failed.");
                    })
                    .fail(function (xhr) {
                        console.error("Save failed:", xhr.status, xhr.responseText);

                        var msg = "Save failed.";
                        try {
                            var json = xhr.responseJSON || JSON.parse(xhr.responseText || "{}");
                            msg = (json && (json.message || json.Message)) || msg;
                        } catch (e) {
                            if (xhr.responseText) msg = xhr.responseText.substring(0, 300);
                        }
                        alertify.error(msg);
                    })
                    .always(function () {
                        $("#btnSaveLoan").prop("disabled", false).text("Save Application");
                    });
            }

            function buildDtoByMode() {
                var mode = getMode();
                if (mode === "REFINANCE") return window.tscLoan.buildRefinancePayload();
                if (mode === "RESCHEDULE") return window.tscLoan.buildReschedulePayload();
                if (mode === "OVERDRAFT") return window.tscLoan.buildOverdraftPayload();
                if (mode === "LOC") return window.tscLoan.buildLocPayload();

                // NEW
                return { AddLoanApplicationCommand: window.tscLoan.buildNewLoanPayload() };
            }

            function getPostUrlByMode() {
                var mode = getMode();
                if (mode === "REFINANCE") return postRefinanceUrl;
                if (mode === "RESCHEDULE") return postRescheduleUrl;
                if (mode === "OVERDRAFT") return postOverdraftUrl;
                if (mode === "LOC") return postLocUrl;
                return postNewUrl;
            }


            // =========================
            // POST HELPER (reused by all modes)
            // =========================
            function postLoan(url, dto) {
                if (!url) {
                    appalert("Posting URL not configured.", 2, 1);
                    return;
                }

                $("#btnSaveLoan").prop("disabled", true).text("Saving...");

                $.ajax({
                    url: url,
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(dto)
                })
                    .done(function (response) {
                        var ok = response && (response.success === true || response.Success === true);
                        if (ok) appalert((response.message || response.Message) || "Submitted successfully.", 1, 1);
                        else appalert((response.message || response.Message) || "Save failed.", 2, 1);
                    })
                    .fail(function (xhr) {
                        console.error("Save failed:", xhr.status, xhr.responseText);

                        var msg = "Save failed.";
                        try {
                            var json = xhr.responseJSON || JSON.parse(xhr.responseText || "{}");
                            msg = (json && (json.message || json.Message)) || msg;
                        } catch (e) {
                            if (xhr.responseText) msg = xhr.responseText.substring(0, 300);
                        }
                        appalert(msg, 2, 1);
                    })
                    .always(function () {
                        $("#btnSaveLoan").prop("disabled", false).text("Save Application");
                    });
            }

            // mode posts
            function postNewLoan(dto) { return postLoan(postNewLoanUrl, dto); }
            function postRefinance(dto) { return postLoan(postRefinanceUrl, dto); }
            function postReschedule(dto) { return postLoan(postRescheduleUrl, dto); }
            function postOverdraft(dto) { return postLoan(postOverdraftUrl, dto); }
            function postLineOfCredit(dto) { return postLoan(postLocUrl, dto); }


        })();
    </script>

}
