            function bindChargeCardEvents() {
                // Remove button on each card
                $(".tsc-charge-remove").off("click").on("click", function () {
                    var feeId = String($(this).data("fee-id"));
                    selectedChargeIds = selectedChargeIds.filter(x => String(x) !== feeId);

