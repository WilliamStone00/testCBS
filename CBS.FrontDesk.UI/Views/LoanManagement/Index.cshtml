@section scripts{

    <script>
/**
 * TSC Loan Wizard - Step 1 (Member Search) + Step 2 (Facility + Existing Loans)
 * ----------------------------------------------------------------------------
 * Design goals:
 *  - Keep wizardState GLOBAL (Step 3 depends on it)
 *  - Avoid duplicated handlers / duplicate state blocks (your current file has duplicates)
 *  - Provide small modules for maintainability
 *  - Provide defensive parsing (supports camelCase + PascalCase payloads)
 *
 * Dependencies:
 *  - jQuery
 *  - DOM elements: #txtMemberSearch, #btnMemberSearch, #memberResults, #memberEmpty, #searchStatus
 *  - Step panels: #panelSearch, #panelFacility, #panelApplication
 *  - Stepper: #stepSearch, #stepFacility, #stepApplication
 *  - Existing loans containers: #existingLoansWrap, #existingLoansEmpty (and optional #existingLoansHint)
 *
 * Step 3 contract:
 *  - window.wizardState must exist
 *  - This script sets:
 *      wizardState.memberId, wizardState.member
 *      wizardState.facility
 *      wizardState.restructureMode
 *      wizardState.oldLoanId
 *      wizardState.oldLoan (normalized object)
 *      wizardState.loansById (lookup)
 *      wizardState.oldLoanProductId, oldLoanAmount, oldLoanBalance (optional extra)
 *  - This script will call one of these if present:
 *      window.tscLoanApp.init() OR window.tscLoanApp.show() OR window.initApplicationUi()
 */
(function (window, $) {
    "use strict";

    // =========================================================================
    // 0) CONFIG
    // =========================================================================
    // Prefer reading routes from #loanUiRoutes (best practice) but fallback to Razor vars
    var Routes = (function () {
        var $r = $("#loanUiRoutes");
        // NOTE: in your HTML you had a small markup issue (style="display:none;" inside the div tag)
        // This script still reads attributes safely if they exist.

        function attr(name, fallback) {
            if (!$r.length) return fallback;
            return $r.attr(name) || fallback;
        }

        return {
            searchMembers: '@Url.Action("SearchMembers", "LoanManagement")',
            getMemberLoans: attr("data-loans-url", '@Url.Action("GetMemberLoans", "LoanManagement")')
        };
    })();

    var Config = {
        debounceMs: 350,

        // Member Reference rule:
        // You requested: "Member reference must be constraint to 10 only, once 10 launch search"
        memberRefLen: 10,

        // If your reference is strictly numeric, switch to: /^\d{10}$/
        memberRefRegex: /^[A-Za-z0-9]{10}$/
    };

    // =========================================================================
    // 1) GLOBAL STATE (DO NOT BREAK STEP 3)
    // =========================================================================
    // ✅ Keep wizardState GLOBAL so Step 3 script can read it
    window.wizardState = window.wizardState || {
        memberId: null,
        member: null,

        facility: null,         // CLASSIC | SSF | OVERDRAFT | LOC
        restructureMode: null,  // null | REFINANCE | RESCHEDULE
        oldLoanId: null,

        // Optional extra fields used by some Step 3 flows
        oldLoanProductId: null,
        oldLoanAmount: 0,
        oldLoanBalance: 0,

        // Runtime lookups
        loansById: {}
    };

    var wizardState = window.wizardState;

    // =========================================================================
    // 2) UTILS
    // =========================================================================
    var Utils = (function () {

        function escapeHtml(s) {
            return (s || "").toString().replace(/[&<>"']/g, function (c) {
                return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]);
            });
        }

        // get prop supporting camelCase OR PascalCase
        function gp(o, camel, pascal, fallback) {
            if (!o) return fallback;
            var v = o[camel];
            if (v !== undefined && v !== null && v !== "") return v;
            v = o[pascal];
            if (v !== undefined && v !== null && v !== "") return v;
            return fallback;
        }

        function normalizeQuery(q) {
            q = (q || "").toString().trim();
            q = q.replace(/\s+/g, ""); // remove spaces
            return q;
        }

        function isValidMemberRef(q) {
            q = (q || "");
            return q.length === Config.memberRefLen && Config.memberRefRegex.test(q);
        }

        function toNum(v, fallback) {
            var n = Number(v);
            return isNaN(n) ? (fallback || 0) : n;
        }

        function fmtMoney(v, currency) {
            var n = toNum(v, 0);
            return n.toLocaleString() + " " + (currency || "FCFA");
        }

        function safeDateText(rawDate) {
            if (!rawDate) return "";
            var dt = new Date(rawDate);
            if (isNaN(dt.getTime())) return "";
            return dt.toLocaleDateString();
        }

        return {
            escapeHtml: escapeHtml,
            gp: gp,
            normalizeQuery: normalizeQuery,
            isValidMemberRef: isValidMemberRef,
            toNum: toNum,
            fmtMoney: fmtMoney,
            safeDateText: safeDateText
        };
    })();

    // =========================================================================
    // 3) API
    // =========================================================================
    var Api = (function () {

        function searchMembers(ref10) {
            return $.ajax({
                url: Routes.searchMembers,
                method: "GET",
                data: { q: ref10 },
                cache: false
            });
        }

        function getMemberLoans(memberId) {
            return $.ajax({
                url: Routes.getMemberLoans,
                method: "GET",
                data: { memberId: memberId },
                cache: false
            });
        }

        return {
            searchMembers: searchMembers,
            getMemberLoans: getMemberLoans
        };
    })();

    // =========================================================================
    // 4) UI HELPERS
    // =========================================================================
    var UI = (function () {

        function setLoading(isLoading) {
            $("#searchStatus").toggle(!!isLoading);
        }

        function setEmpty(show) {
            $("#memberEmpty").toggle(!!show);
        }

        function clearResults() {
            $("#memberResults").empty();
        }

        function showPanel(panelIdToShow) {
            // Keep it simple: hide known panels
            $("#panelSearch").hide();
            $("#panelFacility").hide();
            $("#panelApplication").hide();

            $(panelIdToShow).show();
        }

        function setStepActive(stepIdActive) {
            // Basic stepper states: active / done
            $("#stepSearch, #stepFacility, #stepApplication, #stepReview")
                .removeClass("active");

            $(stepIdActive).addClass("active");
        }

        function markStepDone(stepId) {
            $(stepId).removeClass("active").addClass("done");
        }

        function unDoneStep(stepId) {
            $(stepId).removeClass("done");
        }

        function setProceedEnabled(enabled) {
            $("#btnProceedToApplication").prop("disabled", !enabled);
        }

        function resetFacilitySelection() {
            $(".facility-tile").removeClass("selected");
        }

        return {
            setLoading: setLoading,
            setEmpty: setEmpty,
            clearResults: clearResults,
            showPanel: showPanel,
            setStepActive: setStepActive,
            markStepDone: markStepDone,
            unDoneStep: unDoneStep,
            setProceedEnabled: setProceedEnabled,
            resetFacilitySelection: resetFacilitySelection
        };
    })();

    // =========================================================================
    // 5) MEMBER SEARCH (STEP 1)
    // =========================================================================
    var MemberSearch = (function () {
        var timer = null;
        var lastQuery = "";

        /**
         * Render member list cards.
         * We store a normalized object in data-member for easy selection.
         */
        function renderMembers(items) {
            var $wrap = $("#memberResults");
            $wrap.empty();

            if (!items || !items.length) {
                // show empty only when user attempted valid length
                UI.setEmpty(lastQuery.length === Config.memberRefLen);
                return;
            }

            UI.setEmpty(false);

            function val(v) {
                return (v !== null && v !== undefined && String(v).trim() !== "") ? String(v).trim() : "";
            }

            items.forEach(function (m) {

                // Normalize (supports camelCase + PascalCase)
                var id = Utils.gp(m, "id", "Id") ||
                         Utils.gp(m, "memberId", "MemberId") ||
                         Utils.gp(m, "customerId", "CustomerId");

                var name = val(Utils.gp(m, "name", "Name"));
                var code = val(Utils.gp(m, "code", "Code"));

                var phone = val(Utils.gp(m, "phoneNumber", "PhoneNumber"));
                var branchName = val(Utils.gp(m, "branchName", "BranchName"));
                var branchCode = val(Utils.gp(m, "branchCode", "BranchCode"));

                var balance = Utils.toNum(Utils.gp(m, "balance", "Balance", 0), 0);
                var currency = val(Utils.gp(m, "currency", "Currency")) || "FCFA";

                var payload = {
                    id: id,
                    name: name,
                    code: code,
                    phoneNumber: phone,
                    branchName: branchName,
                    branchCode: branchCode,
                    balance: balance,
                    currency: currency
                };

                var phoneText = phone || "Phone not available";
                var branchText = branchName
                    ? (branchName + (branchCode ? (" (" + branchCode + ")") : ""))
                    : "Branch not available";

                var cardHtml =
                    '<div class="member-card" data-member="' + Utils.escapeHtml(JSON.stringify(payload)) + '">' +
                        '<div class="member-left">' +
                            '<div class="avatar"><i class="mdi mdi-account-outline"></i></div>' +
                            '<div style="min-width:0;">' +
                                '<p class="member-name mb-1">' + Utils.escapeHtml(name) + "</p>" +
                                '<div class="member-meta d-flex flex-wrap gap-3">' +
                                    '<span><i class="mdi mdi-identifier text-muted me-1"></i>' + Utils.escapeHtml(code) + "</span>" +
                                    '<span><i class="mdi mdi-phone-outline text-muted me-1"></i>' + Utils.escapeHtml(phoneText) + "</span>" +
                                "</div>" +
                                '<div class="member-meta mt-1">' +
                                    '<span><i class="mdi mdi-bank-outline text-muted me-1"></i>' + Utils.escapeHtml(branchText) + "</span>" +
                                "</div>" +
                            "</div>" +
                        "</div>" +
                        '<div class="balance-box">' +
                            '<div class="balance-label">Balance</div>' +
                            '<div class="balance-value">' + balance.toLocaleString() + " " + Utils.escapeHtml(currency) + "</div>" +
                        "</div>" +
                    "</div>";

                $wrap.append(cardHtml);
            });
        }

        /**
         * Executes search ONLY when reference length == 10.
         */
        function doSearch(q) {
            lastQuery = q || "";
            UI.clearResults();
            UI.setEmpty(false);

            if (!q || q.length !== Config.memberRefLen) return;

            if (!Utils.isValidMemberRef(q)) {
                UI.setEmpty(true);
                return;
            }

            UI.setLoading(true);

            Api.searchMembers(q)
                .done(function (res) {
                    // support shapes: {success,data}, {Data}, array...
                    var items =
                        (res && (res.data || res.Data || res.items || res.Items || res.result || res.Result)) ||
                        (Array.isArray(res) ? res : []);

                    renderMembers(items);
                })
                .fail(function () {
                    renderMembers([]);
                })
                .always(function () {
                    UI.setLoading(false);
                });
        }

        function wireEvents() {
            // Input typing (debounced)
            $("#txtMemberSearch")
                .off("input.tscMemberSearch")
                .on("input.tscMemberSearch", function () {
                    var q = Utils.normalizeQuery($(this).val());
                    $(this).val(q);

                    // Reset UI hints when shorter than 10
                    if (!q || q.length < Config.memberRefLen) {
                        UI.setLoading(false);
                        UI.setEmpty(false);
                        UI.clearResults();
                    }

                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        doSearch(q);
                    }, Config.debounceMs);
                });

            // Search button
            $("#btnMemberSearch")
                .off("click.tscMemberSearch")
                .on("click.tscMemberSearch", function () {
                    var q = Utils.normalizeQuery($("#txtMemberSearch").val());
                    $("#txtMemberSearch").val(q);
                    doSearch(q);
                });

            // Select member card
            $("#memberResults")
                .off("click.tscMemberPick", ".member-card")
                .on("click.tscMemberPick", ".member-card", function () {
                    var raw = $(this).attr("data-member");
                    if (!raw) return;

                    var member = null;
                    try { member = JSON.parse(raw); } catch (e) { member = null; }
                    if (!member || !member.id) return;

                    FacilityStep.goToFacility(member);
                });
        }

        return {
            wireEvents: wireEvents
        };
    })();

    // =========================================================================
    // 6) FACILITY + EXISTING LOANS (STEP 2)
    // =========================================================================
    var FacilityStep = (function () {

        function setMemberHeader(member) {
            var name = Utils.gp(member, "name", "Name", "") || "";
            var code = Utils.gp(member, "code", "Code", "") || "";
            var phone = Utils.gp(member, "phoneNumber", "PhoneNumber", "") ||
                        Utils.gp(member, "phone", "Phone", "") || "";
            var branchName = Utils.gp(member, "branchName", "BranchName", "") || "";
            var branchCode = Utils.gp(member, "branchCode", "BranchCode", "") || "";
            var balance = Utils.gp(member, "balance", "Balance", 0);
            var currency = Utils.gp(member, "currency", "Currency", "FCFA") || "FCFA";

            var phoneText = phone ? phone : "Phone not available";
            var branchText = branchName
                ? (branchName + (branchCode ? (" (" + branchCode + ")") : ""))
                : "Branch not available";

            var balText = (!isNaN(Number(balance)))
                ? (Number(balance).toLocaleString() + " " + currency)
                : ("0 " + currency);

            $("#selectedMemberHeader").html(
                '<div class="card border-0 shadow-sm" style="border-radius:14px;">' +
                    '<div class="card-body py-3">' +
                        '<div class="d-flex align-items-center justify-content-between flex-wrap gap-3">' +

                            '<div class="d-flex align-items-center gap-3">' +
                                '<div class="avatar" style="width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eef3ff;">' +
                                    '<i class="mdi mdi-account text-primary" style="font-size:22px;"></i>' +
                                "</div>" +

                                '<div style="min-width:0;">' +
                                    '<div class="fw-bold" style="font-size:18px; color: var(--tsc-text);">' +
                                        Utils.escapeHtml(name) +
                                    "</div>" +

                                    '<div class="text-muted small d-flex flex-wrap gap-3 mt-1">' +
                                        '<span><i class="mdi mdi-identifier text-muted me-1"></i>' + Utils.escapeHtml(code) + "</span>" +
                                        '<span><i class="mdi mdi-phone-outline text-muted me-1"></i>' + Utils.escapeHtml(phoneText) + "</span>" +
                                        '<span><i class="mdi mdi-bank-outline text-muted me-1"></i>' + Utils.escapeHtml(branchText) + "</span>" +
                                    "</div>" +
                                "</div>" +
                            "</div>" +

                            '<div class="text-end">' +
                                '<div class="text-muted small">Balance</div>' +
                                '<div class="fw-bold" style="font-size:16px;">' + Utils.escapeHtml(balText) + "</div>" +
                            "</div>" +

                        "</div>" +
                    "</div>" +
                "</div>"
            );
        }

        function resetStep2Selections() {
            wizardState.facility = null;
            wizardState.restructureMode = null;
            wizardState.oldLoanId = null;
            wizardState.oldLoan = null;

            // optional fields
            wizardState.oldLoanProductId = null;
            wizardState.oldLoanAmount = 0;
            wizardState.oldLoanBalance = 0;

            UI.resetFacilitySelection();
            UI.setProceedEnabled(false);
        }

        function goToFacility(member) {
            if (!member || !member.id) return;

            // State
            wizardState.memberId = member.id;
            wizardState.member = member;

            resetStep2Selections();

            // Stepper + panels
            UI.markStepDone("#stepSearch");
            UI.setStepActive("#stepFacility");
            UI.showPanel("#panelFacility");

            setMemberHeader(member);

            // Load existing loans automatically
            Loans.load(member.id);
        }

        function goBackToSearch() {
            // Stepper
            UI.unDoneStep("#stepSearch");
            UI.setStepActive("#stepSearch");

            // Panels
            UI.showPanel("#panelSearch");
        }

        function wireEvents() {
            // Back
            $("#btnBackToSearch")
                .off("click.tscBackToSearch")
                .on("click.tscBackToSearch", goBackToSearch);

            // Facility tiles selection
            $("#panelFacility")
                .off("click.tscFacilityPick", ".facility-tile")
                .on("click.tscFacilityPick", ".facility-tile", function () {

                    // Choosing facility means NOT restructuring old loan
                    wizardState.facility = String($(this).data("facility") || "").toUpperCase();
                    wizardState.restructureMode = null;
                    wizardState.oldLoanId = null;
                    wizardState.oldLoan = null;

                    // optional extras reset
                    wizardState.oldLoanProductId = null;
                    wizardState.oldLoanAmount = 0;
                    wizardState.oldLoanBalance = 0;

                    UI.resetFacilitySelection();
                    $(this).addClass("selected");

                    UI.setProceedEnabled(true);
                });

            // Refinance/Reschedule buttons (in loan cards)
            $("#panelFacility")
                .off("click.tscLoanRestructure", ".btnRefinance, .btnReschedule")
                .on("click.tscLoanRestructure", ".btnRefinance, .btnReschedule", function () {

                    var loanId = String($(this).data("loanid") || "");
                    if (!loanId) return;

                    wizardState.oldLoanId = loanId;
                    wizardState.restructureMode = $(this).hasClass("btnRefinance") ? "REFINANCE" : "RESCHEDULE";

                    // Attach full normalized loan object (for Step 3)
                    wizardState.oldLoan = (wizardState.loansById && wizardState.loansById[loanId])
                        ? wizardState.loansById[loanId]
                        : null;

                    // Restructure means facility tile cleared
                    wizardState.facility = null;
                    UI.resetFacilitySelection();

                    // Optional extras for Step 3 convenience
                    if (wizardState.oldLoan) {
                        wizardState.oldLoanProductId = wizardState.oldLoan.loanProductId || wizardState.oldLoan.LoanProductId || null;
                        wizardState.oldLoanAmount = Utils.toNum(wizardState.oldLoan.amount || wizardState.oldLoan.Amount || 0, 0);
                        wizardState.oldLoanBalance = Utils.toNum(wizardState.oldLoan.balance || wizardState.oldLoan.Balance || 0, 0);
                    }

                    UI.setProceedEnabled(true);

                    // Highlight selected card
                    $(".loan-card").css("border-color", "var(--tsc-border)").css("background", "#fff");
                    $(this).closest(".loan-card")
                        .css("border-color", "rgba(37,99,235,.35)")
                        .css("background", "rgba(37,99,235,.05)");

                    // Optional: live update Step 3 if already loaded
                    if (window.tscLoan && typeof window.tscLoan.setOldLoan === "function" && wizardState.oldLoan) {
                        window.tscLoan.setOldLoan(wizardState.oldLoan);
                    }
                });

            // Proceed to Step 3 (Application)
            $("#btnProceedToApplication")
                .off("click.tscProceed")
                .on("click.tscProceed", function () {

                    if (!wizardState.memberId) {
                        alert("Select a member first.");
                        return;
                    }

                    // Must have either facility OR restructure mode
                    if (!wizardState.restructureMode && !wizardState.facility) {
                        alert("Select a facility (Classic / SSF / Overdraft / LOC) OR choose refinance/reschedule on a loan.");
                        return;
                    }

                    // Stepper + panels
                    UI.markStepDone("#stepFacility");
                    UI.setStepActive("#stepApplication");
                    UI.showPanel("#panelApplication");

                    // Step 3 init hooks (do not break existing Step 3 script)
                    if (window.tscLoanApp && typeof window.tscLoanApp.init === "function") {
                        window.tscLoanApp.init();
                        return;
                    }
                    if (window.tscLoanApp && typeof window.tscLoanApp.show === "function") {
                        window.tscLoanApp.show();
                        return;
                    }
                    if (typeof window.initApplicationUi === "function") {
                        window.initApplicationUi();
                        return;
                    }

                    console.warn("Step 3 init function not found. Ensure Step 3 application script is loaded after this script.");
                });
        }

        return {
            wireEvents: wireEvents,
            goToFacility: goToFacility
        };
    })();

    // =========================================================================
    // 7) LOANS RENDERING (Step 2)
    // =========================================================================
    var Loans = (function () {

        function parseLoansResponse(res) {
            return (res && (res.data || res.Data || res.items || res.Items || res.result || res.Result))
                || (Array.isArray(res) ? res : []);
        }

        function sortNewestFirst(items) {
            // Supports multiple possible date fields
            return (items || []).slice().sort(function (a, b) {
                function getDate(x) {
                    var v =
                        (x && (x.createdOn || x.CreatedOn)) ||
                        (x && (x.disbursementDate || x.DisbursementDate)) ||
                        (x && (x.startDate || x.StartDate)) ||
                        (x && (x.applicationDate || x.ApplicationDate)) ||
                        (x && (x.updatedOn || x.UpdatedOn)) ||
                        null;

                    if (!v) return 0;
                    var t = new Date(v).getTime();
                    return isNaN(t) ? 0 : t;
                }
                return getDate(b) - getDate(a);
            });
        }

        /**
         * Normalize a loan object so Step 3 reads consistent fields.
         */
        function normalizeLoan(l) {
            function pick(camel, pascal, fallback) {
                return Utils.gp(l, camel, pascal, fallback);
            }

            var id = String(pick("id", "Id", ""));
            var name = pick("name", "Name", "Loan");
            var code = pick("code", "Code", pick("loanId", "LoanId", ""));
            var status = pick("status", "Status", "Active");

            var currency = pick("currency", "Currency", "FCFA");
            var amount = Utils.toNum(pick("amount", "Amount", 0), 0);
            var balance = Utils.toNum(pick("balance", "Balance", 0), 0);

            var accrualInterest = Utils.toNum(pick("accrualInterest", "AccrualInterest", 0), 0);
            var vat = Utils.toNum(pick("vat", "VAT", pick("Vat", "Vat", 0)), 0);
            var penalty = Utils.toNum(pick("penalty", "Penalty", 0), 0);

            var delinquentInterest = Utils.toNum(pick("delinquentInterest", "DelinquentInterest", 0), 0);
            var delinquentAmount = Utils.toNum(pick("delinquentAmount", "DelinquentAmount", 0), 0);
            var delinquentDays = Utils.toNum(pick("delinquentDays", "DelinquentDays", 0), 0);

            var totalDue = Utils.toNum(pick("totalDueAmount", "TotalDueAmount", 0), 0);

            var rawDate =
                pick("createdOn", "CreatedOn", null) ||
                pick("disbursementDate", "DisbursementDate", null) ||
                pick("startDate", "StartDate", null) ||
                pick("applicationDate", "ApplicationDate", null) ||
                null;

            var dateText = Utils.safeDateText(rawDate);

            // also keep common ids for Step 3
            var loanProductId = pick("loanProductId", "LoanProductId", null);
            var facility = (pick("facility", "Facility", "") || "").toString().toUpperCase();

            return {
                id: id,
                name: name,
                code: code,
                status: status,

                currency: currency,
                amount: amount,
                balance: balance,

                accrualInterest: accrualInterest,
                vat: vat,
                penalty: penalty,

                delinquentInterest: delinquentInterest,
                delinquentAmount: delinquentAmount,
                delinquentDays: delinquentDays,

                totalDueAmount: totalDue,
                rawDate: rawDate,
                dateText: dateText,

                loanProductId: loanProductId,
                facility: facility,

                raw: l
            };
        }

        function statusPillClass(status) {
            var s = (status || "").toLowerCase();
            if (s.includes("delinq")) return "delinquent";
            if (s.includes("close")) return "closed";
            return "active";
        }

        function render(items) {
            var $wrap = $("#existingLoansWrap");
            $wrap.empty().addClass("loan-grid-wrap");

            // Reset lookup each render
            wizardState.loansById = {};

            if (!items || !items.length) {
                $("#existingLoansEmpty").show();
                return;
            }
            $("#existingLoansEmpty").hide();

            items.forEach(function (lRaw) {
                var loan = normalizeLoan(lRaw);
                wizardState.loansById[String(loan.id)] = loan;

                var pillClass = statusPillClass(loan.status);

                var delinquencyNote = "";
                if ((loan.delinquentDays || 0) > 0 || (loan.delinquentAmount || 0) > 0) {
                    delinquencyNote =
                        '<div class="small mt-2" style="color: rgba(180,83,9,1);">' +
                            '<i class="mdi mdi-alert-circle-outline me-1"></i>' +
                            "Delinquency detected (" + Number(loan.delinquentDays || 0).toLocaleString() + " days)" +
                        "</div>";
                }

                $wrap.append(
                    '<div class="loan-card" data-loanid="' + Utils.escapeHtml(String(loan.id)) + '">' +
                        '<div class="loan-header">' +
                            '<div style="min-width:0;">' +
                                '<p class="loan-title">' + Utils.escapeHtml(String(loan.name)) + "</p>" +
                                '<div class="loan-sub">' +
                                    "<span><strong>Loan ID:</strong> " + Utils.escapeHtml(String(loan.code)) + "</span>" +
                                    (loan.dateText ? ('<span class="dot">•</span><span><strong>Date:</strong> ' + Utils.escapeHtml(loan.dateText) + "</span>") : "") +
                                "</div>" +
                            "</div>" +
                            '<span class="status-pill ' + pillClass + '">' + Utils.escapeHtml(String(loan.status)) + "</span>" +
                        "</div>" +

                        '<div class="loan-metrics">' +
                            '<div class="metric"><div class="k">Loan Amount</div><div class="v">' + Utils.fmtMoney(loan.amount, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Outstanding Balance</div><div class="v">' + Utils.fmtMoney(loan.balance, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Accrual Interest</div><div class="v">' + Utils.fmtMoney(loan.accrualInterest, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">VAT</div><div class="v">' + Utils.fmtMoney(loan.vat, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Penalty</div><div class="v">' + Utils.fmtMoney(loan.penalty, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Delinquent Interest</div><div class="v">' + Utils.fmtMoney(loan.delinquentInterest, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Delinquent Amount</div><div class="v">' + Utils.fmtMoney(loan.delinquentAmount, loan.currency) + "</div></div>" +
                            '<div class="metric"><div class="k">Delinquent Days</div><div class="v">' + Number(loan.delinquentDays || 0).toLocaleString() + " days</div></div>" +

                            '<div class="metric due" title="Balance + Accrual Interest + VAT + Penalty + Delinquent Interest + Delinquent Amount">' +
                                '<div class="k">Total Due Amount</div>' +
                                '<div class="v">' + Utils.fmtMoney(loan.totalDueAmount, loan.currency) + "</div>" +
                            "</div>" +
                        "</div>" +

                        delinquencyNote +

                        '<div class="loan-footer">' +
                            '<div class="loan-actions" data-loanid="' + Utils.escapeHtml(String(loan.id)) + '">' +
                                '<button type="button" class="btn btn-soft btn-soft-primary btnRefinance" data-loanid="' + Utils.escapeHtml(String(loan.id)) + '" data-mode="REFINANCE">Refinance</button>' +
                                '<button type="button" class="btn btn-soft btn-soft-warn btnReschedule" data-loanid="' + Utils.escapeHtml(String(loan.id)) + '" data-mode="RESCHEDULE">Reschedule</button>' +
                            "</div>" +
                            (loan.dateText ? ('<div class="loan-date">Most recent: ' + Utils.escapeHtml(loan.dateText) + "</div>") : '<div class="loan-date"></div>') +
                        "</div>" +
                    "</div>"
                );
            });
        }

        function load(memberId) {
            if (!memberId) {
                $("#existingLoansWrap").empty().addClass("loan-grid-wrap");
                $("#existingLoansEmpty").show();
                return;
            }

            // Optional hint element (only if you have it)
            if ($("#existingLoansHint").length) $("#existingLoansHint").text("Loading member loans…");

            $("#existingLoansEmpty").hide();
            $("#existingLoansWrap")
                .addClass("loan-grid-wrap")
                .html('<div class="tsc-empty" style="grid-column: 1 / -1;"><span class="tsc-spinner me-2"></span> Loading loans...</div>');

            Api.getMemberLoans(memberId)
                .done(function (res) {
                    var items = parseLoansResponse(res);
                    items = sortNewestFirst(items);
                    render(items);

                    if ($("#existingLoansHint").length) {
                        $("#existingLoansHint").text(items.length ? "Select refinance/reschedule if needed." : "No active loans.");
                    }
                })
                .fail(function (xhr) {
                    console.error("GetMemberLoans FAILED:", xhr && xhr.status, xhr && xhr.responseText);
                    $("#existingLoansWrap").empty().addClass("loan-grid-wrap");
                    $("#existingLoansEmpty").show();
                    if ($("#existingLoansHint").length) $("#existingLoansHint").text("Failed to load loans.");
                });
        }

        return {
            load: load
        };
    })();

    // =========================================================================
    // 8) INIT (wire everything once)
    // =========================================================================
    function init() {
        // Ensure starting state is Step 1 (Search)
        UI.setStepActive("#stepSearch");
        UI.showPanel("#panelSearch");

        MemberSearch.wireEvents();
        FacilityStep.wireEvents();
    }

    // DOM ready
    $(init);

})(window, jQuery);
    </script>



    <script type="text/template" id="tplGuarantorCard">
        <div class="col-12" data-gid="{{gid}}">
            <div class="card border-0 shadow-sm">
