                // -----------------------------
                function facilityHint(modeValue) {
                    if (modeValue === "OVERDRAFT") {
                        return "Recommended: link to salary/regular income, set limit within policy, and enforce auto-recovery from inflows.";
                    }
                    if (modeValue === "LOC") {
