                    '<div class="d-flex justify-content-between"><span class="text-muted">Guarantor</span><span class="fw-bold">' + (payload.HasGuarantor ? "Yes" : "No") + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Collateral</span><span class="fw-bold">' + (payload.HasCollateral ? "Yes" : "No") + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Loan Documents Required</span><span class="fw-bold">' + (payload.RequiresDocuments ? "Yes" : "No") + '</span></div>' +

                    '<div class="tsc-divider my-2"></div>' +

                    '<div class="d-flex justify-content-between"><span class="text-muted">Savings Coverage Amount</span><span class="fw-bold">' + money(payload.SavingsCoverageAmount) + '</span></div>' +
                    '<div class="d-flex justify-content-between"><span class="text-muted">Share required amount</span><span class="fw-bold">' + money(payload.SavingsCoverageRate) + '</span></div>' +

                    (payload.DocumentNotes ? ('<div class="mt-2"><div class="text-muted small">Document Notes</div><div class="fw-semibold">' + esc(payload.DocumentNotes) + '</div></div>') : '') +

                    '<div class="tsc-divider my-3"></div>' +
                    '<div class="fw-bold mb-1">Recovery Accounts</div>' + listHtml(recoveryAccTexts)
                );

                renderDocsReview();
                renderScoringReview();

                var $rec = $("#reviewRecovery");
                $rec.empty();

                if (!payload.HasRecoveryMechanism || !payload.RecoveryAccounts.length) {
                    $rec.html('<div class="text-muted small">No recovery mechanism selected.</div>');
                    return;
