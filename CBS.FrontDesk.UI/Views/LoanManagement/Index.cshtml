            // =====================================================
            // ✅ Mode rules: RESCHEDULE minimal fields + Overdraft/LOC datasets
            // =====================================================
            function applyModeUiRules() {
                var mode = (wizardState.restructureMode || "NEW").toUpperCase();
                var facility = wizardState.facility || "";

                // show facility-specific datasets
                var facUpper = String(facility || "").toUpperCase();
                $("#overdraftFieldsCard").toggle(facUpper === "OVERDRAFT");
                $("#locFieldsCard").toggle(facUpper === "LOC" || facUpper === "LINEOFCREDIT" || facUpper === "LINE_OF_CREDIT");

                var isReschedule = (mode === "RESCHEDULE");
