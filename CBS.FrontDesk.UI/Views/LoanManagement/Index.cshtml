                    var note = pick(cmd, ["Note", "note"], "");

                    var title = mode + " CONFIRMATION"; // ✅ e.g., "RESCHEDULE CONFIRMATION"

                    return (
                        '<div style="font-size:13px;line-height:1.35;text-align:left;">' +
                        '<div style="font-weight:800;margin-bottom:8px;text-transform:uppercase;">' + esc(title) + '</div>' +

                        '<div style="font-weight:700;margin-bottom:8px;">Confirm Loan Reschedule</div>' +

