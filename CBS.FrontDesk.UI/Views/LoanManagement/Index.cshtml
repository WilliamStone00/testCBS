                    dlRow("Ordinary Shares Provided", '<span class="fw-bold">' + money(req.OrdinarySharesAmountProvided || 0) + '</span>') +
                    dlRow("Total Downpayment Provided", '<span class="fw-bold">' + money(req.TotalDownpaymentAmountProvided || 0) + '</span>') +
                    (req.DocumentNotes ? ('<div class="mt-2"><div class="text-muted small">Document Notes</div><div class="fw-semibold">' + esc(req.DocumentNotes) + '</div></div>') : '') +

                    '<div class="tsc-divider my-3"></div>' +

                    sectionTitle("mdi mdi-account-group-outline", "Security Parties (Counts)") +
                    divider() +
                    '<div class="small text-muted">Moral Guarantors: <b>' + mg.length +
                    '</b> • Coobligors: <b>' + co.length +
                    '</b> • Shotees: <b>' + sh.length +
                    '</b> • Inter-Cooperations: <b>' + ic.length +
                    '</b> • Collaterals: <b>' + col.length + '</b></div>' +

                    '<div class="tsc-divider my-3"></div>' +

                    sectionTitle("mdi mdi-lock-outline", "Recovery Blocks (Summary)") +
                    divider() +
                    dlRow("Enabled", recEnabled ? badge("YES", "bg-success") : badge("NO", "bg-secondary")) +
                    dlRow("Accounts", '<span class="fw-bold">' + blocks.length + '</span>') +
                    dlRow("Total Blocked", '<span class="fw-bold">' + money(blockedTotal) + '</span>') +

                    '</div></div>'
                );

                // --------------------------
                // DOCUMENTS PREVIEW (already uses DTO)
                // --------------------------
                renderDocsReviewFromDto(req.Documents || []);

                // --------------------------
                // SCORING DTO PREVIEW (status + insight)
                // --------------------------
                var sc2 = req.Scoring || {};
                $("#reviewScoring").html(
                    '<div class="fw-bold mb-1">Credit Scoring Status</div>' +
                    '<div class="card border-0 bg-light"><div class="card-body py-2">' +
                    dlRow("Status", '<span class="fw-bold">' + esc(sc2.StatusCaption || sc2.StatusCode || "") + '</span>') +
                    dlRow("Score", '<span class="fw-bold">' + esc(sc2.Score || 0) + '</span>') +
                    dlRow("Required", '<span class="fw-bold">' + esc(sc2.Required || 0) + '</span>') +
                    dlRow("Delta", '<span class="fw-bold">' + esc(sc2.Delta || 0) + '</span>') +
                    (sc2.Insight ? '<div class="mt-2"><div class="text-muted small">Insight</div><div class="fw-semibold">' + esc(sc2.Insight) + '</div></div>' : '') +
                    '</div></div>'
                );

                // --------------------------
                // ✅ DETAILED RECOVERY LIST (AccountNumber/Name/Decision/Amount)
                // --------------------------
                var $rec = $("#reviewRecovery");
                $rec.empty();

                if (!req.HasRecoveryMechanism || !blocks.length) {
                    $rec.html(emptyBox("No recovery mechanism selected."));
                } else {
                    var labelMap = {};
                    $("#ddlRecoveryAccounts option").each(function () { labelMap[this.value] = $(this).text(); });

                    var recRows = blocks.map(function (b) {
                        var label = (b.Label || b._Label || labelMap[b.AccountId] || "");
                        var name = (b.AccountName || "").toString().trim();
                        var accNo = (b.AccountNumber || "").toString().trim();
                        var decision = normalizeDecisionText(b);
                        return "<tr>" +
                            cell(label || name || b.AccountId) +
                            cell(accNo) +
                            cell(decision) +
                            cellMoney(b.BlockAmount || 0) +
                            "</tr>";
                    });

                    $rec.html(
                        '<div class="card border-0 bg-light">' +
                        '<div class="card-body py-2">' +
                        sectionTitle("mdi mdi-lock-outline", "Recovery Accounts (Details)") +
                        divider() +
                        renderTable(["Account (Label/Name)", "Account No", "Decision", "Block Amount"], recRows) +
                        '</div>' +
                        '</div>'
                    );
                }

                // --------------------------
                // ✅ DETAILED SECURITY PARTIES (ALL user-entered fields)
                // --------------------------
                function renderMoralGuarantors(list) {
                    list = safeArr(list);
                    if (!list.length) return emptyBox("No moral guarantors.");
                    var rows = list.map(function (g) {
                        return "<tr>" +
                            cell(g.CompanyOrGroupName || "") +
                            cell(g.IdCardNumber || "") +
                            cell(g.IssueDate || "") +
                            cell(g.ExpireDate || "") +
                            cell(g.Relationship || "") +
                            cell(g.PhoneNumber || "") +
                            cellMoney(g.GuaranteeAmount || 0) +
                            "</tr>";
                    });
                    return renderTable(["Company/Group", "ID Card", "Issue", "Expire", "Relationship", "Phone", "Guarantee"], rows);
                }

                function renderMemberGuarantors(list, title) {
                    list = safeArr(list);
                    if (!list.length) return emptyBox("None.");

                    var rows = list.map(function (g) {
                        return "<tr>" +
                            cell(g.MemerberName || "") +
                            cell(g.MemerberReference || "") +
                            cell(g.Relationship || "") +
                            cell(g.PhoneNumber || "") +

                            // ✅ ReleaseOrder now correctly displayed
                            cell(g.ReleaseOrder || "") +

                            cell(g.AccountNumber || g.AccountId || "") +
                            cellBool(!!g.BlockAccount) +
                            cellMoney(g.Amount || 0) +
                            cellMoney(g.GuaranteeAmount || 0) +
                            "</tr>";
                    });

                    // ✅ FIXED: header now has 9 columns (matches rows)
                    return renderTable(
                        ["Member", "Ref", "Relationship", "Phone", "Release Order", "Account", "Block", "Block Amt", "Guarantee"],
                        rows
                    );
                }


                function renderInterCooperations(list) {
                    list = safeArr(list);
                    if (!list.length) return emptyBox("None.");
                    var rows = list.map(function (g) {
                        return "<tr>" +
                            cell(g.MemerberName || "") +
                            cell(g.MemerberReference || "") +
                            cell(g.AffiliateOrInstitutionName || "") +
                            cell(g.PhoneNumber || "") +
                            cell(g.AccountNumber || g.AccountId || "") +
                            cellBool(!!g.BlockAccount) +
                            cellMoney(g.Amount || 0) +
                            cellMoney(g.GuaranteeAmount || 0) +
                            "</tr>";
                    });
                    return renderTable(["Member", "Ref", "Institution", "Phone", "Account", "Block", "Block Amt", "Guarantee"], rows);
                }

                function renderCollaterals(list) {
                    list = safeArr(list);
                    if (!list.length) return emptyBox("No collaterals.");
                    var rows = list.map(function (c) {
                        return "<tr>" +
                            cell(c.Name || "") +
                            cell(c.CollateraTypeId || "") +
                            cell(c.Location || "") +
                            cell(c.ReferenceNumber || "") +
                            cellMoney(c.Amount || 0) +
                            "</tr>";
                    });
                    return renderTable(["Name", "Type", "Location", "Reference", "Amount"], rows);
                }

                // Put detailed security parties under #reviewDocuments if you prefer,
                // but you asked "all payload preview here" -> we keep it in #reviewRecovery AFTER recovery list
                // so everything is visible without changing layout.
                var securityHtml =
                    '<div class="card border-0 shadow-sm mt-2">' +
                    '<div class="card-body py-2">' +
                    sectionTitle("mdi mdi-account-group", "Security Parties (Details)", "Everything the user entered for guarantors & collaterals.") +
                    divider() +

                    '<div class="fw-bold mb-1">Moral Guarantors</div>' +
                    renderMoralGuarantors(mg) +

                    '<div class="tsc-divider my-3"></div>' +
                    '<div class="fw-bold mb-1">Coobligors</div>' +
                    renderMemberGuarantors(co) +

                    '<div class="tsc-divider my-3"></div>' +
                    '<div class="fw-bold mb-1">Shotees</div>' +
                    renderMemberGuarantors(sh) +

                    '<div class="tsc-divider my-3"></div>' +
                    '<div class="fw-bold mb-1">Inter-Cooperations</div>' +
                    renderInterCooperations(ic) +

                    '<div class="tsc-divider my-3"></div>' +
                    '<div class="fw-bold mb-1">Collaterals</div>' +
                    renderCollaterals(col) +

                    '</div>' +
                    '</div>';

                // append under recovery panel (keeps existing layout, no new containers needed)
                $("#reviewRecovery").append(securityHtml);

                // Finally dump full payload to debug box (optional but very useful)
                dumpToDebugBox("FULL Payload (NEW/REFINANCE)", payload);
            }

        })();
    </script>


    <script>
        (function () {
            "use strict";
            if (!window.wizardState) return;

            // =========================
            // CONFIG / ROUTES
            // =========================
            var $routes = $("#loanUiRoutes");
            var postNewLoanUrl = $routes.data("post-new-loan-url");
            var postRefinanceUrl = $routes.data("post-refinance-url");
            var postRescheduleUrl = $routes.data("post-reschedule-url");
            var postOverdraftUrl = $routes.data("post-overdraft-url");
            var postLocUrl = $routes.data("post-loc-url");

            // =========================
            // UTILS
            // =========================
            function esc(s) {
                return (s || "").toString().replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]);
                });
            }
            function num(v) {
                if (v === null || v === undefined) return 0;
                var raw = (v + "").replace(/,/g, "").trim();
                var n = Number(raw || 0);
                return isNaN(n) ? 0 : n;
            }
            function money(v) { return num(v).toLocaleString() + " FCFA"; }

            function selectedObjects($sel) {
                if (!$sel || !$sel.length) return [];
                return $sel.find("option:selected").map(function () {
                    var $o = $(this);
                    return {
                        id: this.value,
                        text: $o.text(),
                        points: num($o.attr("data-points")),
                        amount: num($o.attr("data-amount")),
                        mode: String($o.attr("data-mode") || "")
                    };
                }).get();
            }

            function selectedTexts($sel) {
                if (!$sel || !$sel.length) return [];
                return $sel.find("option:selected").map(function () { return $(this).text(); }).get();
            }

            function listHtml(items) {
                if (!items || !items.length) return '<span class="text-muted">None</span>';
                return '<ul style="margin:0;padding-left:18px;">' + items.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") + "</ul>";
            }

            // =========================
            // VALIDATION UI HELPERS
            // =========================
            function ensureInvalidFeedback($el) {
                var $fb = $el.nextAll(".invalid-feedback").first();
                if ($fb.length) return $fb;

                // select2 support
                var $s2 = $el.next(".select2");
                if ($s2.length) {
                    $fb = $s2.nextAll(".invalid-feedback").first();
                    if ($fb.length) return $fb;
                    return $('<div class="invalid-feedback d-block"></div>').insertAfter($s2);
                }
                return $('<div class="invalid-feedback"></div>').insertAfter($el);
            }

            function markInvalid($el, msg) {
                $el.addClass("is-invalid");
                var $fb = ensureInvalidFeedback($el);
                $fb.text(msg || "This field is required.").show();
            }

            function clearInvalid($el) {
                $el.removeClass("is-invalid");
                var $fb = $el.nextAll(".invalid-feedback").first();
                if ($fb.length) $fb.hide().text("");

                var $s2 = $el.next(".select2");
                if ($s2.length) {
                    var $fb2 = $s2.nextAll(".invalid-feedback").first();
                    if ($fb2.length) $fb2.hide().text("");
                }
            }

            function scrollToFirstInvalid() {
                var $first = $(".is-invalid").first();
                if ($first.length) $("html, body").animate({ scrollTop: $first.offset().top - 120 }, 250);
            }

            function setAppHintRed(msg) {
                var $hint = $("#appModeHint");
                if (!$hint.length) return;
                $hint.removeClass("text-muted").addClass("text-danger fw-bold").text(msg || "");
            }

            // ✅ validate "policy" only if it is actually used (visible + enabled + has options)
            function isPolicyActive($policy) {
                if (!$policy || !$policy.length) return false;
                if ($policy.is(":disabled")) return false;
                if (!$policy.is(":visible")) return false;
                var optCount = $policy.find("option").length;
                if (optCount <= 1) return false;
                return true;
            }

            // =========================
            // SCORING EXTRACTORS
            // =========================
            function getTextByLabel($root, label) {
                var txt = "";
                $root.find("*").each(function () {
                    var t = ($(this).text() || "").trim();
                    if (t.toLowerCase().startsWith(label.toLowerCase())) { txt = t; return false; }
                });
                return txt;
            }

            function extractFirstInt(text) {
                var m = (text || "").match(/-?\d+/);
                return m ? parseInt(m[0], 10) : 0;
            }

            function normalizeScoreStatus(caption) {
                var c = (caption || "").toUpperCase();
                if (!c) return "UNKNOWN";
                if (c.indexOf("NO RISK") >= 0 || c.indexOf("COVERED") >= 0 || c.indexOf("PROCEED") >= 0) return "OK";
                if (c.indexOf("RISK") >= 0 || c.indexOf("WARNING") >= 0 || c.indexOf("CAUTION") >= 0) return "WARN";
                if (c.indexOf("REJECT") >= 0 || c.indexOf("NOT COVERED") >= 0 || c.indexOf("HIGH RISK") >= 0) return "FAIL";
                return "UNKNOWN";
            }

            function buildScoringSummary() {
                // Prefer explicit IDs if you add them. Otherwise fallback to parsing section.
                var $box = $("#creditScoringPanel"); // ✅ recommended wrapper id
                if (!$box.length) $box = $(".credit-scoring, #creditScoring, .card:has(h5:contains('Credit Scoring')), .card:has(h6:contains('Credit Scoring'))").first();

                // Caption (e.g. badge text)
                var caption = ($("#scoreStatusCaption").text().trim() || "");
                if (!caption && $box.length) caption = $box.find(".badge, .status-badge").first().text().trim();

                // Score/Required/Delta
                var score = num($("#scoreValue").text());
                var required = num($("#scoreRequired").text());
                var delta = num($("#scoreDelta").text());

                if ((!score && !required && !delta) && $box.length) {
                    score = extractFirstInt(getTextByLabel($box, "Score"));
                    required = extractFirstInt(getTextByLabel($box, "Required"));
                    delta = extractFirstInt(getTextByLabel($box, "Delta"));
                }

                // Insight / recommendation
                var insight = ($("#scoreInsight").text().trim() || "");
                if (!insight && $box.length) {
                    var rec = $box.find("*:contains('Recommendation')").last().text().trim();
                    insight = rec || "";
                }

                // Selected assessments points total (from select options)
                var scoreItems = selectedObjects($("#ddlScoreAssessments"));
                var totalPoints = 0;
                scoreItems.forEach(function (x) { totalPoints += (x.points || 0); });

                return {
                    StatusCaption: caption || null,
                    StatusCode: normalizeScoreStatus(caption),
                    Score: parseInt(score || 0, 10),
                    Required: parseInt(required || 0, 10),
                    Delta: parseInt(delta || 0, 10),
                    Insight: insight || null,
                    TotalSelectedPoints: parseInt(totalPoints || 0, 10)
                };
            }

            // =========================
            // DOCUMENTS (FILES + PREVIEW URL)
            // =========================
            // ✅ IMPORTANT: set the correct file input id here (your UI)
            var DOC_INPUT_SELECTOR = "#fileLoanDocuments"; // change if needed

            function buildDocumentsMeta() {
                var $file = $(DOC_INPUT_SELECTOR);
                if (!$file.length || !$file[0].files) return [];

                return Array.prototype.map.call($file[0].files, function (f, idx) {
                    // Create preview link for this session (opens in new tab)
                    var url = null;
                    try { url = URL.createObjectURL(f); } catch (e) { url = null; }

                    return {
                        Index: idx,
                        FileName: f.name,
                        ContentType: f.type || "",
                        Size: f.size || 0,
                        PreviewUrl: url
                    };
                });
            }

            // =========================
            // RECOVERY BLOCKS / DECISIONS
            // =========================
            function getRecoveryBlocks() {
                if (window.tscRecovery && typeof window.tscRecovery.getBlocks === "function") return window.tscRecovery.getBlocks() || [];

                // fallback
                var blocks = [];
                $(".recovery-block-amount").each(function () {
                    var $i = $(this);
                    var acc = $i.data("account-id") || $i.attr("data-account-id");
                    var amt = num($i.val());
                    if (acc && amt > 0) blocks.push({ AccountId: acc, BlockAmount: amt });
                });
                return blocks;
            }
            function inferAccountKindFromText(text) {
                var t = String(text || "").toLowerCase();
                // You can adjust keywords to match your labels
                if (t.includes("ordinary shares") || t.includes("shares") || t.includes("shr-")) return "SHARES";
                if (t.includes("savings") || t.includes("sav-")) return "SAVINGS";
                return "OTHER";
            }



            function computeBlockedByKind() {
                var blocks = (window.tscRecovery && window.tscRecovery.getBlocks)
                    ? window.tscRecovery.getBlocks()
                    : [];

                // Build label map from select
                var labelMap = {};
                $("#ddlRecoveryAccounts option").each(function () {
                    labelMap[this.value] = $(this).text() || "";
                });

                var sums = { SAVINGS: 0, SHARES: 0, OTHER: 0, TOTAL: 0 };

                for (var i = 0; i < blocks.length; i++) {
                    var b = blocks[i];
                    var amt = parseFloat(b.BlockAmount) || 0;
                    var label = labelMap[b.AccountId] || "";
                    var kind = inferAccountKindFromText(label);

                    sums[kind] += amt;
                    sums.TOTAL += amt;
                }

                return sums;
            }

            function getManagerDecision() {
                if (window.tscRecovery && typeof window.tscRecovery.getManagerDecision === "function") return window.tscRecovery.getManagerDecision() || [];

                // fallback
                var decisions = [];
                $(".manager-decision-select").each(function () {
                    var $s = $(this);
                    var acc = $s.data("account-id") || $s.attr("data-account-id");
                    if (!acc) return;
                    decisions.push({ AccountId: acc, Decision: ($s.val() || null), ManagerAmount: null });
                });
                return decisions;
            }

            // =========================
            // VALIDATE BEFORE REVIEW/SAVE
            // =========================
            function validateNewLoan() {
                var ok = true;

                var $loanType = $("#ddlInstitutionLoanType");
                var $product = $("#ddlLoanProduct");
                var $amount = $("#txtAmount");
                var $interest = $("#txtInterest");
                var $period = $("#ddlRepaymentPeriod");
                var $repType = $("#ddlRepaymentType");
                var $disbType = $("#ddlDisbursementType");

                [$loanType, $product, $amount, $interest, $period, $repType, $disbType].forEach(clearInvalid);

                if (!$loanType.val()) { markInvalid($loanType, "Please select an institution loan type."); ok = false; }
                if (!$product.val()) { markInvalid($product, "Please select a loan product."); ok = false; }

                var amt = num($amount.val());
                if (!amt || amt <= 0) { markInvalid($amount, "Enter a valid requested amount."); ok = false; }

                var intr = num($interest.val());
                if (!intr || intr <= 0) { markInvalid($interest, "Enter a valid interest rate."); ok = false; }

                if (!$period.val()) { markInvalid($period, "Please select a repayment period."); ok = false; }
                if (!$repType.val()) { markInvalid($repType, "Please select a repayment type."); ok = false; }
                if (!$disbType.val()) { markInvalid($disbType, "Please select a disbursement type."); ok = false; }

                // Recovery validations (policy only if active)
                if ($("#chkRecoveryMechanism").is(":checked")) {
                    var $recAcc = $("#ddlRecoveryAccounts");
                    clearInvalid($recAcc);
                    var selected = $recAcc.val() || [];
                    if (!selected.length) { markInvalid($recAcc, "Select at least one recovery account."); ok = false; }

                    var $policy = $("#ddlRecoveryPolicy");
                    if (isPolicyActive($policy)) {
                        clearInvalid($policy);
                        if (!$policy.val()) { markInvalid($policy, "Select a recovery policy."); ok = false; }
                    }

                    if (window.tscRecovery && typeof window.tscRecovery.validateBlocks === "function") {
                        if (!window.tscRecovery.validateBlocks()) ok = false;
                    }
                }

                if (!ok) {
                    setAppHintRed("Please complete the required fields highlighted in red before you can review / save.");
                    scrollToFirstInvalid();
                }

                return ok;
            }

            // clear invalid on live change
            $(document).on("change input", "#ddlInstitutionLoanType,#ddlLoanProduct,#txtAmount,#txtInterest,#ddlRepaymentPeriod,#ddlRepaymentType,#ddlDisbursementType,#ddlRecoveryAccounts,#ddlRecoveryPolicy", function () {
                clearInvalid($(this));
            });

            function getMode() {
                // prefer explicit wizardState.restructureMode
                var m = (window.wizardState && window.wizardState.restructureMode) ? window.wizardState.restructureMode : "NEW";
                m = (m || "").toUpperCase();
                if (!m) m = "NEW";
                return m;
            }

            function validateBeforePostByMode() {
                var mode = getMode();

                // RESCHEDULE: only need OldLoanId + new period
                if (mode === "RESCHEDULE") {
                    var ok = true;
                    if (!window.wizardState.oldLoanId) {
                        alertify.error("Please select the loan to reschedule.");
                        return false;
                    }
                    var $period = $("#ddlRepaymentPeriod");
                    clearInvalid($period);
                    if (!$period.val()) { markInvalid($period, "Please select the new repayment period."); ok = false; }
                    if (!ok) scrollToFirstInvalid();
                    return ok;
                }

                // Refinance/Overdraft/LOC/New: use full validation
                return validateNewLoan();
            }


            // =========================
            // BUILD PAYLOAD (NEW LOAN)  ✅ UPDATED FOR CONTROLLER
            // =========================
            window.tscLoan = window.tscLoan || {};
            // returns RefinanceLoanApplicationRequest
            window.tscLoan.buildRefinancePayload = function () {

                var newCmd = window.tscLoan.buildNewLoanPayload(); // your existing NewLoanApplicationRequest-equivalent
                newCmd.Mode = "REFINANCE";

                // OldLoanId should come from wizardState or a hidden field
                var oldLoanId = (window.wizardState && window.wizardState.oldLoanId) || $("#txtOldLoanId").val() || "";

                // Reason (UI recommended)
                var reason = ($("#txtRefinanceReason").val && $("#txtRefinanceReason").val()) ? $("#txtRefinanceReason").val() : ($("#txtReason").val ? $("#txtReason").val() : "");

                return {
                    AddLoanApplicationCommand: newCmd,
                    OldLoanId: oldLoanId,
                    Reason: reason || ""
                };
            };

            // returns RescheduleLoanApplicationRequest
            window.tscLoan.buildReschedulePayload = function () {

                var oldLoanId = (window.wizardState && window.wizardState.oldLoanId) || $("#txtOldLoanId").val() || "";

                // Remaining principal (optional input, but backend should recompute/validate)
                var remaining = num($("#txtRemainingCapitalBalance").val());

                // New duration
                var newN = parseInt(num($("#txtNewNumberOfRepayments").val()) || 0, 10);

                // Repayment circle/type
                var circle = $("#ddlRepaymentCircle").val() || $("#ddlRepaymentPeriod").val() || ""; // (Per Month/Week etc)
                var repType = $("#ddlRepaymentType").val() || "";

                var reason = ($("#txtRescheduleReason").val && $("#txtRescheduleReason").val()) ? $("#txtRescheduleReason").val() : ($("#txtReason").val ? $("#txtReason").val() : "");

                return {
                    RescheduleCommand: {
                        OldLoanId: oldLoanId,
                        RemainingCapitalBalance: remaining,
                        NewNumberOfRepayments: newN,
                        RepaymentCircle: circle,
                        RepaymentType: repType,
                        Reason: reason || ""
                    }
                };
            };


            // returns OverdraftApplicationRequest
            window.tscLoan.buildOverdraftPayload = function () {

                var scoring = buildScoringSummary();

                return {
                    AddOverdraftCommand: {
                        MemberId: (window.wizardState && window.wizardState.memberId) || "",
                        OverdraftAccount: {
                            AccountNumber: $("#ddlOverdraftAccount option:selected").text() || "",
                            AccountId: $("#ddlOverdraftAccount").val() || "",
                            AvilableBalance: num($("#txtOverdraftAvailableBalance").val()),
                            Consummed: num($("#txtOverdraftConsumed").val()),
                            AccountLimit: num($("#txtOverdraftAccountLimit").val())
                        },
                        OverdraftLimit: num($("#txtOverdraftLimit").val()),
                        InterestRate: num($("#txtOverdraftInterestRate").val()) || num($("#txtInterest").val()),
                        DurationDays: parseInt(num($("#txtOverdraftDurationDays").val()) || 0, 10),
                        Purpose: ($("#txtOverdraftPurpose").val && $("#txtOverdraftPurpose").val()) ? $("#txtOverdraftPurpose").val() : "",
                        Scoring: scoring
                    }
                };
            };


            // returns LineOfCreditApplicationRequest
            window.tscLoan.buildLineOfCreditPayload = function () {

                var scoring = buildScoringSummary();

                return {
                    AddLineOfCreditCommand: {
                        MemberId: (window.wizardState && window.wizardState.memberId) || "",
                        OverdraftAccount: {
                            AccountNumber: $("#ddlLocAccount option:selected").text() || "",
                            AccountId: $("#ddlLocAccount").val() || "",
                            AvilableBalance: num($("#txtLocAvailableBalance").val()),
                            Consummed: num($("#txtLocConsumed").val()),
                            AccountLimit: num($("#txtLocAccountLimit").val())
                        },
                        ApprovedLimit: num($("#txtLocApprovedLimit").val()),
