                    $(`.tsc-charge-cb[value="${feeId}"]`).prop("checked", false);

                    refreshChargesEditorAndSummary();
                });

                // User input validation: user >= system
                $(".tsc-charge-user").off("input blur").on("input blur", function () {
                    var $i = $(this);
                    var feeId = String($i.data("fee-id"));
                    var amount = toNum($("#txtAmount").val());

                    var rule = chargeRulesCache.find(x => String(x.Id || x.id) === feeId);
                    var sys = computeChargeValue(rule || {}, amount);

                    var v = toNum($i.val());
                    if (v < sys) {
                        v = sys;
                        $i.val(v);
                        $i.addClass("is-invalid");
                    } else {
                        $i.removeClass("is-invalid");
                    }

                    chargeUserOverrides[feeId] = v;
                    updateChargeSummaryFromSelection();
                    buildChargesSubmissionJson();
