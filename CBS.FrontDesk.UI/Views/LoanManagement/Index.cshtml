            function validateInterestLive() {
                var policy = window.productPolicy || {};
                var minI = Number(policy.minInterest || 0);
                var maxI = Number(policy.maxInterest || 0);

                var $i = $("#txtInterest");
                var raw = ($i.val() || "").trim();
                var v = parseFloat(raw);

                // allow empty while typing
                if (!raw) {
                    setInvalid($i, false);
                    return true;
                }

                var ok = !isNaN(v) && v > 0 && v >= minI && v <= maxI;

                setInvalid(
                    $i,
