                        '<div><b>Member:</b> ' + memberLine + '</div>' +
                        '<div><b>Mode:</b> RESCHEDULE</div>' +
                        '<div><b>Old Loan:</b> ' + esc(oldLoanId || "N/A") + '</div>' +
                        (reschedCapital > 0 ? '<div><b>Capital to Reschedule:</b> ' + money(reschedCapital) + '</div>' : '') +
                        '<div><b>New Period:</b> ' + esc(newPeriodMonths || "N/A") + ' months</div>' +
                        '<div><b>Grace:</b> ' + esc(newGraceMonths) + ' months</div>' +
                        (note ? ('<div style="grid-column:1 / span 2;"><b>Note:</b> ' + esc(note) + '</div>') : '') +
                        '</div>' +

                        (memberExtrasHtml ? ('<hr style="margin:10px 0;" />' + memberExtrasHtml) : '') +

                        '<hr style="margin:10px 0;" />' +
                        '<div style="color:#b02a37;font-weight:700;">⚠ ' + esc(facilityHint("RESCHEDULE")) + '</div>' +
