                        '<div class="tsc-divider my-2"></div>' +

                        '<div class="d-flex justify-content-between"><span class="text-muted">Facility</span><span class="fw-bold text-dark">' + esc(facility) + '</span></div>' +
                        '<div class="d-flex justify-content-between"><span class="text-muted">Mode</span><span class="fw-bold text-success">RESCHEDULE</span></div>' +
                        (oldId ? ('<div class="d-flex justify-content-between"><span class="text-muted">Old Loan Id</span><span class="fw-bold text-dark">' + esc(oldId) + '</span></div>') : '') +

                        '<div class="tsc-divider my-2"></div>' +

                        '<div class="d-flex justify-content-between"><span class="text-muted">Institution Loan Type</span><span class="fw-bold text-dark">' + esc(loanTypeText) + '</span></div>' +
                        '<div class="d-flex justify-content-between"><span class="text-muted">Loan Product</span><span class="fw-bold text-dark">' + esc(productText) + '</span></div>'
                    );

                    // -----------------------------
                    // RIGHT: Old loan details + New schedule terms (ONLY 3 fields + units)
                    // -----------------------------
                    var oldBlock = (oldLoan)
