            function setFieldInvalid($el, isInvalid, message) {
                if (!$el || !$el.length) return;

                // If this is a Select2 control, we must style the Select2 box (not the hidden <select>)
                var $s2 = $el.next(".select2");
                if (!$s2.length && $el.data("select2")) {
                    // sometimes select2 container isn't the immediate next sibling
                    $s2 = $el.parent().find(".select2").first();
                }

                // Error element should be placed after select2 container if present, else after the element
                var $err;
                if ($s2.length) {
                    $err = $s2.nextAll(".invalid-feedback, .field-error").first();
                    if (!$err.length) $err = $('<div class="invalid-feedback d-block"></div>').insertAfter($s2);
                } else {
                    $err = ensureFieldErrorEl($el);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    if ($s2.length) {
                        $s2.find(".select2-selection").addClass("is-invalid");
                    }
                    $err.text(message || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    if ($s2.length) {
                        $s2.find(".select2-selection").removeClass("is-invalid");
                    }
                    $err.hide().text("");
                }
            }

            function inRangeNumber(v, min, max) {
                if (v === null || v === undefined || isNaN(v)) return false;
                if (min !== null && min !== undefined && !isNaN(min) && v < min) return false;
                if (max !== null && max !== undefined && !isNaN(max) && v > max) return false;
                return true;
            }

            function buildChargesPayload() {
                var amt = Number($("#txtAmount").val() || 0);
                var selected = [];

                $("#ddlCharges option:selected").each(function () {
                    var id = this.value;
                    var charge = (chargesCache || []).find(x => String(x.Id || x.id) === String(id));
                    if (!charge) return;

                    var sys = computeSystemCharge(charge, amt);
                    var mode = String(charge.Mode || charge.mode || "").toUpperCase();
                    var calcType = String(charge.CalcType || charge.calcType || "");

                    // user editable field you render per selected charge
                    var userVal = Number($(`#chargeUser_${id}`).val() || sys);

                    // enforce rule: user cannot go below system
                    if (userVal < sys) userVal = sys;

                    selected.push({
                        FeeId: id,
                        SystemCharge: sys,
                        UserCharge: userVal,
                        Mode: mode,
                        ChargeCalcType: calcType
                    });
                });

                return selected;
            }


            $("#ddlCharges").on("change", function () {
                var before = 0, after = 0;

                $("#ddlCharges option:selected").each(function () {
                    var sys = Number($(this).attr("data-system") || 0);
                    var mode = String($(this).attr("data-mode") || "").toUpperCase();

                    if (mode.includes("BEFORE")) before += sys;
                    else after += sys;
                });

                $("#sumBefore").text(before.toLocaleString());
                $("#sumAfter").text(after.toLocaleString());
                $("#sumUpfront").text(before.toLocaleString());

                var total = before + after;
                $("#sumTotalCharges").text(total.toLocaleString());
            });


            function resetChargesSummary() {
                $("#sumBefore").text("0");
                $("#sumAfter").text("0");
                $("#sumUpfront").text("0");
                $("#upfrontHint").text("No upfront charges selected.").removeClass("text-warning").addClass("text-muted");
            }

            // =====================================================
            // Recovery Mechanism (load accounts ONLY when enabled)
            // =====================================================

            function toNum(v) { var n = Number(v); return isNaN(n) ? 0 : n; }
            function upper(s) { return String(s || "").trim().toUpperCase(); }
            function normStr(v) { return (v == null) ? "" : String(v).trim(); }
            // [DEDUPED] pick(o, camel, pascal, def) removed (use top-level pick).

            function normalizeAccount(a) {
                var id = normStr(pick(a, "id", "Id", ""));
                var type = normStr(pick(a, "accountType", "AccountType", ""));
                var number = normStr(pick(a, "accountNumber", "AccountNumber", ""));
                var name = normStr(pick(a, "accountName", "AccountName", ""));      // NEW
                var status = normStr(pick(a, "status", "Status", "ACTIVE"));        // NEW
                var balance = Number(pick(a, "balance", "Balance", 0)) || 0;
                var currency = normStr(pick(a, "currency", "Currency", "FCFA")) || "FCFA";

                return { id, type, number, name, status, balance, currency, raw: a };
            }


            function esc(s) {
                return (s ?? "").toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }


            function isSavings(a) {
                var t = normStr(pick(a, "accountType", "AccountType", "")).toLowerCase().replace(/\s+/g, " ").trim();
                return t === "savings";
            }

            function isOrdinaryShares(a) {
                var t = normStr(pick(a, "accountType", "AccountType", "")).toLowerCase().replace(/\s+/g, " ").trim();
                return (t === "ordinary shares" || t === "ordinaryshares");
            }
            function pickKey(obj, key, fallback) { return (obj && obj[key] !== undefined && obj[key] !== null && obj[key] !== '') ? obj[key] : fallback; }
            function isSavingsOrShares(a) {
                var t = normStr(pick(a, "accountType", "AccountType", "")).toLowerCase().replace(/\s+/g, " ").trim();
                return t === "savings" || t === "ordinary shares" || t === "ordinaryshares";
            }
            // ✅ identify required accounts by policy flag OR by type+reason
            function isPolicyRequiredAccount(a) {
                // Treat system-default Savings + Ordinary Shares as policy-required (locked selection).
                // Backend can also mark required explicitly using IsRequired/isRequired or Reason/PolicyMessage.
                if (!a) return false;

                // Explicit flags from backend
                var req = pick(a, "isRequired", "IsRequired", null);
                if (req === true) return true;

                var reason = upper(pick(a, "reason", "Reason", ""));
                if (reason.includes("REQUIRED")) return true;

                // Default required types
                if (isSavings(a) || isOrdinaryShares(a)) return true;

                return false;
            }

            // ✅ amounts coming from coobligor + shotee (wire these to your real state)
            function getCoobligorTotal() { return toNum(window.recoveryState?.coobligorTotal || 0); }
            function getShoteeTotal() { return toNum(window.recoveryState?.shoteeTotal || 0); }

            // ✅ Loan/policy values (wire these to your real wizard/loan state)
            function getRequestedLoanAmount() {
                return toNum(window.wizardState?.application?.requestedAmount || window.wizardState?.loanAmount || 0);
            }
            function getDownpaymentPercent() {
                return toNum(window.wizardState?.policy?.downpaymentPercent || window.wizardState?.facilityPolicy?.downpaymentPercent || 0);
            }
            function getLoanAmount() {
                // adapt if your amount id differs
                return toNum($("#txtAmount").val() || 0);
            }
            function applyRequiredRecoveryAccounts() {
                window.recoveryState = window.recoveryState || {};
                window.recoveryState.selected = window.recoveryState.selected || {};

                var all = window.recoveryState.accounts || [];
                var selected = window.recoveryState.selected;

                all.forEach(function (a) {
                    if (!isPolicyRequiredAccount(a)) return;

                    var id = String(pick(a, "id", "Id", ""));
                    if (!id) return;

                    // Preserve previous selection if any (especially user-entered amount)
                    selected[id] = selected[id] || { amount: 0, decision: "Blocked" };

                    // Mark as required (selection locked) but allow amount entry (do NOT lock amount input)
                    selected[id].required = true;

                    // Ensure a default decision exists
                    selected[id].decision = selected[id].decision || "Blocked";

                    // If backend provides a minimum required amount, prefill once (only if empty)
                    var minAmt = toNum(pick(a, "minRequiredAmount", "MinRequiredAmount", 0));
                    if (minAmt > 0 && (!toNum(selected[id].amount))) {
                        selected[id].amount = minAmt;
                    }

                    selected[id].reason = pick(a, "policyMessage", "PolicyMessage", "Required by policy.");
                });

                window.recoveryState.selected = selected;
            }


            function statusBadge(status) {
                var s = (status || "").toUpperCase();
                if (s === "ACTIVE") return `<span class="badge bg-success-subtle text-success border">ACTIVE</span>`;
                if (s === "DORMANT") return `<span class="badge bg-warning-subtle text-warning border">DORMANT</span>`;
                return `<span class="badge bg-secondary-subtle text-secondary border">${esc(s || "UNKNOWN")}</span>`;
            }

            function requirePolicyReady() {
                return !!(window.productPolicy && (window.productPolicy.minSharesRequired !== undefined));
            }
            /**
             * ✅ Apply current policy => auto-select & lock Savings/Shares rules
             * - Shares: required, not blockable => Decision=Required, Amount=0, locked
             * - Savings: required => Decision=Blocked, Amount=max(minSavingsAbs, loanAmount * minSavingsPercent/100), locked
             */
            function applyRecoveryPolicyFromProductPolicy() {
                if (!window.recoveryState.enabled) return;
                if (!requirePolicyReady()) return;

                var p = window.productPolicy;
                var loanAmount = getLoanAmount();

                var minSavingsAbs = toNum(p.minSavingsAbs);
                var minSavingsPercent = toNum(p.minSavingsPercent);
                var minSharesRequired = toNum(p.minSharesRequired);

                var needSavings = (minSavingsAbs > 0) || (minSavingsPercent > 0);
                var needShares = (minSharesRequired > 0);

                var items = window.recoveryState.accounts || [];
                var selected = window.recoveryState.selected || {};

                // ✅ helper: create/update a selected entry
                function upsert(id, patch) {
                    selected[id] = selected[id] || { amount: 0, decision: "KeepOpen", locked: false, reason: "" };
                    Object.assign(selected[id], patch);
                }

                // ✅ helper: remove policy entry if policy no longer requires it
                function dropPolicy(id, policyKey) {
                    if (!selected[id]) return;
                    if (selected[id].locked && selected[id].policyKey === policyKey) delete selected[id];
                }

                items.forEach(function (a) {
                    var id = String(pick(a, "id", "Id", ""));
                    if (!id) return;

                    // ✅ Ordinary Shares (Required, not blockable)
                    if (needShares && isOrdinaryShares(a)) {
                        upsert(id, {
                            decision: "Required",
                            amount: minSharesRequired,
                            locked: true,
                            reason: `Shares required by policy (min ${minSharesRequired.toLocaleString()} FCFA). Not blockable.`,
                            policyKey: "SHARES_REQUIRED"
                        });
                        return;
                    }

                    // ✅ Savings (Blocked, auto amount)
                    if (needSavings && isSavings(a)) {
                        var pctAmt = Math.round((loanAmount * minSavingsPercent) / 100);
                        var amt = Math.max(minSavingsAbs, pctAmt);

                        upsert(id, {
                            decision: "Blocked",
                            amount: amt,
                            locked: true,
                            reason: `Savings required by policy (${minSavingsPercent}% and/or min ${minSavingsAbs.toLocaleString()} FCFA).`,
                            policyKey: "SAVINGS_REQUIRED"
                        });
                        return;
                    }

                    // ✅ IMPORTANT: do NOTHING for other accounts (do NOT create selected entry)
                });

                // If policy no longer requires them, remove only the locked policy-managed entries
                if (!needSavings) {
                    items.filter(isSavings).forEach(a => dropPolicy(String(pick(a, "id", "Id", "")), "SAVINGS_REQUIRED"));
                }
                if (!needShares) {
                    items.filter(isOrdinaryShares).forEach(a => dropPolicy(String(pick(a, "id", "Id", "")), "SHARES_REQUIRED"));
                }

                window.recoveryState.selected = selected;

                renderRecoveryPicker();
                renderRecoveryEditor();
                //syncRecoveryHiddenJson?.();
            }
            function clearRecoveryNonPolicySelection() {
                var selected = window.recoveryState.selected || {};
                Object.keys(selected).forEach(function (id) {
                    if (!selected[id].locked) delete selected[id];
                });
                renderRecoveryPicker();
                renderRecoveryEditor();
            }
            // Helpers
            function normStr(v) { return (v == null) ? "" : String(v).trim(); }
            function renderRecoveryPicker() {
                var q = normStr($("#recoveryCard #txtRecoverySearch").val()).toLowerCase();
                var showOthers = $("#recoveryCard #chkRecoveryShowOthers").is(":checked");

                // filter list to display in picker
                var all = window.recoveryState.accounts || [];
                var selected = window.recoveryState.selected || {};
                var displayList = all.filter(function (a) {
                    // ✅ exclude policy-required savings/shares from other list (they are already forced-selected)
                    if (isPolicyRequiredAccount(a) && isSavingsOrShares(a)) return false;
                    // ✅ if showOthers OFF, hide non savings/shares
                    if (!showOthers && !isSavingsOrShares(a)) return false;
                    if (!q) return true;

                    var type = normStr(pick(a, "accountType", "AccountType", ""));
                    var num = normStr(pick(a, "accountNumber", "AccountNumber", ""));
                    var name = normStr(pick(a, "accountName", "AccountName", ""));
                    var st = normStr(pick(a, "status", "Status", ""));
                    var hay = (type + " " + num + " " + name + " " + st).toLowerCase();
                    return hay.includes(q);
                });

                if (!displayList.length) {
                    $("#recoveryCard #recoveryPicker").html(`<div class="p-2 text-muted small">No accounts found.</div>`);
                    return;
                }

                var html = `<div class="list-group list-group-flush">`;

                displayList.forEach(function (a) {
                    var id = normStr(pick(a, "id", "Id", ""));
                    var type = normStr(pick(a, "accountType", "AccountType", ""));
                    var number = normStr(pick(a, "accountNumber", "AccountNumber", ""));
                    var accName = normStr(pick(a, "accountName", "AccountName", ""));
                    var balance = Number(pick(a, "balance", "Balance", 0)) || 0;
                    var currency = normStr(pick(a, "currency", "Currency", "FCFA")) || "FCFA";
                    var status = normStr(pick(a, "status", "Status", "ACTIVE")) || "ACTIVE";

                    var required = (a && isPolicyRequiredAccount(a)) === true;
                    var checked = required ? true : !!selected[id];
                    var statusBadge = status.toUpperCase() === "ACTIVE"
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle">ACTIVE</span>`
                        : status.toUpperCase() === "DORMANT"
                            ? `<span class="badge bg-warning-subtle text-warning border border-warning-subtle">DORMANT</span>`
                            : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">INACTIVE</span>`;

                    var sub = [accName, `Bal: ${balance.toLocaleString()} ${currency}`].filter(Boolean).join(" • ");

                    html += `
              <label class="list-group-item d-flex align-items-start gap-2">
                  <input class="form-check-input mt-1 tsc-recovery-pick"
                         type="checkbox"
                         data-id="${escapeHtml(id)}"
                         data-required="${required ? "1" : "0"}"
                         ${checked ? "checked" : ""}
                         ${required ? "disabled" : ""}>
                  <div class="flex-grow-1">
                      <div class="fw-semibold">${escapeHtml(type)} - ${escapeHtml(number)}</div>
                      <div class="text-muted small">${escapeHtml(sub || "-")}</div>
                  </div>
                  ${statusBadge}
              </label>`;
                });

                html += `</div>`;
                $("#recoveryCard #recoveryPicker").html(html);
            }

            function renderRecoveryEditor() {
                var items = window.recoveryState.accounts || [];
                var selected = window.recoveryState.selected || {};
                var ids = Object.keys(selected);

                $("#recoveryCard #recoveryAmountsWrap").toggle(ids.length > 0);

                if (!ids.length) {
                    $("#recoveryAmountsList").html(`<div class="text-muted small p-2">No selected accounts.</div>`);
                    return;
                }

