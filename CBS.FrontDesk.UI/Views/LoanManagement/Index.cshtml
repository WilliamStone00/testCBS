            function ensureFieldErrorEl($el) {
                // Put an error element right under the input/select
                var $err = $el.siblings(".field-error");
                if (!$err.length) {
                    $err = $('<div class="field-error text-danger small mt-1" style="display:none;"></div>');
                    $el.after($err);
                }
                return $err;
            }
            function validateAmountLive() {
                var mode = String(wizardState.restructureMode || "NEW").toUpperCase();
                if (mode === "RESCHEDULE") {
                    // requested amount is forced from old loan, so don't block the UI
                    setFieldInvalid($("#txtAmount"), false);
                    return true;
                }
                var policy = window.productPolicy || {};
                var minA = Number(policy.minAmount || 0);
                var maxA = Number(policy.maxAmount || 0);

                var $a = $("#txtAmount");
                var raw = ($a.val() || "").trim();
                var v = parseFloat(raw);

                if (!raw) {
                    setFieldInvalid($a, false);
                    return true;
                }

                var ok = inRangeNumber(v, minA, maxA);
                setFieldInvalid(
                    $a,
                    !ok,
                    "Amount must be within policy range (" +
                    Number(minA).toLocaleString() + " - " +
                    Number(maxA).toLocaleString() + " FCFA)."
                );

                return ok;
            }

            $("#txtAmount")
                .off(".amountPolicy")
                .on("input.amountPolicy blur.amountPolicy", function () {
                    validateAmountLive();
                });

            function validateRepaymentPeriodLive() {
                var policy = window.productPolicy || {};
                var minM = Number(policy.minMonth || 0);
                var maxM = Number(policy.maxMonth || 0);

                var $rp = $("#ddlRepaymentPeriod");
                var rp = Number($rp.val() || 0);

                // allowed list from productCache
                var periods = (productCache && (productCache.Periods || productCache.periods)) || [];
                var allowed = periods && periods.length ? periods.map(Number).indexOf(rp) >= 0 : true;

                var ok = (rp > 0) && allowed && inRangeNumber(rp, minM, maxM);

                setFieldInvalid(
                    $rp,
                    !ok,
                    "Repayment period must be within policy range (" + minM + " - " + maxM + " months) and match allowed periods."
                );

                return ok;
            }



            $("#ddlRepaymentPeriod")
                .off(".rpPolicy")
                .on("change.rpPolicy blur.rpPolicy", function () {
                    validateRepaymentPeriodLive();
                });


            $("#txtAmount")
                .off(".amountPolicy")
                .on("input.amountPolicy blur.amountPolicy", function () {
                    validateAmountLive();
                });

            function validateInterestLive() {
                var policy = window.productPolicy || {};
                var minI = Number(policy.minInterest || 0);
                var maxI = Number(policy.maxInterest || 0);

                var $i = $("#txtInterest");
                var raw = ($i.val() || "").trim();
                var v = parseFloat(raw);

                // allow empty while typing
                if (!raw) {
                    setInvalid($i, false);
                    return true;
                }

                var ok = !isNaN(v) && v > 0 && v >= minI && v <= maxI;

                setInvalid(
                    $i,
                    !ok,
                    "Interest must be within policy range (" + minI + "% - " + maxI + "%)."
                );

                return ok;
            }

            // same binding style as amount
            $("#txtInterest")
                .off(".interestLive")
                .on("input.interestLive blur.interestLive", function () {
                    validateInterestLive();
                });


            function setFieldInvalid($el, isInvalid, message) {
                var $err = ensureFieldErrorEl($el);

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    $err.text(message || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    $err.hide().text("");
                }
            }

            function inRangeNumber(v, min, max) {
                if (v === null || v === undefined || isNaN(v)) return false;
                if (min !== null && min !== undefined && !isNaN(min) && v < min) return false;
                if (max !== null && max !== undefined && !isNaN(max) && v > max) return false;
                return true;
            }



            $("#ddlCharges").on("change", function () {
                var before = 0, after = 0;

                $("#ddlCharges option:selected").each(function () {
                    var amt = Number($(this).data("amount") || 0);
                    var mode = String($(this).data("mode") || "").toUpperCase();

                    if (mode.includes("BEFORE")) before += amt;
                    else after += amt;
                });

                // Upfront = BEFORE_APPRAISAL (cash desk requirement)
                $("#sumBefore").text(before.toLocaleString());
                $("#sumAfter").text(after.toLocaleString());
                $("#sumUpfront").text(before.toLocaleString());

                // Friendly hint
                if (before > 0) {
                    $("#upfrontHint").text("Upfront payment required at cash desk before processing.");
                    $("#upfrontHint").removeClass("text-muted").addClass("text-warning");
                } else {
                    $("#upfrontHint").text("No upfront charges selected.");
                    $("#upfrontHint").removeClass("text-warning").addClass("text-muted");
                }
                var totalCharges = before + after;
                $("#sumTotalCharges").text(totalCharges.toLocaleString());

            });

            function resetChargesSummary() {
                $("#sumBefore").text("0");
