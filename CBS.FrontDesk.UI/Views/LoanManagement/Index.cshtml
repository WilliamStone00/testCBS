                var labelMap = {};
                $("#ddlRecoveryAccounts option").each(function () { labelMap[this.value] = $(this).text(); });

                var mgrMap = {};
                (payload.ManagerRecoveryDecision || []).forEach(function (x) { mgrMap[x.AccountId] = x; });

                (payload.RecoveryBlocks || []).forEach(function (b) {
                    var label = labelMap[b.AccountId] || b.AccountId;
                    var mgr = mgrMap[b.AccountId];

                    var decision = mgr ? mgr.Decision : "PENDING";
                    var managerAmt = mgr ? mgr.ManagerAmount : b.BlockAmount;

                    $rec.append(
                        '<div class="card border-0 bg-light mb-2">' +
