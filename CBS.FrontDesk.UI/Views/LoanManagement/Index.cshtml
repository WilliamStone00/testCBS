        `);
        });
    }
    function setOldLoanSelection(loan) {
        wizardState.oldLoanId = loan.Id || loan.id;
        wizardState.oldLoanProductId = loan.LoanProductId || loan.loanProductId;
        wizardState.oldLoanAmount = Number(loan.Amount || loan.amount || 0);
        wizardState.oldLoanBalance = Number(loan.Balance || loan.balance || 0);

        // facility can be AUTO (from old loan)
        wizardState.facility = (loan.Facility || loan.facility || wizardState.facility || "").toUpperCase();
    }

    // -----------------------------
