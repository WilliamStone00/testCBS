            // =========================
            // Helpers to show all selected items in review
            // =========================
            function selectedTexts($sel) {
                return $sel.find("option:selected").map(function () { return $(this).text(); }).get();
            }
            function selectedObjects($sel) {
                return $sel.find("option:selected").map(function () {
                    var $o = $(this);
                    return {
                        id: this.value,
                        text: $o.text(),
                        points: Number($o.attr("data-points") || 0),
                        amount: Number($o.attr("data-amount") || 0),
                        mode: String($o.attr("data-mode") || "")
                    };
                }).get();
            }
            function listHtml(items) {
                if (!items || !items.length) return '<div class="text-muted small">None selected</div>';
                return '<ul class="mb-0 small ps-3">' + items.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") + "</ul>";
            }

            // =========================
            // Documents preview helper (file input -> blob url)
            // =========================
            var _docUrlCache = {}; // name|size|lastModified -> blob url

            function getLoanDocFiles() {
                // Try common IDs (update this if your input has a different id)
                var $inp = $("#loanDocuments, #LoanDocuments, #fuLoanDocs, #fileLoanDocs, #txtLoanDocs, #LoanDocs, #loanDocs, #uploadLoanDocs").first();
                if (!$inp.length) {
                    // last resort: any file input inside Risk Mitigation section
                    $inp = $('input[type="file"]').first();
                }
                if (!$inp.length) return { input: null, files: [] };

                var el = $inp.get(0);
                var files = (el && el.files) ? Array.prototype.slice.call(el.files) : [];
                return { input: el, files: files };
            }

            function fileKey(f) {
                return [f.name, f.size, f.lastModified].join("|");
            }

            function blobUrlForFile(f) {
                var k = fileKey(f);
                if (_docUrlCache[k]) return _docUrlCache[k];
                var url = URL.createObjectURL(f);
                _docUrlCache[k] = url;
                return url;
            }

            function renderDocsReview() {
                // Put docs into #reviewDocuments if present; otherwise append to #reviewRisk
                var $host = $("#reviewDocuments");
                var fallbackToRisk = false;
                if (!$host.length) {
                    $host = $("#reviewRisk");
                    fallbackToRisk = true;
                }

                var info = getLoanDocFiles();
                var files = info.files || [];

                var html = '<div class="fw-bold mb-1">Uploaded Documents</div>';

                if (!files.length) {
                    html += '<div class="text-muted small">No documents uploaded.</div>';
                    if (fallbackToRisk) html = '<div class="tsc-divider my-3"></div>' + html;
                    if (fallbackToRisk) $host.append(html); else $host.html(html);
                    return;
                }

                html += '<div class="list-group">';
                files.forEach(function (f) {
                    var url = blobUrlForFile(f);
                    var name = esc(f.name);
                    var sizeKb = Math.round((f.size || 0) / 1024);

                    var isImg = /^image\//i.test(f.type || "");
                    var thumb = "";
                    if (isImg) {
                        thumb = '<img src="' + esc(url) + '" alt="' + name + '" style="width:46px;height:46px;object-fit:cover;border-radius:8px;border:1px solid rgba(0,0,0,.08);" />';
                    } else {
                        thumb = '<div style="width:46px;height:46px;border-radius:8px;border:1px solid rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;background:#f8f9fa;font-size:12px;" class="text-muted">DOC</div>';
                    }

                    html += ''
                        + '<a class="list-group-item list-group-item-action d-flex align-items-center gap-2" '
                        + 'href="' + esc(url) + '" target="_blank" rel="noopener">'
                        + thumb
                        + '<div class="flex-grow-1">'
                        + '<div class="fw-semibold">' + name + '</div>'
                        + '<div class="small text-muted">' + esc((f.type || "file").toString()) + ' • ' + sizeKb + ' KB • Click to preview</div>'
                        + '</div>'
                        + '<div class="small text-primary fw-semibold">Open</div>'
                        + '</a>';
                });
                html += '</div>';

                if (fallbackToRisk) {
                    $host.append('<div class="tsc-divider my-3"></div>' + html);
                } else {
                    $host.html(html);
                }
            }

            // =========================
            // Scoring status + insight (read from UI)
            // =========================
            function txt($el) { return ($el && $el.length) ? ($el.text() || "").trim() : ""; }

            function renderScoringReview() {
                var $host = $("#reviewScoring");
                var fallbackToRisk = false;
                if (!$host.length) {
                    $host = $("#reviewRisk");
                    fallbackToRisk = true;
                }

                // Try known IDs first (if you have them in your Step3 scoring widget)
                var scoreVal = txt($("#scoreValue, #scorePoints, #lblScore, #scoreComputed"));
                var requiredVal = txt($("#scoreRequired, #requiredScore, #lblRequiredScore"));
                var deltaVal = txt($("#scoreDelta, #deltaScore, #lblDeltaScore"));
                var badgeVal = txt($("#scoreBadge, #scoreStatusBadge, #lblScoreBadge"));
                var recVal = txt($("#scoreRecommendation, #scoreAdvice, #lblScoreRecommendation"));

                // If IDs not found, try extracting from the "Status" panel in the scoring section
                if (!scoreVal && !requiredVal && !deltaVal && !recVal) {
                    var $status = $("#creditScoring, #panelCreditScoring, #sectionCreditScoring").find(".status, .Status, .card-body").last();

                    var allText = ($status.length ? $status.text() : "").replace(/\s+/g, " ").trim();

                    // Best-effort regex extraction
                    // e.g. "Score: 480 Required: 75 Delta: +405 pts Recommendation: Proceed..."
                    var mScore = allText.match(/Score\s*:\s*([0-9]+(?:\.[0-9]+)?)/i);
                    var mReq = allText.match(/Required\s*:\s*([0-9]+(?:\.[0-9]+)?)/i);
                    var mDelta = allText.match(/Delta\s*:\s*([+\-]?[0-9]+(?:\.[0-9]+)?)/i);
                    var mRec = allText.match(/Recommendation\s*:\s*([^]+)$/i);

                    if (mScore) scoreVal = mScore[1];
                    if (mReq) requiredVal = mReq[1];
                    if (mDelta) deltaVal = mDelta[1];
                    if (mRec) recVal = (mRec[1] || "").trim();
                }

                // Badge often exists as a green pill/button; try locate within scoring section
                if (!badgeVal) {
                    var $badge = $("#creditScoring, #panelCreditScoring, #sectionCreditScoring").find(".badge, .btn, .pill, .rounded-pill").filter(function () {
                        var t = ($(this).text() || "").trim();
                        return t && t.length <= 40; // likely status label
                    }).first();
                    badgeVal = txt($badge);
                }

                var html = '<div class="fw-bold mb-1">Credit Scoring Status</div>';

                if (!scoreVal && !badgeVal && !recVal) {
                    html += '<div class="text-muted small">No scoring status captured.</div>';
                    if (fallbackToRisk) $host.append('<div class="tsc-divider my-3"></div>' + html);
                    else $host.html(html);
                    return;
                }

                html += '<div class="card border-0 bg-light"><div class="card-body py-2">';
                if (badgeVal) {
                    html += '<div class="mb-2"><span class="badge rounded-pill bg-success">' + esc(badgeVal) + '</span></div>';
                }
                html += '<div class="small">';
                if (scoreVal) html += '<div class="d-flex justify-content-between"><span class="text-muted">Score</span><span class="fw-bold">' + esc(scoreVal) + '</span></div>';
                if (requiredVal) html += '<div class="d-flex justify-content-between"><span class="text-muted">Required</span><span class="fw-bold">' + esc(requiredVal) + '</span></div>';
                if (deltaVal) html += '<div class="d-flex justify-content-between"><span class="text-muted">Delta</span><span class="fw-bold">' + esc(deltaVal) + '</span></div>';
                html += '</div>';

                if (recVal) {
                    html += '<div class="mt-2"><div class="text-muted small">Insight</div><div class="fw-semibold">' + esc(recVal) + '</div></div>';
                }

                html += '</div></div>';

                if (fallbackToRisk) $host.append('<div class="tsc-divider my-3"></div>' + html);
                else $host.html(html);
            }

            // =========================
            // Preview rendering
            // =========================
            function renderPreview(payload) {

                var productText = $("#ddlLoanProduct option:selected").text() || "";
                var loanTypeText = $("#ddlInstitutionLoanType option:selected").text() || "";

                var mode = (payload.Mode || "").toString().toUpperCase();
                var facility = payload.Facility || "AUTO";

                // -----------------------------
                // Member mini helper
                // -----------------------------
                var mem = (window.wizardState && window.wizardState.member) ? window.wizardState.member : {};
                var memberName = mem.name || "";
                var memberCode = mem.code || "";

                // -----------------------------
                // Helpers
                // -----------------------------
                function pickOldLoanFromState() {
                    var ws = window.wizardState || {};
                    var id = ws.oldLoanId || payload.OldLoanId || null;
                    if (!id) return null;

                    var key = String(id);
                    var map = ws.loansById || {};
                    return map[key] || null;
                }

                function moneyWithCurrency(v, ccy) {
                    return num(v).toLocaleString() + " " + esc(ccy || "FCFA");
                }

                // ✅ For reschedule: the value is BALANCE (Remaining Capital), not "amount".
                // Try to read the reschedule amount input if it exists, else fallback to old balance.
                function getRescheduleCapital(oldBalance) {
                    var $res = $("#txtRescheduleAmount, #txtAmountToReschedule, #txtRemainingCapital").first();
                    if ($res.length) {
                        var v = num($res.val());
                        if (v > 0) return v;
                    }
                    // fallback
                    return num(oldBalance);
                }

                // -----------------------------
                // RESCHEDULE PREVIEW (special)
                // -----------------------------
                if (mode === "RESCHEDULE") {

                    // ✅ Title change
                    if ($("#reviewRightTitle").length) {
                        $("#reviewRightTitle").html('<i class="mdi mdi-refresh me-1"></i> Loan Reschedule Summary');
                    }

                    // ✅ pull from lookup where you stored it
                    var oldLoan = pickOldLoanFromState();

                    var oldId = oldLoan ? (oldLoan.id || "") : (payload.OldLoanId || (window.wizardState && window.wizardState.oldLoanId) || "");
                    var oldStatus = oldLoan ? (oldLoan.status || "") : "";
                    var oldCurrency = oldLoan ? (oldLoan.currency || "FCFA") : "FCFA";

                    var oldAmount = oldLoan ? num(oldLoan.amount) : 0;
                    var oldBalance = oldLoan ? num(oldLoan.balance) : 0;

                    var oldAccrualInterest = oldLoan ? num(oldLoan.accrualInterest) : 0;
                    var oldVat = oldLoan ? num(oldLoan.vat) : 0;
                    var oldPenalty = oldLoan ? num(oldLoan.penalty) : 0;

                    var oldDelInterest = oldLoan ? num(oldLoan.delinquentInterest) : 0;
                    var oldDelAmount = oldLoan ? num(oldLoan.delinquentAmount) : 0;
                    var oldDelDays = oldLoan ? num(oldLoan.delinquentDays) : 0;

                    var oldTotalDue = oldLoan ? num(oldLoan.totalDueAmount) : 0;
                    var oldDateText = oldLoan ? (oldLoan.dateText || "") : "";

                    // ✅ Remaining capital (reschedule amount)
                    var remainingCapital = getRescheduleCapital(oldBalance);

                    // -----------------------------
                    // Helpers (units + status pill)
                    // -----------------------------
                    function monthsLabel(v) {
                        var n = num(v);
                        if (!n || n <= 0) return "0 months";
                        return n + " month" + (n > 1 ? "s" : "");
                    }

                    // You requested "Grace Period in Month"
                    // NOTE: payload.GracePeriodDays is used elsewhere, but for RESCHEDULE preview we treat it as months.
                    var graceMonths = num(payload.GracePeriodDays || 0);

                    function isDelinquentStatus(s) {
                        s = (s || "").toString().toUpperCase();
                        return s.indexOf("DELINQUENT") >= 0 || s.indexOf("ARREAR") >= 0 || s.indexOf("LATE") >= 0;
                    }

                    function statusBadgeHtml(s) {
                        var t = (s || "").toString().trim();
                        if (!t) return "";
                        var cls = isDelinquentStatus(t) ? "bg-danger" : "bg-secondary";
                        return '<span class="badge rounded-pill ' + cls + '">' + esc(t) + '</span>';
                    }

                    // -----------------------------
                    // LEFT: Summary (keep clean)
                    // -----------------------------
                    $("#reviewSummary").html(
                        '<div class="d-flex justify-content-between"><span class="text-muted">Member</span><span class="fw-bold text-dark">' + esc(memberName) + '</span></div>' +
