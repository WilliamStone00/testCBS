            });
            // =========================
            // Documents preview helper (file input -> blob url)
            // =========================
            var _docUrlCache = {}; // name|size|lastModified -> blob url

            function getLoanDocFiles() {
                var $inp = $("#loanDocuments, #LoanDocuments, #fuLoanDocs, #fileLoanDocs, #txtLoanDocs, #LoanDocs, #loanDocs, #uploadLoanDocs").first();
                if (!$inp.length) $inp = $('input[type="file"]').first();
                if (!$inp.length) return { input: null, files: [] };

                var el = $inp.get(0);
                var files = (el && el.files) ? Array.prototype.slice.call(el.files) : [];
                return { input: el, files: files };
            }
            function fileKey(f) { return [f.name, f.size, f.lastModified].join("|"); }
            function blobUrlForFile(f) {
                var k = fileKey(f);
                if (_docUrlCache[k]) return _docUrlCache[k];
                var url = URL.createObjectURL(f);
                _docUrlCache[k] = url;
                return url;
            }

            function renderDocsReviewFromDto(docDtos) {
                var $host = $("#reviewDocuments");
                var fallbackToRisk = false;
                if (!$host.length) { $host = $("#reviewRisk"); fallbackToRisk = true; }

                var docs = Array.isArray(docDtos) ? docDtos : [];

                var html = '<div class="fw-bold mb-1">Uploaded Documents</div>';

                if (!docs.length) {
                    html += '<div class="text-muted small">No documents uploaded.</div>';
                    if (fallbackToRisk) $host.append('<div class="tsc-divider my-3"></div>' + html);
                    else $host.html(html);
                    return;
                }

                html += '<div class="list-group">';
                docs.forEach(function (d) {
                    var name = esc(d.FileName || "");
                    var type = esc(d.ContentType || "file");
                    var sizeKb = Math.round((Number(d.Size || 0) || 0) / 1024);

                    var url = (d.PreviewUrl || "").toString().trim();
                    if (!url) {
                        var info = getLoanDocFiles();
                        var match = (info.files || []).filter(function (f) { return f.name === (d.FileName || "") && (f.size || 0) === (d.Size || 0); })[0];
                        if (match) url = blobUrlForFile(match);
                    }
                    if (!url) url = "#";

                    var isImg = /^image\//i.test(d.ContentType || "");
                    var thumb = "";
                    if (isImg && url !== "#") {
                        thumb = '<img src="' + esc(url) + '" alt="' + name + '" style="width:46px;height:46px;object-fit:cover;border-radius:8px;border:1px solid rgba(0,0,0,.08);" />';
                    } else {
                        thumb = '<div style="width:46px;height:46px;border-radius:8px;border:1px solid rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;background:#f8f9fa;font-size:12px;" class="text-muted">DOC</div>';
                    }

                    var openAttr = (url === "#") ? '' : 'href="' + esc(url) + '" target="_blank" rel="noopener"';
                    html += ''
                        + '<a class="list-group-item list-group-item-action d-flex align-items-center gap-2" ' + openAttr + '>'
                        + thumb
                        + '<div class="flex-grow-1">'
                        + '<div class="fw-semibold">' + name + '</div>'
                        + '<div class="small text-muted">' + type + ' • ' + sizeKb + ' KB</div>'
                        + '</div>'
                        + (url === "#" ? '<div class="small text-muted fw-semibold">No Preview</div>' : '<div class="small text-primary fw-semibold">Open</div>')
                        + '</a>';
                });
                html += '</div>';

                if (fallbackToRisk) $host.append('<div class="tsc-divider my-3"></div>' + html);
                else $host.html(html);
            }            // =========================
            // Preview rendering (UPDATED: show ALL user-entered payload)
            // =========================
            function renderPreview(payload) {

                var productText = safeText("#ddlLoanProduct") || "";
                var loanTypeText = safeText("#ddlInstitutionLoanType") || "";

                var ws = window.wizardState || {};
