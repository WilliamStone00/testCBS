                $("#rescheduleAmountCol").toggle(isReschedule);
                // =====================================================
                // ✅ RESCHEDULE: hide all red-highlighted non-required blocks
                // =====================================================
                $("#institutionLoanTypeCol").toggle(!isReschedule);     // Loan Type (Institution)
                $("#institutionLoanProductCol").toggle(!isReschedule);  // Loan Product (Institution)
                $("#pcmfPurposeBox").toggle(!isReschedule);             // PCMF Purpose (from product)
                $("#recoveryCard").toggle(!isReschedule);               // Guarantees     
                $("#interestCol").toggle(!isReschedule);                // Interest Rate (%)
                $("#disbursementCol").toggle(!isReschedule);            // Disbursement Type
                $("#riskMitigationCard").toggle(!isReschedule);         // Entire Risk Mitigation card
                // Your existing "heavy sections" (safe if present)
                $("#ddlCharges").closest(".card").toggle(!isReschedule);
