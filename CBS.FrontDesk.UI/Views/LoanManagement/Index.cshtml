                                <label class="form-label">Tenor (Months)</label>
                                <input type="number" class="form-control" id="txtOverdraftTenorMonths" min="0" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Auto Recovery</label>
                                <select class="form-select" id="ddlOverdraftAutoRecovery">
                                    <option value="TRUE">Yes</option>
                                    <option value="FALSE">No</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Overdraft Notes</label>
                                <textarea class="form-control" id="txtOverdraftNote" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ LINE OF CREDIT FIELDS -->
                <div class="card tsc-card-soft mb-3" id="locFieldsCard" style="display:none;">
                    <div class="card-body">
                        <h5 class="tsc-section-title mb-2"><i class="mdi mdi-briefcase-outline me-1"></i> Line of Credit Setup</h5>

                        <div class="row g-2">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Credit Limit</label>
                                <input type="number" class="form-control" id="txtLocLimit" min="0" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Tenor (Months)</label>
                                <input type="number" class="form-control" id="txtLocTenorMonths" min="0" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Drawdown Mode</label>
                                <select class="form-select" id="ddlLocDrawdownMode">
                                    <option value="REVOLVING">Revolving</option>
                                    <option value="NON_REVOLVING">Non-Revolving</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">LOC Notes</label>
                                <textarea class="form-control" id="txtLocNote" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Manager Decision (Auto-filled from selected accounts) -->
                <div class="card tsc-card-soft mb-3" id="managerRecoveryDecisionWrap" style="display:none;">
                    <div class="card-body">
                        <h5 class="tsc-section-title mb-2">
                            <i class="mdi mdi-account-check-outline me-1"></i> Manager Recovery Decision
                        </h5>

                        <div class="small text-muted mb-2">
                            Accounts selected by the officer appear below. The manager decides whether each account should be blocked.
                        </div>

                        <div id="managerRecoveryList" class="vstack gap-2"></div>

                        <div class="form-text mt-2">
                            Note: Blocking will only be executed after approval.
                        </div>
                    </div>
                </div>


                <!-- Right: Scoring + Advisory -->
                <div class="card tsc-card-soft mb-3">
                    <div class="card-body">
                        <h5 class="tsc-section-title mb-2">
                            <i class="mdi mdi-chart-donut-variant me-1"></i> Credit Scoring
                        </h5>

                        <div class="small text-muted mb-2">
                            Branch manager selects assessments. System computes score based on requested amount and gives advice.
                        </div>

                        <label class="form-label">Assessment (Select multiple)</label>
                        <select class="form-select" id="ddlScoreAssessments" multiple size="8"></select>

                        <div class="tsc-divider my-3"></div>

                        <div class="tsc-score-result" id="scoreResultBox" style="display:none;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="fw-bold">Status</div>
                                <span class="badge rounded-pill" id="scoreBadge"></span>
                            </div>

                            <div class="mt-2 small">
                                <div><span class="text-muted">Score:</span> <strong id="scoreValue">0</strong></div>
                                <div><span class="text-muted">Required:</span> <strong id="scoreRequired">0</strong></div>
                                <div><span class="text-muted">Delta:</span> <strong id="scoreDelta">0 pts</strong></div>
                                <div class="mt-2" id="scoreAdvice"></div>
                                <div class="mt-2 text-muted" id="scoreSuggestedAmount"></div>

                            </div>
                        </div>
                    </div>
                </div>



            </div>


        </div>
    </div>
    <!-- STEP 4: Review -->
    <div class="tsc-card p-4 mb-3" id="panelReview" style="display:none;">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h4 class="tsc-section-title mb-1">
                    <i class="mdi mdi-check-decagram-outline me-1"></i> Review & Confirmation
                </h4>
                <div class="text-muted small">
                    Preview everything before saving. Saving is locked until you generate preview and confirm.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-soft" id="btnBackToApplication">
                    <i class="mdi mdi-arrow-left"></i> Back to Application
                </button>

                <!-- ✅ NEW: Go back to Loan Management index -->
                <button type="button"
                        class="btn btn-soft btn-soft-danger"
                        id="btnNewApplication"
                        data-url="@Url.Action("Index", "LoanManagement")">
                    <i class="mdi mdi-plus-circle-outline"></i> New Application
                </button>

                <button type="button" class="btn btn-soft btn-soft-primary" id="btnGeneratePreview">
                    <i class="mdi mdi-eye-outline"></i> Generate Preview
                </button>

                <button type="button" class="btn btn-primary" id="btnSaveLoan" disabled>
                    <i class="mdi mdi-content-save-check-outline"></i> Save Application
                </button>
            </div>
        </div>

        <div class="alert alert-warning py-2 mb-3" id="reviewLockHint">
            <i class="mdi mdi-lock-outline me-1"></i>
            Generate preview first. Then confirm before saving.
        </div>

        <!-- Confirm checkbox -->
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="chkConfirmReview" disabled>
            <label class="form-check-label fw-semibold" for="chkConfirmReview">
                I confirm this loan application preview is correct and ready to be saved.
            </label>
        </div>

        <!-- Preview container -->
        <div id="reviewPreviewWrap" style="display:none;">

            <div class="row g-3">

                <!-- LEFT: Summary -->
                <div class="col-12 col-lg-6">
                    <div class="card tsc-card-soft">
                        <div class="card-body">
                            <h5 class="tsc-section-title mb-2">
                                <i class="mdi mdi-file-document-outline me-1"></i> Application Summary
                            </h5>

                            <div id="reviewSummary" class="small"></div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Risk, scoring, recovery -->
                <div class="col-12 col-lg-6">
                    <div class="card tsc-card-soft">
                        <div class="card-body">
                            <h5 class="tsc-section-title mb-2" id="reviewRightTitle">
                                <i class="mdi mdi-shield-check-outline me-1"></i> Risk & Recovery Summary
                            </h5>


                            <div id="reviewRisk" class="small"></div>

                            <div class="tsc-divider my-3"></div>

                            <h6 class="fw-bold mb-2">
                                <i class="mdi mdi-lock-outline me-1"></i> Recovery Accounts (Selected)
                            </h6>

                            <div id="reviewRecovery" class="vstack gap-2"></div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="tsc-divider my-3"></div>

            <!-- Audit note -->
            <div class="alert alert-info py-2 mb-0">
                <i class="mdi mdi-information-outline me-1"></i>
                Saving will persist exactly what is shown in this preview.
            </div>

        </div>
    </div>


</div>

@section scripts{
    <script>
(function () {

    // -----------------------------
    // Config
    // -----------------------------
    var searchUrl = '@Url.Action("SearchMembers", "LoanManagement")';
    var loansUrl  = '@Url.Action("GetMemberLoans", "LoanManagement")';

    var debounceMs = 350;
    var minLen = 10;

    var timer = null;
    var lastQuery = "";

    // ✅ IMPORTANT: keep wizardState GLOBAL so Step 3 script can read it
    window.wizardState = window.wizardState || {
        memberId: null,
        member: null,
        facility: null,            // CLASSIC | SSF | OVERDRAFT | LOC
        restructureMode: null,     // null | REFINANCE | RESCHEDULE
        oldLoanId: null,
            // ✅ new (from selected old loan row)
        oldLoanProductId: null,
        oldLoanAmount: 0,
        oldLoanBalance: 0
    };

    // Keep local alias (so your code below remains the same)
    var wizardState = window.wizardState;

    // -----------------------------
    // UI Helpers
    // -----------------------------
    function setLoading(isLoading) { $("#searchStatus").toggle(isLoading); }
    function setEmpty(show) { $("#memberEmpty").toggle(show); }

    function escapeHtml(s){
        return (s || "").replace(/[&<>"']/g, function(c){
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);
        });
    }

    function gp(o, camel, pascal) {
        if (!o) return null;
        var v = o[camel];
        if (v !== undefined && v !== null) return v;
        v = o[pascal];
        if (v !== undefined && v !== null) return v;
        return null;
    }

    // -----------------------------
    // Step 1: Search (Member Reference length = 10)
    // -----------------------------
    var REF_LEN = 10;
    var debounceMs = 350;

    var timer = null;
    var lastQuery = "";

    // ✅ IMPORTANT: keep wizardState GLOBAL so Step 3 script can read it
    window.wizardState = window.wizardState || {
        memberId: null,
        member: null,
        facility: null,            // CLASSIC | SSF | OVERDRAFT | LOC
        restructureMode: null,     // null | REFINANCE | RESCHEDULE
        oldLoanId: null
    };

    // Keep local alias (so your code below remains the same)
    var wizardState = window.wizardState;

    // -----------------------------
    // UI Helpers
    // -----------------------------
    function setLoading(isLoading) { $("#searchStatus").toggle(!!isLoading); }
    function setEmpty(show) { $("#memberEmpty").toggle(!!show); }

    function escapeHtml(s) {
        return (s || "").replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]);
        });
    }

    function gp(o, camel, pascal) {
        if (!o) return null;
        var v = o[camel];
        if (v !== undefined && v !== null) return v;
        v = o[pascal];
        if (v !== undefined && v !== null) return v;
        return null;
    }

    function normalizeQuery(q) {
        q = (q || "").trim();
        q = q.replace(/\s+/g, ""); // remove spaces
        return q;
    }

    function isValidMemberRef(q) {
        // change to /^\d{10}$/ if reference is always numeric
        return /^[A-Za-z0-9]{10}$/.test(q);
    }

    // -----------------------------
    // Step 1: Render Members ✅ MUST exist before doSearch uses it
    // -----------------------------
    function renderMembers(items) {
        var $wrap = $("#memberResults");
        $wrap.empty();

        if (!items || !items.length) {
            setEmpty(lastQuery.length >= minLen);
            return;
        }

        setEmpty(false);

        function val(v) {
            return (v !== null && v !== undefined && String(v).trim() !== "")
                ? String(v).trim()
                : "";
        }

        items.forEach(function (m) {

            // Normalize (supports camelCase + PascalCase)
            var id = gp(m, "id", "Id") || gp(m, "memberId", "MemberId") || gp(m, "customerId", "CustomerId");
            var name = val(gp(m, "name", "Name"));
            var code = val(gp(m, "code", "Code"));

            var phone = val(gp(m, "phoneNumber", "PhoneNumber"));
            var branchName = val(gp(m, "branchName", "BranchName"));
            var branchCode = val(gp(m, "branchCode", "BranchCode"));

            var balance = Number(gp(m, "balance", "Balance") || 0);
            var currency = val(gp(m, "currency", "Currency")) || "FCFA";

            // ✅ store full info for selection step
            var payload = {
                id: id,
                name: name,
                code: code,
                phoneNumber: phone,
                branchName: branchName,
                branchCode: branchCode,
                balance: balance,
                currency: currency
            };

            var phoneText = phone ? phone : "Phone not available";
            var branchText = branchName
                ? (branchName + (branchCode ? (" (" + branchCode + ")") : ""))
                : "Branch not available";

            var card = `
            <div class="member-card" data-member="${escapeHtml(JSON.stringify(payload))}">
                <div class="member-left">
                    <div class="avatar"><i class="mdi mdi-account-outline"></i></div>

                    <div style="min-width:0;">
                        <p class="member-name mb-1">${escapeHtml(name)}</p>

                        <div class="member-meta d-flex flex-wrap gap-3">
                            <span><i class="mdi mdi-identifier text-muted me-1"></i>${escapeHtml(code)}</span>
                            <span><i class="mdi mdi-phone-outline text-muted me-1"></i>${escapeHtml(phoneText)}</span>
                        </div>

                        <div class="member-meta mt-1">
                            <span><i class="mdi mdi-bank-outline text-muted me-1"></i>${escapeHtml(branchText)}</span>
                        </div>
                    </div>
                </div>

                <div class="balance-box">
                    <div class="balance-label">Balance</div>
                    <div class="balance-value">${balance.toLocaleString()} ${escapeHtml(currency)}</div>
                </div>
            </div>
        `;

            $wrap.append(card);
        });
    }

    // -----------------------------
    // Search (ONLY when 10 chars)
    // -----------------------------
    function doSearch(q) {
        lastQuery = q || "";
        $("#memberResults").empty();
        setEmpty(false);

        if (!q || q.length !== REF_LEN) return;

        if (!isValidMemberRef(q)) {
            setEmpty(true);
            return;
        }

        setLoading(true);

        $.ajax({
            url: searchUrl,
            method: "GET",
            data: { q: q }
        })
            .done(function (res) {
                // support various shapes: {success,data}, {Data}, array, etc.
                var items =
                    (res && res.data) ||
                    (res && res.Data) ||
                    (Array.isArray(res) ? res : []);

                renderMembers(items);
            })
            .fail(function () {
                renderMembers([]);
            })
            .always(function () {
                setLoading(false);
            });
    }

    // -----------------------------
    // Events
    // -----------------------------
    $("#txtMemberSearch").off("input.memberSearch").on("input.memberSearch", function () {
        var q = normalizeQuery($(this).val());
        $(this).val(q);

        clearTimeout(timer);
        timer = setTimeout(function () {
            doSearch(q);
        }, debounceMs);
    });

    // Optional: search button (if you added it)
    $("#btnMemberSearch").off("click.memberSearch").on("click.memberSearch", function () {
        var q = normalizeQuery($("#txtMemberSearch").val());
        $("#txtMemberSearch").val(q);
        doSearch(q);
    });

    // Select member
    $("#memberResults").off("click.memberPick", ".member-card").on("click.memberPick", ".member-card", function () {
        var raw = $(this).attr("data-member");
        if (!raw) return;

        var m = null;
        try { m = JSON.parse(raw); } catch (e) { m = null; }
        if (!m || !m.id) return;

        wizardState.memberId = m.id;
        wizardState.member = m;

        // move to next step (your existing flow can run here)
        // Example:
        // $("#panelSearch").hide();
        // $("#panelFacility").show();

        // If you already have a function to load loans:
        // loadMemberLoans(m.id);

    });

    // -----------------------------
    // Step Navigation
    // -----------------------------
    function goBackToSearch(){
        $("#stepFacility").removeClass("active");
        $("#stepSearch").removeClass("done").addClass("active");

        $("#panelFacility").hide();
        $("#panelSearch").show();
    }

    function goToFacility(member) {

        if (!member || !member.id) {
            console.error("goToFacility called without member.id", member);
            return;
        }

        // Set wizard state
        wizardState.member = member;
        wizardState.memberId = member.id;
        wizardState.facility = null;
        wizardState.restructureMode = null;
        wizardState.oldLoanId = null;

        console.log("goToFacility -> wizardState:", wizardState);

        // Stepper
        $("#stepSearch").removeClass("active").addClass("done");
        $("#stepFacility").addClass("active");

        // Panels
        $("#panelSearch").hide();
        $("#panelFacility").show();

        // Reset selections
        $("#btnProceedToApplication").prop("disabled", true);
        $(".facility-tile").removeClass("selected");

        // ✅ normalize fields (support camelCase / PascalCase)
        var name = gp(member, "name", "Name") || "";
        var code = gp(member, "code", "Code") || "";
        var phone = gp(member, "phoneNumber", "PhoneNumber") || gp(member, "phone", "Phone") || "";
        var branchName = gp(member, "branchName", "BranchName") || "";
        var branchCode = gp(member, "branchCode", "BranchCode") || "";
        var balance = gp(member, "balance", "Balance");
        var currency = gp(member, "currency", "Currency") || "FCFA";

        var phoneText = phone ? phone : "Phone not available";
        var branchText = branchName
            ? (branchName + (branchCode ? (" (" + branchCode + ")") : ""))
            : "Branch not available";

        var balText = (balance !== null && balance !== undefined && !isNaN(Number(balance)))
            ? (Number(balance).toLocaleString() + " " + currency)
            : ("0 " + currency);

        // ✅ Member header (beautiful + richer info)
        $("#selectedMemberHeader").html(`
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar" style="width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eef3ff;">
                            <i class="mdi mdi-account text-primary" style="font-size:22px;"></i>
                        </div>

                        <div style="min-width:0;">
                            <div class="fw-bold" style="font-size:18px; color: var(--tsc-text);">
                                ${escapeHtml(name)}
                            </div>

                            <div class="text-muted small d-flex flex-wrap gap-3 mt-1">
                                <span><i class="mdi mdi-identifier text-muted me-1"></i>${escapeHtml(code)}</span>
                                <span><i class="mdi mdi-phone-outline text-muted me-1"></i>${escapeHtml(phoneText)}</span>
                                <span><i class="mdi mdi-bank-outline text-muted me-1"></i>${escapeHtml(branchText)}</span>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <div class="text-muted small">Balance</div>
                        <div class="fw-bold" style="font-size:16px;">
                            ${escapeHtml(balText)}
                        </div>
                    </div>

                </div>
            </div>
        </div>
    `);

        // Prepare existing loan area
        $("#existingLoansHint").text("Loading member loans…");
        $("#existingLoansEmpty").hide();
        $("#existingLoansWrap").empty();

        // Auto-load existing loans
        loadExistingLoans(member.id);
    }

    // -----------------------------
    // Existing Loans (Step 2)
    // -----------------------------
    $("#btnLoadExistingLoans").on("click", function () {
        var id = wizardState.memberId;
        if (id === null || id === undefined || id === "") {
            $("#existingLoansHint").text("Select a member first.");
            return;
        }
        loadExistingLoans(id);
    });

    function loadExistingLoans(memberId) {

        if (!memberId) {
            console.warn("loadExistingLoans called with empty memberId");
            $("#existingLoansHint").text("No member selected.");
            return;
        }

        if (!loansUrl) {
            console.error("loansUrl is empty. #loanUiRoutes missing OR route not rendered.");
            $("#existingLoansHint").text("Routes not loaded. Refresh or check layout.");
            return;
        }

        console.log("Calling GetMemberLoans:", loansUrl, "memberId:", memberId);

        $("#existingLoansHint").text("Loading member loans…");
        $("#existingLoansEmpty").hide();

        // ✅ ensure grid class is applied (2 cards per row)
        $("#existingLoansWrap")
            .addClass("loan-grid-wrap")
            .html(`
            <div class="tsc-empty" style="grid-column: 1 / -1;">
                <span class="tsc-spinner me-2"></span> Loading loans...
            </div>
        `);

        $.ajax({
            url: loansUrl,
            method: "GET",
            data: { memberId: memberId },
            cache: false
        })
            .done(function (res) {
                console.log("GetMemberLoans raw response:", res);

                var items =
                    (res && (res.data || res.Data || res.items || res.Items || res.result || res.Result)) ||
                    (Array.isArray(res) ? res : []);

                // ✅ newest first (support multiple possible date fields)
                items = (items || []).slice().sort(function (a, b) {
                    function getDate(x) {
                        var v =
                            x.createdOn ?? x.CreatedOn ??
                            x.disbursementDate ?? x.DisbursementDate ??
                            x.startDate ?? x.StartDate ??
                            x.applicationDate ?? x.ApplicationDate ??
                            x.updatedOn ?? x.UpdatedOn ??
                            null;

                        if (!v) return 0;
                        var t = new Date(v).getTime();
                        return isNaN(t) ? 0 : t;
                    }
                    return getDate(b) - getDate(a);
                });

                console.log("Parsed loans items:", items, "count:", items.length);

                renderLoans(items);
                $("#existingLoansHint").text(items.length ? "Select refinance/reschedule if needed." : "No active loans.");
            })
            .fail(function (xhr) {
                console.error("GetMemberLoans FAILED:", xhr.status, xhr.responseText);
                $("#existingLoansWrap").empty().addClass("loan-grid-wrap");
                $("#existingLoansHint").text("Failed to load. Click 'Load Existing Loans'.");
                $("#existingLoansEmpty").show();
            });
    }

    function fmtMoney(v, currency) {
        var n = Number(v || 0);
        return n.toLocaleString() + " " + (currency || "FCFA");
    }
    function fmtNum(v) {
        return Number(v || 0).toLocaleString();
    }

    function renderLoans(items) {
        var $wrap = $("#existingLoansWrap");
        $wrap.empty().addClass("loan-grid-wrap"); // ✅ ensures 2-per-row grid

        // ✅ ensure lookup exists for Step 3
        wizardState.loansById = wizardState.loansById || {};
        // optional: reset each time you render
        wizardState.loansById = {};

        if (!items || !items.length) {
            $("#existingLoansEmpty").show();
            return;
        }
        $("#existingLoansEmpty").hide();

        function pick(l, camel, pascal, fallback) {
            var v = (l && l[camel] !== undefined && l[camel] !== null) ? l[camel] : null;
            if (v !== null) return v;
            v = (l && l[pascal] !== undefined && l[pascal] !== null) ? l[pascal] : null;
            if (v !== null) return v;
            return fallback;
        }

        items.forEach(function (l) {

            // -----------------------------
            // Base fields
            // -----------------------------
            var id = pick(l, "id", "Id", "");
            var name = pick(l, "name", "Name", "Loan");
            var code = pick(l, "code", "Code", pick(l, "loanId", "LoanId", ""));
            var status = pick(l, "status", "Status", "Active");

            var currency = pick(l, "currency", "Currency", "FCFA");
            var amount = pick(l, "amount", "Amount", 0);
            var balance = pick(l, "balance", "Balance", 0);

            // -----------------------------
            // Extra fields
            // -----------------------------
            var accrualInterest = pick(l, "accrualInterest", "AccrualInterest", 0);
            var vat = pick(l, "vat", "VAT", pick(l, "Vat", "Vat", 0));
            var penalty = pick(l, "penalty", "Penalty", 0);

            var delinquentInterest = pick(l, "delinquentInterest", "DelinquentInterest", 0);
            var delinquentAmount = pick(l, "delinquentAmount", "DelinquentAmount", 0);
            var delinquentDays = pick(l, "delinquentDays", "DelinquentDays", 0);

            var totalDue = pick(l, "totalDueAmount", "TotalDueAmount", 0);

            // -----------------------------
            // Optional date for "most recent" display
            // -----------------------------
            var rawDate =
                (pick(l, "createdOn", "CreatedOn", null) ?? null) ??
                (pick(l, "disbursementDate", "DisbursementDate", null) ?? null) ??
                (pick(l, "startDate", "StartDate", null) ?? null) ??
                (pick(l, "applicationDate", "ApplicationDate", null) ?? null);

            var dateText = "";
            if (rawDate) {
                var dt = new Date(rawDate);
                if (!isNaN(dt.getTime())) dateText = dt.toLocaleDateString();
            }

            // -----------------------------
