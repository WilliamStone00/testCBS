            function setInvalid($el, isInvalid, message) {
                if (!$el || !$el.length) return;

                // If this is a select2 field, we must style the visible select2 UI,
                // not only the hidden <select>.
                var $s2 = $el.next(".select2");
                var $target = ($s2.length ? $s2.find(".select2-selection") : $el);

                // Find/create feedback element AFTER the visible target
                var $msg = null;
                if ($s2.length) {
                    $msg = $s2.nextAll(".invalid-feedback, .field-error").first();
                    if (!$msg.length) $msg = $('<div class="invalid-feedback d-block"></div>').insertAfter($s2);
                } else {
                    $msg = $el.nextAll(".invalid-feedback, .field-error").first();
                    if (!$msg.length) $msg = $('<div class="invalid-feedback d-block"></div>').insertAfter($el);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    $target.addClass("is-invalid");
                    $msg.text(message || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    $target.removeClass("is-invalid");
                    $msg.text("").hide();
                }
            }


