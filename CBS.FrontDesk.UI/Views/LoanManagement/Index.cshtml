                    var v = toNum($(this).val());
                    // clamp between 0 and available balance (if known)
                    var acc = (window.recoveryState.accounts || []).find(x => String(pick(x, "id", "Id", "")) === String(id));
                    var bal = acc ? toNum(pick(acc, "balance", "Balance", 0)) : null;
                    if (bal !== null && bal >= 0 && v > bal) v = bal;
                    if (v < 0) v = 0;
                    selected[id].amount = v;
                    $(this).val(v);
                    // reflect to downpayment immediately
                    try { renderDownpaymentBox(); } catch (e) { }

                });
            }

            function bindRecoveryEditorEvents() {
                // remove card
                $(".tsc-recovery-remove").off("click").on("click", function () {
                    var id = String($(this).data("id"));
                    selectedRecoveryIds = selectedRecoveryIds.filter(x => x !== id);
                    delete recoverySelections[id];
                    $(`.tsc-recovery-cb[value="${id}"]`).prop("checked", false);
                    renderRecoveryEditor();
                });

                // decision change
                $(".tsc-recovery-decision").off("change").on("change", function () {
                    var id = String($(this).data("id"));
                    var decision = String($(this).val() || "Blocked");
                    recoverySelections[id] = recoverySelections[id] || { decision: "Blocked", amount: 0 };
                    recoverySelections[id].decision = decision;

                    // if keep open => disable amount and force 0
                    var $amt = $(`.tsc-recovery-amount[data-id="${id}"]`);
                    if (decision === "KeepOpen") {
                        recoverySelections[id].amount = 0;
                        $amt.val(0).prop("disabled", true).removeClass("is-invalid");
                    } else {
                        $amt.prop("disabled", false);
                    }

                    buildRecoverySubmissionJson();
                });

                // amount change
                $(".tsc-recovery-amount").off("input blur").on("input blur", function () {
                    var $i = $(this);
                    var id = String($i.data("id"));
                    var v = toNum($i.val());
                    var acc = recoveryAccountsCache.find(x => String(x.Id || x.id) === id);
                    var bal = toNum(acc ? (acc.Balance || acc.balance) : 0);

                    if (v > bal) {
                        $i.addClass("is-invalid");
                        v = bal;
                        $i.val(v);
                    } else {
                        $i.removeClass("is-invalid");
                    }

