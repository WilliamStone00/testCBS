            // Provided = sum of all selected coobligor/shotee blocked amounts + any other selected recovery accounts
            // NOTE: you said: "sum of selected accounts excluding ordinaryshares must be the % of amount requested"
            // We'll compute using recoveryState.selected if present, ignoring ordinary shares.

            function computeDownpaymentProvidedFromRecovery() {
                // Provided = Recovery Accounts amounts (EXCLUDING shares) + Guarantors contributions + Collateral estimated amounts
                var provided = 0;

                // 1) Recovery accounts (exclude ordinary/preference shares)
                $(".recovery-selected-card").each(function () {
                    var $card = $(this);
                    var a = $card.data("account") || {};
                    var amt = parseMoney($card.find(".txtRecoveryAmount").val());
                    if (isNaN(amt) || amt < 0) amt = 0;

                    if (isOrdinaryShares(a) || isPreferenceShares(a)) return;
                    provided += amt;
                });

                // 2) Guarantors contributions (COOBLIGOR / SHOTEE / INTER_COOPERATION: blocked amount, MORAL: guarantee amount)
                var gsum = 0;
                (wizardState.guarantors || []).forEach(function (g) {
                    var type = String(g.guarantorType || "").toUpperCase();
                    var amt = toNum(g.amount || 0);

                    if (type === "COOBLIGOR" || type === "SHOTEE" || type === "INTER_COOPERATION") {
                        gsum += amt; // blocked amount
                    } else if (type === "MORAL_GUARANTOR" || type === "MORAL" || type === "MORAL GUARANTOR") {
                        gsum += amt; // guarantee amount
                    }
                });

                // 3) Collateral estimated amounts
                var csum = 0;
                (wizardState.collaterals || []).forEach(function (c) {
                    csum += toNum(c.estimatedAmount || c.amount || 0);
                });

                return provided + gsum + csum;
            }

