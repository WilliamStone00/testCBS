                            '<div class="card border-0 mb-2" style="background:#f3f4f6;">' +
                            '<div class="card-body py-2">' +
                            '<div class="fw-bold mb-2 text-dark"><i class="mdi mdi-history me-1"></i> Old Loan Details</div>' +

                            (oldId ? '<div class="d-flex justify-content-between"><span class="text-muted">Loan Id</span><span class="fw-semibold text-dark">' + esc(oldId) + '</span></div>' : '') +

