                    var $policy = $("#ddlRecoveryPolicy");

                    // If policy control is present in the UI, validate it
                    if ($policy.length && $policy.is(":visible") && !$policy.is(":disabled")) {

                        var policyMode = $policy.val();

                        if (!policyMode) {
                            $policy.addClass("is-invalid");

                            // bootstrap invalid-feedback (create if missing)
                            var $fb = $policy.nextAll(".invalid-feedback").first();
                            if (!$fb.length) $fb = $('<div class="invalid-feedback"></div>').insertAfter($policy);
                            $fb.text("Please select a recovery policy.");

                            // scroll to it
                            $("html, body").animate({ scrollTop: $policy.offset().top - 120 }, 250);
                            return false;
                        } else {
                            $policy.removeClass("is-invalid");
                        }

                        // PARTIAL_BLOCK validation only applies if dropdown exists and mode is selected
                        if (policyMode === "PARTIAL_BLOCK") {
                            var valid = true;

                            $(".recovery-block-amount").each(function () {
                                var $i = $(this);
                                var val = parseFloat($i.val());
                                var max = parseFloat($i.data("balance"));

                                if (isNaN(val) || val <= 0 || val > max) {
                                    clampInterestToPolicy
                                    $i.addClass("is-invalid");
                                    valid = false;
                                } else {
                                    $i.removeClass("is-invalid");
                                }
                            });

                            if (!valid) return false;
                        }
                    }

                    // If policy dropdown is NOT present/visible, we skip policy validation completely.
                    // (Your UI is account-based recovery without a policy selector.)
                }

                // Down payment percentage validation
                if (!validateDownPaymentPolicy()) return false;

                if (!validateSavingsAndSharesAreEnteredAndValid()) return false;

                return true;
            }
            function getLoanAmount() {
                var v = parseFloat($("#txtAmount").val());
                return isNaN(v) ? 0 : v;
            }

            function computeSavingsCoverageProvided() {
                var loanAmount = getLoanAmount();
                var amt = parseFloat($("#txtSavingsCoverage").val() || 0);
                var rate = parseFloat($("#txtShareMinimumRequiredAmount").val() || 0);

                var fromRate = (loanAmount > 0 && rate > 0) ? (loanAmount * rate / 100.0) : 0;
                return Math.max(amt || 0, fromRate || 0); // user can enter either
            }
            function validateSavingsAndSharesAreEnteredAndValid() {
                var policy = window.productPolicy || {};
                var loanAmount = getLoanAmount();
                if (!loanAmount || loanAmount <= 0) return true;

                // Required savings = max(abs, percent)
                var pct = parseFloat(policy.minSavingsPercent) || 0;
                var abs = parseFloat(policy.minSavingsAbs) || 0;
                var pctAmt = (loanAmount * pct) / 100.0;
                var requiredSavings = Math.max(abs, pctAmt);

                // Required shares
                var requiredShares = parseFloat(policy.minSharesRequired) || 0;

                // Provided savings coverage (entered by manager)
                var providedSavings = computeSavingsCoverageProvided();

                // Blocked sums (from selected accounts)
                var sums = computeBlockedByKind(); // uses recoveryBlocks + inferAccountKindFromText

                // Enforce savings coverage entered
                if (requiredSavings > 0) {
                    // must enter either amount or rate (so providedSavings > 0)
                    if (providedSavings <= 0) {
                        alert(
                            "Savings coverage is required by policy.\n" +
                            "Please enter Savings Coverage Amount or Savings Coverage Rate."
                        );
                        $("#txtSavingsCoverage").addClass("is-invalid");
                        $("#txtShareMinimumRequiredAmount").addClass("is-invalid");
                        return false;
                    }

                    // must meet required
                    if (providedSavings < requiredSavings) {
                        alert(
                            "Savings coverage is insufficient.\n" +
                            "Required: " + requiredSavings.toLocaleString() + " FCFA\n" +
                            "Provided: " + providedSavings.toLocaleString() + " FCFA\n" +
                            "Tip: increase savings coverage amount or rate."
                        );
                        $("#txtSavingsCoverage").addClass("is-invalid");
                        $("#txtShareMinimumRequiredAmount").addClass("is-invalid");
                        return false;
                    }

                    $("#txtSavingsCoverage").removeClass("is-invalid");
                    $("#txtShareMinimumRequiredAmount").removeClass("is-invalid");
                }

                // Enforce shares: must be blocked through share accounts
                if (requiredShares > 0) {
                    if (!$("#chkRecoveryMechanism").is(":checked")) {
                        alert("Shares blocking is required by policy. Enable recovery mechanism and select the shares account.");
                        return false;
                    }

                    if (sums.SHARES < requiredShares) {
                        alert(
                            "Minimum shares requirement not met.\n" +
                            "Required Shares: " + requiredShares.toLocaleString() + " FCFA\n" +
                            "Blocked Shares: " + sums.SHARES.toLocaleString() + " FCFA\n" +
                            "Tip: block more on Ordinary Shares account."
                        );
                        return false;
                    }
                }

                return true;
            }

            function inferAccountKindFromText(text) {
                var t = String(text || "").toLowerCase();
                // You can adjust keywords to match your labels
                if (t.includes("ordinary shares") || t.includes("shares") || t.includes("shr-")) return "SHARES";
                if (t.includes("savings") || t.includes("sav-")) return "SAVINGS";
                return "OTHER";
            }




            function validateDownPaymentPolicy() {
                var policy = window.productPolicy || {};
                if (!policy.requireDownPayment) return true;

                var loanAmount = getLoanAmount();
                var rate = parseFloat(policy.downPaymentRatePercent) || 0;

                // If policy says down payment required, rate must be > 0
                if (rate <= 0) {
                    appalert("Down payment policy is enabled but rate is not configured.", 2, 1);
                    return false;
                }

                var required = (loanAmount * rate) / 100.0;
                var actual = computeDownPaymentFromSelectedAccounts();

                if (actual < required) {
                    appalert(
                        "Down payment is insufficient.\n" +
                        "Required (" + rate + "%): " + required.toLocaleString() + " FCFA\n" +
                        "Provided: " + actual.toLocaleString() + " FCFA\n" +
                        "Tip: select more non-share accounts or increase blocking amounts."
                        , 2, 1);
                    return false;
                }

                return true;
            }
            function getLoanAmount() {
                var v = parseFloat($("#txtAmount").val());
                return isNaN(v) ? 0 : v;
            }

            // blocks: output from window.tscRecovery.getBlocks()
            // You must mark share accounts in option data:
            // <option ... data-is-share="1"></option>
            function computeDownPaymentFromSelectedAccounts() {

                var blocks = (window.tscRecovery && window.tscRecovery.getBlocks)
                    ? window.tscRecovery.getBlocks()
                    : [];

                // Build lookup for isShareAccount from select options
                var shareMap = {};
                $("#ddlRecoveryAccounts option").each(function () {
                    var id = this.value;
                    var isShare = String($(this).attr("data-is-share") || "").toLowerCase();
                    shareMap[id] = (isShare === "1" || isShare === "true" || isShare === "yes");
                });

                var sum = 0;
                for (var i = 0; i < blocks.length; i++) {
                    var b = blocks[i];
                    var isShareAcc = shareMap[b.AccountId] === true;
                    if (!isShareAcc) sum += (parseFloat(b.BlockAmount) || 0);
                }
                return sum;
            }

            // ✅ Bind to both (safe)
            $(document).off("click.tscRisk", "#btnSubmitApplication")
                .on("click.tscRisk", "#btnSubmitApplication", function (e) {

                    var mode = String((window.wizardState && wizardState.restructureMode) || "NEW").toUpperCase();
                    var isReschedule = (mode === "RESCHEDULE");

