            function normalizeDecision(d) {
                var x = (d || "").toString().trim();
                if (!x) return "Blocked";
                return x;
            }

            function getRecoveryBlocksFromUI() {
                // ✅ Always refresh hidden json first (Step3 truth)
                syncRecoveryHiddenFromUI();

                var raw = safeJsonParse($(IDS.RecoveryJson).val(), []);
                raw = Array.isArray(raw) ? raw : [];

                // Normalize to one shape
                return raw.map(function (r) {
                    var accId = String(r.AccountId || r.accountId || "");
                    var accNo = (r.AccountNumber || "").toString().trim();
                    var accName = (r.AccountName || r._Label || r.Label || "").toString().trim();

                    // Step3 uses Decision; legacy uses BlockedStatus
                    var decision = normalizeDecision(r.Decision || r.BlockedStatus || "Blocked");

                    if (!accNo && accName) accNo = parseAccountNumberFromLabel(accName);

                    return {
                        AccountId: accId,
                        AccountNumber: accNo,
                        AccountType: (r.AccountType || "").toString(),
                        AccountName: accName,
                        BlockAmount: num(r.BlockAmount || 0),
                        BlockedStatus: decision,  // keep for preview/legacy renderers
                        Decision: decision,       // keep for backend if it expects Decision
                        _Label: (r._Label || r.Label || accName || "").toString()
                    };
                }).filter(function (x) { return !!x.AccountId; });
            }

            function buildRecoveryAmountsSummary() {
                syncRecoveryHiddenFromUI();

                var raw = safeJsonParse($(IDS.RecoveryJson).val(), []);
                if (!Array.isArray(raw)) raw = [];

                var labelMap = {};
                $("#ddlRecoveryAccounts option").each(function () { labelMap[this.value] = $(this).text() || ""; });

                var savings = 0;
                var ordinaryShares = 0;
                var preferenceShares = 0;
                var others = 0;

                for (var i = 0; i < raw.length; i++) {
                    var r = raw[i] || {};
                    var amt = num(r.BlockAmount || r.Amount || r.amount || 0);
                    var kind = classifyRecoveryAccount(r, labelMap);

                    if (kind === "SAVINGS") savings += amt;
                    else if (kind === "ORDINARY_SHARES") ordinaryShares += amt;
                    else if (kind === "PREFERENCE_SHARES") preferenceShares += amt;
                    else others += amt;
                }

                var totalExclOrdShares = savings + preferenceShares + others;

                return {
                    SavingsCoverageAmount: savings,
                    OrdinarySharesAmountProvided: ordinaryShares,
                    TotalDownpaymentAmountProvided: totalExclOrdShares,
                    _dbg: {
                        Savings: savings,
                        OrdinaryShares: ordinaryShares,
                        PreferenceShares: preferenceShares,
                        Others: others,
                        TotalAll: (savings + ordinaryShares + preferenceShares + others),
                        TotalExclOrdShares: totalExclOrdShares
                    }
                };
            }

