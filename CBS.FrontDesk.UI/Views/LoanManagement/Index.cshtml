            function ensureFieldErrorEl($el) {
                // Put an error element right under the input/select
                var $err = $el.siblings(".field-error");
                if (!$err.length) {
                    $err = $('<div class="field-error text-danger small mt-1" style="display:none;"></div>');
                    $el.after($err);
                }
                return $err;
            }
            function validateAmountLive() {
                var mode = String(wizardState.restructureMode || "NEW").toUpperCase();
                if (mode === "RESCHEDULE") {
                    // requested amount is forced from old loan, so don't block the UI
                    setFieldInvalid($("#txtAmount"), false);
                    return true;
                }
                var policy = window.productPolicy || {};
                var minA = Number(policy.minAmount || 0);
                var maxA = Number(policy.maxAmount || 0);

                var $a = $("#txtAmount");
                var raw = ($a.val() || "").trim();
                var v = parseFloat(raw);

                if (!raw) {
                    setFieldInvalid($a, false);
                    return true;
                }

                var ok = inRangeNumber(v, minA, maxA);
                setFieldInvalid(
                    $a,
                    !ok,
                    "Amount must be within policy range (" +
                    Number(minA).toLocaleString() + " - " +
                    Number(maxA).toLocaleString() + " FCFA)."
                );

                return ok;
            }

            $("#txtAmount")
                .off(".amountPolicy")
                .on("input.amountPolicy blur.amountPolicy", function () {
                    validateAmountLive();
                });

            function validateRepaymentPeriodLive() {
                var policy = window.productPolicy || {};
                var minM = Number(policy.minMonth || 0);
                var maxM = Number(policy.maxMonth || 0);

                var $rp = $("#ddlRepaymentPeriod");
                var rp = Number($rp.val() || 0);

                // allowed list from productCache
                var periods = (productCache && (productCache.Periods || productCache.periods)) || [];
                var allowed = periods && periods.length ? periods.map(Number).indexOf(rp) >= 0 : true;

                var ok = (rp > 0) && allowed && inRangeNumber(rp, minM, maxM);

                setFieldInvalid(
                    $rp,
                    !ok,
                    "Repayment period must be within policy range (" + minM + " - " + maxM + " months) and match allowed periods."
                );

                return ok;
            }



            $("#ddlRepaymentPeriod")
