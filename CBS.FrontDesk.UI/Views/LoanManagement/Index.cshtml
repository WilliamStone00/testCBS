                           class="form-control form-control-sm tsc-recovery-amount"
                           data-id="${esc(id)}"
                           min="0"
                           max="${bal}"
                           value="${toNum(sel.amount)}"
                           ${(sel.decision === "KeepOpen" || sel.decision === "Required") ? "disabled" : ""}>
                  </div>

                  <div class="col-7">
                    <label class="form-label small text-muted mb-1">Decision</label>
                    <select class="form-select form-select-sm tsc-recovery-decision"
                            data-id="${esc(id)}"
                            ${(locked || required) ? "disabled" : ""}>
                      <option value="Blocked" ${sel.decision === "Blocked" ? "selected" : ""}>Blocked</option>
                      <option value="StandingOrder" ${sel.decision === "StandingOrder" ? "selected" : ""}>StandingOrder</option>
                      <option value="KeepOpen" ${sel.decision === "KeepOpen" ? "selected" : ""}>KeepOpen</option>
                      <option value="Lien" ${sel.decision === "Lien" ? "selected" : ""}>Lien</option>
                      <option value="Required" ${sel.decision === "Required" ? "selected" : ""} disabled>Required (Policy)</option>
                    </select>
                  </div>
                </div>

                ${sel.reason ? `<div class="text-muted small mt-1">${esc(sel.reason)}</div>` : ""}

              </div>
            </div>
          </div>
        `;
                }).join("");

                $("#recoveryAmountsList").html(`<div class="row g-2 mt-1">${cards}</div>`);

                $("#recoveryCard #btnRecoveryClear").off("click").on("click", function () {
                    clearRecoveryNonPolicySelection();
                });

                $(".tsc-recovery-remove").off("click").on("click", function () {
                    var id = String($(this).data("id"));
                    if (selected[id] && selected[id].locked) return;
                    delete selected[id];
                    renderRecoveryPicker();
                    renderRecoveryEditor();
