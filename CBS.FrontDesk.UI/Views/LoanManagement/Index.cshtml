            function showErr(msg) {
                if (window.alertify && alertify.error) alertify.error(msg);
                else alert(msg);
            }
            function setRequired($el, yes) {
                if (!$el || !$el.length) return;
                if (yes) $el.attr("required", "required");
                else $el.removeAttr("required");
            }
            function isMemberBackedGuarantorType(t) {
                // ✅ Only these types are linked to an institution member reference.
                // Inter-Cooperation is treated like Moral Guarantor (manual KYC, no lookup).
                t = String(t || "").toUpperCase();
                return (t === "COOBLIGOR" || t === "SHOTEE");
            }
            function validateIdDates($card) {
                if (!$card || !$card.length) return true;
                var issue = $card.find(".txtIssueDate").val();
                var exp = $card.find(".txtExpireDate").val();
                if (!issue || !exp) return false;
                var dIssue = new Date(issue + "T00:00:00");
                var dExp = new Date(exp + "T00:00:00");
                var today = new Date(); today.setHours(0, 0, 0, 0);
                if (isNaN(dIssue.getTime()) || isNaN(dExp.getTime())) return false;
                if (dExp <= dIssue) {
                    showErr("ID Expiry date must be after issue date.");
                    $card.find(".txtExpireDate").val("");
                    return false;
                }
                if (dExp < today) {
                    showErr("ID Expiry date cannot be in the past.");
                    $card.find(".txtExpireDate").val("");
                    return false;
                }
                return true;
            }
            function applyGuarantorRequirements($card) {
                var t = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                var memberBacked = isMemberBackedGuarantorType(t);

                // Always required (per requirement)
                setRequired($card.find(".ddlGuarantorType"), true);
                setRequired($card.find(".ddlRelationship"), true);
                setRequired($card.find(".txtNameCompany"), true);
                setRequired($card.find(".txtIdCardNumber"), true);
                setRequired($card.find(".txtIssueDate"), true);
                setRequired($card.find(".txtExpireDate"), true);
                setRequired($card.find(".txtPhone"), true);
                setRequired($card.find(".txtAddress"), true);

                // Member-backed required
                setRequired($card.find(".txtMemberRef"), memberBacked);
                setRequired($card.find(".ddlAccount"), memberBacked);
                setRequired($card.find(".txtBlockAmount"), memberBacked);
                setRequired($card.find(".ddlBlockFlag"), memberBacked);

                // Sync block amount -> guarantee amount and lock guarantee for member-backed
                var $gAmt = $card.find(".txtGuaranteeAmount");
                var $bAmt = $card.find(".txtBlockAmount");
                if (memberBacked) {
                    $gAmt.prop("readonly", true);
                    var bv = $bAmt.val() ? Number($bAmt.val()) : 0;
                    $gAmt.val(isFinite(bv) ? bv : 0);
                } else {
                    $gAmt.prop("readonly", false);
                }
            }

            function rebuildGuarantorsJson() {
                // normalize from DOM
                var arr = [];
                $("#guarantorList [data-gid]").each(function () {
                    var $c = $(this);
                    var gid = $c.data("gid");

                    var type = String($c.find(".ddlGuarantorType").val() || "").toUpperCase();
                    var isMemberBacked = (type === "COOBLIGOR" || type === "SHOTEE" || type === "INTER_COOPERATION");

                    var item = {
                        id: gid,
                        guarantorType: type,
                        memberReference: $c.find(".txtMemberRef").val() || "",
                        memerberName: $c.find(".txtNameCompany").val() || "",
                        companyOrGroupName: $c.find(".txtNameCompany").val() || "",
                        affiliateOrInstitutionName: $c.find(".txtNameCompany").val() || "",

                        idCardNumber: $c.find(".txtIdCardNumber").val() || "",
                        issueDate: $c.find(".txtIssueDate").val() || "",
                        expireDate: $c.find(".txtExpireDate").val() || "",

                        relationship: $c.find(".txtRelationship").val() || "",
                        address: $c.find(".txtAddress").val() || "",
                        phoneNumber: $c.find(".txtPhone").val() || "",
                        email: $c.find(".txtEmail").val() || "",

                        guaranteeAmount: toNum($c.find(".txtGuaranteeAmount").val() || 0),

                        // for coobligor/shotee/intercoop
                        accountNumber: isMemberBacked ? ($c.find(".ddlAccount").val() || "") : "",
                        amount: isMemberBacked ? toNum($c.find(".txtBlockAmount").val() || 0) : 0,
                        blockAccount: isMemberBacked ? String($c.find(".ddlBlockFlag").val() || "true") === "true" : false,

                        // release order (assigned later)
                        releaseOrder: null
                    };

                    arr.push(item);
                });

                // release order assignment if needed (only for blocking member-backed entries)
                var blockables = arr.filter(x =>
                    (x.guarantorType === "COOBLIGOR" || x.guarantorType === "SHOTEE" || x.guarantorType === "INTER_COOPERATION") &&
                    x.blockAccount === true && toNum(x.amount) > 0
                );

                // require release order only if more than 1
                $("#releaseOrderWrap").toggle(blockables.length > 1);

                if (blockables.length > 1) {
                    // build UI
                    var html = "";
                    blockables.forEach(function (x) {
                        html += `
  <div class="col-12 col-md-6" data-rid="${escHtml(x.id)}">
    <div class="border rounded p-2">
      <div class="fw-semibold small">${escHtml(x.memerberName || x.memberReference || x.id)}</div>
