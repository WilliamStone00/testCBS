            function evaluateScore() {
                try {
                    var amount = Number($("#txtAmount").val() || 0);

                    if (!amount || amount <= 0) {
                        $("#scoreResultBox").hide();
                        return;
                    }

                    var score = getSelectedScorePoints();
                    var required = requiredScoreByAmount(amount);

                    var overBonus = scoreConfig ? Number(scoreConfig.overScoreBonus || scoreConfig.OverScoreBonus || 15) : 15;
                    var medBuf = scoreConfig ? Number(scoreConfig.mediumRiskBuffer || scoreConfig.MediumRiskBuffer || 10) : 10;

                    // suggested amount based on bands
                    var suggested = suggestedMaxAmountByScore(score);

                    // cap by policy max
                    var policy = window.productPolicy || {};
                    var policyMax = Number(policy.maxAmount || policy.MaxAmount || 0);
                    if (suggested > 0 && policyMax > 0) suggested = Math.min(suggested, policyMax);

                    // If suggested is 0 (score below all bands), we can still show a tiny guidance:
                    // recommended amount = min band max where score could pass? => use delta
                    var recommendationText = "";
                    var approvedAmount = (suggested > 0 ? suggested : 0);

                    // Determine status
                    var status, badgeClass, advice;

                    if (score >= required + overBonus) {
                        status = "NO RISK";
                        badgeClass = "bg-success";
                        advice = "Recommendation: Proceed. Member is strongly above required score for this amount.";
                    } else if (score >= required) {
                        status = "LOW RISK";
                        badgeClass = "bg-primary";
                        advice = "Recommendation: Proceed with normal controls. Consider light mitigation if policy requires.";
                    } else if (score >= required - medBuf) {
                        status = "MEDIUM RISK";
                        badgeClass = "bg-warning text-dark";
                        advice = "Recommendation: Reduce amount OR add stronger mitigation (blocking/guarantor/collateral) before approval.";
                    } else {
                        status = "HIGH RISK";
                        badgeClass = "bg-danger";
                        advice = "Recommendation: Do not proceed unless exceptional mitigation is added OR the amount is reduced significantly.";
                    }

                    // Show recommended/approved amount line
                    if (approvedAmount > 0) {
                        if (amount > approvedAmount) {
                            recommendationText =
                                "Recommended approved amount: " + approvedAmount.toLocaleString() + " FCFA. " +
                                "Requested amount is higher than scoring comfort.";
                        } else {
                            recommendationText =
                                "Recommended approved amount: up to " + approvedAmount.toLocaleString() + " FCFA.";
                        }
                        if (policyMax > 0 && approvedAmount === policyMax) {
                            recommendationText += " (Capped by product policy limit)";
                        }
                    } else {
                        recommendationText =
                            "Recommended approved amount: Not available (score does not meet minimum bands).";
                    }

                    $("#scoreSuggestedAmount").text(recommendationText);

                    $("#scoreResultBox").show();
                    $("#scoreBadge").attr("class", "badge rounded-pill " + badgeClass).text(status);
                    $("#scoreValue").text(score);
                    $("#scoreRequired").text(required);
                    $("#scoreAdvice").text(advice);

                    // delta
                    var delta = score - required;
                    $("#scoreDelta")
                        .text((delta >= 0 ? "+" : "") + delta + " pts")
                        .toggleClass("text-success", delta >= 0)
                        .toggleClass("text-danger", delta < 0);

                } catch (e) {
                    console.error("evaluateScore failed:", e);
                }
