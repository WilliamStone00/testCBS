                    var number = pick(a, "accountNumber", "AccountNumber", "");
                    var name = pick(a, "accountName", "AccountName", "");
                    var bal = toNum(pick(a, "balance", "Balance", 0));
                    var cur = pick(a, "currency", "Currency", "FCFA");
                    var status = pick(a, "status", "Status", "");

