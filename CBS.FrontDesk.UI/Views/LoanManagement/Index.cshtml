            function _buildMemberGuarantorCommon(g) {
                return {
                    MemerberName: (g.MemerberName || g.MemberName || "").toString(),
                    MemerberReference: (g.MemerberReference || g.MemberReference || "").toString(),
                    IdCardNumber: (g.IdCardNumber || "").toString(),
                    ExpireDate: (g.ExpireDate || "").toString(),
                    IssueDate: (g.IssueDate || "").toString(),
                    Relationship: (g.Relationship || "").toString(),
                    Address: (g.Address || "").toString(),
                    PhoneNumber: (g.PhoneNumber || "").toString(),
                    Email: (g.Email || "").toString(),
                    GuaranteeAmount: num(g.GuaranteeAmount || 0),
                    AccountNumber: (g.AccountNumber || "").toString(),
                    Amount: num(g.Amount || 0),
                    BlockAccount: boolVal(g.BlockAccount),
                    AccountId: (g.AccountId || "").toString(),

                    // ✅ NEW: keep what you already capture from UI
                    ReleaseOrder: (g.ReleaseOrder || "").toString()
                };
            }
            function buildReleaseOrders() {
                var all = readAllGuarantors();
                var map = {}; // MemberReference -> order (take smallest)

                function parseOrder(raw) {
                    if (raw === null || raw === undefined) return null;
                    var s = (raw + "").trim();
                    if (!s) return null;

                    // allow "1", "01", "Order 1", etc.
                    var m = s.match(/\d+/);
                    if (!m) return null;

                    var n = parseInt(m[0], 10);
                    return isNaN(n) ? null : n;
                }

                all.forEach(function (g) {
                    var memberRef = (g.MemerberReference || g.MemberReference || "").toString().trim();
                    if (!memberRef) return;

                    var ord = parseOrder(g.ReleaseOrder);
                    if (ord === null) return;

                    // keep smallest order if duplicated
                    if (map[memberRef] === undefined || ord < map[memberRef]) {
                        map[memberRef] = ord;
                    }
                });

                var list = Object.keys(map).map(function (k) {
                    return { MemberReference: k, Order: map[k] };
                });

                // sort by order
                list.sort(function (a, b) { return (a.Order || 0) - (b.Order || 0); });

                return list;
            }


