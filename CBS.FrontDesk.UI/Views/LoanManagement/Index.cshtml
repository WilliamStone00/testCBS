@using Resources
@{
    ViewBag.Title = "Loan Management";
}



<style>
    .tsc-card-soft {
        border-radius: 18px;
        border: 1px solid rgba(15,23,42,.08);
        box-shadow: 0 10px 24px rgba(15,23,42,.06);
    }

    .tsc-title {
        font-weight: 900;
        color: var(--tsc-text);
    }

    .tsc-policy-box {
        border: 1px solid rgba(15,23,42,.07);
        border-radius: 14px;
        padding: 12px;
        background: rgba(15,23,42,.02);
    }

    .tsc-divider {
        height: 1px;
        background: rgba(15,23,42,.08);
    }

    .tsc-score-result {
        border-radius: 14px;
        padding: 12px;
        border: 1px solid rgba(15,23,42,.08);
    }
</style>
<style>
    /* -----------------------------
       TSC Soft UI Tokens
    ----------------------------- */
    :root {
        --tsc-bg: #f6f7fb;
        --tsc-card: #ffffff;
        --tsc-border: rgba(15, 23, 42, .08);
        --tsc-text: #0f172a;
        --tsc-muted: rgba(15, 23, 42, .65);
        --tsc-primary: #2563eb; /* adjust to your TSC primary */
        --tsc-soft: rgba(37, 99, 235, .10);
        --tsc-shadow: 0 10px 28px rgba(15, 23, 42, .08);
        --tsc-radius: 18px;
    }

    body {
        background: var(--tsc-bg) !important;
    }

    .tsc-wrap {
        padding: 18px 0 24px;
    }

    .tsc-banner {
        background: var(--tsc-card);
        border: 1px solid var(--tsc-border);
        border-radius: var(--tsc-radius);
        box-shadow: var(--tsc-shadow);
        padding: 18px 18px;
    }

    .tsc-title {
        font-weight: 800;
        color: var(--tsc-text);
        font-size: 30px;
    }

    .tsc-subtitle {
        color: var(--tsc-muted);
        margin-top: 2px;
    }

    .tsc-card {
        background: var(--tsc-card);
        border: 1px solid var(--tsc-border);
        border-radius: var(--tsc-radius);
        box-shadow: var(--tsc-shadow);
    }

    .tsc-stepper {
        background: var(--tsc-card);
        border: 1px solid var(--tsc-border);
        border-radius: var(--tsc-radius);
        box-shadow: var(--tsc-shadow);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        overflow: auto;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
        color: var(--tsc-muted);
        font-weight: 700;
    }

        .step .dot {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--tsc-border);
            background: #fff;
            color: var(--tsc-muted);
            flex: 0 0 auto;
        }

        .step.active {
            color: var(--tsc-primary);
        }

            .step.active .dot {
                border-color: rgba(37,99,235,.35);
                background: var(--tsc-soft);
                color: var(--tsc-primary);
            }

        .step.done .dot {
            border-color: rgba(34,197,94,.35);
            background: rgba(34,197,94,.10);
            color: rgba(21,128,61,1);
        }

    .step-line {
        height: 2px;
        width: 70px;
        background: rgba(15,23,42,.10);
        border-radius: 99px;
        flex: 0 0 auto;
    }

    .tsc-section-title {
        font-weight: 800;
        color: var(--tsc-text);
        margin: 0;
    }

    .tsc-help {
        color: var(--tsc-muted);
        margin: 6px 0 0;
        font-size: 13px;
    }

    .tsc-input {
        border-radius: 14px !important;
        border: 1px solid var(--tsc-border) !important;
        padding: 12px 14px !important;
        height: 48px;
        background: #fff;
    }

        .tsc-input:focus {
            border-color: rgba(37,99,235,.35) !important;
            box-shadow: 0 0 0 .25rem rgba(37,99,235,.12) !important;
        }

    .member-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .member-card {
        border: 1px solid var(--tsc-border);
        border-radius: 16px;
        padding: 14px 14px;
        background: #fff;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

        .member-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 26px rgba(15,23,42,.10);
        }

    .member-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        background: rgba(37,99,235,.10);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--tsc-primary);
        flex: 0 0 auto;
    }

    .member-name {
        font-weight: 800;
        color: var(--tsc-text);
        margin: 0;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .member-meta {
        color: var(--tsc-muted);
        font-size: 12px;
        margin-top: 2px;
    }

    .balance-box {
        text-align: right;
        flex: 0 0 auto;
    }

    .balance-label {
        color: var(--tsc-muted);
        font-size: 12px;
    }

    .balance-value {
        font-weight: 900;
        color: var(--tsc-text);
        font-size: 16px;
    }

    .tsc-empty {
        border: 1px dashed rgba(15,23,42,.18);
        border-radius: 16px;
        padding: 18px;
        color: var(--tsc-muted);
        background: rgba(255,255,255,.65);
    }

    .tsc-spinner {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid rgba(15,23,42,.15);
        border-top-color: rgba(37,99,235,.9);
        animation: spin .7s linear infinite;
        display: inline-block;
        vertical-align: middle;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .tsc-btn-primary {
        border-radius: 14px;
        padding: 10px 14px;
        font-weight: 800;
    }



    /* Facility tiles */
    .facility-tile {
        border: 1px solid var(--tsc-border);
        border-radius: 16px;
        padding: 16px 16px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
        min-height: 86px;
        position: relative;
    }

        .facility-tile:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 26px rgba(15,23,42,.10);
        }

        .facility-tile.selected {
            border-color: rgba(37,99,235,.35);
            background: rgba(37,99,235,.06);
        }

    .tile-icon {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        background: rgba(37,99,235,.10);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--tsc-primary);
        flex: 0 0 auto;
        font-size: 20px;
    }

    .tile-title {
        font-weight: 900;
        color: var(--tsc-text);
    }

    .tile-sub {
        color: var(--tsc-muted);
        font-size: 12px;
        margin-top: 2px;
    }

    .tile-text {
        min-width: 0;
    }

    .tile-check {
        opacity: 0;
        color: rgba(21,128,61,1);
        font-size: 22px;
        flex: 0 0 auto;
    }

    .facility-tile.selected .tile-check {
        opacity: 1;
    }

    .loan-card {
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 18px;
        background: #fff;
        padding: 14px;
        box-shadow: 0 10px 24px rgba(15,23,42,.06);
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }

        .loan-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 32px rgba(15,23,42,.10);
            border-color: rgba(37,99,235,.18);
        }

    .loan-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(15,23,42,.06);
        margin-bottom: 10px;
    }

    .loan-title {
        font-weight: 900;
        margin: 0;
        color: var(--tsc-text);
        font-size: 15px;
        line-height: 1.1;
    }

    .loan-sub {
        color: var(--tsc-muted);
        font-size: 12px;
        margin-top: 3px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .loan-sub .dot {
            opacity: .35;
        }

    .loan-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 12px;
        padding: 12px;
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 14px;
        background: rgba(15,23,42,.02);
    }

    .metric .k {
        color: var(--tsc-muted);
        font-size: 11px;
    }

    .metric .v {
        font-weight: 900;
        color: var(--tsc-text);
        font-size: 13px;
    }

    .metric.due {
        grid-column: 1 / -1;
        background: rgba(37,99,235,.06);
        border-radius: 12px;
        padding: 10px;
        border: 1px solid rgba(37,99,235,.12);
    }

    .loan-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .loan-date {
        font-size: 11px;
        color: var(--tsc-muted);
    }

    /* status pill look */
    .status-pill {
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(15,23,42,.04);
    }

        .status-pill.active {
            background: rgba(34,197,94,.10);
            border-color: rgba(34,197,94,.22);
            color: rgba(21,128,61,1);
        }

        .status-pill.delinquent {
            background: rgba(245,158,11,.12);
            border-color: rgba(245,158,11,.25);
            color: rgba(180,83,9,1);
        }

        .status-pill.closed {
            background: rgba(148,163,184,.16);
            border-color: rgba(148,163,184,.22);
            color: rgba(71,85,105,1);
        }

    .loan-grid-wrap {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 2 loans per row */
    .loan-grid-wrap {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    @@media (max-width: 992px) {
        .loan-grid-wrap {
            grid-template-columns: 1fr;
        }
    }

    /* tighter actions */
    .loan-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .loan-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        /* Button selection (only button highlights, not card) */
        .loan-actions .btn {
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 800;
        }

            /* Selected states */
            .loan-actions .btn.is-selected {
                box-shadow: 0 10px 22px rgba(15,23,42,.12);
                transform: translateY(-1px);
            }

        /* Optional: subtle outline when selected */
        .loan-actions .btnRefinance.is-selected {
            border-color: rgba(37,99,235,.45) !important;
            background: rgba(37,99,235,.10) !important;
        }

        .loan-actions .btnReschedule.is-selected {
            border-color: rgba(245,158,11,.45) !important;
            background: rgba(245,158,11,.10) !important;
        }
    /* SEARCH BAR (matches the screenshot) */
    .tsc-searchbar__group {
        align-items: stretch;
    }

    /* left icon box */
    .tsc-searchbar__icon {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-right: 0;
        border-radius: 14px 0 0 14px;
        padding: 0 14px;
        color: #9ca3af;
    }

    /* input */
    .tsc-searchbar__input {
        border: 1px solid #e5e7eb !important;
        border-left: 0 !important;
        border-right: 0 !important;
        border-radius: 0 !important;
        padding: 14px 14px;
        height: 52px; /* consistent height */
        box-shadow: none !important;
    }

        .tsc-searchbar__input:focus {
            border-color: #cbd5e1 !important;
            box-shadow: none !important;
        }

    /* right button (green square) */
    .tsc-searchbar__btn {
        height: 52px;
        width: 52px;
        border-radius: 0 14px 14px 0;
        background: #0a8f08; /* green like screenshot */
        color: #fff;
        border: 1px solid #0a8f08;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .tsc-searchbar__btn:hover {
            filter: brightness(.95);
            color: #fff;
        }

        .tsc-searchbar__btn:focus {
            box-shadow: none !important;
        }

        /* icon sizing */
        .tsc-searchbar__btn i {
            font-size: 20px;
            line-height: 1;
        }

    .tsc-searchbar__icon i {
        font-size: 18px;
        line-height: 1;
    }
</style>

<style>
    .member-meta {
        font-size: 0.85rem;
        color: #6c757d;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

        .member-meta i {
            margin-right: 4px;
            color: #6b7280;
        }

    .member-name {
        font-weight: 600;
        margin-bottom: 2px;
    }
    /* Optional small UX polish */
    .tsc-charge-picker label {
        cursor: pointer;
    }

    .tsc-charge-picker input[type="checkbox"] {
        margin-top: 0.1rem;
    }

    /* If you want stronger color cues in the cards */
    .badge.bg-warning-subtle {
        background: rgba(255,193,7,.15) !important;
    }

    .badge.bg-primary-subtle {
        background: rgba(13,110,253,.15) !important;
    }

    .badge.bg-success-subtle {
        background: rgba(25,135,84,.15) !important;
    }
    /* picker spacing */
    #recoveryPicker .tsc-pick-row {
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
    }

    #recoveryPicker .form-check-input {
        transform: scale(1.05);
    }

    /* cards spacing */
    .tsc-recovery-card {
        border-radius: 12px;
    }

        .tsc-recovery-card .card-body {
            padding: .65rem !important;
        }

        .tsc-recovery-card .form-label {
            margin-bottom: .2rem !important;
        }

        .tsc-recovery-card .text-muted.small {
            line-height: 1.2;
        }

        .tsc-recovery-card .row.g-2 {
            --bs-gutter-x: .5rem;
            --bs-gutter-y: .5rem;
        }

    :root {
        --tsc-font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, "Noto Sans", "Liberation Sans", sans-serif;
    }

    body {
        font-family: var(--tsc-font);
    }

    .tsc-title {
        font-family: var(--tsc-font);
        font-weight: 700;
        letter-spacing: -.02em;
        line-height: 1.15;
        font-size: 1.15rem; /* clean dashboard size */
        margin: 0;
    }

    .tsc-subtitle {
        font-family: var(--tsc-font);
        font-weight: 400;
        color: rgba(255,255,255,.70); /* if dark theme */
        /* if light theme use: #6b7280 */
        font-size: .93rem;
        line-height: 1.35;
    }

    .tsc-em {
        font-weight: 600;
        color: rgba(255,255,255,.90); /* dark */
        /* light: #111827 */
    }
</style>
<style>
    .tsc-checklist-body {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 8px;
        max-height: 220px;
        overflow: auto;
        background: #fff;
    }

    .tsc-check-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 6px 4px;
        border-radius: 6px;
    }

        .tsc-check-item:hover {
            background: #f8fafc;
        }

        .tsc-check-item .meta {
            line-height: 1.2;
        }

        .tsc-check-item .title {
            font-weight: 600;
            font-size: 13px;
        }

        .tsc-check-item .sub {
            font-size: 12px;
            color: #6b7280;
        }

    .tsc-pill {
        display: inline-block;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 999px;
        margin-left: 8px;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    .tsc-checklist-body {
        max-height: 220px;
        overflow: auto;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .35rem;
        padding: .35rem;
        background: #fff;
    }

    .tsc-check-item {
        display: flex;
        gap: .6rem;
        padding: .45rem .5rem;
        border-radius: .35rem;
        cursor: pointer;
        margin-bottom: .25rem;
    }

        .tsc-check-item:hover {
            background: rgba(0,0,0,.03);
        }

        .tsc-check-item .meta .title {
            font-weight: 600;
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .tsc-check-item .meta .sub {
            font-size: .78rem;
            color: #6c757d;
        }

    .tsc-pill {
        font-size: .65rem;
        padding: .12rem .45rem;
        border-radius: 10rem;
        border: 1px solid rgba(0,0,0,.12);
        color: #6c757d;
    }
</style>

<div class="container tsc-wrap">

    <!-- TSC Banner (Enhanced - no breaking changes) -->
    <div class="row">
        <div class="col-12">

            <div class="card bg-light mb-4">
                <div class="card-body text-center">

                    <h1 class="card-title text-primary">
                        <i class="mdi mdi-bank-outline me-2"></i>
                        Loan Application Process
                    </h1>

                    <p class="card-text text-muted">
                        Complete the steps below to submit a new loan application or manage an existing one.
                    </p>

                    <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

                </div>
            </div>

        </div>
    </div>



    <!-- Stepper -->
    <div class="tsc-stepper mb-3">
        <div class="step active" id="stepSearch">
            <div class="dot"><i class="mdi mdi-account-search-outline"></i></div>
            Search Member
        </div>

        <div class="step-line"></div>

        <div class="step" id="stepFacility">
            <div class="dot"><i class="mdi mdi-office-building-outline"></i></div>
            Facility
        </div>

        <div class="step-line"></div>

        <div class="step" id="stepApplication">
            <div class="dot"><i class="mdi mdi-file-document-edit-outline"></i></div>
            Application
        </div>

        <div class="step-line"></div>

        <div class="step" id="stepReview">
            <div class="dot"><i class="mdi mdi-clipboard-check-outline"></i></div>
            Review
        </div>
    </div>


    <!-- STEP 1: Search (Formatted + Search Button at end) -->
    <div class="tsc-card p-4 mb-2" id="panelSearch">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h4 class="tsc-title mb-1">
                    <i class="mdi mdi-account-search-outline me-1"></i> Search Member
                </h4>
                <div class="tsc-subtitle">
                    Search using <span class="tsc-em">Member Reference</span> or <span class="tsc-em">Account Number</span>, then select the member to continue.
                </div>
            </div>
        </div>


        <!-- Search bar + button -->
        <!-- Search bar -->
        <div class="tsc-searchbar mb-2">
            <div class="input-group tsc-searchbar__group">

                <!-- Left icon box -->
                <span class="input-group-text tsc-searchbar__icon">
                    <i class="mdi mdi-card-account-details-outline"></i>
                </span>

                <!-- Input -->
                <input type="text"
                       class="form-control tsc-searchbar__input"
                       id="txtMemberSearch"
                       placeholder="Enter Member Reference or Account Number..."
                       autocomplete="off" />

                <!-- Search button -->
                <button type="button"
                        class="btn tsc-searchbar__btn"
                        id="btnMemberSearch"
                        title="Search">
                    <i class="mdi mdi-magnify"></i>
                </button>

            </div>
        </div>



        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="small text-muted" id="searchHint">
                Tip: paste the member reference or account number and click <b>Search</b>.
            </div>

            <div class="small text-muted" id="searchStatus" style="display:none;">
                <span class="tsc-spinner me-2"></span> Searching...
            </div>
        </div>

        <!-- Results -->
        <div id="memberResults" class="member-list"></div>

        <div id="memberEmpty" class="tsc-empty mt-3" style="display:none;">
            <div class="fw-bold mb-1">No results</div>
            <div>Try a valid <b>Member Reference</b> or <b>Account Number</b>.</div>
        </div>
    </div>


    <!-- STEP 2: Facility (placeholder - we will build next) -->
    <div class="tsc-card p-4 mb-3" id="panelFacility" style="display:none;">
        <a href="javascript:void(0)" id="btnBackToSearch" class="text-decoration-none">
            <i class="mdi mdi-arrow-left"></i> Back to Search
        </a>

        <div class="mt-3" id="selectedMemberHeader"></div>

        <hr class="my-3" />

        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
            <div>
                <h4 class="tsc-section-title mb-1">Select Loan Facility</h4>
                <div class="text-muted small">Choose the facility to proceed, or restructure an existing loan.</div>
            </div>
            <div>
                <button class="btn btn-primary tsc-btn-primary" id="btnProceedToApplication" disabled>
                    Continue <i class="mdi mdi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Facility Tiles -->
        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <div class="facility-tile active-on-hover" data-facility="CLASSIC">
                    <div class="tile-icon"><i class="mdi mdi-file-document-outline"></i></div>
                    <div class="tile-text">
                        <div class="tile-title">Classic Loan</div>
