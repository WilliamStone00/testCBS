                    }
                    if (modeValue === "REFINANCE") {
                        return "Refinancing creates a new facility while referencing the old loan for settlement and audit trail.";
                    }
                    if (modeValue === "RESCHEDULE") {
                        // ✅ updated advice exactly as you described
                        return "Advisable: member should clear VAT, accrued interest, and penalties (if any) so only CAPITAL is rescheduled. If not cleared, accruals may be added to the balance, but the amortization table will be generated on CAPITAL only.";
                    }
