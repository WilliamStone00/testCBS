                        '</div>';
                }

                function divider() { return '<div class="tsc-divider my-2"></div>'; }

                function safeArr(x) { return Array.isArray(x) ? x : []; }

                function normalizeDecisionText(b) {
                    // payload may have Decision or BlockedStatus
                    return (b && (b.Decision || b.BlockedStatus) ? (b.Decision || b.BlockedStatus) : "");
                }

                function renderTable(headers, rowsHtml) {
                    if (!rowsHtml || !rowsHtml.length) return emptyBox("None");
                    var thead = '<thead><tr>' + headers.map(function (h) { return '<th class="small text-muted fw-semibold">' + esc(h) + '</th>'; }).join("") + '</tr></thead>';
                    var tbody = '<tbody>' + rowsHtml.join("") + '</tbody>';
                    return '<div class="table-responsive">' +
                        '<table class="table table-sm align-middle mb-0">' +
                        thead + tbody +
                        '</table>' +
                        '</div>';
                }

                function cell(v) { return '<td class="small">' + (v === null || v === undefined || v === "" ? '<span class="text-muted">—</span>' : esc(v)) + '</td>'; }
                function cellMoney(v) { return '<td class="small fw-semibold text-end">' + esc(num(v || 0).toLocaleString()) + ' FCFA</td>'; }
                function cellBool(v) { return '<td class="small">' + (v ? badge("YES", "bg-success") : badge("NO", "bg-secondary")) + '</td>'; }

                // --------------------------
                // Detect mode/facility from payload shape
                // --------------------------
                var isReschedule = !!payload.RescheduleCommand;
                var isRefinance = !!payload.AddLoanApplicationCommand;
                var isOverdraft = !!payload.AddOverdraftCommand;
                var isLoc = !!payload.AddLineOfCreditCommand;

                var mode = isReschedule ? "RESCHEDULE" : (isRefinance ? "REFINANCE" : (isOverdraft ? "OVERDRAFT" : (isLoc ? "LINEOFCREDIT" : "NEW")));
                var facility = (function () {
                    if (isOverdraft) return "OVERDRAFT";
                    if (isLoc) return "LINEOFCREDIT";
                    if (isReschedule) return (ws.facility || safeVal("#txtFacility") || "CLASSIC");
                    if (isRefinance) return (payload.AddLoanApplicationCommand && payload.AddLoanApplicationCommand.Facility) || (ws.facility || safeVal("#txtFacility") || "CLASSIC");
                    return (payload.Facility || ws.facility || safeVal("#txtFacility") || "CLASSIC");
                })();

                // -------------------------------------------------
                // RESCHEDULE PREVIEW (show full payload for reschedule)
                // -------------------------------------------------
                if (isReschedule) {
