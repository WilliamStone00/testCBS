                        '<div class="small text-muted d-flex justify-content-between"><span>Manager Amount</span><span class="fw-bold">' + money(managerAmt) + '</span></div>' +
                        '<div class="small text-muted d-flex justify-content-between"><span>Decision</span><span class="fw-bold">' + esc(decision) + '</span></div>' +
