                fillRelationshipSelect($newCard.find(".ddlRelationship"));
                applyGuarantorRequirements($newCard);

                refreshGuarantorTitles();
                rebuildGuarantorsJson();

                /**
                 * Refresh guarantor card headers:
                 * - Adds numbering (1,2,3...)
                 * - Shows selected guarantor type in BOLD, UPPERCASE, with distinct color
                 *   Example: "GUARANTOR (CO-OBLIGOR) #2"
                 */
                function refreshGuarantorTitles() {
                    var typeLabels = {
                        "MORAL_GUARANTOR": "MORAL GUARANTOR",
                        "COOBLIGOR": "CO-OBLIGOR",
                        "SHOTEE": "SHOTEE",
                        "INTER_COOPERATION": "INTER-COOPERATION"
                    };

                    $("#guarantorList [data-gid]").each(function (i) {
                        var $card = $(this);
                        var t = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                        var label = typeLabels[t] || "GUARANTOR";
                        var idx = i + 1;

                        var title = `GUARANTOR (${label}) #${idx}`;

                        // Target the header title (first .fw-semibold in the card header)
                        var $titleEl = $card.find(".d-flex .fw-semibold").first();
                        if ($titleEl && $titleEl.length) {
                            $titleEl.text(title)
                                .css({
                                    "font-weight": "900",
                                    "letter-spacing": "0.5px",
                                    "text-transform": "uppercase"
                                })
                                .addClass("text-primary");
                        }
                    });
                }

            }

            $("#btnAddGuarantor").off("click.addG").on("click.addG", addGuarantorCard);

            // When account changes, cache selected balance (for block amount validation)
            $(document).off("change.gAcc", "#guarantorList .ddlAccount").on("change.gAcc", "#guarantorList .ddlAccount", function () {
                var $ddl = $(this);
                var $card = $ddl.closest("[data-gid]");
                var bal = toNum($ddl.find("option:selected").attr("data-balance") || 0);
                $card.data("selectedBalance", bal);
                // Re-validate current block amount against balance
                $card.find(".txtBlockAmount").trigger("input");
            });

            // Block amount: must not exceed selected account balance; sync to guarantee amount (member-backed types)
            $(document).off("input.gBlock", "#guarantorList .txtBlockAmount").on("input.gBlock", "#guarantorList .txtBlockAmount", function () {
                var $inp = $(this);
                var $card = $inp.closest("[data-gid]");
                var bal = toNum($card.data("selectedBalance") || 0);
                var v = toNum($inp.val() || 0);

                if (bal > 0 && v > bal) {
                    v = bal;
                    $inp.val(fmt0(v));
                    appError("Blocked amount cannot exceed account balance (" + fmt0(bal) + ").");
                }

                // For Coobligor/Shotee/Inter-Coop, guarantee amount mirrors blocked amount
                var t = String($card.find(".ddlGuarantorType").val() || "");
                if (isMemberBackedGuarantorType(t)) {
                    $card.find(".txtGuaranteeAmount").val(fmt0(v)).prop("readonly", true);
                }

                rebuildGuarantorsJson();
                renderDownpaymentBox();
            });


            function bindGuarantorCardEvents($card) {
                $card.find(".btnRemoveGuarantor").off("click.rmG").on("click.rmG", function () {
                    $card.remove();
                    refreshGuarantorTitles();
                    rebuildGuarantorsJson();
                    // Update downpayment/blocked totals after removal
                    applyDownpaymentProvided();
                    updateTotalBlockedAll();
                });

                $card.find(".ddlGuarantorType").off("change.gType").on("change.gType", function () {
                    var t = String($(this).val() || "").toUpperCase();
                    // ✅ Member-backed means we can search & load member KYC/accounts (Co-obligor, Shotee only).
                    // Inter-Cooperation is treated like Moral Guarantor (manual KYC, no member lookup).
                    var isMemberBacked = (t === "COOBLIGOR" || t === "SHOTEE");

                    $card.find(".wrapMemberSearch").toggle(isMemberBacked);
                    $card.find(".wrapAccountSelect").toggle(isMemberBacked);
                    $card.find(".wrapBlockAmount").toggle(isMemberBacked);
                    $card.find(".wrapBlockFlag").toggle(isMemberBacked);

                    // Ensure reference dropdowns are ready (relationship/collateral types)
                    loadReferenceDataOnce();
                    fillRelationshipSelect($card.find(".ddlRelationship"));

                    // Apply required fields + sync rules

                    // Update totals live
                    $card.find(".txtGuaranteeAmount, .txtBlockAmount").off("input.totals").on("input.totals", function () {
                        applyDownpaymentProvided();
                        updateTotalBlockedAll();
                        rebuildGuarantorsJson();
                    });

                    $card.find(".ddlBlockFlag, .ddlAccount").off("change.totals").on("change.totals", function () {
                        applyDownpaymentProvided();
                        updateTotalBlockedAll();
                        rebuildGuarantorsJson();
                    });

                    applyGuarantorRequirements($card);

                    // Date validation handlers
                    $card.find(".txtIssueDate,.txtExpireDate").off("change.iddates").on("change.iddates", function () {
                        validateIdDates($card);
                    });

                    // Block amount => Guarantee amount sync (member-backed types)
                    $card.find(".txtBlockAmount").off("input.syncg").on("input.syncg", function () {
                        var t2 = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                        if (!isMemberBackedGuarantorType(t2)) return;
                        var v2 = $(this).val() ? Number($(this).val()) : 0;
                        $card.find(".txtGuaranteeAmount").val(isFinite(v2) ? v2 : 0);
                        rebuildGuarantorsJson();
                        if ($("#chkDownPayment").is(":checked")) renderDownpaymentBox();
                    });

                    // clear account list when switching
                    if (!isMemberBacked) {
                        $card.find(".ddlAccount").empty();
                        $card.find(".txtMemberRef").val("");
                        $card.find(".memberSearchHint").text("");
                    }

                    rebuildGuarantorsJson();
                });

                // changes -> rebuild
                $card.find("input, select, textarea").off("input.gAny change.gAny").on("input.gAny change.gAny", function () {
                    rebuildGuarantorsJson();
                });

                // member search (Co-obligor / Shotee ONLY)
                // - Enforce 10-char reference
                // - Auto-trigger lookup once length reaches 10
                $card.find(".txtMemberRef").attr("maxlength", "10");

                $card.find(".txtMemberRef").off("input.memberRef").on("input.memberRef", function () {
                    var $i = $(this);
                    var v = String($i.val() || "");

                    if (v.length > 10) {
                        v = v.substring(0, 10);
                        $i.val(v);
                    }

                    var gt = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                    if (v.length === 10 && isMemberBackedGuarantorType(gt)) {
                        // Auto-search when ref becomes valid
                        $card.find(".btnSearchMember").trigger("click");
                    }
                });

                $card.find(".btnSearchMember").off("click.searchM").on("click.searchM", function () {
                    // Only Co-obligor/Shotee can be searched (Inter-Cooperation behaves like Moral Guarantor).
                    var gt = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                    if (!isMemberBackedGuarantorType(gt)) {
                        $card.find(".memberSearchHint").html(`<span class="text-muted">Member lookup not required for this guarantor type.</span>`);
                        return;
                    }

                    var memberRef = String($card.find(".txtMemberRef").val() || "").trim();
                    if (!memberRef) {
                        $card.find(".memberSearchHint").html(`<span class="text-danger">Enter a 10-character member reference.</span>`);
                        return;
                    }
                    if (memberRef.length !== 10) {
                        $card.find(".memberSearchHint").html(`<span class="text-danger">Member reference must be exactly 10 characters.</span>`);
                        return;
                    }

                    var memberLookupUrl = routes.memberLookup;
                    if (!memberLookupUrl) {
                        alertify.error("Member lookup URL not configured.");
                        return;
                    }

                    // UX: show searching state
                    $card.find(".memberSearchHint").html(`<span class="text-muted">Searching...</span>`);
                    $.get(memberLookupUrl, { memberReference: memberRef })
                        .done(function (res) {
                            var ok = (res && (res.success === true || res.Success === true));
                            var data = (res && (res.data || res.Data)) || null;

                            if (!ok || !data) {
                                $card.find(".memberSearchHint").html(`<span class="text-danger">Member not found.</span>`);
                                return;
                            }

                            // Fill KYC
                            $card.find(".txtNameCompany").val(data.name || data.Name || "");
                            $card.find(".txtIdCardNumber").val(data.idCardNumber || data.IdCardNumber || "");
                            $card.find(".txtPhone").val(data.phoneNumber || data.PhoneNumber || "");
                            $card.find(".txtEmail").val(data.email || data.Email || "");
                            $card.find(".txtAddress").val(data.address || data.Address || "");
                            $card.find(".txtIssueDate").val(data.issueDate || data.IssueDate || "");
                            $card.find(".txtExpireDate").val(data.expireDate || data.ExpireDate || "");

                            $card.data("memberId", data.memberId || data.MemberId || "");
                            $card.find(".memberSearchHint").html(`<span class="text-success">Member loaded.</span>`);

                            applyGuarantorRequirements($card);
                            validateIdDates($card);


                            // Load accounts
                            var mid = $card.data("memberId");
                            if (!mid || !memberAccountsUrl) return;

                            $card.find(".ddlAccount").html(`<option value="">Loading accounts...</option>`);
                            $.get(memberAccountsUrl, { memberId: mid })
                                .done(function (ares) {
                                    var items = (ares && (ares.data || ares.Data)) || [];
                                    var opts = `<option value="">-- Select Account --</option>`;

                                    items.forEach(function (a) {
                                        var accNo = pick(a, "accountNumber", "AccountNumber", "");
                                        var type = pick(a, "accountType", "AccountType", "");
                                        var bal = toNum(pick(a, "balance", "Balance", 0));
                                        var cur = pick(a, "currency", "Currency", "FCFA") || "FCFA";
                                        opts += `<option value="${escHtml(accNo)}">${escHtml(type)} - ${escHtml(accNo)} (Bal: ${bal.toLocaleString()} ${escHtml(cur)})</option>`;
                                    });

                                    $card.find(".ddlAccount").html(opts);
                                    rebuildGuarantorsJson();
                                })
                                .fail(function () {
                                    $card.find(".ddlAccount").html(`<option value="">Failed to load accounts</option>`);
                                });

                            rebuildGuarantorsJson();
                        })
                        .fail(function () {
                            $card.find(".memberSearchHint").html(`<span class="text-danger">Lookup failed.</span>`);
                        });
                });
            }
            $(document).on("click", ".btnSearchMember", function () {
                var routes = getRoutes();

                if (!routes.memberLookupUrl) {
                    alert("Member lookup URL not configured. Check #loanUiRoutes data-member-lookup-url.");
                    return;
                }

                var $card = $(this).closest("[data-gid]");
                var ref = normStr($card.find(".txtMemberRef").val());
