            $("#chkLoanDocs").on("change", function () {
                $("#loanDocsWrap").toggle($(this).is(":checked"));

                // optional: clear on uncheck
                if (!$(this).is(":checked")) {
                    $("#fileLoanDocs").val("");
                    $("#txtLoanDocsNote").val("");
                }
            });

            // Store per-account blocking amounts
            // key = accountId, value = decimal
            var recoveryBlocks = {};

            function autoSizeMultiSelect($sel, minRows, maxRows) {
                var count = $sel.find('option').length || 0;
                var rows = Math.max(minRows || 6, Math.min(maxRows || 12, count));
                $sel.attr('size', rows);
            }

            function getSelectedAccounts($sel) {
                return $sel.find('option:selected').map(function () {
                    var $opt = $(this);

                    // 1️⃣ Try data-balance first (BEST PRACTICE)
                    var balanceAttr = $opt.attr("data-balance");
                    var balance = parseFloat(balanceAttr);

                    // 2️⃣ Fallback: extract number from label (supports EN + FR)
                    if (isNaN(balance)) {
                        var text = $opt.text();

                        // Matches:
                        // "Bal: 150,000 FCFA"
                        // "Solde : 150 000 FCFA"
                        // "Balance: 150000"
                        var match = text.match(/(?:bal|balance|solde)\s*[:\-]?\s*([\d\s,\.]+)/i);

                        if (match && match[1]) {
                            balance = parseFloat(
                                match[1]
                                    .replace(/\s/g, '')   // remove spaces
                                    .replace(/,/g, '')    // remove commas
                            );
                        }
                    }

                    return {
                        id: this.value,
                        text: $opt.text(),
                        balance: isNaN(balance) ? 0 : balance
                    };
                }).get();
            }



            // Minimal HTML escape for safe rendering
            function escapeHtml(s) {
                return (s || "").replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function renderRecoveryAmounts(selected) {
