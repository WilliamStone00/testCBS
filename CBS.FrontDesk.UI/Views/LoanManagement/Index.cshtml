                        // Autofill KYC fields
                        $card.find(".txtNameCompany").val(pickKey(m, "name", ""));
                        $card.find(".txtPhone").val(pickKey(m, "phoneNumber", ""));
                        $card.find(".txtEmail").val(pickKey(m, "email", ""));
                        $card.find(".txtAddress").val(pickKey(m, "address", ""));
                        $card.find(".txtIdCardNumber").val(pickKey(m, "idCardNumber", ""));
                        $card.find(".txtIssueDate").val(pickKey(m, "issueDate", ""));   // must be yyyy-MM-dd if using <input type=date>
                        $card.find(".txtExpireDate").val(pickKey(m, "expireDate", "")); // must be yyyy-MM-dd if using <input type=date>

                        // Store member id on card for later
                        $card.attr("data-memberid", pickKey(m, "memberId", ""));

                        $hint.text("Member found: " + pickKey(m, "name", ""));

                        // Load accounts for blocking when required
                        loadMemberAccountsIntoGuarantorCard($card, pickKey(m, "memberId", ""));
                    })
                    .fail(function (xhr) {
                        console.error("LookupMember failed:", xhr);
                        $hint.text("Lookup failed.");
                    });
            });
            function applyRiskMitigationPolicy(policy) {
                // Expected policy fields:
                // RequireGuarantor, RequireCollateral, RequireCoObligor, RequireMortgage, RequireDocuments, etc.

                syncMitigation("Guarantor", !!policy.RequireGuarantor);
                syncMitigation("Collateral", !!policy.RequireCollateral);
                syncMitigation("CoObligor", !!policy.RequireCoObligor);
                syncMitigation("Shotee", !!policy.RequireMortgage /* or separate RequireShotee if you have */);

                // You can add more mappings here
            }

            function syncMitigation(name, isRequired) {
                // Naming convention example:
                // checkbox: #chkGuarantor
                // wrapper:  #wrapGuarantor
                // add btn:  #btnAddGuarantor
                var id = name.replace(/\s/g, "");

                var $chk = $("#chk" + id);
                var $wrap = $("#wrap" + id);

                if (!$chk.length || !$wrap.length) return;

                if (isRequired) {
                    $chk.prop("checked", true).prop("disabled", true); // user cannot uncheck required
                    $wrap.show(); // show panel so user can click "Add"
                } else {
                    $chk.prop("disabled", false);
                    // respect current user choice
                    if ($chk.is(":checked")) $wrap.show(); else $wrap.hide();
                }
            }

            // user toggles (optional ones)
            $(document).on("change", ".riskMitigationToggle", function () {
                var name = $(this).data("name"); // e.g. data-name="Guarantor"
                syncMitigation(name, false);     // not required, so just follow checked/unchecked
            });

            function loadMemberAccountsIntoGuarantorCard($card, memberId) {
                var routes = getRoutes();
                if (!routes.memberAccountsUrl) {
                    console.warn("memberAccountsUrl missing in #loanUiRoutes");
                    return;
                }
                if (!memberId) return;

                $.getJSON(routes.memberAccountsUrl, { memberId: memberId })
                    .done(function (res) {
                        if (!res || !res.success) return;

                        var $ddl = $card.find(".ddlAccount");
                        if (!$ddl.length) return;

                        $ddl.empty().append('<option value="">-- Select account --</option>');

                        (res.data || []).forEach(function (a) {
                            var txt = (a.AccountType || "") + " - " + (a.AccountNumber || "") + " | " + (a.AccountName || "") + " | Bal: " + (a.Balance || 0) + " " + (a.Currency || "");
                            $ddl.append('<option value="' + a.Id + '" data-type="' + (a.AccountType || "") + '" data-balance="' + (a.Balance || 0) + '">' + txt + '</option>');
                        });

                        // Show account block UI now that accounts exist
                        $card.find(".wrapAccountSelect,.wrapBlockAmount,.wrapBlockFlag").show();
                    })
                    .fail(function (xhr) {
                        console.error("GetMemberAccountsByMemberId failed:", xhr);
                    });
            }

            // if policy requires guarantor, optionally start with one entry
            // (you can remove this if you don't want auto-add)
            function autoInitGuarantorsIfRequired() {
                var p = window.productPolicy || {};
                if (p.requireGuarantor && $("#chkGuarantor").is(":checked") && !$("#guarantorList [data-gid]").length) {
                    addGuarantorCard();
                }
            }

            // call after policy load (place this inside bindProductPolicies(p) end if you want)
            // autoInitGuarantorsIfRequired();


            // ---------------------
            // COLLATERAL LOGIC
            // ---------------------
            function rebuildCollateralJson() {
                var arr = [];
                $("#collateralList [data-cid]").each(function () {
                    var $c = $(this);
                    arr.push({
                        id: String($c.data("cid")),
                        name: $c.find(".colName").val() || "",
                        collateraTypeId: $c.find(".ddlCollateralType").val() || "",
                        amount: toNum($c.find(".colAmount").val() || 0),
                        location: $c.find(".colLocation").val() || "",
                        address: $c.find(".colAddress").val() || "",
                        referenceNumber: $c.find(".colRef").val() || ""
                    });
                });

                riskState.collateral = arr;
                $("#hidCollateralJson").val(JSON.stringify(arr));
            }

            function addCollateralCard() {
                var cid = uid("c");
                var tpl = $("#tplCollateralCard").html().replaceAll("{{cid}}", cid);
                $("#collateralList").append(tpl);

                var $card = $("#collateralList [data-cid='" + cid + "']");
                $card.find(".btnRemoveCollateral").off("click.rmC").on("click.rmC", function () {
                    $card.remove();
                    rebuildCollateralJson();
                });

                $card.find("input, select, textarea").off("input.col change.col").on("input.col change.col", function () { rebuildCollateralJson(); renderDownpaymentBox(); });

