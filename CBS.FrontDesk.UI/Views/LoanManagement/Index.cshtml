            function setInvalid($el, isInvalid, message) {
                if (!$el || !$el.length) return;

                var msgText = message || "Invalid value.";
                var isSelect = ($el.is("select") === true);
                var $s2 = isSelect ? $el.next(".select2") : $();

                // Prefer placing feedback after select2 container when present
                var $anchor = ($s2 && $s2.length) ? $s2 : $el;
                var $msg = $anchor.nextAll(".invalid-feedback, .field-error").first();

                if (!$msg.length) {
                    $msg = $('<div class="invalid-feedback d-block"></div>');
                    $anchor.after($msg);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    if ($s2 && $s2.length) $s2.find(".select2-selection").addClass("is-invalid");
                    $msg.text(msgText).show();
                } else {
                    $el.removeClass("is-invalid");
                    if ($s2 && $s2.length) $s2.find(".select2-selection").removeClass("is-invalid");
                    $msg.text("").hide();
                }
            }

            function bindProductPolicies(p) {
                $("#productPolicyBox").show();
                $("#policyBadge").text("Policy Loaded");

                // -----------------------------
                // Numeric helpers (safe)
                // -----------------------------
                function toNum(v) {
                    var n = Number(v);
                    return isNaN(n) ? 0 : n;
                }

                function gp(o, camel, pascal) {
                    if (!o) return null;
                    var v = o[camel];
                    if (v !== undefined && v !== null) return v;
                    v = o[pascal];
                    if (v !== undefined && v !== null) return v;
                    return null;
                }

                function toBool(v) {
                    if (v === true) return true;
                    if (v === false) return false;
                    var s = (v === null || v === undefined) ? "" : String(v).trim().toLowerCase();
                    return (s === "true" || s === "1" || s === "yes" || s === "y");
                }

                // -----------------------------
                // Existing core policies
                // -----------------------------
                var minAmount = toNum(gp(p, "minAmount", "MinAmount"));
                var maxAmount = toNum(gp(p, "maxAmount", "MaxAmount"));
                var minInterest = toNum(gp(p, "minInterest", "MinInterest"));
                var maxInterest = toNum(gp(p, "maxInterest", "MaxInterest"));
                var minMonth = toNum(gp(p, "minMonth", "MinMonth"));
                var maxMonth = toNum(gp(p, "maxMonth", "MaxMonth"));

                // ✅ Grace Period (MONTHS) policy
                var minGracePeriodMonths = toNum(gp(p, "minGracePeriodMonths", "MinGracePeriodMonths"));
                var maxGracePeriodMonths = toNum(gp(p, "maxGracePeriodMonths", "MaxGracePeriodMonths"));

                // Keep your absolute mins (if any)
                var minSavingsAbs = toNum(gp(p, "minSavings", "MinSavings"));

                // Product's own min share (legacy) + policy floor (75,000 default)
                var minSharesProduct = toNum(
                    gp(p, "minOrdinaryShares", "MinOrdinaryShares") ??
                    gp(p, "minOrdinaryShare", "MinOrdinaryShare") ??
                    gp(p, "minShares", "MinShares")
                );

                var minSharesPolicy = toNum(
                    gp(p, "minOrdinarySharesPolicy", "MinOrdinarySharesPolicy")
                );
                if (minSharesPolicy <= 0) minSharesPolicy = 75000;

                // Savings percent policy (default 20%)
                var minSavingsPercent = toNum(gp(p, "minSavingsPercent", "MinSavingsPercent"));
                if (minSavingsPercent <= 0) minSavingsPercent = 20;

                // Down payment % policy
                var requireDownPayment = toBool(gp(p, "requireDownPayment", "RequireDownPayment"));
                var downPaymentRatePercent = toNum(gp(p, "downPaymentRatePercent", "DownPaymentRatePercent"));

                // Risk requirement flags
                var requireGuarantor = toBool(gp(p, "requireGuarantor", "RequireGuarantor"));
                var requireCollateral = toBool(gp(p, "requireCollateral", "RequireCollateral"));
                var requireCoObligor = toBool(gp(p, "requireCoObligor", "RequireCoObligor"));
                var requireMortgage = toBool(gp(p, "requireMortgage", "RequireMortgage"));
                var requireDocuments = toBool(gp(p, "requireDocuments", "RequireDocuments"));

                // -----------------------------
                // Persist a normalized policy for validators
                // -----------------------------
                window.productPolicy = {
                    minAmount: minAmount,
                    maxAmount: maxAmount,
                    minInterest: minInterest,
                    maxInterest: maxInterest,
                    minMonth: minMonth,
                    maxMonth: maxMonth,

                    // ✅ Grace Period Months
                    minGracePeriodMonths: minGracePeriodMonths,
                    maxGracePeriodMonths: maxGracePeriodMonths,

                    minSavingsAbs: minSavingsAbs,
                    minSavingsPercent: minSavingsPercent,

                    // Use the STRICTER of product vs policy floor
                    minSharesProduct: minSharesProduct,
                    minSharesPolicy: minSharesPolicy,
                    minSharesRequired: Math.max(minSharesProduct, minSharesPolicy),

                    requireDownPayment: requireDownPayment,
                    downPaymentRatePercent: downPaymentRatePercent,

                    requireGuarantor: requireGuarantor,
                    requireCollateral: requireCollateral,
                    requireCoObligor: requireCoObligor,
                    requireMortgage: requireMortgage,
                    requireDocuments: requireDocuments
                };


                // user toggles (optional ones)
                $(document).on("change", ".riskMitigationToggle", function () {
                    var name = $(this).data("name"); // e.g. data-name="Guarantor"
                    syncMitigation(name, false);     // not required, so just follow checked/unchecked
                });

                // -----------------------------
                // Small UI helpers
                // -----------------------------
                function yesNoBadge(flag) {
                    return flag
                        ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Required</span>'
                        : '<span class="badge bg-success-subtle text-success border border-success-subtle">Optional</span>';
                }

                function fmtPct(n) {
                    n = toNum(n);
                    return (n <= 0) ? "0%" : (n + "%");
                }

                // -----------------------------
                // Render Policy Grid
                // -----------------------------
                $("#policyGrid").html(`
                                    <div class="col-6">Min Amount: <strong>${minAmount.toLocaleString()} FCFA</strong></div>
                                    <div class="col-6">Max Amount: <strong>${maxAmount.toLocaleString()} FCFA</strong></div>

                                    <div class="col-6">Min Interest: <strong>${minInterest}%</strong></div>
                                    <div class="col-6">Max Interest: <strong>${maxInterest}%</strong></div>

                                    <div class="col-6">Min Month: <strong>${minMonth}</strong></div>
                                    <div class="col-6">Max Month: <strong>${maxMonth}</strong></div>

                                    <div class="col-6">Min Grace (Months): <strong>${minGracePeriodMonths}</strong></div>
                                    <div class="col-6">Max Grace (Months): <strong>${maxGracePeriodMonths}</strong></div>

                                    <div class="col-6">Min Savings (Absolute): <strong>${minSavingsAbs.toLocaleString()} FCFA</strong></div>
                                    <div class="col-6">Min Savings (% of Amount): <strong>${fmtPct(minSavingsPercent)}</strong></div>

                                    <div class="col-6">Min Shares (Product): <strong>${minSharesProduct.toLocaleString()} FCFA</strong></div>
                                    <div class="col-6">Min Shares (Policy): <strong>${minSharesPolicy.toLocaleString()} FCFA</strong></div>

                                    <div class="col-12 mt-2">
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <div>Down Payment: <strong>${fmtPct(downPaymentRatePercent)}</strong> ${yesNoBadge(requireDownPayment)}</div>
                                            <div>Guarantor: ${yesNoBadge(requireGuarantor)}</div>
                                            <div>Collateral: ${yesNoBadge(requireCollateral)}</div>
                                            <div>Co-obligor: ${yesNoBadge(requireCoObligor)}</div>
                                            <div>Mortgage: ${yesNoBadge(requireMortgage)}</div>
                                            <div>Documents: ${yesNoBadge(requireDocuments)}</div>
                                        </div>
                                    </div>
                                `);

                // -----------------------------
                // Soft guide on fields
                // -----------------------------
                $("#txtAmount").attr("min", minAmount || null).attr("max", maxAmount || null);
                $("#txtInterest").attr("min", minInterest || null).attr("max", maxInterest || null);

                // ✅ Grace Period is now MONTHS (integer)
                // If your textbox id is different, change here only.
                $("#txtGracePeriod")
                    .attr("type", "number")
                    .attr("step", 1)
                    .attr("min", (minGracePeriodMonths || 0))
                    .attr("max", (maxGracePeriodMonths || null));

                // Optional: guide label
                $("#policyHint").text("Policy limits and risk requirements are loaded.");

                // Optional: auto-check the risk toggles to reflect policy (UI only, actual proof is elsewhere)
                $("#chkDownPayment").prop("checked", requireDownPayment);
                $("#chkGuarantor").prop("checked", requireGuarantor);
                $("#chkCollateral").prop("checked", requireCollateral);
                $("#chkLoanDocs").prop("checked", requireDocuments);

                // Optional: show/hide docs area immediately if required
                $("#loanDocsWrap").toggle($("#chkLoanDocs").is(":checked"));
            }
