                    $list.append(row);
                });
                renderManagerRecoveryDecision(selected);
                updateBlockedTotals();

                $wrap.show();
            }

            function pruneRecoveryBlocks(selectedIds) {
                // remove amounts for items no longer selected
                Object.keys(recoveryBlocks).forEach(function (k) {
                    if (selectedIds.indexOf(k) === -1) delete recoveryBlocks[k];
                });
            }

            function validateBlockAmount($input) {
                var balance = parseFloat($input.data("balance"));
                if (isNaN(balance)) balance = 0;

                var raw = $input.val();

                // empty is allowed (means "not set")
                if (raw === "" || raw === null || raw === undefined) {
                    $input.removeClass("is-invalid");
                    return true;
                }

                var num = parseFloat(raw);
                if (isNaN(num) || num < 0) {
                    $input.addClass("is-invalid");
                    return false;
                }

                if (num > balance) {
                    $input.addClass("is-invalid");
                    $input.next(".invalid-feedback")
                        .text("Block amount cannot exceed available balance (" + balance + ").");
                    return false;
                }


                $input.removeClass("is-invalid");
                return true;
            }

            function validateAllRecoveryBlocks() {
                var ok = true;
                $(".recovery-block-amount").each(function () {
                    if (!validateBlockAmount($(this))) ok = false;
                });
                return ok;
            }

            // -----------------------------
            // Wire-up
            // -----------------------------
            var $ddl = $("#ddlRecoveryAccounts");
            function bindRecoveryForContainer($container) {
                var $ddl = $container.find("#ddlRecoveryAccounts");

                if (!$ddl.length) return;

                // avoid double-binding
                $ddl.off("change.tscRecovery").on("change.tscRecovery", function () {
                    var selected = getSelectedAccounts($ddl);
                    var ids = selected.map(x => x.id);
                    pruneRecoveryBlocks(ids);

                    // render per-account inputs (officer proposed)
                    renderRecoveryAmounts(selected);

                    // render manager decision inputs
                    renderManagerRecoveryDecision(selected);

                    // totals (if you added them)
                    if (typeof updateBlockedTotals === "function") updateBlockedTotals();
                });

                // Also re-render manager list when amounts change
                $container.off("input.tscRecovery blur.tscRecovery", ".recovery-block-amount")
                    .on("input.tscRecovery blur.tscRecovery", ".recovery-block-amount", function () {
                        var $inp = $(this);
                        if (!validateBlockAmount($inp)) return;

                        var id = $inp.data("account-id");
                        var val = $inp.val();
                        if (val === "" || val === null || val === undefined) {
                            recoveryBlocks[id] = "";
                        } else {
                            var num = parseFloat(val);
                            recoveryBlocks[id] = isNaN(num) ? "" : num;
                        }

                        // refresh manager list live
                        var selected = getSelectedAccounts($ddl);
                        renderManagerRecoveryDecision(selected);

                        if (typeof updateBlockedTotals === "function") updateBlockedTotals();
                    });
            }

            // Bind for both possible sections (because you duplicated IDs)
            bindRecoveryForContainer($("#panelApplication"));           // main app
            bindRecoveryForContainer($("#panelApplication .card"));     // safe extra

            // When you load options into ddlRecoveryAccounts, ensure each option has:
            // <option value="ACC_ID" data-balance="12345.67">Account Label</option>
            // Then call: window.tscRecovery.autoSize();

            $ddl.on("change", function () {
                var selected = getSelectedAccounts($ddl);
                var ids = selected.map(x => x.id);
                pruneRecoveryBlocks(ids);
                renderRecoveryAmounts(selected);
                // ✅ NEW: reflect in manager list
                renderManagerRecoveryDecision(selected);
            });

            // Capture changes in the amount inputs (dynamic)
            // validate on input + blur to ensure proper UX
            $(document).on("input blur", ".recovery-block-amount", function () {
                var $inp = $(this);

                // Validate against balance
                if (!validateBlockAmount($inp)) return;

                var id = $inp.data("account-id");
                var val = $inp.val();

                if (val === "" || val === null || val === undefined) {
                    recoveryBlocks[id] = "";
                    return;
                }

                var num = parseFloat(val);
                recoveryBlocks[id] = isNaN(num) ? "" : num;
                // ✅ NEW: update manager list live
                var selected = getSelectedAccounts($ddl);
                renderManagerRecoveryDecision(selected);
            });


            // Helper: call this after you populate ddl options via AJAX
            window.tscRecovery = {
                autoSize: function () { autoSizeMultiSelect($ddl, 6, 14); },
                validateBlocks: function () { return validateAllRecoveryBlocks(); }, // call this before submit
                getBlocks: function () {
                    // Return array for API submission (only valid numeric values)
                    return Object.keys(recoveryBlocks)
                        .filter(k => recoveryBlocks[k] !== "" && recoveryBlocks[k] !== null && recoveryBlocks[k] !== undefined)
                        .map(k => ({ AccountId: k, BlockAmount: recoveryBlocks[k] }));
                }
            };

            window.tscRecovery.getManagerDecision = function () {
                var arr = [];

                $("#managerRecoveryList .mgr-block-decision").each(function () {
                    var id = $(this).data("account-id");
                    var decision = $(this).val();

                    var amount = $("#managerRecoveryList .mgr-block-amount[data-account-id='" + id + "']").val();
                    amount = parseFloat(amount);
                    if (isNaN(amount)) amount = 0;

                    arr.push({
                        AccountId: id,
                        ProposedAmount: recoveryBlocks[id] || 0,
                        ManagerAmount: amount,
                        Decision: decision
                    });
                });

                return arr;
            };

        })();

    </script>

    <script>
        (function () {
            "use strict";

            // Guards
            if (!window.wizardState) return;

            // =========================
            // Utility
            // =========================
            function esc(s) {
                return (s || "").toString().replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]);
                });
            }

            // ✅ comma-safe number parsing (supports "350,000")
            function num(v) {
                if (v === null || v === undefined) return 0;
                var raw = (v + "").replace(/,/g, "").trim();
                var n = Number(raw || 0);
                return isNaN(n) ? 0 : n;
            }
            function money(v) { return num(v).toLocaleString() + " FCFA"; }

            function isTruthy(v) { return v !== null && v !== undefined && (v + "").trim() !== ""; }

            // =========================
            // Validation UI helpers
            // =========================
            function ensureInvalidFeedback($el, msg) {
                var $fb = $el.nextAll(".invalid-feedback").first();
                if (!$fb.length) $fb = $('<div class="invalid-feedback"></div>').insertAfter($el);
                $fb.text(msg || "Invalid value.");
            }

            function markInvalid($el, msg) {
                $el.addClass("is-invalid");
                var $fb = ensureInvalidFeedback($el);
                $fb.text(msg || "This field is required.").show();
            }

            function clearInvalid($el) {
                $el.removeClass("is-invalid");

                var $fb = $el.nextAll(".invalid-feedback").first();
                if ($fb.length) $fb.hide().text("");

                var $s2 = $el.next(".select2");
                if ($s2.length) {
                    var $fb2 = $s2.nextAll(".invalid-feedback").first();
                    if ($fb2.length) $fb2.hide().text("");
                }
            }

            function scrollToFirstInvalid() {
                var $first = $(".is-invalid").first();
                if ($first.length) $("html, body").animate({ scrollTop: $first.offset().top - 120 }, 250);
            }

            function setAppHintRed(msg) {
                var $hint = $("#appModeHint");
                if (!$hint.length) return;
                if (!msg) {
                    $hint.removeClass("text-danger fw-bold").addClass("text-muted").text("");
                    return;
                }
                $hint.removeClass("text-muted").addClass("text-danger fw-bold").text(msg);
            }

            // ✅ FIX: only validate "policy" if it's real/active (visible + enabled + has options)
            function isPolicyActive($policy) {
                if (!$policy || !$policy.length) return false;
                if ($policy.is(":disabled")) return false;
                if (!$policy.is(":visible")) return false;

                // if it has no meaningful options, skip
                var optCount = $policy.find("option").length;
                if (optCount <= 1) return false;

                return true;
            }

            // ✅ FIX: only validate blocks when PARTIAL_BLOCK (or block inputs are visible)
            function shouldValidateBlocks() {
                var $policy = $("#ddlRecoveryPolicy");
                var policyMode = ($policy.length ? ($policy.val() || "") : "").toString().toUpperCase();

                if (policyMode === "PARTIAL_BLOCK") return true;

                // If UI shows block amount fields, validate them
                var $visibleBlocks = $(".recovery-block-amount:visible");
                return $visibleBlocks.length > 0;
            }
            function setFieldInvalid($el, isInvalid, msg) {
                var id = $el.attr("id");
                if (!id) return;

                var $msg = $("#err_" + id);
                if (!$msg.length) {
                    $msg = $('<div id="err_' + id + '" class="invalid-feedback d-block"></div>');
                    $el.after($msg);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    $msg.text(msg || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    $msg.text("").hide();
                }
            }
            function validateStep3Terms() {
                var ok =
                    validateAmountLive() &&
                    validateInterestLive() &&
                    validateRepaymentPeriodLive() &&
                    validateGracePeriodLive();

                return ok;
            }

            function setInvalid($el, isInvalid, message) {
                // same pattern for ALL inputs: message under the input
                // try to find an existing message element next to the input
                var $msg = $el.siblings(".invalid-feedback, .field-error").first();

                // if not found, create one (bootstrap invalid-feedback)
                if (!$msg.length) {
                    $msg = $('<div class="invalid-feedback d-block"></div>');
                    $el.after($msg);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    $msg.text(message || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    $msg.text("").hide();
                }
            }
            // =========================
            // Step 3 validation Grace periods
            // =========================

            function validateGracePeriodLive() {
                var policy = window.productPolicy || {};
                var minG = Number(policy.minGracePeriodMonths || 0);
                var maxG = Number(policy.maxGracePeriodMonths || 0);

                var $g = $("#txtGracePeriod");
                var raw = ($g.val() || "").trim();
                var v = parseInt(raw, 10);

                // empty is allowed (submit-required rules can handle it)
                if (!raw) {
                    setInvalid($g, false);
                    return true;
                }

                // if max is 0 (policy not loaded), don’t block user typing
                // (optional safety)
                if (maxG <= 0 && minG <= 0) {
                    setInvalid($g, false);
                    return true;
                }

                var ok = !isNaN(v) && v >= minG && v <= maxG;

                setInvalid(
                    $g,
                    !ok,
                    "Grace period must be within policy range (" + minG + " - " + maxG + " months)."
                );

                return ok;
            }

            // bind live like your other fields
            $("#txtGracePeriod")
                .off(".graceLive")
                .on("input.graceLive blur.graceLive", validateGracePeriodLive);



            // =========================
            // Step 3 validation (when preview / submit is attempted)
            // =========================
            function validateStep3BeforeReview() {
                var ok = true;

                // Required fields
                var $loanType = $("#ddlInstitutionLoanType");
                var $product = $("#ddlLoanProduct");
                var $amount = $("#txtAmount");
                var $interest = $("#txtInterest");
                var $period = $("#ddlRepaymentPeriod");
                var $repType = $("#ddlRepaymentType");
                var $disbType = $("#ddlDisbursementType");

                [$loanType, $product, $amount, $interest, $period, $repType, $disbType].forEach(clearInvalid);

                if (!$loanType.val()) { markInvalid($loanType, "Please select an institution loan type."); ok = false; }
                if (!$product.val()) { markInvalid($product, "Please select a loan product."); ok = false; }

                var amt = num($amount.val());
                if (!amt || amt <= 0) { markInvalid($amount, "Enter a valid requested amount."); ok = false; }

                var intr = num($interest.val());
                if (!intr || intr <= 0) { markInvalid($interest, "Enter a valid interest rate."); ok = false; }

                if (!$period.val()) { markInvalid($period, "Please select a repayment period."); ok = false; }
                if (!$repType.val()) { markInvalid($repType, "Please select a repayment type."); ok = false; }
                if (!$disbType.val()) { markInvalid($disbType, "Please select a disbursement type."); ok = false; }

                // Recovery mechanism additional required rule
                if ($("#chkRecoveryMechanism").is(":checked")) {
                    var $recAcc = $("#ddlRecoveryAccounts");
                    clearInvalid($recAcc);

                    var selected = $recAcc.val() || [];
                    if (!selected.length) {
                        markInvalid($recAcc, "Select at least one recovery account.");
                        ok = false;
                    }

                    // ✅ FIX: policy validation only when actually used
                    var $policy = $("#ddlRecoveryPolicy");
                    if (isPolicyActive($policy)) {
                        clearInvalid($policy);
                        if (!$policy.val()) {
                            markInvalid($policy, "Select a recovery policy.");
                            ok = false;
                        }
                    }

                    // ✅ FIX: only validate blocks when needed (prevents blocking review unnecessarily)
                    if (ok && window.tscRecovery && typeof window.tscRecovery.validateBlocks === "function") {
                        if (shouldValidateBlocks()) {
                            if (!window.tscRecovery.validateBlocks()) ok = false;
                        }
                    }
                } else {
                    // If recovery not enabled, make sure recovery-related fields are not marked invalid
                    clearInvalid($("#ddlRecoveryAccounts"));
                    clearInvalid($("#ddlRecoveryPolicy"));
                }

                if (!ok) {
                    setAppHintRed("Please complete the required fields highlighted in red before you can review / save.");
                    scrollToFirstInvalid();
                } else {
                    setAppHintRed("");
                }

                return ok;
            }

            // On change, clear invalid live
            $(document).off("change.step4 input.step4", "#ddlInstitutionLoanType,#ddlLoanProduct,#txtAmount,#txtInterest,#ddlRepaymentPeriod,#ddlRepaymentType,#ddlDisbursementType,#ddlRecoveryAccounts,#ddlRecoveryPolicy")
                .on("change.step4 input.step4", "#ddlInstitutionLoanType,#ddlLoanProduct,#txtAmount,#txtInterest,#ddlRepaymentPeriod,#ddlRepaymentType,#ddlDisbursementType,#ddlRecoveryAccounts,#ddlRecoveryPolicy", function () {
                    clearInvalid($(this));
                });

            // =========================
