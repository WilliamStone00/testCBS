            // =====================================================
            // Recovery Mechanism (load accounts ONLY when enabled)
            // =====================================================
            $("#chkRecoveryMechanism").on("change", function () {
                var enabled = $(this).is(":checked");
                $("#recoveryAccountsWrap").toggle(enabled);

                if (!enabled) {
