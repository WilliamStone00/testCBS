                        (reschedCapital > 0 ? '<div><b>Capital to Reschedule:</b> ' + money(reschedCapital) + '</div>' : '') +
                        '<div><b>New Period:</b> ' + esc(newPeriodMonths || "N/A") + ' months</div>' +
