                                  ${modeBadge(mode)}
                                  ${feeTypeBadge(calcTypeStr)}
                                  <button type="button"
                                          class="btn btn-sm btn-outline-danger py-0 px-2 tsc-charge-remove"
                                          data-fee-id="${esc(id)}"
                                          title="Remove">
