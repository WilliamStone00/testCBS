            // --------------------------------------
            // ✅ Summary (color logic already from totals; keep yours)
            // --------------------------------------
            function updateChargeSummaryFromSelection() {
                var amount = toNum($("#txtAmount").val());
                var selectedRules = chargeRulesCache.filter(c => selectedChargeIds.indexOf(String(c.Id || c.id)) >= 0);

                var payload = selectedRules.map(function (c) {
                    var id = String(c.Id || c.id);
                    var mode = normMode(c.Mode || c.mode || "");
                    var calcType = String(c.CalcType || c.calcType || "");
                    var systemCharge = computeChargeValue(c, amount);
                    var userCharge = toNum(chargeUserOverrides[id] || systemCharge);
                    if (userCharge < systemCharge) userCharge = systemCharge;

                    return { id, mode, calcType, systemCharge, userCharge };
                });

                updateChargeSummary(payload);
            }

            function updateChargeSummary(items) {
                var before = 0, after = 0, total = 0;

                (items || []).forEach(function (x) {
                    var amt = toNum(x.userCharge);
                    if (String(x.mode || "").includes("BEFORE")) before += amt;
                    else after += amt;
                    total += amt;
                });

                $("#sumBefore").text(before.toLocaleString());
                $("#sumAfter").text(after.toLocaleString());
                $("#sumUpfront").text(before.toLocaleString());
                $("#sumTotalCharges").text(total.toLocaleString());

                // ✅ optional: tint numbers
                $("#sumBefore").toggleClass("text-warning", before > 0);
                $("#sumAfter").toggleClass("text-primary", after > 0);
                $("#sumUpfront").toggleClass("text-success", before > 0);
            }

            function buildChargesSubmissionJson() {
                var amount = toNum($("#txtAmount").val());
                var selectedRules = chargeRulesCache.filter(c => selectedChargeIds.indexOf(String(c.Id || c.id)) >= 0);

                var submit = selectedRules.map(function (c) {
                    var feeId = String(c.Id || c.id);
                    var mode = normMode(c.Mode || c.mode || "");
                    var calcType = String(c.CalcType || c.calcType || "");

                    var systemCharge = computeChargeValue(c, amount);
                    var userCharge = toNum(chargeUserOverrides[feeId] || systemCharge);
                    if (userCharge < systemCharge) userCharge = systemCharge;

                    return {
                        FeeId: feeId,
                        Mode: mode,
                        ChargeCalcType: calcType,
                        SystemCharge: systemCharge,
                        UserCharge: userCharge
                    };
                });

                $("#hidSelectedChargesJson").val(JSON.stringify(submit));
            }

