                                  <div class="fw-bold">${systemCharge.toLocaleString()} FCFA</div>
                              </div>

                              <div class="col-6 col-xl-3">
                                  <div class="text-muted">User</div>
                                  <input type="number"
                                         class="form-control form-control-sm tsc-charge-user"
                                         data-fee-id="${esc(id)}"
                                         min="${systemCharge}"
                                         value="${userCharge}">
                                  <div class="invalid-feedback">Cannot be below system charge.</div>
                              </div>

                              <div class="col-6 col-xl-3">
                                  <div class="text-muted">Fee Type</div>
                                  <div class="fw-bold">${esc(
                        (calcTypeStr === "1") ? "FIXED" :
                            (calcTypeStr === "2") ? "RATE" :
                                (calcTypeStr === "3") ? "RANGE" : calcTypeStr
                    )}</div>
