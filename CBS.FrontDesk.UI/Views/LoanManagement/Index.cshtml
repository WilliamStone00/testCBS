            // =========================
            // CONFIRM DIALOG (ALERTIFY) ✅ supports NEW/REFINANCE/RESCHEDULE/OVERDRAFT/LOC
            // =========================
            function buildConfirmHtml(payload) {

                // -----------------------------
                // Helpers (local, non-breaking)
                // -----------------------------
                function upper(s) { return (s || "").toString().trim().toUpperCase(); }

                function pick(obj, keys, fallback) {
                    if (!obj) return fallback;
                    for (var i = 0; i < keys.length; i++) {
                        var k = keys[i];
                        if (obj[k] !== undefined && obj[k] !== null && obj[k] !== "") return obj[k];
                    }
                    return fallback;
                }

                function safeListHtml(items) {
                    if (typeof listHtml === "function") return listHtml(items);
                    if (!items || !items.length) return '<span class="text-muted">None</span>';
                    return '<ul style="margin:0;padding-left:18px;">' + items.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") + "</ul>";
                }

                // -----------------------------
                // Detect payload shape
                // -----------------------------
                var isWrapped = payload && payload.AddLoanApplicationCommand;
                var isReschedule = payload && payload.RescheduleLoanCommand;

                var cmd = isWrapped ? payload.AddLoanApplicationCommand : (isReschedule ? payload.RescheduleLoanCommand : (payload || {}));

                // -----------------------------
