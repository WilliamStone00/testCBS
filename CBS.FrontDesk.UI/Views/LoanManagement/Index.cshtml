                $(".tsc-recovery-decision").off("change").on("change", function () {
                    var id = String($(this).data("id"));
                    if (!selected[id] || selected[id].locked) return;

                    selected[id].decision = String($(this).val());
                    if (selected[id].decision === "KeepOpen") {
                        selected[id].amount = 0;
                    }
                    renderRecoveryEditor();
                });

                $(".tsc-recovery-amount").off("input").on("input", function () {
