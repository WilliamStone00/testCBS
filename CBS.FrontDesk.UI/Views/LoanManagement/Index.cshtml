                $("#repaymentPeriodsPills").closest(".card, .col, .row, div").show(); // safe show
                $("#ddlRepaymentPeriod").closest(".col, .form-group, div").show();

                // ✅ hide recovery mechanism card during reschedule
                //$("#recoveryMechanismCard").toggle(!isReschedule);

                // ✅ also hide guarantees/collateral blocks etc. during reschedule (if you want)
                $(".tsc-guarantees-wrap").toggle(!isReschedule);
                // ✅ hide recovery mechanism during rescheduling
                $("#recoveryAccountsWrap").closest(".card").toggle(!isReschedule);
                // =====================================================
                // ✅ RESCHEDULE: lock amount to remaining principal/balance
                // =====================================================
                if (isReschedule) {
                    var loan = wizardState.oldLoan || {};

                    var originalAmount = Number(loan.amount || loan.Amount || 0);
                    var remainingPrincipal = Number(loan.balance || loan.Balance || 0);

                    // Requested amount = ORIGINAL amount
                    $("#txtAmount").val(originalAmount > 0 ? originalAmount : "").prop("readonly", true);

                    // Amount to be rescheduled = Remaining capital
