                return (safeVal("#txtAppMode") || wizardState.restructureMode || wizardState.applicationMode || "NEW").toString().toUpperCase();
            }

            function buildPayloadForSave() {
                var mode = getMode();
                var facility = getFacility();

                if (mode === "RESCHEDULE") return buildRescheduleLoanApplicationRequest();
                if (mode === "REFINANCE") return buildRefinanceLoanApplicationRequest();

                if (facility === "OVERDRAFT") return buildOverdraftApplicationRequest();
                if (facility === "LINEOFCREDIT" || facility === "LINE_OF_CREDIT") return buildLineOfCreditApplicationRequest();

                return buildNewLoanApplicationRequest();
            }

            // =========================
            // Preview helpers (unchanged)
