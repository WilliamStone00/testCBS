    });

    $("#panelFacility").on("click", ".btnRefinance, .btnReschedule", function () {
        var loanId = String($(this).data("loanid") || "");

        wizardState.oldLoanId = loanId;
        wizardState.restructureMode = $(this).hasClass("btnRefinance") ? "REFINANCE" : "RESCHEDULE";

        // ✅ NEW: attach the full loan object
        wizardState.oldLoan = (wizardState.loansById && wizardState.loansById[loanId])
            ? wizardState.loansById[loanId]
            : null;

        // You are restructuring, so facility tile must be cleared
        wizardState.facility = null;
        $(".facility-tile").removeClass("selected");

        $("#btnProceedToApplication").prop("disabled", false);

        // Highlight card
        $(".loan-card")
            .css("border-color", "var(--tsc-border)")
            .css("background", "#fff");

        $(this).closest(".loan-card")
            .css("border-color", "rgba(37,99,235,.35)")
            .css("background", "rgba(37,99,235,.05)");

        // ✅ OPTIONAL: if Step 3 script is already loaded, update it live
        if (window.tscLoan && typeof window.tscLoan.setOldLoan === "function" && wizardState.oldLoan) {
            window.tscLoan.setOldLoan(wizardState.oldLoan);
        }
    });



    // ✅ Step 3 wiring without breaking Step 1/2
    $("#btnProceedToApplication").on("click", function () {

        // Guards (same logic as before, but safer)
        if (!wizardState.memberId) {
            alert("Select a member first.");
            return;
        }
        if (!wizardState.restructureMode && !wizardState.facility) {
            alert("Select a facility (Classic / SSF / Overdraft / LOC) OR choose refinance/reschedule on a loan.");
            return;
        }

        // Stepper
        $("#stepFacility").removeClass("active").addClass("done");
        $("#stepApplication").addClass("active");

        // Panels
        $("#panelFacility").hide();
        $("#panelApplication").show();

        // 🔗 Wire Step 3 init (your Step 3 script must be loaded on the page)
        // Option A: if you used my Step 3 module: window.tscLoanApp.show()
        if (window.tscLoanApp && typeof window.tscLoanApp.init === "function") {
            window.tscLoanApp.init(); // init only (panel already shown)
            return;
        }
        if (window.tscLoanApp && typeof window.tscLoanApp.show === "function") {
            window.tscLoanApp.show(); // it will show panel + init
            return;
        }

        // Option B: if you exposed initApplicationUi() globally in your Step 3 script
        if (typeof window.initApplicationUi === "function") {
            window.initApplicationUi();
            return;
        }

        // Fallback: do not break the flow
        console.warn("Step 3 init function not found. Ensure Step 3 application script is loaded after this script.");
        $("#appModeHint").text("Step 3 script not loaded. Please include the Application script file after this one.");
    });

    // -----------------------------
    // Events (Search)
    // -----------------------------
    $("#btnBackToSearch").on("click", goBackToSearch);

    $("#memberResults").on("click", ".member-card", function () {
        try {
            var raw = $(this).attr("data-member");
            var m = JSON.parse(raw);

            // m is already normalized from renderMembers
            if (!m || !m.id) {
                console.error("Selected member missing id:", m);
                return;
            }

            goToFacility(m);
        } catch (e) {
            console.error("Member selection parse error:", e);
        }
    });

    $("#txtMemberSearch").on("input", function () {
        var q = ($(this).val() || "").trim();

        if (q.length < minLen) {
            lastQuery = q;
            setLoading(false);
            setEmpty(false);
            $("#searchHint").text("Start typing to see results.");
            $("#memberResults").empty();
            return;
        }

        $("#searchHint").text("Showing matches for: " + q);

        clearTimeout(timer);
        timer = setTimeout(function () {
            lastQuery = q;
            searchMembers(q);
        }, debounceMs);
    });

    function searchMembers(q) {
        setLoading(true);

        $.ajax({
            url: searchUrl,
            method: "GET",
            data: { q: q },
            cache: false
        })
        .done(function (res) {
            var items = (res && (res.data || res.Data)) ? (res.data || res.Data) : [];
            renderMembers(items);
        })
        .fail(function () {
            renderMembers([]);
            setEmpty(true);
        })
        .always(function () {
            setLoading(false);
        });
    }

})();
    </script>


    <script>
        // =====================================================
        // TSC Loan Wizard - STEP 3 (Application UI) Script ONLY
        // Keep this file separate from Search/Facility scripts.
        // Requires: jQuery, wizardState (global), #loanUiRoutes data-* routes.
        // =====================================================
        (function () {
            "use strict";
            var scoreConfig = null;

            // -----------------------------
            // Guard: wizardState must exist (created in Step 1/2 script)
            // -----------------------------
            if (!window.wizardState) {
                console.error("STEP3: wizardState is missing. Ensure search/facility script defines window.wizardState.");
                return;
            }
            var wizardState = window.wizardState;
            // -----------------------------
            // Routes (from Razor)
            // -----------------------------
            var $routes = $("#loanUiRoutes");
            var loanTypesUrl = $routes.data("loan-types-url");
            var productsUrl = $routes.data("products-url");
            var chargesUrl = $routes.data("charges-url");
            var scoreUrl = $routes.data("score-url");
            var accountsUrl = $routes.data("accounts-url");

            // -----------------------------
            // Public API: call from Step2 script
            // window.tscLoanApp.show()
            // -----------------------------
            window.tscLoanApp = window.tscLoanApp || {};
            window.tscLoanApp.show = showApplicationPanel;
            window.tscLoanApp.init = initApplicationUi; // optional alias

            // Optional (Step2 can call this live)
            window.tscLoan = window.tscLoan || {};
            window.tscLoan.setOldLoan = function (loan) {
                wizardState.oldLoan = loan || null;
                renderOldLoanDetails();
                applyModeUiRules(); // if already in step3
            };

            // -----------------------------
            // Local state for Step 3 only
            // -----------------------------
            var productCache = null; // last selected product object
            var scoreConfig = null;
            var scoresLoaded = false;
            // =====================================================
            // UI Helpers
            // =====================================================
            function escapeHtml(s) {
                return (s || "").replace(/[&<>"']/g, function (c) {
                    return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]);
                });
            }

            function pick(o, camel, pascal, fallback) {
                if (!o) return fallback;
                if (o[camel] !== undefined && o[camel] !== null) return o[camel];
                if (o[pascal] !== undefined && o[pascal] !== null) return o[pascal];
                return fallback;
            }

            function fmtMoney(v, currency) {
                return Number(v || 0).toLocaleString() + " " + escapeHtml(currency || "FCFA");
            }

            function showToastHint($el, text) {
                $el.text(text || "");
            }

            function inRange(n, min, max) {
                n = Number(n);
                min = Number(min);
                max = Number(max);
                if (isNaN(n)) return false;
                if (!isNaN(min) && min > 0 && n < min) return false;
                if (!isNaN(max) && max > 0 && n > max) return false;
                return true;
            }
            // =========================
            // Validation UI helpers
            // =========================
            function ensureInvalidFeedback($el, msg) {
                var $fb = $el.nextAll(".invalid-feedback").first();
                if (!$fb.length) $fb = $('<div class="invalid-feedback"></div>').insertAfter($el);
                $fb.text(msg || "Invalid value.");
            }
            function validateInterestToPolicy() {
                var policy = window.productPolicy || {};
                var minI = Number(policy.minInterest || 0);
                var maxI = Number(policy.maxInterest || 0);

                var $i = $("#txtInterest");
                var raw = ($i.val() || "").toString().trim();
                var v = parseFloat(raw);

                // empty => let your submit required checks handle it
                if (raw === "") {
                    $i.removeClass("is-invalid");
                    return true;
                }

                if (isNaN(v) || v <= 0) {
                    $i.addClass("is-invalid");
                    ensureInvalidFeedback($i, "Enter a valid interest rate.");
                    return false;
                }

                var ok = (v >= minI) && (v <= maxI);
                if (!ok) {
                    $i.addClass("is-invalid");
                    ensureInvalidFeedback($i, "Interest must be within product range (" + minI + "% - " + maxI + "%).");

                    // keep focus on interest so user fixes it
                    setTimeout(function () { $i.focus(); }, 0);
                    return false;
                }

                $i.removeClass("is-invalid");
                return true;
            }

            // clamp on blur (manager finishes typing)
            $("#txtInterest")
                .off("input.intPolicy blur.intPolicy")
                .on("input.intPolicy", function () {
                    // soft validate while typing (no focus stealing)
                    validateInterestToPolicy();
                })
                .on("blur.intPolicy", function () {
                    // strong validate: if invalid, force focus back
                    if (!validateInterestToPolicy()) {
                        setTimeout(function () { $("#txtInterest").focus(); }, 0);
                        return false;
                    }

                    // keep your existing live validator call if you want
                    if (typeof validateAmountInterestPeriodLive === "function") {
                        validateAmountInterestPeriodLive();
                    }
                });


            // Live bind
            $("#txtAmount, #txtInterest").on("input blur", validateAmountInterestPeriodLive);
            $("#ddlRepaymentPeriod").on("change", validateAmountInterestPeriodLive);

            // =====================================================
            // Step 3: Show/Init Application Panel
            // =====================================================
            function showApplicationPanel() {
                // Basic guards
                if (!wizardState.memberId) {
                    alert("Select a member first.");
                    return;
                }

                // For NEW applications, facility must be selected
                if (!wizardState.restructureMode && !wizardState.facility) {
                    alert("Select a facility first (Classic / SSF / Overdraft / LOC).");
                    return;
                }

                // Move panels
                $("#panelFacility").hide();
                $("#panelApplication").show();

                // Stepper (if your stepper exists)
                $("#stepFacility").removeClass("active").addClass("done");
                $("#stepApplication").addClass("active");

                initApplicationUi();
            }
            function validateAmountInterestPeriodLive() {
                var okAmount = validateAmountLive();           // your existing amount validation
                var okInterest = validateInterestLive();       // ✅ new
                var okGrace = validateGracePeriodLive();       // ✅ new
                var okRp = validateRepaymentPeriodLive();      // if you have it

                return okAmount && okInterest && okGrace && okRp;
            }
            function setInvalid($el, isInvalid, message) {
                // same pattern for ALL inputs: message under the input
                // try to find an existing message element next to the input
                var $msg = $el.siblings(".invalid-feedback, .field-error").first();

                // if not found, create one (bootstrap invalid-feedback)
                if (!$msg.length) {
                    $msg = $('<div class="invalid-feedback d-block"></div>');
                    $el.after($msg);
                }

                if (isInvalid) {
                    $el.addClass("is-invalid");
                    $msg.text(message || "Invalid value.").show();
                } else {
                    $el.removeClass("is-invalid");
                    $msg.text("").hide();
                }
            }
            function loadPolicyFromOldLoanProduct() {
                var dfd = $.Deferred();

                if (!productsUrl) return dfd.resolve(null).promise();

                var loan = wizardState.oldLoan || {};
                var oldProductId =
                    loan.loanProductId || loan.LoanProductId ||
                    loan.productId || loan.ProductId || "";

                if (!oldProductId) {
                    console.warn("RESCHEDULE: old loan product id missing.");
                    resetProductPolicyBox();
                    bindRepaymentPeriods({ Periods: [] }); // clear ddl
                    return dfd.resolve(null).promise();
                }

                // ✅ use your existing endpoint shape (list)
                $.get(productsUrl, {
                    facility: wizardState.facility || "AUTO",
                    mode: "RESCHEDULE",
                    oldLoanId: wizardState.oldLoanId
                })
                    .done(function (res) {
                        var list = (res && (res.data || res.Data)) || [];

                        // find by id
                        var p = (list || []).find(function (x) {
                            return String(pick(x, "id", "Id", "")) === String(oldProductId);
                        });

                        // fallback: if endpoint returns only one product
                        if (!p && list.length === 1) p = list[0];

                        if (!p) {
                            console.warn("RESCHEDULE: could not resolve old loan product in returned list.");
                            resetProductPolicyBox();
                            bindRepaymentPeriods({ Periods: [] });
                            return dfd.resolve(null).promise();
                        }

                        productCache = p;
                        bindProductPolicies(p);
                        bindRepaymentPeriods(p);

                        // optional: show purpose line even if product dropdown hidden
                        $("#pcmfPurposeLine").text(p.PcmfPurpose || p.pcmfPurpose || "--");
                        $("#pcmfPurposeBadge").text("Loaded");

                        return dfd.resolve(p).promise();
                    })
                    .fail(function () {
                        console.warn("RESCHEDULE: failed to load products list.");
                        resetProductPolicyBox();
                        bindRepaymentPeriods({ Periods: [] });
                        return dfd.resolve(null).promise();
                    });

                return dfd.promise();
            }
            function initApplicationUi() {
                var mode = wizardState.restructureMode ? wizardState.restructureMode : "NEW";
                $("#txtAppMode").val(mode);

                $("#txtFacility").val(wizardState.facility || "AUTO (from old loan)");

                renderOldLoanDetails();

                resetProductPolicyBox();
                resetChargesSummary();
                resetScoreBox();

                loadInstitutionLoanTypes();

                // ✅ NEW logic: if restructure -> load policy using oldLoanProductId
                if (mode === "RESCHEDULE" || mode === "REFINANCE") {
                    loadPolicyForRestructure();   // << add this
                } else {
                    loadInstitutionLoanProducts(); // normal NEW flow
                }

                applyModeUiRules();
            }

            function loadPolicyForRestructure() {
                var productId = wizardState.oldLoanProductId;
                if (!productId) {
                    console.warn("Missing oldLoanProductId. Cannot load product policy.");
                    return;
                }

                $.get(productsUrl, {
                    facility: "",                           // optional (controller can ignore)
                    mode: wizardState.restructureMode,      // "RESCHEDULE" | "REFINANCE"
                    oldLoanId: wizardState.oldLoanId,       // optional
                    productId: productId                    // ✅ key
                }).done(function (res) {
                    if (!res || !res.success) return;

                    var p = (res.data && res.data.length) ? res.data[0] : null;
                    if (!p) return;

                    // cache + bind policy + periods
                    productCache = p;

                    bindProductPolicies(p);
                    bindRepaymentPeriods(p);

                    // your existing calls if needed:
                    loadChargesForProduct(p.Id || p.id);
                    loadScoringAssessments();

                    // ✅ reschedule rules
                    if (wizardState.restructureMode === "RESCHEDULE") {
                        lockRescheduleAmounts();
                    }
                });
            }
            function lockRescheduleAmounts() {
                var oldLoan = wizardState.oldLoan || {};
                var oldAmount = Number(oldLoan.Amount || oldLoan.amount || 0);
                var oldBalance = Number(oldLoan.Balance || oldLoan.balance || 0);

                // ✅ show the amount being rescheduled (usually the remaining balance)
                $("#txtRescheduleAmount").val(oldBalance.toLocaleString());

                // ✅ requested amount must remain the original amount
                $("#txtAmount").val(oldAmount).prop("readonly", true);

