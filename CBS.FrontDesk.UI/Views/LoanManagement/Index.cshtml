            function loadScoreConfig() {
                if (!scoreConfigUrl) return $.Deferred().resolve().promise();

                return $.get(scoreConfigUrl, { facility: wizardState.facility })
                    .done(function (res) {
                        scoreConfig = (res && (res.data || res.Data)) || null;
                    })
                    .fail(function () {
                        console.warn("Score config failed to load. Using fallback defaults.");
                        scoreConfig = null;
                    });
            }

            function loadScoringAssessments() {
                var $ddl = $("#ddlScoreAssessments");
                $ddl.empty();
                autoSizeMultiSelect($ddl, 6, 16);

                if (!scoreUrl) return;

                scoresLoaded = false;

                // ✅ One call returns BOTH: config + assessments
                $.get(scoreUrl, { facility: wizardState.facility })
                    .done(function (res) {

                        // model contains Bands + Assessments + buffers
                        var model = (res && (res.data || res.Data)) || null;

                        // keep using same global variable name used by evaluateScore()
                        scoreConfig = model;

                        // assessments list
                        var items = model && (model.assessments || model.Assessments) || [];

                        if (!items.length) {
                            $ddl.append(`<option value="" disabled>No scoring assessments configured</option>`);
                            autoSizeMultiSelect($ddl, 3, 8);
                            return;
                        }

                        items.forEach(function (s) {
                            var id = pick(s, "id", "Id", "");
                            var name = pick(s, "name", "Name", "");
                            var pts = Number(pick(s, "points", "Points", 0));

                            $ddl.append(
                                `<option value="${escapeHtml(String(id))}" data-points="${pts}">
                                                                                    ${escapeHtml(String(name))} (+${pts})
                                                                                 </option>`
                            );
                        });

                        autoSizeMultiSelect($ddl, 6, 16);

                        scoresLoaded = true;
                        evaluateScore(); // initial
                    })
                    .fail(function () {
                        console.warn("Scoring model failed to load.");
                        scoreConfig = null;
                        autoSizeMultiSelect($ddl, 6, 16);
                    });
            }

            function autoSizeMultiSelect($sel, minRows, maxRows) {
                var count = $sel.find('option').length || 0;
                var rows = Math.max(minRows || 6, Math.min(maxRows || 14, count));
                $sel.attr('size', rows);
            }


            function requiredScoreByAmount(amount) {
                amount = Number(amount || 0);
                if (!amount || amount <= 0) return 0;

                var cfg = scoreConfig;
                var bands = cfg && (cfg.bands || cfg.Bands);

                if (!bands || !bands.length) {
                    // fallback (only if server failed)
                    if (amount <= 200000) return 40;
                    if (amount <= 1000000) return 60;
                    return 75;
                }

                for (var i = 0; i < bands.length; i++) {
                    var b = bands[i];
                    var max = Number(b.maxAmount || b.MaxAmount || 0);
                    var req = Number(b.requiredScore || b.RequiredScore || 0);
                    if (max > 0 && amount <= max) return req;
                }

                var last = bands[bands.length - 1];
                return Number(last.requiredScore || last.RequiredScore || 0);
            }
            function suggestedMaxAmountByScore(score) {
                score = Number(score || 0);
                var cfg = scoreConfig;
                var bands = cfg && (cfg.bands || cfg.Bands);
                if (!bands || !bands.length) return 0;

                // Sort by maxAmount ascending (safe)
                var sorted = bands.slice().sort(function (a, b) {
                    return Number(a.maxAmount || a.MaxAmount || 0) - Number(b.maxAmount || b.MaxAmount || 0);
                });

                var best = 0;
                for (var i = 0; i < sorted.length; i++) {
                    var b = sorted[i];
                    var max = Number(b.maxAmount || b.MaxAmount || 0);
                    var req = Number(b.requiredScore || b.RequiredScore || 0);
                    if (max > 0 && score >= req) best = max;
                }
                return best;
            }
            function getLoanAmount() {
                var v = parseFloat($("#txtAmount").val());
                return isNaN(v) ? 0 : v;
            }

            function computeSavingsCoverageProvided() {
                var loanAmount = getLoanAmount();
                var amt = parseFloat($("#txtSavingsCoverage").val() || 0);
                var rate = parseFloat($("#txtShareMinimumRequiredAmount").val() || 0);

                var fromRate = (loanAmount > 0 && rate > 0) ? (loanAmount * rate / 100.0) : 0;
                return Math.max(amt || 0, fromRate || 0); // user can enter either
            }
            function computeBlockedByKind() {
                var blocks = (window.tscRecovery && window.tscRecovery.getBlocks)
                    ? window.tscRecovery.getBlocks()
                    : [];

                // Build label map from select
                var labelMap = {};
                $("#ddlRecoveryAccounts option").each(function () {
                    labelMap[this.value] = $(this).text() || "";
                });

                var sums = { SAVINGS: 0, SHARES: 0, OTHER: 0, TOTAL: 0 };

                for (var i = 0; i < blocks.length; i++) {
                    var b = blocks[i];
                    var amt = parseFloat(b.BlockAmount) || 0;
                    var label = labelMap[b.AccountId] || "";
                    var kind = inferAccountKindFromText(label);

                    sums[kind] += amt;
                    sums.TOTAL += amt;
                }

                return sums;
            }
            function inferAccountKindFromText(text) {
                var t = String(text || "").toLowerCase();
                // You can adjust keywords to match your labels
                if (t.includes("ordinary shares") || t.includes("shares") || t.includes("shr-")) return "SHARES";
                if (t.includes("savings") || t.includes("sav-")) return "SAVINGS";
                return "OTHER";
            }
            function validateSavingsSharesAndDownPaymentLive() {

                var policy = window.productPolicy || {};
                var loanAmount = getLoanAmount();
                if (!loanAmount || loanAmount <= 0) return true;

                var ok = true;

                function toNum(v) {
                    var n = Number(v);
                    return isNaN(n) ? 0 : n;
                }

                function inRange(n, min, max) {
                    n = toNum(n); min = toNum(min); max = toNum(max);
                    if (min > 0 && n < min) return false;
                    if (max > 0 && n > max) return false;
                    return true;
                }

                // Same inline-message style as grace-period (under the control)
                function mark($el, isOk, msg) {
                    if (!$el || !$el.length) return isOk;
                    ok = ok && isOk;

                    if (typeof setInvalid === "function") {
                        setInvalid($el, !isOk, msg);
                    } else {
                        $el.toggleClass("is-invalid", !isOk);
                    }
                    return isOk;
                }

                // -----------------------------
                // 1) Savings requirement
                // -----------------------------
                var pct = toNum(policy.minSavingsPercent);
                var abs = toNum(policy.minSavingsAbs);
                var pctAmt = (loanAmount * pct) / 100.0;
                var requiredSavings = Math.max(abs, pctAmt);

                // Provided savings (manager can enter either amount OR rate)
                var providedSavings = computeSavingsCoverageProvided(); // already supports amount or rate

                if (requiredSavings > 0) {
                    var hasSavingsInput = ($("#txtSavingsCoverage").length || $("#txtSavingsCoverageRate").length);

                    var msgSavings =
                        "Savings coverage must be within policy requirement. " +
                        "Required: " + requiredSavings.toLocaleString() + " FCFA " +
                        "(Abs: " + abs.toLocaleString() + " FCFA, or " + pct + "% of amount).";

                    // Must enter something + must meet required
                    mark($("#txtSavingsCoverage"), hasSavingsInput && providedSavings > 0 && providedSavings >= requiredSavings, msgSavings);
                    mark($("#txtSavingsCoverageRate"), hasSavingsInput && providedSavings > 0 && providedSavings >= requiredSavings, msgSavings);
                } else {
                    // if policy doesn't require, still ensure non-negative
                    mark($("#txtSavingsCoverage"), toNum($("#txtSavingsCoverage").val()) >= 0, "Savings coverage cannot be negative.");
                    mark($("#txtSavingsCoverageRate"), toNum($("#txtSavingsCoverageRate").val()) >= 0, "Savings coverage rate cannot be negative.");
                }

                // -----------------------------
                // 2) Shares requirement (from policy) vs manager entered value
                // -----------------------------
                var requiredShares = toNum(policy.minSharesRequired);
                var sharesProvided = toNum($("#txtShareMinimumRequiredAmount").val()); // ✅ manager entry

                if (requiredShares > 0) {

                    var msgShares =
                        "Shares amount must meet policy requirement. " +
                        "Required: " + requiredShares.toLocaleString() + " FCFA.";

                    // Must enter and must meet required
                    mark($("#txtShareMinimumRequiredAmount"), sharesProvided > 0 && sharesProvided >= requiredShares, msgShares);

                    // Optional consistency check: if recovery mechanism enabled and share accounts selected,
                    // ensure blocked shares is not less than what manager claims (avoid mismatch).
                    if ($("#chkRecoveryMechanism").is(":checked")) {
                        var sums = computeBlockedByKind(); // SAVINGS / SHARES / OTHER / TOTAL

                        // only enforce if there is at least one shares account selected/blocking exists
                        if (sums.SHARES > 0) {
                            mark(
                                $("#txtShareMinimumRequiredAmount"),
                                sums.SHARES >= sharesProvided,
                                "Blocked shares (" + sums.SHARES.toLocaleString() + " FCFA) cannot be less than shares provided (" + sharesProvided.toLocaleString() + " FCFA). " +
                                "Tip: increase shares block amount or adjust provided shares."
                            );
                        }
                    }
                } else {
                    // if policy doesn't require, still ensure non-negative
                    mark($("#txtShareMinimumRequiredAmount"), sharesProvided >= 0, "Shares amount cannot be negative.");
                }

                // -----------------------------
                // 3) Down Payment required (validate against Total Blocked Recovery)
                // -----------------------------
                if (policy.requireDownPayment) {

                    var dpRate = toNum(policy.downPaymentRatePercent);
                    var requiredDp = (loanAmount > 0 && dpRate > 0) ? (loanAmount * dpRate / 100.0) : 0;

                    var sums2 = computeBlockedByKind();
                    var providedDp = toNum(sums2.TOTAL); // ✅ your highlighted total blocked

                    // If you also have a specific downpayment input, you can validate that too,
                    // but for now we validate using TOTAL BLOCKED.
                    var msgDp =
                        "Down payment is required by policy. " +
                        "Required: " + requiredDp.toLocaleString() + " FCFA (" + dpRate + "% of amount). " +
                        "Provided (Total Blocked): " + providedDp.toLocaleString() + " FCFA.";

                    // Put message under a visible control (choose one):
                    // If you have a textbox, use it. Otherwise attach to the recovery select.
                    if ($("#txtDownPaymentAmount").length) {
                        mark($("#txtDownPaymentAmount"), providedDp >= requiredDp, msgDp);
                    } else {
                        // attach to recovery accounts selector (best visible target for this rule)
                        mark($("#ddlRecoveryAccounts"), providedDp >= requiredDp, msgDp);
                    }
                }

                return ok;
            }

            $("#txtSavingsCoverage, #txtSavingsCoverageRate, #txtShareMinimumRequiredAmount")
