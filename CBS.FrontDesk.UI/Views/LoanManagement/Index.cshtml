                // -----------------------------
                if (mode === "RESCHEDULE" || isReschedule) {

                    // ✅ New period/grace are MONTHS
                    // Try mode-specific props first, then fallback to common ones
                    var newPeriodMonths = pick(cmd, ["NewRepaymentPeriodMonths", "newRepaymentPeriodMonths", "NewRepaymentPeriod", "newRepaymentPeriod"], repaymentPeriod);
                    var newGraceMonths = Number(pick(cmd, ["NewGracePeriodMonths", "newGracePeriodMonths", "GracePeriodMonths", "gracePeriodMonths", "GracePeriodDays", "gracePeriodDays"], graceMonths)) || 0;

                    // also show capital/reschedule amount if your command contains it (optional)
