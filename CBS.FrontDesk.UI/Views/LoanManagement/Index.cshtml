                var memberCode = mem.code || "";

                function moneyWithCurrency(v, ccy) {
                    return num(v).toLocaleString() + " " + esc(ccy || "FCFA");
                }

                // --------------------------
                // ✅ HTML helpers
                // --------------------------
                function badge(text, cls) {
                    return '<span class="badge rounded-pill ' + (cls || 'bg-light text-dark border') + '">' + esc(text || "") + '</span>';
                }

                function emptyBox(msg) {
                    return '<div class="text-muted small">' + esc(msg || "None") + '</div>';
                }

                function dlRow(label, valueHtml) {
                    return '<div class="d-flex justify-content-between align-items-start gap-2">' +
                        '<span class="text-muted small">' + esc(label) + '</span>' +
                        '<span class="fw-bold text-dark text-end" style="max-width:60%;">' + (valueHtml || "") + '</span>' +
                        '</div>';
                }

                function sectionTitle(icon, title, sub) {
                    return '<div class="d-flex justify-content-between align-items-start gap-2">' +
