            }

            $("#btnAddCollateral").off("click.addC").on("click.addC", addCollateralCard);

            // Also rebuild when section toggles on/off
            $("#chkCollateral").on("change", function () { syncRiskFormsVisibility(); rebuildCollateralJson(); renderDownpaymentBox(); });
            $("#chkGuarantor").on("change", function () { syncRiskFormsVisibility(); rebuildGuarantorsJson(); renderDownpaymentBox(); });
            $("#chkDownPayment").on("change", function () { syncRiskFormsVisibility(); renderDownpaymentBox(); });


        })();





        /* ========================================================================
           PATCH vNext (Recovery + RefData UX)
           - Hide Recovery Summary section (Policy Downpayment Coverage inside Recovery card)
           - Prevent unchecking locked policy-required Savings/Shares in Recovery picker/editor
           - Downpayment Provided = sum of entered recovery amounts (excluding shares)
           - Add "Load Lists" button to reload Relationships + Collateral Types
           - Ensure ref data reload on Guarantor Type change
           ======================================================================== */
        (function () {
            if (typeof window === "undefined") return;

            // -----------------------------
            // Helpers (safe)
            // -----------------------------
            function toNum(v) { var n = parseFloat(String(v ?? "0").replace(/,/g, "")); return isNaN(n) ? 0 : n; }
            function normStr(v) { return (v || "").toString().trim(); }
            function isSharesType(type) {
                var s = normStr(type).toLowerCase().replace(/\s+/g, " ").trim();
                // exclude any shares
                return s.includes("shares") || s.includes("share");
            }
            function isOrdinarySharesType(type) {
                var s = normStr(type).toLowerCase().replace(/\s+/g, " ").trim();
                return s.includes("ordinary shares") || s.includes("ordinaryshares");
            }

            function findRecoveryAccountById(id) {
                try {
                    var accounts = (window.recoveryState && window.recoveryState.accounts) ? window.recoveryState.accounts : [];
                    for (var i = 0; i < accounts.length; i++) {
                        var a = accounts[i];
                        var aid = (typeof pick === "function") ? String(pick(a, "id", "Id", "")) : String(a.id || a.Id || "");
                        if (String(aid) === String(id)) return a;
                    }
                } catch (e) { /* ignore */ }
                return null;
            }

            // -----------------------------
            // 1) Hide Recovery Summary (remove highlighted section)
            // -----------------------------
            function hideRecoverySummary() {
                try {
                    var $sum = $("#recoverySummary");
                    if ($sum.length) $sum.hide().empty();
                } catch (e) { /* ignore */ }
            }

            // -----------------------------
            // 2) Prevent unchecking locked policy-required accounts
            // -----------------------------
            function enforceLockedRecoverySelection($chk) {
                try {
                    var id = $chk.data("id");
                    if (!id) return;

                    var sel = (window.recoveryState && window.recoveryState.selected) ? window.recoveryState.selected[id] : null;
                    if (sel && sel.locked) {
                        // revert
                        $chk.prop("checked", true);
                        if (window.alertify && alertify.error) alertify.error("This account is required by policy and cannot be unchecked.");
                        else console.warn("Policy-required account cannot be unchecked:", id);
                    }
                } catch (e) { /* ignore */ }
            }

            // -----------------------------
            // 3) Downpayment Provided = sum of entered recovery amounts (excluding shares)
            //    Uses DOM so it reflects EXACT user inputs.
            // -----------------------------
            window.computeDownpaymentProvidedFromRecovery = function () {
                var provided = 0;

                // 3.1 Recovery accounts amounts entered (exclude shares)
                try {
                    $(".recovery-selected-item").each(function () {
                        var $row = $(this);
                        var type = normStr($row.data("type"));
                        var amt = toNum($row.find(".txtRecoveryAmount").val());
                        if (amt <= 0) return;

                        // exclude shares (ordinary + preference + any shares)
                        if (isSharesType(type)) return;

                        provided += amt;
                    });
                } catch (e) { /* ignore */ }

                // 3.2 Also include coobligor/shotee contributions if your riskState stores them
                // (kept for backward compatibility, but safe if not present)
                try {
                    if (window.riskState && Array.isArray(window.riskState.guarantors)) {
                        window.riskState.guarantors.forEach(function (g) {
                            var t = normStr(g && (g.type || g.GuarantorType || g.guarantorType)).toUpperCase();
                            // only those that represent blocked amount contributions
                            if (t === "COOBLIGOR" || t === "SHOTEE" || t === "INTER_COOPERATION") {
                                var ba = toNum(g.blockAmount || g.BlockAmount || g.guaranteeAmount || g.GuaranteeAmount || 0);
                                if (ba > 0) provided += ba;
                            }
                        });
                    }
                } catch (e) { /* ignore */ }

                return Math.round(provided);
            };

            // Whenever recovery amounts change, refresh downpayment box immediately
            function hookRecoveryToDownpayment() {
                $(document)
                    .off("input.dpFromRecovery change.dpFromRecovery", "#recoveryCard .txtRecoveryAmount, #recoveryCard .ddlRecoveryDecision")
                    .on("input.dpFromRecovery change.dpFromRecovery", "#recoveryCard .txtRecoveryAmount, #recoveryCard .ddlRecoveryDecision", function () {
                        try {
                            if ($("#chkDownPayment").is(":checked") && typeof window.renderDownpaymentBox === "function") {
                                window.renderDownpaymentBox();
                            }
                        } catch (e) { /* ignore */ }
                    });
            }

            // -----------------------------
            // 4) Add "Load Lists" button (Relationships + Collateral Types)
            // -----------------------------
            function injectRefReloadButton() {
                try {
                    // Add near guarantor add button
                    if ($("#btnLoadRefData").length === 0 && $("#btnAddGuarantor").length) {
                        var btn = `
          <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLoadRefData" title="Reload Relationships & Collateral Types">
            <i class="mdi mdi-refresh me-1"></i> Load Lists
          </button>`;
                        $("#btnAddGuarantor").before(btn);
                    }

                    // Click handler
                    $(document)
                        .off("click.refdata", "#btnLoadRefData")
                        .on("click.refdata", "#btnLoadRefData", function () {
                            try {
                                if (typeof window.loadReferenceData === "function") {
                                    window.loadReferenceData(true).then(function () {
                                        if (window.alertify && alertify.success) alertify.success("Lists loaded.");
                                    });
                                } else {
                                    if (window.alertify && alertify.error) alertify.error("Reference loader is not available.");
                                    else alert("Reference loader is not available.");
                                }
                            } catch (e) {
                                console.error(e);
                            }
                        });
                } catch (e) { /* ignore */ }
            }

            // Ensure ref data load on guarantor type change (user request)
            function hookGuarantorTypeLoadsRefData() {
                $(document)
                    .off("change.refdata", "#guarantorList .ddlGuarantorType")
                    .on("change.refdata", "#guarantorList .ddlGuarantorType", function () {
                        try {
                            // reload if relationships not populated yet
                            var $card = $(this).closest("[data-gid]");
                            var $rel = $card.find(".ddlRelationship");
                            var needs = !$rel.length || $rel.find("option").length <= 1;
                            if (needs && typeof window.loadReferenceData === "function") window.loadReferenceData(true);
                        } catch (e) { /* ignore */ }
                    });
            }

            // -----------------------------
            // Reference Lists Loader (Relationships & Collateral Types)
            // Exposed globally for the "Load Lists" button and for guarantor-type onchange.
            // -----------------------------
            window.loadReferenceData = function (force) {
                force = !!force;
                window.__step3RefData = window.__step3RefData || { relationships: null, collateralTypes: null, loadedAt: 0 };

                var now = Date.now();
                // Cache for 10 minutes unless force
                if (!force && window.__step3RefData.loadedAt && (now - window.__step3RefData.loadedAt) < (10 * 60 * 1000)
                    && Array.isArray(window.__step3RefData.relationships) && Array.isArray(window.__step3RefData.collateralTypes)) {
                    return Promise.resolve(window.__step3RefData);
                }

                var routes = (typeof getRoutes === "function") ? getRoutes() : null;
                var relUrl = (routes && routes.relationshipsUrl) || window.relationshipsUrl || null;
                var colUrl = (routes && routes.collateralTypesUrl) || window.collateralTypesUrl || null;

                function normList(resp) {
                    if (!resp) return [];
                    if (Array.isArray(resp)) return resp;
                    if (resp.data && Array.isArray(resp.data)) return resp.data;
                    if (resp.Data && Array.isArray(resp.Data)) return resp.Data;
                    return [];
                }

                function loadJson(url) {
                    if (!url) return Promise.resolve([]);
                    return new Promise(function (resolve) {
                        $.getJSON(url)
                            .done(function (resp) { resolve(normList(resp)); })
                            .fail(function () { resolve([]); });
                    });
                }

                return Promise.all([loadJson(relUrl), loadJson(colUrl)]).then(function (res) {
                    window.__step3RefData.relationships = res[0] || [];
                    window.__step3RefData.collateralTypes = res[1] || [];
                    window.__step3RefData.loadedAt = Date.now();

                    // Refresh dropdowns in all existing cards
                    try {
                        $(".ddlRelationship").each(function () {
                            var $ddl = $(this);
                            var cur = $ddl.val();
                            $ddl.empty().append('<option value="">-- Select relationship --</option>');
                            window.__step3RefData.relationships.forEach(function (r) {
                                var id = pick(r, "id", "Id", "value", "Value", "");
                                var name = pick(r, "name", "Name", "text", "Text", "");
                                if (!id && name) id = name;
                                $ddl.append('<option value="' + esc(id) + '">' + esc(name || id) + '</option>');
                            });
                            if (cur) $ddl.val(cur);
                        });

                        $(".ddlCollateralType").each(function () {
                            var $ddl = $(this);
                            var cur = $ddl.val();
                            $ddl.empty().append('<option value="">-- Select collateral type --</option>');
                            window.__step3RefData.collateralTypes.forEach(function (c) {
                                var id = pick(c, "id", "Id", "value", "Value", "");
                                var name = pick(c, "name", "Name", "text", "Text", "");
                                if (!id && name) id = name;
                                $ddl.append('<option value="' + esc(id) + '">' + esc(name || id) + '</option>');
                            });
                            if (cur) $ddl.val(cur);
                        });
                    } catch (e) { /* ignore */ }

                    return window.__step3RefData;
                });
            };



            // -----------------------------
            // 5) Enforce locked selection on picker checkbox change
            // -----------------------------
            function hookLockedCheckboxGuard() {
                $(document)
                    .off("change.lockedRecovery", "#recoveryCard .tsc-recovery-pick")
                    .on("change.lockedRecovery", "#recoveryCard .tsc-recovery-pick", function () {
                        var $chk = $(this);
                        // if user tries to uncheck a locked account, revert.
                        if (!$chk.is(":checked")) enforceLockedRecoverySelection($chk);
                    });
            }

            // -----------------------------
            // Init patches
            // -----------------------------

            // -----------------------------
            // Public exports (compatibility)
            // Some existing wizard scripts call these by name.
            // We expose them safely without overwriting if already defined.
            // -----------------------------
            try {
                window.LoanWizardStep3 = window.LoanWizardStep3 || {};
                window.LoanWizardStep3.formatMoney = formatMoney;
                window.LoanWizardStep3.parseMoney = (typeof parseMoney === "function") ? parseMoney : window.LoanWizardStep3.parseMoney;
                window.LoanWizardStep3.loadReferenceDataOnce = (typeof loadReferenceDataOnce === "function") ? loadReferenceDataOnce : window.LoanWizardStep3.loadReferenceDataOnce;
                window.LoanWizardStep3.applyDownpaymentProvided = (typeof applyDownpaymentProvided === "function") ? applyDownpaymentProvided : window.LoanWizardStep3.applyDownpaymentProvided;

                if (typeof window.formatMoney === "undefined") window.formatMoney = formatMoney;
                if (typeof window.parseMoney === "undefined" && typeof parseMoney === "function") window.parseMoney = parseMoney;
                if (typeof window.loadReferenceDataOnce === "undefined" && typeof loadReferenceDataOnce === "function") window.loadReferenceDataOnce = loadReferenceDataOnce;
                if (typeof window.applyDownpaymentProvided === "undefined" && typeof applyDownpaymentProvided === "function") window.applyDownpaymentProvided = applyDownpaymentProvided;

                // Expose routes if other scripts depend on it
                if (typeof window.routes === "undefined" && typeof routes !== "undefined") window.routes = routes;
            } catch (e) { /* ignore */ }

            $(function () {
                hideRecoverySummary();
                injectRefReloadButton();
                hookGuarantorTypeLoadsRefData();
                hookLockedCheckboxGuard();
                hookRecoveryToDownpayment();
            });
        })();



        /* =========================================================
           STEP 3 PATCH (2026-01-01)
           Fixes:
           - Enforce Block Amount <= selected account balance
           - Sync Block Amount -> Guarantee Amount (readonly) for Coobligor/Shotee/Inter-Cooperation
           - Make policy-required recovery accounts readonly (Savings + Shares etc)
           - Include Moral Guarantor guarantee amount + Collateral amount in Downpayment "Provided"
           - Render Credit Scoring as checkbox list (keeps underlying select in sync)
           ========================================================= */
        (function (w, $) {
            if (!$) return;

            // ---------- small helpers ----------
            function msgErr(m) {
                try { if (w.alertify && alertify.error) return alertify.error(m); } catch (e) { }
                console.error(m);
            }
            function msgInfo(m) {
                try { if (w.alertify && alertify.message) return alertify.message(m); } catch (e) { }
                console.log(m);
            }
            function toNum(v) {
                var n = parseFloat((v || "0").toString().replace(/,/g, ""));
                return isFinite(n) ? n : 0;
            }
            function isSharesText(t) {
                t = (t || "").toString().toLowerCase();
                return t.includes("shares") || t.includes("ordinaryshare") || t.includes("ordinary shares") || t.includes("preferenceshare") || t.includes("preference shares");
            }
            function isSavingsText(t) {
                t = (t || "").toString().toLowerCase();
                return t.includes("savings");
            }
            function parseBalFromOptionText(txt) {
                // expects "...(Bal: 325,000 FCFA)" -> 325000
                if (!txt) return 0;
                var m = txt.toString().match(/Bal:\s*([0-9,\.\s]+)/i);
                if (!m) return 0;
                return toNum(m[1]);
            }

            // ---------- DOWNPAYMENT PROVIDED calculation ----------
            function getDpRequired() { return toNum($("#dpRequiredAmt").text()); }

            function sumRecoveryProvidedExcludingShares() {
                // sums amounts typed in selected recovery cards, excluding shares
                var total = 0;

                // preferred: cards under #recoveryCard #recoveryAmountsList
                $("#recoveryCard #recoveryAmountsList .tsc-rec-card, #recoveryCard #recoveryAmountsList .card").each(function () {
                    var $card = $(this);
                    var title = $card.find(".fw-semibold, .fw-bold, h6, h5").first().text() || $card.text();
                    if (isSharesText(title)) return;

                    var $amt = $card.find("input[type='number'], input.amount, .txtRecoveryAmount").first();
                    if ($amt && $amt.length) total += toNum($amt.val());
                });

                // fallback: any visible recovery amounts inputs (excluding shares)
                if (total <= 0) {
                    $("#recoveryCard input[type='number']").each(function () {
                        var $i = $(this);
                        var $wrap = $i.closest(".card, .tsc-rec-card");
                        var title = $wrap.find(".fw-semibold, .fw-bold, h6, h5").first().text() || $wrap.text();
                        if (isSharesText(title)) return;
                        total += toNum($i.val());
                    });
                }
                return total;
            }

            function sumCollateralAmounts() {
                var t = 0;
                $("#collateralList .colAmount").each(function () { t += toNum($(this).val()); });
                return t;
            }


            function sumMemberGuarantorBlockedAmounts() {
                var sum = 0;
                $("#guarantorList [data-gid]").each(function () {
                    var $card = $(this);
                    var t = String($card.find(".ddlGuarantorType").val() || "").toUpperCase();
                    if (!(t === "COOBLIGOR" || t === "SHOTEE")) return;

                    var blockYes = String($card.find(".ddlBlockFlag").val() || "true").toLowerCase() === "true";
                    if (!blockYes) return;

                    sum += parseMoney($card.find(".txtBlockAmount").val());
                });
                return sum;
            }

            function sumMoralGuarantorAmounts() {
                var t = 0;
                $("#guarantorList [data-gid]").each(function () {
                    var $card = $(this);
                    var gType = ($card.find(".ddlGuarantorType").val() || "").toString().toUpperCase();
                    if (gType === "MORAL_GUARANTOR") {
                        t += toNum($card.find(".txtGuaranteeAmount").val());
                    }
                });
                return t;
            }


            /**
             * Total blocked amount (All sources)
             * - Recovery Accounts (selected & marked to block) EXCLUDING Savings/Ordinary Shares if required
             * - Guarantor member accounts blocked (Co-obligor/Shotee) when Block? = Yes
             *
             * This drives the readonly field #txtTotalRecoveryBlocked.
             */
            function updateTotalBlockedAll() {
                var total = 0;
                try { total += sumRecoveryProvidedExcludingShares(); } catch (e) { /* ignore */ }
                try { total += sumMemberGuarantorBlockedAmounts(); } catch (e) { /* ignore */ }

                if ($("#txtTotalRecoveryBlocked").length) {
                    $("#txtTotalRecoveryBlocked").val(formatMoney(total));
                }
                return total;
            }

            function applyDownpaymentProvided() {
                // Provided = recovery(non-shares) + collateral + moral guarantors
                //var provided = sumRecoveryProvidedExcludingShares() + sumCollateralAmounts() + sumMoralGuarantorAmounts() + sumMemberGuarantorBlockedAmounts();
                var provided = sumRecoveryProvidedExcludingShares() + sumMemberGuarantorBlockedAmounts();

                // update UI if present
                if ($("#dpProvidedAmt").length) $("#dpProvidedAmt").text(provided.toLocaleString());
                if ($("#dpRemainingAmt").length) {
                    var rem = Math.max(0, getDpRequired() - provided);
                    $("#dpRemainingAmt").text(rem.toLocaleString());
                }

                // Keep global blocked total updated
                updateTotalBlockedAll();

                // badge
                var req = getDpRequired();
                var covered = provided >= req && req > 0;
                var $b = $("#dpCoverageBadge");
                if ($b.length) {
                    $b.removeClass("bg-secondary-subtle text-secondary bg-danger-subtle text-danger bg-success-subtle text-success border");
                    if (req <= 0) {
                        $b.addClass("bg-secondary-subtle text-secondary border").text("Not evaluated");
                    } else if (covered) {
                        $b.addClass("bg-success-subtle text-success border").text("COVERED");
                    } else {
                        $b.addClass("bg-danger-subtle text-danger border").text("NOT COVERED");
                    }
                }
            }

            // expose for your "Recalculate" button
            w.tscRecalcDownpaymentProvided = applyDownpaymentProvided;

            // ---------- Balance control + guarantee sync ----------
            function enforceBlockAmount($card) {
                var gType = ($card.find(".ddlGuarantorType").val() || "").toString().toUpperCase();
                var isMemberBlocking = (gType === "COOBLIGOR" || gType === "SHOTEE");
                if (!isMemberBlocking) return;

                var $ddl = $card.find(".ddlAccount");
                var $blk = $card.find(".txtBlockAmount");
                var $gua = $card.find(".txtGuaranteeAmount");

                if (!$ddl.length || !$blk.length || !$gua.length) return;

                var $opt = $ddl.find("option:selected");
                var bal = toNum($opt.data("balance"));
                if (!bal) bal = parseBalFromOptionText($opt.text());

                var v = toNum($blk.val());
                if (bal > 0 && v > bal) {
                    msgErr("Block amount cannot exceed account balance (" + bal.toLocaleString() + ").");
                    v = bal;
                    $blk.val(v);
                }

                // Sync Guarantee Amount from Block Amount for SHOTEE / CO-OBLIGOR (must always match)
                function syncGuaranteeFromBlockIfNeeded($card) {
                    try {
                        var type = String($card.find(".ddlGuarantorType").val() || "").toLowerCase();
                        var isSync =
                            type.includes("shotee") ||
                            type.includes("co-obligor") || type.includes("coobligor") || type.includes("co obligor");
                        if (!isSync) return;

                        var v = parseMoney($card.find(".txtBlockAmount").val());
                        if (isNaN(v) || v < 0) v = 0;

                        var $g = $card.find(".txtGuaranteeAmount");
                        $g.val(formatMoney(v));
                        // keep readonly so user cannot diverge it from blocked amount
                        $g.prop("readonly", true);
                    } catch (e) { /* no-op */ }
                }

                // Sync to guarantee + lock
                $gua.val(v);
                $gua.prop("readonly", true);
            }

            // Also when user manually edits guarantee for moral guarantor, re-apply DP
            function wireGuarantorEvents() {
                // block amount input
                $(document).off("input.tscblk", "#guarantorList .txtBlockAmount");
                $(document).on("input.tscblk", "#guarantorList .txtBlockAmount", function () {
                    var $card = $(this).closest("[data-gid]");
                    enforceBlockAmount($card);
                    applyDownpaymentProvided();
                });

                // account change
                $(document).off("change.tscacc", "#guarantorList .ddlAccount");
                $(document).on("change.tscacc", "#guarantorList .ddlAccount", function () {
                    var $card = $(this).closest("[data-gid]");
                    enforceBlockAmount($card);
                    applyDownpaymentProvided();
                });

                // guarantor type change => unlock/lock guarantee amount accordingly
                $(document).off("change.tscgtype2", "#guarantorList .ddlGuarantorType");
                $(document).on("change.tscgtype2", "#guarantorList .ddlGuarantorType", function () {
                    var $card = $(this).closest("[data-gid]");
                    var t = ($(this).val() || "").toString().toUpperCase();
                    var $gua = $card.find(".txtGuaranteeAmount");
                    if (t === "COOBLIGOR" || t === "SHOTEE" || t === "INTER_COOPERATION") {
                        // will be synced from block
                        $gua.val(toNum($card.find(".txtBlockAmount").val()));
                        $gua.prop("readonly", true);
                    } else {
                        $gua.prop("readonly", false);
                    }
                    applyDownpaymentProvided();
                });

                // moral guarantor guarantee amount typing => add to DP
                $(document).off("input.tscgua", "#guarantorList .txtGuaranteeAmount");
                $(document).on("input.tscgua", "#guarantorList .txtGuaranteeAmount", function () {
                    var $card = $(this).closest("[data-gid]");
                    var t = ($card.find(".ddlGuarantorType").val() || "").toString().toUpperCase();
                    if ((t === "MORAL_GUARANTOR" || t === "INTER_COOPERATION")) applyDownpaymentProvided();
                });
            }

            // ---------- Recovery required accounts readonly ----------
            function lockPolicyRecoveryEditors() {
                // Treat Savings and Ordinary Shares as required by default IF they are checked and show "Required by policy" or decision is "Required (Policy)"
                $("#recoveryCard #recoveryAmountsList .card, #recoveryCard #recoveryAmountsList .tsc-rec-card").each(function () {
                    var $c = $(this);
                    var title = $c.find(".fw-semibold, .fw-bold, h6, h5").first().text() || "";
                    var isPolicy = ($c.text() || "").toLowerCase().includes("required by policy") || ($c.find("select").val() || "").toLowerCase().includes("required");
                    var mustLock = isPolicy || isSavingsText(title) || title.toLowerCase().includes("ordinaryshares");
                    if (!mustLock) return;

                    $c.find("input[type='number']").prop("readonly", true).prop("disabled", true).addClass("bg-light");
                    $c.find("select").prop("disabled", true).addClass("bg-light");
                    $c.find(".btn-remove, .btnRemove, .remove, .mdi-close, button.btn-outline-danger, button.btn-danger").prop("disabled", true).hide();
                });
            }

            // whenever recovery amounts change, recalc downpayment
            function wireRecoveryRecalc() {
                $(document).off("input.tscrec", "#recoveryCard #recoveryAmountsList input[type='number']");
                $(document).on("input.tscrec", "#recoveryCard #recoveryAmountsList input[type='number']", function () {
                    lockPolicyRecoveryEditors();
                    applyDownpaymentProvided();
                });
            }

            // ---------- Collateral amount -> downpayment ----------
            function wireCollateralRecalc() {
                $(document).off("input.tsccol", "#collateralList .colAmount");
                $(document).on("input.tsccol", "#collateralList .colAmount", function () {
                    applyDownpaymentProvided();
                });
            }

            // ---------- Scoring as checkbox list ----------
            function renderScoreCheckboxes() {
                var $sel = $("#ddlScoreAssessments");
                if (!$sel.length) return;

                // build container once
                var $box = $("#scoreCheckboxList");
                if (!$box.length) {
                    $box = $('<div id="scoreCheckboxList" class="border rounded p-2" style="max-height:260px; overflow:auto;"></div>');
                    $sel.after($box);
                    $sel.hide(); // keep select for compatibility, but UI uses checkboxes
                } else {
                    $box.empty();
                }

                // render each option as checkbox
                $sel.find("option").each(function (idx) {
                    var $o = $(this);
                    var val = $o.attr("value");
                    var text = $o.text();
                    if (!val) return;

                    var id = "sc_" + idx + "_" + (val || "").toString().replace(/[^a-z0-9]/gi, "_");
                    var checked = $o.is(":selected");

                    var $row = $('<div class="form-check small mb-1"></div>');
                    var $cb = $('<input class="form-check-input scoreChk" type="checkbox">').attr("id", id).attr("data-val", val);
                    if (checked) $cb.prop("checked", true);
                    var $lb = $('<label class="form-check-label"></label>').attr("for", id).text(text);

                    $row.append($cb).append($lb);
                    $box.append($row);
                });

                // wire checkbox -> select sync
                $(document).off("change.tscscore", "#scoreCheckboxList .scoreChk");
                $(document).on("change.tscscore", "#scoreCheckboxList .scoreChk", function () {
                    var val = $(this).attr("data-val");
                    var checked = $(this).is(":checked");
                    $sel.find("option[value='" + val.replace(/'/g, "\\'") + "']").prop("selected", checked);
                    $sel.trigger("change"); // triggers existing scoring calculator
                });
            }

            // ---------- boot ----------
            function boot() {
                // --------- Lists / lookups ---------
                // Do not assume routes are available; try best effort from DOM/global.
                try { ensureLoanUiRoutes(); } catch (e) { /* ignore */ }

                // Load scoring options early (async). Without this, the scoring UI stays empty.
                try { loadScoringAssessments(); } catch (e) { console.warn("loadScoringAssessments failed:", e); }

        // =========================================================
        // RELATIONSHIPS & COLLATERAL TYPES (load on button click)
        // - does NOT auto-load on guarantor type change
        // - keeps current selection if possible
        // =========================================================
        function getRelationshipsUrl() {
            try {
                if (window.routes && (routes.relationshipsUrl || routes.getRelationshipsUrl)) {
                    return routes.relationshipsUrl || routes.getRelationshipsUrl;
                }
            } catch (e) { }
            return "/LoanManagement/GetRelationships";
        }
        function getCollateralTypesUrl() {
            try {
                if (window.routes && (routes.collateralTypesUrl || routes.getCollateralTypesUrl)) {
                    return routes.collateralTypesUrl || routes.getCollateralTypesUrl;
                }
            } catch (e) { }
            return "/LoanManagement/GetCollateralTypes";
        }

        function loadRelationshipsInto($select, keepSelected) {
            if (!$select || !$select.length) return;
            var prev = keepSelected ? ($select.val() || "") : "";
            $select.prop("disabled", true);

            $.getJSON(getRelationshipsUrl())
                .done(function (res) {
                    var arr = (res && res.data) ? res.data : (Array.isArray(res) ? res : []);
                    $select.empty().append('<option value="">-- Select relationship --</option>');
                    (arr || []).forEach(function (x) {
                        var id = (x.Id || x.id || x.Value || x.value || "");
                        var name = (x.Name || x.name || x.Text || x.text || id);
                        if (!id) return;
                        $select.append('<option value="' + esc(id) + '">' + esc(name) + '</option>');
                    });
                    if (prev && $select.find('option[value="' + prev.replace(/"/g, '\\"') + '"]').length) {
                        $select.val(prev);
                    }
                })
                .fail(function (xhr) {
                    console.warn("GetRelationships failed", xhr && xhr.status, xhr && xhr.responseText);
                })
                .always(function () {
                    $select.prop("disabled", false);
                    try { $select.trigger("change.select2"); } catch (e) { }
                });
        }

        function loadCollateralTypesInto($select, keepSelected) {
            if (!$select || !$select.length) return;
            var prev = keepSelected ? ($select.val() || "") : "";
            $select.prop("disabled", true);

            $.getJSON(getCollateralTypesUrl())
                .done(function (res) {
                    var arr = (res && res.data) ? res.data : (Array.isArray(res) ? res : []);
                    $select.empty().append('<option value="">-- Select collateral type --</option>');
                    (arr || []).forEach(function (x) {
                        var id = (x.Id || x.id || x.Value || x.value || "");
                        var name = (x.Name || x.name || x.Text || x.text || id);
                        if (!id) return;
                        $select.append('<option value="' + esc(id) + '">' + esc(name) + '</option>');
                    });
                    if (prev && $select.find('option[value="' + prev.replace(/"/g, '\\"') + '"]').length) {
                        $select.val(prev);
                    }
                })
                .fail(function (xhr) {
                    console.warn("GetCollateralTypes failed", xhr && xhr.status, xhr && xhr.responseText);
                })
                .always(function () {
                    $select.prop("disabled", false);
                    try { $select.trigger("change.select2"); } catch (e) { }
                });
        }

        // Click: reload relationships in THIS guarantor card only
        $(document).on("click", ".btnLoadRelationships", function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $sel = $(this).closest(".input-group").find("select.ddlRelationship");
            loadRelationshipsInto($sel, true);
        });

        // Click: reload collateral types in THIS collateral card only
            $(document).on("click", ".btnLoadCollateralTypes", function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $sel = $(this).closest(".input-group").find("select.ddlCollateralType");
                loadCollateralTypesInto($sel, true);
            });

                // Bind scoring evaluation (select + checkbox mirror)
                $("#ddlScoreAssessments, #txtAmount").off("change input.tscScore").on("change input.tscScore", function () {
                    try { evaluateScore(); } catch (e) { console.warn("evaluateScore failed:", e); }
                });

                // --------- Risk / Recovery ---------
                wireGuarantorEvents();
                wireRecoveryRecalc();
                wireCollateralRecalc();

                // Render scoring checkboxes (mirrors #ddlScoreAssessments)
                // Re-render again after async options load.
                renderScoreCheckboxes();
                //setTimeout(renderScoreCheckboxes, 800);

                // keep DP in sync always
                lockPolicyRecoveryEditors();
                applyDownpaymentProvided();
            }

            $(boot);

        })(window, window.jQuery);


    </script>


    <script>
        (function () {

            // ---------------------------------------------
            // STATE (MUST be declared BEFORE any usage)
            // ---------------------------------------------
            // key = accountId, value = decimal|string("")
            var recoveryBlocks = {};

            // ✅ New Application button -> LoanManagement Index
            $("#btnNewApplication").off("click.newApp").on("click.newApp", function () {
                var url = $(this).data("url");
                if (url) window.location.href = url;
            });

            // ---------------------------------------------
            // Helpers
            // ---------------------------------------------
            function escapeHtml(s) {
                return (s || "").replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function getLoanAmount() {
                var v = parseFloat($("#txtAmount").val());
                return isNaN(v) ? 0 : v;
            }

            function inferAccountKindFromText(text) {
                var t = String(text || "").toLowerCase();
                // Adjust keywords to match your labels
                if (t.includes("ordinary shares") || t.includes("shares") || t.includes("shr-")) return "SHARES";
                if (t.includes("savings") || t.includes("sav-")) return "SAVINGS";
                return "OTHER";
            }

            // ---------------------------------------------
            // Totals
            // ---------------------------------------------
            function computeBlockedByKind() {
                var blocks = (window.tscRecovery && window.tscRecovery.getBlocks)
                    ? window.tscRecovery.getBlocks()
                    : [];

                var labelMap = {};
                $("#ddlRecoveryAccounts option").each(function () {
                    labelMap[this.value] = $(this).text() || "";
                });

                var sums = { SAVINGS: 0, SHARES: 0, OTHER: 0, TOTAL: 0 };

                for (var i = 0; i < blocks.length; i++) {
                    var b = blocks[i];
                    var amt = parseFloat(b.BlockAmount) || 0;
                    var label = labelMap[b.AccountId] || "";
                    var kind = inferAccountKindFromText(label);

                    sums[kind] += amt;
                    sums.TOTAL += amt;
                }
                return sums;
            }

            function updateBlockedTotals() {
                var total = 0;
                Object.keys(recoveryBlocks || {}).forEach(function (k) {
                    var v = parseFloat(recoveryBlocks[k]);
                    if (!isNaN(v) && v > 0) total += v;
                });
                $("#sumTotalBlocked").text(total.toLocaleString());
            }


            // Keep manager amount enabled/disabled based on decision (nice UX, safe)
            $(document).off("change.tscMgrDecision", "#managerRecoveryList .mgr-block-decision")
                .on("change.tscMgrDecision", "#managerRecoveryList .mgr-block-decision", function () {
                    var id = $(this).data("account-id");
                    var decision = String($(this).val() || "");
                    var $amt = $("#managerRecoveryList .mgr-block-amount[data-account-id='" + id + "']");
                    if (!$amt.length) return;

                    if (decision === "REJECT") {
                        $amt.val("").prop("disabled", true);
                    } else {
                        $amt.prop("disabled", false);
                        // if empty and we have proposed, prefill
                        if ($amt.val() === "" && recoveryBlocks[id] !== "" && recoveryBlocks[id] !== undefined) {
                            $amt.val(recoveryBlocks[id]);
                        }
                    }
                });

            // ---------------------------------------------
            // Validation
            // ---------------------------------------------
            function validateDownPaymentPolicy() {
                var policy = window.productPolicy || {};
                if (!policy.requireDownPayment) return true;

                var loanAmount = getLoanAmount();
                var rate = parseFloat(policy.downPaymentRatePercent) || 0;

                if (rate <= 0) {
                    appalert("Down payment policy is enabled but rate is not configured.", 2, 1);
                    return false;
                }

                var required = (loanAmount * rate) / 100.0;
                var actual = computeDownPaymentFromSelectedAccounts();

                if (actual < required) {
                    appalert(
                        "Down payment is insufficient.\n" +
                        "Required (" + rate + "%): " + required.toLocaleString() + " FCFA\n" +
                        "Provided: " + actual.toLocaleString() + " FCFA\n" +
                        "Tip: select more non-share accounts or increase blocking amounts.",
                        2, 1
                    );
                    return false;
                }

                return true;
            }

            // blocks: output from window.tscRecovery.getBlocks()
            // You must mark share accounts in option data:
            // <option ... data-is-share="1"></option>
            function computeDownPaymentFromSelectedAccounts() {

                var blocks = (window.tscRecovery && window.tscRecovery.getBlocks)
                    ? window.tscRecovery.getBlocks()
                    : [];

                // Build lookup for isShareAccount from select options
                var shareMap = {};
                $("#ddlRecoveryAccounts option").each(function () {
                    var id = this.value;
                    var isShare = String($(this).attr("data-is-share") || "").toLowerCase();
                    shareMap[id] = (isShare === "1" || isShare === "true" || isShare === "yes");
                });

                var sum = 0;
                for (var i = 0; i < blocks.length; i++) {
                    var b = blocks[i];
                    var isShareAcc = shareMap[b.AccountId] === true;
                    if (!isShareAcc) sum += (parseFloat(b.BlockAmount) || 0);
                }
                return sum;
            }

            function validateRiskMitigation() {
                var mode = String((window.wizardState && wizardState.restructureMode) || "NEW").toUpperCase();
                if (mode === "RESCHEDULE") return true;

                // Recovery policy validation (ONLY if policy dropdown exists + visible + enabled)
                if ($("#chkRecoveryMechanism").is(":checked")) {

                    var $policy = $("#ddlRecoveryPolicy");

                    // If policy control is present in the UI, validate it
                    if ($policy.length && $policy.is(":visible") && !$policy.is(":disabled")) {

                        var policyMode = $policy.val();

                        if (!policyMode) {
                            $policy.addClass("is-invalid");

                            var $fb = $policy.nextAll(".invalid-feedback").first();
                            if (!$fb.length) $fb = $('<div class="invalid-feedback"></div>').insertAfter($policy);
                            $fb.text("Please select a recovery policy.");

                            $("html, body").animate({ scrollTop: $policy.offset().top - 120 }, 250);
                            return false;
                        } else {
                            $policy.removeClass("is-invalid");
                        }

                        // PARTIAL_BLOCK validation only applies if dropdown exists and mode is selected
                        if (policyMode === "PARTIAL_BLOCK") {
                            var valid = true;

                            $(".recovery-block-amount").each(function () {
                                var $i = $(this);
                                var val = parseFloat($i.val());
                                var max = parseFloat($i.data("balance"));

                                if (isNaN(val) || val <= 0 || val > max) {
                                    $i.addClass("is-invalid");
                                    valid = false;
                                } else {
                                    $i.removeClass("is-invalid");
                                }
                            });

                            if (!valid) return false;
                        }
                    }
                    // If policy dropdown is NOT present/visible, skip policy validation completely.
                }

                // Down payment percentage validation
                if (!validateDownPaymentPolicy()) return false;

                // Keep your existing function call (if defined in your file)
                if (typeof validateSavingsAndSharesAreEnteredAndValid === "function") {
                    if (!validateSavingsAndSharesAreEnteredAndValid()) return false;
                }

                return true;
            }

            // ---------------------------------------------
            // Recovery selection + rendering
            // ---------------------------------------------
            function autoSizeMultiSelect($sel, minRows, maxRows) {
                var count = $sel.find('option').length || 0;
                var rows = Math.max(minRows || 6, Math.min(maxRows || 12, count));
                $sel.attr('size', rows);
            }

            function getSelectedAccounts($sel) {
                return $sel.find('option:selected').map(function () {
                    var $opt = $(this);

                    // 1️⃣ data-balance preferred
                    var balanceAttr = $opt.attr("data-balance");
                    var balance = parseFloat(balanceAttr);

                    // 2️⃣ Fallback: extract from label (EN+FR)
                    if (isNaN(balance)) {
                        var text = $opt.text();
                        var match = text.match(/(?:bal|balance|solde)\s*[:\-]?\s*([\d\s,\.]+)/i);
                        if (match && match[1]) {
                            balance = parseFloat(
                                match[1].replace(/\s/g, '').replace(/,/g, '')
                            );
                        }
                    }

                    return {
                        id: this.value,
                        text: $opt.text(),
                        balance: isNaN(balance) ? 0 : balance
                    };
                }).get();
            }

            function pruneRecoveryBlocks(selectedIds) {
                Object.keys(recoveryBlocks || {}).forEach(function (k) {
                    if (selectedIds.indexOf(k) === -1) delete recoveryBlocks[k];
                });
            }

            function validateBlockAmount($input) {
                var balance = parseFloat($input.data("balance"));
                if (isNaN(balance)) balance = 0;

                var raw = $input.val();

                // empty is allowed
                if (raw === "" || raw === null || raw === undefined) {
                    $input.removeClass("is-invalid");
                    return true;
                }

                var num = parseFloat(raw);
                if (isNaN(num) || num < 0) {
                    $input.addClass("is-invalid");
                    return false;
                }

                if (num > balance) {
                    $input.addClass("is-invalid");
                    $input.next(".invalid-feedback")
                        .text("Block amount cannot exceed available balance (" + balance + ").");
                    return false;
                }

                $input.removeClass("is-invalid");
                return true;
            }

            function validateAllRecoveryBlocks() {
                var ok = true;
                $(".recovery-block-amount").each(function () {
                    if (!validateBlockAmount($(this))) ok = false;
                });
                return ok;
            }

            function renderRecoveryAmounts(selected) {
                var $wrap = $("#recoveryAmountsWrap");

                var $list = $("#recoveryAmountsList");
                if (!$list.length) {
                    $wrap.html('<div id="recoveryAmountsList" class="d-grid gap-2"></div>');
                    $list = $("#recoveryAmountsList");
                }

                $list.empty();

                if (!selected || selected.length === 0) {
                    $wrap.hide();
                    return;
                }

                selected.forEach(function (a) {
                    var current = (recoveryBlocks[a.id] !== undefined) ? recoveryBlocks[a.id] : "";

                    var row = `
                                                                <div class="card border-0 bg-light">
                                                                    <div class="card-body py-2">
                                                                        <div class="row g-2 align-items-center">
                                                                            <div class="col-12 col-md-7">
                                                                                <div class="fw-semibold">${escapeHtml(a.text)}</div>
                                                                                <div class="small text-muted">
                                                                                    Available Balance: <span class="fw-bold">${Number(a.balance || 0).toLocaleString()}</span>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12 col-md-5">
                                                                                <label class="form-label mb-1 small">Amount to block</label>
                                                                                <input type="number"
                                                                                       class="form-control form-control-sm recovery-block-amount"
                                                                                       data-account-id="${escapeHtml(a.id)}"
                                                                                       data-balance="${a.balance}"
                                                                                       min="0"
                                                                                       max="${a.balance}"
                                                                                       step="0.01"
                                                                                       value="${current}"
                                                                                       placeholder="0.00">
                                                                                <div class="invalid-feedback">
                                                                                    Block amount cannot exceed available balance (${Number(a.balance || 0).toLocaleString()}).
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            `;
                    $list.append(row);
                });

                updateBlockedTotals();
                $wrap.show();
            }

            // ---------------------------------------------
            // Submit binding (SAFE + NO duplicate bindings)
            // ---------------------------------------------
            $(document).off("click.tscRisk", "#btnSubmitApplication")
                .on("click.tscRisk", "#btnSubmitApplication", function (e) {

                    var mode = String((window.wizardState && wizardState.restructureMode) || "NEW").toUpperCase();
                    if (mode === "RESCHEDULE") return true;

                    if (!$("#riskMitigationCard").is(":visible")) return true;

                    if (typeof validateRiskMitigation === "function" && !validateRiskMitigation()) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        return false;
                    }
                });

            $(document).off("click.tscRisk2", "#btnSubmitLoan")
                .on("click.tscRisk2", "#btnSubmitLoan", function (e) {
                    if (!validateRiskMitigation()) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        return false;
                    }
                });

            // ---------------------------------------------
            // Policy dropdown behavior (kept)
            // ---------------------------------------------
            $(document).off("change.tscPolicy", "#ddlRecoveryPolicy")
                .on("change.tscPolicy", "#ddlRecoveryPolicy", function () {
                    var mode = $(this).val();

                    $(".recovery-block-amount").each(function () {
                        var $input = $(this);
                        var balance = parseFloat($input.data("balance")) || 0;

                        if (mode === "FULL_BLOCK") {
                            $input.val(balance.toFixed(2));
                            $input.prop("disabled", true).removeClass("is-invalid");
                        }
                        else if (mode === "MONITOR_ONLY") {
                            $input.val("");
                            $input.prop("disabled", true).removeClass("is-invalid");
                        }
                        else {
                            $input.prop("disabled", false);
                        }
                    });
                });

            // Loan docs toggle (kept)
            $(document).off("change.tscDocs", "#chkLoanDocs")
                .on("change.tscDocs", "#chkLoanDocs", function () {
                    $("#loanDocsWrap").toggle($(this).is(":checked"));
                    if (!$(this).is(":checked")) {
                        $("#fileLoanDocs").val("");
                        $("#txtLoanDocsNote").val("");
                    }
                });

            // ---------------------------------------------
            // Binding for Recovery Container (FIXED + no double events)
            // ---------------------------------------------
            function bindRecoveryForContainer($container) {
                var $ddl = $container.find("#ddlRecoveryAccounts");
                if (!$ddl.length) return;

                $ddl.off("change.tscRecovery").on("change.tscRecovery", function () {
                    var selected = getSelectedAccounts($ddl);
                    var ids = selected.map(function (x) { return x.id; });
                    pruneRecoveryBlocks(ids);

                    renderRecoveryAmounts(selected);
                    updateBlockedTotals();
                });

                // amounts change -> keep model + refresh manager list + totals
                $container.off("input.tscRecovery blur.tscRecovery", ".recovery-block-amount")
                    .on("input.tscRecovery blur.tscRecovery", ".recovery-block-amount", function () {
                        var $inp = $(this);
                        if (!validateBlockAmount($inp)) return;

                        var id = $inp.data("account-id");
                        var val = $inp.val();

                        if (val === "" || val === null || val === undefined) {
                            recoveryBlocks[id] = "";
                        } else {
                            var num = parseFloat(val);
                            recoveryBlocks[id] = isNaN(num) ? "" : num;
                        }

                        var selected = getSelectedAccounts($ddl);
                        updateBlockedTotals();
                    });
            }

            // Bind for both possible sections (you mentioned duplicated IDs)
            bindRecoveryForContainer($("#panelApplication"));
            bindRecoveryForContainer($("#panelApplication .card"));

            // ---------------------------------------------
            // Public API (kept + hardened)
            // ---------------------------------------------
            var $ddlMain = $("#ddlRecoveryAccounts");

            window.tscRecovery = window.tscRecovery || {};
            window.tscRecovery.autoSize = function () { autoSizeMultiSelect($ddlMain, 6, 14); };
            window.tscRecovery.validateBlocks = function () { return validateAllRecoveryBlocks(); };

            window.tscRecovery.getBlocks = function () {
                return Object.keys(recoveryBlocks || {})
                    .filter(function (k) {
                        return recoveryBlocks[k] !== "" && recoveryBlocks[k] !== null && recoveryBlocks[k] !== undefined;
                    })
                    .map(function (k) { return { AccountId: k, BlockAmount: recoveryBlocks[k] }; });
            };

            window.tscRecovery.getManagerDecision = function () {
                var arr = [];

                $("#managerRecoveryList .mgr-block-decision").each(function () {
                    var id = $(this).data("account-id");
                    var decision = $(this).val();

                    var amount = $("#managerRecoveryList .mgr-block-amount[data-account-id='" + id + "']").val();
                    amount = parseFloat(amount);
                    if (isNaN(amount)) amount = 0;

                    arr.push({
                        AccountId: id,
                        ProposedAmount: parseFloat(recoveryBlocks[id]) || 0,
                        ManagerAmount: amount,
                        Decision: decision
                    });
                });

                return arr;
            };

            // Optional: expose totals if you want them elsewhere
            window.tscRecovery.getBlockedTotalsByKind = computeBlockedByKind;

        })();
    </script>

    <script>
        (function () {
            "use strict";

            // Guards
            if (!window.wizardState) return;

            // =========================
            // Utility
            // =========================
            function esc(s) {
                return (s || "").toString().replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]);
                });
            }

            // ✅ comma-safe number parsing (supports "350,000")
            function num(v) {
                if (v === null || v === undefined) return 0;
                var raw = (v + "").replace(/,/g, "").trim();
                var n = Number(raw || 0);
                return isNaN(n) ? 0 : n;
            }
            function toNum(v) { return num(v); }

            function money(v) { return num(v).toLocaleString() + " FCFA"; }
            function isTruthy(v) { return v !== null && v !== undefined && (v + "").trim() !== ""; }

            // ✅ helpers
            function normUpper(x) { return (x || "").toString().trim().toUpperCase(); }

            // Try to extract account number from label text
            function parseAccountNumberFromLabel(label) {
                var t = (label || "").toString().trim();
                if (!t) return "";

                var m =
                    t.match(/\b([A-Z]{2,6}-\d{1,12})\b/i) ||
                    t.match(/\(([A-Z]{2,6}-\d{1,12})\)/i);

                return (m && m[1]) ? m[1].toString().trim() : "";
            }

            // =========================
            // Validation UI helpers
            // =========================
            function ensureInvalidFeedback($el, msg) {
                var $fb = $el.nextAll(".invalid-feedback").first();
                if (!$fb.length) $fb = $('<div class="invalid-feedback"></div>').insertAfter($el);
                $fb.text(msg || "Invalid value.");
                return $fb;
            }

            // =========================
            // ✅ DEBUG / PAYLOAD LOGGING
            // =========================
            function prettyJson(obj) {
                try { return JSON.stringify(obj, null, 2); } catch (e) { return String(obj); }
            }
            function dumpToDebugBox(title, obj) {
                var $box = $("#dbgPayload");
                if (!$box.length) return;
                var text = "===== " + title + " =====\n" + prettyJson(obj) + "\n\n";
                $box.val(text + ($box.val() || ""));
            }
            function logGroup(title, fn) {
                try { console.groupCollapsed(title); fn && fn(); }
                finally { console.groupEnd(); }
            }

            // =========================
            // ✅ RECOVERY CLASSIFICATION (Savings / Shares / Others)
            // =========================
            function classifyRecoveryAccount(r, labelMap) {
                var accNo = normUpper(r.AccountNumber || r.Number || r.accountNumber || "");
                var accName = normUpper(r.AccountName || r.Name || "");
                var type = normUpper(r.AccountType || r.Type || r.AccountTypeName || "");
                var label = normUpper((r._Label || (labelMap && labelMap[r.AccountId]) || ""));

                var hay = [accNo, accName, type, label].join(" ");

                if (hay.includes("ORDINARY") && hay.includes("SHARE")) return "ORDINARY_SHARES";
                if (accNo.startsWith("SHR-")) return "ORDINARY_SHARES";

                if (hay.includes("PREFERENCE") && hay.includes("SHARE")) return "PREFERENCE_SHARES";
                if (accNo.startsWith("PSH-")) return "PREFERENCE_SHARES";

                if (hay.includes("DAILYSAVINGS") || accNo.startsWith("DSV-")) return "OTHERS";

                if (hay.includes("SAVING") || hay.includes("SAVINGS") || accNo.startsWith("SAV-")) return "SAVINGS";

                return "OTHERS";
            }

            // =========================
            // ✅ FIXED IDS
            // =========================
            var IDS = {
                ChargesJson: "#hidSelectedChargesJson",
                RecoveryJson: "#hidRecoverySelectionJson",
                GuarantorsJson: "#hidGuarantorsJson",
                CollateralsJson: "#hidCollateralJson",
                DocumentsJson: "#hidDocumentsMetaJson"
            };

            // =========================
            // Safe helpers
            // =========================
            function safeJsonParse(str, fallback) { try { return str ? JSON.parse(str) : fallback; } catch (e) { return fallback; } }
            function safeVal(sel) { return (($(sel).val() || "") + "").trim(); }
            function safeText(sel) { return (($(sel).find(":selected").text() || "") + "").trim(); }
            function asList(x) { return Array.isArray(x) ? x : (x ? [x] : []); }

            // =========================
            // ✅ IMPORTANT: use STEP-3 builders if available
            // These are the functions your attached Step 3 script uses to create the hidden JSON.
            // If they exist -> call them. Otherwise fallback to legacy extraction.
            // =========================
            function callIfFn(fnName) {
                try {
                    var fn = window[fnName];
                    if (typeof fn === "function") fn();
                } catch (e) { }
            }

            // =========================
            // ✅ SYNC RECOVERY: UI -> Hidden JSON
            // PERFECT SOURCE: Step3 builder -> #hidRecoverySelectionJson
            // =========================
            function syncRecoveryHiddenFromUI() {
                // ✅ Step3 official builder (best)
                callIfFn("buildRecoverySubmissionJson");

                // If Step3 builder filled it, stop.
                if ($(IDS.RecoveryJson).length && safeVal(IDS.RecoveryJson)) return;

                // ✅ Legacy state-based fallback (your existing tscRecovery)
                if (window.tscRecovery && typeof window.tscRecovery.getBlocks === "function") {
                    // Build label map from select
                    var labelMap = {};
                    $("#ddlRecoveryAccounts option").each(function () {
                        labelMap[this.value] = (this.text || "").toString().trim();
                    });

                    var blocks = window.tscRecovery.getBlocks() || [];
                    var normalized = blocks.map(function (b) {
                        var accountId = String(b.AccountId || b.accountId || b.Id || b.id || "");

                        var label = (b.Label || b.label || b.AccountLabel || b.accountLabel || "").toString().trim();
                        if (!label && accountId && labelMap[accountId]) label = labelMap[accountId];

                        var accNo = (b.AccountNumber || b.accountNumber || "").toString().trim();
                        if (!accNo && label) accNo = parseAccountNumberFromLabel(label);

                        var accName = (b.AccountName || b.accountName || "").toString().trim();
                        if (!accName && label) accName = label;

                        return {
                            AccountId: accountId,
                            AccountNumber: accNo,
                            AccountType: (b.AccountType || b.accountType || "").toString(),
                            AccountName: accName,
                            Decision: (b.Decision || b.BlockedStatus || "Blocked").toString(),
                            BlockAmount: num(b.BlockAmount || b.Amount || 0),
                            _Label: label
                        };
                    }).filter(function (x) { return x.AccountId; });

                    if (normalized.length) {
                        $(IDS.RecoveryJson).val(JSON.stringify(normalized));
                        return;
                    }
                }

                // ✅ DOM fallback (CRITICAL): read directly from the “Selected Recovery Accounts” cards
                if (!$(IDS.RecoveryJson).length) return;

                // build lookup from ddlRecoveryAccounts option text -> id
                var optionRows = [];
                $("#ddlRecoveryAccounts option").each(function () {
                    optionRows.push({ id: this.value, text: (this.text || "").toString() });
                });

                function findAccountIdByAccountNo(accNo) {
                    accNo = (accNo || "").toUpperCase().trim();
                    if (!accNo) return "";
                    for (var i = 0; i < optionRows.length; i++) {
                        if ((optionRows[i].text || "").toUpperCase().indexOf(accNo) >= 0) return optionRows[i].id;
                    }
                    return "";
                }

                var domBlocks = [];

                // we key off your own class you already use: .recovery-block-amount
                $(".recovery-block-amount:visible").each(function () {
                    var $amt = $(this);
                    var $card = $amt.closest(".card, .border, .shadow-sm, .shadow, .tsc-card, .tsc-card-soft").first();

                    // try locate label text in the card
                    var labelText =
                        ($card.find(".fw-semibold,.fw-bold,.card-title,.title").first().text() || "").trim() ||
                        ($card.text() || "").trim();

                    var accountNo = parseAccountNumberFromLabel(labelText);
                    var accountId =
                        ($card.attr("data-account-id") || $card.data("accountId") || $card.data("account-id") || "").toString().trim();

                    if (!accountId && accountNo) accountId = findAccountIdByAccountNo(accountNo);

                    // decision select inside same card
                    var decision =
                        ($card.find("select:visible").filter(function () {
                            // choose the select that contains Blocked/Required etc
                            var t = ($(this).text() || "").toUpperCase();
                            return t.indexOf("BLOCK") >= 0 || t.indexOf("REQUIRED") >= 0;
                        }).first().val() || "Blocked");

                    domBlocks.push({
                        AccountId: accountId,
                        AccountNumber: accountNo,
                        AccountName: labelText,
                        Decision: decision,
                        BlockAmount: num($amt.val() || 0),
                        _Label: labelText
                    });
                });

                domBlocks = domBlocks.filter(function (x) { return !!x.AccountId; });

                if (domBlocks.length) {
                    $(IDS.RecoveryJson).val(JSON.stringify(domBlocks));
                }
            }

            // =========================
            // ✅ SYNC CHARGES: UI -> Hidden JSON
            // PERFECT SOURCE: Step3 builder -> #hidSelectedChargesJson
            // =========================
            function syncChargesHiddenFromUI() {
                callIfFn("buildChargesSubmissionJson");
            }

            // =========================
            // ✅ SYNC GUARANTORS: UI -> Hidden JSON
            // PERFECT SOURCE: Step3 builder -> #hidGuarantorsJson
            // =========================
            function boolVal(v) {
                return (v === true || v === "true" || v === 1 || v === "1");
            }

            function syncGuarantorsHiddenFromUI() {
                // Step3 official builder first
                callIfFn("buildGuarantorsSubmissionJson");
                if ($(IDS.GuarantorsJson).length && safeVal(IDS.GuarantorsJson)) return;

                if (!$(IDS.GuarantorsJson).length) return;

                // ✅ find the dynamic guarantor container (support multiple ids/classes)
                var $wrap =
                    $("#guarantorList, #guarantorsList, #guarantorEntries, #guarantorContainer, .guarantor-list, .tsc-guarantor-list").first();

                if (!$wrap.length) $wrap = $(document);

                // ✅ find each guarantor “card”
                var $cards = $wrap.find("[data-gid], [data-guarantor-id], .guarantor-card, .tsc-guarantor-card, .guarantor-entry").filter(":visible");
                if (!$cards.length) $cards = $wrap.find("fieldset, .card, .border").filter(function () {
                    // heuristic: contains a guarantor type select / member ref input
                    var t = ($(this).text() || "").toUpperCase();
                    return t.indexOf("GUARANTOR") >= 0 && (t.indexOf("REFERENCE") >= 0 || t.indexOf("ID CARD") >= 0);
                });

                var list = [];

                $cards.each(function () {
                    var $c = $(this);

                    function v(sel) { return ($c.find(sel).first().val() || "").toString().trim(); }
                    function t(sel) { return ($c.find(sel).first().text() || "").toString().trim(); }

                    var type =
                        normUpper(
                            v(".ddlGuarantorType") ||
                            v("[name*='GuarantorType']") ||
                            $c.data("type") ||
                            ""
                        );

                    var guaranteeAmount =
                        num(
                            v(".txtGuaranteeAmount") ||
                            v("[name*='GuaranteeAmount']") ||
                            v(".txtAmount") ||
                            v(".guarantee-amount") ||
                            0
                        );

                    var memberName =
                        v(".txtMemberName,.txtName,.txtNameCompany") ||
                        v("[name*='MemerberName']") ||
                        v("[name*='MemberName']") ||
                        "";

                    var memberRef =
                        v(".txtMemberRef,.txtMemberReference") ||
                        v("[name*='MemerberReference']") ||
                        v("[name*='MemberReference']") ||
                        "";

                    // account to block
                    var accountId =
                        v(".ddlAccount") ||
                        v("[name*='AccountId']") ||
                        "";

                    var accountNumber =
                        (t(".ddlAccount option:selected") || v(".txtAccountNumber") || "").toString().trim();

                    var blockAmount =
                        num(
                            v(".txtBlockAmount,.recovery-block-amount") ||
                            v("[name*='BlockAmount']") ||
                            v("[name*='Amount']") ||
                            0
                        );

                    var blockAccount =
                        boolVal(
                            v(".ddlBlockFlag") ||
                            v("[name*='BlockAccount']") ||
                            v("[name*='Blockccount']") ||
                            ""
                        );

                    // ✅ capture “Release Order Required” (your highlighted section)
                    var releaseOrder =
                        v(".ddlReleaseOrder") ||
                        v("[name*='ReleaseOrder']") ||
                        v("[name*='ReleaseOrderRequired']") ||
                        "";

                    list.push({
                        GuarantorType: type,

