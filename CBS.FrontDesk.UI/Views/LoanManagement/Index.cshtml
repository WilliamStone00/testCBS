                        '<div class="card-body py-2">' +
                        sectionTitle("mdi mdi-calendar-sync", "New Reschedule Terms") +
                        divider() +
                        dlRow("Remaining Capital Balance", '<span class="fw-bold text-success">' + moneyWithCurrency(remaining, "FCFA") + '</span>') +
                        dlRow("New Repayments", '<span class="fw-semibold">' + esc(newN) + '</span>') +
                        dlRow("Repayment Circle", '<span class="fw-semibold">' + esc(circle) + '</span>') +
                        dlRow("Repayment Type", '<span class="fw-semibold">' + esc(repType) + '</span>') +
