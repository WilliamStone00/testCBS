                    var newPeriodMonths = pick(cmd, ["NewRepaymentPeriodMonths", "newRepaymentPeriodMonths", "NewRepaymentPeriod", "newRepaymentPeriod"], repaymentPeriod);
                    var newGraceMonths = Number(pick(cmd, ["NewGracePeriodMonths", "newGracePeriodMonths", "GracePeriodMonths", "gracePeriodMonths", "GracePeriodDays", "gracePeriodDays"], graceMonths)) || 0;

                    // also show capital/reschedule amount if your command contains it (optional)
                    var reschedCapital = Number(pick(cmd, ["RescheduleAmount", "rescheduleAmount", "RemainingCapital", "remainingCapital", "Capital", "capital"], 0)) || 0;

                    var note = pick(cmd, ["Note", "note"], "");

                    var title = mode + " CONFIRMATION"; // ✅ e.g., "RESCHEDULE CONFIRMATION"

                    return (
                        '<div style="font-size:13px;line-height:1.35;text-align:left;">' +
                        '<div style="font-weight:800;margin-bottom:8px;text-transform:uppercase;">' + esc(title) + '</div>' +

                        '<div style="font-weight:700;margin-bottom:8px;">Confirm Loan Reschedule</div>' +

