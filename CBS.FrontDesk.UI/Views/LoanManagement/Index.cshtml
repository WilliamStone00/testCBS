                return sums;
            }
            function inferAccountKindFromText(text) {
                var t = String(text || "").toLowerCase();
                // You can adjust keywords to match your labels
                if (t.includes("ordinary shares") || t.includes("shares") || t.includes("shr-")) return "SHARES";
                if (t.includes("savings") || t.includes("sav-")) return "SAVINGS";
                return "OTHER";
            }

            function getSelectedScorePoints() {
                var total = 0;

                // 1) Preferred: checkbox UI
                var $checks = $("#scoreAssessmentsList .chkScoreItem:checked");
                if ($checks.length) {
                    $checks.each(function () {
                        var $c = $(this);

                        var pts = Number($c.attr("data-points") || $c.data("points") || 0);
                        var minPts = Number($c.attr("data-minpoints") || $c.data("minpoints") || 0);
                        var weight = Number($c.attr("data-weight") || $c.data("weight") || 1);
                        var isPenalty = String($c.attr("data-penalty") || $c.data("penalty") || "0") === "1";

                        var val = isPenalty ? (minPts || 0) : (pts || 0);
                        if (!isFinite(val)) val = 0;
                        if (!isFinite(weight) || weight <= 0) weight = 1;

                        total += (val * weight);
                    });

                    return Math.round(total);
                }

                // 2) Fallback: hidden select
                $("#ddlScoreAssessments option:selected").each(function () {
                    var $o = $(this);

                    var pts2 = Number($o.attr("data-points") || 0);
                    var minPts2 = Number($o.attr("data-minpoints") || 0);
                    var weight2 = Number($o.attr("data-weight") || 1);
                    var isPenalty2 = String($o.attr("data-penalty") || "0") === "1";

                    var val2 = isPenalty2 ? (minPts2 || 0) : (pts2 || 0);
                    if (!isFinite(val2)) val2 = 0;
                    if (!isFinite(weight2) || weight2 <= 0) weight2 = 1;

                    total += (val2 * weight2);
