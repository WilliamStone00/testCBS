                            '<div class="tsc-divider my-2"></div>' +

                            '<div class="d-flex justify-content-between"><span class="text-muted">Original Amount</span><span class="fw-bold text-dark">' + moneyWithCurrency(oldAmount, oldCurrency) + '</span></div>' +
                            '<div class="d-flex justify-content-between"><span class="text-muted">Current Balance (Remaining Capital)</span><span class="fw-bold text-dark">' + moneyWithCurrency(oldBalance, oldCurrency) + '</span></div>' +

                            '<div class="tsc-divider my-2"></div>' +

                            '<div class="d-flex justify-content-between"><span class="text-muted">Accrual Interest</span><span class="fw-semibold text-dark">' + moneyWithCurrency(oldAccrualInterest, oldCurrency) + '</span></div>' +
                            '<div class="d-flex justify-content-between"><span class="text-muted">VAT</span><span class="fw-semibold text-dark">' + moneyWithCurrency(oldVat, oldCurrency) + '</span></div>' +
                            '<div class="d-flex justify-content-between"><span class="text-muted">Penalty</span><span class="fw-semibold text-dark">' + moneyWithCurrency(oldPenalty, oldCurrency) + '</span></div>' +

                            '<div class="tsc-divider my-2"></div>' +

                            '<div class="d-flex justify-content-between"><span class="text-muted">Delinquent Interest</span><span class="fw-semibold text-dark">' + moneyWithCurrency(oldDelInterest, oldCurrency) + '</span></div>' +
                            '<div class="d-flex justify-content-between"><span class="text-muted">Delinquent Amount</span><span class="fw-semibold text-dark">' + moneyWithCurrency(oldDelAmount, oldCurrency) + '</span></div>' +
                            '<div class="d-flex justify-content-between"><span class="text-muted">Delinquent Days</span><span class="fw-semibold text-dark">' + esc(oldDelDays) + '</span></div>' +

                            '<div class="tsc-divider my-2"></div>' +

                            '<div class="d-flex justify-content-between"><span class="text-muted">Total Due</span><span class="fw-bold text-danger">' + moneyWithCurrency(oldTotalDue, oldCurrency) + '</span></div>' +
                            '</div>' +
                            '</div>'
                        )
