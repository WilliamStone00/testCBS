                }).join("");

                $("#repaymentPeriodsPills").html(pills || `<span class="text-muted small">No repayment periods configured.</span>`);

                // Dropdown (if exists)
                if ($("#ddlRepaymentPeriod").length) {
                    $("#ddlRepaymentPeriod").html(`<option value="">-- Select Repayment Period --</option>`);
                    (periods || []).forEach(function (m) {
                        $("#ddlRepaymentPeriod").append(`<option value="${Number(m)}">${Number(m)} Months</option>`);
                    });
                }
            }

