@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<div class="form-wrapper">
    <!-- Member Details & Mobile Money Source Selection -->
    <div class="change-group">
        <div class="row mb-2 align-items-center">
            <!-- Member's Name Section -->
            <div class="col-md-6">
                <div class="form-floating">
                    <span class="formatted-amount shadow-sm d-block py-3 px-4 bg-light rounded border border-secondary">
                        @GlobalMobileMoneyBackOffice.MembersName: <strong>@Model.Customer.name</strong>
                    </span>
                </div>
            </div>

            <!-- Mobile Money Source Selection -->
            <div class="col-md-6">
                <div class="row">
                    <!-- Mobile Money MTN -->
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.AddNoneCashMobileMoneyCommand.SourceType, "MobileMoneyMTN",
                                new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyMTN" })
                            <label class="form-check-label shadow-input-boxes" for="MobileMoneyMTN"
                                   style="background-color: yellow; color: black;">
                                @GlobalMobileMoneyBackOffice.MobileMoneyMTN
                            </label>
                        </div>
                    </div>
                    <!-- Mobile Money Orange -->
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.AddNoneCashMobileMoneyCommand.SourceType, "MobileMoneyORANGE",
                                new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyORANGE" })
                            <label class="form-check-label shadow-input-boxes" for="MobileMoneyORANGE"
                                   style="background-color: orange; color: white;">
                                @GlobalMobileMoneyBackOffice.MobileMoneyOrange
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Mobile Money Source Selection -->
    <fieldset class="fieldset-custom">
        <div class="change-group">
            <div class="row mt-2 gy-4">
                <!-- Member Reference -->
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddNoneCashMobileMoneyCommand.MemberReference,
                            new { @class = "form-control shadow-input-boxes", @id = "customerId" })
                        @Html.ValidationMessageFor(m => m.AddNoneCashMobileMoneyCommand.MemberReference, "",
                            new { @class = "text-danger " })
                        <label>@GlobalMobileMoneyBackOffice.MMOMNoneMemberReference</label>
                    </div>
                </div>

                <!-- Representative Name -->
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddNoneCashMobileMoneyCommand.CustomerName,
                            new { @class = "form-control shadow-input-boxes", @id = "MemberName" })
                        @Html.ValidationMessageFor(m => m.AddNoneCashMobileMoneyCommand.CustomerName, "",
                            new { @class = "text-danger " })
                        <label>@GlobalMobileMoneyBackOffice.RepresentativeName</label>
                    </div>
                </div>

                <!-- Telephone Number -->
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddNoneCashMobileMoneyCommand.TelephoneNumber,
                            new { @class = "form-control shadow-input-boxes", @id = "TelephoneNumber" })
                        @Html.ValidationMessageFor(m => m.AddNoneCashMobileMoneyCommand.TelephoneNumber, "",
                            new { @class = "text-danger " })
                        <label>@GlobalMobileMoneyBackOffice.PhoneNumber</label>
                    </div>
                </div>

                <!-- Teller Code -->
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddNoneCashMobileMoneyCommand.TellerCode,
                            new { @class = "form-control shadow-input-boxes", @id = "TellerCode" })
                        @Html.ValidationMessageFor(m => m.AddNoneCashMobileMoneyCommand.TellerCode, "",
                            new { @class = "text-danger " })
                        <label>@GlobalMobileMoneyBackOffice.TillCode</label>
                    </div>
                </div>

                <!-- Note Section -->
                <div class="col-md-12 mt-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.AddNoneCashMobileMoneyCommand.Note,
                            new { @class = "form-control shadow-input-boxes", @id = "Note", rows = "3", placeholder = @GlobalMobileMoneyBackOffice.EnterReasonForTransaction, style = "height: 70px;" })
                        @Html.ValidationMessageFor(m => m.AddNoneCashMobileMoneyCommand.Note, "", new { @class = "text-danger " })
                        <label for="Note">@GlobalMobileMoneyBackOffice.TransactionNoteReason</label>
                    </div>
                </div>
                <!-- Bulk Deposit Table -->
                <div class="table-responsive mt-2 mb-1">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <tr>
                                <th style="display:none;">ProductID</th>
                                <th>@GlobalMobileMoneyBackOffice.Accounts</th>
                                <th>@GlobalMobileMoneyBackOffice.Balance</th>
                                <th>@GlobalMobileMoneyBackOffice.Amount</th>
                                <th style="display:block">@GlobalMobileMoneyBackOffice.Fee</th>
                                <th>@GlobalMobileMoneyBackOffice.Total</th>
                                <th>@GlobalMobileMoneyBackOffice.Confirm</th>
                                <th style="display:none">@GlobalMobileMoneyBackOffice.Inc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.BulkDeposits.Where(x => !x.AccountType.ToLower().Contains("loan")).OrderBy(t => t.AccountType))
                            {
                                <tr>
                                    <td style="display:none;">@d.AccountNumber</td>
                                    <td>@d.AccountType</td>
                                    <td>@d.Balance.ToString("#,##0.0")</td>
                                    <td>
                                        <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.Amount">
                                    </td>
                                    <td style="display:block">
                                        <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee">
                                    </td>
                                    <td>
                                        <span class="total-span">@d.Total</span>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input">
                                    </td>
                                    <td style="display:none">
                                        <input type="checkbox" class="form-check-input check-inclussive" disabled>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" style="text-align: right;"><strong>@GlobalMobileMoneyBackOffice.Total:</strong></td>
                                <td id="tableTotal">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="MobileMoneyNoneCashIn" id="OperationType" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostMobileMoney()">
                    <i class="fas fa-save me-1"></i> @GlobalMobileMoneyBackOffice.Post
                </button>
                @*<button type="button" id="reprint" class="btn btn-secondary me-2" onclick="Reprint()">
                        <i class="fas fa-print me-1"></i> Re-print
                    </button>*@
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
        <hr style="border: 2px solid green;" />
    </fieldset>
</div>





