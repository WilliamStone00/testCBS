
@{
    ViewBag.Title = "DAILY COLLECTION DASHBOARD";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@using Resources
@section Styles {
    <link href="~/CBSTemp/ui/assets/css/DailyCollectionDashBoard.css" rel="stylesheet" />

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/Scripts/Js/Dashboard/DailyCollection/DailyCollectionDashboard.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            fetch('@Url.Action("ChartData", "Branch")')
                .then(response => response.json())
                .then(data => {
                    const branchCtx = document.getElementById('branchChart').getContext('2d');

                    new Chart(branchCtx, {
                        type: 'doughnut',
                        data: data,
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                }
                            }
                        }
                    });
                });
        });
    </script>
}
@model CBS.FrontDesk.Data.Entity.DailyCollectorManagement.DailyCollectionConfiguration

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyCollectionDashboard.DAILY_COLLECTION_DASHBOARD</span>
                </h1>

                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalDailyCollectionDashboard.This_interface_enable_back_office_operator_to_pay_each_daily_collector
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyCollectionDashboard.TIPS_for_daily_collection_payment</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.DateRange:</strong> @GlobalShared.Select_Payment_period .</li>
                <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong>  @GlobalDailyCollectionDashboard.Select_branch_if_you_are_connected_as_head_office</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-success me-2"></i> <strong>@GlobalShared.Daily_collector:</strong>@GlobalDailyCollectionDashboard.Select_the_daily_collector_head_office</li>


            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="filter-bar">


            <div class="filters">
                <div class="filter-row">

                    @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                    {
                        <div class="filter-group">
                            <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                            @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                            {
                                @class = "form-control date",
                                type = "month",
                                id = "month",
                                name = "month"
                            })
                            @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="branch">🏢 @GlobalShared.Select_Branch</label>
                            @Html.DropDownListFor(m => m.DashboardActivities.BranchId, new SelectList(ViewBag.Branches == null ? "" : ViewBag.Branches, "Value", "Text"), "--- Select Branch", new { @class = "form-control select2", @search = "true" })

                        </div>
                        <div class="filter-group">
                            <label for="collector">👤 @GlobalDailyCollectionDashboard.Select_Daily_Collector</label>

                            @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                        </div>
                    }
                    else
                    {
                        <div class="filter-group">
                            <label for="month">📅 @GlobalShared.Select_Month & @GlobalShared.Year</label>
                            @Html.TextBoxFor(m => m.DashboardActivities.Month, new
                            {
                                @class = "form-control date",
                                type = "month",
                                id = "month",
                                name = "month"
                            })
                            @Html.ValidationMessageFor(m => m.DashboardActivities.Month, "", new { @class = "text-danger" })
                        </div>
                        <div class="filter-group">
                            <label for="collector">👤 @GlobalDailyCollectionDashboard.Select_Daily_Collector</label>

                            @Html.DropDownListFor(m => m.DashboardActivities.CollectorId, new SelectList(ViewBag.DailyCollectors == null ? "" : ViewBag.DailyCollectors, "Value", "Text"), "--- Select Daily Collectors", new { @class = "form-control select2", @search = "true" })
                        </div>
                    }

                </div>
                <div class="filter-row">
                    <div class="row mt-2">
                        <div class="col-md-4 d-flex justify-content-end">
                            @*     <button id="applyFilterBtn" class="btn btn-primary me-2 w-100" onclick="loadData()"><i class="mdi mdi-magnify"></i> 🔍 Load Data</button>*@
                            <button id="submitBtn" type="submit" class="load-btn btn-primary" onclick="loadDashboard()">🔍 @GlobalShared.Load_Data</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="row">

</div>
