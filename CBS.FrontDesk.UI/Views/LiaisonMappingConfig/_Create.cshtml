@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMappingV2.LiaisonMapping

<fieldset class="fieldset-custom">
    <legend>Liaison Mapping Configuration</legend>

    @using (Html.BeginForm("Create", "LiaisonMappingConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.Id)

        <div class="row gy-3">
            <!-- Branch -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches, "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2", @id = "BranchId", @onchange = "LoadBranchAccounts(this.value)" }
                    )
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label for="BranchId">Branch</label>
                </div>
            </div>

            <!-- Counterparty Branch -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(
                        m => m.CounterpartyBranchId,
                        new SelectList(ViewBag.Branches, "Id", "Name"),
                        "--- Select Counterparty Branch ---",
                        new { @class = "form-control select2", id = "CounterpartyBranchId" }
                    )
                    @Html.ValidationMessageFor(m => m.CounterpartyBranchId, "", new { @class = "text-danger" })
                    <label for="CounterpartyBranchId">Counterparty Branch</label>
                </div>
            </div>

            <!-- Due From Asset Account -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(
                        m => m.DueFromAssetAccountId,
                        new SelectList(ViewBag.Accounts, "Value", "Text"),
                        "--- Select Due From Account ---",
                        new { @class = "form-control select2", id = "DueFromAssetAccountId" }
                    )
                    @Html.ValidationMessageFor(m => m.DueFromAssetAccountId, "", new { @class = "text-danger" })
                    <label for="DueFromAssetAccountId">Due From Asset Account</label>
                </div>
            </div>

            <!-- Due To Liability Account -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(
                        m => m.DueToLiabilityAccountId,
                        new SelectList(ViewBag.Accounts, "Value", "Text"),
                        "--- Select Due To Account ---",
                        new { @class = "form-control select2", id = "DueToLiabilityAccountId" }
                    )
                    @Html.ValidationMessageFor(m => m.DueToLiabilityAccountId, "", new { @class = "text-danger" })
                    <label for="DueToLiabilityAccountId">Due To Liability Account</label>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 d-flex justify-content-end gap-2">
            @if (ViewBag.Key != null)
            {
                <button type="submit" class="btn btn-primary">Update</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary">Save Mapping</button>
                <button type="reset" class="btn btn-outline-secondary">Reset</button>
            }
        </div>
    }
</fieldset>


<script>
    // Charger les comptes en fonction de la branche sélectionnée
    function LoadBranchAccounts(branchId) {
        if (!branchId) {
            ResetAccountDropdowns();
            return;
        }

        $('#DueFromAssetAccountId, #DueToLiabilityAccountId')
            .empty()
            .append('<option value="">Loading...</option>')
            .prop('disabled', true);

        $.ajax({
            url: '@Url.Action("Ajaxloader", "LiaisonMappingConfig")',
            type: 'GET',
            data: { Key: branchId },
            success: function (data) {
                ResetAccountDropdowns();

                if (data && data.length > 0) {
                    $.each(data, function (i, item) {
                        $('#DueFromAssetAccountId').append($('<option>', { value: item.Value, text: item.Text }));
                        $('#DueToLiabilityAccountId').append($('<option>', { value: item.Value, text: item.Text }));
                    });
                } else {
                    $('#DueFromAssetAccountId').append('<option value="">No accounts found</option>');
                    $('#DueToLiabilityAccountId').append('<option value="">No accounts found</option>');
                }

                $('#DueFromAssetAccountId, #DueToLiabilityAccountId').prop('disabled', false);

                if ($('.select2').length) {
                    $('#DueFromAssetAccountId').trigger('change.select2');
                    $('#DueToLiabilityAccountId').trigger('change.select2');
                }
            },
            error: function () {
                alert('Error loading branch accounts.');
                ResetAccountDropdowns();
            }
        });
    }

    function ResetAccountDropdowns() {
        $('#DueFromAssetAccountId').empty().append('<option value="">--- Select Due From Account ---</option>');
        $('#DueToLiabilityAccountId').empty().append('<option value="">--- Select Due To Account ---</option>');
    }

</script>

