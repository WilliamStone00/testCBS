@model CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMappingV2.LiaisonMapping
    @using Resources
<!-- Header -->
<div class="row mb-2">
    <div class="col-12">
        <div class="card bg-light">
            <div class="card-body text-center py-2">
                <h5 class="card-title text-primary mb-1">
                    <i class="mdi mdi-bank-outline me-2"></i> @GlobalLiaisonMappingConfig.Liaison_Mapping_Configuration
                </h5>
                <p class="small mb-0">
                    @GlobalLiaisonMappingConfig.Create_or_edit_a_liaison_mapping_between_branches_and_GL_accounts
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span class="small"><i class="mdi mdi-help-circle-outline me-2"></i> @GlobalLiaisonMappingConfig.Tips_for_Liaison_Mapping</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLiaisonTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLiaisonTips" class="collapse">
        <div class="card-body py-2">
            <ul class="mb-0 small">
                <li><strong>@GlobalShared.Branch:</strong> @GlobalLiaisonMappingConfig.Select_the_main_branch_for_the_mapping</li>
                <li><strong>@GlobalShared.Counterparty_Branch:</strong> @GlobalLiaisonMappingConfig.Select_the_branch_to_map_against</li>
                <li><strong>@GlobalShared.Accounts:</strong> @GlobalLiaisonMappingConfig.Assign_correct_asset_and_liability_accounts</li>
                <li><strong>@GlobalShared.Status:</strong> @GlobalLiaisonMappingConfig.Only_authorized_users_can_modify_mappings</li>
            </ul>
        </div>
    </div>
</div>

<!-- Form -->
<fieldset class="fieldset-custom">

    @using (Html.BeginForm("Create", "LiaisonMappingConfig", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.Id)

    <div class="row gy-3">
        <!-- Branch -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.BranchId, ""+ GlobalShared.Select_source_branch + "", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(
                m => m.BranchId,
                new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Branch ---",
                new { @class = "form-control select2", @id = "BranchId", @onchange = "LoadBranchAccounts(this.value)" }
            )
            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
        </div>

        <!-- Counterparty Branch -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.CounterpartyBranchId, ""+ GlobalShared.Select_Counterparty_Branch + "", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(
                m => m.CounterpartyBranchId,
                new SelectList(ViewBag.CounterpartyBranches, "Id", "Name"),
                "--- Select Counterparty Branch ---",
                new { @class = "form-control select2", @id = "CounterpartyBranchId" }
            )
            @Html.ValidationMessageFor(m => m.CounterpartyBranchId, "", new { @class = "text-danger" })
        </div>

        <!-- GL Account (ancien Due From Asset Account) -->
        <div class="col-12">
            @Html.LabelFor(m => m.DueFromAssetAccountId, ""+ GlobalShared.Select_destination_branch_liason + "", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(
                m => m.DueFromAssetAccountId,
                new SelectList(ViewBag.Accounts, "Value", "Text", Model.DueFromAssetAccountId),
                "--- Select destination branch liason ---",
                new { @class = "form-control select2", @id = "DueFromAssetAccountId" }
            )
            @Html.ValidationMessageFor(m => m.DueFromAssetAccountId, "", new { @class = "text-danger" })
        </div>

    </div>

        <!-- Action Buttons -->
        <div class="mt-4 d-flex justify-content-end gap-2">
            @if (ViewBag.Key != null)
            {
                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">@GlobalShared.Update</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">@GlobalShared.Save_Mapping</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            }
        </div>
    }
</fieldset>


<script>
        // Charger les comptes en fonction de la branche sélectionnée
        function LoadBranchAccounts(branchId) {
            if (!branchId) {
                ResetAccountDropdowns();
                return;
            }

            $('#DueFromAssetAccountId, #DueToLiabilityAccountId')
                .empty()
                .append('<option value="">Loading...</option>')
                .prop('disabled', true);

            $.ajax({
                url: '@Url.Action("Ajaxloader", "LiaisonMappingConfig")',
                type: 'GET',
                data: { Key: branchId },
                success: function (data) {
                    ResetAccountDropdowns();

                    if (data && data.length > 0) { 
                        $.each(data, function (i, item) {
                            $('#DueFromAssetAccountId').append($('<option>', { value: item.Value, text: item.Text }));
                            $('#DueToLiabilityAccountId').append($('<option>', { value: item.Value, text: item.Text }));
                        });
                    } else {
                        $('#DueFromAssetAccountId').append('<option value="">No accounts found</option>');
                        $('#DueToLiabilityAccountId').append('<option value="">No accounts found</option>');
                    }

                    $('#DueFromAssetAccountId, #DueToLiabilityAccountId').prop('disabled', false);

                    if ($('.select2').length) {
                        $('#DueFromAssetAccountId').trigger('change.select2');
                        $('#DueToLiabilityAccountId').trigger('change.select2');
                    }
                },
                error: function () {
                    alert('Error loading branch accounts.');
                    ResetAccountDropdowns();
                }
            });
        }

        function ResetAccountDropdowns() {
            $('#DueFromAssetAccountId').empty().append('<option value="">--- Select Due From Account ---</option>');
            $('#DueToLiabilityAccountId').empty().append('<option value="">--- Select Due To Account ---</option>');
        }

</script>

