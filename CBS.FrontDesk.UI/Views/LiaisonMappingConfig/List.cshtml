@* Liaison Mapping Filters - minimal fields to match LiaisonMappingConfigQuery *@
@using Resources

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank me-2"></i> @GlobalLiaisonMappingConfig.Liaison_Mapping_Configuration
                </h1>
                <p class="card-text text-muted">
                    @GlobalLiaisonMappingConfig.Manage_liaison_mappings_between_branches_and_GL_accounts_efficiently
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLiaisonTips" aria-expanded="false" aria-controls="collapseLiaisonTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLiaisonTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLiaisonMappingConfig.Ensure_branch_and_account_details_are_correct_before_saving</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLiaisonMappingConfig.Prevent_duplicate_mappings_between_the_same_branches</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalLiaisonMappingConfig.Only_authorized_staff_can_modify_mappings</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalLiaisonMappingConfig.Use_the_status_checkbox_to_enable_or_disable_a_mapping</li>
            </ul>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow p-3 mb-4" id="filtersSection">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>@GlobalShared.Liaison_Mapping_Filters</h5>

    <form id="liaisonFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">

            <!-- Toggle switches -->
            <div class="row mb-2">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch" onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">@GlobalShared.Show_Branch_Filter</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDates" onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDates">@GlobalShared.Show_Date_Filters</label>
                    </div>
                </div>
            </div>

            <!-- Branch Filter -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">@GlobalShared.Branch</label>
                        @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2" })
                    </div>
                </div>
            </div>

            <!-- Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Created_From</label>
                        <input type="date" id="CreatedFromUtc" name="CreatedFromUtc" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Created_To</label>
                        <input type="date" id="CreatedToUtc" name="CreatedToUtc" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter buttons -->
        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                </button>
                <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
    </form>
</div>



<!-- Add Button above DataTable -->
<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-success" onclick="openLiaisonModalAdd()">
        <i class="mdi mdi-plus me-1"></i> @GlobalShared.Add_Mapping
    </button>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_LiaisonMappingDataTable")
</div>

<!-- ✅ MODAL SECTION -->
<div class="modal fade" id="liaisonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary">
                    <i class="mdi mdi-bank-outline me-1"></i> @GlobalShared.Liaison_Mapping
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="liaisonModalBody">
                <div class="text-center p-3">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">@GlobalShared.Loading...</p>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="openLiaisonModalAdd()" data-bs-dismiss="modal">
                    <i class="mdi mdi-content-save me-1"></i> @GlobalShared.Add_New_Mapping
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> @GlobalShared.Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* DataTable fixed layout */
        #myDataTable {
            table-layout: fixed;
            width: 100%;
        }

            #myDataTable td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        /* Si tu veux wrap du texte, décommenter */
        /* #myDataTable td { white-space: normal; } */

        /* Center text inside Status icon block */
        .status-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-weight: bold;
        }
    </style>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        var liaisonTable = null;

        // Convert empty string to null
        function emptyToNull(v) {
            return (v === undefined || v === null || v === '') ? null : v;
        }

        // Collect filters from form
        function collectLiaisonFilters() {
            return {
                BranchId: emptyToNull($('#BranchId').val()),
                CreatedFromUtc: emptyToNull($('#CreatedFromUtc').val()),
                CreatedToUtc: emptyToNull($('#CreatedToUtc').val()),
                options: {}
            };
        }

        // Initialize DataTable
        function initLiaisonDataTable() {
            if ($.fn.DataTable.isDataTable('#myDataTable') && liaisonTable) return;

            liaisonTable = $('#myDataTable').DataTable({
                serverSide: true,
                searching: false,
                responsive: true,
                order: [[0, 'desc']],
                ajax: {
                    url: '/LiaisonMappingConfig/LoadLiaisonMappingData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectLiaisonFilters();
                        filters.options = {
                            draw: d.draw,
                            //start: d.start,
                            //length: d.length,
                            pageSize: d.length,
                            skip: d.start,

                            searchValue: d.search?.value || '',
                            sortColumnName: 'CreatedDate',
                            sortColumnDirection: 'desc'
                        };
                        return JSON.stringify(filters);
                    },
                    error: function () {
                        appalert('Failed to load data', 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        width: '15%',
                        render: d => d ? moment(d).format('MM/DD/YYYY HH:mm:ss') : '-'
                    },

                    // 🔥 BranchName + DueFrom info
                    {
                        data: null,
                        width: '35%',
                        render: function (row) {
                            const branch = row.BranchName || '-';
                            const accName = row.DueFromAssetAccountName || 'N/A';
                            const accNumber = row.DueFromAssetAccountNumber || 'N/A';

                            return `
                    <div>
                        <strong>${branch}</strong><br/>
                        <small class="text-muted">
                            ${accName} (${accNumber})
                        </small>
                    </div>`;
                        }
                    },

                    // 🔥 CounterpartyBranchName + DueTo info
                    {
                        data: null,
                        width: '30%',
                        render: function (row) {
                            const counter = row.CounterpartyBranchName || '-';
                            const accName = row.DueToLiabilityAccountName || 'N/A';
                            const accNumber = row.DueToLiabilityAccountNumber || 'N/A';

                            return `
                    <div>
                        <strong>${counter}</strong><br/>
                        <small class="text-muted">
                            
                        </small>
                    </div>`;
                        }
                    },
                    // 🔥 Status avec icônes
                    {
                        data: null,
                        width: '5%',
                        render: function (row) {
                            const status = row.Status || 'NO';
                            //const displayText = status === 'YES' ? 'Map<Ok>' : 'Map<Error>';
                            const displayText = status === 'YES' ? 'Map&lt;Ok&gt;' : 'Map&lt;Error&gt;';
                            const iconHtml = status === 'YES'
                                ? '<i class="mdi mdi-check-circle" style="color: green; font-size: 16px;"></i>'
                                : '<i class="mdi mdi-close-circle" style="color: red; font-size: 16px;"></i>';

                            return `
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
                                        ${iconHtml}
                                        <span style="font-weight: bold;">${displayText}</span>
                                    </div>
                                `;
                        },
                        className: 'text-center'
                    },
                    {
                        data: 'Id',
                        width: '20%',
                        orderable: false,
                        render: function (data) {
                            const recordId = encodeURIComponent(data);
                            return `
                    <button class="btn btn-sm btn-outline-primary"
                        onclick="openLiaisonModal('${recordId}')">
                        <i class='fas fa-edit me-1'></i> Edit
                    </button>`;
                        }
                    }

                ],
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                language: { emptyTable: 'No records found' }
            });
        }

        // Reload DataTable
        function loadLiaisonData() {
            initLiaisonDataTable();
            if (liaisonTable) liaisonTable.ajax.reload(null, false);
        }

        // Reset filters
        function resetLiaisonFilters() {
            $('#liaisonFilterForm')[0].reset();
            $('#branchFilter, #dateFilters').addClass('d-none');
            if (liaisonTable) liaisonTable.ajax.reload(null, false);
            appalert('Filters reset', 3, 1);
        }

        // Initialize Select2 inside a modal
        function initSelect2InModal(modalSelector) {
            $(modalSelector).find('.select2').each(function () {
                $(this).select2({
                    width: '100%',
                    dropdownParent: $(modalSelector) // attach dropdown to modal
                });
            });
        }

        // Open modal and load _Create partial
        function openLiaisonModal(recordId) {
            const modalSelector = '#liaisonModal';
                             /*       $('#liaisonModalBody').html(`
                                        <div class="text-center p-3">
                                            <div class="spinner-border text-primary" role="status"></div>
                                            <p class="mt-2 text-muted">Loading form...</p>
                                        </div>`)*/;



            $.ajax({
                url: '/LiaisonMappingConfig/InitializeData',
                type: 'GET',
                data: { KEY: recordId, partialView: '_Create', path: 'edit' },
                success: function (data) {
                    const modal = new bootstrap.Modal(document.getElementById('liaisonModal'));
                    modal.show();
                    $('#liaisonModalBody').html(data);
                    initSelect2InModal(modalSelector); // initialize Select2 correctly
                },
                error: function () {
                    $('#liaisonModalBody').html('<div class="alert alert-danger">Error loading form.</div>');
                }
            });
        }


        // Open modal and load _Create partial
        function openLiaisonModalAdd() {
            const modalSelector = '#liaisonModal';
            /*     $('#liaisonModalBody').html(`
                     <div class="text-center p-3">
                         <div class="spinner-border text-primary" role="status"></div>
                         <p class="mt-2 text-muted">Loading form...</p>
                     </div>`);*/


            $.ajax({
                url: '/LiaisonMappingConfig/InitializeData',
                type: 'GET',
                data: { KEY: null, partialView: '_Create', path: 'new' },
                success: function (data) {
                    const modal = new bootstrap.Modal(document.getElementById('liaisonModal'));
                    modal.show();
                    $('#liaisonModalBody').html(data);
                    initSelect2InModal(modalSelector); // initialize Select2 correctly
                },
                error: function () {
                    $('#liaisonModalBody').html('<div class="alert alert-danger">Error loading form.</div>');
                }
            });
        }

        $(document).ready(function () {
            // Filter buttons
            $('#applyFilterBtn').click(e => { e.preventDefault(); loadLiaisonData(); });
            $('#resetFilterBtn').click(e => { e.preventDefault(); resetLiaisonFilters(); });

            // Enter key triggers apply filter
            $('#liaisonFilterForm input').keypress(e => { if (e.which === 13) { e.preventDefault(); loadLiaisonData(); } });

            // Initialize Select2 outside modal (filters)
            if ($.fn.select2) {
                $('.select2').not('#liaisonModal .select2').select2({ width: '100%' });
            }
        });
    </script>

}
