@model List<CBS.FrontDesk.Data.Entity.AccountingV2.LiaisonMappingV2.LiaisonMapping>

<fieldset class="fieldset-custom">
    <legend>Liaison Mappings</legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>No liaison mappings have been set up yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th>Creation Date</th>
                        <th>Branch</th>
                        <th>Counterparty Branch</th>
                        <th>Due From Account</th>
                        <th>Due To Account</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CreatedDate</td>
                            <td>@item.BranchName (@item.BranchCode)</td>
                            <td>@item.CounterpartyBranchName</td>
                            <td>@item.DueFromAssetAccountName (@item.DueFromAssetAccountNumber)</td>
                            <td>@item.DueToLiabilityAccountName (@item.DueToLiabilityAccountNumber)</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" onclick="AddORUpdateGen('@item.Id','datalistingview','_Create','update','LiaisonMapping')">
                                    <i class="fas fa-edit me-1"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-info" onclick="showLiaisonMappingDetails('@item.Id')">
                                    <i class="fas fa-info-circle me-1"></i> Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
