@{
    ViewBag.Title = "Liaison Mapping Configuration";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank me-2"></i> Liaison Mapping Configuration
                </h1>
                <p class="text-muted">
                    Manage liaison mappings between branches and GL accounts efficiently.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-end mb-2">
                    <a onclick="LoadDataGen('LiaisonMappingConfig','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-secondary btn-sm me-2">
                        <i class="mdi mdi-view-list mdi-18px"></i> View List
                    </a>
                    <a onclick="AddORUpdateGen(null,'datalistingview','_Create','new','LiaisonMappingConfig')" class="btn btn-label-primary btn-sm">
                        <i class="mdi mdi-plus mdi-18px"></i> Add Mapping
                    </a>
                </div>
                <div id="datalistingview">
                    @Html.Partial("_Create")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Details -->
<div class="modal fade" id="liaisonMappingDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="text-primary fw-bold">Liaison Mapping Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="liaisonMappingDetailsContent">
                <!-- Dynamic content -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function showLiaisonMappingDetails(id) {
            $('#liaisonMappingDetailsContent').html('<p>Loading...</p>');
            $.ajax({
                url: '/LiaisonMapping/GetDetailsPartialView',
                type: 'GET',
                data: { Key: id },
                success: function (html) {
                    $('#liaisonMappingDetailsContent').html(html);
                    $('#liaisonMappingDetailsModal').modal('show');
                },
                error: function () {
                    $('#liaisonMappingDetailsContent').html('<p>Error loading details.</p>');
                    $('#liaisonMappingDetailsModal').modal('show');
                }
            });
        }
    </script>
}
