@{
    ViewBag.Title = "Liaison Mapping Configuration";
}
@using Resources
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank me-2"></i> @GlobalLiaisonMappingConfig.Liaison_Mapping_Configuration
                </h1>
                <p class="card-text text-muted">
                    @GlobalLiaisonMappingConfig.Manage_liaison_mappings_between_branches_and_GL_accounts_efficiently
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLiaisonTips" aria-expanded="false" aria-controls="collapseLiaisonTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLiaisonTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLiaisonMappingConfig.Ensure_branch_and_account_details_are_correct_before_saving.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLiaisonMappingConfig.Prevent_duplicate_mappings_between_the_same_branches</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalLiaisonMappingConfig.authorized_staff_can_modify_mappings</li>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalLiaisonMappingConfig.Use_the_status_checkbox_to_enable_or_disable_a_mapping</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconLiaison">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-Liaison" aria-expanded="true" aria-controls="accordionPopoutIcon-Liaison">
                            <i class="mdi mdi-bank me-2"></i> @GlobalLiaisonMappingConfig.Liaison_Mapping_Configuration
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-Liaison" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-1">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button" href="/LiaisonMappingConfig/List" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.View_List
                                        </a>
                                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','LiaisonMappingConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Mapping">
                                            <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.Add_Mapping
                                        </a>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_Create")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Liaison Mapping Details -->
<div class="modal fade" id="liaisonMappingDetailsModal" tabindex="-1" aria-labelledby="liaisonMappingDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header p-2">
                <header class="w-100 text-center">
                    <h4 class="text-primary fw-bold mb-1">
                        <i class="mdi mdi-bank me-2"></i> @GlobalShared.Mapping_Details
                    </h4>
                    <p class="text-muted mb-0">
                        @GlobalLiaisonMappingConfig.View_and_manage_liaison_mapping_information_efficiently
                    </p>
                    <hr style="border: 1px solid rgba(128, 128, 128, 0.5);" />
                </header>
            </div>
            <div class="modal-body p-2">
                <div id="liaisonMappingDetailsContent">
                    <!-- Dynamic content or partial view will be loaded here -->
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Show Liaison Mapping Details Modal
        function showLiaisonMappingDetails(id) {
            $('#liaisonMappingDetailsContent').html('<p>Loading...</p>');
            $.ajax({
                url: '/LiaisonMapping/GetDetailsPartialView',
                type: 'GET',
                data: { Key: id },
                success: function (html) {
                    $('#liaisonMappingDetailsContent').html(html);
                    $('#liaisonMappingDetailsModal').modal('show');
                },
                error: function () {
                    $('#liaisonMappingDetailsContent').html('<p>Error loading details.</p>');
                    $('#liaisonMappingDetailsModal').modal('show');
                }
            });
        }

        $(document).ready(function () {

            LoadDT("#myDataTable");
        });
    </script>
}

