@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm
@using Resources

<table class="table">
    <thead>
        <tr>
            <th colspan="2" class="separation-text"><h5 class="card-title">@GlobalShared.Members_Informations</h5></th>
        </tr>
    </thead>
    <tbody>
       
        <tr>
            <td><strong>@GlobalShared.Member_reference:</strong></td>
            <td><span id="notes10000Required">@Model.Customer.CustomerId</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Member:</strong></td>
            <td><span id="notes10000Required">@Model.Customer.name</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Photo:</strong></td>
            <td>
                <img id="customerPhoto" src="@Model.Customer.photoUrl" alt="Customer Photo" style="max-width: 100px; height: auto;">
            </td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Telephone:</strong></td>
            <td><span id="notes2000Required">@Model.Customer.Phone</span></td>
        </tr>



    </tbody>
    <thead>
        <tr>
            <th colspan="2" class="separation-text"><h5 class="card-title">@GlobalChargesWaived.REQUESTINFO</h5></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>@GlobalShared.Request_Code:</strong></td>
            <td><span id="calculatedBalance">@Model.ChargesWaived.TransactionReference</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Request_Date:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.DateOfWaiverRequest</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalChargesWaived.WaivedAmount:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.CustomCharge.ToString("#,##0.0 XAF")</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalChargesWaived.NormalCharge:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.NormalCharge.ToString("#,##0.0 XAF")</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Initiator:</strong></td>
            <td><span id="coins50Required">@Model.ChargesWaived.WaiverInitiator</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Comment:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.Comment</span></td>
        </tr>


        <tr>
            <td><strong>@GlobalChargesWaived.DateWaived:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.DateOfWaived</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalChargesWaived.IsWithdrawalDone:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.IsWaiverDone, Date: @Model.ChargesWaived.DateOfWaived</span></td>
        </tr>
        <tr>
            <td><strong>@GlobalShared.Cashier:</strong></td>
            <td><span id="notes5000Required">@Model.ChargesWaived.TellerCaise, @Model.ChargesWaived.TellerName </span></td>
        </tr>
    </tbody>
</table>
