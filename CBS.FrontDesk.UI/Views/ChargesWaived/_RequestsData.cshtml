@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm


@if (Model.ChargesWaiveds.Any())
{<div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Member account</th>
                    <th>Waived Charge</th>
                    <th>Normal Charge</th>
                    <th>Status</th>
                    <th>Expired date</th>
                    <th>Reference</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.ChargesWaiveds)
                {
                    <tr>
                        <td style="width:20%">@d.DateOfWaiverRequest</td>
                        <td style="width:10%">@d.CustomerId</td>
                        <td style="width:10%">@d.CustomCharge.ToString("#,##0.0")</td>
                        <td style="width:10%">@d.NormalCharge.ToString("#,##0.0")</td>
                        <td style="width:10%">
                            @if (d.IsWaiverDone)
                            {
                                <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">Already Paid</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">Pending...</span>
                            }
                        </td>
                        <td style="width:20%">@d.TransactionReference</td>
                        <td style="width:10%">
                            @if (DateTime.Now.Date > d.DateOfWaiverRequest.Date)
                            {
                                <span class="badge rounded-pill rounded-2 badge-danger bg-label-danger fs-tiny py-1">Expired</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">OK</span>
                            }
                        </td>
                        <td style="width:10%">
                            <a href="#" onclick="ViewDetail('@d.Id')" data-toggle="modal" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space customer-details" data-bs-toggle="tooltip" title="View Details">
                                <i class="mdi mdi-information"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center my-3">
        <p> No Data was found at the moment..</p>
    </div>
}




