@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm
@using Resources
<div class="card-body d-sm-flex d-block">
    <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
        <a href="#" onclick="SearchByCustomerNumber('_CustomerCard','datalistingview')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space customer-details" data-bs-toggle="tooltip" title="@GlobalChargesWaived.ViewCustomerDetails">
            <i class="fas fa-user"></i>
        </a>
        <a href="#" onclick="GetMemberData('@Model.Customer.CustomerId','_OperationDesk','datalistingview','request')" class="btn btn-icon btn-label-danger btn-sm btn-fab demo btn-space cashin" data-bs-toggle="tooltip" title="@GlobalChargesWaived.InitiateSavingWithdrawalRequest.">
            <i class="fas fa-money-bill-wave-alt"></i>
        </a>
        <a href="#" onclick="LoadRequest()" class="btn btn-icon btn-label-dark btn-sm btn-fab demo btn-space cashout" data-bs-toggle="tooltip" title="@GlobalChargesWaived.LoadRequests">
            <i class="mdi mdi-format-list-bulleted"></i>
        </a>
        @*<a href="#" onclick="GetMemberData('@Model.Customer.CustomerId','_OperationDesk','datalistingview','repayment')" class="btn btn-icon btn-label-dark btn-sm btn-fab demo btn-space loan-repayment" data-bs-toggle="tooltip" title="Perform loan repayment operation">
            <i class="fas fa-hand-holding-usd"></i>
        </a>
        <a href="#" onclick="AddDepositor()" data-toggle="modal" data-target="#depositerModal" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space customer-details" data-bs-toggle="tooltip" title="Add depositor">
            <i class="fas fa-user"></i> 
            <i class="fas fa-money-check"></i>
        </a>
        <a href="#" onclick="AddNote()" data-toggle="modal" data-target="#depositerModal" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space customer-details" data-bs-toggle="tooltip" title="Add note">
            <i class="fas fa-user"></i>
            <i class="fas fa-sticky-note"></i>
        </a>*@
    </div>
</div>
