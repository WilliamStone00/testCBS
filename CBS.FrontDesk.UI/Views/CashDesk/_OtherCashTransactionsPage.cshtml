@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources


@{
    bool isOut = (string)ViewBag.FormContext == "OtherCashOut";
    var pageTitle = isOut ? "Other Cash-Out Operations" : "Other Cash-In Operations";
    var opName = isOut ? "Other Cash-Out" : "Other Cash-In";
    ViewBag.Title = pageTitle;
}
<!-- Page Title and Welcome Message -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center p-3">
                <h2 class="card-title text-primary mb-2">
                    <i class="mdi mdi-cash me-2"></i> @pageTitle
                    <span class="badge @(isOut ? "bg-danger" : "bg-primary") ms-2">
                        @(isOut ? "Expense" : "Income")
                    </span>
                </h2>

                <p class="mb-1">
                    @Html.Raw(@CashDeskRessource.Welcome_to_the_Cash_Desk_of_TSC)
                    @Html.Raw(@CashDeskRessource.This_interface_manages_opName_transactions_posted_directly_to_the_branch_chart_of_accounts)
                </p>

                <p class="mb-1">
                    <strong>@opName</strong>
                    @(isOut ? "refers to cash paid out" : "refers to cash received")
                    @CashDeskRessource.at_the_teller_desk_allocated_against_predefined_branch_GL_accounts
                </p>

                <p class="mb-2 text-muted small">
                    💡 <strong>@CashDeskRessource.Note:</strong> @CashDeskRessource.Use_this_strictly_for
                    <strong>@(isOut ? "cash-out" : "cash-in")</strong> @CashDeskRessource.that_does_not_involve_member_accounts
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips (operation-aware, compact) -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i>
            @(isOut ? "Tips for Other Cash-Out" : "Tips for Other Cash-In")
        </span>
        <button class="btn btn-light btn-sm" type="button"
                data-bs-toggle="collapse" data-bs-target="#collapseOtherCashTips"
                aria-expanded="false" aria-controls="collapseOtherCashTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseOtherCashTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-view-grid-plus-outline text-success me-2"></i>
                    @Html.Raw(@CashDeskRessource.You_can_allocate_the_transaction_to_multiple_GL_accounts)
                    @Html.Raw(@CashDeskRessource.Use_Add_Row_to_insert_additional_GL_lines)
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-primary me-2"></i>
                    @Html.Raw(@CashDeskRessource.Confirm_the_GLs_to_be_impacted_by_ticking_the_Select_checkbox_on_each_row_before_posting)
                    @CashDeskRessource.Only_checked_rows_are_included
                </li>

                <li>
                    <i class="mdi mdi-calendar-lock-outline text-secondary me-2"></i>
                    @Html.Raw(@CashDeskRessource.Accounting_Date_is_read_only_and_uses_the_current_accounting_date)
                </li>

                <li>
                    <i class="mdi mdi-plus-circle-outline text-info me-2"></i>
                    @Html.Raw(@CashDeskRessource.Click_Add_Row_to_add_a_new_GL_entry_choose_GL_enter_Note_and_Amount)
                </li>

                <li>
                    <i class="mdi mdi-trash-can-outline text-danger me-2"></i>
                    @Html.Raw(@CashDeskRessource.Click_the_Delete_button_on_a_row_to_remove_that_GL_entry)
                </li>

                <li>
                    <i class="mdi mdi-cash-multiple text-warning me-2"></i>
                    @Html.Raw(@CashDeskRessource.Ensure_the_sum_of_all_selected_GL_amounts_equals_the_cash_Denominations)
                </li>

                <li>
                    <i class="mdi mdi-note-text-outline text-muted me-2"></i>
                    @Html.Raw(@CashDeskRessource.Add_a_clear_Narration_and_capture_Name_CNI_Telephone_for_audit)
                </li>

                <li>
                    <i class="mdi mdi-domain text-muted me-2"></i>
                    @Html.Raw(@CashDeskRessource.If_Inter_Branch_is_enabled_select_the_destination_branch_before_posting)
                </li>
                <li>
                    <i class="mdi mdi-printer-check text-success me-2"></i>
                    @Html.Raw(@CashDeskRessource.After_posting_successfully_click_Re_Print_to_print_the_operation_receipt_for_your_records)
                </li>
            </ul>
        </div>
    </div>
</div>


<!-- Main Transaction Area -->
<div class="row g-2">
    <!-- Left: Denominations -->
    <div class="col-md-3">
        <div class="card shadow-sm mb-0">
            <div class="card-body p-2">
                @Html.Partial("_DenominationBreakDown")
            </div>
        </div>
    </div>

    <!-- Right: Other Cash Transactions -->
    <div class="col-md-9">
        <div class="card shadow-sm mb-0">
            <div class="card-body p-3">
                <div id="datalistingview_inner">
                    @Html.Partial("_OtherTransactionForm")
                </div>
            </div>
        </div>
    </div>
</div>





