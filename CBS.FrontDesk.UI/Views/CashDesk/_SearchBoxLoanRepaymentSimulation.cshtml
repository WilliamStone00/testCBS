
@using Resources

<fieldset class="fieldset-custom p-3">
    <div class="row">
        <div class="col-md-8 mx-auto">

            <!-- Search Bar -->
            <div class="input-group shadow">
                <input type="text" id="manualSearchInput" class="form-control" placeholder="@CashDeskRessource.EnterMemberReferenceNumber">
                <button class="btn btn-primary" onclick="GetMemberDataLoanSimulation()">
                    <i class="mdi mdi-magnify"></i> @GlobalShared.Search
                </button>
            </div>
            <small class="form-text text-muted mt-2">
                @CashDeskRessource.EnterThe10DigitMemberReferenceNumber <br />
                @CashDeskRessource.PerformLoanRepaymentSimulation
            </small>
        </div>
    </div>
</fieldset>
<input type="hidden" class="form-control shadow-box" value="repayment" id="currentselectedOperation" />