

@using Resources

<div class="row g-2 align-items-center mb-2">
    <div class="col-md-7 col-lg-6">
        <input type="hidden"
               class="form-control shadow-box"
               value="cashin_momokash_collection"
               id="currentselectedOperation" />

        <label for="manualSearchInput" class="form-label small mb-1">
            @CashDesk_MomocashCollectionSearchBox.EnterMemberReferenceNumber
        </label>

        <div class="input-group input-group-sm">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   id="manualSearchInput"
                   class="form-control shadow-box"
                   placeholder="@CashDesk_MomocashCollectionSearchBox.EnterMemberReferenceNumber" />
            <button type="button"
                    class="btn btn-primary"
                    id="btnSearchMember"
                    onclick="GetMember()">
                @CashDesk_MomocashCollectionSearchBox.Search
            </button>
        </div>
    </div>

    <div class="col-md-5 col-lg-6 text-md-end d-none d-md-block">
        <small class="text-muted">
            Press <strong>Enter</strong> or click <strong>Search</strong>.
        </small>
    </div>
</div>


