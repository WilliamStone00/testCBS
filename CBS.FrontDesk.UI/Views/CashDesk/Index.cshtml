@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    ViewBag.Title = "Cash desk";
}

<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-1">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash me-2"></i> Cash Desk Management
                </h1>
                <p class="card-text">
                    Welcome to the Cash Desk TRUST SOFT CREDIT (TSC). This interface allows you to efficiently manage cash-related operations.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <!-- Collapsible Description Section -->
    <div class="col-12">
        <div class="accordion" id="helpTipsAccordion">
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span>
                        <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
                    </span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                    <div class="card-body">
                        <div class="accordion" id="helpDetailsAccordion">
                            <!-- Withdrawal From Saving Account Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWithdrawalSavingAccount" aria-expanded="false" aria-controls="collapseWithdrawalSavingAccount">
                                        Withdrawal From Saving Account Policies
                                    </button>
                                </h2>
                                <div id="collapseWithdrawalSavingAccount" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>To perform a withdrawal from a saving account, follow these guidelines:</li>
                                            <ul>
                                                <li>A member must notify weeks or days before the withdrawal.</li>
                                                <li>Withdrawal incurs a service charge of 2% on a normal day and 2.5% on holidays or weekends.</li>
                                                <li>A Withdrawal Form fee is applied: 300 XAF for Physical Persons and 1,000 XAF for Moral Persons.</li>
                                                <li>If the member notifies before the withdrawal, only the form fee is applied. Otherwise, both the form fee and service fee are charged.</li>
                                                <li>Ensure sufficient funds are available in the account to process the withdrawal.</li>
                                            </ul>
                                            <strong>NB:</strong> Always verify the account balance and fees before proceeding.
                                    </div>
                                </div>
                            </div>
                            <!-- Cash Out From Saving Account Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCashOutSavingAccount" aria-expanded="false" aria-controls="collapseCashOutSavingAccount">
                                        Cash Out From Saving Account
                                    </button>
                                </h2>
                                <div id="collapseCashOutSavingAccount" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>To perform a cash-out from a saving account, follow these steps:</li>
                                            <ul>
                                                <li>a. Click the <strong>Cash-Out</strong> icon.</li>
                                                <li>b. Enter denominations.</li>
                                                <li>c. Enter the amount to be withdrawn in the <strong>Amount</strong> column.</li>
                                                <li>d. If there are charges, enter the applicable charges in the <strong>Fee</strong> column.</li>
                                                <li>e. Check the <strong>CONF</strong> checkbox to confirm the transaction.</li>
                                                <li>f. Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                            </ul>
                                        </ul>
                                        <strong>NB:</strong> Ensure the member has sufficient balance to avoid transaction rejection.
                                    </div>
                                </div>
                            </div>
                            <!-- Loan Repayment Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepayment" aria-expanded="false" aria-controls="collapseLoanRepayment">
                                        Loan Repayment
                                    </button>
                                </h2>
                                <div id="collapseLoanRepayment" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>To perform a loan repayment, click the icon []:</li>
                                            <ul>
                                                <li>a. Enter denominations.</li>
                                                <li>b. Enter Amount in the <strong>"Enter Capital"</strong> column.</li>
                                                <li>c. Enter Interest in the <strong>"Enter Interest"</strong> column.</li>
                                                <li>d. Enter Penalty in the <strong>"Enter Penalty"</strong> column.</li>
                                                <li>e. If the loan has VAT, the VAT is automatically calculated on interest input.</li>
                                                <li>f. Check the <strong>CONF</strong> checkbox.</li>
                                                <li>g. Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                            </ul>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Cash In Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCashIn" aria-expanded="false" aria-controls="collapseCashIn">
                                        Cash In
                                    </button>
                                </h2>
                                <div id="collapseCashIn" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>
                                                To perform a cash-in or deposit without charges, click the <strong>Cash-In</strong> icon:
                                                <ul>
                                                    <li>Enter denominations.</li>
                                                    <li>Enter the amount in the <strong>Amount</strong> column of any listed account of your choice.</li>
                                                    <li>Check the <strong>CONF</strong> checkbox.</li>
                                                    <li>Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                                </ul>
                                            </li>
                                            <li>
                                                To perform a cash-in or deposit with charges, click the <strong>Cash-In</strong> icon:
                                                <ul>
                                                    <li>Enter denominations.</li>
                                                    <li>Enter the amount in the <strong>Amount</strong> column & charges in the <strong>Fee</strong> column of any listed account of your choice.</li>
                                                    <li>Check the <strong>CONF</strong> checkbox.</li>
                                                    <li>Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <strong>NB:</strong> Any charge inputted incorrectly will be rejected because the system is configured to validate all necessary charges.
                                    </div>
                                </div>
                            </div>

                            <!-- Cash Out Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCashOut" aria-expanded="false" aria-controls="collapseCashOut">
                                        Cash Out
                                    </button>
                                </h2>
                                <div id="collapseCashOut" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <p>In cash-out, the fee can either be inclusive or exclusive.</p>
                                        <ul>
                                            <li>
                                                To perform a cash-out without charges, click the <strong>Cash-Out</strong> icon:
                                                <ul>
                                                    <li>Enter denominations.</li>
                                                    <li>Enter the amount in the <strong>Amount</strong> column of any listed account of your choice.</li>
                                                    <li>Check the <strong>CONF</strong> checkbox.</li>
                                                    <li>Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                                </ul>
                                            </li>
                                            <li>
                                                To perform a cash-out with charges, choose one of the following:
                                                <ul>
                                                    <li>
                                                        <strong>Charges Inclusive:</strong> The charge is debited directly from the member's balance, and the full requested amount is given to the member:
                                                        <ul>
                                                            <li>Enter denominations.</li>
                                                            <li>Enter the amount in the <strong>Amount</strong> column & charges in the <strong>Fee</strong> column of any listed account of your choice.</li>
                                                            <li>Check the <strong>CONF</strong> checkbox.</li>
                                                            <li>Check the <strong>INC</strong> box.</li>
                                                            <li>Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                                        </ul>
                                                    </li>
                                                    <li>
                                                        <strong>Charges Exclusive:</strong> The cashier collects the charge from the member during the operation (cash operation):
                                                        <ul>
                                                            <li>Enter denominations.</li>
                                                            <li>Enter the amount in the <strong>Amount</strong> column & charges in the <strong>Fee</strong> column of any listed account of your choice.</li>
                                                            <li>Check the <strong>CONF</strong> checkbox.</li>
                                                            <li>Do not check the <strong>INC</strong> box.</li>
                                                            <li>Click <strong>Save</strong>. After a successful transaction, click <strong>Re-Print</strong> to print the receipt.</li>
                                                        </ul>
                                                    </li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <strong>NB:</strong> Any charge inputted incorrectly will be rejected because the system is configured to validate all necessary charges.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Definitions Section -->
                        <div class="card mt-4">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0">Definitions</h6>
                            </div>
                            <div class="card-body">
                                <ul>
                                    <li><strong>Inclusive Charges:</strong> The charge is debited directly from the member's balance, and the requested amount is given in full. If the member has insufficient funds, the transaction will be rejected to avoid balance overdraft.</li>
                                    <li><strong>Exclusive Charges:</strong> The cashier collects the charge in cash directly from the member during the operation.</li>
                                    <li>
                                        <strong>Withdrawal From Saving Account:</strong> A member withdraws 50,000 XAF from their savings account.
                                        <ul>
                                            <li>
                                                <strong>With Notification:</strong> The member notified the @Session["BranchName"] service in advance and pays only the form fee (300 XAF for Physical Persons or 1,000 XAF for Moral Persons). No service fee is charged.
                                            </li>
                                            <li>
                                                <strong>Without Notification:</strong> The member did not notify the @Session["BranchName"] service and pays both the form fee and a service fee of 2% on a normal day (1,000 XAF) or 2.5% on a holiday/weekend (1,250 XAF). Additionally, the total cost will be 51,300 XAF for a normal day and 51,550 XAF for a holiday/weekend.
                                            </li>
                                        </ul>
                                        <h6 class="text-primary mt-3">Scenario Examples:</h6>
                                        <p>
                                            <strong>Cash In:</strong> A member deposits 20,000 XAF with a charge of 500 XAF.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>Without Charges:</strong> The member's account is credited with 20,000 XAF. The system validates and confirms the transaction.
                                            </li>
                                            <li>
                                                <strong>With Charges:</strong> The member's account is credited with 19,500 XAF after deducting 500 XAF as charges.
                                            </li>
                                        </ul>
                                        <p>
                                            <strong>Loan Repayment:</strong> A member repays a loan of 10,000 XAF with an interest of 500 XAF and a penalty of 200 XAF.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>With VAT:</strong> The VAT is automatically calculated on the interest, and the system debits the total amount (10,700 XAF + VAT) from the member's account.
                                            </li>
                                            <li>
                                                <strong>Without VAT:</strong> The total repayment amount of 10,700 XAF is debited from the member's account.
                                            </li>
                                        </ul>
                                        <p>
                                            <strong>Cash Out:</strong> A member requests to withdraw 15,000 XAF with a charge of 300 XAF.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>Inclusive:</strong> The member receives 15,000 XAF, and their account is debited with 15,300 XAF.
                                            </li>
                                            <li>
                                                <strong>Exclusive:</strong> The member pays the 300 XAF charge in cash and receives 15,000 XAF. Their account is debited with 15,000 XAF only.
                                            </li>
                                        </ul>
                                        <p>
                                            <strong>Withdrawal From Saving Account:</strong> A member withdraws 50,000 XAF from their savings account.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>With Notification:</strong> The member notified the bank in advance and pays only the form fee (300 XAF for Physical Persons or 1,000 XAF for Moral Persons). No service fee is charged.
                                            </li>
                                            <li>
                                                <strong>Without Notification:</strong> The member did not notify the bank and pays both the form fee and a service fee of 2% on a normal day (1,000 XAF) or 2.5% on a holiday/weekend (1,250 XAF).
                                            </li>
                                        </ul>
                                        <p>
                                            <strong>Loan Repayment:</strong> A member repays a loan of 10,000 XAF with an interest of 500 XAF and a penalty of 200 XAF.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>With VAT:</strong> The VAT is automatically calculated on the interest, and the system debits the total amount (10,700 XAF + VAT) from the member's account.
                                            </li>
                                            <li>
                                                <strong>Without VAT:</strong> The total repayment amount of 10,700 XAF is debited from the member's account.
                                            </li>
                                        </ul>
                                        <p>
                                            <strong>Cash Out:</strong> A member requests to withdraw 15,000 XAF with a charge of 300 XAF.
                                        </p>
                                        <ul>
                                            <li>
                                                <strong>Inclusive:</strong> The member receives 15,000 XAF, and their account is debited with 15,300 XAF.
                                            </li>
                                            <li>
                                                <strong>Exclusive:</strong> The member pays the 300 XAF charge in cash and receives 15,000 XAF. Their account is debited with 15,000 XAF only.
                                            </li>
                                        </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col">
        <div class="row my-3">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">

                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-bank me-2"></i>
                            <span id="cashDeskOperations">CASH OPERATIONS</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="collapseDeliveryAddress"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">

                            @Html.Partial("_SearchBox")
                            <div id="datalistingview">


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">Loan Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="modalAmount">Enter Amount:</label>
                    <input type="number" class="form-control" id="modalAmount" placeholder="Enter amount">
                </div>
                <div class="form-group">
                    <label for="modalInterest">Enter Interest:</label>
                    <input type="number" class="form-control" id="modalInterest" placeholder="Enter interest">
                </div>
                <div class="form-group">
                    <label for="modalPenalty">Enter Penalty:</label>
                    <input type="number" class="form-control" id="modalPenalty" placeholder="Enter penalty">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="modalOkButton" onclick="applyPayment()">OK</button>
            </div>
        </div>
    </div>
</div>



<!-- Modal to display customer information -->
@Html.Partial("_model")

@Html.Partial("_TemporalMembersLookUp")




@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="~/Scripts/Js/Crud/CashDesk/PreMemberOnboarding.js"></script>
<script src="~/Scripts/Js/Crud/CashDesk/CashDeskOperations.js"></script>

}
