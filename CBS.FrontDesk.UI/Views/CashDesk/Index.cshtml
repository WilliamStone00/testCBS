@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    ViewBag.Title = "Cash desk";
}
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">

<div class="row">
    <div class="col">
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">

                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-bank me-2"></i>
                            @*<i class="mdi mdi-cash-bank me-2"></i>*@
                            <span id="cashDeskOperations">CASH OPERATIONS</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="collapseDeliveryAddress"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @Html.Partial("_SearchBox")
                            <div id="datalistingview">


                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @*}*@
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">Loan Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="modalAmount">Enter Amount:</label>
                    <input type="number" class="form-control" id="modalAmount" placeholder="Enter amount">
                </div>
                <div class="form-group">
                    <label for="modalInterest">Enter Interest:</label>
                    <input type="number" class="form-control" id="modalInterest" placeholder="Enter interest">
                </div>
                <div class="form-group">
                    <label for="modalPenalty">Enter Penalty:</label>
                    <input type="number" class="form-control" id="modalPenalty" placeholder="Enter penalty">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="modalOkButton" onclick="applyPayment()">OK</button>
            </div>
        </div>
    </div>
</div>



<!-- Modal to display customer information -->
@Html.Partial("_model")

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="~/Scripts/Js/Crud/CashDesk/CashDeskOperations.js"></script>
@*<script src="~/Scripts/Js/Crud/Operation/Operation.js"></script>*@

}