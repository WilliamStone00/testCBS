@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    var isNewSubscription = ViewBag.Operation?.ToString()?.ToLower() == "newsubcription";
}

<style>
    /* Let browser auto-fit based on content & header */
    #myDataTableT2 {
        table-layout: auto; /* auto sizing, not fixed */
        width: 100%;
    }

        #myDataTableT2 thead th,
        #myDataTableT2 tbody td,
        #myDataTableT2 tfoot td {
            white-space: nowrap; /* prevent wrapping */
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
            padding: .4rem .6rem; /* consistent compact padding */
        }

            /* Right-align numeric columns */
            #myDataTableT2 th:nth-child(3),
            #myDataTableT2 th:nth-child(4),
            #myDataTableT2 th:nth-child(5),
            #myDataTableT2 th:nth-child(10),
            #myDataTableT2 td:nth-child(3),
            #myDataTableT2 td:nth-child(4),
            #myDataTableT2 td:nth-child(5),
            #myDataTableT2 td:nth-child(10),
            #myDataTableT2 tfoot td:nth-child(9) {
                text-align: right;
            }

        /* Keep CONF column narrow */
        #myDataTableT2 th:last-child,
        #myDataTableT2 td:last-child {
            text-align: center;
            width: 3rem; /* force smallest */
        }

        /* Inputs smaller and consistent */
        #myDataTableT2 .form-control.form-control-sm {
            padding: .25rem .4rem;
            height: 2rem;
            font-size: .85rem;
        }

    @@media (max-width: 992px) {
        #myDataTableT2 {
            font-size: .8rem; /* shrink font on smaller screens */
        }

            #myDataTableT2 .form-control.form-control-sm {
                font-size: .75rem;
            }
    }
</style>
<style>
    /* Compact fieldsets and tables stacked vertically */
    .fieldset-custom {
        margin-bottom: .75rem;
    }

        .fieldset-custom > legend {
            margin-bottom: .35rem;
        }

    /* Tables inside our compact sections */
    .compact-section .table {
        margin-bottom: .5rem;
    }

        .compact-section .table thead {
            margin-bottom: 0;
        }

    .compact-section .table-responsive {
        margin-bottom: .5rem;
    }

    /* Remove extra top margin on the repayment block */
    #loanRepaymentSection {
        margin-top: .5rem !important;
    }
</style>


<span id="customerName" class="d-none">@Model.Customer.name</span>
@if (ViewBag.Operation == "cashin" || isNewSubscription)
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: green">
                @(isNewSubscription
        ? CashDeskRessource.MemberOnboardingDeposit
        : (Model.IsDailyCollector
            ? "Daily Collector Cash Clearance"
            : GlobalShared.Cash_In))
            </legend>



            <hr style="border: 2px solid green;" />

            @if (isNewSubscription)
            {
                <div id="preMemberOnboardingContainer" class="mt-3">
                    @Html.Partial("_PreMemberOnboardingSummary")
                </div>
            }

            <div class="change-group">
                <div class="row mt-2 gy-2">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start mb-2">
                                @GlobalShared.Member_name : @Model.Customer.name
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline d-flex justify-content-end">
                            <span class="formatted-amount shadow-box mb-2" id="lblDepositRequest_amount">
                                @GlobalShared.Total_amount : <b>@Model.MemberOnboardingDetailDto.GrandTotal.ToString("N0")</b>
                            </span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0" />
                        </div>
                    </div>

                    <!-- Toolbar: hide-balance + include-loan on one line -->
                    <div class="col-12">
                        <div class="d-flex flex-wrap align-items-center gap-4">
                            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                                <input class="form-check-input" type="checkbox" id="hideBalanceCheckbox" onchange="toggleHideBalance()" />
                                <label class="form-check-label fw-bold m-0" id="hideBalanceLabel" for="hideBalanceCheckbox" style="font-size:0.95rem;">
                                    @CashDeskRessource.BalancewWllBeShownOnReceipt
                                </label>
                            </div>

                            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                                <input class="form-check-input" type="checkbox" id="includeLoanRepaymentCheckbox" onchange="toggleLoanRepayment()" />
                                <label class="form-check-label fw-bold m-0" for="includeLoanRepaymentCheckbox" style="font-size:0.95rem;">
                                    @GlobalShared.Include_Loan_Repayment
                                </label>
                                <!-- mirror for backend -->
                                <input type="hidden" id="IncludeLoanRepayment" name="IncludeLoanRepayment" value="false" />
                            </div>
                        </div>
                    </div>
                    @if (isNewSubscription)
                    {
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control shadow-input-boxes" id="CustomerAlphaNumber"
                                       placeholder=" @CashDeskRessource.MemberCustomAccountNumberExample" required />
                                <label for="CustomerAlphaNumber">@CashDeskRessource.MemberCustomAccountNumber</label>
                            </div>
                        </div>
                    }
                    else if (Model.IsDailyCollector)
                    {
                        <!-- Collection Approach (Radio Buttons) -->
                        <div class="col-md-12">
                            <fieldset class="mb-3">
                                <legend class="fs-6 text-muted mb-2">@GlobalShared.Collection_Approach</legend>

                                <div class="d-flex gap-4 flex-wrap" id="collectionApproachGroup">
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.DailyCollectorCollectApproach, "Device",
                                            new { @class = "form-check-input", id = "approachDevice" })
                                        <label class="form-check-label fw-semibold" for="approachDevice">
                                            <i class="mdi mdi-nfc-tap-variant me-1"></i> @GlobalShared.Device (C-Money / POS)
                                        </label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.DailyCollectorCollectApproach, "Manual",
                                            new { @class = "form-check-input", id = "approachManual" })
                                        <label class="form-check-label fw-semibold" for="approachManual">
                                            <i class="mdi mdi-file-upload-outline me-1"></i> @GlobalShared.Manual (@GlobalShared.Uploaded_batch)
                                        </label>
                                    </div>
                                </div>

                                <small class="text-muted d-block mt-1">
                                    @Html.Raw(@CashDeskRessource.Choose_Manual_to_clear_from_an_approved_uploaded_batch_or_Device_for_C_Money_POS_device_collections)
                                </small>
                            </fieldset>
                        </div>

                        <!-- Approved Manual Batch (hidden by default; shown only if 'Manual') -->
                        <div class="col-md-12 d-none" id="manualBatchWrapper">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.DropDownListFor(
                                    m => m.ManualEntryDailyCollectorId,
                                    ViewBag.ApprovedManualEntries as IEnumerable<SelectListItem>,
                                    (ViewBag.ApprovedManualEntries as IEnumerable<SelectListItem>)?.Any() == true
                                        ? "--- Select Approved Batch ---"
                                        : "--- No Approved Batches ---",
                                    new { @class = "form-control select2", id = "ManualEntryDailyCollectorId" } /* required toggled by JS */
                                )
                                <label>@CashDeskRessource.Approved_Daily_Collector_Batch_Cash_Clearance</label>
                                <small class="text-muted d-block mt-1">
                                    @Html.Raw(@CashDeskRessource.Only_batches_with_Status_Approved_and_not_yet_fully_completed_are_listed)
                                </small>
                            </div>
                        </div>
                    }
                    <input type="hidden" id="CustomerAlphaNumber" value="0" />

                    <!-- AML SECTION -->
                    <div class="col-12 mt-2">
                        <fieldset class="fieldset-custom">
                            <legend class="fs-6 text-muted mb-2">
                                <i class="mdi mdi-shield-search me-1"></i> AML / KYC
                            </legend>

                            <div class="row gy-2">
                                <!-- Source of Funds -->
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.SourceOfFundsCode,
                                            ViewBag.SourceOfFunds as IEnumerable<SelectListItem>,
                                            "--- Select Source of Funds / Income ---",
                                            new { @class = "form-control select2 aml-source", id = "SourceOfFundsCode" }
                                        )
                                        <label for="SourceOfFundsCode">Source of Funds (Income Source)</label>
                                        <small class="text-muted d-block mt-1">
                                            Required for AML monitoring (money laundering risk).
                                        </small>
                                    </div>

                                    <div class="form-floating form-floating-outline mt-2 d-none" id="SourceOfFundsOtherWrap">
                                        @Html.TextBoxFor(m => m.SourceOfFundsOther,
                                            new { @class = "form-control shadow-input-boxes", id = "SourceOfFundsOther", placeholder = "Type source of funds..." })
                                        <label for="SourceOfFundsOther">Specify (Other)</label>
                                    </div>
                                </div>

                                <!-- Purpose -->
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.DepositPurposeCode,
                                            ViewBag.DepositPurpose as IEnumerable<SelectListItem>,
                                            "--- Select Deposit Purpose ---",
                                            new { @class = "form-control select2 aml-purpose", id = "DepositPurposeCode" }
                                        )
                                        <label for="DepositPurposeCode">Purpose of Deposit</label>
                                    </div>

                                    <div class="form-floating form-floating-outline mt-2 d-none" id="DepositPurposeOtherWrap">
                                        @Html.TextBoxFor(m => m.DepositPurposeOther,
                                            new { @class = "form-control shadow-input-boxes", id = "DepositPurposeOther", placeholder = "Type purpose..." })
                                        <label for="DepositPurposeOther">Specify (Other)</label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>


                    <div class="table-responsive w-100 compact-section">
                        <fieldset class="fieldset-custom">
                            <div class="table-responsive w-100">
                                <table class="table table-hover" id="myDataTableT">
                                    <thead class="table-light">
                                        <!-- New header row (legend) to match the loans table style -->
                                        <tr>
                                            <th colspan="8" class="text-center fw-bold bg-light text-dark">
                                                @GlobalShared.MEMBERS_ACCOUNTS
                                            </th>
                                        </tr>
                                        <tr>
                                            <th style="display: none;"> @GlobalShared.Product_ID</th>
                                            <th> @GlobalShared.Accounts</th>
                                            <th> @GlobalShared.Balance</th>
                                            <th> @GlobalShared.Amount</th>
                                            <th> @CashDeskRessource.Fee</th>
                                            <th> @GlobalShared.Total</th>
                                            <th> @GlobalShared.Conf</th>
                                            <th> @GlobalShared.Inc</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.BulkDeposits
                                                               .Where(x => !x.AccountType.ToLower().Contains("loan"))
                                                               .OrderBy(t => t.AccountType))
                                        {
                                            <tr>
                                                <td style="display: none;">@d.AccountNumber</td>
                                                <td>@d.AccountType</td>
                                                <td>@d.Balance.ToString("N2")</td>
                                                <td>
                                                    <input type="number"
                                                           class="form-control amount-input shadow-input-boxes"
                                                           value="@d.Amount" />
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           class="form-control fee-input shadow-input-boxes"
                                                           value="@d.Fee" />
                                                </td>
                                                <td><span class="total-span">@d.Total</span></td>
                                                <td><input type="checkbox" class="form-check-input" /></td>
                                                <td><input type="checkbox" class="form-check-input check-inclussive" disabled /></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold">Total:</td>
                                            <td id="tableTotal"><b>@Model.MemberOnboardingDetailDto.GrandTotal.ToString("N0")</b></td>
                                            <td colspan="4"></td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold"> @GlobalShared.Difference:</td>
                                            <td id="tableBalance">0</td>
                                            <td colspan="4"></td>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>

                        </fieldset>
                    </div>

                    <!-- Loan Repayment: reduce top spacing -->
                    <div id="loanRepaymentSection" class="mt-1 d-none compact-section">
                        <fieldset class="fieldset-custom">
                            <!-- ========================= LOAN REPAYMENT SECTION (Hidden by default) ========================= -->
                            <!-- Toolbar: left = search member's loans, right = VAT mode + calculate -->
                            <div class="row">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <!-- Left: Search member’s loans -->
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLoadMemberLoans">
                                        <i class="mdi mdi-magnify me-1"></i> @CashDeskRessource.Load_Members_Loans
                                    </button>

                                    <!-- Right: VAT buttons -->
                                    <div class="btn-group" role="group" aria-label="VAT Mode">
                                        <input class="btn-check" type="radio" name="vatMode" id="vatModeExclusive"
                                               value="exclusive"
                                               onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                                        <label class="btn btn-outline-primary" for="vatModeExclusive">
                                            @GlobalShared.VAT_Exclusive (19.25%)
                                        </label>

                                        <input class="btn-check" type="radio" name="vatMode" id="vatModeInclusive"
                                               value="inclusive" checked
                                               onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                                        <label class="btn btn-outline-primary" for="vatModeInclusive">
                                            @GlobalShared.VAT_Inclusive (16.1425%)
                                        </label>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover" id="myDataTableT2">
                                        <!-- Column widths -->
                                        <colgroup>
                                            <col class="col-hide">        @* LRef (hidden) *@
                                            <col class="col-date">        @* DATE *@
                                            <col class="col-lamount">     @* L.AMOUNT *@
                                            <col class="col-ai">          @* A.I *@
                                            <col class="col-balance">     @* BALANCE *@
                                            <col class="col-capital">     @* CAPITAL input *@
                                            <col class="col-interest">    @* INTEREST input *@
                                            <col class="col-vat">         @* VAT (readonly) *@
                                            <col class="col-penalty">     @* PENALTY input *@
                                            <col class="col-total">       @* TOTAL *@
                                            <col class="col-conf">        @* CONF (smallest) *@
                                        </colgroup>

                                        <thead class="table-light">
                                            <tr>
                                                <th colspan="10" class="text-center fw-bold bg-light text-dark">
                                                    @GlobalLoanRepaymentBackOffice.MEMBERS_OPENED_LOANS
                                                </th>
                                            </tr>
                                            <tr>
                                                <th style="display:none;">@GlobalLoanRepaymentBackOffice.LRef</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Date</th>
                                                <th>@GlobalLoanRepaymentBackOffice.LAmount</th>
                                                <th>@GlobalLoanRepaymentBackOffice.AI</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Balance</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Capital</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Interest</th>
                                                <th>@GlobalLoanRepaymentBackOffice.VAT</th>
                                                <th>Pen</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Total</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Conf</th>
                                            </tr>
                                        </thead>

                                        <tbody id="loanRepaymentTable">
                                            @foreach (var d in Model.Loans)
                                            {
                                                var loanId = d.Id;
                                                <tr id="row-@loanId">
                                                    <!-- hidden ref -->
                                                    <td style="display:none;">@loanId</td>

                                                    <!-- DATE -->
                                                    <td>@d.LoanDate.ToString("dd/MM/yy")</td>

                                                    <!-- L.AMOUNT (also expose data-loan-amount for JS) -->
                                                    <td class="loan-amount" data-loan-amount="@d.LoanAmount">
                                                        @d.LoanAmount.ToString("#,##0.0")
                                                    </td>

                                                    <!-- A.I -->
                                                    <td>@d.AccrualInterest.ToString("#,##0.0")</td>

                                                    <!-- BALANCE -->
                                                    <td>@d.Balance.ToString("#,##0.0")</td>

                                                    <!-- CAPITAL -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm capital-input"
                                                               id="capital-@loanId"
                                                               value="0"
                                                               step="0.01"
                                                               oninput="updateTotals('@loanId')" />
                                                    </td>

                                                    <!-- INTEREST (holds data-loanamount for VAT logic) -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm interest-input"
                                                               id="interest-@loanId"
                                                               value="0"
                                                               data-original="0"
                                                               data-loanamount="@d.LoanAmount"
                                                               oninput="handleInterestInput('@loanId')" />
                                                    </td>

                                                    <!-- VAT (readonly) -->
                                                    <td>
                                                        <input type="text"
                                                               class="form-control form-control-sm vat-input"
                                                               id="vat-@loanId"
                                                               value="0"
                                                               readonly />
                                                    </td>

                                                    <!-- PENALTY -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm penalty-input"
                                                               id="penalty-@loanId"
                                                               value="0"
                                                               step="0.01"
                                                               oninput="updateTotals('@loanId')" />
                                                    </td>

                                                    <!-- TOTAL -->
                                                    <td class="text-end">
                                                        <span class="total-span" id="total-@loanId">0</span>
                                                    </td>

                                                    <!-- CONF -->
                                                    <td class="text-center">
                                                        <input type="checkbox"
                                                               class="form-check-input loan-confirmation-checkbox"
                                                               onchange="updateTotals()" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <td colspan="8" class="text-end fw-bold">
                                                    @GlobalLoanRepaymentBackOffice.OverallTotalRepayment:
                                                </td>
                                                <td id="totalRepaymentAmount" class="text-end">0</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>

                                    </table>
                                </div>

                            </div>

                            <!-- ======================= / LOAN REPAYMENT SECTION ======================= -->

                        </fieldset>
                    </div>


                    <script>
                        (() => {
                            // -------- Constants --------
                            const LOAN_VAT_THRESHOLD = 2000000; // VAT applies only when loan amount >= 2,000,000
                            const VAT_EXCLUSIVE_RATE = 19.25;   // VAT on net interest
                            const VAT_INCLUSIVE_RATE = 16.1425; // VAT portion inside a VAT-inclusive amount

                            // Safe number parser
                            const toNumber = (v) => (v == null ? 0 : (parseFloat(String(v).replace(/,/g, '')) || 0));

                            // VAT mode: 'exclusive' | 'inclusive' | null
                            const getVatMode = () => {
                                const r = document.querySelector('input[name="vatMode"]:checked');
                                return r ? r.value : null;
                            };

                            // Called when user types interest — ONLY stores raw (gross) input, clears VAT
                            function handleInterestInput(loanId) {
                                const interestEl = document.getElementById(`interest-${loanId}`);
                                if (!interestEl) return;

                                const entered = toNumber(interestEl.value);
                                interestEl.dataset.gross = String(entered);     // remember what user typed

                                const vatEl = document.getElementById(`vat-${loanId}`);
                                if (vatEl) vatEl.value = "0";                   // clear VAT until mode is applied

                                updateRowTotal(loanId);
                                updateGrandTotals();
                            }

                            // Apply VAT for a single row given a mode
                            function applyVatForRow(loanId, mode) {
                                const interestEl = document.getElementById(`interest-${loanId}`);
                                const vatEl = document.getElementById(`vat-${loanId}`);
                                if (!interestEl || !vatEl) return;

                                const loanAmount = toNumber(interestEl.dataset.loanamount);
                                let gross = toNumber(interestEl.dataset.gross);
                                if (!gross) {                                   // fallback if user never typed yet
                                    gross = toNumber(interestEl.value);
                                    interestEl.dataset.gross = String(gross);
                                }

                                let vat = 0;

                                if (loanAmount >= LOAN_VAT_THRESHOLD && (mode === 'exclusive' || mode === 'inclusive')) {
                                    if (mode === 'exclusive') {
                                        // Exclusive: interest remains gross; VAT is added separately
                                        interestEl.value = Math.round(gross);
                                        vat = Math.round(gross * (VAT_EXCLUSIVE_RATE / 100));
                                    } else {
                                        // Inclusive: compute VAT portion inside gross, reduce interest to net
                                        vat = Math.round(gross * (VAT_INCLUSIVE_RATE / 100));
                                        const net = Math.max(0, Math.round(gross - vat));
                                        interestEl.value = net;
                                    }
                                } else {
                                    // Not eligible => no VAT
                                    interestEl.value = Math.round(gross);
                                    vat = 0;
                                }

                                // Keep row VAT strictly numeric
                                vatEl.value = String(vat);

                                updateRowTotal(loanId);
                            }

                            // Apply the currently selected VAT mode to ALL rows
                            function applyVatModeToAllRows() {
                                const mode = getVatMode(); // may be null
                                document.querySelectorAll('#loanRepaymentTable tr').forEach(row => {
                                    const loanId = row.id.replace('row-', '');
                                    if (loanId) applyVatForRow(loanId, mode);
                                });
                                updateGrandTotals();
                            }

                            // Update one row total (capital + interest + vat + penalty)
                            function updateRowTotal(loanId) {
                                const interest = toNumber(document.getElementById(`interest-${loanId}`)?.value);
                                const vat = toNumber(document.getElementById(`vat-${loanId}`)?.value);
                                const capital = toNumber(document.getElementById(`capital-${loanId}`)?.value);
                                const penalty = toNumber(document.getElementById(`penalty-${loanId}`)?.value);

                                const total = capital + interest + vat + penalty;

                                // Keep row TOTAL strictly numeric
                                const span = document.getElementById(`total-${loanId}`);
                                if (span) span.innerText = String(total);
                            }

                            // Grand totals (footer only)
                            function updateGrandTotals() {
                                let totalRepayment = 0;

                                document.querySelectorAll("#loanRepaymentTable tr").forEach(row => {
                                    const id = row.id.replace("row-", "");
                                    const interest = toNumber(document.getElementById(`interest-${id}`)?.value);
                                    const vat = toNumber(document.getElementById(`vat-${id}`)?.value);
                                    const capital = toNumber(document.getElementById(`capital-${id}`)?.value);
                                    const penalty = toNumber(document.getElementById(`penalty-${id}`)?.value);

                                    totalRepayment += capital + interest + vat + penalty;
                                });

                                const totalCell = document.getElementById("totalRepaymentAmount");
                                if (totalCell) {
                                    totalCell.innerText = (typeof formatCurrencyNoName === 'function')
                                        ? formatCurrencyNoName(totalRepayment)
                                        : totalRepayment.toLocaleString('en-US');
                                }
                            }

                            // Expose for inline calls
                            window.handleInterestInput = handleInterestInput;
                            window.applyVatModeToAllRows = applyVatModeToAllRows;
                            window.updateTotals = function (loanId) { if (loanId) updateRowTotal(loanId); updateGrandTotals(); };

                            // Wire listeners once DOM is ready
                            document.addEventListener('DOMContentLoaded', () => {
                                // Row listeners
                                document.querySelectorAll('#loanRepaymentTable tr').forEach(row => {
                                    const id = row.id.replace('row-', '');
                                    document.getElementById(`capital-${id}`)?.addEventListener('input', () => { updateRowTotal(id); updateGrandTotals(); });
                                    document.getElementById(`penalty-${id}`)?.addEventListener('input', () => { updateRowTotal(id); updateGrandTotals(); });
                                    document.getElementById(`interest-${id}`)?.addEventListener('input', () => handleInterestInput(id));
                                });

