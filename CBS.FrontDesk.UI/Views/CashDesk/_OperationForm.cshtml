else if (ViewBag.Operation == "loanapplicationfeepayment")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: green">LOAN FEE</legend>
            <hr style="border: 2px solid green;" />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">Member's name: @Model.Customer.name</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>
                </div>
                <hr style="border: 2px solid green;" />
                @if (!Model.LoanApplicationFees.Any())
                {

                    <div class="text-center my-3">
                        <p>@Model.Customer.name has no pending loadn fee. <br /><i>Oops!!!</i> </p>
                    </div>
                }
                else
                {
                    var GTotal = 0;
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <tr>
                                <th style="display:none;">FeeRangeId</th>
                                <th style="display:none;">LoanApplocationId</th>
                                <th style="display:none;">Period</th>
                                <th>Fee Label</th>
                                <th>Amount</th>
                                <th style="display:none;">Fee/Charges</th>
                                <th>Total</th>
                                <th>Conf</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.LoanApplicationFees.GroupBy(fee => fee.Period))
                            {
                                
                                decimal periodTotal = 0;
                                <tr class="period-group">
                                    <td colspan="8"><strong>@d.Key</strong></td>
                                </tr>
                                foreach (var fee in d)
                                {
                                    periodTotal += fee.FeeAmount;
                                    <tr>
                                        <td style="display:none;">@fee.Id</td>
                                        <td style="display:none;">
                                            <input type="text" class="form-control loan-application-id shadow-input-boxes" value="@fee.LoanApplicationId">
                                        </td>
                                        <td style="display:none;">
                                            <input type="text" class="form-control period shadow-input-boxes" value="@fee.Period">
                                        </td>
                                        <td>@fee.FeeLable</td>
                                        <td>
                                            <input type="number" class="form-control amount-input shadow-input-boxes" value="@fee.FeeAmount">
                                        </td>
                                        <td style="display:none;">
                                            <input type="number" class="form-control fee-input shadow-input-boxes" value="0">
                                        </td>
                                        <td>
                                            <span class="total-span">@fee.FeeAmount</span>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input">
                                        </td>
                                    </tr>
                                }
                                <tr class="period-total">
                                    <td colspan="2" style="text-align: right;"><strong>Total:</strong></td>
                                    <td style="color:blue"><b>@periodTotal.ToString("#,##0.0")</b></td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="text-align: right;"><strong>Total:</strong></td>
                                <td id="tableTotal">0</td>
                                <td style="color:blue"><b>G.T: @Model.LoanApplicationFees.Sum(x => x.FeeAmount).ToString("#,##0.0")</b></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="text-align: right;"><strong>Balance:</strong></td>
                                <td id="tableBalance">0</td>
                            </tr>
                        </tfoot>
                    </table>

                }
            </div>
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="LoanFee" id="OperationType" />
                <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostFEE()">
                    <i class="fas fa-money-bill-wave me-1"></i> PAY FEE
                </button>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> Re-print
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> Reset
                </button>
            </div>
            <hr style="border: 2px solid green;" />
        </fieldset>
    </div>

}


