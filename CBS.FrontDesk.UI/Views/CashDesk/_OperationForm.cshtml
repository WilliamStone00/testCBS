                    interestGross: gross,
                    rowVatRate,
                    mode
                });

                // For inclusive mode, the input should show NET (once applied)
                if (mode === 'inclusive' && $interest) {
                    $interest.value = interestNet;
                    $interest.dataset.gross = String(gross); // remember the user-entered gross
                }

                // Keep VAT numeric in row state (no visible VAT column in this table)
                tr.dataset.vat = String(vat);

                const total = capitalVal + (mode === 'inclusive' ? interestNet : interestVal) + penaltyVal + vat;
                const totalSpan = document.getElementById(`total-${id}`);
                if (totalSpan) totalSpan.textContent = String(total); // keep numeric

                return { total, vat };
            }

            // Recompute footer: Calculated VAT + Total (formatted)
            function recomputeFooters() {
                let sumTotal = 0, sumVat = 0;
                document.querySelectorAll('#myDataTableT tbody tr').forEach(tr => {
                    sumTotal += toNumber(tr.querySelector('.total-span')?.textContent);
                    sumVat += toNumber(tr.dataset?.vat);
                });

                const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = fmt(val); };
                setText('tableTotal', sumTotal);
                setText('calculatedVat', sumVat);
                // 'tableBalance' remains handled elsewhere
            }

            // --------- Functions referenced in your markup ---------
            // While typing interest: preview VAT/total without forcing net value yet
            window.previewVat = function (rowId, val /* , rowVatRate, loanAmount (ignored) */) {
                const tr = document.getElementById(`row-${rowId}`);
                if (!tr) return;

                const mode = getVatMode();
                const interestGross = toNumber(val);

                // Get row VatRate from the row’s last cell (authoritative)
                const rowVatRate = toNumber(tr.querySelector('td:last-child')?.textContent);

                const { vat, interestNet } = computeVatForRow({
                    interestGross,
                    rowVatRate,
                    mode
                });

                // stash gross for blur-apply; during preview we DON'T overwrite the input
                const $interest = document.getElementById(`interest-${rowId}`);
                if ($interest) $interest.dataset.gross = String(interestGross);

                tr.dataset.vat = String(vat);

                const capitalVal = toNumber(document.getElementById(`capital-${rowId}`)?.value);
                const penaltyVal = toNumber(document.getElementById(`penalty-${rowId}`)?.value);
                const total = capitalVal + (mode === 'inclusive' ? interestNet : interestGross) + penaltyVal + vat;

                const $total = document.getElementById(`total-${rowId}`);
                if ($total) $total.textContent = String(total); // keep numeric
                recomputeFooters();
            };

            // On blur: apply/lock the net (for inclusive) and recompute
            window.applyVatAdjustment = function (rowId) {
                const tr = document.getElementById(`row-${rowId}`);
                if (!tr) return;
                recomputeRowTotal(tr);
                recomputeFooters();
            };

            // When user toggles VAT mode, apply to all rows
            window.applyVatModeToAllRows = function () {
                document.querySelectorAll('#myDataTableT tbody tr').forEach(tr => {
                    recomputeRowTotal(tr);
                });
                recomputeFooters();
            };

            // Wire input listeners so totals stay live
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('#myDataTableT tbody tr').forEach(tr => {
                    const id = (tr.id || '').replace('row-', '');
                    document.getElementById(`capital-${id}`)?.addEventListener('input', () => { recomputeRowTotal(tr); recomputeFooters(); });
                    document.getElementById(`penalty-${id}`)?.addEventListener('input', () => { recomputeRowTotal(tr); recomputeFooters(); });
                    // interest handled by previewVat()/applyVatAdjustment() via your existing inline handlers
                });

                // Apply once on load with current (inclusive) default
                applyVatModeToAllRows();
            });
        })();
    </script>*@

