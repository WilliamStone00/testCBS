else if (ViewBag.Operation == "repayment")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend>LOAN REPAYMENT</legend>
            <hr style="border: 2px solid green;" />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">Member's name: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                            <input type="hidden" class="form-control vat-input shadow-input-boxes" id="vatRate" value="0"> <!-- Ensure the vatRate is set dynamically -->
                        </div>
                    </div>
                    <div class="table-responsive" style="width: 100%;">
                        <table class="table table-hover" id="myDataTableT">
                            <thead class="table-light">
                                <tr>
                                    <th style="display:none;">LoanId</th>
                                    <th>Date</th>
                                    <th style="display:none;">Amount</th> <!-- Hide Amount column -->
                                    <th>Balance</th>
                                    <th>Int</th>
                                    <th style="display:none;">V.Rate</th> <!-- Hide V.Rate column -->
                                    <th style="display:none;">Due A</th> <!-- Hide Due A column -->
                                    <th>Enter Capital</th>
                                    <th>Enter Interest</th>
                                    <th>Enter Penalty</th> <!-- Added Penalty input column -->
                                    <th>Total</th>
                                    <th>Conf</th>
                                    <!--<th>Action</th>--> <!-- New Action column -->
                                    <th>Details</th> <!-- New Details column -->
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Loans)
                                {
                                    <tr id="row-@d.Id">
                                        <td style="display:none;">@d.Id</td>
                                        <td>@d.LoanDate.ToString("dd/MM/yy")</td>
                                        <td style="display:none;">@d.LoanAmount.ToString("#,##0.0")</td> <!-- Hide Amount column -->
                                        <td>@d.Balance.ToString("#,##0.0")</td>
                                        <td>@d.AccrualInterest.ToString("#,##0.0")</td>
                                        <td style="display:none;">@d.VatRate.ToString("#,##0.00")</td> <!-- Hide V.Rate column -->
                                        <td style="display:none;">@d.DueAmount.ToString("#,##0.0")</td> <!-- Hide Due A column -->
                                        <td>
                                            <input type="number" class="form-control amount-input shadow-input-boxes" id="capital-@d.Id" value="0">
                                        </td>
                                        <td>
                                            <input type="number" class="form-control interest-input shadow-input-boxes" id="interest-@d.Id" value="0" oninput="calculateVat(this, @d.VatRate)">
                                        </td>
                                        <td>
                                            <!-- Penalty input field -->
                                            <input type="number" class="form-control penalty-input shadow-input-boxes" id="penalty-@d.Id" value="0">
                                        </td>
                                        <td>
                                            <span class="total-span" id="total-@d.Id">0</span>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input">
                                        </td>
                                        @*<td>
                                <button type="button" class="btn btn-primary" onclick="openPaymentModal('@d.Id', @d.AccrualInterest, @d.Balance)">Pay</button>
                            </td>*@
                                        <td>
                                            <!-- Details Button -->
                                            <button type="button" class="btn btn-info btn-sm" onclick='showLoanDetails(@Html.Raw(Json.Encode(d)))'>Details</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" style="text-align: right;"><strong>Total:</strong></td>
                                    <td id="tableTotal">0</td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="text-align: right;"><strong>Balance:</strong></td>
                                    <td id="tableBalance">0</td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="text-align: right;"><strong>Calculated VAT:</strong></td>
                                    <td id="calculatedVat">0</td> <!-- This will display the calculated VAT -->
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Loan Details Modal -->
                    <div class="modal fade" id="loanDetailsModal" tabindex="-1" role="dialog" aria-labelledby="loanDetailsModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content shadow-lg border-0">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title" id="loanDetailsModalLabel">📋 Loan Details</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <!-- Loan Details Section -->
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            <div class="card bg-light shadow-sm">
                                                <div class="card-body text-center">
                                                    <h6 class="card-title text-muted mb-1">Loan Date</h6>
                                                    <h4 class="card-text text-dark" id="detailLoanDate">N/A</h4>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card bg-light shadow-sm">
                                                <div class="card-body text-center">
                                                    <h6 class="card-title text-muted mb-1">Amount</h6>
                                                    <h4 class="card-text text-dark" id="detailLoanAmount">XAF 0</h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            <div class="card bg-light shadow-sm">
                                                <div class="card-body text-center">
                                                    <h6 class="card-title text-muted mb-1">Balance</h6>
                                                    <h4 class="card-text text-dark" id="detailBalance">XAF 0</h4>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card bg-light shadow-sm">
                                                <div class="card-body text-center">
