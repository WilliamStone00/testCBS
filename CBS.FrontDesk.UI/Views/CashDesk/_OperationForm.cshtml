                    </button>
                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="ReprintLoan()">
                        <i class="fas a-print me-1"></i> @GlobalShared.Re_print
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                    </button>
                </div>

                <hr style="border: 2px solid green;" />
                <script>
                    (() => {
                        const toN = v => (v == null ? 0 : (parseFloat(String(v).replace(/,/g, '')) || 0));
                        const fmt = n => (n || 0).toLocaleString('en-US');
                        const mode = () => (document.querySelector('input[name="vatMode"]:checked')?.value || null); // 'exclusive'|'inclusive'|null

                        // VAT math using the row's VatRate% (last cell)
                        function calcVat(interestGross, rate, m) {
                            if (!(rate > 0) || (m !== 'exclusive' && m !== 'inclusive')) {
                                return { vat: 0, net: interestGross };
                            }
                            if (m === 'exclusive') {
                                const vat = Math.round(interestGross * (rate / 100));
                                return { vat, net: interestGross };
                            }
                            // inclusive: VAT portion inside gross = gross * r/(100+r)
                            const vat = Math.round(interestGross * (rate / (100 + rate)));
                            return { vat, net: Math.max(0, Math.round(interestGross - vat)) };
                        }

                        function getRowRate(tr) {
                            return toN(tr.querySelector('td:last-child')?.textContent);
                        }

                        // Ensure we always have the original GROSS the user typed
                        function ensureGrossStored(input) {
                            const v = toN(input.value);
                            if (!input.dataset.gross) input.dataset.gross = String(v);
                            return toN(input.dataset.gross);
                        }

                        // Recompute a single row & keep row total numeric (no formatting)
                        function recomputeRow(tr) {
                            const id = (tr.id || '').replace('row-', '');
                            const $int = document.getElementById(`interest-${id}`);
                            const $cap = document.getElementById(`capital-${id}`);
                            const $pen = document.getElementById(`penalty-${id}`);

                            if (!$int) return { total: 0, vat: 0, checked: false };

                            const gross = ensureGrossStored($int);              // original gross the user entered
                            const r = getRowRate(tr);
                            const m = mode();

                            const { vat, net } = calcVat(gross, r, m);

                            // Apply display rule:
                            // - Exclusive: show original gross (no change)
                            // - Inclusive: show NET (once applied)
                            if (m === 'exclusive') {
                                $int.value = String(gross);
                            } else if (m === 'inclusive') {
                                $int.value = String(net);
                            }

                            tr.dataset.vat = String(vat);

                            const cap = toN($cap?.value);
                            const pen = toN($pen?.value);
                            const interestForTotal = (m === 'inclusive') ? net : gross; // exclusive uses gross as entered

                            const total = cap + interestForTotal + pen + vat;
                            const $tot = document.getElementById(`total-${id}`);
                            if ($tot) $tot.textContent = String(total);

                            const checked = !!tr.querySelector('input.form-check-input')?.checked;
                            return { total, vat, checked };
                        }

                        // Sum rule:
                        // - If at least one row is checked -> sum ONLY checked
                        // - Else -> sum ALL rows
                        function recomputeFooters() {
                            const rows = Array.from(document.querySelectorAll('#myDataTableT tbody tr'));
                            const anyChecked = rows.some(tr => tr.querySelector('input.form-check-input')?.checked);

                            let sumT = 0, sumV = 0;
                            rows.forEach(tr => {
                                const use = anyChecked ? (tr.querySelector('input.form-check-input')?.checked) : true;
                                if (!use) return;
                                sumT += toN(tr.querySelector('.total-span')?.textContent);
                                sumV += toN(tr.dataset.vat);
                            });

                            const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = fmt(val); };
                            set('tableTotal', sumT);
                            set('calculatedVat', sumV);

                            const notes = toN(document.getElementById('totalNoteAmount')?.value);
                            set('tableBalance', notes - sumT);
                        }

                        // Public hooks used by your markup
                        window.previewVat = function (rowId, val) {
                            const tr = document.getElementById(`row-${rowId}`);
                            if (!tr) return;
                            // store latest gross while typing
                            const $int = document.getElementById(`interest-${rowId}`);
                            if ($int) $int.dataset.gross = String(toN(val));
                            // show a live preview based on current mode
                            recomputeRow(tr);
                            recomputeFooters();
                        };

                        window.applyVatAdjustment = function (rowId) {
                            const tr = document.getElementById(`row-${rowId}`);
                            if (!tr) return;
                            // lock result for the chosen mode
                            recomputeRow(tr);
                            recomputeFooters();
                        };

                        window.applyVatModeToAllRows = function () {
                            document.querySelectorAll('#myDataTableT tbody tr').forEach(tr => {
                                // On mode switch, we always recalc from stored gross (so exclusive restores it)
                                recomputeRow(tr);
                            });
                            recomputeFooters();
                        };

                        // Wire up row inputs & checkboxes
                        document.addEventListener('DOMContentLoaded', () => {
                            document.querySelectorAll('#myDataTableT tbody tr').forEach(tr => {
                                const id = (tr.id || '').replace('row-', '');

                                // on first load, store the current interest as gross
                                const $int = document.getElementById(`interest-${id}`);
                                if ($int) ensureGrossStored($int);

                                document.getElementById(`capital-${id}`)?.addEventListener('input', () => { recomputeRow(tr); recomputeFooters(); });
                                document.getElementById(`penalty-${id}`)?.addEventListener('input', () => { recomputeRow(tr); recomputeFooters(); });
                                tr.querySelector('input.form-check-input')?.addEventListener('change', () => { recomputeRow(tr); recomputeFooters(); });
                            });

                            // Recompute immediately when VAT option is clicked/changed
                            document.querySelectorAll('input[name="vatMode"]').forEach(r => {
                                r.addEventListener('change', applyVatModeToAllRows);
                                r.addEventListener('click', applyVatModeToAllRows);
                            });

                            // Initial pass (whatever default radio is)
                            applyVatModeToAllRows();
                        });
                    })();
                </script>

            </div>
        </fieldset>
    </div>


}
