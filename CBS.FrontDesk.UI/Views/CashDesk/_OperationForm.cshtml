<script>
    (function () {
        function toggleManualBatchVisibility() {
            var value = $('input[name="DailyCollectorCollectApproach"]:checked').val() || '';
            var $wrap = $('#manualBatchWrapper');
            var $ddl = $('#ManualEntryDailyCollectorId');

            if (value === 'Manual') {
                $wrap.removeClass('d-none');
                $ddl.prop('required', true);
            } else {
                $wrap.addClass('d-none');
                $ddl.prop('required', false).val('').trigger('change');
            }
        }

        $(document).ready(function () {
            // Hide on load unless model already set to 'Manual'
            toggleManualBatchVisibility();
            $('#collectionApproachGroup input[type=radio]').on('change', toggleManualBatchVisibility);
        });
    })();
</script>
<script>
    // Hide on load (defensive; also styled with d-none)
    document.addEventListener('DOMContentLoaded', function () {
        const sec = document.getElementById('loanRepaymentSection');
        if (sec) sec.classList.add('d-none');
        const includeHidden = document.getElementById('IncludeLoanRepayment');
        if (includeHidden) includeHidden.value = "false";
    });

    function toggleLoanRepayment() {
        const checked = document.getElementById('includeLoanRepaymentCheckbox').checked;
        document.getElementById('IncludeLoanRepayment').value = checked ? "true" : "false";
        const sec = document.getElementById('loanRepaymentSection');
        if (!sec) return;
        if (checked) {
            sec.classList.remove('d-none');
        } else {
            sec.classList.add('d-none');
            resetLoanSectionValues();
        }
        recalcLoanTotals();
    }

    function resetLoanSectionValues() {
        // Zero-out inputs and totals when hidden (prevents stale amounts)
        document.querySelectorAll('#loanRepaymentSection input[type="number"]').forEach(i => i.value = "0");
        document.querySelectorAll('#loanRepaymentSection input[type="checkbox"]').forEach(i => i.checked = false);
        document.querySelectorAll('#loanRepaymentSection .total-span').forEach(s => s.textContent = "0");
        const t = document.getElementById('loanTableTotal'); if (t) t.textContent = "0";
        const b = document.getElementById('loanTableBalance'); if (b) b.textContent = "0";
        const v = document.getElementById('calculatedVat'); if (v) v.textContent = "0";
    }

    function recalcLoanRow(loanId) {
        // Read row amounts
        const cap = parseFloat(document.getElementById(`capital-${loanId}`)?.value || "0");
        const intv = parseFloat(document.getElementById(`interest-${loanId}`)?.value || "0");
        const pen = parseFloat(document.getElementById(`penalty-${loanId}`)?.value || "0");

        // If you also compute VAT per row, you can read a per-row VAT span here:
        // const vat = parseFloat(document.getElementById(`vat-${loanId}`)?.textContent || "0");
        // For now, just sum principal+interest+penalty
        const total = (cap + intv + pen);
        const totalSpan = document.getElementById(`total-${loanId}`);
        if (totalSpan) totalSpan.textContent = total.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });

        recalcLoanTotals();
    }

    function recalcLoanTotals() {
        let total = 0;
        document.querySelectorAll('#loanRepaymentSection tbody tr').forEach(tr => {
            // If you require confirmation to include in totals, gate here:
            const useRow = tr.querySelector('.confirm-loan')?.checked ?? true;
            const totalCell = tr.querySelector('.total-span');
            const val = parseFloat((totalCell?.textContent || "0").replace(/,/g, ""));
            if (useRow) total += (isNaN(val) ? 0 : val);
        });

        const totalEl = document.getElementById('loanTableTotal');
        if (totalEl) totalEl.textContent = total.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });

        // If you want the "Balance" row to reflect difference vs. entered cash, wire it to your cash-in amount:
        const enteredCash = parseFloat(document.getElementById('totalNoteAmount')?.value || "0");
        const bal = (enteredCash - total);
        const balEl = document.getElementById('loanTableBalance');
        if (balEl) balEl.textContent = bal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    }
    // Load loans for the member
    function loadMemberLoans() {
        var memberId = $("#customerId").val(); // hidden field from your form
        if (!memberId) {
            alert("⚠️ Member ID is missing.");
            return;
        }

        $.getJSON("/CashDesk/GetMemberLoans", { memberId: memberId })
            .done(function (res) {
                if (!res.success) {
                    alert(res.message || "❌ Failed to load loans.");
                    return;
                }

                const tbody = $("#loanRepaymentTable");
                tbody.empty(); // clear existing

                const fmt = (n) => (Number(n) || 0).toLocaleString('en-US', { maximumFractionDigits: 1 });

                res.data.forEach(function (loan) {
                    const id = loan.Id;
                    const rowHtml = `
                      <tr id="row-${id}">
                        <!-- hidden LRef -->
                        <td style="display:none;">${id}</td>

                        <!-- DATE -->
                        <td>${loan.LoanDate}</td>

                        <!-- L.AMOUNT (with data-loan-amount for VAT threshold check) -->
                        <td class="loan-amount" data-loan-amount="${loan.LoanAmount}">
                          ${fmt(loan.LoanAmount)}
                        </td>

                        <!-- A.I -->
                        <td>${fmt(loan.AccrualInterest)}</td>

                        <!-- BALANCE -->
                        <td>${fmt(loan.Balance)}</td>

                        <!-- CAPITAL -->
                        <td>
                          <input type="number"
                                 class="form-control capital-input"
                                 id="capital-${id}"
                                 value="0"
                                 step="0.01"
                                 oninput="updateTotals('${id}')" />
                        </td>

                        <!-- INTEREST (holds data-loanamount for VAT calc) -->
                        <td>
                          <input type="number"
                                 class="form-control interest-input"
                                 id="interest-${id}"
                                 value="0"
                                 data-original="0"
                                 data-loanamount="${loan.LoanAmount}"
                                 oninput="handleInterestInput('${id}')" />
                        </td>

                        <!-- VAT (readonly) -->
                        <td>
                          <input type="text"
                                 class="form-control vat-input"
                                 id="vat-${id}"
                                 value="0"
                                 readonly />
                        </td>

                        <!-- PENALTY -->
                        <td>
                          <input type="number"
                                 class="form-control penalty-input"
                                 id="penalty-${id}"
                                 value="0"
                                 step="0.01"
                                 oninput="updateTotals('${id}')" />
                        </td>

                        <!-- TOTAL (right-aligned to match footer) -->
                        <td class="text-end">
                          <span class="total-span" id="total-${id}">0</span>
                        </td>

                        <!-- CONF -->
                        <td class="text-center">
                          <input type="checkbox"
                                 class="form-check-input loan-confirmation-checkbox"
                                 onchange="updateTotals()" />
                        </td>
                      </tr>`;

                    tbody.append(rowHtml);
                });

                // reset footer cells
                $("#totalRepaymentAmount").text("0");
                $("#remainingBalance").text("0");
                $("#balanceIndicator").text("❌").css("color", "red");
                $("#calculatedVat").text("0");

                // recompute once
                if (typeof updateGrandTotals === "function") {
                    updateGrandTotals();
                }
            })
            .fail(function () {
                alert("❌ Server error while fetching loans.");
            });
    }

    // Bind button
    $(document).on("click", "#btnLoadMemberLoans", loadMemberLoans);
</script>
<script>
    (() => {
        // -------- Constants --------
        const LOAN_VAT_THRESHOLD = 2000000; // VAT applies only when loan amount >= 2,000,000
        const VAT_EXCLUSIVE_RATE = 19.25;   // VAT on net interest
        const VAT_INCLUSIVE_RATE = 16.1425; // VAT portion inside a VAT-inclusive amount

        // Safe number parser
        const toNumber = (v) => (v == null ? 0 : (parseFloat(String(v).replace(/,/g, '')) || 0));

        // VAT mode: 'exclusive' | 'inclusive' | null
        const getVatMode = () => {
            const r = document.querySelector('input[name="vatMode"]:checked');
            return r ? r.value : null;
        };

        // Called when user types interest — ONLY stores raw (gross) input, clears VAT
        function handleInterestInput(loanId) {
            const interestEl = document.getElementById(`interest-${loanId}`);
            if (!interestEl) return;

            const entered = toNumber(interestEl.value);
            interestEl.dataset.gross = String(entered);     // remember what user typed

            const vatEl = document.getElementById(`vat-${loanId}`);
            if (vatEl) vatEl.value = "0";                   // clear VAT until mode is applied

            updateRowTotal(loanId);
            updateGrandTotals();
        }

        // Apply VAT for a single row given a mode
        function applyVatForRow(loanId, mode) {
            const interestEl = document.getElementById(`interest-${loanId}`);
            const vatEl = document.getElementById(`vat-${loanId}`);
            if (!interestEl || !vatEl) return;

            const loanAmount = toNumber(interestEl.dataset.loanamount);
            let gross = toNumber(interestEl.dataset.gross);
            if (!gross) {                                   // fallback if user never typed yet
                gross = toNumber(interestEl.value);
                interestEl.dataset.gross = String(gross);
            }

            let vat = 0;

            if (loanAmount >= LOAN_VAT_THRESHOLD && (mode === 'exclusive' || mode === 'inclusive')) {
                if (mode === 'exclusive') {
                    // Exclusive: interest remains gross; VAT is added separately
                    interestEl.value = Math.round(gross);
                    vat = Math.round(gross * (VAT_EXCLUSIVE_RATE / 100));
                } else {
                    // Inclusive: compute VAT portion inside gross, reduce interest to net
                    vat = Math.round(gross * (VAT_INCLUSIVE_RATE / 100));
                    const net = Math.max(0, Math.round(gross - vat));
                    interestEl.value = net;
                }
            } else {
                // Not eligible => no VAT
                interestEl.value = Math.round(gross);
                vat = 0;
            }

            // Keep row VAT strictly numeric
            vatEl.value = String(vat);

            updateRowTotal(loanId);
        }

        // Apply the currently selected VAT mode to ALL rows
        function applyVatModeToAllRows() {
            const mode = getVatMode(); // may be null
            document.querySelectorAll('#loanRepaymentTable tr').forEach(row => {
                const loanId = row.id.replace('row-', '');
                if (loanId) applyVatForRow(loanId, mode);
            });
            updateGrandTotals();
        }

        // Update one row total (capital + interest + vat + penalty)
        function updateRowTotal(loanId) {
            const interest = toNumber(document.getElementById(`interest-${loanId}`)?.value);
            const vat = toNumber(document.getElementById(`vat-${loanId}`)?.value);
            const capital = toNumber(document.getElementById(`capital-${loanId}`)?.value);
            const penalty = toNumber(document.getElementById(`penalty-${loanId}`)?.value);

            const total = capital + interest + vat + penalty;

            // Keep row TOTAL strictly numeric
            const span = document.getElementById(`total-${loanId}`);
            if (span) span.innerText = String(total);
        }

        // Grand totals (footer only)
        function updateGrandTotals() {
            let totalRepayment = 0;

            document.querySelectorAll("#loanRepaymentTable tr").forEach(row => {
                const id = row.id.replace("row-", "");
                const interest = toNumber(document.getElementById(`interest-${id}`)?.value);
                const vat = toNumber(document.getElementById(`vat-${id}`)?.value);
                const capital = toNumber(document.getElementById(`capital-${id}`)?.value);
                const penalty = toNumber(document.getElementById(`penalty-${id}`)?.value);

                totalRepayment += capital + interest + vat + penalty;
            });

            const totalCell = document.getElementById("totalRepaymentAmount");
            if (totalCell) {
                totalCell.innerText = (typeof formatCurrencyNoName === 'function')
                    ? formatCurrencyNoName(totalRepayment)
                    : totalRepayment.toLocaleString('en-US');
            }
        }

        // Expose for inline calls
        window.handleInterestInput = handleInterestInput;
        window.applyVatModeToAllRows = applyVatModeToAllRows;
        window.updateTotals = function (loanId) { if (loanId) updateRowTotal(loanId); updateGrandTotals(); };

        // Wire listeners once DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            // Row listeners
            document.querySelectorAll('#loanRepaymentTable tr').forEach(row => {
                const id = row.id.replace('row-', '');
                document.getElementById(`capital-${id}`)?.addEventListener('input', () => { updateRowTotal(id); updateGrandTotals(); });
                document.getElementById(`penalty-${id}`)?.addEventListener('input', () => { updateRowTotal(id); updateGrandTotals(); });
                document.getElementById(`interest-${id}`)?.addEventListener('input', () => handleInterestInput(id));
            });

            // VAT radios (if you still have them hidden in the toolbar)
            document.querySelectorAll('input[name="vatMode"]').forEach(r => {
                r.addEventListener('change', applyVatModeToAllRows);
                r.addEventListener('click', applyVatModeToAllRows);
            });

            // Default to Inclusive
            const inclusiveRadio = document.getElementById('vatModeInclusive');
            if (inclusiveRadio) inclusiveRadio.checked = true;
            applyVatModeToAllRows();

            updateGrandTotals();
        });
    })();
</script>

