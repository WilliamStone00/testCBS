@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    var isNewSubscription = ViewBag.Operation?.ToString()?.ToLower() == "newsubcription";
}

<style>
    /* Let browser auto-fit based on content & header */
    #myDataTableT2 {
        table-layout: auto; /* auto sizing, not fixed */
        width: 100%;
    }

        #myDataTableT2 thead th,
        #myDataTableT2 tbody td,
        #myDataTableT2 tfoot td {
            white-space: nowrap; /* prevent wrapping */
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
            padding: .4rem .6rem; /* consistent compact padding */
        }

            /* Right-align numeric columns */
            #myDataTableT2 th:nth-child(3),
            #myDataTableT2 th:nth-child(4),
            #myDataTableT2 th:nth-child(5),
            #myDataTableT2 th:nth-child(10),
            #myDataTableT2 td:nth-child(3),
            #myDataTableT2 td:nth-child(4),
            #myDataTableT2 td:nth-child(5),
            #myDataTableT2 td:nth-child(10),
            #myDataTableT2 tfoot td:nth-child(9) {
                text-align: right;
            }

        /* Keep CONF column narrow */
        #myDataTableT2 th:last-child,
        #myDataTableT2 td:last-child {
            text-align: center;
            width: 3rem; /* force smallest */
        }

        /* Inputs smaller and consistent */
        #myDataTableT2 .form-control.form-control-sm {
            padding: .25rem .4rem;
            height: 2rem;
            font-size: .85rem;
        }

    @@media (max-width: 992px) {
        #myDataTableT2 {
            font-size: .8rem; /* shrink font on smaller screens */
        }

            #myDataTableT2 .form-control.form-control-sm {
                font-size: .75rem;
            }
    }
</style>
<style>
    /* Compact fieldsets and tables stacked vertically */
    .fieldset-custom {
        margin-bottom: .75rem;
    }

        .fieldset-custom > legend {
            margin-bottom: .35rem;
        }

    /* Tables inside our compact sections */
    .compact-section .table {
        margin-bottom: .5rem;
    }

        .compact-section .table thead {
            margin-bottom: 0;
        }

    .compact-section .table-responsive {
        margin-bottom: .5rem;
    }

    /* Remove extra top margin on the repayment block */
    #loanRepaymentSection {
        margin-top: .5rem !important;
    }
</style>


<span id="customerName" class="d-none">@Model.Customer.name</span>
@if (ViewBag.Operation == "cashin" || isNewSubscription)
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: green">
                @(isNewSubscription
        ? CashDesk_OperationForm.MemberOnboardingDeposit
        : (Model.IsDailyCollector
            ? "Daily Collector Cash Clearance"
            : CashDesk_OperationForm.CashIn))
            </legend>



            <hr style="border: 2px solid green;" />

            @if (isNewSubscription)
            {
                <div id="preMemberOnboardingContainer" class="mt-3">
                    @Html.Partial("_PreMemberOnboardingSummary")
                </div>
            }

            <div class="change-group">
                <div class="row mt-2 gy-2">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start mb-2">
                                @CashDesk_OperationForm.MemberName : @Model.Customer.name
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline d-flex justify-content-end">
                            <span class="formatted-amount shadow-box mb-2" id="lblDepositRequest_amount">
                                @CashDesk_OperationForm.TotalAmount : <b>@Model.MemberOnboardingDetailDto.GrandTotal.ToString("N0")</b>
                            </span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0" />
                        </div>
                    </div>

                    <!-- Toolbar: hide-balance + include-loan on one line -->
                    <div class="col-12">
                        <div class="d-flex flex-wrap align-items-center gap-4">
                            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                                <input class="form-check-input" type="checkbox" id="hideBalanceCheckbox" onchange="toggleHideBalance()" />
                                <label class="form-check-label fw-bold m-0" id="hideBalanceLabel" for="hideBalanceCheckbox" style="font-size:0.95rem;">
                                    @CashDesk_OperationForm.BalancewWllBeShownOnReceipt
                                </label>
                            </div>

                            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                                <input class="form-check-input" type="checkbox" id="includeLoanRepaymentCheckbox" onchange="toggleLoanRepayment()" />
                                <label class="form-check-label fw-bold m-0" for="includeLoanRepaymentCheckbox" style="font-size:0.95rem;">
                                    Include Loan Repayment
                                </label>
                                <!-- mirror for backend -->
                                <input type="hidden" id="IncludeLoanRepayment" name="IncludeLoanRepayment" value="false" />
                            </div>
                        </div>
                    </div>
                    @if (isNewSubscription)
                    {
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control shadow-input-boxes" id="CustomerAlphaNumber"
                                       placeholder=" @CashDesk_OperationForm.MemberCustomAccountNumberExample" required />
                                <label for="CustomerAlphaNumber">@CashDesk_OperationForm.MemberCustomAccountNumber</label>
                            </div>
                        </div>
                    }
                    else if (Model.IsDailyCollector)
                    {
                        <!-- Collection Approach (Radio Buttons) -->
                        <div class="col-md-12">
                            <fieldset class="mb-3">
                                <legend class="fs-6 text-muted mb-2">Collection Approach</legend>

                                <div class="d-flex gap-4 flex-wrap" id="collectionApproachGroup">
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.DailyCollectorCollectApproach, "Device",
                                            new { @class = "form-check-input", id = "approachDevice" })
                                        <label class="form-check-label fw-semibold" for="approachDevice">
                                            <i class="mdi mdi-nfc-tap-variant me-1"></i> Device (C-Money / POS)
                                        </label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.DailyCollectorCollectApproach, "Manual",
                                            new { @class = "form-check-input", id = "approachManual" })
                                        <label class="form-check-label fw-semibold" for="approachManual">
                                            <i class="mdi mdi-file-upload-outline me-1"></i> Manual (Uploaded batch)
                                        </label>
                                    </div>
                                </div>

                                <small class="text-muted d-block mt-1">
                                    Choose <strong>Manual</strong> to clear from an approved uploaded batch, or <strong>Device</strong> for C-Money/POS device collections.
                                </small>
                            </fieldset>
                        </div>

                        <!-- Approved Manual Batch (hidden by default; shown only if 'Manual') -->
                        <div class="col-md-12 d-none" id="manualBatchWrapper">
                            <div class="form-floating form-floating-outline mb-3">
                                @Html.DropDownListFor(
                                    m => m.ManualEntryDailyCollectorId,
                                    ViewBag.ApprovedManualEntries as IEnumerable<SelectListItem>,
                                    (ViewBag.ApprovedManualEntries as IEnumerable<SelectListItem>)?.Any() == true
                                        ? "--- Select Approved Batch ---"
                                        : "--- No Approved Batches ---",
                                    new { @class = "form-control select2", id = "ManualEntryDailyCollectorId" } /* required toggled by JS */
                                )
                                <label>Approved Daily Collector Batch (Cash Clearance)</label>
                                <small class="text-muted d-block mt-1">
                                    Only batches with <em>Status = Approved</em> and not yet fully completed are listed.
                                </small>
                            </div>
                        </div>
                    }
                    <input type="hidden" id="CustomerAlphaNumber" value="0" />




                    <div class="table-responsive w-100 compact-section">
                        <fieldset class="fieldset-custom">
                            <div class="table-responsive w-100">
                                <table class="table table-hover" id="myDataTableT">
                                    <thead class="table-light">
                                        <!-- New header row (legend) to match the loans table style -->
                                        <tr>
                                            <th colspan="8" class="text-center fw-bold bg-light text-dark">
                                                MEMBER'S ACCOUNTS
                                            </th>
                                        </tr>
                                        <tr>
                                            <th style="display: none;"> @CashDesk_OperationForm.ProductID</th>
                                            <th> @CashDesk_OperationForm.Accounts</th>
                                            <th> @CashDesk_OperationForm.Balance</th>
                                            <th> @CashDesk_OperationForm.Amount</th>
                                            <th> @CashDesk_OperationForm.Fee</th>
                                            <th> @CashDesk_OperationForm.Total</th>
                                            <th> @CashDesk_OperationForm.Conf</th>
                                            <th> @CashDesk_OperationForm.Inc</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.BulkDeposits
                                                               .Where(x => !x.AccountType.ToLower().Contains("loan"))
                                                               .OrderBy(t => t.AccountType))
                                        {
                                            <tr>
                                                <td style="display: none;">@d.AccountNumber</td>
                                                <td>@d.AccountType</td>
                                                <td>@d.Balance.ToString("N2")</td>
                                                <td>
                                                    <input type="number"
                                                           class="form-control amount-input shadow-input-boxes"
                                                           value="@d.Amount" />
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           class="form-control fee-input shadow-input-boxes"
                                                           value="@d.Fee" />
                                                </td>
                                                <td><span class="total-span">@d.Total</span></td>
                                                <td><input type="checkbox" class="form-check-input" /></td>
                                                <td><input type="checkbox" class="form-check-input check-inclussive" disabled /></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold">Total:</td>
                                            <td id="tableTotal"><b>@Model.MemberOnboardingDetailDto.GrandTotal.ToString("N0")</b></td>
                                            <td colspan="4"></td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold"> @CashDesk_OperationForm.Difference:</td>
                                            <td id="tableBalance">0</td>
                                            <td colspan="4"></td>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>

                        </fieldset>
                    </div>

                    <!-- Loan Repayment: reduce top spacing -->
                    <div id="loanRepaymentSection" class="mt-1 d-none compact-section">
                        <fieldset class="fieldset-custom">
                            <!-- ========================= LOAN REPAYMENT SECTION (Hidden by default) ========================= -->
                            <!-- Toolbar: left = search member's loans, right = VAT mode + calculate -->
                            <div class="row">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <!-- Left: Search member’s loans -->
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLoadMemberLoans">
                                        <i class="mdi mdi-magnify me-1"></i> Load Member’s Loans
                                    </button>

                                    <!-- Right: VAT buttons -->
                                    <div class="btn-group" role="group" aria-label="VAT Mode">
                                        <input class="btn-check" type="radio" name="vatMode" id="vatModeExclusive"
                                               value="exclusive"
                                               onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                                        <label class="btn btn-outline-primary" for="vatModeExclusive">
                                            VAT Exclusive (19.25%)
                                        </label>

                                        <input class="btn-check" type="radio" name="vatMode" id="vatModeInclusive"
                                               value="inclusive" checked
                                               onchange="applyVatModeToAllRows()" onclick="applyVatModeToAllRows()">
                                        <label class="btn btn-outline-primary" for="vatModeInclusive">
                                            VAT Inclusive (16.1425%)
                                        </label>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover" id="myDataTableT2">
                                        <!-- Column widths -->
                                        <colgroup>
                                            <col class="col-hide">        @* LRef (hidden) *@
                                            <col class="col-date">        @* DATE *@
                                            <col class="col-lamount">     @* L.AMOUNT *@
                                            <col class="col-ai">          @* A.I *@
                                            <col class="col-balance">     @* BALANCE *@
                                            <col class="col-capital">     @* CAPITAL input *@
                                            <col class="col-interest">    @* INTEREST input *@
                                            <col class="col-vat">         @* VAT (readonly) *@
                                            <col class="col-penalty">     @* PENALTY input *@
                                            <col class="col-total">       @* TOTAL *@
                                            <col class="col-conf">        @* CONF (smallest) *@
                                        </colgroup>

                                        <thead class="table-light">
                                            <tr>
                                                <th colspan="10" class="text-center fw-bold bg-light text-dark">
                                                    @GlobalLoanRepaymentBackOffice.MEMBERS_OPENED_LOANS
                                                </th>
                                            </tr>
                                            <tr>
                                                <th style="display:none;">@GlobalLoanRepaymentBackOffice.LRef</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Date</th>
                                                <th>@GlobalLoanRepaymentBackOffice.LAmount</th>
                                                <th>@GlobalLoanRepaymentBackOffice.AI</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Balance</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Capital</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Interest</th>
                                                <th>@GlobalLoanRepaymentBackOffice.VAT</th>
                                                <th>Pen</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Total</th>
                                                <th>@GlobalLoanRepaymentBackOffice.Conf</th>
                                            </tr>
                                        </thead>

                                        <tbody id="loanRepaymentTable">
                                            @foreach (var d in Model.Loans)
                                            {
                                                var loanId = d.Id;
                                                <tr id="row-@loanId">
                                                    <!-- hidden ref -->
                                                    <td style="display:none;">@loanId</td>

                                                    <!-- DATE -->
                                                    <td>@d.LoanDate.ToString("dd/MM/yy")</td>

                                                    <!-- L.AMOUNT (also expose data-loan-amount for JS) -->
                                                    <td class="loan-amount" data-loan-amount="@d.LoanAmount">
                                                        @d.LoanAmount.ToString("#,##0.0")
                                                    </td>

                                                    <!-- A.I -->
                                                    <td>@d.AccrualInterest.ToString("#,##0.0")</td>

                                                    <!-- BALANCE -->
                                                    <td>@d.Balance.ToString("#,##0.0")</td>

                                                    <!-- CAPITAL -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm capital-input"
                                                               id="capital-@loanId"
                                                               value="0"
                                                               step="0.01"
                                                               oninput="updateTotals('@loanId')" />
                                                    </td>

                                                    <!-- INTEREST (holds data-loanamount for VAT logic) -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm interest-input"
                                                               id="interest-@loanId"
                                                               value="0"
                                                               data-original="0"
                                                               data-loanamount="@d.LoanAmount"
                                                               oninput="handleInterestInput('@loanId')" />
                                                    </td>

                                                    <!-- VAT (readonly) -->
                                                    <td>
                                                        <input type="text"
                                                               class="form-control form-control-sm vat-input"
                                                               id="vat-@loanId"
                                                               value="0"
                                                               readonly />
                                                    </td>

                                                    <!-- PENALTY -->
                                                    <td>
                                                        <input type="number"
                                                               class="form-control form-control-sm penalty-input"
                                                               id="penalty-@loanId"
                                                               value="0"
                                                               step="0.01"
                                                               oninput="updateTotals('@loanId')" />
                                                    </td>

                                                    <!-- TOTAL -->
                                                    <td class="text-end">
                                                        <span class="total-span" id="total-@loanId">0</span>
                                                    </td>

                                                    <!-- CONF -->
                                                    <td class="text-center">
                                                        <input type="checkbox"
                                                               class="form-check-input loan-confirmation-checkbox"
                                                               onchange="updateTotals()" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <td colspan="8" class="text-end fw-bold">
                                                    @GlobalLoanRepaymentBackOffice.OverallTotalRepayment:
                                                </td>
                                                <td id="totalRepaymentAmount" class="text-end">0</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>

                                    </table>
                                </div>

                            </div>

                            <!-- ======================= / LOAN REPAYMENT SECTION ======================= -->

                        </fieldset>
                    </div>




                </div>

                <div class="header-buttons mt-4 float-end">
                    <input type="hidden" name="OperationType" value="CashIn" id="OperationType" />
                    <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />

                    <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostCashIn()">
                        <i class="fas fa-money-bill-wave me-1"></i> @CashDesk_OperationForm.CashInB
                    </button>

                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> @CashDesk_OperationForm.Reset
                    </button>
                </div>
            </div>

            <hr style="border: 2px solid green;" />
        </fieldset>
    </div>
}


else if (ViewBag.Operation == "withdrawalnotification")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: red">S.W.N<small>(@CashDesk_OperationForm.SavingWithdrawalNotification)</small></legend>
            <hr style="border: 2px solid red;" />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">@CashDesk_OperationForm.MemberName: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_OperationForm.TotalAmount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>
                    <hr style="border: 2px solid red;" />
                    @if (!Model.WithdrawalNotifications.Any())
                    {

                        <div class="text-center my-3">
                            <p>@Model.Customer.name @CashDesk_OperationForm.hasNoNotifcationToWithdrawalFromSavingAccount. <br /><i>@CashDesk_OperationForm.NormalwithdrawalChargesFromSavingShallBeAppled.</i> </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="width: 100%;">
                            <table class="table table-hover" id="myDataTableT">
                                <thead class="table-light">
                                    <tr>
                                        <th style="display:none;">@CashDesk_OperationForm.NotificationId</th>
                                        <th>@CashDesk_OperationForm.RequestedAmount</th>
                                        <th>@CashDesk_OperationForm.FormCharges</th>
                                        <th>@CashDesk_OperationForm.Status</th>
                                        <th>@CashDesk_OperationForm.IDW</th>
                                        <th>@CashDesk_OperationForm.Grace</th>
                                        <th>@CashDesk_OperationForm.Total</th>
                                        <th>@CashDesk_OperationForm.Conf</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.WithdrawalNotifications.Where(x => !x.IsWithdrawalDone).OrderBy(t => t.NotificationDate))
                                    {
                                        <tr>
                                            <td style="display:none;">@d.Id</td>
                                            <td>
                                                <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.AmountRequired">
                                            </td>
                                            <td>
                                                <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.FormNotificationCharge" readonly="readonly">
                                            </td>
                                            <td>
                                                <span class="status">@d.ApprovalStatus</span>
                                            </td>
                                            <td>
                                                <span class="doiw">@d.DateOfIntendedWithdrawal.ToShortDateString()</span>
                                            </td>
                                            <td>
                                                <span class="dogp">@d.GracePeriodDate.ToShortDateString()</span>
                                            </td>
                                            <td>
                                                <span class="total-span">@d.Total</span>
                                            </td>
                                            <td>
                                                <input type="checkbox" class="form-check-input">
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5" style="text-align: right;"><strong>@CashDesk_OperationForm.Total:</strong></td>
                                        <td id="tableTotal">0</td>
                                        <td></td> <!-- Empty cell to align with the checkbox column -->
                                    </tr>
                                    <tr>
                                        <td colspan="6" style="text-align: right;"><strong>@CashDesk_OperationForm.Balance:</strong></td>
                                        <td id="tableBalance">0</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="header-buttons mt-4 float-end">
                            <input type="hidden" name="OperationType" value="SavingWithdrawalFormFee" id="OperationType" />
                            <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                            <button type="submit" id="submit" class="btn btn-danger me-2" onclick="PostWithdrawalFromFee()">
                                <i class="fas fa-money-bill-wave me-1"></i> @CashDesk_OperationForm.ConfirmPayment
                            </button>
                            <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                                <i class="fas fa-print me-1"></i> @CashDesk_OperationForm.RePrint
                            </button>
                            <button type="reset" class="btn btn-outline-secondary">
                                <i class="fas fa-sync-alt me-1"></i> @CashDesk_OperationForm.Reset
                            </button>
                        </div>
                        <hr style="border: 2px solid red;" />
                    }
                </div>

            </div>
        </fieldset>
    </div>

}
else if (ViewBag.Operation == "cashout")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend style="color: red"> @CashDesk_OperationForm.CashOut</legend>
            <hr style="border: 2px solid red;" />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-8">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start"> @CashDesk_OperationForm.MemberName: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount"> @CashDesk_OperationForm.TotalAmount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>


                    <!-- ✅ Nice placement of the Hide Balance option below -->
                    <div class="col-md-12">
                        <div class="form-check form-switch d-flex align-items-center gap-2 mt-1">
                            <input class="form-check-input" type="checkbox" id="hideBalanceCheckbox" onchange="toggleHideBalance()" />
                            <label class="form-check-label fw-bold" id="hideBalanceLabel" for="hideBalanceCheckbox" style="font-size: 0.95rem;">
                                @CashDesk_OperationForm.BalancewWllBeShownOnReceipt
                            </label>
                        </div>
                    </div>

                    <hr style="border: 2px solid red;" />
                    <div class="table-responsive" style="width: 100%;">
                        <table class="table table-hover" id="myDataTableT">
                            <thead class="table-light">
                                <tr>
                                    <th style="display:none;">@CashDesk_OperationForm.ProductID</th>
                                    <th>@CashDesk_OperationForm.OrdinaryAccounts</th>
                                    <th>@CashDesk_OperationForm.Balance</th>
                                    <th>@CashDesk_OperationForm.Amount</th>
                                    <th>>@CashDesk_OperationForm.FeeCharges</th>
                                    <th>@CashDesk_OperationForm.Total</th>
