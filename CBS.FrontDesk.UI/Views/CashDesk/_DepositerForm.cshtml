@using Resources
<div class="modal-body pt-0">
    <form id="depositorForm">
        <div class="row gy-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" id="DepositorName" class="form-control" placeholder="@GlobalShared.Full_Name">
                    <label for="DepositorName">@GlobalShared.Name</label>
                    <div class="invalid-feedback">@GlobalShared.Please_enter_name.</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="tel" id="DepositerTelephone" class="form-control" placeholder="@GlobalShared.Phone_Number">
                    <label for="DepositorTelephone">@GlobalShared.Phone_Number</label>
                    <div class="invalid-feedback">@GlobalShared.Phone_number_is_required.</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" id="DepositorIDNumber" class="form-control" placeholder="@GlobalShared.ID_Number">
                    <label for="DepositorIDNumber">@GlobalShared.CNI_ID_Number</label>
                    <div class="invalid-feedback">@GlobalShared.Enter_a_valid_ID_number.</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating">
                    <input type="date" id="DepositorIDIssueDate" class="form-control">
                    <label for="DepositorIDIssueDate">@GlobalShared.Issue_Date</label>
                    <div class="invalid-feedback">@GlobalShared.Issue_date_is_required.</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating">
                    <input type="date" id="DepositorIDExpiryDate" class="form-control">
                    <label for="DepositorIDExpiryDate">@GlobalShared.Expiry_Date</label>
                    <div class="invalid-feedback">@GlobalShared.Expiry_date_is_required.</div>
                    <div class="invalid-feedback">@GlobalShared.Please_enter_a_valid_date.</div>

                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating">
                    <input type="text" id="DepositorIDNumberPlaceOfIssue" class="form-control" placeholder="@GlobalShared.PlaceOfIssue">
                    <label for="DepositorIDNumberPlaceOfIssue">@GlobalShared.PlaceOfIssue</label>
                    <div class="invalid-feedback">@GlobalShared.PlaceOfIssue.</div>
                    <div class="invalid-feedback">@GlobalShared.Please_enter_a_valid_place.</div>

                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating">
                    <textarea id="DepositerNote" class="form-control" placeholder="Optional note..." style="height: 75px;"></textarea>
                    <label for="DepositerNote">@CashDeskRessource.Note</label>
                </div>
            </div>
        </div>
    </form>
</div>
