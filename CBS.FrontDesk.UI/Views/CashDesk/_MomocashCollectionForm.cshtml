<script>
    // Show a tiny summary in the toggle button once name/phone typed
    (function () {
        const nameEl = document.getElementById('DepositorName');
        const phoneEl = document.getElementById('DepositorTelephone');
        const mini = document.getElementById('repMiniSummary');
        const update = () => {
            const n = (nameEl?.value || '').trim();
            const p = (phoneEl?.value || '').trim();
            if (!mini) return;
            if (n || p) {
                mini.classList.remove('d-none');
                mini.textContent = `(${n || '—'} / ${p || '—'})`;
            } else {
                mini.classList.add('d-none');
                mini.textContent = '–';
            }
        };
        nameEl?.addEventListener('input', update);
        phoneEl?.addEventListener('input', update);
        update();
    })();
</script>