@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<style>
    /* -----------------------------------------
       Base compact fieldset layout (safe)
    ------------------------------------------*/
    .tsc-form-header .meta {
        line-height: 1.2;
    }

        .tsc-form-header .meta span {
            display: inline-flex;
            align-items: center;
        }

    .fieldset-custom {
        padding: 0.75rem 1rem;
    }

        .fieldset-custom .row {
            margin-bottom: .25rem;
        }

            .fieldset-custom .row:last-child {
                margin-bottom: 0;
            }

        .fieldset-custom .form-floating {
            padding: .25rem 0;
        }

        .fieldset-custom .form-control,
        .fieldset-custom .select2-selection--single {
            min-height: 34px;
            padding-top: .25rem;
            padding-bottom: .25rem;
            font-size: .9rem;
        }

        .fieldset-custom .table {
            margin-bottom: .25rem;
        }

            .fieldset-custom .table th,
            .fieldset-custom .table td {
                padding-top: .35rem;
                padding-bottom: .35rem;
                font-size: .9rem;
            }

    .header-buttons {
        margin-top: .75rem !important;
    }

    /* -----------------------------------------
       New form header (replaces legend)
    ------------------------------------------*/
    .tsc-form-header {
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
        border-radius: .6rem;
        padding: .65rem .85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        box-shadow: 0 1px 0 rgba(0,0,0,.02);
    }

        .tsc-form-header .title {
            font-weight: 700;
            letter-spacing: .2px;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            white-space: nowrap;
        }

        .tsc-form-header .meta {
            font-size: .92rem;
            color: #111;
            display: flex;
            flex-wrap: wrap;
            gap: .35rem .8rem;
            align-items: center;
            justify-content: flex-end;
            flex: 1;
        }

            .tsc-form-header .meta strong {
                font-weight: 700;
                color: #111;
            }

        .tsc-form-header .sep {
            color: rgba(0,0,0,.25);
            font-weight: 700;
        }

    /* Responsive: stack header nicely on small screens */
    @@media (max-width: 576px) {
        .tsc-form-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .tsc-form-header .meta {
                justify-content: flex-start;
            }

            .tsc-form-header .sep {
                display: none;
            }
    }

    /* -----------------------------------------
       Source type pills (MTN / Orange)
    ------------------------------------------*/
    .momo-pill {
        border: 1px solid rgba(0,0,0,.12);
        padding: .35rem .65rem;
        border-radius: 999px;
        background: #fff;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        user-select: none;
        transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
    }

        .momo-pill input {
            margin-top: 0;
        }

        .momo-pill:hover {
            background: #f8fafc;
            border-color: rgba(0,0,0,.18);
            box-shadow: 0 1px 0 rgba(0,0,0,.04);
        }

        /* Optional: highlight selected radio (works when the input is inside the label) */
        .momo-pill:has(input:checked) {
            border-color: rgba(25,135,84,.45); /* bootstrap success-ish */
            background: rgba(25,135,84,.06);
        }

    /* -----------------------------------------
       (Optional) summary box – keep if you still use it elsewhere
    ------------------------------------------*/
    .momo-summary {
        border: 1px solid rgba(0,0,0,.10);
        background: #f8fafc;
        border-radius: .6rem;
        padding: .6rem .75rem;
    }
</style>
<style>
    /* Keep checkbox columns stable */
    #myDataTableT th.col-check,
    #myDataTableT td.col-check {
        width: 84px; /* Confirm */
        min-width: 84px;
        max-width: 84px;
        text-align: center;
        white-space: nowrap;
    }

    #myDataTableT th.col-inc,
    #myDataTableT td.col-inc {
        width: 60px; /* Inc */
        min-width: 60px;
        max-width: 60px;
        text-align: center;
        white-space: nowrap;
    }

        /* Make checkbox look centered + consistent */
        #myDataTableT td.col-check .form-check-input,
        #myDataTableT td.col-inc .form-check-input {
            margin: 0;
            vertical-align: middle;
            transform: translateY(1px);
        }

    /* Prevent header text from wrapping weirdly */
    #myDataTableT thead th {
        white-space: nowrap;
        font-size: .82rem;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: rgba(0,0,0,.60);
    }

    /* Slightly soften row spacing */
    #myDataTableT tbody td {
        vertical-align: middle;
    }
</style>
<style>
    /* --- Loan table fixed widths (CONF + VAT-INC/EXC) --- */
    #myDataTableT th.col-conf,
    #myDataTableT td.col-conf {
        width: 84px;
        min-width: 84px;
        max-width: 84px;
        text-align: center;
        white-space: nowrap;
    }

    #myDataTableT th.col-vat,
    #myDataTableT td.col-vat {
        width: 110px;
        min-width: 110px;
        max-width: 110px;
        text-align: center;
        white-space: nowrap;
    }

        #myDataTableT td.col-conf .form-check-input,
        #myDataTableT td.col-vat .form-check-input {
            margin: 0;
            vertical-align: middle;
            transform: translateY(1px);
        }

    /* Improve header readability */
    #myDataTableT thead th {
        white-space: nowrap;
        font-size: .82rem;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: rgba(0,0,0,.60);
    }

    /* Footer alignment + spacing */
    #myDataTableT tfoot td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>


@if (ViewBag.Operation == "cashin_momokash_collection")
{
    <div class="tsc-form-header mb-3">
        <div class="title text-success">
            <i class="mdi mdi-cash-plus"></i>
            CASH-IN
        </div>

        <div class="meta">
            <span><strong>Member's name:</strong> @Model.Customer.name</span>
            <span class="sep">|</span>
            <span><strong>Branch name:</strong> @Model.Branch.Name</span>
            <span class="sep">|</span>
            <span><strong>Branch code:</strong> @Model.Branch.BranchCode</span>
        </div>
    </div>

    <div class="row g-3">

        <!-- ✅ Source Type + Accounting Date -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-3 align-items-center">

                        <div class="col-md-8">
                            <label class="fw-semibold text-dark mb-1">
                                <i class="mdi mdi-cellphone-check me-1"></i>
                                Source Type
                            </label>

                            <div class="d-flex flex-wrap gap-2">
                                <label class="momo-pill">
                                    @Html.RadioButtonFor(m => m.BulkDeposit.SourceType, "MomocashCollectionMTN", new { id = "MobileMoneyMTN" })
                                    @CashDesk_MomocashCollectionForm.MomoCashCollectionMobileMoneyMTN
                                </label>

                                <label class="momo-pill">
                                    @Html.RadioButtonFor(m => m.BulkDeposit.SourceType, "MomocashCollectionOrange", new { id = "MobileMoneyORANGE" })
                                    @CashDesk_MomocashCollectionForm.MomoCashCollectionMobileMoneyOrange
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <label class="form-label fw-semibold me-2 mb-1 d-block">
                                <i class="mdi mdi-calendar-clock me-1"></i>
                                Accounting Date
                            </label>

                            @Html.TextBoxFor(
                                m => m.BulkDeposit.AccountingDate,
                                Model.BulkDeposit.AccountingDate.HasValue
                                    ? Model.BulkDeposit.AccountingDate.Value.ToString("yyyy-MM-dd")
                                    : DateTime.Today.ToString("yyyy-MM-dd"),
                                new
                                {
                                    @class = "form-control form-control-sm d-inline-block accounting-date",
                                    style = "width: 180px",
                                    type = "date",
                                    data_date_default = "today",
                                    data_date_max = "today"
                                })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.AccountingDate, "", new { @class = "text-danger" })
                        </div>

                        <!-- ✅ keep same hidden field -->
                        <input type="hidden" id="memberName" value="@Model.AddMembersNoneCashOperationCommand.MemberName" />

                    </div>
                </div>
            </div>
        </div>

        <!-- ✅ Branch + GL Account -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="form-floating border rounded">
                                @Html.DropDownListFor(
                                    m => m.BulkDeposit.BranchId,
                                    new SelectList(ViewBag.Branches, "Id", "Name"),
                                    "---Select branch---",
                                    new { @class = "form-control shadow-sm select2", id = "branchInput" })
                                @Html.ValidationMessageFor(m => m.BulkDeposit.BranchId, "", new { @class = "text-danger" })
                                <label for="branchInput">Branch</label>
                            </div>
                            <div class="form-text">
                                Select the branch to load available Momocash GL accounts.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating border rounded">
                                @Html.DropDownListFor(
                                    m => m.BulkDeposit.ChartOfAccountId,
                                    Enumerable.Empty<SelectListItem>(),
                                    "---GL Account---",
                                    new { @class = "form-control select2", id = "account_number", @search = "true" })
                                @Html.ValidationMessageFor(m => m.BulkDeposit.ChartOfAccountId, "", new { @class = "text-danger" })
                                <label id="accountNumberLabel" for="account_number">Correspondent account</label>
                            </div>
                            <div class="form-text">
                                Pick the correspondent GL account that receives the Momocash collection.
                            </div>
                        </div>

                    </div>

                    <!-- ✅ Representative Toggle -->
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#repSection"
                                aria-expanded="false"
                                aria-controls="repSection">
                            <i class="bi bi-person-vcard me-1"></i>
                            Add representative
                            <span id="repMiniSummary" class="ms-2 text-muted small d-none">–</span>
                        </button>
                    </div>

                    <!-- ✅ Representative Section (unchanged ids) -->
                    <div class="mt-2">
                        <div id="repSection" class="collapse">
                            <div class="border rounded-3 p-3 bg-light-subtle">
                                <div class="fw-semibold mb-2">
                                    <i class="mdi mdi-account-badge-outline me-1"></i>
                                    Representative / Depositor Info
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="text" id="DepositorName" class="form-control form-control-sm"
                                                   placeholder="@CashDesk_DepositerForm.FullName">
                                            <label for="DepositorName" class="small">@CashDesk_DepositerForm.Name</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.PleaseEnterName.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="tel" id="DepositorTelephone" class="form-control form-control-sm"
                                                   placeholder="@CashDesk_DepositerForm.PhoneNumber">
                                            <label for="DepositorTelephone" class="small">@CashDesk_DepositerForm.PhoneNumber</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.PhoneNumberIsRequired.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="text" id="DepositorIDNumber" class="form-control form-control-sm"
                                                   placeholder="@CashDesk_DepositerForm.IDNumber">
                                            <label for="DepositorIDNumber" class="small">@CashDesk_DepositerForm.CNIIDNumber</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.EnterAValidIDNumber.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <input type="date" id="DepositorIDIssueDate" class="form-control form-control-sm">
                                            <label for="DepositorIDIssueDate" class="small">@CashDesk_DepositerForm.IssueDate</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.IssueDateRequired.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <input type="date" id="DepositorIDExpiryDate" class="form-control form-control-sm">
                                            <label for="DepositorIDExpiryDate" class="small">@CashDesk_DepositerForm.ExpiryDate</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.ExpiryDateIsRequired.</div>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.PleaseEnterValidDate.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating">
                                            <input type="text" id="DepositorIDNumberPlaceOfIssue" class="form-control form-control-sm"
                                                   placeholder="@CashDesk_DepositerForm.PlaceOfIssue">
                                            <label for="DepositorIDNumberPlaceOfIssue" class="small">@CashDesk_DepositerForm.PlaceOfIssue</label>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.PlaceOfIssue.</div>
                                            <div class="invalid-feedback">@CashDesk_DepositerForm.PleaseEnterValidPlace.</div>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating">
                                            <textarea id="DepositorNote" class="form-control form-control-sm"
                                                      placeholder="Optional note..." style="height:70px;"></textarea>
                                            <label for="DepositorNote" class="small">@CashDesk_DepositerForm.Note</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ✅ Accounts Table -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="fw-semibold">
                            <i class="mdi mdi-wallet-outline me-1"></i>
                            Accounts
                        </div>
                        <div class="small text-muted">
                            Enter amount + fee, tick confirm, and totals will compute.
                        </div>
                    </div>

                    <div class="table-responsive" style="width:100%;">
                        <table class="table table-hover align-middle" id="myDataTableT">
                            <thead class="table-light">
                                <tr>
                                    <th style="display:none;">@CashDesk_MomocashCollectionForm.ProductID</th>
                                    <th>@CashDesk_MomocashCollectionForm.Accounts</th>
                                    <th class="text-end">@CashDesk_MomocashCollectionForm.Balance</th>
                                    <th style="min-width:140px;">@CashDesk_MomocashCollectionForm.Amount</th>
                                    <th style="min-width:120px;">@CashDesk_MomocashCollectionForm.Fee</th>
                                    <th class="text-end">@CashDesk_MomocashCollectionForm.Total</th>
                                    <th class="text-center col-check">@CashDesk_MomocashCollectionForm.Confirm</th>
                                    <th class="text-center col-inc">@CashDesk_MomocashCollectionForm.Inc</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var d in Model.BulkDeposits
                                    .Where(x => !x.AccountType.ToLower().Contains("loan"))
                                    .OrderBy(t => t.AccountType))
                                {
                                    <tr>
                                        <td style="display:none;">@d.AccountNumber</td>
                                        <td class="fw-semibold">@d.AccountType</td>
                                        <td class="text-end">@d.Balance.ToString("#,##0.0")</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm amount-input shadow-input-boxes" value="@d.Amount">
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm fee-input shadow-input-boxes" value="@d.Fee">
                                        </td>
                                        <td class="text-end">
                                            <span class="total-span">@d.Total</span>
                                        </td>
                                        <td class="text-center col-check">
                                            <input type="checkbox" class="form-check-input">
                                        </td>
                                        <td class="text-center col-inc">
                                            <input type="checkbox" class="form-check-input check-inclussive" disabled>
                                        </td>

                                    </tr>
                                }
                            </tbody>

                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="5" class="text-end">
                                        <strong>@CashDesk_MomocashCollectionForm.Total:</strong>
                                    </td>
                                    <td class="text-end fw-bold" id="tableTotal">0</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>

                        </table>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- ✅ Action Buttons -->
    <div class="header-buttons mt-3 d-flex justify-content-end gap-2 flex-wrap">
        <input type="hidden" name="OperationType" value="CashInMomocashCollection" id="OperationType" />
        <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />

        <button type="submit" id="submit" class="btn btn-primary d-inline-flex align-items-center" onclick="PostCashIn()">
            <i class="fas fa-money-bill-wave me-1"></i>
            @CashDesk_MomocashCollectionForm.CashIn
        </button>

        <button type="submit" id="submit" class="btn btn-secondary d-inline-flex align-items-center" onclick="Reprint()">
            <i class="fas fa-print me-1"></i>
            @CashDesk_MomocashCollectionForm.RePrint
        </button>

        <button type="reset" class="btn btn-outline-secondary d-inline-flex align-items-center">
            <i class="fas fa-sync-alt me-1"></i>
            @CashDesk_MomocashCollectionForm.Reset
        </button>
    </div>
}


else if (ViewBag.Operation == "repayment_momokash_collection")
{
    <div class="tsc-form-header mb-3">
        <div class="title text-success">
            <i class="mdi mdi-hand-coin"></i>
            LOAN REPAYMENT
        </div>

        <div class="meta">
            <span><strong>Member's name:</strong> @Model.Customer.name</span>
            <span class="sep">|</span>
            <span><strong>Branch name:</strong> @Model.Branch.Name</span>
            <span class="sep">|</span>
            <span><strong>Branch code:</strong> @Model.Branch.BranchCode</span>
        </div>
    </div>



    <div class="row g-3">

        <!-- ✅ Source Type + Accounting Date -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-3 align-items-center">

                        <div class="col-md-8">
                            <label class="fw-semibold text-dark mb-1">
                                <i class="mdi mdi-cellphone-check me-1"></i>
                                Source Type
                            </label>

                            <div class="d-flex flex-wrap gap-2">
                                <label class="momo-pill">
                                    @Html.RadioButtonFor(
                                        m => m.AddOtherTransactionMobileMoneyCommand.SourceType,
                                        "MomocashCollectionMTN",
                                        new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyMTN" })
                                    @CashDesk_MomocashCollectionForm.MomoCashCollectionMobileMoneyMTN
                                </label>

                                <label class="momo-pill">
                                    @Html.RadioButtonFor(
                                        m => m.AddOtherTransactionMobileMoneyCommand.SourceType,
                                        "MomocashCollectionOrange",
                                        new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyORANGE" })
                                    @CashDesk_MomocashCollectionForm.MomoCashCollectionMobileMoneyOrange
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <label class="form-label fw-semibold me-2 mb-1 d-block">
                                <i class="mdi mdi-calendar-clock me-1"></i>
                                Accounting Date
                            </label>

                            @Html.TextBoxFor(
                                m => m.BulkDeposit.AccountingDate,
                                Model.BulkDeposit.AccountingDate.HasValue
                                    ? Model.BulkDeposit.AccountingDate.Value.ToString("yyyy-MM-dd")
                                    : DateTime.Today.ToString("yyyy-MM-dd"),
                                new
                                {
                                    @class = "form-control form-control-sm d-inline-block accounting-date",
                                    style = "width: 180px",
                                    type = "date",
                                    data_date_default = "today",
                                    data_date_max = "today"
                                })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.AccountingDate, "", new { @class = "text-danger" })
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- ✅ Branch + GL Account -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="form-floating border rounded">
                                @Html.DropDownListFor(
                                    m => m.BulkDeposit.BranchId,
                                    new SelectList(ViewBag.Branches, "Id", "Name"),
                                    "---Select branch---",
                                    new { @class = "form-control shadow-sm select2", id = "branchInput" })
                                @Html.ValidationMessageFor(m => m.BulkDeposit.BranchId, "", new { @class = "text-danger" })
                                <label for="branchInput">Branch</label>
                            </div>
                            <div class="form-text">
                                Select the branch to load available Momocash GL accounts.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating border rounded">
                                @Html.DropDownListFor(
                                    m => m.BulkDeposit.ChartOfAccountId,
                                    Enumerable.Empty<SelectListItem>(),
                                    "---GL Account---",
                                    new { @class = "form-control select2", id = "account_number", @search = "true" })
                                @Html.ValidationMessageFor(m => m.BulkDeposit.ChartOfAccountId, "", new { @class = "text-danger" })
                                <label id="accountNumberLabel" for="account_number">Correspondent account</label>
                            </div>
                            <div class="form-text">
                                Choose the correspondent GL that receives the loan repayment collection.
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- ✅ Collection Charge (Loan Repayment Momocash) -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="fw-semibold">
                            <i class="mdi mdi-cash-plus me-1"></i>
                            Collection Charge
                        </div>
                        <div class="small text-muted">
                            Optional fee charged for this collection (will be added to totals if enabled).
                        </div>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <div class="form-floating border rounded">
                                <input type="number"
                                       class="form-control form-control-sm shadow-input-boxes"
                                       id="repaymentCollectionCharge"
                                       name="repaymentCollectionCharge"
                                       value="0"
                                       min="0"
                                       step="1"
                                       placeholder="0" />
