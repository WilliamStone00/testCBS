<script>
    $(document).ready(function () {
        var $branch = $('#branchInput');
        var $account = $('#account_number');

        function resetGlDropdown() {
            $account.empty();
            $account.append($('<option/>', {
                value: '',
                text: '---Select Momocash GL Account---'
            }));
            $account.trigger('change.select2');
        }

        // Initialize select2 if available
        if ($.fn.select2) {
            $branch.select2();
            $account.select2();
        }

        $branch.on('change', function () {
            var branchId = $(this).val();

            resetGlDropdown();

            if (!branchId) {
                return; // no branch selected
            }

            $.ajax({
                url: '@Url.Action("LoadGLbyBranchId", "MemberNoneCashOperation")', // adjust controller if needed
                type: 'GET',
                dataType: 'json',
                data: { branchid: branchId },
                success: function (data) {
                    // Expecting data as [{ value: '...', text: '...' }, ...]
                    $.each(data, function (i, item) {
                        $account.append($('<option/>', {
                            value: item.value || item.Value,
                            text: item.text || item.Text
                        }));
                    });
                    $account.trigger('change.select2');
                },
                error: function () {
                    // Optional: simple error handling
                    alert('Unable to load GL accounts for the selected branch.');
                }
            });
        });
    });
</script>
<script>
    (function () {
        // When form loads after search, ensure the hidden operation matches server ViewBag.Operation
        var serverOp = '@(ViewBag.Operation ?? "")';
        if (!serverOp) return;

        var $op = $('#currentselectedOperation');
        if ($op.length) $op.val(serverOp);

        if (typeof window.setMomoOperation === "function") {
            window.setMomoOperation(serverOp);
        }
    })();
</script>

<script>
    // Show a tiny summary in the toggle button once name/phone typed
    (function () {
        const nameEl = document.getElementById('DepositorName');
        const phoneEl = document.getElementById('DepositorTelephone');
        const mini = document.getElementById('repMiniSummary');
        const update = () => {
            const n = (nameEl?.value || '').trim();
            const p = (phoneEl?.value || '').trim();
            if (!mini) return;
            if (n || p) {
                mini.classList.remove('d-none');
                mini.textContent = `(${n || '—'} / ${p || '—'})`;
            } else {
                mini.classList.add('d-none');
                mini.textContent = '–';
            }
        };
        nameEl?.addEventListener('input', update);
        phoneEl?.addEventListener('input', update);
        update();
    })();
</script>
<script>
    (function () {
        function syncChargeFields() {
            var amt = parseFloat($("#repaymentCollectionCharge").val()) || 0;
            var apply = $("#repaymentChargeApply").is(":checked") ? "1" : "0";
            var mode = $("#repaymentChargeMode").val() || "ADD_TO_TOTAL";

            $("#hRepaymentChargeAmount").val(amt);
            $("#hRepaymentChargeApply").val(apply);
            $("#hRepaymentChargeMode").val(mode);
        }

        function syncRepMiniSummary() {
            var name = ($("#DepositorName").val() || "").trim();
            var tel = ($("#DepositorTelephone").val() || "").trim();
            var summary = [name, tel].filter(Boolean).join(" • ");

            if (summary) {
                $("#repMiniSummaryLoan").removeClass("d-none").text("– " + summary);
            } else {
                $("#repMiniSummaryLoan").addClass("d-none").text("–");
            }
        }

        $(document).on("input change", "#repaymentCollectionCharge, #repaymentChargeApply, #repaymentChargeMode", syncChargeFields);
        $(document).on("input", "#DepositorName, #DepositorTelephone", syncRepMiniSummary);

        // init
        syncChargeFields();
        syncRepMiniSummary();
    })();
</script>
