@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    ViewBag.Title = @OtherCashMobileMoney.MobileMoneyOperations;
}

<!-- Page Title and Welcome Message -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-3">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cellphone-message me-2"></i> @OtherCashMobileMoney.MobileMoneyManagement
                </h1>
                <p class="card-text">
                    @OtherCashMobileMoney.WelcomeToThe <strong>@OtherCashMobileMoney.MobileMoneyCashDesk</strong> @OtherCashMobileMoney.Of <strong>@OtherCashMobileMoney.TRUSTSOFTCREDITTSC</strong>. @OtherCashMobileMoney.ThisInterfaceManages <strong>@OtherCashMobileMoney.MobileMoneyMTNAndOrangeOperations</strong> @OtherCashMobileMoney.ForBoth <strong>@OtherCashMobileMoney.CashIn</strong> @OtherCashMobileMoney.And <strong>@OtherCashMobileMoney.CashOut</strong> @OtherCashMobileMoney.Transactions.
                </p>
                <p class="card-text">
                    @OtherCashMobileMoney.MobileMoneyTransactionsAreRegisteredUnder <strong>@OtherCashMobileMoney.GLAccounts</strong> @OtherCashMobileMoney.UsingDefined <strong>@OtherCashMobileMoney.AccountingMappings</strong> @OtherCashMobileMoney.AndLinkedTo <strong>@OtherCashMobileMoney.NonMemberRepresentatives</strong>.
                </p>
                <p class="card-text">
                    💡 <strong>@OtherCashMobileMoney.Note:</strong> @OtherCashMobileMoney.ThisModuleSupports <strong>@OtherCashMobileMoney.CashBasedTransactions</strong> @OtherCashMobileMoney.WithTelecomWallets, @OtherCashMobileMoney.ValidatedVia <strong>@OtherCashMobileMoney.TillCodes</strong> @OtherCashMobileMoney.AndProperlyItemizedForReconciliation.
                </p>
                <hr style="border: 2px solid rgba(0, 128, 0, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section for Mobile Money -->
<div class="row">
    <div class="col-12">
        <div class="accordion mb-4" id="tipsAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-bold text-success" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                        <i class="mdi mdi-information-outline me-2"></i> @OtherCashMobileMoney.TipsAndGuidelinesForMobileMoneyTransactions
                    </button>
                </h2>
                <div id="collapseTips" class="accordion-collapse collapse" data-bs-parent="#tipsAccordion">
                    <div class="accordion-body">
                        <ul class="mb-2">
                            <li><strong>@OtherCashMobileMoney.OperatorSelection:</strong> @OtherCashMobileMoney.ChooseEither <span style="color: #FFD700;"><strong>@OtherCashMobileMoney.MTNMobileMoney</strong></span> @OtherCashMobileMoney.Or <span style="color: #FFA500;"><strong>@OtherCashMobileMoney.OrangeMoney</strong></span> @OtherCashMobileMoney.ToSpecifyTheTransactionSource.</li>
                            <li><strong>@OtherCashMobileMoney.TransactionDirection:</strong> @OtherCashMobileMoney.IndicateWhetherTheTransactionIsA <strong>@OtherCashMobileMoney.CashIn</strong> (@OtherCashMobileMoney.Deposit) @OtherCashMobileMoney.Or <strong>@OtherCashMobileMoney.CashOut</strong> (@OtherCashMobileMoney.Withdrawal).</li>
                            <li><strong>@OtherCashMobileMoney.ClientIdentification:</strong> @OtherCashMobileMoney.EnterThe <strong>@OtherCashMobileMoney.RepresentativesName</strong>, <strong>@OtherCashMobileMoney.PhoneNumber</strong>, @OtherCashMobileMoney.And <strong>@OtherCashMobileMoney.CNI</strong> @OtherCashMobileMoney.ForProperCustomerTracking.</li>
                            <li><strong>@OtherCashMobileMoney.MemberReference:</strong> @OtherCashMobileMoney.OptionallyProvideAReferenceIfTheTransactionIsLinkedToAKnownMember.</li>
                            <li><strong>@OtherCashMobileMoney.TillCode:</strong> @OtherCashMobileMoney.The <strong>@OtherCashMobileMoney.TillCode</strong> @OtherCashMobileMoney.Is <span class="text-danger fw-bold">@OtherCashMobileMoney.Mandatory</span> @OtherCashMobileMoney.ForBranchOfficesWith <strong>@OtherCashMobileMoney.MultipleTills</strong>. @OtherCashMobileMoney.ThisEnsuresPrecise <strong>@OtherCashMobileMoney.TellerTrackingAndReconciliation</strong>.</li>
                            <li><strong>@OtherCashMobileMoney.TransactionEntry:</strong> @OtherCashMobileMoney.UseTheTransactionTableToInputAmountsConfirmThemAndMonitorTotalBalancesDynamically.</li>
                            <li><strong>@OtherCashMobileMoney.PostingMapping:</strong> @OtherCashMobileMoney.AllOperationsAreAutomaticallyLinkedToPredefinedGLAccountsBasedOnSelectedTelecomOperatorAndTransactionType.</li>
                        </ul>
                        <p class="text">
                            <strong>@OtherCashMobileMoney.Reminder:</strong> @OtherCashMobileMoney.UseThisInterfaceForExternalMobileMoneyWalletInteractionsOnly.
                        </p>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Transaction Area -->
<div class="row">
    <div class="col">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingMobileMoney">
                    <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseMobileMoney" aria-expanded="true" aria-controls="collapseMobileMoney">
                        <i class="mdi mdi-cash-register me-2"></i> @OtherCashMobileMoney.MobileMoneyOperationsHC
                    </button>
                </h2>
                <hr />
                <div id="collapseMobileMoney" class="accordion-collapse collapse show" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div id="datalistingview">
                            @Html.Partial("_OtherCashMobileMoneyDesk")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔷 Modal for Customer Info -->
@Html.Partial("_model")

<!-- 🔷 Scripts -->
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/CashDesk/OtherCashMobileMoney.js"></script>
}
