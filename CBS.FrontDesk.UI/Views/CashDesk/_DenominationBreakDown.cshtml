

@using Resources
<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend style="color: blue">@CashDesk_DenominationBreakDown.Denomination</legend>
        <table class="table table-striped table-hover" id="myDataTable" style="border-collapse: collapse; width: 100%;">
            <thead>
                <tr>
                    <th colspan="2" class="separation-text"><h6 class="card-title">@CashDesk_DenominationBreakDown.Notes</h6></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>10,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note10000" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="10000"></td>
                </tr>
                <tr>
                    <td><strong>5,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note5000" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="5000"></td>
                </tr>
                <tr>
                    <td><strong>2,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note2000" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="2000"></td>
                </tr>
                <tr>
                    <td><strong>1,000</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note1000" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="1000"></td>
                </tr>
                <tr>
                    <td><strong>500</strong></td>
                    <td><input type="number" class="form-control" id="Notes_note500" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="500"></td>
                </tr>
            </tbody>
            <thead>
                <tr>
                    <th colspan="2" class="separation-text"><h6 class="card-title">Coins</h6></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>500</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin500" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="500"></td>
                </tr>
                <tr>
                    <td><strong>100</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin100" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="100"></td>
                </tr>
                <tr>
                    <td><strong>50</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin50" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="50"></td>
                </tr>
                <tr>
                    <td><strong>25</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin25" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="25"></td>
                </tr>
                <tr>
                    <td><strong>10</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin10" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="10"></td>
                </tr>
                <tr>
                    <td><strong>5</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin5" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="5"></td>
                </tr>
                <tr>
                    <td><strong>1</strong></td>
                    <td><input type="number" class="form-control" id="Notes_coin1" oninput="calculateBalance()" value="0" min="0" step="1" title="@CashDesk_DenominationBreakDown.PleaseEnterAPositiveInteger" data-denomination="1"></td>
                </tr>
            </tbody>
        </table>
    </fieldset>
</div>
