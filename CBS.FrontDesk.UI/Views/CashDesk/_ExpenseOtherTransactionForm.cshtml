@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources

    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend>@CashDesk_ExpenseOtherTransactionForm.OtherPaymentExpensive</legend>
            <hr />
            <div class="change-group">
                <div class="row mt-2 gy-4">

                    <div class="col-md-6">
                        <div class="input-group mb-3">
                            <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="@CashDesk_ExpenseOtherTransactionForm.EnterMemberReferenceNumber">
                            <button class="btn btn-outline-secondary" type="button" id="manualSearchInputbutton" onclick="GetMember()">
                                @CashDesk_ExpenseOtherTransactionForm.Search
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_ExpenseOtherTransactionForm.TotalAmount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Member_Account", new { @class = "form-check-input", id = "memberAccountOption" })
                                <label class="form-check-label" for="memberAccountOption">@CashDesk_ExpenseOtherTransactionForm.ItSAMember</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Cash_Collected", new { @class = "form-check-input", id = "cashCollectionOption" })
                                <label class="form-check-label" for="cashCollectionOption">@CashDesk_ExpenseOtherTransactionForm.NoneMemberOrStaff</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.EventCode, new SelectList(ViewBag.EventCodes, "Value", "Text"), "---"+@CashDesk_ExpenseOtherTransactionForm.SelectEventItem +"---", new { @class = "form-control select2", @search = "true", @id = "BulkDeposit_OtherTransaction_EventCode" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.EventCode, "", new { @class = "text-danger" })
                            <label>@CashDesk_ExpenseOtherTransactionForm.WhatEventItem</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.BulkDeposit.OtherTransaction.MemberName, new { @class = "form-control", @id = "Name" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.MemberName, "", new { @class = "text-danger " })
                            <label for="formValidationDob">@CashDesk_ExpenseOtherTransactionForm.EnterIndividualName</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextAreaFor(m => m.BulkDeposit.OtherTransaction.Narration, new { @class = "form-control", @style = "height: 80px;", @id = "Naration" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Narration, "", new { @class = "text-danger " })
                            <label for="formValidationDob">@CashDesk_ExpenseOtherTransactionForm.NarationOrDescription</label>
                        </div>
                    </div>


                    @Html.Partial("_NoneMemberPayment")

                </div>
                <div class="header-buttons mt-4 float-end">
                    <input type="hidden" name="OperationType" value="OtherCashInExpense" id="OperationType" />
                    <input type="hidden" name="customerId" value="" id="customerId" />
                    <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostExpense()">
                        <i class="fas fa-save me-1"></i> @CashDesk_ExpenseOtherTransactionForm.Post
                    </button>
                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                        <i class="fas fa-print me-1"></i> @CashDesk_ExpenseOtherTransactionForm.Reprint
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> @CashDesk_ExpenseOtherTransactionForm.Reset
                    </button>
                </div>
            </div>
        </fieldset>
    </div>




