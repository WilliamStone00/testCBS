@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk


    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend>OTHER PAYMENTS EXPENSE</legend>
            <hr />
            <div class="change-group">
                <div class="row mt-2 gy-4">

                    <div class="col-md-6">
                        <div class="input-group mb-3">
                            <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="Enter member's reference number">
                            <button class="btn btn-outline-secondary" type="button" id="manualSearchInputbutton" onclick="GetMember()">
                                Search
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">Total amount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Member_Account", new { @class = "form-check-input", id = "memberAccountOption" })
                                <label class="form-check-label" for="memberAccountOption">It's a member</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Cash_Collected", new { @class = "form-check-input", id = "cashCollectionOption" })
                                <label class="form-check-label" for="cashCollectionOption">None Member or Staff</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.EventCode, new SelectList(ViewBag.EventCodes, "Value", "Text"), "---Select Event Item---", new { @class = "form-control select2", @search = "true", @id = "BulkDeposit_OtherTransaction_EventCode" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.EventCode, "", new { @class = "text-danger" })
                            <label>What event item?</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.BulkDeposit.OtherTransaction.Name, new { @class = "form-control", @id = "Name" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Name, "", new { @class = "text-danger " })
                            <label for="formValidationDob">Enter individual name</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextAreaFor(m => m.BulkDeposit.OtherTransaction.Naration, new { @class = "form-control", @style = "height: 80px;", @id = "Naration" })
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Naration, "", new { @class = "text-danger " })
                            <label for="formValidationDob">Naration or Description</label>
                        </div>
                    </div>


                    @Html.Partial("_NoneMemberPayment")

                </div>
                <div class="header-buttons mt-4 float-end">
                    <input type="hidden" name="OperationType" value="OtherCashInExpense" id="OperationType" />
                    <input type="hidden" name="customerId" value="" id="customerId" />
                    <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostExpense()">
                        <i class="fas fa-save me-1"></i> Post
                    </button>
                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                        <i class="fas fa-print me-1"></i> Re-print
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> Reset
                    </button>
                </div>
            </div>
        </fieldset>
    </div>




