@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources

<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend>@CashDeskRessource.OtherPaymentExpenses</legend>
        <hr />
        <div class="change-group">
            <div class="row mt-2 gy-4">
                <!-- 🔹 Toggle Inter-Branch -->
                <div class="col-md-12 mb-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="isInterBranchCheck" onchange="toggleBranchDropdown()" />
                        <label class="form-check-label fw-semibold" for="isInterBranchCheck" id="interBranchLabel">
                            🔄 @CashDeskRessource.Enable_Inter_Branch_Transaction
                        </label>
                    </div>
                </div>


                <!-- 🔹 Branch Selection (Shown only if Inter-Branch is checked) -->
                <div id="branchDropdownContainer" class="col-md-12 mb-3" style="display: none;">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.ExternalBranchId,
                            new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", @id = "ExternalBranchId" })
                        <label for="ExternalBranchId">Destination Branch</label>
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.ExternalBranchId, "", new { @class = "text-danger" })
                    </div>
                </div>



                <!-- 🔹 Member Search -->
                <div class="col-md-6">
                    <div class="input-group mb-3">
                        <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="@CashDeskRessource.EnterMemberReferenceNumber" />
                        <button class="btn btn-outline-secondary" type="button" id="manualSearchInputbutton" onclick="GetMember()">
                            @GlobalShared.Search
                        </button>
                    </div>
                </div>

                <!-- 🔹 Total Amount Display -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@GlobalShared.Total_amount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0" />
                    </div>
                </div>

                <hr />

                <!-- 🔹 Source Type -->
                <div class="row">
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Member_Account", new { @class = "form-check-input", id = "memberAccountOption" })
                            <label class="form-check-label" for="memberAccountOption">@CashDeskRessource.ItSAMember</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Cash_Collected", new { @class = "form-check-input", id = "cashCollectionOption" })
                            <label class="form-check-label" for="cashCollectionOption">@CashDeskRessource.NoneMemberOrStaff</label>
                        </div>
                    </div>
                </div>

                <!-- 🔹 Event Code -->
                <div class="col-md-12">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.EventCode,
                            new SelectList(ViewBag.EventCodes, "Value", "Text"),
                            "---" + @CashDeskRessource.SelectEventItem + "---",
                            new { @class = "form-control select2", @id = "BulkDeposit_OtherTransaction_EventCode" })
                        <label for="BulkDeposit_OtherTransaction_EventCode">@CashDeskRessource.WhatEventItem</label>
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.EventCode, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- 🔹 Member Name -->
                <div class="col-md-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.BulkDeposit.OtherTransaction.MemberName, new { @class = "form-control", @id = "Name" })
                        <label for="MemberName">@CashDeskRessource.EnterIndividualName</label>
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.MemberName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- 🔹 Narration -->
                <div class="col-md-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.BulkDeposit.OtherTransaction.Narration, new { @class = "form-control", @style = "height: 80px;", @id = "Naration" })
                        <label for="Naration">@CashDeskRessource.NarationOrDescription</label>
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Narration, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- 🔹 Optional Non-Member Payment Partial -->
                @Html.Partial("_NoneMemberPayment")

            </div>

            <!-- 🔹 Action Buttons -->
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="OtherCashInExpense" id="OperationType" />
                <input type="hidden" name="customerId" value="" id="customerId" />

                <button type="submit" id="submitExpense" class="btn btn-primary me-2" onclick="PostExpense()">
                    <i class="fas fa-save me-1"></i> @GlobalShared.Post
                </button>

                <button type="button" id="reprintExpense" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @GlobalShared.Re_print
                </button>

                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
    </fieldset>
</div>


<script>
    function toggleBranchDropdown() {
        const checkbox = document.getElementById("isInterBranchCheck");
        const dropdownContainer = document.getElementById("branchDropdownContainer");
        const label = document.getElementById("interBranchLabel");

        if (checkbox.checked) {
            dropdownContainer.style.display = "block";
            label.innerText = "📍 Select Destination Branch";
        } else {
            dropdownContainer.style.display = "none";
            label.innerText = "🔄 Enable Inter-Branch Transaction";
        }
    }
</script>

