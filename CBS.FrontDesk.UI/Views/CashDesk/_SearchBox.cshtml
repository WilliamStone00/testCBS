@using Resources

<fieldset class="fieldset-custom p-3 shadow-sm mb-1">
    <legend class="fw-bold text-primary mb-1">
        <i class="mdi mdi-account-search me-1"></i> @GlobalShared.Search
    </legend>

    <div class="row">
        <div class="col-md-10 mx-auto">
            <!-- 🔍 Search Input + Button -->
            <div class="input-group shadow-sm">
                <input type="text" id="manualSearchInput" class="form-control"
                       placeholder="@CashDeskRessource.EnterMemberReferenceNumber"
                       aria-label="@CashDeskRessource.EnterMemberReferenceNumber" />
                <button class="btn btn-primary" type="button" onclick="GetMember()">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
                </button>
            </div>

            <!-- ℹ️ Help Text -->
            <div class="form-text text-muted mt-2">
                <i class="fas fa-info-circle me-1 text-info"></i>
                @CashDeskRessource.EnterThe10DigitMemberReferenceNumber
                <br />
                <i class="fas fa-lock me-1 text-info"></i>
                @CashDeskRessource.PerformSecureCashDepositsIntoMemberAccounts
            </div>
        </div>
    </div>
</fieldset>

<!-- Hidden field to track selected operation -->
<input type="hidden" id="currentselectedOperation" value="" />

<!-- 🖨 Reprint Button -->
<div class="text-end mb-3">
    <button type="button" class="btn btn-outline-secondary" onclick="Reprint()">
        <i class="fas fa-print me-1"></i> @GlobalShared.Re_print
    </button>
</div>
