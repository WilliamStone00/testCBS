@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources

<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend>@CashDesk_OtherCashMobileMoneyForm.MobileMoneyOperations</legend>
        <hr style="border: 2px solid green;" />
        <div class="change-group">
            <div class="row mt-2 gy-4">
                <div class="row">
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.AddOtherTransactionMobileMoneyCommand.SourceType, "MobileMoneyMTN", new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyMTN" })
                            <label class="form-check-label shadow-input-boxes" for="MobileMoneyMTN">@CashDesk_OtherCashMobileMoneyForm.MobileMoneyMTN</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.AddOtherTransactionMobileMoneyCommand.SourceType, "MobileMoneyORANGE", new { @class = "form-check-input shadow-input-boxes", id = "MobileMoneyORANGE" })
                            <label class="form-check-label shadow-input-boxes" for="MobileMoneyORANGE">@CashDesk_OtherCashMobileMoneyForm.MobileMoneyOrange</label>
                        </div>
                    </div>
                </div>
                <hr style="border: 2px solid orange;" />
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.AddOtherTransactionMobileMoneyCommand.BookingDirection, "Deposit", new { @class = "form-check-input shadow-input-boxes", @id = "deposit" })
                                <label class="form-check-label shadow-input-boxes" for="Deposit">@CashDesk_OtherCashMobileMoneyForm.CashIn</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.AddOtherTransactionMobileMoneyCommand.BookingDirection, "Withdrawal", new { @class = "form-check-input shadow-input-boxes" })
                                <label class="form-check-label shadow-input-boxes" for="Withdrawal">@CashDesk_OtherCashMobileMoneyForm.CashOut</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_OtherCashMobileMoneyForm.TotalAmount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddOtherTransactionMobileMoneyCommand.MemberReference, new { @class = "form-control shadow-input-boxes", @id = "customerId" })
                        @Html.ValidationMessageFor(m => m.AddOtherTransactionMobileMoneyCommand.MemberReference, "", new { @class = "text-danger " })
                        <label>@CashDesk_OtherCashMobileMoneyForm.NoneMemberRef</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddOtherTransactionMobileMoneyCommand.CustomerName, new { @class = "form-control shadow-input-boxes", @id = "MemberName" })
                        @Html.ValidationMessageFor(m => m.AddOtherTransactionMobileMoneyCommand.CustomerName, "", new { @class = "text-danger " })
                        <label>@CashDesk_OtherCashMobileMoneyForm.RepresentativeName</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddOtherTransactionMobileMoneyCommand.TelephoneNumber, new { @class = "form-control shadow-input-boxes", @id = "TelephoneNumber" })
                        @Html.ValidationMessageFor(m => m.AddOtherTransactionMobileMoneyCommand.TelephoneNumber, "", new { @class = "text-danger " })
                        <label>@CashDesk_OtherCashMobileMoneyForm.Number</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddOtherTransactionMobileMoneyCommand.CNI, new { @class = "form-control shadow-input-boxes", @id = "CNI" })
                        @Html.ValidationMessageFor(m => m.AddOtherTransactionMobileMoneyCommand.CNI, "", new { @class = "text-danger " })
                        <label>@CashDesk_OtherCashMobileMoneyForm.CNI</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.AddOtherTransactionMobileMoneyCommand.TellerCode, new { @class = "form-control shadow-input-boxes", @id = "TellerCode" })
                        @Html.ValidationMessageFor(m => m.AddOtherTransactionMobileMoneyCommand.TellerCode, "", new { @class = "text-danger " })
                        <label>@CashDesk_OtherCashMobileMoneyForm.TillCode</label>
                    </div>
                </div>
                <div class="table-responsive" id="cash_collected" style="width: 100%;">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <tr>
                                <th style="display:none;">@CashDesk_OtherCashMobileMoneyForm.ProductID</th>
                                <th style="display:none;">@CashDesk_OtherCashMobileMoneyForm.OrdinaryAccounts</th>
                                <th>@CashDesk_OtherCashMobileMoneyForm.Amount</th>
                                <th style="display:none;">@CashDesk_OtherCashMobileMoneyForm.Fee</th>
                                <th>@CashDesk_OtherCashMobileMoneyForm.Total</th>
                                <th>@CashDesk_OtherCashMobileMoneyForm.Confirm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.BulkDeposits.Where(x => x.AccountType.ToLower() != "loan").OrderBy(t => t.AccountType))
                            {
                                <tr>
                                    <td style="display:none;">@d.AccountNumber</td>
                                    <td style="display:none;">@d.AccountType</td>
                                    <td>
                                        <input type="number" class="form-control amount-input shadow-input-boxes" value="@d.Amount">
                                    </td>
                                    <td style="display:none;">
                                        <input type="number" class="form-control fee-input shadow-input-boxes" value="@d.Fee">
                                    </td>
                                    <td>
                                        <span class="total-span">@d.Total</span>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input shadow-input-boxes">
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td style="display:none;"></td>
                                <td style="display:none;"></td>
                                <td colspan="1" style="text-align: right;"><strong>@CashDesk_OtherCashMobileMoneyForm.Total:</strong></td>
                                <td id="tableTotal">0</td>
                            </tr>
                            <tr>
                                <td style="display:none;"></td>
                                <td style="display:none;"></td>
                                <td colspan="1" style="text-align: right;"><strong>@CashDesk_OtherCashMobileMoneyForm.Difference:</strong></td>
                                <td id="tableBalance">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="MobileMoney" id="OperationType" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostMobileMoney()">
                    <i class="fas fa-save me-1"></i> @CashDesk_OtherCashMobileMoneyForm.Post
                </button>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @CashDesk_OtherCashMobileMoneyForm.Reprint
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherCashMobileMoneyForm.Reset
                </button>
            </div>
        </div>
        <hr style="border: 2px solid green;" />
    </fieldset>
</div>


