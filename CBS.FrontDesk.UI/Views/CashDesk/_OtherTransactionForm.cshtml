@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    var selectedSourceType = Model?.BulkDeposit?.OtherTransaction?.SourceType ?? "Cash_Collected";
    var isOut = (string)ViewBag.FormContext == "OtherCashOut";
    var legendClass = isOut ? "text-danger" : "text-success"; // red for expense, green for income
    var legendIcon = isOut ? "💸" : "💰";
    var legendText = isOut ? "Other Cash-Out" : "Other Cash-In";
}

<style>
    /* The cell wrapper for the select */
    .alloc-cell {
        position: relative;
        /* IMPORTANT: allow the popup to be clickable */
        overflow: visible; /* was hidden */
    }

        /* Select2 should fill the cell, text truncates with … */
        .alloc-cell .select2-container {
            width: 100% !important;
        }

        .alloc-cell .select2-selection--single {
            max-width: 100%;
        }

        .alloc-cell .select2-selection__rendered {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Keep the dropdown no wider than the cell, but make it clickable above neighbors */
        .alloc-cell .select2-dropdown {
            width: 100% !important;
            max-width: 100% !important;
        }

    /* When open, guarantee it sits above table/headers/etc */
    .select2-container--open .select2-dropdown {
        z-index: 9999 !important; /* was 2000; raise to win stacking */
    }

    /* Let options wrap so the menu stays narrow */
    .select2-results__option {
        white-space: normal;
    }

    /* Textarea look (unchanged) */
    .autosize {
        overflow: hidden;
        resize: none;
        line-height: 1.25rem;
    }

    .alloc-note {
        max-height: 7.5rem;
    }
    /* ~6 lines */

    /* Compact fieldset + legend */
    .fieldset-custom {
        border-radius: 8px;
    }

    #contextTitle {
        margin-bottom: .75rem !important;
    }

    /* Tighter vertical rhythm */
    .form-wrapper .mb-4 {
        margin-bottom: 1rem !important;
    }

    .form-wrapper .mb-3 {
        margin-bottom: .75rem !important;
    }

    .form-wrapper .form-floating > .form-control {
        min-height: 2.5rem;
    }

    .form-wrapper .form-floating > label {
        padding: .25rem .75rem;
    }

    /* Right-aligned “Total Amount” badge */
    .total-badge {
        display: inline-block;
        background: #f6f6f6;
        border: 1px solid #ddd;
        color: #333;
        font-weight: 700;
        border-radius: .5rem;
        padding: .35rem .6rem;
    }

    /* Make Select2 match form-control height in this form */
    .select2-container--default .select2-selection--single {
        height: 2.5rem;
        border: 1px solid #ced4da;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 2.4rem;
            padding-left: .75rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 2.5rem;
        }
</style>




@if (ViewBag.Operation == "income_expense")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom p-3">
            <input type="hidden" id="FormContext" value="@ViewBag.FormContext" />

            <legend class="h6 mb-3 @(isOut ? "text-danger" : "text-primary")" id="contextTitle">
                @(isOut ? "💸 Other Cash-Out" : "💰 Other Cash-In")
            </legend>

            <!-- Inter-Branch + Source + Total -->
            <div class="row g-3 align-items-center mb-3">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check m-0">
                            <input type="checkbox" class="form-check-input" id="isInterBranchCheck" onchange="toggleBranchDropdown()" />
                            <label class="form-check-label fw-semibold" for="isInterBranchCheck" id="interBranchLabel">
                                🔄 Enable Inter-Branch Transaction
                            </label>
                        </div>

                        <div class="form-check form-check-inline m-0">
                            <span class="fw-semibold me-2">@CashDesk_OtherTransactionForm.SelectSource</span>
                            @Html.RadioButtonFor(
                                m => m.BulkDeposit.OtherTransaction.SourceType,
                                "Cash_Collected",
                                new { @class = "form-check-input", id = "cashCollectionOption", @onclick = "toggleAccountDropdown()" }
                            )
                            <label class="form-check-label" for="cashCollectionOption" id="sourceCollectLabel">
                                @(isOut ? "Payout Cash" : "Collect Cash")
                            </label>
                        </div>
                    </div>

                    <!-- Inter-branch destination dropdown (only when checked) -->
                    <div id="branchDropdownContainer" class="mt-2" style="display:none;">
                        <div class="form-floating">
                            @Html.DropDownListFor(
                                m => m.BulkDeposit.OtherTransaction.ExternalBranchId,
                                new SelectList(ViewBag.Branches, "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-control select2", @id = "ExternalBranchId" }
                            )
                            <label for="ExternalBranchId">Destination Branch</label>
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.ExternalBranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @* -------- NEW: Other Source (Cash-OUT only) -------- *@
                    @if (isOut)
                    {
                        <div class="mt-3">
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsOtherSource"
                                       onchange="OtherSourceUI.toggle()">
                                <label class="form-check-label fw-semibold" for="IsOtherSource">
                                    Use another source GL (e.g., petty cash)
                                </label>
                            </div>

                            <div id="OtherSourceContainer" class="mt-2" style="display:none;">
                                <div class="form-floating">
                                    @Html.DropDownList(
                                        "OtherSourceOfAccountId",
                                        new SelectList((IEnumerable<dynamic>)ViewBag.AccountIds ?? new List<dynamic>(), "Value", "Text"),
                                        "--- Select Source GL ---",
                                        new { @class = "form-control select2", @id = "OtherSourceOfAccountId" }
                                    )
                                    <label for="OtherSourceOfAccountId">Source GL (credited)</label>
                                    <span class="small text-muted d-block mt-1">
                                        This GL will be credited as the source of funds for the expense.
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                    @* -------- /NEW -------- *@
                </div>

                <div class="col-lg-4 d-flex justify-content-lg-end">
                    <span class="total-badge" id="lblDepositRequest_amount">
                        @CashDesk_OtherTransactionForm.TotalAmount 0.0
                    </span>
                    <input type="hidden" id="totalNoteAmount" value="0" />
                </div>
            </div>

            <!-- Name / CNI / Phone -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        @Html.TextBoxFor(
                            m => m.BulkDeposit.OtherTransaction.MemberName,
                            new { @class = "form-control", @id = "Name", placeholder = "Name" }
                        )
                        <label for="Name">@CashDesk_OtherTransactionForm.Name</label>
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.MemberName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" id="CNI" class="form-control" placeholder="CNI" />
                        <label for="CNI">CNI</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="tel" id="TelephoneNumber" class="form-control" inputmode="tel" placeholder="Telephone" />
                        <label for="TelephoneNumber">Telephone</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-floating">
                    @Html.TextAreaFor(
                        m => m.BulkDeposit.OtherTransaction.Narration,
                        new { @class = "form-control", @style = "height:74px;", @id = "DepositerNote", placeholder = "Narration / Description" }
                    )
                    <label for="DepositerNote">@CashDesk_OtherTransactionForm.NarrationDescription</label>
                    @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Narration, "", new { @class = "text-danger" })
                </div>
            </div>

            @Html.Partial("_OtherPaymentFormDetail")

            <div class="d-flex justify-content-end mt-3">
                <input type="hidden" name="OperationType" value="@(isOut ? "OtherCashOut" : "OtherCashIn")" id="OperationType" />
                <input type="hidden" name="customerId" value="" id="customerId" />

                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostOtherCashIn()">
                    <i class="fas fa-save me-1"></i> @CashDesk_OtherTransactionForm.Post
                </button>

                <button type="button" id="reprint" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @CashDesk_OtherTransactionForm.Reprint
                </button>

                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherTransactionForm.Reset
                </button>
            </div>
        </fieldset>
    </div>
}


else if (ViewBag.Operation == "transfer_non_member")
{


    <div class="form-wrapper">
        <fieldset class="fieldset-custom p-3">
            <input type="hidden" id="FormContext" value="@ViewBag.FormContext" />

            <!-- Context-sensitive legend -->
            <legend class="@legendClass h6" id="contextTitle">
                @legendIcon @legendText
            </legend>

            <!-- Inter-Branch + Source + Total -->
            <div class="row g-3 align-items-center mb-3">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check m-0">
                            <input type="checkbox" class="form-check-input" id="isInterBranchCheck" onchange="toggleBranchDropdown()" />
                            <label class="form-check-label fw-semibold" for="isInterBranchCheck" id="interBranchLabel">
                                🔄 Enable Inter-Branch Transaction
                            </label>
                        </div>

                        <div class="form-check form-check-inline m-0">
                            <span class="fw-semibold me-2">Select Source</span>
                            @Html.RadioButtonFor(
                              m => m.BulkDeposit.OtherTransaction.SourceType,
                              "Cash_Collected",
                              new { @class = "form-check-input", id = "cashCollectionOption", @onclick = "toggleAccountDropdown()" }
                            )
                            <label class="form-check-label" for="cashCollectionOption" id="sourceCollectLabel">
                                @(isOut ? "Payout Cash" : "Collect Cash")
                            </label>
                        </div>
                    </div>

                    <div id="branchDropdownContainer" class="mt-2" style="display:none;">
                        <div class="form-floating">
                            @Html.DropDownListFor(
                              m => m.BulkDeposit.OtherTransaction.ExternalBranchId,
                              new SelectList(ViewBag.Branches, "Id", "Name"),
                              "--- Select Branch ---",
                              new { @class = "form-control select2", @id = "ExternalBranchId" })
                            <label for="ExternalBranchId">Destination Branch</label>
                            @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.ExternalBranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 d-flex justify-content-lg-end">
                    <span class="total-badge" id="lblDepositRequest_amount">
                        Total Amount: 0.0
                    </span>
                    <input type="hidden" id="totalNoteAmount" value="0" />
                </div>
            </div>

            <!-- rest of your form... -->
        </fieldset>
    </div>

}

else if (ViewBag.Operation == "withdrawal_non_member")
{
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend>@CashDesk_OtherTransactionForm.CashOut</legend>
            <hr />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">@CashDesk_OtherTransactionForm.MembersName: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_OtherTransactionForm.TotalAmount: 0.0</span>
                            <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                        </div>
                    </div>
                    <div class="table-responsive" style="width: 100%;">
                        <table class="table table-hover" id="myDataTableT">
                            <thead class="table-light">
                                <tr>
                                    <th style="display:none;">@CashDesk_OtherTransactionForm.ProductID</th>
                                    <th>@CashDesk_OtherTransactionForm.OrdinaryAccounts</th>
                                    <th>@CashDesk_OtherTransactionForm.Amount</th>
                                    <th>@CashDesk_OtherTransactionForm.FeeCharges</th>
                                    <th>@CashDesk_OtherTransactionForm.Total</th>
                                    <th>@CashDesk_OtherTransactionForm.Confirm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.BulkDeposits.Where(x => x.AccountType.ToLower() !=
                                "loan").OrderBy(t => t.AccountType))
                                {
                                    <tr>
                                        <td style="display:none;">@d.AccountNumber</td>
                                        <td>@d.AccountType</td>
                                        <td>
                                            <input type="number" class="form-control amount-input shadow-input-boxes"
                                                   value="@d.Amount">
                                        </td>
                                        <td>
                                            <input type="number" class="form-control fee-input shadow-input-boxes"
                                                   value="@d.Fee">
                                        </td>
                                        <td>
                                            <span class="total-span">@d.Total</span>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input">
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Total:</strong></td>
                                    <td id="tableTotal">0</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="4" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Balance:</strong></td>
                                    <td id="tableBalance">0</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    @*<div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextAreaFor(m => m.BulkDeposit.Note, new { @class = "form-control", @style = "height:
                                75px;", @id = "Note" })
                                @Html.ValidationMessageFor(m => m.BulkDeposit.Note, "", new { @class = "text-danger " })
                                <label for="formValidationDob">Reasons for cash out</label>
                            </div>
                        </div>*@
                </div>
                <div class="header-buttons mt-4 float-end">
                    <input type="hidden" name="OperationType" value="Withdrawal" id="OperationType" />
                    <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                    <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostCashOut()">
                        <i class="fas fa-money-bill-wave me-1"></i> @CashDesk_OtherTransactionForm.CashOut
                    </button>
                    <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                        <i class="fas fa-print me-1"></i> @CashDesk_OtherTransactionForm.Reprint
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherTransactionForm.Reset
                    </button>
                </div>
            </div>
        </fieldset>
    </div>

}



<script>
    function toggleBranchDropdown() {
        const checkbox = document.getElementById("isInterBranchCheck");
        const dropdownContainer = document.getElementById("branchDropdownContainer");
        const label = document.getElementById("interBranchLabel");

        if (checkbox.checked) {
            dropdownContainer.style.display = "block";
            label.innerText = "📍 Select Destination Branch";
        } else {
            dropdownContainer.style.display = "none";
            label.innerText = "🔄 Enable Inter-Branch Transaction";
        }
    }
</script>
