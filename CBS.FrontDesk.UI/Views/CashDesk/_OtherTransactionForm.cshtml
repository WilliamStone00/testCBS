@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
    @using Resources
@{
    var selectedSourceType = Model?.BulkDeposit?.OtherTransaction?.SourceType ?? "Cash_Collected";
}
@if (ViewBag.Operation == "income_expense")
{
   <div class="form-wrapper">
       <fieldset class="fieldset-custom p-4">
           <legend class="text-primary h5 mb-4">💰 @CashDesk_OtherTransactionForm.OtherCashIn</legend>

           <!-- Source Type Selection -->
           <div class="mb-4">
               <label class="fw-semibold mb-2 d-block">@CashDesk_OtherTransactionForm.SelectSource</label>
               <div class="form-check">
                   @Html.RadioButton("BulkDeposit.OtherTransaction.SourceType", "Cash_Collected", true, new
                {
                @class = "form-check-input",
                id = "cashCollectionOption",
                @onclick = "toggleAccountDropdown()"
                })
                   <label class="form-check-label" for="cashCollectionOption">@CashDesk_OtherTransactionForm.CollectCash</label>
               </div>
           </div>

           <!-- Event Item -->
           <div class="mb-4">
               <div class="form-floating shadow-sm">
                   <label for="BulkDeposit_OtherTransaction_EventCode">@CashDesk_OtherTransactionForm.EventItem</label>
                   @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.EventCode,
                new SelectList(ViewBag.EventCodes, "Value", "Text"),
                "---Select Event Item---",
                new { @class = "form-control select2", @id = "BulkDeposit_OtherTransaction_EventCode" })
                   @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.EventCode, "", new
                   {
                       @class =
                   "text-danger"
                   })
               </div>
           </div>

           <!-- Member Name -->
           <div class="mb-4">
               <div class="form-floating shadow-sm">
                   @Html.TextBoxFor(m => m.BulkDeposit.OtherTransaction.MemberName, new
                   {
                       @class = "form-control",
                       @id =
                "Name"
                   })
                   @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.MemberName, "", new
                   {
                       @class =
                   "text-danger"
                   })
                   <label for="Name">@CashDesk_OtherTransactionForm.Name</label>
               </div>
           </div>

           <!-- Narration -->
           <div class="mb-4">
               <div class="form-floating shadow-sm">
                   @Html.TextAreaFor(m => m.BulkDeposit.OtherTransaction.Narration,
                new { @class = "form-control", style = "height: 80px;", @id = "DepositerNote" })
                   @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.Narration, "", new
                   {
                       @class =
                   "text-danger"
                   })
                   <label for="DepositerNote">@CashDesk_OtherTransactionForm.NarrationDescription</label>
               </div>
           </div>

           <!-- Summary Display -->
           <div class="row mb-4">
               <div class="col-md-6"></div>
               <div class="col-md-6 text-end">
                   <span class="formatted-amount shadow-box fw-bold" id="lblDepositRequest_amount">
                       @CashDesk_OtherTransactionForm.TotalAmount 0.0
                   </span>
                   <input type="hidden" id="totalNoteAmount" value="0" />
               </div>
           </div>

           <!-- 🔹 Include Non-Member Payment Info -->
           @Html.Partial("_NoneMemberPayment")

           <!-- Action Buttons -->
           <div class="d-flex justify-content-end mt-4">
               <input type="hidden" name="OperationType" value="OtherCashIn" id="OperationType" />
               <input type="hidden" name="customerId" value="" id="customerId" />

               <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostOtherCashIn()">
                   <i class="fas fa-save me-1"></i> @CashDesk_OtherTransactionForm.Post
               </button>
               <button type="button" id="reprint" class="btn btn-secondary me-2" onclick="Reprint()">
                   <i class="fas fa-print me-1"></i> @CashDesk_OtherTransactionForm.Reprint
               </button>
               <button type="reset" class="btn btn-outline-secondary">
                   <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherTransactionForm.Reset
               </button>
           </div>
       </fieldset>
   </div>
}

else if (ViewBag.Operation == "transfer_non_member")
{
<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend>@CashDesk_OtherTransactionForm.SavingWithdrawalNotificationCharges</legend>
        <hr />
        <div class="change-group">
            <div class="row mt-2 gy-4">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box float-start">@CashDesk_OtherTransactionForm.MembersName: @Model.Customer.name</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_OtherTransactionForm.TotalAmount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    </div>
                </div>
                <div class="table-responsive" style="width: 100%;">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <tr>
                                <th style="display:none;">@CashDesk_OtherTransactionForm.NotificationId</th>
                                <th>@CashDesk_OtherTransactionForm.RequestedAmount</th>
                                <th>@CashDesk_OtherTransactionForm.FormCharges</th>
                                <th>@CashDesk_OtherTransactionForm.Status</th>
                                <th>@CashDesk_OtherTransactionForm.IDW</th>
                                <th>@CashDesk_OtherTransactionForm.Grace</th>
                                <th>@CashDesk_OtherTransactionForm.Total</th>
                                <th>@CashDesk_OtherTransactionForm.Confirm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.WithdrawalNotifications.Where(x => !x.IsWithdrawalDone).OrderBy(t
                            => t.NotificationDate))
                            {
                                <tr>
                                    <td style="display:none;">@d.Id</td>
                                    <td>
                                        <input type="number" class="form-control amount-input shadow-input-boxes"
                                               value="@d.AmountRequired">
                                    </td>
                                    <td>
                                        <input type="number" class="form-control fee-input shadow-input-boxes"
                                               value="@d.FormNotificationCharge" readonly="readonly">
                                    </td>
                                    <td>
                                        <span class="status">@d.ApprovalStatus</span>
                                    </td>
                                    <td>
                                        <span class="doiw">@d.DateOfIntendedWithdrawal.ToShortDateString()</span>
                                    </td>
                                    <td>
                                        <span class="dogp">@d.GracePeriodDate.ToShortDateString()</span>
                                    </td>
                                    <td>
                                        <span class="total-span">@d.Total</span>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input">
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Total:</strong></td>
                                <td id="tableTotal">0</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="6" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Balance:</strong></td>
                                <td id="tableBalance">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="SavingWithdrawalFormFee" id="OperationType" />
                <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostWithdrawalFromFee()">
                    <i class="fas fa-money-bill-wave me-1"></i> @CashDesk_OtherTransactionForm.ConfirmPayment
                </button>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @CashDesk_OtherTransactionForm.Reprint
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherTransactionForm.Reset
                </button>
            </div>
        </div>
    </fieldset>
</div>

}

else if (ViewBag.Operation == "withdrawal_non_member")
{
<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend>@CashDesk_OtherTransactionForm.CashOut</legend>
        <hr />
        <div class="change-group">
            <div class="row mt-2 gy-4">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box float-start">@CashDesk_OtherTransactionForm.MembersName: @Model.Customer.name</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@CashDesk_OtherTransactionForm.TotalAmount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    </div>
                </div>
                <div class="table-responsive" style="width: 100%;">
                    <table class="table table-hover" id="myDataTableT">
                        <thead class="table-light">
                            <tr>
                                <th style="display:none;">@CashDesk_OtherTransactionForm.ProductID</th>
                                <th>@CashDesk_OtherTransactionForm.OrdinaryAccounts</th>
                                <th>@CashDesk_OtherTransactionForm.Amount</th>
                                <th>@CashDesk_OtherTransactionForm.FeeCharges</th>
                                <th>@CashDesk_OtherTransactionForm.Total</th>
                                <th>@CashDesk_OtherTransactionForm.Confirm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.BulkDeposits.Where(x => x.AccountType.ToLower() !=
                            "loan").OrderBy(t => t.AccountType))
                            {
                                <tr>
                                    <td style="display:none;">@d.AccountNumber</td>
                                    <td>@d.AccountType</td>
                                    <td>
                                        <input type="number" class="form-control amount-input shadow-input-boxes"
                                               value="@d.Amount">
                                    </td>
                                    <td>
                                        <input type="number" class="form-control fee-input shadow-input-boxes"
                                               value="@d.Fee">
                                    </td>
                                    <td>
                                        <span class="total-span">@d.Total</span>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input">
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Total:</strong></td>
                                <td id="tableTotal">0</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="4" style="text-align: right;"><strong>@CashDesk_OtherTransactionForm.Balance:</strong></td>
                                <td id="tableBalance">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                @*<div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.BulkDeposit.Note, new { @class = "form-control", @style = "height:
                        75px;", @id = "Note" })
                        @Html.ValidationMessageFor(m => m.BulkDeposit.Note, "", new { @class = "text-danger " })
                        <label for="formValidationDob">Reasons for cash out</label>
                    </div>
                </div>*@
            </div>
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="Withdrawal" id="OperationType" />
                <input type="hidden" name="customerId" value="@Model.CustomerId" id="customerId" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostCashOut()">
                    <i class="fas fa-money-bill-wave me-1"></i> @CashDesk_OtherTransactionForm.CashOut
                </button>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @CashDesk_OtherTransactionForm.Reprint
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @CashDesk_OtherTransactionForm.Reset
                </button>
            </div>
        </div>
    </fieldset>
</div>

}



