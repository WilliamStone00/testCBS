@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = @CashDeskRessource.CashDeskCashinTitle;
}
<style>
    .is-invalid {
        border-color: red !important;
        background-color: #fff0f0;
    }
</style>
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-1">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash me-2"></i> @CashDeskRessource.CashDeskManagement
                </h1>

                <p class="card-text">
                    @CashDeskRessource.WelcomeToTheCashDesk
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <!-- Collapsible Description Section -->
    <div class="col-12">
        <div class="accordion" id="helpTipsAccordion">
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span>
                        <i class="mdi mdi-information-outline me-2"></i> @GlobalShared.HELP_TIPS
                    </span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                    <div class="card-body">
                        <div class="accordion" id="helpDetailsAccordion">
                            <!-- Loan Repayment Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepayment" aria-expanded="false" aria-controls="collapseLoanRepayment">
                                        @CashDeskRessource.LoanRepayment
                                    </button>
                                </h2>
                                <div id="collapseLoanRepayment" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>
                                                @CashDeskRessource.ToPerformALoanRepaymentClickTheIcon:
                                                <ul>
                                                    <li>@CashDeskRessource.AEnterDenominations.</li>
                                                    <li>@CashDeskRessource.EnterAmountInThe <strong>@GlobalShared.EnterCapital</strong> @CashDeskRessource.Column.</li>
                                                    <li>@CashDeskRessource.EnterInterestInThe <strong>@GlobalShared.EnterInterest</strong> @CashDeskRessource.Column.</li>
                                                    <li>@CashDeskRessource.EnterPenaltyInThe <strong>@GlobalShared.EnterPenalty</strong> @CashDeskRessource.Column.</li>
                                                    <li>@CashDeskRessource.IfTheLoanHasVATTheVATIsAutomaticallyCalculatedOnInterestInput.</li>
                                                    <li>@CashDeskRessource.FCheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                </ul>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Cash In Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCashIn" aria-expanded="false" aria-controls="collapseCashIn">
                                        @GlobalShared.Cash_In
                                    </button>
                                </h2>
                                <div id="collapseCashIn" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>
                                                @CashDeskRessource.ToPerformACashInOrDepositWithoutChargesClickThe <strong>@GlobalShared.Cash_In</strong> @GlobalShared.Icon:
                                                <ul>
                                                    <li>@CashDeskRessource.EnterDenominations.</li>
                                                    <li>@CashDeskRessource.EnterTheAmountInThe <strong>@GlobalShared.Amount</strong> @CashDeskRessource.ColumnOfAnyListedAccountOfYourChoice.</li>
                                                    <li>@CashDeskRessource.CheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                </ul>
                                            </li>
                                            <li>
                                                @CashDeskRessource.ToPerformACashInOrDepositWithChargesClickThe <strong>@GlobalShared.Cash_In</strong> @GlobalShared.Icon:
                                                <ul>
                                                    <li>@CashDeskRessource.EnterDenominations.</li>
                                                    <li>@CashDeskRessource.EnterTheAmountInThe <strong>@GlobalShared.Amount</strong> @CashDeskRessource.ColumnAndChargesInThe <strong>@CashDeskRessource.Fee</strong> @CashDeskRessource.ColumnOfAnyListedAccountOfYourChoice.</li>
                                                    <li>@CashDeskRessource.CheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <strong>@CashDeskRessource.NB:</strong> @CashDeskRessource.AnyChargeInputtedIncorrectlyWillBeRejectedBecauseTheSystemIsConfiguredToValidateAllNecessaryCharges.
                                    </div>
                                </div>
                            </div>
                            <!-- Cash Out Section -->
                            <div class="accordion-item mt-2">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCashOut" aria-expanded="false" aria-controls="collapseCashOut">
                                        @GlobalShared.Cash_out
                                    </button>
                                </h2>
                                <div id="collapseCashOut" class="accordion-collapse collapse" data-bs-parent="#helpDetailsAccordion">
                                    <div class="accordion-body">
                                        <p>@CashDeskRessource.InCashOutTheFeeCanEitherBeInclusiveOrExclusive.</p>
                                        <ul>
                                            <li>
                                                @CashDeskRessource.ToPerformACashOutWithoutChargesClickThe <strong>@GlobalShared.Cash_out</strong> @GlobalShared.Icon:
                                                <ul>
                                                    <li>@CashDeskRessource.EnterDenominations.</li>
                                                    <li>@CashDeskRessource.EnterTheAmountInThe <strong>@GlobalShared.Amount</strong> @CashDeskRessource.ColumnOfAnyListedAccountOfYourChoice.</li>
                                                    <li>@CashDeskRessource.CheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                </ul>
                                            </li>
                                            <li>
                                                @CashDeskRessource.ToPerformACashOutWithChargesChooseOneOfTheFollowing:
                                                <ul>
                                                    <li>
                                                        <strong>@CashDeskRessource.ChargesInclusive:</strong> @CashDeskRessource.TheChargeIsDebitedDirectlyFromTheMembersBalanceAndTheFullRequestedAmountIsGivenToTheMember:
                                                        <ul>
                                                            <li>@CashDeskRessource.EnterDenominations.</li>
                                                            <li>@CashDeskRessource.EnterTheAmountInThe <strong>@GlobalShared.Amount</strong> @CashDeskRessource.ColumnAndChargesInThe <strong>@CashDeskRessource.Fee</strong> @CashDeskRessource.ColumnOfAnyListedAccountOfYourChoice.</li>
                                                            <li>@CashDeskRessource.CheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                            <li>@CashDeskRessource.CheckThe <strong>@GlobalShared.Inc</strong> @CashDeskRessource.Box.</li>
                                                            <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                        </ul>
                                                    </li>
                                                    <li>
                                                        <strong>@CashDeskRessource.ChargesExclusive:</strong> @CashDeskRessource.TheCashierCollectsTheChargeFromTheMemberDuringTheOperationCashOperation:
                                                        <ul>
                                                            <li>@CashDeskRessource.EnterDenominations.</li>
                                                            <li>@CashDeskRessource.EnterTheAmountInThe <strong>@GlobalShared.Amount</strong> @CashDeskRessource.ColumnAndChargesInThe <strong>@CashDeskRessource.Fee</strong> @CashDeskRessource.ColumnOfAnyListedAccountOfYourChoice.</li>
                                                            <li>@CashDeskRessource.CheckThe <strong>@CashDeskRessource.CONF</strong> @GlobalShared.Checkbox.</li>
                                                            <li>@CashDeskRessource.DoNotCheckThe <strong>@GlobalShared.Inc</strong> @CashDeskRessource.Box.</li>
                                                            <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong>. @CashDeskRessource.AfterASuccessfulTransactionClick <strong>@GlobalShared.Re_print</strong> @CashDeskRessource.ToPrintTheReceipt.</li>
                                                        </ul>
                                                    </li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <strong>@CashDeskRessource.NB:</strong> @CashDeskRessource.AnyChargeInputtedIncorrectlyWillBeRejectedBecauseTheSystemIsConfiguredToValidateAllNecessaryCharges.
                                    </div>
                                </div>
                            </div>

                            <!-- Definitions Section -->
                            <div class="accordion-item mt-4">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-primary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDefinitions" aria-expanded="false" aria-controls="collapseDefinitions">
                                        @GlobalShared.Definitions
                                    </button>
                                </h2>
                                <div id="collapseDefinitions" class="accordion-collapse collapse" data-bs-parent="#helpTipsAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li><strong>@CashDeskRessource.InclusiveCharges:</strong> @CashDeskRessource.TheChargeIsDebitedDirectlyFromTheMembersBalanceAndTheRequestedAmountIsGivenInFull.</li>
                                            <li><strong>@CashDeskRessource.ExclusiveCharges:</strong> @CashDeskRessource.TheCashierCollectsTheChargeInCashDirectlyFromTheMemberDuringTheOperation.</li>
                                            <li>
                                                <strong>@CashDeskRessource.WithdrawalFromSavingAccount:</strong> @CashDeskRessource.AMemberWithdraws
                                                <ul>
                                                    <li><strong>@CashDeskRessource.WithNotification:</strong> @CashDeskRessource.TheMemberNotifiedThe</li>
                                                    <li><strong>@CashDeskRessource.WithoutNotification:</strong> @CashDeskRessource.TheMemberDidNotNotifyThe</li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <h6 class="text-primary mt-3">@CashDeskRessource.ScenarioExamples:</h6>
                                        <p><strong>@GlobalShared.Cash_In:</strong> @CashDeskRessource.AMemberDeposits</p>
                                        <ul>
                                            <li><strong>@CashDeskRessource.WithoutCharges:</strong> @CashDeskRessource.TheMembersAccountIsCreditedWith</li>
                                            <li><strong>@CashDeskRessource.WithCharges:</strong> @CashDeskRessource.TheMembersAccountIsCreditedWith</li>
                                        </ul>
                                        <p><strong>@CashDeskRessource.LoanRepayment:</strong> @CashDeskRessource.AMemberRepaysALoanOf</p>
                                        <ul>
                                            <li><strong>@CashDeskRessource.WithVAT:</strong> @CashDeskRessource.TheVATIsAutomaticallyCalculatedOnTheInterestAndTheSystemDebitsTheTotalAmount.</li>
                                            <li><strong>@CashDeskRessource.WithoutVAT:</strong> @CashDeskRessource.TheTotalRepaymentAmountOf</li>
                                        </ul>
                                        <p><strong>@GlobalShared.Cash_out:</strong> @CashDeskRessource.AMemberRequestsToWithdraw</p>
                                        <ul>
                                            <li><strong>@GlobalShared.Inclusive:</strong> @CashDeskRessource.TheMemberReceives</li>
                                            <li><strong>@GlobalShared.Exclusive:</strong> @CashDeskRessource.TheMemberPaysThe</li>
                                        </ul>
                                    </div>
                                </div>
                            </div> <!-- End of Definitions Section -->

                        </div> <!-- End of helpDetailsAccordion -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- 🔘 Action Panel Section -->
<div class="row mb-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-end">
                <a href="#"
                   class="btn btn-sm btn-outline-danger d-flex align-items-center gap-2"
                   onclick="$('#tempMembersModal').modal('show'); setTimeout(loadMemberData, 300);"
                   data-bs-toggle="tooltip"
                   title="@CashDeskRessource.ManagePreRegisteredMembers">
                    <i class="mdi mdi-account-alert-outline fs-5"></i> @CashDeskRessource.PreRegisteredMembers
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col">
        <div class="row my-3">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">

                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-bank me-2"></i>
                            <span id="cashDeskOperations">@CashDeskRessource.CashOperations</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="collapseDeliveryAddress"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">

                            @Html.Partial("_SearchBox")
                            <div id="datalistingview">


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">@CashDeskRessource.LoanPayment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="modalAmount">@GlobalShared.Enter_Amount:</label>
                    <input type="number" class="form-control" id="modalAmount" placeholder="@GlobalShared.Enter_Amount">
                </div>
                <div class="form-group">
                    <label for="modalInterest">@GlobalShared.EnterInterest:</label>
                    <input type="number" class="form-control" id="modalInterest" placeholder="@GlobalShared.EnterInterest">
                </div>
                <div class="form-group">
                    <label for="modalPenalty">@GlobalShared.EnterPenalty:</label>
                    <input type="number" class="form-control" id="modalPenalty" placeholder="@GlobalShared.EnterPenalty">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
                <button type="button" class="btn btn-primary" id="modalOkButton" onclick="applyPayment()">@CashDeskRessource.OK</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="depositerModal" tabindex="-1" aria-labelledby="depositerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="depositorLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@CashDeskRessource.ProcessingTransactionPleaseWait</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary" id="depositorModalTitle">
                                <i class="mdi mdi-account-card-details-outline me-2"></i> @CashDeskRessource.DepositorInformationRequired
                            </h1>
                            <p class="card-text" id="depositorModalDescription">
                                @CashDeskRessource.ToCompleteThisTransactionPleaseEnterTheDepositorsFullInformationForRegulatoryAndAuditCompliance.
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @CashDeskRessource.WhyThisIsRequired</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDepositorTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseDepositorTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-account-check-outline text-primary me-2"></i><strong>@CashDeskRessource.IdentityTracking:</strong> @CashDeskRessource.HelpsTrackWhoCompletedTheTransaction.</li>
                            <li><i class="mdi mdi-shield-lock-outline text-success me-2"></i><strong>@GlobalShared.Compliance:</strong> @CashDeskRessource.RequiredForKYCAndAMLRegulations.</li>
                            <li><i class="mdi mdi-file-document-box-check-outline text-warning me-2"></i><strong>@CashDeskRessource.AuditTrail:</strong> @CashDeskRessource.PermanentProofOfWhoDepositedFunds.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Depositor Form Partial -->
            @Html.Partial("_DepositerForm")

            <!-- Footer -->
            <div class="modal-footer justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        @GlobalShared.Member: <span class="text-dark" id="depositorCustomerName"></span> |
                        ID: <span class="text-dark" id="depositorCustomerId"></span>
                    </span>
                </div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> @GlobalShared.Cancel
                    </button>
                    <button type="button" id="confirmDepositorBtn" class="btn btn-success ms-2">
                        <i class="mdi mdi-check-circle-outline"></i> @CashDeskRessource.ConfirmAndProceed
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


@Html.Partial("_TemporalMembersLookUp")

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/Crud/CashDesk/PreMemberOnboarding.js"></script>
<script src="~/Scripts/Js/Crud/CashDesk/CashDeskCashin.js"></script>
}
