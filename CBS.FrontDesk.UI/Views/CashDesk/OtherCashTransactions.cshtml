@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = GlobalOtherCashTransactions.OtherCashOperations;
}

<!-- 🔷 Page Title and Welcome Message -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-3">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-cash me-2"></i> @GlobalOtherCashTransactions.CashDeskManagement
                </h1>
                <p class="card-text">
                    @GlobalOtherCashTransactions.WelcomeToTheCashDeskOf <strong>TRUST SOFT CREDIT (TSC)</strong>. @GlobalOtherCashTransactions.ThisInterfaceManagesOtherCashInOperations
                </p>
                <p class="card-text">
                    @GlobalOtherCashTransactions.OtherCashInRefersToCashPhysicallyReceived
                </p>
                <p class="card-text">
                    💡 <strong>@GlobalOtherCashTransactions.Note:</strong> @GlobalOtherCashTransactions.ThisInterfaceIsStrictlyForCashInOperations
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- 🔷 Tips Section for Other Cash-In -->
<div class="row">
    <div class="col-12">
        <div class="accordion mb-4" id="tipsAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                        <i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalOtherCashTransactions.TipsAndGuidelinesForOtherCashIn
                    </button>
                </h2>
                <div id="collapseTips" class="accordion-collapse collapse" data-bs-parent="#tipsAccordion">
                    <div class="accordion-body">
                        <ul class="mb-2">
                            <li>@GlobalOtherCashTransactions.GLIntegration</li>
                            <li>@GlobalOtherCashTransactions.EventItemRequired</li>
                            <li>@GlobalOtherCashTransactions.NonMemberFocused</li>
                            <li>@GlobalOtherCashTransactions.DenominationEntry</li>
                            <li>@GlobalOtherCashTransactions.ClearNarration</li>
                            <li>@GlobalOtherCashTransactions.BranchSpecificConfiguration</li>
                        </ul>
                        <p class="text"><strong>@GlobalOtherCashTransactions.Note:</strong> @GlobalOtherCashTransactions.ThisInterfaceHandlesCashInOnly</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔷 Main Transaction Area -->
<div class="row g-4">
    <div class="col-md-3">
        <!-- Denominations Breakdown -->
        @Html.Partial("_DenominationBreakDown")
    </div>

    <div class="col-md-9">
        <!-- Collapsible Card for Cash Transactions -->
        <div class="accordion" id="collapsibleSection">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseDeliveryAddress" aria-expanded="true" aria-controls="collapseDeliveryAddress">
                        <i class="mdi mdi-bank me-2"></i> <span id="cashDeskOperations">@GlobalOtherCashTransactions.OtherCashInOperations</span>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress" class="accordion-collapse collapse show" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body p-4">
                        <!-- Cash-In Form Partial -->
                        <div class="mt-4" id="datalistingview_inner">
                            @Html.Partial("_OtherTransactionForm")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔷 Scripts -->
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/CashDesk/OtherTransactions.js"></script>
    <script src="~/Scripts/Js/Crud/CashDesk/OtherTransactions.js"></script>
}
