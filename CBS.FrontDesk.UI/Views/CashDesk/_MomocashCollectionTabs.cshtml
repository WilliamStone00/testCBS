@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources

<div class="card-body d-sm-flex d-block">
    <div class="d-flex align-items-center flex-wrap lh-1 gap-2 mb-2 mb-sm-0">

        @* Optional: customer details button – keep commented if not used now
            <a href="#"
               onclick="SearchByCustomerNumber('_CustomerCard','datalistingview')"
               class="btn btn-outline-secondary btn-sm d-flex align-items-center"
               data-bs-toggle="tooltip"
               title="View customer details">
                <i class="fas fa-user me-1"></i>
                <span class="d-none d-md-inline">Customer</span>
            </a>
        *@

        <!-- Cash-in button -->
        <a href="#"
           class="btn btn-success btn-sm d-flex align-items-center momo-op-btn active"
           data-operation="cashin_momokash_collection"
           data-bs-toggle="tooltip"
           title="@CashDesk_MomocashCollectionTabs.PerformCashinOperation"
           onclick="setMomoOperation('cashin_momokash_collection'); GetMemberData('@Model.CustomerId','_MomocashCollectionDesk','datalistingview','cashin_momokash_collection'); return false;">
            <i class="fas fa-money-check me-1"></i>
            <span>Cash-in</span>
        </a>

        <!-- Loan repayment button -->
        <a href="#"
           class="btn btn-dark btn-sm d-flex align-items-center momo-op-btn"
           data-operation="repayment_momokash_collection"
           data-bs-toggle="tooltip"
           title="@CashDesk_MomocashCollectionTabs.PerformLoanRepaymentOperation"
           onclick="setMomoOperation('repayment_momokash_collection'); GetMemberData('@Model.CustomerId','_MomocashCollectionDesk','datalistingview','repayment_momokash_collection'); return false;">
            <i class="fas fa-hand-holding-usd me-1"></i>
            <span>Loan repayment</span>
        </a>

    </div>
</div>
<script>
    function setMomoOperation(op) {
        // update hidden field
        var $opInput = $('#currentselectedOperation');
        if ($opInput.length) {
            $opInput.val(op);
        }

        // toggle active state on buttons
        $('.momo-op-btn').removeClass('active');
        $('.momo-op-btn[data-operation="' + op + '"]').addClass('active');
    }

</script>