@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = @CashDeskRessource.LoanRepaymentSimulationTitle;
}

<!-- Page Header -->
<div class="card` bg-light mb-1">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cash me-2"></i> @CashDeskRessource.LoanRepaymentSimulationAtMemberServiceDesk
        </h1>
        <p class="card-text">
            @CashDeskRessource.LoanRepaymentSimulationDescription
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>
<!-- Tips Section -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @CashDeskRessource.TipsForAccurateLoanRepaymentSimulation
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanRepaymentTips" aria-expanded="false" aria-controls="collapseLoanRepaymentTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanRepaymentTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @CashDeskRessource.PurposeOfSimulation</li>
                <li><i class="mdi mdi-cash-plus text-success me-2"></i> <strong>@CashDeskRessource.AccurateInput:</strong> @CashDeskRessource.EnterTheCorrectAmountsUnder <strong>@GlobalShared.Capital</strong>, <strong>@GlobalShared.Interest</strong>, @CashDeskRessource.And <strong>@GlobalShared.Penalty</strong> @CashDeskRessource.ToProjectTheCorrectRepaymentTotal.</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> <strong>@CashDeskRessource.VATApplicability:</strong> @CashDeskRessource.VATIsAutomaticallyAppliedToLoansOf <strong>@CashDeskRessource.TwoMillionXAFOrMore</strong>. @CashDeskRessource.SelectThe <strong>@CashDeskRessource.VATInclusive</strong> @CashDeskRessource.CheckboxIfVATIsAlreadyPartOfTheInterestEntered.</li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-primary me-2"></i> @CashDeskRessource.SummaryVerification
                    <ul>
                        <li>@CashDeskRessource.EnsureTotalRepaymentMatchesExpectations</li>
                        <li>@CashDeskRessource.DoubleCheckBreakdownOfIndividualComponents</li>
                    </ul>
                </li>
                <li><i class="mdi mdi-note-edit-outline text-info me-2"></i> @CashDeskRessource.GuidanceForMembers</li>
                <li><i class="mdi mdi-content-save-edit-outline text-warning me-2"></i> @CashDeskRessource.Adjustments</li>
                <li><i class="mdi mdi-account-multiple-check-outline text-primary me-2"></i> @CashDeskRessource.MultipleLoans</li>
                <li>
                    <i class="mdi mdi-alert-circle-check-outline text-danger me-2"></i> @CashDeskRessource.ScenarioExamples
                    <ul>
                        <li>
                            <strong>@CashDeskRessource.Scenario1VATIncluded</strong> @CashDeskRessource.Scenario1VATIncludedDescription
                            <ul>
                                <li>@CashDeskRessource.VATCalculationFormula <em>@CashDeskRessource.formula</em></li>
                                <li>@CashDeskRessource.TotalRepaymentReflectsComputedVAT</li>
                            </ul>
                        </li>
                        <li>
                            <strong>@CashDeskRessource.Scenario2SeparateVAT</strong> @CashDeskRessource.Scenario2SeparateVATDescription
                            <ul>
                                <li>@CashDeskRessource.VATCalculation</li>
                                <li>@CashDeskRessource.TotalRepaymentIncludesInterestPlusVAT</li>
                            </ul>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Render Partial View -->
<div class="mb-1">
    @Html.Partial("_SearchBoxLoanRepaymentSimulation")
    <div id="datalistingview">
        <!-- Results displayed here -->
    </div>
</div>
@Html.Partial("_model")

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="~/Scripts/Js/Crud/CashDesk/LoanRefpaymentSimulation.js"></script>
}
