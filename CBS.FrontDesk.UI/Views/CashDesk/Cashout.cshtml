@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
@{
    ViewBag.Title = @CashDeskRessource.CashDeskCashoutTitle;
}
<style>
    /* subtle hover wobble for the pill */
    #cashStatusToggle:hover {
        transform: translateY(-1px);
        transition: .15s ease;
    }

    /* make the card draggable indicate */
    #cashStatusCard {
        cursor: grab;
    }

        #cashStatusCard.dragging {
            opacity: .95;
            cursor: grabbing;
        }

    /* badges for surplus/deficit will be set from JS */

</style>
<link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-1">
            <div class="card-body text-center">
                <h1 class="card-title text-danger">
                    <i class="mdi mdi-cash-multiple me-2"></i> @CashDeskRessource.CashDeskWithdrawalOperations
                </h1>
                <p class="card-text">
                    @CashDeskRessource.ManageMemberCashWithdrawalOperations
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Collapsible Description Section -->
<div class="row">
    <div class="col-12">
        <div class="accordion" id="helpTipsAccordion">
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-danger">
                    <span>
                        <i class="mdi mdi-lightbulb-on-outline me-2"></i> @CashDeskRessource.WithdrawalTipsAndInstructions
                    </span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="true" aria-controls="collapseHelpTips">
                        <i class="mdi mdi-chevron-up"></i>
                    </button>
                </h6>
                <div id="collapseHelpTips" class="collapse" data-bs-parent="#helpTipsAccordion">
                    <div class="card-body">
                        <ul class="mb-2">
                            <li>
                                <strong><i class="mdi mdi-cash me-1"></i> @CashDeskRessource.NormalWithdrawal:</strong>
                                <ul>
                                    <li>@CashDeskRessource.EnterDenominations.</li>
                                    <li>@GlobalShared.Input <strong>@GlobalShared.Amount</strong> @CashDeskRessource.And <strong>@CashDeskRessource.Fee</strong>.</li>
                                    <li>@CashDeskRessource.Use <strong>@CashDeskRessource.CONF</strong> @CashDeskRessource.ToConfirmAnd <strong>@GlobalShared.Inc</strong> @CashDeskRessource.ForInclusiveCharges.</li>
                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong> @CashDeskRessource.Then <strong>@GlobalShared.Re_print</strong>.</li>
                                </ul>
                            </li>
                            <li>
                                <strong><i class="mdi mdi-file-document-edit-outline me-1"></i> @CashDeskRessource.SWSWithdrawal:</strong>
                                <ul>
                                    <li>@CashDeskRessource.Provide <strong>@GlobalShared.Check_name</strong> @CashDeskRessource.And <strong>@GlobalShared.Check_number</strong>.</li>
                                    <li>@CashDeskRessource.UseOneAccountOnlyWith <strong>@GlobalShared.Amount</strong> @CashDeskRessource.And <strong>@CashDeskRessource.FormFee</strong>.</li>
                                    <li>@GlobalShared.Check <strong>@CashDeskRessource.CONF</strong> @CashDeskRessource.AndProvide <strong>@CashDeskRessource.RepresentativeInfo</strong>.</li>
                                    <li>@CashDeskRessource.Click <strong>@GlobalShared.Save</strong> @CashDeskRessource.Then <strong>@GlobalShared.Re_print</strong>.</li>
                                </ul>
                            </li>
                            <li>
                                <strong><i class="mdi mdi-bell-alert-outline me-1"></i> @CashDeskRessource.WithdrawalFromSavingNotificationPolicy:</strong>
                                <ul>
                                    <li><strong>@CashDeskRessource.WithNotification:</strong> @CashDeskRessource.OnlyFormFeeApplies</li>
                                    <li><strong>@CashDeskRessource.WithoutNotification:</strong> @CashDeskRessource.FormFeePlusServiceCharge</li>
                                </ul>
                            </li>
                        </ul>
                        <p class="text-muted mb-0"><strong>@CashDeskRessource.Note:</strong> @CashDeskRessource.AlwaysValidateAccountBalanceServiceFeesAndRepresentativeInformationBeforeProceeding.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Transaction Area -->
<div class="row">
    <div class="col">
        <div class="row my-3">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-bank me-2"></i>
                            <span id="cashDeskOperations">@CashDeskRessource.WithdrawalOperations</span>
                        </button>
                    </h2>
                    <hr />
                    <div id="collapseDeliveryAddress" data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @Html.Partial("_SearchBox")
                            <div id="datalistingview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Depositor Information -->
<div class="modal fade" id="depositerModal" tabindex="-1" aria-labelledby="depositerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">
            <!-- Loader Overlay -->
            <div id="depositorLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="fw-semibold text-primary">@CashDeskRessource.ProcessingTransactionPleaseWait...</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-primary" id="depositorModalTitle">
                                <i class="mdi mdi-account-card-details-outline me-2"></i> @CashDeskRessource.DepositorInformationRequired
                            </h1>
                            <span id="operationTypeTag" class="ms-2"></span>
                            <p class="card-text" id="depositorModalDescription">
                                @CashDeskRessource.ToCompleteThisTransactionPleaseEnterTheDepositorsFullInformationForRegulatoryAndAuditCompliance.
                            </p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="card m-3">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @CashDeskRessource.WhyThisIsRequired</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDepositorTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseDepositorTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-account-check-outline text-primary me-2"></i><strong>@CashDeskRessource.IdentityTracking:</strong> @CashDeskRessource.HelpsTrackWhoCompletedTheTransaction.</li>
                            <li><i class="mdi mdi-shield-lock-outline text-success me-2"></i><strong>@GlobalShared.Compliance:</strong> @CashDeskRessource.RequiredForKYCAndAMLRegulations.</li>
                            <li><i class="mdi mdi-file-document-box-check-outline text-warning me-2"></i><strong>@CashDeskRessource.AuditTrail:</strong> @CashDeskRessource.PermanentProofOfWhoDepositedFunds.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Depositor Form Partial -->
            @Html.Partial("_DepositerForm")

            <!-- Footer -->
            <div class="modal-footer justify-content-between">
                <div>
                    <span class="text-muted fw-semibold">
                        @GlobalShared.Member: <span class="text-dark" id="depositorCustomerName"></span> |
                        ID: <span class="text-dark" id="depositorCustomerId"></span>
                    </span>
                </div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="mdi mdi-close"></i> @GlobalShared.Cancel
                    </button>
                    <button type="button" id="confirmDepositorBtn" class="btn btn-success ms-2">
                        <i class="mdi mdi-check-circle-outline"></i> @CashDeskRessource.ConfirmAndProceed
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Floating toggle button -->
<button id="cashStatusToggle"
        type="button"
        class="btn btn-tsc-primary shadow-lg position-fixed"
        style="right: 18px; bottom: 18px; z-index: 1055; border-radius: 999px; padding: 10px 14px;"
        title="Show current cash status">
    <i class="bi bi-cash-stack me-1"></i> Cash status
</button>

<!-- Flappy card -->
<div id="cashStatusCard"
     class="card shadow-lg border-0 position-fixed d-none"
     style="right: 18px; bottom: 74px; width: 380px; z-index: 1056; border-radius: 18px; overflow: hidden;">
    <div class="card-header d-flex align-items-center justify-content-between py-2 px-3 bg-light">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-wallet2"></i>
            <strong>Cash Situation</strong>
            <span id="cs-branch" class="badge bg-secondary-subtle text-secondary-emphasis"></span>
            <span id="cs-date" class="badge bg-secondary-subtle text-secondary-emphasis"></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button id="cs-refresh" class="btn btn-sm btn-outline-primary" title="Refresh now">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button id="cs-close" class="btn btn-sm btn-outline-secondary" title="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-3" id="cs-body">
        <!-- loader -->
        <div id="cs-loading" class="text-center py-4">
            <div class="spinner-border" role="status"></div>
            <div class="small text-muted mt-2">Loading current provisions…</div>
        </div>

        <!-- content -->
        <div id="cs-content" class="d-none">
            <div class="row g-2">
                <div class="col-6">
                    <div class="border rounded-3 p-2">
                        <div class="small text-muted">Opening (Day)</div>
                        <div id="cs-opening" class="fw-bold fs-6">—</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded-3 p-2">
                        <div class="small text-muted">Cash at hand (System)</div>
                        <div id="cs-system" class="fw-bold fs-6">—</div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="border rounded-3 p-2">
                        <div class="small text-muted">Reported cash</div>
                        <div id="cs-reported" class="fw-bold fs-6">—</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded-3 p-2">
                        <div class="small text-muted">Account balance</div>
                        <div id="cs-acct" class="fw-bold fs-6">—</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border rounded-3 p-2 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted">Surplus / Deficit</div>
                            <div id="cs-sd" class="fw-bold">—</div>
                        </div>
                        <span id="cs-sd-badge" class="badge">—</span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border rounded-3 p-2">
                        <div class="d-flex justify-content-between small text-muted">
                            <span>#Cash-In</span><span>#Cash-Out</span>
                        </div>
                        <div class="d-flex justify-content-between fw-semibold">
                            <span id="cs-nin">—</span><span id="cs-nout">—</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-2">
                            <span>Vol Cash-In</span><span>Vol Cash-Out</span>
                        </div>
                        <div class="d-flex justify-content-between fw-semibold">
                            <span id="cs-vin">—</span><span id="cs-vout">—</span>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border rounded-3 p-2">
                        <div class="small text-muted">Last operation</div>
                        <div class="d-flex justify-content-between">
                            <span id="cs-last-type" class="fw-semibold">—</span>
                            <span id="cs-last-amt" class="fw-bold">—</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <button id="cs-denom" class="btn btn-sm btn-outline-dark">
                    <i class="bi bi-list-ul me-1"></i> View denomination snapshot
                </button>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="cs-autorefresh">
                    <label class="form-check-label small" for="cs-autorefresh">Auto-refresh (30s)</label>
                </div>
            </div>
        </div>

        <!-- error -->
        <div id="cs-error" class="alert alert-warning d-none mt-2 small" role="alert"></div>
    </div>
</div>

<!-- Denomination snapshot modal -->
<div class="modal fade" id="denomSnapshotModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-list-ul me-2"></i>Denomination snapshot</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="denomJson" class="bg-light p-3 rounded small mb-0" style="white-space: pre-wrap;"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/CashDesk/CashDeskCashout.js"></script>
    <script>
  (function () {
    // ✅ Always let MVC build the correct route (respecting Areas, base paths, etc.)
    // If this controller is in an Area, add: new { area = "YourAreaName" }
    const cashProvisionUrl = '@Url.Action("GetCurrentProvision", "OpenningOfDay")';

    // ✅ Inject server-side values safely
    const CurrentUserId   = @Html.Raw(Json.Encode(User?.Identity?.Name ?? ""));
    const CurrentBranch   = @Html.Raw(Json.Encode(""));
    const CurrentTeller   = ""; // fill if you already know
    const AccountingDate  = ""; // e.g. "2025-09-05" if you want to force a date

    // UI refs
    const elBtn     = document.getElementById('cashStatusToggle');
    const elCard    = document.getElementById('cashStatusCard');
    const elClose   = document.getElementById('cs-close');
    const elRefresh = document.getElementById('cs-refresh');
    const elAuto    = document.getElementById('cs-autorefresh');
    const elLoading = document.getElementById('cs-loading');
    const elContent = document.getElementById('cs-content');
    const elError   = document.getElementById('cs-error');

    const elBranch  = document.getElementById('cs-branch');
    const elDate    = document.getElementById('cs-date');
    const elOpen    = document.getElementById('cs-opening');
    const elSys     = document.getElementById('cs-system');
    const elRep     = document.getElementById('cs-reported');
    const elAcct    = document.getElementById('cs-acct');
    const elNIn     = document.getElementById('cs-nin');
    const elNOut    = document.getElementById('cs-nout');
    const elVIn     = document.getElementById('cs-vin');
    const elVOut    = document.getElementById('cs-vout');
    const elLType   = document.getElementById('cs-last-type');
    const elLAmt    = document.getElementById('cs-last-amt');
    const elSDBadge = document.getElementById('cs-sd-badge');
    const elSD      = document.getElementById('cs-sd');
    const elDenom   = document.getElementById('cs-denom');
    const elDenomPre= document.getElementById('denomJson');

    let autoTimer = null;

    function toggleVisible(showContent, message) {
      elLoading.classList.toggle('d-none', showContent);
      elContent.classList.toggle('d-none', !showContent);
      elError.classList.add('d-none');
      if (message) {
        elError.textContent = message;
        elError.classList.remove('d-none');
        elLoading.classList.add('d-none');
        elContent.classList.add('d-none');
      }
    }
    function fmtAmt(x) {
      const n = Number(x || 0);
      return n.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }
    function isoDate(d) {
      try { return new Date(d).toISOString().slice(0,10); } catch { return '—'; }
    }
    // Pull value safely whether your JSON is PascalCase or camelCase
    function get(d, pascal, camel) { return d[camel] ?? d[pascal]; }

    function renderCashStatus(payload) {
      if (!payload || !payload.data) throw new Error(payload?.message || 'No data returned.');
      const d = payload.data;

      elBranch.textContent = get(d, 'BranchId', 'branchId') || '—';
      elDate.textContent   = d.OpenedDate || d.openedDate ? isoDate(d.OpenedDate || d.openedDate)
                        : (payload.meta?.accountingDate || '—');

      elOpen.textContent = 'FCFA ' + fmtAmt(get(d, 'OpenOfDayAmount', 'openOfDayAmount') ?? get(d, 'TotalOpeningAmount', 'totalOpeningAmount'));
      elSys.textContent  = 'FCFA ' + fmtAmt(get(d, 'SystemCashInHand', 'systemCashInHand'));
      elRep.textContent  = 'FCFA ' + fmtAmt(get(d, 'ReportedCashInHand', 'reportedCashInHand'));
      elAcct.textContent = 'FCFA ' + fmtAmt(get(d, 'AccountBalance', 'accountBalance'));

      elNIn.textContent  = get(d, 'NumberOfCashIn', 'numberOfCashIn') ?? 0;
      elNOut.textContent = get(d, 'NumberOfCashOut', 'numberOfCashOut') ?? 0;
      elVIn.textContent  = 'FCFA ' + fmtAmt(get(d, 'VolumeOfCashIn', 'volumeOfCashIn'));
      elVOut.textContent = 'FCFA ' + fmtAmt(get(d, 'VolumeOfCashOut', 'volumeOfCashOut'));

      elLType.textContent = get(d, 'LastOperationType', 'lastOperationType') || '—';
      elLAmt.textContent  = get(d, 'LastOperationAmount', 'lastOperationAmount')
                            ? ('FCFA ' + fmtAmt(get(d, 'LastOperationAmount', 'lastOperationAmount'))) : '—';

      const surplus = Number(get(d, 'SurplusAmount', 'surplusAmount') || 0);
      const deficit = Number(get(d, 'DeficitAmount', 'deficitAmount') || 0);
      let label = 'Balanced', badge = 'bg-secondary';
      if (surplus > 0) { label = `Surplus: FCFA ${fmtAmt(surplus)}`; badge = 'bg-success'; }
      if (deficit > 0) { label = `Deficit: FCFA ${fmtAmt(deficit)}`; badge = 'bg-danger'; }
      elSD.textContent = label;
      elSDBadge.className = 'badge ' + badge;
      elSDBadge.textContent = badge.includes('success') ? '✔ OK' : (badge.includes('danger') ? '⚠ Check' : '—');

      elDenom.onclick = () => {
        const snap = get(d, 'DenominationSnapshotJson', 'denominationSnapshotJson') || '';
        elDenomPre.textContent = snap ? JSON.stringify(JSON.parse(snap), null, 2) : 'No snapshot available.';
        const m = new bootstrap.Modal(document.getElementById('denomSnapshotModal'));
        m.show();
      };
    }

    function loadCashStatusAjax() {
      toggleVisible(false);

      $.ajax({
        url: cashProvisionUrl,           // MVC-built URL
        type: 'GET',
        dataType: 'json',
        cache: false,
        // cookies/auth are automatically sent for same-origin
        data: {
          userId: CurrentUserId || undefined,
          branchId: CurrentBranch || undefined,
          tellerId: CurrentTeller || undefined,
          accountingDate: AccountingDate || undefined
        },
        success: function (payload, textStatus, xhr) {
          try {
            renderCashStatus(payload);
            toggleVisible(true);
          } catch (e) {
            toggleVisible(false, e.message || 'Unable to render cash status.');
          }
        },
        error: function (xhr) {
          // If server returned HTML (login page, error page), show a readable snippet
          const ct = (xhr.getResponseHeader('Content-Type') || '').toLowerCase();
          if (!ct.includes('application/json')) {
            const snippet = (xhr.responseText || '').toString().slice(0, 200);
            toggleVisible(false, `Expected JSON, got ${ct || 'unknown'}.\n${snippet}`);
          } else {
            toggleVisible(false, `HTTP ${xhr.status} – ${xhr.statusText}`);
          }
          console.error('Cash status AJAX error:', xhr);
        }
      });
    }

    // Button → open + load
    elBtn?.addEventListener('click', () => {
      const hidden = elCard.classList.contains('d-none');
      elCard.classList.toggle('d-none', !hidden);
      if (hidden) loadCashStatusAjax();
    });
    elClose?.addEventListener('click', () => elCard.classList.add('d-none'));
    elRefresh?.addEventListener('click', loadCashStatusAjax);

    // Auto-refresh every 30s
    elAuto?.addEventListener('change', (e) => {
      if (e.target.checked) { loadCashStatusAjax(); autoTimer = setInterval(loadCashStatusAjax, 30000); }
      else { clearInterval(autoTimer); autoTimer = null; }
    });
  })();
    </script>

}
