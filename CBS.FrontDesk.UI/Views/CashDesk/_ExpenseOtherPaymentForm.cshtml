@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@using Resources
<div class="form-wrapper">
    <fieldset class="fieldset-custom">
        <legend>@CashDeskRessource.OtherPaymentExpenses</legend>
        <hr />
        <div class="change-group">
            <div class="row mt-2 gy-4">

                <div class="col-md-6">
                    <div class="input-group mb-3">
                        <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="@CashDeskRessource.EnterMemberAccountNumber">
                        <button class="btn btn-outline-secondary" type="button" id="manualSearchInputbutton" onclick="LoadMembersAccounts('account_number')">
                            @GlobalShared.Search
                        </button>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <span class="formatted-amount shadow-box" id="lblDepositRequest_amount">@GlobalShared.Total_amount: 0.0</span>
                        <input type="hidden" class="form-control amount-input shadow-input-boxes" id="totalNoteAmount" value="0">
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-6">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.BulkDeposit.OtherTransaction.SourceType, "Member_Account", new { @class = "form-check-input", id = "memberAccountOption" })
                            <label class="form-check-label" for="memberAccountOption">@CashDeskRessource.FromMemberAccount</label>
                        </div>
                    </div>
                </div>
                @*<div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.EventCode, new SelectList(ViewBag.EventCodes, "Value", "Text"), "---Select Event Item---", new { @class = "form-control select2", @search = "true", @id = "BulkDeposit_OtherTransaction_EventCode" })
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.EventCode, "", new { @class = "text-danger" })
                        <label>What event item?</label>
                    </div>
                </div>*@
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.BulkDeposit.OtherTransaction.AccountNumber, new SelectList(ViewBag.MemberAccounts, "Value", "Text"), CashDeskRessource.SelectMemberAccount , new { @class = "form-control select2", @id = "account_number", @search = "true" })
                        @Html.ValidationMessageFor(m => m.BulkDeposit.OtherTransaction.AccountNumber, "", new { @class = "text-danger " })
                        <label for="formValidationDob">@CashDeskRessource.SelectAccountToPerformTheOperation</label>
                    </div>
                </div>


                @Html.Partial("_NoneMemberPayment")

            </div>
            <div class="header-buttons mt-4 float-end">
                <input type="hidden" name="OperationType" value="Expense" id="OperationType" />
                <input type="hidden" name="customerId" value="" id="customerId" />
                <button type="submit" id="submit" class="btn btn-primary me-2" onclick="PostOtherCashIn()">
                    <i class="fas fa-save me-1"></i> @GlobalShared.Post
                </button>
                <button type="submit" id="submit" class="btn btn-secondary me-2" onclick="Reprint()">
                    <i class="fas fa-print me-1"></i> @GlobalShared.Re_print
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="fas fa-sync-alt me-1"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
    </fieldset>
</div>



