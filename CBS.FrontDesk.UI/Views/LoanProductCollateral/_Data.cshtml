@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanProductCollateral>


<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Tag</th>
                <th>Product</th>
                <th>Colateral</th>
                <th>Range</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td style="width:20%">@d.LoanProductCollateralTag</td>
                    <td style="width:25%">@d.LoanProduct.ProductName</td>
                    <td style="width:20%">@d.Collateral.name</td>
                    <td style="width:20%">@d.MinimumValueRate.ToString("0.0")% - @d.MaximumValueRate.ToString("0.0")%</td>
                    <td style="width:15%">
                        <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview','_LoanProductCollateral','update','LoanProductCollateral')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.LoanProductCollateralTag to edit">Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.LoanProductCollateralTag" onclick="showConfirmMessage('@d.Id','myDataTable')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>





