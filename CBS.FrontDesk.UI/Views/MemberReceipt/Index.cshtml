@{
    ViewBag.Title = "Member Receipts Overview";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-receipt-text-outline me-2"></i> @GlobalMemberReceipt.member_receipts
                </h1>
                <p class="card-text">
                    @GlobalMemberReceipt.track_search_and_analyze_member_payment_receipts_across_branches.
                </p>
                <p class="card-text text-muted small">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>@GlobalMemberReceipt.use_filters_like_branch_date_range_member_reference_or_transaction_reference.
                </p>
                <hr style="border: 2px solid rgba(0, 128, 128, 0.2);" />
            </div>
        </div>
    </div>
</div>


<!-- Tips Section -->
@Html.Partial("_Tips")

<!-- Advanced Filters -->
@Html.Partial("_Filter")

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_MemberReceiptDataTable")
</div>
<!-- Modal View Partial -->
<div id="receiptModalContainer">

</div>
@section Scripts {

    <script src="~/Scripts/Js/MemberReceiptsP/MemberReceipt.js"></script>
    <script>
        let _receiptPrintBusy = false;

        function ReprintReceipts(btn) {
            if (window._receiptPrintBusy) return;
            window._receiptPrintBusy = true;

            const $btn = btn || document.getElementById('btnPrintReceipt');
            const $loader = document.getElementById('receiptLoader');
            const $spinner = $btn.querySelector('.spinner-border');
            const $text = $btn.querySelector('.btn-text');

            // turn on loading state
            $btn.dataset.originalHtml = $text.innerHTML;
            $btn.disabled = true;
            $spinner.classList.remove('d-none');
            $text.innerHTML = 'Printing...';
            $loader?.classList.remove('d-none');

            const done = () => {
                $loader?.classList.add('d-none');
                $spinner.classList.add('d-none');
                $text.innerHTML = $btn.dataset.originalHtml || '<i class="mdi mdi-printer"></i> Print';
                $btn.disabled = false;
                window._receiptPrintBusy = false;
            };

            try {
                // Call your report
                ReportView("MemberReceipt", null, "GetReport", null, null, "receipts",
                    "ReportParameterLessWithSubReports")
                    .always(done);   // ← works now because ReportView returns the jqXHR
            } catch (e) {
                console.error(e);
                done();
            }
        }
    </script>
}
