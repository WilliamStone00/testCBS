<div class="card shadow p-3 mb-4">
    <h5 class="text-success mb-3">
        <i class="mdi mdi-filter-outline me-1"></i> Advanced Filters
    </h5>

    <div class="card p-3 bg-light">
        <!-- Branch Full Width -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label fw-bold">Branch</label>
                @Html.DropDownList("branchInput", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", @id = "branchInput" })
            </div>
        </div>

        <!-- Member Reference & Name -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Member Reference</label>
                <input type="text" id="memberReference" class="form-control" placeholder="Member Reference" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Member Name</label>
                <input type="text" id="memberName" class="form-control" placeholder="Member Name" />
            </div>
        </div>

        <!-- Toggle: Show/Hide Transaction Ref + Date -->
        <div class="row mb-3">
            <div class="col-md-6 form-check">
                <input type="checkbox" id="showTransactionFilter" class="form-check-input" />
                <label for="showTransactionFilter" class="form-check-label fw-bold">Filter by Transaction Reference</label>
            </div>
            <div class="col-md-6 form-check">
                <input type="checkbox" id="showDateFilter" class="form-check-input" />
                <label for="showDateFilter" class="form-check-label fw-bold">Filter by Date Range</label>
            </div>
        </div>

        <div id="transactionFilterSection" class="row mb-3" style="display: none;">
            <div class="col-md-12">
                <label class="form-label fw-bold">Transaction Reference</label>
                <input type="text" id="transactionReference" class="form-control" placeholder="Transaction Reference" />
            </div>
        </div>

        <div id="dateFilterSection" class="row mb-3" style="display: none;">
            <div class="col-md-6">
                <label class="form-label fw-bold">Start Date</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">End Date</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
        </div>
    </div>
    <!-- Action Buttons -->
    <div class="row mt-2">
        <div class="col-md-4">
            <button id="applyFilterBtn" class="btn btn-primary w-100"><i class="mdi mdi-magnify"></i> Apply Filter</button>
        </div>
        <div class="col-md-4">
            <button id="resetFilterBtn" class="btn btn-dark w-100"><i class="mdi mdi-refresh"></i> Reset</button>
        </div>
        <div class="col-md-4">
            <button id="exportBtn" class="btn btn-default w-100"><i class="mdi mdi-file-excel"></i> Export</button>
        </div>
    </div>
</div>
