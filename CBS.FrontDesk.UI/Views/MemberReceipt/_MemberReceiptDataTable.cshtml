
@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-table"></i> @GlobalShared.payments_receipts
    </h5>

    <div class="table-responsive">
        <table id="myDataTable" class="table table-striped table-bordered table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Receipt_ID</th>
                    <th>@GlobalShared.Member_name</th>
                    <th>@GlobalShared.Member_ref</th>
                    <th>@GlobalShared.Amount</th>
                    <th>@GlobalShared.Date</th>
                    <th>@GlobalShared.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>





