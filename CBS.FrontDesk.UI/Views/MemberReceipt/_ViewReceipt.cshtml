@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountOperation.PaymentReceipt

<div class="modal fade" id="viewReceiptModal" tabindex="-1" aria-labelledby="viewReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">

            <!-- Loader Overlay -->
            <div id="receiptLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                    <div class="spinner-border text-tsc mb-3" role="status"></div>
                    <p class="fw-semibold text-tsc">Loading receipt details... Please wait.</p>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="w-100">
                    <div class="card bg-light mb-2">
                        <div class="card-body text-center">
                            <h1 class="card-title text-tsc" id="viewReceiptModalLabel">
                                <i class="mdi mdi-receipt-text-outline me-2"></i> Receipt Viewer
                            </h1>
                            <p class="card-text">You are viewing a detailed summary of the selected member payment receipt. Use the tips below to guide your validation process.</p>
                            <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Viewer Tips Section -->
            <div class="card mx-3 mt-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-tsc">
                    <span><i class="mdi mdi-information-outline me-2"></i> Receipt Validation Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReceiptTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseReceiptTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0" style="list-style: none; padding-left: 0;">
                            <li class="mb-2">
                                <i class="mdi mdi-eye-check-outline text-tsc me-2"></i>
                                <strong>Confirm Identity:</strong> Ensure the names match verified member and depositor information.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-cash-multiple text-success me-2"></i>
                                <strong>Review Totals:</strong> Make sure the total paid equals the breakdown + charges.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-bank text-muted me-2"></i>
                                <strong>Use Audit References:</strong> Always double-check internal/external reference numbers.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-chart-bar text-tsc-dark me-2"></i>
                                <strong>Check Denominations:</strong> Cash breakdown should match physical notes and coins.
                            </li>
                            <li class="mb-2">
                                <i class="mdi mdi-alert-octagon-outline text-danger me-2"></i>
                                <strong>Suspect Discrepancy?</strong> Report mismatches for audit follow-up.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Scrollable Content -->
            <div id="receiptContent" class="px-3 pb-2 overflow-auto" style="max-height: 65vh;">
                @Html.Partial("_ReceiptSummaryTable")
            </div>

            <!-- Always-visible Footer with Cancel/Print -->
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="mdi mdi-close"></i> Close
                </button>
                <button type="button" class="btn btn-primary" onclick="printReceipt()">
                    <i class="mdi mdi-printer"></i> Print
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printReceipt() {
            var content = document.getElementById('receiptContent').innerHTML;
            var printWindow = window.open('', '', 'width=900,height=650');
            printWindow.document.write('<html><head><title>Print Receipt</title>');
            printWindow.document.write('<link rel="stylesheet" href="/Content/bootstrap.min.css" />');
            printWindow.document.write('<style>body{font-family:sans-serif;margin:20px;} table{width:100%;font-size:12px;} th{text-align:left;}</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(content);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            printWindow.print();
        }
    </script>
}





