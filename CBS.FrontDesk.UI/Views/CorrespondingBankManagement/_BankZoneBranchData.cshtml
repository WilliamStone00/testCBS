
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration

<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>BankingZoneName</th>
            <th>BranchName</th>
            <th>Type</th>
            <th>BankName</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.BankZoneBranchs)
        {
            <tr>
                <td style="width:25%">@d.BankingZoneName</td>
                <td style="width:20%">@d.BranchName</td>
                <td style="width:15%">@d.Type</td>
                <td style="width:30%">@d.BankName</td>
                <td style="width:10%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateCorrespondingBank','update','CorrespondingBankManagement','correspondingBank')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.BranchName to edit">Edit</a>
                    |<a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete @d.BranchName" onclick="DeleteDataConfiguration('CorrespondingBankManagement','@d.Id','DataTableCorrespondingBank','_CorrespondingBankData',0,'datalistingview','correspondingBank')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
 