
@using Resources
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration


<div class="col-12 card-body">
    <div class="card mb-12">

        <div class="card-body">
            @using (Html.BeginForm("AddOrUpdate", "CorrespondingBankManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
            {<input type="hidden" name="ServiceOption" value="correspondingBank" id="ServiceOption" />
                @Html.HiddenFor(m => m.CorrespondingBank.Id, new { @Value = "0" })
                <div class="row mt-2 gy-4">

                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CorrespondingBank.InstitionType, new SelectList(ViewBag.BankTypes == null ? "" : ViewBag.BankTypes, "Text", "Value"), "---"+ @GlobalCorrespondingBankManagement.SelectFinancialInstitutionType+"---", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.InstitionType, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.FinancialInstitution</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBank.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.Name, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.Name</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBank.Code, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.Code, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.BankCode</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBank.HeadOfficeLocation, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.HeadOfficeLocation, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.HeadOfficeLocation</label>

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBank.HeadOfficeTelephone, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.HeadOfficeTelephone, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.HeadOfficeTelephone</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBank.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBank.Email, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.HeadOfficeTelephone</label>
                        </div>
                    </div>

                </div>
                <div class="mt-4">
                    @if (Model.CorrespondingBank.Id == null)
                    {
                        <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                        <input type="hidden" name="Action" value="insert" id="Action" />
                    }
                    else
                    { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                        @Html.HiddenFor(m => m.CorrespondingBank.Id)
                        <input type="hidden" name="Action" value="update" id="Action" />
                    }
                </div>
            }

        </div>
    </div>
</div>
