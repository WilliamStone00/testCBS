
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration

<table class="table table-hover" id="DataTableCorrespondingBank">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Institution</th>
            <th>HeadOffice</th>
            <th>Telephone</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.CorrespondingBanks)
        {
            <tr>
                <td style="width:20%">@d.Name</td>
                <td style="width:10%">@d.Code</td>
                <td style="width:10%">@d.InstitionType</td>
                <td style="width:10%">@d.HeadOfficeLocation</td>
                <td style="width:10%">@d.HeadOfficeTelephone</td>
                <td style="width:40%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateCorrespondingBank','update','CorrespondingBankManagement','correspondingBank')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>
                    |<a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteDataConfiguration('CorrespondingBankManagement','@d.Id','DataTableCorrespondingBank','_CorrespondingBankData',0,'datalistingview','correspondingBank')">Delete</a>
                    |<a href="/CorrespondingBankManagement/ManageCorrespondingBank?Key=@d.Id" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" title="">Manage @d.Name Branches</a>
                </td>
            </tr>
        }
    </tbody>
</table>
 