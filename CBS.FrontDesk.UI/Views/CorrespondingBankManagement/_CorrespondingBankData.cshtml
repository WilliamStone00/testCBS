@using Resources
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration

<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalCorrespondingBankManagement.Name</th>
            <th>@GlobalCorrespondingBankManagement.Code</th>
            <th>@GlobalCorrespondingBankManagement.Institution</th>
            <th>@GlobalCorrespondingBankManagement.HeadOffice</th>
            <th>@GlobalCorrespondingBankManagement.Telephone</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.CorrespondingBanks)
        {
            <tr>
                <td style="width:20%">@d.Name</td>
                <td style="width:10%">@d.Code</td>
                <td style="width:15%">@d.InstitionType</td>
                <td style="width:25%">@d.HeadOfficeLocation</td>
                <td style="width:20%">@d.HeadOfficeTelephone</td>
                <td style="width:10%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateCorrespondingBank','update','CorrespondingBankManagement','correspondingBank')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                    |<a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteDataConfiguration('CorrespondingBankManagement','@d.Id','myDataTable','_CorrespondingBankData',0,'datalistingview','correspondingBank')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
 