
@using Resources
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration


<div class="col-12 card-body">
    <div class="card mb-12">

        @using (Html.BeginForm("AddOrUpdate", "CorrespondingBankManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            <div class="card-body">

                <input type="hidden" name="ServiceOption" value="correspondingBankBranch" id="ServiceOption" />
                <div class="row mt-2 gy-4">
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.DropDownListFor(m => m.CorrespondingBankBranch.ThirdPartyInstitutionId, new SelectList(ViewBag.ThirdPartyInstitutions == null ? "" : ViewBag.ThirdPartyInstitutions, "Text", "Value"), "---"+ GlobalShared.Select_bank+"---", new { @class = "form-control select2", @search = "true" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.ThirdPartyInstitutionId, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.FinancialInstitution</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBankBranch.BranchName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.BranchName, "", new { @class = "text-danger" })
                            <label>@GlobalShared.Name</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.CorrespondingBankBranch.TownName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.TownName, "", new { @class = "text-danger" })
                            <label>@GlobalCorrespondingBankManagement.TownName</label>
                        </div>
                    </div>
                </div>
                    <div class="row mt-2 gy-4">



                        <div class="col-md-3">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.CorrespondingBankBranch.RegionId, new SelectList(ViewBag.Regions == null ? "" : ViewBag.Regions, "Text", "Value"), "---"+ @GlobalCorrespondingBankManagement.SelectRegion+"---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.RegionId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Region</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.CorrespondingBankBranch.DivisionId, new SelectList(ViewBag.Divisions == null ? "" : ViewBag.Divisions, "Text", "Value"), "---"+ @GlobalCorrespondingBankManagement.SelectDivision+"---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.DivisionId, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Division</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.CorrespondingBankBranch.SubdivisionId, new SelectList(ViewBag.Subdivisions == null ? "" : ViewBag.Subdivisions, "Text", "Value"), "---"+@GlobalCorrespondingBankManagement.SelectSubdivision+"---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.SubdivisionId, "", new { @class = "text-danger" })
                                <label>@GlobalCorrespondingBankManagement.SubDivision</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.CorrespondingBankBranch.TownId, new SelectList(ViewBag.Towns == null ? "" : ViewBag.Towns, "Text", "Value"), "---"+@GlobalCorrespondingBankManagement.SelectDivision+"---", new { @class = "form-control select2", @search = "true" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.DivisionId, "", new { @class = "text-danger" })
                                <label>@GlobalCorrespondingBankManagement.TownId</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.CorrespondingBankBranch.TownName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.TownName, "", new { @class = "text-danger" })
                                <label>@GlobalShared.Telephone</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.CorrespondingBankBranch.FocalPointName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.FocalPointName, "", new { @class = "text-danger" })
                                <label>@GlobalCorrespondingBankManagement.FocalPointName</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.CorrespondingBankBranch.FocalPointContact, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CorrespondingBankBranch.FocalPointContact, "", new { @class = "text-danger" })
                                <label>@GlobalCorrespondingBankManagement.FocalPointFunction</label>
                            </div>
                        </div>


                    </div>
                    <div class="mt-4">
                        @if (Model.CorrespondingBankBranch.Id == null)
                        {
                            <button type="submit" class="btn btn-primary me-2">Save</button>
                            <input type="hidden" name="Action" value="insert" id="Action" />
                        }
                        else
                        { <button type="submit" class="btn btn-primary me-2">Update</button>
                            @Html.HiddenFor(m => m.CorrespondingBankBranch.Id)
                            <input type="hidden" name="Action" value="update" id="Action" />
                        }
                    </div>
                </div>
                }



            </div>
</div>

