
@model CBS.FrontDesk.Data.Entity.CorrespondingBankManaagement.CorrespondingBankConfiguration

<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>BranchName</th>
            <th>FocalPointContact</th>
            <th>FocalPointName</th>
            <th>TownName</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.CorrespondingBankBranches)
        {
            <tr>
                <td style="width:20%">@d.BankName</td>
                <td style="width:20%">@d.BranchName</td>
                <td style="width:15%">@d.FocalPointContact</td>
                <td style="width:15%">@d.FocalPointName</td>
                <td style="width:15%">@d.TownName</td>
                <td style="width:15%">
                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateCorrespondingBankBranch','update','CorrespondingBankManagement','correspondingBank')" class="mr-2 btn btn-default" data-toggle="tooltip" data-placement="top" title="Select @d.BranchName to edit">Edit</a>
                    |<a href="#" class="mr-2 btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete @d.BranchName" onclick="DeleteDataConfiguration('CorrespondingBankManagement','@d.Id','DataTableCorrespondingBank','_CorrespondingBankBranchData',0,'datalistingview','correspondingBank')">Delete</a>
      
                </td>
            </tr>
        }
    </tbody>
</table>
 