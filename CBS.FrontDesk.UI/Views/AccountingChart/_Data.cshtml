@model List<CBS.FrontDesk.Data.Entity.Accounting.ChartOfAccountDto>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>AccountNumber</th>
            <th>Description</th>
            <th>BalanceSheetAccount</th>
            <th>IsDirectAccount</th>
            <th>RootAccount</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @{
        if (Model != null)
        {
            foreach (var d in Model)
            {
                <tr>
                
                    <td style="width:35%">@d.AccountNumber : @d.LabelEn</td>
                    <td style="width:25%">@d.LabelEn</td>
                    <td style="width:5%">@d.IsBalanceAccount</td>
                    <td style="width:5%">@d.RootParentId</td>
                    <td style="width:20%">@d.LabelFr</td>
                    <td style="width:10%">
                        <a href="#" onclick="AddORUpdateGen('@d.RootParentId','datalistingview','_Update','update','AccountingChart')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.AccountNumber to edit">Edit</a>
                        <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.AccountNumber" onclick="DeleteRecordDataTable('ChartOfAccount','@d.RootParentId','myDataTable','_Data',0,'datalistingview')">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
                
        }
         
        }
    </tbody>
</table>

