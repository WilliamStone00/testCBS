@model CBS.FrontDesk.Data.Entity.Accounting.ChartOfAccount
@using Resources
@{
    ViewBag.Title = @GlobalAccountingChart_Delete.ChartOfAccount;
}
<style>
    .red-text {
        color: red;
    }
</style>
<div class="row">
    <!-- Context Menu -->
    <div class="col-12 card-body">
        <div class="card col-12 alert alert-outline-danger">

            @GlobalAccountingChart_Delete.DeleteConfirmationMessage
            <br>
            @GlobalAccountingChart_Delete.Number: @Model.AccountNumber <br>
            @GlobalAccountingChart_Delete.Label: @Model.LabelEn
            <br>
            @GlobalAccountingChart_Delete.DeleteWarningMessage

            <div class="col-md-12 col-12">
                <button onclick="DeleteData('AccountingChart', @Model.AccountNumber)" class="btn btn-danger waves-effect waves-light mdi-bag-checked">@GlobalAccountingChart_Delete.YesButtonText</button>
            </div>

        </div>
    </div>
</div>