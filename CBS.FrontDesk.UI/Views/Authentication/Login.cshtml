@model CBS.API.Helper.AuthRequest
@{
    Layout = "~/Views/Shared/_LoginMainCover.cshtml";
    ViewBag.Title = "T R U S T S O F T C R E D I T-Authentication";
}

<style>

    .authentication-text {
        color: #007bff; /* Choose your desired text color */
    }

    .trustbank-text {
        font-size: 24px;
    }

    .form-container {
        padding: 20px;
    }

    .form-floating {
        position: relative;
    }

        .form-floating input,
        .form-floating label {
            width: 100%;
        }

    .form-password-toggle {
        position: relative;
    }

        .form-password-toggle input {
            padding-right: 40px;
        }

    .input-group-text {
        cursor: pointer;
    }

    .form-check-input {
        margin-right: 5px;
    }

    .forgot-password-link {
        text-decoration: none;
        color: #6c757d; /* Choose your desired link color */
    }

    .login-policy {
        margin-top: 20px;
    }

        .login-policy hr {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .login-policy label {
            display: block;
        }

    .alert {
        margin-top: 20px;
    }
</style>

<div class="authentication-inner row m-0">
    <!-- Left Section -->
    <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center">
        <img src="~/AppFiles/Images/Logog2X.JPEG" class="authentication-image" alt="mask" />
    </div>
    <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg position-relative">
        <div class="w-px-400 mx-auto pt-5 pt-lg-0 form-container">
            <div class="image-container">
                <img src="~/AppFiles/Images/Logog2XI.png" />
            </div>
            <hr />
            <h5 class="mb-2 trustbank-text" style="display: inline-block; font-size: 1rem;">T R U S T S O F T C R E D I T <span class="authentication-text" style="display: inline-block;">Authentication</span></h5>
            <hr />
            <!-- Error Message -->
            @if (ViewBag.Success == false)
            {
                <div class="alert alert-outline-danger" role="alert">
                    @ViewBag.Message
                </div>
            }
            <p class="mb-4">Please sign in to your account.</p>

            @using (Html.BeginForm("Login", "Authentication", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal form-label-left" }))
            {
                
                <!-- Username Input -->
                <div class="form-floating form-floating-outline mb-3">
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @placeholder = "User name", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                    <label for="username">Email or Username</label>
                </div>

                <!-- Password Input -->
                <div class="mb-3 form-password-toggle">
                    <div class="input-group input-group-merge">
                        <div class="form-floating form-floating-outline">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password", autocomplete = "current-password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            <label for="password">Password</label>
                        </div>
                        <span class="input-group-text cursor-pointer"><i class="mdi mdi-eye-off-outline"></i></span>
                    </div>
                </div>

                <!-- Hidden fields for geolocation data -->
                @Html.HiddenFor(m => m.GeoLocationResponse.Ip, new { id = "GeoLocationResponse_Ip" })
                @Html.HiddenFor(m => m.GeoLocationResponse.City, new { id = "GeoLocationResponse_City" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Region, new { id = "GeoLocationResponse_Region" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Country, new { id = "GeoLocationResponse_Country" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Loc, new { id = "GeoLocationResponse_Loc" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Org, new { id = "GeoLocationResponse_Org" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Timezone, new { id = "GeoLocationResponse_Timezone" })
                @Html.HiddenFor(m => m.GeoLocationResponse.Readme, new { id = "GeoLocationResponse_Readme" })

                <!-- Login Button -->
                <button type="submit" class="btn btn-primary d-grid w-100">Login</button>
            }

            <!-- Login Policy -->
            <div class="login-policy">
                <div class="col-sm-12">
                    <p class="text-muted mb-0"><b>LOGIN POLICY</b></p>
                    <hr />
                    <label>1. Your max login attempt is 3, else blocked.</label>
                    <label>2. If your account is blocked, contact your administrator.</label>
                    <label>3. If you forget your password, contact your administrator.</label>
                </div>
            </div>
            @*<div id="location-prompt">
                <p>We need to access your location to provide a better user experience. Please allow location access when prompted.</p>
            </div>
            <button id="retry-location" onclick="getLocation()">Retry Location Access</button>*@


        </div>
    </div>
    <!-- /Login Section -->
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
