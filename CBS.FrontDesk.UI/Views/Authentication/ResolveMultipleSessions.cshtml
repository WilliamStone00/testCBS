@model CBS.API.Helper.SessionAuth

@{
    Layout = "~/Views/Shared/_LoginMainCover.cshtml";
    ViewBag.Title = "T R U S T S O F T C R E D I T - Multiple Sessions Detected";
    var messages = ViewBag.Message?.ToString().Split(new[] { '\n', ';' }, StringSplitOptions.RemoveEmptyEntries);
}

<style>
    body {
        background-image: url('@Url.Content("~/AppFiles/Images/NBG_.jpeg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        margin: 0;
        padding: 0;
        height: 100vh;
        width: 100vw;
        font-family: Arial, sans-serif;
    }

    .authentication-inner {
        display: flex;
        align-items: center;
        width: 100%;
        height: 100%;
        padding-top: 50px;
    }

    .authentication-bg {
        background-color: rgba(255, 255, 255, 0.9);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 500px;
    }

    .styled-hr {
        border: 0;
        height: 4px;
        background: linear-gradient(to right, deepskyblue, limegreen);
        margin: 20px 0;
    }

    .trust-soft { color: deepskyblue; font-weight: bold; }
    .credit { color: limegreen; font-weight: bold; }
</style>

<div class="authentication-inner row">
    <div class="col-lg-8 d-none d-lg-block"></div>

    <div class="col-12 col-lg-4 col-xl-4 authentication-bg position-relative">
        <div class="w-100 mx-auto p-3 pt-5 pt-lg-0 form-container">
            <div class="image-container text-center mb-4">
                <img src="~/AppFiles/Images/Logog2XI.png" class="img-fluid" alt="Logo" />
            </div>

            <hr class="styled-hr" />
            <h5 class="trustbank-text mb-1">
                <span class="trust-soft">T R U S T S O F T</span>
                <span class="credit">C R E D I T</span>
            </h5>
            <small class="d-block mt-0"><i>Session Security Notice</i></small>
            <hr class="styled-hr" />

            <div class="alert alert-warning shadow-sm">
                <i class="mdi mdi-alert-circle-outline me-2"></i>
                <strong>Multiple Active Sessions Detected!</strong>
                @if (messages != null && messages.Length > 0)
                {
                    <ul class="mt-2 mb-0 ps-3">
                        @foreach (var msg in messages)
                        {
                            <li>@msg.Trim()</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mb-0">@ViewBag.Message</p>
                }

            </div>

            <div class="text-start mb-3">
                <p><strong>User:</strong> @ViewBag.Username</p>
                <p><strong>Open Sessions:</strong> @ViewBag.SessionCount</p>
            </div>

            @using (Html.BeginForm("ResolveMultipleSessions", "Authentication", FormMethod.Post))
            {
                @Html.HiddenFor(m => m.UserName)
                @Html.HiddenFor(m => m.Counts)

                <div class="form-floating form-floating-outline mb-3">
                    @Html.TextBoxFor(m => m.SessionRecoveryCode, new
                    {
                        @class = "form-control",
                        placeholder = "Enter Your Session Code",
                        required = "required"
                    })
                    <label for="sessionRecoveryCode">Session Recovery Code</label>
                    @Html.ValidationMessageFor(m => m.SessionRecoveryCode, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-danger d-grid w-100 mb-3">
                    Terminate Other Sessions
                </button>
            }


            <div class="text-center">
                <a href="@Url.Action("Login", "Authentication")" class="btn btn-outline-primary w-100">
                    <i class="fas fa-arrow-left me-1"></i> Back to Login Page
                </a>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">This ensures only your session remains active for enhanced security.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
