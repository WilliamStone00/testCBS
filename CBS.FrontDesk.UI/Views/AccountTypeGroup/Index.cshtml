<!-- Content Area -->
<div id="datalistingview">
    <!-- Create form will be loaded here by default -->
    @Html.Partial("_AccountTypeGroupForm", Model)
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Enable tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            
            // Clear modal content when hidden
            $('#confirmationModal').on('hidden.bs.modal', function() {
                $('#confirmationModal .modal-body').empty();
            });
            
            // Handle form submission in main content
            $(document).on('submit', '#accountTypeGroupForm', handleFormSubmit);
            
            // Handle form submission in edit modal
            $(document).on('submit', '#editGroupForm', handleEditFormSubmit);
        });
        
        function showCreateForm() {
            $.ajax({
                url: '/AccountTypeGroup/InitializeData',
                type: 'GET',
                data: {
                    partialView: '_AccountTypeGroupForm',
                    path: 'new'
                },
                success: function(response) {
                    $('#editModalBody').html(response);
                    $('#editModal').modal('show');
                    $('[data-bs-toggle="tooltip"]').tooltip();
                },
                error: function(error) {
                    console.error('Error loading create form:', error);
                    appalert('Error loading create form. Please try again.', 4, 1);
                }
            });
        }
        
        function handleFormSubmit(event) {
            event.preventDefault();
            var form = event.target;
            submitWithConfirmation(form);
        }
        
        function handleEditFormSubmit(event) {
            event.preventDefault();
            var form = event.target;
            submitWithConfirmation(form);
        }
        
        function submitWithConfirmation(form) {
            try { $.validator.unobtrusive.parse(form); } catch (e) {}
            var $form = $(form);
            if ($form.length && !$form.valid()) return false;

            var isMultipart = ($form.attr('enctype') || '').toLowerCase() === 'multipart/form-data';
            var token = getAntiForgeryToken();
            var $submit = $form.find('[type="submit"]').first();
            var origHtml = $submit.data('orig-html') || $submit.html();
            $submit.data('orig-html', origHtml);
            $submit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');

            var doAjax = function () {
                var ajaxOptions = {
                    url: '/AccountTypeGroup/CreateOrUpdate',
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            var lvl = 1;
                            if (response.status === 'Exist') lvl = 3;
                            if (response.status === 'Failed') lvl = 2;
                            showMsg(response.message || 'Operation successful', lvl);

                            if (response.reloadDataView === "Yes" || response.reload === true) {
                                // Reload the form with fresh data
                                loadFreshForm();
                            }
                            
                            // If form is in modal and successful, hide modal
                            if ($form.attr('id') === 'editGroupForm') {
                                $('#editModal').modal('hide');
                            }
                        } else {
                            var lvl = (response && response.status === 'Exist') ? 3 : 2;
                            showMsg((response && response.message) ? response.message : 'Operation failed', lvl);
                        }
                    },
                    error: function (xhr) {
                        var parsed = normalizeResponse(xhr.responseText);
                        if (parsed && parsed.message) {
                            showMsg(parsed.message, parsed.success ? 1 : 2);
                        } else if (xhr.status === 401) {
                            window.location.href = '/Authentication/Login';
                        } else {
                            showMsg(xhr.statusText || 'Network error', 4);
                            console.error('Form submission error', xhr.status, xhr.responseText);
                        }
                    },
                    complete: function () {
                        $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                    }
                };

                if (isMultipart) {
                    ajaxOptions.data = new FormData(form);
                    ajaxOptions.processData = false;
                    ajaxOptions.contentType = false;
                    if (token) ajaxOptions.headers = { 'RequestVerificationToken': token };
                } else {
                    ajaxOptions.data = $form.serialize();
                    if (token) ajaxOptions.headers = { 'RequestVerificationToken': token };
                }

                $.ajax(ajaxOptions);
            };

            // confirmation with alertify
            if (window.alertify && typeof alertify.confirm === 'function') {
                try {
                    alertify.confirm(
                        "Confirmation", 
                        "Are you sure you want to perform this action?", 
                        function () { 
                            doAjax(); 
                        }, 
                        function () { 
                            showMsg('Transaction cancelled', 3);
                            $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                        }
                    ).set('labels', { ok: 'Yes', cancel: 'No' });
                } catch (e) { 
                    if (confirm('Are you sure?')) {
                        doAjax(); 
                    } else {
                        showMsg('Cancelled', 3);
                        $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                    }
                }
            } else {
                if (confirm('Are you sure you want to perform this action?')) {
                    doAjax(); 
                } else {
                    showMsg('Transaction cancelled', 3);
                    $submit.prop('disabled', false).html($submit.data('orig-html') || origHtml);
                }
            }

            return false;
        }
        
        function loadFreshForm() {
            $.ajax({
                url: '/AccountTypeGroup/InitializeData',
                type: 'GET',
                data: {
                    partialView: '_AccountTypeGroupForm',
                    path: 'new'
                },
                success: function(response) {
                    $('#datalistingview').html(response);
                    $('[data-bs-toggle="tooltip"]').tooltip();
                },
                error: function(error) {
                    console.error('Error refreshing form:', error);
                    appalert('Error refreshing form. Please try again.', 4, 1);
                }
            });
        }
        
        function confirmAction(message) {
            return new Promise(function(resolve) {
                $('#confirmationModal .modal-body').text(message);
                $('#confirmationModal').modal('show');
                
                $('#confirmAction').off('click').on('click', function() {
                    $('#confirmationModal').modal('hide');
                    resolve(true);
                });
                
                $('#cancelAction').off('click').on('click', function() {
                    $('#confirmationModal').modal('hide');
                    resolve(false);
                });
            });
        }
        
        // Helper functions (if not already defined)
        function getAntiForgeryToken() {
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (!token) {
                token = $('input[name="X-XSRF-TOKEN"]').val();
            }
            return token;
        }
        
        function normalizeResponse(raw) {
            if (!raw) return null;
            try {
                return JSON.parse(raw);
            } catch (e) {
                // If it's already an object, return it
                if (typeof raw === 'object') return raw;
                return { message: raw, success: false };
            }
        }
        
        function showMsg(message, level) {
            // Use existing appalert function if available, otherwise fallback
            if (typeof appalert === 'function') {
                appalert(message, level, 1);
            } else {
                alert(message);
            }
        }
    </script>
}