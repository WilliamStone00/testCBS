@model CBS.FrontDesk.Data.Entity.Accounting_V2.AccountTypeGroup.AccountTypeGroupResponse

<!-- Custom Header Section -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center py-3">
                <h4 class="card-title text-primary mb-1">
                    <i class="mdi mdi-account-group me-2"></i>Account Type Group Management
                </h4>
                <p class="card-text small text-muted mb-0">
                    Manage account type groups for organizing account types
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Collapsible Tips -->
<div class="card mb-2">
    <h6 class="card-header py-2 d-flex justify-content-between align-items-center text-primary">
        <span class="small"><i class="mdi mdi-information-outline me-1"></i> Tips</span>
        <button class="btn btn-light btn-sm p-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGroupTips2">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseGroupTips2" class="collapse">
        <div class="card-body py-2">
            <ul class="small mb-0">
                <li><strong>Group Name:</strong> Descriptive name for the account type group (required).</li>
                <li><strong>Group Code:</strong> Unique code identifier for the group (required).</li>
                <li><strong>Display Order:</strong> Determines the order in which groups appear (lower numbers first).</li>
                <li><strong>Active Status:</strong> Enable or disable the group for use in the system.</li>
                <li><strong>Description:</strong> Provide detailed information about the group's purpose.</li>
                <li><strong>Account Types:</strong> Each group can contain multiple account types.</li>
                <li><strong>Code Format:</strong> Use consistent coding convention (e.g., MEM_ORD, SYS_RESERVED).</li>
            </ul>
        </div>
    </div>
</div>

<div class="card">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "AccountTypeGroup", FormMethod.Post,
               new
               {
                   enctype = "multipart/form-data",
                   id = "editGroupForm",
                   onsubmit = "return false;"
               }))
        {
            @Html.HiddenFor(m => m.Id)
            @Html.AntiForgeryToken()

            <div class="row gy-3">
                <!-- Group Information Section -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pt-2 pb-1">
                        <i class="mdi mdi-account-group me-1"></i> Account Type Group Information
                    </h6>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Group Name", required = "required" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        <label>Group Name *</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "Group Code", required = "required" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                        <label>Group Code *</label>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating shadow-sm">
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Description", rows = "3" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label>Description</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", placeholder = "Display Order", type = "number", min = "0" })
                        @Html.ValidationMessageFor(m => m.DisplayOrder, "", new { @class = "text-danger" })
                        <label>Display Order</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating shadow-sm">
                        <div class="form-check form-switch mt-3 ms-2">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActiveSwitch" })
                            <label class="form-check-label" for="IsActiveSwitch">
                                Active Status
                            </label>
                        </div>
                        <small class="text-muted ms-2">Toggle to activate/deactivate this group</small>
                    </div>
                </div>

                <div class="col-12 text-end mt-4">
                    @if (string.IsNullOrEmpty(Model?.Id))
                    {
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="mdi mdi-content-save me-1"></i> Create Group
                        </button>
                        <button type="button" class="btn btn-outline-secondary shadow-sm px-4" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="mdi mdi-content-save me-1"></i> Update Group
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>
