@model List<CBS.FrontDesk.Data.Entity.CheckManagementSystem.CategoryConfig>
@using Resources

<fieldset class="fieldset-custom">
    <h6 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>  Advanced Category Filters </h6>

    <div class="table-responsive">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@ChequeManagements.Name</th>
                    <th>@ChequeManagements.Price</th>
                    <th>@ChequeManagements.Numberofpages</th>
                    <th>@ChequeManagements.isactive</th>
                    <th>@ChequeManagements.validity</th>
                    <th>@ChequeManagements.isc</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td style="width:15%">@category.name</td>
                        <td style="width:15%">@category.basePrice</td>
                        <td style="width:15%">@category.numberOfPages</td>
                        <td style="width:15%">
                            @if (category.isActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td style="width:15%">@category.validityPeriodInMonths</td>
                        <td style="width:15%">@category.issuanceLimitPerCustomerType</td>
                        <td style="width:10%" class="text-center">
                            <a href="#"
                               onclick="AddORUpdateGen('@category.Id', 'datalistingview', '_Categories', 'get', 'Categoryconfic')"
                               class="mr-2"
                               data-toggle="tooltip"
                               title="Edit @category.name">Edits</a>

                            <a href="#" class="ms-2 text-danger js-delete-category" data-id="@category.Id" data-name="@category.name">Delete</a>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>
</fieldset>



