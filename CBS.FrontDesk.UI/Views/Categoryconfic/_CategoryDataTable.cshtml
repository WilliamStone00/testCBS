@model List<CBS.FrontDesk.Data.Entity.CheckManagementSystem.CategoryConfig>
    @using Resources

    <fieldset class="fieldset-custom">
        <div class="table-responsive">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@ChequeManagements.Name</th>
                        <th>@ChequeManagements.Price</th>
                        <th>@ChequeManagements.Numberofpages</th>
                        <th>@ChequeManagements.isactive</th>
                        <th>@ChequeManagements.validity</th>
                        <th>@ChequeManagements.isc</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                    <td style="width:20%">@category.Name</td>
                    <td style="width:20%">@category.BasePrice</td>
                    <td style="width:20%">@category.NumberOfPages</td>
                    <td style="width:20%">
                        @if (category.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td style="width:15%">@category.ValidityPeriodInMonths</td>
                    <td style="width:15%">@category.IssuanceLimitPerCustomerType</td>
                        <td style="width:5%" class="text-center">
                            <a href="#"
                               onclick="AddORUpdateGen('@category.Id', 'datalistingview', '_Categories', 'get', 'Categoryconfic')"
                               class="mr-2"
                               data-toggle="tooltip"
                               title="Edit @category.Name">Edits</a>

                            <a href="#"
                               onclick="DeleteRecordDataTable('Categoryconfic', '@category.Id', 'myDataTable', '_CategoryDataTable', 0, 'datalistingview',null,'list')"
                               class="mr-2 text-danger"
                               data-toggle="tooltip"
                               title="Delete @category.Name">Delete</a>
                        </td>
                </tr>

                     }
                </tbody>
            </table>
        </div>
    </fieldset>


  
