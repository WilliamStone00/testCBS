@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i>@ChequeManagements.CheckBooks</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@ChequeManagements.CreatedDate</th>
                    <th>@ChequeManagements.CategoryName</th>
                    <th>@ChequeManagements.IsCentralised</th>
                    <th>@ChequeManagements.BasePrice</th>
                    <th>@ChequeManagements.NumOfLeaves</th>
                    <th>@ChequeManagements.Status</th>
                    <th>@ChequeManagements.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Category Details Modal (shell) -->
<div class="modal fade" id="categoryDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-book-open-page-variant-outline me-1"></i> @ChequeManagements.CategoryDetails</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- server partial will be injected here -->
                <div class="text-center">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@ChequeManagements.Close</button>
            </div>
        </div>
    </div>
</div>
