@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.CategoryConfig
@using Resources 
<fieldset class="fieldset-custom">

    <!-- Header Card -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body text-center">
            <h1 class="card-title text-primary fw-bold mb-2">
                <i class="mdi mdi-book-open-page-variant-outline me-2"></i> @ChequeManagements.CategoryDetails
            </h1>
            <p class="card-text text-muted mb-1">
                @ChequeManagements.text
            </p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i> @ChequeManagements.BasicInformation</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@ChequeManagements.CategoryID</td><td>@Model.id</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.BankId:</td><td>@Model.bankId</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.Branch Id:</td><td>@(Model.branchID ?? "-")</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.Name:</td><td>@Model.name</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.IsCentralised:</td><td>@(Model.isCentralised ? "Yes" : "No")</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.isactive:</td><td>@(Model.isActive ? "Yes" : "No")</td></tr>
            </table>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
            <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i> Category Settings</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@ChequeManagements.NumberOfCheckBooks:</td><td>@Model.numberofCheckBooks</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.Numberofpages:</td><td>@Model.numberOfPages</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.validity</td><td>@Model.validityPeriodInMonths</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.limit</td><td>@Model.issuanceLimitPerCustomerType</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.MaxIssuancePerYear</td><td>@Model.maxIssuancePerYear</td></tr>
            </table>
        </div>
    </div>

    <!-- Fee Section -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-currency-usd me-2"></i> Fee Structure</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@ChequeManagements.BasePrice</td><td>@String.Format("{0:N2}", Model.basePrice)</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.IssuanceFee:</td><td>@String.Format("{0:N2}", Model.issuanceFee)</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.RenewalFee:</td><td>@String.Format("{0:N2}", Model.renewalFee)</td></tr>
            </table>
        </div>
    </div>

    <!-- Timeline Section -->
    <div class="row mt-3">
        <div class="col-12">
            <h6 class="text-primary"><i class="mdi mdi-timeline-clock-outline me-2"></i> Timeline</h6>
            <table class="table table-sm table-bordered">
                <tr><td class="fw-bold">@ChequeManagements.CreatedDate:</td><td>@Model.createdDate.ToString()</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.Createdby</td><td>@Model.createdBy</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.ModifiedDate</td><td>@Model.modifiedDate.ToString()</td></tr>
                <tr><td class="fw-bold">@ChequeManagements.ModifiedBy</td><td>@Model.modifiedBy</td></tr>
            </table>
        </div>
    </div>

</fieldset>
