@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.CategoryConfig
@using Resources


<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a href="@Url.Action("List", "Categoryconfic")"
           class="btn btn-label-primary btn-sm me-2"
           id="btnViewList"
           data-bs-toggle="tooltip"
           title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Categories','new','Categoryconfic')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalVault.AddNewVault">
            <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.ADD_NEW
        </a>
    </div>
</div>
<div class="card mb-1">
    <div class="modal-body">
        @using (Html.BeginForm("CreateOrUpdate", "Categoryconfic", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);"}))
        {
            @Html.HiddenFor(m => m.id)
        <div class="row gy-3">
            <!-- Profile & Address Section -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pt-2 pb-1"><i class="mdi mdi-card-account-details-outline me-1"></i> @GlobalShared.Category_Details </h6>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.name, new { @class = "form-control", placeholder = GlobalShared.Name })
                    @Html.ValidationMessageFor(m => m.name, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.basePrice, new { @class = "form-control", placeholder = GlobalShared.Price })
                    @Html.ValidationMessageFor(m => m.basePrice, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Price</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(
                        m => m.maxTransactionAmount,
                        new
                        {
                            @class = "form-control",
                            placeholder = GlobalShared.Max_Transaction_Amount,
                            type = "number",
                            step = "0.01",
                            min = "0"
                        })
                    @Html.ValidationMessageFor(
                        m => m.maxTransactionAmount,
                        "",
                        new { @class = "text-danger" })
                    <label>@GlobalShared.Max_Transaction_Amount</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.numberOfPages, new { @class = "form-control", placeholder = GlobalShared.Number_of_Pages })
                    @Html.ValidationMessageFor(m => m.numberOfPages, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Number_of_Pages</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.issuanceLimitPerCustomerType, new { @class = "form-control", placeholder = CategoryconficResource.issueance_per_customer })
                    @Html.ValidationMessageFor(m => m.issuanceLimitPerCustomerType, "", new { @class = "text-danger" })
                    <label>@CategoryconficResource.issueance_per_customer </label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.TextBoxFor(m => m.validityPeriodInMonths, new { @class = "form-control", placeholder = GlobalShared.validity })
                    @Html.ValidationMessageFor(m => m.validityPeriodInMonths, "", new { @class = "text-danger" })
                    <label>@GlobalShared.validity</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.branchID, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(m => m.branchID, "", new { @class = "text-danger" })
                    <label>@GlobalUserManagement.Branch</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-group ps-2">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.isActive, new { @class = "form-check-input", id = "IsActive" })
                        <label class="form-check-label" for="IsActive">@GlobalShared.IsActive</label>
                    </div>
                    @Html.ValidationMessageFor(m => m.isActive, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-12 text-end mt-3">
                @if (Model.id == null)
                {
                    <button type="submit" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-save me-1"></i> @GlobalUserManagement.CreateAccount
                    </button>
                    <button type="reset" class="btn btn-outline-secondary shadow-sm px-4">
                        @GlobalShared.Reset
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
            </div>
        </div>
        }
    </div>
    </div>