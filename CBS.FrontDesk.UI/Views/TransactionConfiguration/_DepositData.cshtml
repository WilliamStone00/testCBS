@using Resources
<fieldset class="fieldset-custom">
    <legend>@Globals_DepositData.DepositPoliciesData</legend>
    @if (Model.DepositLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>@Globals_DepositData.NoDepositPolicyConfigured</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable_Deposit">
                <thead>
                    <tr>
                        <th>@Globals_DepositData.Type</th>
                        <th>@Globals_DepositData.MaxAmount</th>
                        <th>@Globals_DepositData.Source</th>
                        <th>@Globals_DepositData.Destination</th>
                        <th>@Globals_DepositData.CamCCUL</th>
                        <th>@Globals_DepositData.HeadOffice</th>
                        <th>@Globals_DepositData.FluxPTM</th>
                        <th>@Globals_DepositData.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DepositLimits)
                    {
                        <tr>
                            <td>@d.DepositType</td>
                            <td>@d.MaxAmount.ToString("#,##0.0")</td>
                            <td>@d.SourceBrachOfficeShare.ToString("#,##0") %</td>
                            <td>@d.DestinationBranchOfficeShare.ToString("#,##0") %</td>
                            <td>@d.CamCCULShare.ToString("#,##0") %</td>
                            <td>@d.HeadOfficeShare.ToString("#,##0") %</td>
                            <td>@d.FluxAndPTMShare.ToString("#,##0") %</td>
                            <td>
                                <a href="#" onclick="AddORUpdateGen('@d.Id','myDataTable_Deposit','_DepositConfig','get','TransactionConfiguration','depositlimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_DepositData.Select, @d.Product.Name, @d.DepositType)">@Globals_DepositData.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_DepositData.Delete, @d.Product.Name, @d.DepositType)" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','myDataTable_Deposit','_DepositData',0,'datalistingview_Deposit',null,'cash_deposit_parameter')">@Globals_DepositData.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>