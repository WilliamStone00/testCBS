@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <input type="hidden" name="ServiceOption" value="depositlimit" id="ServiceOption" />
    <div class="row mt-2 gy-4">
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.DepositLimit.productId, new SelectList(ViewBag.Products, "Id", "name"), "---Select product---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.DepositLimit.productId, "", new { @class = "text-danger" })
                <label>Select product</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.DepositLimit.depositType, new SelectList(ViewBag.DepositLimitTypes, "Text", "Value"), "---Select deposit type---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.DepositLimit.depositType, "", new { @class = "text-danger" })
                <label>Select deposit limit type</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.DepositLimit.minAmount, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DepositLimit.minAmount, "", new { @class = "text-danger" })
                <label>Min deposit amount</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.DepositLimit.maxAmount, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DepositLimit.maxAmount, "", new { @class = "text-danger" })
                <label>Max deposit amount</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.DepositLimit.feePercentage, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DepositLimit.feePercentage, "", new { @class = "text-danger" })
                <label>Percentage fee</label>
            </div>
        </div>
    </div>
    <div class="mt-4">
        @if (Model.DepositLimit.id == null)
        {
            <button type="submit" class="btn btn-primary me-2">Save</button>
            <input type="hidden" name="Action" value="insert" id="Action" />
        }
        else
        { <button type="submit" class="btn btn-primary me-2">Update</button>
            @Html.HiddenFor(m => m.DepositLimit.id)
            <input type="hidden" name="Action" value="update" id="Action" />
        }
    </div>
}
