@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
@{
    ViewBag.Title = GlobalsAccountMapping.AccountMapping;
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title text-primary">@GlobalsAccountMapping.AccountMappingFor @Model.SavingProduct.Name</h4>
                <p class="card-text text-muted">
                    @GlobalsAccountMapping.AccountMappingDescription
                </p>
            </div>
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button text-primary"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cog me-2"></i> @GlobalsAccountMapping.OrdinaryAccountMapping 
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <h5 class="text-success">
                                                @GlobalsAccountMapping.ConfigureAccMapForTransRelTo
                                                <strong>@Model.SavingProduct.Name</strong>.
                                            </h5>
                                            <p class="text-muted">
                                                @GlobalsAccountMapping.ConfigureAccMapForTransRelToDescription
                                            </p>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_AccountMappingVII")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

