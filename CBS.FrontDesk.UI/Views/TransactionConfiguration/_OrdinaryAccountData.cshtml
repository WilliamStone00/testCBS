@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@if (Model.SavingProducts.Count == 0)
{
    <div class="text-center my-3">
        <p>No ordinary product created.</p>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_ProductConfig','new','TransactionConfiguration','savingproduct')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
}
else
{ <fieldset class="fieldset-custom">
        <legend>Ordinary account listings for mapping and policies</legend>
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Range</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SavingProducts)
                    {
                        <tr>
                            <td style="width:10%">@d.Code</td>
                            <td style="width:30%">@d.Name</td>
                            <td style="width:13%">@d.AccountType</td>
                            <td style="width:20%">@d.MinAmount.ToString("#,##0.0")-@d.MaxAmount.ToString("#,##0.0")</td>
                            <td style="width:7%">
                                @if (d.ActiveStatus)
                                {
                                    <span class="badge bg-info">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Inactive</span>
                                }
                            </td>
                            <td style="width:20%">
                                @if (!d.IsUsedForTellerProvisioning)
                                {
                                    <a href="/TransactionConfiguration/PolicyandSharing?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="Configure @d.Name operation policies">Policies |</a>
                                    <a href="/TransactionConfiguration/AccountMapping?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="Configure @d.Name account mapping">Mappings |</a>
                                    <a href="/TransactionConfiguration/AccountMappingInfo?Key=@d.Id" class="mr-2" target="_blank" data-toggle="tooltip" data-placement="top" title="Configure @d.Name account mapping">Simulation</a>

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </fieldset>
}

