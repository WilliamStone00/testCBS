@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<fieldset class="fieldset-custom">
    <legend>Withdrawal policies data</legend>
    @if (Model.WithdrawalLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>No withdrawal policy is configured.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Product name</th>
                        <th>type</th>
                        <th>Min-Max Amount</th>
                        <th>Form Fee MP</th>
                        <th>Form Fee PP</th>
                        <th>Notification on Withdrawal</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.WithdrawalLimits)
                    {
                        <tr>
                            <td style="width:20%">@d.Product.Name</td>
                            <td style="width:15%">@d.WithdrawalType</td>
                            <td style="width:20%">@d.MinAmount.ToString("#,##0.0")-@d.MaxAmount.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.MoralPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.PhysicalPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td style="width:10%">
                                @if (d.MustNotifyOnWithdrawal)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Withdrawal','_WithdrawalConfig','get','TransactionConfiguration','withdrawallimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Product.Name @d.WithdrawalType to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Product.Name @d.WithdrawalType" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','myDataTable','_WithdrawalData',0,'datalistingview_Withdrawal')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }



</fieldset>