@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<fieldset class="fieldset-custom">
    <legend>Withdrawal policies data</legend>
    @if (Model.WithdrawalLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>No withdrawal policy is configured.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover" id="xmyDataTable">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Max Amount</th>
                        <th>Form M</th>
                        <th>From P</th>
                        <th>Source</th>
                        <th>Destin</th>
                        <th>CamCCUL</th>
                        <th>HeadOffice</th>
                        <th>FluxPTM</th>
                        <th>SWN</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.WithdrawalLimits)
                    {
                        <tr>
                            <td>@d.WithdrawalType</td>
                            <td>@d.MaxAmount.ToString("#,##0.0")</td>
                            <td>@d.MoralPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td>@d.PhysicalPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td>@d.SourceBrachOfficeShare.ToString("#,##0") %</td>
                            <td>@d.DestinationBranchOfficeShare.ToString("#,##0") %</td>
                            <td>@d.CamCCULShare.ToString("#,##0") %</td>
                            <td>@d.HeadOfficeShare.ToString("#,##0") %</td>
                            <td>@d.FluxAndPTMShare.ToString("#,##0") %</td>
                            <td>
                                @if (d.MustNotifyOnWithdrawal)
                                {
                                    <span class="badge bg-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                            <td>
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Withdrawal','_WithdrawalConfig','get','TransactionConfiguration','withdrawallimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Product.Name @d.WithdrawalType to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Product.Name @d.WithdrawalType" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','xmyDataTable','_WithdrawalData',0,'datalistingview_Withdrawal',null,'cash_withdrawal_parameter')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
