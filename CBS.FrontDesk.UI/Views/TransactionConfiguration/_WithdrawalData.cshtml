@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<table class="table table-hover" id="myDataTable_Withdrawal">
    <thead class="table-light">
        <tr>
            <th>Product name</th>
            <th>type</th>
            <th>Min-Max Amount</th>
            <th>Charges</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.WithdrawalLimits)
        {
            <tr>
                <td style="width:35%">@d.product.name</td>
                <td style="width:15%">@d.withdrawalType</td>
                <td style="width:20%">@d.minAmount-@d.maxAmount</td>
                <td style="width:10%">
                    @if (d.withdrawalFeeFlat > 0)
                    {
                        <label>@d.withdrawalFeeFlat</label>
                    }
                    else
                    {
                        <label>@d.withdrawalFeeRate %</label>
                    }
                </td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview_Withdrawal','_WithdrawalConfig','get','TransactionConfiguration','withdrawallimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.product.name @d.withdrawalType to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.product.name @d.withdrawalType" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','myDataTable_Withdrawal','_WithdrawalData',0,'datalistingview_Withdrawal')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

