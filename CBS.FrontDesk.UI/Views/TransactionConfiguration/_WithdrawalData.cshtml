@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources

<fieldset class="fieldset-custom">
    <legend>@Globals_WithdrawalData.WithdrawalPoliciesData</legend>
    @if (Model.WithdrawalLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>@Globals_WithdrawalData.NoWithdrawalPolicyConfigured</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover" id="xmyDataTable">
                <thead>
                    <tr>
                        <th>@Globals_WithdrawalData.Type</th>
                        <th>@Globals_WithdrawalData.MaxAmount</th>
                        <th>@Globals_WithdrawalData.FormM</th>
                        <th>@Globals_WithdrawalData.FromP</th>
                        <th>@Globals_WithdrawalData.Source</th>
                        <th>@Globals_WithdrawalData.Destin</th>
                        <th>@Globals_WithdrawalData.CamCCUL</th>
                        <th>@Globals_WithdrawalData.HeadOffice</th>
                        <th>@Globals_WithdrawalData.FluxPTM</th>
                        <th>@Globals_WithdrawalData.SWN</th>
                        <th>@Globals_WithdrawalData.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.WithdrawalLimits)
                    {
                        <tr>
                            <td>@d.WithdrawalType</td>
                            <td>@d.MaxAmount.ToString("#,##0.0")</td>
                            <td>@d.MoralPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td>@d.PhysicalPersonWithdrawalFormFee.ToString("#,##0.0")</td>
                            <td>@d.SourceBrachOfficeShare.ToString("#,##0") %</td>
                            <td>@d.DestinationBranchOfficeShare.ToString("#,##0") %</td>
                            <td>@d.CamCCULShare.ToString("#,##0") %</td>
                            <td>@d.HeadOfficeShare.ToString("#,##0") %</td>
                            <td>@d.FluxAndPTMShare.ToString("#,##0") %</td>
                            <td>
                                @if (d.MustNotifyOnWithdrawal)
                                {
                                    <span class="badge bg-info">@Globals_WithdrawalData.Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Globals_WithdrawalData.No</span>
                                }
                            </td>
                            <td>
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_Withdrawal','_WithdrawalConfig','get','TransactionConfiguration','withdrawallimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_WithdrawalData.SelectToEdit, d.Product.Name, d.WithdrawalType)">@Globals_WithdrawalData.Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@string.Format(Globals_WithdrawalData.Delete, d.Product.Name, d.WithdrawalType)" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','xmyDataTable','_WithdrawalData',0,'datalistingview_Withdrawal',null,'cash_withdrawal_parameter')">@Globals_WithdrawalData.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>