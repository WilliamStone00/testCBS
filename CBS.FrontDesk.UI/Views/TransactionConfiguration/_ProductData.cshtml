@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@if (Model.SavingProducts.Count == 0)
{
    <div class="text-center my-3">
        <p>No ordinary product created.</p>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_ProductConfig','new','TransactionConfiguration','savingproduct')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Add new">
            <span class="tf-icons mdi mdi-plus mdi-18px"></span>
        </a>
    </div>
}
else
{
    <fieldset class="fieldset-custom">
        <legend>Ordinary account listings</legend>
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable_product">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Range</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SavingProducts)
                    {
                        <tr>
                            <td style="width:10%">@d.Code</td>
                            <td style="width:35%">@d.Name</td>
                            <td style="width:13%">@d.AccountType</td>
                            <td style="width:20%">@d.MinAmount.ToString("#,##0.0")-@d.MaxAmount.ToString("#,##0.0")</td>
                            <td style="width:7%">
                                @if (d.ActiveStatus)
                                {
                                    <span class="badge bg-info">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Inactive</span>
                                }
                            </td>
                            <td style="width:15%">
                                @if (!d.IsUsedForTellerProvisioning)
                                {
                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_ProductConfig','get','TransactionConfiguration','savingproduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit |</a>
                                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.Id','myDataTable_product','_ProductData',0,'datalistingview_product')">Delete</a>
                                }
                                else
                                {
                                    <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_ProductConfig','get','TransactionConfiguration','savingproduct')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </fieldset>
}

