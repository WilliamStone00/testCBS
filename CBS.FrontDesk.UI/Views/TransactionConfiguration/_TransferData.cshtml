@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<fieldset class="fieldset-custom">
    <legend>Transfer policies data</legend>
    @if (Model.TransferLimits.Count == 0)
    {
        <div class="text-center my-3">
            <p>No transfer policy is configured.</p>
        </div>
    }
    else
    { <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Product name</th>
                        <th>Transfer type</th>
                        <th>Min-Max Amount</th>
                        <th>S-Share</th>
                        <th>D-Share</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.TransferLimits)
                    {
                        <tr>
                            <td style="width:30%">@d.product.Name</td>
                            <td style="width:15%">@d.transferType</td>
                            <td style="width:20%">@d.minAmount.ToString("#,##0.0")-@d.maxAmount.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.SourceBrachOfficeShare.ToString("#,##0.0") %</td>
                            <td style="width:10%">@d.DestinationBranchOfficeShare.ToString("#,##0.0")</td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_Transfer','_TransferConfig','get','TransactionConfiguration','transferlimit')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.product.Name @d.transferType to edit">Edit</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.product.Name @d.transferType" onclick="DeleteRecordDataTable('TransactionConfiguration','@d.id','myDataTable','_TransferData',0,'datalistingview_Transfer',null,'cash_transfer_parameter')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    </fieldset>

