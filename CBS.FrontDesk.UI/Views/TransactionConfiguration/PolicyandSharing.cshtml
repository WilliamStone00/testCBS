@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration

@{
    ViewBag.Title = "Policies and Sharing";
}
<style>
    /* Generic table styles */
    table {
        width: 100%;
        table-layout: auto; /* Adjusts columns based on content */
        border-collapse: collapse; /* Removes extra spacing between cells */
        background-color: #f9f9f9; /* Light smoky background */
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Subtle smoky shadow */
        border: 1px solid #ddd; /* Dusty border */
    }

        /* Table headers */
        table thead {
            background-color: #e0e0e0; /* Muted gray for the header */
            color: #555; /* Soft text color */
            font-weight: bold;
            border-bottom: 2px solid #ccc; /* Smoky divider */
        }

        /* Table rows */
        table tbody tr {
            transition: background-color 0.3s; /* Smooth hover effect */
        }

            table tbody tr:hover {
                background-color: #eaeaea; /* Smoky hover effect */
            }

            /* Alternating row colors for dusty effect */
            table tbody tr:nth-child(even) {
                background-color: #f2f2f2; /* Slightly darker gray */
            }

        /* Table cells */
        table th, table td {
            padding: 10px; /* Add spacing for better readability */
            text-align: left; /* Align text to the left */
            color: #444; /* Dusty text color */
        }

    /* Responsive container */
    .table-responsive {
        overflow-x: auto; /* Ensure horizontal scroll for small screens */
        background-color: #f4f4f4; /* Subtle dusty background */
        padding: 10px; /* Add spacing around the table */
        border-radius: 8px; /* Smooth edges for a modern look */
    }
</style>
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title text-primary">Policies and Sharing Configuration</h4>
                <p class="card-text text-muted">
                    Configure policies and sharing rules for <strong>@Model.SavingProduct.Name</strong>.
                    These settings ensure accurate and consistent handling of account policies.
                </p>
            </div>
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cog me-2"></i>
                            Ordinary Account Configurations
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <h5 class="text-success">Ordinary Account Settings</h5>
                                            <p class="text-muted">
                                                Manage and update policies, configurations, and sharing rules for
                                                <strong>@Model.SavingProduct.Name</strong>. Ensure all configurations align
                                                with your organizational standards.
                                            </p>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_Policies")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

