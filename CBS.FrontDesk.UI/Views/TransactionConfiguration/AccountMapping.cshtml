@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration

@{
    ViewBag.Title = "Account Mapping";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title text-primary">Account Mapping for @Model.SavingProduct.Name</h4>
                <p class="card-text text-muted">
                    Use this section to map chart of account configurations to the saving product. This ensures accurate tracking of transactions related to the product.
                </p>
            </div>
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button text-primary"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cog me-2"></i> Ordinary Account Mapping
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <h5 class="text-success">
                                                Configure account mappings for transactions related to
                                                <strong>@Model.SavingProduct.Name</strong>.
                                            </h5>
                                            <p class="text-muted">
                                                Account mapping ensures that all financial operations for this product
                                                are accurately reflected in the appropriate accounts.
                                                Please review and map the accounts carefully.
                                            </p>
                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_AccountMapping")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/TransactionConfiguration/SavingProductFeeMapping.js"></script>
}

