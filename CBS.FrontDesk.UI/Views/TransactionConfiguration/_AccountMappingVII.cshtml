@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Mapping ordinary accounts to the account chart.
                    </button>
                </h2>

                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">

                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {

                                <input type="hidden" name="ServiceOption" value="accountmappingv2" id="ServiceOption" />

                                <!-- Product context (readonly) -->
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SavingProduct.Code, new { @class = "form-control", @readonly = true })
                                            <label>Product code</label>
                                            <small class="form-text text-muted">Unique product identifier used across the accounting configuration.</small>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                            <label>Product name</label>
                                            <small class="form-text text-muted">Human-readable name of the product you are mapping to the GL.</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- SECTION 1: Principals & Interest -->
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-12"><h6 class="text-primary mb-2">Principals & Interest</h6></div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2PrincipalAmountChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Principal account</label>
                                            <small class="form-text text-muted">Member liability balance for the product (savings principal / core balance).</small>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2InterestAmountChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Interest account</label>
                                            <small class="form-text text-muted">GL to recognize interest accrued/paid related to this product.</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- SECTION 2: Transits & Commissions -->
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-12"><h6 class="text-primary mb-2">Transits & Commissions</h6></div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2TransitChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Transit account (local use)</label>
                                            <small class="form-text text-muted">Temporary holding account for in-process movements within the same branch (e.g., teller handover).</small>
                                        </div>
                                    </div>

                                    <!-- NEW: Cash-in commission account (replaces old generic commission) -->
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2CashInCommissionChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Cash-in commission account</label>
                                            <small class="form-text text-muted">
                                                Branch commission GL used when charging commission on cash deposits for this product.
                                            </small>
                                        </div>
                                    </div>

                                    <!-- NEW: Cash-out commission account -->
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2CashOutCommissionChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Cash-out commission account</label>
                                            <small class="form-text text-muted">
                                                Branch commission GL used when charging commission on cash withdrawals for this product.
                                            </small>
                                        </div>
                                    </div>

                                    <!-- NEW: Transfer commission account -->
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(
                                              m => m.SavingProduct.AccountingV2TransferCommissionChartOfAccountId,
                                              new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                              "Select an account",
                                              new { @class = "form-control select2", @search = "true" })
                                            <label>Transfer commission account</label>
                                            <small class="form-text text-muted">
                                                Branch commission GL used when charging commission on account-to-account transfers for this product.
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                @* DAILY COLLECTIONS *@
                                if (Model.SavingProduct.AccountType.Contains("Daily"))
                                {
                                    <!-- SECTION 3: Daily Collections -->
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12"><h6 class="text-primary mb-2">Daily Collections</h6></div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2SuplusChartOfAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Surplus account for Daily Savings</label>
                                                <small class="form-text text-muted">
                                                    Holds surplus balances collected by daily collectors.
                                                </small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2ShortageChartOfAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Shortage account for Daily Savings</label>
                                                <small class="form-text text-muted">
                                                    Holds shortage balances realized from daily collections after reconciliation.
                                                </small>
                                            </div>
                                        </div>

                                    </div>
                                }

                                if (Model.SavingProduct.AccountType.Contains("Salary"))
                                {
                                    <!-- SECTION 3: Civil servants -->
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12"><h6 class="text-primary mb-2">Civil servants</h6></div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2CivilServantsSalarySourceChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Salary source account</label>
                                                <small class="form-text text-muted">Bank/agency current account that funds civil servant salary batches (credit origin).</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2CivilServantsSalaryDestinationPayableChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Salary destination payable account</label>
                                                <small class="form-text text-muted">Interim payable that holds the batch total before distribution to member accounts.</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2CivilServantsSalarySourceSalaryChartofaccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Source salary account</label>
                                                <small class="form-text text-muted">Account debited when releasing funds from the payable to individual members.</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2CivilServantsSalaryDestinationSalaryProductChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Destination salary product account</label>
                                                <small class="form-text text-muted">Member product GL (credit) used when posting the salary to the beneficiary account.</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 4: Private institutions -->
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12"><h6 class="text-primary mb-2">Private institutions</h6></div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2PrivateInstitutionSalarySourceChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Salary source account</label>
                                                <small class="form-text text-muted">Funding account for private institution payroll batches.</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2PrivateInstitutionSalaryDestinationPayableChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Salary destination payable account</label>
                                                <small class="form-text text-muted">Temporary payable for private payroll totals before member posting.</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2PrivateInstitutionSalarySourceSalaryChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Source salary account</label>
                                                <small class="form-text text-muted">GL debited when moving private payroll from payable to members.</small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2PrivateInstitutionDestinationSalaryProductChartofAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Destination salary product account</label>
                                                <small class="form-text text-muted">Member product GL credited for private payroll beneficiaries.</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 5: Suspense -->
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12"><h6 class="text-primary mb-2">Suspense account</h6></div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                  m => m.SavingProduct.AccountingV2SuspenseChartOfAccountId,
                                                  new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                  "Select an account",
                                                  new { @class = "form-control select2", @search = "true" })
                                                <label>Suspense account</label>
                                                <small class="form-text text-muted">Holds unidentified/unbalanced items (e.g., unmatched salary lines) pending investigation.</small>
                                            </div>
                                        </div>
                                    </div>

                                }

                                <div class="mt-2">
                                    @if (Model.SavingProduct?.Id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Map accounts</button>
                                        @Html.HiddenFor(m => m.SavingProduct.Id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }
                                </div>

                            }

                        </div>
                    </div>
                </div>

            </div>

            <!-- =============================================== -->
            <!-- PRODUCT NARRATIONS (Cash-in / Cash-out / Transfer) -->
            <!-- =============================================== -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingNarrations">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseNarrations"
                            aria-expanded="false"
                            aria-controls="collapseNarrations">
                        Product narrations for cash-in, cash-out and transfers
                    </button>
                </h2>

                <div id="collapseNarrations"
                     class="accordion-collapse collapse"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">

                            @using (Html.BeginForm(
                                "AddOrUpdateSavingProductNarrations",         // 🔁 MVC action name
                                "TransactionConfiguration",                   // 🔁 MVC controller name
                                FormMethod.Post,
                                new { onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                @Html.HiddenFor(m => m.SavingProduct.Id)
                                <input type="hidden" name="ServiceOption" value="productnarrations" />

                                <!-- Header / tips -->
                                <div class="col-12">
                                    <p class="text-muted mb-2">
                                        Use this section to define default narrations that will appear on
                                        journal lines and receipts for this product.
                                        If left blank, the system will fall back to generic descriptions.
                                    </p>
                                </div>

                                <!-- ROW 1: Cash-in -->
                                <div class="col-12">
                                    <h6 class="text-primary mb-2">Cash-in (Deposits)</h6>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.CashInNarration,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height: 110px;"
                                            })
                                        <label>Cash-in narration (principal)</label>
                                        <small class="form-text text-muted">
                                            Default description for standard cash deposits on this product
                                            (e.g. “Cash deposit to savings account”).
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.CashinNarrationForCommision,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height: 110px;"
                                            })
                                        <label>Cash-in narration for commission</label>
                                        <small class="form-text text-muted">
                                            Narration used when posting commission on cash deposits
                                            (e.g. “Cash-in commission on deposit”).
                                        </small>
                                    </div>
                                </div>

                                <!-- ROW 2: Cash-out -->
                                <div class="col-12 mt-2">
                                    <h6 class="text-primary mb-2">Cash-out (Withdrawals)</h6>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.CashOutNarration,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height: 110px;"
                                            })
                                        <label>Cash-out narration (principal)</label>
                                        <small class="form-text text-muted">
                                            Default description for cash withdrawals from this product
                                            (e.g. “Cash withdrawal from savings account”).
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.CashOutNarrationForCommision,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height = 110px;"
                                            })
                                        <label>Cash-out narration for commission</label>
                                        <small class="form-text text-muted">
                                            Narration used when posting commission on cash withdrawals
                                            (e.g. “Cash-out commission on withdrawal”).
                                        </small>
                                    </div>
                                </div>

                                <!-- ROW 3: Transfers -->
                                <div class="col-12 mt-2">
                                    <h6 class="text-primary mb-2">Account-to-account transfers</h6>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.TransfterNarration,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height: 110px;"
                                            })
                                        <label>Transfer narration (principal movement)</label>
                                        <small class="form-text text-muted">
                                            Default description for principal movements between accounts
                                            (e.g. “Transfer between member accounts”).
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(
                                            m => m.SavingProduct.TransfterNarrationForCommision,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3",
                                                style = "height: 110px;"
                                            })
                                        <label>Transfer narration for commission</label>
                                        <small class="form-text text-muted">
                                            Narration used when posting commission on account-to-account transfers
                                            (e.g. “Transfer commission between member accounts”).
                                        </small>
                                    </div>
                                </div>

                                <!-- Submit -->
                                <div class="col-12 mt-3">
                                    <button type="submit" class="btn btn-primary me-2">
                                        Save narrations
                                    </button>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>
