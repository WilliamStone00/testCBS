    </fieldset>
    <fieldset class="fieldset-custom">
        <legend>
            @Globals_ProductConfig.MobileApplicationControlForCMoney
            <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.ControlProductSettingsForMobileApplicationAccess"></i>
        </legend>
        <div class="row">
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.ActivateForMobileApp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="ActivateForMobileApp">
                        @Globals_ProductConfig.CheckToActivateThisProductForMobileApp
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.EnableThisOptionToMakeThisProductAvailableOnTheMobileApp"></i>
