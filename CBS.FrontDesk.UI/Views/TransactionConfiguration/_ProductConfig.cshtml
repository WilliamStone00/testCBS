    <fieldset class="fieldset-custom">
        <legend>@Globals_ProductConfig.AccountCharacteristicsBehaviour</legend>
        <div class="row">
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.ActiveStatus, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_ActiveStatus">
                        @Globals_ProductConfig.CheckToActivateThisProduct
