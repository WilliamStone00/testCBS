                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPeformCashOutMobileApp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="CanPeformCashoutMobileApp">
                        @Globals_ProductConfig.PerformCashout
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.AllowCashOutTransactionsThroughTheMobileApp"></i>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPeformCashinMobileApp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="CanPeformCashinMobileApp">
                        @Globals_ProductConfig.PerformCashin
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.EnableCashInOperationsThroughTheMobileApp"></i>
                    </label>
                </div>
            </div>
            <div class="col-6 mb-2" id="swn">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.ActivateSavingWithdrawalNotificationForMobileApp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="ActivateSavingWithdrawalNotificationForMobileApp">
                        @Globals_ProductConfig.ActivateSavingWithdrawalNotification
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.ActivateNotificationsForSavingsWithdrawalsInTheMobileApp"></i>
                    </label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.DisplayOrder, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.DisplayOrder, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.OrderOfListingOrDisplayInCMoneyAppForMembersUsage</label>
                </div>
            </div>
        </div>
    </fieldset>

    if (Model.SavingProduct.AccountType == "Saving")
    {
        <fieldset class="fieldset-custom">
            <legend>
                @Globals_ProductConfig.ThirdPartySavingWithdrawalFormCharge
                <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.SetTheFormChargeForWithdrawaingFromSavingAccount"></i>
            </legend>
            <div class="row">
                <div class="col-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.SavingProduct.WithdrawalFormSavingFormFeeFor3PP, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SavingProduct.WithdrawalFormSavingFormFeeFor3PP, "", new { @class = "text-danger" })
                        <label>@Globals_ProductConfig.FormCharge</label>
                    </div>
                </div>
            </div>
        </fieldset>
    }

    <fieldset class="fieldset-custom">
        <legend>
            @Globals_ProductConfig.ThirdPartyApplicationControl
            <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.ControlSettingsForThirdPartyApplicationAccess"></i>
        </legend>
        <div class="row">
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.ActivateFor3PPApp, new { @class = "form-check-input" })
                    <label class="form-check-label" for="ActivateFor3PPApp">
                        @Globals_ProductConfig.CheckToActivateThisProductFor3PPApp
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.EnableThisOptionToActivateTheProductForThirdPartyApplications"></i>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPeformTransfer3PP, new { @class = "form-check-input" })
                    <label class="form-check-label" for="CanPeformTransfer3PP">
                        @Globals_ProductConfig.PerformTransfer
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.AllowTransferOperationsViaThirdPartyApplications"></i>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPeformCashOut3PP, new { @class = "form-check-input" })
                    <label class="form-check-label" for="CanPeformCashOut3PP">
                        @Globals_ProductConfig.PerformCashout
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.EnableCashOutTransactionsViaThirdPartyApplications"></i>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPeformCashin3PP, new { @class = "form-check-input" })
                    <label class="form-check-label" for="CanPeformCashin3PP">
                        @Globals_ProductConfig.PerformCashin
                        <i class="bi bi-info-circle-fill" data-bs-toggle="tooltip" title="@Globals_ProductConfig.EnableCashInTransactionsViaThirdPartyApplications"></i>
                    </label>
                </div>
            </div>
        </div>
    </fieldset>

    <div class="mt-4">
        @if (Model.SavingProduct.Id == null)
        {
            <button type="submit" class="btn btn-primary me-2">@Globals_ProductConfig.Save</button>
            <input type="hidden" name="Action" value="insert" id="Action" />
        }
        else
        {
            <button type="submit" class="btn btn-primary me-2">@Globals_ProductConfig.Update</button>
            @Html.HiddenFor(m => m.SavingProduct.Id)
            <input type="hidden" name="Action" value="update" id="Action" />
        }
    </div>
}

