                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.SelectThisOptionToMakeTheAccountAccessibleOnlyToTellersForManagementPurposes"></i>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.AllowInterbranchDeposit, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_AllowInterbranchDeposit">
                        @Globals_ProductConfig.CheckToAllowInterBranchDeposit
                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.AllowDepositsToBeMadeIntoThisAccountFromDifferentBranches"></i>
