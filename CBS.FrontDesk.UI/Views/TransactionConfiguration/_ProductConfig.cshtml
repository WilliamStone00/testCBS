    <fieldset class="fieldset-custom">
        <legend>@Globals_ProductConfig.DefaultAccountOpeningConditions</legend>
        <div class="row gy-3">
            <!-- 🟢 Group: Moral Person -->
            <div class="col-12">
                <h6 class="text-primary border-bottom pb-1"><i class="bi bi-person-badge me-1"></i> @Globals_ProductConfig.MoralPerson</h6>
            </div>
            <!-- Minimum Opening Balance - Moral -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MinimumOpeningBalanceMoralPerson, new { @class = "form-control", type = "number", step = "0.01" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MinimumOpeningBalanceMoralPerson, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MinimumOpeningBalance</label>
                </div>
            </div>
            <!-- Required Opening Balance - Moral -->
            <div class="col-md-3">
                <div class="form-check mt-4 pt-2">
                    @Html.CheckBoxFor(m => m.SavingProduct.RequiredOpeningBalanceMoralPerson, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_RequiredOpeningBalanceMoralPerson">
                        @Globals_ProductConfig.RequiredOpening
                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.IsOpeningBalanceMandatoryForMoralPerson"></i>
                    </label>
                </div>
            </div>
            <!-- Installments - Moral -->
            <div class="col-md-3">
                <div class="form-check mt-4 pt-2">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPayInInstallmentMoralPerson, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_CanPayInInstallmentMoralPerson">
                        @Globals_ProductConfig.PayInInstallments
                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.AllowInstallmentPaymentForMoralPerson"></i>
                    </label>
                </div>
            </div>
            <!-- 🔵 Group: Physical Person -->
            <div class="col-12 mt-4">
                <h6 class="text-primary border-bottom pb-1"><i class="bi bi-person-lines-fill me-1"></i> @Globals_ProductConfig.PhysicalPerson</h6>
            </div>
            <!-- Minimum Opening Balance - Physical -->
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MinimumOpeningBalancePhysicalPerson, new { @class = "form-control", type = "number", step = "0.01" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MinimumOpeningBalancePhysicalPerson, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MinimumOpeningBalance</label>
                </div>
            </div>
            <!-- Required Opening Balance - Physical -->
            <div class="col-md-3">
                <div class="form-check mt-4 pt-2">
                    @Html.CheckBoxFor(m => m.SavingProduct.RequiredOpeningBalancePhysicalPerson, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_RequiredOpeningBalancePhysicalPerson">
                        @Globals_ProductConfig.RequiredOpening
                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.IsOpeningBalanceMandatoryForPhysicalPerson"></i>
                    </label>
                </div>
            </div>
            <!-- Installments - Physical -->
            <div class="col-md-3">
                <div class="form-check mt-4 pt-2">
                    @Html.CheckBoxFor(m => m.SavingProduct.CanPayInInstallmentPhysicalPerson, new { @class = "form-check-input" })
                    <label class="form-check-label" for="SavingProduct_CanPayInInstallmentPhysicalPerson">
                        @Globals_ProductConfig.PayInInstallments
                        <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="@Globals_ProductConfig.AllowInstallmentPaymentForPhysicalPerson"></i>
                    </label>
                </div>
            </div>
        </div>
    </fieldset>

    if (Model.SavingProduct.AccountType == "MemberShare")
    {
        <fieldset class="fieldset-custom mt-4">
            <legend>Daily Saver Minimum Share Opening Balances</legend>
            <div class="row gy-3">

                <!-- 🟢 Group: Moral Person -->
                <div class="col-12">
                    <h6 class="text-primary border-bottom pb-1">
                        <i class="bi bi-person-badge me-1"></i> Moral Person
                    </h6>
                </div>

                <!-- Daily Saver Shares - Moral Minimum -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.SavingProduct.MinDailySaverSharesOpeningBalanceMoral, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.SavingProduct.MinDailySaverSharesOpeningBalanceMoral, "", new { @class = "text-danger" })
                        <label>Minimum Daily Saver Shares Opening Balance</label>
                    </div>
                </div>

                <!-- 🔵 Group: Physical Person -->
                <div class="col-12 mt-4">
                    <h6 class="text-primary border-bottom pb-1">
                        <i class="bi bi-person-lines-fill me-1"></i> Physical Person
                    </h6>
                </div>

                <!-- Daily Saver Shares - Physical Minimum -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.SavingProduct.MinDailySaverSharesOpeningBalancePerson, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.SavingProduct.MinDailySaverSharesOpeningBalancePerson, "", new { @class = "text-danger" })
                        <label>Minimum Daily Saver Shares Opening Balance</label>
                    </div>
                </div>

            </div>
        </fieldset>

    }

