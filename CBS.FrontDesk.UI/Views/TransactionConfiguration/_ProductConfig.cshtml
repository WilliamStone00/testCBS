<script>
    $(function () {

        var $ddlGroup          = $('#AccountTypeGroupId');
        var $container         = $('#AccountTypeDefinitionsContainer');
        var $legend            = $('#AccountTypeDefinitionsLegend');
        var $hiddenAccountType = $('#SavingProduct_AccountType');

        var selectedDefinitionId    = '@(Model.SavingProduct.AccountTypeDefinitionId ?? string.Empty)';
        var selectedAccountTypeCode = '@(Model.SavingProduct.AccountType ?? string.Empty)';

        // Always find the wrapper fieldset around the container
        function getWrapper() {
            return $container.closest('fieldset');
        }

        function setVisible(hasData) {
            var $wrapper = getWrapper();
            if (!$wrapper.length) {
                console.warn('Definitions fieldset not found around AccountTypeDefinitionsContainer');
                return;
            }
            if (hasData) {
                $wrapper.show();
            } else {
                $wrapper.hide();
            }
        }

        // ─────────────────────────────────────────────
        // Tree rendering: parent nodes + child radios
        // ─────────────────────────────────────────────
        function renderDefinitions(defs) {
            console.log('renderDefinitions, count =', defs ? defs.length : 0);

            $container.empty();
            if ($hiddenAccountType.length) {
                $hiddenAccountType.val('');
            }

            if (!defs || !defs.length) {
                setVisible(false);
                return;
            }

            setVisible(true);

            // Normalize IDs & parent IDs
            defs.forEach(function (d) {
                d._id = d.id || d.Id;
                d._pid = d.parentId || d.ParentId || null;
            });

            // Map: id -> def
            var byId = {};
            defs.forEach(function (d) { byId[d._id] = d; });

            // Map: ParentId -> children[]
            var byParent = {};
            defs.forEach(function (d) {
                var pid = d._pid || null;
                if (!byParent[pid]) byParent[pid] = [];
                byParent[pid].push(d);
            });

            // Sort children of every parent
            Object.keys(byParent).forEach(function (key) {
                byParent[key].sort(function (a, b) {
                    var ao = (a.displayOrder || a.DisplayOrder || 0);
                    var bo = (b.displayOrder || b.DisplayOrder || 0);
                    if (ao !== bo) return ao - bo;

                    var an = (a.name || a.Name || '');
                    var bn = (b.name || b.Name || '');
                    return an.localeCompare(bn);
                });
            });

            // Top-level roots = definitions with no ParentId
            var roots = byParent[null] || byParent[undefined] || [];
            if (!roots.length) {
                // fallback: everything is "root"
                roots = defs;
            }

            function renderFolderForRoot(rootDef) {
                var rootId = rootDef._id;
                var rootName = rootDef.name || rootDef.Name;
                var rootCode = rootDef.code || rootDef.Code;

                var $folder = $('<div class="account-folder"></div>');

                // ── Folder header (click to collapse/expand) ───────────────
                var $header = $('<div class="account-folder-header"></div>');
                var $caret = $('<span class="account-folder-header-caret">▾</span>');
                var $icon = $('<span class="account-folder-header-icon"><i class="fa fa-folder-open"></i></span>');
                var $hName = $('<span class="account-folder-header-name"></span>').text(rootName);
                var $hCode = $('<span class="account-folder-header-code"></span>').text(rootCode ? ' (' + rootCode + ')' : '');

                $header.append($caret).append($icon).append($hName).append($hCode);
                $folder.append($header);

                var $list = $('<ul class="account-folder-list"></ul>');
                $folder.append($list);

                // 🔽 Toggle collapse on header click
                $header.on('click', function () {
                    $folder.toggleClass('collapsed');
                });

                // Numbering starts at 1 within each folder
                var counter = 1;

                function addNode(def, isChild) {
                    var id = def._id;
                    var name = def.name || def.Name;
                    var code = def.code || def.Code;

                    var $li = $('<li class="account-folder-node"></li>');
                    if (isChild) {
                        $li.addClass('account-folder-node-child');
                    }

                    var inputId = 'AccountTypeDefinition_' + id;

                    var $radio = $('<input>', {
                        type: 'radio',
                        'class': 'form-check-input',
                        name: 'SavingProduct.AccountTypeDefinitionId',
                        id: inputId,
                        value: id
                    });

                    // Pre-select logic (unchanged) ...
                    if (selectedDefinitionId && selectedDefinitionId === String(id)) {
                        $radio.prop('checked', true);
                        if ($hiddenAccountType.length && code) {
                            $hiddenAccountType.val(code);
                        }
                    } else if (!selectedDefinitionId && selectedAccountTypeCode && code === selectedAccountTypeCode) {
                        $radio.prop('checked', true);
                        if ($hiddenAccountType.length && code) {
                            $hiddenAccountType.val(code);
                        }
                    }

                    $radio.on('change', function () {
                        if ($hiddenAccountType.length) {
                            $hiddenAccountType.val(code || '');
                        }
                    });

                    // 👉 alignment grid (as we did before)
                    var $label = $('<label>', {
                        'class': 'account-folder-node-label',
                        'for': inputId
                    });

                    var $num = $('<span class="account-folder-node-number"></span>').text(counter + '.');
                    var $content = $('<span class="account-folder-node-content"></span>');
                    var $nameSpan = $('<span class="account-folder-node-name"></span>').text(name);
                    var $codeSpan = $('<span class="account-folder-node-code"></span>').text(code ? ' (' + code + ')' : '');

                    $content.append($radio).append($nameSpan).append($codeSpan);
                    $label.append($num).append($content);

                    $li.append($label);
                    $list.append($li);

                    counter++;
                }

                function renderSubtree(def, isChild) {
                    addNode(def, isChild);
                    var children = byParent[def._id] || [];
                    children.forEach(function (child) {
                        renderSubtree(child, true);
                    });
                }

                renderSubtree(rootDef, false);
                $container.append($folder);
            }

            // Render each root as its own folder
            roots.forEach(function (root) {
                renderFolderForRoot(root);
            });
        }

        // ─────────────────────────────────────────────
        // AJAX loader     (used by onchange + initial)
        // ─────────────────────────────────────────────
        function loadDefinitions(groupId) {
            console.log('loadDefinitions, groupId =', groupId);
            if (!groupId) {
                renderDefinitions([]);
                return;
            }

            $.getJSON('@Url.Action("GetAccountTypeDefinitionsByGroup", "TransactionConfiguration")',
                { groupId: groupId })
                .done(function (data) {
                    console.log('AJAX success, data =', data);
                    renderDefinitions(data || []);
                })
                .fail(function (xhr, status, err) {
                    console.error('Failed to load account definitions:', status || err);
                    renderDefinitions([]);
                });
        }

        // ✅ Global function used by the dropdown onchange
        window.onAccountTypeGroupChanged = function (select) {
            var gid = $(select).val() || '';
            loadDefinitions(gid);
        };

        // Initial state: hide section
        setVisible(false);

        // If a group is already selected in edit mode, load its definitions
        var initialGroupId = $ddlGroup.val() || '';
        console.log('initialGroupId =', initialGroupId);
        if (initialGroupId) {
            loadDefinitions(initialGroupId);
        }

    });
</script>

