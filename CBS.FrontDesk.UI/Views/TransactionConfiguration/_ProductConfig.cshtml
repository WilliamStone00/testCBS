@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
<style>
    .account-tree-container {
        padding: .5rem 1rem 1rem 0.75rem;
    }

    .account-folder {
        border: 1px solid #e0e0f0;
        border-radius: .75rem;
        padding: .35rem .75rem .55rem .75rem;
        margin-bottom: .45rem;
        background: #f9f9ff;
    }

    .account-folder-header {
        display: flex;
        align-items: center;
        font-weight: 600;
        margin-bottom: .15rem;
        cursor: default;
    }

    .account-folder-header-icon {
        margin-right: .35rem;
        color: #5a5ad1;
        font-size: 14px;
    }

    .account-folder-header-name {
        margin-right: .35rem;
    }

    .account-folder-header-code {
        font-size: .8rem;
        color: #6c757d;
    }

    .account-folder-list {
        list-style: none;
        margin: 0;
        padding-left: .2rem;
    }

    .account-folder-node {
        margin-bottom: .05rem;
    }

    .account-folder-node-label {
        display: flex;
        align-items: center;
        padding: 1px 4px;
        border-radius: 6px;
        cursor: pointer;
    }

        .account-folder-node-label:hover {
            background-color: #f5f5f9;
        }

    .account-folder-node-number {
        width: 1.8rem;
        font-size: .8rem;
        color: #6c757d;
    }

    .account-folder-node-label input[type="radio"] {
        margin-right: .35rem;
    }

    .account-folder-node-name {
        margin-right: .3rem;
    }

    .account-folder-node-code {
        font-size: .8rem;
        color: #6c757d;
    }

    /* Indent children */
    .account-folder-node-child .account-folder-node-label {
        margin-left: 1.5rem;
    }
</style>

@using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <fieldset class="fieldset-custom">
        <legend>@Globals_ProductConfig.OrdinaryAccount</legend>
        <input type="hidden" name="ServiceOption" value="savingproduct" id="ServiceOption" />
        <div class="row mt-2 gy-4">
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.Code, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.Code, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.ProductCode</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.Name, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.ProductName</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.SavingProduct.CurrencyId, new SelectList(ViewBag.Currencies, "Value", "Text"), @Globals_ProductConfig.SelectCurrency, new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.CurrencyId, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.Currency</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MinAmount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MinAmount, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MinimumAmount</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MaxAmount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MaxAmount, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MaximumAmount</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MinimumAccountBalanceMoralPerson, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MinimumAccountBalanceMoralPerson, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MinimumBalanceMoralPerson</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.SavingProduct.MinimumAccountBalancePhysicalPerson, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.MinimumAccountBalancePhysicalPerson, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.MinimumBalancePhysicalPerson</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.SavingProduct.InterestAccrualFrequency, new SelectList(ViewBag.Frequences, "Text", "Value"), @Globals_ProductConfig.SelectInterestCalculationFrequency, new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.InterestAccrualFrequency, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.InterestAccrualFrequency</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.SavingProduct.PostingFrequency, new SelectList(ViewBag.Frequences, "Text", "Value"), @Globals_ProductConfig.SelectAccount, new { @class = "form-control select2", @search = "true" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.PostingFrequency, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.InterestPostingFrequency</label>
                </div>
            </div>

            <div class="col-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.SavingProduct.AutoAddToMember, new { @class = "form-check-input" })
                    <label class="form-check-label" for="activeStatus">@Globals_ProductConfig.AddToMembersDefaultOrdinaryAccount</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextAreaFor(m => m.SavingProduct.Description, new { @class = "form-control", @style = "height: 75px;" })
                    @Html.ValidationMessageFor(m => m.SavingProduct.Description, "", new { @class = "text-danger" })
                    <label>@Globals_ProductConfig.Description</label>
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset class="fieldset-custom">
        <legend>@Globals_ProductConfig.ProductCategory</legend>
        <div class="row">
            <div class="col-12">
                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.SavingProduct.ProductCategory, "Teller", new { id = "teller", @class = "form-check-input" })
                    <label class="form-check-label" for="teller">@Globals_ProductConfig.Teller</label>
                </div>
                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.SavingProduct.ProductCategory, "OrdinaryAccount", new { id = "ordinaryAccount", @class = "form-check-input" })
                    <label class="form-check-label" for="ordinaryAccount">@Globals_ProductConfig.OrdinaryAccount</label>
                </div>
                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.SavingProduct.ProductCategory, "Remittance", new { id = "remittance", @class = "form-check-input" })
                    <label class="form-check-label" for="remittance">@Globals_ProductConfig.Remittance</label>
                </div>
            </div>
        </div>
        <!-- Validation Message -->
        <div class="text-danger">
            @Html.ValidationMessageFor(m => m.SavingProduct.ProductCategory)
        </div>
    </fieldset>
    @* 🔄 Dynamic Account Type Group + Definitions *@
    <fieldset class="fieldset-custom">
        <legend>Account type group & definition</legend>

        <div class="row gy-1">
            <!-- 1️⃣ Group selector -->
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @* Group comes from AccountTypeGroup table *@
                    @Html.DropDownList(
                    "AccountTypeGroupId",
                    new SelectList((IEnumerable<dynamic>)ViewBag.AccountTypeGroups, "Id", "Name"),
                    "-- Select account type group --",
                    new
                    {
                        @class = "form-select select2",
                        id = "AccountTypeGroupId",
                        @search = "true",
                        onchange = "onAccountTypeGroupChanged(this)"   // ✅ here
                    })

                    <label>Account type group</label>
                </div>
            </div>

            <!-- Hidden backing field for old AccountType string -->
            @Html.HiddenFor(m => m.SavingProduct.AccountType)

            <div class="col-md-12">
                <fieldset class="fieldset-custom mt-1"
                          id="AccountTypeDefinitionsWrapper" style="display:none;">
                    <legend id="AccountTypeDefinitionsLegend">Account definitions</legend>
                    <div id="AccountTypeDefinitionsContainer" class="row">
                        @* Radios will be rendered here by JavaScript *@
                    </div>
                    <div class="text-danger">
                        @Html.ValidationMessageFor(m => m.SavingProduct.AccountTypeDefinitionId)
                    </div>
                </fieldset>
            </div>


        </div>
    </fieldset>
