            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        Harmonize Charges Mapping to @Model.SavingProduct.Name
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">

                    <div class="accordion-body">
                        @using (Html.BeginForm("Create", "SavingProductFee", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostSavingProductFeeMapping(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Charges Mapping</legend>
                                <div class="row g-4">
                                    @Html.HiddenFor(model => model.SavingProductFee.SavingProductId)
                                    <input type="hidden" name="option" value="addaccount" id="option" />

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                            <label>Account Name</label>
                                            <small class="form-text text-muted">The name of the saving product being mapped.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProductFee.FeeType,
                                                new SelectList(ViewBag.FeeType, "Value", "Text"), "---Select Fee Type---",
                                                new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProductFee.FeeType, "", new { @class = "text-danger" })
                                            <label>Operation Type</label>
                                            <small class="form-text text-muted">Choose the type of operation for this charge mapping.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProductFee.FeeId,
                                                new SelectList(ViewBag.Fees, "Id", "Name"), "---Select Fees---",
                                                new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProductFee.FeeId, "", new { @class = "text-danger" })
                                            <label>Select Fee Type</label>
                                            <small class="form-text text-muted">Select the fee type to map to this product.</small>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="mb-2">Fee Policy Type</label>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Local", new { @class = "form-check-input", id = "localOption" })
                                            <label class="form-check-label" for="localOption">Local</label>
                                            <small class="form-text text-muted">Applicable for charges within the same branch.</small>
                                        </div>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Inter_Branch", new { @class = "form-check-input", id = "interBranchOption" })
                                            <label class="form-check-label" for="interBranchOption">Inter-Branch</label>
                                            <small class="form-text text-muted">Applicable for inter-branch transactions.</small>
                                        </div>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Self", new { @class = "form-check-input", id = "self" })
                                            <label class="form-check-label" for="self">Self-Transfer</label>
                                            <small class="form-text text-muted">For self-to-self transfers.</small>
                                        </div>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Incoming_International", new { @class = "form-check-input", id = "incoming_International" })
                                            <label class="form-check-label" for="incoming_International">Incoming International</label>
                                            <small class="form-text text-muted">For charges on incoming international transfers.</small>
                                        </div>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Outgoing_International", new { @class = "form-check-input", id = "outgoing_International" })
                                            <label class="form-check-label" for="outgoing_International">Outgoing International</label>
                                            <small class="form-text text-muted">For charges on outgoing international transfers.</small>
                                        </div>
                                    </div>

                                    <input type="hidden" value="@Model.SavingProduct.Id" id="savingproductid" />
                                </div>

                                <div class="mt-4">
                                    @Html.HiddenFor(m => m.SavingProductFee.Id)
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                    <input type="hidden" name="ServiceOption" value="fee_mapping" id="ServiceOption" />
                                    <button type="submit" class="btn btn-primary">Map Selected Charge Type</button>
                                </div>
                            </fieldset>
                        }
                    </div>

                    <div class="accordion-body">
                        <div class="demo-inline-spacing text-end mb-3">
                            <a type="button" onclick="LoadProductFeeMapping('@Model.SavingProduct.Id')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                            </a>
                        </div>
                        <fieldset class="fieldset-custom">
                            <legend>Charges Mapping</legend>
                            <div id="datalistingview_feeMapping"></div>
                        </fieldset>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

