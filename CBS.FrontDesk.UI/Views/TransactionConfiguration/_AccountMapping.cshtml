@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Mapping ordinary accounts to the account chart.
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>Account Mappings</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Code, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Code, "", new { @class = "text-danger" })
                                                <label>Product Code</label>
                                            </div>
                                        </div>
                                        <div class="col-md-9">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Name, "", new { @class = "text-danger" })
                                                <label>Product name</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.SavingProduct.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Description, "", new { @class = "text-danger" })
                                                <label>Description</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdPricipalAccount, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdPricipalAccount, "", new { @class = "text-danger" })
                                                <label>Capital (This is an account that holds the sum of the product.)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdInterestAccount, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestAccount, "", new { @class = "text-danger" })
                                                <label>Interest account (This is an account that receive all interest generated from products)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount, "", new { @class = "text-danger" })
                                                <label>Interest expense account (This is an account that receive all interest paid out to other accounts)</label>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdCommissionAccount, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdCommissionAccount, "", new { @class = "text-danger" })
                                                <label>Commision account. (This account holds commissions generated from operations)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdLiassonAccount, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdLiassonAccount, "", new { @class = "text-danger" })
                                                <label>Liaison account. (This account is used as transit for inter-operations between branches)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdWithrawalFee, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdWithrawalFee, "", new { @class = "text-danger" })
                                                <label>Withdrawal fee (This is an account that receive all withdrawal fee generated from this saving products)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.SavingProduct.ChartOfAccountIdTransferFee, new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---", new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdTransferFee, "", new { @class = "text-danger" })
                                                <label>Transfer fee (This is an account that receive all transfer fee generated from this saving products)</label>
                                            </div>
                                        </div>

                                    </div>
                                </fieldset>
                                <div class="mt-4">
                                    @if (Model.SavingProduct.Id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    { <button type="submit" class="btn btn-primary me-2">Map Accounts</button>
                                        @Html.HiddenFor(m => m.SavingProduct.Id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }

                                </div>
                            }

                        </div>
                    </div>
                </div>


            </div>

            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod4">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod4"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod4">
                        Mapping withdrawal form charges of @Model.SavingProduct.Name to chart of account events
                    </button>
                </h2>
                <div id="collapsePaymentMethod4"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod4"
                     data-bs-parent="#collapsibleSection">

                    <div class="accordion-body">
                        @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Form Charges Mapping</legend>
                                <div class="row g-4">
                                    @Html.HiddenFor(model => model.SavingProduct.Id)
                                    <input type="hidden" name="option" value="mapformeventcharges" id="option" />
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                            <label>Account name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProduct.EventCodeMoralPersonWithdrawalFormFee, new SelectList(ViewBag.EventCodes, "Text", "Value"), "---Select event code---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProduct.EventCodeMoralPersonWithdrawalFormFee, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Form fee moral person</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProduct.EventCodePhysicalPersonWithdrawalFormFee, new SelectList(ViewBag.EventCodes, "Text", "Value"), "---Select event code---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProduct.EventCodePhysicalPersonWithdrawalFormFee, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Form fee physical person</label>
                                        </div>
                                    </div>
                                    <input type="hidden" value="@Model.SavingProduct.Id" id="savingproductid" />
                                </div>
                                <div class="mt-4">
                                    @Html.HiddenFor(m => m.SavingProductFee.Id)
                                    <input type="hidden" name="Action" value="update" id="Action" />
                                    <input type="hidden" name="ServiceOption" value="mapformeventcharges" id="ServiceOption" />
                                    <button type="submit" class="btn btn-primary">Map Events</button>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>

            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        Harmonize charges mapping to @Model.SavingProduct.Name
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">

                    <div class="accordion-body">
                        @using (Html.BeginForm("Create", "SavingProductFee", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostSavingProductFeeMapping(this);" }))
                        {
                            <fieldset class="fieldset-custom">
                                <legend>Charges Mapping</legend>
                                <div class="row g-4">
                                    @Html.HiddenFor(model => model.SavingProductFee.SavingProductId)
                                    <input type="hidden" name="option" value="addaccount" id="option" />
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                            <label>Account name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProductFee.FeeType, new SelectList(ViewBag.FeeType, "Text", "Value"), "---Select Fee Type---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProductFee.FeeType, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Operation type</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SavingProductFee.FeeId, new SelectList(ViewBag.Fees, "Id", "Name"), "---Select Fees---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.SavingProductFee.FeeId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">Select fee type</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Local", new { @class = "form-check-input", id = "localOption" })
                                            <label class="form-check-label" for="localOption">Local</label>
                                        </div>
                                        <div class="form-check">
                                            @Html.RadioButtonFor(m => m.SavingProductFee.FeePolicyType, "Inter_Branch", new { @class = "form-check-input", id = "interBranchOption" })
                                            <label class="form-check-label" for="interBranchOption">Inter-Branch</label>
                                        </div>
                                    </div>

                                    <input type="hidden" value="@Model.SavingProduct.Id" id="savingproductid" />
                                </div>
                                <div class="mt-4">
                                    @Html.HiddenFor(m => m.SavingProductFee.Id)
                                    <input type="hidden" name="Action" value="insert" id="Action" />
                                    <input type="hidden" name="ServiceOption" value="fee_mapping" id="ServiceOption" />
                                    <button type="submit" class="btn btn-primary">Map selected charge type</button>
                                </div>
                            </fieldset>
                        }
                    </div>
                    <div class="accordion-body">
                        <div class="demo-inline-spacing text-end mb-3">
                            <!-- Added mb-3 for margin bottom -->
                            <a type="button" onclick="LoadProductFeeMapping('@Model.SavingProduct.Id')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                            </a>
                        </div>
                        <fieldset class="fieldset-custom">
                            <legend>Charges Mapping</legend>
                            <div id="datalistingview_feeMapping">

                            </div>
                        </fieldset>
                    </div>


                </div>
            </div>

        </div>
    </div>
</div>

