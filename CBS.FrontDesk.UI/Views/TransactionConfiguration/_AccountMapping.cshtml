                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalsAccountMapping.MapAccounts</button>
                                        @Html.HiddenFor(m => m.SavingProduct.Id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            }

           
