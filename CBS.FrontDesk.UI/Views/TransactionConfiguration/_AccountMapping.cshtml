                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCMoneyTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.CamCCULShareTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsForCamCCULShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCMoneyTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCMoneyTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.HeadOfficeTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsForHeadOfficeShare @Model.SavingProduct.Name.
                                                </small>
