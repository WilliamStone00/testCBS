                                        </div>
                                    </div>
                                </fieldset>

                                <div class="mt-4">
                                    @if (Model.SavingProduct.Id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalsAccountMapping.Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">@GlobalsAccountMapping.MapAccounts</button>
                                        @Html.HiddenFor(m => m.SavingProduct.Id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }
                                </div>
                            }

                        </div>
                    </div>
                </div>


            </div>

            @if (Model.SavingProduct.AccountType.Contains("Salary"))
            {
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod4x">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod4x"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod4x">
                            @GlobalsAccountMapping.MappingCivilServantAndPrivateInstitutionForOrdinaryAccount @Model.SavingProduct.Name @GlobalsAccountMapping.ToTheMainChartOfAccounts
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod4x"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod4x"
                         data-bs-parent="#collapsibleSection">

                        <div class="accordion-body">
                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalsAccountMapping.AccountMappings</legend>
                                    <input type="hidden" name="ServiceOption" value="salaryMapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">

                                        <!-- Step 1: Receiving Money from UBC (Civil Servants) -->
                                        <div class="col-md-12">
                                            <h5>@GlobalsAccountMapping.Step1ReceivingMoneyFromUBCCivilServants</h5>
                                            <p>@GlobalsAccountMapping.ThisStepInvolvesDebitingTheUBCCurrentAccountAndCreditingTheCivilServantsSalaryPayableAccount.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalarySourceChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalarySourceChartofAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.CivilServantsSalarySourceAccount</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalaryDestinationPayableChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalaryDestinationPayableChartofAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.CivilServantsSalaryDestinationPayableAccount</label>
                                            </div>
                                        </div>

                                        <!-- Step 4: Disbursement of Funds (Civil Servants) -->
                                        <div class="col-md-12">
                                            <h5>@GlobalsAccountMapping.Step4DisbursementOfFundsIntoSalaryAccountsCivilServants</h5>
                                            <p>@GlobalsAccountMapping.InThisStepTheCivilServantsSalaryPayableAccountIsDebitedAndTheMembersSalaryAccountsAreCredited.</p>
                                        </div>
