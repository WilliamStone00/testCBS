                                                    new { @class = "text-danger" }
                                                )
                                                <label>CamCCUL Share (Cash In Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-in commissions for CamCCUL share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashOutCommission,
