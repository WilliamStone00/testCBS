                        </button>
                    </h2>
                    <div id="collapsePaymentMethod4x"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod4x"
                         data-bs-parent="#collapsibleSection">

                        <div class="accordion-body">
                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>Account Mappings</legend>
                                    <input type="hidden" name="ServiceOption" value="salaryMapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">



                                        <!-- Step 1: Receiving Money from UBC (Civil Servants) -->
                                        <div class="col-md-12">
                                            <h5>Step 1: Receiving Money from UBC (Civil Servants)</h5>
                                            <p>This step involves debiting the UBC current account and crediting the Civil Servants Salary Payable Account.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalarySourceChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalarySourceChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Civil Servants Salary Source Account</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalaryDestinationPayableChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalaryDestinationPayableChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Civil Servants Salary Destination Payable Account</label>
                                            </div>
                                        </div>

                                        <!-- Step 4: Disbursement of Funds (Civil Servants) -->
                                        <div class="col-md-12">
                                            <h5>Step 4: Disbursement of Funds into Salary Accounts (Civil Servants)</h5>
                                            <p>In this step, the Civil Servants Salary Payable Account is debited, and the members' salary accounts are credited.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalarySourceSalaryChartofaccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalarySourceSalaryChartofaccountId, "", new { @class = "text-danger" })
                                                <label>Civil Servants Salary Source Salary Account</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.CivilServantsSalaryDestinationSalaryProductChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.CivilServantsSalaryDestinationSalaryProductChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Civil Servants Salary Destination Salary Product Account</label>
                                            </div>
                                        </div>

