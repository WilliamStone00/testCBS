                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.EventCodeAdvanceOfSalaryFormFee,
                                                    new SelectList(ViewBag.EventCodes, "Value", "Text"),
