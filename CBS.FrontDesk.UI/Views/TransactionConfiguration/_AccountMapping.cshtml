@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Mapping ordinary accounts to the account chart.
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>Account Mappings</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Code, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Code, "", new { @class = "text-danger" })
                                                <label>Product Code</label>
                                                <small class="form-text text-muted">The unique code assigned to @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-9">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Name, "", new { @class = "text-danger" })
                                                <label>Product Name</label>
                                                <small class="form-text text-muted">The name of the product.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.SavingProduct.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Description, "", new { @class = "text-danger" })
                                                <label>Description</label>
                                                <small class="form-text text-muted">A brief description @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdPricipalAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdPricipalAccount, "", new { @class = "text-danger" })
                                                <label>Principal Account</label>
                                                <small class="form-text text-muted">Account used to hold the principal amount for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdInterestAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestAccount, "", new { @class = "text-danger" })
                                                <label>Interest Account</label>
                                                <small class="form-text text-muted">Tracks interest income generated from @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount, "", new { @class = "text-danger" })
                                                <label>Interest Expense Account</label>
                                                <small class="form-text text-muted">Tracks interest expenses paid to @Model.SavingProduct.Name..</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdCashInCommission, "", new { @class = "text-danger" })
                                                <label>Cash-In Commission Account</label>
                                                <small class="form-text text-muted">Tracks commissions from cash-in operations for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdCashOutCommission, "", new { @class = "text-danger" })
                                                <label>Cash-Out Commission Account</label>
                                                <small class="form-text text-muted">Tracks commissions from cash-out operations for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdLiassonAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdLiassonAccount, "", new { @class = "text-danger" })
                                                <label>Liaison Account</label>
                                                <small class="form-text text-muted">Used as a transit account for inter-branch transactions for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        @*<div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdWithrawalFee,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdWithrawalFee, "", new { @class = "text-danger" })
                                                <label>Withdrawal Fee Account</label>
                                                <small class="form-text text-muted">Tracks fees generated from withdrawal operations for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>*@
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdTransferFee,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdTransferFee, "", new { @class = "text-danger" })
                                                <label>Transfer commision Account</label>
                                                <small class="form-text text-muted">Tracks commision generated from transfer operations for @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                                <fieldset class="fieldset-custom">
                                    <legend>Partner sharing GL Mapping on @Model.SavingProduct.Name.</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashInCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>Head Office Share (Cash In Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-in commissions at the head office on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
