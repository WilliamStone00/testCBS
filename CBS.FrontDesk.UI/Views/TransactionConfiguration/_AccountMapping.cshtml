                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.SuspenseChartOfAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.SuspenseAccount</label>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                                <div class="mt-4">
                                    @if (Model.SavingProduct.Id == null)
