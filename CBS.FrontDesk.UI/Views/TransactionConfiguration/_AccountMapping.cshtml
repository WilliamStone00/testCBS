                                                    new { @class = "text-danger" }
                                                )
                                                <label>Flux and PTM Share (Transfer Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking transfer commissions for Flux and PTM share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
