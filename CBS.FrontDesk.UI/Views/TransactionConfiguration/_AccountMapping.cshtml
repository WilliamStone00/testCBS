@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration
@using Resources
<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @GlobalsAccountMapping.MappingOrdinaryAccountsToTheAccountChart.
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @using (Html.BeginForm("AddOrUpdate", "TransactionConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                            {
                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalsAccountMapping.AccountMappings</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Code, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Code, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.ProductCode</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TheUniqueCodeAssignedTo @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-9">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Name, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.ProductName</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TheNameOfTheProduct.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextAreaFor(m => m.SavingProduct.Description, new { @class = "form-control", @style = "height: 75px;", @readonly = true })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.Description, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.Description</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.ABriefDescription @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdPricipalAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdPricipalAccount, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.PrincipalAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.AccountUsedToHoldThePrincipalAmountFor @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdInterestAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestAccount, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.InterestAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TracksInterestIncomeGeneratedFrom @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdInterestExpenseAccount, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.InterestExpenseAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TracksInterestExpensesPaidTo @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdCashInCommission, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.CashInCommissionAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TracksCommissionsFromCashInOperationsFor @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdCashOutCommission, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.CashOutCommissionAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TracksCommissionsFromCashOutOperationsFor @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdLiassonAccount,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdLiassonAccount, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.LiaisonAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.UsedAsATransitAccountForInterBranchTransactionsFor @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdTransferFee,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.ChartOfAccountIdTransferFee, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.TransferCommissionAccount</label>
                                                <small class="form-text text-muted">@GlobalsAccountMapping.TracksCommissionGeneratedFromTransferOperationsFor @Model.SavingProduct.Name.</small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.TransitChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "Select an account",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(m => m.SavingProduct.TransitChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Transit Account (Local Use)</label>
                                                <small class="form-text text-muted">
                                                    This account is used to temporarily hold internal funds during local processing steps such as teller handovers, internal settlements, or pending adjustments within the same branch.
                                                </small>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.SuspenseChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "Select an account",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(m => m.SavingProduct.SuspenseChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Suspense Account (Local Use)</label>
                                                <small class="form-text text-muted">
                                                    This account is used to hold unidentified or unbalanced amounts arising from local operations—such as data entry errors, pending approvals, or system mismatches—until they are properly resolved.
                                                </small>
                                            </div>
                                        </div>

                                    </div>
                                </fieldset>

                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalsAccountMapping.PartnerSharingGLMapping @Model.SavingProduct.Name.</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashInCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.HeadOfficeShareCashInCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashInCommissionsAtTheHeadOffice @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareCashOutCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.HeadOfficeShareCashOutCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashOutCommissionsAtTheHeadOffice @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdHeadOfficeShareTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.HeadOfficeShareTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsAtTheHeadOffice @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashInCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.FluxAndPTMShareCashInCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashInCommissionsForFluxAndPTMShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashOutCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.FluxAndPTMShareCashOutCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashOutCommissionsForFluxAndPTMShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.FluxAndPTMShareTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsForFluxAndPTMShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashInCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.CamCCULShareCashInCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashInCommissionsForCamCCULShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashOutCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.CamCCULShareCashOutCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingCashOutCommissionsForCamCCULShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.CamCCULShareTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsForCamCCULShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                    

                                </fieldset>

                                <fieldset class="fieldset-custom">
                                    <legend>@GlobalsAccountMapping.CMoneySharingGLMapping @Model.SavingProduct.Name.</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCMoneyTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCMoneyTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>@GlobalsAccountMapping.FluxAndPTMShareTransferCommission</label>
                                                <small class="form-text text-muted">
                                                    @GlobalsAccountMapping.SelectTheAccountForTrackingTransferCommissionsForFluxAndPTMShare @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCMoneyTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
