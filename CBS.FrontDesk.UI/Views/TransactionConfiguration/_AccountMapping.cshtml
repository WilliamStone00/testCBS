                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.SavingProduct.Name, new { @class = "form-control", @readonly = true })
                                                <label>Account Name</label>
                                                <small class="form-text text-muted">The name of the saving product for which charges are being mapped.</small>
