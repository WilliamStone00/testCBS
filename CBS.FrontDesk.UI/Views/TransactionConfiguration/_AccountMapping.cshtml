                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.PrivateInstitutionSalaryDestinationPayableChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionSalaryDestinationPayableChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Private Institutions Salary Destination Payable Account</label>
                                            </div>
                                        </div>

                                        <!-- Step 4: Disbursement of Funds (Private Institutions) -->
                                        <div class="col-md-12">
                                            <h5>Step 4: Disbursement of Funds into Salary Accounts (Private Institutions)</h5>
                                            <p>In this step, the Private Institutions Salary Payable Account is debited, and the members' salary accounts are credited.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.PrivateInstitutionSalarySourceSalaryChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionSalarySourceSalaryChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Private Institutions Salary Source Salary Account</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.PrivateInstitutionDestinationSalaryProductChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionDestinationSalaryProductChartofAccountId, "", new { @class = "text-danger" })
                                                <label>Private Institutions Salary Destination Salary Product Account</label>
                                            </div>
                                        </div>
                                        <!-- Shared Suspense Account -->
                                        <div class="col-md-12">
                                            <h5>Suspense Account for Salary Processing</h5>
                                            <p class="text-muted">
                                                The Suspense Account is used to temporarily hold salaries for <strong>unidentified salary earners</strong> from the list of salary disbursements provided by the state or private institutions.
                                                This account ensures that funds are not misplaced while awaiting proper identification and allocation to the correct recipients.
                                            </p>
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.SuspenseChartOfAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), "---Select Suspense Account---",
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.SuspenseChartOfAccountId, "", new { @class = "text-danger" })
                                                <label>Suspense Account</label>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                                <div class="mt-4">
                                    @if (Model.SavingProduct.Id == null)
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Save</button>
                                        <input type="hidden" name="Action" value="insert" id="Action" />
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary me-2">Map Accounts</button>
                                        @Html.HiddenFor(m => m.SavingProduct.Id)
                                        <input type="hidden" name="Action" value="update" id="Action" />
                                    }
                                </div>
                            }

                        </div>
                    </div>
                </div>

            }

           
            @if (Model.SavingProduct.AccountType=="Saving")
