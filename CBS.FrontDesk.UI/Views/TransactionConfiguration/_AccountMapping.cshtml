                                                    m => m.SavingProduct.PrivateInstitutionSalaryDestinationPayableChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionSalaryDestinationPayableChartofAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.PrivateInstitutionsSalaryDestinationPayableAccount</label>
                                            </div>
                                        </div>

                                        <!-- Step 4: Disbursement of Funds (Private Institutions) -->
                                        <div class="col-md-12">
                                            <h5>@GlobalsAccountMapping.Step4DisbursementOfFundsIntoSalaryAccountsPrivateInstitutions</h5>
                                            <p>@GlobalsAccountMapping.InThisStepThePrivateInstitutionsSalaryPayableAccountIsDebitedAndTheMembersSalaryAccountsAreCredited.</p>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.PrivateInstitutionSalarySourceSalaryChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionSalarySourceSalaryChartofAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.PrivateInstitutionsSalarySourceSalaryAccount</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.PrivateInstitutionDestinationSalaryProductChartofAccountId,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"), @GlobalsAccountMapping.SelectAnAccount,
                                                    new { @class = "form-control select2", @search = "true" })
                                                @Html.ValidationMessageFor(m => m.SavingProduct.PrivateInstitutionDestinationSalaryProductChartofAccountId, "", new { @class = "text-danger" })
                                                <label>@GlobalsAccountMapping.PrivateInstitutionsSalaryDestinationSalaryProductAccount</label>
                                            </div>
                                        </div>

                                        <!-- Shared Suspense Account -->
                                        <div class="col-md-12">
                                            <h5>@GlobalsAccountMapping.SuspenseAccountForSalaryProcessing</h5>
                                            <p class="text-muted">
                                                @GlobalsAccountMapping.TheSuspenseAccountIsUsedToTemporarilyHoldSalariesForUnidentifiedSalaryEarnersFromTheListOfSalaryDisbursementsProvidedByTheStateOrPrivateInstitutions.
