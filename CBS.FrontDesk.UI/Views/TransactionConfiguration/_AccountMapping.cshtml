                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-in commissions for Flux and PTM share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCashOutCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>Flux and PTM Share (Cash Out Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-out commissions for Flux and PTM share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>Flux and PTM Share (Transfer Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking transfer commissions for Flux and PTM share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashInCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashInCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>CamCCUL Share (Cash In Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-in commissions for CamCCUL share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashOutCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCashOutCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>CamCCUL Share (Cash Out Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking cash-out commissions for CamCCUL share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>CamCCUL Share (Transfer Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking transfer commissions for CamCCUL share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                                <fieldset class="fieldset-custom">
                                    <legend>CMONEY sharing GL Mapping on @Model.SavingProduct.Name.</legend>
                                    <input type="hidden" name="ServiceOption" value="accountmapping" id="ServiceOption" />
                                    <div class="row mt-2 gy-4">
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCMoneyTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdFluxAndPTMShareCMoneyTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>Flux and PTM Share (Transfer Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking transfer commissions for Flux and PTM share on @Model.SavingProduct.Name.
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCMoneyTransferCommission,
                                                    new SelectList(ViewBag.chartOfAccounts, "Value", "Text"),
                                                    "---Select an account---",
                                                    new { @class = "form-control select2", @search = "true" }
                                                )
                                                @Html.ValidationMessageFor(
                                                    m => m.SavingProduct.ChartOfAccountIdCamCCULShareCMoneyTransferCommission, "",
                                                    new { @class = "text-danger" }
                                                )
                                                <label>CamCCUL Share (Transfer Commission)</label>
                                                <small class="form-text text-muted">
                                                    Select the account for tracking transfer commissions for CamCCUL share on @Model.SavingProduct.Name.
                                                </small>
