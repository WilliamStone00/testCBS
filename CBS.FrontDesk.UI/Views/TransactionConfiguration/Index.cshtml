@using Resources
@{
    ViewBag.Title = GlobalOrdinaryAccounts.OrdinaryAccountsManagement;
}
@using CBS.FrontDesk.UI.Helper
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card">
            <!-- Card Header -->
            <div class="card-header text-center">
                <h4 class="card-title text-primary">@GlobalOrdinaryAccounts.OrdinaryAccountManagement</h4>
                <p class="card-text text-muted">
                    @GlobalOrdinaryAccounts.OrdinaryAccountManagementDescription
                </p>
            </div>

            <!-- Accordion -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between align-items-center"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cog me-2"></i>
                            @GlobalOrdinaryAccounts.OrdinaryAccountsManagement
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <!-- Main View Change -->
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <!-- Actions Section -->
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="text-success">Actions</h5>
                                                <div class="btn-group">
                                                    <!-- View List Button -->
                                                    <a type="button"
                                                       onclick="LoadDataGen('TransactionConfiguration', 'myDataTable_product', '_ProductData', 0, 'datalistingview', null, 'savingproduct', 'list')"
                                                       class="btn btn-default btn-sm"
                                                       data-bs-toggle="tooltip"
                                                       title=" @GlobalOrdinaryAccounts.ViewListDescription">
                                                        <i class="mdi mdi-view-list mdi-18px"></i> @GlobalOrdinaryAccounts.ViewList
                                                    </a>
                                                    <!-- Add New Button -->
                                                    <a type="button"
                                                       onclick="AddORUpdateGen(null, 'datalistingview', '_ProductConfig', 'new', 'TransactionConfiguration', 'savingproduct')"
                                                       class="btn btn-default btn-sm"
                                                       data-bs-toggle="tooltip"
                                                       title="@GlobalOrdinaryAccounts.AddNewDescription">
                                                        <i class="mdi mdi-plus mdi-18px"></i> @GlobalOrdinaryAccounts.AddNew
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Data Listing View -->
                                    <div id="datalistingview">
                                        @Html.Partial("_ProductData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/DropDownLoader.js"></script>
    <script>
    (function () {
        var accountTypeGroups = @Html.Raw(JsonMVC.Serialize(ViewBag.AccountTypeGroups ?? new List<object>()));
        var accountTypeDefinitions = [];

        var selectedDefinitionId = '@(Model.SavingProduct.AccountTypeDefinitionId ?? string.Empty)';
        var selectedAccountTypeCode = '@(Model.SavingProduct.AccountType ?? string.Empty)';

        var ddlGroup = document.getElementById('AccountTypeGroupId');
        var definitionsContainer = document.getElementById('AccountTypeDefinitionsContainer');
        var definitionsLegend = document.getElementById('AccountTypeDefinitionsLegend');
        var definitionsWrapper = document.getElementById('AccountTypeDefinitionsWrapper');
        var hiddenAccountType = document.getElementById('SavingProduct_AccountType');

        // 🔹 helper to hide/show the whole red area
        function setDefinitionsVisible(hasData) {
            if (!definitionsWrapper) return;
            definitionsWrapper.style.display = hasData ? 'block' : 'none';
        }

        // hide by default on page load
        setDefinitionsVisible(false);

        function loadDefinitionsForGroup(groupId, callback) {
            if (!definitionsContainer) return;

            if (!groupId) {
                accountTypeDefinitions = [];
                renderDefinitionsForGroup('');
                if (typeof callback === 'function') callback();
                return;
            }

            $.getJSON('@Url.Action("GetAccountTypeDefinitionsByGroup", "TransactionConfiguration")',
                { groupId: groupId })
                .done(function (data) {
                    accountTypeDefinitions = data || [];
                    renderDefinitionsForGroup(groupId);
                    if (typeof callback === 'function') callback();
                })
                .fail(function (xhr, status, err) {
                    console.error('Failed to load account definitions:', status || err);
                    accountTypeDefinitions = [];
                    renderDefinitionsForGroup(groupId);
                    if (typeof callback === 'function') callback();
                });
        }

        function renderDefinitionsForGroup(groupId) {
            if (!definitionsContainer) return;

            definitionsContainer.innerHTML = '';
            if (hiddenAccountType) hiddenAccountType.value = '';

            // No group selected ⇒ hide section
            if (!groupId) {
                if (definitionsLegend)
                    definitionsLegend.textContent = 'Account definitions';

                setDefinitionsVisible(false);
                return;
            }

            var grp = (accountTypeGroups || []).find(function (g) {
                return g.id === groupId || g.Id === groupId;
            });

            if (grp && definitionsLegend) {
                definitionsLegend.textContent = (grp.name || grp.Name || 'Account definitions');
            }

            var defs = (accountTypeDefinitions || []).filter(function (d) {
                var isDeleted = d.isDeleted || d.IsDeleted;
                var isActive = (typeof d.isActive !== 'undefined' ? d.isActive : d.IsActive);
                return !isDeleted && (isActive === true || isActive === null || typeof isActive === 'undefined');
            });

            // No defs for this group ⇒ hide section
            if (!defs.length) {
                setDefinitionsVisible(false);
                return;
            }

            // We have data ⇒ show section
            setDefinitionsVisible(true);

            defs.sort(function (a, b) {
                var ao = (a.displayOrder || a.DisplayOrder || 0);
                var bo = (b.displayOrder || b.DisplayOrder || 0);
                return ao - bo;
            });

            defs.forEach(function (d) {
                var id = d.id || d.Id;
                var name = d.name || d.Name;
                var code = d.code || d.Code;

                var col = document.createElement('div');
                col.className = 'col-12 col-md-6 mb-1';

                var wrapper = document.createElement('div');
                wrapper.className = 'form-check';

                var radio = document.createElement('input');
                radio.type = 'radio';
                radio.className = 'form-check-input';
                radio.name = 'SavingProduct.AccountTypeDefinitionId';
                radio.id = 'AccountTypeDefinition_' + id;
                radio.value = id;

                if (selectedDefinitionId && selectedDefinitionId === String(id)) {
                    radio.checked = true;
                    if (hiddenAccountType && code) hiddenAccountType.value = code;
                } else if (!selectedDefinitionId && selectedAccountTypeCode && code === selectedAccountTypeCode) {
                    radio.checked = true;
                    if (hiddenAccountType && code) hiddenAccountType.value = code;
                }

                radio.addEventListener('change', function () {
                    if (hiddenAccountType) hiddenAccountType.value = code || '';
                });

                var label = document.createElement('label');
                label.className = 'form-check-label';
                label.setAttribute('for', radio.id);
                label.textContent = name + (code ? ' (' + code + ')' : '');

                wrapper.appendChild(radio);
                wrapper.appendChild(label);
                col.appendChild(wrapper);
                definitionsContainer.appendChild(col);
            });
        }

        if (ddlGroup) {
            ddlGroup.addEventListener('change', function () {
                var gid = ddlGroup.value || '';
                loadDefinitionsForGroup(gid);
            });

            var initialGroupId = ddlGroup.value || '';
            if (initialGroupId) {
                loadDefinitionsForGroup(initialGroupId);
            } else {
                renderDefinitionsForGroup('');
            }
        }

        var tooltipTriggerList = [].slice.call(
            document.querySelectorAll('[data-bs-toggle="tooltip"]')
        );
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

    })();
    </script>

}
