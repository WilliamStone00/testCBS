                                                    var localCashOutEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "CASHOUT");
                                                    var sumDebitCO = localCashOutEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                    var sumCreditCO = localCashOutEntri.Where(x => x.BookingDirection != "DEBIT").Sum(x => Convert.ToDouble(x.Amount));

                                                    <th>@sumDebitCO</th>
                                                    <th>@sumCreditCO</th>
                                                }
                                            </tr>
                                        </thead>

                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Four">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionFour" aria-expanded="false" aria-controls="accordionFour">
