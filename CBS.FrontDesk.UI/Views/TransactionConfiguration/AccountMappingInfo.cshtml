@model CBS.FrontDesk.Data.Entity.SavingProducts.SavingConfiguration

@{
    ViewBag.Title = "Accouning entry booking";

}
<div class="container bg-icon-right">
    <h6 class="text-center fw-semibold d-flex justify-content-center align-items-center mb-4">
        <img src="~/AppFiles/Images/Icon.ico" alt="section title icon" class="me-2">

        <span class="text-uppercase"></span>
    </h6>
    <h3 class="text-center mb-2">Accounting entries for <span class="fw-bold"> @ViewBag.ProductName</span> service. </h3>
    <div class="row gy-5">
        <div class="col-lg-5">
            <div class="text-center">

                <img src="~/AppFiles/Images/BG2.png" class="faq-image" />
            </div>
        </div>
        @if (ViewBag.ProductType == "Saving_Product")
        {
            <div class="col-lg-7">
                <div class="accordion" id="accordionFront">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-One">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="false" aria-controls="accordionOne">
                                Local Cash Deposit Operation:
                            </button>
                        </h2>

                        <div id="accordionOne" class="accordion-collapse collapse" data-bs-parent="#accordionFront" aria-labelledby="accordionOne" style="">
                            <div class="accordion-body">

                                @if (Model.SavingDepositProductIsChargable)
                                {
                                    <p>
                                        This table below shows the accounting entries for a local branch deposit operation for a member in his <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold"> For Instance:</span>
                                    </p>

                                    <p>
                                        A member wants to deposit 10000Frs and needs to pay deposit fee of 200Frs.
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        This table below shows the accounting entries for a local branch deposit operation for a member in his <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold"> For Instance:</span>
                                    </p>

                                    <p>
                                        A member wants to deposit 10000Frs.
                                    </p>
                                }
                                <div class="table-responsive mb-3">
                                    <table class="table table-hover" id="myDataTable_AccountData">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Accout Number</th>
                                                <th>Account Label</th>
                                                <th>Debit</th>
                                                <th>Credit</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{

                                                var localDepositEntries = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "DEPOSIT");

                                                foreach (var item in localDepositEntries)
                                                {
                                                    <tr>
                                                        <td style="width:30%">@item.AccountNumber</td>
                                                        <td style="width:30%">@item.AccountName</td>
                                                        @if (item.BookingDirection == "DEBIT")
                                                        {
                                                            <td style="width:20%">@item.Amount</td>
                                                            <td style="width:20%">0</td>
                                                        }
                                                        else
                                                        {
                                                            <td style="width:20%">0</td>
                                                            <td style="width:20%">@item.Amount </td>

                                                        }

                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                        <thead class="table-light">
                                            <tr>

                                                <th colspan="2">Total debit</th>
                                                @{

                                                    var localDepositEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "DEPOSIT");
                                                    var sumDebit = localDepositEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                    var sumCredit = localDepositEntri.Where(x => x.BookingDirection != "DEBIT").Sum(x => Convert.ToDouble(x.Amount));

                                                    <th>@sumDebit</th>
                                                    <th>@sumCredit</th>
                                                }
                                            </tr>
                                        </thead>

                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Two">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionTwo" aria-expanded="false" aria-controls="accordionTwo">
                                Remote branch cash deposit Operation:
                            </button>
                        </h2>
                        <div id="accordionTwo" class="accordion-collapse collapse" aria-labelledby="accordionTwo" data-bs-parent="#accordionFront" style="">
                            <div class="accordion-body">

                                @if (Model.SavingDepositProductIsChargable)
                                {
                                    <p>
                                        This table below shows the accounting entries for a local branch deposit operation for a member in his <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold"> For Instance:</span>
                                    </p>

                                    <p>
                                        A member wants to deposit 10000Frs and needs to pay deposit fee of 200Frs.
                                    </p>
                                }
                                else
                                {
                                    <div class="text-center mb-2">
                                        This table below show the accounting entries for a local branch deposit operation for a member in his  <span class="fw-bold"> @ViewBag.ProductName</span> account.
                                        <span class="fw-bold">
                                            For Instance:
                                        </span><br>
                                        A member wants to deposit 10000Frs.
                                    </div>
                                }



                                <div class="table-responsive mb-3">
                                    <table class="table table-hover" id="myDataTable_AccountData">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Accout Number</th>
                                                <th>Account Label</th>
                                                <th>Debit</th>
                                                <th>Credit</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{

                                                var RemoteDepositEntries = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "DEPOSIT_REMOTE");

                                                foreach (var item in RemoteDepositEntries)
                                                {
                                                    <tr>
                                                        <td style="width:30%">@item.AccountNumber</td>
                                                        <td style="width:30%">@item.AccountName</td>
                                                        @if (item.BookingDirection == "DEBIT")
                                                        {
                                                            <td style="width:20%">@item.Amount</td>
                                                            <td style="width:20%">0</td>
                                                        }
                                                        else
                                                        {
                                                            <td style="width:20%">0</td>
                                                            <td style="width:20%">@item.Amount </td>

                                                        }

                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                        <thead class="table-light">
                                            <tr>

                                                <th colspan="2">Total debit</th>
                                                @{

                                                    var RemoteDepositEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "DEPOSIT_REMOTE");
                                                    var sumDebitRd = RemoteDepositEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                    var sumCreditRd = RemoteDepositEntri.Where(x => x.BookingDirection == "CREDIT").Sum(x => Convert.ToDouble(x.Amount));

                                                    <th>@sumDebitRd</th>
                                                    <th>@sumCreditRd</th>
                                                }
                                            </tr>
                                        </thead>

                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Three">
