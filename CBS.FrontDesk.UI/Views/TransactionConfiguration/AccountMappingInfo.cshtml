                        <div id="accordionFour" class="accordion-collapse collapse" aria-labelledby="accordionFour" data-bs-parent="#accordionFront" style="">
                            <div class="accordion-body">
                                @if (Model.SavingWithdrwalProductIsChargable)
                                {
                                    <p>
                                        This table below shows the accounting entries for a local branch deposit operation for a member in his <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold"> For Instance:</span>
                                    </p>

                                    <p>
                                        A member wants to withdraw 10000Frs and needs to pay a fine of 200Frs.
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        This table below shows the accounting entries for a local branch deposit operation for a member in his <span class="fw-bold">@ViewBag.ProductName</span> account.
                                    </p>
                                    <p>
                                        <span class="fw-bold"> For Instance:</span>
                                    </p>

                                    <p>
                                        A member wants to withdraw 10000Frs.
                                    </p>
                                }
                                <div class="table-responsive mb-3">
                                    <table class="table table-hover" id="myDataTable_AccountData">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Accout Number</th>
                                                <th>Account Label</th>
                                                <th>Debit</th>
