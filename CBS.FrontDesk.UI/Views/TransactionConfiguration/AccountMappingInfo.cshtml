                                                        }
                                                        else
                                                        {
                                                            <td style="width:20%">0</td>
                                                            <td style="width:20%">@item.Amount </td>

                                                        }

                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                        <thead class="table-light">
                                            <tr>

                                                <th colspan="2">Total debit</th>
                                                @{

                                                    var RemoteCashOutEntri = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "CASHOUT_REMOTE");
                                                    var sumDebitRCO = RemoteCashOutEntri.Where(x => x.BookingDirection == "DEBIT").Sum(x => Convert.ToDouble(x.Amount));
                                                    var sumCreditRCO = RemoteCashOutEntri.Where(x => x.BookingDirection != "DEBIT").Sum(x => Convert.ToDouble(x.Amount));

                                                    <th>@sumDebitRCO</th>
                                                    <th>@sumCreditRCO</th>
                                                }
                                            </tr>
                                        </thead>

                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Five">
                            <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionFive" aria-expanded="true" aria-controls="accordionFive">
                                Interest expense to members
                            </button>
                        </h2>
                        <div id="accordionFive" class="accordion-collapse collapse show" aria-labelledby="accordionFive" data-bs-parent="#accordionFront" style="">
                            <div class="accordion-body">
                                @{ 
                                    var modelch = Model.chartofAccountInfos.Where(x => x.OperationType == "INTEREST_EXPENSE").FirstOrDefault();
                                        }
                                The determinant account @modelch.AccountNumber - @modelch.AccountName has been set but the default counterpart cannot be evaluated
                                due to missen configuration.                           
                            </div>
                        </div>
                    </div>
              
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-7">
                <div class="accordion" id="accordionFront">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-One">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="false" aria-controls="accordionOne">
