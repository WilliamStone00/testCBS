                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{

                                                var RemoteCashOutEntries = Model.chartofAccountInfos.Where(Id => Id.AccountNumber != "XXXXXXXX" && Id.OperationType == "CASHOUT_REMOTE");

                                                foreach (var item in RemoteCashOutEntries)
                                                {
                                                    <tr>
                                                        <td style="width:30%">@item.AccountNumber</td>
                                                        <td style="width:30%">@item.AccountName</td>
                                                        @if (item.BookingDirection == "DEBIT")
