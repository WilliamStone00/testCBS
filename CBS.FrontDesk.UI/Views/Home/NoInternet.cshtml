@{
    ViewBag.Title = "No Internet Connection";
}

<div class="container-fluid h-100 d-flex flex-column justify-content-center align-items-center bg-light">
    <div class="card shadow border-0" style="width: 450px; background-color: #f4f5f7; border-radius: 12px;">
        <div class="card-body text-center p-5">
            <div class="mb-3">
                <i class="mdi mdi-wifi-off text-success display-1"></i>
            </div>
            <h3 class="text-primary mb-2 font-weight-bold">No Internet Connection</h3>
            <p class="text-muted mb-4" style="font-size: 1rem;">
                You are currently offline. Please check your internet connection and try again.
            </p>
            <a href="~/Home" class="btn btn-gradient-primary px-4 py-2">
                RETRY
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #eef1f5;
    }

    .card {
        box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.1);
    }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #28a745, #218838);
        color: #fff;
        border: none;
        transition: background 0.3s ease;
    }

        .btn-gradient-primary:hover {
            background: linear-gradient(135deg, #218838, #1e7e34);
        }
</style>
