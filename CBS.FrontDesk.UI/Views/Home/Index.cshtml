@using Resources
@{
    ViewBag.Title = "Home";
}

<style>
    body {
        background-image: url('@Url.Content("~/AppFiles/Images/NBG.jpeg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        margin: 0;
        padding: 0;
        height: 100vh;
        width: 100vw;
        font-family: Arial, sans-serif;
    }

    .navbar {
        background-color: #333;
        height: 50px;
        position: fixed;
        width: 100%;
        top: 0;
        left: 0;
        z-index: 1000;
    }

    .content {
        position: relative;
        z-index: 1;
        color: #fff;
        text-align: center;
        padding-top: 100px;
    }

    h1 {
        font-size: 3rem;
        font-weight: bold;
        color: #2d9cdb;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        margin-bottom: 20px;
    }

    p {
        font-size: 1.1rem;
        color: green;
        font-weight: normal;
        line-height: 1.6;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
        position: absolute;
        top: 70px;
        right: 20px;
        margin: 0;
    }

    .partner-text {
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 5px;
        color: forestgreen;
    }

    .satisfaction-text {
        font-size: 1rem;
        color: blue;
        margin-top: 0;
    }

    .styled-hr {
        font-size: 2rem;
        font-weight: bold;
    }

    .trust-soft {
        color: deepskyblue;
    }

    .credit {
        color: limegreen;
    }
</style>

<body>
    <div class="content">
        <h1 class="styled-hr">
            @GlobalHome.welcome_to
            <span class="trust-soft">TRUSTSOFT</span>
            <span class="credit">CREDIT</span>
        </h1>
    </div>

    <!-- Partner Info -->
    <a href="https://fluxcm.com" target="_blank" class="footer-link fw-medium">
        <p class="partner-text">@GlobalHome.your_secure_reliable_partner_flux</p>
        <p class="satisfaction-text mt-4"><small><i> Flux SARL! : @GlobalHome.empowering_businesses_enhancing_lives</i></small></p>
    </a>
</body>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
