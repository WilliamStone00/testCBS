@model CBS.FrontDesk.Data.Entity.SavingProducts.Account

<fieldset class="fieldset-custom">
    @if (!Model.Transfers.Any())
    {
        <div class="text-center my-3">
            <p>No pending transfer(s) are available for the moment</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <div class="card-header">
                <h5 class="card-title">Transfers</h5>
            </div>

            <table class="table table-hover table-striped table-bordered align-middle" id="myDataTableT">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%;">Date</th>
                        <th style="width: 15%;">Sending Account</th>
                        <th style="width: 15%;">Receiving Account</th>
                        <th style="width: 10%;">Amount</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 25%;">Initiator</th>
                        <th style="width: 10%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Transfers)
                    {
                        <tr>
                            <td>@d.DateOfInitiation.ToString("dd-MM-yyyy, hh:mm:ss")</td>
                            <td>@d.SourceAccountNumber</td>
                            <td>@d.DestinationAccountNumber</td>
                            <td>@d.Amount.ToString("#,##0.0")</td>
                            <td>
                                <!-- Beautified Status with Badges -->
                                @if (d.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (d.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (d.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            </td>
                            <td>@d.InitiatedByUSerName</td>
                            <td>
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_TransferConfirmation','confirmation_request','Operation')"
                                   class="btn btn-sm btn-outline-primary" data-toggle="tooltip" data-placement="top" title="Select to approve">
                                    Approve
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>

