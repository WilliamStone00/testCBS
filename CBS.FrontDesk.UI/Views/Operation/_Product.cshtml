@model CBS.FrontDesk.Data.Entity.SavingProducts.Account


@{
    var name = $"{Model.Customer.firstName} {Model.Customer.lastName}";
}

<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-information me-2"></i>
                PRODUCT INFORMATION
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">
                        <div class="card mb-4">
                            <div class="card-body pt-2 mt-1">
                              <div class="row mt-2 gy-4">
                                        <div class="col-md-8">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => name, new { @class = "form-control", @readonly = true })
                                                <label>Profile</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.name, new { @class = "form-control", @readonly = true })
                                                <label>Saving product</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.createdBy, new { @class = "form-control", @readonly = true })
                                                <label>Saving officer</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.createdDate, new { @class = "form-control", @readonly = true })
                                                <label>Opening date</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.interestRate, new { @class = "form-control", @readonly = true })
                                                <label>Interest rate</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.entryFee, new { @class = "form-control", @readonly = true })
                                                <label>Entry fee</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.closingFee, new { @class = "form-control", @readonly = true })
                                                <label>Closing fee</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.reopeningFee, new { @class = "form-control", @readonly = true })
                                                <label>Re-opening fee</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.managementFee, new { @class = "form-control", @readonly = true })
                                                <label>Management fee</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.yearlyInterestRate, new { @class = "form-control", @readonly = true })
                                                <label>Yearly interst rate</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.minAmount, new { @class = "form-control", @readonly = true })
                                                <label>Minimum amount</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.maxAmount, new { @class = "form-control", @readonly = true })
                                                <label>Max amount</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.managementFeeFrequency, new { @class = "form-control", @readonly = true })
                                                <label>Management fee frequency</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.product.postingFrequency, new { @class = "form-control", @readonly = true })
                                                <label>Posting frequency</label>
                                            </div>
                                        </div>
                                    </div>
                             
                            </div>
                            <!-- /Account -->
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconTwo">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-2"
                    aria-controls="accordionPopoutIcon-2">
                <i class="mdi mdi-outdoor-lamp me-2"></i>
                WITHDRAWAL CONFIGURATION
            </button>
        </h2>
        <div id="accordionPopoutIcon-2"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewReset">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableW">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Withdrawal Type</th>
                                            <th>Fee</th>
                                            <th>Min</th>
                                            <th>Max</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.product.withdrawalLimits)
                                        {
                                            <tr>
                                                <td style="width:70%">@d.withdrawalType</td>
                                                <td style="width:10%">@d.feePercentage</td>
                                                <td style="width:10%">@d.minAmount</td>
                                                <td style="width:10%">@d.maxAmount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOne">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-1"
                    aria-controls="accordionPopoutIcon-1">
                <i class="mdi mdi-octagram-plus me-2"></i>
               DEPOSITS CONFIGURATION
            </button>
        </h2>

        <div id="accordionPopoutIcon-1"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainview_mfa">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableD">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Deposit type</th>
                                            <th>Fee</th>
                                            <th>Min</th>
                                            <th>Max</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.product.depositLimits)
                                        {
                                            <tr>
                                                <td style="width:70%">@d.depositType</td>
                                                <td style="width:10%">@d.feePercentage</td>
                                                <td style="width:10%">@d.minAmount</td>
                                                <td style="width:10%">@d.maxAmount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOneT">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-T"
                    aria-controls="accordionPopoutIcon-T">
                <i class="mdi mdi-transfer me-2"></i>
                TRANSFER CONFIGURATION
            </button>
        </h2>

        <div id="accordionPopoutIcon-T"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="transferSeting">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableT">
                                    <thead class="table-light">
                                    <tr>
                                        <th>transferType</th>
                                        <th>Fee</th>
                                        <th>Min</th>
                                        <th>Max</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var d in Model.product.transferLimits)
                                    {
                                        <tr>
                                            <td style="width:70%">@d.transferType</td>
                                            <td style="width:10%">@d.feePercentage</td>
                                            <td style="width:10%">@d.minAmount</td>
                                            <td style="width:10%">@d.maxAmount</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

</div>








