@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@using Resources

@{
    var name = $"{Model.Customer.firstName} {Model.Customer.lastName}";
}

<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-information me-2"></i>
                <b> @Model.product.name.ToUpper() @GlobalOperation.account_configuration_details</b>
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <div class="change-group">
                        <div class="card mb-4">
                            <div class="card-body pt-2 mt-1">
                                <div class="row mt-2 gy-4">
                                    <div class="col-md-8">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.accountName, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalOperation.member_account_name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.product.name, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalOperation.saving_product</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.createdBy, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalOperation.saving_officer</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.createdDate, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalShared.opening_date</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.product.minAmount, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalShared.Minimum_Amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.product.maxAmount, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalShared.Max_Amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.product.activeStatus, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalOperation.product_active_status</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.product.postingFrequency, new { @class = "form-control", @readonly = true })
                                            <label>@GlobalOperation.posting_frequency</label>
                                        </div>
                                    </div>
                                </div>
                             
                            </div>
                            <!-- /Account -->
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconTwo">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-2"
                    aria-controls="accordionPopoutIcon-2">
                <i class="mdi mdi-outdoor-lamp me-2"></i>
                @GlobalOperation.withdrawal_configuration
            </button>
        </h2>
        <div id="accordionPopoutIcon-2"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewReset">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableW">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalOperation.withdrawal_type</th>
                                            <th>@GlobalShared.Fee</th>
                                            <th>@GlobalShared.min</th>
                                            <th>@GlobalShared.max</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.product.WithdrawalParameters)
                                        {
                                            <tr>
                                                <td style="width:70%">@d.withdrawalType</td>
                                                <td style="width:10%">@d.withdrawalFeeFlat</td>
                                                <td style="width:10%">@d.minAmount</td>
                                                <td style="width:10%">@d.maxAmount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOne">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-1"
                    aria-controls="accordionPopoutIcon-1">
                <i class="mdi mdi-octagram-plus me-2"></i>
                @GlobalOperation.deposits_configuration
            </button>
        </h2>

        <div id="accordionPopoutIcon-1"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainview_mfa">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableD">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalOperation.deposit_type</th>
                                            <th>@GlobalShared.Fee</th>
                                            <th>@GlobalShared.min</th>
                                            <th>@GlobalShared.max</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.product.CashDepositParameters)
                                        {
                                            <tr>
                                                <td style="width:70%">@d.depositType</td>
                                                <td style="width:10%">@d.depositFeeFlat</td>
                                                <td style="width:10%">@d.minAmount</td>
                                                <td style="width:10%">@d.maxAmount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="accordion-item">
        <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconOneT">
            <button type="button"
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-T"
                    aria-controls="accordionPopoutIcon-T">
                <i class="mdi mdi-transfer me-2"></i>
                @GlobalOperation.transfer_configuration
            </button>
        </h2>

        <div id="accordionPopoutIcon-T"
             class="accordion-collapse collapse"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="transferSeting">
                    <div class="reset-group">
                        <div class="card mb-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-hover" id="myDataTableT">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@GlobalShared.transfer_type</th>
                                            <th>@GlobalShared.Fee</th>
                                            <th>@GlobalShared.rate</th>
                                            <th>@GlobalShared.min</th>
                                            <th>@GlobalShared.max</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var d in Model.product.TransferParameters)
                                    {
                                        <tr>
                                            <td style="width:70%">@d.transferType</td>
                                            <td style="width:10%">@d.transferFeeFlat</td>
                                            <td style="width:10%">@d.transferFeeRate</td>
                                            <td style="width:10%">@d.minAmount</td>
                                            <td style="width:10%">@d.maxAmount</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

</div>








