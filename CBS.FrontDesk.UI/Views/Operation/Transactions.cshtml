@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountOperation.GetAllTransactionsByDatesAndBranchQuery

@{
    ViewBag.Title = "Transaction Query";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-excel me-2"></i> Transaction Query Form
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <legend>Transaction Query Parameters</legend>
                                <div class="card-body">
                                    @using (Html.BeginForm("OperationDownload", "Operation", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        <hr />

                                        <div class="row g-4">
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m => m.ByBranchId, new { @class = "form-check-input", @id = "byBranchCheckbox" })
                                                    <label class="form-check-label" for="byBranchCheckbox">Check to filter by Branch</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m => m.ByTellerId, new { @class = "form-check-input", @id = "byTellerCheckbox" })
                                                    <label class="form-check-label" for="byTellerCheckbox">Check to filter by Teller</label>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row g-4">
                                            <div class="col-md-4" id="branchDiv" style="display:block">
                                                <label for="branchInput">Branch</label>
                                                @Html.DropDownListFor(m => m.BranchID, new SelectList(ViewBag.Branches, "Id", "Name"), "---Select Branch---", new { @class = "form-control shadow-box select2", @id = "branchInput" })
                                                @Html.ValidationMessageFor(m => m.BranchID, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4" id="tellerDiv" style="display:none">
                                                <label for="tellerInput">Teller</label>
                                                @Html.DropDownListFor(m => m.TellerId, new SelectList(ViewBag.Tellers, "Value", "Text"), "---Select Teller---", new { @class = "form-control shadow-box select2", @id = "tellerInput" })
                                                @Html.ValidationMessageFor(m => m.TellerId, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-8">
                                                <div class="row g-4">
                                                    <div class="col-md-6">
                                                        <label for="dateFromInput">Date From</label>
                                                        <div class="input-group">
                                                            @Html.TextBoxFor(m => m.DateFrom, new { @class = "form-control shadow-box date-picker", @id = "dateFromInput", @placeholder = "Date From" })
                                                        </div>
                                                        @Html.ValidationMessageFor(m => m.DateFrom, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="dateToInput">Date To</label>
                                                        <div class="input-group">
                                                            @Html.TextBoxFor(m => m.DateTo, new { @class = "form-control shadow-box date-picker", @id = "dateToInput", @placeholder = "Date To" })
                                                        </div>
                                                        @Html.ValidationMessageFor(m => m.DateTo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <hr />

                                        <div class="row g-4">
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m => m.IsByDate, new { @class = "form-check-input", @id = "byDateCheckbox", @checked = "checked", @readonly = "readonly" })
                                                    <label class="form-check-label" for="byDateCheckbox">Filter By Date</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    @Html.CheckBoxFor(m => m.UseAccountingDate, new { @class = "form-check-input", @id = "useAccountingDateCheckbox", @checked = "checked" })
                                                    <label class="form-check-label" for="useAccountingDateCheckbox">Use Accounting Date</label>
                                                </div>
                                            </div>
                                        </div>


                                        <hr />

                                        <div class="text-center">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="fa fa-search me-2"></i> Submit Query
                                            </button>
                                        </div>
                                    }
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var byBranchCheckbox = document.getElementById('byBranchCheckbox');
        var byTellerCheckbox = document.getElementById('byTellerCheckbox');
        var branchDiv = document.getElementById('branchDiv');
        var tellerDiv = document.getElementById('tellerDiv');
        var byDateCheckbox = document.getElementById('byDateCheckbox');
        var useAccountingDateCheckbox = document.getElementById('useAccountingDateCheckbox');

        // Function to toggle visibility of branchDiv and tellerDiv
        function toggleDivs() {
            if (byBranchCheckbox.checked) {
                branchDiv.style.display = 'block';
                tellerDiv.style.display = 'none';
                byTellerCheckbox.checked = false;  // Uncheck Teller when Branch is checked
            } else if (byTellerCheckbox.checked) {
                tellerDiv.style.display = 'block';
                branchDiv.style.display = 'none';
                byBranchCheckbox.checked = false;  // Uncheck Branch when Teller is checked
            }
        }

        // Ensure one checkbox is always checked
        function ensureCheckboxIsChecked() {
            // If both are unchecked, check Branch by default
            if (!byBranchCheckbox.checked && !byTellerCheckbox.checked) {
                byBranchCheckbox.checked = true;
            }
        }

        // Set initial states
        byBranchCheckbox.checked = true; // Set Branch as checked by default
        byTellerCheckbox.checked = false;
        byDateCheckbox.checked = true;  // By Date checkbox checked by default
        useAccountingDateCheckbox.checked = true;  // Use Accounting Date checked by default
        byDateCheckbox.setAttribute('readonly', 'readonly');  // Make By Date readonly
        useAccountingDateCheckbox.setAttribute('readonly', 'readonly');  // Make Use Accounting Date readonly

        // Initial toggle on page load
        toggleDivs();

        // Add event listeners to checkboxes to handle changes
        byBranchCheckbox.addEventListener('change', function () {
            if (byBranchCheckbox.checked) {
                byTellerCheckbox.checked = false;  // Ensure Teller is unchecked when Branch is checked
            } else {
                byTellerCheckbox.checked = true;  // If Branch is unchecked, check Teller
            }
            toggleDivs();
        });

        byTellerCheckbox.addEventListener('change', function () {
            if (byTellerCheckbox.checked) {
                byBranchCheckbox.checked = false;  // Ensure Branch is unchecked when Teller is checked
            } else {
                byBranchCheckbox.checked = true;  // If Teller is unchecked, check Branch
            }
            toggleDivs();
        });

        // Ensure one checkbox is always checked after any change
        byBranchCheckbox.addEventListener('change', ensureCheckboxIsChecked);
        byTellerCheckbox.addEventListener('change', ensureCheckboxIsChecked);
    });

</script>
}

