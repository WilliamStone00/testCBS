@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
<!-- User Card -->
<div class="card mb-4 border-2 border-primary">
    <div class="card mt-3 px-3 py-2">
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#customerInfoModal">Customer Details</button>
        <br />
        <h4 class="group-title">
            Custumer Number <span class="highlight-text">@Model.Customer.customerId</span><br />
            <small>Customer Code: Last 5 digits</small><br />
            <small>Bank Code: @Session["BankCode"].ToString()</small><br />
            <small>Branch Code: @Session["BranchCode"].ToString()</small><br />
            Selected account number <span class="highlight-text">@Model.accountNumber</span><br />
        </h4>
    </div>
    <br />
    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <div class="card-info">
                    <div class="d-flex align-items-center">
                        <h4 class="mb-0">@Model.AccountBalance.totalBalance</h4>
                    </div>
                    <small>Total account balance</small>
                </div>
            </div>
        </div>
    </div>
    <div class="card mt-3">
        <div class="card-body px-3 py-2">
            <h5 class="card-title">Picture</h5>
            <div class="image-upload-container">
                <!-- Image for picture -->
                @if (Model.Customer.photoUrl != null)
                {
                    <!-- Clickable photo for preview -->
                    <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                        <img src="@Model.Customer.photoUrl" class="img-fluid preview-image" alt="Uploaded Image">
                    </a>
                    <!-- Modal for photo preview -->
                    <div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-body">
                                    <img src="@Model.Customer.photoUrl" class="img-fluid" alt="Uploaded Image">
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <img src="@Url.Content(Model.Customer.ImageNoVirtualPath)" class="img-fluid preview-image" alt="No Signature Found" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                }
                <!-- ... Other content ... -->
            </div>
        </div>
    </div>
    <div class="card mt-3">
        <div class="card-body px-3 py-2">
            <h5 class="card-title">Signature</h5>
            <div class="image-upload-container">
                <!-- Image for signature -->
                @if (Model.Customer.signatureUrl != null)
                {
                    <!-- Clickable signature for preview -->
                    <a href="#" data-bs-toggle="modal" data-bs-target="#signaturePreviewModal">
                        <img src="@Model.Customer.signatureUrl" class="img-fluid preview-image" alt="Uploaded Signature">
                    </a>
                    <!-- Modal for signature preview -->
                    <div class="modal fade" id="signaturePreviewModal" tabindex="-1" aria-labelledby="signaturePreviewModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-body">
                                    <img src="@Model.Customer.signatureUrl" class="img-fluid" alt="Uploaded Signature">
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <img src="@Url.Content(Model.Customer.ImageVirtualNoSignaturePath)" class="img-fluid preview-image" alt="No Signature Found" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                }
                <!-- ... Other content ... -->
            </div>
        </div>
    </div>
</div>

<div class="card mb-4 border-2 border-primary">
    <div class="card-body">
        <h5 class="pb-3 border-bottom mb-3">Registration Info</h5>
        <ul class="list-unstyled g-2 my-4">
            <li class="mb-2 d-flex align-items-center px-3 py-2">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span> Organization: @Model.Customer.organizationId</span>
            </li>
            <li class="mb-2 d-flex align-items-center px-3 py-2">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Branch office: @Model.Customer.bankId</span>
            </li>
            <li class="mb-2 d-flex align-items-center px-3 py-2">
                <i class="mdi mdi-circle-medium text-lighter mdi-24px"></i><span>Branch: @Model.Customer.branchId</span>
            </li>
        </ul>
    </div>
</div>

