@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
    @using Resources
@if (Model.Loans.Count == 0)
{
    <div class="text-center my-3">
        <p>@GlobalOperation.no_loans_have_been_contracted_by @Model.Customer.name</p>
    </div>
}
else
{
    <div class="card-header">
        <h6 class="card-title">@GlobalOperation.members_current_loan</h6>
    </div>
    <div class="table-responsive mb-3">

        <table class="table table-hover" id="myDataTable_customer_loan">
            <thead class="table-light">
                <tr>
                    <th style="width: 7%">@GlobalShared.Action</th>
                    <th style="width: 7%">@GlobalShared.Date</th>
                    <th style="width: 8%">@GlobalShared.maturity_date</th>
                    <th style="width: 10%">@GlobalShared.Principal</th>
                    <th style="width: 7%">@GlobalShared.Interest Rate</th>
                    <th style="width: 8%">@GlobalShared.Accrual_Interest</th>
                    <th style="width: 8%">@GlobalShared.Tax</th>
                    <th style="width: 8%">@GlobalShared.Penalty</th>
                    <th style="width: 8%">@GlobalShared.due</th>
                    <th style="width: 8%">@GlobalShared.Paid</th>
                    <th style="width: 8%">@GlobalShared.Balance</th>
                    <th style="width: 8%">@GlobalShared.last_payment</th>
                    <th style="width: 7%">@GlobalShared.Status</th>
                    <th style="width: 7%">@GlobalShared.State</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Loans.OrderBy(app => app.DisbursementDate))
                {
                    <tr>
                        <td style="width: 7%">
                            <a href="#" onclick="GetLoan('@d.Id')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalOperation.select_loan_to_repay.">
                                Select
                            </a>
                        </td>
                        <td style="width: 7%">@d.LoanDate</td>
                        <td style="width: 8%">@d.MaturityDate</td>
                        <td style="width: 10%">@d.Principal.ToString("#,0.00")</td>
                        <td style="width: 7%">@d.InterestRate %</td>
                        <td style="width: 8%">@d.AccrualInterestBalance.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Tax.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.PenaltyBalance.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.DueAmount.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Paid.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.Balance.ToString("#,0.00")</td>
                        <td style="width: 8%">@d.LastPayment.ToString("#,0.00")</td>
                        <td style="width: 7%">@d.LoanStatus</td>
                        <td style="width: 7%">
                            @if (d.IsCurrentLoan)
                            {
                                <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@GlobalShared.Current</span>
                            }
                            else
                            {
                        <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@GlobalShared.Restructured</span>
                            }
                        </td>

                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="1"></td>
                    <td>Principal:</td>
                    <td>@Model.Loans.Sum(x => x.Principal).ToString("#,0.00")</td>
                    <td>Paid:</td>
                    <td>@Model.Loans.Sum(x => x.Paid).ToString("#,0.00")</td>
                    <td>Balance:</td>
                    <td>@Model.Loans.Sum(x => x.Balance).ToString("#,0.00")</td>
                    <td></td> <!-- Placeholder for the last column -->
                </tr>
            </tfoot>
        </table>
    </div>

}

