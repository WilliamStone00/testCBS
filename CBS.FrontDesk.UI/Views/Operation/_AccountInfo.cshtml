@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@{
    var status = false;
    string comment = "No initial deposit has been made.";
    if (Model.AccountBalance.accounts.Any())
    {
        status = true;
    }
}

<div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

    <div class="accordion-item active">
        <h2 class="accordion-header text-body d-flex justify-content-between"
            id="accordionPopoutIconThree">
            <button type="button"
                    class="accordion-button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPopoutIcon-3"
                    aria-expanded="true"
                    aria-controls="accordionPopoutIcon-3">
                <i class="mdi mdi-folder-information-outline me-2"></i>
                ACCOUNT INFORMATION
            </button>
        </h2>
        <div id="accordionPopoutIcon-3"
             class="accordion-collapse collapse show"
             data-bs-parent="#accordionPopoutIcon">
            <div class="accordion-body">
                <div id="mainviewChange">
                    <fieldset class="fieldset-custom">
                        <div class="change-group">
                            <div class="col-12">

                                @if (Model.Status == "Inprogress")
                                {
                                    <br />
                                    <div class="text-center my-3">
                                        <p>No initial deposit is done into account number: @Model.AccountNumber </p>
                                        <a href="/Operation/Deposit?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Perform member deposit operation">
                                            <span class="tf-icons mdi mdi-octagram-plus mdi-18px"></span>
                                        </a>
                                    </div>




                                }
                                else
                                {
                                    <div class="col-lg-12 col-sm-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex align-items-center flex-wrap gap-2">
                                                    <div class="card-info">
                                                        <div class="d-flex align-items-center">
                                                            <h5 class="mb-0">Balance: @Model.Balance.ToString("#,##0.0")</h5>
                                                        </div>
                                                        <small>Account Number: <b>@Model.AccountNumber</b></small><br />
                                                        <small>Opening balance: <b>N/A</b></small><br />
                                                        <small class="mb-0">Account Name: <b>@Model.Product.name</b></small><br />
                                                        <small class="mb-0">Account Status: <b>@Model.Status</b></small><br />
                                                        <small class="mb-0">Date created: <b>@Model.CreatedDate</b></small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <br />
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="card-title">ACCOUNTS</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive mb-3">
                                            <table class="table table-hover" id="myDataTableT">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Account Type</th>
                                                        <th>Status</th>
                                                        <th>Balance</th>
                                                        <th>Balance B/F</th>
                                                        <th>Account Number</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var d in Model.Accounts)
                                                    {
                                                        <tr onclick="navigateToDetails('@Url.Action("AccountDetails", "Operation", new { KEY = @d.accountNumber })')">
                                                            <td style="width: 40%;">
                                                                <a href="@Url.Action("AccountDetails", "Operation", new { KEY = @d.accountNumber })">
                                                                    @d.product.name
                                                                </a>
                                                            </td>
                                                            <td style="width: 10%;">
                                                                @if (d.status.ToLower() == "active")
                                                                {
                                                                    <label class="ql-color-purple"><span class="blue-text badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@d.status</span></label>
                                                                }
                                                                else
                                                                {
                                                                    <label class="ql-color-purple"><span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">In-Active</span></label>
                                                                }
                                                            </td>
                                                            <td style="width: 15%;">@Convert.ToDecimal(d.balance).ToString("#,##0.0")</td>
                                                            <td style="width: 15%;">@Convert.ToDecimal(d.previousBalance).ToString("#,##0.0")</td>
                                                            <td style="width: 20%;">@d.accountNumber</td>
                                                        </tr>
                                                    }
                                                </tbody>                                                <tfoot>
                                                    <tr>
                                                        <td colspan="2">Total Balance:</td>
                                                        <td colspan="3"><span id="totalBalance">@Model.AccountBalance.accounts.Sum(x => x.Balance).ToString("#,##0.0")</span></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </fieldset>
                </div>

            </div>
        </div>
    </div>
</div>



