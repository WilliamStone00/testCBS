@model CBS.FrontDesk.Data.Entity.SavingProducts.Account

<div class="card mb-4 border-2 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
        <h5 class="card-title mb-0">Transfer Details</h5>
        <button class="btn btn-sm btn-light" onclick="printTransferDetails()">
            <i class="fa fa-print"></i> Print
        </button>
    </div>
    <div id="transferDetails" class="card-body">

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Source Account:</strong>
                <span>@Model.Transfer.SourceAccountNumber, @Model.Transfer.SourceAccountType</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Destination Account:</strong>
                <span>@Model.Transfer.DestinationAccountNumber, @Model.Transfer.DestinationAccountType</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Source Branch:</strong>
                <span>@Model.Transfer.SourceBranchName</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Destination Branch:</strong>
                <span>@Model.Transfer.DestinationAccountName</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Sender:</strong>
                <span>@Model.Transfer.SenderName</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Receiver:</strong>
                <span>@Model.Transfer.RecieverName</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Amount:</strong>
                <span>@Model.Transfer.Amount.ToString("#,##0.00") FCFA</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Status:</strong>
                @if (Model.Transfer.Status == "Pending")
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
                else if (Model.Transfer.Status == "Approved")
                {
                    <span class="badge bg-success">Approved</span>
                }
                else if (Model.Transfer.Status == "Rejected")
                {
                    <span class="badge bg-danger">Rejected</span>
                }
                else
                {
                    <span class="badge bg-secondary">Unknown</span>
                }
            </div>
        </div>

        <hr class="my-3">

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Source Commission:</strong>
                <span>@Model.Transfer.SourceCommision.ToString("#,##0.00") FCFA</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Destination Commission:</strong>
                <span>@Model.Transfer.DestinationCommision.ToString("#,##0.00") FCFA</span>
            </div>
        </div>

        <hr class="my-3">

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Request Source:</strong>
                <span>@Model.Transfer.SourceType</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Transaction Type:</strong>
                <span>@Model.Transfer.TransactionType</span>
            </div>
        </div>

        <hr class="my-3">

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Reference Number:</strong>
                <span>@Model.Transfer.TransactionRef</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Initiator:</strong>
                <span>@Model.Transfer.InitiatedByUSerName</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12 d-flex justify-content-between">
                <strong>Initiator Comment:</strong>
                <span>@Model.Transfer.InitiatorComment</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12 d-flex justify-content-between">
                <strong>Approved By:</strong>
                <span>@Model.Transfer.ApprovedByUserName</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12 d-flex justify-content-between">
                <strong>Approval Comment:</strong>
                <span>@Model.Transfer.ValidatorComment</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Initiation Date:</strong>
                <span>@Model.Transfer.DateOfInitiation.ToString("dd-MM-yyyy, hh:mm:ss")</span>
            </div>
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Approval Date:</strong>
                <span>@Model.Transfer.DateOfApproval?.ToString("dd-MM-yyyy, hh:mm:ss")</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 d-flex justify-content-between">
                <strong>Teller:</strong>
                <span>@Model.Transfer.Teller.name</span>
            </div>
        </div>

    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>

<script>
function printTransferDetails() {
    // Get the content of the transferDetails div
    var printContent = document.getElementById('transferDetails').innerHTML;

    // Define custom HTML with header, footer, and signature lines
    var printWindow = window.open('', '', 'height=800,width=600');
    printWindow.document.write('<html><head><title>Print Transfer Details</title>');
    printWindow.document.write('<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">');
    printWindow.document.write('</head><body>');

    // Custom Header with Bank Name and Branch Name
    printWindow.document.write('<div class="text-center mb-4">');
    printWindow.document.write('<h3>' + '@Session["BankName"]' + '</h3>'); // Correctly include the bank name from session
    printWindow.document.write('<p>Branch Name: ' + '@Model.Transfer.SourceBranchName' + '</p>'); // Correctly include the branch name
    printWindow.document.write('<p>Date: ' + new Date().toLocaleDateString() + '</p>');
    // Title for the transfer
    printWindow.document.write('<h4 class="text-center">TRANSFER DETAILS</h4>');
    printWindow.document.write('<hr></div>'); // Separates header from the content


    // Insert the transfer details content
    printWindow.document.write('<div>' + printContent + '</div>');

    // Signature Section
    printWindow.document.write('<div class="mt-5 mb-5">');
    printWindow.document.write('<p><strong>Signatures:</strong></p>');
    printWindow.document.write('<div class="d-flex justify-content-between" style="margin-top: 50px;">');
    printWindow.document.write('<div><hr style="width:200px;"/><p>Client Signature</p></div>');
    printWindow.document.write('<div><hr style="width:200px;"/><p>Cashier Signature</p></div>');
    printWindow.document.write('</div></div>');

    // Footer
    printWindow.document.write('<hr><footer class="text-center"><p>Thank you for using our service.</p></footer>');

    printWindow.document.write('</body></html>');

    // Print and close the window
    printWindow.document.close();
    printWindow.print();
}

