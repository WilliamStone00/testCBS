@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
    @using Resources
@{
    ViewBag.Title = "Deposit";
}
<div class="row">
    <div class="col">
        <div class="row my-4">
            @if (@Model.Customer == null)
            {
                <div class="text-center my-3">
                    <p>@GlobalOperation.error_ocured_while_getting_member</p>
                </div>
            }
            else
            {
                <div class="accordion" id="collapsibleSection">
                    <div class="card accordion-item mb-3">
                        <h2 class="accordion-header" id="headingDeliveryAddress">
                            <button type="button"
                                    class="accordion-button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseDeliveryAddress"
                                    aria-expanded="true"
                                    aria-controls="collapseDeliveryAddress">
                                <div class="d-flex justify-content-center">
                                    <!-- Center-align text -->
                                    <div class="fw-bold fs-4">
                                        @GlobalOperation.members_cash_desk_operations
                                        <small style="color: blue;">@GlobalOperation.selected_account: @Model.AccountType, @GlobalShared.Account_Number: @Model.AccountNumber</small>
                                    </div>                                
                                </div>
                            </button>
                        </h2>
                        <div id="collapseDeliveryAddress"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#collapsibleSection">
                            <div class="accordion-body">
                                <div class="row g-4">
                                    <div class="col-md-3">
                                        @Html.Partial("_CustomerCard")
                                    </div>
                                    <div class="col-md-9">
                                        <div class="card mb-3 border-2">
                                            @Html.Partial("_Tabs")
                                        </div>
                                        <div class="card mb-3 border-2">
                                            <div id="datalistingview">
                                                @Html.Partial("_DepositAndWithdrawal")
                                            </div>
                                        </div>
                                    </div>
                                    @*<div class="col-md-3">
                                        @Html.Partial("_DenominationNotes")
                                    </div>*@
                                </div>

                            </div>


                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</div>


<!-- Modal to display customer information -->
@Html.Partial("_SharedModal")

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/Crud/Operation/Operation.js"></script>

}