@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
<h4 class="card-header">Account initialization</h4>
<div class="card-body pt-2 mt-1">
    @using (Html.BeginForm("Deposit", "Operation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return PostData(this);" }))
    {<input type="hidden" name="OperationType" value="InitialDeposit" id="OperationType" />
        <input type="hidden" name="partialView" value="_AccountInfo" id="partialView" />
        <input type="hidden" name="accountNumber" value="@Model.accountNumber" id="accountNumber" />
        <input type="hidden" name="divID" value="mainview" id="divID" />
        <input type="hidden" name="controller" value="TransactionManagement" id="controller" />
        <input type="hidden" name="actionMethod" value="InitializeData" id="actionMethod" />
        <div class="row mt-2 gy-3">

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Customer.name, new { @class = "form-control", @readonly = true })
                    <label>Account holder name</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.accountNumber, new { @class = "form-control", @readonly = true })
                    <label>Account number</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.product.name, new { @class = "form-control", @readonly = true })
                    <label>Account type</label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.amount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.amount, "", new { @class = "text-danger" })
                    <label style="color:blue">Enter initial deposit (min: @Model.product.minAmount, max: @Model.product.maxAmount)</label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.note10000, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.note10000, "", new { @class = "text-danger " })
                    <label>Note-10,000</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.note5000, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.note5000, "", new { @class = "text-danger " })
                    <label>Note-5,000</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.note2000, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.note2000, "", new { @class = "text-danger " })
                    <label>Note-2,000</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.note1000, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.note1000, "", new { @class = "text-danger " })
                    <label>Note-1,000</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.note500, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.note500, "", new { @class = "text-danger " })
                    <label>Note-500</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin500, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin500, "", new { @class = "text-danger " })
                    <label>Coin-500</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin100, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin100, "", new { @class = "text-danger " })
                    <label>Coin-100</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin50, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin50, "", new { @class = "text-danger " })
                    <label>Coin-50</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin25, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin25, "", new { @class = "text-danger " })
                    <label>Coin-25</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin10, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin10, "", new { @class = "text-danger " })
                    <label>Coin-10</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin5, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin5, "", new { @class = "text-danger " })
                    <label>Coin-5</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.AccountActivationRequest.currencyNotes.coin1, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AccountActivationRequest.currencyNotes.coin1, "", new { @class = "text-danger " })
                    <label>Coin-1</label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Open account</button>
        </div>
    }
</div>
