@model CBS.FrontDesk.Data.Entity.SavingProducts.Account

<fieldset class="fieldset-custom">
    @if (!Model.Transfers.Any())
    {
        <div class="text-center my-3">
            <p>No transfer is available for the main time</p>
        </div>
    }
    else
    {
<div class="table-responsive mb-3">
    <div class="card-header">
        <h5 class="card-title">Transfers initiated</h5>
    </div>
    <table class="table table-hover" id="myDataTableT">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Sending account</th>
                <th>Recieving account</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Initiator</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Transfers)
            {
                <tr>
                    <td style="width:20%">@d.DateOfInitiation.ToString("dd-MM-yyyy, hh:mm:ss")</td>
                    <td style="width:12%">@d.SourceAccountNumber</td>
                    <td style="width:12%">@d.DestinationAccountNumber</td>
                    <td style="width:10%">@d.Amount.ToString("#,##0.0")</td>
                    <td style="width:8%">@d.Status</td>
                    <td style="width:30%">@d.InitiatedByUSerName</td>
                    <td style="width:8%">

                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_TransferDetails','details','Operation')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select to approve">
                            Details
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

    }

</fieldset>

