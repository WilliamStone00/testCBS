@model CBS.FrontDesk.Data.Entity.SavingProducts.Account

    <div class="card-body d-sm-flex d-block">
        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
            <a href="/Operation/Deposit?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Perform member deposit operation in @Model.AccountNumber (@Model.AccountType)">
                <span class="tf-icons mdi mdi-octagram-plus mdi-18px"></span>
            </a>
            <a href="/Operation/Withdrawal?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Perform member withdrawal operation">
                <span class="tf-icons mdi mdi-outdoor-lamp mdi-18px"></span>
            </a>
            <a href="/Operation/TransferRequest" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" target="_blank" data-bs-toggle="tooltip" title="Peform transfer from @Model.AccountNumber (@Model.AccountType) to another account">
                <span class="tf-icons mdi mdi-transfer mdi-18px"></span>
            </a>
            <a href="/Operation/LoanRepayment?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Perform member loan repayment operation in @Model.AccountNumber (@Model.AccountType)">
                <span class="tf-icons mdi mdi-contactless-payment mdi-18px"></span>
            </a>
            <a href="/Operation/AccountDetails?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="View of allmMember account information">
                <span class="tf-icons mdi mdi-folder-information-outline mdi-18px"></span>
            </a>
            <a href="/Operation/Statement?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Member's account statement of @Model.AccountNumber (@Model.AccountType)">
                <span class="tf-icons mdi mdi-format-list-bulleted mdi-18px"></span>
            </a>
            @*<a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetTransactionHistory('@Model.AccountNumber','datalistingview','_TransactionHistrotriesData','histories','myDataTable','1')" data-bs-toggle="tooltip" title="Member account statements">
            <span class="tf-icons mdi mdi-format-list-bulleted mdi-18px"></span>
        </a>*@
            @*<a href="#" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" data-bs-toggle="tooltip" title="Member subcribed account information">
            <span class="tf-icons mdi mdi-information mdi-18px"></span>
        </a>*@
