            <span class="tf-icons mdi mdi-octagram-plus mdi-18px"></span>
        </a>
        <a href="/Operation/Withdrawal?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetObject('@Model.AccountNumber','datalistingview','_Withdrawal','withdrawal')" data-bs-toggle="tooltip" title="Perform member withdrawal operation">
            <span class="tf-icons mdi mdi-outdoor-lamp mdi-18px"></span>
        </a>

        <a href="/Operation/AccountDetails?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetObject('@Model.AccountNumber','datalistingview','_AccountInfo','accountInfo')" data-bs-toggle="tooltip" title="Member account information">
            <span class="tf-icons mdi mdi-folder-information-outline mdi-18px"></span>
        </a>

        <a href="/Operation/Statement?KEY=@Model.AccountNumber" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space" onclick="GetTransactionHistory('@Model.AccountNumber','datalistingview','_TransactionHistrotriesData','histories','myDataTable','1')" data-bs-toggle="tooltip" title="Member account statements">
            <span class="tf-icons mdi mdi-format-list-bulleted mdi-18px"></span>
        </a>
