@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@using Resources
<div class="card mb-4 border-2">
    <div class="card-header">
        <h5 class="card-title">@GlobalOperation.notes_denomination</h5>
    </div>
    <div class="card-body">
        <div class="mt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th colspan="2" class="separation-text"><h5 class="card-title">@GlobalShared.Notes</h5></th>
                    </tr>
                </thead>
                <thead>
                    <tr>
                        <th>@GlobalShared.Notes</th>
                        <th>@GlobalShared.values</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>@GlobalShared.Balance:</strong></td>
                        <td><span id="calculatedBalance">0.00</span></td>
                    </tr>
                    <tr>
                        <td><strong>10,000:</strong></td>
                        <td><span id="notes10000Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>5,000:</strong></td>
                        <td><span id="notes5000Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>2,000:</strong></td>
                        <td><span id="notes2000Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>1,000:</strong></td>
                        <td><span id="notes1000Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>500:</strong></td>
                        <td><span id="notes500Required">0</span></td>
                    </tr>
                </tbody>
                <thead>
                    <tr>
                        <th colspan="2" class="separation-text"><h5 class="card-title">@GlobalShared.Coins</h5></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>500:</strong></td>
                        <td><span id="coins500Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>100:</strong></td>
                        <td><span id="coins100Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>50:</strong></td>
                        <td><span id="coins50Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>25:</strong></td>
                        <td><span id="coins25Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>10:</strong></td>
                        <td><span id="coins10Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>5:</strong></td>
                        <td><span id="coins5Required">0</span></td>
                    </tr>
                    <tr>
                        <td><strong>1:</strong></td>
                        <td><span id="coins1Required">0</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
