@model CBS.FrontDesk.Data.Entity.SavingProducts.Account
@{
    ViewBag.Title = "Account Details";
}

<div class="row">
    <div class="col-xl-4 col-lg-5 col-md-5 order-1 order-md-0">
        @Html.Partial("_CustomerCard")
    </div>
    <div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
        @Html.Partial("_Tabs")
        <div class="card">

            <div id="datalistingview">
                @Html.Partial("_Product")
            </div>

        </div>
    </div>

</div>

<!-- Modal to display customer information -->
<div class="modal fade" id="customerInfoModal" tabindex="-1" aria-labelledby="customerInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerInfoModalLabel">Customer Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Place the customer information here -->
                <div class="card-body">
                    <div class="image-upload-container">
                        <!-- Image for picture -->
                        @if (Model.Customer.photoUrl != null)
                        {
                            <!-- Clickable photo for preview -->
                            <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                                <img src="@Model.Customer.photoUrl" class="img-fluid preview-image" alt="Uploaded Image">
                            </a>
                            <!-- Modal for photo preview -->
                            <div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-body">
                                            <img src="@Model.Customer.photoUrl" class="img-fluid" alt="Uploaded Image">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <img src="@Url.Content(Model.Customer.ImageNoVirtualPath)" class="img-fluid preview-image" alt="No Signature Found" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                        }
                        <!-- ... Other content ... -->
                    </div>
                    <h5 class="pb-3 border-bottom mb-3">Details</h5>
                    <div class="info-container">
                        <ul class="list-unstyled mb-4">
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">PIN:</span>
                                <span>@Model.Customer.taxIdentificationNumber</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Identity Number:</span>
                                <span>@Model.Customer.idNumber</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Email:</span>
                                <span>@Model.Customer.email</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Status:</span>
                                <span class="badge bg-label-success rounded-pill">
                                    @if (@Model.Customer.active)
                                    {
                                        <label>Active</label>
                                    }
                                    else
                                    {
                                        <label>In-Active</label>
                                    }
                                </span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Telephone:</span>
                                <span>@Model.Customer.phone</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Home phone number:</span>
                                <span>@Model.Customer.phone</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Address:</span>
                                <span>@Model.Customer.address</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-medium text-heading me-2">Online banking status</span>
                                <span class="badge bg-label-success rounded-pill">
                                    @if (@Model.Customer.isUseOnLineMobileBanking)
                                    {
                                        <label>Activated</label>
                                    }
                                    else
                                    {
                                        <label>Not-active</label>
                                    }
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="~/Scripts/Js/Crud/Operation/Operation.js"></script>


}