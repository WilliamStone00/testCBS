    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
        // Simple console markers for the cascading dropdown lifecycle
        console.log("Cascading Location Dropdowns Initialized");

        $('#CountryId').on('change', function () {
            const countryId = $(this).val();
            resetDropdowns(['#RegionId', '#DivisionId', '#SubDivisionId', '#TownId']);
            if (!countryId) return;

            $('#RegionId').append('<option>Loading...</option>');
            $.getJSON('/DailySaverManagement/GetRegionsByCountry', { countryId: countryId })
                .done(function (data) { populateDropdown('#RegionId', data, '---Select Region---'); })
                .fail(function () { populateDropdown('#RegionId', [], 'Error loading regions'); });
        });

        $('#RegionId').on('change', function () {
            const regionId = $(this).val();
            resetDropdowns(['#DivisionId', '#SubDivisionId', '#TownId']);
            if (!regionId) return;

            $('#DivisionId').append('<option>Loading...</option>');
            $.getJSON('/DailySaverManagement/GetDivisionsByRegion', { regionId: regionId })
                .done(function (data) { populateDropdown('#DivisionId', data, '---Select Division---'); })
                .fail(function () { populateDropdown('#DivisionId', [], 'Error loading divisions'); });
        });

        $('#DivisionId').on('change', function () {
            const divisionId = $(this).val();
            resetDropdowns(['#SubDivisionId', '#TownId']);
            if (!divisionId) return;

            $('#SubDivisionId').append('<option>Loading...</option>');
            $.getJSON('/DailySaverManagement/GetSubDivisionsByDivision', { divisionId: divisionId })
                .done(function (data) { populateDropdown('#SubDivisionId', data, '---Select Sub-Division---'); })
                .fail(function () { populateDropdown('#SubDivisionId', [], 'Error loading sub-divisions'); });
        });

        $('#SubDivisionId').on('change', function () {
            const subDivisionId = $(this).val();
            resetDropdowns(['#TownId']);
            if (!subDivisionId) return;

            $('#TownId').append('<option>Loading...</option>');
            $.getJSON('/DailySaverManagement/GetTownsBySubDivision', { subDivisionId: subDivisionId })
                .done(function (data) { populateDropdown('#TownId', data, '---Select Town---'); })
                .fail(function () { populateDropdown('#TownId', [], 'Error loading towns'); });
        });

        function populateDropdown(selector, data, placeholder) {
            const dropdown = $(selector);
            dropdown.empty().append($('<option>').val('').text(placeholder));
            $.each(data, function (i, item) {
                dropdown.append($('<option>').val(item.Id).text(item.Name));
            });
            if (dropdown.hasClass('select2')) dropdown.trigger('change.select2');
        }

        function resetDropdowns(selectors) {
            selectors.forEach(id => {
                $(id).empty().append('<option value="">---Select---</option>');
                if ($(id).hasClass('select2')) $(id).trigger('change.select2');
            });
        }
    </script>
}
