@model CBS.FrontDesk.Data.Entity.CustomerManagement.DailySaverCreateVm

@using (Html.BeginForm("AddOrUpdate", "DailySaverManagement", FormMethod.Post, new { enctype = "multipart/form-data", id = "memberForm", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

<div class="accordion" id="dailySaverAccordion">

    <!-- Branch selection (moved into the form) -->
    <div class="card mb-3">
        <div class="card-body">
            <label for="BranchId" class="form-label fw-bold">Select Branch</label>
            @Html.DropDownListFor(m => m.BranchId,
                new SelectList(ViewBag.Branches, "Id", "Name"),
                "--- Select Branch ---",
                new { @class = "form-control shadow-sm select2", id = "BranchId", required = "required" })
            @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- New / Existing toggle -->
    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-bold d-block mb-2">Daily saver type</label>
            <div id="radioButtonsContainer" class="d-flex gap-4">
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.IsNewCustomer, true, new { @class = "form-check-input", id = "rbNew" })
                    <label class="form-check-label" for="rbNew">New Daily saver</label>
                </div>
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.IsNewCustomer, false, new { @class = "form-check-input", id = "rbExisting", disabled = "disabled" })
                    <label class="form-check-label" for="rbExisting">Existing member</label>
                </div>
            </div>
            <!-- New Daily Saver ID (DS + 1–7 digits) -->
            <div id="newSaverBlock" class="row mt-3" style="display:none;">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.DailySaverId, new
                        {
                            @class = "form-control",
                            id = "DailySaverId",
                            maxlength = "9",               // "DS" + 7 digits
                            pattern = @"^DS\d{1,7}$",      // enforce DS + digits
                            inputmode = "numeric",         // mobile keyboard hints numeric
                            placeholder = "e.g. DS1, DS00945, DS01238"
                        })
                        @Html.ValidationMessageFor(m => m.DailySaverId, "", new { @class = "text-danger", id = "DailySaverIdError" })

                        <label>
                            Daily saver account number
                            <i class="mdi mdi-information-outline text-primary ms-1"
                               data-bs-toggle="tooltip"
                               data-bs-placement="right"
                               title="Daily saver account number must start with 'DS' followed by 1 to 7 digits. Example: DS1, DS00945, DS01238."></i>
                        </label>
                    </div>
                    <small class="text-muted">Format: DS + 1–7 digits (e.g. DS1, DS00945, DS01238).</small>
                </div>
            </div>






            <!-- Existing CustomerId (10 digits) -->
            <div id="existingCustomerBlock" class="row mt-3" style="display:none;">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.CustomerId, new
                   {
                       @class = "form-control",
                       id = "CustomerId",
                       maxlength = "10",
                       pattern = @"\d{10}",
                       inputmode = "numeric",
                       placeholder = "0123456789",
                       disabled = "disabled"
                   })
                        @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                        <label>Existing Member Account (10 digits)</label>
                    </div>
                    <small class="text-muted">Example: 0130001234</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile -->
    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="ds_profile_h">
            <button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#ds_profile_c">
                Profile
            </button>
        </h2>
        <div id="ds_profile_c" class="accordion-collapse collapse show" data-bs-parent="#dailySaverAccordion">
            <div class="accordion-body">
                <fieldset class="fieldset-custom">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                                <label>First name</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                                <label>Last name</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.EnumDropDownListFor(m => m.Gender, "--- Select gender ---", new { @class = "form-control select2", required = "required" })
                                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
                                <label>Gender</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date", required = "required" })
                                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
                                <label>Date of birth</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                <label>Phone</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                <label>Email</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
    <!-- Extra Personal Info -->
    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="ds_extra_h">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#ds_extra_c">
                Additional Information
            </button>
        </h2>
        <div id="ds_extra_c" class="accordion-collapse collapse" data-bs-parent="#dailySaverAccordion">
            <div class="accordion-body">
                <fieldset class="fieldset-custom">
                    <div class="row g-4">

                        <!-- Place of Birth -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.PlaceOfBirth, new { @class = "form-control", placeholder = "Place of Birth" })
                                @Html.ValidationMessageFor(m => m.PlaceOfBirth, "", new { @class = "text-danger" })
                                <label>Place of Birth</label>
                            </div>
                        </div>

                        <!-- Language -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.Language,
                                    new SelectList(ViewBag.Languages, "Value", "Text"),
                                    "--- Select Language ---",
                                    new { @class = "form-control select2", required = "required" })
                                @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                                <label>Language</label>
                            </div>
                        </div>

                        <!-- Marital Status -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.MaritalStatus,
                                    new SelectList(ViewBag.MaritalStatuses, "Value", "Text"),
                                    "--- Select Marital Status ---",
                                    new { @class = "form-control select2", required = "required" })
                                @Html.ValidationMessageFor(m => m.MaritalStatus, "", new { @class = "text-danger" })
                                <label>Marital Status</label>
                            </div>
                        </div>

                        <!-- IsUploadedData (grayed out) -->
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                @Html.CheckBoxFor(m => m.IsUploadedData,
                                    new { @class = "form-check-input", disabled = "disabled" })
                                <label class="form-check-label fw-bold" for="IsUploadedData">
                                    Is Uploaded Data (system-managed)
                                </label>
                            </div>
                            <small class="text-muted">Always set to false. Controlled by system.</small>
                        </div>

                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <!-- Address & Geography -->
    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="ds_addr_h">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#ds_addr_c">
                Address
            </button>
        </h2>
        <div id="ds_addr_c" class="accordion-collapse collapse" data-bs-parent="#dailySaverAccordion">
            <div class="accordion-body">
                <fieldset class="fieldset-custom">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.CountryId, new SelectList(ViewBag.Countries, "Id", "Name"), "--- Select Country ---", new { @class = "form-control select2", id = "CountryId", required = "required" })
                                @Html.ValidationMessageFor(m => m.CountryId, "", new { @class = "text-danger" })
                                <label>Country</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.RegionId, new SelectList(ViewBag.Regions, "Id", "Name"), "--- Select Region ---", new { @class = "form-control select2", id = "RegionId", required = "required" })
                                @Html.ValidationMessageFor(m => m.RegionId, "", new { @class = "text-danger" })
                                <label>Region</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.DivisionId, new SelectList(ViewBag.Divisions, "Id", "Name"), "--- Select Division ---", new { @class = "form-control select2", id = "DivisionId", required = "required" })
                                @Html.ValidationMessageFor(m => m.DivisionId, "", new { @class = "text-danger" })
                                <label>Division</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.SubDivisionId, new SelectList(ViewBag.SubDivisions, "Id", "Name"), "--- Select Sub-Division ---", new { @class = "form-control select2", id = "SubDivisionId", required = "required" })
                                @Html.ValidationMessageFor(m => m.SubDivisionId, "", new { @class = "text-danger" })
                                <label>Sub-Division</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.TownId, new SelectList(ViewBag.Towns, "Id", "Name"), "--- Select Town ---", new { @class = "form-control select2", id = "TownId", required = "required" })
                                @Html.ValidationMessageFor(m => m.TownId, "", new { @class = "text-danger" })
                                <label>Town</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating form-floating-outline">
                                @Html.TextAreaFor(m => m.Address, new { @class = "form-control", required = "required", id = "Address" })
                                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                <label>Address</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <!-- Identification -->
    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="ds_id_h">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#ds_id_c">
                Identification
            </button>
        </h2>
        <div id="ds_id_c" class="accordion-collapse collapse" data-bs-parent="#dailySaverAccordion">
            <div class="accordion-body">
                <fieldset class="fieldset-custom">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.IDNumber, "", new { @class = "text-danger" })
                                <label>National ID / Passport No.</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.IDNumberIssueDate, new { @class = "form-control", type = "date", required = "required" })
                                @Html.ValidationMessageFor(m => m.IDNumberIssueDate, "", new { @class = "text-danger" })
                                <label>Date issued</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.IDNumberIssueAt, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.IDNumberIssueAt, "", new { @class = "text-danger" })
                                <label>Place issued</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    <!-- Account Setup -->
    <div class="card accordion-item mb-3">
        <h2 class="accordion-header" id="ds_eco_h">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#ds_eco_c">
                Account Setup
            </button>
        </h2>
        <div id="ds_eco_c" class="accordion-collapse collapse" data-bs-parent="#dailySaverAccordion">
            <div class="accordion-body">
                <fieldset class="fieldset-custom">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.DropDownListFor(m => m.EconomicActivitiesId, new SelectList(ViewBag.EconomicActivities, "Id", "Name"), "--- Select activity ---", new { @class = "form-control select2", required = "required" })
                                @Html.ValidationMessageFor(m => m.EconomicActivitiesId, "", new { @class = "text-danger" })
                                <label>Economic activity</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.Occupation, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.Occupation, "", new { @class = "text-danger" })
                                <label>Occupation</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.TotalSubscriptionAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                                @Html.ValidationMessageFor(m => m.TotalSubscriptionAmount, "", new { @class = "text-danger" })
                                <label>Opening Amount (optional)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating form-floating-outline">
                                @Html.TextBoxFor(m => m.ExternalTransactionReference, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ExternalTransactionReference, "", new { @class = "text-danger" })
                                <label>External Transaction Ref.</label>
                            </div>
                        </div>
                    </div>
                </fieldset>


            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="mdi mdi-content-save-outline me-1"></i> Save
        </button>
        <a href="@Url.Action("Index","DailySaverManagement")" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>
}

