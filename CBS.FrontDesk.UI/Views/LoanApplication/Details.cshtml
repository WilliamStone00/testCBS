@model CBS.FrontDesk.Data.Entity.LoanConf.LoanApplication
@{
    ViewBag.Title = "Loan Application Details";
    var SavingCoverage = (Model.SavingAccountCoverageRate / 100) * Model.RequestedAmount;
    var totalRefinancing = Model.RequestedAmount + Model.RestructuredBalance;
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-file-document-outline me-2"></i> Loan Application Details
        </h1>
        <p class="card-text">
            View and manage loan application details, repayment schedule, and loan tracking. This section provides all necessary information related to the loan, approvals, repayments, and associated financial calculations.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Loan Application Help Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Important Guidelines for Loan Application Modifications</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanEditTips" aria-expanded="false" aria-controls="collapseLoanEditTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanEditTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> **Once a loan is approved or disbursed, it cannot be modified.** If there is an issue with an approved loan, please contact your administrator.</li>

                <li>
                    <i class="mdi mdi-pencil-outline text-primary me-2"></i> **Modifiable Details:**
                    <ul>
                        <li>Requested **Loan Amount**</li>
                        <li>Interest Rate & Loan Duration</li>
                        <li>Repayment Terms & Grace Period</li>
                        <li>Guarantor & Collateral Information</li>
                        <li>Coverage details (Savings, Shares, Deposits, Salary, etc.)</li>
                        <li>Applicable **loan fees & charges**</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i> **Non-Modifiable Details:**
                    <ul>
                        <li>Loan Application Date</li>
                        <li>Loan Status (Once Approved, it is Locked)</li>
                        <li>Disbursement Information</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-bank-transfer text-success me-2"></i> **Loan Coverage Requirements:**
                    <ul>
                        <li>Ensure that the total coverage amount (savings, deposits, shares, or salary) meets the loan security requirements.</li>
                        <li>If a **down payment is required**, make sure it is correctly recorded.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> **Before Submission:**
                    <ul>
                        <li>Review all entered details to ensure accuracy.</li>
                        <li>Any incorrect information may cause delays in approval.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-history text-info me-2"></i> **Tracking Loan Applications:**
                    <ul>
                        <li>Use the **Loan Query Panel** to check application status and approvals.</li>
                        <li>For any further assistance, reach out to your loan officer.</li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        @if (!Model.IsApproved)
        {
            <a type="button"
               href="@Url.Action("EditLoanApplication", "LoanApplication", new { KEY = Model.Id })"
               target="_blank"
               class="btn btn-label-warning btn-sm me-2"
               data-bs-toggle="tooltip"
               title="Edit Loan Application">
                <i class="mdi mdi-pencil mdi-18px"></i> Edit
            </a>
        }

        @if (Session["IsHeadOffice"] != null && (bool)Session["IsHeadOffice"])
        {
            <a type="button" class="btn btn-label-danger btn-sm me-2"
               data-bs-toggle="tooltip" title="Delete Loan Application"
               onclick="confirmDelete('@Model.Id')">
                <i class="mdi mdi-trash-can mdi-18px"></i> Delete
            </a>
        }

        <a type="button" href="@Url.Action("Index", "LoanApplication")"
           class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="Back to Loan List">
            <i class="mdi mdi-arrow-left mdi-18px"></i> Back
        </a>
    </div>
</div>

<!-- Loan Details Section -->
@if (Model.IsApproved && Model.Loans?.Any() == true)
{
    <div class="card shadow-sm mt-4 mb-2">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="mdi mdi-bank"></i> LOAN APPROVAL STATUS
        </div>
        <div class="card-body">
            <!-- Loan Details Table -->
            <table class="table table-bordered table-striped" id="myDataTable">
                <thead>
                    <tr class="table-secondary">
                        <th>ID</th>
                        <th>L.Date</th>
                        <th>l.Amount</th>
                        <th>I.Rate</th>
                        <th>A.Interest</th>
                        <th>Total Due</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>N.Installment</th>
                        <th>Duration</th>
                        <th>M.Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        var totalDue = loan.Principal + loan.AccrualInterest + loan.Fee;
                        <tr>
                            <td>
                                <a href="/Loan/Details?KEY=@loan.Id" target="_blank">
                                    @loan.Id
                                </a>
                            </td>
                            <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanAmount.ToString("#,##0.0")</td>
                            <td>@loan.InterestRate %</td>
                            <td>@loan.AccrualInterest.ToString("#,##0.0")</td>
                            <td>@totalDue.ToString("#,##0.0")</td>
                            <td>@loan.Paid.ToString("#,##0.0")</td>
                            <td>@loan.Balance.ToString("#,##0.0")</td>
                            <td>@loan.NextInstallmentDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanDuration months</td>
                            <td>@loan.MaturityDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@(loan.LoanStatus == "Active" ? "primary" : (loan.LoanStatus == "Delinquent" ? "danger" : "secondary"))">
                                    @loan.LoanStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mt-2">
        <div class="card-body text-center">
            <div class="alert alert-warning">
                <h5><i class="mdi mdi-alert-circle-outline"></i> Loan Not Yet Approved</h5>
                <p class="text-muted">
                    This loan application is still under review. Once approved, all loan details will be updated here.
                </p>
            </div>

            <div class="alert alert-info">
                <i class="mdi mdi-clock-outline me-2"></i>
                <strong>Tip:</strong> If your loan application is taking too long for approval, contact the loan department for assistance.
            </div>
        </div>
    </div>
}

<!-- Loan Terms Details -->
<div class="card shadow-sm mt-2">
    <div class="card-header bg-dark text-white fw-bold">
        <i class="mdi mdi-bank"></i> LOAN APPLICATION TERMS DETAILS
    </div>
    <div class="card-body">
        <p class="text-muted">
            Below are the specific terms and conditions of this loan application, including repayment structure and collateral details.
        </p>
        @Html.Partial("_Details")
    </div>
</div>
<!-- Scripts -->
@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
