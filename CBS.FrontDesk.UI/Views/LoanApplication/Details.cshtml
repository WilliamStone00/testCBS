@model CBS.FrontDesk.Data.Entity.LoanConf.LoanApplication
    @using Resources
@{
    ViewBag.Title = @GlobalShared.loan_application_details;
    var SavingCoverage = (Model.SavingAccountCoverageRate / 100) * Model.RequestedAmount;
    var totalRefinancing = Model.RequestedAmount + Model.RestructuredBalance;
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-file-document-outline me-2"></i> @GlobalShared.loan_application_details
        </h1>
        <p class="card-text">
            @GlobalLoanApplication.view_and_manage_loan_application_details.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Loan Application Help Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoanApplication.important_guidelines_for_loan_application_modifications</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanEditTips" aria-expanded="false" aria-controls="collapseLoanEditTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanEditTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalLoanApplication.once_aloan_is_approved_or_disbursed_it_cannot_be_modified.</li>

                <li>
                    <i class="mdi mdi-pencil-outline text-primary me-2"></i> @GlobalLoanApplication.modifiable_details
                    <ul>
                        <li>@GlobalLoanApplication.requested_loan_amount</li>
                        <li>@GlobalLoanApplication.interest_rate_loan_duration</li>
                        <li>@GlobalLoanApplication.repayment_terms_grace_period</li>
                        <li>@GlobalLoanApplication.guarantor_collateral_information</li>
                        <li>@GlobalLoanApplication.coverage_details</li>
                        <li>@GlobalLoanApplication.applicable_loan_fees_charges</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalLoanApplication.non_modifiable_details
                    <ul>
                        <li>@GlobalShared.loan_application_date</li>
                        <li>@GlobalLoanApplication.loan_status_once_approved</li>
                        <li>@GlobalLoanApplication.disbursement_information</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-bank-transfer text-success me-2"></i> @GlobalLoanApplication.loan_coverage_requirements
                    <ul>
                        <li>@GlobalLoanApplication.ensure_that_the_total_coverage_amount_meet_the_loan_req.</li>
                        <li>@GlobalLoanApplication.if_adown_payment_is_required_make_sure_it_is_correctly_recorded.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLoanApplication.before_submission
                    <ul>
                        <li>@GlobalLoanApplication.review_all_entered_details_to_ensure_accuracy.</li>
                        <li>@GlobalLoanApplication.any_incorrect_information_may_cause_delays_in_approval.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-history text-info me-2"></i> @GlobalLoanApplication.tracking_loan_applications
                    <ul>
                        <li>@GlobalLoanApplication.use_the_loan_query_panel.</li>
                        <li>@GlobalLoanApplication.for_any_further_assistance_reach_out_to_your_loan_officer.</li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        @if (!Model.IsApproved)
        {
            <a type="button"
               href="@Url.Action("EditLoanApplication", "LoanApplication", new { KEY = Model.Id })"
               target="_blank"
               class="btn btn-label-warning btn-sm me-2"
               data-bs-toggle="tooltip"
               title="Edit Loan Application">
                <i class="mdi mdi-pencil mdi-18px"></i> @GlobalShared.Edit
            </a>
        }

        @if (Session["IsHeadOffice"] != null && (bool)Session["IsHeadOffice"])
        {
            <a type="button" class="btn btn-label-danger btn-sm me-2"
               data-bs-toggle="tooltip" title="Delete Loan Application"
               onclick="confirmDelete('@Model.Id')">
                <i class="mdi mdi-trash-can mdi-18px"></i> @GlobalShared.Delete
            </a>
        }

    <a type="button" href="@Url.Action("Index", "LoanApplication")"
       class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="@GlobalLoanApplication.back_to_loan_list">
        <i class="mdi mdi-arrow-left mdi-18px"></i> @GlobalShared.Back
    </a>
    </div>
</div>

<!-- Loan Details Section -->
@if (Model.IsApproved && Model.Loans?.Any() == true)
{
    <div class="card shadow-sm mt-4 mb-2">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="mdi mdi-bank"></i> @GlobalLoanApplication.loan_approval_status
        </div>
        <div class="card-body">
            <!-- Loan Details Table -->
            <table class="table table-bordered table-striped" id="myDataTable">
                <thead>
                    <tr class="table-secondary">
                        <th>@GlobalShared.id</th>
                        <th>@GlobalLoanApplication.l_date</th>
                        <th>@GlobalLoanApplication.l_amount</th>
                        <th>@GlobalLoanApplication.l_rate</th>
                        <th>@GlobalLoanApplication.a_interest</th>
                        <th>@GlobalShared.total_due</th>
                        <th>@GlobalShared.Paid</th>
                        <th>@GlobalShared.Balance</th>
                        <th>@GlobalLoanApplication.n_installment</th>
                        <th>@GlobalShared.Duration</th>
                        <th>@GlobalLoanApplication.m_date</th>
                        <th>@GlobalShared.Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        var totalDue = loan.Principal + loan.AccrualInterest + loan.Fee;
                        <tr>
                            <td>
                                <a href="/Loan/Details?KEY=@loan.Id" target="_blank">
                                    @loan.Id
                                </a>
                            </td>
                            <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanAmount.ToString("#,##0.0")</td>
                            <td>@loan.InterestRate %</td>
                            <td>@loan.AccrualInterest.ToString("#,##0.0")</td>
                            <td>@totalDue.ToString("#,##0.0")</td>
                            <td>@loan.Paid.ToString("#,##0.0")</td>
                            <td>@loan.Balance.ToString("#,##0.0")</td>
                            <td>@loan.NextInstallmentDate.ToString("dd/MM/yyyy")</td>
                            <td>@loan.LoanDuration months</td>
                            <td>@loan.MaturityDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@(loan.LoanStatus == "Active" ? "primary" : (loan.LoanStatus == "Delinquent" ? "danger" : "secondary"))">
                                    @loan.LoanStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mt-2">
        <div class="card-body text-center">
            <div class="alert alert-warning">
                <h5><i class="mdi mdi-alert-circle-outline"></i> @GlobalLoanApplication.loan_not_yet_approved</h5>
                <p class="text-muted">
                    @GlobalLoanApplication.this_loan_application_is_still_under_review.
                </p>
            </div>

            <div class="alert alert-info">
                <i class="mdi mdi-clock-outline me-2"></i>
                <strong>@GlobalShared.Tip:</strong> @GlobalLoanApplication.if_your_loan_application_is_taking_too_long_for_approval_contact_the_loan_dep.
            </div>
        </div>
    </div>
}

<!-- Loan Terms Details -->
<div class="card shadow-sm mt-2">
    <div class="card-header bg-dark text-white fw-bold">
        <i class="mdi mdi-bank"></i> @GlobalLoanApplication.loan_application_terms_details
    </div>
    <div class="card-body">
        <p class="text-muted">
            @GlobalLoanApplication.below_are_the_specific_terms_and_conditions_of_this_loan_application.
        </p>
        @Html.Partial("_Details")
    </div>
</div>
<!-- Scripts -->
@section Scripts {
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
