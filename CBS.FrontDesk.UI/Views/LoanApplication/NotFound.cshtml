@{
    ViewBag.Title = "Loan Application Not Found";
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-danger">
            <i class="mdi mdi-alert-circle-outline me-2"></i> Oops! Loan Application Not Found
        </h1>
        <p class="lead text-muted">
            The loan application you are looking for does not exist, may have been removed, or you may have entered an incorrect Loan ID.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Search & Filters Section -->
<div class="card mb-3 shadow-sm">
    <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
        <span>
            <i class="mdi mdi-filter-outline me-2"></i> Try Searching for Another Loan Application
        </span>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Search Criteria -->
            <div class="col-md-4">
                <label for="searchCriteria" class="form-label fw-bold">Search Criteria:</label>
                <input type="text" id="searchCriteria" class="form-control shadow-sm" placeholder="Enter customer name, branch, or reference..." />
            </div>

            <!-- Loan Category -->
            <div class="col-md-4">
                <label for="loanCategory" class="form-label fw-bold">Loan Category:</label>
                <select id="loanCategory" class="form-select shadow-sm">
                    <option value="all">All</option>
                    <option value="Main_loan">Main Loans</option>
                    <option value="SSF">Special Saving Facilities</option>
                </select>
            </div>

            <!-- Approval Status -->
            <div class="col-md-4">
                <label for="approvalStatus" class="form-label fw-bold">Approval Status:</label>
                <select id="approvalStatus" class="form-select shadow-sm">
                    <option value="all">All</option>
                    <option value="Approved">Approved</option>
                    <option value="Pending">Pending Approval</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
        </div>

        <!-- Search & Back Buttons -->
        <div class="row mt-3">
            <div class="col-md-12 d-flex justify-content-end">
                <button id="searchButton" class="btn btn-primary me-2">
                    <i class="mdi mdi-magnify me-1"></i> Search
                </button>
                <a href="@Url.Action("Index", "LoanApplication")" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left me-1"></i> Back to Loan Applications
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
