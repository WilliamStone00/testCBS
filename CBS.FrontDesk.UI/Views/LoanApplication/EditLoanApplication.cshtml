@model CBS.FrontDesk.Data.Entity.MemberOperation.UpdateLoanApplicationCommand
@{
    ViewBag.Title = "Edit Loan Application";
}

<!-- Page Header -->
<div class="card bg-light mb-4">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-bank-outline me-2"></i> Loan Application Modification
        </h1>
        <p class="card-text">
            This page allows you to modify **loan applications that have not yet been approved or disbursed**.
            Please ensure all details are correctly updated before submitting for approval.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Loan Application Help Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Important Guidelines for Loan Application Modifications</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanEditTips" aria-expanded="false" aria-controls="collapseLoanEditTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanEditTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> **Once a loan is approved or disbursed, it cannot be modified.** If there is an issue with an approved loan, please contact your administrator.</li>

                <li>
                    <i class="mdi mdi-pencil-outline text-primary me-2"></i> **Modifiable Details:**
                    <ul>
                        <li>Requested **Loan Amount**</li>
                        <li>Interest Rate & Loan Duration</li>
                        <li>Repayment Terms & Grace Period</li>
                        <li>Guarantor & Collateral Information</li>
                        <li>Coverage details (Savings, Shares, Deposits, Salary, etc.)</li>
                        <li>Applicable **loan fees & charges**</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i> **Non-Modifiable Details:**
                    <ul>
                        <li>Loan Application Date</li>
                        <li>Loan Status (Once Approved, it is Locked)</li>
                        <li>Disbursement Information</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-bank-transfer text-success me-2"></i> **Loan Coverage Requirements:**
                    <ul>
                        <li>Ensure that the total coverage amount (savings, deposits, shares, or salary) meets the loan security requirements.</li>
                        <li>If a **down payment is required**, make sure it is correctly recorded.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> **Before Submission:**
                    <ul>
                        <li>Review all entered details to ensure accuracy.</li>
                        <li>Any incorrect information may cause delays in approval.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-history text-info me-2"></i> **Tracking Loan Applications:**
                    <ul>
                        <li>Use the **Loan Query Panel** to check application status and approvals.</li>
                        <li>For any further assistance, reach out to your loan officer.</li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Loan Application Modification Form -->
<div class="row invoice-preview">
    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
        <button type="button"
                class="accordion-button"
                data-bs-toggle="collapse"
                data-bs-target="#accordionPopoutIcon-3"
                aria-expanded="true"
                aria-controls="accordionPopoutIcon-3">
            <i class="mdi mdi-file-edit-outline me-2"></i>
            <div class="d-flex justify-content-center">
                <div class="fw-bold fs-4" id="panelTitle">MODIFY LOAN APPLICATION</div>
            </div>
        </button>
    </h2>
    <br />
    <hr />

    <!-- Member Information Panel -->
    <div class="col-xl-3 col-md-4 col-12 invoice-actions">
        <fieldset class="fieldset-custom">
            <div class="card">
                <div class="card-body">
                    <h4 class="group-title">
                        MEMBER REFERENCE # <span class="highlight-text">@Model.Customer.CustomerId</span><br />
                        <hr />
                        <small>Bank Code: @Session["BankCode"].ToString()</small><br />
                        <small>Branch Code: @Session["BranchCode"].ToString()</small>
                    </h4>
                </div>
            </div>
            <br />
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title text-left mb-0">Member: @Model.Customer.name</h5>
                    <hr />
                    @if (Model.Customer.photoUrl != null)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                            <img src="@Model.Customer.photoUrl" class="img-fluid preview-image" alt="Uploaded Image">
                        </a>
                    }
                    else
                    {
                        <img src="@Url.Content(Model.Customer.ImageNoVirtualPath)" class="img-fluid preview-image" alt="No Photo Found">
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <!-- Loan Application Modification Form Section -->
    <div class="col-xl-9 col-lg-8 col-md-8 order-0 order-md-1">
        <fieldset class="fieldset-custom">
            <div class="card mt-3">
                <div class="card-body text-center">
                    <a href="@Url.Action("Details", "LoanApplication", new { KEY = Model.Id })"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="mdi mdi-arrow-left-circle-outline me-1"></i> Back to Loan Application Details
                    </a>
                </div>
            </div>
        </fieldset>

        <fieldset class="fieldset-custom">
            <div id="datalistingview">
                @Html.Partial("_EditLoanApplication")
            </div>
        </fieldset>
    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script>
    function AjaxPostAndUpdatexxx(form) {
        var formData = new FormData(form);  // Prepare the form data, including any files if present.

        $.ajax({
            url: $(form).attr('action'),  // Use the form's action URL.
            type: 'POST',  // Use POST method for form submission.
            data: formData,  // Send the form data.
            processData: false,  // Prevent jQuery from processing the data.
            contentType: false,  // Allow file uploads.
            success: function (response) {
                if (response.success) {
                    // Handle successful form submission.
                    alert("Loan application updated successfully.");
                    // Optionally, you can reload the page or update some part of the page here.
                } else {
                    // Display error message if submission failed.
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                // Handle AJAX errors.
                alert("An error occurred: " + error);
            }
        });

        return false;  // Prevent default form submission.
    }


    </script>
}
