@model CBS.FrontDesk.Data.Entity.MemberOperation.UpdateLoanApplicationCommand
    @using Resources
@{
    ViewBag.Title = @GlobalLoanApplication.EditLoanApplication;
}

<!-- Page Header -->
<div class="card bg-light mb-4">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-bank-outline me-2"></i> @GlobalLoanApplication.LoanApplicationModification
        </h1>
        <p class="card-text">
            @GlobalLoanApplication.ThisPageAllowsYouToModifyLoanApplications.
            @GlobalLoanApplication.PleaseEnsureAllDetailsAreCorrectlyUpdated.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Loan Application Help Tips -->
<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoanApplication.ImportantGuidelinesForLoanApplicationModifications</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanEditTips" aria-expanded="false" aria-controls="collapseLoanEditTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanEditTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-lock-outline text-danger me-2"></i> @GlobalLoanApplication.OnceAloanIsApprovedOrDisbursedItCannotBeModified.</li>

                <li>
                    <i class="mdi mdi-pencil-outline text-primary me-2"></i> @GlobalLoanApplication.ModifiableDetails
                    <ul>
                        <li>@GlobalLoanApplication.RequestedLoanAmount</li>
                        <li>@GlobalLoanApplication.InterestRateLoanDuration</li>
                        <li>@GlobalLoanApplication.RepaymentTermsGracePeriod</li>
                        <li>@GlobalLoanApplication.GuarantorCollateralInformation</li>
                        <li>@GlobalLoanApplication.CoverageDetails</li>
                        <li>@GlobalLoanApplication.ApplicableLoanFeesCharges*</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalLoanApplication.NonModifiableDetails
                    <ul>
                        <li>@GlobalLoanApplication.LoanApplicationDate</li>
                        <li>@GlobalLoanApplication.LoanStatusOnceApproved</li>
                        <li>@GlobalLoanApplication.DisbursementInformation</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-bank-transfer text-success me-2"></i> @GlobalLoanApplication.LoanCoverageRequirements
                    <ul>
                        <li>@GlobalLoanApplication.EnsureThatTheTotalCoverageAmountMeetTheLoanReq.</li>
                        <li>@GlobalLoanApplication.IfADownPaymentIsRequiredMakeSureItIsCorrectlyRecorded.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalLoanApplication.BeforeSubmission
                    <ul>
                        <li>@GlobalLoanApplication.ReviewAllEnteredDetailsToEnsureAccuracy.</li>
                        <li>@GlobalLoanApplication.AnyIncorrectInformationMayCauseDelaysInApproval.</li>
                    </ul>
                </li>

                <li>
                    <i class="mdi mdi-history text-info me-2"></i> @GlobalLoanApplication.TrackingLoanApplications
                    <ul>
                        <li>@GlobalLoanApplication.UseTheLoanQueryPanel.</li>
                        <li>@GlobalLoanApplication.ForAnyFurtherAssistanceReachOutToYourLoanOfficer.</li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Loan Application Modification Form -->
<div class="row invoice-preview">
    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
        <button type="button"
                class="accordion-button"
                data-bs-toggle="collapse"
                data-bs-target="#accordionPopoutIcon-3"
                aria-expanded="true"
                aria-controls="accordionPopoutIcon-3">
            <i class="mdi mdi-file-edit-outline me-2"></i>
            <div class="d-flex justify-content-center">
                <div class="fw-bold fs-4" id="panelTitle">@GlobalLoanApplication.MODIFY_LOAN_APPLICATION</div>
            </div>
        </button>
    </h2>
    <br />
    <hr />

    <!-- Member Information Panel -->
    <div class="col-xl-3 col-md-4 col-12 invoice-actions">
        <fieldset class="fieldset-custom">
            <div class="card">
                <div class="card-body">
                    <h4 class="group-title">
                        @GlobalLoanApplication.MEMBER_REFERENCE # <span class="highlight-text">@Model.Customer.CustomerId</span><br />
                        <hr />
                        <small>@GlobalLoanApplication.BankCode: @Session["BankCode"].ToString()</small><br />
                        <small>@GlobalLoanApplication.BranchCode: @Session["BranchCode"].ToString()</small>
                    </h4>
                </div>
            </div>
            <br />
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title text-left mb-0">@GlobalLoanApplication.Member: @Model.Customer.name</h5>
                    <hr />
                    @if (Model.Customer.photoUrl != null)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                            <img src="@Model.Customer.photoUrl" class="img-fluid preview-image" alt="@GlobalShared.UploadedImage">
                        </a>
                    }
                    else
                    {
                        <img src="@Url.Content(Model.Customer.ImageNoVirtualPath)" class="img-fluid preview-image" alt="@GlobalShared.NoPhotoFound">
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <!-- Loan Application Modification Form Section -->
    <div class="col-xl-9 col-lg-8 col-md-8 order-0 order-md-1">
        <fieldset class="fieldset-custom">
            <div class="card mt-3">
                <div class="card-body text-center">
                    <a href="@Url.Action("Details", "LoanApplication", new { KEY = Model.Id })"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="mdi mdi-arrow-left-circle-outline me-1"></i> @GlobalLoanApplication.BackToLoanApplicationDetails
                    </a>
                </div>
            </div>
        </fieldset>

        <fieldset class="fieldset-custom">
            <div id="datalistingview">
                @Html.Partial("_EditLoanApplication")
            </div>
        </fieldset>
    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script>
    function AjaxPostAndUpdatexxx(form) {
        var formData = new FormData(form);  // Prepare the form data, including any files if present.

        $.ajax({
            url: $(form).attr('action'),  // Use the form's action URL.
            type: 'POST',  // Use POST method for form submission.
            data: formData,  // Send the form data.
            processData: false,  // Prevent jQuery from processing the data.
            contentType: false,  // Allow file uploads.
            success: function (response) {
                if (response.success) {
                    // Handle successful form submission.
                    alert("Loan application updated successfully.");
                    // Optionally, you can reload the page or update some part of the page here.
                } else {
                    // Display error message if submission failed.
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                // Handle AJAX errors.
                alert("An error occurred: " + error);
            }
        });

        return false;  // Prevent default form submission.
    }


    </script>
}
