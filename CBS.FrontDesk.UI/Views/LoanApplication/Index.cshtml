@model CBS.FrontDesk.Data.Entity.LoanConf.LoanApplication
@{
    ViewBag.Title = "Loan Application Query Overview";
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-finance me-2"></i> LOAN APPLICATION QUERY LOGS
        </h1>
        <p class="card-text">
            Monitor and analyze loan applications, track approvals, and view repayment schedules. This interface allows you to efficiently manage loan applications through dynamic search filters and exportable reports.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Search & Filters Section -->
<div class="card mb-3 shadow-sm">
    <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
        <span>
            <i class="mdi mdi-filter-outline me-2"></i> Loan Application Search and Filters
        </span>
        <button id="toggleFilterButton" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#filterContent">
            <i class="mdi mdi-chevron-down"></i> Show Filters
        </button>
    </div>
    <div class="card-body collapse" id="filterContent">
        <div class="row">
            <!-- Date Filters -->
            <div class="col-md-3">
                <label for="dateFrom" class="form-label fw-bold">Date From:</label>
                <input type="text" id="dateFrom" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-3">
                <label for="dateTo" class="form-label fw-bold">Date To:</label>
                <input type="text" id="dateTo" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>

            <!-- Loan Category & Target -->
            <div class="col-md-3">
                <label for="loanCategory" class="form-label fw-bold">Loan Category:</label>
                <select id="loanCategory" class="form-select shadow-sm">
                    <option value="all">All</option>
                    <option value="Main_loan">Main Loans</option>
                    <option value="SSF">Special Saving Facilities</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="approvalStatus" class="form-label fw-bold">Approval Status:</label>
                <select id="approvalStatus" class="form-select shadow-sm">
                    <option value="all">All</option>
                    <option value="Approved">Approved</option>
                    <option value="Pending">Pending Approval</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-3">
                <label for="searchCriteria" class="form-label fw-bold">Search Criteria:</label>
                <input type="text" id="searchCriteria" class="form-control shadow-sm" placeholder="Enter customer name, branch, or reference..." />
            </div>
            <div class="col-md-3">
                <label for="loanTarget" class="form-label fw-bold">Loan Target:</label>
                <select id="loanTarget" class="form-select shadow-sm">
                    <option value="all">All</option>
                    <option value="Employee">Employee</option>
                    <option value="Government">Government</option>
                    <option value="Groups">Groups</option>
                </select>
            </div>

            <!-- Branch Selection -->
            <div class="col-md-6">
                <label for="branchInput" class="form-label fw-bold">Branch:</label>
                @Html.DropDownListFor(
                    m => m.BranchId,
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "---Select All---",
                    new { @class = "form-control shadow-sm select2", @id = "branchInput" }
                )
            </div>
        </div>

        <!-- Search & Reset Buttons -->
        <div class="row mt-3">
            <div class="col-md-12 d-flex justify-content-end">
                <button id="searchButton" class="btn btn-primary me-2">
                    <i class="mdi mdi-magnify me-1"></i> Search
                </button>
                <button id="resetButton" class="btn btn-secondary me-2">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filter
                </button>
                <button id="exportButton" class="btn btn-success" onclick="exportLoanData()">
                    <i class="mdi mdi-file-excel me-1"></i> Export
                </button>
            </div>
        </div>

    </div>
</div>



<!-- Loan Applications Table -->
<div class="card shadow-sm" id="loanApplicationDataCard" style="display: none;">
    <div class="card-header bg-light text-dark fw-bold">
        <i class="mdi mdi-table me-2"></i> Loan Application Data Table
    </div>
    <div class="card-body">
        <div id="loanApplicationDataTableContainer">
            @Html.Partial("_LoanApplicationData")
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
