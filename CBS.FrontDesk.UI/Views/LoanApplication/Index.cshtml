@model CBS.FrontDesk.Data.Entity.LoanConf.LoanApplication
    @using Resources
@{
    ViewBag.Title = @GlobalLoanApplication.loan_application_query_overview;
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-finance me-2"></i> @GlobalLoanApplication.loan_application_query_logs
        </h1>
        <p class="card-text">
            @GlobalLoanApplication.monitor_and_analyze_loan_applications.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </div>
</div>

<!-- Search & Filters Section -->
<div class="card mb-3 shadow-sm">
    <div class="card-header bg-light text-dark fw-bold d-flex justify-content-between align-items-center">
        <span>
            <i class="mdi mdi-filter-outline me-2"></i>@GlobalLoanApplication.loan_application_search_and_filters
        </span>
        <button id="toggleFilterButton" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#filterContent">
            <i class="mdi mdi-chevron-down"></i> @GlobalShared.Show_Filters
        </button>
    </div>
    <div class="card-body collapse" id="filterContent">
        <div class="row">
            <!-- Date Filters -->
            <div class="col-md-3">
                <label for="dateFrom" class="form-label fw-bold">@GlobalShared.date_from:</label>
                <input type="text" id="dateFrom" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-3">
                <label for="dateTo" class="form-label fw-bold">@GlobalShared.date_to:</label>
                <input type="text" id="dateTo" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>

            <!-- Loan Category & Target -->
            <div class="col-md-3">
                <label for="loanCategory" class="form-label fw-bold">@GlobalShared.Loan_Category:</label>
                <select id="loanCategory" class="form-select shadow-sm">
                    <option value="all">@GlobalShared.All</option>
                    <option value="Main_loan">@GlobalShared.main_loans</option>
                    <option value="SSF">@GlobalLoanApplication.special_saving_facilities</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="approvalStatus" class="form-label fw-bold">@GlobalShared.Approval_status:</label>
                <select id="approvalStatus" class="form-select shadow-sm">
                    <option value="all">@GlobalShared.All</option>
                    <option value="Approved">@GlobalShared.Approved</option>
                    <option value="Pending">@GlobalShared.Pending Approval</option>
                    <option value="Rejected">@GlobalShared.Rejected</option>
                </select>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-3">
                <label for="searchCriteria" class="form-label fw-bold">@GlobalShared.Search_Criteria:</label>
                <input type="text" id="searchCriteria" class="form-control shadow-sm" placeholder="@GlobalLoanApplication.enter_customer_name_branch_or_reference..." />
            </div>
            <div class="col-md-3">
                <label for="loanTarget" class="form-label fw-bold">@GlobalShared.Loan_Target:</label>
                <select id="loanTarget" class="form-select shadow-sm">
                    <option value="all">@GlobalShared.All</option>
                    <option value="Employee">@GlobalShared.employee</option>
                    <option value="Government">@GlobalShared.government</option>
                    <option value="Groups">@GlobalShared.Groups</option>
                </select>
            </div>

            <!-- Branch Selection -->
            <div class="col-md-6">
                <label for="branchInput" class="form-label fw-bold">@GlobalShared.Branch:</label>
                @Html.DropDownListFor(
                    m => m.BranchId,
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "---"+ @GlobalShared.Select_All+"---",
                    new { @class = "form-control shadow-sm select2", @id = "branchInput" }
                )
            </div>
        </div>

        <!-- Search & Reset Buttons -->
        <div class="row mt-3">
            <div class="col-md-12 d-flex justify-content-end">
                <button id="searchButton" class="btn btn-primary me-2">
                    <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
                </button>
                <button id="resetButton" class="btn btn-secondary me-2">
                    <i class="mdi mdi-refresh me-1"></i> @GlobalShared.ResetFilter
                </button>
                <button id="exportButton" class="btn btn-success" onclick="exportLoanData()">
                    <i class="mdi mdi-file-excel me-1"></i> @GlobalShared.Export
                </button>
            </div>
        </div>

    </div>
</div>



<!-- Loan Applications Table -->
<div class="card shadow-sm" id="loanApplicationDataCard" style="display: none;">
    <div class="card-header bg-light text-dark fw-bold">
        <i class="mdi mdi-table me-2"></i> @GlobalShared.loan_application_data_table
    </div>
    <div class="card-body">
        <div id="loanApplicationDataTableContainer">
            @Html.Partial("_LoanApplicationData")
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/LoanApplicationHistory/LoanApplicationQuery.js"></script>
}
