@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalMemberOrdinaryAccountsF8.DownloadedFiles</legend>
    @if (Model.FileDownloadInfoLoans.Count == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalMemberOrdinaryAccountsF8.NoFileFound</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalMemberOrdinaryAccountsF8.Date</th>
                        <th>@GlobalMemberOrdinaryAccountsF8.FileName</th>
                        <th>@GlobalMemberOrdinaryAccountsF8.Size</th>
                        <th>@GlobalMemberOrdinaryAccountsF8.User</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.FileDownloadInfoLoans.OrderByDescending(d => d.DateInitiated))
                    {
                        <tr>
                            <td style="width:20%">@d.DateInitiated</td>
                            <td style="width:35%">@d.FileName</td>
                            <td style="width:10%">@d.Size</td>
                            <td style="width:17%">@d.UserName</td>
                            <td style="width:18%">
                                <a href="/MemberOrdinaryAccountsF8/DownloadFileF8?fileId=@d.Id" onclick="" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.FileName @GlobalShared.ToDownload">@GlobalShared.Download</a> |
                                <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.FileName" onclick="DeleteRecordThenReloadPage('MemberOrdinaryAccountsF8','@d.Id')">@GlobalShared.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }


</fieldset>
