@model List<CBS.FrontDesk.Data.Entity.LoanConf.FileDownloadInfo>

<fieldset class="fieldset-custom">
    <legend id="select_base">Downloaded Files</legend>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center my-3">
            <p>No downloaded files found.</p>
        </div>
    }
    else
    {
        <div class="text-end mb-2">
            <button class="btn btn-danger btn-sm" onclick="DeleteAllDownloads()" data-bs-toggle="tooltip" title="Delete all downloaded files">
                <i class="mdi mdi-delete-outline"></i> Delete All
            </button>
        </div>

        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%">Date</th>
                        <th style="width: 35%">File Name</th>
                        <th style="width: 10%">Size</th>
                        <th style="width: 17%">User</th>
                        <th style="width: 18%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderByDescending(d => d.DateInitiated))
                    {
                        <tr>
                            <td>@d.DateInitiated.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@d.FileName</td>
                            <td>@d.Size</td>
                            <td>@d.UserName</td>
                            <td>
                                <a href="@Url.Action("DownloadFileF8", "MemberOrdinaryAccountsF8", new { fileId = d.Id })"
                                   class="me-2"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Click to download @d.FileName">
                                    Download
                                </a> |
                                <a href="#"
                                   class="ms-2 text-danger"
                                   onclick="DeleteRecordThenReloadPage('MemberOrdinaryAccountsF8','@d.Id')"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Delete @d.FileName">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
<script>
    function DeleteAllDownloads() {
        if (confirm("Are you sure you want to delete all downloaded files?")) {
            $.ajax({
                url: '/MemberOrdinaryAccountsF8/DeleteAllDownloads',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || "An error occurred while deleting.");
                    }
                },
                error: function () {
                    alert("Server error during delete all operation.");
                }
            });
        }
    }
</script>
