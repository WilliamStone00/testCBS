@model List<CBS.FrontDesk.Data.Entity.LoanConf.FileDownloadInfo>
@using Resources
<fieldset class="fieldset-custom">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center my-3">
            <p>@GlobalShared.no_downloaded_files_found.</p>
        </div>
    }
    else
    {
 

        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%">@GlobalShared.Date</th>
                        <th style="width: 35%">@GlobalShared.File_Name</th>
                        <th style="width: 10%">@GlobalShared.Size</th>
                        <th style="width: 17%">@GlobalShared.User</th>
                        <th style="width: 18%">@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderByDescending(d => d.DateInitiated))
                    {
                        <tr>
                            <td>@d.DateInitiated.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@d.FileName</td>
                            <td>@d.Size</td>
                            <td>@d.UserName</td>
                            <td>
                                <a href="@Url.Action("DownloadFileF8", "MemberOrdinaryAccountsF8", new { fileId = d.Id })"
                                   class="me-2"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Click to download @d.FileName">
                                    @GlobalShared.Download
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
