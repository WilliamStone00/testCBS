@{
    ViewBag.Title = "Member Balances";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 shadow-sm border-0">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-bank me-2"></i> @GlobalMemberOrdinaryAccountsF8.members_account_balances
                </h1>
                <p class="card-text fs-6">
                    @Html.Raw(@GlobalMemberOrdinaryAccountsF8.this_interface_allows_users_to_view_filter_and_export_detailed_account_balance_information_for_registered_members_across_various_product_types_such_as_savings_deposits_and_shares).
                </p>
                <p class="card-text text-dark">
                    @Html.Raw(@GlobalMemberOrdinaryAccountsF8.the_tool_is_optimized_for_backoffice_teams_accountants_auditors_and_compliance_officers_who_need_to_track_member_balances_and_perform_reconciliation_or_analysis).
                </p>
                <p class="card-text">
                    @Html.Raw(@GlobalMemberOrdinaryAccountsF8.once_filtered_you_can_export_the_results_to_a_structured_excel_file_all_your_generated_downloads_will_appear_below_and_remain_available_until_you_delete_them_manually).
                </p>
                <hr style="border: 2px solid rgba(0, 128, 0, 0.4);" />
            </div>
        </div>
    </div>
</div>


<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalMemberOrdinaryAccountsF8.tips_for_filtering_and_export</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="list-unstyled ms-2">
                <li class="mb-2">
                    <i class="mdi mdi-home-map-marker text-primary me-2"></i>
                    <span class="fw-bold">@GlobalShared.Branch:</span>
                    @GlobalMemberOrdinaryAccountsF8.select_a_branch_to_filter_results_for_members_registered_at_that_location.
                </li>
                <li class="mb-2">
                    <i class="mdi mdi-cash-multiple text-success me-2"></i>
                    <span class="fw-bold">@GlobalShared.Account_type:</span>
                    @GlobalMemberOrdinaryAccountsF8.choose_one_or_more_product_types_eg_saving_deposit_shares_to_refine_your_search.
                </li>
                <li class="mb-2">
                    <i class="mdi mdi-file-export text-info me-2"></i>
                    <span class="fw-bold">@GlobalShared.Export:</span>
                    @Html.Raw(@GlobalMemberOrdinaryAccountsF8.after_applying_filters_click_export_to_excel). @GlobalMemberOrdinaryAccountsF8.the_system_will_prepare_your_file_and_list_it_in_the_downloaded_files_section_below.
                </li>
                <li class="mb-2">
                    <i class="mdi mdi-download-box-outline text-secondary me-2"></i>
                    <span class="fw-bold">@GlobalShared.Download:</span>
                    @GlobalMemberOrdinaryAccountsF8.once_prepared_your_export_file_will_appear_in_the_grid_view_click_on_it_to_download.
                </li>
                <li class="mb-2">
                    <i class="mdi mdi-trash-can-outline text-danger me-2"></i>
                    <span class="fw-bold">@GlobalShared.delete_all:</span>
                    @Html.Raw(@GlobalMemberOrdinaryAccountsF8.if_the_grid_becomes_too_heavy_or_you_no_longer_need_old_exports_use_the_delete_all_button_to_clear_all_your_downloaded_files).
                </li>
            </ul>
        </div>
    </div>
</div>


@using (Html.BeginForm("ExportMemberAccountBalances", "MemberOrdinaryAccountsF8", FormMethod.Post, new { id = "exportForm" }))
{
    <div class="card shadow p-3 mb-2">
        <h5 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.filter_options</h5>
        <div class="card p-3 bg-light">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.Branch</label>
                    @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), $"--- {@GlobalShared.Select_Branch} ---", new { @class = "form-control select2" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.Account_Types</label>
                    @Html.ListBox("AccountTypes", new MultiSelectList(ViewBag.AccountTypes, "Value", "Text"), new { @class = "form-control select2", multiple = "multiple" })
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.account_profile</label>
                    @Html.DropDownList("accountProfile", new SelectList(ViewBag.AccountProfiles, "Value", "Text"), $"--- {@GlobalShared.select_profile} ---", new { @class = "form-control select2", id = "accountProfile" })
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12 d-flex">
                <button type="submit" id="exportBtn" class="btn btn-primary w-100 me-2">
                    <i class="mdi mdi-file-export"></i> @GlobalShared.export_to_excel
                </button>
                <button type="button" id="reloadFilterBtn" class="btn btn-dark w-100">
                    <i class="mdi mdi-refresh"></i> @GlobalShared.Reload
                </button>
            </div>
        </div>
    </div>
}


<div class="card shadow-sm border-0 mb-2">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 text-dark">
            <i class="mdi mdi-download-box-outline me-1"></i> @GlobalShared.downloaded_files
        </h6>
        <button class="btn btn-danger btn-sm" onclick="DeleteAllDownloads()">
            <i class="mdi mdi-trash-can-outline me-1"></i> @GlobalShared.delete_all
        </button>
    </div>
    <div class="card-body p-3" id="downloadListContainer">
        @Html.Partial("_FileDownloadData")
    </div>
</div>





@section Scripts {
    <script>
        $(document).ready(function () {
            // Reload filter data (same as re-applying with current filters)
            $("#reloadFilterBtn").click(function () {
                location.reload();
            });

        // Export to Excel
        $('#exportBtn').click(function (e) {
            e.preventDefault();

            var form = $('#exportForm');
            var formData = form.serialize();

            $.ajax({
                url: form.attr('action'),
                method: 'POST',
                data: formData,
                traditional: true,
                beforeSend: function () {
                    $('#exportBtn').prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin"></i> Exporting...');
                },
                success: function (html) {
                    $('#downloadListContainer').html(html);
                    appalert("✅ Export completed and file ready for download.", 1, 3); // type: success
                },
                error: function (xhr) {
                    appalert("❌ Export failed: " + xhr.responseText, 3, 4); // type: error
                },
                complete: function () {
                    $('#exportBtn').prop('disabled', false).html('<i class="mdi mdi-file-export"></i> Export to Excel');
                }
            });
        });

        // Apply filter and reload member balances
$("#applyFilterBtn").click(function () {
    var data = {
        branchId: $("#branchId").val(),
        accountTypes: $("#accountTypes").val(),
        accountProfile: $("#accountProfile").val()
    };

    if (!data.branchId || data.accountTypes.length === 0 || !data.accountProfile) {
        appalert("⚠️ Please select Branch, Account Types, and Account Profile.", 2, 4); // type: warning
        return;
    }

    $.ajax({
        url: '@Url.Action("GetFilteredMemberBalances", "MemberOrdinaryAccountsF8")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (result) {
            $("#memberBalancesTableView").html(result);
        },
        error: function () {
            appalert("❌ An error occurred while loading member balances.", 3, 4);
        }
    });
});

        // Reset filter inputs
        $("#resetFilterBtn").click(function () {
            $("#branchId").val("").trigger("change");
            $("#accountTypes").val([]).trigger("change");
        });
    });

    // Delete all downloaded files with confirmation
    function DeleteAllDownloads() {
        alertify.confirm(
            'Delete All Downloads',
            'Are you sure you want to delete all downloaded files?',
            function () {
                $.ajax({
                    url: '/MemberOrdinaryAccountsF8/DeleteAllFiles',
                    type: 'POST',
                    success: function (response) {
                        $('#downloadListContainer').html(response);
                        appalert("✅ All downloaded files deleted successfully.", 1, 4);
                    },
                    error: function (xhr) {
                        let message = xhr.responseText || "An unexpected server error occurred.";
                        appalert("❌ " + message, 3, 4);
                    }
                });
            },
            function () {
                appalert("ℹ️ Operation cancelled by user.", 2, 3); // type: info/warning
            }
        ).set({ labels: { ok: 'Yes, Delete', cancel: 'Cancel' } });
    }
    </script>
}
