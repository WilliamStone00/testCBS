@{
    ViewBag.Title = "Members F8 Balances";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header d-flex justify-content-between align-items-center" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-excel me-2"></i> Members Accounts F8
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="accordion-body">
                                        <div id="datalistingviewx">
                                            <br />
                                            @Html.Partial("_SearchBox")
                                        </div>
                                        <div id="datalistingview">
                                            @Html.Partial("_FileDownloadData")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

<script>
    $(document).ready(function () {
        $('#myDataTable').DataTable({
            "paging": true,
            "ordering": true,
            "searching": true,
            "order": [[1, 'desc']], // Order by the second column (index 1) in descending order (date column)
            "columnDefs": [
                { type: 'date', targets: 1 } // Set the type of column 1 (date column) to 'date' for proper sorting
            ],
            "buttons": ['excel', 'csv', 'pdf', 'print'] // Enable export buttons
        });
    });
</script>


}










