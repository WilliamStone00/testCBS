@model CBS.FrontDesk.Data.Entity.LoanConf.Loan
@using Resources
<fieldset class="fieldset-custom">
    <legend>@GlobalMemberOrdinaryAccountsF8.export_members_account_balances</legend>
    <form method="post" action="/MemberOrdinaryAccountsF8/DownloadFileF8/">
        <div class="row g-4">
            <div class="col-md-12">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="branchInput">@GlobalShared.Branch</label>
                        <div class="input-group">
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.InitiateLoanDownloadCommand.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---"+ @GlobalShared.Select_Branch+"---", new { @class = "form-control shadow-box select2", @id = "branchInput" })
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-default btn-sm w-100">@GlobalShared.Initiate_Download</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</fieldset>


