@model CBS.FrontDesk.Data.Entity.LoanConf.Loan

<fieldset class="fieldset-custom">
    <legend>Export Members Account Balances</legend>
    <form method="post" action="/MemberOrdinaryAccountsF8/DownloadFileF8/">
        <div class="row g-4">
            <div class="col-md-12">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="branchInput">Branch</label>
                        <div class="input-group">
                            @Html.DropDownListFor(m => m.InitiateLoanDownloadCommand.BranchId, new SelectList(ViewBag.Branches, "id", "name"), "---Select Branch---", new { @class = "form-control shadow-box select2", @id = "branchInput" })
                            <button type="submit" class="btn btn-default btn-sm">Initiate Download</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</fieldset>

