@model IEnumerable<CBS.FrontDesk.Data.Entity.CustomerCategory>
@using Resources
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>@GlobalMembersCategory.Name</th>
            <th>@GlobalMembersCategory.Description</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:25%">@d.Name</td>
                <td style="width:60%">@d.Description</td>
                <td style="width:15%">
                    <a href="#" onclick="AddOrUpdateGen('@d.Id','datalistingview','_CustomerCategory','get','MembersCategory')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.Name @GlobalShared.ToEdit">@GlobalShared.Edit</a> |
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.Name" onclick="DeleteRecordDataTable('MembersCategory','@d.Id','myDataTable','_CustomerCategoryData',0,'datalistingview')">@GlobalShared.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

