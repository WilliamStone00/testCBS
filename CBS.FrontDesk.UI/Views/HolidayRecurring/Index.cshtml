@{
    ViewBag.Title = "Holiday Recurring";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="mdi mdi-calendar-outline me-2"></i> Holiday Recurring Configuration</h5>
                <div>
                    <!-- View List Button -->
                    <button class="btn btn-label-primary btn-sm"
                            onclick="LoadDataGen('HolidayRecurring', 'myDataTable', '_Data', 0, 'datalistingview')"
                            data-bs-toggle="tooltip"
                            title="View List">
                        <i class="mdi mdi-view-list mdi-18px"></i> View List
                    </button>

                    <!-- Add New Button -->
                    <button class="btn btn-label-secondary btn-sm"
                            onclick="AddORUpdateGen(null, 'datalistingview', '_Create', 'new', 'HolidayRecurring')"
                            data-bs-toggle="tooltip"
                            title="Add New">
                        <i class="mdi mdi-plus mdi-18px"></i> Add New
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div id="accordionPopoutIcon" class="accordion accordion-popout">
                    <div class="accordion-item active">
                        <h2 class="accordion-header" id="accordionPopoutIconThree">
                            <button class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#accordionPopoutIcon-3"
                                    aria-expanded="true"
                                    aria-controls="accordionPopoutIcon-3">
                                <i class="mdi mdi-cash-multiple me-2"></i> Configure Recurring Holidays
                            </button>
                        </h2>
                        <div id="accordionPopoutIcon-3"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#accordionPopoutIcon">
                            <div class="accordion-body">
                                <!-- Dynamic Content Section -->
                                <div id="mainviewChange">
                                    <div class="change-group">
                                        <div id="datalistingview">
                                            @Html.Partial("_Create")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

