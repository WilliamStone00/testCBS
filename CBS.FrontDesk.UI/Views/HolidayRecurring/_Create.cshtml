@model CBS.FrontDesk.Data.Entity.AccountingDayObject.HolyDayRecurring
     @using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalHoliday.RecurringSet Recurring Holidays</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "HolidayRecurring", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(model => model.Id)

            <div class="row mt-3 gy-4">
                <div class="col-md-5">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        <label for="Month">@GlobalHoliday.Name</label>
                    </div>
                </div>
                <!-- Holiday Type -->
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.HolidayType, new SelectList(ViewBag.HolidayTypes, "Value", "Text"), "---"+ @GlobalHoliday.Select Holiday Type +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.HolidayType, "", new { @class = "text-danger" })
                        <label for="HolidayType">@GlobalHoliday.Holiday Type</label>
                    </div>
                </div>

                <!-- Recurrence Pattern -->
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.RecurrencePattern, new SelectList(ViewBag.RecurrencePatterns, "Value", "Text"), "---"+ @GlobalHoliday.Select Recurrence Pattern +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.RecurrencePattern, "", new { @class = "text-danger" })
                        <label for="RecurrencePattern">@GlobalHoliday.Recurrence Pattern</label>
                    </div>
                </div>

                <!-- Checkbox to toggle Exclude Recurring Day visibility -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.ExcludeRecurringDay, new { @class = "form-check-input", id = "excludeRecurringDayCheck" })
                        <label class="form-check-label" for="excludeRecurringDayCheck">@GlobalHoliday.Exclude Recurring Day</label>
                    </div>
                </div>

                <!-- Recurring Day -->
                <div class="col-md-12" id="recurringDayDive">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.RecurringDay, new SelectList(ViewBag.DayOfWeeks, "Value", "Text"), "---"+ @GlobalHoliday.Select Recurring Day +"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.RecurringDay, "", new { @class = "text-danger" })
                        <label for="RecurringDay">@GlobalHoliday.Recurring Day</label>
                    </div>
                </div>

                <!-- Checkbox to toggle Exclude Day and Month visibility -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.ExludeDayAndMonth, new { @class = "form-check-input", id = "excludeDayMonthCheck" })
                        <label class="form-check-label" for="excludeDayMonthCheck">@GlobalHoliday.Exclude Day and Month</label>
                    </div>
                </div>

                <!-- Month -->
                <div class="col-md-6" id="monthDiv">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Month, new { @class = "form-control", type = "number", min = "0", max = "12" })
                        @Html.ValidationMessageFor(m => m.Month, "", new { @class = "text-danger" })
                        <label for="Month">@GlobalHoliday.Month</label>
                    </div>
                </div>

                <!-- Day of Month -->
                <div class="col-md-6" id="dayOfMonthDiv">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.DayOfMonth, new { @class = "form-control", type = "number", min = "", max = "31" })
                        @Html.ValidationMessageFor(m => m.DayOfMonth, "", new { @class = "text-danger" })
                        <label for="DayOfMonth">@GlobalHoliday.Day of Month</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsGlobal, new { @class = "form-check-input", id = "isGlobalCheck" })
                        <label class="form-check-label" for="isGlobalCheck">@GlobalHoliday.Check to centralise</label>
                    </div>
                </div>

                <div class="col-md-12" id="branchSection" style="display:@(Model?.IsGlobal == true ? "none" : "block");">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId", @search = "true" }
                        )
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label for="BranchId">@GlobalHoliday.Select Branch</label>
                    </div>
                </div>

                <!-- Description -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label for="Description">@GlobalHoliday.Description</label>
                    </div>
                </div>

                <!-- Active Status -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActive" })
                        <label class="form-check-label" for="isActive">@GlobalHoliday.Active Status</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                }
                else
                {
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
                }
            </div>
        }
    </div>
</fieldset>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Function to initialize the form elements and event listeners
        function initializeFormElements() {
            const excludeRecurringDayCheck = document.getElementById("excludeRecurringDayCheck");
            const excludeDayMonthCheck = document.getElementById("excludeDayMonthCheck");
            const recurringDayDiv = document.getElementById("recurringDayDive");
            const monthDiv = document.getElementById("monthDiv");
            const dayOfMonthDiv = document.getElementById("dayOfMonthDiv");
            const isGlobalCheck = document.getElementById("isGlobalCheck");
            const branchSection = document.getElementById("branchSection");

            // Toggle recurring day section visibility
            function toggleRecurringDayDiv() {
                if (excludeRecurringDayCheck.checked) {
                    recurringDayDiv.style.display = "none";
                } else {
                    recurringDayDiv.style.display = "block";
                }
            }

            // Toggle month and day-of-month fields visibility
            function toggleDayMonthFields() {
                console.log("Exclude Day and Month checkbox checked: ", excludeDayMonthCheck.checked);

                if (excludeDayMonthCheck.checked) {
                    console.log("Hiding monthDiv and dayOfMonthDiv...");
                    monthDiv.style.display = "none";
                    dayOfMonthDiv.style.display = "none";
                } else {
                    console.log("Showing monthDiv and dayOfMonthDiv...");
                    monthDiv.style.display = "block";
                    dayOfMonthDiv.style.display = "block";
                }
            }

            // Toggle branch section visibility
            function toggleBranchSection() {
                if (isGlobalCheck.checked) {
                    branchSection.style.display = "none";
                } else {
                    branchSection.style.display = "block";
                }
            }

            // Initial checks on page load
            toggleRecurringDayDiv();
            toggleDayMonthFields();
            toggleBranchSection();

            // Add event listeners for checkbox changes
            excludeRecurringDayCheck.addEventListener("change", toggleRecurringDayDiv);
            excludeDayMonthCheck.addEventListener("change", toggleDayMonthFields);
            isGlobalCheck.addEventListener("change", toggleBranchSection);
        }

        //// Initialize the form elements
        //initializeFormElements();

        //// Reinitialize form elements after an AJAX request (e.g., after partial view update)
        //$(document).on('ajaxComplete', function () {
        //    // Re-run the initialization for newly loaded form elements
        //    initializeFormElements();
        //});
    });
</script>
