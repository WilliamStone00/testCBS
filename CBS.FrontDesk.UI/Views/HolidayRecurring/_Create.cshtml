@model CBS.FrontDesk.Data.Entity.AccountingDayObject.HolyDayRecurring
<fieldset class="fieldset-custom">
    <legend id="select_base">Set Recurring Holidays</legend>
    <div class="card-body">
        @using (Html.BeginForm("Create", "HolidayRecurring", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            @Html.HiddenFor(model => model.Id)

            <div class="row mt-3 gy-4">

                <!-- Holiday Type -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.HolidayType, new SelectList(ViewBag.HolidayTypes, "Value", "Text"), "--- Select Holiday Type ---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.HolidayType, "", new { @class = "text-danger" })
                        <label for="HolidayType">Holiday Type</label>
                    </div>
                </div>

                <!-- Recurrence Pattern -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.RecurrencePattern, new SelectList(ViewBag.RecurrencePatterns, "Value", "Text"), "--- Select Recurrence Pattern ---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.RecurrencePattern, "", new { @class = "text-danger" })
                        <label for="RecurrencePattern">Recurrence Pattern</label>
                    </div>
                </div>

                <!-- Recurring Day -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.RecurringDay, new SelectList(ViewBag.DayOfWeeks, "Value", "Text"), "--- Select Recurring Day ---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.RecurringDay, "", new { @class = "text-danger" })
                        <label for="RecurringDay">Recurring Day</label>
                    </div>
                </div>

                <!-- Checkbox to toggle Month and Day visibility -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.ExludeDayAndMonth, new { @class = "form-check-input", id = "excludeDayMonthCheck" })
                        <label class="form-check-label" for="excludeDayMonthCheck">Exclude Day and Month</label>
                    </div>
                </div>

                <!-- Month -->
                <div class="col-md-6" id="monthDiv">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Month, new { @class = "form-control", type = "number", min = "1", max = "12" })
                        @Html.ValidationMessageFor(m => m.Month, "", new { @class = "text-danger" })
                        <label for="Month">Month</label>
                    </div>
                </div>

                <!-- Day of Month -->
                <div class="col-md-6" id="dayOfMonthDiv">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.DayOfMonth, new { @class = "form-control", type = "number", min = "1", max = "31" })
                        @Html.ValidationMessageFor(m => m.DayOfMonth, "", new { @class = "text-danger" })
                        <label for="DayOfMonth">Day of Month</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsGlobal, new { @class = "form-check-input", id = "isGlobalCheck" })
                        <label class="form-check-label" for="isGlobalCheck">Check to centralise</label>
                    </div>
                </div>

                <div class="col-md-12" id="branchSection" style="display:@(Model?.IsGlobal == true ? "none" : "block");">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                            m => m.BranchId,
                            new SelectList(ViewBag.Branches, "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "BranchId", @search = "true" }
                        )
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                        <label for="BranchId">Select Branch</label>
                    </div>
                </div>


                <!-- Description -->
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", style = "height: 200px;" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        <label for="Description">Description</label>
                    </div>
                </div>

                <!-- Active Status -->
                <div class="col-md-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActive" })
                        <label class="form-check-label" for="isActive">Active Status</label>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                @if (ViewBag.Key != null)
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>
                }
            </div>
        }
    </div>
</fieldset>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const excludeDayMonthCheck = document.getElementById("excludeDayMonthCheck");
        const monthDiv = document.getElementById("monthDiv");
        const dayOfMonthDiv = document.getElementById("dayOfMonthDiv");

        function toggleDayMonthFields() {
            if (excludeDayMonthCheck.checked) {
                monthDiv.style.display = "none";
                dayOfMonthDiv.style.display = "none";
            } else {
                monthDiv.style.display = "block";
                dayOfMonthDiv.style.display = "block";
            }
        }

        // Initial check on page load
        toggleDayMonthFields();

        // Add event listener for changes
        excludeDayMonthCheck.addEventListener("change", toggleDayMonthFields);
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isGlobalCheck = document.getElementById("isGlobalCheck");
        const branchSection = document.getElementById("branchSection");

        function toggleBranchSection() {
            if (isGlobalCheck.checked) {
                branchSection.style.display = "none";
            } else {
                branchSection.style.display = "block";
            }
        }

        // Initial check on page load
        toggleBranchSection();

        // Add event listener for changes
        isGlobalCheck.addEventListener("change", toggleBranchSection);
    });
</script>
