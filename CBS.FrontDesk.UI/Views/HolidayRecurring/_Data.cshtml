@model List<CBS.FrontDesk.Data.Entity.AccountingDayObject.HolyDayRecurring>

<fieldset class="fieldset-custom">
    <legend id="select_base">Configured Recurring Holiday Data</legend>
    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>No recurring holiday is configured yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-striped table-hover table-bordered text-center" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Recurrence Pattern</th>
                        <th>Recurring Day</th>
                        <th>Month</th>
                        <th>Day</th>
                        <th>Status</th>
                        <th>Configuration</th>
                        <th>Branch</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var holiday in Model)
                    {
                        <tr>
                            <td>@holiday.Name</td> <!-- Added Name Column -->
                            <td>@holiday.RecurrencePattern</td>
                            <td>@holiday.RecurringDay</td>
                            <td>@holiday.Month</td>
                            <td>
                                @holiday.DayOfMonth
                                <sup>
                                    @(
                                        (holiday.DayOfMonth % 100 >= 11 && holiday.DayOfMonth % 100 <= 13) ? "th" :
                                        (holiday.DayOfMonth % 10 == 1) ? "st" :
                                        (holiday.DayOfMonth % 10 == 2) ? "nd" :
                                        (holiday.DayOfMonth % 10 == 3) ? "rd" : "th"
                                    )
                                </sup>
                            </td>
                            <td>
                                @if (holiday.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success fs-6">
                                        <i class="fas fa-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger fs-6">
                                        <i class="fas fa-times-circle"></i> Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                @if (holiday.IsGlobal)
                                {
                                    <span class="badge rounded-pill bg-primary fs-6">
                                        <i class="fas fa-globe"></i> Centralised
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary fs-6">
                                        <i class="fas fa-building"></i> Branch-specific
                                    </span>
                                }
                            </td>

                            <td>@(holiday.Branch?.Name ?? "N/A")</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Actions (Show Restriction Icon for Centralised Holidays) -->
                                    @if (holiday.IsGlobal)
                                    {
                                        if (Session["IsHeadOffice"] != null && (bool)Session["IsHeadOffice"])
                                        {
                                            <!-- Edit and Delete Button for Global Holidays if IsHeadOffice is true -->
                                            <button class="btn btn-outline-primary btn-sm d-flex align-items-center"
                                                    onclick="AddORUpdateGen('@holiday.Id', 'datalistingview', '_Create', 'update', 'HolidayRecurring', null, null)"
                                                    data-toggle="tooltip"
                                                    title="Edit @holiday.Name">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </button>

                                            <button class="btn btn-outline-danger btn-sm d-flex align-items-center"
                                                    onclick="DeleteRecordDataTable('HolidayRecurring', '@holiday.Id', 'myDataTable', '_Data', 0, 'datalistingview', null, 'list')"
                                                    data-toggle="tooltip"
                                                    title="Delete @holiday.Name">
                                                <i class="fas fa-trash-alt me-1"></i> Delete
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Restriction Icon for Global Holidays when IsHeadOffice is false -->
                                            <span class="text-danger" data-toggle="tooltip" title="Edit/Delete Restricted">
                                                <i class="fas fa-ban"></i>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Edit and Delete Button for Branch-specific Holidays (Anyone can Edit/Delete) -->
                                        <button class="btn btn-outline-primary btn-sm d-flex align-items-center"
                                                onclick="AddORUpdateGen('@holiday.Id', 'datalistingview', '_Create', 'update', 'HolidayRecurring', null, null)"
                                                data-toggle="tooltip"
                                                title="Edit @holiday.Name">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm d-flex align-items-center"
                                                onclick="DeleteRecordDataTable('HolidayRecurring', '@holiday.Id', 'myDataTable', '_Data', 0, 'datalistingview', null, 'list')"
                                                data-toggle="tooltip"
                                                title="Delete @holiday.Name">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </button>
                                    }
                                </div>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
