@model List<CBS.FrontDesk.Data.Entity.LoanConf.FeeRange>

@if (Model.Count == 0)
{
    <div class="text-center my-3">
        <p>No loan fee type is configured</p>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>from</th>
                    <th>to</th>
                    <th>charges</th>
                    <th>%</th>
                    <th>type</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="width:45%">@d.Fee.Name</td>

                        @if (d.Fee.FeeBase == "Percentage")
                        {
                            <td style="width:10%">N/A</td>
                            <td style="width:10%">N/A</td>
                            <td style="width:10%">N/A</td>
                            <td style="width:5%">@d.PercentageValue.ToString("#,##0.0")%</td>
                        }
                        else if (d.Fee.FeeBase == "Range")
                        {
                            <td style="width:10%">@d.AmountFrom.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.AmountTo.ToString("#,##0.0")</td>
                            <td style="width:10%">@d.Charge.ToString("#,##0.00")</td>
                            <td style="width:5%">N/A</td>
                        }
                        <td style="width:10%">@d.Fee.FeeBase</td>
                        <td style="width:15%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_Create','update','FeeRange')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Fee.Name to edit">Edit</a> |
                            <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Fee.Name" onclick="DeleteRecordDataTable('FeeRange','@d.Id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}




