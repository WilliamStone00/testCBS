@model CBS.FrontDesk.Data.Entity.CustomerManagement.IndividualProfile
@using Resources
<style>
    #radioButtonsContainer div.form-check {
        display: flex;
        align-items: center;
        margin-right: 1rem; /* Adds spacing between items */
    }

        #radioButtonsContainer div.form-check label {
            margin-left: 0.5rem; /* Spacing between radio button and label */
        }
</style>

<div class="col">
    @using (Html.BeginForm("Create", "Individual", FormMethod.Post, new { enctype = "multipart/form-data",id = "memberForm", onsubmit = "return AjaxPostAndUpdateMemberRegistration(this);" }))
    {
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryAddress"
                                aria-expanded="true"
                                aria-controls="collapseDeliveryAddress">
                            @GlobalShared.Profile
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.CustomerId, new { @class = "form-control", @placeholder = "1234", @readonly = true, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.MembersReferenceNumber</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @placeholder = GlobalShared.First_Name, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.First_Name</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @placeholder = @GlobalIndividual.LastName, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.LastName</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Matricule, new { @class = "form-control", @placeholder = "1234" })
                                            @Html.ValidationMessageFor(m => m.Matricule, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.MembersMatriculeNumber</label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="CustomerType" class="form-label">@GlobalIndividual.SelectMemberAccountType</label>
                                        @Html.DropDownListFor(m => m.CustomerType,
                                            new List<SelectListItem>
                                            {
                                                new SelectListItem { Value = "MemberAccount", Text = "Regular member account", Selected = true },
                                                new SelectListItem { Value = "AffiliateMemberSalaryAccount", Text = @GlobalIndividual.TemporalSalaryAccountForMembersAssociatedToOtherAffiliates },
                                                new SelectListItem { Value = "UnknownSalaryMemberAccount", Text = @GlobalIndividual.TemporalSalaryAccountForNoneRegularizedMembers },
                                                new SelectListItem { Value = "DailyCollection", Text = @GlobalIndividual.DailyServersAccount },
                                                new SelectListItem { Value = "MobileMoneyMTN", Text = @GlobalIndividual.MTNMoneyCollectiveAccountForNoneRegularizedMembers },
                                                new SelectListItem { Value = "MobileMoneyOrange", Text = @GlobalIndividual.OrangeMoneyCollectiveAccountForNoneRegularizeMembers },
                                                new SelectListItem { Value = "Remittance", Text = @GlobalIndividual.RemittanceCollectiveAccountForNoneRegularizedMembers }
                                            },
                                            new { @class = "form-select shadow-input-boxes", id = "CustomerType", @required = "required" }
                                        )
                                    </div>


                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.Gender, new SelectList(ViewBag.genders, "Text", "Value"), "---" + @GlobalIndividual.SelectGender + "---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.Gender</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", @type = "date", @placeholder = GlobalShared.Date_of_birth, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Date_of_birth</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.PlaceOfBirth, new { @class = "form-control", @placeholder = GlobalShared.Place_of_Birth, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.PlaceOfBirth, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Place_of_Birth</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", @placeholder = GlobalShared.Phone_Number, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Phone_Number</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control", @placeholder = @GlobalIndividual.NationalIDCardNumber, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.IDNumber, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.NationalIDCard</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumberIssueDate, new { @class = "form-control", @type = "date", @placeholder = GlobalShared.Date_issued, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.IDNumberIssueDate, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.Date_issued</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.IDNumberIssueAt, new { @class = "form-control", @placeholder = GlobalShared.PlaceOfIssued, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.IDNumberIssueAt, "", new { @class = "text-danger" })
                                            <label>@GlobalShared.PlaceOfIssued</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.TaxIdentificationNumber, new { @class = "form-control", @placeholder = @GlobalIndividual.PersonnalIdentificationNumber })
                                            @Html.ValidationMessageFor(m => m.TaxIdentificationNumber, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.PersonnalIdentificationNumber</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.EconomicActivitiesId, new SelectList(ViewBag.EconomicActivities, "Id", "Name"), "---" + @GlobalIndividual.SelectEconomicActivity + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.EconomicActivitiesId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">@GlobalIndividual.EconomicActivity</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Occupation, new { @class = "form-control", @placeholder = @GlobalIndividual.Occumation, @required = "required" })
                                            @Html.ValidationMessageFor(m => m.Occupation, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.Occupation</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.Language, new SelectList(ViewBag.languages, "Text", "Value"), "---" + @GlobalIndividual.SelectLanguage + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">@GlobalIndividual.Language</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.CustomerCategoryId, new SelectList(ViewBag.Categories, "Value", "Text"), "---" + @GlobalIndividual.SelectMembersCategory + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.CustomerCategoryId, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">@GlobalIndividual.SelectMembersCategory</label>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.CustomerStatus,
                                                ViewBag.MemberStatuses as List<SelectListItem>,
                                                "--- Select Member Status ---",
                                                new { @class = "form-control select2", @required = "required" })

                                            @Html.ValidationMessageFor(m => m.CustomerStatus, "", new { @class = "text-danger" })
                                            <label>Select Member Status</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        @Html.CheckBoxFor(model => model.IsPoliticaExposed, new { @class = "form-check-input" })
                                        @Html.LabelFor(model => model.IsPoliticaExposed, "Select Exposed status", new { @class = "form-check-label" })
                                    </div>
                                    <div id="pepDetails" class="row">
                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.DropDownListFor(m => m.PoliticaExposedQuestion,
                                                    ViewBag.politicalstatuses as List<SelectListItem>,
                                                    "--- Select  status ---",
                                                    new { @class = "form-control select2" })

                                                @Html.ValidationMessageFor(m => m.PoliticaExposedQuestion, "", new { @class = "text-danger" })
                                                <label>Polictical question</label>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.PoliticaExposedAnswer, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.PoliticaExposedAnswer, "", new { @class = "text-danger" })
                                                <label>Political Response</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
</fieldset>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod3">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod3"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod3">
                            @GlobalShared.Address
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod3"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod3"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.CountryId,
                                                new SelectList(ViewBag.Countries, "Id", "Name"),
                                                "---"+ @GlobalIndividual.SelectCountry+"---",
                                                new { @class = "form-control select2", @id = "CountryId", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.CountryId, "", new { @class = "text-danger" })
                                            <label for="CountryId">@GlobalShared.Country</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.RegionId,
                                                new SelectList(ViewBag.Regions, "Id", "Name"),
                                                "---"+ GlobalShared.Select_Region+"---",
                                                new { @class = "form-control select2", @id = "RegionId", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.RegionId, "", new { @class = "text-danger" })
                                            <label for="RegionId">@GlobalShared.Region</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.DivisionId,
                                                new SelectList(ViewBag.Divisions, "Id", "Name"),
                                                "---"+ @GlobalIndividual.SelectDivision+"---",
                                                new { @class = "form-control select2", @id = "DivisionId", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.DivisionId, "", new { @class = "text-danger" })
                                            <label for="DivisionId">@GlobalShared.Division</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.SubDivisionId,
                                                new SelectList(ViewBag.SubDivisions, "Id", "Name"),
                                                "---"+ @GlobalIndividual.SelectSubDivision+"---",
                                                new { @class = "form-control select2", @id = "SubDivisionId", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.SubDivisionId, "", new { @class = "text-danger" })
                                            <label for="SubDivisionId">@GlobalShared.SubDivision</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.TownId,
                                                new SelectList(ViewBag.Towns, "Id", "Name"),
                                                "---" + @GlobalIndividual.SelectTown+"---",
                                                new { @class = "form-control select2", @id = "TownId", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.TownId, "", new { @class = "text-danger" })
                                            <label for="TownId">@GlobalShared.Town</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", @placeholder = GlobalShared.Address , @required = "required", @id = "Address" })
                                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                            <label for="Address">@GlobalShared.Address</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = GlobalShared.Email, @required = "required", @id = "Email" })
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            <label for="Email">@GlobalShared.Email</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Fax, new { @class = "form-control", @placeholder = @GlobalIndividual.FaxNumber, @id = "Fax" })
                                            @Html.ValidationMessageFor(m => m.Fax, "", new { @class = "text-danger" })
                                            <label for="Fax">@GlobalIndividual.FaxNumber</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.POBox, new { @class = "form-control", @placeholder = @GlobalIndividual.PostBoxNumber, @id = "POBox" })
                                            @Html.ValidationMessageFor(m => m.POBox, "", new { @class = "text-danger" })
                                            <label for="POBox">@GlobalIndividual.PostBoxNumber</label>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.VillageOfOrigin, new { @class = "form-control", @placeholder = @GlobalIndividual.VillageOfOrigin, @required = "required", @id = "VillageOfOrigin" })
                                            @Html.ValidationMessageFor(m => m.VillageOfOrigin, "", new { @class = "text-danger" })
                                            <label for="VillageOfOrigin">@GlobalIndividual.VillageOfOrigin </label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod5">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod5"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod5">
                            @GlobalShared.Marital_Status
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod5"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod5"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.MaritalStatus, new SelectList(ViewBag.maritalStatuses, "Text", "Value"), "---"+ @GlobalIndividual.SelectMaritalStatus+"---", new { @class = "form-control select2", @search = "true", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.MaritalStatus, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">@GlobalShared.Marital_Status</label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SpouseName, new { @class = "form-control", @placeholder = @GlobalIndividual.SpouseName })
                                            @Html.ValidationMessageFor(m => m.SpouseName, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.SpouseName</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SpouseAddress, new { @class = "form-control", @placeholder = @GlobalIndividual.SpouseAddress })
                                            @Html.ValidationMessageFor(m => m.SpouseAddress, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.SpouseAddress</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SpouseContactNumber, new { @class = "form-control", @placeholder = @GlobalIndividual.SpouseContact })
                                            @Html.ValidationMessageFor(m => m.SpouseContactNumber, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.SpouseContact</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.SpouseOccupation, new { @class = "form-control", @placeholder = @GlobalIndividual.SpouseOccupation })
                                            @Html.ValidationMessageFor(m => m.SpouseOccupation, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.SpouseOccupation</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.NumberOfKids, new { @class = "form-control", @placeholder = @GlobalIndividual.NumberOfKids })
                                            @Html.ValidationMessageFor(m => m.NumberOfKids, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.NumberOfKids</label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryOptions">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryOptions"
                                aria-expanded="false"
                                aria-controls="collapseDeliveryOptions">
                            @GlobalIndividual.WorkingStatus
                        </button>
                    </h2>
                    <div id="collapseDeliveryOptions"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingDeliveryOptions"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.WorkingStatus, new SelectList(ViewBag.workingStatuses, "Text", "Value"), "---"+ @GlobalIndividual.SelectWorkStatus + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.WorkingStatus, "", new { @class = "text-danger " })
                                            <label for="formValidationDob">@GlobalIndividual.WorkStatus</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.EmployerName, new { @class = "form-control", @placeholder = @GlobalIndividual.EmployeerName })
                                            @Html.ValidationMessageFor(m => m.EmployerName, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.EmployeerName</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.EmployerTelephone, new { @class = "form-control", @placeholder = @GlobalIndividual.EmployeerTelephone })
                                            @Html.ValidationMessageFor(m => m.EmployerTelephone, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.EmployeerTelephone</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.EmployerAddress, new { @class = "form-control", @placeholder = @GlobalIndividual.EmployeerAddress })
                                            @Html.ValidationMessageFor(m => m.EmployerAddress, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.EmployeerAddress</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.Income, new { @class = "form-control", @placeholder = @GlobalIndividual.Income })
                                            @Html.ValidationMessageFor(m => m.Income, "", new { @class = "text-danger" })
                                            <label>@GlobalIndividual.SalaryOrIncome</label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingParentInfo">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseParentInfo"
                                aria-expanded="false"
                                aria-controls="collapseParentInfo">
                            @GlobalIndividual.ParentsInformation
                        </button>
                    </h2>
                    <div id="collapseParentInfo"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingParentInfo"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <h5 class="text-primary">@GlobalIndividual.MothersInformation</h5>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.MName, new { @class = "form-control", @placeholder = @GlobalIndividual.MothersFullName, @required = "required" })
