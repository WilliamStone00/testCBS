<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get the checkbox and the container
        const noneMemberAccountCheckbox = document.getElementById('NoneMemberAccount');
        const radioButtonsContainer = document.getElementById('radioButtonsContainer');
        const customerTypeHiddenInput = document.createElement('input'); // Hidden input for CustomerType
        customerTypeHiddenInput.type = 'hidden';
        customerTypeHiddenInput.name = 'CustomerType';
        document.body.appendChild(customerTypeHiddenInput); // Append hidden input to the body

        // Function to toggle visibility
        function toggleRadioButtons() {
            if (noneMemberAccountCheckbox.checked) {
                radioButtonsContainer.style.display = 'block'; // Show the container
                customerTypeHiddenInput.value = ''; // Clear the hidden input value
            } else {
                radioButtonsContainer.style.display = 'none'; // Hide the container
                customerTypeHiddenInput.value = 'MemberAccount'; // Set the hidden input to 'MemberAccount'
            }
        }

        // Initialize visibility on page load
        toggleRadioButtons();

        // Attach the event listener to the checkbox
        noneMemberAccountCheckbox.addEventListener('change', toggleRadioButtons);

        // Ensure the hidden input is updated if no radio button is selected
        const radioButtons = radioButtonsContainer.querySelectorAll('input[type="radio"][name="CustomerType"]');
        radioButtons.forEach(radio => {
            radio.addEventListener('change', () => {
                customerTypeHiddenInput.value = radio.checked ? radio.value : '';
            });
        });
    });
</script>

