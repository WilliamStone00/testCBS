@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile

<div class="card-body">
    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="upload" />
        <input type="hidden" name="CustomerDocumentRequest.DocumentType" value="CustomerPhoto" />
        <div class="form-group">
            <div class="upload-container">
                <div class="image-preview">
                    <img src="@Url.Content(Model.CustomerList.ImageVirtualPath)" alt="No Image Found" id="previewimage" class="img-fluid" />
                </div>
                <label for="imageuploadSignature" class="custom-file-upload">
                    <i class="fas fa-cloud-upload-alt"></i> Choose Photo
                </label>
                <input type="file" name="CustomerDocumentRequest.AttachedFiles" accept="image/jpeg,image/png,image/JPG" id="imageuploadSignature" onchange="ShowImagePreview(this, document.getElementById('previewimage'))" />
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Upload Photo</button>
        </div>
    }
</div>
