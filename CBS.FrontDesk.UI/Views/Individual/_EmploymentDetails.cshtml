@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources
<div class="card-body">


    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="employmentdetail" id="option" />
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.WorkingStatus, new SelectList(ViewBag.workingStatuses, "Text", "Value"), "---"+ @GlobalIndividual.SelectWorkStatus +"---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.CustomerList.WorkingStatus, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.Work_status</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.EmployerName, new { @class = "form-control", @placeholder = GlobalShared.Employeer_name })
                @Html.ValidationMessageFor(m => m.CustomerList.EmployerName, "", new { @class = "text-danger" })
                <label>@GlobalShared.Employeer_name</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.EmployerTelephone, new { @class = "form-control", @placeholder = GlobalShared.Employeer_telephone })
                @Html.ValidationMessageFor(m => m.CustomerList.EmployerTelephone, "", new { @class = "text-danger" })
                <label>@GlobalShared.Employeer_telephone</label>
            </div>
        </div>
        <div class="col-md-8">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.EmployerAddress, new { @class = "form-control", @placeholder = GlobalShared.Employeer_address })
                @Html.ValidationMessageFor(m => m.CustomerList.EmployerAddress, "", new { @class = "text-danger" })
                <label>@GlobalShared.Employeer_address</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Income, new { @class = "form-control", @placeholder = GlobalShared.Income })
                @Html.ValidationMessageFor(m => m.CustomerList.Income, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.SalaryOrIncome</label>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">@GlobalShared.Update</button>
        </div>
    }
</div>
