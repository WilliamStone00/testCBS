@model List<CBS.FrontDesk.Data.Entity.CustomerManagement.IndividualProfile>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Customer number</th>
            <th>phone</th>
            <th>Town</th>
            <th>Branch</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:20%">@d.name</td>
                <td style="width:15%">@d.customerId</td>
                <td style="width:10%">@d.phone</td>
                <td style="width:15%">@d.town</td>
                <td style="width:15%">@d.branch</td>
                <td style="width:10%">@d.activeStatus</td>
                <td style="width:10%">
                    <a href="/Individual/CustomerProfile?KEY=@d.customerId" target="_blank" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Profile</a>
                    @*<a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteRecordDataTable('Individual','@d.customerId','myDataTable','_Data',0,'datalistingview')">Delete</a>*@
                </td>
            </tr>
        }
    </tbody>
</table>




