@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile

<div class="card-body">


    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(model => model.MembershipNextOfKingsMember.CustomerId)
        <input type="hidden" name="option" value="nextofking" id="option" />
        <div class="col-md-9">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.MembershipNextOfKingsMember.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MembershipNextOfKingsMember.Name, "", new { @class = "text-danger " })
                <label>Next of king name</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.MembershipNextOfKingsMember.Ratio, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MembershipNextOfKingsMember.Ratio, "", new { @class = "text-danger " })
                <label>Ratio (In %)</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.MembershipNextOfKingsMember.Relation, new SelectList(ViewBag.relationships, "Value", "Text"), "---Select relation---", new { @class = "form-control select2", @search = "true" })
                @Html.ValidationMessageFor(m => m.MembershipNextOfKingsMember.Relation, "", new { @class = "text-danger " })
                <label for="formValidationDob">Select relationship between @Model.CustomerList.name with this individual</label>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Add next of kings</button>
        </div>
    }
</div>
