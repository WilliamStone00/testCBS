
@{
    ViewBag.Title = "Members";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account-group"></i>&nbsp; Members

                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div class="card mb-4">
                                    <div class="card-body d-sm-flex d-block">
                                        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                            <a type="button" onclick="LoadUsers()" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View List">
                                                <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <!-- Manual Search Bar -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-8 d-flex align-items-center">
                                                <label for="manualSearchInput" class="search-label">Search by account number or member's name or telephone number...</label>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="input-group">
                                                    <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="Enter search criteria...">
                                                    <button class="btn btn-primary" onclick="manualSearch()">Search</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_IndividualData")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>




@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/CustomerManagement/Customers/Customers.js"></script>
}

