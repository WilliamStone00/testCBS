@{
    ViewBag.Title = "Members in " + Session["BranchName"];
}

<div class="container mt-4">
    <header class="text-center mb-4">
        <h1 class="text-primary fw-bold">Members Listing</h1>
        <p class="text-muted">
            This page provides an overview of all members in your branch: <strong>@Session["BranchName"]</strong>.
            You can search for specific members using their Reference number such as 010000365, name, or phone number. Use the tools below to manage and view member details efficiently.
        </p>
        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
    </header>

    <div id="accordionMembers" class="accordion accordion-popout">
        <div class="accordion-item active">
            <h2 class="accordion-header" id="membersHeading">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#membersCollapse" aria-expanded="true" aria-controls="membersCollapse">
                    <i class="mdi mdi-account-group me-2"></i> Members in Branch: <strong>@Session["BranchName"]</strong>
                </button>
            </h2>
            <div id="membersCollapse" class="accordion-collapse collapse show" aria-labelledby="membersHeading" data-bs-parent="#accordionMembers">
                <div class="accordion-body">
                    <!-- Description Section -->
                    <div class="alert alert-info mb-4">
                        <p class="mb-0">
                            <i class="mdi mdi-information-outline me-2"></i>
                            <strong>How to Use This Page:</strong>
                        </p>
                        <ul class="mt-2">
                            <li>Use the search bar to find specific members by entering their account number, name, or phone number.</li>
                            <li>From the displayed list of searched members, click on a member's profile to view and modify their details, such as contact information and account status.</li>
                            <li>To see all members, click on the "View List" button to load all members in the branch.</li>
                            <li>Repeat step 2 to modify other members' accounts as needed.</li>
                        </ul>
                    </div>

                    <div class="card mb-4 shadow">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0"><i class="mdi mdi-account-circle-outline"></i> Members Overview</h5>
                            <button type="button" onclick="LoadUsers()" class="btn btn-label-primary">
                                <i class="mdi mdi-view-list me-2"></i>View List
                            </button>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="card mb-4 shadow">
                        <div class="card-body">
                            <label for="manualSearchInput" class="form-label fw-bold">Search Members</label>
                            <div class="input-group">
                                <input type="text" id="manualSearchInput" class="form-control shadow-box" placeholder="Search by account number, member's name, or phone number..." />
                                <button class="btn btn-primary" onclick="manualSearch()">Search</button>
                            </div>
                            <small class="text-muted mt-2 d-block">Example: Enter "12345", "John Doe", or "0701234567" to find a member.</small>
                        </div>
                    </div>

                    <!-- Members Data Listing -->
                    <div id="datalistingview">
                        @Html.Partial("_IndividualData")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Js/Crud/CustomerManagement/Customers/Customers.js"></script>
}
