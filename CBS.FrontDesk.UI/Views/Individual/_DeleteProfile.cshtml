@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources
<div class="card-header">
    <h5 class="card-title">@GlobalIndividual.AccountStatus</h5>
</div>
<div class="card-body">
    <div class="mb-3 col-12">
        @if (Model.CustomerList.MembershipApprovalStatus != "Approved")
        {
            <span class="badge bg-danger">@GlobalIndividual.AwaitsMembershipApproval</span>
            <div class="alert alert-warning mt-2" role="alert">
                <p>@GlobalIndividual.ThisAccountHasNotYetBeenApprovedForMembership:</p>
                <ul>
                    <li>@GlobalIndividual.PayTheRequiredMembershipDues.</li>
                    <li>@GlobalIndividual.MakeAnInitialOrMinimumDepositIntoTheFollowingAccounts:</li>
                    <ul>
                        <li>@GlobalIndividual.OShare</li>
                        <li>@GlobalIndividual.SavingsAccount</li>
                        <li>@GlobalIndividual.PreferenceShareAccount</li>
                    </ul>
                </ul>
                <p>@GlobalIndividual.OnceTheseRequirementsAreMetTheMembershipStatus.</p>
            </div>
        }
        else
        {
    <span class="badge bg-success">@GlobalIndividual.FullMember</span>
            <div class="alert alert-info mt-2" role="alert">
                <p>@GlobalIndividual.TheMembershipApprovalProcessIsCompleteAnd @Model.CustomerList.name @GlobalIndividual.isNowAfullMember.</p>
            </div>

            if (Model.CustomerList.Active)
            {
                <div class="alert alert-success" role="alert">
                    <h6 class="alert-heading">@Model.CustomerList.name: @GlobalIndividual.accountIsActive.</h6>
                    <p>@GlobalIndividual.UncheckTheBoxAndClickTheDeactivate.</p>
                </div>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    <h6 class="alert-heading">@Model.CustomerList.name's @GlobalIndividual.accountIsDeactivated.</h6>
                    <p>@GlobalIndividual.CheckTheBoxAndClickTheReactivateButton.</p>
                </div>
            }

        }
        <br />
        <br />
        @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
        {
            <!-- Hidden Fields -->
            @Html.HiddenFor(model => model.CustomerList.CustomerId)
            <input type="hidden" name="option" value="Status" id="option" />

                <!-- Activation Toggle -->
                <div class="form-check mb-3">
                    @Html.CheckBoxFor(m => m.CustomerList.Active, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActive">
                        @if (Model.CustomerList.Active)
                        {
                            @:@GlobalIndividual.UncheckToDeactivateTheCustomersAccount
                        }
                        else
                        {
                            @:@GlobalIndividual.CheckToReactivateTheCustomersAccount
                        }
                    </label>
                </div>

            <!-- Action Button -->
            <div class="col-12">
                <button type="submit" class="btn @(Model.CustomerList.Active ? "btn-danger" : "btn-primary")">
                    @if (Model.CustomerList.Active)
                    {
                        @:Deactivate Account
                    }
                    else
                    {
                        @:Reactivate Account
                    }
                </button>
            </div>
        }

    </div>


</div>

