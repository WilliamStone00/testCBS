@{
    ViewBag.Title = "Individual Account Creation";
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-circle me-2"></i> Individual Account Creation
                </h1>
                <p class="card-text text-muted">
                    Create a new member account by filling in the identification details accurately. Ensure all required fields are completed.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Help Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> HELP TIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                Follow these tips to ensure a successful account creation process:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Enter all required personal information (e.g., name, ID, address).</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure the member's contact details are accurate for future communications.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Double-check identification details such as ID numbers or document types.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Attach necessary documents if applicable (e.g., photo, proof of address).</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Use dropdown fields (e.g., gender, marital status) to ensure accurate categorization.</li>

                <!-- New Tips -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Matricules:</strong>
                    <ul>
                        <li>Mandatory for <strong>Civil Servants</strong>. Ensure this field is completed accurately.</li>
                        <li>Leave blank for other account types unless instructed otherwise.</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Salary Information:</strong>
                    <ul>
                        <li>
                            Mandatory for:
                            <ul>
                                <li><strong>Civil Servants</strong></li>
                                <li><strong>Salary Earners</strong></li>
                                <li><strong>Branch Employees</strong></li>
                            </ul>
                        </li>
                        <li>Ensure salary details are accurate and align with the member's profile.</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Member Reference:</strong>
                    <ul>
                        <li>The system will <strong>auto-generate</strong> a serial Member Reference Number if left empty with the default value of <code>0000000</code>.</li>
                        <li>If you enter a custom value, it will be considered as long as it is valid.</li>
                        <li>Member References are a combination of the <strong>Branch Code</strong> and a <strong>7-digit Member Code</strong>.</li>
                        <ul>
                            <li><i class="mdi mdi-information-outline text-primary me-2"></i> For example, a Member Number 1 in Branch 003 will appear as <strong>0030000001</strong>.</li>
                        </ul>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>None Member Accounts:</strong>
                    <ul>
                        <li>
                            Check the <strong>None Member Account</strong> button for collective accounts such as:
                            <ul>
                                <li>Mobile Money</li>
                                <li>Remittance</li>
                                <li>Orange Money</li>
                                <li>Daily Collection</li>
                            </ul>
                        </li>
                        <li>If left unchecked, the system considers it a <strong>Member Account</strong>.</li>
                    </ul>
                </li>
            </ul>
            <p class="text-muted">Note:</p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i> Click <strong>Save</strong> to create the account once all fields are completed.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> If the form cannot be submitted, review the highlighted fields for missing or incorrect information.</li>
            </ul>
        </div>
    </div>
</div>


<div class="row mb-1">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <!-- Member Identification Form -->
            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account-card-details me-2"></i> Member's Identification Form
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div id="datalistingview">
                                    @Html.Partial("_CreateProfile")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {
        // Log version check
        console.log("📦 Cascading Location Dropdowns Initialized");

        $('#CountryId').on('change', function () {
            const countryId = $(this).val();
            console.log("🌍 Country selected:", countryId);
            resetDropdowns(['#RegionId', '#DivisionId', '#SubDivisionId', '#TownId']);

            if (!countryId) return;

            $('#RegionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetRegionsByCountry', { countryId: countryId })
                .done(function (data) {
                    populateDropdown('#RegionId', data, '---Select Region---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading regions:", error);
                    populateDropdown('#RegionId', [], 'Error loading regions');
                });
        });

        $('#RegionId').on('change', function () {
            const regionId = $(this).val();
            console.log("📍 Region selected:", regionId);
            resetDropdowns(['#DivisionId', '#SubDivisionId', '#TownId']);

            if (!regionId) return;

            $('#DivisionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetDivisionsByRegion', { regionId: regionId })
                .done(function (data) {
                    populateDropdown('#DivisionId', data, '---Select Division---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading divisions:", error);
                    populateDropdown('#DivisionId', [], 'Error loading divisions');
                });
        });

        $('#DivisionId').on('change', function () {
            const divisionId = $(this).val();
            console.log("🏛 Division selected:", divisionId);
            resetDropdowns(['#SubDivisionId', '#TownId']);

            if (!divisionId) return;

            $('#SubDivisionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetSubDivisionsByDivision', { divisionId: divisionId })
                .done(function (data) {
                    populateDropdown('#SubDivisionId', data, '---Select Sub-Division---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading sub-divisions:", error);
                    populateDropdown('#SubDivisionId', [], 'Error loading sub-divisions');
                });
        });

        $('#SubDivisionId').on('change', function () {
            const subDivisionId = $(this).val();
            console.log("🏘 Sub-Division selected:", subDivisionId);
            resetDropdowns(['#TownId']);

            if (!subDivisionId) return;

            $('#TownId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetTownsBySubDivision', { subDivisionId: subDivisionId })
                .done(function (data) {
                    populateDropdown('#TownId', data, '---Select Town---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading towns:", error);
                    populateDropdown('#TownId', [], 'Error loading towns');
                });
        });

        function populateDropdown(selector, data, placeholder) {
            const dropdown = $(selector);
            dropdown.empty().append($('<option>').val('').text(placeholder));

            $.each(data, function (i, item) {
                dropdown.append($('<option>').val(item.Id).text(item.Name));
            });

            // If you're using select2
            if (dropdown.hasClass('select2')) {
                dropdown.trigger('change.select2');
            }
        }

        function resetDropdowns(selectors) {
            selectors.forEach(id => {
                $(id).empty().append('<option value="">---Select---</option>');
                if ($(id).hasClass('select2')) {
                    $(id).trigger('change.select2');
                }
            });
        }
    });

    </script>
    <script src="~/Scripts/Js/Crud/CustomerManagement/Customers/Customers.js"></script>
}
