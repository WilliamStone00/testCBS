@using Resources
@{
    ViewBag.Title = @GlobalIndividual.IndividualAccountCreation;
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-circle me-2"></i> @GlobalIndividual.IndividualAccountCreation
                </h1>
                <p class="card-text text-muted">
                    @GlobalIndividual.CreateANewMemberAccountByFillingInTheIdentificationDetailsAccurately.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Help Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalIndividual.HELPTIPS
        </span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseHelpTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">
                @GlobalIndividual.FollowTheseTipsToEnsureAsuccessfulAccountCreationProcess:
            </p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalIndividual.EnterAllRequiredPersonalInformation.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalIndividual.EnsureTheMembersContactDetailsAreAccurate.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalIndividual.DoubleCheckIdentificationDetailsSuchAsIDNumbersOrDocumentTypes.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalIndividual.AttachNecessaryDocumentsIfApplicable.</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalIndividual.UseDropdownFields.</li>

                <!-- New Tips -->
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalIndividual.Matricules:</strong>
                    <ul>
                        <li>@GlobalIndividual.MandatoryFor <strong>@GlobalIndividual.CivilServants</strong>. @GlobalIndividual.EnsureThisFieldIsCompletedAccurately.</li>
                        <li>@GlobalIndividual.LeaveBlankForOtherAccountTypesUnlessInstructedOtherwise.</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalIndividual.SalaryInformation:</strong>
                    <ul>
                        <li>
                            @GlobalIndividual.MandatoryFor:
                            <ul>
                                <li><strong>@GlobalIndividual.CivilServants</strong></li>
                                <li><strong>@GlobalIndividual.SalaryEarners</strong></li>
                                <li><strong>@GlobalIndividual.BranchEmployees</strong></li>
                            </ul>
                        </li>
                        <li>@GlobalIndividual.EnsureSalaryDetailsAreAccurateAndAlignWithTheMembersProfile.</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.Member_reference:</strong>
                    <ul>
                        <li>@GlobalIndividual.TheSystemWill <strong>@GlobalIndividual.AutoGenerate</strong> @GlobalIndividual.aSerialMemberReferenceNumberIfLeftEmptyWithTheDefaultValueOf <code>0000000</code>.</li>
                        <li>@GlobalIndividual.IfYouEnterACustomValueItWillBeConsideredAsLongAsItIsValid.</li>
                        <li>@GlobalIndividual.MemberReferencesAreAcombinationOfThe <strong>@GlobalShared.Branch_Code</strong> @GlobalIndividual.AndA <strong>@GlobalIndividual.DigitMemberCode</strong>.</li>
                        <ul>
                            <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalIndividual.ForExampleAMemberNumber1InBranch003willAppearAs <strong>0030000001</strong>.</li>
                        </ul>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalIndividual.NoneMemberAccounts:</strong>
                    <ul>
                        <li>
                            @GlobalIndividual.CheckThe <strong>@GlobalIndividual.NoneMemberAccount</strong> @GlobalIndividual.buttonForCollectiveAccountsSuchAs:
                            <ul>
                                <li>@GlobalIndividual.MobileMoney</li>
                                <li>@GlobalIndividual.Remittance</li>
                                <li>@GlobalIndividual.OrangeMoney</li>
                                <li>@GlobalIndividual.DailyCollection</li>
                            </ul>
                        </li>
                        <li>@GlobalIndividual.IfLeftUncheckedTheSystemConsidersItA <strong>@GlobalIndividual.MemberAccount</strong>.</li>
                    </ul>
                </li>
            </ul>
            <p class="text-muted">Note:</p>
            <ul>
                <li><i class="mdi mdi-information-outline text-primary me-2"></i>@GlobalShared.Click <strong>@GlobalShared.Save</strong> @GlobalIndividual.toCreateTheAccountOnceAllFieldsAreCompleted.</li>
                <li><i class="mdi mdi-alert-outline text-danger me-2"></i> @GlobalIndividual.IfTheFormCannotBeSubmittedReviewTheHighlightedFields.</li>
            </ul>
        </div>
    </div>
</div>


<div class="row mb-1">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <!-- Member Identification Form -->
            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account-card-details me-2"></i> @GlobalIndividual.MembersIdentificationForm
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div id="datalistingview">
                                    @Html.Partial("_CreateProfile")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {
        // Log version check
        console.log("📦 Cascading Location Dropdowns Initialized");

        $('#CountryId').on('change', function () {
            const countryId = $(this).val();
            console.log("🌍 Country selected:", countryId);
            resetDropdowns(['#RegionId', '#DivisionId', '#SubDivisionId', '#TownId']);

            if (!countryId) return;

            $('#RegionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetRegionsByCountry', { countryId: countryId })
                .done(function (data) {
                    populateDropdown('#RegionId', data, '---Select Region---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading regions:", error);
                    populateDropdown('#RegionId', [], 'Error loading regions');
                });
        });

        $('#RegionId').on('change', function () {
            const regionId = $(this).val();
            console.log("📍 Region selected:", regionId);
            resetDropdowns(['#DivisionId', '#SubDivisionId', '#TownId']);

            if (!regionId) return;

            $('#DivisionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetDivisionsByRegion', { regionId: regionId })
                .done(function (data) {
                    populateDropdown('#DivisionId', data, '---Select Division---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading divisions:", error);
                    populateDropdown('#DivisionId', [], 'Error loading divisions');
                });
        });

        $('#DivisionId').on('change', function () {
            const divisionId = $(this).val();
            console.log("🏛 Division selected:", divisionId);
            resetDropdowns(['#SubDivisionId', '#TownId']);

            if (!divisionId) return;

            $('#SubDivisionId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetSubDivisionsByDivision', { divisionId: divisionId })
                .done(function (data) {
                    populateDropdown('#SubDivisionId', data, '---Select Sub-Division---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading sub-divisions:", error);
                    populateDropdown('#SubDivisionId', [], 'Error loading sub-divisions');
                });
        });

        $('#SubDivisionId').on('change', function () {
            const subDivisionId = $(this).val();
            console.log("🏘 Sub-Division selected:", subDivisionId);
            resetDropdowns(['#TownId']);

            if (!subDivisionId) return;

            $('#TownId').append('<option>Loading...</option>');

            $.getJSON('/Individual/GetTownsBySubDivision', { subDivisionId: subDivisionId })
                .done(function (data) {
                    populateDropdown('#TownId', data, '---Select Town---');
                })
                .fail(function (xhr, status, error) {
                    console.error("❌ Error loading towns:", error);
                    populateDropdown('#TownId', [], 'Error loading towns');
                });
        });

        function populateDropdown(selector, data, placeholder) {
            const dropdown = $(selector);
            dropdown.empty().append($('<option>').val('').text(placeholder));

            $.each(data, function (i, item) {
                dropdown.append($('<option>').val(item.Id).text(item.Name));
            });

            // If you're using select2
            if (dropdown.hasClass('select2')) {
                dropdown.trigger('change.select2');
            }
        }

        function resetDropdowns(selectors) {
            selectors.forEach(id => {
                $(id).empty().append('<option value="">---Select---</option>');
                if ($(id).hasClass('select2')) {
                    $(id).trigger('change.select2');
                }
            });
        }


        function togglePepSection() {
            if ($('#IsPoliticaExposed').is(':checked')) {
                $('#pepDetails').slideDown();
            } else {
                $('#pepDetails').slideUp();
            }
        }

        // Run on page load
        togglePepSection();

        // Run on checkbox change
        $('#IsPoliticaExposed').change(function () {
            togglePepSection();
        });
    });

    </script>
    <script src="~/Scripts/Js/Crud/CustomerManagement/Customers/Customers.js"></script>
}
