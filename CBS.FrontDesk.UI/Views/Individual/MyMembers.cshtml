@using Resources
@{
    ViewBag.Title = @GlobalIndividual.MemberOverview;
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group-outline me-2"></i> @GlobalIndividual.MEMBERSOVERVIEW
                </h1>
                <p class="card-text">
                    @GlobalIndividual.ViewAndManageRegisteredMembersAcrossAllBranches.
                </p>
                <p class="card-text text-warning fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> @GlobalIndividual.LeverageTheFiltersBelowToNarrowResultsByGender.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @GlobalIndividual.TIPS_FOR_FILTERING_MEMBERS_EFFECTIVELY</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.FilterByBranch:</strong> @GlobalIndividual.EasilySegmentMembersByOperationalBranch.</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i> <strong>@GlobalShared.Registration_dates:</strong> @GlobalIndividual.FilterByCreationDateOrBirthDateToTargetSpecificDemographics.</li>
                <li><i class="mdi mdi-gender-male-female text-secondary me-2"></i> <strong>@GlobalIndividual.GenderMaritalStatus:</strong> @GlobalIndividual.AnalyzeMemberBreakdownAcrossKeyAttributes.</li>
                <li><i class="mdi mdi-account-check-outline text-info me-2"></i> <strong>@GlobalIndividual.ApprovalLegalStatus:</strong> @GlobalIndividual.FilterApprovedMembersByLegalFormOrType.</li>
                <li><i class="mdi mdi-file-export-outline text-success me-2"></i> <strong>@GlobalShared.Export:</strong> @GlobalIndividual.ExportSearchResultsToExcelForReportingOrRecordkeeping.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Advanced Filters -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalShared.Member_Filters</h5>
    <form id="memberFilterForm">
        <div class="card p-3 mb-3 bg-light">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.Customer_ID</label>
                    <input type="text" id="customerId" name="CustomerId" class="form-control" placeholder="@GlobalShared.Customer_ID" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.First_Name</label>
                    <input type="text" id="firstName" name="FirstName" class="form-control" placeholder="@GlobalShared.First_Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">@GlobalShared.Last_Name</label>
                    <input type="text" id="lastName" name="LastName" class="form-control" placeholder="@GlobalShared.Last_Name" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Gender</label>
                    <select id="gender" name="Gender" class="form-select">
                        <option value="">@GlobalShared.All</option>
                        <option value="Male">@GlobalShared.Male</option>
                        <option value="Female">@GlobalShared.Female</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Marital_Status</label>
                    <select id="maritalStatus" name="MaritalStatus" class="form-select">
                        <option value="">@GlobalShared.All</option>
                        <option value="Single">@GlobalShared.Single</option>
                        <option value="Married">@GlobalShared.Married</option>
                        <option value="Divorced">@GlobalShared.Divorced</option>
                        <option value="Widowed">@GlobalShared.Widowed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Working_Status</label>
                    <select id="workingStatus" name="WorkingStatus" class="form-select">
                        <option value="">@GlobalShared.All</option>
                        <option value="Working">@GlobalShared.Working</option>
                        <option value="Unemployed">@GlobalShared.Unemployed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Membership_Approval</label>
                    <select id="membershipApprovalStatus" name="MembershipApprovalStatus" class="form-select">
                        <option value="">@GlobalShared.All</option>
                        <option value="Approved">@GlobalShared.Approved</option>
                        <option value="Pending">@GlobalShared.Pending</option>
                        <option value="Rejected">@GlobalShared.Rejected</option>
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalIndividual.LegalForm</label>
                    <select id="legalForm" name="LegalForm" class="form-select">
                        <option value="">All</option>
                        <option value="Physical_Person">@GlobalShared.Physical_Person</option>
                        <option value="Moral_Person">@GlobalShared.Moral_Person</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Customer_Type</label>
                    <input type="text" id="customerType" name="CustomerType" class="form-control" placeholder="Customer Type" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Age_Category</label>
                    <input type="text" id="ageCategoryStatus" name="AgeCategoryStatus" class="form-control" placeholder="@GlobalIndividual.AgeCategoryStatus" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">@GlobalShared.Branch</label>
                    @Html.DropDownList("BranchId", new SelectList(ViewBag.Branches, "Id", "Name"), "---"+ GlobalShared.SelectBranch+"---", new { @class = "form-control select2", @id = "branchId", @name = "BranchId" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalShared.Date_of_Birth_From </label>
                    <input type="date" id="dobFrom" name="DateOfBirthFrom" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalShared.Date_of_Birth_To</label>
                    <input type="date" id="dobTo" name="DateOfBirthTo" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalShared.Created_From</label>
                    <input type="date" id="createdFrom" name="CreatedFrom" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">@GlobalShared.Created_To</label>
                    <input type="date" id="createdTo" name="CreatedTo" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter</button>
                <button id="resetFilterBtn" type="reset" class="btn btn-secondary me-2 w-100"><i class="mdi mdi-refresh"></i> @GlobalShared.Reset</button>
                <button id="exportBtn" class="btn btn-success w-100"><i class="mdi mdi-file-excel"></i> @GlobalShared.Export</button>
            </div>
        </div>
    </form>
</div>

<!-- DataTable Partial -->
<div id="datalistingview">
    @Html.Partial("_MemberData")
</div>

@section Scripts {
    <script src="~/Scripts/Js/Members/memberIndex.js"></script>
}




