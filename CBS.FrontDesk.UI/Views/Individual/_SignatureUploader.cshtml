@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile


<div class="card-body">
    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdate(this);", @id = "formValidationExamples" }))
    {
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="upload" />
        <input type="hidden" name="CustomerDocumentRequest.DocumentType" value="CustomerSignature" />
        <div class="form-group">
            <div class="upload-container">
                <div class="image-preview">
                    <img src="@Url.Content(Model.CustomerList.ImageVirtualSignaturePath)" alt="No Image Found" id="previewsignature" class="img-fluid" />
                </div>
                <label for="signatureuploadPhoto" class="custom-file-upload">
                    <i class="fas fa-cloud-upload-alt"></i> Choose Scanned Signature
                </label>
                <input type="file" name="CustomerDocumentRequest.AttachedFiles" accept="image/jpeg,image/png,image/JPG" id="signatureuploadPhoto" onchange="ShowImagePreview(this, document.getElementById('previewsignature'))" />
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Upload Signature</button>
        </div>
    }
</div>
