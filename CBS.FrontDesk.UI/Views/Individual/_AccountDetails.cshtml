@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <!-- General Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.General_Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Account_Number:</td>
                        <td>@Model.CustomerAccount.accountNumber</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Account_Name:</td>
                        <td>@Model.CustomerAccount.accountName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Customer_Name:</td>
                        <td>@Model.CustomerAccount.customerName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Member_reference:</td>
                        <td>@Model.CustomerAccount.customerId</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Branch_Code:</td>
                        <td>@Model.CustomerAccount.branchCode</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Bank_ID:</td>
                        <td>@Model.CustomerAccount.bankId</td>
                    </tr>

                    <!-- Balance Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Balance_Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Current_balance:</td>
                        <td>@Model.CustomerAccount.balance.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Previous_Balance:</td>
                        <td>@Model.CustomerAccount.previousBalance.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Blocked_Amount:</td>
                        <td>@Model.CustomerAccount.blockedAmount.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Encrypted_Balance:</td>
                        <td>@Model.CustomerAccount.encryptedBalance</td>
                    </tr>

                    <!-- Account Status -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Account_Status</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Status:</td>
                        <td>
                            @if (Model.CustomerAccount.status == "Active")
                            {
                                <span class="badge bg-success text-white">@GlobalShared.Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@Model.CustomerAccount.status</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Reason_for_Block:</td>
                        <td>@Model.CustomerAccount.reasonOfBlocked</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Date_Blocked:</td>
                        <td>@(Model.CustomerAccount.dateBlocked == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateBlocked.ToString("dd/MM/yyyy"))</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Date_Released:</td>
                        <td>@(Model.CustomerAccount.dateReleased == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateReleased.ToString("dd/MM/yyyy"))</td>
                    </tr>

                    <!-- Product Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Product_Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Product_Code:</td>
                        <td>@Model.CustomerAccount.product.Code</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Product_Name:</td>
                        <td>@Model.CustomerAccount.product.Name</td>
                    </tr>

                    <!-- Interest Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Interest_Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalIndividual.Interest_Generated:</td>
                        <td>@Model.CustomerAccount.interestGenerated.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalIndividual.Last_Interest_Posted:</td>
                        <td>@Model.CustomerAccount.lastInterestPosted.ToString("N1") FCFA</td>
                    </tr>

                    <!-- Account Operations -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalShared.Account_Operations</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Last_operation:</td>
                        <td>@Model.CustomerAccount.lastOperation</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Last_operation_amount:</td>
                        <td>@Model.CustomerAccount.lastOperationAmount.ToString("N1") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Date_of_Last_Operation:</td>
                        <td>@(Model.CustomerAccount.dateOfLastOperation == DateTime.MinValue ? "N/A" : Model.CustomerAccount.dateOfLastOperation.ToString("dd/MM/yyyy"))</td>
                    </tr>

                    <!-- Opening Day Information -->
                    <tr class="table-primary">
                        <td colspan="2" class="font-weight-bold text-center">@GlobalIndividual.Opening_Day_Information</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalIndividual.Opening_Day_Status:</td>
                        <td>@Model.CustomerAccount.openningOfDayStatus</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Opening_Day_Date:</td>
                        <td>@(Model.CustomerAccount.openningOfDayDate == DateTime.MinValue ? "N/A" : Model.CustomerAccount.openningOfDayDate.ToString("dd/MM/yyyy"))</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">@GlobalShared.Opening_Balance:</td>
                        <td>@Model.CustomerAccount.openingBalance.ToString("N1") FCFA</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>
