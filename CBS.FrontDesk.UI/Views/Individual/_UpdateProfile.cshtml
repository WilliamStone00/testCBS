@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
@using Resources
<div class="card-body">

    @using (Html.BeginForm("Update", "Individual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-3", onsubmit = "return AjaxPostAndUpdateMembers(this);", @id = "formValidationExamples" }))
    {
        <!-- Account Details -->
        @Html.HiddenFor(model => model.CustomerList.CustomerId)
        <input type="hidden" name="option" value="Profile" id="option" />
        <div class="col-12">
            <h5><b>1. @GlobalShared.ProfileDetails</b></h5>
            <hr class="mt-0" />
        </div>

        <div class="col-md-7">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.FirstName, new { @class = "form-control", @placeholder = GlobalShared.First_Name, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.FirstName, "", new { @class = "text-danger" })
                <label>@GlobalShared.First_Name</label>
            </div>
        </div>
        <div class="col-md-5">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.LastName, new { @class = "form-control", @placeholder = @GlobalIndividual.LastName, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.LastName, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.LastName</label>
            </div>
        </div>
        <div class="col-md-9">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Matricule, new { @class = "form-control", @placeholder = "1234" })
                @Html.ValidationMessageFor(m => m.CustomerList.Matricule, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.MembersMatriculeNumber</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.Gender, new SelectList(ViewBag.genders, "Text", "Value"), "---" + @GlobalIndividual.SelectGender + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Gender, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.Gender</label>
            </div>
        </div>

        <div class="col-12">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.CustomerList.IsDailyCollector, new { @class = "form-check-input", @Readonly = true })
                <label class="form-check-label" for="isActive">@GlobalIndividual.CheckMeIAmAdailySavingMember.</label>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.DateOfBirth, new { @class = "form-control date-picker", @placeholder = GlobalShared.Date_of_birth, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.DateOfBirth, "", new { @class = "text-danger" })
                <label>@GlobalShared.Date_of_birth</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.PlaceOfBirth, new { @class = "form-control", @placeholder = GlobalShared.Place_of_Birth, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.PlaceOfBirth, "", new { @class = "text-danger" })
                <label>@GlobalShared.Place_of_Birth</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Phone, new { @class = "form-control", @placeholder = GlobalShared.Phone_Number, @readonly = true, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Phone, "", new { @class = "text-danger" })
                <label>@GlobalShared.Phone_Number</label>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.IDNumber, new { @class = "form-control", @placeholder = @GlobalIndividual.NationalIDCardNumber, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.IDNumber, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.NationalIDCard</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.IDNumberIssueDate, new { @class = "form-control date-picker", @placeholder = "Date issued", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.IDNumberIssueDate, "", new { @class = "text-danger" })
                <label>@GlobalShared.Date_issued</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.IDNumberIssueAt, new { @class = "form-control", @placeholder = GlobalShared.PlaceOfIssued, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.IDNumberIssueAt, "", new { @class = "text-danger" })
                <label>@GlobalShared.PlaceOfIssue</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.TaxIdentificationNumber, new { @class = "form-control", @placeholder = @GlobalIndividual.PersonnalIdentificationNumber, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.TaxIdentificationNumber, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.PersonnalIdentificationNumber</label>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.EconomicActivitiesId, new SelectList(ViewBag.EconomicActivities, "Id", "Name"), "---" + @GlobalIndividual.SelectEconomicActivity + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.EconomicActivitiesId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalIndividual.EconimicActivity</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Occupation, new { @class = "form-control", @placeholder = @GlobalIndividual.Occumation, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Occupation, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.Occumation</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.Language, new SelectList(ViewBag.languages, "Text", "Value"), "---" + @GlobalIndividual.SelectLanguage + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Language, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalIndividual.Language</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.CustomerCategoryId, new SelectList(ViewBag.Categories, "Value", "Text"), "---" + @GlobalIndividual.SelectCustomerCategory + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.CustomerCategoryId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalIndividual.SelectCustomerCategory</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.CustomerStatus,
                    ViewBag.MemberStatuses as List<SelectListItem>,
                    "--- Select Member Status ---",
                    new { @class = "form-control select2", @required = "required" })

                @Html.ValidationMessageFor(m => m.CustomerList.CustomerStatus, "", new { @class = "text-danger" })
                <label>Select Member Status</label>
            </div>
        </div>



        <div class="col-md-4">
            @Html.CheckBoxFor(model => model.CustomerList.IsPoliticaExposed, new { @class = "form-check-input" })
            @Html.LabelFor(model => model.CustomerList.IsPoliticaExposed, "Select Exposed status", new { @class = "form-check-label" })
        </div>
        <div id="pepDetails" class="row">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.DropDownListFor(m => m.CustomerList.PoliticaExposedQuestion,
                        ViewBag.politicalstatuses as List<SelectListItem>,
                        "--- Select  status ---",
                        new { @class = "form-control select2", @required = "required" })

                    @Html.ValidationMessageFor(m => m.CustomerList.PoliticaExposedQuestion, "", new { @class = "text-danger" })
                    <label>Polictical question</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.CustomerList.PoliticaExposedAnswer, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CustomerList.PoliticaExposedAnswer, "", new { @class = "text-danger" })
                    <label>Political Response</label>
                </div>
            </div>
        </div>
        <!-- Address Info -->
        <div class="col-12">
            <h5 class="mt-2"><b>2. @GlobalIndividual.AddressInfo</b></h5>
            <hr class="mt-0" />
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.CountryId, new SelectList(ViewBag.Countries, "Id", "Name"), "---" + @GlobalIndividual.SelectCountry + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.CountryId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.Country</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.RegionId, new SelectList(ViewBag.Regions, "Id", "Name"), "---" + GlobalShared.Select_Region + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.RegionId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.Region</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.DivisionId, new SelectList(ViewBag.Divisions, "Id", "Name"), "---" + @GlobalIndividual.SelectDivision + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.DivisionId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.Division</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.SubDivisionId, new SelectList(ViewBag.SubDivisions, "Id", "Name"), "---" + @GlobalIndividual.SelectSubDivision + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.SubDivisionId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.SubDivision</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.DropDownListFor(m => m.CustomerList.TownId, new SelectList(ViewBag.Towns, "Id", "Name"), "---" + @GlobalIndividual.SelectTown + "---", new { @class = "form-control select2", @search = "true", @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.TownId, "", new { @class = "text-danger " })
                <label for="formValidationDob">@GlobalShared.Town</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextAreaFor(m => m.CustomerList.Address, new { @class = "form-control", @placeholder = GlobalShared.Address, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Address, "", new { @class = "text-danger" })
                <label>@GlobalShared.Address</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Email, new { @class = "form-control", @placeholder = GlobalShared.Email, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.Email, "", new { @class = "text-danger" })
                <label>@GlobalShared.Email</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.Fax, new { @class = "form-control", @placeholder = @GlobalIndividual.PersonalPhoneNumber })
                @Html.ValidationMessageFor(m => m.CustomerList.Fax, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.FaxNumber</label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.POBox, new { @class = "form-control", @placeholder = @GlobalIndividual.PostBoxNumber })
                @Html.ValidationMessageFor(m => m.CustomerList.POBox, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.PostBoxNumber</label>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.VillageOfOrigin, new { @class = "form-control", @placeholder = @GlobalIndividual.VillageOfOrigin, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.VillageOfOrigin, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.VillageOfOrigin</label>
            </div>
        </div>
        <div class="col-12">
            <h5 class="mt-2"><b>3. @GlobalIndividual.ParentsInformation</b></h5>
            <hr class="mt-0" />
        </div>

        <!-- Mother's Information -->
        <div class="col-md-12">
            <h6 class="text-primary">@GlobalIndividual.MothersInformation</h6>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.MName, new { @class = "form-control", @placeholder = @GlobalIndividual.MothersFullName, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.MName, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.MothersFullName</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.MPhone, new { @class = "form-control", @placeholder = @GlobalIndividual.MothersPhoneNumber, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.MPhone, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.MothersPhoneNumber</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.MOccupation, new { @class = "form-control", @placeholder = @GlobalIndividual.MothersOccupation, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.MOccupation, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.MothersOccupation</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.MAddress, new { @class = "form-control", @placeholder = @GlobalIndividual.MothersAddress, @required = "required" })
                @Html.ValidationMessageFor(m => m.CustomerList.MAddress, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.MothersAddress</label>
            </div>
        </div>

        <!-- Father's Information -->
        <div class="col-md-12 mt-4">
            <h6 class="text-primary">@GlobalIndividual.FathersInformation</h6>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.FName, new { @class = "form-control", @placeholder = @GlobalIndividual.FathersFullName })
                @Html.ValidationMessageFor(m => m.CustomerList.FName, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.FathersFullName</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.FPhone, new { @class = "form-control", @placeholder = @GlobalIndividual.FathersPhoneNumber })
                @Html.ValidationMessageFor(m => m.CustomerList.FPhone, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.FathersPhoneNumber</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.FOccupation, new { @class = "form-control", @placeholder = @GlobalIndividual.FathersOccupation })
                @Html.ValidationMessageFor(m => m.CustomerList.FOccupation, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.FathersOccupation</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.CustomerList.FAddress, new { @class = "form-control", @placeholder = @GlobalIndividual.FathersAddress })
                @Html.ValidationMessageFor(m => m.CustomerList.FAddress, "", new { @class = "text-danger" })
                <label>@GlobalIndividual.FathersAddress</label>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">@GlobalShared.Update</button>
        </div>
    }
</div>
