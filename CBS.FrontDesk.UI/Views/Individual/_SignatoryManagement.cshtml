<div id="accordionPayment" class="accordion">
    <div class="accordion-item active">
        <h2 class="accordion-header">
            <button class="accordion-button"
                    type="button"
                    data-bs-toggle="collapse"
                    aria-expanded="true"
                    data-bs-target="#accordionPayment-1"
                    aria-controls="accordionPayment-1">
                Add account signatories
            </button>
        </h2>

        <div id="accordionPayment-1" class="accordion-collapse collapse show">
            <div class="accordion-body">
                @Html.Partial("_AddCardSignatureSpecimen")
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accordionPayment-2"
                    aria-controls="accordionPayment-2">
                Accounts signatories
            </button>
        </h2>
        <div id="accordionPayment-2" class="accordion-collapse collapse">
            <div class="accordion-body">
                @Html.Partial("_AddCardSignatureSpecimenData")
            </div>
        </div>
    </div>
</div>