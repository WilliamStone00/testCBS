
@{ ViewBag.Title = "Member Status"; }
@using Resources

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-flag-variant me-2"></i>  @GlobalIndividual.MemberShip_Status_Data_Table
                </h1>
                <p class="card-text text-muted">
                    @GlobalIndividual.Define_a_new_status_label_for_your_members
                </p>
            </div>
        </div>
    </div>
</div>



<div class="card p-3 shadow mb-2">
    <div class="table-responsive">
        <table id="memberStatusTable" class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Name</th>
                    <th>@GlobalShared.Description</th>
                    
                    <th style="width:150px;">@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>





<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-width">
        <div class="modal-content">


            <div class="modal-body">


                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-eye-outline me-2"></i>@GlobalIndividual.Member_Status_Details
                        </h1>
                        <p class="card-text">
                            @GlobalIndividual.View_full_information_of_the_selected_member_status
                        </p>
                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@GlobalShared.Name</label>
                    <input type="text" id="detailsName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@GlobalShared.Description</label>
                    <textarea id="detailsDescription" class="form-control" rows="3" readonly></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@GlobalShared.Default_Status</label>
                    <input type="text" id="detailsDefault" class="form-control" readonly />
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-width">
        <div class="modal-content">

            
            <div class="modal-body">

                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-pencil-outline me-2"></i>@GlobalIndividual.Update_Member_Status
                        </h1>
                        <p class="card-text">
                            @GlobalIndividual.Modify_the_selected_member_status_information
                        </p>
                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>


                <input type="hidden" id="updateId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">@GlobalShared.Name</label>
                    <input type="text" id="updateName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@GlobalShared.Description</label>
                    <textarea id="updateDescription" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" id="updateDefault" class="form-check-input" />
                    <label class="form-check-label fw-bold">
                        @GlobalIndividual.Set_as_Default_Status
                    </label>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Cancel</button>
                <button id="btnSubmitUpdate" class="btn btn-primary">@GlobalShared.Save_Changes</button>
            </div>

        </div>
    </div>
</div>

  @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {

        var table = $('#memberStatusTable').DataTable({
            ajax: {
                url: '/Individual/GetMemberStatuses',
                type: 'GET',
                dataSrc: 'data'
            },
            pageLength: 5,
            columns: [
                { data: 'Name' },
                { data: 'Description' },
                {
                    data: 'Id',
                    orderable: false,
                    searchable: false,
                    render: function (data) {
                        return `
                            <button class="btn btn-sm btn-info me-1 btn-details"
                                data-id="${data}">
                                Details
                            </button>

                            <button class="btn btn-sm btn-primary btn-update"
                                data-id="${data}">
                                Update
                            </button>
                        `;
                    }
                }
            ]
        });

        // =========================
        // DETAILS BUTTON CLICK
        // =========================
        $('#memberStatusTable').on('click', '.btn-details', function () {

            var id = $(this).data('id');

            if (!id) {
                appalert("Invalid Member Status ID.", 0, 1);
                return;
            }

            $.get('/Individual/MemberStatusDetails', { id: id })
                .done(function (response) {

                    if (response.success) {

                        $('#detailsName').val(response.data.Name);
                        $('#detailsDescription').val(response.data.Description);
                        $('#detailsDefault').val(response.data.IsDefault ? "Yes" : "No");

                        var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                        modal.show();

                    } else {
                        appalert(response.message || "Unable to load details.", 2, 1);
                    }
                })
                .fail(function (xhr) {
                    console.log("Status:", xhr.status);
                    console.log("Response:", xhr.responseText);
                    appalert("Server error occurred while loading details.", 0, 1);
                });
        });

        // =========================
        // UPDATE BUTTON CLICK
        // =========================
        $('#memberStatusTable').on('click', '.btn-update', function () {

            var id = $(this).data('id');

            if (!id) {
                appalert("Invalid Member Status ID.", 0, 1);
                return;
            }

            $.get('/Individual/MemberStatusDetails', { id: id })
                .done(function (response) {

                    if (response.success) {

                        // ✅ Fill UPDATE modal fields (correct IDs)
                        $('#updateId').val(response.data.Id);
                        $('#updateName').val(response.data.Name);
                        $('#updateDescription').val(response.data.Description);
                        $('#updateDefault').prop('checked', response.data.IsDefault);

                        var modal = new bootstrap.Modal(document.getElementById('updateModal'));
                        modal.show();

                    } else {
                        appalert(response.message || "Unable to load details.", 2, 1);
                    }
                })
                .fail(function (xhr) {
                    console.log("Status:", xhr.status);
                    console.log("Response:", xhr.responseText);
                    appalert("Server error occurred while loading details.", 0, 1);
                });
        });



        $('#btnSubmitUpdate').click(function () {

            var model = {
                Id: $('#updateId').val(),
                Name: $('#updateName').val(),
                Description: $('#updateDescription').val(),
                IsDefault: $('#updateDefault').is(':checked')
            };

            if (!model.Id) {
                appalert("Invalid Member Status ID.", 0, 1);
                return;
            }

            alertify.confirm(
                "Confirm Update",
                "Are you sure you want to post this update?",
                function () {

                    // YES clicked
                    $.ajax({
                        url: '/Individual/Updates',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(model),
                        success: function (response) {

                            if (response.success) {

                                appalert("Member Status updated successfully.", 1, 1);

                                var modal = bootstrap.Modal.getInstance(document.getElementById('updateModal'));
                                modal.hide();

                                $('#memberStatusTable').DataTable().ajax.reload();

                            } else {
                                appalert(response.message || "Update failed.", 2, 1);
                            }
                        },
                        error: function (xhr) {
                            console.log(xhr.responseText);
                            appalert("Server error occurred while updating.", 0, 1);
                        }
                    });

                },
                function () {
                    // NO clicked
                    alertify.error("Update cancelled");
                }
            );

        });    });
</script>   
        
}



