@model CBS.FrontDesk.Data.Entity.IndividualCustomerProfile
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Account number</th>
                <th>Ration</th>
                <th>Relationship</th>
                <th>Branch</th>
                <th>Signature</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.CustomerList.membershipNextOfKings)
            {
                <tr>
                    <td style="width:15%">@d.name</td>
                    <td style="width:10%">@d.accountNumber</td>
                    <td style="width:10%">@d.ratio</td>
                    <td style="width:35%">@d.relation</td>
                    <td style="width:10%">@d.branchId</td>
                    <td style="width:10%">@d.signatureFile</td>
                    <td style="width:10%">
                        <a href="#" target="_blank" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">
                            <i class="mdi mdi-folder mr-1"></i>
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>