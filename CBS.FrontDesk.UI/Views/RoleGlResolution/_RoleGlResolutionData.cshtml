@using Resources
<div class="card shadow-sm p-3">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i> @GlobalRoleGlResolution.role_gl_resolutions</h5>
    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Scope</th>
                    <th>@GlobalRoleGlResolution.scope_name</th>
                    <th>@GlobalShared.role</th>
                    <th>@GlobalShared.gl_account</th>
                    <th>@GlobalShared.Created_At</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded dynamically -->
            </tbody>
        </table>
    </div>
</div>
