@* _AffiliateData.cshtml *@
@using Resources
@{
    // optional: set title or other view data here
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="myDataTable" class="table table-striped table-hover table-bordered" style="width:100%">
                <colgroup>
                    <col style="width:15%" />  
                    <col style="width:15%" />  
                    <col style="width:5%" />  
                    <col style="width:30%" />  
                    <col style="width:13%" />   
                    <col style="width:12%" />  
                    <col style="width:10%" />   
                </colgroup>

                <thead class="table-light">
                    <tr>
                        <th>@GlobalShared.CreatedDate</th>
                        <th>@GlobalShared.Name</th>
                        <th>@GlobalShared.Class</th>
                        <th>@GlobalShared.Reason</th>
                        <th>@GlobalShared.Posting_Allowed</th>
                        <th>@GlobalShared.Scope</th>
                        <th style="width:160px">@GlobalShared.Actions</th>
                    </tr>
                </thead>

                <tbody>                  
                </tbody>
            </table>
        </div>
    </div>
</div>




