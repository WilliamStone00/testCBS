@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.AddCORRESPONDANCE
@using Resources

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-book-open-page-variant-outline me-2"></i>Correspondance Request Creation
        </h1>
        <p class="card-text text-muted mb-1">
            Use this form to create the correspondance request which is lacking
        </p>
    </div>
</div>

<div class="card shadow p-3 mb-4">
    @using (Html.BeginForm("Addcorrespondance", "FileUpload", FormMethod.Post, new { id = "correspondenceForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate1(this);" }))
    {
        @Html.AntiForgeryToken()

    <div class="mt-2">
        <h4 class="mb-3 text-primary"><i class="mdi mdi-email-outline me-2"></i> @GlobalShared.Create</h4>

        <div class="col-md-6">
            <label class="form-label small text-muted">Parent Account Reference</label>
            <input type="text" class="form-control-plaintext" readonly value="@Model.Name" />
        </div>

        <hr />

        <div class="row g-2">
            <div class="col-md-6">
                <div class="form-floating">
                    @Html.TextBoxFor(m => m.Type, new { @class = "form-control", placeholder = "Correspondence type", id = "Type", maxlength = "50" })
                    <label for="Type">Correspondence Type</label>
                    @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    @Html.DropDownList("Language", ViewBag.Languages as SelectList ?? new SelectList(new[] { new { Value = "", Text = "--- Any ---" } }, "Value", "Text"), "--- Any ---", new { @class = "form-control", id = "Language", placeholder = "Language" })
                    @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                    <label for="Language">Language</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- Branch Selection Section -->
        <div class="row g-2 mt-2">
            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.BranchId, new SelectList(ViewBag.Branches, "Id", "name"), "---" + @GlobalUserManagement.SelectBranch + "---", new { @class = "form-control select2", id = "BranchId" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    <label>@GlobalUserManagement.Branch</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.BranchAccountId, new SelectList(Enumerable.Empty<SelectListItem>()), "--- Select Branch Account reference ---", new { @class = "form-control select2", id = "BranchAccountId" })
                    @Html.ValidationMessageFor(m => m.BranchAccountId, "", new { @class = "text-danger" })
                    <label for="BranchAccountId">Branch Account reference</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- Affiliate Accounts Section -->
        <div class="row g-2 mt-2">
            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.AffiliateAccountId,
                        new SelectList(ViewBag.AffiliateAccounts, "Id", "Name"),
                        "--- Select Affiliate Account ---",
                        new { @class = "form-select select2", @aria_label = "Affiliate Account" })
                    @Html.ValidationMessageFor(m => m.AffiliateAccountId, "", new { @class = "text-danger" })
                    <label>Affiliate Account</label>
                </div>
            </div>
        </div>

        <!-- Conditional Source Affiliate Account -->
        <div id="sourceAffiliateSection" style="display: none;">
            <div class="row g-2 mt-2">
                <div class="col-md-12">
                    <div class="form-floating shadow-sm">
                        @Html.DropDownListFor(m => m.SourceAffiliateAccountId,
                            new SelectList(ViewBag.AffiliateAccounts, "Id", "Name"),
                            "--- Select Source Affiliate Account ---",
                            new { @class = "form-select select2", @aria_label = "Affiliate Account" })
                        @Html.ValidationMessageFor(m => m.SourceAffiliateAccountId, "", new { @class = "text-danger" })
                        <label for="SourceAffiliateAccountId">Source Affiliate Account</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- HO PCMF Account Section -->
        <div class="row g-2 mt-2">
            <div class="col-md-12">
                <div class="form-floating shadow-sm">
                    @Html.DropDownListFor(m => m.HoPcmfAccountId,
                        new SelectList(ViewBag.HoPcmfAccountId, "Id", "Name"),
                        "--- Select HoPcmf Account ---",
                        new { @class = "form-select select2", placeholder = "HoPcmf Account Id", @aria_label = "HoPcmfAccountId" })
                    @Html.ValidationMessageFor(m => m.HoPcmfAccountId, "", new { @class = "text-danger" })
                    <label for="HoPcmfAccountId">HoPcmf Account</label>
                </div>
            </div>
        </div>

        <!-- Rationale Section -->
        <div class="row g-2 mt-2">
            <div class="col-md-12">
                <div class="form-floating">
                    @Html.TextAreaFor(m => m.Rationale, 5, 0, new { @class = "form-control", placeholder = "Rationale / Reason", id = "Rationale" })
                    <label for="Rationale">Rationale</label>
                    @Html.ValidationMessageFor(m => m.Rationale, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <hr />

        <!-- Buttons Section -->
        <div class="text-end">
            @if (string.IsNullOrWhiteSpace(Model?.CorrelationId))
            {
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> @GlobalShared.Save</button>
                <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary me-2"><i class="mdi mdi-refresh"></i> @GlobalBank.Update</button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            }
        </div>
    </div>
    }
</div>

@section Scripts {
    <script>
    $(document).ready(function() {
        // Initialize Select2
        $('.select2').select2();

        // Handle branch dropdown change event
        $('#BranchId').on('change', function() {
            var branchId = $(this).val();
            var branchAccountDropdown = $('#BranchAccountId');

            // Show loading state
            branchAccountDropdown.empty().prop('disabled', true);
            branchAccountDropdown.append($('<option></option>').val('').text('Loading branch accounts...'));

            if (!branchId) {
                resetBranchAccountDropdown();
                return;
            }

            loadBranchAccounts(branchId, branchAccountDropdown);
        });

        // Handle Type change to show/hide source affiliate section
        $('#Type').on('change', function() {
            var type = $(this).val();
            if (type === 'AffiliateToHo') {
                $('#sourceAffiliateSection').show();
            } else {
                $('#sourceAffiliateSection').hide();
                $('#SourceAffiliateAccountId').val('').trigger('change');
            }
        });

        // Initialize type-based visibility
        $('#Type').trigger('change');

        function loadBranchAccounts(branchId, dropdown) {
            $.ajax({
                url: '@Url.Action("GetBranchAccountsByBranch", "FileUpload")',
                type: 'GET',
                data: { branchId: branchId },
                timeout: 10000, // 10 second timeout
                success: function(response) {
                    dropdown.empty().prop('disabled', false);

                    if (response.success && response.data && response.data.length > 0) {
                        dropdown.append($('<option></option>').val('').text('--- Select Branch Account reference ---'));

                        $.each(response.data, function(index, account) {
                            dropdown.append($('<option></option>').val(account.id).text(account.name));
                        });

                        showNotification('Branch accounts loaded successfully', 'success');
                    } else {
                        dropdown.append($('<option></option>').val('').text('No branch accounts available'));
                        showNotification('No branch accounts found for selected branch', 'warning');
                    }

                    dropdown.trigger('change');
                },
                error: function(xhr, status, error) {
                    dropdown.empty().prop('disabled', false);
                    dropdown.append($('<option></option>').val('').text('Error loading branch accounts'));
                    showNotification('Failed to load branch accounts. Please try again.', 'error');
                    console.error('AJAX Error:', error);
                }
            });
        }

        function resetBranchAccountDropdown() {
            var dropdown = $('#BranchAccountId');
            dropdown.empty().prop('disabled', false);
            dropdown.append($('<option></option>').val('').text('--- Select Branch Account reference ---'));
            dropdown.trigger('change');
        }

        function showNotification(message, type) {
            // Use your existing notification system or console log
            console.log(`${type.toUpperCase()}: ${message}`);

            // If you have a toast notification system, use it here:
            // appalert(message, type === 'success' ? 1 : type === 'warning' ? 3 : 2, 1);
        }

        // Initialize if branch is pre-selected
        if ($('#BranchId').val()) {
            $('#BranchId').trigger('change');
        }
    });

    // Your existing form submission function
    function AjaxPostAndUpdate1(form) {
        console.log("Form Action:", form.action);
        console.log("Form Method:", form.method);

        var formData = new FormData(form);
        for (var pair of formData.entries()) {
            console.log(pair[0] + ', ' + pair[1]);
        }

        $.validator.unobtrusive.parse(form);
        if ($(form).valid()) {
            alertify.confirm("Confirmation", "Are you sure you want to perform this action? ",
                function () {
                    var ajaxConfig = {
                        type: 'POST',
                        url: form.action,
                        data: new FormData(form),
                        success: function (response) {
                            console.log("Response:", response);
                            if (response.success) {
                                if (response.status === "Exist") {
                                    appalert(response.message, 3, 1);
                                }
                                else if (response.status === "Failed") {
                                    appalert(response.message, 2, 1);
                                }
                                else {
                                    appalert(response.message, 1, 1);
                                }

                                if (response.option === 'Update' && response.reloadDataView === "Yes") {
                                    LoadDataMain(response.controllerName, response.option, response.divLoaderList, response.tableName, response.dataLoaderActionName, "KEY", "List");
                                }
                                else if (response.optype === 'Insert' && response.reloadDataView === "Yes") {
                                    EditResetMain("KEY", response.option, response.divLoaderCreator, response.controllerName, response.reinitializedActionName, response.groupID);
                                }
                                else if (response.reloadDataView === "Yes") {
                                    LoadDataMain(response.controllerName, response.option, response.divLoaderList, response.tableName, response.dataLoaderActionName, "KEY", "List");
                                }
                            } else {
                                if (response.Status === "Exist") {
                                    appalert(response.message, 3, 1);
                                } else {
                                    appalert(response.message, 2, 1);
                                }
                            }
                        },
                        error: function (err) {
                            console.log("Error:", err);

                            if (err.status === 401) { // Unauthorized
                                // Session has expired, redirect to the login page
                                window.location.href = '/Authentication/Login'; // Adjust the URL as needed
                            } else {
                                appalert(err.statusText, 0, 1);
                            }
                        }
                    };

                    if ($(form).attr('enctype') === "multipart/form-data") {
                        ajaxConfig.contentType = false;
                        ajaxConfig.processData = false;
                    }

                    console.log("AJAX Config:", ajaxConfig);
                    $.ajax(ajaxConfig);
                },
                function () {
                    appalert('Transaction cancelled', 3, 1);
                }
            );
        }
        return false;
    }
    </script>
}