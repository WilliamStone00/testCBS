@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.Accountwaiting
@using System.Globalization
@using Resources
@{
    // Helper: true when scope equals AFFILIATE (case-insensitive)
    var isAffiliate = string.Equals(Model?.Scope, "AFFILIATE", StringComparison.OrdinalIgnoreCase);
}

<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-book-open-page-variant-outline me-2"></i>@GlobalFileUpload.Awaiting_Correspondence_Details
        </h1>
        <p class="card-text text-muted mb-1">
            @GlobalFileUpload.here_we_have_the_details_of_an_account_awaiting_correspondance
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-information-outline me-2"></i>@GlobalShared.Basic_Information</h6>
        <table class="table table-sm table-bordered">
            <tbody>
            @*    <tr>
                    <td class="fw-bold">Id</td>
                    <td>@Html.DisplayFor(m => m.Id)</td>
                </tr>*@
                <tr>
                    <td class="fw-bold">Scope</td>
                    <td>@Html.DisplayFor(m => m.Scope)</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Branch</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.BranchName) ? "-" : Html.Encode(Model.BranchName))</td>
                </tr>

                @* Only show Affiliate Id row when scope = AFFILIATE *@
               @* @if (isAffiliate)
                {
                    <tr>
                        <td class="fw-bold">Affiliate Id</td>
                        <td>@(string.IsNullOrWhiteSpace(Model?.AffiliateId) ? "-" : Html.Encode(Model.AffiliateId))</td>
                    </tr>
                }*@

                <tr>
                    <td class="fw-bold">@GlobalShared.Code</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.Code) ? "-" : Html.Encode(Model.Code))</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Name</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.Name) ? "-" : Html.Encode(Model.Name))</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Name (EN)</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.NameEn) ? "-" : Html.Encode(Model.NameEn))</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Name (FR)</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.NameFr) ? "-" : Html.Encode(Model.NameFr))</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-cog-outline me-2"></i>@GlobalShared.Financial_Info</h6>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td class="fw-bold">Class</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.Class) ? "-" : Html.Encode(Model.Class))</td>
                </tr>

                @* These two rows are visible only for AFFILIATE scope *@
                @*   @if (isAffiliate)
        {
            <tr>
                <td class="fw-bold">Ho PCMF Account Id</td>
                <td>@(string.IsNullOrWhiteSpace(Model?.HoPcmfAccountId) ? "-" : Html.Encode(Model.HoPcmfAccountId))</td>
            </tr>
            <tr>
                <td class="fw-bold">Affiliate → HO Correspondence Id</td>
                <td>@(string.IsNullOrWhiteSpace(Model?.AffiliateToHoCorrespondenceId) ? "-" : Html.Encode(Model.AffiliateToHoCorrespondenceId))</td>
            </tr>
        }*@

                <tr>
                    <td class="fw-bold">@GlobalFileUpload.Requires_Mapping</td>
                    <td>@(Model?.RequiresMapping == true ? "Yes" : "No")</td>
                </tr>

                @* Only show Affiliate Account Id when scope = AFFILIATE *@
                @* @if (isAffiliate)
                    {
                        <tr>
                            <td class="fw-bold">Affiliate Account Id</td>
                            <td>@(string.IsNullOrWhiteSpace(Model?.AffiliateAccountId) ? "-" : Html.Encode(Model.AffiliateAccountId))</td>
                        </tr>
                    }

                    <tr>
                        <td class="fw-bold">Branch Account Id</td>
                        <td>@(string.IsNullOrWhiteSpace(Model?.BranchAccountId) ? "-" : Html.Encode(Model.BranchAccountId))</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Path</td>
                        <td>@(string.IsNullOrWhiteSpace(Model?.Path) ? "-" : Html.Encode(Model.Path))</td>
                    </tr>*@
                <tr>
                    <td class="fw-bold">@GlobalShared.Depth</td>
                    <td>@(Model != null ? Model.Depth.ToString(CultureInfo.InvariantCulture) : "-")</td>
                </tr>
                <tr>
                    <td class="fw-bold">@GlobalShared.Posting_Allowed</td>
                    <td>@(Model?.PostingAllowed == true ? "Yes" : "No")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-note-text me-2"></i>@GlobalShared.Reason</h6>
        <div class="card card-body">
            @(string.IsNullOrWhiteSpace(Model?.Reason) ? "-" : Html.Encode(Model.Reason))
        </div>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary"><i class="mdi mdi-calendar-range me-2"></i>@GlobalShared.Dates & @GlobalShared.Status</h6>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td class="fw-bold">@GlobalShared.Created_Date</td>
                    <td>
                        @(
                            Model != null
                            ? Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                            : "-"
                        )
                    </td>
                </tr>
              @*  <tr>
                    <td class="fw-bold">Modified Date</td>
                    <td>
                        @(
                            Model != null
                            ? Model.ModifiedDate.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                            : "-"
                        )
                    </td>
                </tr>*@
                @*<tr>
                        <td class="fw-bold">Is Deleted</td>
                        <td>@(Model?.IsDeleted == true ? "Yes" : "No")</td>
                    </tr>*@
                <tr>
                    <td class="fw-bold">@GlobalShared.Language</td>
                    <td>@(string.IsNullOrWhiteSpace(Model?.Language) ? "-" : Html.Encode(Model.Language))</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
