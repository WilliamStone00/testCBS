@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.CorrespondenceRequestDto
@using System.Globalization
@using Resources

@{
    var status = string.IsNullOrWhiteSpace(Model?.Status) ? "Pending" : Model.Status;
}

<!-- Header Section (aligned with Bulk Operation style) -->
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-3 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-email-outline me-2"></i> @GlobalFileUpload.Correspondence_Request_Details
                </h1>
                <p class="card-text lead mb-1">
                    @GlobalFileUpload.Detailed_view_of_a_single_correspondence_request_including_accounts_mappings_and_audit_trail
                </p>

                <div class="mt-2">
                    <span class="fw-semibold me-2">Status:</span>
                    @{
                        var s = status?.Trim().ToLowerInvariant();
                        string badgeClass = "badge bg-secondary";
                        if (s == "pending" || s == "open" || s == "review")
                        {
                            badgeClass = "badge bg-warning text-dark";
                        }
                        else if (s == "approved" || s == "completed")
                        {
                            badgeClass = "badge bg-success";
                        }
                        else if (s == "rejected" || s == "closed" || s == "declined" || s == "cancelled")
                        {
                            badgeClass = "badge bg-danger";
                        }
                    }
                    <span class="@badgeClass">@status</span>
                </div>

                <hr class="my-3" style="border: 2px solid rgba(128, 128, 128, 0.3);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section (similar pattern to Bulk Operation tips) -->
<div class="card mb-3 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>
            <i class="mdi mdi-information-outline me-2"></i> @GlobalFileUpload.Tips_about_this_correspondence
        </span>
        <button class="btn btn-light btn-sm" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseCorrespondenceTips"
                aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseCorrespondenceTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-email-check-outline text-primary me-2"></i>
                    <strong>@GlobalShared.Scope:</strong> @GlobalFileUpload.This_record_describes_a_single_correspondence_request_Branch_or_Affiliate
                </li>
                <li>
                    <i class="mdi mdi-account-search-outline text-success me-2"></i>
                    <strong>@GlobalFileUpload.Request_vs_Action:</strong> @Html.Raw(@GlobalFileUpload.Use_Requested_By_and_Actioned_By_to_trace_who_initiated_and_who_processed_the_request)
                </li>
                <li>
                    <i class="mdi mdi-swap-horizontal text-info me-2"></i>
                    <strong>@GlobalShared.GL_Mapping:</strong> @GlobalFileUpload.Check_Branch_Affiliate_Ho_PCMF_mappings_before_approving_any_correspondence_change_in_GL_structure
                </li>
                <li>
                    <i class="mdi mdi-alert-outline text-warning me-2"></i>
                    <strong>@GlobalShared.Audit:</strong> @GlobalFileUpload.Created_Modified_Actioned_dates_help_you_validate_the_timeline_and_detect_late_or_suspicious_changes
                </li>
            </ul>
        </div>
    </div>
</div>

