<div class="row mt-2">
    <div class="col-md-6">
        <h6 class="text-primary">
            <i class="mdi mdi-note-text me-2"></i>Rationale / Rejection
        </h6>
        <div class="card card-body">
            @if (!string.IsNullOrWhiteSpace(Model?.Rationale))
            {
                @Html.Raw(Html.Encode(Model.Rationale).Replace("\n", "<br/>"))
            }
            else if (!string.IsNullOrWhiteSpace(Model?.RejectionReason))
            {
                <span class="text-danger">@Html.Encode(Model.RejectionReason)</span>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </div>
    </div>

    <div class="col-md-6">
        <h6 class="text-primary">
            <i class="mdi mdi-calendar-range me-2"></i>Dates & Status
        </h6>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td class="fw-bold">Actioned Date</td>
                    <td>
                        @(
                            Model != null && Model?.ActionedDate != null 
                                ? Model?.ActionedDate.Value.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                                : "-"
                         )
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">Created Date</td>
                    <td>
                        @(
                            Model != null && Model?.CreatedDate != null
                                ? Model?.CreatedDate.Value.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                                : "-"
                         )
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">Modified Date</td>
                    <td>
                        @(
                            Model != null && Model?.ModifiedDate != null
                                ? Model?.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                                : "-"
                         )
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">Is Deleted</td>
                    <td>@(Model?.IsDeleted == true ? "Yes" : "No")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
