@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.CorrespondanceRequestQuery
@using Resources
@{
    ViewBag.Title = "Correspondence Request listing";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold">
                    <i class="mdi mdi-email-outline me-2"></i> @GlobalFileUpload.Correspondence
                </h1>
                <p class="card-text">@GlobalFileUpload.Filter_and_search_correspondences</p>

                <div class="alert alert-info mt-3 py-2">
                    <i class="mdi mdi-information-outline me-1"></i>
                    @GlobalFileUpload.Use_the_filters_below_to_narrow_down_results
                </div>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalShared.TIPS_UC</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-filter-outline text-success me-2"></i><strong>@GlobalShared.Type:</strong> @GlobalFileUpload.Filter_by_correspondence_type</li>
                <li><i class="mdi mdi-tag-multiple text-info me-2"></i><strong>@GlobalShared.Status:</strong> @GlobalShared.Filter_by_status</li>
                <li><i class="mdi mdi-calendar-range text-primary me-2"></i><strong>@GlobalShared.Date_Range:</strong> @GlobalFileUpload.Use_date_window</li>
                <li><i class="mdi mdi-eye-off text-warning me-2"></i><strong>@GlobalShared.Include_Deleted:</strong> @GlobalFileUpload.Shows_deleted_items</li>
            </ul>
        </div>
    </div>
</div>

<div class="card shadow p-3 mb-4" id="filtersSection">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i>@GlobalShared.Filters</h5>



    <div class="card p-3 mb-3 bg-light">

        <!-- Toggle groups -->
        <div class="row mb-3">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Type,"Branch", new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(
                    m => m.BranchId,
                    new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                    "--- " + GlobalShared.SelectBranch + " ---",
                    new { @class = "form-select select2", id = "BranchId" }
                )
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           id="toggleDates"
                           onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                    <label class="form-check-label fw-bold" for="toggleDates">@GlobalShared.Show_Date_Filters</label>
                </div>
            </div>

            <div class="col-md-3 d-flex justify-content-end align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           id="toggleAdvanced"
                           onclick="document.getElementById('advancedFilters').classList.toggle('d-none')" />
                    <label class="form-check-label fw-bold ms-2" for="toggleAdvanced">@GlobalShared.Show_advanced_filters</label>
                </div>
            </div>
        </div>

        <!-- Basic filters -->
        <div class="row mb-3">

            <div class="col-md-6">
                @Html.LabelFor(m => m.Type, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(
                    m => m.Type,
                    new List<SelectListItem>
                    {
                        new SelectListItem {Text="--- Any ---", Value="" },
                        new SelectListItem {Text="BranchToAffiliate", Value="BranchToAffiliate" },
                        new SelectListItem {Text="AffiliateToHo", Value="AffiliateToHo" }
                    },
                    new { @class = "form-control select2", id = "Type" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.Status, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(
                    m => m.Status,
                        new SelectList(ViewBag.Statuses ?? new List<SelectListItem>(), "Value", "Text"),
                        "--- " + GlobalShared.All + " ---",
                    new { @class = "form-control select2", id = "Status" })
            </div>

            @* Removed CorrelationId as requested earlier *@
        </div>

        <!-- Date Filters -->
        <div id="dateFilters" class="d-none">
            <div class="row mb-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.CreatedFromUtc, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(
                        m => m.CreatedFromUtc,
                        "{0:yyyy-MM-dd}",
                        new { @class = "form-control", type = "date", id = "CreatedFromUtc" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.CreatedToUtc, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(
                        m => m.CreatedToUtc,
                        "{0:yyyy-MM-dd}",
                        new { @class = "form-control", type = "date", id = "CreatedToUtc" })
                </div>
            </div>
        </div>

        <!-- Advanced filters -->
        <div id="advancedFilters" class="d-none">
            <div class="row mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IncludeDeleted,
                            new { @class = "form-check-input", id = "IncludeDeleted" })
                        @Html.LabelFor(m => m.IncludeDeleted,
                            new { @class = "form-check-label fw-bold ms-2" })
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Buttons -->
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="applyFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
            </button>

            <button id="resetFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
            </button>
        </div>
    </div>


</div>

<!-- Table Block -->
<div id="datalistingview">
    @Html.Partial("_CorrespondanceRequestTableData")
</div>

<!-- Reusable Modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        var correspondenceTable = null;

        function emptyToNull(v) {
            if (v === undefined || v === null) return null;
            var s = v.toString().trim();
            return s.length === 0 ? null : s;
        }

        function confirmAction(message, callback) {
            try {
                if (typeof appconfirm === 'function') {
                    appconfirm(message, callback, function () { });
                    return;
                }
                if (typeof appalert === 'function' && typeof appalert.confirm === 'function') {
                    appalert.confirm(message).then(function (ok) {
                        if (ok) callback();
                    }).catch(function () { });
                    return;
                }
            } catch (e) {
                console.warn('custom confirm failed, falling back:', e);
            }
            if (window.confirm(message)) callback();
        }

        // helper: post JSON with antiforgery header
        function postJsonWithToken(url, payload, onDone, onFail) {
            var token = getAntiForgeryToken && getAntiForgeryToken();
            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: token ? { 'RequestVerificationToken': token } : {},
                success: function (res) {
                    if (typeof onDone === 'function') onDone(res);
                },
                error: function (jqXHR) {
                    if (typeof onFail === 'function') onFail(jqXHR);
                }
            });
        }

        function collectCorrespondenceFilters() {
            // build object matching CorrespondanceRequestQuery
            return {
                Type: emptyToNull($('#Type').val()),
                Status: emptyToNull($('#Status').val()),
                BranchId: emptyToNull($('#BranchId').val()),
                CreatedFromUtc: emptyToNull($('#CreatedFromUtc').val()),
                CreatedToUtc: emptyToNull($('#CreatedToUtc').val()),
                CorrelationId: emptyToNull($('#CorrelationId').val()),
                IncludeDeleted: $('#IncludeDeleted').is(':checked') ? true : false,
                // Language removed
                Options: {} // to be filled by datatable
            };
        }

        function escapeHtml(str) {
            if (str === undefined || str === null) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function initCorrespondenceTableIfNeeded() {
            if ($.fn.DataTable.isDataTable('#myDataTable') && correspondenceTable) {
                return;
            }

            if (!$('#myDataTable').length) {
                if (typeof appalert === 'function') appalert('Table element #myDataTable not found', 0, 1);
                return;
            }

            correspondenceTable = $('#myDataTable').DataTable({
                serverSide: true,
                searching: false,
                responsive: true,
                destroy: false,
                order: [[0, 'desc']], // CreatedDate desc
                deferLoading: 0,
                ajax: {
                    url: '@Url.Action("LoadCorrespondanceRequestDatatable", "FileUpload")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        var filters = collectCorrespondenceFilters();
                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search && d.search.value ? d.search.value : '',
                            sortColumnName: (d.columns && d.order && d.order.length)
                                ? (d.columns[d.order[0].column].data || d.columns[d.order[0].column].name)
                                : 'CreatedDate',
                            sortColumnDirection: (d.order && d.order.length) ? d.order[0].dir : 'desc'
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (jqXHR) {
                        var msg = 'Failed to load data. Please try again.';
                        try {
                            msg = jqXHR.responseJSON?.message || msg;
                        } catch (e) { }
                        if (typeof appalert === 'function') appalert(msg, 0, 1);
                    }
                },
                columns: [
                    {
                        data: 'CreatedDate',
                        name: 'CreatedDate',
                        render: function (data) {
                            if (!data) return '-';
                            if (window.moment) return moment(data).format('DD/MM/YYYY HH:mm:ss');
                            return escapeHtml(data);
                        }
                    },
                    {
                        data: 'Type',
                        name: 'Type',
                        render: function (d) {
                            var s = (d || '').toString().toLowerCase();
                            if (s === 'branchtoaffiliate' || s === 'branch')
                                return '<span class="badge bg-primary text-dark">' + escapeHtml(d) + '</span>';
                            if (s === 'affiliatetoho' || s === 'affiliate')
                                return '<span class="badge bg-success">' + escapeHtml(d) + '</span>';
                            return '<span class="badge bg-secondary">' + escapeHtml(d || '-') + '</span>';
                        }
                    },
                    {
                        data: 'BranchName',
                        name: 'Branch Namee',
                        render: function (d) {
                            return escapeHtml(d || '-');
                        }
                    },
                    {
                        data: 'BranchAccountCode',
                        name: 'Branch Acc. Code',
                        render: function (d) {
                            return escapeHtml(d || '-');
                        }
                    },

                    {
                        data: 'AffiliateAccountCode',
                        name: 'Affiliate Acc. Code',
                        render: function (d) {
                            return escapeHtml(d || '-');
                        }
                    },
                    {
                        data: 'HoPcmfAccountCode',
                        name: 'HoPcmf Acc. Code',
                        render: function (d) {
                            return escapeHtml(d || '-');
                        }
                    },
                    {
                        data: 'RequestedByName',
                        name: 'Requested By',
                        render: function (d) {
                            return escapeHtml(d || '-');
                        }
                    },
                    {
                        data: 'Status',
                        name: 'Status',
                        render: function (d) {
                            var s = (d || '').toString().toLowerCase();
                            if (s === 'open' || s === 'pending' || s === 'review')
                                return '<span class="badge bg-warning text-dark">' + escapeHtml(d) + '</span>';
                            if (s === 'rejected' || s === 'closed' || s === 'declined' || s === 'cancelled')
                                return '<span class="badge bg-danger">' + escapeHtml(d) + '</span>';
                            if (s === 'approved' || s === 'completed')
                                return '<span class="badge bg-success">' + escapeHtml(d) + '</span>';
                            return '<span class="badge bg-secondary">' + escapeHtml(d || '-') + '</span>';
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var rawId = String(row.Id || data || '');
                            var recordId = encodeURIComponent(rawId);
                            var safeId = rawId.replace(/[^a-zA-Z0-9_\-]/g, '') || 'x';
                            var btnId = 'actionDropdown_' + safeId;

                            var status = (row.Status || '').toString().trim().toLowerCase();

                            var detailsBtn = `
                                <button type="button" class="dropdown-item btn-details" data-id="${recordId}" data-title="${escapeHtml(row.Type)}">
                                    <i class="mdi mdi-eye me-1 text-primary"></i> Details
                                </button>`;

                            var reviewBtn = `
                                <button type="button" class="dropdown-item btn-approve" data-id="${recordId}" data-title="${escapeHtml(row.Type)}">
                                    <i class="mdi mdi-clipboard-check me-1 text-success"></i> Approve
                                </button>`;

                            var rejectBtn = `
                                <button type="button" class="dropdown-item btn-reject text-danger" data-id="${recordId}" data-title="${escapeHtml(row.Type)}">
                                    <i class="mdi mdi-close-circle-outline me-1"></i> Reject
                                </button>`;

                            var menuItems = '';
                            if (status === 'pending' || status === 'open') {
                                menuItems = `
                                    <li>${detailsBtn}</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>${reviewBtn}</li>
                                    <li>${rejectBtn}</li>`;
                            } else {
                                menuItems = `<li>${detailsBtn}</li>`;
                            }

                            return `
                                <div class="dropdown text-center">
                                    <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                            type="button" id="${btnId}"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i> Actions
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="${btnId}">
                                        ${menuItems}
                                    </ul>
                                </div>`;
                        }
                    }
                ],
                language: { emptyTable: 'No correspondence records found' },
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                initComplete: function () {
                    try {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                                new bootstrap.Tooltip(el);
                            });
                        }
                    } catch (e) { }
                }
            });
        }

        function loadCorrespondenceData() {
            initCorrespondenceTableIfNeeded();
            if (correspondenceTable) {
                correspondenceTable.page(0).draw(false);
            }
        }

        function resetCorrespondenceFilters() {
            var form = document.getElementById('correspondenceFilterForm');
            if (form) form.reset();

            $('#dateFilters, #advancedFilters').addClass('d-none');

            if (correspondenceTable && $.fn.DataTable.isDataTable('#myDataTable')) {
                correspondenceTable.clear().draw();
            }

            if ($.fn.select2) {
                try {
                    $('#Status').val(null).trigger('change');
                } catch (e) { }
            }

            if (typeof appalert === 'function') appalert('Filters reset', 3, 1);
        }

        // Details handler
        $(document).on('click', '.btn-details', function (e) {
            e.preventDefault();
            var raw = $(this).data('id');
            var id = raw ? decodeURIComponent(raw) : null;
            if (!id) {
                if (typeof appalert === 'function') appalert('Missing id for details', 0, 1);
                return;
            }

            var modalEl = document.getElementById('affiliateDetailsModal');
            if (!modalEl) {
                if (typeof appalert === 'function') appalert('Details modal not found', 0, 1);
                return;
            }

            var bsModal = null;
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    bsModal = new bootstrap.Modal(modalEl);
                }
            } catch (e) { console.warn(e); }

           /* $('#affiliateDetailsModal .modal-body').html(
                '<div class="text-center py-4">' +
                '<div class="spinner-border" role="status">' +
                '<span class="visually-hidden">Loading...</span>' +
                '</div>' +
                '</div>'
            );
*/


            $.get('@Url.Action("GetCorrespondanceRequest", "FileUpload")', {
                KEY: id,
                partialView: "_CorrespondanceRequestDetails"
            })
            .done(function (html) {
                   bsModal.show();
                $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
            })
            .fail(function () {
                $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
            });
        });

        // Approve handler
        $(document).on('click', '.btn-approve', function (e) {
            e.preventDefault();
            var raw = $(this).data('id');
            var id = raw ? decodeURIComponent(raw) : null;
            if (!id) {
                if (typeof appalert === 'function') appalert('Missing id for details', 0, 1);
                return;
            }

            var modalEl = document.getElementById('affiliateDetailsModal');
            if (!modalEl) {
                if (typeof appalert === 'function') appalert('Approval modal not found', 0, 1);
                return;
            }

            var bsModal = null;
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    bsModal = new bootstrap.Modal(modalEl);
                }
            } catch (e) { console.warn(e); }

           /* $('#affiliateDetailsModal .modal-body').html(
                '<div class="text-center py-4">' +
                '<div class="spinner-border" role="status">' +
                '<span class="visually-hidden">Loading...</span>' +
                '</div>' +
                '</div>'
            );
*/


            $.get('@Url.Action("GetCorrespondanceRequest", "FileUpload")', {
                KEY: id,
                partialView: "_CorrespondenceApprovalAndRejectionRequest",
                path:"approve"
            })
            .done(function (html) {
                   bsModal.show();
                $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
            })
            .fail(function () {
                $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
            });
        });

       @* // Approve handler
        $(document).off('click', '.btn-approve').on('click', '.btn-approve', function (e) {
            e.preventDefault();
            var raw = $(this).data('id');
            var id = raw ? decodeURIComponent(raw) : null;
            if (!id) {
                if (typeof appalert === 'function') appalert('Missing id for approve', 0, 1);
                return;
            }

            confirmAction('Are you sure you want to APPROVE this correspondence?', function () {
                postJsonWithToken('@Url.Action("Approve", "FileUpload")', { id: id }, function (res) {
                    if (res && res.isSuccess) {
                        if (typeof appalert === 'function') appalert(res.message || 'Approved', 3, 1);
                        if (correspondenceTable) correspondenceTable.ajax.reload(null, false);
                    } else {
                        if (typeof appalert === 'function') appalert((res && res.message) || 'Approve failed', 0, 1);
                    }
                }, function () {
                    if (typeof appalert === 'function') appalert('Server error while approving', 0, 1);
                });
            });
        });*@

        // Reject handler
        $(document).on('click', '.btn-reject', function (e) {
            e.preventDefault();
            var raw = $(this).data('id');
            var id = raw ? decodeURIComponent(raw) : null;
            if (!id) {
                if (typeof appalert === 'function') appalert('Missing id for details', 0, 1);
                return;
            }

            var modalEl = document.getElementById('affiliateDetailsModal');
            if (!modalEl) {
                if (typeof appalert === 'function') appalert('Rejection modal not found', 0, 1);
                return;
            }

            var bsModal = null;
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    bsModal = new bootstrap.Modal(modalEl);
                }
            } catch (e) { console.warn(e); }

           /* $('#affiliateDetailsModal .modal-body').html(
                '<div class="text-center py-4">' +
                '<div class="spinner-border" role="status">' +
                '<span class="visually-hidden">Loading...</span>' +
                '</div>' +
                '</div>'
            );
           */


            $.get('@Url.Action("GetCorrespondanceRequest", "FileUpload")', {
                KEY: id,
                partialView: "_CorrespondenceApprovalAndRejectionRequest",
                path:"reject"
            })
            .done(function (html) {
                   bsModal.show();
                $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-center text-muted">No details available.</div>');
            })
            .fail(function () {
                $('#affiliateDetailsModal .modal-body').html('<div class="text-center text-danger">Error loading details</div>');
                if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
            });
        });

       @* $(document).off('click', '.btn-reject').on('click', '.btn-reject', function (e) {
            e.preventDefault();
            var raw = $(this).data('id');
            var id = raw ? decodeURIComponent(raw) : null;
            if (!id) {
                if (typeof appalert === 'function') appalert('Missing id for reject', 0, 1);
                return;
            }

            confirmAction('Are you sure you want to REJECT this correspondence?', function () {
                postJsonWithToken('@Url.Action("Reject", "FileUpload")', { id: id }, function (res) {
                    if (res && res.isSuccess) {
                        if (typeof appalert === 'function') appalert(res.message || 'Rejected', 3, 1);
                        if (correspondenceTable) correspondenceTable.ajax.reload(null, false);
                    } else {
                        if (typeof appalert === 'function') appalert((res && res.message) || 'Reject failed', 0, 1);
                    }
                }, function () {
                    if (typeof appalert === 'function') appalert('Server error while rejecting', 0, 1);
                });
            });
        });*@

        $(document).ready(function () {
            $('#applyFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                loadCorrespondenceData();
            });

            $('#resetFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                resetCorrespondenceFilters();
            });

            $('#correspondenceFilterForm input').off('keypress').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#applyFilterBtn').click();
                }
            });

            if ($.fn.select2) {
                try {
                    if ($('#Status').length) $('#Status').select2({ width: '100%', placeholder: 'Status' });
                } catch (err) { console.warn('select2 init failed', err); }
            }
        });
    </script>
}
