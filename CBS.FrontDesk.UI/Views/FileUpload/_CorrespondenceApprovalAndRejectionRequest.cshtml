@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.CorrespondenceApproveAndRejection
@using Resources
@using (Html.BeginForm("ApproveOrRejectCorrespondenceRequest", "FileUpload", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{

    @Html.AntiForgeryToken()
    <div class="card mb-3 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center text-primary">
            <span>
                <i class="mdi mdi-checkbox-marked-circle-outline me-2"></i>
                Correspondence Request Approval / Rjection
            </span>
            @if (Model.Type == "Approval")
            {
                <span class="badge bg-info text-dark">
                    Approval Request
                </span>
            }
            else if (Model.Type == "Rejection")
            {
                <span class="badge bg-info text-dark">
                    Rejection Request
                </span>
            }

        </div>

        <div class="card-body">
            <!-- Hidden Id / Language (for post) -->
            @Html.HiddenFor(m => m.Id, new { id = "CorrespondenceId" })
            @Html.HiddenFor(m => m.Type)
            @Html.HiddenFor(m => m.Language, new { id = "CorrespondenceLanguage" })

            <!-- Tips block -->
            <div class="alert alert-light border mb-3">
                <div class="d-flex">
                    <div class="me-2">
                        <i class="mdi mdi-information-outline text-primary fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-primary mb-1">Approval tips</h6>
                        <ul class="mb-0 ps-3">
                            <li>Review the correspondence details before approving or rejecting.</li>
                            <li>Use the note field to explain the reason for your decision.</li>
                            <li>Your user identity will be attached automatically for audit trail.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Basic info (read-only) -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="mdi mdi-identifier me-1"></i> Id
                    </label>
                    <input type="text"
                           class="form-control"
                           value="@Model.Id"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="mdi mdi-account-check-outline me-1"></i> Requested By
                    </label>
                    <input type="text"
                           class="form-control"
                           value="@Model.RequestBy"
                           readonly />
                </div>
            </div>

            <!-- Note field -->
            <div class="mb-3">
                @Html.LabelFor(m => m.Note, new { @class = "form-label fw-bold text-primary" })
                @Html.TextAreaFor(
                    m => m.Note,
                    new
                    {
                        @class = "form-control",
                        rows = "4",
                        placeholder = "Enter approval note (required for audit)...",
                        id = "CorrespondenceNote"
                    })
                <small class="text-muted">
                    Provide a clear justification. This note will be stored in the audit trail.
                </small>
            </div>

            <!-- Optional: language display (read-only) -->
            @* @if (!string.IsNullOrWhiteSpace(Model.Language))
                {
                    <div class="mb-2">
                        <label class="form-label fw-bold">
                            <i class="mdi mdi-translate me-1"></i> Language
                        </label>
                        <input type="text"
                               class="form-control"
                               value="@Model.Language"
                               readonly />
                    </div>
                }*@
        </div>

        <!-- Footer with Approve button -->
        <div class="card-footer d-flex justify-content-end">
            @if (Model.Type == "Approval")
            {
                <button type="submit" class="btn btn-success" id="btnApproveCorrespondence"   data-bs-dismiss="modal">
                    <i class="mdi mdi-check-circle-outline me-1"></i> Approve
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-danger" id="btnRejectCorrespondence"  data-bs-dismiss="modal">
                    <i class="mdi mdi-check-circle-outline me-1"></i> Reject
                </button>
            }

        </div>
    </div>
}
