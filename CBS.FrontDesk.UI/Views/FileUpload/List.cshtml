@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.AccountwaitingCorrespondanceQuery
@using Resources
@{
    ViewBag.Title = "Affiliate Overview - Filters";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-group me-2"></i>Account Awaiting Correspondance Listing
                </h1>
                <p class="card-text">@AccountingV2.AffiliateManagementtext</p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<div id="filtersSection" class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @AccountingV2.AffiliateFilters</h5>

    <form id="affiliateFilterForm" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">

            <!-- Row 0: Branch + Affiliate -->
            <div class="row mb-3 g-2">
                <div class="col-md-6">
                    @Html.DropDownListFor(
                        m => m.BranchId,
                        new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- " + @GlobalUserManagement.SelectBranch + " ---",
                        new { @class = "form-select select2", id = "BranchId" }
                    )
                </div>

                <div class="col-md-6">
                    @Html.DropDownListFor(
                        m => m.AffiliateId,
                        new SelectList(ViewBag.Affiliates ?? new List<SelectListItem>(), "Id", "Name"),
                        "--- " + @AccountingV2.All + " ---",
                        new { @class = "form-select select2", id = "AffiliateId" }
                    )
                </div>
            </div>

            <!-- Row 1: Scope, Class -->
            <div class="row mb-2">
                <div class="col-md-6">
                    @Html.DropDownList(
                        "Scope",
                        new SelectList(new[]
                        {
                            new SelectListItem { Text = "--- Select Scope ---", Value = "" },
                            new SelectListItem { Text = "Affiliate", Value = "Affiliate" },
                            new SelectListItem { Text = "Branch", Value = "Branch" }
                        }, "Value", "Text"),
                        null,
                        new { @class = "form-select", id = "Scope" }
                    )
                </div>

                <div class="col-md-6">
                    @Html.DropDownList(
                        "Class",
                        new SelectList(ViewBag.Classes ?? new List<SelectListItem>(), "Value", "Text"),
                        "--- Select Account Class ---",
                        new { @class = "form-select", id = "Class" }
                    )
                </div>
            </div>

            <!-- Row 2: Name, Filter By Account Code -->
            <div class="row mb-2">
                <div class="col-md-12">
                    @Html.TextBox("AccountCode", null, new { @class = "form-control", placeholder = "Filter by Account Code" })
                </div>
            </div>

            <!-- Row 3: CreatedFromUtc, CreatedToUtc -->
            <div class="row mb-2">
                <div class="col-md-6">
                    @Html.TextBox("CreatedFromUtc", null, new { @class = "form-control", type = "date", placeholder = "Created From (UTC)" })
                </div>
                <div class="col-md-6">
                    @Html.TextBox("CreatedToUtc", null, new { @class = "form-control", type = "date", placeholder = "Created To (UTC)" })
                </div>
            </div>

            <!-- Row 4: PostingAllowed, IncludeDeleted -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-12 d-flex flex-wrap gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="PostingAllowed" name="PostingAllowed" />
                        <label class="form-check-label fw-bold" for="PostingAllowed">Posting Allowed</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="IncludeDeleted" name="IncludeDeleted" />
                        <label class="form-check-label fw-bold" for="IncludeDeleted">@AccountingV2.IncludeDeleted</label>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyAffiliateFilterBtn" type="button" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @AccountingV2.ApplyFilter
                </button>
                <button id="resetAffiliateFilterBtn" type="button" class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @AccountingV2.Reset
                </button>
            </div>
        </div>
    </form>
</div>



<!-- DataTable placeholder (table will be created/initialized only when Apply is clicked) -->
<div id="affiliateListingView" class="mt-3">
    @* You can keep the partial or leave empty; DataTable will be inserted if not present. *@
    <div id="affiliateTableContainer">
        <!-- table injected here on Apply -->
    </div>
</div>

<!--------------------------------------------------Modals---------------------------------------------------->
<!-- Details Modal -->
<div class="modal fade" id="affiliateDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- server-rendered details partial will be injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal - used for Add & Update -->
<div class="modal fade" id="affiliateFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- server-rendered add/update partial will be injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <!-- Save button inside partial will handle submit; keep this as fallback -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
(function ($) {
          'use strict';

          var affiliateTable = null;


    function escAttr(v) {
        if (v === null || v === undefined) return '';
        return String(v)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
          // Map numeric Class -> label
          const CLASS_MAP = {
            "EQUITY": "EQUITY",
            "FIXED ASSETS": "FIXED ASSETS",
            "MEMBERS": "MEMBERS",
            "THIRD PARTIES": "THIRD PARTIES",
            "TREASURY": "TREASURY",
            "EXPENSES": "EXPENSES",
            "REVENUE": "REVENUE",
            "OUTSIDE ORDINARY ACTIVITIES (OOA)": "OUTSIDE ORDINARY ACTIVITIES (OOA)",
            "MANAGEMENT": "MANAGEMENT"
          };
          function renderClassLabel(raw) {
            if (raw == null) return '-';
            const v = String(raw).trim();
            if (CLASS_MAP[v]) return CLASS_MAP[v];
            // if backend already sends text, keep it
            return Object.values(CLASS_MAP).includes(v) ? v : '-';
          }

          function collectAffiliateFilters() {
            // read only what’s on the page (no toggle logic)
            const getVal = (sel) => {
              const v = $(sel).val();
              return (v === undefined || v === null || String(v).trim() === '') ? null : v;
            };
            const getBool = (sel) => $(sel).is(':checked') ? true : null;

            return {
              BranchId: getVal('#BranchId'),
              AffiliateId: getVal('#AffiliateId'),
              Scope: getVal('#Scope'),
              Class: getVal('#Class'),
              AccountCode: getVal('#AccountCode') || getVal('input[name="AccountCode"]'), // safety
              CreatedFromUtc: getVal('#CreatedFromUtc') || getVal('input[name="CreatedFromUtc"]'),
              CreatedToUtc: getVal('#CreatedToUtc') || getVal('input[name="CreatedToUtc"]'),
              PostingAllowed: getBool('#PostingAllowed'),
              IncludeDeleted: getBool('#IncludeDeleted')
            };
          }

          function initSelect2() {
            if (!$.fn.select2) return;
            try {
              $('#BranchId').select2({ width: '100%', placeholder: 'Select Branch', allowClear: true });
              $('#AffiliateId').select2({ width: '100%', placeholder: 'Select Affiliate', allowClear: true });
              $('#Scope').select2({ width: '100%', placeholder: 'Select Scope', allowClear: true });
              $('#Class').select2({ width: '100%', placeholder: 'Select Account Class', allowClear: true });
            } catch (e) {
              console.warn('select2 init failed', e);
              if (typeof appalert === 'function') appalert('select2 init failed: ' + (e?.message || e), 2, 1);
            }
          }

          function ensureTableSkeleton() {
            if (!$('#myDataTable').length) {
              $('#affiliateTableContainer').html(`
                <table id="myDataTable" class="table table-striped table-bordered w-100">
                  <thead>
                    <tr>
                      <th>Created</th>
                      <th>Account Code</th>
                      <th>Name</th>
                      <th>Class</th>
                      <th>Posting</th>
                      <th>Scope</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              `);
            }
          }

          function initDataTableIfNeeded() {
            if (affiliateTable && $.fn.DataTable.isDataTable('#myDataTable')) return;

            ensureTableSkeleton();

            // Clean up any prior instance hard
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
              try { $('#myDataTable').DataTable().destroy(); } catch {}
              $('#myDataTable').empty();
              ensureTableSkeleton();
            }

            affiliateTable = $('#myDataTable').DataTable({
              serverSide: true,
              searching: false,
              responsive: true,
              destroy: true,
              order: [[0, 'desc']],
              ajax: {
                url: '@Url.Action("LoadAccountwaitingData", "FileUpload")',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                  const filters = collectAffiliateFilters();
                  const orderIdx = (d.order && d.order[0] && d.order[0].column) ?? 0;
                  const sortCol = (d.columns && d.columns[orderIdx] && d.columns[orderIdx].data) || 'CreatedDate';
                  const sortDir = (d.order && d.order[0] && d.order[0].dir) || 'desc';

                  return JSON.stringify({
                    ...filters,
                    options: {
                      draw: d.draw,
                      start: d.start,
                      length: d.length,
                      skip: d.start,
                      pageSize: d.length,
                      searchValue: d.search?.value || '',
                      sortColumnName: sortCol,
                      sortColumnDirection: sortDir
                    }
                  });
                },
                error: function (jqXHR) {
                  let msg = 'Failed to load data. Please try again.';
                  try { msg = jqXHR.responseJSON?.message || msg; } catch {}
                  if (typeof appalert === 'function') appalert(msg, 0, 1);
                }
              },
              columns: [
                {
                  data: 'CreatedDate',
                  render: function (data) {
                    return data ? (window.moment ? moment(data).format('DD/MM/YYYY HH:mm:ss') : data) : '-';
                  }
                },
                // Adjust these field names to your DTO:
                { data: 'Code', defaultContent: '-' },
                { data: 'Name', defaultContent: '-' },
                {
                  data: 'Class',
                  defaultContent: '-',
                 /* render: function (data) {
                    const label = renderClassLabel(data);
                    return label === '-' ? label : `<span class="badge bg-light text-dark">${label}</span>`;
                  }*/
                },
                {
                  data: 'PostingAllowed',
                  render: function (val) {
                    return (val === true || val === 'true')
                      ? '<span class="badge bg-success">Yes</span>'
                      : '<span class="badge bg-secondary">No</span>';
                  }
                },
                { data: 'Scope', defaultContent: '-' },
                {
                  data: 'Id',
                  orderable: false,
                  searchable: false,
                  render: function (data, type, row) {
                    const rawId = String(row.id || row.Id || data || '');
                    const recordId = encodeURIComponent(rawId);
                    const safeId = rawId.replace(/[^a-zA-Z0-9_-]/g, '') || 'x';
                    const btnId = 'actionDropdown_' + safeId;



                      const name = escAttr(row.Name ?? row.name ?? '');
                      const scope = escAttr(row.Scope ?? row.scope ?? '');
                      const branchId = escAttr(row.BranchId ?? row.branchId ?? '');
                      const hoPcmfAccountId = escAttr(row.HoPcmfAccountId ?? row.hoPcmfAccountId ?? '');
                      const affiliateAccountId = escAttr(row.AffiliateAccountId ?? row.affiliateAccountId ?? '');
                      const branchAccountId = escAttr(row.BranchAccountId ?? row.branchAccountId ?? '');

                      const isDeleted = row.isDeleted === true || row.isDeleted === 'true' || row.isDeleted === 1;

                      const detailsBtn = `
                              <button type="button" class="dropdown-item btn-details"
                                      data-id="${recordId}" data-name="${name}">
                                <i class="mdi mdi-eye me-1 text-primary"></i> View Acc. To Be Mapped Details
                              </button>`;

                     const addCorrBtn = `
                              <button type="button" class="dropdown-item btn-addcorr"
                                      data-id="${recordId}"
                                      data-name="${name}"
                                      data-scope="${scope}"
                                      data-branch-id="${branchId}"
                                      data-hopcmf-account-id="${hoPcmfAccountId}"
                                      data-affiliate-account-id="${affiliateAccountId}"
                                      data-branch-account-id="${branchAccountId}">
                                <i class="mdi mdi-plus-box-outline me-1 text-success"></i> Add Corres. request
                              </button>`;


                    return `
                      <div class="dropdown text-center">
                        <button class="btn btn-sm btn-info dropdown-toggle text-white"
                                type="button" id="${btnId}"
                                data-bs-toggle="dropdown" aria-expanded="false">
                          <i class="mdi mdi-cog-outline"></i> Actions
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="${btnId}">
                          <li>${detailsBtn}</li>
                          <li>${addCorrBtn}</li>
                        </ul>
                      </div>
                    `.trim();
                  }
                }
              ],
              language: { emptyTable: 'No records found' },
              lengthMenu: [10, 25, 50],
              pageLength: 10,
              initComplete: function () {
                try {
                  if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                      new bootstrap.Tooltip(el);
                    });
                  }
                } catch {}
              }
            });
    }



          // Delegated actions
          function bindDelegatedActions() {
            // Details
            $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
              e.preventDefault();
              const $btn = $(this);
              let id;
              try { id = $btn.data('id') ? decodeURIComponent($btn.data('id')) : null; } catch { id = $btn.data('id') || null; }
              if (!id) { if (typeof appalert === 'function') appalert('Missing id for details', 0, 1); return; }

              const original = $btn.html();
              $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...');

              $.get('@Url.Action("InitializeData", "FileUpload")', { KEY: id, partialView: '_Details' })
                .done(function (html) {
                  $('#affiliateDetailsModal .modal-body').html(html || '<div class="text-muted p-3">No details available.</div>');
                  try {
                    new bootstrap.Modal(document.getElementById('affiliateDetailsModal')).show();
                  } catch (err) { console.error('Modal show error:', err); }
                })
                .fail(function () {
                  $('#affiliateDetailsModal .modal-body').html('<div class="text-danger p-3">Error loading details.</div>');
                  try {
                    new bootstrap.Modal(document.getElementById('affiliateDetailsModal')).show();
                  } catch (err) { console.error('Modal show error:', err); }
                  if (typeof appalert === 'function') appalert('Failed to load details', 0, 1);
                })
                .always(function () { $btn.prop('disabled', false).html(original); });
            });

            // Add Correspondence
            $(document).off('click', '.btn-addcorr').on('click', '.btn-addcorr', function () {
                const recordId = $(this).data('id');
                const name = $(this).data('name');
                const scope = $(this).data('scope');

                // New attributes
                const branchId = $(this).data('branch-id') ?? $(this).data('branchId');
                const hoPcmfAccountId = $(this).data('hopcmf-account-id') ?? $(this).data('hopcmfAccountId');
                const affiliateAccountId = $(this).data('affiliate-account-id') ?? $(this).data('affiliateAccountId');
                const branchAccountId = $(this).data('branch-account-id') ?? $(this).data('branchAccountId');


              // lazy modal
              if (!$('#correspondenceModal').length) {
                $('body').append(`
                  <div class="modal fade" id="correspondenceModal" tabindex="-1" aria-labelledby="correspondenceModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg"><div class="modal-content">
                      <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body"></div>
                    </div></div>
                  </div>
                `);
              }

              $('#correspondenceModal .modal-body').html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
                $.get('/FileUpload/GetCorrespondencePartial', {
                    recordId,
                    name,
                    scope,
                    branchId,
                    hoPcmfAccountId,
                    affiliateAccountId,
                    branchAccountId })
                .done(function (html) {
                  $('#correspondenceModal .modal-body').html(html);
                  new bootstrap.Modal(document.getElementById('correspondenceModal')).show();
                })
                .fail(function () {
                  $('#correspondenceModal .modal-body').html('<div class="text-danger p-3">Failed to load correspondence form</div>');
                  new bootstrap.Modal(document.getElementById('correspondenceModal')).show();
                });
            });


              if ($.fn.select2) {
                  try {
                      $('#HoPcmfAccountId').select2({ width: '100%', placeholder: 'Select HO PCMF Account', allowClear: true });
                      $('#AffiliateAccountId').select2({ width: '100%', placeholder: 'Select Affiliate Account', allowClear: true });
                  } catch (e) { console.warn('select2 init failed', e); }
              }


            // Update
            $(document).off('click', '.btn-update').on('click', '.btn-update', function (e) {
              e.preventDefault();
              const $btn = $(this);
              let id;
              try { id = $btn.data('id') ? decodeURIComponent($btn.data('id')) : null; } catch { id = $btn.data('id') || null; }
              if (!id) { if (typeof appalert === 'function') appalert('Missing id to update correspondence', 0, 1); return; }

              const original = $btn.html();
              $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...');

              $.get('@Url.Action("InitializeData", "FileUpload")', { KEY: id, partialView: '_UpdateAwaitingCorrespondance' })
                .done(function (html) {
                  $('#affiliateFormModal .modal-body').html(html || '<div class="text-muted p-3">No form returned.</div>');
                  new bootstrap.Modal(document.getElementById('affiliateFormModal')).show();
                })
                .fail(function (jqXHR, textStatus, errorThrown) {
                  $('#affiliateFormModal .modal-body').html('<div class="text-danger p-3">Error loading form.</div>');
                  new bootstrap.Modal(document.getElementById('affiliateFormModal')).show();
                  if (typeof appalert === 'function') appalert('Failed to load form: ' + (errorThrown || textStatus), 0, 1);
                })
                .always(function () { $btn.prop('disabled', false).html(original); });
            });

            // Delete
            $(document).off('click', '.btn-delete').on('click', '.btn-delete', function (e) {
              e.preventDefault();
              let id;
              try { id = $(this).data('id') ? decodeURIComponent($(this).data('id')) : null; } catch { id = $(this).data('id') || null; }
              if (!id) return (typeof appalert === 'function') ? appalert('Missing id for delete', 0, 1) : null;

              if (!confirm('Are you sure you want to delete this record?')) return;

              $.post('@Url.Action("Delete", "FileUpload")', { KEY: id })
                .done(function (res) {
                  if (res && res.success) {
                    if (affiliateTable) affiliateTable.ajax.reload(null, false);
                    if (typeof appalert === 'function') appalert(res.message || 'Deleted', 3, 1);
                  } else {
                    if (typeof appalert === 'function') appalert(res?.message || 'Delete failed', 0, 1);
                  }
                })
                .fail(function () {
                  if (typeof appalert === 'function') appalert('Delete request failed', 0, 1);
                });
            });
          }

          function resetAffiliateFilters() {
            const form = document.getElementById('affiliateFilterForm');
            if (form) form.reset();

            // Clear select2s
            if ($.fn.select2) {
              try {
                $('#BranchId').val(null).trigger('change');
                $('#AffiliateId').val(null).trigger('change');
                $('#Scope').val(null).trigger('change');
                $('#Class').val(null).trigger('change');
              } catch {}
            }

            if (affiliateTable) affiliateTable.ajax.reload(null, false);
          }

          $(function () {
            initSelect2();
            bindDelegatedActions();

            // Apply -> (re)load server data
            $('#applyAffiliateFilterBtn').off('click').on('click', function (e) {
              e.preventDefault();
              initDataTableIfNeeded();
              if (affiliateTable) affiliateTable.ajax.reload(null, false);
            });

            // Reset
            $('#resetAffiliateFilterBtn').off('click').on('click', function (e) {
              e.preventDefault();
              resetAffiliateFilters();
            });

            // Optional: Enter key triggers Apply
            $('#affiliateFilterForm').on('keypress', 'input,select', function (e) {
              if (e.which === 13) {
                e.preventDefault();
                $('#applyAffiliateFilterBtn').trigger('click');
              }
            });

            // No auto-load; user clicks Apply
          });
})(jQuery);
    </script>
}

