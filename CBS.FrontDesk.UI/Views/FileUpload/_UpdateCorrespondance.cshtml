@model CBS.FrontDesk.Data.Entity.Accounting_V2.FileUpload.Accountwaiting
@using (Html.BeginForm("CreateOrUpdate", "FileUpload", FormMethod.Post, new { id = "formUpdateCorrespondence" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="mb-3">
        <label class="form-label">Type</label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Details</label>
        <textarea asp-for="Details" class="form-control"></textarea>
        <span asp-validation-for="Details" class="text-danger"></span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary" id="saveUpdateCorrespondence">Save changes</button>
    </div>
}
<script>
    (function () {
        $('#formUpdateCorrespondence').off('submit').on('submit', function (e) {
            e.preventDefault();
            var $form = $(this);
            $.post($form.attr('action'), $form.serialize())
                .done(function (res) {
                    if (res?.isSuccess) {
                        bootstrap.Modal.getInstance(document.getElementById('affiliateFormModal')).hide();
                        if (typeof affiliateTable !== 'undefined' && affiliateTable) affiliateTable.ajax.reload(null, false);
                        if (typeof appalert === 'function') appalert(res.message || 'Updated', 3, 1);
                    } else {
                        // show validation / error
                        if (res && res.errors) {
                            for (var k in res.errors) {
                                $('[data-valmsg-for="' + k + '"]').html(res.errors[k].join('<br/>'));
                            }
                        } else {
                            if (typeof appalert === 'function') appalert(res.message || 'Update failed', 0, 1);
                        }
                    }
                }).fail(function () {
                    if (typeof appalert === 'function') appalert('Server error', 0, 1);
                });
        });
    })();
</script>
