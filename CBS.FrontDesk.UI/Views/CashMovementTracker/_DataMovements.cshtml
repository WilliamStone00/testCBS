
@model  CBS.FrontDesk.Data.Entity.CashMovementTracker.CashMovementConfiguration

@if (Convert.ToBoolean(Session["IsHeadOffice"]))
{
    <table class="table table-hover" id="DataTableCashMovementTrackerDataHO">
        <thead class="table-light">
            <tr>
                <th>Branch</th>
                <th>Requested By</th>
                <th>Approved By</th>
                <th>OperaRetionType</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.CashMovementDtos)
            {
                if (!d.BranchName.Contains("Head office"))
                {
                    <tr>
                        <td style="width:20%">@d.BranchName</td>
                        <td style="width:22%">@d.RequestedBy</td>
                        <td style="width:23%">@d.ApprovedBy</td>
                        <td style="width:10%">@d.OperationType</td>
                        <td style="width:15%">@d.Amount</td>

                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateTracker','details','CashMovementTracker','cashmovementtracker')" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select item to edit">Activate</a>
                       
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

}
else
{
    <table class="table table-hover" id="DataTableCashMovementTrackerDataBranch">
        <thead class="table-light">
            <tr>
           
                <th>Requested By</th>
                <th>Approved By</th>
                <th>OperaRetionType</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.CashMovementDtos)
            {
                if (!d.BranchName.Contains("Head office"))
                {
                    <tr>

                        <td style="width:32%">@d.RequestedBy</td>
                        <td style="width:33%">@d.ApprovedBy</td>
                        <td style="width:10%">@d.OperationType</td>
                        <td style="width:15%">@d.Amount</td>

                        <td style="width:10%">
                            <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview','_CreateTracker','details','CashMovementTracker','cashmovementtracker')" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" title="Select item to edit">Activate</a>
                        </td>
                    </tr>
                }

            }
        </tbody>
    </table>
}
