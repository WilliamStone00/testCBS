@model  CBS.FrontDesk.Data.Entity.CashMovementTracker.CashMovementConfiguration
    @using Resources
<div class="table-responsive mb-3">
    <table class="table table-hover" id="DataTableCashMovementTrackerData">
        <thead class="table-light">
            <tr>
                @if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                {
                    <th>@GlobalShared.Branch</th>
                }

            <th>@GlobalShared.Approved_by</th>
            <th>@GlobalShared.Amount</th>
            <th>@GlobalShared.Message</th>
            <th>@GlobalShared.Movement</th>
            <th>@GlobalShared.Action</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Convert.ToBoolean(Session["IsHeadOffice"]) == true)
                {
                    foreach (var d in Model.CashReplenimentRequestDtos)
                    {
                        <tr>
                            <td style="width:25%">@d.BranchOffice</td>
                            <td style="width:25%">@d.ApprovedBy</td>
                            <td style="width:15%">@d.AmountApproved</td>
                            <td style="width:10%">@GlobalCashMovementTracker.BankCashOut</td>
                            <td style="width:15%">
                                @{
                                    @(d.BranchId == d.CorrespondingBranchId ? "Bank CashOut" : "Branch to Branch")
                                }
                            </td>
                            <td style="width:10%">
                                <a href="#" onclick="SetCashMovementTracker(@d.BranchId,@d.Id,'CashRepleniment', @(d.BranchId == d.CorrespondingBranchId ? "Bank CashOut" : "Branch to Branch"))" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#largeModal" title="@GlobalShared.Select @d.ReferenceId @GlobalCashMovementTracker.ToSetTracker">@GlobalCashMovementTracker.SetTracker</a>

                            </td>
                        </tr>
                    }
                    foreach (var d in Model.DepositNotificationDto)
                    {
                        <tr>
                            <td style="width:25%">@d.BranchOffice</td>
                            <td style="width:25%">@d.ApprovedBy</td>
                            <td style="width:15%">@d.Amount</td>
                            <td style="width:10%">@GlobalCashMovementTracker.BankDeposit</td>
                            <td style="width:15%">
                                @{
                                    @(d.BranchId == d.BankAccountOwner ? "Bank Deposit" : "Branch to Branch")
                                }
                            </td>
                            <td style="width:10%">
                                <a href="#" onclick="SetCashMovementTracker(@d.BranchId,@d.Id,'Deposit', @(d.BranchId == d.BankAccountOwner ? "Bank Deposit" : "Branch to Branch"))" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#largeModal" title="@GlobalShared.Select @d.Id @GlobalCashMovementTracker.ToSetTracker">@GlobalCashMovementTracker.SetTracker</a>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    foreach (var d in Model.CashReplenimentRequestDtos)
                    {
                        <tr>

                            <td style="width:25%">@d.ApprovedBy</td>
                            <td style="width:20%">@d.AmountApproved</td>
                            <td style="width:15%">@GlobalCashMovementTracker.BankCashOut</td>
                            <td style="width:15%">
                                @{
                                    @(d.BranchId == d.CorrespondingBranchId ? "Bank CashOut" : "Branch to Branch")
                                }
                            </td>
                            <td style="width:10%">
                                <a href="#" onclick="SetCashMovementTracker(@d.BranchId,@d.Id,'CashRepleniment', @(d.BranchId == d.CorrespondingBranchId ? "Bank CashOut" : "Branch to Branch"))" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#largeModal" title="@GlobalShared.Select @d.ReferenceId @GlobalCashMovementTracker.ToSetTracker">@GlobalCashMovementTracker.SetTracker</a>
                            </td>
                        </tr>
                    }
                    foreach (var d in Model.DepositNotificationDto)
                    {
                        <tr>

                            <td style="width:25%">@d.ApprovedBy</td>
                            <td style="width:15%">@d.Amount</td>
                            <td style="width:10%">@GlobalCashMovementTracker.BankDeposit</td>
                            <td style="width:15%">
                                @{
                                    @(d.BranchId == d.BankAccountOwner ? "Bank Deposit" : "Branch to Branch")
                                }
                            </td>
                            <td style="width:10%">
                                <a href="#" onclick="SetCashMovementTracker(@d.BranchId,@d.Id,'Deposit', @(d.BranchId == d.BankAccountOwner ?  "Bank Deposit" : "Branch to Branch"))" class="mr-2 btn btn-primary" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#largeModal" title="@GlobalShared.Select @d.Id @GlobalCashMovementTracker.ToSetTracker">@GlobalCashMovementTracker.SetTracker</a>

                            </td>
                        </tr>
                    }

                }

            }

        </tbody>
    </table>

    </div>

