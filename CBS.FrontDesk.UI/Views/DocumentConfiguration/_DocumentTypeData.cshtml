@model  CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
<table class="table table-hover" id="myDataTable_DocumentType">
    <thead class="table-light">
        <tr>
            <th>Document</th>
            <th>Type</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.DocumentTypeDtos)
        {

            <tr>
                <td style="width:20%">@d.documentName</td>
                <td style="width:20%">@d.name</td>
                <td style="width:40%">@d.description</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_DocumentType','_CreateDocumentType','update','DocumentConfiguration','DocumentType')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteDataConfiguration('DocumentConfiguration','@d.id','myDataTable_DocumentType','_DocumentTypeData',0,'datalistingview_DocumentType','DocumentType')">Delete</a>

                </td>


            </tr>


        }
    </tbody>
</table>
