@model CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "DocumentConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEvent" id="ServiceOption" />
     <div class="row mt-2 gy-4">
         <div class="col-6">
             <div class="form-floating form-floating-outline">
                 @Html.DropDownListFor(m => m.DocumentReferenceCode.DocumentId, new SelectList(ViewBag.Document == null ? "" : ViewBag.Document, "Id", "Name"), "---"+ @GlobalDocumentConfiguration.SelectDocument +"---", new { @class = "form-control select2", @search = "true" })
                 @Html.ValidationMessageFor(m => m.DocumentReferenceCode.DocumentId, "", new { @class = "text-danger" })
                 <label>@GlobalDocumentConfiguration.OperationEvent</label>
             </div>
         </div>
         <div class="col-6">
             <div class="form-floating form-floating-outline">
                 @Html.DropDownListFor(m => m.DocumentReferenceCode.DocumentTypeId, new SelectList(ViewBag.DocumentType == null ? "" : ViewBag.DocumentType, "Id", "Name"), "---"+ @GlobalDocumentConfiguration.SelectDocument +"---", new { @class = "form-control select2", @search = "true" })
                 @Html.ValidationMessageFor(m => m.DocumentReferenceCode.DocumentTypeId, "", new { @class = "text-danger" })
                 <label>@GlobalDocumentConfiguration.OperationEvent</label>
             </div>
         </div>
         <div class="col-md-6">
             <div class="form-floating form-floating-outline">
                 @Html.TextBoxFor(m => m.DocumentReferenceCode.ReferenceCode, new { @class = "form-control" })
                 @Html.ValidationMessageFor(m => m.DocumentReferenceCode.ReferenceCode, "", new { @class = "text-danger" })
                 <label>@GlobalDocumentConfiguration.ReferenceCode</label>
             </div>
         </div>
         <div class="col-md-6">
             <div class="form-floating form-floating-outline">

                 @Html.TextAreaFor(m => m.DocumentReferenceCode.Description, new { @class = "form-control", @style = "height: 200px;" })
                 @Html.ValidationMessageFor(m => m.DocumentReferenceCode.Description, "", new { @class = "text-danger" })
                 <label>@GlobalShared.Description</label>

             </div>
         </div>

         <div class="col-md-12">
             @Html.CheckBoxFor(m => m.DocumentReferenceCode.HasException, new { @class = "form-check-input", @id = "IsActiveCheckbox", @value = false })
             <label>@GlobalDocumentConfiguration.CheckThisBoxIfTheReferenceCodeHasExceptionsToConsider</label>

         </div>




     </div>

        <div class="mt-4">
            @if (Model.DocumentReferenceCode.Id == null)
            {
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                @Html.HiddenFor(m => m.DocumentReferenceCode.Id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }
</div>