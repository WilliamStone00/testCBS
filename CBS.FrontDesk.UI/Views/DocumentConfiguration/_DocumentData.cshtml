@model  CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
    @using Resources
<table class="table table-hover" id="myDataTable_Document">
    <thead class="table-light">
        <tr>
            <th>@GlobalShared.Name</th>
            <th>@GlobalShared.Description</th>
            <th>@GlobalShared.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Documents)
        {

            <tr>
                <td style="width:35%">@d.name</td>
                <td style="width:45%">@d.description</td>

                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_Document','_CreateDocument','update','AccountingConfiguration','Document')" class="mr-2" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.name @GlobalShared.ToEdit">@GlobalShared.Edit</a>
                    <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="@GlobalShared.Delete @d.name" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.id','myDataTable_Document','_DocumentData',0,'datalistingview_Document','Document')">@GlobalShared.Delete</a>

                </td>


            </tr>


        }
    </tbody>
</table>
 