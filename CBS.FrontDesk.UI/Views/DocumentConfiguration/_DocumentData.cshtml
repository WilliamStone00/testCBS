@model  CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
<table class="table table-hover" id="myDataTable_Document">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Documents)
        {

            <tr>
                <td style="width:35%">@d.name</td>
                <td style="width:45%">@d.description</td>

                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen('@d.id','datalistingview_Document','_CreateDocument','update','AccountingConfiguration','Document')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">Edit</a>
                    <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="Delete @d.name" onclick="DeleteDataConfiguration('AccountingConfiguration','@d.id','myDataTable_Document','_DocumentData',0,'datalistingview_Document','Document')">Delete</a>

                </td>


            </tr>


        }
    </tbody>
</table>
 