@model  CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
<table class="table table-hover" id="myDataTable_DocumentReferenceCode">
    <thead class="table-light">
        <tr>
            <th>Document</th>
            <th>Type</th>
            <th>ReferenceCode</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.DocumentReferenceCodes)
        {

            <tr>
                <td style="width:15%">@d.Document</td>
                <td style="width:15%">@d.DocumentType</td>
                <td style="width:15%">@d.ReferenceCode</td>
                <td style="width:30%">@d.Description</td>
                @if (d.Document.ToLower() == "profitandloss")
                {

                }
                else
                {
                    <td style="width:40%">
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_DocumentReferenceCode','_CreateDocumentReferenceCode','update','DocumentConfiguration','DocumentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ReferenceCode to edit">Gross Accounts</a>|
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_DocumentReferenceCode','_CreateDocumentReferenceCode','update','DocumentConfiguration','DocumentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ReferenceCode to edit">Provision Accounts</a>|
                        <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_DocumentReferenceCode','_CreateDocumentReferenceCode','update','DocumentConfiguration','DocumentReferenceCode')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.ReferenceCode to edit">Edit ReferenceCode</a>|
                        <a href="#" class="mr-2 " data-toggle="tooltip" data-placement="top" title="Delete @d.ReferenceCode" onclick="DeleteDataConfiguration('DocumentConfiguration','@d.Id','myDataTable_DocumentReferenceCode','_DocumentReferenceCodeData',0,'datalistingview_DocumentReferenceCode','DocumentReferenceCode')">Delete ReferenceCode</a>

                    </td>

                }


            </tr>


        }
    </tbody>
</table>
