@model CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "DocumentConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEventAttribute" id="ServiceOption" />

     <div class="row mt-2 gy-4">
         <div class="col-6">
             <div class="form-floating form-floating-outline">
                 @Html.DropDownListFor(m => m.DocumentType.documentId, new SelectList(ViewBag.Document == null ? "" : ViewBag.Document, "Id", "Name"), "---Select Document---", new { @class = "form-control select2", @search = "true" })
                 @Html.ValidationMessageFor(m => m.DocumentType.documentId, "", new { @class = "text-danger" })
                 <label>OperationEvent</label>
             </div>
         </div>
         <div class="col-6">
             <div class="form-floating form-floating-outline">
                 @Html.TextBoxFor(m => m.DocumentType.name, new { @class = "form-control" })
                 @Html.ValidationMessageFor(m => m.DocumentType.name, "", new { @class = "text-danger" })
                 <label>Name</label>
             </div>
         </div>
         <div class="col-12">
             <div class="form-floating form-floating-outline">
                 @Html.TextBoxFor(m => m.DocumentType.description, new { @class = "form-control" })
                 @Html.ValidationMessageFor(m => m.DocumentType.description, "", new { @class = "text-danger" })
                 <label>Name</label>
             </div>
         </div>

     </div>

        <div class="mt-4">
            @if (Model.DocumentType.id == null)
            {
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">Update</button>
                @Html.HiddenFor(m => m.DocumentType.id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }            
            <div class="text-center text-muted"><small>C B S 4 U user account (@Session["FullName"])</small></div>
        </div>

    }
</div>