@model CBS.FrontDesk.Data.Entity.Accounting.DocumentConfiguration
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("AddOrUpdate", "DocumentConfiguration", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {<input type="hidden" name="ServiceOption" value="operationEvent" id="ServiceOption" />
        <div class="row mt-2 gy-4">
            <div class="col-md-6">
                <div class="form-floating form-floating-outline">
                    @Html.TextBoxFor(m => m.Document.name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Document.name, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Name</label>
                </div>
            </div>
       

            <div class="col-md-12">
                <div class="form-floating form-floating-outline">

                    @Html.TextAreaFor(m => m.Document.description, new { @class = "form-control", @style = "height: 200px;" })
                    @Html.ValidationMessageFor(m => m.Document.description, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Description</label>

                </div>
            </div>






        </div>

        <div class="mt-4">
            @if (Model.Document.id == null)
            {
                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                @Html.HiddenFor(m => m.Document.id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    }
</div>