@model CBS.FrontDesk.Data.Entity.AccountingV2.CashReconciliation.CashAndVaultInit
@using Resources
@{
    ViewBag.Title = "Cash Reconciliation";
}

@using (Html.BeginForm("SaveCashReconciliation", "CashReconciliation", FormMethod.Post,
    new { enctype = "multipart/form-data", id = "ReconciliationForm", onsubmit = "return cashReconciliationSubmitAjax(this);" }))
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-primary mb-0">
                    <i class="mdi mdi-cash-multiple me-2"></i> Cash Reconciliation
                </h6>
            </div>

            <!-- Branch -->
            <div class="row mb-4 align-items-end">
                <div class="col-md-12 mb-3">
                    @Html.Label("BranchId", "Branch", new { @class = "form-label fw-bold", @for = "BranchId" })
                    @Html.DropDownList(
                        "BranchId",
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-control select2 mb-1", id = "BranchId", required = "required", onchange = "loadReconciliationAccounts(this.value)" }
                    )
                </div>
            </div>

            <!-- Cash GL -->
            <div class="row mb-4 align-items-end">
                <div class="col-md-12 mb-3">
                    @Html.Label("SourceGlId", "Cash GL", new { @class = "form-label fw-semibold", @for = "SourceGlId" })
                    @Html.DropDownList("SourceGlId",
                        new List<SelectListItem> { new SelectListItem { Text = "--- Select Cash GL ---", Value = "" } },
                        new { @class = "form-control select2", id = "SourceGlId", required = "required" })
                </div>
            </div>

            <!-- Amount / Balance / Diff -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", id = "Amount", placeholder = "Enter Cash in Hand", required = "required", type = "text", inputmode = "decimal" })
                        <label for="Amount">Amount</label>
                        @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-floating shadow-sm">
                        <input type="text" class="form-control" id="Balance" name="Balance" readonly placeholder="Balance" />
                        <label for="Balance">Balance</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-floating shadow-sm">
                        <input type="text" class="form-control" id="CashDiff" name="CashDiff" readonly placeholder="Cash diff" />
                        <label for="CashDiff">Cash diff</label>
                    </div>
                </div>
            </div>

            <!-- Difference GL -->
            <div class="row mb-4 align-items-end">
                <div class="col-md-12 mb-3">
                    @Html.Label("DestinationGlId", "Difference GL", new { @class = "form-label fw-semibold", @for = "DestinationGlId" })
                    @Html.DropDownList("DestinationGlId",
                        new List<SelectListItem> { new SelectListItem { Text = "--- Select cash diff GL ---", Value = "" } },
                        new { @class = "form-control select2", id = "DestinationGlId", required = "required" })
                </div>
            </div>

            <!-- Till + Cashier -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.TillName, new { @class = "form-control", id = "TillName", placeholder = "Enter Till name", required = "required" })
                        <label for="TillName">Till Name</label>
                        @Html.ValidationMessageFor(m => m.TillName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-floating shadow-sm">
                        @Html.TextBoxFor(m => m.NameOfCashier, new { @class = "form-control", id = "NameOfCashier", placeholder = "Enter Cashier name", required = "required" })
                        <label for="NameOfCashier">Cashier Name</label>
                        @Html.ValidationMessageFor(m => m.NameOfCashier, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- Note -->
            <div class="mt-4">
                @* If your model uses "Narration", change to m => m.Narration and keep id="Memo" for script compatibility *@
                @Html.Label("Memo", "Note", new { @class = "form-label fw-bold", @for = "Memo" })
                @Html.TextAreaFor(m => m.Naration, new { @class = "form-control shadow-sm", rows = "3", placeholder = "Enter any remark or note about the cash reconciliation", required = "required", id = "Memo" })
                @Html.ValidationMessageFor(m => m.Naration, "", new { @class = "text-danger" })
            </div>

            <div class="mt-4 text-end">
                <button type="button" class="btn btn-primary" onclick="cashReconciliationSubmitAjax(this.form)">SAVE</button>
            </div>
        </div>
    </div>
}
