<div class="card">
    <div class="card-body">
        @Html.Partial("_Initialise")
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
$(document).ready(function () {
    $('.select2').select2();
    let treasuryBalance = 0;

    // 🔹 Fetch balance when Source GL changes
    $("#SourceGlId").on("change", function () {
        const accountId = $(this).val();
        if (!accountId) {
            treasuryBalance = 0;
            $("#Balance, #CashDiff").val("");
            return;
        }

        $.ajax({
            url: '@Url.Action("GetAccountBalance", "CashReconciliation")',
            type: 'GET',
            data: { accountId: accountId },
            success: function (response) {
                if (response && response.success) {
                    treasuryBalance = parseFloat(response.balance) || 0;
                    $("#Balance").val(treasuryBalance.toLocaleString());
                    calculateCashDiff();
                } else {
                    treasuryBalance = 0;
                    $("#Balance, #CashDiff").val("");
                    appalert(response.message || "Balance not found", 3, 1);
                }
            },
            error: function () {
                treasuryBalance = 0;
                $("#Balance, #CashDiff").val("");
                appalert("Failed to get balance", 0, 1);
            }
        });
    });

    // 🔹 Recalculate Cash Diff when Amount changes
    $("#Amount").on("input", function () {
        calculateCashDiff();
    });

    function calculateCashDiff() {
        const amount = parseFloat($("#Amount").val().replace(/,/g, '')) || 0;
        const cashDiff = treasuryBalance - amount;
        $("#CashDiff").val(cashDiff.toLocaleString());
    }
});


// 🔹 Load Treasury and Deficit Accounts (called from onchange)
function loadReconciliationAccounts(branchId) {
    if (!branchId) {
        $("#SourceGlId").html('<option value="">--- Select Cash GL ---</option>').trigger('change');
        $("#DestinationGlId").html('<option value="">--- Select cash diff GL ---</option>').trigger('change');
        $("#Balance, #CashDiff").val("");
        appalert("Please select a valid branch.", 3, 1);
        return;
    }

    // Disable dropdowns during fetch
    $("#SourceGlId, #DestinationGlId").prop("disabled", true);

    $.ajax({
        url: '@Url.Action("GetCashReconciliationAccounts", "CashReconciliation")',
        type: 'GET',
        data: { branchId: branchId },
        success: function (response) {
            if (response && response.success) {

                //console.log("Result : " + response);
                // Treasury → Cash GL
                let sourceOptions = '<option value="">--- Select Cash GL ---</option>';
                response.data.treasuryAccounts.forEach(acc => {
                    sourceOptions += `<option value="${acc.accountId}">${acc.accountName}</option>`;
                });
                $("#SourceGlId").html(sourceOptions).trigger('change');

                // Deficit → Difference GL
                let destOptions = '<option value="">--- Select cash diff GL ---</option>';
                response.data.deficitAccounts.forEach(acc => {
                    destOptions += `<option value="${acc.accountId}">${acc.accountName}</option>`;
                });
                $("#DestinationGlId").html(destOptions).trigger('change');

                appalert("Accounts loaded successfully.", 1, 1);
            } else {
                appalert(response.message || "Failed to load accounts.", 2, 1);
            }
        },
        error: function () {
            appalert("Error loading accounts", 0, 1);
        },
        complete: function () {
            $("#SourceGlId, #DestinationGlId").prop("disabled", false);
        }
    });
}


// 🔹 Submit confirmation modal
window.cashReconciliationSubmitAjax = function (form) {
    if (!$(form).valid()) return false;

    const confirmationTitle = "Confirm Cash Reconciliation";
    const message = `
        <p>Please review the details below before confirming:</p>
        <table class="table table-sm table-bordered">
            <tbody>
                <tr><th>Branch</th><td>${$('#BranchId option:selected').text()}</td></tr>
                <tr><th>Cash GL (Source)</th><td>${$('#SourceGlId option:selected').text()}</td></tr>
                <tr><th>Cash GL (Destination)</th><td>${$('#DestinationGlId option:selected').text()}</td></tr>
                <tr><th>Amount</th><td>${$('#Amount').val()}</td></tr>
                <tr><th>Balance</th><td>${$('#Balance').val()}</td></tr>
                <tr><th>Cash Diff</th><td>${$('#CashDiff').val()}</td></tr>
                <tr><th>Till Name</th><td>${$('#TillName').val()}</td></tr>
                <tr><th>Cashier</th><td>${$('#NameOfCashier').val()}</td></tr>
                <tr><th>Note</th><td>${$('#Memo').val()}</td></tr>
            </tbody>
        </table>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
            <label for="alertifyConfirmCheckbox" class="form-check-label">
                I confirm that the above reconciliation details are correct.
            </label>
        </div>
    `;

    alertify.confirm(confirmationTitle, message,
        function () {
            if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                return false;
            }

            $.ajax({
                type: 'POST',
                url: form.action,
                data: new FormData(form),
                processData: false,
                contentType: false,
                beforeSend: function () {
                    $('.alertify .ajs-ok').prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm"></span> Processing...');
                },
                success: function (response) {
                    if (response.success) {
                        appalert(response.message || "✅ Saved successfully!", 1, 1);
                        alertify.dismissAll();
                        if (response.reloadDataView === "Yes") {
                            $('#ReconciliationForm')[0].reset();
                            $('.select2').val(null).trigger('change');
                        }
                    } else {
                        appalert(response.message || "❌ Failed to save cash reconciliation", 2, 1);
                    }
                },
                error: function (xhr) {
                    appalert("❌ Error: " + xhr.statusText, 0, 1);
                },
                complete: function () {
                    $('.alertify .ajs-ok').prop('disabled', false).html('Yes, Continue');
                }
            });
        },
        function () {
            appalert("🚫 Operation cancelled.", 2, 1);
        }
    ).set({
        labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
        onshow: function () {
            const okBtn = $('.alertify .ajs-ok');
            okBtn.prop('disabled', true);
            $('#alertifyConfirmCheckbox').off('change').on('change', function () {
                okBtn.prop('disabled', !this.checked);
            });
        }
    });
};
    </script>
}
