@{ ViewBag.Title = "Notification History"; }
@using Resources

<!-- =================================================
     PAGE HEADER
================================================== -->
<div class="card bg-light mb-4 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary fw-bold mb-2">
            <i class="mdi mdi-history me-2"></i> @GlobalNotificationHistory.notification_history
        </h1>
        <p class="card-text text-muted mb-1">
            @GlobalNotificationHistory.search_and_review_the_history_of_all_automated_notifications_sent_by_the_system.
        </p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            <strong>@GlobalShared.how_to_search:</strong> @GlobalNotificationHistory.you_must_select_a_search_criteria_either_branch_or_customer_id_and_click_the_search_button_to_load_data.
        </div>
        <hr style="border-top: 1px solid rgba(0,0,0,0.1);" />
    </div>
</div>


<!-- =================================================
     TIPS SECTION (Collapsible)
================================================== -->
<div class="card mb-4">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> @GlobalNotificationHistory.tips_for_searching_history</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ol class="list-group list-group-numbered">
                <li class="list-group-item">
                    <strong>@GlobalNotificationHistory.choose_your_search_method:</strong> @GlobalNotificationHistory.start_by_using_the_search_by_dropdown_this_changes_the_input_field_to_allow_you_to_search_for_all_notifications_sent_to_a_specific_branch_or_a_single_customer_id.
                </li>
                <li class="list-group-item">
                    <strong>@GlobalShared.branch_search:</strong> @GlobalNotificationHistory.when_searching_by_branch_you_will_see_a_complete_history_of_all_notifications_related_to_that_branchs_activities_this_is_useful_for_branchlevel_audits.
                </li>
                <li class="list-group-item">
                    <strong>@GlobalNotificationHistory.customer_id_search:</strong> @GlobalNotificationHistory.when_searching_by_customer_id_you_will_see_all_notifications_sent_directly_to_that_specific_customer_this_is_useful_for_investigating_a_customers_query.
                </li>
                <li class="list-group-item">
                    <strong>@GlobalShared.review_content:</strong> @GlobalNotificationHistory.the_content_column_in_the_results_table_shows_the_exact_message_that_was_sent_for_long_messages_hover_over_the_text_to_see_the_full_content_in_a_tooltip.
                </li>
            </ol>
        </div>
    </div>
</div>

<!-- Search/Filter Section -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-magnify me-1"></i> @GlobalNotificationHistory.search_notification_history</h5>
    <div class="card p-3 mb-3 bg-light border">
        <div class="row g-3 align-items-end">
            <!-- Search Type Selector -->
            <div class="col-md-3">
                <label class="form-label fw-bold">@GlobalShared.search_by:</label>
                <select id="searchBy" class="form-control select2">
                    <option value="branch" selected>@GlobalShared.Branch</option>
                    <option value="customer">@GlobalShared.Customer_ID</option>
                </select>
            </div>

            <!-- Branch Search Input (Visible by default) -->
            <div id="branchSearchContainer" class="col-md-7">
                <label class="form-label">Select Branch</label>
                @Html.DropDownList("branchSearchValue", new SelectList(ViewBag.Branches, "Id", "Name"), $"--- {@GlobalShared.select_a_branch} ---", new { @class = "form-control select2" })
            </div>

            <!-- Customer Search Input (Initially Hidden) -->
            <div id="customerSearchContainer" class="col-md-7" style="display:none;">
                <label class="form-label">@GlobalShared.enter_customer_id</label>
                <input type="text" id="customerSearchValue" class="form-control" placeholder="Enter full Customer ID..." />
            </div>

            <!-- Action Button -->
            <div class="col-md-2">
                <button id="applyFilterBtn" class="btn btn-primary w-100"><i class="mdi mdi-magnify"></i> @GlobalShared.Search</button>
            </div>
        </div>
    </div>
</div>

<!-- DataTable Container -->
<div class="card shadow p-3">
    <div class="table-responsive">
        <table id="historyDataTable" class="table table-hover" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Customer</th>
                    <th>@GlobalShared.Branch</th>
                    <th>@GlobalShared.notification_type</th>
                    <th>@GlobalShared.sent_date</th>
                    <th>@GlobalShared.content</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script>
    $(document).ready(function() {
        let dataTable = null; // Holds the DataTable instance

        // --- Initialize UI ---
        $('.select2').select2({ width: '100%' });

        // --- Event Handlers ---

        // Toggle visibility of search inputs when the 'Search By' dropdown changes
        $('#searchBy').on('change', function() {
            const selected = $(this).val();
            if (selected === 'branch') {
                $('#branchSearchContainer').show();
                $('#customerSearchContainer').hide();
            } else {
                $('#branchSearchContainer').hide();
                $('#customerSearchContainer').show();
            }
        });

        // "Search" button click handler
        $('#applyFilterBtn').on('click', function () {
            const searchBy = $('#searchBy').val();
            const value = (searchBy === 'branch')
                ? $('#branchSearchValue').val()
                : $('#customerSearchValue').val();

            if (!value) {
                appalert('Please select a branch or enter a customer ID to search.', 2, 1);
                return;
            }

            // Initialize or reload the DataTable with new search criteria
            if (!dataTable) {
                dataTable = initializeDataTable(searchBy, value);
            } else {
                // Change the AJAX URL and reload
                let newUrl = `@Url.Action("LoadHistoryData", "NotificationHistory")?searchBy=${searchBy}&value=${value}`;
                dataTable.ajax.url(newUrl).load();
            }
        });

        // --- DataTable Initialization Function ---
        function initializeDataTable(searchBy, value) {
            return $('#historyDataTable').DataTable({
                "processing": true,
                "serverSide": false, // This is CLIENT-SIDE processing, as the full list is returned
                "ajax": {
                    "url": `@Url.Action("LoadHistoryData", "NotificationHistory")`,
                    "type": "POST",
                    "data": {
                        // Pass the filter criteria to the controller
                        searchBy: searchBy,
                        value: value
                    },
                    // The 'dataSrc' property points to the array in the JSON response
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "CustomerName", "defaultContent": "" },
                    { "data": "BranchName", "defaultContent": "" },
                    { "data": "NotificationType" },
                    {
                        "data": "SentDate",
                        "render": function(data) { return data ? new Date(data).toLocaleString() : ''; }
                    },
                    {
                        "data": "Content",
                        // Truncate long content for better display
                        "render": function(data) {
                             return data && data.length > 50 ?
                                `<span title="${data}">${data.substring(0, 50)}...</span>` :
                                data;
                        }
                    }
                ],
                "language": {
                    "emptyTable": "No notification history found. Please apply a search filter."
                }
            });
        }
    });
    </script>
}