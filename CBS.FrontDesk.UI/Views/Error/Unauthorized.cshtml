@{
    ViewBag.Title = "401-Unauthorized";
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
}


<h2 class="mb-4">401-Unauthorized Access</h2>
<p class="lead mb-4">Oops! It seems you don't have permission to access this page.</p>
<p>Please contact the administrator for assistance or try again later.</p>

<p>ERROR:<br />@ViewBag.ErrorMessage</p>
<a href="/" class="btn">Go Back to Home</a>