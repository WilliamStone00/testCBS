@using Resources
@{
    ViewBag.Title = "An Error Occurred";
    var title = ViewBag.TitleText ?? "Oops! Something went wrong.";
    var message = ViewBag.Message ?? "We're sorry, but an unexpected error has occurred.";
    var errorCode = ViewBag.StatusCode ?? 500;
    var stackTrace = ViewBag.StackTrace ?? "";
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    var showDiagnostics = HttpContext.Current.IsDebuggingEnabled; // show extra info in Debug mode
}

<div class="container mt-5">
    <div class="alert alert-danger shadow border-start border-4 border-danger">
        <h4 class="alert-heading"><i class="mdi mdi-alert-circle-outline me-2"></i> @title</h4>
        <p><strong>@GlobalShared.StatusCode:</strong> @errorCode</p>
        <p><strong>@GlobalShared.Message:</strong> @message</p>

        @if (showDiagnostics && !string.IsNullOrEmpty(stackTrace))
        {
            <hr />
            <pre class="bg-light p-3 rounded">@stackTrace</pre>
        }

        <hr />
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
            <i class="mdi mdi-home-outline me-1"></i> @GlobalShared.ReturnToHome
        </a>
    </div>
</div>
