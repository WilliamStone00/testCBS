@using Resources
@{
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    ViewBag.Title = "Access Blocked";

    string ip = Request.QueryString["ip"];
    string reason = Request.QueryString["reason"];
    string blockedAtRaw = Request.QueryString["blockedAt"];
    string unblockAfterRaw = Request.QueryString["unblockAfter"];

    string blockedAtFormatted = "Unavailable";
    string countdownMessage = "";

    if (DateTime.TryParse(blockedAtRaw, out DateTime parsedBlockedAt))
    {
        blockedAtFormatted = parsedBlockedAt.ToLocalTime().ToString("f");

        if (int.TryParse(unblockAfterRaw, out int minutes))
        {
            if (minutes <= 10)
            {
                var unblockTime = parsedBlockedAt.AddMinutes(minutes);
                var remaining = unblockTime.ToLocalTime() - DateTime.Now;

                if (remaining.TotalSeconds > 0)
                {
                    countdownMessage = $"<strong>Time Remaining:</strong> {remaining.Minutes} min {remaining.Seconds} sec";
                }
                else
                {
                    countdownMessage = "<strong>Time Remaining:</strong> expired – please try again.";
                }
            }
        }
    }
}
<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 text-danger mb-3">
            <i class="mdi mdi-shield-lock-outline"></i> @GlobalShared.Access_Blocked
        </h1>
        <h5 class="text-muted mb-4">HTTP Status Code: <span class="text-dark">403 – @GlobalShared.Forbidden</span></h5>
        <p class="lead text-secondary">@GlobalError.Your_access_has_been_restricted_due_to_unusual_or_excessive_activity</p>
    </div>

    <div class="card mx-auto mt-4 shadow-sm border-danger" style="max-width: 600px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">@GlobalShared.IP_Address:</dt>
                <dd class="col-sm-7">@ip</dd>

                <dt class="col-sm-5">@GlobalShared.Reason:</dt>
                <dd class="col-sm-7 text-capitalize">@reason</dd>

                <dt class="col-sm-5">@GlobalShared.Blocked_At:</dt>
                <dd class="col-sm-7">@blockedAtFormatted</dd>

                <dt class="col-sm-5">@GlobalShared.Bloc_Duration:</dt>
                <dd class="col-sm-7">@unblockAfterRaw minutes</dd>

                @if (!string.IsNullOrEmpty(countdownMessage))
                {
                    <dt class="col-sm-5">@GlobalShared.Status:</dt>
                    <dd class="col-sm-7 text-danger">@Html.Raw(countdownMessage)</dd>
                }
            </dl>
        </div>
    </div>

    <div class="text-center mt-4">
        <p>
            @Html.Raw(@GlobalError.If_you_believe_this_is_a_mistake_please_contact_support_via) <a href="mailto:support@trustsoftcredit.com">support@trustsoftcredit.com</a>
            @GlobalError.or_open_a_ticket_at <a href="https://support.trustsoftcredit.com">support.trustsoftcredit.com</a>.
        </p>
        <a href="/" class="btn btn-outline-primary">
            <i class="mdi mdi-home-outline"></i> @GlobalShared.ReturnToHome
        </a>
    </div>
</div>
