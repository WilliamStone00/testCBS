
@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
    @using Resources
@{
    ViewBag.Title = "Salary Summary";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-cabinet me-2"></i> @GlobalSalaryAnalyzer.SALARY_SUMMARY
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryAnalyzer.ViewAnalyzeAndManageEmployeeSalary.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card mb-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> @GlobalSalaryAnalyzer.TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalarySummaryTips" aria-expanded="false" aria-controls="collapseSalarySummaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalarySummaryTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-file-document-outline text-primary me-2"></i> @GlobalSalaryAnalyzer.UseThe <strong>"@GlobalSalaryAnalyzer.RunSalaryAnalysis"</strong> @GlobalSalaryAnalyzer.buttonToAnalyzeUploadedSalaryData.</li>
                            <li><i class="mdi mdi-eye-outline text-primary me-2"></i> @GlobalSalaryAnalyzer.ClickThe <strong>"@GlobalSalaryAnalyzer.ViewResultOfAnalyzedSalary"</strong> @GlobalSalaryAnalyzer.buttonToCheckPreviouslyAnalyzedResults.</li>
                            <li><i class="mdi mdi-alert-outline text-warning me-2"></i> @GlobalSalaryAnalyzer.EnsureAllUploadedSalaryFilesAreAccurate (e.g., Excel, CSV).</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryAnalyzer.RegularlyVerifyAnalyzedResults.</li>
                            <li><i class="mdi mdi-database-search-outline text-primary me-2"></i> @GlobalSalaryAnalyzer.UseSearchFiltersToQuicklyLocateSpecificEmployeeSalaryRecords.</li>
                            <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i> @GlobalSalaryAnalyzer.AddressAnomaliesLikeOverpayments.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> @GlobalSalaryAnalyzer.EditAnalyzedSalaryRecordsForCorrections.</li>
                            <li><i class="mdi mdi-delete-outline text-danger me-2"></i> @GlobalSalaryAnalyzer.DeleteInvalidUploadsToMaintainClean.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-chart-bar me-1"></i> @GlobalSalaryAnalyzer.SalaryAnalysis
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" href="/SalaryUpload" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>
                                            <!-- Run Salary Analysis -->
                                            <a type="button" href="#" class="btn btn-label-secondary btn-sm me-2"
                                               data-bs-toggle="tooltip" title="@GlobalSalaryAnalyzer.RunSalaryAnalysis"
                                               onclick="runAnalysis('@Model.SalaryUploadModelSummaryDto.FileUploadId')">
                                                <i class="mdi mdi-play-box-outline mdi-18px"></i> @GlobalSalaryAnalyzer.RunAnalysis
                                            </a>
                                            <!-- View Analyzed Results -->
                                            <a type="button" href="/SalaryAnalyzer/SalaryAnalysisResultSummary?fileUploadid=@Model.SalaryUploadModelSummaryDto.FileUploadId" target="_blank" class="btn btn-label-primary btn-sm" data-bs-toggle="tooltip" title="@GlobalSalaryAnalyzer.ViewAnalyzedResults">
                                                <i class="mdi mdi-file-eye-outline mdi-18px"></i> @GlobalSalaryAnalyzer.ViewResults
                                            </a>

                                        </div>
                                    </div>
                                    <div id="datalistingview">
                                        @Html.Partial("_SalaryDetailsData")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
        $(document).ready(function () {

            LoadDT("myDataTable", 0)


        });
        function runAnalysis(fileUploadId) {
        alertify.confirm(
          "RUN SALARY ANALYSIS WARNING!!!",
          "Are you sure you want to run the salary analysis?\nThis action cannot be reverted!",
          function () {
            const url = "/SalaryAnalyzer/ExecuteAnalysis";
            const payload = { FileUploadId: fileUploadId };

            $.ajax({
              type: "POST",
              url: url,
              contentType: "application/json",
              data: JSON.stringify(payload),
              success: function (response) {
                if (response && response.success) {
                  // Build the redirect URL safely using Razor to respect app base path/areas
                  const resultUrl = '@Url.Action("SalaryAnalysisResultSummary","SalaryAnalyzer")'
                                    + "?fileUploadid=" + encodeURIComponent(fileUploadId);

                  // Optional toast before redirect
                  appalert(response.message || "Analysis complete.", 1, 1);

                  // Redirect to the results page
                  window.location.assign(resultUrl); // or window.location.replace(resultUrl);
                } else {
                  appalert((response && response.message) || "Analysis failed.", 3, 1);
                }
              },
              error: function (err) {
                appalert(err.statusText || "Request failed.", 3, 1);
              }
            });
          },
          function () {
            appalert("Analysis cancelled", 3, 1);
          }
    );
  }

</script>
}





