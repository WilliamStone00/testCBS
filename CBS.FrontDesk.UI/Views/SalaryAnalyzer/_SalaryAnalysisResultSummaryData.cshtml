@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
@using Resources
<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <!-- Dashboard Header -->
        <div class="card-header bg-light">
            <h5 class="card-title text-primary mb-0">
                @GlobalSalaryAnalyzer.salary_analysis_dashboard
            </h5>
        </div>
        <div id="dashboardSummary" class="mb-4">
            <div class="row">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.Total_members</h6>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.SalaryAnalysisResultSummary.TotalMembers
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalSalaryAnalyzer.total_net_salary</h6>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.SalaryAnalysisResultSummary.TotalNetSalary.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_capital</h6>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.SalaryAnalysisResultSummary.TotalLoanCapital.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_interest</h6>
                            <p class="card-text fs-5 fw-bold text-danger">
                                @Model.SalaryAnalysisResultSummary.TotalLoanInterest.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_vat</h6>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.SalaryAnalysisResultSummary.TotalVAT.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_repayment</h6>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.SalaryAnalysisResultSummary.TotalLoanRepayment.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_deposit</h6>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.SalaryAnalysisResultSummary.TotalDeposit.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_savings</h6>
                            <p class="card-text fs-5 fw-bold text-success">
                                @Model.SalaryAnalysisResultSummary.TotalSavings.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_charges</h6>
                            <p class="card-text fs-5 fw-bold text-danger">
                                @Model.SalaryAnalysisResultSummary.TotalCharges.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_shares</h6>
                            <p class="card-text fs-5 fw-bold text-warning">
                                @Model.SalaryAnalysisResultSummary.TotalShares.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_salary</h6>
                            <p class="card-text fs-5 fw-bold text-info">
                                @Model.SalaryAnalysisResultSummary.TotalRemainingSalary.ToString("N1")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h6 class="card-title text-primary">@GlobalShared.total_branches</h6>
                            <p class="card-text fs-5 fw-bold text-primary">
                                @Model.SalaryAnalysisResultSummary.TotalBranches
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Tips Section -->
        <div class="card mb-2">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span>
                    <i class="mdi mdi-information-outline me-2"></i> @GlobalSalaryAnalyzer.tips_for_efficient_use
                </span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>
            <div id="collapseTips" class="collapse">
                <div class="card-body">
                    <ul class="mb-0">
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryAnalyzer.use_the_detailed_table_below_to_view_individual_salary_breakdowns.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalSalaryAnalyzer.export_the_results_to_excel_for_offline_review.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalSalaryAnalyzer.review_discrepancies_or_unusual_figures.</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- Detail Table Section -->
        <div class="card mt-4 shadow-sm border-0">
            <div class="card-header bg-light">
                <h5 class="card-title text-primary mb-0">
                    @GlobalSalaryAnalyzer.detailed_salary_analysis_results
                </h5>
            </div>
            <div id="datalistingview_inner">
                <div class="table-responsive mb-3">
                    @if (Model.SalaryAnalysisResultDetails != null && Model.SalaryAnalysisResultDetails.Any())
                    {
                        <table class="table table-bordered table-striped table-hover" id="myDataTable">
                            <thead class="table-light text-center align-middle">
                                <tr>
                                    <th rowspan="2">#</th>
                                    <th rowspan="2">@GlobalShared.Member_name</th>
                                    <th rowspan="2">@GlobalShared.Member_ref</th>
                                    <th rowspan="2">@GlobalShared.Amount</th>
                                    <th rowspan="2">SO</th>
                                    <th rowspan="2">@GlobalShared.Savings</th>
                                    <th rowspan="2">@GlobalShared.Deposit</th>
                                    <th rowspan="2">@GlobalSalaryAnalyzer.salary_after_deposit</th>
                                    <th rowspan="2">@GlobalShared.Shares</th>
                                    <th colspan="2">@GlobalShared.Main_Loan</th>
                                    <th colspan="2">@GlobalShared.Exceptional_Loan</th>
                                    <th colspan="2">@GlobalSalaryAnalyzer.elected_staff</th>
                                    <th colspan="2">@GlobalSalaryAnalyzer.special_loans_overdraft</th>
                                    <th colspan="2">@GlobalSalaryAnalyzer.micro_loan</th>
                                    <th colspan="2">SSF</th>
                                    <th rowspan="2">@GlobalShared.Charges</th>
                                    <th rowspan="2">@GlobalShared.Status</th>
                                </tr>
                                <tr>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                    <th>@GlobalShared.Capital</th>
                                    <th>@GlobalShared.Interest</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNumber = 0;
                                }
                                @foreach (var detail in Model.SalaryAnalysisResultDetails)
                                {
                                    rowNumber++;
                                    var totalAmount = detail.Savings + detail.Deposit + detail.Shares
                                                      + detail.Loan1_Main_Loan_Capital + detail.Loan1_Main_Loan_Interest
                                                      + detail.Loan2_Exceptional_Loan_Capital + detail.Loan2_Exceptional_Loan_Interest
                                                      + detail.Loan3_Elected_Staff_Capital + detail.Loan3_Elected_Staff_Interest
                                                      + detail.Loan4_Special_Loan_With_Overdraft_Capital + detail.Loan4_Special_Loan_With_Overdraft_Interest
                                                      + detail.Loan8_Micro_Loan_Capital + detail.Loan8_Micro_Loan_Interest
                                                      + detail.SpSavingCapital + detail.SpSavingInterest
                                                      + detail.Charges;
                                    <tr>
                                        <td class="text-center">@rowNumber</td>
                                        <td>@detail.MemberName</td>
                                        <td>@detail.CustomerId</td>
                                        <td class="text-end">@detail.NetSalary.ToString("N0")</td>
                                        <td class="text-end">@detail.StandingOrderAmount.ToString("N0")</td>
                                        <td class="text-end">@detail.Savings.ToString("N0")</td>
                                        <td class="text-end">@detail.Deposit.ToString("N0")</td>
                                        <td class="text-end">@((detail.Salary - detail.Deposit).ToString("N0"))</td>
                                        <td class="text-end">@detail.Shares.ToString("N0")</td>

                                        <td class="text-end">@detail.Loan1_Main_Loan_Capital.ToString("N0")</td>
                                        <td class="text-end">@detail.Loan1_Main_Loan_Interest.ToString("N0")</td>

                                        <td class="text-end">@detail.Loan2_Exceptional_Loan_Capital.ToString("N0")</td>
                                        <td class="text-end">@detail.Loan2_Exceptional_Loan_Interest.ToString("N0")</td>

                                        <td class="text-end">@detail.Loan3_Elected_Staff_Capital.ToString("N0")</td>
                                        <td class="text-end">@detail.Loan3_Elected_Staff_Interest.ToString("N0")</td>

                                        <td class="text-end">@detail.Loan4_Special_Loan_With_Overdraft_Capital.ToString("N0")</td>
                                        <td class="text-end">@detail.Loan4_Special_Loan_With_Overdraft_Interest.ToString("N0")</td>

                                        <td class="text-end">@detail.Loan8_Micro_Loan_Capital.ToString("N0")</td>
                                        <td class="text-end">@detail.Loan8_Micro_Loan_Interest.ToString("N0")</td>

                                        <td class="text-end">@detail.SpSavingCapital.ToString("N0")</td>
                                        <td class="text-end">@detail.SpSavingInterest.ToString("N0")</td>

                                        <td class="text-end">@detail.Charges.ToString("N0")</td>
                                        <td>
                                            <span class="badge @(detail.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">
                                                @detail.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center my-3">
                            <p>@GlobalSalaryAnalyzer.no_salary_analysis_results_found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</fieldset>
