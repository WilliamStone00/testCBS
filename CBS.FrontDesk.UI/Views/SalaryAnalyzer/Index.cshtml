@using Resources
@{
    ViewBag.Title = "Salary files";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-upload-multiple me-2"></i> @GlobalShared.uploaded_files
                </h1>
                <p class="card-text text-muted">
                    @GlobalSalaryAnalyzer.upload_and_manage_employee_salary_files_easily_and_efficiently.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> @GlobalShared.Tips</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryUploadTips" aria-expanded="false" aria-controls="collapseSalaryUploadTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryUploadTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalSalaryAnalyzer.download_salary_files:</strong> @GlobalShared.use_the <span class="text-primary"><i class="fas fa-download"></i> @GlobalShared.Download</span> @GlobalSalaryAnalyzer.button_to_retrieve_acopy_of_the_uploaded_file.</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>@GlobalShared.view_file_details:</strong> @GlobalShared.click_on_the <span class="text-info"><i class="fas fa-info-circle"></i> @GlobalShared.Details</span> @GlobalSalaryAnalyzer.button_to_view_detailed_analysis.</li>
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> <strong>@GlobalShared.delete_files:</strong> @GlobalShared.use_the <span class="text-danger"><i class="fas fa-trash-alt"></i> @GlobalShared.Delete</span> @GlobalSalaryAnalyzer.button_to_remove_files_that_are_incorrect.</li>
                            <li><i class="mdi mdi-information-outline text-primary me-2"></i> <strong>@GlobalShared.file_naming:</strong> @GlobalSalaryAnalyzer.make_sure_uploaded_files_have_meaningful_names.</li>
                            <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>@GlobalShared.regular_reviews:</strong> @GlobalShared.regularly_review_uploaded_files_to_verify_their_accuracy.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> <strong>@GlobalShared.editable_fields:</strong> @GlobalSalaryAnalyzer.for_minor_corrections_edit_salary_related.</li>
                            <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>@GlobalShared.track_status:</strong> @GlobalSalaryAnalyzer.monitor_the_processing_status_of_salary_files.</li>
                        </ul>
                    </div>
                </div>
            </div>


            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-upload me-1"></i> @GlobalShared.uploaded_files
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" onclick="LoadDataGen('SalaryAnalyzer','myDataTable','_FileUploadData',0,'datalistingview',null,null,'cs_salary')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                                <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {

            LoadDataGen('SalaryAnalyzer', 'myDataTable', '_FileUploadData', 0, 'datalistingview',null,'list','cs_salary')

        });
    </script>
}
