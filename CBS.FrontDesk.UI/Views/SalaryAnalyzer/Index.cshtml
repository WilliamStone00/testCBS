@{
    ViewBag.Title = "Salary files";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-upload-multiple me-2"></i> Uploaded files
                </h1>
                <p class="card-text text-muted">
                    Upload and manage employee salary files easily and efficiently. Use the tools below to upload new salary files or view existing records.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalaryUploadTips" aria-expanded="false" aria-controls="collapseSalaryUploadTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalaryUploadTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>Download Salary Files:</strong> Use the <span class="text-primary"><i class="fas fa-download"></i> Download</span> button to retrieve a copy of the uploaded file for offline review or backup.</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> <strong>View File Details:</strong> Click on the <span class="text-info"><i class="fas fa-info-circle"></i> Details</span> button to view detailed analysis and records related to the uploaded file. This opens the details in a new tab for convenience.</li>
                            <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> <strong>Delete Files:</strong> Use the <span class="text-danger"><i class="fas fa-trash-alt"></i> Delete</span> button to remove files that are incorrect, outdated, or no longer needed. Ensure you confirm the action as deleted files cannot be recovered.</li>
                            <li><i class="mdi mdi-information-outline text-primary me-2"></i> <strong>File Naming:</strong> Make sure uploaded files have meaningful names to help with easy identification during reviews.</li>
                            <li><i class="mdi mdi-calendar-check-outline text-primary me-2"></i> <strong>Regular Reviews:</strong> Regularly review uploaded files to verify their accuracy and ensure all payroll operations align with uploaded data.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> <strong>Editable Fields:</strong> For minor corrections, edit salary-related data after viewing the file details to align with updated requirements.</li>
                            <li><i class="mdi mdi-account-outline text-primary me-2"></i> <strong>Track Status:</strong> Monitor the processing status of salary files through the file details page.</li>
                        </ul>
                    </div>
                </div>
            </div>


            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-file-upload me-1"></i> Uploaded files
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" onclick="LoadDataGen('SalaryAnalyzer','myDataTable','_FileUploadData',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                                <i class="mdi mdi-view-list mdi-18px"></i> View List
                                            </a>
                                        </div>
                                    </div>
                                    <div id="datalistingview">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {

            LoadDataGen('SalaryAnalyzer', 'myDataTable', '_FileUploadData', 0, 'datalistingview')

        });
    </script>
}
