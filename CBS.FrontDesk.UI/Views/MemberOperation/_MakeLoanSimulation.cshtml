@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
<fieldset class="fieldset-custom">
    <div class="change-group">
        <div class="card mb-4">
            <div class="card-body d-sm-flex d-block">
                <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                    <div class="ms-3">
                        <a type="button" onclick="LoadLocalSchedule()" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="View schedule">
                            <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</fieldset>
<div class="col">
    @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostLoanScedule(this);" }))
    {
        <input type="hidden" name="ServiceOption" value="loan_schedule" id="ServiceOption" />
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryAddress"
                                aria-expanded="true"
                                aria-controls="collapseDeliveryAddress">
                            Enter parameters to simulate a loan
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <fieldset class="fieldset-custom">
                                <div class="row g-4">
                                    <div class="col-md-3">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.LoanParameter.Amount, new { @class = "form-control", @id = "financialInput", @oninput = "formatFinancialFigure(this.value)" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.Amount, "", new { @class = "text-danger" })
                                            <label>Amount</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.LoanParameter.LoanDuration, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.LoanDuration, "", new { @class = "text-danger" })
                                            <label>Loan duration</label>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.LoanParameter.LoanDurationType, new SelectList(ViewBag.LoanDurationPeriods, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.LoanDurationType, "", new { @class = "text-danger " })
                                            <label>Loan duration type</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.LoanParameter.InterestRate, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.InterestRate, "", new { @class = "text-danger" })
                                            <label>Interest rate (In percentage %)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.LoanParameter.AmortizationType, new SelectList(ViewBag.AmortizationTypes, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.AmortizationType, "", new { @class = "text-danger " })
                                            <label>Amortization type</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.LoanParameter.RepaymentCycle, new SelectList(ViewBag.RepaymentCycles, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.RepaymentCycle, "", new { @class = "text-danger " })
                                            <label>Repayment cycle</label>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.LoanParameter.StrRepaymentStartDate, new { @class = "form-control date-picker", @placeholder = "Date of first repayment" })
                                            @Html.ValidationMessageFor(m => m.LoanParameter.StrRepaymentStartDate, "", new { @class = "text-danger" })
                                            <label>Repayment start date</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary me-2">Generate schedule</button>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>

            </div>

        </div>


    }
</div>
<br />
<div class="accordion-body">
    <div id="amortization_schedule_data_div">

    </div>
</div>

