@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel

<div class="card mb-4">
    <div class="card-body d-sm-flex d-block">
        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
            <div class="ms-3">
                <a type="button" onclick="AddORUpdateGen('@Model.LoanApplication.Id','datalistingview','_MemberLoanApplicationDetail','application_detail','MemberOperation','applications')" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Reload detail page">
                    <span class="tf-icons mdi mdi-reload mdi-18px"></span>
                </a>
            </div>
        </div>
    </div>

</div>



<div class="col">

    <div class="row my-4">
        <div class="accordion" id="collapsibleSection">
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        Loan Term
                    </button>
                </h2>

                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="table-responsive mb-3">
                            @Html.Partial("_SharedLoanTerm")
                        </div>
                    </div>
                </div>
            </div>
           
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod8">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod8"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod8">
                            Add Guarantor
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod8"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod8"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="row g-4">
                                <div id="datalistingview_gurantor_add">
                                    @Html.Partial("_AddLoanGuarantor")
                                </div>
                            </div>
                            <hr />
                            <div class="accordion-body">
                                <div id="datalistingview_data">

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
           
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod4">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod4"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod4">
                            Add collateral
                        </button>
                    </h2>
                    <div id="collapsePaymentMethod4"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod4"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="row g-4">
                                <div id="datalistingview_collateral_add">
                                    @Html.Partial("_AddLoanCollateral")
                                </div>
                            </div>
                            <div id="datalistingview_collateral_data">

                            </div>
                        </div>
                    </div>
                </div>
           
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod5">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod5"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod5">
                        Add documents
                    </button>
                </h2>
                <div id="collapsePaymentMethod5"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod5"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div id="datalistingview_document_add">
                                @Html.Partial("_AddtachedLoanDocument")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


</div>




