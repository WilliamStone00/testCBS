@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel



@if (Model.LoanApplications.Count == 0)
{
    <div class="text-center my-3">
        <p class="fs-5 text-muted">No loan application was found for validation</p>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover table-bordered" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Members References</th>
                    <th>Loan Type</th>
                    <th>Amount</th>
                    <th>Application Type</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LoanApplications.OrderByDescending(app => app.ApplicationDate))
                {
                    <tr>
                        <td>@d.ApplicationDate.ToString("dd MMM yyyy")</td>
                        <td>@d.CustomerId</td>
                        <td>@d.LoanType</td>
                        <td>@d.Amount.ToString("#,0.00")</td>
                        <td>@d.LoanApplicationType</td>
                        <td>
                            @if (d.ApprovalStatus == "Awaits_Loan_Commitee_Validation")
                            {
                                <span class="badge bg-warning text-dark">Awaiting Committee</span>
                            }
                            else if (d.ApprovalStatus == "Await_Initialization_Fee_Payment")
                            {
                                <span class="badge bg-info text-white">Awaiting Fee Payment</span>
                            }
                            else
                            {
                                if (d.IsApproved)
                                {
                                    <span class="badge bg-success text-white">@d.ApprovalStatus</span>
                                }
                                else
                                {
                                    if (d.ApprovalStatus == "Validated")
                                    {
                                        <span class="badge bg-dark text-white">@d.ApprovalStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white">@d.ApprovalStatus</span>
                                    }
                                }
                            }
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="actionDropdown@d.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cog"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="actionDropdown@d.Id">
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="AddORUpdateGen('@d.Id', 'datalistingview', '_LoanApplicationApproval', 'loan_approval', 'MemberOperation', 'applications')">
                                            <i class="fas fa-check-circle me-2"></i> Approve
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#viewDetailsModal@d.Id">
                                            <i class="fas fa-info-circle me-2"></i>Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="DeleteRecordDataTable('LoanApplications', '@d.Id', 'myDataTable', '_Data', 0, 'datalistingview')">
                                            <i class="fas fa-trash-alt me-2"></i>Delete
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="ResetStatus('@d.Id')">
                                            <i class="fas fa-undo me-2"></i>Reset Status
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>

                    <!-- Modal for View Details -->
                    @*<div class="modal fade" id="viewDetailsModal@d.Id" tabindex="-1" aria-labelledby="viewDetailsModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="viewDetailsModalLabel">Loan Application Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">

                                        @Html.Partial("_LoanDetails", d)
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>*@
                }
            </tbody>
        </table>
    </div>
}




