@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
@{
    ViewBag.Title = GlobalLoanApplicationApproval.LoanApplicationApproval;
}

<div class="row g-4">
    <!-- 🗓️ Accounting Date -->
    <div class="col-md-12">
        <div class="form-floating form-floating-outline position-relative">
            @Html.TextBoxFor(
              m => m.UpdateLoanApplicationStatus.AccountingDate,
              Model.UpdateLoanApplicationStatus.AccountingDate == default(DateTime)
                ? DateTime.Today.ToString("yyyy-MM-dd")
                : "{0:yyyy-MM-dd}",
              new
                   {
                @class = "form-control accounting-date",
                type = "date",
                data_date_default = "today",   // auto-fill today if empty/MinValue
                data_date_max = "today"        // prevent future dates (remove if not needed)
                // data_date_min = "today"     // uncomment to only allow today & after
              })
            @Html.ValidationMessageFor(m => m.UpdateLoanApplicationStatus.AccountingDate, "", new { @class = "text-danger" })
            <label>@(Member_Global_LoanApplication.AccountingDate ?? "Accounting Date")</label>

            <span class="position-absolute top-0 end-0 translate-middle-y mt-3 me-3 badge bg-open-green px-3">
                <i class="mdi mdi-calendar-check-outline me-1"></i>
                <span id="ApprovalAccountingDateBadge"></span>
            </span>
        </div>
        <small class="text-muted">
            This date will be used for accounting entries tied to this approval.
        </small>
    </div>

    <div class="col-md-12">
        <div class="form-floating">
            @Html.TextBoxFor(m => m.UpdateLoanApplicationStatus.OTPCode, new { @class = "form-control", placeholder = @GlobalLoanApplicationApproval.EnterOTPCode, autocomplete = "one-time-code" })
            @Html.ValidationMessageFor(m => m.UpdateLoanApplicationStatus.OTPCode, "", new { @class = "text-danger" })
            <label for="UpdateLoanApplicationStatus_OTPCode">
                @GlobalLoanApplicationApproval.EnterOTPCodeFrom @Model.Customer.name
            </label>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-floating">
            @Html.DropDownListFor(
                m => m.UpdateLoanApplicationStatus.ApprovalStatus,
                new SelectList(ViewBag.LoanApplicationStatus, "Value", "Text"),
                "---Select---",
                new { @class = "form-control select2", @search = "true", placeholder = @GlobalLoanApplicationApproval.SelectApprovalStatus })
            @Html.ValidationMessageFor(m => m.UpdateLoanApplicationStatus.ApprovalStatus, "", new { @class = "text-danger" })
            <label for="UpdateLoanApplicationStatus_ApprovalStatus">@GlobalLoanApplicationApproval.SelectApprovalStatus</label>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-floating">
            @Html.TextAreaFor(m => m.UpdateLoanApplicationStatus.ApprovalComment, new { @class = "form-control", style = "height: 200px;", placeholder = @GlobalLoanApplicationApproval.AddAComment })
            @Html.ValidationMessageFor(m => m.UpdateLoanApplicationStatus.ApprovalComment, "", new { @class = "text-danger" })
            <label for="UpdateLoanApplicationStatus_ApprovalComment">@GlobalLoanApplicationApproval.Comment</label>
        </div>
    </div>
</div>
