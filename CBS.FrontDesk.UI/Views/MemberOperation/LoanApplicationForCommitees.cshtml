@{
    ViewBag.Title = GlobalLoanApplicationForCommitees.CommitteeValidations;
}
@using Resources

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account me-2"></i> @GlobalLoanApplicationForCommitees.CommitteeLoanApplicationValidations
                </h1>
                <p class="card-text text-muted">
                    @GlobalLoanApplicationForCommitees.CommitteeValidationsDescription
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> @GlobalLoanApplicationForCommitees.ImportantNotice</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>
            <div id="collapseHelpTips" class="collapse">
                <div class="card-body">
                    <ul>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalLoanApplicationForCommitees.Tip1</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalLoanApplicationForCommitees.Tip2</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalLoanApplicationForCommitees.Tip3</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalLoanApplicationForCommitees.Tip4</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @GlobalLoanApplicationForCommitees.Tip5</li>
                        <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalLoanApplicationForCommitees.Tip6</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">

            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between"
                    id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account me-2"></i>
                        @GlobalLoanApplicationForCommitees.LoanApplicationRequests @Session["BranchName"]
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div class="card mb-4">
                                    <div class="card-body d-sm-flex d-block">
                                        <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                                            <div class="ms-3">
                                                <a href="/MemberOperation/LoanApplicationForCommitees" type="button" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalLoanApplicationForCommitees.ViewListOfLoanApplications">
                                                    <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_LoanApplicationForCommiteeData")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/OperationPanel/LoanApplication.js"></script>
<script>
    $(document).ready(function () {
        LoadDT("myDataTable", 0);
    });

</script>
}
