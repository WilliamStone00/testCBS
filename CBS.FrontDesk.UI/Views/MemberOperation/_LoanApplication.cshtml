                                        <label class="form-check-label" for="isActive">Apply interest waiver to this application ?</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.InterestWaiverPercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.InterestWaiverPercentage, "", new { @class = "text-danger" })
                                        <label id="waiverranges">waiver rate (%)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod">
