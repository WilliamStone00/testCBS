@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel


<div class="col">
    @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.AddLoanApplicationCommand.CustomerId)
        <input type="hidden" value="@Model.AddLoanApplicationCommand.CustomerId" id="customerid" />
        <br />
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryAddress"
                                aria-expanded="true"
                                aria-controls="collapseDeliveryAddress">
                            Loan product
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Loan Product: This section allows you to select the appropriate loan product for the loan application. Here's a breakdown of the key components:
Key Points:
1. Select Loan Product Dropdown: Use this dropdown menu to choose the specific loan product that best fits the borrower's needs. The available options are populated based on the loan products available in the system.
2. Select Loan Type Dropdown: This dropdown menu enables you to specify the type of loan being applied for. It could be a personal loan, business loan, mortgage, etc.
3. Amount: Enter the desired loan amount in this field.
4. Loan Duration: Specify the intended duration of the loan in months or years.
5. Help Icon: Click on the help icon (ℹ️) next to the &quot;Loan Product&quot; heading for additional assistance and guidance on selecting the most suitable loan product for the borrower's needs.
By carefully selecting the appropriate loan product and terms in this section, you can ensure that the loan meets the borrower's needs while also aligning with their financial capabilities and objectives."></i>
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanApplicationType, new SelectList(ViewBag.LoanApplicationTypes, "Value", "Text"), "---Select loan application types---", new { @class = "form-control select2", @search = "true", @onchange = "LoadRefinancing(this.value,'loanapplicationtype','loanid')" })
                                        <label>Application type</label>
                                    </div>
                                </div>
                                <div class="col-md-12" style="display:none" id="loandiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanId, new SelectList(ViewBag.MembersLoan, "Value", "Text"), "---Select loan---", new { @class = "form-control select2", @search = "true", @id = "loanid" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanId, "", new { @class = "text-danger" })
                                        <label id="loanlable">Loan</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanProductId, new SelectList(ViewBag.LoanProducts, "Value", "Text"), "---Select loan product---", new { @class = "form-control select2", @search = "true", @onchange = "LoanProductsProperties(this.value,'loanrepayment_cycles','RepaymentCircle')" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanProductId, "", new { @class = "text-danger " })
                                        <label>Loan product</label>
                                    </div>
                                </div>
                                @*<div class="col-md-6">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanCategory, new SelectList(ViewBag.LoanCategories, "Value", "Text"), "---Select loan category---", new { @class = "form-control select2", @search = "true" })
                                            @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanCategory, "", new { @class = "text-danger " })
                                            <label>Select loan category</label>
                                        </div>
                                    </div>*@
                                <div class="col-12">
                                    <div class="form-check form-check-inline" id="accountType">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Main_Loan", new { id = "MainLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="MainLoan">Main Loan</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Special_Saving_Facility_Loan", new { id = "SpecialSavingFacilityLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="SpecialSavingFacilityLoan">Special Saving Facility</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanTarget, new SelectList(ViewBag.LoanTargets, "Value", "Text"), "---Select loan category---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanTarget, "", new { @class = "text-danger " })
                                        <label>Targeted population</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanType, new SelectList(ViewBag.LoanTypes, "Value", "Text"), "---Select loan type---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanType, "", new { @class = "text-danger " })
                                        <label>Select loan type</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.Amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.Amount, "", new { @class = "text-danger" })
                                        <label id="amount">Amount</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.LoanDuration, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanDuration, "", new { @class = "text-danger" })
                                        <label id="loanduration">Loan duration</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsChargesInclussive, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Check me to include charges to my loan. I don't have money to pay at the cash desk.</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod3">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod3"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod3">
                            Risk mitigation
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Risk Mitigation: This section allows you to specify risk mitigation measures associated with the loan application. Here's an overview of the key components:
Key Points:
1. Collateral: Check this box if the borrower has provided collateral for the loan.
2. Guarantor: Check this box if the borrower has provided a guarantor for the loan.
3. Share Account Coverage Amount: Enter the amount covered by the borrower's share account, if applicable.
4. Saving Account Coverage Rate: Specify the coverage rate provided by the borrower's saving account, if applicable.
5. Salary Account Coverage Rate: Enter the coverage rate provided by the borrower's salary account, if applicable.
By carefully considering and implementing appropriate risk mitigation measures in this section, you can minimize the potential losses associated with the loan and protect the interests of the lender."></i>

                        </button>
                    </h2>
                    <div id="collapsePaymentMethod3"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod3"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">

                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.RequiredDownPaymentCoverageRate, new { @class = "form-check-input" })
                                        <label id="downpaymentrate" class="form-check-label" for="isActive">Does this application require down payment?</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsThereGuarantor, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Have member provided guarantor Or Co-Obligator?</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsThereCollateral, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Have member provided collateral?</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsPreferenceShareAccountCoverageAmount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Place preference share as guarantee</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsDepositAccountCoverageAmount, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">Place deposit as guarantee</label>
                                    </div>
                                </div>
                                @*<div class="col-6">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsTermDeposiAccountCoverageAmount, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="isActive">Place temp deposit as guarantee</label>
                                        </div>
                                    </div>*@

                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.DepositAccountCoverageAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.DepositAccountCoverageAmount, "", new { @class = "text-danger" })
                                        <label>Deposit coverage amount</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.PreferenceShareAccountCoverageAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.PreferenceShareAccountCoverageAmount, "", new { @class = "text-danger" })
                                        <label>Preference coverage amount</label>
                                    </div>
                                </div>
                                @*<div class="col-md-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.TextBoxFor(m => m.AddLoanApplicationCommand.TermDeposiAccountCoverageAmount, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.TermDeposiAccountCoverageAmount, "", new { @class = "text-danger" })
                                            <label>Temp account coverage amount</label>
                                        </div>
                                    </div>*@
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.ShareAccountCoverageAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.ShareAccountCoverageAmount, "", new { @class = "text-danger" })
                                        <label id="share">Share account coverage amount</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.SavingAccountCoverageRate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.SavingAccountCoverageRate, "", new { @class = "text-danger" })
                                        <label id="saving">Saving account coverage rate</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.SalaryAccountCoverageRate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.SalaryAccountCoverageRate, "", new { @class = "text-danger" })
                                        <label id="salary">Salary account coverage rate</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingPaymentMethod4">
                        <button type="button"
                                class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapsePaymentMethod4"
                                aria-expanded="false"
                                aria-controls="collapsePaymentMethod4">
                            Grace period and charges
                            <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="Grace Period and Charges: This section allows you to specify grace period and charges associated with the loan application. Here's an overview of the key components:

 Key Points:
1. Apply Charges: Check this box if charges are applicable to this loan.
2. Charge Rate (%): Enter the percentage of charges applicable to the loan amount.
3. Number of Days to Apply Charges: Enter the number of days within which charges should be applied after the due date.
4. Grace Period Before First Payment: Enter the grace period, in months, before the first repayment installment is due.
5. Grace Period After Maturity Date: Enter the grace period, in days, after the entire loan becomes overdue.
By specifying these parameters accurately, you can ensure clarity regarding charges and grace periods associated with the loan, facilitating smooth loan management and repayment."></i>

                        </button>
                    </h2>
                    <div id="collapsePaymentMethod4"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPaymentMethod4"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.GracePeriodBeforeFirstPayment, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.GracePeriodBeforeFirstPayment, "", new { @class = "text-danger" })
                                        <label>Prefered first payment date (in Month e.g 1 or 2 or 3)</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.GracePeriodAfterMaturityDate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.GracePeriodBeforeFirstPayment, "", new { @class = "text-danger" })
                                        <label>Enter grace period after entire loan is overdure (in days)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryOptions">
                        <button type="button"
                                class="accordion-button collapsed"
