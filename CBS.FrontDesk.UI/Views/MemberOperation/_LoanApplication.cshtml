<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Get the elements
        const depositCheckbox = document.querySelector('input[name="AddLoanApplicationCommand.IsDepositAccountCoverageAmount"]');
        const preferenceCheckbox = document.querySelector('input[name="AddLoanApplicationCommand.IsPreferenceShareAccountCoverageAmount"]');
        const salaryCheckbox = document.querySelector('input[name="AddLoanApplicationCommand.IsSalryAccount"]'); // Salary checkbox

        const depositField = document.querySelector('[name="AddLoanApplicationCommand.DepositAccountCoverageAmount"]');
        const preferenceField = document.querySelector('[name="AddLoanApplicationCommand.PreferenceShareAccountCoverageAmount"]');
        const salaryField = document.querySelector('[name="AddLoanApplicationCommand.SalaryAccountCoverageRate"]'); // Salary field

        // Function to toggle visibility and reset value if unchecked
        function toggleFieldVisibilityAndReset(checkbox, field) {
            const parent = field.closest('.form-floating');
            if (checkbox.checked) {
                parent.style.display = "block";
            } else {
                parent.style.display = "none";
                field.value = 0; // Reset the value to 0
            }
        }

        // Initial toggle based on the default checkbox state
        toggleFieldVisibilityAndReset(depositCheckbox, depositField);
        toggleFieldVisibilityAndReset(preferenceCheckbox, preferenceField);
        toggleFieldVisibilityAndReset(salaryCheckbox, salaryField); // Handle salary field

        // Add event listeners for checkbox changes
        depositCheckbox.addEventListener("change", function () {
            toggleFieldVisibilityAndReset(depositCheckbox, depositField);
        });

        preferenceCheckbox.addEventListener("change", function () {
            toggleFieldVisibilityAndReset(preferenceCheckbox, preferenceField);
        });

        salaryCheckbox.addEventListener("change", function () {
            toggleFieldVisibilityAndReset(salaryCheckbox, salaryField); // Handle salary field
        });
    });
</script>
