@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
<style>
    .bg-open-green {
        background-color: #28a745; /* or your preferred green */
        color: #fff;
    }

    .badge {
        font-size: 0.85rem;
        border-radius: 50rem;
    }
</style>
<!-- 🗓️ Accounting Date -->
<style>
    .pe-none {
        pointer-events: none;
    }
    /* ignore mouse events */
    .with-badge-pr {
        padding-right: 7rem !important;
    }
    /* space so text isn't under badge */
</style>
<!-- ✅ Put this CSS in your page (or site stylesheet) -->
<style>
    /* =========================
     TSC-aligned (soft) palette
     ========================= */
    :root {
        --tsc-accent: #29b36a; /* your TSC green accent (keep subtle) */
        --tsc-ok: #1e88a8; /* ✅ use tick-like calm teal/blue-green */
        --tsc-bad: #c0392b; /* error */
        --tsc-muted: #6b7280;
        --tsc-border: rgba(0,0,0,.10);
        --tsc-bg: #ffffff;
        --tsc-soft: #f6f8fb;
    }

    /* =========================
     Coverage calculator card
     ========================= */
    #pcmfCoverageBox .card {
        border: 1px solid var(--tsc-border);
        border-radius: 12px;
        overflow: hidden;
        background: var(--tsc-bg);
    }

    /* ✅ Remove thick blue. Use soft light header with subtle accent line */
    #pcmfCoverageBox .card-header {
        background: var(--tsc-soft);
        color: #111827;
        padding: 10px 14px;
        border-bottom: 1px solid var(--tsc-border);
        position: relative;
    }

        #pcmfCoverageBox .card-header:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--tsc-accent); /* subtle TSC green accent */
        }

        #pcmfCoverageBox .card-header .fw-semibold {
            font-size: .95rem;
            font-weight: 700;
        }

    /* PCMF pill: keep green but softer and consistent */
    #pcmfTagInline .badge {
        background: rgba(41,179,106,.12) !important;
        color: #1f7a3a !important;
        border: 1px solid rgba(41,179,106,.25);
        border-radius: 999px;
        padding: 6px 10px;
        font-weight: 700;
    }

    #pcmfCoverageBox .card-body {
        padding: 14px 16px;
    }

    /* ✅ Status line uses tick color (not green neon) */
    #pcmfCoverageStatus.text-success {
        color: var(--tsc-ok) !important;
        font-weight: 700;
    }

    #pcmfCoverageStatus.text-danger {
        color: var(--tsc-bad) !important;
        font-weight: 700;
    }

    /* =========================
     Inputs: remove neon green
     ========================= */

    /* stop bootstrap bright green outlines */
    .is-valid {
        border-color: var(--tsc-border) !important;
        box-shadow: none !important;
    }

    /* ✅ Add our own subtle "ok" ring using tick color */
    .tsc-ok-input {
        border-color: rgba(30,136,168,.45) !important;
        box-shadow: 0 0 0 .12rem rgba(30,136,168,.12) !important;
    }

    .is-invalid {
        border-color: rgba(192,57,43,.55) !important;
        box-shadow: 0 0 0 .12rem rgba(192,57,43,.10) !important;
    }

    /* Feedback text */
    .tsc-ok-text {
        color: var(--tsc-ok) !important; /* ✅ tick color */
        font-weight: 600;
    }

    .tsc-bad-text {
        color: var(--tsc-bad) !important;
        font-weight: 600;
    }

    /* Make the "between..." label line less aggressive */
    .form-floating label,
    .form-floating-outline label {
        color: #374151;
    }
    /* PCMF calculator card - TSC friendly */
    .tsc-pcmf-box {
        border: 1px solid #e6e8ef;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    .tsc-pcmf-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .65rem .9rem;
        background: #f6f7fb; /* neutral, matches TSC vibe */
        border-bottom: 1px solid #e6e8ef;
    }

    .tsc-pcmf-title {
        font-weight: 600;
        color: #2b2f3a;
    }

    .tsc-pcmf-tag .badge {
        font-weight: 600;
        border-radius: 999px;
    }

    /* Feedback lines: NO green text; only the tick stays green */
    .tsc-limit-feedback {
        display: block;
        margin-top: .35rem;
        font-size: .85rem;
        color: #4a4f5c;
    }

        .tsc-limit-feedback .tsc-tick {
            color: #2fb344; /* tick green only */
            margin-right: .35rem;
        }

        .tsc-limit-feedback.tsc-bad {
            color: #dc3545;
        }

            .tsc-limit-feedback.tsc-bad .tsc-tick {
                color: #dc3545;
            }

    /* Keep default input borders; only highlight invalid */
    .form-control.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: none !important;
    }

    /* Do NOT force green borders on valid */
    .form-control.is-valid {
        border-color: inherit !important;
        background-image: none !important;
        box-shadow: none !important;
    }

</style>

<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @Member_Global_LoanApplication.LoanApplicationTips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanTips" aria-expanded="false" aria-controls="collapseLoanTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">@Member_Global_LoanApplication.FollowTheseTips</p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.EnsureAllLoanDetails</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.ValidateMembersEligibility</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.UseOverrideBalanceSection</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.VerifyCoobligorsAccountBalance</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @Member_Global_LoanApplication.EnsureBlockedAccounts</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.RiskMitigationMeasures</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.EnsureRequiredDocuments</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.ValidateFees</li>
            </ul>
            <p class="text-muted">@Member_Global_LoanApplication.AdditionalNotes</p>
            <ul>
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.TrustWillNotGrantLoan
                    <ul>
                        <li>@Member_Global_LoanApplication.MinimumShares</li>
                        <li>@Member_Global_LoanApplication.MinimumSavings</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.DownPaymentRequired
                    <ul>
                        <li>@Member_Global_LoanApplication.SavingsAccount</li>
                        <li>@Member_Global_LoanApplication.OrdinaryShares</li>
                        <li>@Member_Global_LoanApplication.DepositAccount</li>
                        <li>@Member_Global_LoanApplication.SalaryAccount</li>
                    </ul>
                    @Member_Global_LoanApplication.DefaultLoanRequirements
                </li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.CoobligorsMustBeProvided</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.AccountsUsedAsGuarantees</li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-0">
    <h6 class="card-header d-flex justify-content-between align-items-center text-danger">
        <span><i class="mdi mdi-alert-circle-outline me-2"></i> @Member_Global_LoanApplication.ImportantNotices</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNotices" aria-expanded="false" aria-controls="collapseNotices">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseNotices" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.OverrideBalanceSectionShouldOnlyBeUsed</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ChangesToLoanBalances</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.AnyChangeInBalanceInformation</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.VatIsCalculatedAutomatically</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ChangesMadeToBalanceInformation</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.EveryLoanProcessRequires</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.EnsureAllMandatoryFields</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ForLoansRequiringUpfrontFees</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.LoanApprovalAndProcessing</li>
            </ul>
        </div>
    </div>
</div>



@using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.HiddenFor(m => m.AddLoanApplicationCommand.CustomerId)
    <input type="hidden" value="@Model.AddLoanApplicationCommand.CustomerId" id="customerid" />
    <br />
    <div class="row">
        <div class="accordion" id="collapsibleSection">

            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @Member_Global_LoanApplication.LoanProduct
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@Member_Global_LoanApplication.LoanProductHelp"></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <br />
                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">
                                <!-- ✅ Branch Selection -->
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(
                                            m => m.AddLoanApplicationCommand.BranchId,
                                            new SelectList(ViewBag.Branches, "Id", "Name"),
                                            "---" + @GlobalLoanApplication.SelectAll + "---",
                                            new { @class = "form-control shadow-sm select2" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.BranchId, "", new { @class = "text-danger" })
                                        <label for="LoanBranchId">@GlobalLoanRepaymentBackOffice.BranchName</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanApplicationType, new SelectList(ViewBag.LoanApplicationTypes, "Value", "Text"), @Member_Global_LoanApplication.SelectLoanApplicationTypes, new { @class = "form-control select2", @search = "true", @id = "LoanApplicationType", @onchange = "LoadRefinancing(this.value,'loanapplicationtype','loanid')" })
                                        <label>@Member_Global_LoanApplication.ApplicationType</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline position-relative">
                                        @Html.TextBoxFor(
                                          m => m.AddLoanApplicationCommand.AccountingDate,
                                          Model.AddLoanApplicationCommand.AccountingDate == default(DateTime)
                                            ? DateTime.Today.ToString("yyyy-MM-dd")
                                            : "{0:yyyy-MM-dd}",
                                          new
                                              {
                                            @class = "form-control accounting-date",
                                            type = "date",
                                            data_date_default = "today",   // auto-fill today if empty/MinValue
                                            data_date_max = "today"        // prevent future dates (remove if not needed)
                                            // data_date_min = "today"     // uncomment to only allow today & after
                                          })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.AccountingDate, "", new { @class = "text-danger" })
                                        <label>@(Member_Global_LoanApplication.AccountingDate ?? "Accounting Date")</label>
                                    </div>
                                    <small class="text-muted">
                                        This date will be used as the accounting date for posting and audit.
                                        Choose a past date to backdate (if permitted).
                                    </small>
                                </div>





                                <!-- ✅ Loan Product Category -->
                                <div class="col-md-12" id="LoanCategorySelect">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanProductCategoryId,
                                            new SelectList(ViewBag.Categories, "Id", "NameEn"),
                                            @Member_Global_LoanApplication.SelectLoanProductCategory,
                                            new { @class = "form-control select2", @search = "true", @id = "LoanCategoryId", @onchange = "GetLoanPurposes(this.value,'purposeId')" })
                                        <label>@Member_Global_LoanApplication.SelectLoanProductCategory</label>
                                    </div>
                                </div>


                                <!-- ✅ Loan Term -->
                                <div class="col-md-12" id="LoanTermSelect">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanTermId,
                                            new SelectList(ViewBag.LoanTerms, "Id", "Name"),
                                            "---" + @Member_Global_LoanApplication.SelectLoanTerm + "---",
                                            new
                                            {
                                                @class = "form-control select2",
                                                @search = "true",
                                                @id = "LoanTermId",
                                                @onchange = "LoadTargetsByTermAndPurpose()" // ✅ same loader
                                            })
                                    </div>
                                </div>
                                <div class="col-12" id="LoanCategoryDive">
                                    <div class="form-check form-check-inline" id="accountType">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Main_Loan", new { id = "MainLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="MainLoan">@Member_Global_LoanApplication.MainLoan</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Special_Saving_Facility_Loan", new { id = "SpecialSavingFacilityLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="SpecialSavingFacilityLoan">@Member_Global_LoanApplication.SpecialSavingFacility</label>
                                    </div>
                                </div>
                                <div class="col-md-12" id="TargetPopulationDiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanTarget,
                                            new SelectList(ViewBag.LoanTargets, "Value", "Text"),
                                            @Member_Global_LoanApplication.SelectLoanCategory,
                                            new
                                            {
                                                @class = "form-control select2",
                                                @search = "true",
                                                @onchange = "GetProductByTarget(this.value,'loan_productid')",
                                                @id = "TargetId"
                                            })                                        <label>@Member_Global_LoanApplication.TargetedPopulation</label>
                                        </div>
                                    </div>
                                    <!-- Adjusted row -->

                                    <div id="loandiv" style="display:none;">
                                        <!-- Dynamic Header -->
                                        <h4 id="repaymentHeader" class="mb-3"></h4>

                                        <!-- ===================== -->
                                        <!-- 🟦 REFINANCING GUIDELINES -->
                                        <!-- ===================== -->
                                        <div class="card mb-4" id="refinancingGuidelines" style="display:none;">
                                            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                                <span>
                                                    <i class="mdi mdi-information-outline me-2"></i>
                                                    Loan Refinancing – Important Guidelines (TSC)
                                                </span>
                                                <button class="btn btn-light btn-sm" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseRefinancingTips"
                                                        aria-expanded="false"
                                                        aria-controls="collapseRefinancingTips">
                                                    <i class="mdi mdi-chevron-down"></i>
                                                </button>
                                            </h6>

                                            <div id="collapseRefinancingTips" class="collapse">
                                                <div class="card-body">

                                                    <p class="text-muted mb-2">
                                                        In TSC, loan refinancing is treated as a <strong>normal loan application</strong> where a new loan is created
                                                        to settle an existing loan and provide the member with an additional <strong>requested (top-up) amount</strong>.
                                                    </p>

                                                    <ul>
                                                        <li>
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Refinancing follows the <strong>standard loan workflow</strong>:
                                                            <ul class="mt-1">
                                                                <li>✔ Loan application</li>
                                                                <li>✔ Fee payment (if applicable)</li>
                                                                <li>✔ Validation and appraisal</li>
                                                                <li>✔ Approval</li>
                                                                <li>✔ Disbursement</li>
                                                            </ul>
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Select the <strong>loan to be refinanced</strong> from the dropdown list.
                                                            This loan will be settled automatically during disbursement.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Enter the <strong>new amount requested by the member</strong> (top-up).
                                                            The system computes the refinancing base by combining:
                                                            <ul class="mt-1">
                                                                <li>✔ Outstanding loan balance (capital)</li>
                                                                <li>✔ Accrued interest</li>
                                                                <li>✔ VAT</li>
                                                                <li>✔ Penalties (if any)</li>
                                                                <li>✔ Plus the new requested/top-up amount</li>
                                                            </ul>
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            At disbursement, TSC will <strong>automatically repay the old loan in full</strong>
                                                            from the refinancing proceeds (no manual repayment required).
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            The member receives only the <strong>net requested/top-up amount</strong>
                                                            (excluding old-loan settlement). This net amount is credited to the member’s
                                                            <strong>deposit account</strong>. Any applicable fees are deducted from the deposit account.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            Use <strong>"Override Balance"</strong> and <strong>"Stop further interest calculations"</strong>
                                                            only when explicitly authorized and properly documented.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            Any changes to balance, interest, VAT, penalty, or fees must be <strong>justified and approved</strong>.
                                                        </li>
                                                    </ul>

                                                    <p class="text-muted mt-3">Additional Notes:</p>

                                                    <ul>
                                                        <li>
                                                            <i class="mdi mdi-information-outline text-primary me-2"></i>
                                                            The refinanced loan is a <strong>new loan</strong> with a new reference, new schedule,
                                                            and a complete accounting lifecycle.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-information-outline text-primary me-2"></i>
                                                            The old loan is <strong>closed/settled</strong> as part of the refinancing process.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-information-outline text-primary me-2"></i>
                                                            Refinancing is used when the member needs <strong>additional funding</strong>
                                                            while keeping the process under full credit workflow control.
                                                        </li>

                                                        <li>
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            If the goal is only to change repayment dates/installments (without new money),
                                                            use <strong>loan rescheduling</strong> instead.
                                                        </li>
                                                    </ul>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- ===================== -->
                                        <!-- 🟣 RESCHEDULING GUIDELINES -->
                                        <!-- ===================== -->
                                        <div class="card mb-4" id="reschedulingGuidelines" style="display:none;">
                                            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                                <span>
                                                    <i class="mdi mdi-information-outline me-2"></i>
                                                    Loan Rescheduling – Important Guidelines (TSC)
                                                </span>
                                                <button class="btn btn-light btn-sm" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseReschedulingTips"
                                                        aria-expanded="false"
                                                        aria-controls="collapseReschedulingTips">
                                                    <i class="mdi mdi-chevron-down"></i>
                                                </button>
                                            </h6>

                                            <div id="collapseReschedulingTips" class="collapse">
                                                <div class="card-body">

                                                    <p class="text-muted mb-2">
                                                        In TSC, <strong>loan rescheduling</strong> is a controlled loan re-creation process.
                                                        The system creates a <strong>new loan</strong> primarily from the
                                                        <strong>remaining balance</strong> of an existing active loan,
                                                        while preserving the original loan product rules, tax behavior, and accounting configuration.
                                                    </p>

                                                    <!-- ✅ Key Alert -->
                                                    <div class="alert alert-warning d-flex align-items-start mb-3" role="alert">
                                                        <i class="mdi mdi-alert-outline me-2 mt-1"></i>
                                                        <div>
                                                            <div class="fw-semibold">Important advisory before rescheduling</div>
                                                            <div class="small">
                                                                It is strongly recommended to <strong>clear accrued interest, VAT, and penalties</strong>
                                                                before rescheduling. If not cleared, these amounts will be
                                                                <strong>carried forward</strong> and included in the rescheduled loan computation.
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <ul class="mb-3">
                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Select the <strong>existing active loan</strong> to be rescheduled.
                                                            This loan becomes the reference for policy and behavior inheritance.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            The new loan is created from the <strong>remaining balance (capital)</strong>
                                                            of the old loan and follows the standard workflow:
                                                            <ul class="mt-1">
                                                                <li>✔ Loan application</li>
                                                                <li>✔ Fees (only those marked <strong>Before Processing</strong>, if applicable)</li>
                                                                <li>✔ Validation and approval</li>
                                                                <li>✖ <strong>No disbursement is performed</strong> (rescheduling does not release new cash)</li>
                                                            </ul>
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            The rescheduled loan <strong>inherits the original loan’s behavior</strong>,
                                                            including interest rules, VAT treatment (taxable or non-taxable),
                                                            penalty rules, repayment logic, and accounting configuration.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Rescheduling may transition a loan from
                                                            <strong>short-term</strong> to <strong>medium-term</strong> or <strong>long-term</strong>,
                                                            by increasing the number of installments and extending the maturity period
                                                            (subject to approval).
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            If not cleared before rescheduling, the following are <strong>carried forward</strong>:
                                                            <ul class="mt-1">
                                                                <li>⚠️ <strong>Accrued interest</strong> — existing accrued interest remains, and new daily interest is added to it</li>
                                                                <li>⚠️ <strong>VAT</strong> — remains applicable if the loan is taxable</li>
                                                                <li>⚠️ <strong>Penalty</strong> — remains attached if unpaid</li>
                                                            </ul>
                                                            <div class="text-muted small mt-1">
                                                                Best practice: clear interest, VAT, and penalties before rescheduling
                                                                to keep the new repayment schedule clean and predictable.
                                                            </div>
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Only <strong>approved rescheduling parameters</strong> may be modified:
                                                            <ul class="mt-1">
                                                                <li>✔ Repayment dates</li>
                                                                <li>✔ Number of installments (must be greater than the original schedule)</li>
                                                                <li>✔ Installment amounts</li>
                                                                <li>✔ Loan duration / maturity date</li>
                                                                <li>✔ Grace period (if approved)</li>
                                                            </ul>
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            The following elements are <strong>not negotiable</strong> during rescheduling:
                                                            <ul class="mt-1">
                                                                <li>✖ Loan product core behavior</li>
                                                                <li>✖ Interest, VAT, and penalty policy inherited from the original loan</li>
                                                                <li>✖ Risk configuration and accounting rules</li>
                                                                <li>✖ Product-linked accounting mappings</li>
                                                            </ul>
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-check-circle-outline text-success me-2"></i>
                                                            Use <strong>"Override Balance"</strong> and
                                                            <strong>"Stop further interest calculations"</strong>
                                                            only when explicitly approved and fully documented.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            Any change affecting balances, accrued interest, VAT, penalties, or delinquency status
                                                            must be <strong>clearly justified and formally authorized</strong>.
                                                        </li>
                                                    </ul>

                                                    <p class="text-muted mt-3 mb-2 fw-semibold">Additional Notes</p>
                                                    <ul class="mb-0">
                                                        <li class="mb-2">
                                                            <i class="mdi mdi-information-outline text-primary me-2"></i>
                                                            The original loan is closed or frozen for audit and history,
                                                            while the rescheduled loan becomes the active repayment instrument.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-information-outline text-primary me-2"></i>
                                                            All historical repayments and accounting postings on the original loan
                                                            remain intact, traceable, and auditable.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            Rescheduling is intended for <strong>temporary repayment difficulty</strong>.
                                                            If loan exposure or product structure must change fundamentally,
                                                            consider <strong>loan restructuring</strong> or <strong>refinancing</strong>.
                                                        </li>

                                                        <li class="mb-2">
                                                            <i class="mdi mdi-alert-circle-outline text-warning me-2"></i>
                                                            When in doubt, consult the Loan Manager or Credit Committee before submission.
                                                        </li>
                                                    </ul>

                                                </div>
                                            </div>
