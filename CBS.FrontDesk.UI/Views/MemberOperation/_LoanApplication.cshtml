    (function () {
        const input = document.getElementById("AccountingDate");
        const prettyTarget = document.getElementById("AccountingDatePretty");

        // Default to today if empty
        if (input && !input.value) {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            input.value = `${yyyy}-${mm}-${dd}`;
        }

        function pretty(d) {
            const date = new Date(`${d}T00:00:00`);
            // Soft, readable format (e.g., Fri, 08 Aug 2025)
            return date.toLocaleDateString(undefined, {
                weekday: 'short', year: 'numeric', month: 'short', day: '2-digit'
            });
        }

        function updateBadge() {
            if (input && prettyTarget && input.value) {
                prettyTarget.textContent = pretty(input.value);
            }
        }

        if (input) {
            input.addEventListener("change", updateBadge);
            updateBadge();
        }
    })();
</script>




