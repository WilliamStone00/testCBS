@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources

<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> @Member_Global_LoanApplication.LoanApplicationTips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanTips" aria-expanded="false" aria-controls="collapseLoanTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseLoanTips" class="collapse">
        <div class="card-body">
            <p class="text-muted mb-2">@Member_Global_LoanApplication.FollowTheseTips</p>
            <ul>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.EnsureAllLoanDetails</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.ValidateMembersEligibility</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.UseOverrideBalanceSection</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.VerifyCoobligorsAccountBalance</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @Member_Global_LoanApplication.EnsureBlockedAccounts</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.RiskMitigationMeasures</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.EnsureRequiredDocuments</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.ValidateFees</li>
            </ul>
            <p class="text-muted">@Member_Global_LoanApplication.AdditionalNotes</p>
            <ul>
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.TrustWillNotGrantLoan
                    <ul>
                        <li>@Member_Global_LoanApplication.MinimumShares</li>
                        <li>@Member_Global_LoanApplication.MinimumSavings</li>
                    </ul>
                </li>
                <li>
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.DownPaymentRequired
                    <ul>
                        <li>@Member_Global_LoanApplication.SavingsAccount</li>
                        <li>@Member_Global_LoanApplication.OrdinaryShares</li>
                        <li>@Member_Global_LoanApplication.DepositAccount</li>
                        <li>@Member_Global_LoanApplication.SalaryAccount</li>
                    </ul>
                    @Member_Global_LoanApplication.DefaultLoanRequirements
                </li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.CoobligorsMustBeProvided</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.AccountsUsedAsGuarantees</li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-0">
    <h6 class="card-header d-flex justify-content-between align-items-center text-danger">
        <span><i class="mdi mdi-alert-circle-outline me-2"></i> @Member_Global_LoanApplication.ImportantNotices</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNotices" aria-expanded="false" aria-controls="collapseNotices">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseNotices" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.OverrideBalanceSectionShouldOnlyBeUsed</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ChangesToLoanBalances</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.AnyChangeInBalanceInformation</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.VatIsCalculatedAutomatically</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ChangesMadeToBalanceInformation</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.EveryLoanProcessRequires</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.EnsureAllMandatoryFields</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.ForLoansRequiringUpfrontFees</li>
                <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Member_Global_LoanApplication.LoanApprovalAndProcessing</li>
            </ul>
        </div>
    </div>
</div>



@using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.HiddenFor(m => m.AddLoanApplicationCommand.CustomerId)
    <input type="hidden" value="@Model.AddLoanApplicationCommand.CustomerId" id="customerid" />
    <br />
    <div class="row">
        <div class="accordion" id="collapsibleSection">

            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @Member_Global_LoanApplication.LoanProduct
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@Member_Global_LoanApplication.LoanProductHelp"></i>
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <br />
                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanApplicationType, new SelectList(ViewBag.LoanApplicationTypes, "Value", "Text"), @Member_Global_LoanApplication.SelectLoanApplicationTypes, new { @class = "form-control select2", @search = "true", @id = "LoanApplicationType", @onchange = "LoadRefinancing(this.value,'loanapplicationtype','loanid')" })
                                        <label>@Member_Global_LoanApplication.ApplicationType</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanProductCategoryId, new SelectList(ViewBag.Categories, "Id", "Name"), @Member_Global_LoanApplication.SelectLoanProductCategory, new { @class = "form-control select2", @search = "true", @id = "LoanCategoryId", @onchange = "GetLoanPurposes(this.value,'purposeId')" })
                                        <label>@Member_Global_LoanApplication.SelectLoanProductCategory</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanTermId, new SelectList(ViewBag.LoanTerms, "Id", "Name"), "---" + @Member_Global_LoanApplication.SelectLoanTerm + "---", new { @class = "form-control select2", @search = "true", @id = "LoanTermId", @onchange = "GetConfiuredTargets(this.value,'TargetId')" })
                                        <label>@Member_Global_LoanApplication.SelectLoanTerm</label>
                                    </div>
                                </div>
                                <div class="col-12" id="LoanCategoryDive">
                                    <div class="form-check form-check-inline" id="accountType">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Main_Loan", new { id = "MainLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="MainLoan">@Member_Global_LoanApplication.MainLoan</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.AddLoanApplicationCommand.LoanCategory, "Special_Saving_Facility_Loan", new { id = "SpecialSavingFacilityLoan", @class = "form-check-input" })
                                        <label class="form-check-label" for="SpecialSavingFacilityLoan">@Member_Global_LoanApplication.SpecialSavingFacility</label>
                                    </div>
                                </div>
                                <div class="col-md-12" id="TargetPopulationDiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanTarget, new SelectList(ViewBag.LoanTargets, "Value", "Text"), @Member_Global_LoanApplication.SelectLoanCategory, new { @class = "form-control select2", @search = "true", @onchange = "GetProductByTarget(this.value,'loan_productid')", @id = "TargetId" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanTarget, "", new { @class = "text-danger " })
                                        <label>@Member_Global_LoanApplication.TargetedPopulation</label>
                                    </div>
                                </div>
                                <!-- Adjusted row -->
                                <div id="loandiv" style="display:none;">
                                    <h5 id="repaymentHeader">@Member_Global_LoanApplication.SelectLoanToRefinance</h5>
                                    <div class="card mb-4">
                                        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                            <span><i class="mdi mdi-information-outline me-2"></i> @Member_Global_LoanApplication.Tips</span>
                                            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                                                <i class="mdi mdi-chevron-down"></i>
                                            </button>
                                        </h6>
                                        <div id="collapseHelpTips" class="collapse">
                                            <div class="card-body">
                                                <p class="text-muted mb-2">@Member_Global_LoanApplication.FollowTheseTips</p>
                                                <ul>
                                                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.SelectLoanToRefinanceFromDropdown</li>
                                                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.UseOverrideBalanceSection2</li>
                                                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.EnableStopFurtherInterestCalculations</li>
                                                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Member_Global_LoanApplication.FillOutRepaymentDetailsAccurately</li>
                                                    <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @Member_Global_LoanApplication.AnyChangesToLoanBalances</li>
                                                </ul>
                                                <p class="text-muted">@Member_Global_LoanApplication.AdditionalNotes</p>
                                                <ul>
                                                    <li><i class="mdi mdi-information-outline text-primary me-2"></i> @Member_Global_LoanApplication.EnsureAllRepaymentDetails</li>
                                                    <li><i class="mdi mdi-information-outline text-primary me-2"></i> @Member_Global_LoanApplication.VerifyLoanReference</li>
                                                    <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @Member_Global_LoanApplication.ConsultLoanManager</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 mb-4">
                                        <div class="form-floating form-floating-outline">
                                            @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanId, new SelectList(ViewBag.MembersLoan, "Value", "Text"), "---" + @Member_Global_LoanApplication.SelectLoan + "---", new { @class = "form-control select2", @search = "true", @id = "loanid", @onchange = "GetLoan(this.value)" })
                                            @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanId, "", new { @class = "text-danger" })
                                            <label>@Member_Global_LoanApplication.MemberCurrentLoans</label>
                                        </div>
                                    </div>

                                    <!-- Balance, Interest, VAT, Penalty inputs -->
                                    <div class="col-md-12 mb-4">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsOverRightOldLoanInterestAndBalance, new { @class = "form-check-input", @id = "IsOverRightOldLoanInterestAndBalance" })
                                            <label class="form-check-label" for="IsOverRightOldLoanInterestAndBalance">@Member_Global_LoanApplication.OverrideLoanBalanceProcessRepayment</label>
                                        </div>
                                    </div>

                                    <div class="row" id="loanoveride" style="display:none;">
                                        <div style="display:none">
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.AddLoanApplicationCommand.NewBalance, new { @class = "form-control", @id = "NewBalance" })
                                                    @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.NewBalance, "", new { @class = "text-danger" })
                                                    <label for="NewBalance">@Member_Global_LoanApplication.OverrideBalance</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.AddLoanApplicationCommand.NewInterest, new { @class = "form-control", @id = "NewInterest" })
                                                    @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.NewInterest, "", new { @class = "text-danger" })
                                                    <label for="NewInterest">@Member_Global_LoanApplication.OverrideInterest</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.AddLoanApplicationCommand.NewVAT, new { @class = "form-control", @id = "NewVAT" })
                                                    @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.NewVAT, "", new { @class = "text-danger" })
                                                    <label for="NewVAT">@Member_Global_LoanApplication.OverrideVAT</label>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-floating form-floating-outline">
                                                    @Html.TextBoxFor(m => m.AddLoanApplicationCommand.NewPenalty, new { @class = "form-control", @id = "NewPenalty" })
                                                    @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.NewPenalty, "", new { @class = "text-danger" })
                                                    <label for="NewPenalty">@Member_Global_LoanApplication.OverridePenalty</label>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-md-12 mb-4">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.StopInterestCalculation, new { @class = "form-check-input", @id = "StopInterestCalculation" })
                                                <label class="form-check-label" for="StopInterestCalculation">@Member_Global_LoanApplication.StopFurtherInterestCalculations</label>
                                            </div>
                                        </div>
                                        <!-- Repayment Details -->
                                        <h5>@Member_Global_LoanApplication.RepaymentDetails</h5>
                                        <div class="col-md-3 mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Capital, new { @class = "form-control", @id = "oldLoanCapital", @onchange = "calculateVATAndTotal()" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Capital, "", new { @class = "text-danger" })
                                                <label for="oldLoanCapital">@Member_Global_LoanApplication.Capital</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Interest, new { @class = "form-control", @id = "oldLoanInterest", @onchange = "calculateVATAndTotal()" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Interest, "", new { @class = "text-danger" })
                                                <label for="oldLoanInterest">@Member_Global_LoanApplication.Interest</label>
                                            </div>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.VatRate, new { @class = "form-control", @id = "oldLoanvatRate", @readonly = "readonly" })
                                                <label for="oldLoanvatRate">@Member_Global_LoanApplication.VatRate</label>
                                            </div>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.VAT, new { @class = "form-control", @id = "oldLoanVAT", @readonly = "readonly" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.VAT, "", new { @class = "text-danger" })
                                                <label for="oldLoanVAT">@Member_Global_LoanApplication.VAT</label>
                                            </div>
                                        </div>
                                        <div class="col-md-2 mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Amount, new { @class = "form-control", @id = "oldLoanAmount", @readonly = "readonly" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Amount, "", new { @class = "text-danger" })
                                                <label for="oldLoanAmount">@Member_Global_LoanApplication.DAmount</label>
                                            </div>
                                        </div>

                                        <div class="col-md-3 mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Penalty, new { @class = "form-control", @id = "oldLoanPenalty", @onchange = "calculateVATAndTotal()" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.Penalty, "", new { @class = "text-danger" })
                                                <label for="oldLoanPenalty">@Member_Global_LoanApplication.Penalty</label>
                                            </div>
                                        </div>
                                        <div class="col-md-9 mb-3">
                                            <div class="form-floating form-floating-outline">
                                                @Html.TextBoxFor(m => m.AddLoanApplicationCommand.OldLoanPayment.LoanId, new { @class = "form-control", @id = "oldLoanLoanId", @readonly = "readonly" })
                                                @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.OldLoanPayment.LoanId, "", new { @class = "text-danger" })
                                                <label for="oldLoanLoanId">@Member_Global_LoanApplication.LoanReference</label>
                                            </div>
                                        </div>
                                    </div>


                                </div>
                                <div class="col-md-12" id="loanProductDiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanProductId, new SelectList(ViewBag.LoanProducts, "Value", "Text"), @Member_Global_LoanApplication.SelectLoanProduct, new { @class = "form-control select2", @search = "true", @onchange = "LoanProductsProperties(this.value,'loanrepayment_cycles','RepaymentCircle')", @id = "loan_productid" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanProductId, "", new { @class = "text-danger " })
                                        <label>@Member_Global_LoanApplication.LoanProduct</label>
                                    </div>
                                </div>
                                <div class="col-md-12" id="loanTypeDiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.AddLoanApplicationCommand.LoanType, new SelectList(ViewBag.LoanTypes, "Value", "Text"), @Member_Global_LoanApplication.SelectLoanType, new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanType, "", new { @class = "text-danger " })
                                        <label>@Member_Global_LoanApplication.SelectLoanType</label>
                                    </div>
                                </div>

                                <div class="col-md-12" id="RAmountDiv">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.Amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.Amount, "", new { @class = "text-danger" })
                                        <label id="amount">@Member_Global_LoanApplication.Amount</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.LoanDuration, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.LoanDuration, "", new { @class = "text-danger" })
                                        <label id="loanduration">@Member_Global_LoanApplication.LoanDuration</label>
                                    </div>
                                </div>
                                <div class="col-12" id="beforeProcessingDiv">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsPaidFeeBeforeProcessing, new { @class = "form-check-input", @id = "FeePaidBeforeProcessing" })
                                        <label class="form-check-label" for="FeePaidBeforeProcessing">
                                            @Member_Global_LoanApplication.APartialFeeMustBePaidBeforeTheLoanCanBeProcessed
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12" id="afterProcessingDiv">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsPaidFeeAfterProcessing, new { @class = "form-check-input", @id = "FeePaidAfterProcessing", @disabled = "disabled" })
                                        <label class="form-check-label" for="FeePaidAfterProcessing">
                                            @Member_Global_LoanApplication.TheFeeCanEitherBePaidUpfront
                                        </label>
                                    </div>
                                </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <div class="card accordion-item mb-3" id="RiskMitigationDiv">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        @Member_Global_LoanApplication.RiskMitigation
                        <i class="mdi mdi-help-circle text-primary ms-2" data-bs-toggle="tooltip" title="@Member_Global_LoanApplication.RiskMitigationHelp"></i>
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <br />

                    <div class="accordion-body">
                        <fieldset class="fieldset-custom">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.RequiredDownPaymentCoverageRate,
                                            new { @class = "form-check-input", @id = "downPaymentCheckbox" })
                                        <label id="downpaymentrate" class="form-check-label" for="downPaymentCheckbox">@Member_Global_LoanApplication.DoesThisApplicationRequireDownPayment</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsThereGuarantor, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">@Member_Global_LoanApplication.HasTheMemberProvidedAGuarantorOrCoobligator</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.AddLoanApplicationCommand.IsThereCollateral, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="isActive">@Member_Global_LoanApplication.HasMemberProvidedCollateral</label>
                                    </div>
                                </div>

                                <hr />


                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextBoxFor(m => m.AddLoanApplicationCommand.ShareAccountCoverageAmount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.AddLoanApplicationCommand.ShareAccountCoverageAmount, "", new { @class = "text-danger" })
                                        <label id="share">@Member_Global_LoanApplication.OrdinaryShareAccountCoverageAmount</label>
                                    </div>
