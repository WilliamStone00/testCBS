@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
<fieldset class="fieldset-custom">
    <legend id="select_base" style="font-size: 14px;">Simulated Repayment Data</legend>
    <hr style="border: 2px solid blue;" />
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 3%">SN</th>
                    <th style="width: 7%">Date</th>
                    <th style="width: 7%">Begining Balance</th>
                    <th style="width: 8%">Capital</th>
                    <th style="width: 8%">Interest</th>
                    <th style="width: 8%">Tax</th>
                    <th style="width: 7%">Annuity</th>
                    <th style="width: 20%">End Balance</th>
                </tr>
            </thead>
            <tbody>
                <!-- First Additional Row -->
                <tr>
                    <td colspan="7"></td>
                    <td style="width: 12%">
                        @if (Model.LoanAmortizations.Any())
                        {
                            <span>
                                Loan amount: @Model.LoanAmortizations.FirstOrDefault().Amount.ToString("#,0.0")
                            </span>
                        }
                        else
                        {
                            <span>
                                Principal: 0.0
                            </span>
                        }
                    </td>
                </tr>

                @foreach (var d in Model.LoanAmortizations.OrderBy(app => app.Sno))
                {
                    <tr>
                        <td style="width: 5%">@d.Sno</td>
                        <td style="width: 15%">@d.NextPaymentDate.ToShortDateString()</td>
                        <td style="width: 15%">@d.BegginingBalance.ToString("#,0.0")</td>
                        <td style="width: 15%">@d.Principal.ToString("#,0.0")</td>
                        <td style="width: 10%">@d.Interest.ToString("#,0.0")</td>
                        <td style="width: 10%">@d.Tax.ToString("#,0.0")</td>
                        <td style="width: 10%">@d.Annuity.ToString("#,0.0")</td>
                        <td style="width: 20%">@d.Balance.ToString("#,0.0")</td>
                    </tr>
                }
            </tbody>
            <!-- Footer -->
            <tfoot>
                <tr>
                    <td colspan="8"></td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td style="width: 15%">T.Capital: @Model.LoanAmortizations.Sum(x => x.Principal).ToString("#,0.00")</td>
                    <td style="width: 15%">T.Interest: @Model.LoanAmortizations.Sum(x => x.Interest).ToString("#,0.00")</td>
                    <td style="width: 15%">T.Tax: @Model.LoanAmortizations.Sum(x => x.Tax).ToString("#,0.00")</td>
                    <td style="width: 25%">T.Annuity: @Model.LoanAmortizations.Sum(x => x.TotalDue).ToString("#,0.00")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</fieldset>

