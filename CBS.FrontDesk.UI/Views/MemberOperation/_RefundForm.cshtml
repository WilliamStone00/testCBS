@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
    @using Resources

<div class="col-md-12">
    <div class="form-floating form-floating-outline">
        @Html.DropDownListFor(m => m.Refund.PaymentMode, new SelectList(ViewBag.PaymentModes, "Value", "Text"), "---"+@Global_RefundForm.SelectRepaymentMode+"---", new { @class = "form-control select2", @search = "true" })
        @Html.ValidationMessageFor(m => m.Refund.PaymentMode, "", new { @class = "text-danger " })
        <label>@Global_RefundForm.SelectRepaymentMode</label>
    </div>
</div>
<div class="col-md-12">
    <div class="form-floating form-floating-outline">
        @Html.TextBoxFor(m => m.Refund.Paid, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Refund.Paid, "", new { @class = "text-danger" })
        <label>@Global_RefundForm.RepaymentAmount</label>
    </div>
</div>
<div class="col-md-12">
    <div class="form-floating form-floating-outline">
        @Html.TextBoxFor(m => m.Refund.DateOfPayment, new { @class = "form-control date-picker" })
        @Html.ValidationMessageFor(m => m.Refund.DateOfPayment, "", new { @class = "text-danger" })
        <label>@Global_RefundForm.DateOfPayment</label>
    </div>
</div>


