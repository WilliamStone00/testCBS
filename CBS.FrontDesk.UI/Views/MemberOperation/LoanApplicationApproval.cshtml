@{
    ViewBag.Title = "Loan Approval";
}

<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-4">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account me-2"></i> Loan Approval Management
                </h1>
                <p class="card-text text-muted">
                    Review and manage loan application requests efficiently. Approve or reject applications based on the compliance of provided information with set loan policies.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> IMPORTANT NOTICE</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>
            <div id="collapseHelpTips" class="collapse">
                <div class="card-body">
                    <ul>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Ensure all required documents are uploaded before approving a loan application.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Verify the loan details, including applicant's eligibility, loan amount, and repayment plan, against the set criteria by the Loan Management Board.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Changes to loan details, if required, must be justified with proper documentation.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Once approved, loan details cannot be modified without re-initiating the process.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Any changes in balance information will override existing balance data and cannot be undone.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> VAT is automatically calculated based on the entered interest.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> Every loan process requires a document to proceed.</li>
                        <li><i class="mdi mdi-information-outline text-primary me-2"></i> Use the tooltip help for additional information on loan application fields.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
            <div class="accordion-item active">
                <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#accordionPopoutIcon-3"
                            aria-expanded="true"
                            aria-controls="accordionPopoutIcon-3">
                        <i class="mdi mdi-account me-2"></i>
                        @Session["BranchName"] LOAN APPLICATION REQUESTS
                    </button>
                </h2>
                <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                    <div class="accordion-body">
                        <div id="mainviewChange">
                            <div class="change-group">
                                <div id="datalistingview">
                                    @Html.Partial("_LoanApplicationApprovalData")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}
