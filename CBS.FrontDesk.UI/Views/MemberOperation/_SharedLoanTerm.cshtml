@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel


<table class="table table-bordered">
    <tr>
        <td><strong>Member's Code:</strong></td>
        <td>@Model.LoanApplication.CustomerId</td>
    </tr>
    <tr>
        <td><strong>Loan Applocation Code:</strong></td>
        <td>@Model.LoanApplication.Id</td>
    </tr>
    <tr>
        <td><strong>Loan Product ID:</strong></td>
        <td>@Model.LoanApplication.LoanProductId</td>
    </tr>
    <tr>
        <td><strong>Loan Product Name:</strong></td>
        <td>@Model.LoanApplication.LoanProduct.ProductName</td>
    </tr>
    <tr>
        <td><strong>Loan type:</strong></td>
        <td>@Model.LoanApplication.LoanType</td>
    </tr>
    <tr>
        <td><strong>Amount:</strong></td>
        <td>@Model.LoanApplication.Amount.ToString("#,##0.00") FCFA</td>
    </tr>
    <tr>
        <td><strong>Interest Rate:</strong></td>
        <td>@Model.LoanApplication.InterestRate.ToString("#,##0.00")%</td>
    </tr>
    <tr>
        <td><strong>Processing Fee Rate:</strong></td>
        <td>@Model.LoanApplication.ProcessingFee.ToString("#,##0.00") % of @Model.LoanApplication.Amount.ToString("#,##0.00") FCFA</td>
    </tr>
    <tr>
        <td><strong>Repayment Circle:</strong></td>
        <td>@Model.LoanApplication.LoanProduct.LoanProductRepaymentCycles.FirstOrDefault(x => x.Id == @Model.LoanApplication.RepaymentCircle).RepaymentCycle</td>
    </tr>
    <tr>
        <td><strong>Loan Duration:</strong></td>
        <td>@Model.LoanApplication.LoanDuration  -  @Model.LoanApplication.LoanProduct.LoanDurationPeriod</td>

    </tr>
    <tr>
        <td><strong>First installment Date:</strong></td>
        <td>@Model.LoanApplication.FirstInstallmentDate.ToString("MM/dd/yyyy")</td>
    </tr>
    <tr>
        <td><strong>Application Date:</strong></td>
        <td>@Model.LoanApplication.ApplicationDate</td>
    </tr>
    <tr>
        <td><strong>Approval Status:</strong></td>
        <td>@Model.LoanApplication.ApprovalStatus</td>
    </tr>
    <tr>
        <td><strong>Has the loan been approved?:</strong></td>
        <td>@Model.LoanApplication.IsApproved</td>
    </tr>
    <tr>
        <td><strong>Interest Type:</strong></td>
        <td>@Model.LoanApplication.LoanProduct.LoanInterestType</td>
    </tr>
    <tr>
        <td><strong>Vat rate:</strong></td>
        <td>@Model.LoanApplication.VatRate %</td>
    </tr>
    <tr>
        <td><strong>Grace period before first installment:</strong></td>
        <td>@Model.LoanApplication.GracePeriodBeforeFirstPayment days before first installment.</td>
    </tr>
    <tr>
        <td><strong>Grace period after loan due date:</strong></td>
        <td>@Model.LoanApplication.GracePeriodAfterMaturityDate days after maturity date.</td>
    </tr>
</table>




