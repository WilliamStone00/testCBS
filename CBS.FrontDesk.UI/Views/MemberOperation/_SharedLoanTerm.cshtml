@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td class="font-weight-bold">Member's Code:</td>
                        <td>@Model.LoanApplication.CustomerId</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Application Code:</td>
                        <td>@Model.LoanApplication.Id</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Application Type:</td>
                        <td>
                            @if (@Model.LoanApplication.LoanType != "Normal")
                            {
                                @Model.LoanApplication.LoanApplicationType <br /><a href="/Loan/Details?KEY=@Model.LoanApplication.LoanId" target="_blank">Details >> @Model.LoanApplication.LoanId</a>
                            }
                            else
                            {
                                @Model.LoanApplication.LoanApplicationType
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Product:</td>
                        <td>@Model.LoanApplication.LoanProduct.ProductName</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Type:</td>
                        <td>@Model.LoanApplication.LoanType</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Target:</td>
                        <td>@Model.LoanApplication.LoanTarget</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Product ID:</td>
                        <td>@Model.LoanApplication.LoanProductId</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Amount:</td>
                        <td>@Model.LoanApplication.Amount.ToString("#,##0.00") FCFA</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Interest Rate:</td>
                        <td>@Model.LoanApplication.InterestRate.ToString("#,##0.00")%</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Fees:</td>
                        <td>
                            @if (Model.LoanApplication.LoanApplicationFees.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var fee in Model.LoanApplication.LoanApplicationFees)
                                    {
                                        <li>
                                            @fee.FeeLable: @(fee.FeeAmount.ToString("#,##0.00") + " FCFA")
                                        </li>
                                    }
                                </ul>
                                <div>
                                    <strong>Total Fee Amount:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.FeeAmount).ToString("#,##0.00") + " FCFA")<br />
                                    <strong>Total Amount Paid:</strong> @(Model.LoanApplication.LoanApplicationFees.Sum(f => f.AmountPaid).ToString("#,##0.00") + " FCFA")
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No Fee Added.</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Repayment Cycle:</td>
                        <td>
                            @{
                                var repaymentCycle = Model.LoanApplication.LoanProduct.LoanProductRepaymentCycles
                                    .FirstOrDefault(x => x.Id == Model.LoanApplication.RepaymentCircle)?.RepaymentCycle ?? "N/A";
                            }
                            @repaymentCycle
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Loan Duration:</td>
                        <td>@Model.LoanApplication.LoanDuration - @Model.LoanApplication.LoanProduct.LoanDurationPeriod</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">First Installment Date:</td>
                        <td>@Model.LoanApplication.FirstInstallmentDate.ToString("MM/dd/yyyy")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Application Date:</td>
                        <td>@Model.LoanApplication.ApplicationDate.ToString("MM/dd/yyyy")</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Approval Status:</td>
                        <td>@Model.LoanApplication.ApprovalStatus</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Has the loan been approved?</td>
                        <td>
                            @if (Model.LoanApplication.IsApproved)
                            {
                                <span class="badge bg-success text-white">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">VAT Rate:</td>
                        <td>@Model.LoanApplication.VatRate.ToString("#,##0.00")%</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Grace Period Before First Installment:</td>
                        <td>@Model.LoanApplication.GracePeriodBeforeFirstPayment months before first installment</td>
                    </tr>
                    <tr>
                        <td class="font-weight-bold">Grace Period After Loan Due Date:</td>
                        <td>@Model.LoanApplication.GracePeriodAfterMaturityDate days after maturity date</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
