<div class="collapse mt-3" id="loanDetailsCard">
    <div class="card card-body border border-primary shadow-sm">
        <h5 class="mb-3 text-primary fw-bold"><i class="mdi mdi-information-outline me-1"></i> Loan Details</h5>

        <table class="table table-sm table-bordered mb-0">
            <tbody>
                <tr><td class="fw-bold">Loan Product ID</td><td id="rl_productId"></td></tr>
                <tr><td class="fw-bold">Product Name</td><td id="rl_productName"></td></tr>
                <tr><td class="fw-bold">Loan Type</td><td id="rl_loanType"></td></tr>
                <tr><td class="fw-bold">Loan Term</td><td id="rl_loanTerm"></td></tr>
                <tr><td class="fw-bold">Target Population</td><td id="rl_targetPopulation"></td></tr>
                <tr><td class="fw-bold">Purpose</td><td id="rl_loanPurpose"></td></tr>
                <tr><td class="fw-bold">Repayment Period</td><td id="rl_repaymentPeriod"></td></tr>
                <tr><td class="fw-bold">Interest Rate</td><td id="rl_interestRate"></td></tr>
                <tr><td class="fw-bold">Capital</td><td id="rl_principal"></td></tr>
                <tr><td class="fw-bold">Interest</td><td id="rl_interest"></td></tr>
                <tr><td class="fw-bold">VAT</td><td id="rl_vat"></td></tr>
                <tr><td class="fw-bold">Penalty</td><td id="rl_penalty"></td></tr>
                <tr class="table-danger fw-bold"><td>Total Due</td><td id="rl_dueAmount"></td></tr>
            </tbody>
        </table>
    </div>
</div>
