@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel

@if (Model.Loans.Count == 0)
{
    <div class="text-center my-3">
        <p>There are no pending loan(s) for disbursement</p>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover" id="myDataTable_customer_loan">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Principal</th>
                    <th>Interest Rate</th>
                    <th>Fee</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>State</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Loans.OrderBy(app => app.LoanDate))
                {
                    <tr>
                        <td style="width: 30%">@d.LoanDate</td>
                        <td style="width: 10%">@d.Principal.ToString("#,0.00")</td>
                        <td style="width: 10%">@d.InterestRate %</td>
                        <td style="width: 10%">@d.Fee.ToString("#,0.00")</td>
                        <td style="width: 10%">@d.Balance.ToString("#,0.00")</td>
                        <td style="width: 10%">@d.LoanStatus</td>
                        <td style="width: 10%">
                            @if (d.IsCurrentLoan)
                            {
                                <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">Current</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">Restructured</span>
                            }
                        </td>
                        <td style="width: 10%">
                            <a href="#" onclick="GetPendingLoans('@d.Id')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select for detail">
                                Disbursed
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="1"></td>
                    <td>Principal:</td>
                    <td>@Model.Loans.Sum(x => x.Principal).ToString("#,0.00")</td>
                    <td>Paid:</td>
                    <td>@Model.Loans.Sum(x => x.Paid).ToString("#,0.00")</td>
                    <td>Balance:</td>
                    <td>@Model.Loans.Sum(x => x.Balance).ToString("#,0.00")</td>
                    <td></td> <!-- Placeholder for the last column -->
                </tr>
            </tfoot>
        </table>
    </div>

}
