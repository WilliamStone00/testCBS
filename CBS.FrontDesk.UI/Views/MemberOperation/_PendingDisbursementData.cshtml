@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel

@if (Model.Loans.Count == 0)
{
    <div class="text-center my-3">
        <p class="text-muted">There are no pending loans for disbursement.</p>
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover table-striped" id="myDataTable_customer_loan">
            <thead class="table-light">
                <tr>
                    <th>Loan date</th>
                    <th>Member Reference</th>
                    <th>Principal</th>
                    <th>Fee Paid</th>
                    <th>Status</th>
                    <th>State</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Loans.OrderBy(app => app.LoanDate))
                {
                    <tr>
                        <td>@d.LoanDate</td>
                        <td>@d.CustomerId</td>
                        <td>@d.Principal.ToString("#,##0.0")</td>
                        <td>@d.FeePaid.ToString("#,##0.0")</td>
                        <td>
                            <span class="badge bg-success">Approved</span>
                        </td>
                        <td>
                            @if (!d.IsLoanDisbursted)
                            {
                                <span class="badge bg-warning">Awaits Disbursement</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Disbursed</span>
                            }
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="actionDropdown@d.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cog"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="actionDropdown@d.Id">
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="GetPendingLoans('@d.Id')">
                                            <i class="fas fa-check-circle me-2"></i>Disburse
                                        </a>
                                    </li>
                                    @*<li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#viewDetailsModal@d.Id">
                                            <i class="fas fa-info-circle me-2"></i>Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="DeleteRecordDataTable('LoanApplications', '@d.Id', 'myDataTable', '_Data', 0, 'datalistingview')">
                                            <i class="fas fa-trash-alt me-2"></i>Delete
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="ResetStatus('@d.Id')">
                                            <i class="fas fa-undo me-2"></i>Reset Status
                                        </a>
                                    </li>*@
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="1"></td>
                    <td><strong>Totals:</strong></td>
                    <td><strong>@Model.Loans.Sum(x => x.Principal).ToString("#,##0.0")</strong></td>
                    <td><strong>@Model.Loans.Sum(x => x.Paid).ToString("#,##0.0")</strong></td>
                    <td></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
