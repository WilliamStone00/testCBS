@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
    @using Resources

<div class="col">
    <div class="row my-4">
        <!-- Tips Section -->
        <div class="card mb-4">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> @Global_LoanCommiteeValidations.ValidationTips</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseValidationTips" aria-expanded="false" aria-controls="collapseValidationTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>
            <div id="collapseValidationTips" class="collapse">
                <div class="card-body">
                    <ul>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Global_LoanCommiteeValidations.LoanDurationMustMatchTheBorrowersRepaymentAbility</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Global_LoanCommiteeValidations.RepaymentCyclesShouldAlignWithTheMembersIncomeFrequency</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Global_LoanCommiteeValidations.InterestRatesMustFollowLoanProductGuidelines</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Global_LoanCommiteeValidations.TheFirstInstallmentDateMustAdhereToTheDefinedGracePeriodPolicy</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Global_LoanCommiteeValidations.EnsureAllMandatoryFeesAreRecordedCorrectly</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Global_LoanCommiteeValidations.AllLoanProductsHaveSpecificRules</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @Global_LoanCommiteeValidations.GracePeriodsMustBeVerifiedAgainstPolicyLimits</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Global_LoanCommiteeValidations.AttachedDocumentsAreMandatoryForLoanValidation</li>
                        <li><i class="mdi mdi-alert-circle-outline text-danger me-2"></i> @Global_LoanCommiteeValidations.ChangesToApprovalStatusMustReflectTheActualProgress</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="accordion" id="collapsibleSection">
            <!-- Loan Application Validation Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button"
                            class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryAddress"
                            aria-expanded="true"
                            aria-controls="collapseDeliveryAddress">
                        @Global_LoanCommiteeValidations.LoanApplicationValidation
                    </button>
                </h2>
                <div id="collapseDeliveryAddress"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                        {
                            if (Model.LoanCommiteeValidationHistory != null)
                            {
                                @Html.HiddenFor(m => m.LoanCommiteeValidationHistory.LoanApplicationId)
                            }
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanCommiteeValidationHistory.Status, new SelectList(ViewBag.LoanCommiteeValidationStatuses, "Value", "Text"), "---Select---", new { @class = "form-control select2", @search = "true" })
                                        @Html.ValidationMessageFor(m => m.LoanCommiteeValidationHistory.Status, "", new { @class = "text-danger" })
                                        <label>@Global_LoanCommiteeValidations.Status</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.LoanCommiteeValidationHistory.Comment, new { @class = "form-control", @style = "height: 200px;" })
                                        @Html.ValidationMessageFor(m => m.LoanCommiteeValidationHistory.Comment, "", new { @class = "text-danger" })
                                        <label>@Global_LoanCommiteeValidations.Comment</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">@Global_LoanCommiteeValidations.AddValidation</button>
                                <input type="hidden" name="ServiceOption" value="loan_commitee_validation_history" id="ServiceOption" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Loan Term Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod3">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod3"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod3">
                        @Global_LoanCommiteeValidations.LoanTerm
                    </button>
                </h2>
                <div id="collapsePaymentMethod3"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod3"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @Html.Partial("_LoanTerm")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loan Schedule Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod4">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod4"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod4">
                        @Global_LoanCommiteeValidations.LoanSchedule
                    </button>
                </h2>
                <div id="collapsePaymentMethod4"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod4"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <div id="datalistingview">
                                @Html.Partial("_MakeLoanSimulation")
                            </div>
                            <div class="accordion-body">
                                <div id="amortization_schedule_data_div"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loan Collateral Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingDeliveryOptions">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseDeliveryOptions"
                            aria-expanded="false"
                            aria-controls="collapseDeliveryOptions">
                        @Global_LoanCommiteeValidations.LoanCollateral
                    </button>
                </h2>
                <div id="collapseDeliveryOptions"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDeliveryOptions"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @Html.Partial("_AddLoanCollateralData")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guarantor Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod">
                        @Global_LoanCommiteeValidations.Guarantor
                    </button>
                </h2>
                <div id="collapsePaymentMethod"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @Html.Partial("_AddLoanGuarantorData")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attached Files Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod7">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod7"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod7">
                        @Global_LoanCommiteeValidations.AttachedFiles
                    </button>
                </h2>
                <div id="collapsePaymentMethod7"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod7"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @Html.Partial("_AttachedFileData")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Committee Validations Section -->
            <div class="card accordion-item mb-3">
                <h2 class="accordion-header" id="headingPaymentMethod8">
                    <button type="button"
                            class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapsePaymentMethod8"
                            aria-expanded="false"
                            aria-controls="collapsePaymentMethod8">
                        @Global_LoanCommiteeValidations.CommitteeValidations
                    </button>
                </h2>
                <div id="collapsePaymentMethod8"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPaymentMethod8"
                     data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                        <div class="row g-4">
                            @Html.Partial("_LoanCommiteeValidationData")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>