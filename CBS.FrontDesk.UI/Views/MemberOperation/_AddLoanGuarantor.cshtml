@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
@using Resources
<div class="change-group">
    <div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <div class="ms-3">
                    <a type="button" onclick="AddORUpdateGen(@Model.LoanApplication.Id,'datalistingview_gurantor_add','_AddLoanGuarantor','application_detail','MemberOperation','applications')" class="btn btn-icon btn-label-secondary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@Global_AddLoanGuarantor.AddNewGuarantor">
                        <span class="tf-icons mdi mdi-plus mdi-18px"></span>
                    </a>
                </div>
                <div class="ms-3">
                    <a type="button" onclick="LoadGuarantors()" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@Global_AddLoanGuarantor.ViewListOfGuarantors">
                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>



<div class="col">
    <div class="accordion-body">
        @using (Html.BeginForm("Create", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostGuarantor(this);" }))
        {
            @Html.HiddenFor(m => m.LoanGuarantor.Id)
            @Html.HiddenFor(m => m.LoanGuarantor.CustomerId)
            @Html.HiddenFor(m => m.LoanApplication.Id)
            @Html.HiddenFor(m => m.LoanGuarantor.LoanApplicationId)

            <input type="hidden" name="ServiceOption" value="guarantor" id="ServiceOption" />

            <div class="row g-4">

                <div class="col-md-12">
                    <label class="form-label">@Global_AddLoanGuarantor.GuarantorType</label>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.LoanGuarantor.GuarantorType, "Shotee", new { id = "guarantorShotee", @class = "form-check-input", onchange = "toggleAccountNumberField();" })
                            <label for="guarantorShotee" class="form-check-label">@Global_AddLoanGuarantor.Shotee</label>
                            <small class="d-block text-muted">@Global_AddLoanGuarantor.ShoteeDescription</small>
                        </div>

                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.LoanGuarantor.GuarantorType, "Co_Obligor", new { id = "guarantorCoObligor", @class = "form-check-input", onchange = "toggleAccountNumberField();" })
                            <label for="guarantorCoObligor" class="form-check-label">@Global_AddLoanGuarantor.CoObligor</label>
                            <small class="d-block text-muted">@Global_AddLoanGuarantor.CoObligorDescription</small>
                        </div>

                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.LoanGuarantor.GuarantorType, "Inter_Cooperation", new { id = "guarantorInterCooperation", @class = "form-check-input", onchange = "toggleAccountNumberField();" })
                            <label for="guarantorInterCooperation" class="form-check-label">@Global_AddLoanGuarantor.InterCooperation</label>
                            <small class="d-block text-muted">@Global_AddLoanGuarantor.InterCooperationDescription</small>
                        </div>

                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.LoanGuarantor.GuarantorType, "Moral_Guarantor", new { id = "guarantorMoralGuarantor", @class = "form-check-input", onchange = "toggleAccountNumberField();" })
                            <label for="guarantorMoralGuarantor" class="form-check-label">@Global_AddLoanGuarantor.MoralGuarantor</label>
                            <small class="d-block text-muted">@Global_AddLoanGuarantor.MoralGuarantorDescription</small>
                        </div>
                    </div>
                </div>

                <!-- Account Number (conditionally shown) -->
                <div class="col-md-12" id="accountNumberField" style="display: none;">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.AccountNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.AccountNumber, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.AccountNumber</label>
                    </div>
                </div>

                <!-- Other Fields -->
                <div class="col-md-9">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.GuarantorName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.GuarantorName, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.GuarantorName</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.GuaranteeAmount, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.GuaranteeAmount, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.GuaranteeAmount</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.IdCardNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.IdCardNumber, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.IdCardNumber</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.IssueDate, new { @class = "form-control date" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.IssueDate, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.IssueDate</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.ExpireDate, new { @class = "form-control date" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.ExpireDate, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.ExpireDate</label>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.Address, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.Address</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.PhoneNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.PhoneNumber, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.PhoneNumber</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.Email, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.Email, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.Email</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.LoanGuarantor.Relationship, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoanGuarantor.Relationship, "", new { @class = "text-danger" })
                        <label>@Global_AddLoanGuarantor.Relationship</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                @if (ViewBag.Key == null)
                {
                    <button type="submit" class="btn btn-primary me-2">@Global_AddLoanGuarantor.AddGuarantor</button>
                    <button type="reset" class="btn btn-outline-secondary">@Global_AddLoanGuarantor.Reset</button>
                    <input type="hidden" name="Path" value="insert" id="Path" />
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">@Global_AddLoanGuarantor.Update</button>
                    <input type="hidden" name="Path" value="update" id="Path" />
                }
            </div>
        }
    </div>
</div>

<script>
    function toggleAccountNumberField() {
        const selectedGuarantorType = document.querySelector('input[name="LoanGuarantor.GuarantorType"]:checked').value;
        const accountNumberField = document.getElementById('accountNumberField');

        if (selectedGuarantorType === 'Shotee' || selectedGuarantorType === 'Co_Obligor' || selectedGuarantorType === 'Inter_Cooperation') {
            accountNumberField.style.display = 'block';
        } else {
            accountNumberField.style.display = 'none';
        }
    }
</script>
