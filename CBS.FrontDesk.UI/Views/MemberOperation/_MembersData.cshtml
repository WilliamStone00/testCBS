@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
<div class="table-responsive mb-3">
    <table class="table table-hover" id="myDataTable">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Member number</th>
                <th>phone</th>
                <th>Town</th>
                <th>Branch</th>
                <th>Status</th>
                <th>Membership</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Customers)
            {
                <tr>
                    <td style="width:20%">@d.name</td>
                    <td style="width:8%">@d.customerId</td>
                    <td style="width:8%">@d.phone</td>
                    <td style="width:15%">@d.town</td>
                    <td style="width:15%">@d.branch</td>
                    <td style="width:8%">


                        @if (d.activeStatus == "Active")
                        {
                           <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@d.activeStatus</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">Blocked</span>
                        }

                    </td>
                    <td style="width:10%">
                        @if (d.membershipApprovalStatus == "Approved")
                        {
                           <span class="badge rounded-pill rounded-2 badge-primary bg-label-primary fs-tiny py-1">@d.membershipApprovalStatus</span>
                        }
                        else
                        {
                           <span class="badge rounded-pill rounded-2 badge-dark bg-label-dark fs-tiny py-1">@d.membershipApprovalStatus</span>
                        }

                    </td>
                    <td style="width:10%">
                        <a href="/MemberOperation/OperationPanel?KEY=@d.customerId" target="_blank" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.name to edit">
                            <i class="mdi mdi-folder mr-1"></i> <!-- Icon of a folder -->
                            Panel
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>




