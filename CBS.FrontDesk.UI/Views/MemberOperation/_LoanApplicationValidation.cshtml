@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel


<div class="col">
    @using (Html.BeginForm("Update", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.LoanApplication.Id)
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item">
                    <h2 class="accordion-header" id="headingDeliveryAddress">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseDeliveryAddress"
                                aria-expanded="true"
                                aria-controls="collapseDeliveryAddress">
                            Loan application validation
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.DropDownListFor(m => m.LoanApplication.ApprovalStatus, new SelectList(ViewBag.LoanApplicationStatus, "Value", "Text"), "---Select loan product---", new { @class = "form-control select2", @search = "true", @onchange = "LoadDropDown(this.value,'loanrepayment_cycles','RepaymentCircle')" })
                                        @Html.ValidationMessageFor(m => m.LoanApplication.ApprovalStatus, "", new { @class = "text-danger " })
                                        <label>Select approval status</label>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating form-floating-outline">
                                        @Html.TextAreaFor(m => m.LoanApplication.ApprovalComment, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.LoanApplication.ApprovalComment, "", new { @class = "text-danger" })
                                        <label>Comment</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary me-2">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


    }
</div>



