
@using Resources
@model CBS.FrontDesk.Data.Entity.SavingProducts.AccountActivation.CashDesk
@{
    ViewBag.Title = GlobalMembers.LoanApplicationRequest;
}
<div class="row">
    <div class="col">
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header" id="headingDeliveryAddress">

                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-note-search-outline me-2"></i>
                            @GlobalMembers.SearchMemberToInit
                        </button>
                    </h2>
                    <hr />
                    <div id="collapseDeliveryAddress"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @Html.Partial("_SearchBox")
                        </div>
                    </div>
                </div>
            </div>
            @*}*@
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/OperationPanel/Customers.js"></script>

}