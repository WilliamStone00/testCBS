@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
<hr />
<div class="change-group">
    <div class="card mb-4">
        <div class="card-body d-sm-flex d-block">
            <div class="d-flex align-items-center lh-1 me-3 mb-3 mb-sm-0">
                <div class="ms-3">
                    <a type="button" onclick="LoadCollaterals()" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="Reload collaterals">
                        <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
@if (!Model.LoanCollateras.Any())
{
    <div class="text-center my-3">
        <p>No loan collateral is added</p>
    </div>
}
else
{
    if (ViewBag.Value == "0")
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable_collateral">
                <thead class="table-light">
                    <tr>
                        <th>Tag</th>
                        <th>Value</th>
                        <th>Location</th>
                        <th>Address</th>
                        <th>References</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.LoanCollateras)
                    {
                        <tr>
                            <td style="width:35%">@d.LoanProductCollateral.LoanProductCollateralTag</td>
                            <td style="width:10%">@d.Amount.ToString("#,0.0")</td>
                            <td style="width:15%">@d.Location</td>
                            <td style="width:20%">@d.Address</td>
                            <td style="width:10%">@d.Reference</td>
                            <td style="width:10%">
                                <a href="#" onclick="AddORUpdateGen('@d.Id','datalistingview_collateral_add','_AddLoanCollateral','get_collateral','MemberOperation','applications')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.LoanProductCollateral.LoanProductCollateralTag to edit">
                                    Edit
                                </a>

                                @*<a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.LoanProductCollateral.LoanProductCollateralTag" onclick="showConfirmMessage('@d.Id','myDataTable_gurantor')">Delete</a>*@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable_collateral">
                <thead class="table-light">
                    <tr>
                        <th>Tag</th>
                        <th>Value</th>
                        <th>Location</th>
                        <th>Address</th>
                        <th>References</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.LoanCollateras)
                    {
                        <tr>
                            <td style="width:35%">@d.LoanProductCollateral.LoanProductCollateralTag</td>
                            <td style="width:10%">@d.Amount.ToString("#,0.0")</td>
                            <td style="width:15%">@d.Location</td>
                            <td style="width:20%">@d.Address</td>
                            <td style="width:10%">@d.Reference</td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
}
