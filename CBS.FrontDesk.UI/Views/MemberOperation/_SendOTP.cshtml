@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel


<div class="col">
    @using (Html.BeginForm("GenerateOTP", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        @Html.HiddenFor(m => m.AddOTPNotificationCommand.LoanApplicationId)
        @Html.HiddenFor(m => m.AddOTPNotificationCommand.CustomerId)
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">Send OTP code to @Model.Customer.name</button>
        </div>
    }
</div>



