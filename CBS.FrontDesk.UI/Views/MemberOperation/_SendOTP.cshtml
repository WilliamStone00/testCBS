@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel

<fieldset class="fieldset-custom">

    <div class="col-12 col-md-8 mx-auto">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title text-center">Send OTP Code</h5>
                <p class="text-muted text-center">Send a one-time password to verify the loan application.</p>

                @using (Html.BeginForm("GenerateOTP", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    @Html.HiddenFor(m => m.AddOTPNotificationCommand.LoanApplicationId)
                    @Html.HiddenFor(m => m.AddOTPNotificationCommand.CustomerId)

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-paper-plane me-2"></i> Send OTP to @Model.Customer.name
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

</fieldset>


