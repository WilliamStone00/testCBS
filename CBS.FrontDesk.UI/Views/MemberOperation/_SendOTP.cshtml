@model CBS.FrontDesk.Data.Entity.MemberOperation.MemberOperationPanel
    @using Resources

<fieldset class="fieldset-custom">

    <div class="col-12 col-md-8 mx-auto">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title text-center"> @Global_SendOTP.SendOTPCode</h5>
                <p class="text-muted text-center">@Global_SendOTP.SendOTPCodeDescription</p>

                @using (Html.BeginForm("GenerateOTP", "MemberOperation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
                {
                    @Html.HiddenFor(m => m.AddOTPNotificationCommand.LoanApplicationId)
                    @Html.HiddenFor(m => m.AddOTPNotificationCommand.CustomerId)

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-paper-plane me-2"></i> @Global_SendOTP.SendOTPTo @Model.Customer.name
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

</fieldset>


