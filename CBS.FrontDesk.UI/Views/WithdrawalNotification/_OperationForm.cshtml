@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm
@using (Html.BeginForm("Create", "WithdrawalNotification", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateWithdrawalFromRequest(this);" }))
{

    @Html.HiddenFor(model => model.WithdrawalNotification.Id)
    @Html.HiddenFor(model => model.WithdrawalNotification.CustomerId)
    <input type="hidden" value="@Model.Customer.CustomerId" id="customerid" />
    <div class="form-wrapper">
        <fieldset class="fieldset-custom">
            <legend>Saving Withdrawal Request</legend>
            <hr />
            <div class="change-group">
                <div class="row mt-2 gy-4">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box float-start">Member's name: @Model.Customer.name</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            <span class="formatted-amount shadow-box text-green" id="lblDepositRequest_amount">
                                Account balance: @Model.WithdrawalNotification.AccountBalance.ToString("#,##0.0")
                            </span>
                        </div>

                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.WithdrawalNotification.AccountNumber, new { @class = "form-control", @readonly = true })
                            @Html.ValidationMessageFor(m => m.WithdrawalNotification.AccountNumber, "", new { @class = "text-danger" })
                            <label>Account number</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.WithdrawalNotification.AmountRequired, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.WithdrawalNotification.AmountRequired, "", new { @class = "text-danger" })
                            <label>Requested amount</label>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.WithdrawalNotification.FormNotificationCharge, new { @class = "form-control", @readonly = true })
                            @Html.ValidationMessageFor(m => m.WithdrawalNotification.FormNotificationCharge, "", new { @class = "text-danger" })
                            <label>Form charges</label>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.WithdrawalNotification.LoanBalance, new { @class = "form-control", @readonly = true })
                            @Html.ValidationMessageFor(m => m.WithdrawalNotification.LoanBalance, "", new { @class = "text-danger" })
                            <label>Loan balance</label>
                        </div>
                    </div>
                    <fieldset class="form-group">
                        <legend>Intended date for withdrawal</legend>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalYear,
                                                          Enumerable.Range(DateTime.Now.Year - 0, 1).Reverse().Select(y => new SelectListItem { Value = y.ToString(), Text = y.ToString() }),
                                                          "Intended Year",
                                                          new { @class = "form-control select2", @search = "true", @id = "DateOfIntendedWithdrawalYear" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalYear, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalMonth,
                                                          System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((month, index) => new SelectListItem { Value = (index + 1).ToString(), Text = month }),
                                                          "Intended Month",
                                                          new { @class = "form-control select2", @search = "true", @id = "DateOfIntendedWithdrawalMonth" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalMonth, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalDay,
                                                          Enumerable.Range(1, 31).Select(d => new SelectListItem { Value = d.ToString(), Text = d.ToString() }),
                                                          "Intended Day",
                                                          new { @class = "form-control select2", @search = "true", @id = "DateOfIntendedWithdrawalDay" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.DateOfIntendedWithdrawalDay, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.GracePeriodDateYear,
                                                          Enumerable.Range(DateTime.Now.Year - 0, 1).Reverse().Select(y => new SelectListItem { Value = y.ToString(), Text = y.ToString() }),
                                                          "Year of grace period",
                                                          new { @class = "form-control select2", @search = "true", @id = "GracePeriodYear" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.GracePeriodDateYear, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.GracePeriodDateMonth,
                                                          System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((month, index) => new SelectListItem { Value = (index + 1).ToString(), Text = month }),
                                                          "Month of grace period",
                                                          new { @class = "form-control select2", @search = "true", @id = "GracePeriodMonth" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.GracePeriodDateMonth, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating form-floating-outline">
                                    @Html.DropDownListFor(m => m.WithdrawalNotification.GracePeriodDateDay,
                                                          Enumerable.Range(1, 31).Select(d => new SelectListItem { Value = d.ToString(), Text = d.ToString() }),
                                                          "Day of grace period",
                                                          new { @class = "form-control select2", @search = "true", @id = "GracePeriodDay" })
                                    @Html.ValidationMessageFor(m => m.WithdrawalNotification.GracePeriodDateDay, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="form-group">
                        <legend>Select reason for withdrawal</legend>
                        <div class="row">
                            <div class="col-4">
                                <div class="form-check">
                                    @Html.RadioButtonFor(m => m.WithdrawalNotification.ReasonForWithdrawal, "LoanRepayment", new { @class = "form-check-input", id = "loanRepayment", @onclick = "toggleLoanRepaymentDiv()" })
                                    <label class="form-check-label" for="loanRepayment">Loan repayment</label>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-check">
                                    @Html.RadioButtonFor(m => m.WithdrawalNotification.ReasonForWithdrawal, "Consumption", new { @class = "form-check-input", id = "consumption", @checked = "checked", @onclick = "toggleLoanRepaymentDiv()" })
                                    <label class="form-check-label" for="consumption">Consumption</label>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-check">
                                    @Html.RadioButtonFor(m => m.WithdrawalNotification.ReasonForWithdrawal, "Others", new { @class = "form-check-input", id = "others", @onclick = "toggleLoanRepaymentDiv()" })
                                    <label class="form-check-label" for="others">Others</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextAreaFor(m => m.WithdrawalNotification.Purpose, new { @class = "form-control", @style = "height: 75px;" })
                            @Html.ValidationMessageFor(m => m.WithdrawalNotification.Purpose, "", new { @class = "text-danger" })
                            <label>Purpose of withdrawing from saving</label>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    @if (ViewBag.Key != null)
                    {
                        <button type="submit" class="btn btn-primary me-2">Update</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary me-2">Save</button>
                    }
                </div>
            </div>
        </fieldset>
    </div>
}



