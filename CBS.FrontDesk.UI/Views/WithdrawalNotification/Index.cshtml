@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm
@{
    ViewBag.Title = "Withdrawal Notification";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<div class="row">
    <div class="col">
        <div class="row my-4">
            <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item mb-3">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="fas fa-bell me-2"></i>


                            SAVING WITHDRAWAL NOTIFICATION
                        </button>
                    </h2>
                    <div id="collapseDeliveryAddress"
                         data-bs-parent="#collapsibleSection">
                        <div class="accordion-body">
                            @Html.Partial("_SearchBox")
                            <div id="datalistingview">


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/Scripts/Js/Crud/WithdrawalNotification/WithdrawalNotification.js"></script>

}