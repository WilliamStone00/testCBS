@model CBS.FrontDesk.Data.Entity.SavingProducts.WithdrawalNotificationForm
@using Resources

    @if (Model.WithdrawalNotifications.Any())
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalWithdrawalNotification.Reference</th>
                        <th>@GlobalWithdrawalNotification.Amount</th>
                        <th>I Date</th>
                        <th>G Date</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalWithdrawalNotification.Reason</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.WithdrawalNotifications)
                    {
                        <tr>

                            <td style="width:20%">@d.TransactionReference</td>
                            <td style="width:10%">@d.AmountRequired.ToString("#,##0.0")</td>
                            <td style="width:20%">@d.DateOfIntendedWithdrawal.ToShortDateString()</td>
                            <td style="width:20%">@d.GracePeriodDate.ToShortDateString()</td>
                            <td style="width:10%">@d.ApprovalStatus</td>
                            <td style="width:10%">@d.ReasonForWithdrawal</td>
                            <td style="width:10%">
                                <a href="#" onclick="ValidateRequest('@d.Id')" data-toggle="modal" class="btn btn-icon btn-label-primary btn-sm btn-fab demo btn-space customer-details" data-bs-toggle="tooltip" title="@GlobalShared.Validate">
                                    <i class="fas fa-check-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center my-3">
            <p> @GlobalWithdrawalNotification.NoDataWasFoundAtTheMoment..</p>
        </div>
    }




