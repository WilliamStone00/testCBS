@model CBS.FrontDesk.Data.Entity.AccountingV2.SharedMonth.SharedMonthSimulation
@using Resources

@{
    ViewBag.Title = " Shared Month calculation";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Shared Month calculation
        </h1>
    </div>
</div>


<!-- Add Year Button -->
<div class="card mb-3">
        <div class="card-body d-flex justify-content-end align-items-center gap-2">
            <button type="button" id="btnshareMonth" class="btn btn-success btn-sm px-2">
                <i class="mdi mdi-plus-circle-outline me-1"></i> Prepare Data
            </button>


            <a href="/SharedMonthSimulation/List" target="_blank" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="ViewList">
                <i class="mdi mdi-view-list mdi-18px"></i> File Upload
            </a>
        </div>

    </div>




<!-- Advance Filters -->
<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="SharedMonthFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <div class="card p-3 mb-2 bg-light">




            <!-- DATE RANGE -->
            <div class="row mb-1">

                <div class="col-md-12  mb-1">
                    <label class="form-label fw-bold">Branch</label>
                    @Html.DropDownList(
                        "BranchId",
                        new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                        "--- Select Branch ---",
                        new { @class = "form-select select2" })
                    <div class="invalid-feedback">Please select a branch</div>
                </div>




                <div class="col-md-6  mb-1">
                    <label class="form-label fw-bold">Month</label>
                    @Html.DropDownList(
                        "Month",
                        new SelectList(ViewBag.Month, "Value", "Text"),
                        "--- Select Period ---",
                        new { @class = "form-select select2" })
                    <div class="invalid-feedback">Please select a Month</div>
                </div>


                <div class="col-md-6  mb-1">
                    <label class="form-label fw-bold">Interest Distribution Type</label>
                    @Html.DropDownList(
                    "IntrestType",
                    new SelectList(ViewBag.IntrestDistributionType, "Value", "Text"),
                    "--- Select Distribution Type ---",
                    new { @class = "form-select select2" })
                    <div class="invalid-feedback">Please select distribution type</div>
                </div>


            </div>




            <!-- ACTION BUTTONS -->
            <div class="row g-2 mt-2">
                <div class="col-12 col-md-6">
                    <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="mdi mdi-magnify me-1"></i> Apply Filters
                    </button>
                </div>
                <div class="col-12 col-md-6">
                    <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                        <i class="mdi mdi-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>

        </div>



    </form>
</div>


<div id="datalistingview">
    @Html.Partial("_Datatable")
</div>





<div class="modal fade" id="sharedMonthModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-light">
                <h5 class="modal-title text-primary">
                    <i class="mdi mdi-calendar-month me-2"></i> Shared Month Simulation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">

                <!-- 🔽 PASTE YOUR EXISTING VIEW CONTENT HERE 🔽 -->



                <div class="row">
                    <div class="col-xl-12 col-lg-12 col-md-12">

                        <!-- EVERYTHING YOU ALREADY WROTE STAYS EXACTLY THE SAME -->
                        <!-- Header Card -->
                        <!-- Form -->
                        <!-- Accordion -->
                        <!-- Tables -->
                        <!-- Scripts still work -->


                        @using (Html.BeginForm("LoadSimulationData", "SharedMonthSimulation", FormMethod.Post, new { id = "sharedMonthForm", onsubmit = "return AjaxPostSharedMonth(this);" }))

                        {
                            @Html.AntiForgeryToken()

                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="mdi mdi-cog-outline me-2"></i> Distribution Parameters
                                    </h5>
                                </div>

                                <div class="card-body">
                                    <div class="row g-3">

                                        <!-- Branch -->
                                        <div class="col-md-12  mb-1">
                                            <label class="form-label fw-bold">Branch</label>
                                            @Html.DropDownList(
                                                "BranchId1",
                                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                                "--- Select Branch ---",
                                                new { @class = "form-select select2", required = "required" })
                                            <div class="invalid-feedback">Please select a branch</div>
                                        </div>



                                        <div class="col-md-6  mb-1">
                                            <label class="form-label fw-bold">Accounting year</label>
                                            @Html.DropDownList(
                                                "Year",
                                                Enumerable.Empty<SelectListItem>(),
                                                "--- Select Year ---",
                                                new { @class = "form-select select2", required = "required" })

                                            <div class="invalid-feedback">Please select a year</div>
                                        </div>

                                        <div class="col-md-6 mb-1">
                                            @Html.LabelFor(m => m.InterestRate, "Interest Rate",
                                                new { @class = "form-label fw-bold" })
                                            @Html.TextBoxFor(m => m.InterestRate,
                                                new { @class = "form-control", type = "number" })
                                        </div>
                                        <!-- Period -->


                                        <div class="col-md-6  mb-1">
                                            <label class="form-label fw-bold">Month</label>
                                            @Html.DropDownList(
                                                "Month1",
                                                new SelectList(ViewBag.Month, "Value", "Text"),
                                                "--- Select Period ---",
                                                new { @class = "form-select select2", required = "required" })
                                            <div class="invalid-feedback">Please select a Month</div>
                                        </div>

                                        <!-- Interest Distribution Type -->
                                        <div class="col-md-6  mb-1">
                                            <label class="form-label fw-bold">Interest Distribution Type</label>
                                            @Html.DropDownList(
                                            "IntrestType1",
                                            new SelectList(ViewBag.IntrestDistributionType, "Value", "Text"),
                                            "--- Select Distribution Type ---",
                                            new { @class = "form-select select2", required = "required", id = "IntrestType1" })
                                            <div class="invalid-feedback">Please select distribution type</div>
                                        </div>


                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="row">
                                    <div class="col-md-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-cog-play-outline"></i>
                                            <span class="btn-text">Simulate</span>
                                        </button>


                                    </div>
                                </div>



                            </div>


                        }


                        <!-- Account List Section -->
                        <div class="accordion mb-2 d-none" id="accountListAccordionShared">

                            @Html.Partial("_SimulationData")

                        </div>

                    </div>
                </div>



            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>








@section Scripts {


    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // ==============================
        // 🔹 Load Shared Month Data
        // ==============================
        function loadSharedMonthData() {
            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: false,
                order: [[0, 'asc']],
                ajax: {
                    url: '/SharedMonthSimulation/LoadSharedMonthData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        const filters = collectSharedMonthFilters();
                        filters.Options = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };
                        return JSON.stringify(filters);
                    },
                    error: function (xhr, status, err) {
                        console.error('❌ Error loading shared month data:', status, err);
                        appalert('❌ Failed to load shared month data. Status: ' + xhr.status, 4, 1);
                    }
                },
                columns: [
                    { data: 'BranchName', name: 'BranchName' },
                    { data: 'Month', name: 'Month' },
                    { data: 'InterestType', name: 'InterestType' },
                    {
                        data: 'Status',
                        name: 'Status',
                        render: function (data) {
                            return data
                                ? '<span class="badge bg-success">Processed</span>'
                                : '<span class="badge bg-warning">Pending</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
                                    <div class="text-center">
                                        <button class="btn btn-sm btn-info" data-id="${row.Id}">
                                            <i class="mdi mdi-eye-outline me-1"></i> View
                                        </button>
                                    </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    appalert('✅ Shared month table loaded successfully!', 1, 1);
                },
                drawCallback: function () {
                    const api = this.api();
                    if (api.rows({ page: 'current' }).data().length === 0) {
                        appalert('⚠️ No shared month records found.', 2, 1);
                    }
                }
            });
        }

        function collectSharedMonthFilters() {
            return {
                BranchId: $('#BranchId').val(),
                Month: $('#Month').val(),
                IntrestType: $('#IntrestType').val(),
                Options: {}
            };
        }

        // Apply filters
        $('#SharedMonthFilterForm').on('submit', function (e) {
            e.preventDefault();
            loadSharedMonthData();
        });

        // Reset filters
        $('#resetFilterBtn').on('click', function () {
            resetSharedMonthFilters();
        });

        function resetSharedMonthFilters() {
            $('#SharedMonthFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');
            appalert('🧹 Filters reset successfully', 1, 1);
        }

        // Show Modal
        $(document).on('click', '#btnshareMonth', function () {
            const modal = new bootstrap.Modal(document.getElementById('sharedMonthModal'));
            modal.show();
        });

        // Load Year when Branch changes
        $(document).on('change', '#BranchId1', function () {

            const branchId = $(this).val();
            const $yearDropdown = $('#Year');

            $yearDropdown.empty()
                .append('<option value="">--- Select Year ---</option>')
                .prop('disabled', true);

            if (!branchId) return;

            $.ajax({
                url: '/SharedMonthSimulation/GetAccountingYearsByBranch',
                type: 'GET',
                data: { branchId: branchId },

                success: function (data) {
                    if (!data || data.length === 0) {
                        appalert('⚠ No open accounting years found for this branch', 2, 1);
                        return;
                    }

                    $.each(data, function (i, item) {
                        $yearDropdown.append(
                            $('<option>', {
                                /*value: item.Id,*/
                                value: item.year,
                                text: item.DisplayName
                            })
                        );
                    });

                    $yearDropdown.prop('disabled', false).trigger('change');
                },

                error: function (xhr) {
                    appalert(xhr.responseJSON?.message || 'Failed to load accounting years', 3, 1);
                }
            });
        });


        // ==============================
        // 🔹 Ajax Post with Alertify Confirm
        // ==============================
        function AjaxPostSharedMonth(form) {

            var $form = $(form);

            // Get values
            var branchVal = $('#BranchId1').val();
            var branchText = $('#BranchId1 option:selected').text();

            var yearVal = $('#Year').val();
            var yearText = $('#Year option:selected').text();

            var monthVal = $('#Month1').val();
            var monthText = $('#Month1 option:selected').text();


            var interestRate = $('#InterestRate').val();

            // **Interest Distribution Type**
            var interestTypeVal = $('#IntrestType1').val();
            var interestTypeText = $('#IntrestType1 option:selected').text();

            // Confirm message
            const message = `
                    <p>Please review the details before confirming:</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Branch</th><td>${branchText}</td></tr>
                            <tr><th>Accounting Year</th><td>${yearText}</td></tr>
                            <tr><th>Month</th><td>${monthText}</td></tr>
                            <tr><th>Interest Rate</th><td>${interestRate}</td></tr>
                            <tr><th>Distribution Type</th><td>${interestTypeText}</td></tr>
                        </tbody>
                    </table>
                    <div class="form-check mt-3">
                        <input type="checkbox" class="form-check-input" id="alertifyConfirmCheckbox">
                        <label class="form-check-label" for="alertifyConfirmCheckbox">
                            I confirm that the above details are correct.
                        </label>
                    </div>
                `;

            alertify.confirm("Confirm Simulation", message,
                function () {

                    if (!$('#alertifyConfirmCheckbox').is(':checked')) {
                        appalert("❗ Please confirm by checking the box before proceeding.", 3, 1);
                        return;
                    }

                    // Hide details card before running
                    $('#simulationdetailsCard').hide();

                    var $btn = $form.find("button[type='submit']");
                    var $icon = $btn.find("i");
                    var $text = $btn.find(".btn-text");

                    // Loading state
                    $btn.prop('disabled', true);
                    $icon.removeClass('mdi-cog-play-outline').addClass('mdi-loading mdi-spin');
                    $text.text('Processing...');

                    const token = $form.find('input[name="__RequestVerificationToken"]').val();

                    var formData = new FormData($form[0]);
                    formData.append("IntrestType", interestTypeVal);
                    formData.append("Month", monthVal);
                    formData.append("BranchId", branchVal);
                    formData.append("Year", yearVal);

                    $.ajax({
                        url: $form.attr("action"),
                        type: "POST",
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: token ? { 'RequestVerificationToken': token } : {},

                        success: function (response) {

                            if (response && response.success) {
                                appalert(response.message || "✅ Simulation successful.", 1, 1);
                                $('#simulationdetailsCard').slideDown();

                                $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-check-circle');
                                $text.text('Done');

                                alertify.dismissAll();
                            } else {
                                appalert((response && response.message) || "❌ Operation failed.", 3, 1);
                                $('#simulationdetailsCard').hide();

                                $btn.prop('disabled', false);
                                $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-cog-play-outline');
                                $text.text('Simulate');
                            }
                        },

                        error: function (xhr, status, error) {
                            appalert("❌ An error occurred: " + error, 3, 1);
                            $('#simulationdetailsCard').hide();

                            $btn.prop('disabled', false);
                            $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-cog-play-outline');
                            $text.text('Simulate');
                        }
                    });

                },
                function () {
                    appalert("🚫 Operation cancelled.", 2, 1);
                }
            ).set({
                labels: { ok: 'Yes, Continue', cancel: 'Cancel' },
                onshow: function () {
                    const okBtn = $('.alertify .ajs-ok');
                    okBtn.prop('disabled', true);
                    $('#alertifyConfirmCheckbox').on('change', function () {
                        okBtn.prop('disabled', !this.checked);
                    });
                }
            });

            return false;
        }
    </script>
}