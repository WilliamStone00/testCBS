                aria-expanded="true"
                aria-controls="collapseAccountListShared">
            <i class="mdi mdi-account-details me-2"></i> Share Month Simulation
        </button>
    </h2>

    <div id="collapseAccountListShared"
         class="accordion-collapse collapse show"
         aria-labelledby="headingAccountListShared">

        <div class="accordion-body">

            <div class="table-responsive">
                <table class="table table-hover mb-0" id="myDataTable">
                    <thead class="table-light">
