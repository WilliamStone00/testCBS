
@model CBS.FrontDesk.Data.Entity.AccountingV2.SharedMonth.SharedMonthSimulation

@using Resources
@{
    ViewBag.Title = "Shared Month Simulation";
}


<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">

        <!-- Header Section -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-calendar-month me-2"></i> SHARED MONTH
                </h1>
                <p class="card-text">
                    <strong>Interest Distribution Module</strong> – Configure shared month interest distribution
                    by branch, period, year, and journal type.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />

                <div class="alert alert-info mt-3">
                    <i class="mdi mdi-alert-circle-outline me-2"></i>
                    <strong>Important:</strong> Ensure the selected period and year are already closed before running
                    distribution.
                </div>
            </div>
        </div>


        <div class="card mb-1">
            <div class="card-body d-flex justify-content-end align-items-center">

                <a href="/SharedMonthSimulation/List" target="_blank" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="ViewList">
                    <i class="mdi mdi-view-list mdi-18px"></i> File Upload
                </a>

            </div>
        </div>

        <div id="datalistingview">
            @Html.Partial("_intrestgeneration")
        </div>

        @using (Html.BeginForm("LoadSimulationData", "SharedMonthSimulation", FormMethod.Post, new { id = "sharedMonthForm", onsubmit = "return AjaxPostSharedMonth(this);" }))

        {
            @Html.AntiForgeryToken()

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="mdi mdi-cog-outline me-2"></i> Distribution Parameters
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <!-- Branch -->
                        <div class="col-md-12  mb-1">
                            <label class="form-label fw-bold">Branch</label>
                            @Html.DropDownList(
                                "BranchId",
                                new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                                "--- Select Branch ---",
                                new { @class = "form-select select2", required = "required" })
                            <div class="invalid-feedback">Please select a branch</div>
                        </div>



                        <div class="col-md-6  mb-1">
                            <label class="form-label fw-bold">Year</label>
                            @Html.DropDownList(
                                "Year",
                                new SelectList(ViewBag.Year, "Value", "Text"),
                                "--- Select Year ---",
                                new { @class = "form-select select2", required = "required" })
                            <div class="invalid-feedback">Please select a year</div>
                        </div>

                        <div class="col-md-6 mb-1">
                            @Html.LabelFor(m => m.InterestRate, "Interest Rate",
                                new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.InterestRate,
                                new { @class = "form-control", type = "number" })
                        </div>
                        <!-- Period -->


                        <div class="col-md-6  mb-1">
                            <label class="form-label fw-bold">Month</label>
                            @Html.DropDownList(
                                "Month",
                                new SelectList(ViewBag.Month, "Value", "Text"),
                                "--- Select Period ---",
                                new { @class = "form-select select2", required = "required" })
                            <div class="invalid-feedback">Please select a Month</div>
                        </div>

                        <!-- Interest Distribution Type -->
                        <div class="col-md-6  mb-1">
                            <label class="form-label fw-bold">Interest Distribution Type</label>
                            @Html.DropDownList(
                            "InterestDistributionType",
                            new SelectList(ViewBag.IntrestDistributionType, "Value", "Text"),
                            "--- Select Distribution Type ---",
                            new { @class = "form-select select2", required = "required" })
                            <div class="invalid-feedback">Please select distribution type</div>
                        </div>






                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row">
                    <div class="col-md-12 text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-cog-play-outline me-2"></i> Simulate
                        </button>

                    </div>
                </div>
            </div>


        }


        <!-- Account List Section -->
        <div class="accordion mb-2 d-none" id="accountListAccordionShared">

            @Html.Partial("_SimulationData")

        </div>

    </div>
</div>





<!-- Save Simulation Modal -->
<div class="modal fade" id="saveSimulationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Save Share Month Simulation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" id="SimulationName" class="form-control"
                           placeholder="Enter simulation name" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea id="SimulationDescription" class="form-control"
                              rows="3"
                              placeholder="Enter description"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" id="btnConfirmSaveSimulation"
                        class="btn btn-success btn-sm">
                    <i class="mdi mdi-content-save-outline me-1"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>





@section Scripts {


    @Scripts.Render("~/bundles/jqueryval")

    <script>





        // ===============================
        // Request History Table
        // ===============================
        var requestHistoryTable = null;

        function initializeRequestHistoryTable(tableData) {

            // Destroy existing table if exists
            if ($.fn.DataTable.isDataTable('#requestHistoryTable')) {
                requestHistoryTable.destroy();
                $('#requestHistoryTable tbody').empty();
            }

            requestHistoryTable = $('#requestHistoryTable').DataTable({
                data: tableData,
                serverSide: false,
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'asc']],

                columns: [
                    {
                        data: 'startDate', // camelCase
                        render: data => data ? new Date(data).toLocaleDateString() : ''
                    },
                    {
                        data: 'endDate',
                        render: data => data ? new Date(data).toLocaleDateString() : ''
                    },
                    {
                        data: 'branchName'
                    },
                    {
                        data: 'createdAt',
                        render: data => data ? new Date(data).toLocaleString() : ''
                    },
                   
                   
                    {
                        data: 'lastError'
                    },
                    {
                        data: 'status'
                    }
                ],

                language: {
                    emptyTable: "No request history available",
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    paginate: {
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        }


        var sharedMonthTable = null;

        // ===============================
        // Initialize / Reinitialize Table
        // ===============================
        function initializeSharedMonthTable(tableData) {

            // Destroy existing table if exists
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                sharedMonthTable.destroy();
                $('#myDataTable tbody').empty();
            }

            sharedMonthTable = $('#myDataTable').DataTable({
                data: tableData,
                serverSide: false,
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'asc']],

                columns: [
                    {
                        data: 'MemberReference',
                        name: 'MemberReference'
                    },
                    {
                        data: 'MemberName',
                        name: 'MemberName'
                    },
                    {
                        data: 'Gross',
                        name: 'Gross',
                        className: 'text-end',
                        render: data => Number(data).toFixed(2)
                    },
                    {
                        data: 'Tax',                     // ✅ NEW
                        name: 'Tax',
                        className: 'text-end',
                        render: data => Number(data || 0).toFixed(2)
                    },
                    {
                        data: 'Interest',
                        name: 'Interest',
                        className: 'text-end',
                        render: data => Number(data).toFixed(2)
                    },
                    {
                        data: 'Adjustment',
                        name: 'Adjustment',
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                            <input type="number"
                                   class="form-control form-control-sm adjustment-input text-end"
                                   value="${Number(data || 0).toFixed(2)}"
                                   step="0.01"
                                   min="0"
                                   data-member-ref="${row.MemberReference}" />
                        `;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-end',
                        render: function () {
                            return `
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-account">
                                <i class="mdi mdi-delete-outline"></i>
                            </button>
                        `;
                        }
                    }
                ],


                language: {
                    emptyTable: "No simulation data available",
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    paginate: {
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        }

       


        // ===============================
        // AJAX Submit
        // ===============================
        function AjaxPostSharedMonth(form) {
            $.validator.unobtrusive.parse(form);

            if (!$(form).valid()) {
                return false;
            }

            $.ajax({
                type: 'POST',
                url: form.action,
                data: $(form).serialize(),

                beforeSend: function () {
                    $(form).find('button[type="submit"]').prop('disabled', true);
                },

                success: function (response) {

                    if (!response.success) {
                        appalert(response.message || 'Simulation failed', 3, 1);
                        return;
                    }

                    // Initialize DataTable with returned data
                    initializeSharedMonthTable(response.data);

                    // Show accordion
                    $('#accountListAccordionShared').removeClass('d-none');
                    $('#collapseAccountListShared').addClass('show');

                    appalert(response.message || '✅ Simulation completed successfully', 1, 1);
                },

                error: function (err) {
                    appalert(err.responseJSON?.message || 'Server error', 3, 1);
                },

                complete: function () {
                    $(form).find('button[type="submit"]').prop('disabled', false);
                }
            });

            return false;
        }

        // ===============================
        // Remove Row
        // ===============================
        $(document).on('click', '.remove-account', function () {
            sharedMonthTable
                .row($(this).closest('tr'))
                .remove()
                .draw();
        });

        // ===============================
        // Highlight Adjustment Change
        // ===============================
        $(document).on('input', '.adjustment-input', function () {
            $(this).addClass('border-warning');
        });

        // ===============================
        // Collect Adjustments (for save)
        // ===============================
        function collectAdjustments() {
            const adjustments = [];

            $('.adjustment-input').each(function () {
                adjustments.push({
                    MemberReference: $(this).data('member-ref'),
                    Adjustment: parseFloat($(this).val()) || 0
                });
            });

            return adjustments;
        }

        // ===============================
        // Show Save Simulation Modal ✅
        // ===============================
        $(document).on('click', '#btnSaveSimulation', function () {
            const modal = new bootstrap.Modal(
                document.getElementById('saveSimulationModal')
            );
            modal.show();
        });


        function collectModalData() {
            return {
                Name: $('#SimulationName').val(),
                Description: $('#SimulationDescription').val()
            };
        }
        function collectSimulationParameters() {
            return {
                BranchId: $('#BranchId').val(),
                Year: parseInt($('#Year').val()),
                IntrestDistributionType: $('#InterestDistributionType').val(),
                Month: $('#Month').val(),
                InterestRate: parseFloat($('#InterestRate').val()) || null
            };
        }
        function collectTableData() {
            const data = [];

            sharedMonthTable.rows().every(function () {
                const row = this.data();
                const adjustmentInput = $(this.node()).find('.adjustment-input');

                data.push({
                    MemberReference: row.MemberReference,
                    MemberName: row.MemberName,
                    Balance: row.Balance || 0,
                    Gross: row.Gross || 0,
                    Tax: row.Tax || 0,
                    Interest: row.Interest || 0,
                    Adjustment: parseFloat(adjustmentInput.val()) || 0
                });
            });

            return data;
        }

        $(document).on('click', '#btnConfirmSaveSimulation', function () {

            const payload = {
                ...collectSimulationParameters(),
                ...collectModalData(),
                ShareMonthPsiReportLineDto: collectTableData()
            };

            $.ajax({
                url: '/SharedMonthSimulation/SaveSimulation',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),

                success: function (res) {
                    if (!res.success) {
                        appalert(res.message || 'Save failed', 3, 1);
                        return;
                    }

                    $('#saveSimulationModal').modal('hide');
                    appalert('✅ Simulation saved successfully', 1, 1);
                },

                error: function (err) {
                    appalert(err.responseJSON?.message || 'Server error', 3, 1);
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function () {

            const chkNetwork = document.getElementById('IsForNetwork');
            const branchWrapper = document.getElementById('branchWrapper');

            function toggleBranch() {
                if (chkNetwork.checked) {
                    branchWrapper.classList.add('d-none');
                } else {
                    branchWrapper.classList.remove('d-none');
                }
            }

            // Initial state (important on edit pages)
            toggleBranch();

            // On change
            chkNetwork.addEventListener('change', toggleBranch);
        });



        $(document).ready(function () {

            // Bind the form submit
            $("#GenerationForm").on("submit", function (e) {
                e.preventDefault(); // Prevent normal submission
                ConfirmAndSubmitForm(this);
            });

            // Optional: trigger via "Activate" button
            $("#GenerationForm button[type='button']").on("click", function () {
                ConfirmAndSubmitForm($("#GenerationForm")[0]);
            });

        });

        function ConfirmAndSubmitForm(form) {
            // Validate form first
            if (!$(form).valid()) {
                appalert("Please fill all required fields.", 2, 1);
                return false;
            }

            // Ask for confirmation before submitting
            alertify.confirm(
                "Confirmation",
                "Are you sure you want to proceed?",
                function () { // OK callback
                    AjaxPostGeneration(form);
                },
                function () { // Cancel callback
                    appalert("🚫 Operation cancelled.", 2, 1);
                }
            ).set({ labels: { ok: 'Yes', cancel: 'No' } });
        }

        function AjaxPostGeneration(form) {

            // Always hide details card before new processing
            $('#simulationdetailsCard').hide();

            var $btn = $(form).find("button[type='button']");
            var $icon = $btn.find("i");
            var $text = $btn.find(".btn-text");

            // Optional: show loading state
            $btn.prop('disabled', true);
            $icon.removeClass('mdi-power').addClass('mdi-loading mdi-spin');
            $text.text('Processing...');

            // Build custom payload
            var payload = {
                BranchId: $('#BranchId1').val() || null,
                StartDate: $('#StartDate').val() || null, // "2025-01-15"
                EndDate: $('#EndDate').val() || null,
                IsForNetwork: $('#IsForNetwork').is(":checked")
            };

            $.ajax({
                url: $(form).attr("action"),
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success) {

                        appalert(response.message || "✅ Operation successful.", 1, 1);

                        // ✅ SHOW simulation details card
                        $('#simulationdetailsCard').slideDown();

                        $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-check-circle');
                        $text.text('Done');

                    } else {

                        appalert((response && response.message) || "❌ Operation failed.", 3, 1);

                        $('#simulationdetailsCard').hide();

                        $btn.prop('disabled', false);
                        $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-power');
                        $text.text('Activate');
                    }
                },

                error: function (xhr, status, error) {

                    appalert("❌ An error occurred: " + error, 3, 1);

                    // ✅ Ensure card stays hidden on error
                    $('#simulationdetailsCard').hide();

                    $btn.prop('disabled', false);
                    $icon.removeClass('mdi-loading mdi-spin').addClass('mdi-power');
                    $text.text('Activate');
                }

            });

            return false;
        }


        

        $(document).on('click', '#proceedToRequestBtn', function () {

            var payload = {
                BranchId: $('#BranchId1').val() || null,
                StartDate: $('#StartDate').val() || null,
                EndDate: $('#EndDate').val() || null,
                IsForNetwork: $('#IsForNetwork').is(":checked")
            };

            $.ajax({
                url: '/SharedMonthSimulation/ProceedRequestData',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),

                beforeSend: function () {
                    $('#proceedToRequestBtn')
                        .prop('disabled', true)
                        .html('<i class="mdi mdi-loading mdi-spin me-1"></i> Processing...');
                },

                success: function (response) {
                    if (!response || !response.success) {
                        appalert(response?.message || '❌ Proceed request failed', 3, 1);
                        return;
                    }

                    appalert(response.message || '✅ Request sent successfully', 1, 1);

                    console.log(response.data);

                    // Extract Items array
                    if (response.data && response.data.items && response.data.items.length > 0) {
                        initializeRequestHistoryTable(response.data.items);
                    }
                },

                error: function (err) {
                    appalert(err.responseJSON?.message || 'Server error', 3, 1);
                },

                complete: function () {
                    $('#proceedToRequestBtn')
                        .prop('disabled', false)
                        .html('<i class="mdi mdi-arrow-right"></i> Proceed to Request');
                }
            });
        });


    </script>
}

















