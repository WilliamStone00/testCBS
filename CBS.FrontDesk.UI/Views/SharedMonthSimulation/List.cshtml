
@model CBS.FrontDesk.Data.Entity.AccountingV2.SharedMonth.SharedMonthSimulation
@{
    ViewBag.Title = "List Simulation";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> Simulation Data
        </h1>

        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Use the filters below to search and Simulated efficiently.
        </div>
    </div>
</div>





<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="journalHeaderFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-2 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Accounting / Created Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">
                   
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>
                    <div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>
                </div>
            </div>

            @*<hr class="my-3" />*@

            <!-- 🔹 Reference, Operation Type & Work Ticket (always visible) -->
            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Simulation Name</label>
                    <input type="text" id="name" name="Name" class="form-control mb-1" placeholder="Enter Name" />
                </div>
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Interest Rate</label>
                    <input type="number" id="InterestRate" name="InterestRate" class="form-control mb-1" placeholder="Enter Interest Rate" />
                </div>

                <div class="col-md-4  mb-1">
                    <label class="form-label fw-bold">Month</label>
                    @Html.DropDownList(
                        "Month",
                        new SelectList(ViewBag.Month, "Value", "Text"),
                        "--- Select MonTh ---",
                        new { @class = "form-select select2", required = "required" })
                    <div class="invalid-feedback">Please select a Month</div>
                </div>
            </div>
           

        </div>     <!-- Action Buttons -->

        <div class="row g-2 mt-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button id="resetFilterBtn" type="button" class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btntExport" class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> Export
                </button>
            </div>
        </div>
    </form>
</div>


<div id="datalistingview">
    @Html.Partial("_Datatable")
</div>
