
@model CBS.FrontDesk.Data.Entity.AccountingV2.SharedMonth.SharedMonthFileupload
@{
    ViewBag.Title = "Shared Month File Upload";
}

@using Resources


<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary fw-bold mb-2">
                    <i class="mdi mdi-calendar-month me-2"></i> shared Month File Upload
                </h1>

                <p class="card-text text-info fw-semibold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> Always select branch and file type . Select Month where neccesary
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips -->
<div class="card mb-2 shadow-sm">
    <h6 class="card-header d-flex justify-content-between align-items-center bg-light text-primary">
        <span><i class="mdi mdi-lightbulb-outline me-2"></i> @AccountingV2.Tips</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLoanTips" aria-expanded="false" aria-controls="collapseLoanTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
</div>

<!-- Main Workspace Card -->
<div class="card shadow-sm border-0 mb-4">
    <div id="mainWorkspace">
        @using (Html.BeginForm("UploadSharedMonth", "SharedMonthSimulation", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return fileupload(this);" }))
        {

            <div class="card-body">
                <div class="row g-3">


                    <!-- BRANCH DROPDOWN -->
                    <div class="col-12 branch-dropdown">
                        <label for="BranchId" class="form-label fw-semibold">🏢 Select Branch</label>
                        @Html.DropDownList(
                         "BranchId",
                         new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                         "--- Select Branch ---",
                         new { @class = "form-select select2", required = "required" })
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-1" id="InterestRateDiv">
                        @Html.LabelFor(m => m.InterestRate, "Interest Rate",
                            new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.InterestRate,
                            new { @class = "form-control", type = "number" })
                    </div>



                    <div class="col-md-6 mb-1">

                        <div class="position-relative">
                            @Html.LabelFor(m => m.ProductId, "Account Type",
                                new { @class = "form-label fw-bold" })

                            @Html.DropDownListFor(
                                m => m.ProductId,
                                ViewBag.Products as List<SelectListItem>,
                                "-- Select Account Type --",
                                new { @class = "form-control  select2" }
                            )
                            <small class="text-muted">
                                Destinaion Account for interest
                            </small>
                            <div class="invalid-feedback">Please select File type</div>

                        </div>
                    </div>
                    <div class="col-md-12 mb-1" id="FileTypeDiv">
                        <label class="form-label fw-bold">File Type</label>
                        @Html.DropDownList(
                            "FileType",
                            new SelectList(ViewBag.FileType, "Value", "Text"),
                            "--- Select File Type ---",
                            new { @class = "form-select select2", required = "required" })
                        <div class="invalid-feedback">Please select File type</div>
                    </div>

                    <div class="col-md-6 mb-1" id="MonthDiv">
                        <label class="form-label fw-bold">Month</label>
                        @Html.DropDownList(
                            "Month",
                            new SelectList(ViewBag.Month, "Value", "Text"),
                            "--- Select Period ---",
                            new { @class = "form-select select2", id = "Month" })
                        <div class="invalid-feedback">Please select a Month</div>
                    </div>

                    <!-- ACCOUNTING YEAR DROPDOWN -->
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold">Accounting Year</label>
                        <select id="AccountingYearId" name="AccountingYearId"
                                class="form-select select2" required>
                            <option value="">--- Select Accounting Year ---</option>
                        </select>
                        <div class="invalid-feedback">Please select an Accounting Year</div>
                    </div>


                    <div class="mb-1">

                        <div class="input-group">
                            <input type="file" name="file" id="file" class="form-control" required />
                            <button type="submit" class="btn btn-primary" id="btnSubmitUpload">
                                <i class="mdi mdi-cloud-upload-outline me-1"></i> @ChequeManagements.UploadFile
                            </button>
                        </div>
                    </div>



                    <div class="col-12 text-end mt-3">
                        <div class="d-flex justify-content-end gap-2">
                            <a id="MonthlyUnprocessDataLink"
                               href="@Url.Action("MonthlyUnprocessData", "SharedMonthSimulation")"
                               class="btn btn-outline-primary d-none">
                                <i class="mdi mdi-file-download-outline me-1"></i>
                                Download MFI Template (Monthly Unprocess Data)
                            </a>

                            <a id="MonthlyprocessDataLink"
                               href="@Url.Action("MonthlyprocessData", "SharedMonthSimulation")"
                               class="btn btn-outline-primary d-none">
                                <i class="mdi mdi-file-download-outline me-1"></i>
                                Download MFI Template (Monthly process Data)
                            </a>

                            <a id="AnnualprocessDataLink"
                               href="@Url.Action("AnnualprocessData", "SharedMonthSimulation")"
                               class="btn btn-outline-primary d-none">
                                <i class="mdi mdi-file-download-outline me-1"></i>
                                Download MFI Template (Annual process Data)
                            </a>

                            <a id="TaxprocessDataLink"
                               href="@Url.Action("AnnualprocessData", "SharedMonthSimulation")"
                               class="btn btn-outline-primary d-none">
                                <i class="mdi mdi-file-download-outline me-1"></i>
                                Download MFI Template (Tax)
                            </a>


                        </div>
                    </div>


                </div>
            </div>

        }  <!-- using block closed -->
    </div>


</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {

        /* ================= FILE TYPE LOGIC ================= */

        function toggleMonthAndLinks() {
            var fileType = $("#FileType").val();

            var monthDiv = $("#MonthDiv");
            var fileTypeDiv = $("#FileTypeDiv");
            var interestRateDiv = $("#InterestRateDiv");

            // All download links
            var allLinks = $(
                "#MonthlyUnprocessDataLink," +
                "#MonthlyprocessDataLink," +
                "#AnnualprocessDataLink," +
                "#TaxprocessDataLink"
            );

            // Hide all links first
            allLinks.addClass("d-none");

            // Default UI
            monthDiv.hide();
            interestRateDiv.show();
            fileTypeDiv.removeClass("col-md-6").addClass("col-md-12");

            switch (fileType) {

                case "MonthlyUnprocessData":
                    monthDiv.show();
                    $("#MonthlyUnprocessDataLink").removeClass("d-none");
                    break;

                case "MonthlyprocessData":
                    monthDiv.show();
                    $("#MonthlyprocessDataLink").removeClass("d-none");
                    break;

                case "AnnualprocessData":
                    interestRateDiv.hide();
                    $("#AnnualprocessDataLink").removeClass("d-none");
                    break;

                case "Tax":
                    interestRateDiv.hide();
                    $("#TaxprocessDataLink").removeClass("d-none");
                    break;

                default:
                    // DEFAULT → Annual link visible
                    $("#AnnualprocessDataLink").removeClass("d-none");
                    break;
            }
        }

        // Initial state
        $("#MonthDiv").hide();
        toggleMonthAndLinks();

        // On change
        $("#FileType").on("change", toggleMonthAndLinks);




        /* ================= BRANCH → ACCOUNTING YEAR ================= */

        $("#BranchId").on("change", function () {
            var branchId = $(this).val();
            var $yearDropdown = $("#AccountingYearId");

            $yearDropdown.empty()
                .append('<option value="">--- Loading Accounting Years ---</option>')
                .prop("disabled", true);

            if (!branchId) {
                $yearDropdown
                    .empty()
                    .append('<option value="">--- Select Accounting Year ---</option>')
                    .prop("disabled", false);
                return;
            }

            $.ajax({
                url: '@Url.Action("GetAccountingYearsByBranch", "SharedMonthSimulation")',
                type: 'GET',
                data: { branchId: branchId },

                success: function (years) {
                    $yearDropdown.empty()
                        .append('<option value="">--- Select Accounting Year ---</option>');

                    if (years && years.length > 0) {

                        $.each(years, function (i, year) {
                            $yearDropdown.append(
                                $('<option/>')
                                    .val(year.Id)            // ✅ ID sent to server
                                    .text(year.DisplayName)  // eg: 2024
                            );
                        });

                        // ✅ SUCCESS MESSAGE
                        appalert("✅ Accounting years loaded successfully",1,1);

                    } else {
                        $yearDropdown.append('<option value="">No Open Accounting Year</option>');

                        // ⚠ INFO MESSAGE
                        appalert("⚠ No open accounting year found for this branch",3,1);
                    }

                    $yearDropdown.prop("disabled", false);
                },

                error: function () {
                    appalert("❌ Failed to load Accounting Years", 0, 1);
                    $yearDropdown.prop("disabled", false);
                }
            });
        });

    });

    /* ================= FORM SUBMIT ================= */

    function fileupload(form) {
        try {
            var $form = $(form);

            if ($.validator && $.validator.unobtrusive) {
                $.validator.unobtrusive.parse($form);
            }

            if ($.validator && !$form.valid()) {
                appalert("❌ Please fill all required fields correctly.", 2, 1);
                return false;
            }

            alertify.confirm(
                "Confirm Upload",
                "Are you sure you want to upload this file?",
                function () {
                    var formData = new FormData(form);

                    var token = $form.find('input[name="__RequestVerificationToken"]').val();
                    if (token && !formData.has('__RequestVerificationToken')) {
                        formData.append('__RequestVerificationToken', token);
                    }

                    var $btn = $("#btnSubmitUpload");
                    $btn.prop("disabled", true);

                    $.ajax({
                        url: $form.attr("action"),
                        type: "POST",
                        data: formData,
                        contentType: false,
                        processData: false,

                        success: function (response) {
                            if (response && response.success) {
                                appalert(response.message || "✅ Upload successful", 1, 1);
                                
                            } else {
                                appalert(response.message || "❌ Upload failed", 2, 1);
                            }
                        },

                        error: function (xhr) {
                            if (xhr.status === 401) {
                                window.location.href = "/Authentication/Login";
                                return;
                            }
                            appalert("❌ Server error occurred", 0, 1);
                        },

                        complete: function () {
                            $btn.prop("disabled", false);
                        }
                    });
                },
                function () {
                    appalert("⚠ Upload cancelled", 3, 1);
                }
            );
        } catch (ex) {
            console.error(ex);
            appalert("❌ Unexpected error: " + ex.message, 0, 1);
        }

        return false;
    }
</script>
}
