<div id="updateTableContainer" class="card p-3 shadow mb-4">
    <div class="table-responsive mb-4">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>@GlobalShared.menu</th>
                    <th>@GlobalShared.original_description</th>
                    <th>@GlobalMenuTranslation.translated_text</th>
                    <th>@GlobalMenuTranslation.translated_description</th>
                </tr>
            </thead>
            <tbody id="updateTranslationTableBody">
                <!-- Populated by JS -->
            </tbody>
        </table>
    </div>
    <button class="btn btn-primary mt-3" onclick="submitUpdatedMenuTranslations()">
        <i class="mdi mdi-content-save me-1"></i> @GlobalMenuTranslation.update_translations
    </button>
</div>
