@{
    ViewBag.Title = "Edit Menu Translations";
}

<style>
    .wide-textarea {
        min-width: 250px;
        height: 178px;
        width: 100%;
        resize: vertical;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-translate me-2"></i> EDIT MENU TRANSLATIONS
                </h1>
                <p class="card-text">
                    View and update existing menu translations. Use the language selector to load translated menus for the selected language.
                </p>
                <p class="card-text fw-bold">
                    <i class="mdi mdi-alert-circle-outline me-1"></i> All editable translations will appear in the grid. Ensure accuracy when updating tooltips and descriptions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR EDITING TRANSLATIONS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><i class="mdi mdi-translate text-primary me-2"></i> <strong>Review Each Entry:</strong> Ensure all translated text accurately reflects the original meaning.</li>
                <li><i class="mdi mdi-pencil text-warning me-2"></i> <strong>Update Carefully:</strong> Make edits where necessary, then click <strong>Update Translations</strong>.</li>
                <li><i class="mdi mdi-checkbox-marked-circle-outline text-success me-2"></i> <strong>Partial Updates Allowed:</strong> You don't need to edit all rows at once.</li>
                <li><i class="mdi mdi-content-save text-success me-2"></i> <strong>Changes Take Effect Immediately:</strong> Saved translations update the menu system in real-time.</li>
            </ul>
        </div>
    </div>
</div>


<!-- Navigation Buttons for Add and Edit Modes -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="@Url.Action("Index", "MenuTranslationCreate")" class="btn btn-outline-primary">
        <i class="mdi mdi-plus-circle-outline me-1"></i> Add New Translations
    </a>
    <a href="@Url.Action("Update", "MenuTranslation")" class="btn btn-outline-primary">
        <i class="mdi mdi-pencil-box-outline me-1"></i> Edit Translations
    </a>
</div>


<!-- Language Filter -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-translate me-1"></i> Language Selection</h5>
    <form id="menuTranslationFilterForm">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Select Language</label>
                <select id="languageSelector" name="LanguageCode" class="form-select">
                    <option value="en">English</option>
                    <option value="fr" selected>French</option>
                </select>
            </div>
            <div class="col-md-8 d-flex align-items-end">
                <button id="applyTranslationFilterBtn" class="btn btn-primary me-2 w-100"><i class="mdi mdi-magnify"></i> Load Translations</button>
                <button id="resetTranslationFilterBtn" type="reset" class="btn btn-secondary w-100"><i class="mdi mdi-refresh"></i> Reset</button>
            </div>
        </div>
    </form>
</div>

<!-- Editable Translations Table -->
<div id="updateTableContainer">
    @Html.Partial("_MenuTranslationUpdateData") <!-- Render table with update mode -->
</div>

<!-- JavaScript Section -->
@section Scripts {
    <script src="~/Scripts/Js/Crud/MenuTranslation/MenuTranslationUpdate.js"></script>
}
