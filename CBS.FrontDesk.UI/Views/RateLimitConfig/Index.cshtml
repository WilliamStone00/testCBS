@{
    ViewBag.Title = "DDoS Protection & Rate Limit Configuration";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-lock-outline me-2"></i> DDoS Protection & Rate Limit Configuration
                </h1>
                <p class="card-text">
                    This configuration page allows administrators to define and manage rate limiting policies to protect the system from denial-of-service (DoS) and distributed denial-of-service (DDoS) attacks.
                    These controls help mitigate brute-force login attempts, traffic flooding, and abusive API usage.
                    <br /><br />
                    Customize per-user and per-IP thresholds, enforce dynamic blocking, and apply header-based exemptions to trusted internal services.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Section -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> Rate Limiting Configuration Tips</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    @*<h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span><i class="mdi mdi-information-outline me-2"></i> Rate Limiting Configuration Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>*@
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li>
                    <i class="mdi mdi-counter text-primary me-2"></i>
                    <strong>RequestLimit</strong>: Max requests per user/session in the given window.
                    <span class="text-muted">Recommended: <code>100</code></span>
                </li>
                <li>
                    <i class="mdi mdi-timer-sand text-primary me-2"></i>
                    <strong>TimeWindowSeconds</strong>: Time window (in seconds) to count requests.
                    <span class="text-muted">Recommended: <code>60</code> seconds</span>
                </li>
                <li>
                    <i class="mdi mdi-block-helper text-danger me-2"></i>
                    <strong>BlockDurationMinutes</strong>: Duration (in minutes) to block user/IP after exceeding limits.
                    <span class="text-muted">Recommended: <code>15</code> minutes</span>
                </li>
                <li>
                    <i class="mdi mdi-lan-connect text-info me-2"></i>
                    <strong>IPRequestLimit</strong>: Max requests from a single IP in its own window.
                    <span class="text-muted">Recommended: <code>300</code></span>
                </li>
                <li>
                    <i class="mdi mdi-clock-fast text-info me-2"></i>
                    <strong>IPTimeWindowSeconds</strong>: Time window (in seconds) for IP-based rate enforcement.
                    <span class="text-muted">Recommended: <code>60</code> seconds</span>
                </li>
                <li>
                    <i class="mdi mdi-shield-check-outline text-success me-2"></i>
                    <strong>WhitelistedHeaders</strong>: Headers that bypass rate limits.
                    <span class="text-muted">e.g., <code>X-Internal-Request</code>, <code>X-Bypass-Limit</code></span>
                </li>
                <li>
                    <i class="mdi mdi-alert-outline text-warning me-2"></i>
                    <strong>Action</strong>: What to do when limits are hit (Block, Alert, Log Only).
                    <span class="text-muted">Default: <code>Block</code></span>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Default Config Display -->
<div class="alert alert-secondary mt-3">
    <strong>Default Rate Limit Configuration:</strong><br />
    <code>
        RequestLimit = 100<br />
        TimeWindowSeconds = 60<br />
        BlockDurationMinutes = 15<br />
        IPRequestLimit = 300<br />
        IPTimeWindowSeconds = 60<br />
        WhitelistedHeaders = [ "FLUXTSC-Internal-Request", "FLUXTSC-Bypass-Limit" ]
    </code>
</div>
<!-- Configuration Note -->
<div class="alert alert-info mt-3 mb-2">
    <strong>Notice:</strong> Only <u>one global rate limit configuration</u> is allowed at a time. <br />
    You can view or update the existing configuration, but creating multiple entries is not supported.
</div>
<!-- Main Config View -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div id="accordionPopoutIcon" class="accordion accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-speedometer-slow me-2"></i> Configure Rate Limiting Policies
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="card mb-4">
                                    <div class="card-body d-flex justify-content-end align-items-center">
                                        <a type="button" onclick="LoadDataGen('RateLimitConfig','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View Existing Configs">
                                            <i class="mdi mdi-view-list mdi-18px"></i> View List
                                        </a>
                                        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','RateLimitConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Config">
                                            <i class="mdi mdi-plus mdi-18px"></i> Add Config
                                        </a>
                                    </div>
                                </div>
                                <div id="datalistingview">
                                    @Html.Partial("_Create")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
