
@using Resources
<div class="card p-3 shadow mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-table"></i>Fee Config</h5>
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>@ChequeManagements.FeeType</th>
                    <th>@ChequeManagements.Branch</th>
                    <th>@ChequeManagements.Type</th>
                    <th>@ChequeManagements.IsCentralized</th>
                    <th>@ChequeManagements.Description</th>
                    <th>@ChequeManagements.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @*<h5 class="modal-title">Fee Configuration Details</h5>*@
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- Details content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@ChequeManagements.Close</button>
            </div>
        </div>
    </div>
</div>
