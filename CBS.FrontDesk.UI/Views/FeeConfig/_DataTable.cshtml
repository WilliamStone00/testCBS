@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.Range
@using Resources
@{
    // index is provided via ViewData["index"] by the parent view (or left as placeholder)
    var index = ViewData["index"]?.ToString() ?? "{INDEX}";
}

<tr>

    <td style="width: 25%;">
        <input type="hidden" name="FeeTypeRanges.Index" value="@index" />
        <input type="hidden" name="FeeTypeRanges[@index].Id" value="@Model?.Id" />
        <input type="text" name="FeeTypeRanges[@index].Name" value="@Model?.Name" class="form-control" />
    </td>
    <td style="width: 20%;">
        <input type="number" step="0.01" name="FeeTypeRanges[@index].FromAmount" value="@Model?.FromAmount" class="form-control" />
    </td>
    <td style="width: 20%;">
        <input type="number" step="0.01" name="FeeTypeRanges[@index].ToAmount" value="@(Model?.amountTo.ToString() ?? "")" class="form-control" />
    </td>
    <td style="width: 20%;">
        <input type="number" step="0.01" name="FeeTypeRanges[@index].Fee" value="@(Model?.value.ToString() ?? "")" class="form-control" />
    </td>
    <td class="text-center" style="width: 15%;">
        <button type="button" class="btn btn-sm btn-outline-danger remove-range-row" title="@GlobalFeeConfig.Remove_this_row">
            <i class="mdi mdi-delete"></i>
        </button>
    </td>
</tr>
