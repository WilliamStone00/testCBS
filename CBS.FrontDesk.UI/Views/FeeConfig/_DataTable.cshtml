@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.Range
@{
    var index = ViewData["index"]?.ToString() ?? "{INDEX}";
}
<tr>
    <!-- Hidden index -->
    <td style="width: 30%;">
        <input type="hidden" name="FeeTypeRanges.Index" value="@index" />
        @Html.HiddenFor(m => m.Id, new { Name = $"FeeTypeRanges[{index}].Id" })
        @Html.TextBoxFor(m => m.FromAmount, new { Name = $"FeeTypeRanges[{index}].FromAmount", @class = "form-control", type = "number", step = "5" })
    </td>

    <td style="width: 30%;">
        @Html.TextBoxFor(m => m.ToAmount, new { Name = $"FeeTypeRanges[{index}].ToAmount", @class = "form-control", type = "number", step = "5" })
    </td>

    <td style="width: 30%;">
        @Html.TextBoxFor(m => m.Fee, new { Name = $"FeeTypeRanges[{index}].Fee", @class = "form-control", type = "number", step = "5" })
    </td>

    <!-- Action column -->
    <td class="text-center" style="width: 10%;">
        <button type="button" class="btn btn-sm btn-outline-danger remove-range-row" title="Remove this row">
            <i class="mdi mdi-delete"></i>
        </button>
    </td>
</tr>
