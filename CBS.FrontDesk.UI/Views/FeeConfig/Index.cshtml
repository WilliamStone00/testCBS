@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.FeeConfig
@using Resources

@{
    ViewBag.Title = "Fee Configuration";
}

@* Anti-forgery token for all subsequent AJAX posts on this page. *@
@Html.AntiForgeryToken()

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-currency-usd-circle-outline me-2"></i> Fee Configuration</h1>
        <p class="card-text">Configure centralized or branch-specific fees using percentage or range-based calculations.</p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Always choose either to configure a centralized system or decentralized and always choose a Fee Type.
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR FEE CONFIGURATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse show">
        <div class="card-body">
            <ul>
                <li><strong>Configuration Scope:</strong> Use 'Is Centralized' for system-wide rules; uncheck to pick a branch.</li>
                <li><strong>Load Configuration:</strong> After selecting scope and a fee type click 'Load' to fetch existing settings.</li>
                <li><strong>Fee Method Choice:</strong> Enable only one method at a time (Percentage or Range) — UI enforces this.</li>
                <li><strong>Fee Ranges:</strong> When using ranges ensure no overlap.</li>
                <li><strong>Saving Changes:</strong> Save button persists the entire configuration.</li>
                <li><strong>Deleting a Configuration:</strong> Delete will permanently remove the configuration for the loaded scope.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Configuration Selection Area -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-cogs me-1"></i> Select Configuration Scope</h5>
    <div class="row align-items-end">
        <!-- Is Centralized Checkbox -->
        <div class="col-md-3">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="isCentralized" checked />
                <label class="form-check-label fw-bold" for="isCentralized">Is Centralized?</label>
            </div>
        </div>

        <!-- Branch Dropdown (Initially Hidden) -->
        <div class="col-md-4" id="branch-selection-container" style="display: none;">
            <label class="form-label fw-bold">Select Branch</label>
            @Html.DropDownList("branchId", new SelectList(ViewBag.Branches, "Id", "Name"), "--- Select Branch ---", new { @class = "form-control select2", id = "branchId" })
        </div>

        <!-- Fee Type Dropdown -->
        <div class="col-md-4">
            <label class="form-label fw-bold">Select Fee Type</label>
            @Html.DropDownList("feeType", new SelectList(ViewBag.FeeTypes, "Value", "Text"), "--- Select Fee Type ---", new { @class = "form-control select2", id = "feeType" })
        </div>

        <!-- Load Button -->
        <div class="col-md-1">
            <button id="loadConfigBtn" class="btn btn-primary w-100">Load</button>
        </div>
    </div>
</div>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a type="button" onclick="LoadDataGen('FeeConfig', 'myDataTable', '_DataTable', 0, 'datalistingview', null, 'list')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','FeeConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalVault.AddNewVault">
            <i class="mdi mdi-plus mdi-18px"></i> @ChequeManagements.addbutton
        </a>
    </div>
</div>

<!-- Dynamic container for partial form -->
<div id="config-form-container"></div>

@section Scripts {
    <script>
        // Run on document ready
        $(document).ready(function () {
            setupFeeConfigToggles();
            $('#loadConfigBtn').on('click', loadConfiguration);
            setupDynamicFormHandlers(); // delegates to dynamic form container
        });

        function setupFeeConfigToggles() {
            $('#isCentralized').on('change', function () {
                if (this.checked) {
                    $('#branch-selection-container').slideUp();
                    $('#branchId').val('').trigger('change');
                } else {
                    $('#branch-selection-container').slideDown();
                }
            });
        }

        // Load configuration (fetch partial and inject it)
        function loadConfiguration() {
            var isCentralized = $('#isCentralized').is(':checked');
            var branchId = isCentralized ? null : $('#branchId').val();
            var feeType = $('#feeType').val();

            if (!isCentralized && !branchId) {
                appalert('Please select a branch for non-centralized configuration.', 2, 1);
                return;
            }
            if (!feeType) {
                appalert('Please select a fee type.', 2, 1);
                return;
            }

            const serviceOptionsObject = { isCentralized: isCentralized, branchId: branchId, feeType: feeType };
            const serviceOptionString = JSON.stringify(serviceOptionsObject);

            // Explicit POST to get the partial and inject HTML
            $.post('@Url.Action("InitializeData", "FeeConfig")', {
                partialView: '_Create',
                serviceOption: serviceOptionString
            }, function (html) {
                $('#config-form-container').html(html);
                // If you use Select2 or other plugins in the partial, re-init them here:
                if ($.fn.select2) {
                    $('#config-form-container').find('.select2').select2({ width: '100%' });
                }
            }).fail(function (err) {
                appalert('Failed to load configuration form: ' + err.statusText, 4, 1);
            });
        }

        // Template for a new range row (returns string)
        function getRangeRowTemplate() {
            var template = '';
            template += '<tr>';
            template += '  <td>';
            template += '    <input type="hidden" name="FeeTypeRanges.Index" value="{INDEX}" />';
            template += '    <input type="hidden" name="FeeTypeRanges[{INDEX}].Id" value="" />';
            template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].FromAmount" value="" class="form-control" />';
            template += '  </td>';
            template += '  <td>';
            template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].ToAmount" value="" class="form-control" />';
            template += '  </td>';
            template += '  <td>';
            template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].Fee" value="" class="form-control" />';
            template += '  </td>';
            template += '  <td class="text-center">';
            template += '    <button type="button" class="btn btn-sm btn-outline-danger remove-range-row"><i class="mdi mdi-delete"></i></button>';
            template += '  </td>';
            template += '</tr>';
            return template;
        }

        // Reindex rows so MVC modelbinder binds FeeTypeRanges[0], FeeTypeRanges[1], ...
        function reindexRangeRows() {
            $('#range-table-body tr').each(function (newIndex) {
                $(this).find('input, select, textarea').each(function () {
                    var oldName = $(this).attr('name') || '';
                    if (!oldName) return;

                    // Replace any existing numeric index or placeholder {INDEX}
                    var newName = oldName.replace(/\[\d+\]|\{INDEX\}/g, '[' + newIndex + ']');
                    $(this).attr('name', newName);

                    // Update the .Index hidden field value if present
                    if (oldName.indexOf('.Index') !== -1 || oldName.indexOf('Index') !== -1) {
                        $(this).val(newIndex);
                    }
                });
            });
        }

        // Delegated handlers inside #config-form-container so they work for dynamically loaded partials
        function setupDynamicFormHandlers() {
            var container = $('#config-form-container');

            // Ensure only one fee method active
            container.on('change', '#AcceptPercentage', function () {
                if ($(this).is(':checked')) {
                    $('#AcceptRange').prop('checked', false);
                }
            });
            container.on('change', '#AcceptRange', function () {
                if ($(this).is(':checked')) {
                    $('#AcceptPercentage').prop('checked', false);
                }
            });

            // Add new range row
            container.on('click', '#addRangeRowBtn', function () {
                var currentCount = $('#range-table-body tr').length;
                var newHtml = getRangeRowTemplate().replace(/{INDEX}/g, currentCount);
                $('#range-table-body').append(newHtml);
                reindexRangeRows();
            });

            // Remove range row
            container.on('click', '.remove-range-row', function () {
                $(this).closest('tr').remove();
                reindexRangeRows();
            });

            // Submit form (save)
            container.on('click', '#saveConfigBtn', function (e) {
                e.preventDefault();
                var form = $('#feeConfigForm');
                saveConfiguration(form);
            });

            // Delete configuration
            container.on('click', '#deleteConfigBtn', function (e) {
                e.preventDefault();
                deleteConfiguration();
            });
        }

        // Save configuration (POST) - synchronizes top-level controls into form first
        function saveConfiguration($form) {
            // Sync top-level controls into form hidden fields
            var isCentralizedMain = $('#isCentralized').is(':checked');
            var branchIdMain = isCentralizedMain ? null : $('#branchId').val();
            var feeTypeMain = $('#feeType').val();

            $form.find('input[name="IsCentralized"]').val(isCentralizedMain);
            $form.find('input[name="BranchId"]').val(branchIdMain);
            $form.find('input[name="FeeType"]').val(feeTypeMain);

            // Validate at least one fee method selected
            if (!$form.find('#AcceptPercentage').is(':checked') && !$form.find('#AcceptRange').is(':checked')) {
                appalert('You must enable at least one fee method (Percentage or Range).', 2, 1);
                return;
            }

            // Reindex before serialization
            reindexRangeRows();

            var formData = $form.serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("CreateOrUpdate", "FeeConfig")',
                type: 'POST',
                data: formData + '&__RequestVerificationToken=' + encodeURIComponent(token),
                success: function (response) {
                    if (response.success) {
                        appalert(response.message, 1, 1);
                        // Reload the form to reflect saved data
                        loadConfiguration();
                    } else {
                        appalert(response.message, 2, 1);
                    }
                },
                error: function (err) {
                    appalert('An error occurred while saving: ' + err.statusText, 0, 1);
                }
            });
        }

        // Delete configuration (POST, anti-forgery)
        function deleteConfiguration() {
            var configId = $('#Id').val();
            if (!configId) {
                appalert('Cannot delete a configuration that has not been saved yet.', 3, 1);
                return;
            }

            alertify.confirm('Confirm Deletion', 'Are you sure you want to permanently delete this fee configuration?',
                function () {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '@Url.Action("Delete", "FeeConfig")',
                        type: 'GET',
                        data: { KEY: configId, __RequestVerificationToken: token },
                        success: function (response) {
                            if (response.success) {
                                appalert(response.message, 1, 1);
                                $('#config-form-container').empty();
                            } else {
                                appalert(response.message, 4, 1);
                            }
                        },
                        error: function (err) {
                            appalert('An error occurred during deletion: ' + err.statusText, 4, 1);
                        }
                    });
                },
                function () {
                    appalert('Deletion cancelled.', 3, 1);
                }
            );
        }
    </script>
}
