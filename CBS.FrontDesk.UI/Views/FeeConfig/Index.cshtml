        // Template for a new range row (returns string)
    function getRangeRowTemplate() {
        var template = '';
        template += '<tr>';
        template += '  <td>';
        template += '    <input type="hidden" name="FeeTypeRanges.Index" value="{INDEX}" />';
        template += '    <input type="hidden" name="FeeTypeRanges[{INDEX}].Id" value="" />';
        template += '    <input type="text" name="FeeTypeRanges[{INDEX}].Name" value="" class="form-control" />';
        template += '  </td>';
        template += '  <td>';
        template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].FromAmount" value="" class="form-control" />';
        template += '  </td>';
        template += '  <td>';
        template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].ToAmount" value="" class="form-control" />';
        template += '  </td>';
        template += '  <td>';
        template += '    <input type="number" step="0.01" name="FeeTypeRanges[{INDEX}].Fee" value="" class="form-control" />';
        template += '  </td>';
        template += '  <td class="text-center">';
        template += '    <button type="button" class="btn btn-sm btn-outline-danger remove-range-row"><i class="mdi mdi-delete"></i></button>';
        template += '  </td>';
        template += '</tr>';
        return template;
    }


        // Reindex rows so MVC modelbinder binds FeeTypeRanges[0], FeeTypeRanges[1], ...
        function reindexRangeRows() {
            $('#range-table-body tr').each(function (newIndex) {
                $(this).find('input, select, textarea').each(function () {
                    var oldName = $(this).attr('name') || '';
                    if (!oldName) return;

                    // Replace any existing numeric index or placeholder {INDEX}
                    var newName = oldName.replace(/\[\d+\]|\{INDEX\}/g, '[' + newIndex + ']');
                    $(this).attr('name', newName);

                    // Update the .Index hidden field value if present
                    if (oldName.indexOf('.Index') !== -1 || oldName.indexOf('Index') !== -1) {
                        $(this).val(newIndex);
                    }
                });
            });
        }

        // Delegated handlers inside #config-form-container so they work for dynamically loaded partials
        function setupDynamicFormHandlers() {
            var container = $('#config-form-container');


            // Ensure only one fee method active
            container.on('change', '#AcceptStatus', function () {
                if ($(this).is(':checked')) {
                    $('#AcceptRange').prop('checked', false);
                }
                if ($(this).is(':checked')) {
                    $('#AcceptPercentage').prop('checked', false);
                }
            });
            container.on('change', '#AcceptPercentage', function () {
                if ($(this).is(':checked')) {
                    $('#AcceptRange').prop('checked', false);
                }
                if ($(this).is(':checked')) {
                    $('#AcceptStatus').prop('checked', false);
                }
            });

            container.on('change', '#AcceptRange', function () {
                if ($(this).is(':checked')) {
                    $('#AcceptPercentage').prop('checked', false);
                }
                if ($(this).is(':checked')) {
                    $('#AcceptStatus').prop('checked', false);
                }
            });

            // Add new range row
            container.off('click', '#addRangeRowBtn'); 
            container.on('click', '#addRangeRowBtn', function () {
                var currentCount = $('#range-table-body tr').length;
                var newHtml = getRangeRowTemplate().replace(/{INDEX}/g, currentCount);
                $('#range-table-body').append(newHtml);
                reindexRangeRows();
            });

            // Remove range row
            container.on('click', '.remove-range-row', function () {
                $(this).closest('tr').remove();
                reindexRangeRows();
            });

            // Delete configuration
            container.on('click', '#deleteConfigBtn', function (e) {
                e.preventDefault();
                deleteConfiguration();
            });

            container.off('submit', '#feeConfigForm');

            $(document).on('submit', '#feeConfigForm', function () {

                var $form = $(this);

                var isCentralizedMain = $('#isCentralized').is(':checked');
                var branchIdMain = isCentralizedMain ? null : $('#branchId').val();
                var feeTypeMain = $('#feeType').val();

                $form.find('input[name="isCentralized"]').val(isCentralizedMain);
                $form.find('input[name="branchId"]').val(branchIdMain);
                $form.find('input[name="feeType"]').val(feeTypeMain);

                reindexRangeRows();

            });

        }



        // Delete configuration (POST, anti-forgery)
        function deleteConfiguration() {
            var configId = $('#Id').val();
            if (!configId) {
                appalert('Cannot delete a configuration that has not been saved yet.', 3, 1);
                return;
            }

            alertify.confirm('Confirm Deletion', 'Are you sure you want to permanently delete this fee configuration?',
                function () {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '@Url.Action("Delete", "FeeConfig")',
                        type: 'GET',
                        data: { KEY: configId, __RequestVerificationToken: token },
                        success: function (response) {
                            if (response.success) {
                                appalert(response.message, 1, 1);
                                $('#config-form-container').empty();
                            } else {
                                appalert(response.message, 4, 1);
                            }
                        },
                        error: function (err) {
                            appalert('An error occurred during deletion: ' + err.statusText, 4, 1);
                        }
                    });
                },
                function () {
                    appalert('Deletion cancelled.', 3, 1);
                }
            );
        }


</script>
}
