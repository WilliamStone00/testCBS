@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.FeeConfig
@using Resources

@{
    ViewBag.Title = "Fee Configuration";
}

@* Anti-forgery token for all subsequent AJAX posts on this page. *@
@Html.AntiForgeryToken()

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-currency-usd-circle-outline me-2"></i> Fee Configuration</h1>
        <p class="card-text">Configure centralized or branch-specific fees using percentage or range-based calculations.</p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            Always choose either to configure a centralized system or decentralized and always choose a Fee Type.
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS FOR FEE CONFIGURATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse show">
        <div class="card-body">
            <ul>
                <li><strong>Configuration Scope:</strong> Use 'Is Centralized' for system-wide rules; uncheck to pick a branch.</li>
                <li><strong>Load Configuration:</strong> After selecting scope and a fee type click 'Load' to fetch existing settings.</li>
                <li><strong>Fee Method Choice:</strong> Enable only one method at a time (Percentage or Range) — UI enforces this.</li>
                <li><strong>Fee Ranges:</strong> When using ranges ensure no overlap.</li>
                <li><strong>Saving Changes:</strong> Save button persists the entire configuration.</li>
                <li><strong>Deleting a Configuration:</strong> Delete will permanently remove the configuration for the loaded scope.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Configuration Selection Area -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-cogs me-1"></i> Select Configuration Scope</h5>
    <div class="row align-items-end">
        <!-- Is Centralized Checkbox -->
        <div class="col-md-3">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="isCentralized" checked />
                <label class="form-check-label fw-bold" for="isCentralized">Is Centralized?</label>
            </div>
        </div>

        <!-- Branch Dropdown (Initially Hidden) -->
        <div class="col-md-4" id="branch-selection-container" style="display: none;">
            <label class="form-label fw-bold">Select Branch</label>

            @* If ViewBag.Branches is IEnumerable with Id and Name *@
            <select id="branchId" name="BranchId" class="form-control select2">
                <option value="">--- Select Branch ---</option>
                @{
                    var branches = ViewBag.Branches as IEnumerable<dynamic>;
                    if (branches != null)
                    {
                        foreach (var b in branches)
                        {
                            <option value="@b.Id" data-name="@b.Name">@b.Name</option>
;
                        }
                    }
                }
            </select>
        </div>

        <!-- Fee Type Dropdown -->
        <div class="col-md-4">
            <label class="form-label fw-bold">Select Fee Type</label>
            @Html.DropDownList("feeType", new SelectList(ViewBag.FeeTypes, "Value", "Text"), "--- Select Fee Type ---", new { @class = "form-control select2", id = "feeType" })
        </div>

        <!-- Load Button -->
        <div class="col-md-1">
            <button id="loadConfigBtn" class="btn btn-primary w-100">Load</button>
        </div>
    </div>
</div>

<div class="card mb-1">
    <div class="card-body d-flex justify-content-end align-items-center">
        <a type="button" onclick="LoadDataGen('FeeConfig', 'myDataTable', '_DataTable', 0, 'datalistingview', null, 'list')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="@GlobalShared.ViewList">
            <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
        </a>
        <a type="button" onclick="AddORUpdateGen(null,'datalistingview','_Create','new','FeeConfig')" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="@GlobalVault.AddNewVault">
            <i class="mdi mdi-plus mdi-18px"></i> @ChequeManagements.addbutton
        </a>
    </div>
</div>

<!-- Dynamic container for partial form -->
<div id="config-form-container"></div>

@section Scripts {
    <script>
        (function ($) {
            'use strict';

            // Status badge renderer
            function getStatusBadge(status) {
                if (!status) return "<span class='badge bg-secondary'>Unknown</span>";
                var s = (status + '').toLowerCase();
                var cls = 'bg-secondary';
                if (s === 'pending') cls = 'bg-warning text-dark';
                else if (s === 'approved' || s === 'extracted' || s === 'completed' || s === 'treated') cls = 'bg-success';
                else if (s === 'rejected' || s === 'failed') cls = 'bg-danger';
                else if (s === 'review' || s === 'reviewed') cls = 'bg-info text-dark';
                return '<span class="badge ' + cls + '">' + (status || '') + '</span>';
            }

            function formatDateForCell(val) {
                if (!val || val === null) return '';
                var d = new Date(val);
                if (isNaN(d.getTime())) return String(val);
                var yyyy = d.getFullYear();
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                return yyyy + '-' + mm + '-' + dd;
            }

            // DataTable initialization (server-side)
            var table = $('#fileDetailsTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("LoadDetailsDataTable", "TransactionDetails")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        // Add our custom filters to the DataTables request
                        return JSON.stringify({
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search,
                            columns: d.columns,
                            order: d.order,
                            filters: {
                                memberBranchCode: $('#f_memberBranchCode').val(),
                                memberBranchId: $('#f_memberBranchId').val(),
                                memberBranchName: $('#BranchIdFilter').val(),
                                amountMin: $('#f_amountMin').val(),
                                amountMax: $('#f_amountMax').val(),
                                memberName: $('#f_memberName').val(),
                                memberReference: $('#f_memberReference').val(),
                                accountNumber: $('#f_accountNumber').val(),
                                dailyCollectorName: $('#f_dailyCollectorName').val(),
                                uploadBy: $('#f_uploadBy').val(),
                                manualEntryDailyCollectorId: $('#f_manualEntryDailyCollectorId').val(),
                                processingStatus: $('#statusFilter').val(),
                                treatementStatus: $('#f_treatementStatus').val(),
                                treatementDateFrom: $('#f_treatementDateFrom').val(),
                                treatementDateTo: $('#f_treatementDateTo').val(),
                                accountingDateFrom: $('#f_accountingDateFrom').val(),
                                accountingDateTo: $('#f_accountingDateTo').val(),
                                startDate: $('#f_startDate').val(),
                                endDate: $('#f_endDate').val(),
                                uploadDateFrom: $('#startDate').val(),
                                uploadDateTo: $('#endDate').val()
                            }
                        });
                    },
                    dataSrc: function (json) {
                        // If your API returns data in a different structure, adjust here
                        return json.data;
                    }
                },
                stripeClasses: [],
                columns: [
                    { data: 'memberName', name: 'MemberName' },
                    { data: 'accountNumber', name: 'AccountNumber' },
                    { data: 'memberBranchName', name: 'MemberBranchName' },
                    {
                        data: 'amount',
                        name: 'Amount',
                        className: 'text-end',
                        render: function (data) {
                            var val = data == null ? 0 : parseFloat(data);
                            return val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: 'dailyCollectorName', name: 'DailyCollectorName' },
                    { data: 'uploadBy', name: 'UploadBy' },
                    {
                        data: 'processingStatus',
                        name: 'ProcessingStatus',
                        render: function (data) { return getStatusBadge(data); }
                    },
                    {
                        data: 'treatementStatus',
                        name: 'TreatementStatus',
                        render: function (data) { return getStatusBadge(data); }
                    },
                    {
                        data: 'treatementDate',
                        name: 'TreatementDate',
                        render: function (d) { return formatDateForCell(d); }
                    },
                    {
                        data: 'accountingDate',
                        name: 'AccountingDate',
                        render: function (d) { return formatDateForCell(d); }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var id = row.manualEntryDailyCollectorId || '';
                            return '<a class="btn btn-sm btn-outline-primary details-btn" href="@Url.Action("GetFileDetailsById", "ManualDailyCollection")?KEY=' + encodeURIComponent(id) + '">Details</a>';
                        }
                    }
                ],
                responsive: true,
                autoWidth: false,
                order: [[0, 'asc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    emptyTable: "No details found.",
                    processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
                },
                drawCallback: function () {
                    $('#rowsCount').text('Showing ' + this.api().page.info().recordsDisplay + ' rows');
                }
            });

            // Helper: toggle optional filter containers
            $('.more-filter-chk').on('change', function () {
                var target = $(this).data('target');
                if (!target) return;
                if ($(this).is(':checked')) {
                    $(target).stop(true, true).slideDown().addClass('show');
                } else {
                    // clear value and hide
                    $(target).find('input').val('');
                    $(target).stop(true, true).slideUp().removeClass('show');
                    table.draw(); // reapply filters with the cleared value
                }
            });

            // Apply button behavior - redraw the table with new filters
            $('#applyFilterBtn').on('click', function () {
                table.draw();
            });

            // Reset button behavior
            $('#resetFilterBtn').on('click', function () {
                // Reset all filters
                $('#detailsFilters input').val('');
                $('#detailsFilters select').val('').trigger('change');

                // Uncheck all optional filters and hide their containers
                $('.more-filter-chk').prop('checked', false);
                $('.more-filter-chk').each(function () {
                    var target = $(this).data('target');
                    if (target) {
                        $(target).stop(true, true).slideUp().removeClass('show');
                    }
                });

                // Redraw the table
                table.draw();
            });

            // Delegate click to open details (modal)
            $('#fileDetailsTable').on('click', '.details-btn', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                // create modal if missing
                if ($('#detailsModal').length === 0) {
                    $('body').append('<div id="detailsModal" class="modal fade" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-3" id="detailsModalBody"></div></div></div></div>');
                }
                $('#detailsModalBody').html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"></div></div>');
                var m = new bootstrap.Modal(document.getElementById('detailsModal'));
                m.show();

                $.get(url).done(function (html) {
                    $('#detailsModalBody').html(html);
                }).fail(function (xhr) {
                    $('#detailsModalBody').html('<div class="alert alert-danger">Could not load details. ' + (xhr.status ? ('Status: ' + xhr.status) : '') + '</div>');
                });
            });

            // Initialize select2 if available
            $(document).ready(function () {
                if ($.fn.select2) {
                    $('#statusFilter, #BranchIdFilter').select2({ width: '100%' });
                }

                // Add a row count display
                $('#detailsFilters').after('<div class="ms-auto text-muted align-self-center small" id="rowsCount">Showing 0 rows</div>');
            });

        })(jQuery);
    </script>
}
