@* Cheque Book Filters - minimal fields to match ChequeBookQuery *@
@using Resources
@{
    ViewBag.Title = "Fee Config Listing ";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary"><i class="mdi mdi-currency-usd-circle-outline me-2"></i>@GlobalFeeConfig.Fee_Configurations</h1>
        <p class="card-text">@GlobalFeeConfig.Configure_centralized_or_branch_specific_fees_using_percentage_or_range_based_calculations</p>
        <div class="alert alert-info mt-3 py-2">
            <i class="mdi mdi-information-outline me-1"></i>
            @GlobalFeeConfig.Always_choose_either_to_configure_a_centralized_system_or_decentralized_and_always_choose_a_Fee_Type
        </div>
    </div>
</div>

<div class="card mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i>@GlobalFeeConfig.TIPS_FOR_FEE_CONFIGURATION</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseTips" class="collapse">
        <div class="card-body">
            <ul>
                <li><strong>@GlobalFeeConfig.ConfigurationScope:</strong>@GlobalFeeConfig.Use_Is_Centralized_for_system_wide_rules_uncheck_to_pick_a_branch</li>
                <li><strong>@GlobalFeeConfig.LoadConfiguration:</strong>@GlobalFeeConfig.After_selecting_scope_and_a_fee_type_click_Load_to_fetch_existing_settings</li>
                <li><strong>@GlobalFeeConfig.Fee_Method_Choice:</strong>@GlobalFeeConfig.Enable_only_one_method_at_a_time_Percentage_or_Range_UI_enforces_this</li>
                <li><strong>@GlobalFeeConfig.FeeRanges:</strong>@GlobalFeeConfig.When_using_ranges_ensure_no_overlap</li>
                <li><strong>@GlobalFeeConfig.Saving_Changes:</strong>@GlobalFeeConfig.Save_button_persists_the_entire_configuration</li>
                <li><strong>@GlobalFeeConfig.Deleting_a_Configuration:</strong>@GlobalFeeConfig.Delete_will_permanently_remove_the_configuration_for_the_loaded_scope</li>
            </ul>
            <a href="~/Views/FeeConfig/List.cshtml">~/Views/FeeConfig/List.cshtml</a>
        </div>
    </div>
</div>

<!-- Fee Config Filters -->
<div class="card shadow p-3 mb-4" id="filtersSection">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-filter-outline me-1"></i> @GlobalFeeConfig.Fee_Config_Filters
    </h5>

    <form id="feeConfigFilterForm" method="post" autocomplete="off">
        <div class="card p-3 mb-3 bg-light">

            <!-- Toggle switches -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch" />
                        <label class="form-check-label fw-bold" for="toggleBranch">@GlobalShared.Show_Branch</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleFeeType" />
                        <label class="form-check-label fw-bold" for="toggleFeeType">@GlobalShared.Show_Fee_Type</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleFlags" />
                        <label class="form-check-label fw-bold" for="toggleFlags">@GlobalFeeConfig.Show_Flags</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDates" />
                        <label class="form-check-label fw-bold" for="toggleDates">@GlobalShared.Show_Date_Filters</label>
                    </div>
                </div>
            </div>

            <!-- Branch Section -->
            <div id="branchFilter" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Branch_Code</label>
                        <input type="text"
                               name="BranchCode"
                               class="form-control"
                               placeholder="e.g. B001" />
                    </div>
                </div>
            </div>

            <!-- Fee Type -->
            <div id="feeTypeContainer" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Fee_Type</label>
                        @Html.DropDownList("FeeType",
                            new SelectList(ViewBag.FeeTypes, "Value", "Text"),
                            "--- Select Fee Type ---",
                            new { @class = "form-control select2" })
                    </div>
                </div>
            </div>

            <!-- Flags -->
            <div id="flagsContainer" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="AcceptStaticAmount"
                                   value="true" />
                            <label class="form-check-label fw-bold">
                                @GlobalFeeConfig.Accept_Static_Amount
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="AcceptPercentage"
                                   value="true" />
                            <label class="form-check-label fw-bold">
                                @GlobalFeeConfig.Accept_Percentage
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="AcceptRange"
                                   value="true" />
                            <label class="form-check-label fw-bold">
                                @GlobalFeeConfig.Accept_Range
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="IsCentralized"
                                   value="true" />
                            <label class="form-check-label fw-bold">
                                @GlobalShared.Is_Centralized
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.Start_Date</label>
                        <input type="date"
                               name="StartDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">@GlobalShared.End_Date</label>
                        <input type="date"
                               name="EndDate"
                               class="form-control" />
                    </div>
                </div>
            </div>

        </div>

        <!-- Buttons -->
        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn"
                        type="submit"
                        class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> @GlobalShared.Apply_Filter
                </button>

                <button id="resetFilterBtn"
                        type="reset"
                        class="btn btn-secondary me-2 w-100">
                    <i class="mdi mdi-refresh"></i> @GlobalShared.Reset
                </button>
            </div>
        </div>
    </form>

</div>

<div id="datalistingview">
    @Html.Partial("_feeconfigData")
</div>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@GlobalShared.Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <!-- AJAX content -->
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    (function () {
        // Config - change this if your controller action name is different
        const ajaxUrl = '@Url.Action("LoadfeeData", "FeeConfig")'; // server should accept POST JSON and return { success: true, data: [...] }
        const antiToken = $('input[name="__RequestVerificationToken"]').val();

        // state
        let allFeeConfigs = [];
        let feeTable = null;

        // init on document ready
        $(function () {
            initUi();
            initEmptyDataTable();

            // wire buttons
            $('#applyFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                onApplyFilters();
            });

            $('#resetFilterBtn').off('click').on('click', function (e) {
                e.preventDefault();
                onResetFilters();
            });

            // toggles already exist - ensure select2 initialised if visible
            safeInitSelect2('#branchId');
            safeInitSelect2('#feeType');
        });

        // initialize UI helpers
        function initUi() {
            // toggles visibility
            $('#toggleBranch').off('change').on('change', function () {
                $('#branchFilter')[$(this).is(':checked') ? 'removeClass' : 'addClass']('d-none');
                safeInitSelect2('#branchId');
            });
            $('#toggleFeeType').off('change').on('change', function () {
                $('#feeTypeContainer')[$(this).is(':checked') ? 'removeClass' : 'addClass']('d-none');
                safeInitSelect2('#feeType');
            });
            $('#toggleFlags').off('change').on('change', function () {
                $('#flagsContainer')[$(this).is(':checked') ? 'removeClass' : 'addClass']('d-none');
            });
            $('#toggleDates').off('change').on('change', function () {
                $('#dateFilters')[$(this).is(':checked') ? 'removeClass' : 'addClass']('d-none');
            });
        }

        function safeInitSelect2(selector) {
            if ($.fn.select2 && $(selector).length && !$(selector).data('select2')) {
                try { $(selector).select2({ width: '100%' }); } catch (e) { console.warn('select2 init failed', e); }
            }
        }

        // Initialize DataTable with empty data and helpful empty message
        function initEmptyDataTable() {
            // destroy if exists
            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                try { $('#myDataTable').DataTable().destroy(); } catch (e) { /* ignore */ }
                $('#myDataTable').empty();
            }

            feeTable = $('#myDataTable').DataTable({
                data: [],
                searching: true,
                ordering: true,
                paging: true,
                responsive: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                columns: [
                    {
                        data: 'feeType',
                        width: '15%',
                        render: (d) => d || 'N/A'
                    },
                    {
                        data: 'branchName',
                        width: '15%',
                        render: (d, t, row) => d || (row.isCentralized ? 'Centralized' : 'N/A')
                    },
                    {
                        data: 'feeType',
                        width: '10%',
                        render: function (d) {
                            if (!d) return '<span class="badge bg-secondary">N/A</span>';
                            return `<span class="badge bg-info">${escapeHtml(d)}</span>`;
                        }
                    },
                    {
                        data: 'isCentralized',
                        width: '10%',
                        render: (d) => d ? '<span class="badge bg-success">true</span>' : '<span class="badge bg-danger">false</span>'
                    },
                    {
                        data: 'description',
                        width: '30%',
                        render: (d) => d || 'No description'
                    },
                    {
                        data: 'id',
                        width: '20%',
                        orderable: false,
                        searchable: false,
                        render: function (id, type, row) {
                            const safeId = String(id || '').replace(/[^a-zA-Z0-9_-]/g, '_');
                            return `
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-info dropdown-toggle" type="button" id="act_${safeId}" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline"></i> Actions
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="act_${safeId}">


<li>
    <button class="dropdown-item btn-details" type="button" data-id="${encodeURIComponent(id)}">
        <i class="mdi mdi-eye me-1 text-info"></i> View Details
    </button>
</li>




                                        <li><button class="dropdown-item" type="button" onclick="editConfig('${escapeJs(id)}')"><i class="mdi mdi-pencil me-1 text-primary"></i> Edit</button></li>
                                        <li><button class="dropdown-item text-danger" type="button" onclick="deleteConfig('${escapeJs(id)}')"><i class="mdi mdi-delete me-1"></i> Delete</button></li>
                                    </ul>
                                </div>`;
                        }
                    }
                ],
                language: {
                    emptyTable: "No fee configurations. Click 'Apply Filter' to load data."
                }
            });
        }

        // Build FeeConfigQuery from form fields
        function buildQueryObject() {

            const branchVisible = !$('#branchFilter').hasClass('d-none');
            const feeTypeVisible = !$('#feeTypeContainer').hasClass('d-none');
            const flagsVisible = !$('#flagsContainer').hasClass('d-none');
            const dateVisible = !$('#dateFilters').hasClass('d-none');

            const branchSelect = $('#BranchId');
            const selectedBranchText = branchSelect.find('option:selected').text();

            return {
                BranchCode: branchVisible ? ($('#branchCode').val() || null) : null,
                BranchId: branchVisible ? (branchSelect.val() || null) : null,
                BranchName: branchVisible && branchSelect.val() ? selectedBranchText : null,

                FeeType: feeTypeVisible ? ($('#FeeType').val() || null) : null,

                AcceptStaticAmount: flagsVisible
                    ? ($('#acceptStaticAmount').is(':checked') ? true : null)
                    : null,

                AcceptPercentage: flagsVisible
                    ? ($('#acceptPercentage').is(':checked') ? true : null)
                    : null,

                AcceptRange: flagsVisible
                    ? ($('#acceptRange').is(':checked') ? true : null)
                    : null,

                IsCentralized: flagsVisible
                    ? ($('#isCentralized').is(':checked') ? true : null)
                    : null,

                StartDate: dateVisible ? ($('#startDate').val() || null) : null,
                EndDate: dateVisible ? ($('#endDate').val() || null) : null,

                Options: {
                    draw: feeTable ? feeTable.page.info().page : 0,
                    pageSize: feeTable ? feeTable.page.len() : 10
                }
            };
        }


        // Apply Filters button clicked
        function onApplyFilters() {
            const query = buildQueryObject();

            // Basic validation: if branch required (visible) ensure selected
            if (!query.IsCentralized && $('#branchFilter').hasClass('d-none') === false && !query.BranchId) {
                if (typeof appalert === 'function') appalert('Please select a branch.', 2, 1);
                return;
            }

            // clear previous rows and show a spinner row while loading
            feeTable.clear().draw();
            $('#myDataTable tbody').html();


            $.ajax({
                url: ajaxUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(query),
                dataType: 'json',
                headers: {
                    'RequestVerificationToken': antiToken
                },
                success: function (resp) {
                    if (!resp || !resp.data) {
                        allFeeConfigs = [];
                        feeTable.clear().draw();
                        if (typeof appalert === 'function') appalert('No data returned from server.', 3, 1);
                        return;
                    }

                    // store and bind
                    allFeeConfigs = resp.data;
                    feeTable.clear();
                    feeTable.rows.add(allFeeConfigs).draw();
                },
                error: function (xhr, status, err) {
                    console.error('Load error', status, err, xhr.responseText);
                    allFeeConfigs = [];
                    feeTable.clear().draw();
                    if (typeof appalert === 'function') appalert('Failed to load fee configurations. See console for details.', 0, 1);
                }
            });
        }

        // Reset filters and clear table
        function onResetFilters() {
            // reset form
            const form = document.getElementById('numconfigFilterForm');
            if (form) form.reset();

            // hide optional blocks and uncheck toggles
            $('#branchFilter, #feeTypeContainer, #flagsContainer, #dateFilters').addClass('d-none');
            $('#toggleBranch, #toggleFeeType, #toggleFlags, #toggleDates').prop('checked', false);

            // reset select2 values if present
            if ($.fn.select2) {
                if ($('#branchId').data('select2')) $('#branchId').val(null).trigger('change');
                if ($('#feeType').data('select2')) $('#feeType').val(null).trigger('change');
            }

            // clear stored data and table
            allFeeConfigs = [];
            if (feeTable) {
                feeTable.clear().draw();
            }

            if (typeof appalert === 'function') appalert('Filters reset', 3, 1);
        }

        // util: escape single quotes for inline JS attributes
        function escapeJs(s) {
            if (s === null || s === undefined) return '';
            return String(s).replace(/'/g, "\\'").replace(/"/g, '\\"');
        }

        //// expose global functions used by action buttons (if not already global)
        //window.showDetails = window.showDetails || function (id) {
        //    const conf = allFeeConfigs.find(x => String(x.id) === String(id));
        //    if (!conf) { if (typeof appalert === 'function') appalert('Configuration not found', 2, 1); return; }
        //    // If you have server partial details injection flow, you can call:
        //     AddORUpdateGen(id, 'detailsModalBody', '_FeeConfigDetails', 'get', 'FeeConfig');
        //    // For now reuse your client-side render if present:
        //    //if (typeof showDetails === 'function' && showDetails !== window.showDetails) {
        //    //    // there is another showDetails defined elsewhere; call it
        //    //    showDetails(id);
        //    //    return;
        //    //}
        //    // fallback: open modal with basic JSON
        //    //$('#detailsModalBody').html('<pre>' + escapeHtml(JSON.stringify(conf, null, 2)) + '</pre>');
        //    $('#detailsModal').modal('show');
        //};

        // Delegated actions: view details in modal
        $(document).off('click', '.btn-details').on('click', '.btn-details', function (e) {
            e.preventDefault();

            var raw = $(this).data('id');
            var partialView = "_FeeConfigDetails";
            var id = raw ? decodeURIComponent(raw) : null;

            if (!id) {
                appalert('Missing id for details', 0, 1);
                return;
            }

            var modalElement = document.getElementById('detailsModal');
            var modalBody = document.getElementById('detailsModalBody');

            if (!modalElement || !modalBody) {
                appalert('Details modal not found', 0, 1);
                return;
            }

            var bsModal = bootstrap.Modal.getOrCreateInstance(modalElement);

            // Show spinner inside modal body (but DO NOT show modal yet)
            modalBody.innerHTML = `
        <div class="text-center my-3">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>`;

            // AJAX GET partial view
            $.get('/FeeConfig/InitializeData', { KEY: id, partialView: partialView })
                .done(function (html) {

                    modalBody.innerHTML = html ||
                        '<div class="text-center text-muted">No details available.</div>';

                    // Re-init tooltips if needed
                    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                            new bootstrap.Tooltip(el);
                        });
                    }

                    // ✅ SHOW MODAL ONLY AFTER CONTENT IS READY
                    bsModal.show();
                })
                .fail(function () {
                    modalBody.innerHTML =
                        '<div class="text-center text-danger">Error loading details</div>';

                    appalert('Failed to load details', 0, 1);
                });
        });


        window.editConfig = window.editConfig || function (id) {
            $('#filtersSection').addClass('d-none'); // preferred, keeps bootstrap classes consistent
            // or $('#filtersSection').hide(); // jQuery hide() works too


            if (typeof AddORUpdateGen === 'function') {
                AddORUpdateGen(id, 'datalistingview', '_Create', 'edit', 'FeeConfig');
            } else {
                if (typeof appalert === 'function') appalert('Edit function not available. Refresh page.', 2, 1);
            }
        };

        window.deleteConfig = window.deleteConfig || function (id) {
            if (typeof deleteConfig === 'function' && deleteConfig !== window.deleteConfig) {
                deleteConfig(id); // call existing implementation if present
                return;
            }

            const conf = allFeeConfigs.find(x => String(x.id) === String(id));
            if (!conf) return;
            if (!window.alertify) {
                if (typeof appalert === 'function') {
                    if (!confirm('Delete config for ' + (conf.feeType || '') + '?')) return;
                }
            }

            $.ajax({
                url: '@Url.Action("Delete", "FeeConfig")',
                type: 'GET',
                data: { KEY: id, __RequestVerificationToken: antiToken },
                success: function (resp) {
                    if (resp && resp.success) {
                        if (typeof appalert === 'function') appalert(resp.message, 1, 1);
                        // reload after deletion
                        onApplyFilters();
                    } else {
                        if (typeof appalert === 'function') appalert(resp.message || 'Delete failed', 4, 1);
                    }
                },
                error: function (xhr) {
                    if (typeof appalert === 'function') appalert('Delete failed. See console.', 4, 1);
                    console.error('Delete error', xhr.responseText);
                }
            });
        };

        // safe HTML escape (same as earlier)
        function escapeHtml(unsafe) {
            if (!unsafe && unsafe !== 0) return '';
            return String(unsafe)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    })();
    </script>
}
