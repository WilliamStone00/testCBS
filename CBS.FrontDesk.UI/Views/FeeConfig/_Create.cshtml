@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.FeeConfig
@using Resources

<form id="feeConfigForm" onsubmit="return false;">
    @Html.AntiForgeryToken()

    @* Hidden fields that will be synced with the page level controls before save *@
    @Html.HiddenFor(m => m.id, new { id = "Id" })
    @Html.HiddenFor(m => m.isCentralized, new { id = "IsCentralized", Name = "IsCentralized" })
    @Html.HiddenFor(m => m.branchId, new { id = "BranchId", Name = "BranchId" })
    @Html.HiddenFor(m => m.feeType, new { id = "FeeType", Name = "FeeType" })
    @Html.HiddenFor(m => m.branchName, new { id = "BranchName", name = "BranchName" })


    <div class="card shadow p-3">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-pencil-box-outline me-2"></i>
            Manage Configuration for: <span class="text-dark">@Model.FeeType</span>
            Manage Configuration for: <span class="text-dark">@Model.feeType</span>
        </h5>

        <div class="form-floating mb-3">
            @Html.TextBoxFor(m => m.description, new { @class = "form-control", placeholder = "Description" })
            @Html.ValidationMessageFor(m => m.description, "", new { @class = "text-danger" })
            <label>Description</label>
        </div>

        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3"><i class="mdi mdi-pencil-box-outline me-2"></i> Static Config</h5>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptStaticAmount, new { id = "AcceptStatus", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptStatus">Enable Status Fee</label>
                </div>

                <div class="form-floating">
                    @Html.TextBoxFor(m => m.staticAmount, new { @class = "form-control", type = "number", step = "1", placeholder = "Static " })
                    @Html.ValidationMessageFor(m => m.staticAmount, "", new { @class = "text-danger" })
                    <label>Static</label>
                </div>
            </div>
        </div>

        <hr />

        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3"><i class="mdi mdi-pencil-box-outline me-2"></i> Percentage Config</h5>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptPercentage, new { id = "AcceptPercentage", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptPercentage">Enable Percentage Fee</label>
                </div>

                <div class="form-floating">
                    @Html.TextBoxFor(m => m.percentageApplied, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Percentage (%)" })
                    @Html.ValidationMessageFor(m => m.percentageApplied, "", new { @class = "text-danger" })
                    <label>Percentage (%)</label>
                </div>
            </div>
        </div>

        <hr />

        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3"><i class="mdi mdi-pencil-box-outline me-2"></i> Range Config</h5>
                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptRange, new { id = "AcceptRange", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptRange">Enable Range-Based Fee</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6>Fee Ranges</h6>
                    <button type="button" id="addRangeRowBtn" class="btn btn-sm btn-outline-text-primary"><i class="mdi mdi-plus"></i> Add Row</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">From Amount</th>
                                <th style="width: 35%;">To Amount</th>
                                <th style="width: 20%;">Fee</th>
                                <th style="width: 10%;"></th>
                            </tr>
                        </thead>
                        <tbody id="range-table-body">
                            @if (Model?.feeTypeRanges != null)
                            {
                                for (int i = 0; i < Model.feeTypeRanges.Count; i++)
                                {
                                    @Html.Partial("_DataTable", Model.feeTypeRanges[i], new ViewDataDictionary { { "index", i } })
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-end">
            <div class="col-12 text-end mt-3">
                @if (string.IsNullOrWhiteSpace(Model?.id))
                {
                    <button id="saveConfigBtn" type="button" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-save me-1"></i> @ChequeManagements.Save
                    </button>
                    <button type="reset" class="btn btn-outline-secondary shadow-sm px-4"> @GlobalShared.Reset </button>
                }
                else
                {
                    <button id="saveConfigBtn" type="button" class="btn btn-primary me-2">@GlobalBank.Update</button>
                    <button id="deleteConfigBtn" type="button" class="btn btn-danger border-4 border-white text-white fw-bold px-3 py-1">
                        Delete
                    </button>
                }
            </div>
        </div>
    </div>
</form>
