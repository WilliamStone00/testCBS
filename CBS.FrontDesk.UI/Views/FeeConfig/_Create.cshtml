@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.Configurations.FeeConfiguration.FeeConfig
@using Resources

@using (Html.BeginForm("CreateOrUpdate", "FeeConfig",
    FormMethod.Post,
    new {  enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()

    @* Hidden fields synced from page-level controls *@
    @Html.HiddenFor(m => m.id, new { id = "Id" })
    @Html.HiddenFor(m => m.isCentralized, new { id = "IsCentralized" })
    @Html.HiddenFor(m => m.branchId, new { id = "BranchId" })
    @Html.HiddenFor(m => m.feeType, new { id = "FeeType" })
    @Html.HiddenFor(m => m.branchName, new { id = "BranchName" })

    <div class="card shadow p-3">
        <h5 class="text-primary mb-3">
            <i class="mdi mdi-pencil-box-outline me-2"></i>
            @GlobalFeeConfig.ManageConfigurationfor:
            <span class="text-dark">@Model.feeType</span>
        </h5>

        <div class="form-floating mb-3 bg-light">
            @Html.TextBoxFor(m => m.description, new { @class = "form-control", placeholder = "Description" })
            @Html.ValidationMessageFor(m => m.description, "", new { @class = "text-danger" })
            <label>@GlobalShared.Description</label>
        </div>

        <!-- STATIC CONFIG -->
        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3">
                    <i class="mdi mdi-pencil-box-outline me-2"></i>
                    @GlobalFeeConfig.StaticConfig
                </h5>

                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptStaticAmount,
                        new { id = "AcceptStatus", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptStatus">
                        @GlobalFeeConfig.EnableStatusFee
                    </label>
                </div>

                <div class="form-floating">
                    @Html.TextBoxFor(m => m.staticAmount,
                        new { @class = "form-control", type = "number", step = "1", placeholder = "Static" })
                    @Html.ValidationMessageFor(m => m.staticAmount, "", new { @class = "text-danger" })
                    <label>@GlobalFeeConfig.Static</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- PERCENTAGE CONFIG -->
        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3">
                    <i class="mdi mdi-pencil-box-outline me-2"></i>
                    @GlobalFeeConfig.PercentageConfig
                </h5>

                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptPercentage,
                        new { id = "AcceptPercentage", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptPercentage">
                        @GlobalFeeConfig.EnablePercentageFee
                    </label>
                </div>

                <div class="form-floating">
                    @Html.TextBoxFor(m => m.percentageApplied,
                        new { @class = "form-control", type = "number", step = "0.01", placeholder = "Percentage (%)" })
                    @Html.ValidationMessageFor(m => m.percentageApplied, "", new { @class = "text-danger" })
                    <label>@GlobalShared.Percentage (%)</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- RANGE CONFIG -->
        <div class="modal-body bg-light">
            <div class="mb-3">
                <h5 class="text-primary mb-3">
                    <i class="mdi mdi-pencil-box-outline me-2"></i>
                    @GlobalFeeConfig.RangeConfig
                </h5>

                <div class="form-check form-switch mb-2">
                    @Html.CheckBoxFor(m => m.acceptRange,
                        new { id = "AcceptRange", @class = "form-check-input" })
                    <label class="form-check-label fw-bold" for="AcceptRange">
                        @GlobalFeeConfig.EnableRangeBasedFee
                    </label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6>@GlobalFeeConfig.FeeRanges</h6>
                    <button type="button"
                            id="addRangeRowBtn"
                            class="btn btn-sm btn-outline-text-primary">
                        <i class="mdi mdi-plus"></i>
                        @GlobalFeeConfig.AddRow
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">@GlobalShared.Name</th>
                                <th style="width: 20%;">@GlobalFeeConfig.FromAmount</th>
                                <th style="width: 20%;">@GlobalFeeConfig.ToAmount</th>
                                <th style="width: 20%;">@GlobalShared.Fee</th>
                                <th style="width: 15%;">@GlobalShared.Actions</th>
                            </tr>
                        </thead>
                        <tbody id="range-table-body">
                            @if (Model?.feeTypeRanges != null)
                            {
                                for (int i = 0; i < Model.feeTypeRanges.Count; i++)
                                {
                                    @Html.Partial("_DataTable",
                                        Model.feeTypeRanges[i],
                                        new ViewDataDictionary { { "index", i } })
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <hr />

        <!-- BUTTONS -->
        <div class="d-flex justify-content-end">
            <div class="col-12 text-end mt-3">
                @if (string.IsNullOrWhiteSpace(Model?.id))
                {
                    <button id="saveConfigBtn" type="submit"
                            class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-save me-1"></i>
                        @GlobalShared.Save
                    </button>

                    <button type="reset"
                            class="btn btn-outline-secondary shadow-sm px-4">
                        @GlobalShared.Reset
                    </button>
                }
                else
                {
                    <button  type="submit"
                            class="btn btn-primary me-2">
                        @GlobalShared.Update
                    </button>

                    <button type="reset"
                            class="btn btn-outline-secondary shadow-sm px-4">
                        @GlobalShared.Reset
                    </button>
                }
            </div>
        </div>

    </div>
}
