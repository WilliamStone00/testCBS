@model CBS.FrontDesk.Data.Entity.AccountingV2.SharedMonth.MemberShareMonthUpload
@{
    ViewBag.Title = "Shared Month Details";
}

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <!-- Page Header -->
            <div class="card-header text-center bg-light">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-file-cabinet me-2"></i> Share Month Summary
                </h1>
                <p class="card-text text-muted">
                    View, analyze and manage share month summaries efficiently.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div class="text-start">
                        <small class="text-muted">
                            <i class="mdi mdi-calendar me-1"></i> @Model.Month @Model.Date?.ToString("yyyy")
                        </small>
                    </div>
                    <div class="text-end">
                        <small class="text-muted">
                            <i class="mdi mdi-office-building me-1"></i> @Model.BranchName (@Model.BranchCode)
                        </small>
                    </div>
                </div>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>

            <!-- Tips Section -->
            <div class="card mb-2">
                <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                    <span><i class="mdi mdi-lightbulb-on-outline me-2"></i> TIPS</span>
                    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSalarySummaryTips" aria-expanded="false" aria-controls="collapseSalarySummaryTips">
                        <i class="mdi mdi-chevron-down"></i>
                    </button>
                </h6>
                <div id="collapseSalarySummaryTips" class="collapse">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><i class="mdi mdi-file-document-outline text-primary me-2"></i> Use the <strong>"Run Share Month Analysis"</strong> button to analyze uploaded share month data.</li>
                            <li><i class="mdi mdi-eye-outline text-primary me-2"></i> Click the <strong>"View Result Of Analyzed Share Month"</strong> button to check previously analyzed results.</li>
                            <li><i class="mdi mdi-alert-outline text-warning me-2"></i> Ensure all uploaded share month files are accurate and in the correct format (e.g., Excel, CSV).</li>
                            <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Regularly verify analyzed results against records to ensure accuracy.</li>
                            <li><i class="mdi mdi-database-search-outline text-primary me-2"></i> Use search filters to quickly locate specific member share month records.</li>
                            <li><i class="mdi mdi-alert-decagram-outline text-danger me-2"></i> Address anomalies like incorrect amounts or missing records promptly.</li>
                            <li><i class="mdi mdi-pencil-outline text-success me-2"></i> Edit analyzed share month records for corrections or updates when necessary.</li>
                            <li><i class="mdi mdi-delete-outline text-danger me-2"></i> Delete invalid uploads to maintain clean and accurate records.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Section -->
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between"
                        id="accordionPopoutIconThree">
                        <button type="button"
                                class="accordion-button"
                                data-bs-toggle="collapse"
                                data-bs-target="#accordionPopoutIcon-3"
                                aria-expanded="true"
                                aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-chart-bar me-1"></i> Share Month Analysis
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-3">
                                        <div class="card-body d-flex justify-content-end align-items-center">
                                            <a type="button" href="/ShareMonth/UploadedFiles" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View List">
                                                <i class="mdi mdi-view-list mdi-18px"></i> View All Uploads
                                            </a>
                                            <a type="button" href="#" class="btn btn-label-info btn-sm me-2" data-bs-toggle="tooltip" title="Download Report">
                                                <i class="mdi mdi-download mdi-18px"></i> Export
                                            </a>
                                        </div>
                                    </div>

                                    <div id="datalistingview">
                                        <fieldset class="fieldset-custom">
                                            <div class="mb-0 border-2">
                                                <div class="accordion" id="summaryAccordion">
                                                    <!-- Overall Summary Cards -->
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header" id="overallSummaryHeading">
                                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#overallSummary" aria-expanded="true" aria-controls="overallSummary">
                                                                <i class="mdi mdi-chart-pie me-2"></i> Overall Share Month Summary
                                                            </button>
                                                        </h2>
                                                        <div id="overallSummary" class="accordion-collapse collapse show" aria-labelledby="overallSummaryHeading" data-bs-parent="#summaryAccordion">
                                                            <div class="accordion-body">
                                                                <div class="row mb-3">
                                                                    <div class="col-md-4">
                                                                        <div class="card shadow-sm border-0">
                                                                            <div class="card-body text-center">
                                                                                <h6 class="card-title text-primary">Total Members</h6>
                                                                                <p class="card-text fs-4 fw-bold text-info">
                                                                                    @Model.TotalMember.ToString("N0")
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="card shadow-sm border-0">
                                                                            <div class="card-body text-center">
                                                                                <h6 class="card-title text-primary">Total Amount</h6>
                                                                                <p class="card-text fs-4 fw-bold text-success">
                                                                                    @Model.TotalAmount.ToString("N1")
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="card shadow-sm border-0">
                                                                            <div class="card-body text-center">
                                                                                <h6 class="card-title text-primary">Average per Member</h6>
                                                                                <p class="card-text fs-4 fw-bold text-warning">
                                                                                    @if (Model.TotalMember > 0)
                                                                                    {
                                                                                        @((Model.TotalAmount / Model.TotalMember).ToString("N1"))
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <text>0.0</text>
                                                                                    }
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="row mb-3">
                                                                    <div class="col-md-12">
                                                                        <div class="card shadow-sm border-0">
                                                                            <div class="card-header bg-light">
                                                                                <h6 class="card-title mb-0">
                                                                                    <i class="mdi mdi-account-group me-2"></i> Upload Details
                                                                                </h6>
                                                                            </div>
                                                                            <div class="card-body">
                                                                                <div class="row">
                                                                                    <div class="col-md-3">
                                                                                        <p class="mb-1"><strong>Uploaded By:</strong></p>
                                                                                        <p class="text-muted">@Model.UploadedBy</p>
                                                                                    </div>
                                                                                    <div class="col-md-3">
                                                                                        <p class="mb-1"><strong>Upload Date:</strong></p>
                                                                                        <p class="text-muted">@Model.UploadedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                                                                    </div>
                                                                                    <div class="col-md-3">
                                                                                        <p class="mb-1"><strong>File Type:</strong></p>
                                                                                        <p class="text-muted">@Model.FileType</p>
                                                                                    </div>
                                                                                    <div class="col-md-3">
                                                                                        <p class="mb-1"><strong>Month:</strong></p>
                                                                                        <p class="text-muted">@Model.Month @Model.Date?.ToString("yyyy")</p>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="row mb-3">
                                                                    <div class="table-responsive mb-3">
                                                                        @if (Model.Lines != null && Model.Lines.Any())
                                                                        {
                                                                            <div class="card shadow-sm border-0">
                                                                                <div class="card-header bg-light">
                                                                                    <h6 class="card-title mb-0">
                                                                                        <i class="mdi mdi-format-list-bulleted me-2"></i> Member Share Month Details
                                                                                    </h6>
                                                                                </div>
                                                                                <div class="card-body p-0">
                                                                                    <table class="table table-hover" id="myDataTable">
                                                                                        <thead class="table-light">
                                                                                            <tr>
                                                                                                <th>#</th>
                                                                                                <th>Member Reference</th>
                                                                                                <th>Member Name</th>
                                                                                                <th>Share Month Amount</th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody>
                                                                                            @{ int rowNumber = 0; }
                                                                                            @foreach (var line in Model.Lines)
                                                                                            {
                                                                                                rowNumber++;
                                                                                                <tr>
                                                                                                    <td>@rowNumber</td>
                                                                                                    <td>@line.MemberReference</td>
                                                                                                    <td>@line.MemberName</td>
                                                                                                    <td class="fw-bold text-success">@line.Amount.ToString("N1")</td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
                                                                                        <tfoot class="table-light">
                                                                                            <tr>
                                                                                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                                                                                <td class="fw-bold text-success">@Model.TotalAmount.ToString("N1")</td>
                                                                                            </tr>
                                                                                        </tfoot>
                                                                                    </table>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="text-center my-5">
                                                                                <div class="text-muted">
                                                                                    <i class="mdi mdi-file-remove-outline mdi-48px"></i>
                                                                                    <p class="mt-2">No share month records found.</p>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Branch Information -->
                                                    <div class="accordion-item mb-2">
                                                        <h2 class="accordion-header" id="branchSummaryHeading">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#branchSummary" aria-expanded="false" aria-controls="branchSummary">
                                                                <i class="mdi mdi-office-building me-2"></i> Branch Information
                                                            </button>
                                                        </h2>
                                                        <div id="branchSummary" class="accordion-collapse collapse" aria-labelledby="branchSummaryHeading" data-bs-parent="#summaryAccordion">
                                                            <div class="accordion-body">
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="card shadow-sm border-0 h-100">
                                                                            <div class="card-header bg-light">
                                                                                <h6 class="card-title mb-0">Branch Details</h6>
                                                                            </div>
                                                                            <div class="card-body">
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Branch Name:</label>
                                                                                    <p class="text-primary">@Model.BranchName</p>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Branch Code:</label>
                                                                                    <p class="text-muted">@Model.BranchCode</p>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Branch ID:</label>
                                                                                    <p class="text-muted">@Model.BranchId</p>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="card shadow-sm border-0 h-100">
                                                                            <div class="card-header bg-light">
                                                                                <h6 class="card-title mb-0">Upload Summary</h6>
                                                                            </div>
                                                                            <div class="card-body">
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Total Records:</label>
                                                                                    <div class="d-flex align-items-center">
                                                                                        <span class="badge bg-info rounded-pill me-2">@Model.Lines?.Count.ToString() ?? "0"</span>
                                                                                        <span>member records</span>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Total Amount:</label>
                                                                                    <div class="d-flex align-items-center">
                                                                                        <i class="mdi mdi-currency-usd text-success me-2"></i>
                                                                                        <span class="fs-5 fw-bold text-success">@Model.TotalAmount.ToString("N1")</span>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Processing Status:</label>
                                                                                    <div>
                                                                                        <span class="badge bg-success rounded-pill">Completed</span>
                                                                                        <small class="text-muted ms-2">@Model.UploadedAt.ToString("dd MMM yyyy")</small>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#myDataTable').DataTable({
                pageLength: 10,
                responsive: true,
                order: [[0, 'asc']],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records..."
                }
            });
        });
    </script>
}