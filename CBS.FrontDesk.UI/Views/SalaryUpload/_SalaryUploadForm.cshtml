@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier


<fieldset class="fieldset-custom">
    <legend id="select_base">Salary Upload Form</legend>
    <div class="card-body">
        @using (Html.BeginForm("SalaryFile", "SalaryUpload", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
        {
            <div class="row mt-2 gy-4">
                <div class="col-md-12">
                    <label class="form-label">Salary Type:</label>
                    <div class="d-flex align-items-center">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="salaryTypeCivil" name="AddSalaryUploadModelCommand.SalaryType" value="CivilServants" required />
                            <label class="form-check-label" for="salaryTypeCivil">Civil Servants</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="salaryTypePrivate" name="AddSalaryUploadModelCommand.SalaryType" value="PrivateInstitutions" required />
                            <label class="form-check-label" for="salaryTypePrivate">Private Institutions</label>
                        </div>
                        @*<div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="salaryTypeInternal" name="AddSalaryUploadModelCommand.SalaryType" value="InternalStaffs" required />
                            <label class="form-check-label" for="salaryTypeInternal">Internal staff</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="salaryTypeDaily" name="AddSalaryUploadModelCommand.SalaryType" value="DailyServers" required />
                            <label class="form-check-label" for="salaryTypeDaily">Daily Servers</label>
                        </div>*@
                    </div>
                    @Html.ValidationMessageFor(m => m.AddSalaryUploadModelCommand.SalaryType, "", new { @class = "text-danger " })
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        <input type="file" id="file" name="AddSalaryUploadModelCommand.File" class="form-control" required />
                        @Html.ValidationMessageFor(m => m.AddSalaryUploadModelCommand.File, "", new { @class = "text-danger " })
                        <label>Select salary file (Formatted: Matricule, Name, NetSalary)</label>
                    </div>
                </div>


            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">Upload</button>
                <button type="reset" class="btn btn-outline-secondary">Reset</button>
            </div>
        }
    </div>
</fieldset>

