@model CBS.FrontDesk.Data.Entity.SalaryManagement.SalaryUploadModelCarrier
@using Resources

<style>
  .status-pip{display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle}
  .status-pip.online{background:#28a745;box-shadow:0 0 0 2px rgba(40,167,69,.15)}
  .status-pip.offline{background:#6c757d;box-shadow:0 0 0 2px rgba(108,117,125,.15)}

  .truncate{max-width:320px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .truncate-branch{max-width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .truncate-user{max-width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}

  #myDataTable thead th{white-space:nowrap}

  /* Optional: squeeze a bit more on smaller screens */
  @@media (max-width: 1400px){
    .truncate-branch{max-width:100px}
    .truncate-user{max-width:100px}
  }
</style>

<fieldset class="fieldset-custom">
    <div class="mb-3 border-2">
        <div id="datalistingview_inner">
            <div class="table-responsive mb-3">
                @if (Model.FileUploads != null && Model.FileUploads.Any())
                {
                    <table class="table table-hover align-middle" id="myDataTable">
                        <thead class="table-light">
                            <tr>
                                <th>@GlobalSalaryUpload.FileName</th>
                                <th>File Type</th>
                                <th>Branch</th>
                                <th>Visibility</th>
                                <th>@GlobalSalaryUpload.UploadedBy</th>
                                <th>@GlobalSalaryUpload.UploadedOn</th>
                                <th>@GlobalShared.Status</th>
                                <th style="width:1%;">@GlobalShared.Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in Model.FileUploads)
                            {
                                <tr>
                                    <!-- File name (truncated) -->
                                    <td class="truncate" title="@file.FileName">@file.FileName</td>

                                    <!-- File type -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(file.FileType))
                                        {<span class="badge bg-secondary">@file.FileType</span> }
                                    else
                                    { <span class="badge bg-light text-muted">Unknown</span>}
                                    </td>

                                    <!-- Branch -->
                                    <td class="truncate-branch" title="@file.BranchName">
                                        @if (!string.IsNullOrWhiteSpace(file.BranchName))
                                        {<span class="badge bg-label-primary">@file.BranchName</span> }
                                    else
                                    { <span class="badge bg-light text-muted">N/A</span>}
                                    </td>

                                    <!-- Visibility -->
                                    <td>
                                        @if (file.PrivateView)
                                        {
                                            <span class="status-pip offline" title="Private (visible to this branch only)"></span>
                                            <span class="ms-1">Private</span>
                                        }
                                        else
                                        {
                                            <span class="status-pip online" title="Public (visible to other branches)"></span>
                                            <span class="ms-1">Public</span>
                                        }
                                    </td>

                                    <td class="truncate-user" title="@file.UploadedBy">@file.UploadedBy</td>
                                    <td>@file.UploadedOn.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(file.SalaryProcessingStatus))
                                        {<span class="badge bg-info">@file.SalaryProcessingStatus</span> }
                                    else
                                    { <span class="badge bg-secondary">N/A</span>}
                                    </td>

                                    <!-- Actions: condensed dropdown -->
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                @GlobalShared.Action
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="/SalaryUpload/DownloadFile?fileId=@file.Id">
                                                        <i class="fas fa-download me-2"></i>@GlobalShared.Download
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" target="_blank"
                                                       href="/SalaryUpload/Detail?fileUploadid=@file.Id">
                                                        <i class="fas fa-info-circle me-2"></i>@GlobalShared.Details
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="DeleteFileRecord('SalaryUpload','@file.Id','myDataTable','_FileUploadData',0,'datalistingview')">
                                                        <i class="fas fa-trash-alt me-2"></i>@GlobalShared.Delete
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center my-3">
                        <p>@GlobalShared.NoFilesUploadedYet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
