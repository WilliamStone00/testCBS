@model CBS.FrontDesk.Data.Entity.SalaryManagement.FileDetailsDto
@using Resources
<div class="row g-4">
    <!-- File Identity Section -->
    <div class="col-xl-3 col-lg-4 col-md-6">
        <div class="card h-100 border-0 shadow-sm card-hover">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-file-earmark-text text-primary me-2"></i>
                    <h6 class="card-title text-primary mb-0">@GlobalShared.File_Information</h6>
                </div>
                <h5 class="mb-1 text-truncate fw-semibold text-primary" title="@Model.FileName">@(Model.FileName ?? "N/A")</h5>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-primary-emphasis small">@(Model.FileCode ?? "")</span>
                    <span class="badge bg-primary-subtle text-primary">@(Model.FileType ?? "N/A")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Branch Details Section -->
    <div class="col-xl-3 col-lg-4 col-md-6">
        <div class="card h-100 border-0 shadow-sm card-hover">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-building text-primary me-2"></i>
                    <h6 class="card-title text-primary mb-0">@GlobalSalaryUpload.branch_details</h6>
                </div>
                <h5 class="mb-1 text-truncate fw-semibold text-primary" title="@Model.BranchName">@(Model.BranchName ?? "N/A")</h5>
                <div class="text-primary-emphasis small">
                    <i class="bi bi-hash me-1"></i>@(Model.BranchId ?? "")
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Information Section -->
    <div class="col-xl-3 col-lg-4 col-md-6">
        <div class="card h-100 border-0 shadow-sm card-hover">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-cloud-upload text-primary me-2"></i>
                    <h6 class="card-title text-primary mb-0">@GlobalSalaryUpload.upload_details</h6>
                </div>
                <h5 class="mb-1 text-truncate fw-semibold text-primary" title="@Model.UploadedBy">@(Model.UploadedBy ?? "N/A")</h5>
                <div class="text-primary-emphasis small">
                    <i class="bi bi-calendar3 me-1"></i>@(Model.UploadedOn.ToString("dd MMM yyyy"))
                    <span class="mx-1">•</span>
                    <i class="bi bi-clock me-1"></i>@(Model.UploadedOn.ToString("HH:mm"))
                </div>
            </div>
        </div>
    </div>

    <!-- Status & Category Section -->
    <div class="col-xl-3 col-lg-4 col-md-6">
        <div class="card h-100 border-0 shadow-sm card-hover">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-check-circle text-primary me-2"></i>
                    <h6 class="card-title text-primary mb-0">@GlobalShared.Status</h6>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge fs-6 px-3 py-2 @(Model.SalaryProcessingStatus == "Completed" ? "bg-success" : "bg-warning text-dark")">
                        @(Model.SalaryProcessingStatus ?? "Pending")
                    </span>
                    <div class="text-end">
                        <span class="text-primary-emphasis small d-block">@GlobalShared.Category</span>
                        <span class="fw-semibold small text-primary">@(Model.FileCategory ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Metadata Section (if needed) -->
    @if (!string.IsNullOrEmpty(Model.FileType) || !string.IsNullOrEmpty(Model.FileCode))
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm card-hover bg-primary bg-opacity-5">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        @if (!string.IsNullOrEmpty(Model.FileType))
                        {
                            <span class="text-primary-emphasis small">
                                <i class="bi bi-file-earmark me-1"></i>@GlobalShared.Type: <span class="fw-semibold text-primary">@Model.FileType</span>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.FileCode))
                        {
                            <span class="text-primary-emphasis small">
                                <i class="bi bi-upc-scan me-1"></i>@GlobalShared.Code: <span class="fw-semibold text-primary">@Model.FileCode</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card-hover {
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        background: white;
        border-radius: 0.75rem;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.75rem 1.5rem rgba(13, 110, 253, 0.15) !important;
            border-color: rgba(13, 110, 253, 0.2) !important;
        }

    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
        border-radius: 0.5rem;
    }

    .bg-primary {
        background-color: #0d6efd !important;
    }

    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .bg-primary.bg-opacity-5 {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }

    .text-primary-emphasis {
        color: rgba(13, 110, 253, 0.8) !important;
    }

    .fw-semibold {
        font-weight: 600;
    }

    /* Bootstrap Icons */
    @@import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css");
</style>