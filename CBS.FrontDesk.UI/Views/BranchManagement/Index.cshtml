<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewModalLabel">@Model.Branch.BranchCode @Model.Branch.Name Logo preview.</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                @if (Model.Branch.LogoUrl != null)
                {
                    <div class="image-upload-container">
                        <img src="@Model.Branch.LogoUrl" class="img-fluid" alt="Preview Image">
                    </div>
                }
                else
                {
                    <div class="image-upload-container">
                        <img src="@Url.Content(Model.Branch.ImageVirtualPath)" class="img-fluid" alt="Preview Image">
                    </div>
                }

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {@Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Js/Crud/DropDownLoader.js"></script>
}


