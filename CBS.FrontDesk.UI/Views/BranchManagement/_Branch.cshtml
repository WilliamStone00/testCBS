@model CBS.FrontDesk.Data.Entity.Config.BankConfig
@using Resources

<style>
    /* Friendly section headers */
    .section-chip {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .35rem .65rem;
        border-radius: 999px;
        background: rgba(13,110,253,.08);
        color: #0d6efd;
        font-weight: 600
    }

    .section-subtle {
        margin: .35rem 0 0 0;
        color: #6c757d;
        font-size: .875rem
    }

    .section-divider {
        height: 1px;
        background: rgba(0,0,0,.06);
        margin: .75rem 0 1rem 0;
        border: 0
    }

    .section-wrap {
        border-left: 3px solid rgba(13,110,253,.25);
        padding-left: .75rem
    }
</style>

@using (Html.BeginForm("AddOrUpdate", "BranchManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    @Html.AntiForgeryToken()
    <fieldset class="fieldset-custom">
        <legend class="mb-3">
            <span class="section-chip"><i class="bi bi-diagram-3"></i> @GlobalShared.Branch_Information</span>
        </legend>

        <input type="hidden" name="ServiceOption" value="branch" id="ServiceOption" />

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

        <!-- Identity -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-info-circle"></i><span>@GlobalShared.Identity</span></div>
                <div class="section-subtle">@GlobalShared.Branch_Name, @GlobalShared.Code &amp; @GlobalShared.Location.</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.BranchCode, new { @class = "form-control", placeholder = GlobalShared.Branch_Code, id = "BranchCode" })
                            <label>@GlobalShared.Branch_Code</label>
                            @Html.ValidationMessageFor(m => m.Branch.BranchCode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Name, new { @class = "form-control", placeholder = GlobalShared.Branch_Name })
                            <label>@GlobalShared.Branch_Name</label>
                            @Html.ValidationMessageFor(m => m.Branch.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Location, new { @class = "form-control", placeholder = GlobalShared.Location })
                            <label>@GlobalShared.Location</label>
                            @Html.ValidationMessageFor(m => m.Branch.Location, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status & flags -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-toggle2-on"></i><span>@GlobalShared.Status</span></div>
                <div class="section-subtle">@GlobalBranchManagement.Activation_head_office_and_bank_link.</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.Branch.ActiveStatus, new { @class = "form-check-input", id = "ActiveStatusChk" })
                            <label class="form-check-label" for="ActiveStatusChk">@GlobalShared.Active</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.Branch.IsHeadOffice, new { @class = "form-check-input", id = "IsHeadOfficeChk" })
                            <label class="form-check-label" for="IsHeadOfficeChk">@GlobalBranchManagement.Set_as_head_office_branch</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.Branch.IsHavingBank, new { @class = "form-check-input", id = "IsHavingBankChk" })
                            <label class="form-check-label" for="IsHavingBankChk">@GlobalBranchManagement.Is_this_branch_linked_to_any_bank</label>
                        </div>
                    </div>

                 
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-telephone"></i><span>@GlobalShared.Contact</span></div>
                <div class="section-subtle">@GlobalShared.Address, P.O. Box, @GlobalShared.Email, @GlobalShared.Phone &amp; @GlobalShared.WebSite.</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Address, new { @class = "form-control", placeholder = GlobalShared.Address })
                            <label>@GlobalShared.Address</label>
                            @Html.ValidationMessageFor(m => m.Branch.Address, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.PBox, new { @class = "form-control", placeholder = GlobalShared.PBox })
                            <label>@GlobalShared.PBox</label>
                            @Html.ValidationMessageFor(m => m.Branch.PBox, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Email, new { @class = "form-control", placeholder = GlobalShared.Email, type = "email" })
                            <label>@GlobalShared.Email</label>
                            @Html.ValidationMessageFor(m => m.Branch.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Telephone, new { @class = "form-control", placeholder = GlobalShared.Telephone })
                            <label>@GlobalShared.Telephone</label>
                            @Html.ValidationMessageFor(m => m.Branch.Telephone, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.WebSite, new { @class = "form-control", placeholder = GlobalShared.WebSite, type = "url" })
                            <label>@GlobalShared.WebSite</label>
                            @Html.ValidationMessageFor(m => m.Branch.WebSite, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Legal -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-file-text"></i><span>@GlobalShared.Registration &amp; @GlobalShared.Tax</span></div>
                <div class="section-subtle">@GlobalBranchManagement.Legal_identifiers_for_the_branch</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.RegistrationNumber, new { @class = "form-control", placeholder = GlobalShared.Registration_number })
                            <label>@GlobalShared.Registration_number</label>
                            @Html.ValidationMessageFor(m => m.Branch.RegistrationNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.ImmatriculationNumber, new { @class = "form-control", placeholder = GlobalShared.Immatriculation_number })
                            <label>@GlobalShared.Immatriculation_number</label>
                            @Html.ValidationMessageFor(m => m.Branch.ImmatriculationNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.TaxPayerNUmber, new { @class = "form-control", placeholder = GlobalShared.Tax_Payer_Number })
                            <label>@GlobalShared.Tax_Payer_Number</label>
                            @Html.ValidationMessageFor(m => m.Branch.TaxPayerNUmber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Branding & Dates -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-palette"></i><span>@GlobalShared.Branding &amp; @GlobalShared.Dates</span></div>
                <div class="section-subtle">@GlobalBranchManagement.Initials_motto_and_creation_date.</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.BankInitial, new { @class = "form-control", placeholder = GlobalShared.Bank_Initial, id = "BankInitial" })
                            <label>@GlobalShared.Bank_Initial</label>
                            @Html.ValidationMessageFor(m => m.Branch.BankInitial, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.DateOfCreation, new { @class = "form-control", type = "date" })
                            <label>@GlobalShared.Date_of_creation</label>
                            @Html.ValidationMessageFor(m => m.Branch.DateOfCreation, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.Motto, new { @class = "form-control", placeholder = GlobalShared.Motto })
                            <label>@GlobalShared.Motto</label>
                            @Html.ValidationMessageFor(m => m.Branch.Motto, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Head Office -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="px-2 pt-2 section-wrap">
                <div class="section-chip"><i class="bi bi-building"></i><span>@GlobalShared.Head_Office</span></div>
                <div class="section-subtle">@GlobalBranchManagement.Contact_and_address_for_escalations.</div>
            </div>
            <hr class="section-divider" />
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.HeadOfficeTelehoneNumber, new { @class = "form-control", placeholder = GlobalShared.Head_office_telephone_number })
                            <label>@GlobalShared.Head_office_telephone_number</label>
                            @Html.ValidationMessageFor(m => m.Branch.HeadOfficeTelehoneNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.Branch.HeadOfficeAddress, new { @class = "form-control", placeholder = GlobalShared.Head_office_address })
                            <label>@GlobalShared.Head_office_address</label>
                            @Html.ValidationMessageFor(m => m.Branch.HeadOfficeAddress, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="mt-3 d-flex gap-2">
            @if (Model.Branch.Id == null)
            {
                @Html.HiddenFor(m => m.Branch.BankId)
                <button type="submit" class="btn btn-primary">@GlobalShared.Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            {
                @Html.HiddenFor(m => m.Branch.Id)
                <button type="submit" class="btn btn-primary">@GlobalShared.Update</button>
                <input type="hidden" name="Action" value="update" id="Action" />
            }
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
        </div>
    </fieldset>
}

@section Scripts {
    <script>
  (function () {
    // Auto-uppercase BranchCode and BankInitial
    const bc = document.getElementById('BranchCode');
    const bi = document.getElementById('BankInitial');
    [bc, bi].forEach(el => el && el.addEventListener('input', () => el.value = el.value.toUpperCase()));

    // Toggle Bank select visibility based on IsHavingBank
    const chk = document.getElementById('IsHavingBankChk');
    const wrap = document.getElementById('BankSelectWrap');
    const bankSel = document.getElementById('BankId');

    function toggleBank() {
      if (!wrap) return;
      const on = chk?.checked;
      wrap.style.display = on ? '' : 'none';
      if (bankSel) bankSel.disabled = !on;
    }

    if (chk) {
      chk.addEventListener('change', toggleBank);
      // initialize on load
      toggleBank();
    }
  })();
    </script>
}
