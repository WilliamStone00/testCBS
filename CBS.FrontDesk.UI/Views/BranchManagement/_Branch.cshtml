@model CBS.FrontDesk.Data.Entity.Config.BankConfig
@using Resources

@using (Html.BeginForm("AddOrUpdate", "BranchManagement", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
{
    <fieldset class="fieldset-custom">
        <legend>@GlobalBranchManagement.BranchInformation</legend>
        <input type="hidden" name="ServiceOption" value="branch" id="ServiceOption" />

        <div class="row mt-2 gy-4">
            <div class="row mt-2 gy-4">
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.BranchCode, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.BranchCode, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.BranchCode</label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Name, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.BranchName</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Branch.IsHavingBank, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@GlobalBranchManagement.IsThisBranchLinkedToAnyBank</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Branch.ActiveStatus, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@GlobalBranchManagement.Active</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Branch.IsHeadOffice, new { @class = "form-check-input" })
                        <label class="form-check-label" for="isActive">@GlobalBranchManagement.SetAsHeadOfficeBranch</label>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Address, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.Address</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.PBox, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.PBox, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.PBox</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Email, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Email, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.Email</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Location, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.Location</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Telephone, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Telephone, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.Telephone</label>
                    </div>
                </div>
                @*<div class="col-md-6">
            <div class="form-floating form-floating-outline">
                @Html.TextBoxFor(m => m.Branch.Capital, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Branch.Capital, "", new { @class = "text-danger" })
                <label>Capital</label>
            </div>
        </div>*@
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.RegistrationNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.RegistrationNumber, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.RegistrationNumber</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.ImmatriculationNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.ImmatriculationNumber, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.ImmatriculationNumber</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.TaxPayerNUmber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.TaxPayerNUmber, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.TaxPayerNumber</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.PBox, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.PBox, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.BoxCode</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.WebSite, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.WebSite, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.WebSite</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.DateOfCreation, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.DateOfCreation, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.DateOfCreation</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.BankInitial, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.BankInitial, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.BankInitial</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.Motto, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.Motto, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.Motto</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.HeadOfficeTelehoneNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.HeadOfficeTelehoneNumber, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.HeadOfficePhoneNumber</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.Branch.HeadOfficeAddress, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Branch.HeadOfficeAddress, "", new { @class = "text-danger" })
                        <label>@GlobalBranchManagement.HeadOfficeAddress</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            @if (Model.Branch.Id == null)
            {
                @Html.HiddenFor(m => m.Branch.BankId)
            <button type="submit" class="btn btn-primary me-2">@GlobalBranchManagement.Save</button>
                <input type="hidden" name="Action" value="insert" id="Action" />
            }
            else
            { <button type="submit" class="btn btn-primary me-2">@GlobalBranchManagement.Update</button>
                @Html.HiddenFor(m => m.Branch.Id)
                <input type="hidden" name="Action" value="update" id="Action" />
            }
        </div>
    </fieldset>
}
