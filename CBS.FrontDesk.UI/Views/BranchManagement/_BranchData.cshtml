@model CBS.FrontDesk.Data.Entity.Config.BankConfig
<table class="table table-hover" id="myDataTable_Branch">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Tell</th>
            <th>Capital</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Branches)
        {
            <tr>
                <td style="width:55%">@d.Name</td>
                <td style="width:5%">@d.BranchCode</td>
                <td style="width:10%">@d.Telephone</td>
                <td style="width:10%">@d.Capital</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.Id,'datalistingview_Branch','_Branch','get','BranchManagement','branch')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.Name to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.Name" onclick="DeleteRecordDataTable('BranchManagement','@d.Id','myDataTable_Branch','_BranchData',0,'datalistingview_Branch')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

