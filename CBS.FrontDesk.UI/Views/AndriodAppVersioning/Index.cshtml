@{
    ViewBag.Title = "Android Version Management";
}



<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-android me-2"></i> Android Version Management
                </h1>
                <p class="card-text">
                    Manage all Android version releases and configurations. Use the options below to view, add, or update versions.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="card mb-1">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> TIPS</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAndroidTips" aria-expanded="false" aria-controls="collapseAndroidTips">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>
    <div id="collapseAndroidTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Ensure version names follow semantic versioning (e.g., 1.0.0).</li>
                <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> Provide a valid APK URL for downloading the Android app.</li>
                <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> Only authorized personnel can update or remove versions.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card mb-1">
            <div class="card-body d-flex justify-content-end align-items-center">
                <a type="button" onclick="LoadDataGen('AndriodAppVersioning','myDataTable','_Data',0,'versionListing',null,null,'list')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View Versions">
                    <i class="mdi mdi-view-list mdi-18px"></i> View Versions
                </a>
                <a type="button" href="/AndriodAppVersioning" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Version">
                    <i class="mdi mdi-plus mdi-18px"></i> Add Version
                </a>
            </div>
        </div>
        <div id="versionListing">
            @Html.Partial("_Create")
        </div>
    </div>
</div>

<div class="modal fade" id="androidVersionModal" tabindex="-1" aria-labelledby="androidVersionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header p-2">
                <header class="w-100 text-center">
                    <h4 class="text-primary fw-bold mb-1">
                        <i class="mdi mdi-android me-2"></i> ANDROID VERSION DETAILS
                    </h4>
                    <p class="text-muted mb-0">
                        View details and manage Android versions efficiently.
                    </p>
                    <hr style="border: 1px solid rgba(128, 128, 128, 0.5);" />
                </header>
            </div>
            <div class="modal-body p-2">
                <div id="androidVersionContent">
                    <!-- Partial view or dynamic content will be loaded here -->
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>

        function showAndroidVersionDetails(versionId) {
            $('#androidVersionContent').html('<p class="text-center">Loading...</p>');

            $.ajax({
                url: '/AndriodAppVersioning/GetAndroidVersionDetail',
                type: 'GET',
                data: { key: versionId },
                success: function (html) {
                    $('#androidVersionContent').html(html);
                    $('#androidVersionModal').modal('show');
                },
                error: function () {
                    $('#androidVersionContent').html('<p class="text-danger text-center">Error loading version details.</p>');
                    $('#androidVersionModal').modal('show');
                }
            });
        }




        function deleteAndroidVersion(versionId) {
            if (!confirm("Are you sure you want to delete this version? This action cannot be undone.")) {
                return;
            }

            $.ajax({
                url: '/AndriodAppVersioning/Delete',
                type: 'POST',
                data: { key: versionId },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload(); // Refresh the page after successful deletion
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while deleting the version.");
                }
            });
        }
    </script>

}
