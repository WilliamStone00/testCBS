@model List<CBS.FrontDesk.Data.Entity.AndriodApp.AndriodVersionConfiguration>
@using Resources
<fieldset class="fieldset-custom p-3 rounded shadow-sm">
    <legend class="fw-bold text-primary">
        <i class="mdi mdi-android me-2"></i> @AndriodAppVersioning_Data.ANDROIDVERSIONLISTING
    </legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p class="text-muted">@AndriodAppVersioning_Data.NoAndroidVersionsHaveBeenConfigured.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered align-middle" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%;">@AndriodAppVersioning_Data.ApplicationName</th>
                        <th style="width: 10%;">@AndriodAppVersioning_Data.Version</th>
                        <th style="width: 15%;">@AndriodAppVersioning_Data.VersionStatus</th>
                        <th style="width: 25%;">@AndriodAppVersioning_Data.APKURL</th>
                        <th style="width: 10%;">@AndriodAppVersioning_Data.Environment</th>
                        <th style="width: 10%;">@AndriodAppVersioning_Data.AppCode</th>
                        <th style="width: 15%;">@AndriodAppVersioning_Data.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var version in Model)
                    {
                        <tr>
                            <td>@version.AppName</td>
                            <td>@version.Version</td>
                            <td>
                                <span class="badge rounded-pill @(version.VersionStatus == "Deprecated" ? "bg-danger" : "bg-success")">
                                    <i class="mdi mdi-@(version.VersionStatus == "Deprecated" ? "alert-circle-outline" : "check-circle-outline")"></i>
                                    @version.VersionStatus
                                </span>
                            </td>
                            <td>
                                <a href="@version.ApkUrl" target="_blank" class="text-primary"
                                   data-bs-toggle="tooltip" title="@version.ApkUrl">
                                    <i class="mdi mdi-link-variant"></i> @GlobalShared.Download
                                </a>
                            </td>
                            <td>
                                <span class="badge rounded-pill @(version.Environment == "Production" ? "bg-primary" : "bg-secondary")">
                                    @version.Environment
                                </span>
                            </td>
                            <td>@version.AppCode</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">

                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                            onclick="AddORUpdateGen('@version.Id', 'versionListing', '_Create', 'update', 'AndriodAppVersioning', null, null)"
                                            data-bs-toggle="tooltip"
                                            title="Edit @version.AppName">
                                        <i class="mdi mdi-pencil me-1"></i>@GlobalShared.Edit
                                    </button>

                                    <!-- Details Button -->
                                    <!--<button type="button"
                                            class="btn btn-sm btn-outline-info d-flex align-items-center"
                                            onclick="showAndroidVersionDetails('@version.Id')"
                                            data-bs-toggle="tooltip"
                                            title="View Details">
                                        <i class="mdi mdi-information-outline me-1"></i> Details
                                    </button>-->

                                    <!-- Delete Button -->
                                    <!--<button type="button"
                                            class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                            onclick="deleteAndroidVersion('@version.Id')"
                                            data-bs-toggle="tooltip"
                                            title="Delete Version">
                                        <i class="mdi mdi-delete me-1"></i> Delete
                                    </button>-->
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
