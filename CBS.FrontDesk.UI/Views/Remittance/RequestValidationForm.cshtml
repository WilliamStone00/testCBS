@model CBS.FrontDesk.Data.Entity.SavingProducts.ValidationOfRemittanceCommand
    @using Resources
@{
    ViewBag.Title = "Remittance Validation";
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 order-0 order-md-1">
        <div class="card">
            <div id="accordionPopoutIcon" class="accordion mt-3 accordion-popout">
                <div class="accordion-item active">
                    <h2 class="accordion-header text-body d-flex justify-content-between" id="accordionPopoutIconThree">
                        <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionPopoutIcon-3" aria-expanded="true" aria-controls="accordionPopoutIcon-3">
                            <i class="mdi mdi-cash-multiple me-2"></i>
                            @GlobalRemittance.remittance_validation: @Model.Remittance.SourceBranchName.ToUpper()
                        </button>
                    </h2>
                    <div id="accordionPopoutIcon-3" class="accordion-collapse collapse show" data-bs-parent="#accordionPopoutIcon">
                        <div class="accordion-body">
                            <div id="mainviewChange">
                                <div class="change-group">
                                    <div class="card mb-4">
                                        <div class="card-body d-sm-flex d-block">
                                            <div class="row w-100 align-items-center">
                                                <!-- Remittance Status -->
                                                <div class="col-md-6">
                                                    <p class="mb-0">
                                                        <strong>@GlobalRemittance.remittance_status:</strong>
                                                        @if (Model.Remittance.Status == "Approved")
                                                        {
                                                            <span class="badge bg-success">@GlobalShared.Approved</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                                                        }
                                                    </p>
                                                </div>

                                                <!-- List Button -->
                                                <div class="col-md-6 text-end">
                                                    <div class="ms-3">
                                                        <a type="button" href="/Remittance/PendingRequest?branchid=@Model.Remittance.SourceBranchId" class="btn btn-icon btn-label-primary btn-sm btn-fab demo" data-bs-toggle="tooltip" title="@GlobalShared.view_pending_requests.">
                                                            <span class="tf-icons mdi mdi-view-list mdi-18px"></span>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion-body">
                                        <div id="datalistingview">
                                            @Html.Partial("_RequestValidationForm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {@Scripts.Render("~/bundles/jqueryval")
@*<script src="~/Scripts/Js/Crud/DailyTellerAssignation/DailyTellerAssignation.js"></script>*@
}










