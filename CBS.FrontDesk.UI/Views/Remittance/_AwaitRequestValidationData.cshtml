@model List<CBS.FrontDesk.Data.Entity.SavingProducts.Remittance>


<fieldset class="fieldset-custom">
    <legend id="select_base">Pending Remittance Requests</legend>
    @if (Model.Count() == 0)
    {
        <div class="text-center my-3">
            <p>No Pending Remittance Requests Found</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Sender</th>
                        <th>Amount</th>
                        <th>Reference</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Initiated by</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:20%">@d.InitiationDate</td>
                            <td style="width:23%">@d.SenderName</td>
                            <td style="width:8%">@d.Amount.ToString("#,##0.0")</td>
                            <td style="width:16%">@d.TransactionReference</td>
                            <td style="width:10%">@d.TransferType</td>
                            <td style="width:7%">
                                <span class="badge bg-warning text-dark">Pending</span>
                            </td>
                            <td style="width:15%">@d.InitiatedBy</td>
                            <td style="width:10%">
                                <a href="/Remittance/RequestValidationForm?remittanceid=@d.Id" class="btn btn-sm btn-success" data-toggle="tooltip" data-placement="top" title="Validate remittance request.">
                                    Validate
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
