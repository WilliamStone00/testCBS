@model List<CBS.FrontDesk.Data.Entity.SavingProducts.Remittance>
@using Resources

<fieldset class="fieldset-custom">
    <legend id="select_base">@GlobalRemittance.PendingRemittanceRequests</legend>
    @if (Model.Count() == 0)
    {
        <div class="text-center my-3">
            <p>@GlobalRemittance.NoPendingRemittanceRequestsFound</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th>@GlobalRemittance.Date</th>
                        <th>@GlobalRemittance.Sender</th>
                        <th>@GlobalRemittance.Amount</th>
                        <th>@GlobalRemittance.Reference</th>
                        <th>@GlobalRemittance.Type</th>
                        <th>@GlobalShared.Status</th>
                        <th>@GlobalRemittance.InitiatedBy</th>
                        <th>@GlobalShared.Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:20%">@d.InitiationDate</td>
                            <td style="width:23%">@d.SenderName</td>
                            <td style="width:8%">@d.Amount.ToString("#,##0.0")</td>
                            <td style="width:16%">@d.TransactionReference</td>
                            <td style="width:10%">@d.TransferType</td>
                            <td style="width:7%">
                                <span class="badge bg-warning text-dark">@GlobalShared.Pending</span>
                            </td>
                            <td style="width:15%">@d.InitiatedBy</td>
                            <td style="width:10%">
                                <a href="/Remittance/RequestValidationForm?remittanceid=@d.Id" class="btn btn-sm btn-success" data-toggle="tooltip" data-placement="top" title="@GlobalRemittance.ValidateRemittanceRequest.">
                                    @GlobalShared.Validate
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
