@model CBS.FrontDesk.Data.Entity.SavingProducts.Remittance
    @using Resources
@{
    ViewBag.Title = "Remittance Query Overview";
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cash-multiple me-2"></i> @GlobalRemittance.REMITTANCE_QUERY_LOGS
        </h1>
        <p class="card-text">
            @GlobalRemittance.TrackAndAnalyzeRemittanceTransactions.
        </p>
        <hr class="border-secondary" />
    </div>
</div>

<!-- Advanced Filter Panel -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalRemittance.AdvancedRemittanceFilters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" />
                <label class="form-check-label fw-bold" for="byBranch">@GlobalRemittance.FilterByBranch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byStatus" />
                <label class="form-check-label fw-bold" for="byStatus">@GlobalRemittance.FilterByStatus</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" />
                <label class="form-check-label fw-bold" for="byDate">@GlobalRemittance.FilterByDateRange</label>
            </div>
        </div>

        <!-- Branch Filter Section -->
        <div id="branchFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="branchSelection" class="form-label fw-bold">@GlobalRemittance.SelectBranch</label>
                @Html.DropDownListFor(
                    m => m.SourceBranchId,
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "---"+ @GlobalRemittance.SelectBranch +"---",
                    new { @class = "form-control shadow-sm select2", @id = "branchSelection" }
                )
            </div>
        </div>

        <!-- Status Filter Section -->
        <div id="statusFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="remittanceStatus" class="form-label fw-bold">@GlobalRemittance.SelectStatus</label>
                <select id="remittanceStatus" class="form-select shadow-sm">
                    <option value="all" selected>@GlobalRemittance.All</option>
                    <option value="Approved">@GlobalShared.Approved</option>
                    <option value="Pending">@GlobalShared.Pending</option>
                    <option value="Rejected">@GlobalShared.Rejected</option>
                    <option value="Paid">@GlobalRemittance.Paid</option>
                    <option value="Withdrawn">@GlobalRemittance.Withdrawn</option>
                </select>
            </div>
        </div>

        <!-- Date Range Filter Section -->
        <div id="dateRangeSection" class="row mb-3" style="display:none;">
            <div class="col-md-6">
                <label for="dateFrom" class="form-label fw-bold">@GlobalRemittance.DateFrom</label>
                <input type="date" id="dateFrom" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-6">
                <label for="dateTo" class="form-label fw-bold">@GlobalRemittance.DateTo</label>
                <input type="date" id="dateTo" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
        </div>

        <!-- Query Parameter Filters -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="queryParameter" class="form-label fw-bold">@GlobalRemittance.SearchBy:</label>
                <select id="queryParameter" class="form-select shadow-sm">
                    <option value="all" selected>A@GlobalRemittance.ll</option>
                    <option value="sourcebranchid">@GlobalRemittance.SourceBranchID</option>
                    <option value="receivingbranchid">@GlobalRemittance.ReceivingBranchID</option>
                    <option value="accountnumber">@GlobalRemittance.AccountNumber</option>
                    <option value="sendername">@GlobalRemittance.SenderName</option>
                    <option value="receivername">@GlobalRemittance.ReceiverName</option>
                    <option value="transactionreference">@GlobalRemittance.TransactionReference</option>
                    <option value="externalreference">@GlobalRemittance.ExternalReference</option>
                    <option value="sendercni">@GlobalRemittance.SenderCNI</option>
                    <option value="receivercni">@GlobalRemittance.ReceiverCNI</option>
                    <option value="senderphonenumber">@GlobalRemittance.SenderPhoneNumber</option>
                    <option value="receiverphonenumber">@GlobalRemittance.ReceiverPhoneNumber</option>
                    <option value="branchid">@GlobalRemittance.BranchID</option>
                </select>
            </div>
            <div class="col-md-8">
                <label for="queryValue" class="form-label fw-bold">Search Value:</label>
                <input type="text" id="queryValue" class="form-control shadow-sm" placeholder="@GlobalRemittance.EnterSearchValue..." />
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="searchButton" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
            </button>
            <button id="resetButton" class="btn btn-secondary me-2 w-100">
                <i class="mdi mdi-refresh me-1"></i> @GlobalRemittance.ResetFilter
            </button>
            <button id="exportButton" class="btn btn-success w-100">
                <i class="mdi mdi-file-excel me-1"></i> @GlobalShared.Export
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle sections based on checkbox
            $('#byBranch').on('change', function () {
                $('#branchFilterSection').toggle(this.checked);
            });

            $('#byStatus').on('change', function () {
                $('#statusFilterSection').toggle(this.checked);
            });

            $('#byDate').on('change', function () {
                $('#dateRangeSection').toggle(this.checked);
            });
        });
    </script>
    <script src="~/Scripts/Js/Crud/Remittance/RemittanceQuery.js"></script>
}

