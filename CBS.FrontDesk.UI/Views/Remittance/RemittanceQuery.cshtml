@model CBS.FrontDesk.Data.Entity.SavingProducts.Remittance
    @using Resources
@{
    ViewBag.Title = "Remittance Query Overview";
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cash-multiple me-2"></i> @GlobalRemittance.remittance_query_logs
        </h1>
        <p class="card-text">
            @GlobalRemittance.track_and_analyze_remittance_transactions.
        </p>
        <hr class="border-secondary" />
    </div>
</div>

<!-- Advanced Filter Panel -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> @GlobalRemittance.advanced_remittance_filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" />
                <label class="form-check-label fw-bold" for="byBranch">@GlobalShared.Filter_by_Branch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byStatus" />
                <label class="form-check-label fw-bold" for="byStatus">@GlobalShared.Filter_by_status</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" />
                <label class="form-check-label fw-bold" for="byDate">@GlobalShared.Filter_by_Date_Range</label>
            </div>
        </div>

        <!-- Branch Filter Section -->
        <div id="branchFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="branchSelection" class="form-label fw-bold">@GlobalShared.Select_Branch</label>
                @Html.DropDownListFor(
                    m => m.SourceBranchId,
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "---"+ @GlobalShared.Select_Branch +"---",
                    new { @class = "form-control shadow-sm select2", @id = "branchSelection" }
                )
            </div>
        </div>

        <!-- Status Filter Section -->
        <div id="statusFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="remittanceStatus" class="form-label fw-bold">@GlobalShared.Select_status</label>
                <select id="remittanceStatus" class="form-select shadow-sm">
                    <option value="all" selected>@GlobalShared.All</option>
                    <option value="Approved">@GlobalShared.Approved</option>
                    <option value="Pending">@GlobalShared.Pending</option>
                    <option value="Rejected">@GlobalShared.Rejected</option>
                    <option value="Paid">@GlobalShared.Paid</option>
                    <option value="Withdrawn">@GlobalShared.withdrawn</option>
                </select>
            </div>
        </div>

        <!-- Date Range Filter Section -->
        <div id="dateRangeSection" class="row mb-3" style="display:none;">
            <div class="col-md-6">
                <label for="dateFrom" class="form-label fw-bold">@GlobalShared.date_from</label>
                <input type="date" id="dateFrom" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-6">
                <label for="dateTo" class="form-label fw-bold">@GlobalShared.date_to</label>
                <input type="date" id="dateTo" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
        </div>

        <!-- Query Parameter Filters -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="queryParameter" class="form-label fw-bold">@GlobalShared.search_by:</label>
                <select id="queryParameter" class="form-select shadow-sm">
                    <option value="all" selected>A@GlobalRemittance.ll</option>
                    <option value="sourcebranchid">@GlobalShared.source_branch_id</option>
                    <option value="receivingbranchid">@GlobalShared.receiving_branch_id</option>
                    <option value="accountnumber">@GlobalShared.Account_Number</option>
                    <option value="sendername">@GlobalShared.sender_name</option>
                    <option value="receivername">@GlobalShared.Receiver_Name</option>
                    <option value="transactionreference">@GlobalShared.Transaction_Reference</option>
                    <option value="externalreference">@GlobalShared.external_reference</option>
                    <option value="sendercni">@GlobalShared.sender_cni</option>
                    <option value="receivercni">@GlobalShared.receiver_cni</option>
                    <option value="senderphonenumber">@GlobalShared.sender_phone_number</option>
                    <option value="receiverphonenumber">@GlobalShared.receiver_phone_number</option>
                    <option value="branchid">@GlobalShared.Branch_ID</option>
                </select>
            </div>
            <div class="col-md-8">
                <label for="queryValue" class="form-label fw-bold">Search Value:</label>
                <input type="text" id="queryValue" class="form-control shadow-sm" placeholder="@GlobalShared.enter_search_value..." />
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="searchButton" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify me-1"></i> @GlobalShared.Search
            </button>
            <button id="resetButton" class="btn btn-secondary me-2 w-100">
                <i class="mdi mdi-refresh me-1"></i> @GlobalShared.reset_filter
            </button>
            <button id="exportButton" class="btn btn-success w-100">
                <i class="mdi mdi-file-excel me-1"></i> @GlobalShared.Export
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle sections based on checkbox
            $('#byBranch').on('change', function () {
                $('#branchFilterSection').toggle(this.checked);
            });

            $('#byStatus').on('change', function () {
                $('#statusFilterSection').toggle(this.checked);
            });

            $('#byDate').on('change', function () {
                $('#dateRangeSection').toggle(this.checked);
            });
        });
    </script>
    <script src="~/Scripts/Js/Crud/Remittance/RemittanceQuery.js"></script>
}

