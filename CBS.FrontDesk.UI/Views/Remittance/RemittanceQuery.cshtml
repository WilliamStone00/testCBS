@model CBS.FrontDesk.Data.Entity.SavingProducts.Remittance
@{
    ViewBag.Title = "Remittance Query Overview";
}

<!-- Page Header -->
<div class="card bg-light mb-2 shadow-sm">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cash-multiple me-2"></i> REMITTANCE QUERY LOGS
        </h1>
        <p class="card-text">
            Track and analyze remittance transactions, monitor statuses, and review transfer details. This interface allows efficient management of remittance operations with dynamic search filters and exportable reports.
        </p>
        <hr class="border-secondary" />
    </div>
</div>

<!-- Advanced Filter Panel -->
<div class="card shadow p-3 mb-4">
    <h5 class="text-primary mb-3"><i class="mdi mdi-filter-outline me-1"></i> Advanced Remittance Filters</h5>
    <div class="card p-3 mb-3 bg-light">
        <div class="row mb-3">
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byBranch" />
                <label class="form-check-label fw-bold" for="byBranch">Filter By Branch</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byStatus" />
                <label class="form-check-label fw-bold" for="byStatus">Filter By Status</label>
            </div>
            <div class="col-md-4 form-check">
                <input type="checkbox" class="form-check-input" id="byDate" />
                <label class="form-check-label fw-bold" for="byDate">Filter By Date Range</label>
            </div>
        </div>

        <!-- Branch Filter Section -->
        <div id="branchFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="branchSelection" class="form-label fw-bold">Select Branch</label>
                @Html.DropDownListFor(
                    m => m.SourceBranchId,
                    new SelectList(ViewBag.Branches, "Id", "Name"),
                    "--- Select Branch ---",
                    new { @class = "form-control shadow-sm select2", @id = "branchSelection" }
                )
            </div>
        </div>

        <!-- Status Filter Section -->
        <div id="statusFilterSection" class="row mb-3" style="display:none;">
            <div class="col-md-12">
                <label for="remittanceStatus" class="form-label fw-bold">Select Status</label>
                <select id="remittanceStatus" class="form-select shadow-sm">
                    <option value="all" selected>All</option>
                    <option value="Approved">Approved</option>
                    <option value="Pending">Pending</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Paid">Paid</option>
                    <option value="Withdrawn">Withdrawn</option>
                </select>
            </div>
        </div>

        <!-- Date Range Filter Section -->
        <div id="dateRangeSection" class="row mb-3" style="display:none;">
            <div class="col-md-6">
                <label for="dateFrom" class="form-label fw-bold">Date From</label>
                <input type="date" id="dateFrom" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
            <div class="col-md-6">
                <label for="dateTo" class="form-label fw-bold">Date To</label>
                <input type="date" id="dateTo" class="form-control shadow-sm" placeholder="dd/MM/yyyy" />
            </div>
        </div>

        <!-- Query Parameter Filters -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="queryParameter" class="form-label fw-bold">Search By:</label>
                <select id="queryParameter" class="form-select shadow-sm">
                    <option value="all" selected>All</option>
                    <option value="sourcebranchid">Source Branch ID</option>
                    <option value="receivingbranchid">Receiving Branch ID</option>
                    <option value="accountnumber">Account Number</option>
                    <option value="sendername">Sender Name</option>
                    <option value="receivername">Receiver Name</option>
                    <option value="transactionreference">Transaction Reference</option>
                    <option value="externalreference">External Reference</option>
                    <option value="sendercni">Sender CNI</option>
                    <option value="receivercni">Receiver CNI</option>
                    <option value="senderphonenumber">Sender Phone Number</option>
                    <option value="receiverphonenumber">Receiver Phone Number</option>
                    <option value="branchid">Branch ID</option>
                </select>
            </div>
            <div class="col-md-8">
                <label for="queryValue" class="form-label fw-bold">Search Value:</label>
                <input type="text" id="queryValue" class="form-control shadow-sm" placeholder="Enter search value..." />
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-2">
        <div class="col-md-12 d-flex">
            <button id="searchButton" class="btn btn-primary me-2 w-100">
                <i class="mdi mdi-magnify me-1"></i> Search
            </button>
            <button id="resetButton" class="btn btn-secondary me-2 w-100">
                <i class="mdi mdi-refresh me-1"></i> Reset Filter
            </button>
            <button id="exportButton" class="btn btn-success w-100">
                <i class="mdi mdi-file-excel me-1"></i> Export
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle sections based on checkbox
            $('#byBranch').on('change', function () {
                $('#branchFilterSection').toggle(this.checked);
            });

            $('#byStatus').on('change', function () {
                $('#statusFilterSection').toggle(this.checked);
            });

            $('#byDate').on('change', function () {
                $('#dateRangeSection').toggle(this.checked);
            });
        });
    </script>
    <script src="~/Scripts/Js/Crud/Remittance/RemittanceQuery.js"></script>
}
