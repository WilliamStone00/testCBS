
@using Resources

<div class="table-responsive mb-3">
    <table class="table table-hover table-bordered align-middle" id="remittanceDataTable">
        <thead>
            <tr>
                <th>@GlobalShared.Date</th>
                <th>@GlobalShared.sender_name</th>
                <th>@GlobalShared.Receiver_Name</th>
                <th>@GlobalShared.Transaction_Reference</th>
                <th>@GlobalShared.initiating_branch</th>
                <th>@GlobalShared.Receiving_Branch</th>
                <th>@GlobalShared.Amount</th>
                <th>@GlobalShared.Status</th>
                <th>@GlobalShared.Action</th>
            </tr>
        </thead>
    </table>
</div>
