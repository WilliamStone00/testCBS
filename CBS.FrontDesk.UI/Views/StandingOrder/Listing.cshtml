                <div id="soDetailsLoader" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none z-3" style="z-index: 1055;">
                    <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <p class="fw-semibold text-primary">Loading Standing Order details...</p>
                    </div>
                </div>

                <!-- Modal Header -->
                <div class="modal-header border-0">
                    <div class="w-100">
                        <div class="card bg-light mb-2">
                            <div class="card-body text-center">
                                <h1 class="card-title text-primary" id="soDetailsModalLabel">
                                    <i class="mdi mdi-file-document-outline me-2"></i> Standing Order Details
                                </h1>
                                <p class="mb-1 text-muted" id="soDetailsSubtitle">View full standing order information and audit details.</p>
                                <hr style="border: 2px solid rgba(128, 128, 128, 0.35);" />
                            </div>
