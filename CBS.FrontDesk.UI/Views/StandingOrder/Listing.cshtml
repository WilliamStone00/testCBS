@model  CBS.FrontDesk.Data.Entity.SalaryManagement.StandingOrderDataTableQuery
@* create a simple query model OR reuse your existing query *@
@using Resources
@{
    ViewBag.Title = "Standing Orders - Filters";
}

<style>
    .compact .card {
        margin-bottom: .5rem !important
    }

    .compact .card-body {
        padding: .75rem !important
    }

    .compact .card-header {
        padding: .5rem .75rem !important
    }

    .compact .form-label {
        margin-bottom: .2rem !important
    }

    .compact .form-check {
        margin-bottom: 0 !important
    }

    .compact .row.g-1 > [class^="col-"] {
        margin-bottom: .5rem
    }
</style>

<div class="compact">
    @*Header*@
    <div class="row mb-2">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center py-2">
                    <h5 class="card-title text-primary mb-1">
                        <i class="mdi mdi-repeat me-2"></i> Standing Order Management
                    </h5>
                    <p class="card-text small mb-0">
                        Register, review and manage member standing orders (filters + server-side datatable).
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tips -->
    <div class="card mb-2">
        <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
            <span class="small"><i class="mdi mdi-information-outline me-2"></i>Tips</span>
            <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSOTips" aria-expanded="false">
                <i class="mdi mdi-chevron-down"></i>
            </button>
        </h6>
        <div id="collapseSOTips" class="collapse">
            <div class="card-body py-2">
                <ul class="mb-0 small">
                    <li><i class="mdi mdi-check-circle-outline text-success me-2"></i>Use filters to reduce dataset before loading.</li>
                    <li><i class="mdi mdi-filter-outline text-secondary me-2"></i>Dates filter standing orders by start/end date window.</li>
                    <li><i class="mdi mdi-toggle-switch-outline text-info me-2"></i>Active filter helps audit operational standing orders.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm p-2 mb-2">
        <h6 class="text-primary mb-2"><i class="mdi mdi-filter-outline me-1"></i>Filters</h6>

        @using (Html.BeginForm("Index", "StandingOrder", FormMethod.Get, new { id = "soFilterForm", autocomplete = "off" }))
        {
            <div class="card p-3 mb-3 bg-light">

                <!-- ============================= -->
                <!-- ALWAYS VISIBLE SECTION -->
                <!-- ============================= -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Id", "Name"),
                            "--- All Branches ---",
                            new { @class = "form-select form-select-sm select2", id = "BranchId" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Member Reference</label>
                        <input id="MemberId" name="MemberId"
                               class="form-control form-control-sm"
                               placeholder="e.g. 5467" />
                    </div>
                </div>

                <hr />

                <!-- ============================= -->
                <!-- FILTER CHECKBOXES -->
                <!-- ============================= -->
                <div class="row g-2">

                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#MemberNameDiv" id="chkMemberName">
                            <label class="form-check-label small" for="chkMemberName">Member Name</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#SourceAccountTypeDiv" id="chkSource">
                            <label class="form-check-label small" for="chkSource">Source Account Type</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#DestinationAccountTypeDiv" id="chkDestination">
                            <label class="form-check-label small" for="chkDestination">Destination Account Type</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#FrequencyDiv" id="chkFrequency">
                            <label class="form-check-label small" for="chkFrequency">Frequency</label>
                        </div>
                    </div>

                    <div class="col-md-3 mt-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#StatusDiv" id="chkStatus">
                            <label class="form-check-label small" for="chkStatus">Status</label>
                        </div>
                    </div>

                    <div class="col-md-3 mt-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#StartDateDiv" id="chkStartDate">
                            <label class="form-check-label small" for="chkStartDate">Start Date</label>
                        </div>
                    </div>

                    <div class="col-md-3 mt-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input filter-toggle" data-target="#EndDateDiv" id="chkEndDate">
                            <label class="form-check-label small" for="chkEndDate">End Date</label>
                        </div>
                    </div>

                </div>

                <hr />

                <!-- ============================= -->
                <!-- HIDDEN FILTER FIELDS -->
                <!-- ============================= -->
                <!-- Member Name -->
                <div id="MemberNameDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Member Name</label>
                        <input id="MemberName" name="MemberName"
                               class="form-control form-control-sm" />
                    </div>
                </div>

                <!-- Source Account Type -->
                <div id="SourceAccountTypeDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Source Account Type</label>
                        @Html.DropDownList("SourceAccountType",
                            new SelectList(ViewBag.SourceAccountTypes ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Any ---",
                            new { @class = "form-select form-select-sm select2" })
                    </div>
                </div>

                <!-- Destination Account Type -->
                <div id="DestinationAccountTypeDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Destination Account Type</label>
                        @Html.DropDownList("DestinationAccountType",
                            new SelectList(ViewBag.DestinationAccountTypes ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Any ---",
                            new { @class = "form-select form-select-sm select2" })
                    </div>
                </div>

                <!-- Frequency -->
                <div id="FrequencyDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Frequency</label>
                        @Html.DropDownList("Frequency",
                            new SelectList(ViewBag.Frequencies ?? new List<SelectListItem>(), "Value", "Text"),
                            "--- Any ---",
                            new { @class = "form-select form-select-sm select2" })
                    </div>
                </div>

                <!-- Status -->
                <div id="StatusDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Status</label>
                        <select id="IsActive" name="IsActive" class="form-select form-select-sm select2">
                            <option value="">--- Any ---</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <!-- Start Date -->
                <div id="StartDateDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Start Date</label>
                        <input id="StartDate" name="StartDate"
                               type="date"
                               class="form-control form-control-sm" />
                    </div>
                </div>

                <!-- End Date -->
                <div id="EndDateDiv" class="row mt-2 d-none">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">End Date</label>
                        <input id="EndDate" name="EndDate"
                               type="date"
                               class="form-control form-control-sm" />
                    </div>
                </div>

            </div>

            <div class="row mt-2">
                <div class="col-md-12 d-flex gap-2">
                    <button id="applySOFilterBtn" type="button" class="btn btn-primary btn-sm flex-fill">
                        <i class="mdi mdi-magnify"></i> Apply Filter
                    </button>
                    <button id="resetSOFilterBtn" type="button" class="btn btn-secondary btn-sm flex-fill">
                        <i class="mdi mdi-refresh"></i> Reset
                    </button>
                </div>
            </div>
        }
    </div>

