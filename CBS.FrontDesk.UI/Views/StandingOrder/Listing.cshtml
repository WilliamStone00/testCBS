@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
(function($, w){
  'use strict';

  // ===== ROUTES =====
  const dataUrl   = '@Url.Action("LoadStandingOrderData", "StandingOrder")';
  const detailUrl = '@Url.Action("InitializeData", "StandingOrder")';
  const initUrl   = '@Url.Action("InitializeData", "StandingOrder")';
  const exportModalUrl = '@Url.Action("", "StandingOrder")';
  const exportDataUrl = '@Url.Action("ExportStandingOrderData", "StandingOrder")';

  let table = null, tableInitialized = false;
  let exportModal = null;

  function getFilters(){
    const isActiveVal = $('#IsActive').val();
    return {
      Options: {},
      BranchId: $('#BranchId').val() || null,
      MemberId: $.trim($('#MemberId').val()) || null,
      MemberName: $.trim($('#MemberName').val()) || null,
      SourceAccountType: $('#SourceAccountType').val() || null,
      DestinationAccountType: $('#DestinationAccountType').val() || null,
      Frequency: $('#Frequency').val() || null,
      IsActive: isActiveVal === "" ? null : (isActiveVal === "true"),
      StartDate: $('#StartDate').val() || null,
      EndDate: $('#EndDate').val() || null
    };
  }

  function showModalLoading(targetSel){
    const $m = $(targetSel);
    $(`${targetSel} .modal-body`).html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
    (bootstrap.Modal.getInstance($m[0]) || new bootstrap.Modal($m[0], { backdrop: 'static' })).show();
  }

  function loadIntoModal(modalSel, url, data){
    $.get(url, data)
      .done(html => {
        showModalLoading(modalSel);
        $(`${modalSel} .modal-body`).html(html || '<div class="text-center text-muted">No content.</div>');
        if ($.fn.select2){
          try {
            $(`${modalSel} .select2`).each(function(){
              if (!$(this).hasClass('select2-hidden-accessible')){
                $(this).select2({ dropdownParent: $(modalSel) });
              }
            });
          } catch(e){ console.warn('select2 in modal init failed', e); }
        }
      })
      .fail(() => $(`${modalSel} .modal-body`).html('<div class="p-3 text-danger">Unable to load content. Please try again.</div>'));
  }

  function actionButtons(row){
    const id = encodeURIComponent(String(row.Id || row.id || ''));
    const btnId = 'so_act_' + (row.Id || row.id || Math.random().toString(36).slice(2));
    return `
      <div class="dropdown text-center">
        <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="mdi mdi-cog-outline"></i> Actions
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="${btnId}">
          <li><button type="button" class="dropdown-item btn-so-detail" data-id="${id}">
            <i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
          <li><button type="button" class="dropdown-item btn-so-edit" data-id="${id}">
            <i class="mdi mdi-pencil-outline me-1 text-info"></i> Edit</button></li>
        </ul>
      </div>`;
  }

  function initDataTable(){
    const selector = '#myDataTable';
    if ($.fn.DataTable.isDataTable(selector)){
      try { $(selector).DataTable().destroy(); } catch(e){ console.warn('destroy failed', e); }
      $(selector + ' tbody').empty();
    }

    table = $(selector).DataTable({
      serverSide: true,
      processing: false,
      responsive: true,
      autoWidth: false,
      pageLength: 10,
      order: [[0, 'desc']],
      columnDefs: [
        { targets: 0, width: '14%' }, // CreatedDate
        { targets: 1, width: '12%' }, // MemberId
        { targets: 2, width: '18%' }, // MemberName
        { targets: 3, width: '12%', className: 'text-end' }, // Amount
        { targets: 4, width: '12%' }, // Source
        { targets: 5, width: '12%' }, // Dest
        { targets: 6, width: '10%' }, // Frequency
        { targets: 7, width: '10%' }, // Status
        { targets: 8, width: '10%', className: 'text-end', orderable: false, searchable: false } // Actions
      ],
      ajax: {
        url: dataUrl,
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: function(d){
          const filters = getFilters();
          filters.Options = {
            draw: d.draw,
            start: d.start,
            length: d.length,
            skip: d.start,
            pageSize: d.length,
            searchValue: d.search?.value || '',
            sortColumnName: '',
            sortColumnDirection: ''
          };
          return JSON.stringify(filters);
        },
        dataSrc: function(json){
          if (!json) return [];
          if (Array.isArray(json.data)) return json.data;
          if (Array.isArray(json.result)) return json.result;
          if (Array.isArray(json.items)) return json.items;
          for (var k in json){ if (Array.isArray(json[k])) return json[k]; }
          return [];
        },
        error: function(){
          $(selector + ' tbody').html('<tr><td colspan="9" class="text-center text-danger">Failed to load data.</td></tr>');
        }
      },
      columns: [
        {
          data: 'CreatedDate', name: 'CreatedDate',
          render: function(data, type, row){
            const v = row.CreatedDate || row.createdDate;
            return v ? (window.moment ? moment(v).format('DD/MM/YYYY HH:mm:ss') : v) : '-';
          }
        },
        { data: 'MemberId', name: 'MemberId', render: (d,t,row) => row.MemberId || row.memberId || '' },
        { data: 'MemberName', name: 'MemberName', render: (d,t,row) => row.MemberName || row.memberName || '' },
        {
          data: 'Amount', name: 'Amount', className: 'text-end',
          render: function(d,t,row){
            const amt = row.Amount ?? row.amount ?? 0;
            return (window.formatCurrency ? formatCurrency(amt) : amt);
          }
        },
        { data: 'SourceAccountType', name: 'SourceAccountType', render: (d,t,row) => row.SourceAccountType || row.sourceAccountType || '' },
        { data: 'DestinationAccountType', name: 'DestinationAccountType', render: (d,t,row) => row.DestinationAccountType || row.destinationAccountType || '' },
        { data: 'Frequency', name: 'Frequency', render: (d,t,row) => row.Frequency || row.frequency || '' },
        {
          data: 'IsActive', name: 'IsActive',
          render: function(d,t,row){
            const active = (row.IsActive ?? row.isActive) === true;
            return active
              ? '<span class="badge bg-success">Active</span>'
              : '<span class="badge bg-secondary">Inactive</span>';
          }
        },
        { data: null, orderable:false, searchable:false, className:'text-end', render: (d,t,row) => actionButtons(row) }
      ],
      language: { emptyTable: 'No standing orders found' }
    });

    tableInitialized = true;
  }

  function reloadTable(){
    if (!tableInitialized){
      if ($('#myDataTable').length === 0){ console.error('myDataTable markup missing. Ensure _DataStandingOrders partial is present.'); return; }
      initDataTable();
    } else if (table && table.ajax){
      table.ajax.reload(null, false);
    }
  }

  // ========== EXPORT FUNCTIONALITY ==========
    // Helper function to check if Alertify is available
    function initExportModal() {
        if (!exportModal) {
            const modalEl = document.getElementById('exportModal');
            if (modalEl) {
                exportModal = new bootstrap.Modal(modalEl, {
                    backdrop: 'static',
                    keyboard: false
                });
            }
        }
    }

    function resetExportButton($btn, originalText) {
        $btn.html(originalText).prop('disabled', false);
        $('#exportProgress .progress-bar').css('width', '0%');
        $('#exportProgress').addClass('d-none');
    }

    function showExportWarning(message) {
        appalert(message, 2, 1); // Using warning state (2) for warnings
    }

    function showExportError(message) {
        appalert(message, 2, 1); // Using warning state (2) for errors
    }

    function showExportSuccess(message) {
        appalert(message, 1, 1); // Using success state (1) for success
    }

    // Handle export button click
    $(document).on('click', '#btnExportSO', function () {
        // Check if table is initialized and has data
        if (!tableInitialized) {
            showExportWarning('Please load the table data first by clicking "Apply Filter" before exporting.');
            return;
        }

        // Check if table has data
        if (table && table.data() && table.data().count() === 0) {
            showExportWarning('No data available to export. Please apply filters to load data first.');
            return;
        }

        // Load export modal content
        $.get(exportModalUrl, function (html) {
            // Remove existing modal if any
            $('#exportModal').remove();

            // Append new modal to body
            $('body').append(html);

            // Initialize modal
            initExportModal();

            // Show modal
            exportModal.show();
        }).fail(function (xhr, status, error) {
            console.error('Failed to load export modal:', error);
            showExportError('Failed to load export options. Please try again.');
        });
    });

    // Handle export confirmation
    $(document).on('click', '#btnConfirmExport', function () {
        const $btn = $(this);
        const originalText = $btn.html();

        // Get all data from DataTable (including paginated)
        let tableData = [];
        let totalRecords = 0;

        if (table && table.rows) {
            // Get all data from the table (across all pages)
            tableData = table.rows({ search: 'applied' }).data().toArray();
            totalRecords = table.data().count();
        }

        if (!tableData || tableData.length === 0) {
            showExportWarning('No data available to export. Please apply filters to load data first.');
            return;
        }

        // Get export options
        const exportOptions = {
            fileName: $('#fileName').val() || 'StandingOrders_Report',
            format: $('#exportFormat').val(),
            startDate: $('#startDate').val(),
            endDate: $('#endDate').val(),
            includeSummary: $('#includeSummary').is(':checked'),
            exportType: $('#exportType').val()
        };

        // Prepare request
        const request = {
            Data: tableData,
            TotalRecords: totalRecords,
            ExportOptions: exportOptions
        };

        // Show progress
        $('#exportProgress').removeClass('d-none');
        $btn.html('<span class="spinner-border spinner-border-sm me-1"></span> Exporting...').prop('disabled', true);

        // Make export request
        $.ajax({
            url: exportDataUrl,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(request),
            xhr: function () {
                var xhr = new window.XMLHttpRequest();
                xhr.addEventListener('progress', function (evt) {
                    if (evt.lengthComputable) {
                        var percentComplete = Math.round(evt.loaded / evt.total * 100);
                        $('#exportProgress .progress-bar').css('width', percentComplete + '%');
                        $('#progressText').text('Exporting... ' + percentComplete + '%');
                    }
                }, false);
                return xhr;
            },
            success: function (response, status, xhr) {
                // Check if response is a file (binary) or JSON error
                const contentType = xhr.getResponseHeader('Content-Type') || '';

                if (contentType.includes('application/json')) {
                    // This is an error response
                    if (response.success === false) {
                        showExportError(response.message || 'Unknown error occurred');
                    } else {
                        showExportError('Unexpected response format');
                    }
                    resetExportButton($btn, originalText);
                    return;
                }

                if (contentType.includes('application/vnd.openxmlformats-officedocument')) {
                    // Handle file download
                    const blob = new Blob([response], {
                        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = exportOptions.fileName + '_' + new Date().toISOString().slice(0, 10) + '.xlsx';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    // Close modal
                    if (exportModal) {
                        exportModal.hide();
                    }

                    showExportSuccess('Your file has been downloaded successfully.');
                } else {
                    showExportError('Unexpected response type: ' + contentType);
                }
            },
            error: function (xhr, status, error) {
                console.error('Export error:', error);
                let errorMsg = 'An error occurred during export. Please try again.';

                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.message) {
                        errorMsg = response.message;
                    }
                } catch (e) {
                    // Not JSON, use default message
                }

                showExportError(errorMsg);
            },
            complete: function () {
                resetExportButton($btn, originalText);
            }
        });
    });

    // Handle export type change
    $(document).on('change', '#exportType', function () {
        if ($(this).val() === 'all') {
            appalert('This will export all standing orders regardless of current filters. This may take longer if there are many records.', 3, 1); // Info state (3)
        }
    });

    // Handle date range validation
    $(document).on('change', '#startDate, #endDate', function () {
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        if (startDate && endDate && startDate > endDate) {
            appalert('Start date cannot be after end date.', 2, 1); // Warning state (2)
            $(this).val('');
        }
    });

    // Handle format change
    $(document).on('change', '#exportFormat', function () {
        const format = $(this).val();
        if (format === 'pdf') {
            appalert('PDF export will include formatted tables and summaries.', 3, 1); // Info state (3)
        }
    });
  // ========== END EXPORT FUNCTIONALITY ==========

  $(function(){
    if ($.fn.select2){
      try { $('.select2').select2({ width:'100%' }); } catch(e){ console.warn('select2 init failed', e); }
    }

    $('#applySOFilterBtn').on('click', function(e){ e.preventDefault(); reloadTable(); });

    $('#resetSOFilterBtn').on('click', function(){
      const $f = $('#soFilterForm'); if ($f.length) $f[0].reset();
      if ($.fn.select2){ try { $('.select2').val(null).trigger('change'); } catch(_){} }
      reloadTable();
    });

    $('#soFilterForm').on('keypress', 'input,select', function(e){
      if (e.which === 13){ e.preventDefault(); reloadTable(); }
    });

    // Actions
    $(document).on('click', '#btnCreateSO', function(){
        loadIntoModal('#soEditModal', initUrl, { KEY: '', partialView:'_StandingOrderForm', path:'new', serviceOption:'StandingOrder' });
    });

    $('#datalistingview').on('click', '.btn-so-detail', function(){
      const id = $(this).data('id'); if (!id) return;
        loadIntoModal('#soDetailsModal', detailUrl, { KEY: id, partialView:'_StandingOrderDetailsPartial' });
    });

    $('#datalistingview').on('click', '.btn-so-edit', function(){
      const id = $(this).data('id'); if (!id) return;
        loadIntoModal('#soEditModal', initUrl, { KEY: id, partialView:'_StandingOrderForm', path:'get', serviceOption:'StandingOrder' });
    });
  });

  $(document).ready(function () {
    $(".filter-toggle").change(function () {
      var target = $(this).data("target");

      if ($(this).is(":checked")) {
        $(target).removeClass("d-none");
      } else {
        $(target).addClass("d-none");

        // Clear values when unchecked
        $(target).find("input").val("");
        $(target).find("select").val("").trigger("change");
      }
    });
  });
})(jQuery, window);
    </script>
}