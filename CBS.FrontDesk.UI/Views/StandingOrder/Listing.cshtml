@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
(function($, w){
  'use strict';

  // ===== ROUTES =====
  const dataUrl   = '@Url.Action("LoadStandingOrderData", "StandingOrder")';
  const detailUrl = '@Url.Action("InitializeData", "StandingOrder")';
  const initUrl   = '@Url.Action("InitializeData", "StandingOrder")';
  const exportModalUrl = '@Url.Action("GetExportModal", "StandingOrder")';
  const exportDataUrl = '@Url.Action("ExportStandingOrderData", "StandingOrder")';

  let table = null, tableInitialized = false;
  let exportModal = null;

  // Alertify helper functions
  function isAlertifyAvailable() {
    return typeof alertify !== 'undefined' && alertify;
  }

  function initAlertify() {
    if (!isAlertifyAvailable()) return;

    alertify.defaults = alertify.defaults || {};
    alertify.defaults.notifier = {
      delay: 5,
      position: 'top-right',
      closeButton: true
    };

    alertify.defaults.glossary = {
      ok: 'OK',
      cancel: 'Cancel'
    };
  }

  // Call init on document ready
  $(document).ready(function() {
    initAlertify();
  });

  function showExportWarning(message) {
    if (isAlertifyAvailable()) {
      alertify.warning(message, 5);
    } else if (typeof appalert === 'function') {
      appalert(message, 2, 'warning');
    } else {
      console.warn('Export warning:', message);
    }
  }

  function showExportError(message) {
    if (isAlertifyAvailable()) {
      alertify.error(message, 5);
    } else if (typeof appalert === 'function') {
      appalert(message, 4, 'danger');
    } else {
      console.error('Export error:', message);
    }
  }

  function showExportSuccess(message) {
    if (isAlertifyAvailable()) {
      alertify.success(message, 3);
    } else if (typeof appalert === 'function') {
      appalert(message, 1, 'success');
    } else {
      console.log('Export success:', message);
    }
  }

  function showExportInfo(message) {
    if (isAlertifyAvailable()) {
      alertify.message(message, 4);
    } else if (typeof appalert === 'function') {
      appalert(message, 3, 'info');
    } else {
      console.info('Export info:', message);
    }
  }

  function showExportConfirm(message, onConfirm, onCancel) {
    if (isAlertifyAvailable()) {
      alertify.confirm(
        'Confirm Export',
        message,
        function() {
          if (onConfirm) onConfirm();
        },
        function() {
          if (onCancel) onCancel();
        }
      ).set('labels', {ok: 'Yes, Export', cancel: 'Cancel'});
    } else {
      if (confirm(message)) {
        if (onConfirm) onConfirm();
      } else {
        if (onCancel) onCancel();
      }
    }
  }

  function getFilters(){
    const isActiveVal = $('#IsActive').val();
    return {
      Options: {},
      BranchId: $('#BranchId').val() || null,
      MemberId: $.trim($('#MemberId').val()) || null,
      MemberName: $.trim($('#MemberName').val()) || null,
      SourceAccountType: $('#SourceAccountType').val() || null,
      DestinationAccountType: $('#DestinationAccountType').val() || null,
      Frequency: $('#Frequency').val() || null,
      IsActive: isActiveVal === "" ? null : (isActiveVal === "true"),
      StartDate: $('#StartDate').val() || null,
      EndDate: $('#EndDate').val() || null
    };
  }

  function showModalLoading(targetSel){
    const $m = $(targetSel);
    if (!$m.length) return;

    $(`${targetSel} .modal-body`).html('<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>');
    const modal = bootstrap.Modal.getInstance($m[0]);
    if (modal) {
      modal.show();
    } else {
      new bootstrap.Modal($m[0], { backdrop: 'static' }).show();
    }
  }

  function loadIntoModal(modalSel, url, data){
    $.get(url, data)
      .done(html => {
        const $modalBody = $(`${modalSel} .modal-body`);
        if ($modalBody.length) {
          $modalBody.html(html || '<div class="text-center text-muted">No content.</div>');
        }

        if ($.fn.select2){
          try {
            $(`${modalSel} .select2`).each(function(){
              if (!$(this).hasClass('select2-hidden-accessible')){
                $(this).select2({ dropdownParent: $(modalSel) });
              }
            });
          } catch(e){ console.warn('select2 in modal init failed', e); }
        }

        const modal = bootstrap.Modal.getInstance($(modalSel)[0]);
        if (modal) modal.show();
      })
      .fail(() => {
        const $modalBody = $(`${modalSel} .modal-body`);
        if ($modalBody.length) {
          $modalBody.html('<div class="p-3 text-danger">Unable to load content. Please try again.</div>');
        }
      });
  }

  function actionButtons(row){
    const id = encodeURIComponent(String(row.Id || row.id || ''));
    const btnId = 'so_act_' + (row.Id || row.id || Math.random().toString(36).slice(2));
    return `
      <div class="dropdown text-center">
        <button class="btn btn-sm btn-info dropdown-toggle text-white" type="button" id="${btnId}" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="mdi mdi-cog-outline"></i> Actions
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="${btnId}">
          <li><button type="button" class="dropdown-item btn-so-detail" data-id="${id}">
            <i class="mdi mdi-eye me-1 text-primary"></i> Details</button></li>
          <li><button type="button" class="dropdown-item btn-so-edit" data-id="${id}">
            <i class="mdi mdi-pencil-outline me-1 text-info"></i> Edit</button></li>
        </ul>
      </div>`;
  }

  function initDataTable(){
    const selector = '#myDataTable';
    if ($.fn.DataTable.isDataTable(selector)){
      try { $(selector).DataTable().destroy(); } catch(e){ console.warn('destroy failed', e); }
      $(selector + ' tbody').empty();
    }

    table = $(selector).DataTable({
      serverSide: true,
      processing: false,
      responsive: true,
      autoWidth: false,
      pageLength: 10,
      order: [[0, 'desc']],
      columnDefs: [
        { targets: 0, width: '14%' }, // CreatedDate
        { targets: 1, width: '12%' }, // MemberId
        { targets: 2, width: '18%' }, // MemberName
        { targets: 3, width: '12%', className: 'text-end' }, // Amount
        { targets: 4, width: '12%' }, // Source
        { targets: 5, width: '12%' }, // Dest
        { targets: 6, width: '10%' }, // Frequency
        { targets: 7, width: '10%' }, // Status
        { targets: 8, width: '10%', className: 'text-end', orderable: false, searchable: false } // Actions
      ],
      ajax: {
        url: dataUrl,
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: function(d){
          const filters = getFilters();
          filters.Options = {
            draw: d.draw,
            start: d.start,
            length: d.length,
            skip: d.start,
            pageSize: d.length,
            searchValue: d.search?.value || '',
            sortColumnName: '',
            sortColumnDirection: ''
          };
          return JSON.stringify(filters);
        },
        dataSrc: function(json){
          if (!json) return [];
          if (Array.isArray(json.data)) return json.data;
          if (Array.isArray(json.result)) return json.result;
          if (Array.isArray(json.items)) return json.items;
          for (var k in json){ if (Array.isArray(json[k])) return json[k]; }
          return [];
        },
        error: function(){
          $(selector + ' tbody').html('<tr><td colspan="9" class="text-center text-danger">Failed to load data.</td></tr>');
        }
      },
      columns: [
        {
          data: 'CreatedDate', name: 'CreatedDate',
          render: function(data, type, row){
            const v = row.CreatedDate || row.createdDate;
            return v ? (window.moment ? moment(v).format('DD/MM/YYYY HH:mm:ss') : v) : '-';
          }
        },
        { data: 'MemberId', name: 'MemberId', render: (d,t,row) => row.MemberId || row.memberId || '' },
        { data: 'MemberName', name: 'MemberName', render: (d,t,row) => row.MemberName || row.memberName || '' },
        {
          data: 'Amount', name: 'Amount', className: 'text-end',
          render: function(d,t,row){
            const amt = row.Amount ?? row.amount ?? 0;
            return (window.formatCurrency ? formatCurrency(amt) : amt);
          }
        },
        { data: 'SourceAccountType', name: 'SourceAccountType', render: (d,t,row) => row.SourceAccountType || row.sourceAccountType || '' },
        { data: 'DestinationAccountType', name: 'DestinationAccountType', render: (d,t,row) => row.DestinationAccountType || row.destinationAccountType || '' },
        { data: 'Frequency', name: 'Frequency', render: (d,t,row) => row.Frequency || row.frequency || '' },
        {
          data: 'IsActive', name: 'IsActive',
          render: function(d,t,row){
            const active = (row.IsActive ?? row.isActive) === true;
            return active
              ? '<span class="badge bg-success">Active</span>'
              : '<span class="badge bg-secondary">Inactive</span>';
          }
        },
        { data: null, orderable:false, searchable:false, className:'text-end', render: (d,t,row) => actionButtons(row) }
      ],
      language: { emptyTable: 'No standing orders found' }
    });

    tableInitialized = true;
  }

      function reloadTable(){
        if (!tableInitialized){
          if ($('#myDataTable').length === 0){ console.error('myDataTable markup missing. Ensure _DataStandingOrders partial is present.'); return; }
          initDataTable();
        } else if (table && table.ajax){
          table.ajax.reload(null, false);
        }
      }

    // ========== EXPORT FUNCTIONALITY ==========

    function initExportModal() {
        const modalEl = document.getElementById('exportModal');
        if (modalEl && !exportModal) {
            exportModal = new bootstrap.Modal(modalEl, {
                backdrop: 'static',
                keyboard: false
            });
        }
        return exportModal;
    }

    function resetExportButton($btn, originalText) {
        if ($btn && $btn.length) {
            $btn.html(originalText).prop('disabled', false);
        }
        $('#exportProgress .progress-bar').css('width', '0%');
        $('#exportProgress').addClass('d-none');
        $('#progressText').text('Preparing export...');
    }

    function performExport($btn, originalText, tableData, totalRecords) {
        // Get export options
        const exportOptions = {
            fileName: $('#fileName').val() || 'StandingOrders_Report',
            format: $('#exportFormat').val(),
            startDate: $('#startDate').val(),
            endDate: $('#endDate').val(),
            includeSummary: $('#includeSummary').is(':checked'),
            exportType: $('#exportType').val()
        };

        // Prepare request
        const request = {
            Data: tableData,
            TotalRecords: totalRecords,
            ExportOptions: exportOptions
        };

        // Show progress
        $('#exportProgress').removeClass('d-none');
        $('#exportProgress .progress-bar').css('width', '0%');
        $('#progressText').text('Starting export...');

        if ($btn && $btn.length) {
            $btn.html('<span class="spinner-border spinner-border-sm me-1"></span> Exporting...').prop('disabled', true);
        }

        appalert('Export started. Please wait...', 3, 'info');

        // SIMULATED PROGRESS - This will show smooth progress while server processes
        let simulatedProgress = 0;
        const progressInterval = setInterval(() => {
            if (simulatedProgress < 90) { // Cap at 90% until actual response
                // Increment by random amount but slow down as we approach 90
                const increment = Math.max(1, Math.random() * (10 - simulatedProgress / 10));
                simulatedProgress = Math.min(90, simulatedProgress + increment);

                // Update progress bar with smooth animation
                $('#exportProgress .progress-bar').css('width', simulatedProgress + '%');

                // Update text with different messages based on progress
                let message = '';
                if (simulatedProgress < 30) {
                    message = 'Preparing data...';
                } else if (simulatedProgress < 60) {
                    message = 'Processing records...';
                } else if (simulatedProgress < 85) {
                    message = 'Generating file...';
                } else {
                    message = 'Finalizing...';
                }

                $('#progressText').text(`${message} ${Math.round(simulatedProgress)}%`);
            }
        }, 300); // Update every 300ms for smooth animation

        // Make export request
        $.ajax({
            url: exportDataUrl,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(request),
            xhrFields: {
                responseType: 'blob'
            },
            xhr: function () {
                var xhr = new window.XMLHttpRequest();
                // Keep the actual download progress for the final 10-100%
                xhr.addEventListener('progress', function (evt) {
                    if (evt.lengthComputable) {
                        // Calculate overall progress: 90% simulated + 10% download
                        const simulatedPart = 90; // Simulated progress capped at 90%
                        const downloadPart = 10; // Remaining 10% for download

                        // Calculate download percentage of the final 10%
                        const downloadPercent = Math.round(evt.loaded / evt.total * 100);
                        const totalPercent = simulatedPart + (downloadPart * downloadPercent / 100);

                        // Clear the simulated interval and use real progress for final stage
                        clearInterval(progressInterval);

                        // Update with real progress
                        $('#exportProgress .progress-bar').css('width', totalPercent + '%');
                        $('#progressText').text(`Downloading file... ${Math.round(totalPercent)}%`);
                    }
                }, false);
                return xhr;
            },
            success: function (response, status, xhr) {
                // Clear the simulated progress interval
                clearInterval(progressInterval);

                // Set to 100% complete
                $('#exportProgress .progress-bar').css('width', '100%');
                $('#progressText').text('Complete! Preparing download...');

                const contentType = xhr.getResponseHeader('Content-Type') || '';

                if (contentType.includes('application/json')) {
                    const reader = new FileReader();
                    reader.onload = function () {
                        try {
                            const jsonResponse = JSON.parse(reader.result);
                            appalert(jsonResponse.message || 'Export failed', 0, 'danger');
                        } catch (e) {
                            appalert('An error occurred during export', 0, 'danger');
                        }
                        resetExportButton($btn, originalText);
                    };
                    reader.readAsText(response);
                    return;
                }

                // Small delay to show 100% completion
                setTimeout(() => {
                    // Get filename from Content-Disposition
                    let fileName = getFileNameFromContentDisposition(xhr);
                    if (!fileName) {
                        const fileExtension = exportOptions.format === 'csv' ? 'csv' :
                            exportOptions.format === 'pdf' ? 'pdf' : 'xlsx';
                        fileName = `${exportOptions.fileName}_${new Date().toISOString().slice(0, 10)}.${fileExtension}`;
                    }

                    // Create download link
                    const url = window.URL.createObjectURL(response);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();

                    setTimeout(() => {
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                    }, 100);

                    // Close modal
                    if (exportModal) {
                        exportModal.hide();
                    }

                    const recordCount = exportOptions.exportType === 'all' ? 'all' : tableData.length;
                    appalert(`Successfully exported ${recordCount} records.`, 1, 'success');
                    resetExportButton($btn, originalText);
                }, 500); // Half second delay to show 100%
            },
            error: function (xhr, status, error) {
                // Clear the simulated progress interval
                clearInterval(progressInterval);

                console.error('Export error:', error);

                if (xhr.responseText) {
                    try {
                        // Try to parse as JSON first
                        const response = JSON.parse(xhr.responseText);
                        appalert(response.message || 'An error occurred during export', 0, 'danger');
                    } catch (e) {
                        // If not JSON, check if it's HTML or text
                        if (xhr.responseText.trim().startsWith('<!DOCTYPE') || xhr.responseText.trim().startsWith('<html')) {
                            appalert('Server error occurred. Please check logs.', 0, 'danger');
                        } else {
                            appalert(xhr.responseText || 'An error occurred during export. Please try again.', 0, 'danger');
                        }
                    }
                } else {
                    appalert('An error occurred during export. Please try again.', 0, 'danger');
                }

                resetExportButton($btn, originalText);
            },
            complete: function () {
                // Ensure interval is cleared even if something else happens
                clearInterval(progressInterval);
            }
        });
    }

    function getFileNameFromContentDisposition(xhr) {
        const contentDisposition = xhr.getResponseHeader('Content-Disposition');
        if (contentDisposition) {
            const filenameMatch = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
            if (filenameMatch && filenameMatch[1]) {
                return filenameMatch[1].replace(/['"]/g, '');
            }
        }
        return null;
    }

    // Handle export button click - Use generic ShowModal
    $(document).on('click', '#btnExportSO', function () {

        // Optional: keep your table validation if needed
        if (!tableInitialized) {
            appalert('Please load the table data first by clicking "Apply Filter" before exporting.', 2, 'warning');
            return;
        }

        const hasData = table && table.rows && table.rows().count() > 0;
        if (!hasData) {
            appalert('No data available to export. Please apply filters to load data first.', 2, 'warning');
            return;
        }

        // 🔥 Just call your generic modal loader
        ShowModal('', '_ExportStandingOrder', 'StandingOrder', 'ExportStandingOrder');

    });


    // Handle export confirmation
    $(document).on('click', '#btnConfirmExport', function () {
        const $btn = $(this);
        const originalText = $btn.html();

        // Get data from DataTable
        let tableData = [];
        let totalRecords = 0;

        if (table && table.rows) {
            const exportType = $('#exportType').val();

            if (exportType === 'filtered') {
                tableData = table.rows({ search: 'applied' }).data().toArray();
                totalRecords = table.data().count();
            } else {
                tableData = table.rows().data().toArray();
                totalRecords = tableData.length;
            }
        }

        if (!tableData || tableData.length === 0) {
            appalert('No data available to export. Please apply filters to load data first.', 2, 'warning');
            return;
        }

        // Show confirmation for large exports
        if (tableData.length > 1000) {
            if (confirm(`You are about to export ${tableData.length} records. This may take a few moments. Continue?`)) {
                performExport($btn, originalText, tableData, totalRecords);
            }
        } else {
            performExport($btn, originalText, tableData, totalRecords);
        }
    });

    // Handle export type change
    $(document).on('change', '#exportType', function () {
        if ($(this).val() === 'all') {
            appalert('This will export all standing orders regardless of current filters. This may take longer if there are many records.', 3, 'info');
        }
    });

    // Handle date range validation
    $(document).on('change', '#startDate, #endDate', function () {
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        if (startDate && endDate && startDate > endDate) {
            appalert('Start date cannot be after end date.', 2, 'warning');
            $(this).val('');
        }
    });

    // Handle format change
    $(document).on('change', '#exportFormat', function () {
        const format = $(this).val();
        if (format === 'pdf') {
            appalert('PDF export will include formatted tables and summaries.', 3, 'info');
        } else if (format === 'csv') {
            appalert('CSV export will include raw data without formatting.', 3, 'info');
        }
    });

    // Clean up modal on hide
    $(document).on('hidden.bs.modal', '#exportModal', function () {
        $('#exportProgress').addClass('d-none');
        $('#exportProgress .progress-bar').css('width', '0%');
        $('#progressText').text('Preparing export...');

        // Remove modal from DOM after hide to prevent duplicates
        $(this).remove();
    });
  // ========== END EXPORT FUNCTIONALITY ==========

  $(function(){
    if ($.fn.select2){
      try { $('.select2').select2({ width:'100%' }); } catch(e){ console.warn('select2 init failed', e); }
    }

    $('#applySOFilterBtn').on('click', function(e){ e.preventDefault(); reloadTable(); });

    $('#resetSOFilterBtn').on('click', function(){
      const $f = $('#soFilterForm'); if ($f.length) $f[0].reset();
      if ($.fn.select2){ try { $('.select2').val(null).trigger('change'); } catch(_){} }
      reloadTable();
    });

    $('#soFilterForm').on('keypress', 'input,select', function(e){
      if (e.which === 13){ e.preventDefault(); reloadTable(); }
    });

    // Actions
    $(document).on('click', '#btnCreateSO', function(){
        loadIntoModal('#soEditModal', initUrl, { KEY: '', partialView:'_StandingOrderForm', path:'new', serviceOption:'StandingOrder' });
    });

    $('#datalistingview').on('click', '.btn-so-detail', function(){
      const id = $(this).data('id'); if (!id) return;
        loadIntoModal('#soDetailsModal', detailUrl, { KEY: id, partialView:'_StandingOrderDetailsPartial' });
    });

    $('#datalistingview').on('click', '.btn-so-edit', function(){
      const id = $(this).data('id'); if (!id) return;
        loadIntoModal('#soEditModal', initUrl, { KEY: id, partialView:'_StandingOrderForm', path:'get', serviceOption:'StandingOrder' });
    });

      $(".filter-toggle").change(function () {
          var target = $(this).data("target");

          if ($(this).is(":checked")) {
              $(target).removeClass("d-none");
          } else {
              $(target).addClass("d-none");
              $(target).find("input").val("");
              $(target).find("select").val("").trigger("change");
          }
      });

  });
})(jQuery, window);
    </script>
