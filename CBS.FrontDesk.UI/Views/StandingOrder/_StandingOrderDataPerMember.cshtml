@model CBS.FrontDesk.Data.Entity.SalaryManagement.StandingOrderCarrier

<div class="row invoice-preview">
    <div class="col-xl-3 col-md-4 col-12 invoice-actions">
        @Html.Partial("_CustomerCard")
    </div>
    <div class="col-xl-9 col-md-8 col-12 mb-md-0 mb-4">
        <fieldset class="fieldset-custom">
            <div class="mb-3 border-2">
                <div id="mainviewChange">
                    <div class="card mb-1">
                        <div class="card-body d-flex justify-content-end align-items-center">
                            <a type="button" onclick="GetMember()" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New order">
                                <i class="mdi mdi-plus mdi-18px"></i> Add new order
                            </a>
                        </div>
                    </div>
                </div>
                <div id="datalistingview_inner">
                    <div class="table-responsive mb-3">
                        @if (Model.StandingOrders != null && Model.StandingOrders.Any())
                        {
                            <table class="table table-hover" id="myDataTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Source Account</th>
                                        <th>Destination Account</th>
                                        <th>Amount</th>
                                        <th>Active status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.StandingOrders)
                                    {
                                        <tr>
                                            <td>@order.SourceAccountType</td>
                                            <td>@order.DestinationAccountType</td>
                                            <td>@order.Amount.ToString("N2")</td>
                                            <td>
                                                @if (order.IsActive)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-center align-items-center gap-2">
                                                    <!-- Edit Button -->
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                                            onclick="AddORUpdateGen('@order.Id', 'datalistingview', '_StandingOrderDesk', 'update', 'StandingOrder', null, null)"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-placement="top"
                                                            title="Edit @order.MemberName">
                                                        <i class="fas fa-edit me-1"></i> Edit
                                                    </button>
                                                    <!-- Details Button -->
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-info d-flex align-items-center"
                                                            onclick="showStandingOrderDetails('@order.Id')"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-placement="top"
                                                            title="View Details">
                                                        <i class="fas fa-info-circle me-1"></i> Details
                                                    </button>
                                                    <!-- Delete Button -->
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                                            onclick="DeleteRecordDataTable('StandingOrder','@order.Id','myDataTable','_StandingOrderDataPerMember',0,'datalistingview','@order.MemberId','my_orders')"
                                                            data-bs-toggle="tooltip"
                                                            data-bs-placement="top"
                                                            title="Delete @order.MemberName">
                                                        <i class="fas fa-trash-alt me-1"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        }
                        else
                        {

                            <div class="text-center my-3">
                                <p>No standing orders found.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
</div>


