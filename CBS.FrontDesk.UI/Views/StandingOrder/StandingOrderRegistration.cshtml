                                        <div id="bulkCreationContent2" class="accordion-collapse collapse" aria-labelledby="headingBulkFileContent2">
                                            <div class="accordion-body">
                                                <div class="table-responsive mb-3">
                                                    <table class="table table-hover table-bordered align-middle" id="soBulkCreateStatusTable2">
                                                        <thead>
                                                            <tr>

                                                                <th>Member Reference</th>
                                                                <th>Member Name</th>
                                                                <th>Amount</th>
