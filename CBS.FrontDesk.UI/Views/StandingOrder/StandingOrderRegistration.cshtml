@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // toggle sections
            $('input[name="InputMethod"]').change(function () {
                if ($(this).val() === 'manual') {
                    $('#manualInputSection').show();
                    $('#fileInputSection').hide();
                } else {
                    $('#manualInputSection').hide();
                    $('#fileInputSection').show();
                }
            });

            $('[data-bs-toggle="tooltip"]').tooltip();

            if ($.fn.select2) {
                try { $('.select2').select2({ width: '100%' }); } catch (e) { console.warn('select2 init failed', e); }
            }
        });
    </script>

    <!-- ======================== -->
    <!-- FILE UPLOAD + PREVIEW JS -->
    <!-- ======================== -->
    <script>
        // holds last preview dataset for bulk create
        window.__soPreviewRows = [];

        function AjaxPostStandingOrderFileUpload(form) {
            $.validator.unobtrusive.parse(form);

            if (!$(form).valid()) return false;

            alertify.confirm("Confirmation", "Upload file for validation & preview?",
                function () {
                    var ajaxConfig = {
                        type: 'POST',
                        url: form.action,
                        data: new FormData(form),
                        success: function (response) {
                            if (response && response.success) {
                                showUploadStatus(response.message || 'File processed successfully', 'success');

                                // DataTables expects `data`
                                const rows = response.data.FileDetails || [];
                                window.__soPreviewRows = rows;

                                displayStandingOrderPreview(rows);
                                updateSummaryBadges(response.data);

                                form.reset();
                            } else {
                                showUploadStatus((response && response.message) ? response.message : 'File processing failed', 'danger');
                                window.__soPreviewRows = [];
                                displayStandingOrderPreview([]);
                                updateSummaryBadges([]);
                            }
                        },
                        error: function (err) {
                            if (err.status === 401) window.location.href = '/Authentication/Login';
                            else showUploadStatus(err.responseJSON?.message || err.statusText || 'Upload failed', 'danger');
                        }
                    };
                    ajaxConfig.contentType = false;
                    ajaxConfig.processData = false;
                    $.ajax(ajaxConfig);
                },
                function () { appalert('Upload cancelled', 3, 1); }
            );

            return false;
        }

        function AjaxPostStandingOrderBulkCreate(form) {
            $.validator.unobtrusive.parse(form);

            // must have preview data
            const rows = window.__soPreviewRows || [];
            console.log('So Preview Rows : '+rows)
            if (!rows.length) {
                appalert('Please upload and preview a valid file first.', 2, 1);
                return false;
            }

            // valid rows only
            //const validRows = rows.filter(x => x.Success === true);
            //if (!validRows.length) {
            //    appalert('No valid rows found to create. Please fix invalid rows and re-upload.', 2, 1);
            //    return false;
            //}

            // additional safety: required fields
            const invalidShape = rows.some(r =>
                !r.MemberId || (parseFloat(r.Amount) || 0) <= 0 || !r.Reason
            );
            if (invalidShape) {
                appalert('Some valid rows are missing required data (MemberRef/Amount/Reason). Re-upload the file.', 2, 1);
                return false;
            }

            if (!$(form).valid()) return false;

            alertify.confirm("Confirmation",
                `Create standing orders for ${rows.length} valid row(s)?`,
                function () {

                    const requestData = {
                       /* StartDate: $('#StartDate').val(),
                        EndDate: $('#EndDate').val(),
                        Frequency: $('#Frequency').val(),
                        Priority: $('#Priority').val(),*/

                        // Send only valid rows
                        Rows: rows.map(r => ({
                            RowNumber: r.RowNumber,
                            MemberId: r.MemberId,
                            MemberName: r.MemberName,
                            Amount: parseFloat(r.Amount) || 0,
                            Reason: r.Reason
                        }))
                    };

                    
                    $.ajax({
                        type: 'POST',
                        url: form.action,
                        data: JSON.stringify(requestData),
                        contentType: 'application/json',
                        success: function (response) {
                            if (response && response.success) {
                                appalert(response.message || 'Standing orders created successfully', 1, 1);

                                // If API returns updated results, refresh preview
                                if (Array.isArray(response.data)) {
                                     displayStandingOrderCreationPreviewResult(response.data, '2');
                                     updateSummaryBadges2(response.data, '2');
                                  
                                }
                            } else {
                                appalert(response?.message || 'Bulk create failed', 2, 1);
                            }
                        },
                        error: function (err) {
                            console.error(err);
                            if (err.status === 401) window.location.href = '/Authentication/Login';
                            else appalert(err.responseJSON?.message || err.statusText || 'An error occurred', 2, 1);
                        }
                    });
                },
                function () { appalert('Creation cancelled', 3, 1); }
            );

            return false;
        }

