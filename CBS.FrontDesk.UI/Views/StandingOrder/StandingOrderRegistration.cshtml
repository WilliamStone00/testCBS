@using Resources
@using Newtonsoft.Json

@{
    ViewBag.Title = "Standing Order Registration (Members)";
}

<style>
    .upload-feedback {
        transition: all 0.3s ease;
    }

    #uploadStatus {
        transition: opacity 0.3s ease;
    }

    .progress-bar {
        transition: width 0.3s ease;
    }

    .help-hint {
        font-size: .85rem;
    }
</style>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">

        <!-- ====================== -->
        <!-- HEADER -->
        <!-- ====================== -->
        <div class="card bg-light mb-4 shadow-sm">
            <div class="card-body text-center">
                <h1 class="card-title text-success fw-bold mb-2">
                    <i class="mdi mdi-calendar-sync me-2"></i> STANDING ORDER REGISTRATION
                </h1>

                <p class="card-text text-muted mb-2">
                    <strong>Standing Order Management Console</strong> — Register member standing orders in bulk.
                    <br />
                    Upload → preview → validate → create standing orders with complete audit and error traceability.
                </p>

                <hr style="border: 2px solid rgba(128, 128, 128, 0.35);" />

                <div class="alert alert-info mt-3 d-flex align-items-center justify-content-center">
                    <i class="mdi mdi-information-outline me-2"></i>
                    <strong>Important:</strong>&nbsp;Uploads are validated first. You can then run <b>Multiple Creation</b> for all valid rows.
                </div>
            </div>
        </div>

        <!-- ====================== -->
        <!-- QUICK ACTIONS -->
        <!-- ====================== -->
        <div class="row mb-2">
            <div class="col-md-6 text-md-end mb-1 mb-md-0">
                <a href="/StandingOrder/Listing" class="btn btn-primary btn-sm shadow-sm px-3 w-100 w-md-auto">
                    <i class="mdi mdi-view-list me-1"></i> Standing Orders Listing
                </a>
            </div>
            <div class="col-md-6 text-md-start">
                <a href="/StandingOrder/DownloadStandingOrderMemberRegistrationTemplate"
                   class="btn btn-outline-secondary btn-sm shadow-sm px-3 w-100 w-md-auto"
                   data-bs-toggle="tooltip" title="Download the required template (CSV/Excel)">
                    <i class="mdi mdi-file-download-outline me-1"></i> Download Template
                </a>
            </div>
        </div>

        <!-- ====================== -->
        <!-- MAIN ACCORDION -->
        <!-- ====================== -->
        <div class="accordion mb-2" id="soUploadAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingMethodSelection">
                    <button class="accordion-button" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseMethodSelection"
                            aria-expanded="true" aria-controls="collapseMethodSelection">
                        <i class="mdi mdi-upload me-2"></i>
                        Standing Order Registration Method
                        <span class="badge bg-success ms-2">Upload + Preview + Create</span>
                    </button>
                </h2>

                <div id="collapseMethodSelection" class="accordion-collapse collapse show" aria-labelledby="headingMethodSelection">
                    <div class="accordion-body">

                        <!-- =============================== -->
                        <!-- INPUT METHOD -->
                        <!-- =============================== -->
                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">
                                        Input Method
                                        <i class="mdi mdi-help-circle-outline text-muted"
                                           data-bs-toggle="tooltip"
                                           title="Choose how to register: manual entry for small batches or file upload for bulk creation."></i>
                                    </label>

                                    <div class="btn-group w-100" role="group" aria-label="Input method">
                                        <input type="radio" class="btn-check" name="InputMethod" id="manualInput" value="manual" />
                                        <label class="btn btn-outline-primary" for="manualInput">
                                            <i class="mdi mdi-keyboard-outline me-2"></i> Manual Entry
                                        </label>

                                        <input type="radio" class="btn-check" name="InputMethod" id="fileInput" value="file" checked />
                                        <label class="btn btn-outline-primary" for="fileInput">
                                            <i class="mdi mdi-file-import-outline me-2"></i> File Upload
                                        </label>
                                    </div>

                                    <small class="text-muted d-block help-hint mt-1">
                                        <i class="mdi mdi-information-outline me-1"></i>
                                        Template headers must be: <b>Member Reference</b>, <b>Member Name</b>, <b>Amount</b>, <b>Reason</b>.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- =============================== -->
                        <!-- MANUAL INPUT (OPTIONAL) -->
                        <!-- =============================== -->
                        <div id="manualInputSection" class="mt-3" style="display:none;">

                            @using (Html.BeginForm("CreateStandingOrdersFromManual", "StandingOrder", FormMethod.Post,
                                new { id = "manualForm", enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdateStandingOrdersManual(this);" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="card shadow-sm mb-2">
                                    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                                        <span><i class="mdi mdi-information-outline me-2"></i> Tips & Rules (Manual Entry)</span>
                                        <button class="btn btn-light btn-sm" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapseUserTipsManual"
                                                aria-expanded="false"
                                                aria-controls="collapseUserTipsManual">
                                            <i class="mdi mdi-chevron-down"></i>
                                        </button>
                                    </h6>

                                    <div id="collapseUserTipsManual" class="collapse">
                                        <div class="card-body">
                                            <ol class="list-group list-group-numbered">
                                                <li class="list-group-item">
                                                    <div class="fw-bold">Member Reference</div>
                                                    Must match a valid member matricule/reference in the system.
                                                </li>
                                                <li class="list-group-item">
                                                    <div class="fw-bold">Amount</div>
                                                    Must be greater than 0.
                                                </li>
                                                <li class="list-group-item">
                                                    <div class="fw-bold">Reason</div>
                                                    Used to infer SO type/purpose (Loan, Saving, Loan Repayment, etc.).
                                                </li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion mb-2" id="manualRowsAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingManualRows">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#collapseManualRows" aria-expanded="true" aria-controls="collapseManualRows">
                                                <i class="mdi mdi-table me-2"></i> Manual Rows
                                                <span class="badge bg-primary ms-2">Multiple Creation</span>
                                            </button>
                                        </h2>
                                        <div id="collapseManualRows" class="accordion-collapse collapse show" aria-labelledby="headingManualRows">
                                            <div class="accordion-body">

                                                <div class="table-responsive">
                                                    <table class="table table-hover mb-0" id="manualRowsTable">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Member Reference</th>
                                                                <th>Member Name</th>
                                                                <th class="text-end">Amount</th>
                                                                <th>Reason</th>
                                                                <th class="text-end">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr class="empty-row">
                                                                <td colspan="5" class="text-center text-muted py-4">
                                                                    <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                                                                    No rows added yet. Click <b>“Add Row”</b> to begin.
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
                                                    <button type="button" class="btn btn-sm btn-outline-danger" id="resetManualRowsBtn">
                                                        <i class="mdi mdi-delete-sweep-outline me-1"></i> Clear All
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary" id="addManualRowBtn">
                                                        <i class="mdi mdi-plus-circle-outline me-1"></i> Add Row
                                                    </button>
                                                </div>

                                                <small class="text-muted">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    Each row creates one Standing Order if valid.
                                                </small>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-2 mb-2">
                                    <div class="col-md-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="mdi mdi-content-save-outline me-2"></i> Create Standing Orders
                                        </button>
                                    </div>
                                </div>


                                <!-- Preview -->
                                <div class="accordion mb-4" id="bulkCreationAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingBulkFileContent">
                                            <button class="accordion-button collapsed" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#bulkCreationContent"
                                                    aria-expanded="false" aria-controls="collapseBulkContent">
                                                <i class="mdi mdi-file-document-outline me-2"></i> Bulk Creation Results (Row Results)
                                            </button>
                                        </h2>
                                        <div id="bulkCreationContent" class="accordion-collapse collapse" aria-labelledby="headingBulkFileContent">
                                            <div class="accordion-body">
                                                <div class="table-responsive mb-3">
                                                    <table class="table table-hover table-bordered align-middle" id="soBulkCreateStatusTable">
                                                        <thead>
                                                            <tr>

                                                                <th>Member Reference</th>
                                                                <th>Member Name</th>
                                                                <th>Amount</th>
                                                                <th>Reason</th>
                                                                <th>Status</th>
                                                                <th>Message</th>
                                                            </tr>
                                                        </thead>
                                                    </table>

                                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                                        <span class="badge bg-dark" id="sumTotalRows1">Total: 0</span>
                                                        <span class="badge bg-success" id="sumValidRows1">Valid: 0</span>
                                                        <span class="badge bg-danger" id="sumInvalidRows1">Invalid: 0</span>
                                                        <span class="badge bg-primary" id="sumTotalAmount1">Amount: 0</span>
                                                    </div>

                                                    <small class="text-muted d-block mt-2">
                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                        Preview shows per-row validation/creation result returned by the API. You can create only valid rows in bulk.
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- =============================== -->
                        <!-- FILE INPUT SECTION -->
                        <!-- =============================== -->
                        <div id="fileInputSection" class="mt-3">

