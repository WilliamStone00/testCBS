                                                    <div class="col-md-12 text-end">
                                                        <button type="submit" class="btn btn-primary" id="btnBulkCreate">
                                                            <i class="mdi mdi-check-circle-outline me-2"></i> Create Standing Orders (Valid Rows)
                                                        </button>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Preview -->
                                <div class="accordion mb-4" id="bulkCreationAccordion2">
                                    <div class="accordion-item">
