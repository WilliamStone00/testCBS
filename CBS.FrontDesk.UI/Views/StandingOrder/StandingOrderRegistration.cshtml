        function updateSummaryBadges(data) {
            //rows = data || [];
            const total = data.TotalRows;
            const valid = data.ValidRows;
            const invalid = data.InvalidRows;
            const totalAmount = data.TotalAmount; //rows.reduce((acc, x) => acc + (parseFloat(x.Amount) || 0), 0);

            $('#sumTotalRows').text('Total: ' + total);
            $('#sumValidRows').text('Valid: ' + valid);
            $('#sumInvalidRows').text('Invalid: ' + invalid);
            $('#sumTotalAmount').text('Amount: ' + formatCurrency(totalAmount));
        }

        function updateSummaryBadges2(rows, tableType) {
            rows = Array.isArray(rows) ? rows : [];

            const total = rows.length;
            const valid = rows.filter(x => x && x.Success === true).length;
            const invalid = total - valid;

            const totalAmount = rows.reduce((acc, x) => {
                const v = x ? (parseFloat(x.Amount) || 0) : 0;
                return acc + v;
            }, 0);

            const suffix = (String(tableType) === '2') ? '2' : '1';

            $('#sumTotalRows' + suffix).text('Total: ' + total);
            $('#sumValidRows' + suffix).text('Valid: ' + valid);
            $('#sumInvalidRows' + suffix).text('Invalid: ' + invalid);
            $('#sumTotalAmount' + suffix).text('Amount: ' + formatCurrency(totalAmount));
        }


        function showUploadStatus(message, type) {
            const $uploadStatus = $('#uploadStatus');
            $uploadStatus.removeClass('d-none alert-danger alert-success alert-info')
                .addClass(`alert alert-${type}`)
                .html(`<i class="mdi mdi-${type === 'success' ? 'check' : 'alert'}-circle-outline me-2"></i>${message}`);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-NG', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(amount);
        }
    </script>

