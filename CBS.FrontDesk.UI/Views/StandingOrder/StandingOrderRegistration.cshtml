    <!-- MANUAL MULTI CREATION JS -->
    <!-- ======================== -->
    <script>
        $(document).ready(function () {
            let rowCounter = 0;

            $('#addManualRowBtn').on('click', function () {
                addManualRow();
            });

            function addManualRow() {
                rowCounter++;
                $('#manualRowsTable .empty-row').remove();

                const newRow = $(`
                    <tr data-row-id="${rowCounter}">
                        <td>
                            <input type="text" class="form-control form-control-sm member-id"
                                   placeholder="e.g. 0010005467" required />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm member-name"
                                   placeholder="John Doe" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm amount text-end"
                                   placeholder="0" step="0.01" min="0.01" required />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm reason"
                                   placeholder="Loan / Saving / Loan Repayment..." required />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove row">
                                <i class="mdi mdi-delete-outline"></i>
                            </button>
                        </td>
                    </tr>
                `);

                $('#manualRowsTable tbody').append(newRow);
                newRow.find('.member-id').focus();
            }

            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();
                if ($('#manualRowsTable tbody tr').length === 0) {
                    $('#manualRowsTable tbody').append(`
                        <tr class="empty-row">
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                                No rows added yet. Click <b>“Add Row”</b> to begin.
                            </td>
                        </tr>
                    `);
                    rowCounter = 0;
                }
            });

            $('#resetManualRowsBtn').on('click', function () {
                $('#manualRowsTable tbody').empty().append(`
                    <tr class="empty-row">
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="mdi mdi-database-remove fs-3 d-block mb-2"></i>
                            No rows added yet. Click <b>“Add Row”</b> to begin.
                        </td>
                    </tr>
                `);
                rowCounter = 0;
            });
        });

        function AjaxPostAndUpdateStandingOrdersManual(form) {
            $.validator.unobtrusive.parse(form);

            const rowCount = $('#manualRowsTable tbody tr').not('.empty-row').length;
            if (rowCount <= 0) {
                appalert('Please add at least one row before creating standing orders.', 2, 1);
                return false;
            }

            // collect
            const rows = [];
            $('#manualRowsTable tbody tr').not('.empty-row').each(function () {
                const $r = $(this);
                rows.push({
                    MemberId: ($r.find('.member-id').val() || '').trim(),
                    MemberName: ($r.find('.member-name').val() || '').trim(),
                    Amount: parseFloat($r.find('.amount').val()) || 0,
                    Reason: ($r.find('.reason').val() || '').trim()
                });
            });

            // simple validation
            if (rows.some(x => !x.MemberId || x.Amount <= 0 || !x.Reason)) {
                appalert('Please ensure Member Reference, Amount (>0) and Reason are filled for all rows.', 2, 1);
                return false;
            }

            if ($(form).valid()) {
                alertify.confirm("Confirmation", `Create standing orders for ${rows.length} row(s)?`,
                    function () {

                        // Your backend can infer Reason/purpose from Reason
                        const requestData = { Rows: rows };

                        $.ajax({
                            type: 'POST',
                            url: form.action,
                            data: JSON.stringify(requestData),
                            contentType: 'application/json',
                            success: function (response) {
                                if (response && response.success) {
                                    appalert(response.message || 'Created successfully', 1, 1);
                                    // If API returns updated results, refresh preview
                                    if (Array.isArray(response.data)) {
                                        displayStandingOrderCreationPreviewResult(response.data,'1');
                                        updateSummaryBadges2(response.data,'1');
                                    }
                                } else {
                                    appalert(response?.message || 'Creation failed', 2, 1);
                                }
                            },
                            error: function (err) {
                                console.error(err);
                                if (err.status === 401) window.location.href = '/Authentication/Login';
                                else appalert(err.responseJSON?.message || err.statusText || 'An error occurred', 2, 1);
                            }
                        });

                    },
                    function () { appalert('Creation cancelled', 3, 1); }
                );
            }
            return false;
        }
    </script>
