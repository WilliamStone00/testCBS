<style>
    /* Dashboard Title */
    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2a5298; /* Deep Blue */
        margin: 1rem 0 0.8rem 0;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    /* Card Borders */
    .card-border-shadow-primary {
        border-left: 4px solid #5b4b8a; /* Indigo */
        box-shadow: 0 2px 8px rgba(42, 82, 152, 0.15);
    }

    /* Dashboard Values */
    .dashboard-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c7873; /* Teal Green */
    }

    /* Sub text */
    .dashboard-sub {
        font-size: 0.9rem;
        color: #5b4b8a; /* Indigo */
    }

    /* Soft warning instead of red */
    .text-warning-soft {
        color: #d49a00 !important; /* Gold / Soft Orange */
    }
</style>

@model CBS.FrontDesk.Data.Entity.AccountingV2.GLSystemReconciliation.ReconciliationData

<div class="card shadow-sm mb-3">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span>RECONCILIATION SUMMARY</span>
    </h6>
    <div class="card-body">

        <!-- TOTAL OPERATIONS -->
        <div class="section-title">Total Operations</div>
        <div class="row mb-3">

            <!-- Total Operations -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Operations</h6>
                        <h3 class="dashboard-value">@Model.Statistics.TotalOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.TotalOperations.Currency @Model.Statistics.TotalOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Operations -->
            <div class="col-sm-6 col-md-4">
                @{
                    var localCount =
                        Model.Statistics.LocalCashInOperations.Count +
                        Model.Statistics.LocalCashOutOperations.Count +
                        Model.Statistics.LocalLoanApprovalOperations.Count +
                        Model.Statistics.LocalLoanDisbursementOperations.Count +
                        Model.Statistics.LocalManualentries.Count;

                    var localVolume =
                        Model.Statistics.LocalCashInOperations.Volume +
                        Model.Statistics.LocalCashOutOperations.Volume +
                        Model.Statistics.LocalLoanApprovalOperations.Volume +
                        Model.Statistics.LocalLoanDisbursementOperations.Volume +
                        Model.Statistics.LocalManualentries.Volume;

                    var localCurrency = Model.Statistics.LocalCashInOperations.Currency;

                    if (localCount == 0)
                    {
                        localCount = Model.Statistics.TotalOperations.Count -
                                     (
                                         Model.Statistics.InterBranchCashInOperations.Count +
                                         Model.Statistics.InterBranchCashOutOperations.Count +
                                         Model.Statistics.InterBranchLoanApprovalOperations.Count +
                                         Model.Statistics.InterBranchLoanDisbursementOperations.Count +
                                         Model.Statistics.InterBranchManualentries.Count
                                     );

                        localVolume = Model.Statistics.TotalOperations.Volume -
                                      (
                                          Model.Statistics.InterBranchCashInOperations.Volume +
                                          Model.Statistics.InterBranchCashOutOperations.Volume +
                                          Model.Statistics.InterBranchLoanApprovalOperations.Volume +
                                          Model.Statistics.InterBranchLoanDisbursementOperations.Volume +
                                          Model.Statistics.InterBranchManualentries.Volume
                                      );
                    }

                    var localClass = localCount == 0 ? "text-warning-soft" : "text-muted";
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase @localClass mb-2">Local Operations</h6>
                        <h3 class="dashboard-value @localClass">@localCount.ToString("N0")</h3>
                        <p class="dashboard-sub @localClass">@localCurrency @localVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Interbranch Operations -->
            <div class="col-sm-6 col-md-4">
                @{
                    var interCount =
                        Model.Statistics.InterBranchCashInOperations.Count +
                        Model.Statistics.InterBranchCashOutOperations.Count +
                        Model.Statistics.InterBranchLoanApprovalOperations.Count +
                        Model.Statistics.InterBranchLoanDisbursementOperations.Count +
                        Model.Statistics.InterBranchManualentries.Count;

                    var interVolume =
                        Model.Statistics.InterBranchCashInOperations.Volume +
                        Model.Statistics.InterBranchCashOutOperations.Volume +
                        Model.Statistics.InterBranchLoanApprovalOperations.Volume +
                        Model.Statistics.InterBranchLoanDisbursementOperations.Volume +
                        Model.Statistics.InterBranchManualentries.Volume;

                    var interCurrency = Model.Statistics.InterBranchCashInOperations.Currency;

                    if (interCount == 0)
                    {
                        interCount = Model.Statistics.TotalOperations.Count - localCount;
                        interVolume = Model.Statistics.TotalOperations.Volume - localVolume;
                    }

                    var interClass = interCount == 0 ? "text-warning-soft" : "text-muted";
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase @interClass mb-2">Interbranch Operations</h6>
                        <h3 class="dashboard-value @interClass">@interCount.ToString("N0")</h3>
                        <p class="dashboard-sub @interClass">@interCurrency @interVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- CASH OPERATIONS – CASH IN -->
        <div class="section-title">Cash Operations – Cash In</div>
        <div class="row mb-3">

            <!-- Total Cash In -->
            <div class="col-sm-6 col-md-4">
                @{
                    var tciCount = Model.Statistics.LocalCashInOperations.Count + Model.Statistics.InterBranchCashInOperations.Count;
                    var tciVolume = Model.Statistics.LocalCashInOperations.Volume + Model.Statistics.InterBranchCashInOperations.Volume;
                    var tciCurrency = Model.Statistics.LocalCashInOperations.Currency;
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Cash In</h6>
                        <h3 class="dashboard-value">@tciCount.ToString("N0")</h3>
                        <p class="dashboard-sub">@tciCurrency @tciVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Cash In -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Local Cash In</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LocalCashInOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LocalCashInOperations.Currency @Model.Statistics.LocalCashInOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Interbranch Cash In -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Interbranch Cash In</h6>
                        <h3 class="dashboard-value">@Model.Statistics.InterBranchCashInOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.InterBranchCashInOperations.Currency @Model.Statistics.InterBranchCashInOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- CASH OPERATIONS – CASH OUT -->
        <div class="section-title">Cash Operations – Cash Out</div>
        <div class="row mb-3">

            <!-- Total Cash Out -->
            <div class="col-sm-6 col-md-4">
                @{
                    var tcoCount = Model.Statistics.LocalCashOutOperations.Count + Model.Statistics.InterBranchCashOutOperations.Count;
                    var tcoVolume = Model.Statistics.LocalCashOutOperations.Volume + Model.Statistics.InterBranchCashOutOperations.Volume;
                    var tcoCurrency = Model.Statistics.LocalCashOutOperations.Currency;
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Cash Out</h6>
                        <h3 class="dashboard-value">@tcoCount.ToString("N0")</h3>
                        <p class="dashboard-sub">@tcoCurrency @tcoVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Cash Out -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Local Cash Out</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LocalCashOutOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LocalCashOutOperations.Currency @Model.Statistics.LocalCashOutOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Interbranch Cash Out -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Interbranch Cash Out</h6>
                        <h3 class="dashboard-value">@Model.Statistics.InterBranchCashOutOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.InterBranchCashOutOperations.Currency @Model.Statistics.InterBranchCashOutOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- LOAN OPERATIONS -->
        <div class="section-title">Loan Operations</div>
        <div class="row mb-3">

            <!-- Total Loan Operations -->
            <div class="col-sm-6 col-md-3">
                @{
                    var totalLoanCount =
                        Model.Statistics.LocalLoanApprovalOperations.Count +
                        Model.Statistics.InterBranchLoanApprovalOperations.Count +
                        Model.Statistics.LocalLoanDisbursementOperations.Count +
                        Model.Statistics.InterBranchLoanDisbursementOperations.Count;

                    var totalLoanVolume =
                        Model.Statistics.LocalLoanApprovalOperations.Volume +
                        Model.Statistics.InterBranchLoanApprovalOperations.Volume +
                        Model.Statistics.LocalLoanDisbursementOperations.Volume +
                        Model.Statistics.InterBranchLoanDisbursementOperations.Volume;

                    var totalLoanCurrency = Model.Statistics.LocalLoanApprovalOperations.Currency;
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Loan Operations</h6>
                        <h3 class="dashboard-value">@totalLoanCount.ToString("N0")</h3>
                        <p class="dashboard-sub">@totalLoanCurrency @totalLoanVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Loan Approval -->
            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Loan Approval</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LocalLoanApprovalOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LocalLoanApprovalOperations.Currency @Model.Statistics.LocalLoanApprovalOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Loan Disbursement -->
            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Local Loan Disbursement</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LocalLoanDisbursementOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LocalLoanDisbursementOperations.Currency @Model.Statistics.LocalLoanDisbursementOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Interbranch Loan Disbursement -->
            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Interbranch Loan Disbursement</h6>
                        <h3 class="dashboard-value">@Model.Statistics.InterBranchLoanDisbursementOperations.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.InterBranchLoanDisbursementOperations.Currency @Model.Statistics.InterBranchLoanDisbursementOperations.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- MANUAL ENTRIES -->
        <div class="section-title">Manual Entries</div>
        <div class="row mb-3">

            <!-- Total Manual Entries -->
            <div class="col-sm-6 col-md-4">
                @{
                    var tmeCount = Model.Statistics.LocalManualentries.Count + Model.Statistics.InterBranchManualentries.Count;
                    var tmeVolume = Model.Statistics.LocalManualentries.Volume + Model.Statistics.InterBranchManualentries.Volume;
                    var tmeCurrency = Model.Statistics.LocalManualentries.Currency;
                }
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Manual Entries</h6>
                        <h3 class="dashboard-value">@tmeCount.ToString("N0")</h3>
                        <p class="dashboard-sub">@tmeCurrency @tmeVolume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Local Manual Entries -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Local Manual Entries</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LocalManualentries.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LocalManualentries.Currency @Model.Statistics.LocalManualentries.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Interbranch Manual Entries -->
            <div class="col-sm-6 col-md-4">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Interbranch Manual Entries</h6>
                        <h3 class="dashboard-value">@Model.Statistics.InterBranchManualentries.Count.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.InterBranchManualentries.Currency @Model.Statistics.InterBranchManualentries.Volume.ToString("N2")</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- PERFORMANCE -->
        <div class="section-title">Performance</div>
        <div class="row mb-3">

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Max Cash Out</h6>
                        <h3 class="dashboard-value">@Model.Statistics.CashOperations.MaxCashOut.Currency @Model.Statistics.CashOperations.MaxCashOut.Amount.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.CashOperations.MaxCashOut.PerformedBy.Name</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Max Cash In</h6>
                        <h3 class="dashboard-value">@Model.Statistics.CashOperations.MaxCashIn.Currency @Model.Statistics.CashOperations.MaxCashIn.Amount.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.CashOperations.MaxCashIn.PerformedBy.Name</p>
                    </div>
                </div>
            </div>

            @*<div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Max Loan Approval</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LoanOperations.MaxLoanApproval.Amount.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LoanOperations.MaxLoanApproval.PerformedBy.Name</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Max Loan Disbursement</h6>
                        <h3 class="dashboard-value">@Model.Statistics.LoanOperations.MaxLoanDisbursement.Amount.ToString("N0")</h3>
                        <p class="dashboard-sub">@Model.Statistics.LoanOperations.MaxLoanDisbursement.PerformedBy.Name</p>
                    </div>
                </div>
            </div>*@

        </div>


        <!-- ========================= RECONCILIATION STATUS ========================= -->
        <div class="section-title">Reconciliation Status</div>
        <div class="row mb-3">

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Total Transactions</h6>
                        <h3 class="dashboard-value">@Model.ReconciliationStatus.TotalTransactions.ToString("N0")</h3>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Reconciled Transactions</h6>
                        <h3 class="dashboard-value text-success">@Model.ReconciliationStatus.ReconciledTransactions.ToString("N0")</h3>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Unreconciled Transactions</h6>
                        <h3 class="dashboard-value text-warning-soft">@Model.ReconciliationStatus.UnreconciledTransactions.ToString("N0")</h3>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="card card-border-shadow-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Reconciliation Rate</h6>
                        <h3 class="dashboard-value">@Model.ReconciliationStatus.ReconciliationRate.ToString("N2") %</h3>
                    </div>
                </div>
            </div>

        </div>


    </div>
</div>

@*<div id="datalistingview">
    <button class="btn btn-outline-primary" onclick="location.href='/GLSystemReconciliation/Details/@Model.ReconciliationId'">
        Show full details
    </button>
</div>*@


<div id="datalistingview">
    <button class="btn btn-primary w-100 py-2" data-bs-toggle="modal" data-bs-target="#closeOfDayModal">
        <i class="mdi mdi-lock"></i> Close of Day
    </button>

    @Html.Partial("_DataTable")
</div>

















