
@model CBS.FrontDesk.Data.Entity.AccountingV2.GLSystemReconciliation.Reconciliation


@{
    ViewBag.Title = "G.L System Reconciliation";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> System Reconciliation
        </h1>

        @*<div class="alert alert-info mt-3 py-2">
                <i class="mdi mdi-information-outline me-1"></i>
                Use the filters below to search and review journal entries efficiently.
            </div>*@
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> FILTER USAGE GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Branch Filter:</strong> Check the box to enable branch selection. You can show or hide it as needed.</li>
                <li><strong>Operation Type:</strong> Choose whether to view <em>Cash In</em> or <em>Cash Out</em> operations.</li>
                <li><strong>Reconciliation Status:</strong> Filter between <em>Temporary</em> or <em>Reconciled</em> journal entries.</li>
                <li><strong>Reference:</strong> Enter a reference number or keyword to search for specific transactions.</li>
                <li><strong>Date Filters:</strong> Use the toggle to show or hide accounting and creation date filters. You can filter by range for better results.</li>
                <li><strong>Apply Filters:</strong> Click <em>Search</em> to load matching results in the table below.</li>
                <li><strong>Reset Filters:</strong> Use the reset button to clear all filters and start a new search.</li>
                <li><strong>Tip:</strong> Combine filters (e.g., Branch + Date) for more precise results.</li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="systemReconciliationFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" name="Options.Page" value="1" />
        <input type="hidden" name="Options.PageSize" value="10" />
        <input type="hidden" name="Options.Sort" value="" />

        <!-- Main Filters Card -->
        <div class="card p-3 mb-2 bg-light">

            <!-- 🔹 Branch & Date Toggles -->
            <div class="row mb-2 align-items-center">
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Accounting / Created Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Branch Dropdown -->
            <div id="branchFilter" class="d-none">
                <div class="row mb-1">
                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="branchId">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2 mb-1", @id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden Date Filters -->
            <div id="dateFilters" class="d-none">
                <div class="row mb-1">
                    @*<div class="col-md-6 mb-1">
                        <label class="form-label fw-bold">Start Accounting Date</label>
                        <input type="date" id="startaccountingDate" name="StartAccountingDate" class="form-control mb-1" />

                    </div>*@
                        @*<div class="col-md-6 mb-1">
                            <label class="form-label fw-bold">End Accounting Date</label>
                            <input type="date" id="endaccountingDate" name="EndAccountingDate" class="form-control mb-1" />
                        </div>*@

                    <div class="col-md-12 mb-1">
                        <label class="form-label fw-bold" for="startDate">Accounting Date</label>
                        <input type="date" id="startDate" name="StartDate" class="form-control mb-1" />
                    </div>

                    @*<div class="col-md-6 mb-1">
                        <label class="form-label fw-bold" for="endDate">End Date</label>
                        <input type="datetime-local" id="endDate" name="EndDate" class="form-control mb-1" />
                    </div>*@


                </div>
            </div>

            @*<hr class="my-3" />*@

            <!-- 🔹 Reference, Operation Type & Work Ticket (always visible) -->
            <div class="row mb-1">
                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Reference</label>
                    <input type="text" id="reference" name="Reference" class="form-control mb-1" placeholder="Enter Reference" />
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Status</label>
                    @Html.DropDownList("Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2 mb-1", @id = "Status" })
                </div>

                <div class="col-md-4 mb-1">
                    <label class="form-label fw-bold">Operation Code</label>
                    @Html.DropDownList("OperationCode",
                        new SelectList(ViewBag.OperationCode, "Value", "Text"),
                        "Select Operation Code",
                        new { @class = "form-control select2 mb-1", @id = "OperationCode" })
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-2">
            <div class="col-md-12 d-flex">
                <button id="applyFilterBtn" type="submit" class="btn btn-primary me-2 w-100">
                    <i class="mdi mdi-magnify"></i> Apply Filters
                </button>
                <button id="resetFilterBtn" type="button" class="btn btn-secondary w-100"
                        onclick="document.getElementById('systemReconciliationFilterForm').reset();">
                    <i class="mdi mdi-refresh"></i> Reset Filters
                </button>
            </div>
        </div>


    </form>
</div>

<div id="datalistingview">

</div>



<div class="modal fade" id="ReconciliationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="journalDetailsModalContent" class="p-3">
                @* Content will be loaded here *@
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="closeOfDayModal" tabindex="-1" aria-labelledby="closeOfDayLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-body" id="closeOfDayContent">
                @* The form will be loaded here *@
            </div>

        </div>
    </div>
</div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>




                // ==============================
                // Collect Summary Filters (API expected)
                // ==============================
                    function getSummaryFilters() {
                        return {
                            branchId: $('#branchId').val(),
                            StartDate: $('#startDate').val(),
                            EndDate: $('#endDate').val(),
                            StartAccountingDate: $('#startaccountingDate').val()
                             
                        };
                    }


                // ==============================
                // Collect DataTable Filters
                // ==============================
                    function getDataTableFilters() {
                        return {
                            BranchId: $('#branchId').val(),
                            OperationCode: $('#OperationCode').val(),
                            Reference: $('#reference').val(),
                            Status: $('#Status').val(),
                            StartDate: $('#startDate').val(),
                            EndDate: $('#endDate').val(),
                            StartAccountingDate: $('#startaccountingDate').val(),
                            Options: {}
                        };
                    }


                // ==============================
                // Load Summary (Returns JSON → Insert into DIV)
                // ==============================
                function loadSummary() {
                    const query = getSummaryFilters();

                    $.ajax({
                        url: '/GLSystemReconciliation/GetReconciliationSummary',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(query),
                        success: function (res) {
                            if (!res.success) {
                                $("#datalistingview").html(`<div class="alert alert-warning">${res.message}</div>`);
                                return;
                            }

                            const summary = res.data;

                            // Load partial view with summary
                            $.ajax({
                                url: '/GLSystemReconciliation/LoadRecordsForm',
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(summary),
                                success: function (html) {
                                    $("#datalistingview").html(html);
                                    loadReconciliationData(); // initialize table
                                }
                            });
                        },
                        error: function (xhr, status, err) {
                            console.error('❌ Load summary failed:', status, err);
                            appalert('❌ Failed to load summary. Status: ' + xhr.status, 4, 1);
                        }
                    });
                }

                // ==============================
                // Load Reconciliation Data (DataTable)
                // ==============================
                function loadReconciliationData() {
                    $('#myDataTable').DataTable({
                        serverSide: true,
                        destroy: true,
                        responsive: true,
                        searching: false,
                        order: [[1, 'desc']],
                        ajax: {
                            url: '/GLSystemReconciliation/LoadReconciliationData',
                            type: 'POST',
                            contentType: 'application/json',
                            data: function (d) {
                                const filters = getDataTableFilters();
                                filters.Options = {
                                    draw: d.draw,
                                    start: d.start,
                                    length: d.length,
                                    skip: d.start,
                                    pageSize: d.length,
                                    searchValue: d.search?.value || '',
                                    sortColumnName: d.columns[d.order[0].column].data,
                                    sortColumnDirection: d.order[0].dir
                                };
                                return JSON.stringify(filters);
                            },
                            error: function (xhr, status, err) {
                                console.error('❌ Load reconciliation failed:', status, err);
                                appalert('❌ Failed to load reconciliation data. Status: ' + xhr.status, 4, 1);
                            }
                        },
                        columns: [
                            { data: 'Reference', name: 'Reference' },
                            {
                                data: 'AccountingDate',
                                name: 'AccountingDate',
                                render: function (data) {
                                    return data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : '';
                                }
                            },
                            { data: 'OperationCode', name: 'OperationCode' },
                            { data: 'OperationBy', name: 'OperationBy' },
                            { data: 'Status', name: 'Status' },
                            {
                                data: null,
                                orderable: false,
                                render: function (_, __, row) {
                                    return `
                                        <div class="text-center d-flex justify-content-between">
                                            <button class="btn btn-sm btn-info view-details" data-id="${row.Id}">
                                                <i class="mdi mdi-eye-outline me-1"></i> View
                                            </button>

                                            <button class="btn btn-sm btn-success push-details"
                                                    data-id="${row.Id}"
                                                    data-branchid="${row.BranchId}"
                                                    data-branchname="${row.BranchName}"
                                                    data-branchcode="${row.BranchCode}">
                                                <i class="mdi mdi-check-outline me-1"></i> Push
                                            </button>
                                        </div>
                                    `;
                                }
                            }
                        ],
                        initComplete: function () {
                            appalert('✅ Table loaded successfully!', 1, 1);
                        },
                        drawCallback: function () {
                            const api = this.api();
                            if (api.rows({ page: 'current' }).data().length === 0) {
                                appalert('⚠️ No reconciliation data found.', 2, 1);
                            }
                        }
                    });
                }

                // ==============================
                // Reset Filters
                // ==============================
                function resetReconciliationFilters() {
                    $('#systemReconciliationFilterForm').trigger('reset');
                    $('.select2').val('').trigger('change');

                    loadSummary();
                    loadReconciliationData();

                    appalert('🧹 Filters reset.', 1, 1);
                }

                // ==============================
                // Init Events
                // ==============================
                $(document).ready(function () {

                    // Apply Filters
                    $('#applyFilterBtn').on('click', function (e) {
                        e.preventDefault();
                        loadSummary();
                        loadReconciliationData();
                    });

                    // Reset Filters
                    $('#resetFilterBtn').on('click', function (e) {
                        e.preventDefault();
                        resetReconciliationFilters();
                    });

                    // ==============================
                    // View Details Modal
                    // ==============================
                    $(document).on("click", ".view-details", function () {
                        const id = $(this).data("id");
                        if (!id) return;

                        $.ajax({
                            url: `/GLSystemReconciliation/GetDetails?id=${encodeURIComponent(id)}`,
                            type: "GET",
                            dataType: "html",
                            success: function (html) {
                                $("#ReconciliationDetailsModal .modal-content").html(html);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('ReconciliationDetailsModal')).show();
                            },
                            error: function (xhr) {
                                $("#ReconciliationDetailsModal .modal-content").html(`
                                    <div class="modal-body">
                                        <div class="alert alert-danger">
                                            Failed to load reconciliation details. Status: ${xhr.status}
                                        </div>
                                    </div>`);
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('ReconciliationDetailsModal')).show();
                            }
                        });
                    });

                    // ==============================
                    // PUSH RECORD ACTION
                    // ==============================
                    $(document).on("click", ".push-details", function () {

                        let payload = {
                            trackerId: $(this).data("id"),
                            pusherName: "@User.Identity.Name",
                            branchId: $(this).data("branchid"),
                            branchName: $(this).data("branchname"),
                            branchCode: $(this).data("branchcode")
                        };

                        console.log("Send payload:", payload);

                        $.ajax({
                            url: '/GLSystemReconciliation/PushRecord',
                            type: 'POST',
                            data: JSON.stringify(payload),
                            contentType: "application/json",
                            success: function (res) {
                                toastr.success("Record pushed successfully!");
                            },
                            error: function (err) {
                                toastr.error("Push failed.");
                            }
                        });
                    });




                });


        $(document).ready(function () {

            $('#closeOfDayModal').on('shown.bs.modal', function () {

                let container = $("#closeOfDayContent");

                // Prevent double-loading if modal is reopened
                if (container.data("loaded") === true)
                    return;

                container.data("loaded", true);

                // Load partial view from controller
                container.load('/GLSystemReconciliation/LoadCloseOfDayForm');
            });

        });


    window.closeOfDaySubmitAjax = function (form) {
        event.preventDefault();

        // Parse and validate form
        $.validator.unobtrusive.parse(form);
        if (!$(form).valid()) {
            appalert("Please fill all required fields.", 2, 1);
            return false;
        }

        // Validate branch
        const branchId = $("#branchId").val();
        if (!branchId || branchId === "--- Select Branch ---") {
            appalert("Please select a branch.", 2, 1);
            return false;
        }

        // Validate checkboxes
        const allChecked = ["#AllTransactionsReconciled", "#CashVaultVerified",
            "#InterBranchConfirmed", "#AnyIssueToBeRaised"]
            .every(id => $(id).is(":checked"));

        if (!allChecked) {
            appalert("All confirmation checkboxes must be checked.", 2, 1);
            return false;
        }

        // -------------------------
        // ✅ COMMENT MUST NOT BE EMPTY
        // -------------------------
        const comment = $("#Comment").val().trim();
        if (!comment) {
            appalert("Please enter a comment before closing the day.", 3, 1);
            return false;
        }

        // Build payload
        const payload = {
            BranchId: branchId,
            Reference: $("#Reference").val(),
            AllTransactionsReconciled: $("#AllTransactionsReconciled").is(":checked"),
            CashVaultVerified: $("#CashVaultVerified").is(":checked"),
            InterBranchConfirmed: $("#InterBranchConfirmed").is(":checked"),
            AnyIssueToBeRaised: $("#AnyIssueToBeRaised").is(":checked"),
            Comment: comment,   // ✔ already trimmed
            ClosedBy : '@User.Identity.Name'
        };

        // Confirmation popup
        alertify.confirm(
            "Confirm Close of Day",
            "Are you sure you want to Close the Day?",
            function () {

                $.ajax({
                    url: form.action,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            appalert(res.message || "Close of Day completed.", 1, 1);
                            $("#closeOfDayModal").modal("hide");
                        } else {
                            appalert(res.message || "Close of Day failed.", 2, 1);
                        }
                    },
                    error: function (err) {
                        appalert(err.statusText, 0, 1);
                    }
                });

            },
            function () {
                appalert("Close of Day cancelled.", 3, 1);
            }
        );

        return false;
    };



    // Re-initialize Select2 whenever the modal content is loaded dynamically
    $('#closeOfDayModal').on('shown.bs.modal', function () {
        $('.select2').select2({
            dropdownParent: $('#closeOfDayModal')   // IMPORTANT fix for modals
        });
    });


    

    $(document).on('click', '.view-detail', function () {
        const params = {
            branchId: $("#branchId").val(),
            startDate: $("#startDate").val(),
            endDate: $("#endDate").val(),
            operationCode: $(this).data("operation"),
            isInterBranch: $(this).data("interbranch")
        };
        window.open('/GLSystemReconciliation/LoadOperationDetailsData?' + $.param(params), '_blank');
    });

    

  

</script>
}
