
@model CBS.FrontDesk.Data.Entity.AccountingV2.GLSystemReconciliation.Reconciliation


@{
    ViewBag.Title = "G.L System Reconciliation";
}

<link href="https://cdn.jsdelivr.net/npm/jsoneditor@9.10.0/dist/jsoneditor.min.css" rel="stylesheet">



<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> System Reconciliation
        </h1>

        @*<div class="alert alert-info mt-3 py-2">
                <i class="mdi mdi-information-outline me-1"></i>
                Use the filters below to search and review journal entries efficiently.
            </div>*@
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> FILTER USAGE GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Branch Filter:</strong> Check the box to enable branch selection. You can show or hide it as needed.</li>
                <li><strong>Operation Type:</strong> Choose whether to view <em>Cash In</em> or <em>Cash Out</em> operations.</li>
                <li><strong>Reconciliation Status:</strong> Filter between <em>Temporary</em> or <em>Reconciled</em> journal entries.</li>
                <li><strong>Reference:</strong> Enter a reference number or keyword to search for specific transactions.</li>
                <li><strong>Date Filters:</strong> Use the toggle to show or hide accounting and creation date filters. You can filter by range for better results.</li>
                <li><strong>Apply Filters:</strong> Click <em>Search</em> to load matching results in the table below.</li>
                <li><strong>Reset Filters:</strong> Use the reset button to clear all filters and start a new search.</li>
                <li><strong>Tip:</strong> Combine filters (e.g., Branch + Date) for more precise results.</li>
            </ul>
        </div>
    </div>
</div>






<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="systemReconciliationFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" id="Page" name="DataTableOptions.Page" value="1" />
        <input type="hidden" id="PageSize" name="DataTableOptions.PageSize" value="10" />
        <input type="hidden" id="length" name="DataTableOptions.Length" value="10" />
        <input type="hidden" id="Sort" name="DataTableOptions.Sort" value="" />

        <div class="card p-3 mb-3 bg-light">

            <!-- ================= TOGGLES ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- ================= BRANCH FILTER ================= -->
            <div id="branchFilter" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- ================= DATE FILTERS ================= -->
            <div id="dateFilters" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="FromDate" name="FromDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="ToDate" name="ToDate" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- ================= CORE FILTERS ================= -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="form-label fw-bold">Member Reference</label>
                    <input type="text" id="MemberReference" name="MemberReference"
                           class="form-control"
                           placeholder="Enter Member Reference" />
                </div>

                @*<div class="col-md-4">
                        <label class="form-label fw-bold">Correlation Id</label>
                        <input type="text" id="CorrelationId" name="CorrelationId"
                               class="form-control"
                               placeholder="Enter Correlation Id" />
                    </div>*@

                <div class="col-md-6">
                    <label class="form-label fw-bold">Reference</label>
                    <input type="text" id="Reference" name="Reference"
                           class="form-control"
                           placeholder="Enter Reference" />
                </div>
            </div>

            <!-- ================= STATUS & OPERATION ================= -->
            <div class="row">

                <div class="col-md-12">
                    <label for="Status" class="form-label fw-bold">
                        Status
                        <small class="text-muted d-block">
                            Select status for failed reconciled entries
                        </small>
                    </label>

                    @Html.DropDownList(
                        "Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2", id = "Status" }
                    )
                </div>


                @*<div class="col-md-6">
                        <label class="form-label fw-bold">Operation Code</label>
                        @Html.DropDownList("OperationCode",
                            new SelectList(ViewBag.OperationCode, "Value", "Text"),
                            "Select Operation Code",
                            new { @class = "form-control select2", id = "OperationCode" })
                    </div>*@

            </div>
        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <button id="applyFilterBtn" type="submit"
                        class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button id="resetFilterBtn" type="button"
                        class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>

            <div class="col-12 col-md-4">
                <button type="button" id="btnExportReconciliation" class="btn btn-success btn-sm w-100">
                    <i class="mdi mdi-export me-1"></i> Export
                </button>
            </div>
        </div>

    </form>
</div>

<div id="datalistingview">
    @Html.Partial("_DataTable")
</div>




<div class="modal fade" id="reconciliationExportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.Partial("_ExportDatatable")

        </div>
    </div>
</div>



<div class="modal fade" id="ReconciliationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="journalDetailsModalContent" class="p-3">
                @* Content will be loaded here *@
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="closeOfDayModal" tabindex="-1" aria-labelledby="closeOfDayLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-body" id="closeOfDayContent">
                @* The form will be loaded here *@
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="payloadModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-body">

                <!-- ================= Header Card ================= -->
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-file-document-outline me-2"></i> Request Payload (Editable)
                        </h1>
                        <p class="card-text">
                            Use this page to modify the payload (Request Json).
                        </p>
                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>

                <label class="form-label fw-bold">Request JSON</label>

                <div id="jsonEditor"
                     style="height: 500px; border: 1px solid #dee2e6; border-radius: 6px;">
                </div>


                <small class="text-muted">
                    Edit the JSON payload carefully. Invalid JSON will not be accepted.
                </small>

                <div id="jsonError" class="text-danger mt-2 d-none"></div>
            </div>

            <div class="modal-footer">

                <button class="btn btn-primary btn-sm" id="btnCopyPayload">
                    <i class="mdi mdi-content-copy me-1"></i> Copy
                </button>


                <button class="btn btn-info btn-sm" id="btnBeautify">
                    <i class="mdi mdi-format-align-left me-1"></i> Beautify
                </button>

                <button class="btn btn-success btn-sm" id="btnSavePayload">
                    <i class="mdi mdi-content-save-outline me-1"></i> Post
                </button>

                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script src="https://cdn.jsdelivr.net/npm/jsoneditor@9.10.0/dist/jsoneditor.min.js"></script>

    <script>

        // =====================================================
        // GLOBAL VARIABLES
        // =====================================================
        let reconciliationTableLoaded = false;
        let editor = null;
        let isJsonValid = false;

        // =====================================================
        // FILTER HELPERS
        // =====================================================
        function getDataTableFilters() {
            return {
                BranchId: $('#branchId').val(),
                OperationCode: $('#OperationCode').val(),
                Reference: $('#Reference').val(),
                MemberReference: $('#MemberReference').val(),
                CorrelationId: $('#CorrelationId').val(),
                Status: $('#Status').val(),
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                DataTableOptions: {}
            };
        }

        function resetReconciliationFilters() {
            $('#systemReconciliationFilterForm').trigger('reset');
            $('.select2').val('').trigger('change');
            appalert('🧹 Filters reset.', 1, 1);
        }

        // =====================================================
        // LOAD DATATABLE
        // =====================================================
        function loadReconciliationData() {

            $('#myDataTable').DataTable({
                serverSide: true,
                destroy: true,
                responsive: true,
                searching: false,
                order: [[0, 'desc']],

                ajax: {
                    url: '/GLSystemReconciliation/LoadReconciliationData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {

                        const filters = getDataTableFilters();

                        filters.DataTableOptions = {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            skip: d.start,
                            pageSize: d.length,
                            searchValue: d.search?.value || '',
                            sortColumnName: d.columns[d.order[0].column].data,
                            sortColumnDirection: d.order[0].dir
                        };

                        return JSON.stringify(filters);
                    },
                    error: function (xhr, status, err) {
                        console.error('❌ Load reconciliation failed:', status, err);
                        appalert('❌ Failed to load reconciliation data. Status: ' + xhr.status, 4, 1);
                    }
                },

                columns: [
                    {
                        data: 'CreatedDate',
                        render: data => data ? moment(data).format('DD/MM/YYYY HH:mm:ss') : ''
                    },
                    { data: 'OperationCode' },
                    { data: 'BranchName' },
                    { data: 'Reference' },
                    { data: 'OperationBy' },
                    {
                        data: 'Status',
                        render: function (data) {
                            if (data === 'Successful')
                                return `<span class="badge bg-success">${data}</span>`;
                            if (data === 'Exception')
                                return `<span class="badge bg-secondary">${data}</span>`;
                            return `<span class="badge bg-light">${data}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (_, __, row) {
                            return `
                                <div class="text-center d-flex justify-content-between">
                                    <button class="btn btn-sm btn-info view-details" data-id="${row.Id}">
                                        <i class="mdi mdi-eye-outline me-1"></i> View
                                    </button>
                                    <button class="btn btn-sm btn-success push-details" data-id="${row.Id}">
                                        <i class="mdi mdi-check-outline me-1"></i> Push
                                    </button>
                                </div>`;
                        }
                    }
                ],

                initComplete: function () {
                    reconciliationTableLoaded = true;
                    appalert('✅ Table loaded successfully!', 1, 1);
                },

                drawCallback: function () {
                    if (!this.api().rows({ page: 'current' }).data().length) {
                        appalert('⚠️ No reconciliation data found.', 2, 1);
                    }
                }
            });
        }

        // =====================================================
        // DOCUMENT READY
        // =====================================================
        $(document).ready(function () {

            // ---------------- APPLY / RESET FILTERS ----------------
            $('#applyFilterBtn').on('click', function (e) {
                e.preventDefault();
                reconciliationTableLoaded = false;
                loadReconciliationData();
            });

            $('#resetFilterBtn').on('click', function (e) {
                e.preventDefault();
                resetReconciliationFilters();
            });

            // ---------------- VIEW DETAILS ----------------
            $(document).on("click", ".view-details", function () {

                const id = $(this).data("id");
                if (!id) return;

                $.get(`/GLSystemReconciliation/GetDetails?id=${encodeURIComponent(id)}`)
                    .done(function (html) {
                        $("#ReconciliationDetailsModal .modal-content").html(html);
                        bootstrap.Modal
                            .getOrCreateInstance(document.getElementById('ReconciliationDetailsModal'))
                            .show();
                    })
                    .fail(function (xhr) {
                        $("#ReconciliationDetailsModal .modal-content").html(`
                            <div class="modal-body">
                                <div class="alert alert-danger">
                                    Failed to load reconciliation details. Status: ${xhr.status}
                                </div>
                            </div>`);
                    });
            });

            // ---------------- PUSH RECORD ----------------
            $(document).on("click", ".push-details", function () {

                const btn = this;
                const form = $("#pushForm");

                if (form.length && !form.valid()) return;

                alertify.confirm(
                    "Confirmation",
                    "Are you sure you want to perform this action?",
                    function () {

                        const payload = { Id: $(btn).data("id") };

                        $.ajax({
                            type: 'POST',
                            url: '/GLSystemReconciliation/PushRecord',
                            data: JSON.stringify(payload),
                            contentType: "application/json",
                            success: function (response) {

                                if (!response.success) {
                                    appalert(response.message || "⚠️ Push completed with warnings.", 3, 1);
                                    return;
                                }

                                if (response.status === "Exist")
                                    appalert(response.message, 3, 1);
                                else if (response.status === "Failed")
                                    appalert(response.message, 2, 1);
                                else
                                    appalert(response.message || "✅ Record pushed successfully!", 1, 1);
                            },
                            error: function (err) {
                                if (err.status === 401)
                                    window.location.href = '/Authentication/Login';
                                else
                                    appalert(err.statusText || "❌ Push failed.", 0, 1);
                            }
                        });
                    },
                    function () { }
                );
            });

            // =====================================================
            // JSON EDITOR SECTION
            // =====================================================

            $(document).on('click', '#btnUpdatePayload', function () {
                console.log("Update clicked");
                //const rawJson = document.getElementById("requestJsonData")?.value;
                const rawJson = JSON.parse(
                    document.getElementById("requestJsonData")?.value || '""'
                );

                if (!rawJson) {
                    appalert("No payload available.", 2, 1);
                    return;
                }

                const container = document.getElementById("jsonEditor");

                if (editor) editor.destroy();

                editor = new JSONEditor(container, {
                    mode: 'code',
                    modes: ['code', 'tree'],
                    onChangeText: function (jsonString) {
                        try {
                            JSON.parse(jsonString);
                            isJsonValid = true;
                            $("#jsonError").addClass("d-none");
                            $("#btnSavePayload").prop("disabled", false);
                        } catch (err) {
                            isJsonValid = false;
                            $("#btnSavePayload").prop("disabled", true);
                            $("#jsonError").removeClass("d-none").text(err.message);
                        }
                    }
                });

                try {
                    editor.set(JSON.parse(rawJson));
                    isJsonValid = true;
                    $("#btnSavePayload").prop("disabled", false);
                } catch {
                    editor.setText(rawJson);
                    $("#btnSavePayload").prop("disabled", true);
                }

                bootstrap.Modal
                    .getOrCreateInstance(document.getElementById('payloadModal'))
                    .show();
            });

            $(document).on('click', '#btnBeautify', function () {

                if (!editor) return;

                try {
                    const formatted = editor.get();
                    editor.set(formatted); // this re-formats properly
                    appalert("✅ JSON Beautified", 1, 1);
                } catch {
                    appalert("❌ Cannot beautify invalid JSON", 3, 1);
                }
            });

            $(document).on('click', '#btnSavePayload', function () {

                if (!editor) {
                    appalert("❌ Editor not initialized.", 3, 1);
                    return;
                }

                if (!isJsonValid) {
                    appalert("❌ Fix JSON errors before posting.", 3, 1);
                    return;
                }

                alertify.confirm(
                    "Confirm Update",
                    "Are you sure you want to update this payload?",
                    async function () {

                        const editedJson = JSON.stringify(editor.get());

                        try {

                            const response = await fetch('/GLSystemReconciliation/UpdatePayload', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: new URLSearchParams({
                                    payload: editedJson
                                })
                            });

                            const result = await response.json();

                            if (result.success) {

                                appalert(result.message || "✅ Payload updated successfully.", 1, 1);

                                bootstrap.Modal
                                    .getInstance(document.getElementById('payloadModal'))
                                    ?.hide();

                            } else {

                                appalert(result.message || "❌ Update failed.", 3, 1);
                            }

                        } catch (err) {

                            console.error("Save error:", err);
                            appalert("❌ Failed to save payload.", 3, 1);
                        }
                    },
                    function () {
                        // Cancel clicked
                        appalert("Update cancelled.", 2, 1);
                    }
                ).set('labels', { ok: 'Yes, Update', cancel: 'Cancel' });

            });


            $(document).on('click', '#btnCopyPayload', async function () {

                try {

                    let jsonToCopy = "";

                    // If JSONEditor exists, get formatted JSON
                    if (editor) {
                        jsonToCopy = JSON.stringify(editor.get(), null, 2);
                    }
                    // Fallback to textarea if editor not initialized
                    else {
                        jsonToCopy = document.getElementById("requestJsonData")?.value || "";
                    }

                    if (!jsonToCopy) {
                        appalert("❌ No payload available to copy.", 3, 1);
                        return;
                    }

                    await navigator.clipboard.writeText(jsonToCopy);

                    appalert("✅ Payload copied to clipboard.", 1, 1);

                } catch (err) {
                    console.error("Copy error:", err);
                    appalert("❌ Failed to copy payload.", 3, 1);
                }

            });

        });

    </script>


}
