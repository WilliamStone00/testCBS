
@model CBS.FrontDesk.Data.Entity.AccountingV2.GLSystemReconciliation.Reconciliation


@{
    ViewBag.Title = "G.L System Reconciliation";
}

<div class="card bg-light mb-3">
    <div class="card-body text-center">
        <h1 class="card-title text-primary">
            <i class="mdi mdi-cog-outline me-2"></i> System Reconciliation
        </h1>

        @*<div class="alert alert-info mt-3 py-2">
                <i class="mdi mdi-information-outline me-1"></i>
                Use the filters below to search and review journal entries efficiently.
            </div>*@
    </div>
</div>

<div class="card mb-2">
    <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
        <span><i class="mdi mdi-information-outline me-2"></i> FILTER USAGE GUIDE</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilterTips" aria-expanded="true">
            <i class="mdi mdi-chevron-down"></i>
        </button>
    </h6>

    <div id="collapseFilterTips" class="collapse">
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Branch Filter:</strong> Check the box to enable branch selection. You can show or hide it as needed.</li>
                <li><strong>Operation Type:</strong> Choose whether to view <em>Cash In</em> or <em>Cash Out</em> operations.</li>
                <li><strong>Reconciliation Status:</strong> Filter between <em>Temporary</em> or <em>Reconciled</em> journal entries.</li>
                <li><strong>Reference:</strong> Enter a reference number or keyword to search for specific transactions.</li>
                <li><strong>Date Filters:</strong> Use the toggle to show or hide accounting and creation date filters. You can filter by range for better results.</li>
                <li><strong>Apply Filters:</strong> Click <em>Search</em> to load matching results in the table below.</li>
                <li><strong>Reset Filters:</strong> Use the reset button to clear all filters and start a new search.</li>
                <li><strong>Tip:</strong> Combine filters (e.g., Branch + Date) for more precise results.</li>
            </ul>
        </div>
    </div>
</div>



<div class="card shadow p-3 mb-2">
    <h5 class="text-primary mb-2">
        <i class="mdi mdi-filter-outline me-1"></i> ADVANCE FILTERS
    </h5>

    <form id="systemReconciliationFilterForm" autocomplete="off" method="post">
        @Html.AntiForgeryToken()

        <!-- DataTable hidden options -->
        <input type="hidden" id="Page" name="DataTableOptions.Page" value="1" />
        <input type="hidden" id="PageSize" name="DataTableOptions.PageSize" value="10" />
        <input type="hidden" id="length" name="DataTableOptions.Length" value="10" />
        <input type="hidden" id="Sort" name="DataTableOptions.Sort" value="" />

        <div class="card p-3 mb-3 bg-light">

            <!-- ================= TOGGLES ================= -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleBranch"
                               onclick="document.getElementById('branchFilter').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleBranch">
                            Show Branch Filter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="toggleDateFilters"
                               onclick="document.getElementById('dateFilters').classList.toggle('d-none')" />
                        <label class="form-check-label fw-bold" for="toggleDateFilters">
                            Show Date Filters
                        </label>
                    </div>
                </div>
            </div>

            <!-- ================= BRANCH FILTER ================= -->
            <div id="branchFilter" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Branch</label>
                        @Html.DropDownList("BranchId",
                            new SelectList(ViewBag.Branches ?? new List<object>(), "Id", "Name"),
                            "--- Select Branch ---",
                            new { @class = "form-control select2", id = "branchId" })
                    </div>
                </div>
            </div>

            <!-- ================= DATE FILTERS ================= -->
            <div id="dateFilters" class="d-none mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" id="FromDate" name="FromDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" id="ToDate" name="ToDate" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- ================= CORE FILTERS ================= -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="form-label fw-bold">Member Reference</label>
                    <input type="text" id="MemberReference" name="MemberReference"
                           class="form-control"
                           placeholder="Enter Member Reference" />
                </div>

                @*<div class="col-md-4">
                    <label class="form-label fw-bold">Correlation Id</label>
                    <input type="text" id="CorrelationId" name="CorrelationId"
                           class="form-control"
                           placeholder="Enter Correlation Id" />
                </div>*@

                <div class="col-md-6">
                    <label class="form-label fw-bold">Reference</label>
                    <input type="text" id="Reference" name="Reference"
                           class="form-control"
                           placeholder="Enter Reference" />
                </div>
            </div>

            <!-- ================= STATUS & OPERATION ================= -->
            <div class="row">

                <div class="col-md-12">
                    <label class="form-label fw-bold">Status</label>
                    @Html.DropDownList("Status",
                        new SelectList(ViewBag.Status, "Value", "Text"),
                        "Select Status",
                        new { @class = "form-control select2", id = "Status" })
                </div>

                @*<div class="col-md-6">
                    <label class="form-label fw-bold">Operation Code</label>
                    @Html.DropDownList("OperationCode",
                        new SelectList(ViewBag.OperationCode, "Value", "Text"),
                        "Select Operation Code",
                        new { @class = "form-control select2", id = "OperationCode" })
                </div>*@

            </div>
        </div>

        <!-- ================= ACTION BUTTONS ================= -->
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <button id="applyFilterBtn" type="submit"
                        class="btn btn-primary btn-sm w-100">
                    <i class="mdi mdi-magnify me-1"></i> Apply Filters
                </button>
            </div>

            <div class="col-12 col-md-6">
                <button id="resetFilterBtn" type="button"
                        class="btn btn-secondary btn-sm w-100">
                    <i class="mdi mdi-refresh me-1"></i> Reset Filters
                </button>
            </div>
        </div>

    </form>
</div>

<div id="datalistingview">
    @Html.Partial("_DataTable")
</div>



<div class="modal fade" id="ReconciliationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div id="journalDetailsModalContent" class="p-3">
                @* Content will be loaded here *@
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="closeOfDayModal" tabindex="-1" aria-labelledby="closeOfDayLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-body" id="closeOfDayContent">
                @* The form will be loaded here *@
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="payloadModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-body">

                <!-- ================= Header Card ================= -->
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <h1 class="card-title text-primary">
                            <i class="mdi mdi-file-document-outline me-2"></i> Request Payload (Editable)
                        </h1>
                        <p class="card-text">
                            Use this page to modify the payload (Request Json).
                        </p>
                        <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
                    </div>
                </div>

                <label class="form-label fw-bold">Request JSON</label>

                <textarea id="formattedJson"
                          class="form-control font-monospace"
                          rows="20"
                          style="resize: vertical;
                         overflow-x: auto;
                         white-space: pre-wrap;
                         background-color: #f8f9fa;
                         border: 1px solid #dee2e6;
                         font-family: 'Courier New', monospace; font-size: 14px;
                         min-height: 400px;"></textarea>

                <small class="text-muted">
                    Edit the JSON payload carefully. Invalid JSON will not be accepted.
                </small>

                <div id="jsonError" class="text-danger mt-2 d-none"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-success btn-sm" id="btnSavePayload">
                    <i class="mdi mdi-content-save-outline me-1"></i> Post
                </button>

                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="mdi mdi-close-circle-outline me-1"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>



