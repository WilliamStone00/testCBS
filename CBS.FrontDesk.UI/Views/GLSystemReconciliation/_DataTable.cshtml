



@using Resources
<div class="card p-3 shadow mb-2">
    <div class="table-responsive">
        <table id="myDataTable" class="table table-bordered table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Created_Date</th>
                    <th>@GlobalShared.Operation_Code</th>
                    <th>@GlobalShared.Branch_Name </th>
                    <th>@GlobalShared.Reference</th>
                    <th>@GlobalShared.Operation_By</th>
                    <th>@GlobalShared.Status</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
