@model IEnumerable<CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeCertification.ChequeCertificationDto>

<div class="card shadow-sm p-3" id="chequeCertificationTableContainer">
    <h5 class="text-primary mb-3">
        <i class="mdi mdi-table me-2"></i> Cheque Certifications
    </h5>

    <div class="table-responsive">
        <table id="myDataTable" class="table table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Cheque Cert. ID</th>
                    <th>Member Ref</th>
                    <th>Branch ID</th>
                    <th>Account No</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ChequeCertificationID</td>
                            <td>@item.MemberReference</td>
                            <td>@item.BranchId</td>
                            <td>@item.AccountNumber</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>
                                @{
                                    var statusBadgeClass = "bg-secondary";
                                    switch (item.CertificationStatus?.ToLower())
                                    {
                                        case "approved": statusBadgeClass = "bg-success"; break;
                                        case "rejected": statusBadgeClass = "bg-danger"; break;
                                        case "pending": statusBadgeClass = "bg-warning"; break;
                                        case "reviewed": statusBadgeClass = "bg-info"; break;
                                    }
                                }
                                <span class="badge @statusBadgeClass">@item.CertificationStatus</span>
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="ViewDetails('@item.ChequeCertificationID')"
                                            title="Cheque Certification Details">
                                        <i class="mdi mdi-book-information-variant me-1"></i> Details
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete('@item.ChequeCertificationID')"
                                            title="Delete Certification">
                                        <i class="mdi mdi-delete me-1"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No cheque certifications found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal for Details -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="detailsModalLabel">Cheque Certification Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
                <div class="text-center py-4">
                    <i class="mdi mdi-loading mdi-spin" style="font-size:24px"></i> Loading details...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p>Are you sure you want to delete this cheque certification?</p>
                <input type="hidden" id="deleteCertificationId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="deleteConfirmed()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    function ViewDetails(chequeCertificationID) {
        if (!chequeCertificationID) {
            toastr.error('Invalid ID');
            return;
        }

        $('#detailsModalBody').html('<div class="text-center py-4"><i class="mdi mdi-loading mdi-spin" style="font-size:24px"></i> Loading details...</div>');
        var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
        modal.show();

        $.ajax({
            url: '@Url.Action("Details", "ChequeCertification")',
            type: 'GET',
            data: { chequeCertificationID: chequeCertificationID },
            dataType: 'html',
            success: function (data) {
                $('#detailsModalBody').html(data);
            },
            error: function () {
                toastr.error('Error loading details');
                $('#detailsModalBody').html('<p class="text-danger">Failed to load details.</p>');
            }
        });
    }

    // Show confirmation modal
    function confirmDelete(chequeCertificationID) {
        $('#deleteCertificationId').val(chequeCertificationID);
        var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Proceed with delete after confirmation
    function deleteConfirmed() {
        var chequeCertificationID = $('#deleteCertificationId').val();
        if (!chequeCertificationID) {
            toastr.error('Invalid ID');
            return;
        }

        $.ajax({
            url: '@Url.Action("Delete", "ChequeCertification")',
            type: 'POST',
            data: { chequeCertificationID: chequeCertificationID },
            success: function (response) {
                toastr.success('Cheque certification deleted successfully');
                $('#deleteModal').modal('hide');
                location.reload(); // reload to refresh table
            },
            error: function () {
                toastr.error('Failed to delete cheque certification');
            }
        });
    }

    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#myDataTable')) {
            $('#myDataTable').DataTable().destroy();
        }

        $('#myDataTable').DataTable({
            pageLength: 10,
            responsive: true,
            ordering: true,
            searching: true,
            autoWidth: false,
            info: true,
            paging: true,
            columnDefs: [
                { "targets": -1, "orderable": false }
            ]
        });

        $('[data-bs-toggle="tooltip"]').tooltip();
    });
</script>
