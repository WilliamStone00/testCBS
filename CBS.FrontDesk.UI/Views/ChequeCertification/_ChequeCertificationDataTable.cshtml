@model IEnumerable<CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeCertification.ChequeCertificationDto>

<style>
    /* Table layout & spacing */
    #myDataTable {
        width: 100% !important;
        table-layout: auto;
    }

        #myDataTable th,
        #myDataTable td {
            vertical-align: middle;
            padding: 8px 12px;
        }

        /* Column specific classes */
        #myDataTable .amount-column {
            text-align: right !important;
            font-weight: 500;
        }

        #myDataTable .status-column {
            text-align: center !important;
        }

        #myDataTable .date-column {
            text-align: center !important;
        }

        #myDataTable .actions-column {
            text-align: center !important;
            white-space: nowrap;
        }

    .badge {
        font-size: 0.75em;
        padding: 4px 8px;
    }

    .btn-group-sm {
        flex-wrap: nowrap;
    }

        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
        }
</style>

<div class="table-responsive">
    <table id="myDataTable" class="table table-striped table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th width="12%">Cheque Certification ID</th>
                <th width="15%">Member Reference</th>
                <th width="12%">Branch ID</th>
                <th width="15%">Account Number</th>
                <th width="12%" class="text-end">Amount</th>
                <th width="12%" class="text-center">Status</th>
                <th width="14%" class="text-center">Created Date</th>
                <th width="20%" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <!-- match cells to headers and use ChequeCertificationID for actions -->
                        <td>@item.ChequeCertificationID</td>
                        <td>@item.MemberReference</td>
                        <td>@item.BranchId</td>
                        <td>@item.AccountNumber</td>
                        <td class="amount-column">@item.Amount.ToString("N2")</td>
                        <td class="status-column">
                            @{
                                var statusBadgeClass = "bg-secondary";
                                switch (item.CertificationStatus?.ToLower())
                                {
                                    case "approved": statusBadgeClass = "bg-success"; break;
                                    case "rejected": statusBadgeClass = "bg-danger"; break;
                                    case "pending": statusBadgeClass = "bg-warning"; break;
                                    case "reviewed": statusBadgeClass = "bg-info"; break;
                                }
                            }
                            <span class="badge @statusBadgeClass">@item.CertificationStatus</span>
                        </td>
                        <td class="date-column">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="actions-column">
                            <div class="btn-group btn-group-sm" role="group">
                                @*<button type="button"
                onclick="AddORUpdateGen('@item.ChequeCertificationID', 'datalistingview', '_ChequeCertificationForm', 'edit', 'ChequeCertification')"
                class="btn btn-outline-primary" data-bs-toggle="tooltip" title="Edit">
            <i class="mdi mdi-pencil"></i>
        </button>*@

                                <button type="button"
                                        onclick="ViewDetails('@item.ChequeCertificationID')"
                                        class="btn btn-outline-info" data-bs-toggle="tooltip" title="View Details">
                                    <i class="mdi mdi-eye"></i>
                                </button>

                                @*@if (item.CertificationStatus?.ToLower() == "pending")
        {
            <button type="button"
                    onclick="ReviewCertification('@item.ChequeCertificationID')"
                    class="btn btn-outline-warning" data-bs-toggle="tooltip" title="Review">
                <i class="mdi mdi-file-search"></i>
            </button>
        }

        @if (item.CertificationStatus?.ToLower() == "reviewed")
        {
            <button type="button"
                    onclick="ValidateCertification('@item.ChequeCertificationID')"
                    class="btn btn-outline-success" data-bs-toggle="tooltip" title="Validate">
                <i class="mdi mdi-check-circle"></i>
            </button>
            <button type="button"
                    onclick="RejectCertification('@item.ChequeCertificationID')"
                    class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Reject">
                <i class="mdi mdi-close-circle"></i>
            </button>
        }*@

                                @*<button type="button"
                                        onclick="DeleteCertification('@item.ChequeCertificationID')"
                                        class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Delete">
                                    <i class="mdi mdi-delete"></i>
                                </button>*@
                                <a href="#"
                                   onclick="DeleteRecordDataTable('ChequeCertification', '@item.ChequeCertificationID', 'myDataTable', '_ChequeCertificationDataTable', 0, 'datalistingview',null,'list')"
                                   class="mr-2 text-danger"
                                   data-toggle="tooltip"
                                   title="Delete">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No cheque certifications found</td>
                </tr>
            }
        </tbody>
    </table>
</div>

  
<script>
    // All functions now expect chequeCertificationID and send it to controller as chequeCertificationID

    function ViewDetails(chequeCertificationID) {
        if (!chequeCertificationID) {
            toastr.error('Invalid ID');
            return;
        }

        // show loader while fetching
       // $('#datalistingview').html('<div class="text-center py-4"><i class="mdi mdi-loading mdi-spin" style="font-size:24px"></i> Loading details...</div>');

        $.ajax({
            url: '@Url.Action("Details", "ChequeCertification")',
            type: 'GET',
            data: { chequeCertificationID: chequeCertificationID },
            dataType: 'html',
            success: function (data) {
                $('#datalistingview2').html(data);
                $('[data-bs-toggle="tooltip"]').tooltip();
                var top = $('#datalistingview').offset();
                if (top) window.scrollTo({ top: top.top - 10, behavior: 'smooth' });
            },
            error: function () {
                toastr.error('Error loading details');
            }
        });
    }

    function ReviewCertification(chequeCertificationID) {
        if (confirm('Are you sure you want to review this certification?')) {
            PerformAction('Review', chequeCertificationID);
        }
    }

    function ValidateCertification(chequeCertificationID) {
        if (confirm('Are you sure you want to validate this certification?')) {
            PerformAction('Validate', chequeCertificationID);
        }
    }

    function RejectCertification(chequeCertificationID) {
        if (confirm('Are you sure you want to reject this certification?')) {
            PerformAction('Reject', chequeCertificationID);
        }
    }

    function DeleteCertification(chequeCertificationID) {
        if (confirm('Are you sure you want to delete this certification?')) {
            PerformAction('Delete', chequeCertificationID);
        }
    }

    function PerformAction(action, chequeCertificationID) {
        $.ajax({
            url: '@Url.Action("Action", "ChequeCertification")' + '?action=' + action + '&chequeCertificationID=' + encodeURIComponent(chequeCertificationID),
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message);
                    // reload list - keep your LoadDataGen call if that exists
                    LoadDataGen('ChequeCertification', 'myDataTable', '_ChequeCertificationDataTable', 0, 'datalistingview', null, 'list');
                } else {
                    toastr.error(response.message || 'Operation failed');
                }
            },
            error: function () {
                toastr.error('Error performing action');
            }
        });
    }

    // Initialize DataTable with proper configuration
    $(document).ready(function () {
        // Destroy existing instance if it exists
        if ($.fn.DataTable.isDataTable('#myDataTable')) {
            $('#myDataTable').DataTable().destroy();
        }

        $('#myDataTable').DataTable({
            "pageLength": 10,
            "responsive": true,
            "ordering": true,
            "searching": true,
            "autoWidth": false,
            "info": true,
            "paging": true,
            "columnDefs": [
                { "width": "12%", "targets": 0 },
                { "width": "15%", "targets": 1 },
                { "width": "12%", "targets": 2 },
                { "width": "15%", "targets": 3 },
                { "width": "12%", "targets": 4 },
                { "width": "12%", "targets": 5 },
                { "width": "14%", "targets": 6 },
                { "width": "20%", "targets": 7, "orderable": false }
            ]
        });

        // Initialize tooltips
        $('[data-bs-toggle="tooltip"]').tooltip();
    });
</script>
