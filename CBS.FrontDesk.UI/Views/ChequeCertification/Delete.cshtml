@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeCertification.ChequeCertificationDto

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="card-title mb-0">
            <i class="mdi mdi-alert-circle me-2"></i> Delete Certification - @Model.ChequeCertificationID
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning d-flex align-items-center mb-4">
            <i class="mdi mdi-alert mdi-24px me-3"></i>
            <div>
                <h5 class="alert-heading mb-1">Warning: This action cannot be undone!</h5>
                <p class="mb-0">You are about to permanently delete this cheque certification record. This action will remove all associated data from the system.</p>
            </div>
        </div>

        <h6 class="mb-3 text-muted">Certification Details to be Deleted:</h6>

        <div class="row">
            <!-- Cheque Certification ID Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-danger h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                <span class="avatar-initial rounded bg-label-danger">
                                    <i class="mdi mdi-identifier mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">@Model.ChequeCertificationID</h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Cheque Certification ID</p>
                    </div>
                </div>
            </div>

            <!-- Member Reference Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-warning h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="mdi mdi-account mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">@Model.MemberReference</h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Member Reference</p>
                    </div>
                </div>
            </div>

            <!-- Account Number Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-info h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                <span class="avatar-initial rounded bg-label-info">
                                    <i class="mdi mdi-credit-card mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">@Model.AccountNumber</h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Account Number</p>
                    </div>
                </div>
            </div>

            <!-- Amount Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-primary h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                <span class="avatar-initial rounded bg-label-primary">
                                    <i class="mdi mdi-cash mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">@Model.Amount.ToString("N2")</h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Amount</p>
                    </div>
                </div>
            </div>

            <!-- Certification Status Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-secondary h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                @{
                                    var statusBadgeClass = "bg-label-secondary";
                                    switch (Model.CertificationStatus?.ToLower())
                                    {
                                        case "approved": statusBadgeClass = "bg-label-success"; break;
                                        case "rejected": statusBadgeClass = "bg-label-danger"; break;
                                        case "pending": statusBadgeClass = "bg-label-warning"; break;
                                        case "reviewed": statusBadgeClass = "bg-label-info"; break;
                                        default: statusBadgeClass = "bg-label-secondary"; break;
                                    }
                                }
                                <span class="avatar-initial rounded @statusBadgeClass">
                                    <i class="mdi mdi-check-circle mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">
                                @{
                                    var statusTextClass = "text-secondary";
                                    switch (Model.CertificationStatus?.ToLower())
                                    {
                                        case "approved": statusTextClass = "text-success"; break;
                                        case "rejected": statusTextClass = "text-danger"; break;
                                        case "pending": statusTextClass = "text-warning"; break;
                                        case "reviewed": statusTextClass = "text-info"; break;
                                        default: statusTextClass = "text-secondary"; break;
                                    }
                                }
                                <span class="@statusTextClass">@Model.CertificationStatus</span>
                            </h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Certification Status</p>
                    </div>
                </div>
            </div>

            <!-- Created Date Card -->
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card card-border-shadow-warning h-100" style="padding: 0.5rem;">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center mb-1 pb-1">
                            <div class="avatar me-1">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="mdi mdi-calendar mdi-16px"></i>
                                </span>
                            </div>
                            <h5 class="ms-1 mb-0" style="font-size: 1.2rem;">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</h5>
                        </div>
                        <p class="mb-0 text-heading" style="font-size: 0.85rem;">Created Date</p>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card card-border-shadow-info">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar me-2">
                                    <span class="avatar-initial rounded bg-label-info">
                                        <i class="mdi mdi-text mdi-16px"></i>
                                    </span>
                                </div>
                                <h5 class="mb-0">Description</h5>
                            </div>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Additional Warning for Specific Statuses -->
        @if (Model.CertificationStatus?.ToLower() == "approved")
        {
            <div class="alert alert-danger mt-4">
                <div class="d-flex align-items-center">
                    <i class="mdi mdi-alert-octagon mdi-24px me-3"></i>
                    <div>
                        <h6 class="mb-1">Special Notice: Approved Certification</h6>
                        <p class="mb-0">This certification has been approved. Deleting it may affect financial records and audit trails.</p>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card-footer bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <button type="button"
                    onclick="LoadDataGen('ChequeCertification', 'myDataTable', '_ChequeCertificationDataTable', 0, 'datalistingview', null, 'list')"
                    class="btn btn-secondary">
                <i class="mdi mdi-arrow-left me-1"></i> Back to List
            </button>

            <div class="d-flex align-items-center">
                <span class="text-muted me-3">Confirm deletion by typing:</span>
                <input type="text" id="deleteConfirmationText" class="form-control form-control-sm me-3"
                       placeholder="Type 'DELETE' to confirm" style="width: 180px;">

                <button type="button"
                        onclick="DeleteCertification('@Model.ChequeCertificationID')"
                        id="deleteButton"
                        class="btn btn-danger" disabled>
                    <i class="mdi mdi-delete me-1"></i> Delete Permanently
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Enable delete button only when user types "DELETE"
    document.getElementById('deleteConfirmationText').addEventListener('input', function() {
        var deleteButton = document.getElementById('deleteButton');
        deleteButton.disabled = this.value.toUpperCase() !== 'DELETE';
    });

    function DeleteCertification(certificationId) {
        if (confirm('Are you absolutely sure you want to delete this certification? This action cannot be undone.')) {
            // Show loading indicator
            var deleteButton = document.getElementById('deleteButton');
            var originalText = deleteButton.innerHTML;
            deleteButton.innerHTML = '<i class="mdi mdi-loading mdi-spin me-1"></i> Deleting...';
            deleteButton.disabled = true;

            // Call your deletion API/endpoint
            // Example:
            // fetch('/ChequeCertification/Delete/' + certificationId, { method: 'POST' })
            //     .then(response => {
            //         if (response.ok) {
            //             // Show success message and redirect
            //             ShowNotification('Certification deleted successfully', 'success');
            //             LoadDataGen('ChequeCertification', 'myDataTable', '_ChequeCertificationDataTable', 0, 'datalistingview', null, 'list');
            //         } else {
            //             throw new Error('Delete failed');
            //         }
            //     })
            //     .catch(error => {
            //         deleteButton.innerHTML = originalText;
            //         deleteButton.disabled = false;
            //         ShowNotification('Error deleting certification', 'error');
            //     });

            // For demo purposes, we'll simulate a successful deletion after 2 seconds
            setTimeout(function() {
                ShowNotification('Certification deleted successfully', 'success');
                LoadDataGen('ChequeCertification', 'myDataTable', '_ChequeCertificationDataTable', 0, 'datalistingview', null, 'list');
            }, 2000);
        }
    }

    function ShowNotification(message, type) {
        // Implement your notification system here
        alert(message); // Simple alert for demo
    }
</script>

<style>
    .card-border-shadow-danger {
        border: 1px solid #f5c2c7;
        box-shadow: 0 0.125rem 0.25rem rgba(220, 53, 69, 0.1);
    }

    .bg-label-danger {
        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

    .card-border-shadow-warning {
        border: 1px solid #ffd599;
        box-shadow: 0 0.125rem 0.25rem rgba(255, 193, 7, 0.1);
    }

    .bg-label-warning {
        background-color: #fff3cd !important;
        color: #856404 !important;
    }
</style>
