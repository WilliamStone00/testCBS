@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeCertification.ChequeCertificationDto
@using Resources
<style>
    .section-header {
        font-weight: bold;
        color: #4CAF50;
        margin-top: 1rem;
        margin-bottom: .5rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .table-sm th.bg-label {
        background-color: #EDEDED;
        width: 200px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }
</style>

<div class="px-3 py-2">

    <!-- 🔷 Cheque Certification Header -->
    <h5 class="fw-bold text-uppercase text-primary border-bottom mb-3">
        <i class="mdi mdi-checkbook me-1"></i> @ChequeCertificationResource.Cheque_Certification_Details
    </h5>

    <!-- 🔷 Certification Information -->
    <h6 class="fw-bold border-bottom text-primary">
        <i class="mdi mdi-certificate me-1"></i> @ChequeCertificationResource.Certification_Information
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr>
                <th class="bg-light" style="width: 220px;">@ChequeCertificationResource.Certification_ID</th>
                <td>@Model.ChequeCertificationID</td>
            </tr>
            <tr>
                <th class="bg-light">@GlobalShared.Member_reference</th>
                <td>@Model.MemberReference</td>
            </tr>
            <tr>
                <th class="bg-light">@GlobalShared.Certification_Status</th>
                <td>
                    @{
                        var statusBadgeClass = "badge bg-secondary";
                        switch (Model.CertificationStatus?.ToLower())
                        {
                            case "approved": statusBadgeClass = "badge bg-success"; break;
                            case "rejected": statusBadgeClass = "badge bg-danger"; break;
                            case "pending": statusBadgeClass = "badge bg-warning"; break;
                            case "reviewed": statusBadgeClass = "badge bg-info"; break;
                            default: statusBadgeClass = "badge bg-secondary"; break;
                        }
                    }
                    <span class="@statusBadgeClass">@Model.CertificationStatus</span>
                </td>
            </tr>
            <tr>
                <th class="bg-light">@GlobalShared.Created_Date</th>
                <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </tbody>
    </table>

    <!-- 🔷 Cheque Details -->
    <h6 class="fw-bold border-bottom text-primary">
        <i class="mdi mdi-checkbook-outline me-1"></i> @ChequeCertificationResource.Cheque_Details
    </h6>
    <table class="table table-sm table-bordered mb-3">
        <tbody>
            <tr>
                <th class="bg-light" style="width: 220px;">@GlobalShared.Branch_ID</th>
                <td>@Model.BranchId</td>
            </tr>
            <tr>
                <th class="bg-light">@ChequeCertificationResource.Cheque_Book_ID</th>
                <td>@Model.ChequeBookId</td>
            </tr>
            <tr>
                <th class="bg-light">@ChequeCertificationResource.Cheque_Leaf_ID</th>
                <td>@Model.ChequeleafId</td>
            </tr>
            <tr>
                <th class="bg-light">@GlobalShared.Account_Number</th>
                <td>@Model.AccountNumber</td>
            </tr>
            <tr>
                <th class="bg-light">@GlobalShared.Amount</th>
                <td><strong>@Model.Amount.ToString("N2") FCFA</strong></td>
            </tr>
        </tbody>
    </table>

    <!-- 🔷 Description (if available) -->
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h6 class="fw-bold border-bottom text-primary">
            <i class="mdi mdi-text-box-outline me-1"></i> @GlobalShared.Description
        </h6>
        <table class="table table-sm table-bordered mb-3">
            <tbody>
                <tr>
                    <th class="bg-light" style="width: 220px;">@GlobalShared.Description</th>
                    <td>@Model.Description</td>
                </tr>
            </tbody>
        </table>
    }

</div>

