@{
    ViewBag.Title = "Create Cheque Certification";
}
@using Resources

@model CBS.FrontDesk.Data.Entity.CheckManagementSystem.ChequeCertification.ChequeCertificationDto

<div class="card-header">
    <h5 class="card-title mb-0 text-success text-start">
        <i class="mdi mdi-plus-circle me-2 text-success"></i> Certification Details
    </h5>
</div>


<div class="card-body">
    @using (Html.BeginForm("Create", "ChequeCertification", FormMethod.Post, new { id = "createCertificationForm", @class = "needs-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(model => model.ChequeCertificationID, new { @class = "form-label required" })
                <div class="input-group">
                    <span class="input-group-text"><i class="mdi mdi-account"></i></span>
                    @Html.TextBoxFor(model => model.ChequeCertificationID, new
                    {
                        @class = "form-control",
                        required = "required",
                        placeholder = "Enter Cheque Certification ID",
                        maxlength = "50"
                    })
                </div>
                @Html.ValidationMessageFor(model => model.ChequeCertificationID, "", new { @class = "text-danger" })
                <small class="form-text text-muted">Unique identifier for the member</small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(model => model.MemberReference, new { @class = "form-label required" })
                <div class="input-group">
                    <span class="input-group-text"><i class="mdi mdi-account"></i></span>
                    @Html.TextBoxFor(model => model.MemberReference, new
                    {
                        @class = "form-control",
                        required = "required",
                        placeholder = "Enter member reference",
                        maxlength = "50"
                    })
                </div>
                @Html.ValidationMessageFor(model => model.MemberReference, "", new { @class = "text-danger" })
                <small class="form-text text-muted"> identifier for the member</small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(model => model.BranchId, new { @class = "form-label required" })
                <div class="input-group">
                    <span class="input-group-text"><i class="mdi mdi-bank"></i></span>
                    @Html.TextBoxFor(model => model.BranchId, new
                    {
                        @class = "form-control",
                        required = "required",
                        placeholder = "Enter branch ID",
                        maxlength = "20"
                    })
                </div>
                @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                <small class="form-text text-muted">Branch where cheque was issued</small>
            </div>
        </div>
    </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(model => model.ChequeBookId, new { @class = "form-label required" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="mdi mdi-book-open"></i></span>
                        @Html.TextBoxFor(model => model.ChequeBookId, new
                        {
                            @class = "form-control",
                            required = "required",
                            placeholder = "Enter cheque book ID",
                            maxlength = "30"
                        })
                    </div>
                    @Html.ValidationMessageFor(model => model.ChequeBookId, "", new { @class = "text-danger" })
                    <small class="form-text text-muted">Cheque book identifier</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(model => model.ChequeleafId, new { @class = "form-label required" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="mdi mdi-file-document"></i></span>
                        @Html.TextBoxFor(model => model.ChequeleafId, new
                        {
                            @class = "form-control",
                            required = "required",
                            placeholder = "Enter cheque leaf ID",
                            maxlength = "30"
                        })
                    </div>
                    @Html.ValidationMessageFor(model => model.ChequeleafId, "", new { @class = "text-danger" })
                    <small class="form-text text-muted">Specific leaf identifier</small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(model => model.AccountNumber, new { @class = "form-label required" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="mdi mdi-credit-card"></i></span>
                        @Html.TextBoxFor(model => model.AccountNumber, new
                        {
                            @class = "form-control",
                            required = "required",
                            placeholder = "Enter account number",
                            maxlength = "20"
                        })
                    </div>
                    @Html.ValidationMessageFor(model => model.AccountNumber, "", new { @class = "text-danger" })
                    <small class="form-text text-muted">Account associated with the cheque</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    @Html.LabelFor(model => model.Amount, new { @class = "form-label required" })
                    <div class="input-group">
                        <span class="input-group-text">₦</span>
                        @Html.TextBoxFor(model => model.Amount, new
                        {
                            @class = "form-control",
                            type = "number",
                            step = "0.01",
                            required = "required",
                            placeholder = "0.00",
                            min = "0.01"
                        })
                    </div>
                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                    <small class="form-text text-muted">Cheque amount (must be greater than 0)</small>
                </div>
            </div>
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.Description, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="mdi mdi-text"></i></span>
                @Html.TextAreaFor(model => model.Description, new
                {
                    @class = "form-control",
                    rows = 4,
                    placeholder = "Enter certification description or notes",
                    maxlength = "500"
                })
            </div>
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            <small class="form-text text-muted">Optional description or additional notes (max 500 characters)</small>
        </div>

        <div class="alert alert-warning">
            <i class="mdi mdi-alert-circle-outline me-2"></i>
            <strong>Please verify all information</strong> before submitting. Once created, the certification will be set to "Pending" status.
        </div>
    }
</div>


    <div class="d-flex justify-content-between align-items-center">

        @*<a href="@Url.Action("Index", "ChequeCertification")" class="btn btn-secondary">
            <i class="mdi mdi-arrow-left me-1"></i> Back to List
        </a>*@


        <div>
            <button type="reset" form="createCertificationForm" class="btn btn-light me-2">
                <i class="mdi mdi-refresh me-1"></i> Reset
            </button>
            <button type="submit" form="createCertificationForm" class="btn btn-primary">
                <i class="mdi mdi-content-save me-1"></i> Create Certification
            </button>
        </div>
    </div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Form validation
            $('#createCertificationForm').on('submit', function (e) {
                e.preventDefault();

                if (this.checkValidity() === false) {
                    e.stopPropagation();
                    this.classList.add('was-validated');
                    return;
                }

                // Show loading state
                var submitBtn = $(this).find('button[type="submit"]');
                var originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="mdi mdi-loading mdi-spin me-1"></i> Creating...');

                // Submit form via AJAX
                $.ajax({
                    url: '@Url.Action("Create", "ChequeCertification")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            // Redirect to index page after successful creation
                            setTimeout(function () {
                                window.location.href = '@Url.Action("Index", "ChequeCertification")';
                            }, 1500);
                        } else {
                            toastr.error(response.message);
                            submitBtn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function (xhr, status, error) {
                        toastr.error('An error occurred while creating the certification: ' + error);
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            });

            // Real-time validation
            $('input, textarea').on('blur', function () {
                $(this).addClass('validated');
            });

            // Amount formatting
            $('#Amount').on('change', function () {
                var value = parseFloat($(this).val());
                if (value && !isNaN(value)) {
                    $(this).val(value.toFixed(2));
                }
            });
        });

        function resetForm() {
            if (confirm('Are you sure you want to reset all fields?')) {
                $('#createCertificationForm')[0].reset();
                $('#createCertificationForm').removeClass('was-validated');
                toastr.info('Form has been reset');
            }
        }

        // Input restrictions
        $('#Amount').on('input', function () {
            var value = $(this).val();
            if (value && parseFloat(value) <= 0) {
                $(this).addClass('is-invalid');
            } else {
                $(this).removeClass('is-invalid');
            }
        });
    </script>
}

<style>
    .required::after {
        content: " *";
        color: #dc3545;
    }

    .form-control.validated:invalid {
        border-color: #dc3545;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6.4.4.4-.4'/%3e%3cpath d='M6 7v2'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .form-control.validated:valid {
        border-color: #198754;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #ced4da;
    }
</style>