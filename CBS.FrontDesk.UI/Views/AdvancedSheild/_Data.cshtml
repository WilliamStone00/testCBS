@model List<CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitConfig>
@using Resources
<fieldset class="fieldset-custom">
    <legend id="select_base">@AdvancedShield.RATE_LIMIT_CONFIGURATIONS</legend>

    @if (!Model.Any())
    {
        <div class="text-center my-3">
            <p>@AdvancedShield.No_rate_limit_configurations_have_been_defined_yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-hover table-bordered align-middle" id="myDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 10%;">Req/User</th>
                        <th style="width: 10%;">Window (s)</th>
                        <th style="width: 10%;">Block (min)</th>
                        <th style="width: 10%;">Req/IP</th>
                        <th style="width: 10%;">IP Window (s)</th>
                        <th style="width: 35%;">Whitelisted Countries</th>
                        <th style="width: 10%;">Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RequestLimit</td>
                            <td>@item.TimeWindowSeconds</td>
                            <td>@item.BlockDurationMinutes</td>
                            <td>@item.IPRequestLimit</td>
                            <td>@item.IPTimeWindowSeconds</td>
                            <td>
                                @if (item.WhitelistedCountriesCode != null && item.WhitelistedCountriesCode.Any())
                                {
                                    <ul class="mb-0 ps-3 small">
                                        @foreach (var header in item.WhitelistedCountriesCode)
                                        {
                                            <li>@header</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">@GlobalShared.None</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="AddORUpdateGen('@item.Id', 'datalistingview', '_Create', 'update', 'AdvancedSheild')"
                                            data-bs-toggle="tooltip"
                                            title="Edit Config">
                                        <i class="fas fa-edit me-1"></i> @GlobalShared.Edit
                                    </button>

                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="DeleteDynamic('AdvancedSheild','Delete','@item.Id','myDataTable','_Data', 2,'datalistingview')"
                                            data-bs-toggle="tooltip"
                                            title="Delete Config">
                                        <i class="fas fa-trash-alt me-1"></i> @GlobalShared.Reset
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</fieldset>
