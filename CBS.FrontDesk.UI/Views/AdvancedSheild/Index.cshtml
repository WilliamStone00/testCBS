@{
    ViewBag.Title = "TSC Advanced Security Shield - Rate Limiting & DDoS Protection";
}
@using Resources
<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-lock-outline me-2"></i> @AdvancedShield.TSC_Advanced_Security_Shield
                </h1>
                <p class="card-text">
                    @AdvancedShield.The_TSC_Advanced_Security_Shield_enables_administrators_to_define_and_enforce_robust_rate_limiting.
                    <br /><br />
                    @AdvancedShield.With_support_for_country_based_whitelisting_CIDR_filtering_suspicious_request_inspection.
                    <br /><br />
                    @AdvancedShield.Fine_tune_request_thresholds_block_durations_and_enforce_countr_IP_alignment_using_white_listed_ISO_codes_and_CIDRs.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

@Html.Partial("_PolicyTips")

<div class="d-flex justify-content-end mb-2">
    <a type="button" onclick="LoadDataGen('AdvancedSheild','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View Existing Configs">
        <i class="mdi mdi-view-list mdi-18px"></i> @GlobalShared.ViewList
    </a>
    <a href="/AdvancedSheild" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Config">
        <i class="mdi mdi-plus mdi-18px"></i> @GlobalShared.AddConfig
    </a>
</div>

<!-- Configuration Notice -->
<div class="alert alert-info mt-3 mb-2">
    <strong>@GlobalShared.Notice:</strong> @AdvancedShield.TSC_allows_only <u>@AdvancedShield.one_global_security_configuration</u> @AdvancedShield.at_a_time_Edit_or_enhance_the_existing_configuration_below_Delete_to_Reset_the_configuration_to_default.
</div>

<!-- Main Config View -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div class="card-body" id="datalistingview">
                @Html.Partial("_Create")
            </div>
        </div>
    </div>
</div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
