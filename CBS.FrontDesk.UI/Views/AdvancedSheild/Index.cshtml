@{
    ViewBag.Title = "TSC Advanced Security Shield - Rate Limiting & DDoS Protection";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-shield-lock-outline me-2"></i> TSC Advanced Security Shield
                </h1>
                <p class="card-text">
                    The TSC Advanced Security Shield enables administrators to define and enforce robust rate-limiting and traffic filtering rules to protect core banking and API services from unauthorized or malicious access. These settings are designed to counter DDoS attacks, brute-force attempts, traffic flooding, and automated exploit scans.
                    <br /><br />
                    With support for country-based whitelisting, CIDR filtering, suspicious request inspection, bad User-Agent blocking, and trusted header exemptions, this shield ensures that only verified and geo-authorized clients can interact with your system.
                    <br /><br />
                    Fine-tune request thresholds, block durations, and enforce country-IP alignment using white-listed ISO codes and CIDRs. The configuration is globally scoped—only one active security policy is permitted at a time to ensure system integrity.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>

@Html.Partial("_PolicyTips")

<div class="d-flex justify-content-end mb-2">
    <a type="button" onclick="LoadDataGen('AdvancedSheild','myDataTable','_Data',0,'datalistingview')" class="btn btn-label-primary btn-sm me-2" data-bs-toggle="tooltip" title="View Existing Configs">
        <i class="mdi mdi-view-list mdi-18px"></i> View List
    </a>
    <a href="/AdvancedSheild" class="btn btn-label-secondary btn-sm" data-bs-toggle="tooltip" title="Add New Config">
        <i class="mdi mdi-plus mdi-18px"></i> Add Config
    </a>
</div>

<!-- Configuration Notice -->
<div class="alert alert-info mt-3 mb-2">
    <strong>Notice:</strong> TSC allows only <u>one global security configuration</u> at a time. Edit or enhance the existing configuration below. Delete to Reset the configuration to default.
</div>

<!-- Main Config View -->
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12">
        <div class="card shadow-sm">
            <div class="card-body" id="datalistingview">
                @Html.Partial("_Create")
            </div>
        </div>
    </div>
</div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
