@model CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitConfig

<fieldset class="fieldset-custom">
    <legend id="select_base">RATE LIMIT CONFIGURATION</legend>
    <div class="card-body">
        @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
        {
            enctype = "multipart/form-data",
            onsubmit = "return AjaxPostAndUpdate(this);"
        }))
        {
            <!-- 1. User/Session Rate Limiting -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-account-outline me-2"></i> User/Session Rate Limit
                </div>
                <div class="card-body row gy-3">
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.RequestLimit, new { @class = "form-control", type = "number", min = 1, required = "required" })
                            @Html.ValidationMessageFor(m => m.RequestLimit, "", new { @class = "text-danger" })
                            <label for="RequestLimit">Request Limit</label>
                            <small class="form-text text-muted">
                                Maximum number of requests allowed per session within the time window. Example: <code>50</code>
                            </small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.TimeWindowSeconds, new { @class = "form-control", type = "number", min = 1, required = "required" })
                            @Html.ValidationMessageFor(m => m.TimeWindowSeconds, "", new { @class = "text-danger" })
                            <label for="TimeWindowSeconds">Time Window (seconds)</label>
                            <small class="form-text text-muted">
                                Time period (in seconds) during which requests are counted. Example: <code>60</code> seconds
                            </small>
                        </div>
                    </div>

                </div>
            </div>

            <!-- 2. IP-Based Rate Limiting -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-lan-connect me-2"></i> IP-Based Rate Limit
                </div>
                <div class="card-body row gy-3">
                    <!-- Max Requests Per IP -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.IPRequestLimit, new { @class = "form-control", type = "number", min = 1 })
                            @Html.ValidationMessageFor(m => m.IPRequestLimit, "", new { @class = "text-danger" })
                            <label for="IPRequestLimit">IP Request Limit</label>
                            <small class="form-text text-muted">
                                Defines the number of allowed requests per IP address within the given window. Example: <code>100</code>
                            </small>
                        </div>
                    </div>

                    <!-- Time Window -->
                    <div class="col-md-6">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.IPTimeWindowSeconds, new { @class = "form-control", type = "number", min = 1 })
                            @Html.ValidationMessageFor(m => m.IPTimeWindowSeconds, "", new { @class = "text-danger" })
                            <label for="IPTimeWindowSeconds">IP Time Window (seconds)</label>
                            <small class="form-text text-muted">
                                Time period (in seconds) to observe request count per IP. Example: <code>30</code>
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-lock-clock-outline me-2"></i> Rate Limit Block Duration
                </div>
                <div class="card-body row gy-3">
                    <div class="col-md-12">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(m => m.BlockDurationMinutes, new { @class = "form-control", type = "number", min = 1, required = "required" })
                            @Html.ValidationMessageFor(m => m.BlockDurationMinutes, "", new { @class = "text-danger" })
                            <label for="BlockDurationMinutes">Block Duration (minutes)</label>
                            <small class="form-text text-muted">
                                Specifies how long (in minutes) a user or IP will be prevented from accessing the system after exceeding defined rate limits.
                                Applies to both session-based and IP-based thresholds. This helps throttle abusive behavior and reduce repeated attacks.
                                <br />Example: <code>15</code> (means a user or IP will be blocked for 15 minutes).
                            </small>
                        </div>
                    </div>
                </div>
            </div>



            <!-- 3. Header Whitelist -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-shield-check-outline me-2"></i> Header Whitelist
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("WhitelistedHeadersInput",
                                       Model.WhitelistedHeaders != null ? string.Join("\n", Model.WhitelistedHeaders) : "",
                                       new { @class = "form-control", style = "height: 120px;", placeholder = "X-Internal-Request\nX-Bypass-Limit" })
                        <label for="WhitelistedHeadersInput">Whitelisted Headers (one per line)</label>
                        @Html.ValidationMessage("WhitelistedHeadersInput", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Requests containing any of these headers will bypass rate limiting. Use only trusted internal headers.<br />
                            Example: <code>X-Internal-Request</code>, <code>X-Bypass-Limit</code>
                        </small>
                    </div>
                </div>
            </div>


            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-map-marker-radius-outline me-2"></i> White listed Countries
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.ListBox("WhiteListedCountriesCode", new MultiSelectList(ViewBag.CountriesCode, "Id", "Name"), new { @class = "form-control select2", id = "roleIds", multiple = "multiple" })
                        <label for="WhiteListedCountriesCode">Select countries to be white listed</label>
                        <small class="form-text text-muted">
                            Select ISO 3166-1 alpha-2 country codes (e.g., <code>CM</code> for Cameroon, <code>NG</code> for Nigeria, <code>FR</code> for France).<br />
                            Only requests originating from these countries will be allowed if GeoIP filtering is enabled.
                        </small>
                        @Html.ValidationMessageFor(m => m.WhiteListedCountriesCode, "", new { @class = "text-danger" })

                    </div>
                </div>
            </div>

            <!-- 4. CIDRs -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-map-marker-radius-outline me-2"></i> Whitelisted CIDR Ranges
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("CameroonCidrs",
                                       Model.CameroonCidrs != null ? string.Join("\n", Model.CameroonCidrs) : "",
                                       new { @class = "form-control", style = "height: 120px;", placeholder = "41.202.64.0/18\n102.244.128.0/18\n105.112.5.45/32" })
                        <label for="CameroonCidrs">Whitelisted CIDR Blocks (one per line)</label>
                        @Html.ValidationMessage("CameroonCidrs", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Enter one CIDR block per line. Both ranges and single IPs are allowed.<br />
                            Example (range): <code>102.244.128.0/18</code><br />
                            Example (single IP): <code>105.112.5.45/32</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 5. Suspicious Indicators -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-alert-circle-outline me-2"></i> Suspicious Indicators
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("SuspiciousIndicators",
                                       Model.SuspiciousIndicators != null ? string.Join("\n", Model.SuspiciousIndicators) : "",
                                       new { @class = "form-control", style = "height: 120px;", placeholder = "sqlmap\ncurl\nbot" })
                        <label for="SuspiciousIndicators">Suspicious Indicators (one per line)</label>
                        @Html.ValidationMessage("SuspiciousIndicators", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Enter one keyword or filename per line that should be flagged during security scans.<br />
                            These values will be matched against request paths, headers, and payloads.<br />
                            Example: <code>shell.php</code>, <code>wp-login</code>, <code>curl</code>, <code>sqlmap</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 6. Excluded Paths -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-minus-box-outline me-2"></i> Excluded Paths
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("ExcludedPaths",
                                       Model.ExcludedPaths != null ? string.Join("\n", Model.ExcludedPaths) : "",
                                       new { @class = "form-control", style = "height: 100px;", placeholder = "/healthz\n/api/keepalive" })
                        <label for="ExcludedPaths">Excluded Request Paths (one per line)</label>
                        @Html.ValidationMessage("ExcludedPaths", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Specify full or partial request paths that should bypass all security filtering rules (rate limit, geo checks, etc.).<br />
                            Example: <code>/healthz</code>, <code>/api/keepalive</code>, <code>/signalr/hubs</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 7. Excluded Substrings -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-filter-minus-outline me-2"></i> Excluded Substrings
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("ExcludedSubstrings",
                                       Model.ExcludedSubstrings != null ? string.Join("\n", Model.ExcludedSubstrings) : "",
                                       new { @class = "form-control", style = "height: 100px;", placeholder = "/internal/\n/status-check" })
                        <label for="ExcludedSubstrings">Excluded Substrings (one per line)</label>
                        @Html.ValidationMessage("ExcludedSubstrings", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Requests containing any of these substrings in the path will bypass security checks.<br />
                            Example: <code>/internal/</code>, <code>/status-check</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 8. Excluded Extensions -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-file-outline me-2"></i> Excluded File Extensions
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("ExcludedExtensions",
                                       Model.ExcludedExtensions != null ? string.Join("\n", Model.ExcludedExtensions) : "",
                                       new { @class = "form-control", style = "height: 100px;", placeholder = ".css\n.js\n.png" })
                        <label for="ExcludedExtensions">Excluded File Extensions (one per line)</label>
                        @Html.ValidationMessage("ExcludedExtensions", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Requests ending in these file extensions will be bypassed from WAF checks.<br />
                            Example: <code>.css</code>, <code>.js</code>, <code>.png</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 9. Bad User-Agents -->
            <div class="card mb-3 border shadow-sm">
                <div class="card-header bg-light fw-bold text-uppercase text-dark">
                    <i class="mdi mdi-account-off-outline me-2"></i> Bad User-Agents
                </div>
                <div class="card-body">
                    <div class="form-floating form-floating-outline">
                        @Html.TextArea("BadUserAgents",
                                       Model.BadUserAgents != null ? string.Join("\n", Model.BadUserAgents) : "",
                                       new { @class = "form-control", style = "height: 120px;", placeholder = "curl\npython-requests\nlibwww-perl" })
                        <label for="BadUserAgents">User-Agent Signatures to Block (one per line)</label>
                        @Html.ValidationMessage("BadUserAgents", "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            Requests containing these substrings in the User-Agent header will be automatically blocked.<br />
                            Example: <code>curl</code>, <code>python-requests</code>, <code>libwww-perl</code>
                        </small>
                    </div>
                </div>
            </div>


            <!-- 10. Action Buttons -->
            <div class="mt-4">
                @Html.HiddenFor(m => m.Id)
                @if (Model.Id == null)
                {
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <input type="hidden" name="Action" value="insert" id="Action" />
                }
                else
                {
                    <button type="submit" class="btn btn-primary me-2">Update</button>
                    <input type="hidden" name="Action" value="update" id="Action" />
                }
            </div>
        }
    </div>
</fieldset>
