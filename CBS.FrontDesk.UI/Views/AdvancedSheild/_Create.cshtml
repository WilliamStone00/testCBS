@model CBS.FrontDesk.Data.Entity.RequestManagement.RateLimitConfig
    @using Resources

<fieldset class="fieldset-custom">
    <legend class="fw-bold">@AdvancedShield.Web_Application_Firewall_Rate_Limiting_Settings</legend>
    <div class="accordion" id="rateLimitAccordion">

        <!-- 1. RATE LIMITING CONFIGURATION (OPEN by default) -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingRateLimit">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRateLimit" aria-expanded="true">
                    <i class="mdi mdi-speedometer me-2 text-primary"></i> @AdvancedShield.Rate_Limiting_Configuration
                </button>
            </h2>
            <div id="collapseRateLimit" class="accordion-collapse collapse show" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p>
                        @AdvancedShield.Configure_thresholds_to_limit_the_number_of_requests_allowed
                        @AdvancedShield.These_rules_help_protect_your_system_against_dos
                    </p>

                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">
                            <!-- Session Request Limit -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.RequestLimit, new { @class = "form-control", type = "number", min = 1, required = "required" })
                                    @Html.ValidationMessageFor(m => m.RequestLimit, "", new { @class = "text-danger" })
                                    <label for="RequestLimit">@AdvancedShield.Session_Request_Limit</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Maximum_number_of_requests_allowed_per_user_session: <code>50</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Session Time Window -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.TimeWindowSeconds, new { @class = "form-control", type = "number", min = 1, required = "required" })
                                    @Html.ValidationMessageFor(m => m.TimeWindowSeconds, "", new { @class = "text-danger" })
                                    <label for="TimeWindowSeconds">@AdvancedShield.Session_Time_Window_seconds</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Time_interval_during_which_the_above_session_request_limit_is_enforced: <code>60</code>
                                    </small>
                                </div>
                            </div>

                            <!-- IP Request Limit -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.IPRequestLimit, new { @class = "form-control", type = "number", min = 1 })
                                    @Html.ValidationMessageFor(m => m.IPRequestLimit, "", new { @class = "text-danger" })
                                    <label for="IPRequestLimit">@AdvancedShield.IP_Request_Limit</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Number_of_allowed_requests_from_a_single_IP_address_before_it_is_rate_limited. Example: <code>100</code>
                                    </small>
                                </div>
                            </div>

                            <!-- IP Time Window -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.IPTimeWindowSeconds, new { @class = "form-control", type = "number", min = 1 })
                                    @Html.ValidationMessageFor(m => m.IPTimeWindowSeconds, "", new { @class = "text-danger" })
                                    <label for="IPTimeWindowSeconds">@AdvancedShield.IP_Time_Window_Seconds</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Time_window_in_seconds_to_apply_the_IP_based_request_limit. Example: <code>30</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Block Duration -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.BlockDurationMinutes, new { @class = "form-control", type = "number", min = 1, required = "required" })
                                    @Html.ValidationMessageFor(m => m.BlockDurationMinutes, "", new { @class = "text-danger" })
                                    <label for="BlockDurationMinutes">@AdvancedShield.Block_Duration (minutes)</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Duration_in_minutes_for_which_an_IP_or_session_should_be_blocked_after_exceeding_rate_limits.
                                        @AdvancedShield.Helps_reduce_repeated_abuse. Example: <code>15</code>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="RATE_LIMITING" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="RATE_LIMITING" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- 2. GEOIP & CIDR WHITELISTING -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingGeoIP">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGeoIP" aria-expanded="false">
                    <i class="mdi mdi-map-marker-radius-outline me-2 text-success"></i> GeoIP & CIDR Whitelisting
                </button>
            </h2>
            <div id="collapseGeoIP" class="accordion-collapse collapse" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p>
                        @AdvancedShield.Use_this_section_to_define_allowed_geographic_regions_and_IP_address_ranges.
                        @AdvancedShield.CIDR_ranges_are_used_to_explicitly_allow_traffic_from_known_I_blocks_such_as_internal_networks_or_trusted_partners.
                    </p>

                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">
                            <!-- Whitelisted Countries -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.ListBox("WhitelistedCountriesCode", new MultiSelectList(ViewBag.CountriesCode, "Id", "Name"), new { @class = "form-control select2", id = "roleIds", multiple = "multiple" })
                                    <label for="WhiteListedCountriesCode">@AdvancedShield.Whitelisted_Countries</label>
                                    @Html.ValidationMessageFor(m => m.WhitelistedCountriesCode, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">
                                    @AdvancedShield.Select_ISO_3166_1_alpha2_codes_for_countries_from_which_requests_should_be_allowed.
                                    <br />
                                    Examples:
                                    <code>CM</code> (Cameroon), <code>NG</code> (Nigeria), <code>FR</code> (France)
                                </small>
                                </div>
                            </div>

                            <!-- Cameroon CIDRs -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("WhitelistedCidrs",
                                                   Model.WhitelistedCidrs != null ? string.Join("\n", Model.WhitelistedCidrs) : "",
                                                   new { @class = "form-control", style = "height: 120px;", placeholder = "41.202.64.0/18\n102.244.128.0/18\n105.112.5.45/32" })
                                    <label for="WhitelistedCidrs">Whitelisted CIDR Blocks</label>
                                    @Html.ValidationMessage("WhitelistedCidrs", "", new { @class = "text-danger" })
                                <small class="form-text text-muted">
                                    @AdvancedShield.Enter_trusted_IP_ranges_to_allow_requests_regardless_o_GeoIP_lookup.
                                    <br />
                                    Examples:
                                    <code>102.244.128.0/18</code> (range), <code>105.112.5.45/32</code> (single IP)
                                </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="GEO_CIDR_WHITELISTING" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="GEO_CIDR_WHITELISTING" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- 3. HEADER VALIDATION & BOT DETECTION -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingHeaderValidation">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHeaderValidation" aria-expanded="false">
                    <i class="mdi mdi-shield-search-outline me-2 text-danger"></i> @AdvancedShield.Header_Validation_Bot_Detection
                </button>
            </h2>
            <div id="collapseHeaderValidation" class="accordion-collapse collapse" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p class="mb-3">
                        @AdvancedShield.This_section_allows_you_to_enforce_advanced_header_level_inspections_to_detect_malformed.
                        @AdvancedShield.It_protects_the_application_from_scanners_telemetry_systems_header_based_injection_attempts_and_unauthorized_cross_origin_requests.
                        @AdvancedShield.The <strong>Header Validation & Bot Detection</strong> module strengthens your application's perimeter by analyzing HTTP request headers for tampering, spoofing, or automation indicators. It inspects key headers like <code>User-Agent</code>, <code>Origin</code>, <code>Referer</code>, and <code>X-Forwarded-For</code> to detect:
                    </p>
                    <ul class="text-muted">
                        <li>🧠 <strong>@AdvancedShield.Bot_an_scanner_signatures</strong> (e.g., <code>curl</code>, <code>wget</code>, @AdvancedShield.penetration_tools)</li>
                        <li>🚫 <strong>@AdvancedShield.Spoofed_or_malformed_header_values</strong> that can bypass access rules</li>
                        <li>🔐 <strong>@AdvancedShield.Missing or forged CORS origins and referers</strong> on protected resources</li>
                        <li>🕵️‍♂️ <strong>@AdvancedShield.Telemetry and tracing headers</strong> used by bots and monitoring tools</li>
                        <li>🧱 <strong>@AdvancedShield.High-risk internal headers</strong> often abused in SSRF and path-based injection attacks</li>
                    </ul>
                    <p class="mb-0">
                        @AdvancedShield.Use_this_section_to_configure_allowlists_regex_validation_patterns_and_enforce_referer_origin_policies_for_sensitive_endpoints.
                    </p>


                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">
                            <!-- Whitelisted Headers -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("WhitelistedHeaders", Model.WhitelistedHeaders != null ? string.Join("\n", Model.WhitelistedHeaders) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "X-Service-Token\nX-Internal-Request" })
                                    <label for="WhitelistedHeaders">@AdvancedShield.Whitelisted_Headers</label>
                                    @Html.ValidationMessage("WhitelistedHeaders", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Headers_that_are_explicitly_allowed_and_should_never_trigger_filtering.
                                        <br />Examples: <code>X-Service-Token</code>, <code>X-Internal-Request</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Protected Path Referer Required -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("ProtectedPathRefererRequired", Model.ProtectedPathRefererRequired != null ? string.Join("\n", Model.ProtectedPathRefererRequired) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "/admin\n/settings\n/config" })
                                    <label for="ProtectedPathRefererRequired">@AdvancedShield.Protected_Path_Referer_Requirements</label>
                                    @Html.ValidationMessage("ProtectedPathRefererRequired", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Paths that require a matching <code>Referer</code> header to be present.
                                        <br />Examples: <code>/admin</code>, <code>/settings</code>, <code>/config</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Sensitive Header Missing Check Paths -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("SensitiveHeaderMissingCheckPaths", Model.SensitiveHeaderMissingCheckPaths != null ? string.Join("\n", Model.SensitiveHeaderMissingCheckPaths) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "/api/token\n/transaction/submit" })
                                    <label for="SensitiveHeaderMissingCheckPaths">@AdvancedShield.Sensitive_Paths_Requiring_Origin_or_Referer</label>
                                    @Html.ValidationMessage("SensitiveHeaderMissingCheckPaths", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Paths that must contain at least one of <code>Origin</code> or <code>Referer</code> headers.
                                        <br />Examples: <code>/api/token</code>, <code>/transaction/submit</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Bad User-Agents -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("BadUserAgents", Model.BadUserAgents != null ? string.Join("\n", Model.BadUserAgents) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "curl\nwget\nsqlmap\nnmap" })
                                    <label for="BadUserAgents">@AdvancedShield.Blacklisted_User_Agents</label>
                                    @Html.ValidationMessage("BadUserAgents", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.User_Agent_substrings_or_patterns_that_indicate_bots_scrapers_or_penetration_testing_tools.
                                        <br />Examples: <code>curl</code>, <code>wget</code>, <code>sqlmap</code>, <code>nmap</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Allowed Origins -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("AllowedOrigins", Model.AllowedOrigins != null ? string.Join("\n", Model.AllowedOrigins) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "https://portal.tscgroup.cm" })
                                    <label for="AllowedOrigins">CORS Allowed Origins</label>
                                    @Html.ValidationMessage("AllowedOrigins", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Origins allowed for cross-origin requests. Requests with a mismatched or missing <code>Origin</code> header may be blocked.
                                        <br />Example: <code>https://portal.tscgroup.cm</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Telemetry Header Prefixes -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("TelemetryHeaderPrefixes", Model.TelemetryHeaderPrefixes != null ? string.Join("\n", Model.TelemetryHeaderPrefixes) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "cf-ray\nx-amzn-trace-id" })
                                    <label for="TelemetryHeaderPrefixes">@AdvancedShield.Telemetry_Bot_Header_Prefixes</label>
                                    @Html.ValidationMessage("TelemetryHeaderPrefixes", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Header_names_that_typically_belong_to_bot_traffic_or_APM_tools.
                                        <br />Examples: <code>x-amzn-trace-id</code>, <code>cf-ray</code>, <code>pingdom-*</code>
                                    </small>
                                </div>
                            </div>

                            <!-- High-Risk Header Keys -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("HighRiskHeaderKeys", Model.HighRiskHeaderKeys != null ? string.Join("\n", Model.HighRiskHeaderKeys) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "X-Original-URL\nX-Rewrite-URL" })
                                    <label for="HighRiskHeaderKeys">@AdvancedShield.High_Risk_Header_Keys</label>
                                    @Html.ValidationMessage("HighRiskHeaderKeys", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Headers_commonly_abused_for_internal_rewrites_or_server_exploits.
                                        <br />Examples: <code>X-Original-URL</code>, <code>X-Rewrite-URL</code>, <code>X-Custom-IP-Authorization</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Spoofed Forwarded-For Indicators -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("SpoofedForwardedForIndicators", Model.SpoofedForwardedForIndicators != null ? string.Join("\n", Model.SpoofedForwardedForIndicators) : "", new { @class = "form-control", style = "height: 100px;", placeholder = "127.0.0.1\n::1\nunknown" })
                                    <label for="SpoofedForwardedForIndicators">X-Forwarded-For Spoofing Signatures</label>
                                    @Html.ValidationMessage("SpoofedForwardedForIndicators", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Patterns that indicate spoofed or internal loopback IPs in <code>X-Forwarded-For</code> headers.
                                        <br />Examples: <code>127.0.0.1</code>, <code>::1</code>, <code>unknown</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Allowed Header Value Patterns -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("AllowedHeaderValuePattern", Model.AllowedHeaderValuePattern != null ? string.Join("\n", Model.AllowedHeaderValuePattern) : "", new { @class = "form-control", style = "height: 120px;", placeholder = @"^[a-zA-Z0-9 _\-\[\]\.:=,;/+*]+$" })
                                    <label for="AllowedHeaderValuePattern">@AdvancedShield.Regex_Patterns_for_Safe_Header_Values</label>
                                    @Html.ValidationMessage("AllowedHeaderValuePattern", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Regular_expressions_used_to_validate_header_values_for_expected_formats.
                                        <br />Examples:
                                        <ul>
                                            <li><code>^[a-zA-Z0-9 _\-\[\]\.:=,;/+*]+$</code> – safe characters</li>
                                            <li><code>^application/(json|xml)$</code> – restricts MIME types</li>
                                            <li><code>^Mozilla.*</code> – ensures User-Agent is browser-based</li>
                                        </ul>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="HEADER_VALIDATION" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="HEADER_VALIDATION" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- 4. PATH & EXTENSION EXCLUSIONS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingPathExclusion">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePathExclusion" aria-expanded="false">
                    <i class="mdi mdi-filter-minus-outline me-2 text-secondary"></i> @AdvancedShield.Path_Extension_Exclusions
                </button>
            </h2>
            <div id="collapsePathExclusion" class="accordion-collapse collapse" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p>
                        @AdvancedShield.Define specific paths, file extensions, or substrings that should bypass WAF and security filtering rules. This is useful for allowing health checks,
                        static content, internal service endpoints, or other benign traffic to pass through uninspected.
                    </p>

                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">

                            <!-- Excluded Paths -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("ExcludedPaths",
                                                   Model.ExcludedPaths != null ? string.Join("\n", Model.ExcludedPaths) : "",
                                                   new { @class = "form-control", style = "height: 100px;", placeholder = "/healthz\n/api/ping" })
                                    <label for="ExcludedPaths">@AdvancedShield.Excluded_Request_Paths</label>
                                    @Html.ValidationMessage("ExcludedPaths", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Exact_or_partial_request_paths_that_should_not_be_inspected_These_will_bypass_all_WAF_filters.
                                        <br />Examples: <code>/healthz</code>, <code>/api/keepalive</code>, <code>/signalr/hubs</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Excluded Substrings -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("ExcludedSubstrings",
                                                   Model.ExcludedSubstrings != null ? string.Join("\n", Model.ExcludedSubstrings) : "",
                                                   new { @class = "form-control", style = "height: 100px;", placeholder = "/internal/\n/status-check" })
                                    <label for="ExcludedSubstrings">@AdvancedShield.Excluded_Substrings_in_Path</label>
                                    @Html.ValidationMessage("ExcludedSubstrings", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Any_request_path_containing_one_of_these_substrings_will_bypass_inspection.
                                        <br />Examples: <code>/internal/</code>, <code>/status-check</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Excluded Extensions -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("ExcludedExtensions",
                                                   Model.ExcludedExtensions != null ? string.Join("\n", Model.ExcludedExtensions) : "",
                                                   new { @class = "form-control", style = "height: 100px;", placeholder = ".css\n.js\n.png" })
                                    <label for="ExcludedExtensions">@AdvancedShield.Excluded_File_Extensions</label>
                                    @Html.ValidationMessage("ExcludedExtensions", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Requests_with_these_file_extensions_will_skip_all_WAF_logic_Useful_for_static_resources.
                                        <br />Examples: <code>.css</code>, <code>.js</code>, <code>.jpg</code>, <code>.pdf</code>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="PATH_EXCLUSIONS" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="PATH_EXCLUSIONS" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- 5. SUSPICIOUS INDICATORS & PAYLOAD MARKERS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingSuspiciousIndicators">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSuspiciousIndicators" aria-expanded="false">
                    <i class="mdi mdi-bug-outline me-2 text-danger"></i> @AdvancedShield.Suspicious_Indicators_Payload_Markers
                </button>
            </h2>
            <div id="collapseSuspiciousIndicators" class="accordion-collapse collapse" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p>
                        @AdvancedShield.Define substrings, keywords, or filenames that are often associated with malicious activity. These values will be scanned in request paths, form keys,
                        and header values. Detected matches will be logged or blocked depending on WAF rules.
                        <br />@AdvancedShield.Use_these_to_detect_common_exploit_tools_automated_scanners_or_unauthorized_access_attempts.
                    </p>

                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">
                            <!-- Suspicious Indicators -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("SuspiciousIndicators",
                                                   Model.SuspiciousIndicators != null ? string.Join("\n", Model.SuspiciousIndicators) : "",
                                                   new { @class = "form-control", style = "height: 120px;", placeholder = "sqlmap\nshell.php\nbot" })
                                    <label for="SuspiciousIndicators">@AdvancedShield.Suspicious_Keywords_or_Paths</label>
                                    @Html.ValidationMessage("SuspiciousIndicators", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Add_indicators_that_are_known_to_be_part_of_malicious_requests_or_scanners.
                                        <br />Examples:
                                        <code>sqlmap</code>, <code>curl</code>, <code>shell.php</code>, <code>adminer</code>, <code>wp-login</code>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="SUSPICIOUS_MARKERS" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="SUSPICIOUS_MARKERS" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>




        <!-- 7. BODY & FILE UPLOAD SCANNING -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingBodyScan">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBodyScan" aria-expanded="false">
                    <i class="mdi mdi-file-search-outline me-2 text-warning"></i> @AdvancedShield.Body_File_Upload_Scanning
                </button>
            </h2>
            <div id="collapseBodyScan" class="accordion-collapse collapse" data-bs-parent="#rateLimitAccordion">
                <div class="accordion-body text-muted">
                    <p>
                        @AdvancedShield.This_section_defines_security_controls_for_scanning_HTTP_request_bodies.
                        @AdvancedShield.It_helps_prevent_fil_based_and_payload_based_attacks_such_as <strong>@AdvancedShield.malware_uploads</strong>, <strong>@AdvancedShield.script_injection</strong>, @AdvancedShield.and <strong>@AdvancedShield.path_traversal</strong>.
                    </p>
                    <p>
                        @AdvancedShield.Validation_covers_field_names_field_values_and_file_content_types_or_extensions.
                    </p>

                    @using (Html.BeginForm("AddOrUpdate", "AdvancedSheild", FormMethod.Post, new
                    {
                        enctype = "multipart/form-data",
                        onsubmit = "return AjaxPostAndUpdate(this);"
                    }))
                    {
                        <div class="row gy-3">
                            <!-- Suspicious Key Patterns -->
                            <div class="col-md-12">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("SuspiciousFormKeyPatterns",
                                                   Model.SuspiciousFormKeyPatterns != null ? string.Join("\n", Model.SuspiciousFormKeyPatterns) : "",
                                                   new { @class = "form-control", style = "height: 120px;", placeholder = "script\n0x\n<>\n{}" })
                                    <label for="SuspiciousFormKeyPatterns">@AdvancedShield.Suspicious_Form_Key_Patterns</label>
                                    @Html.ValidationMessage("SuspiciousFormKeyPatterns", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Specify_substrings_or_patterns_that_must_not_appear_in_field_names_or_keys.
                                        <br />
                                        Examples: <code>script</code>, <code>0x</code>, <code>&lt;&gt;</code>, <code>{}</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Disallowed File Extensions -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextArea("BlockedFileExtensions",
                                                   Model.BlockedFileExtensions != null ? string.Join("\n", Model.BlockedFileExtensions) : "",
                                                   new { @class = "form-control", style = "height: 100px;", placeholder = ".exe\n.js\n.sh" })
                                    <label for="BlockedFileExtensions">@AdvancedShield.Blocked_File_Extensions_one_per_line</label>
                                    @Html.ValidationMessage("BlockedFileExtensions", "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Uploaded_files_with_these_extensions_will_be_rejected.<br />
                                        Example: <code>.exe</code>, <code>.js</code>, <code>.sh</code>
                                    </small>
                                </div>
                            </div>

                            <!-- Max File Size -->
                            <div class="col-md-6">
                                <div class="form-floating form-floating-outline">
                                    @Html.TextBoxFor(m => m.MaxUploadFileSizeKb, new { @class = "form-control", type = "number", min = 1 })
                                    @Html.ValidationMessageFor(m => m.MaxUploadFileSizeKb, "", new { @class = "text-danger" })
                                    <label for="MaxUploadFileSizeKb">@AdvancedShield.Max_File_Upload_Size (KB)</label>
                                    <small class="form-text text-muted">
                                        @AdvancedShield.Limits_the_size_of_uploaded_files (in kilobytes).<br />
                                        Example: <code>2048</code> = 2MB
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @Html.HiddenFor(m => m.Id)
                            @if (Model.Id == null)
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
                                <input type="hidden" name="Action" value="insert" id="Action" />
                                <input type="hidden" name="Option" value="BODY_FILE_SCAN" id="Option" />
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary me-2">@GlobalShared.Update</button>
                                <input type="hidden" name="Action" value="update" id="Action" />
                                <input type="hidden" name="Option" value="BODY_FILE_SCAN" id="Option" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


    </div>
</fieldset>
