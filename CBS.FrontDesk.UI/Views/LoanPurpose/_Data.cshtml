@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanPurpose>
<fieldset class="fieldset-custom">

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Product Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:60%">@d.purposeName</td>
                            <td style="width:25%">@d.LoanProductCategory.Name</td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen('@d.id', 'datalistingview', '_Update', 'update', 'LoanPurpose','list')" class="btn btn-outline-primary btn-sm" data-toggle="tooltip" data-placement="top" title="Select @d.purposeName to edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="#" class="btn btn-outline-danger btn-sm" data-toggle="tooltip" data-placement="top" title="Delete @d.purposeName" onclick="DeleteRecordDataTable('LoanPurpose', '@d.id', 'myDataTable', '_Data', 0, 'datalistingview',null,'list')">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            <strong>No loan purposes available.</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>