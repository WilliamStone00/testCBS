@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanPurpose>
<table class="table table-hover" id="myDataTable">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td style="width:80%">@d.purposeName</td>
                <td style="width:20%">
                    <a href="#" onclick="AddORUpdateGen(@d.id,'datalistingview','_Update','update','LoanPurpose')" class="mr-2" data-toggle="tooltip" data-placement="top" title="Select @d.purposeName to edit">Edit</a>
                    <a href="#" class="mr-2" data-toggle="tooltip" data-placement="top" title="Delete @d.purposeName" onclick="DeleteRecordDataTable('LoanPurpose','@d.id','myDataTable','_Data',0,'datalistingview')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

