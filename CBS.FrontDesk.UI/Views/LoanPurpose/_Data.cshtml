@model List<CBS.FrontDesk.Data.Entity.LoanConf.LoanPurpose>
    @using Resources
<fieldset class="fieldset-custom">

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" id="myDataTable">
            <thead class="table-light">
                <tr>
                    <th>@GlobalShared.Name</th>
                    <th>@GlobalShared.product_category</th>
                    <th>@GlobalShared.Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var d in Model)
                    {
                        <tr>
                            <td style="width:60%">@d.purposeName</td>
                            <td style="width:25%">@d.PcmfLoanPurpose.NameEn</td>
                            <td style="width:15%">
                                <a href="#" onclick="AddORUpdateGen('@d.id', 'datalistingview', '_Update', 'update', 'LoanPurpose','list')" class="btn btn-outline-primary btn-sm" data-toggle="tooltip" data-placement="top" title="@GlobalShared.Select @d.purposeName @GlobalShared.ToEdit">
                                    <i class="fas fa-edit"></i> @GlobalShared.Edit
                                </a>
                                <a href="#" class="btn btn-outline-danger btn-sm" data-toggle="tooltip" data-placement="top" title="Delete @d.purposeName" onclick="DeleteRecordDataTable('LoanPurpose', '@d.id', 'myDataTable', '_Data', 0, 'datalistingview',null,'list')">
                                    <i class="fas fa-trash-alt"></i> @GlobalShared.Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            <strong>@GlobalLoanPurpose.NoLoanPurposesAvailable.</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>