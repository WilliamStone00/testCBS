@model CBS.FrontDesk.Data.Entity.LoanConf.LoanPurpose
    @using Resources
<div class="card-body">
    @using (Html.BeginForm("Create", "LoanPurpose", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return AjaxPostAndUpdate(this);" }))
    {
        <div class="row mt-2 gy-4">
            <fieldset class="fieldset-custom">
                <!-- Loan Product Category Field -->
                <div class="col-md-12 mb-3" id="selectFeild">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(m => m.PcmfLoanPurposeId, new SelectList(ViewBag.Categories, "Id", "NameEn"), "---"+ GlobalShared.Select_Category+"---", new { @class = "form-control select2", @search = "true" })
                        @Html.ValidationMessageFor(m => m.PcmfLoanPurposeId, "", new { @class = "text-danger" })
                        <label>@GlobalLoanPurpose.select_loan_product_category</label>
                    </div>
                </div>
                <!-- Loan Purpose Type Field -->
                <div class="col-md-12 mb-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(m => m.purposeName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.purposeName, "", new { @class = "text-danger" })
                        <label>@GlobalLoanPurpose.loan_purpose</label>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">@GlobalShared.Save</button>
            <button type="reset" class="btn btn-outline-secondary">@GlobalShared.Reset</button>
        </div>
    }
</div>
