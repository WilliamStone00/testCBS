@model CBS.FrontDesk.Data.Entity.DailyCollectorManagementData
    @using Resources
@{
    ViewBag.Title = @GlobalDailyCollectorManagement.Profile;
}






<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="card bg-light mb-2">
            <div class="card-body text-center">
                <h1 class="card-title text-primary">
                    <i class="mdi mdi-account-circle me-2"></i> @GlobalDailyCollectorManagement.DailyAgentProfileManagement <strong>@Session["BranchName"]</strong>
                </h1>
                <p class="card-text text-muted">
                    @GlobalDailyCollectorManagement.ManageDailyAgentprofilesefficiently.
                </p>
                <hr style="border: 2px solid rgba(128, 128, 128, 0.5);" />
            </div>
        </div>
    </div>
</div>
<div class="row invoice-preview">
    <div class="col-xl-3 col-md-4 col-12 invoice-actions">
        <fieldset class="fieldset-custom">
            <!-- Daily Agent Reference Information -->
            <div class="card">
                <div class="card-body">
                    <h4 class="group-title">
                        @GlobalDailyCollectorManagement.AGENTREFERENCE # <span class="highlight-text">@Model.Agent.UserId</span>
                        <hr />
                        @*<small>Daily Agent code: Last 4 digits</small><br />*@
                    <small>@GlobalDailyCollectorManagement.BankCode: @Session["BankCode"].ToString()</small><br />
                        <small>@GlobalDailyCollectorManagement.BranchCode: @Session["BranchCode"].ToString()</small>
                    </h4>
                </div>
            </div>
            <br />
            <!-- Daily Agent Status Information -->
            <div class="card">
                <div class="card-body">
                    <h4 class="group-title">
                        @GlobalDailyCollectorManagement.DailyAgentWorkingInformation
                        <hr />
                        <small>@GlobalDailyCollectorManagement.RegisteredBy: @Model.AgentDto.CreatedBy</small><br />
                        <small>@GlobalDailyCollectorManagement.RegisteredDate: @Model.AgentDto.CreatedDate</small><br />
                        <small>@GlobalDailyCollectorManagement.WorkingZone: <span class="highlight-text">@Model.AgentDto.ZoneName</span></small>
                    </h4>
                </div>
            </div>
            <br />
            <!-- Daily Agent Photo -->
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Photo</h5>
                    <div class="image-upload-container">
                        @if (Model.AgentDto.ProfilePicture != null)
                        {
                            <a href="#" data-bs-toggle="modal" data-bs-target="#photoPreviewModal">
                                <img src="@Model.AgentDto.ProfilePicture" class="img-fluid preview-image" alt="@GlobalShared.UploadedImage">
                            </a>
                        }
                        else
                        {
                            <img src="@Url.Content(Model.AgentDto.ImageNoVirtualPath)" class="img-fluid preview-image" alt="@GlobalShared.NoPhotoFound">
                        }
                    </div>
                </div>
            </div>
            <br />
            <!-- Daily Agent Signature -->
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Signature</h5>
                    <div class="image-upload-container">
                        @if (Model.AgentDto.Signature != null)
                        {
                            <a href="#" data-bs-toggle="modal" data-bs-target="#signaturePreviewModal">
                                <img src="@Model.AgentDto.Signature" class="img-fluid preview-image" alt="@GlobalShared.UploadedSignature">
                            </a>
                        }
                        else
                        {
                            <img src="@Url.Content(Model.AgentDto.ImageVirtualNoSignaturePath)" class="img-fluid preview-image" alt="@GlobalShared.NoSignatureFound">
                        }
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <!-- Rest of the content -->
    <div class="col-xl-9 col-md-8 col-12 mb-md-0 mb-4">
        <!-- Tips Section -->
        <div class="card mb-4">
            <h6 class="card-header d-flex justify-content-between align-items-center text-primary">
                <span><i class="mdi mdi-information-outline me-2"></i> @GlobalDailyCollectorManagement.HELPTIPS</span>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHelpTips" aria-expanded="false" aria-controls="collapseHelpTips">
                    <i class="mdi mdi-chevron-down"></i>
                </button>
            </h6>
            <div id="collapseHelpTips" class="collapse">
                <div class="card-body">
                    <p class="text-muted mb-2">@GlobalDailyCollectorManagement.FollowTheseTipsToManageDailyAgentProfilesEffectively:</p>
                    <ul>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalDailyCollectorManagement.EnsureAllDailyAgentDetails.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalDailyCollectorManagement.DailyAgentReferenceNumbersAreAutoGeneratedUnlessCustomized.</li>
              
                        <li><i class="mdi mdi-check-circle-outline text-success me-2"></i> @GlobalDailyCollectorManagement.PhotoAndSignatureUploadsAreMandatory.</li>
               
                    </ul>
                    <p class="text-muted">@GlobalDailyCollectorManagement.AdditionalNotes:</p>
                    <ul>
                        <li><i class="mdi mdi-information-outline text-primary me-2"></i> @GlobalDailyCollectorManagement.DailyAgentreferencesConsistOfABranchCode.</li>
                        <li><i class="mdi mdi-alert-circle-outline text-warning me-2"></i> @GlobalDailyCollectorManagement.EnsureProperDocumentationIsUploadedForVerificationPurposes.</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- Tabbed Content -->
        <div class="card mb-4">
            <div class="card-header p-0">
                <div class="nav-align-top">
                    <ul class="nav nav-tabs nav-fill" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-profile" aria-controls="navs-profile" aria-selected="true">
                                <i class="tf-icons mdi mdi-account-outline me-1"></i> @GlobalDailyCollectorManagement.ProfileDetails
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-account" aria-controls="navs-account" aria-selected="false">
                                <i class="tf-icons mdi mdi-account-circle-outline me-1"></i> @GlobalDailyCollectorManagement.AccountView
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-document" aria-controls="navs-document" aria-selected="false">
                                <i class="tf-icons mdi mdi-file-document-outline me-1"></i> @GlobalDailyCollectorManagement.DocumentManagement
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-signatory" aria-controls="navs-signatory" aria-selected="false">
                                <i class="tf-icons mdi mdi-pen me-1"></i> @GlobalDailyCollectorManagement.SignatoryManagement
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="tab-content p-0">
                    <div class="tab-pane fade show active" id="navs-profile" role="tabpanel">
                        @Html.Partial("_ProfileDetails")
                    </div>
                    <div class="tab-pane fade" id="navs-account" role="tabpanel">
                        @Html.Partial("_AccountBalance")
                    </div>
                    <div class="tab-pane fade" id="navs-document" role="tabpanel">
                        @Html.Partial("_DocumentManagement")
                    </div>
                    <div class="tab-pane fade" id="navs-signatory" role="tabpanel">
                        @Html.Partial("_SignatoryManagement")
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Photo Modal -->
<div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoPreviewModalLabel">@Model.AgentDto.FirstName @Model.AgentDto.LastName - @GlobalDailyCollectorManagement.PhotoPreview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                @if (Model.AgentDto.ProfilePicture != null)
                {
                    <img src="@Model.AgentDto.ProfilePicture" class="img-fluid" alt="@GlobalDailyCollectorManagement.PreviewImage">
                }
                else
                {
                    <img src="@Url.Content(Model.AgentDto.ImageVirtualPath)" class="img-fluid" alt="@GlobalShared.NoImageFound">
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Signature Modal -->
<div class="modal fade" id="signaturePreviewModal" tabindex="-1" aria-labelledby="signaturePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="signaturePreviewModalLabel">@Model.AgentDto.FirstName @Model.AgentDto.LastName - @GlobalDailyCollectorManagement.SignaturePreview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                @if (Model.AgentDto.Signature != null)
                {
                    <img src="@Model.AgentDto.Signature" class="img-fluid" alt="@GlobalDailyCollectorManagement.PreviewSignature">
                }
                else
                {
                    <img src="@Url.Content(Model.AgentDto.ImageVirtualNoSignaturePath)" class="img-fluid" alt="@GlobalShared.NoSignatureFound">
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@GlobalShared.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="accountDetailModal" tabindex="-1" aria-labelledby="accountDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@GlobalDailyCollectorManagement.AccountDetails</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="accountDetailContent">
                <!-- Account details will be loaded here -->
            </div>
        </div>
    </div>
</div>



@section Scripts {@Scripts.Render("~/bundles/jqueryval")

}



